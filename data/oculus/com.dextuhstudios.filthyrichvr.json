/v/t64.5771-25/596168449_1569996021598271_3388000362332684652_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzgpH0XbYZcQ7kNvwHXQX-F&_nc_oc=Adps7mf-vnKLodHH-pjJ0Y1nbRJM0r5WrEEOEJW6rQtLIwis272GJWfqhHSyWvwPnQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX0eZ24LarSzshDBjXbAhO7uhVl2HT7juWLGMlsGYhrkg&oe=6B0F1365"}, {"file_name": "FRVR 5.png", "id": "1060636227012998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604360590_1060636230346331_8079068354242195316_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Adh1tVff_ssQ7kNvwESvR9o&_nc_oc=AdoOrgiUgEtnpINuFYwNFz-raEZusMpSx2B1MYsPxwdn6iMOgEE2UQy_tSTd10kUGYU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUAuvz8eEQdvWddUgTtsH5UYzH7bdeBMBHuYCoE7IN2jA&oe=6B0EFCCA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Filthy Rich VR", "keywords": ["simulator", "cleaning", "satisfying", "rugs", "washing"], "long_description": "**\ud83e\uddfc Get your hands dirty. Make everything spotless. \u2728**\n\nWelcome to **Filthy Rich VR**, a satisfying virtual reality rug-cleaning simulator where every filthy rug hides something beautiful underneath.\n\nStart with humble, dirt-covered doormats and work your way towards enormous, luxurious rugs worth a fortune. Every job brings new challenges, better equipment, and another incredibly satisfying transformation.\n\n**\ud83e\uddfd GET HANDS-ON**\n\nGrab your tools and get cleaning! Beat out dust, spray stubborn stains, cover rugs in thick foam, scrub away grime, and push dirty water aside with your squeegee. Every movement brings you closer to revealing the beautiful rug beneath.\n\n**\u2728 FROM FILTHY TO FANCY**\n\nDiscover colourful patterns, intricate designs, and extravagant rugs as you progress. Watch dull, muddy surfaces transform into vibrant masterpieces right before your eyes.\n\n**\ud83d\udcb0 BUILD YOUR CLEANING EMPIRE**\n\nEarn money from your work, invest in better equipment, and take on bigger, more valuable rugs. What starts as a simple cleaning job can become a seriously luxurious business.\n\n**\ud83d\udca6 YOUR TOOLS. YOUR TECHNIQUE. YOUR SATISFACTION.**\n\nWhether you're carefully removing a stubborn stain or washing down an enormous rug, there's always something satisfying to clean.\n\n**Ready to get filthy rich? \ud83e\udd11**", "short_description": "Turn filthy rugs into luxurious masterpieces in Filthy Rich VR! Grab your cleaning tools, blast away stubborn dirt, scrub out stains, and reveal stunning patterns beneath the grime. Start small, upgrade your equipment, and work your way towards cleaning enormous, extravagant rugs in this satisfying VR cleaning simulator!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://dextuh.com/filthy-rich-vr/privacy", "developer_terms_of_service_url": null, "publisher_name": "Dextuh Studios", "support_website_url": null, "website_url": "https://dextuh.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1502723496250233"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604370996_1189294500089813_9092049961169432175_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlKQ4N2t1OYQ7kNvwEpm1yT&_nc_oc=AdoxW4iB6-2CbfYXj8i9KCLUS42r4Ce-
YTHy8krACw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-zo5ogyYDsKzI1lMkPow5TuhaDDLj7D3r7mjYqYLjaQ&oe=6AFC9585"}, {"file_name": "screenshot-04-rooms.png", "id": "1437823561588524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620384_1437823568255190_6007458634957454245_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N36M9sD8KV8Q7kNvwFTZgI6&_nc_oc=Adq9iFvol5D6yEYati0jKT2tXyhg6T41FMCuLz-J2lWXSxHOmzdqbuOOm2iKytAO83k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzkJUSwEDElWC6du4Y3eSvDqbuEFWioTVQw-HfU9p1Ww&oe=6AFC63FF"}, {"file_name": "screenshot-03-real-switch.png", "id": "1441177431441820", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499623551_1441177438108486_6189514285101601458_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XjisvIPLd0Q7kNvwFTB7-4&_nc_oc=Adr7uWZgesGXLACep5YAgaJfkJfNHVCRuLxfRjnKgKpJaSquU8d1tIaO_qox2fIbJbU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPlhI_O3hYLX5rVUuAa2IwRVqtE1uLXZZzQ7bLsKkvJA&oe=6AFC6DF8"}, {"file_name": "screenshot-05-devices.png", "id": "858988787235712", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620666_858988790569045_6579547858557263091_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4hagoGWxbMQ7kNvwEIqbXt&_nc_oc=Adp0MNqpFGo1K1twpsNZYCwWaNYcp7JBDXXgOtLc6JC1VzDhYLWxwX-6YhUae5GJ1Nk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR9G-QwMRkDOL57wVntw7KExFjsMa2kT0P0v8_PmzrSQ&oe=6AFC6882"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover-landscape.png", "id": "1655101052840318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619602_1655101056173651_5137106381673431292_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x71sBWNg_cMQ7kNvwHRVYaZ&_nc_oc=AdqFN20tbVG8vOjnqsRa_GirqBc2oITs1Gn38Z6y5j1HWPam6dTxE546vmk1rdYbm0E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk1gmxYbeKNE1gCZotReSb9f30xgdB00lSOFp9QYMPPg&oe=6AFC7880"}, "display_name": "HomePanel MR", "keywords": [], "long_description": "Your smart home, right in front of you.\n\nHomePanel MR brings your Home Assistant devices into mixed reality on Meta Quest 3 and Quest 3S. Place a small marker near a real device, look toward it to reveal controls, and select an action with your hands. Look away and the controls fade out.\n\n\u2022 Switch lights and individual switch channels.\n\u2022 Adjust supported light brightness, fan speed and thermostat temperature.\n\u2022 Open, close or stop supported covers.\n\u2022 Browse rooms and everyday devices, with an All devices view for advanced functions.\n\u2022 Save separate placements for each device channel.\n\u2022 Use English or Vietnamese.\n\nREQUIREMENTS\nA working Home Assistant server, an account on that server, compatible configured devices and network access from the headset are required for real device control. Home Assistant and smart-home hardware are not included. Available actions depend on your devices and integrations. Room placement requires Meta room setup and spatial-data permission.\n\nA built-in demo lets you explore sample devices without connecting a server. Connection credentials are stored locally using Android Keystore encryption when you choose to remember them.\n\nHomePanel MR is an independent app, not affiliated with the Open Home Foundation or Meta.", "short_description": "Put Home Assistant controls beside the devices in your room. Look toward a saved device to reveal compact controls, then use your hands to switch lights, adjust your thermostat and more. Requires a working Home Assistant server and compatible devices; a built-in demo is included. For Meta Quest 3 and Quest 3S."}]}, "developer_name": null, "developer_privacy_policy_url": "https://homepanel-mr.pages.dev/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Hohiep102", "support_website_url"
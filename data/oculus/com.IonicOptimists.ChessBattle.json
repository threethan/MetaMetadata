, "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036657_894213242075184_1397239079056250415_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr7R82J8-JoQ7kNvwH6SV3D&_nc_oc=AdpiO83rH62hJseFNKmn7iVPXqK7iHpNprZf44bo6nWvbBtZXwJhHO2dDRaUZBcdH0g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcQQHUIYh8vXjYq-tRN8wZx_LUOxiPYQf5Mw3gjXdbow&oe=6AFC8D15"}, "display_name": "Chess", "keywords": [], "long_description": "Play exciting and realistic chess games against the chess AI on different difficulty levels in a lovingly designed environment. \n\nDay-One Features:\n- designed from the ground up for mobile VR headsets\n- mixed reality / passthrough for chess games in your real world (experimental)\n- handtracking: grab and place chess pieces on the board with your real hands  (experimental)\n- choice of different difficulties from beginner friendly to expert.\n- lovingly designed environment with classical music and a fireplace\n\nRoadmap 2024:\n- new and different environments\n- new chessboard and chesspieces designs\n- time game\n- online mode / lichess or other chess online platform\n- request a feature you would like to see in the game over our contact form at https://ionic-optimists.de", "short_description": "Play exciting and realistic chess games against the chess AI on different elo levels in a lovingly designed environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ionic-optimists.de/index.php?page=privacy-apps", "developer_terms_of_service_url": null, "publisher_name": "Ionic Optimists", "support_website_url": null, "website_url": "https://www.ionic-optimists.de/index.php?page=home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connectio
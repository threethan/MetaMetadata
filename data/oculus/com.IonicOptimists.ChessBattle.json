 new and different environments\n- new chessboard and chesspieces designs\n- time game\n- online mode / lichess or other chess online platform\n- request a feature you would like to see in the game over our contact form at https://ionic-optimists.de", "short_description": "Play exciting and realistic chess games against the chess AI on different elo levels in a lovingly designed environment. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ionic-optimists.de/index.php?page=privacy-apps", "developer_terms_of_service_url": null, "publisher_name": "Ionic Optimists", "support_website_url": null, "website_url": "https://www.ionic-optimists.de/index.php?page=home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7034804719946660"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7047449435348855", "version": "OVRTransitionAPKVersion"}, "id": "1525674678264409", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6935031733257293", "is_concept": false, "latest_releas
68DE"}, {"file_name": "ScreenShot5.png", "id": "1229911318455712", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307451_1229911321789045_4952743419116075008_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeTzfnvQ4AwQ7kNvwH7TxYo&_nc_oc=AdrdpeQrqJwuoPA5zPacNpOoCzCK38jYpTzYbjEXdnX6lrUwp6JEjt3eP-FkW09E2MI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImuVnXPU17lhC2HjD_J8a65-GgpSRI0gpiZ-Rxd0YSxg&oe=6AA16E14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gravity Run VR: Extreme Obstacle Escape", "keywords": ["Runner", "parkour", "Cat", "Obstacle", "Endless"], "long_description": "\ud83c\udf00 Welcome to Gravity Run VR: Extreme Obstacle Escape\nStep into a thrilling VR endless runner adventure where gravity bends, danger lurks, and only your reflexes will save you. Play as a fearless male cat running on a massive spinning log suspended in a vibrant forest. This isn't just a run \u2014 it\u2019s a 360\u00b0 survival test!\n\n\ud83d\udc3e Gameplay Like Never Before\nFull 360\u00b0 movement \u2014 run upside down or sideways by clinging to the rotating log.\n\nUse left and right triggers on your VR controller to move and dodge incoming branches.\n\nAvoid deadly obstacles like sharp branches and rotating barriers.\n\nMaster the spinning log to stay alive and reach the finish line.\n\n\ud83d\udc98 A Heartwarming VR Journey\nYour goal isn't just survival \u2014 it\u2019s love. At the end of each log lies your soulmate: a beautiful female cat waiting for you. Every run is a journey to reunite.\n\n\ud83c\udfae Designed for Meta Quest VR\nFully immersive VR gameplay\n\nPerfect for fans of endless runners, cat games, parkour, and gravity-defying action\n\nIntuitive controls, fast-paced action, and a unique setting\n\n\ud83d\udd11 Key Features\nVR endless runner with unique rotating log mechanics\n\nFun, casual, and challenging\n\nFamily-friendly and engaging story\n\nGreat for fans of Temple Run VR, Runner games, and cat adventures", "short_description": "Run, dodge, and cling to a spinning log in Gravity Run VR! Play as a brave male cat racing through a wild forest log. Avoid deadly branches, rotate 360\u00b0, and stick to the log with perfect balance using your left and right triggers. Survive the twisting path to reunite with your beloved at the finish line. Are you fast and agile enough to complete the challenge?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://zaras-organization-6.gitbook.io/gravity-run-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Little Zara Gaming Co", "support_website_url": null, "website_url": "https://zaras-organization-6.gitbook.io/gravity-run-vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9902066549897873"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1377963073974117"}, {"status": "PUBLISHED", "id": "1274933090842763"}]}, "baseline_offer": {"id": "1377963073974117"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767854100, "status": "PUBLISHED", "id": "1377963073974117"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9936346486469879", "version": "3"}, "id": "1229055785188716", "channel_name": "LIVE"}]}, "
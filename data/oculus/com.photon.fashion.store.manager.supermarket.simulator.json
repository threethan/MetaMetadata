ps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820652_1573002207508889_2912584882632669945_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8D009rKs2kQ7kNvwFV7v7u&_nc_oc=Adr4JQ_8iVltJaYVm7hKxH_ctpS08xC9N-c6ulF4ZZiYnq3rp8i2vLNbYY5jbnLZfsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_f7rjL1rm9BzBnm8AcW_kgVwT70Keo7G9NlLR6tK6zGQ&oe=6A316284"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fashion Store Manager", "keywords": ["clothing", "fashion", "store", "sales", "supermarket"], "long_description": "Welcome to Fashion Store Manager, the ultimate fashion store and retail simulator where you build and manage your own stylish business. Step into the world of shopping, customer service, and store management as you turn a small shop into a successful fashion empire.\n\nArrange clothing displays, organize inventory, restock shelves, and keep your boutique looking attractive. Help customers find the latest styles, manage checkout counters, and handle daily store operations like a real store manager.\n\nExpand your business by unlocking new fashion items, upgrading interiors, improving customer satisfaction, and increasing profits. Every decision matters as you grow from a small clothing store into a busy shopping destination.\n\nEnjoy relaxing yet rewarding gameplay with colorful environments, smooth controls, and exciting business challenges. Whether you love fashion, management games, or shopping simulators, this game offers a fun and satisfying experience.\n\n**Features**\n- Realistic fashion store manager gameplay\n- Run your own stylish clothing boutique\n- Handle cashier and customer service tasks\n- Organize stock with inventory manager systems\n- Expand your shop and unlock upgrades\n- Smooth and casual business simulator gameplay\n- Fun shop management missions\n\nBecome the top retail boss and build the best fashion store in town with Fashion Store Manager.", "short_description": "Run your own fashion store in Fashion Store Manager. Manage customers, organize shelves, sell trendy outfits, and grow your dream boutique. Enjoy immersive store manager gameplay with shopping tasks, cashier duties, inventory control, and business upgrades. A fun retail simulator and shop management experience for all players."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/photonhorizons/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Photon Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/photonhorizons/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27584625591139698"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2559500234464615"}]}, "baseline_offer": {"id": "2559500234464615"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778010120, "status": "PUBLISHED", "id": "2559500234464615"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27598873336381590", "version": "1.0.1"}, "id": "4366471576958057", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27584625574473033", "is_conce
cdn.com/v/t64.5771-25/38982553_1366299433933655_3660907046079614245_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HaEE-W4Xvh0Q7kNvwEqc9Mf&_nc_oc=AdqeBGU8sBYyGjUBrPP-Jpo2i0fQE9ojwNs3VTsGxrXF8C_vYj8hUi3OE2Qe1IM6e38&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ31DUf6BJFcNq1QMMYnaHMwIXAJMhpFyUWNXN5fMpClQ&oe=6AAD62C2"}, {"file_name": "38982586_141976484469299_3715368043751202176_n.png", "id": "876604477042038", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75334062_876604487042037_2373509080253734104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3PljTuzt0S8Q7kNvwG0wkNJ&_nc_oc=AdrkQjFUKppLEc_cWMiHJq0COmJPGO_q40jEi38obYZxapXWhRJfl6voC8TdMnrOwCw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJt3OGMk4F3E6vcuG8pZle_Or9fSErMQu_QMENO6DBfvw&oe=6AAD51C5"}, {"file_name": "38974538_2861249560757816_1771176779738542046_n.png", "id": "860866155092954", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035394_860866158426287_5830958412392023217_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vt3Pkx6e5U8Q7kNvwEkYY-D&_nc_oc=AdpyGcX8OZBA3ZM0YIaZJzHK5muiZD5YIKBL7lY6EqkbiDUC8u2eYqpIXaiGksXwaoA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSxZj8wedS2OLvK6hmha1HWEXFQD5PAQ_dlOtAtA4NKQ&oe=6AAD5927"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1472371693246142", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75441580_1472371696579475_4686131202655945845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etaDajCyCPkQ7kNvwHGq5XZ&_nc_oc=AdrLdLlslv3q3Cv5AoPG6lJb-q6RksLB5EovODzAxADRuuFTEDEzcNE0x0Ds__xf8NY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDVaZmIrs5ASf9M2udteKZT8VyLmpprWiBYIORS4z3xQ&oe=6AAD5A8D"}, "display_name": "Days of Heroes: D-Day", "keywords": [], "long_description": "Days of Heroes: D-Day have a two unique perspectives, experience the largest landing operation in martial history regarding the forces and means used. Take on the role of an airborne division jumper who descends into enemy territory to destabilize the enemy troops under the cover of night. Alternately, become a soldier beginning their heavy crossing of Omaha beach on D-Day.\n\nComplete diversified military missions, from short- and long-range skirmishes with Nazis, by employing anti-aircraft fire, destroying enemy tanks, and breaking through the trenches and escaping from a firing squad. Use over a dozen weapons typical to the World War II period that have been accurately reproduced in terms of appearance and mechanics.\n\nFinish the campaign and practice your skills on the shooting range, which offers four different gameplay modes. Once ready, try Hardcore Mode, which will take your cleverness, strategic thinking, and will to survive to the extreme.", "short_description": "Days of Heroes: D-Day have a two unique perspectives, experience the largest landing operation in martial history regarding the forces and means used. Take on the role of an airborne division jumper who descends into enemy territory to destabilize the enemy troops under the cover of night. Alternately, become a soldier beginning their heavy crossing of Omaha beach on D-Day. You can check free demo here: https://www.oculus.com/experiences/quest/3346478685453854/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "support_website_url": null, "website_url": "https://szlufik.pl/daysofheroes/index.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "p
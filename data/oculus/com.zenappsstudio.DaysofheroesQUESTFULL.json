lKjnf0V4pT9vjGd89rNyJck-LyayKDJ10_MpHKaw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnZTRKvx14RoqicvhWyW4ycysFuj6nmkO0zLDQqlE8Eg&oe=6AFC7327"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1472371693246142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75441580_1472371696579475_4686131202655945845_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeOL4DRUK5sQ7kNvwE9Jbz9&_nc_oc=AdrY7myH_6bdo27gE0JYqGu6uJ6qLHW6cAr8WtOEMcaAsHh3pfLsJ_i85yVaeOJyQBk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb66-p7kEnCcP8WZ6pJgilrLO_T5XmHZSDEGNc3rbuxg&oe=6AFC748D"}, "display_name": "Days of Heroes: D-Day", "keywords": [], "long_description": "Days of Heroes: D-Day have a two unique perspectives, experience the largest landing operation in martial history regarding the forces and means used. Take on the role of an airborne division jumper who descends into enemy territory to destabilize the enemy troops under the cover of night. Alternately, become a soldier beginning their heavy crossing of Omaha beach on D-Day.\n\nComplete diversified military missions, from short- and long-range skirmishes with Nazis, by employing anti-aircraft fire, destroying enemy tanks, and breaking through the trenches and escaping from a firing squad. Use over a dozen weapons typical to the World War II period that have been accurately reproduced in terms of appearance and mechanics.\n\nFinish the campaign and practice your skills on the shooting range, which offers four different gameplay modes. Once ready, try Hardcore Mode, which will take your cleverness, strategic thinking, and will to survive to the extreme.", "short_description": "Days of Heroes: D-Day have a two unique perspectives, experience the largest landing operation in martial history regarding the forces and means used. Take on the role of an airborne division jumper who descends into enemy territory to destabilize the enemy troops under the cover of night. Alternately, become a soldier beginning their heavy crossing of Omaha beach on D-Day. You can check free demo here: https://www.oculus.com/experiences/quest/3346478685453854/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "support_website_url": null, "website_url": "https://szlufik.pl/daysofheroes/index.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6002817743096399"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "2227011694836848"}, {"status": "PUBLISHED", "id": "1612511923576467"}, {"status": "PUBLISHED", "id": "1557056305931383"}, {"status": "PUBLISHED", "id": "994809633240072"}, {"status": "PUBLISHED", "id": "2857972247890250"}, {"status": "PUBLISHED", "id": "1457579389425441"}, {"status": "PUBLISHED", "id": "34514010751531526"}, {"status": "PUBLISHED", "id": "1612420970190062"}, {"status": "PUBLISHED", "id": "1229949345665378"}, {"status": "PUBLISHED", "id": "873611248331504"}, {"status": "PUBLISHED", "id": "665146632823284"}, {"status": "PUBLISHED", "id": "3168494163326711"}, {"status": "PUBLISHED", "id": "1347383856470111"}, {"status": "PUBLISHE
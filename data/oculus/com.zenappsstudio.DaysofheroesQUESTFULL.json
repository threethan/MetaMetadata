.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRU9gKY1Tfr0EYGVxP7b6XShne7PolxcOb8Vl3s2d7KA&oe=6AEF3F11"}, {"file_name": "39001663_791972811526786_7675262613809682432_n.png", "id": "1366299430600322", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982553_1366299433933655_3660907046079614245_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwxaKm0kUZAQ7kNvwHReBxM&_nc_oc=AdpgN5LOCbOPDaOXuEia0iFn-E93E7hHwJwB3qIzBE9FY4vcMICjSAu50JUdjHNEZgA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREu7-hfyhDZFkoqfcFpukvfavpliaCY9Pw9m88G-jHoA&oe=6AEF4DC2"}, {"file_name": "38982586_141976484469299_3715368043751202176_n.png", "id": "876604477042038", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75334062_876604487042037_2373509080253734104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubp3kExEhGkQ7kNvwEQg015&_nc_oc=Ado0qWL8ZitZ9ghlii-MvD8X9t6kGH0S1mQpkosx4sTfJWzobycr6SQWsAflW8gyFW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoAcmIv6GO-QzyNmdqu-e4DrhPSmXMPPJxN4YlDDEELw&oe=6AEF3CC5"}, {"file_name": "38974538_2861249560757816_1771176779738542046_n.png", "id": "860866155092954", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035394_860866158426287_5830958412392023217_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrGPABf3VV4Q7kNvwEb39_k&_nc_oc=AdoGq23JSPf4aIw9meJj9-c8udiaMYKVwx_52qYC9qAfdRHdACfHJFOiLj-SMP83c5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKdVX2EI1O5zIl405M63mAiyvYhNAFl7d4iF489duvqA&oe=6AEF4427"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1472371693246142", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441580_1472371696579475_4686131202655945845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rImnLzKidm4Q7kNvwFarBGW&_nc_oc=AdqVaEF5zvR_-oKXM4OA2usvexU_kCXeF6LgLMtV0pjVk4assejOGCAbHrBVvtATO30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwAzFbH7VCkD3vIv4vXAzEkCcCJYsJaw2PeUKXpUWGWg&oe=6AEF458D"}, "display_name": "Days of Heroes: D-Day", "keywords": [], "long_description": "Days of Heroes: D-Day have a two unique perspectives, experience the largest landing operation in martial history regarding the forces and means used. Take on the role of an airborne division jumper who descends into enemy territory to destabilize the enemy troops under the cover of night. Alternately, become a soldier beginning their heavy crossing of Omaha beach on D-Day.\n\nComplete diversified military missions, from short- and long-range skirmishes with Nazis, by employing anti-aircraft fire, destroying enemy tanks, and breaking through the trenches and escaping from a firing squad. Use over a dozen weapons typical to the World War II period that have been accurately reproduced in terms of appearance and mechanics.\n\nFinish the campaign and practice your skills on the shooting range, which offers four different gameplay modes. Once ready, try Hardcore Mode, which will take your cleverness, strategic thinking, and will to survive to the extreme.", "short_description": "Days of Heroes: D-Day have a two unique perspectives, experience the largest landing operation in martial history regarding the forces and means used. Take on the role of an airborne division jumper who descends into enemy territory to destabilize the enemy troops under the cover of night. Alternately, become a soldier beginning their heavy crossing of Omaha beach on D-Day. You can check free demo here: https://www.oculus.com/experiences/quest/3346478685453854/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "support_website_url": null, "website_url": "https://szlufik.pl/daysofheroes/index.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3
ohc=8rq-8utsQ2AQ7kNvwG-M5b5&_nc_oc=Ado1DDng-ozfGLZ2F38-H2ruYSuv-SVCZY_N73Tlw4953sA-v07g1i9Nt40i786UmAY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6ytUoL0OkWJrBVWhAI8QSNS6MQ8dzZpBs8xtBvDuV6A&oe=6B099B94"}, {"file_name": "3.png", "id": "1552253702985729", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623443_1552253706319062_4383990735374818211_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ngAx-nFJ48Q7kNvwF80aed&_nc_oc=AdqDKW-R9qYeMEBGG3DOd2jMxY3-1QOr3QmK5FUSGKp-NmQS8NwXGsw9UGsNDg0bVS4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYAkIs0QXWKr0ETjH-IGR5KcxUqxUv9pG8rQ-cUYEVXg&oe=6B099EF8"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_2_.png", "id": "884497651327896", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303471_884497654661229_1055568266215561998_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-MDT3032HIQ7kNvwENzet-&_nc_oc=Adrsgn26z3e6ONLTF0tFixLVjtofgX0Zs9YSJ9loeqMyYUVUUj6yC7-bauggqo9KCKA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDaTlBHU6uG1Hj_l7U2n3Sjvw8jBXXRAJIcHjlSk2MmA&oe=6B09BB97"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_4_.png", "id": "1471909817542340", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312257_1471909820875673_6361018781736377597_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RW0YrokOwxIQ7kNvwHI2-ts&_nc_oc=AdrrMiL726EhtxHjH-MbVkncwSdMJ8g22MfL6qoxuXx7VTgS-gdqmlfvXmCEj6vHXoI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdeYyxGhLQ-G3TiiY_6m-KhoaRZrh5HUGSbuofKRlA3g&oe=6B09BCA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1377499137511821", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_1377499144178487_822249136997555259_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGG2EdHX_uUQ7kNvwGfnfkE&_nc_oc=AdqaIHKNfYGzQ6zD6xHZYrVsefX4Syo4knLTIrns_sbGcbnf1rYkpRdifRxt_pTc_y4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSe9Ex4LMDykGZyo1nDBI824QSwTOXveGbXEg6Hn_VjA&oe=6B09B170"}, "display_name": "Days of Heroes: D-Day", "keywords": ["D\u2011Day", "Shooter", "FPS", "lowpoly", "War"], "long_description": "# Experience the D-Day Invasion in VR\n\n\nStorm the beaches of Normandy and fight through one of the most iconic battles of World War II in this cinematic VR action experience.\n\nSurvive brutal beach landings, push through fortified enemy defenses, take part in sabotage missions, operate heavy weapons, and fight across war-torn battlefields inspired by the events of D-Day.\n\n# \u2694\ufe0f 25 Missions + Training \u2694\ufe0f\n\nFrom massive frontline assaults and trench warfare to sniper encounters, tank battles, and airborne operation \u2014 every mission offers unique gameplay moments built for immersive VR combat.\n\n# \ud83d\udca3 Full VR Combat Experience \ud83d\udca3\n\n- Fight across beach, trenches, villages, bunkers, and battlefields\n- Use rifles, SMGs, machine guns, grenades, explosives, and heavy weaponry\n- Take part in armored assaults and intense frontline combat\n- Experience dynamic battles filled with artillery, air attacks, and enemy counterattacks\n\n# \ud83c\udfc5 Multiple Ways to Fight \ud83c\udfc5\n\nSeveral missions feature  dynamic battlefield events, making each playthrough feel unique.\n\n\ud83c\udfaf Prepare for a cinematic VR war experience where survival, courage, and quick reactions decide the outcome of battle.", "short_description": "Days of Heroes: D-Day throws you straight into the chaos of World War II. Survive intense battles, push through enemy lines, and experience a story\u2011driven VR shooter full of action and atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "supp
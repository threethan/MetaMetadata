ohc=2LmJwsSSasIQ7kNvwGUv5Jk&_nc_oc=AdrzUvevDeNWFrOeNpEFHV6FfcXSTUVdHcSrde1qsSi8CwGi4kbN-Mmtb0d2wzb0FSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyHdpmUDtIV8wAxeNsEm2t8z8l0gn7WedZADBAZqai4w&oe=6B006114"}, {"file_name": "3.png", "id": "1552253702985729", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_1552253706319062_4383990735374818211_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3UnFCBsih8Q7kNvwG9pAl-&_nc_oc=AdpVbjZCw69EZmMseoecHLdKarHHYO8pDihw-fMzAV0qlQOkRvMPRwRrSO2CUTbWb2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2MhhhcOQqAeJXZ86ck9nhVhiuIR8kLRqIKhig9aEXuQ&oe=6B006478"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_2_.png", "id": "884497651327896", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303471_884497654661229_1055568266215561998_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ecFIEyX-sXwQ7kNvwEa-o-k&_nc_oc=AdopKn4ADLxok7MtyNbm5cfKq0-E9memJi4rqiyZmwgJ1DrcXLha5eVK2qkji3RMY1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTthC8ClROLi7Efwt8ldS6yqCfrg4hE8xxkasUbAXY7g&oe=6B008117"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_4_.png", "id": "1471909817542340", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312257_1471909820875673_6361018781736377597_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SB0cAG-xIzkQ7kNvwEpk15-&_nc_oc=Adqylnfr7BpRzh8Op0nzaq0Ib58C5bms8Y1mwJ1ldSCUNIk2H1QhU9mwY2IcOPClCmQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMf12Kerk-U7MYn0x421SsqH5IzHyxY1btEpi5rGeDaw&oe=6B008224"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1377499137511821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_1377499144178487_822249136997555259_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NaEfK3lrhMQ7kNvwEgmEXM&_nc_oc=Adp8hoEi4SFTG2IEXaqWlIggxd4yFvNowSqk77BhqTOnaE5DZU71QcxiChxChqWpuiY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3VolJqfk-Kq0W7Vfk1qRnfsezLl4adealzjOWzqE95g&oe=6B0076F0"}, "display_name": "Days of Heroes: D-Day", "keywords": ["D\u2011Day", "Shooter", "FPS", "lowpoly", "War"], "long_description": "# Experience the D-Day Invasion in VR\n\n\nStorm the beaches of Normandy and fight through one of the most iconic battles of World War II in this cinematic VR action experience.\n\nSurvive brutal beach landings, push through fortified enemy defenses, take part in sabotage missions, operate heavy weapons, and fight across war-torn battlefields inspired by the events of D-Day.\n\n# \u2694\ufe0f 25 Missions + Training \u2694\ufe0f\n\nFrom massive frontline assaults and trench warfare to sniper encounters, tank battles, and airborne operation \u2014 every mission offers unique gameplay moments built for immersive VR combat.\n\n# \ud83d\udca3 Full VR Combat Experience \ud83d\udca3\n\n- Fight across beach, trenches, villages, bunkers, and battlefields\n- Use rifles, SMGs, machine guns, grenades, explosives, and heavy weaponry\n- Take part in armored assaults and intense frontline combat\n- Experience dynamic battles filled with artillery, air attacks, and enemy counterattacks\n\n# \ud83c\udfc5 Multiple Ways to Fight \ud83c\udfc5\n\nSeveral missions feature  dynamic battlefield events, making each playthrough feel unique.\n\n\ud83c\udfaf Prepare for a cinematic VR war experience where survival, courage, and quick reactions decide the outcome of battle.", "short_description": "Days of Heroes: D-Day throws you straight into the chaos of World War II. Survive intense battles, push through enemy lines, and experience a story\u2011driven VR shooter full of action and atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "supp
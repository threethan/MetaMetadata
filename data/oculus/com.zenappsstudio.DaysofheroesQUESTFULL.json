ohc=Mu2VzY7qEL0Q7kNvwHubdhG&_nc_oc=AdqhGRfCQDsAM5cYOPQEPSk65cPefPr1Z9QMGGLbnYJG2q_LeD9tsxEJmhq93CjvDns&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe3yoMHL5ksCM4dO8msJyIRmj_2ZLO2C6NtcOpx5kVAA&oe=6AFB1B14"}, {"file_name": "3.png", "id": "1552253702985729", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499623443_1552253706319062_4383990735374818211_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-EXBx-23zoQ7kNvwEiO1a3&_nc_oc=AdrPkkXUO4OprnBikTEwoxNPxc0qSPwRzIbFF8H9PZGMx_5GHWdp8rY-mWKRL9kpByY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQeZ06fhaRNmMWCVOJKZxUMyF4mQCJEED22kO9Tq1R3w&oe=6AFB1E78"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_2_.png", "id": "884497651327896", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303471_884497654661229_1055568266215561998_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgrSw5GN32kQ7kNvwGuaRR1&_nc_oc=AdoJMguCMVmas_UEzpvWpYFgSMgw5LAZVySzOzgkz8VPufxjr09TmtW-blpVi09oJPk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScMwgJgkxwov3csFYKm7fPxfrdS9XF4WpLiWUAgJaCog&oe=6AFB3B17"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_4_.png", "id": "1471909817542340", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499312257_1471909820875673_6361018781736377597_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1_2clGs__gQ7kNvwESj_HE&_nc_oc=AdpZzwvZf_LUAStvv_dAPPBB3HzfaFxhrsN0N26xOzi7aPotMfTnpRioE-pVRXASVE8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4SOvupQdzzsVmWHllm9g9hS1k1hTP5z1SB4OpzRiefQ&oe=6AFB3C24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1377499137511821", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823940_1377499144178487_822249136997555259_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iniEb6bKN2YQ7kNvwH2Wy7T&_nc_oc=AdqQXU30sjJ23tOAFrzL7js_LmdUXZts1Olu2Hqromv-nHcWax5kegb5E5iYeYUG8qI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNP-J3QucVbt-yaoKhyhp39b8JO4UWZPS-SGcKpZ7eXw&oe=6AFB30F0"}, "display_name": "Days of Heroes: D-Day", "keywords": ["D\u2011Day", "Shooter", "FPS", "lowpoly", "War"], "long_description": "# Experience the D-Day Invasion in VR\n\n\nStorm the beaches of Normandy and fight through one of the most iconic battles of World War II in this cinematic VR action experience.\n\nSurvive brutal beach landings, push through fortified enemy defenses, take part in sabotage missions, operate heavy weapons, and fight across war-torn battlefields inspired by the events of D-Day.\n\n# \u2694\ufe0f 25 Missions + Training \u2694\ufe0f\n\nFrom massive frontline assaults and trench warfare to sniper encounters, tank battles, and airborne operation \u2014 every mission offers unique gameplay moments built for immersive VR combat.\n\n# \ud83d\udca3 Full VR Combat Experience \ud83d\udca3\n\n- Fight across beach, trenches, villages, bunkers, and battlefields\n- Use rifles, SMGs, machine guns, grenades, explosives, and heavy weaponry\n- Take part in armored assaults and intense frontline combat\n- Experience dynamic battles filled with artillery, air attacks, and enemy counterattacks\n\n# \ud83c\udfc5 Multiple Ways to Fight \ud83c\udfc5\n\nSeveral missions feature  dynamic battlefield events, making each playthrough feel unique.\n\n\ud83c\udfaf Prepare for a cinematic VR war experience where survival, courage, and quick reactions decide the outcome of battle.", "short_description": "Days of Heroes: D-Day throws you straight into the chaos of World War II. Survive intense battles, push through enemy lines, and experience a story\u2011driven VR shooter full of action and atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "supp
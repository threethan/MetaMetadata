ohc=Zhf4tukOE6wQ7kNvwFouRH-&_nc_oc=AdqCsFFnTMLb7glQUqHM8snvT-m8VJvpK6UGwWepcfAL-Bi94JvtKw6r3amB24CCzC0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdATaM7CEMgB1kqsZxSxcNu4P_-EzR92GEy71JHx-2Xg&oe=6B0B2554"}, {"file_name": "3.png", "id": "1552253702985729", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623443_1552253706319062_4383990735374818211_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmAXDtfb2esQ7kNvwEm9lgl&_nc_oc=Adr2fN00D8iSAJ2nQmd133MF_Uk7EbdNellHO8O3T8O6Z9C4yQxSSUQasosLH8ha5Z0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRo00tai42DvTpQyTgFEghEOq6JPpyo4dXuDFtYDm4JbA&oe=6B0B28B8"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_2_.png", "id": "884497651327896", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303471_884497654661229_1055568266215561998_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7n4bmYeGREQ7kNvwEBhpEw&_nc_oc=Adq1hjXUnYQXLqEBs2feUP9DhaPP4GDJSjRHFczJZXwdoUVpA1Ti7VxEvtr_SCN0Viw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSY4iv8CXrMo13uJgmQ3KOHj7b1qi9lIUOgzVJe7WZEaw&oe=6B0B0D17"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_4_.png", "id": "1471909817542340", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312257_1471909820875673_6361018781736377597_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYTXPSmRLYMQ7kNvwHa4IFA&_nc_oc=AdqE2Q1d4KhvlBeZvURgCyikYVDC02dF3Ps0GwILMqSd4KVkqFZscG8wip9EigVt9U0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQIc42F6cJaSfJb6PBljGxYN5_VQ_l1hmqxK0ZOcsWpZA&oe=6B0B0E24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1377499137511821", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823940_1377499144178487_822249136997555259_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGG2EdHX_uUQ7kNvwE5Wsdg&_nc_oc=Adq7yV3xptr8B73ZJOfhazE2BWiwKHdI4WvFEJUZAnoMLT5HnK_oLDoSTF52Ao_M2pE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSSOJHp3j5OtFwSb27MvxKmNrJ-rpOTnJ-g6xIrLpKV7w&oe=6B0B3B30"}, "display_name": "Days of Heroes: D-Day", "keywords": ["D\u2011Day", "Shooter", "FPS", "lowpoly", "War"], "long_description": "# Experience the D-Day Invasion in VR\n\n\nStorm the beaches of Normandy and fight through one of the most iconic battles of World War II in this cinematic VR action experience.\n\nSurvive brutal beach landings, push through fortified enemy defenses, take part in sabotage missions, operate heavy weapons, and fight across war-torn battlefields inspired by the events of D-Day.\n\n# \u2694\ufe0f 25 Missions + Training \u2694\ufe0f\n\nFrom massive frontline assaults and trench warfare to sniper encounters, tank battles, and airborne operation \u2014 every mission offers unique gameplay moments built for immersive VR combat.\n\n# \ud83d\udca3 Full VR Combat Experience \ud83d\udca3\n\n- Fight across beach, trenches, villages, bunkers, and battlefields\n- Use rifles, SMGs, machine guns, grenades, explosives, and heavy weaponry\n- Take part in armored assaults and intense frontline combat\n- Experience dynamic battles filled with artillery, air attacks, and enemy counterattacks\n\n# \ud83c\udfc5 Multiple Ways to Fight \ud83c\udfc5\n\nSeveral missions feature  dynamic battlefield events, making each playthrough feel unique.\n\n\ud83c\udfaf Prepare for a cinematic VR war experience where survival, courage, and quick reactions decide the outcome of battle.", "short_description": "Days of Heroes: D-Day throws you straight into the chaos of World War II. Survive intense battles, push through enemy lines, and experience a story\u2011driven VR shooter full of action and atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "supp
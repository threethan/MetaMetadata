ohc=Zhf4tukOE6wQ7kNvwEPMMtH&_nc_oc=AdpAGPINt5lvPhkWpKwhHj420bdmJrKvw3ODLq3YYbNTx4kDNe3D0uyskn6klKAn0nk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT-mtMZQtQQ-ylOdoKCtFTLYMQgh_ssEE707VsLgWqfJQ&oe=6B0C76D4"}, {"file_name": "3.png", "id": "1552253702985729", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_1552253706319062_4383990735374818211_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmAXDtfb2esQ7kNvwH7xwVj&_nc_oc=AdreNZKYENkvlhnJ3CYVYIOC_yfdN0K9TX_jqnr4Y-3p7dvP7HmyO0d7bzdqlCZGu1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1j06OX2Gf8xkL-J82pQREY2HOBO84zKK8IT0L9pZ80Q&oe=6B0C7A38"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_2_.png", "id": "884497651327896", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303471_884497654661229_1055568266215561998_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7n4bmYeGREQ7kNvwGVLHnc&_nc_oc=AdpUpRaAI_RYaoo4MGHROZyvjO1aW9cIZBpQ_-ImRGpVZ3HvmBUEg-5Kt2aD9wVDNm0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7LSzKmOKJBUAMCrF2UixPeuDLpy0225YMWc0iBJOPBg&oe=6B0C5E97"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_4_.png", "id": "1471909817542340", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312257_1471909820875673_6361018781736377597_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYTXPSmRLYMQ7kNvwGlHNsU&_nc_oc=AdorhFj6DSGMpXK0PZZTY_7ThXB8YdQYffVulhI3AA0wEpknYnZxeZMw4dgj-tJhgZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTf87SN_EqfJmrmkwMrZs8q7E6KSy-It3D1pnAw3m77w&oe=6B0C5FA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1377499137511821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_1377499144178487_822249136997555259_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGG2EdHX_uUQ7kNvwEHived&_nc_oc=AdqRN81HF2wwxJ6ydWsC69LD4sTZDNIs8XTe_lDNk3QvAcGP1H2epKk8l_GC-QbrGKw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRI22mooCnq0ofQd1bAbatA5av51bMnIzDBJ4XbM0WtMg&oe=6B0C5470"}, "display_name": "Days of Heroes: D-Day", "keywords": ["D\u2011Day", "Shooter", "FPS", "lowpoly", "War"], "long_description": "# Experience the D-Day Invasion in VR\n\n\nStorm the beaches of Normandy and fight through one of the most iconic battles of World War II in this cinematic VR action experience.\n\nSurvive brutal beach landings, push through fortified enemy defenses, take part in sabotage missions, operate heavy weapons, and fight across war-torn battlefields inspired by the events of D-Day.\n\n# \u2694\ufe0f 25 Missions + Training \u2694\ufe0f\n\nFrom massive frontline assaults and trench warfare to sniper encounters, tank battles, and airborne operation \u2014 every mission offers unique gameplay moments built for immersive VR combat.\n\n# \ud83d\udca3 Full VR Combat Experience \ud83d\udca3\n\n- Fight across beach, trenches, villages, bunkers, and battlefields\n- Use rifles, SMGs, machine guns, grenades, explosives, and heavy weaponry\n- Take part in armored assaults and intense frontline combat\n- Experience dynamic battles filled with artillery, air attacks, and enemy counterattacks\n\n# \ud83c\udfc5 Multiple Ways to Fight \ud83c\udfc5\n\nSeveral missions feature  dynamic battlefield events, making each playthrough feel unique.\n\n\ud83c\udfaf Prepare for a cinematic VR war experience where survival, courage, and quick reactions decide the outcome of battle.", "short_description": "Days of Heroes: D-Day throws you straight into the chaos of World War II. Survive intense battles, push through enemy lines, and experience a story\u2011driven VR shooter full of action and atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "supp
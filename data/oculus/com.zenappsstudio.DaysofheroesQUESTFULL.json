ohc=KBmpUqxzIQwQ7kNvwF4uMIY&_nc_oc=AdotyXXa78MzR-yHYBRwMD-eH8Xggz3xQ2Jn0M4myqKqQpaWHePLPVpV6diB4IAzkPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVk0CgDuj7qUPkVEHwXeowj7Bs3ofEH2_d6WMDPzN8CA&oe=6B05A714"}, {"file_name": "3.png", "id": "1552253702985729", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_1552253706319062_4383990735374818211_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr0SPAfZ_pEQ7kNvwF5D8MS&_nc_oc=Ado3sfWbfoUSYK7HO7F-oCRSpVNGeKWcE8K2iMeWs99s9a90uaf6a-Tqg6NqoflgD90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2dSek-bVH8Mk1T1Ds5hAy4NKDWzkm1bOp8UBgCUT_0A&oe=6B05AA78"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_2_.png", "id": "884497651327896", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303471_884497654661229_1055568266215561998_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsKQaEgqpG8Q7kNvwGDv9c-&_nc_oc=Adpn62WK7HKzjeRFonmyI5BKMwyWK5-xNI8fndzeN2UcO5-I64D0jzwmlCihPNnAOhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwUD2NU7ZhRdYvvXNeXxyNl2sJdsiNSHQIH0erxFPSMA&oe=6B05C717"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_4_.png", "id": "1471909817542340", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312257_1471909820875673_6361018781736377597_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGhpdUCjeUoQ7kNvwFcsQI3&_nc_oc=AdoFEasUuUT3A-4S4c5uOPUH8why8kparjMk9xn8d0ddlS-gex7o0KaWt5idAjQ9pyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv0CKPL5p7WxF5z7sBQnWUynDU54dwc3JXfOo60QDuyw&oe=6B05C824"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1377499137511821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_1377499144178487_822249136997555259_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cABmru_5ngQ7kNvwFPbXGy&_nc_oc=AdrtoXyJl7ImiOWLrvT6lM0OSD5b1O4JdS0i-BJGb3kksuP8UwOLnHNGYYDtv-Z0qi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzsTv5t1qllyP51eoscSCZ3SUHzxyMIEVAOLXlvEomfA&oe=6B05BCF0"}, "display_name": "Days of Heroes: D-Day", "keywords": ["D\u2011Day", "Shooter", "FPS", "lowpoly", "War"], "long_description": "# Experience the D-Day Invasion in VR\n\n\nStorm the beaches of Normandy and fight through one of the most iconic battles of World War II in this cinematic VR action experience.\n\nSurvive brutal beach landings, push through fortified enemy defenses, take part in sabotage missions, operate heavy weapons, and fight across war-torn battlefields inspired by the events of D-Day.\n\n# \u2694\ufe0f 25 Missions + Training \u2694\ufe0f\n\nFrom massive frontline assaults and trench warfare to sniper encounters, tank battles, and airborne operation \u2014 every mission offers unique gameplay moments built for immersive VR combat.\n\n# \ud83d\udca3 Full VR Combat Experience \ud83d\udca3\n\n- Fight across beach, trenches, villages, bunkers, and battlefields\n- Use rifles, SMGs, machine guns, grenades, explosives, and heavy weaponry\n- Take part in armored assaults and intense frontline combat\n- Experience dynamic battles filled with artillery, air attacks, and enemy counterattacks\n\n# \ud83c\udfc5 Multiple Ways to Fight \ud83c\udfc5\n\nSeveral missions feature  dynamic battlefield events, making each playthrough feel unique.\n\n\ud83c\udfaf Prepare for a cinematic VR war experience where survival, courage, and quick reactions decide the outcome of battle.", "short_description": "Days of Heroes: D-Day throws you straight into the chaos of World War II. Survive intense battles, push through enemy lines, and experience a story\u2011driven VR shooter full of action and atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "supp
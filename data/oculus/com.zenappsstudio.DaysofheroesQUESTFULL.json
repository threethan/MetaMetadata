ohc=Zhf4tukOE6wQ7kNvwGO_KLi&_nc_oc=AdoBS8vnaAulUGhx8lV4HICWZkpP-P2Qk6iLo5dbT47jzkQ0SIwQoyuP-HpT-RsotiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVclVYliHaDHls8T2Ykoadvn7a8JEt2cyZVKpEYa3NFKQ&oe=6B0F19D4"}, {"file_name": "3.png", "id": "1552253702985729", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623443_1552253706319062_4383990735374818211_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMCPqMccobsQ7kNvwGE_ApN&_nc_oc=AdpaP76IBNK0XbXgh90doQa36dbGVjNiYg5h_MiCkYEwpI74VuGBLa0Pj-wtc1ff_HQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVW3zh2_t2yPmk5ogZ6vLkbGc-ESBLaXh6WTdYrhZrKhg&oe=6B0F1D38"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_2_.png", "id": "884497651327896", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303471_884497654661229_1055568266215561998_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCwG0wOeol4Q7kNvwFXHt0d&_nc_oc=Adon4y_NzpcVSYvv0Ua1FZnxFSRT9QuemBfmK5aiVF7hBh9BpO3RFIQpgEmTQ2x7Vpw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZJjhJosc5zV34ztySVHEm1957plYl54yB-MC0HysZkQ&oe=6B0F0197"}, {"file_name": "com.zenappsstudio.DaysofheroesQU-_4_.png", "id": "1471909817542340", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312257_1471909820875673_6361018781736377597_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6mwrQz9KL4Q7kNvwGhrIPS&_nc_oc=AdomPcH71x0HmrzBMxw4DM3gjkOzvXZ1xo4zoO0UTCx79xkwYRYuCuMz5AEeHaOgXqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUCO1YrKhy30tD-uCEdF4trH1yp6t0EPJCooDHTV6itrg&oe=6B0F02A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1377499137511821", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823940_1377499144178487_822249136997555259_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tugREf-_u0wQ7kNvwFAhQyx&_nc_oc=AdoMWiOFw-YyDXCxHeVOENCqp1K4C8kDBxEFhqXqnkf8ZeHvdu_eLuNQBf1yWbvfMiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW9LuQZ5lBcavWbGl6qVtMD1CePWa63tm9rz4sDuwguYQ&oe=6B0EF770"}, "display_name": "Days of Heroes: D-Day", "keywords": ["D\u2011Day", "Shooter", "FPS", "lowpoly", "War"], "long_description": "# Experience the D-Day Invasion in VR\n\n\nStorm the beaches of Normandy and fight through one of the most iconic battles of World War II in this cinematic VR action experience.\n\nSurvive brutal beach landings, push through fortified enemy defenses, take part in sabotage missions, operate heavy weapons, and fight across war-torn battlefields inspired by the events of D-Day.\n\n# \u2694\ufe0f 25 Missions + Training \u2694\ufe0f\n\nFrom massive frontline assaults and trench warfare to sniper encounters, tank battles, and airborne operation \u2014 every mission offers unique gameplay moments built for immersive VR combat.\n\n# \ud83d\udca3 Full VR Combat Experience \ud83d\udca3\n\n- Fight across beach, trenches, villages, bunkers, and battlefields\n- Use rifles, SMGs, machine guns, grenades, explosives, and heavy weaponry\n- Take part in armored assaults and intense frontline combat\n- Experience dynamic battles filled with artillery, air attacks, and enemy counterattacks\n\n# \ud83c\udfc5 Multiple Ways to Fight \ud83c\udfc5\n\nSeveral missions feature  dynamic battlefield events, making each playthrough feel unique.\n\n\ud83c\udfaf Prepare for a cinematic VR war experience where survival, courage, and quick reactions decide the outcome of battle.", "short_description": "Days of Heroes: D-Day throws you straight into the chaos of World War II. Survive intense battles, push through enemy lines, and experience a story\u2011driven VR shooter full of action and atmosphere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "supp
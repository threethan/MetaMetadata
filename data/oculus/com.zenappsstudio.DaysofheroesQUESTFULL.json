cdn.com/v/t64.5771-25/38982553_1366299433933655_3660907046079614245_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-cb1H-rjbQQ7kNvwFV194e&_nc_oc=AdrrK9pcC4XU9oC5eJdsmrXirdvETcJxfWh75yhaVoQjncqYz8nO7L8kua6hCGSDGbI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V5aIoAESh17AkhLiFQrHydu8PC95VsEsko2H5_U-Aiw&oe=6A3EA4C2"}, {"file_name": "38982586_141976484469299_3715368043751202176_n.png", "id": "876604477042038", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75334062_876604487042037_2373509080253734104_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa6Xvn0dts0Q7kNvwEsRl1g&_nc_oc=Adq2AGmdTrJmXmJ_1sOfxAdPG7ldNmtoemRpY905jQhkkKWNJxmMkV9hs-NKDdgGgDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-emYgKIpYgWvn6ilnvMVNquw9MXk91oPg855vo5QkZIw&oe=6A3E93C5"}, {"file_name": "38974538_2861249560757816_1771176779738542046_n.png", "id": "860866155092954", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035394_860866158426287_5830958412392023217_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cv8fWGYkibUQ7kNvwE4sEKx&_nc_oc=Adp3E_gDttJX5zI5K-sPHTchHPs-zjJQ_KB2ihOMuGxEtTJYCtqNmk3qBGbFrQkDbUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FeXHl0-tumPd82oh07thnFOWzGbq87u704Bs-kXFq8Q&oe=6A3E9B27"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1472371693246142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441580_1472371696579475_4686131202655945845_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5rYs0RFwRUQ7kNvwHFgatL&_nc_oc=Adren3NSlOZ3x0PTx54iC9EdWqPV4UmrhPQQD4YxSvGFcL8f-q54tBZA7u7kqrdI8xk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H54MwUceV8ls9HR_PJfQ3m2ZaodkPFSXpiOkyXTfSmg&oe=6A3E9C8D"}, "display_name": "Days of Heroes: D-Day", "keywords": [], "long_description": "Days of Heroes: D-Day have a two unique perspectives, experience the largest landing operation in martial history regarding the forces and means used. Take on the role of an airborne division jumper who descends into enemy territory to destabilize the enemy troops under the cover of night. Alternately, become a soldier beginning their heavy crossing of Omaha beach on D-Day.\n\nComplete diversified military missions, from short- and long-range skirmishes with Nazis, by employing anti-aircraft fire, destroying enemy tanks, and breaking through the trenches and escaping from a firing squad. Use over a dozen weapons typical to the World War II period that have been accurately reproduced in terms of appearance and mechanics.\n\nFinish the campaign and practice your skills on the shooting range, which offers four different gameplay modes. Once ready, try Hardcore Mode, which will take your cleverness, strategic thinking, and will to survive to the extreme.", "short_description": "Days of Heroes: D-Day have a two unique perspectives, experience the largest landing operation in martial history regarding the forces and means used. Take on the role of an airborne division jumper who descends into enemy territory to destabilize the enemy troops under the cover of night. Alternately, become a soldier beginning their heavy crossing of Omaha beach on D-Day. You can check free demo here: https://www.oculus.com/experiences/quest/3346478685453854/"}]}, "developer_name": null, "developer_privacy_policy_url": "https://szlufik.pl/daysofheroes/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Zen Apps Studio", "support_website_url": null, "website_url": "https://szlufik.pl/daysofheroes/index.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "p
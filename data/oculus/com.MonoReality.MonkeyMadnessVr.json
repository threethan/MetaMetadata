20f&oh=00_Af-xhC18A-JWzgQB-TC1w3RtX8TWiCnfasbPMRHzAQUVCA&oe=6A2184B9"}, {"file_name": "Screebshot_3.png", "id": "1284208960102474", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828842_1284208963435807_2473095023336806367_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1mPjBtRbwsQ7kNvwF9ZlCP&_nc_oc=AdpHRne1xlcKyX90ZidGhOVQAIHkSZUAXgXYiRAlIW0TQRfc4oQ99iXJXwA0PJttjbY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xOKI-lQvNj7pVMA0Jg1spDQnScLFXBYbRuKhJS0X6EA&oe=6A217BF4"}, {"file_name": "Screebshot_4.png", "id": "1222379709583774", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824592_1222379712917107_4253398076504614646_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sICn-ehQQ74Q7kNvwFnOYFG&_nc_oc=Adq3zuj_oVdtFlTtYEIx_ox1dd8dZ8JDmv45v1LiJubvm1R26iX6d9G969qSXh1yvcM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u1f5V7KzCMk7DwsGlJ9qL2g_2xCXpmm7lFI8nlBU8lg&oe=6A219547"}, {"file_name": "Screebshot_5.png", "id": "1146822227487310", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824609_1146822230820643_7799027971349767203_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoAubZnNJSoQ7kNvwGfVZMG&_nc_oc=Adqm-NV2AoS-W2IEXM5h_ay7eCDeFQy0omhtwNyg_OjVLNjUm-0ZKgv7LHKmQ3_XliI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I-KW4NcLf-8aDMes5A8WLUH-DYApymWdo0csYK1ANnw&oe=6A219A4F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Madness Vr", "keywords": ["Monkey", "Madness", "Gorilla", "Mono", "Reality"], "long_description": "Monkey Madness VR \ud83d\udc12 \u2014 The ultimate multiplayer tag experience in virtual reality! Swing, climb, and leap across vibrant, hand-crafted maps as you chase and evade other players in fast-paced, chaotic tag gameplay. Whether you\u2019re a stealthy climber or a speedy sprinter, the action is always intense and hilarious.\n\n\ud83c\udf1f Features:\n\nDynamic Multiplayer Tag: Join friends or random players online for heart-pounding tag matches.\n\nDiverse Maps: Explore unique environments like forests, canyons, creepy mazes, and colorful party rooms.\n\nCustom Cosmetics: Personalize your monkey with hats, faces, hands, and body skins earned through gameplay.\n\nSmooth VR Locomotion: Designed for comfort and agility to keep you moving fast without motion sickness.\n\nMonsters & Challenges: Beware of roaming monsters that add extra excitement and strategy.\n\nCommunity & Updates: Join an active community with regular updates, new maps, and fun events.\n\nWhether you\u2019re playing casually or competitively, Monkey Madness VR delivers endless fun and monkey business. Get ready to climb, tag, and go bananas!", "short_description": "\ud83d\udc12\u2728 Monkey Madness VR \u2014 Dive into chaotic, fast-paced tag in immersive VR! Swing through vibrant maps, outsmart other players, and show off your unique style with cool cosmetics. Whether you\u2019re climbing, tagging, or just goofing around, endless monkey mayhem and laughs await. Ready to join the madness? Let\u2019s go! \ud83d\ude80\ud83c\udf4c\ud83c\udf89"}]}, "developer_name": null, "developer_privacy_policy_url": "https://monkeymadnessss.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Mono Reality", "support_website_url": null, "website_url": "https://monkeymadnessss.weebly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supp
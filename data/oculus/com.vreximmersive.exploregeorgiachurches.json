sin11-1.oculuscdn.com/v/t64.5771-25/38974909_215466790015788_1368603367033801098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbeTH_QM2bUQ7kNvwGJBkAD&_nc_oc=AdoQfINKXcckhpmXbiRFML7qp9t8cW-jWLphImHwCAsKq8ave1JYfpf5KmoAkJop77Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mPz5T-Y4gbmOCse1na-xuHzGmDnFImcx3NzV1xa79zA&oe=6A22E84E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1065073830606108", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984443_1065073833939441_2167567861273226660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jH5GN1Qj0FUQ7kNvwFkdDc7&_nc_oc=Adqv3-fpFCouiKOtBCRhbih3Mup6KkP0qKidH1zFdnRG2WtC9tl3DvzcIrI3iv26iFQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9KhyIWCrGZlMmaGCTCnvHhtLbSTt2jPQg0O8JDHb68Q&oe=6A22DABE"}, "display_name": "Explore Georgia - Churches", "keywords": [], "long_description": "With this app you will be able to explore wonderful world of orthodox churches of Georgia. Christianity began in the 1st century. You can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \"Explore Georgia - Churches\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.", "short_description": "Explore breathtakingly beautiful orthodox Christian churches of Georgia. Experience Georgian orthodox churches. According to Orthodox tradition, Christianity was first preached in Georgia by the Apostles Simon and Andrew in the 1st century. It became the state religion of Kartli (Iberia) in 319. You will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.
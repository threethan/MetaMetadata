scdn.com/v/t64.5771-25/38974909_215466790015788_1368603367033801098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iipsKWzcCZwQ7kNvwF-3VSz&_nc_oc=AdpZDn3yd6nfMpPCXUAKMcR7KIVWuc7S84IUtVvQFOfbN-K82PtSRhvuLDQOLp8qV5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvGS6YMZ2_2canVvsq77dIN03RHjxFbqS7vKd1F2s7jw&oe=6AB7E1CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1065073830606108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984443_1065073833939441_2167567861273226660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBBXc6qcXY8Q7kNvwF-AAav&_nc_oc=AdqKk2_CjR1i2w6oUyikclYb7zW1Z3xNe0SCWGT_Nh6maRqAdJb_ACG01BB27MZ45CA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm12VwtwXBjWX_6OxtW75MmcCXGLiwp0eqBgW3uWK6Lg&oe=6AB7D43E"}, "display_name": "Explore Georgia - Churches", "keywords": [], "long_description": "With this app you will be able to explore wonderful world of orthodox churches of Georgia. Christianity began in the 1st century. You can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \"Explore Georgia - Churches\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.", "short_description": "Explore breathtakingly beautiful orthodox Christian churches of Georgia. Experience Georgian orthodox churches. According to Orthodox tradition, Christianity was first preached in Georgia by the Apostles Simon and Andrew in the 1st century. It became the state religion of Kartli (Iberia) in 319. You will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_webs
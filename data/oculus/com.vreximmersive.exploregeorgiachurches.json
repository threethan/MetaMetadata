scdn.com/v/t64.5771-25/38974909_215466790015788_1368603367033801098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYsHEsN9y48Q7kNvwHXLvyq&_nc_oc=Adp6nlsRVMKbjxWL6mp2wqvsiHm5MuFlOFo-7MBmsYbT6T1AaSMTVeynsAD3bVbG4GE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tNU0IOVr7g0-HcGTP_jkvuCZuRTSEK4Ilj_uHae7OAQ&oe=6A1AFF4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1065073830606108", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38984443_1065073833939441_2167567861273226660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dk3oWZ7AHWgQ7kNvwEDAsqu&_nc_oc=AdpKX__hBSCfiuCGzIS_67X99lfLirT-M29Ov3ct5JiMmf_X8hosKF6gan916jzvuJc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77EWX-TcSvzxFsyYr0CSSfHwpMma0IRLEqN3MH9IQjHw&oe=6A1AF1BE"}, "display_name": "Explore Georgia - Churches", "keywords": [], "long_description": "With this app you will be able to explore wonderful world of orthodox churches of Georgia. Christianity began in the 1st century. You can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \"Explore Georgia - Churches\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.", "short_description": "Explore breathtakingly beautiful orthodox Christian churches of Georgia. Experience Georgian orthodox churches. According to Orthodox tradition, Christianity was first preached in Georgia by the Apostles Simon and Andrew in the 1st century. It became the state religion of Kartli (Iberia) in 319. You will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_webs
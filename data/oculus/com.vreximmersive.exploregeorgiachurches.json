q7v4gleeY7ZJ1K1XVsgBQAYIXkNPJ06_9rDeoWSzjK4AqIs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXmUqb72Iap6VEpINyLX0LA1qT4G2UrDWZheNYOq5OhXw&oe=6B103E4B"}, {"file_name": "1.png", "id": "215466786682455", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974909_215466790015788_1368603367033801098_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6HP45GbOVUQ7kNvwGmHfsp&_nc_oc=AdpB_nWnFFPAkd-WQhHSTAakgcUOU3WKOzK8Dp6Y7zyT74V8StJZrdsCKk5PKjzBKKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU78v10YhKL-DAjGQiosxaJUEKgEVVF0b5jmYDNpGyYUg&oe=6B10364E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1065073830606108", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984443_1065073833939441_2167567861273226660_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQl6wZI1GD0Q7kNvwHNI5JJ&_nc_oc=AdpaNb0jO9n75i4TcxEA-kVtpXq4-Flg7jB2NHSrupSM0iNWwU2-xTmn4ri3EEztH60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVW1z6vY8hRKX2Tztl6co55KhGKUIjJdO2MGli_cKUsXg&oe=6B1060FE"}, "display_name": "Explore Georgia - Churches", "keywords": [], "long_description": "With this app you will be able to explore wonderful world of orthodox churches of Georgia. Christianity began in the 1st century. You can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \"Explore Georgia - Churches\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.", "short_description": "Explore breathtakingly beautiful orthodox Christian churches of Georgia. Experience Georgian orthodox churches. According to Orthodox tradition, Christianity was first preached in Georgia by the Apostles Simon and Andrew in the 1st century. It became the state religion of Kartli (Iberia) in 319. You will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25614046498195344"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974677_3576802559100707_628365676691629134_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-po3VpCsKv4Q7kNvwEk5DIB&_nc_oc=AdrOzYuL377gAth2qmLiRtaXWJjxSOKMoWonk61gXwv5w_jJydYh12HgUbfcTYtAkX4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYZ0wBvlXAfFxvZQVkTBknK9uAhMied7wvFQHTESYmhw&oe=6B106BFF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Explore Georgia - Churches", "platform": "ANDROID", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1607623310, "lastRevision": {"nodes": [{"id": "3946071695403692", "release_type": "SCHEDULED", "ad
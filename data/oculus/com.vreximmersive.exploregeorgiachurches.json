kNvwHoN9mM&_nc_oc=AdmfRbryuXcTPyynPLg-yCdo98bkUiYNq8sW7nULB2lQsAziS8Ycnnk8CkXMmjE9_gA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfveimczZP1LL0U00sNG9tEbr7EbCtvLNPRWjQTmSRK2HQ&oe=699C370E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1065073830606108", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984443_1065073833939441_2167567861273226660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqViVHBJGwEQ7kNvwFf7Mt-&_nc_oc=AdmIxaRB8eTpktHCdE9djvXgpt-tLU_30wNW--6xOiK_yQaO_8npjYXIARDuM01e590&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvzvSZC8BaJEVwM3wUwPOuFkHpZKbwTzG0KhrSZ8j-9wg&oe=699C61BE"}, "display_name": "Explore Georgia - Churches", "keywords": [], "long_description": "With this app you will be able to explore wonderful world of orthodox churches of Georgia. Christianity began in the 1st century. You can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \"Explore Georgia - Churches\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.", "short_description": "Explore breathtakingly beautiful orthodox Christian churches of Georgia. Experience Georgian orthodox churches. According to Orthodox tradition, Christianity was first preached in Georgia by the Apostles Simon and Andrew in the 1st century. It became the state religion of Kartli (Iberia) in 319. You will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_
98_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ6Pd64VJCsQ7kNvwGpp6BV&_nc_oc=AdoERImQbi7Aq2X77I_-3cmoBymPtB6l83j3KGL8GmlHgMLPfzulqvfbwxI83NtA2qY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ex2EuK7h4_Z33INJUu83WO_g6j2TacdKVkyyhASpyIw&oe=69F1E88E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1065073830606108", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984443_1065073833939441_2167567861273226660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfs6kFEqJ-kQ7kNvwFNRev_&_nc_oc=AdqiGxSzOmSGKku-3yFzppJc17djwUrF_5tF97xO92uP2gs6Z5hrpSJkPqGUq3dur5s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3VSJQDdp-tsfSogLPMwxooQm0CEAcn0I708Eipvs5wgw&oe=69F2133E"}, "display_name": "Explore Georgia - Churches", "keywords": [], "long_description": "With this app you will be able to explore wonderful world of orthodox churches of Georgia. Christianity began in the 1st century. You can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \"Explore Georgia - Churches\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.", "short_description": "Explore breathtakingly beautiful orthodox Christian churches of Georgia. Experience Georgian orthodox churches. According to Orthodox tradition, Christianity was first preached in Georgia by the Apostles Simon and Andrew in the 1st century. It became the state religion of Kartli (Iberia) in 319. You will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "
kNvwGCQdv5&_nc_oc=AdmqSl8dP-er0XcUrnMeUcS7TLBtW87X1TBvP_DMN0EZ76-AEpdgbKblk3w9-gadbE8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuL7x-yo8NZXj8s6O9XQAJGZMPfB9jf1qgKBUAWe54tNw&oe=69A5718E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1065073830606108", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984443_1065073833939441_2167567861273226660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXP0tJOENTYQ7kNvwGxLdZo&_nc_oc=Adn4D5BXihBEPEdTKVaOCxUXUvfUE3pw1ZpUbROrcB4YkppMrL8EbOB7WhTLf_C4AR0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv0lqmZrc7uuNsUOIkLQdk9oMAhgvNUwdNLcn3NVZc4yg&oe=69A59C3E"}, "display_name": "Explore Georgia - Churches", "keywords": [], "long_description": "With this app you will be able to explore wonderful world of orthodox churches of Georgia. Christianity began in the 1st century. You can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \"Explore Georgia - Churches\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.", "short_description": "Explore breathtakingly beautiful orthodox Christian churches of Georgia. Experience Georgian orthodox churches. According to Orthodox tradition, Christianity was first preached in Georgia by the Apostles Simon and Andrew in the 1st century. It became the state religion of Kartli (Iberia) in 319. You will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_
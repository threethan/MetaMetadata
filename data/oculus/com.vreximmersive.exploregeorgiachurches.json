scdn.com/v/t64.5771-25/38974909_215466790015788_1368603367033801098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKuCcZAHfOAQ7kNvwGeluvq&_nc_oc=Adq2ixDL54FnWVvo2y7793Ky2u-po-d3bL7hLlqvxQsJwyti0be6j6h7dUTiP2VN4eo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jvdjRqLEbgziUF9sOADpl97FbdV4d0UcJ_8w52jYqGQ&oe=6A3E97CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1065073830606108", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984443_1065073833939441_2167567861273226660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyT9zFOSIDcQ7kNvwFYqv3C&_nc_oc=AdoV8XExLqCPwy_WnkoOsyRpmXRc67DY3yAzLOvFhKh2_nokKZwcMDUXudTMKcxV1Og&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KK5np3AFGbWyEZ95D-uipT5ISEbtMGEbOfsTEHvz_jQ&oe=6A3E8A3E"}, "display_name": "Explore Georgia - Churches", "keywords": [], "long_description": "With this app you will be able to explore wonderful world of orthodox churches of Georgia. Christianity began in the 1st century. You can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \"Explore Georgia - Churches\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.", "short_description": "Explore breathtakingly beautiful orthodox Christian churches of Georgia. Experience Georgian orthodox churches. According to Orthodox tradition, Christianity was first preached in Georgia by the Apostles Simon and Andrew in the 1st century. It became the state religion of Kartli (Iberia) in 319. You will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_webs
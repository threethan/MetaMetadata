scdn.com/v/t64.5771-25/38974909_215466790015788_1368603367033801098_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM9DZBBHdroQ7kNvwGROzJF&_nc_oc=AdolQj3ivGosK4QPvzt0tQJu0iGs_tiw4khhSngTJfw8WHSMBd9uIlyLg6yjwnmGl1I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bPLY0yjUUpMzl7rrDosw7OJ4Wcq3B9fvpUgh18ZFEsQ&oe=6A452F4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1065073830606108", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984443_1065073833939441_2167567861273226660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33Db2QZ2St4Q7kNvwF93UsM&_nc_oc=AdpdDFqWSWhIVGVPcLO9sK2ROqdYmyMKg10qlmbe2uW-oYLkqaTJupFuRjjvCURU9MA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4uuQ0bNBz6yjxaCX_ajp9Ty95O9oxXUavCK6GkNqruw&oe=6A4521BE"}, "display_name": "Explore Georgia - Churches", "keywords": [], "long_description": "With this app you will be able to explore wonderful world of orthodox churches of Georgia. Christianity began in the 1st century. You can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \"Explore Georgia - Churches\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.", "short_description": "Explore breathtakingly beautiful orthodox Christian churches of Georgia. Experience Georgian orthodox churches. According to Orthodox tradition, Christianity was first preached in Georgia by the Apostles Simon and Andrew in the 1st century. It became the state religion of Kartli (Iberia) in 319. You will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_webs
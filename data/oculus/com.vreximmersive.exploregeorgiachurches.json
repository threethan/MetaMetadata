kNvwHqjD35&_nc_oc=AdkDWaUIxgwbEGVbTIXGJOLlSoPrfGYJumbO_GEJVQHyFi22XhE3z60iLytZ1D5HmaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvj_rTBduraEHGzCVY86WD8b-1-8G1-aEwplMgdLv8zGA&oe=699D888E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Edited.png", "id": "1065073830606108", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984443_1065073833939441_2167567861273226660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqViVHBJGwEQ7kNvwE_ZvoJ&_nc_oc=AdlTzZ2E83S3RMZnfNN8FYehnf7-yzvO9-hIKKkrAk2q1PNVQY0KFvvtu2sy_ZnLDU8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDzOyg1CuEGuvHcfEur0DNMzlRkp80TyT3hCt2MUBsGw&oe=699DB33E"}, "display_name": "Explore Georgia - Churches", "keywords": [], "long_description": "With this app you will be able to explore wonderful world of orthodox churches of Georgia. Christianity began in the 1st century. You can experience destinations listed in this app at your own pace. Just gaze over the waypoints in front of you and start exploring. \"Explore Georgia - Churches\" app was created and published by VRex Immersive. Our mission is to help travelers worldwide explore destinations and tourist activities in VR.", "short_description": "Explore breathtakingly beautiful orthodox Christian churches of Georgia. Experience Georgian orthodox churches. According to Orthodox tradition, Christianity was first preached in Georgia by the Apostles Simon and Andrew in the 1st century. It became the state religion of Kartli (Iberia) in 319. You will be able to navigate through the amazing Georgian churches by simply aiming at the menu items and waypoints you see."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vreximmersive.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VRex Immersive Inc.", "support_website_url": null, "website_url": "https://www.vreximmersive.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_
 2.png", "id": "1116654366158278", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974794_1116654369491611_8628146508245785768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpiwTB1G7vsQ7kNvwGVRDmT&_nc_oc=Adq7xXfkFA4nGrRaH-NbEcl8RKlu-4it-yxELX3r7lEsXSJ5eL3UC8DTs5vfehhB6eQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6PecGS2DiGlw9uWPvoQeknVAYmjfs-5VIGBuqST63UQ&oe=6ADF7725"}, {"file_name": "Snapshot 3.png", "id": "1055720439066709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_1055720442400042_7951480561239104259_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17EJNenuNKQQ7kNvwEgPDHc&_nc_oc=Ado-d4wR2KZ5M1Eia2Cqi23Pwcwg1nUlBz69AnmgiWyWncWAMovUGVYAMlmf4-l_rwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKIXbj_7OzZLlRSD5ASpnkRxE_mwOrEk165QTCOGouRw&oe=6ADF56A9"}, {"file_name": "Snapshot 4.png", "id": "2269485996737844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_2269486000071177_2651540224801535034_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV0ARAjlniAQ7kNvwEUtnSF&_nc_oc=AdpQ7d_JLwZdpuOlRyWkYCuYsS-zMuPU0oGkR_QmLBVGY8kYVQxQUZQ0bZ642SLLDlY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZ5uNN2of7BrEUqagQRmolHLFFDTwUx1mXJ7krsxjWVg&oe=6ADF5B04"}, {"file_name": "Snapshot 5.png", "id": "2126249524404914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974831_2126249527738247_3614109709092099997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPyyrS8qAr8Q7kNvwF8OR3Z&_nc_oc=AdpuUCz5j8jr9GtGQk8rinxC2WPI-Eu91FqvF21mBL7oHaWX3jPewFjoMdFVOEYpUws&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKbbAlTXnsGyjEUPB11vZ_YPNibcaj6CSw7X2jssGMgQ&oe=6ADF73B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape---2560x1440 (1).png", "id": "382586184382173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982705_382586187715506_6226358718878880379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOSTlYoT8jMQ7kNvwE-87yZ&_nc_oc=AdoxqF_jhHN0ovIfgt8RxSD4VPkYUIHYvAtK6HASyxTVhST3-WEQKEgDayjMWNZbXJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlmz3LsFHQf5kIw7I4DoqTqXzxUm9lCYRgp3650THYSw&oe=6ADF5889"}, "display_name": "Linde Virtual Academy - Express", "keywords": [], "long_description": "This application is offering a sneak preview of what the Linde Virtual Academy (LVA) is all about. Get the chance to see a Linde gas process plant and dive into 3 small scenarios that provides an overview on what LVA is about.\n\nThe Linde Virtual Academy is a state-of-the-art online training platform that combines expert knowledge and virtual reality technology to deliver immersive and effective training experiences for professionals in the gas processing industry. The academy provides access to a wide range of online modules, interactive 3D simulations, and multiplayer sessions that enable trainees to learn and develop new skills in a safe and controlled environment. The Linde Virtual Academy aims to enhance training quality, safety measures and optimize operational efficiencies in the gas processing industry. It is designed to accommodate a global audience and can be accessed from anywhere in the world.", "short_description": "This application offers a an easy to access preview of the Linde Virtual Academy.\n\nLinde Virtual Academy is an online VR training platform for gas processing industry professionals. With immersive learning modules and multiplayer sessions, it enhances safety measures and operational efficiencies. Globally accessible, it provides a safe and controlled training environment for learners."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.linde.com/privacy-notice-for-linde-virtual-academy-express/", "developer_terms_of_service_url": null, "publisher_name": "Linde GmbH", "support_website_url": null, "website_url": "https://vr.linde.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
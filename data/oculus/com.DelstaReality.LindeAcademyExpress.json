46508245785768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWwab1bqxagQ7kNvwFbLgUB&_nc_oc=Adrmpu4XWZAjaLRNmyMvF4fPjCkPY35LCofF6QpNAJl9QUz6Ijj6NHgHt6rWltdK2t8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3plMrOCa7ArBmpuO6tzdX1h3sNtuaZylHnqTO9gq6r8Q&oe=69F88865"}, {"file_name": "Snapshot 3.png", "id": "1055720439066709", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031437_1055720442400042_7951480561239104259_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3ZRIjDhlC8Q7kNvwEJBEF3&_nc_oc=AdrrFgCuatuKC3VKrVw10GnVBxZyQ9ReyKIbqBJVnikBHklXx7IF7CR9J9DkzW8A2g4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ezbj94sHwA9pBwuEsqOIEsScXr_Ex7TrERVHcJLWZMA&oe=69F8A029"}, {"file_name": "Snapshot 4.png", "id": "2269485996737844", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974444_2269486000071177_2651540224801535034_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaW4m8wthq4Q7kNvwED1h4D&_nc_oc=AdrjhD7Q6WSZLWwDt5vQOjVjLIX-fJRjI2iJONRfZ5ZXNA7rdzZdItrqaZXpaiyXSbU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3oe3IJPmk0RaPMDjC7RpL-5_1LzFEfGB2QzD-K6B6A8g&oe=69F8A484"}, {"file_name": "Snapshot 5.png", "id": "2126249524404914", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974831_2126249527738247_3614109709092099997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_33aJuhpmZAQ7kNvwHVIaXl&_nc_oc=AdpFA322F74qGhY-iClrtYVJvR8hGLmU4Y1MPOVI-E9GgvXo5Pcu1eqgG1qOzQVK3Jw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3t1YyusO7pWXExiUP8pWMJV2YicePgYNXPfU-YujsfsQ&oe=69F8BD33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape---2560x1440 (1).png", "id": "382586184382173", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982705_382586187715506_6226358718878880379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqRIQZa2Wf4Q7kNvwGqrvGp&_nc_oc=Adq7Y3jBraSpTu0NjysZhktYnnnmR9kj2nZz7JX9d7fx9gT2ChYL2AlGlnL76C7tz8c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3u6zz0yj4TTd5-TepTe0t7ZKsj6jbE8MgrT5x2AwcCQA&oe=69F8A209"}, "display_name": "Linde Virtual Academy - Express", "keywords": [], "long_description": "This application is offering a sneak preview of what the Linde Virtual Academy (LVA) is all about. Get the chance to see a Linde gas process plant and dive into 3 small scenarios that provides an overview on what LVA is about.\n\nThe Linde Virtual Academy is a state-of-the-art online training platform that combines expert knowledge and virtual reality technology to deliver immersive and effective training experiences for professionals in the gas processing industry. The academy provides access to a wide range of online modules, interactive 3D simulations, and multiplayer sessions that enable trainees to learn and develop new skills in a safe and controlled environment. The Linde Virtual Academy aims to enhance training quality, safety measures and optimize operational efficiencies in the gas processing industry. It is designed to accommodate a global audience and can be accessed from anywhere in the world.", "short_description": "This application offers a an easy to access preview of the Linde Virtual Academy.\n\nLinde Virtual Academy is an online VR training platform for gas processing industry professionals. With immersive learning modules and multiplayer sessions, it enhances safety measures and operational efficiencies. Globally accessible, it provides a safe and controlled training environment for learners."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.linde.com/privacy-notice-for-linde-virtual-academy-express/", "developer_terms_of_service_url": null, "publisher_name": "Linde GmbH", "support_website_url": null, "website_url": "https://vr.linde.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
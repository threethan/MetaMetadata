0f&oh=00_AQTwAHFjp9ALhIH2d8A4Id0XVBoxdPQvTGpWBRg_qcaZEw&oe=6AFDC633"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape---2560x1440 (1).png", "id": "382586184382173", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982705_382586187715506_6226358718878880379_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfjdrnAnhnMQ7kNvwGUaXEL&_nc_oc=Adp7FZdYhN31EzR_CdAOSkFL060RhS9QNlznl9xxrGkZenpyuhM83yux6L074bALBZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqI3AFXN2KvfTa8Tkc00SdAr5w9taf6fHuTm8IPg1DLw&oe=6AFDE349"}, "display_name": "Linde Virtual Academy - Express", "keywords": [], "long_description": "This application is offering a sneak preview of what the Linde Virtual Academy (LVA) is all about. Get the chance to see a Linde gas process plant and dive into 3 small scenarios that provides an overview on what LVA is about.\n\nThe Linde Virtual Academy is a state-of-the-art online training platform that combines expert knowledge and virtual reality technology to deliver immersive and effective training experiences for professionals in the gas processing industry. The academy provides access to a wide range of online modules, interactive 3D simulations, and multiplayer sessions that enable trainees to learn and develop new skills in a safe and controlled environment. The Linde Virtual Academy aims to enhance training quality, safety measures and optimize operational efficiencies in the gas processing industry. It is designed to accommodate a global audience and can be accessed from anywhere in the world.", "short_description": "This application offers a an easy to access preview of the Linde Virtual Academy.\n\nLinde Virtual Academy is an online VR training platform for gas processing industry professionals. With immersive learning modules and multiplayer sessions, it enhances safety measures and operational efficiencies. Globally accessible, it provides a safe and controlled training environment for learners."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.linde.com/privacy-notice-for-linde-virtual-academy-express/", "developer_terms_of_service_url": null, "publisher_name": "Linde GmbH", "support_website_url": null, "website_url": "https://vr.linde.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24764344939880161"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1049187720395893"}, {"status": "PUBLISHED", "id": "7554090047958932"}]}, "baseline_offer": {"id": "7554090047958932"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1049187720395893"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27533461966301764", "version": "2.15.14"}, "id": "947453276795025", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24635128052801851", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27533461966301764"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "947453276795025"}]}, "change_log": null, "created_date": 1732013548, "id": "275334619663017
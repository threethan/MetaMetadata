_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFT521VgmmqdN3f_b7ElhmxEo4eWh-y3JvqdvhK3IcqA&oe=6A8D9B89"}, "display_name": "Linde Virtual Academy - Express", "keywords": [], "long_description": "This application is offering a sneak preview of what the Linde Virtual Academy (LVA) is all about. Get the chance to see a Linde gas process plant and dive into 3 small scenarios that provides an overview on what LVA is about.\n\nThe Linde Virtual Academy is a state-of-the-art online training platform that combines expert knowledge and virtual reality technology to deliver immersive and effective training experiences for professionals in the gas processing industry. The academy provides access to a wide range of online modules, interactive 3D simulations, and multiplayer sessions that enable trainees to learn and develop new skills in a safe and controlled environment. The Linde Virtual Academy aims to enhance training quality, safety measures and optimize operational efficiencies in the gas processing industry. It is designed to accommodate a global audience and can be accessed from anywhere in the world.", "short_description": "This application offers a an easy to access preview of the Linde Virtual Academy.\n\nLinde Virtual Academy is an online VR training platform for gas processing industry professionals. With immersive learning modules and multiplayer sessions, it enhances safety measures and operational efficiencies. Globally accessible, it provides a safe and controlled training environment for learners."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.linde.com/privacy-notice-for-linde-virtual-academy-express/", "developer_terms_of_service_url": null, "publisher_name": "Linde GmbH", "support_website_url": null, "website_url": "https://vr.linde.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "5140877
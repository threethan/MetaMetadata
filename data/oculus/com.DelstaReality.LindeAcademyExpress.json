46508245785768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WbjB26Z6NQQ7kNvwFgD1S0&_nc_oc=AdoK4SpZ3HLXtnGeLml00MECBJQG3P2BonsE_LoipRLCy3UaCkI5SaTJo0w3E18gt64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmShaoYC867MV-R2wMgykDIDk49mO4asRm02p70mv2lw&oe=69CE5865"}, {"file_name": "Snapshot 3.png", "id": "1055720439066709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031437_1055720442400042_7951480561239104259_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UX-BnYvPadsQ7kNvwGXWdwq&_nc_oc=AdqJf8LB3sE6tTOMcmaQnS2oWPBQj3xZdP-9uLStG2FILAdl_Tmer3SJROo_TBRsXkk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8xx4-fCyzyJcehcTPzdAgd2gxmjXJQMcbRVgssao4FQ&oe=69CE7029"}, {"file_name": "Snapshot 4.png", "id": "2269485996737844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974444_2269486000071177_2651540224801535034_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCA943QJ30QQ7kNvwGCPudX&_nc_oc=Adrk_p7OmkyO3j0Aom3IEYKHt6yBto3nsKCefmp6yeI4RAb0k_f6Z3pZqh1My5SeFW8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw75GYHuTS1XDjsYCD-NZmtREthbrJxWlSuYYIlrt8JzQ&oe=69CE7484"}, {"file_name": "Snapshot 5.png", "id": "2126249524404914", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974831_2126249527738247_3614109709092099997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57RVHFXjt1wQ7kNvwGOcGoo&_nc_oc=Adoz4pos6Ky3cPjPgnan-QQd7KsOVvRhFZRXjBe-4pF71sFlPslCrl0GIP6ELj8mWt4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIUjMK2UlqKRU7LYhXxIO_Z8mwXqveUFQMhmFUb6Qfvg&oe=69CE54F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape---2560x1440 (1).png", "id": "382586184382173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982705_382586187715506_6226358718878880379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJQubR84bHMQ7kNvwGVd1sX&_nc_oc=Adp75sKSPbYJld4GD0aO3X-GWYeG-o-ELOmwl54pJhXfAJ-tOnyiVgjAT85CaLikwrY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx7qiBt6NZKp1lo3jUEQIkhgzTGmNZockXAatUqhVYlmw&oe=69CE7209"}, "display_name": "Linde Virtual Academy - Express", "keywords": [], "long_description": "This application is offering a sneak preview of what the Linde Virtual Academy (LVA) is all about. Get the chance to see a Linde gas process plant and dive into 3 small scenarios that provides an overview on what LVA is about.\n\nThe Linde Virtual Academy is a state-of-the-art online training platform that combines expert knowledge and virtual reality technology to deliver immersive and effective training experiences for professionals in the gas processing industry. The academy provides access to a wide range of online modules, interactive 3D simulations, and multiplayer sessions that enable trainees to learn and develop new skills in a safe and controlled environment. The Linde Virtual Academy aims to enhance training quality, safety measures and optimize operational efficiencies in the gas processing industry. It is designed to accommodate a global audience and can be accessed from anywhere in the world.", "short_description": "This application offers a an easy to access preview of the Linde Virtual Academy.\n\nLinde Virtual Academy is an online VR training platform for gas processing industry professionals. With immersive learning modules and multiplayer sessions, it enhances safety measures and operational efficiencies. Globally accessible, it provides a safe and controlled training environment for learners."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.linde.com/privacy-notice-for-linde-virtual-academy-express/", "developer_terms_of_service_url": null, "publisher_name": "Linde GmbH", "support_website_url": null, "website_url": "https://vr.linde.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
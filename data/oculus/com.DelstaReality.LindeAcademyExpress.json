46508245785768_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nu7WR3IEfuAQ7kNvwEnjYXh&_nc_oc=AdpjjQ3MKC9HuzcUsYLc4vgwu9SaiHNFd1sl7P0hlYR2T2QjLxWMF3ygVL9_uhDuXC0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h4uiPKzI-yT2C-aZSSm68E4EIu1Uo5nzZD82m2WF3bA&oe=6A1B07A5"}, {"file_name": "Snapshot 3.png", "id": "1055720439066709", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031437_1055720442400042_7951480561239104259_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fpaARA0vmB0Q7kNvwHyQUwl&_nc_oc=Ado0GRQdMJqPQBbqv13BC3kQPcQSo8GSbJojTobYshbdXan7601_sMW280ebzRI5SjI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43EuO563IQe-LPce7qwiJrxNpE1rNuP7v38hDsnBTw2w&oe=6A1AE729"}, {"file_name": "Snapshot 4.png", "id": "2269485996737844", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974444_2269486000071177_2651540224801535034_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfQDpWG8_YoQ7kNvwG8IGZQ&_nc_oc=AdrnLDvpf8VPgMprA2czfgFEwnGseZgxjhcza0REtNzvBLvmNvlUasLcvVjYiEJjDKk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WUCKaPU2ZSJnkod9VLDabKJr02L2Bhw5KA6UiCHBWBw&oe=6A1AEB84"}, {"file_name": "Snapshot 5.png", "id": "2126249524404914", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974831_2126249527738247_3614109709092099997_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZzKuXbRo-MQ7kNvwHsEa1m&_nc_oc=Adop5sk5ZXfNk2wj_OXFfGeXSrDjBhLCdFMRNIqAcotok1kruoCnq6naRO1ivbh08SM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bXlYbLuhWamtEs_BdqfBD1X5Zu7g9U510nv8BWMYK3g&oe=6A1B0433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape---2560x1440 (1).png", "id": "382586184382173", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982705_382586187715506_6226358718878880379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvuW5SNHijAQ7kNvwF9SV8j&_nc_oc=Adouk75Y5iy3rFqjHu_151zjMSAPDNqe-ZLKFXKDbIgIqU0eznU1rfgLoxOku6s9wEo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6U-e8Ly_Ml9O8rsrveqGytD4zgvqKMShgmd4TcbrifRQ&oe=6A1AE909"}, "display_name": "Linde Virtual Academy - Express", "keywords": [], "long_description": "This application is offering a sneak preview of what the Linde Virtual Academy (LVA) is all about. Get the chance to see a Linde gas process plant and dive into 3 small scenarios that provides an overview on what LVA is about.\n\nThe Linde Virtual Academy is a state-of-the-art online training platform that combines expert knowledge and virtual reality technology to deliver immersive and effective training experiences for professionals in the gas processing industry. The academy provides access to a wide range of online modules, interactive 3D simulations, and multiplayer sessions that enable trainees to learn and develop new skills in a safe and controlled environment. The Linde Virtual Academy aims to enhance training quality, safety measures and optimize operational efficiencies in the gas processing industry. It is designed to accommodate a global audience and can be accessed from anywhere in the world.", "short_description": "This application offers a an easy to access preview of the Linde Virtual Academy.\n\nLinde Virtual Academy is an online VR training platform for gas processing industry professionals. With immersive learning modules and multiplayer sessions, it enhances safety measures and operational efficiencies. Globally accessible, it provides a safe and controlled training environment for learners."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vr.linde.com/privacy-notice-for-linde-virtual-academy-express/", "developer_terms_of_service_url": null, "publisher_name": "Linde GmbH", "support_website_url": null, "website_url": "https://vr.linde.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "
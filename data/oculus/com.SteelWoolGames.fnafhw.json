tps://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75422391_627026591237197_8578724097082387584_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFsBmLZ979wQ7kNvwGkdmOo&_nc_oc=Adp8yipFQUlgk838_F4flFnuNXdMAlD6TZN8wMTTjbli_pGaB6aBZYn_o74TU643lE8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YlICRHLZAA2zE-DmhW3Xo8EnyN6xgGhBk1vrA1qlRpg&oe=6A394440"}, "display_name": "Five Nights at Freddy's: Help Wanted", "keywords": ["freddy", "robot", "survival", "horror", "jumpscare"], "long_description": "Five Nights at Freddy\u2019s: Help Wanted is a virtual reality experience for the Oculus Quest. FNaF: HW is a collection of classic and original mini-games set in the Five Nights universe. Survive terrifying encounters with your favorite killer animatronics in a collection of new and classic FIVE NIGHTS AT FREDDY\u2019S\u2122 experiences. \u201cWhere fantasy and fun come to life!\u201d\n\n\nYOU\u2019RE HIRED - Repair claustrophobic ventilation systems, troubleshoot broken animatronics that could activate at any moment, or spend your evenings cowering in the nighttime security guard office. \nCELEBRATE - Confront your favorite killer animatronics including; Freddy, Bonnie, Chica, Foxy, Springtrap, The Mangle, Funtime Foxy, and Circus Baby. \nPIZZA PARTY - Scenes from classic titles have been updated for an immersive VR experience including;  Five Nights at Freddy\u2019s, Five Nights at Freddy\u2019s 2, Five Nights at Freddy\u2019s 3, Five Nights at Freddy\u2019s 4,  and Five Nights at Freddy\u2019s: Sister Location.", "short_description": "Five Nights at Freddy\u2019s: Help Wanted is a virtual reality experience for the Oculus Quest. FNaF: HW is a collection of classic and original mini-games set in the Five Nights universe. Survive terrifying encounters with your favorite killer animatronics in a collection of new and classic FIVE NIGHTS AT FREDDY\u2019S\u2122 experiences. \u201cWhere fantasy and fun come to life!\u201d"}]}, "developer_name": "Steel Wool Studios", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "ScottGames", "support_website_url": "https://www.steelwoolstudios.com/contact", "website_url": "https://www.steelwoolstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3015125065399881"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "597803571255577"}, {"status": "PUBLISHED", "id": "528857238741003"}, {"status": "PENDING", "id": "939589140587068"}, {"status": "PENDING", "id": "3454527221534385"}, {"status": "PENDING", "id": "564658665654983"}, {"status": "PUBLISHED", "id": "893270511712774"}, {"status": "PUBLISHED", "id": "124744029732128"}, {"status": "PUBLISHED", "id": "501084411470951"}, {"status": "PUBLISHED", "id": "945532792720646"}, {"status": "PUBLISHED", "id": "1562490437431226"}, {"status": "PUBLISHED", "id": "1972233816297360"}, {"status": "CANCELLED", "id": "993044854646026"}, {"status": "PUBLISHED", "id": "384999439270910"}, {"status": "PUBLISHED", "id": "5514105438643066"}, {"status": "PENDING", "id": "542173801443613"}, {"status": "PUBLISHED", "id": "1288123818778474"}, {"status": "PUBLISHED", "id": "1355621254631369"}, {"status": "PUBLISHED", "id": "784671399418258"}, {"status": "PENDING", "id": "823399342509567"}, {"status": "PENDING", "id": "993196951711130"}, {"status": "PUBLISHED"
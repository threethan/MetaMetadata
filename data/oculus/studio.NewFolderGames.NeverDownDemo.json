WeSqnw59xmwnB3tDMRDA&oe=6AFC6B0A"}, {"file_name": "4.png", "id": "1283515489001962", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75458096_1283515492335295_3912643504712603920_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLDe9557Fb0Q7kNvwECYb4V&_nc_oc=AdrQWlNepkS8FkopjDPflcZRmTP9qwUCWohy3wo-n1F0qfPqw9NLkI38575ablnP-FI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTHGQCIg6k653t29OfeN324WrCXRDsER_oxRZDiiSWBQ&oe=6AFC8432"}, {"file_name": "5.png", "id": "1332951514239284", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974551_1332951517572617_7246402249940206267_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfHXuUUP3e4Q7kNvwGOqoNg&_nc_oc=AdoOu3Ne-_CxGiC49Prhf7bBpMcKVdE9Dt5WTOq4nRVBFlm_bbKl-NmyqI5bGx1skNo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfOwNoNHwdR0b5k-wHR3cdcWQ1qSvO-HpSsu9kVJ8gIA&oe=6AFC6A38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 never down.png", "id": "249064817920034", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035395_249064821253367_515865525793692077_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1q8-BHE1RAQ7kNvwGNjliW&_nc_oc=AdozUjWL2nTM9REHqerpeqPnL-lVYdmEKDZyPieaINaEahOr5SPVe-DFtLgrarsiR4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnzzKvBIXW5YmRqZIfySxV8OUDmHdrIoYPqzfo5D8UWQ&oe=6AFC7DC5"}, "display_name": "Never Down", "keywords": [], "long_description": "In this addictive game you have to climb up by jumping and pushing off the floor. You need to be fast and agile to get to the top. The game offers many levels of varying difficulty that will allow you to upgrade your skills and become a real climbing master. In addition, the game has beautiful graphics and sound that will immerse you in the exciting world of the game.\n\nIn this game you will test your climbing skills. You must jump and push off the floor to get to the top. The game offers many levels of varying difficulty that will allow you to upgrade your skills and become a real climbing master.\n\nYou will experience a real adrenaline rush as you climb walls and jump from one platform to another. The game offers many unique tasks and levels of varying difficulty that will make you feel like a real hero.\n\nEnjoy addictive gameplay and become the best climber! Don't miss the opportunity to experience real adrenaline and become a real climbing master!", "short_description": "Try to rise above the rest and beat the record!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "657951082901139"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1134733717544227"}]}, "baseline_offer": {"id": "1134733717544227"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1690393766, "status": "PUBLISHED", "id": "1134733717544227"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6955249927919330", "version": "1.0.9"}, "id": "600816335554256", "chan
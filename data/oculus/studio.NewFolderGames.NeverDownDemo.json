_nc_oc=Ado3wYD4uc5_5hjRJl5lV2P4L53_XKZja8qGGF2CFw2oaboVbGJWW8z7t6zNozFkJ3Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeY76t-9BO8w7A6K7tssnqyE-g-qr9iDzJbL5k8YJXow&oe=6AE4BCC3"}, {"file_name": "screenshot_00001.png", "id": "1277529756282261", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982461_1277529759615594_6231929584456893384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5qnAJbGK9AQ7kNvwGTy7Iu&_nc_oc=Adod2LMBDLJp730z3_b_tLrLsnvyn3a_7JNwgCl62d-H7uybRG4NFeOd-rVkoyCjqB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLKYJ8KpqmQDa69_PFy1RPTyZss_FKQr5zaShucgAP1g&oe=6AE4958E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 never down demo.png", "id": "646662994251094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974732_646662997584427_967387807271410904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3_cIKdw_FMQ7kNvwHcbZME&_nc_oc=AdrGM_TLPtc33M6b4YnX3-uJDGMxIVHnUAy2tzAM72PPv3fdn81n35m_lW_t-5kd8zo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt51Zho1Q5sKWL7v2w_WpZVSCingKvllsncIM4wQorNA&oe=6AE4B467"}, "display_name": "Never Down - Early Access", "keywords": [], "long_description": "The game is completely FREE, enjoy and wait for the update! \n\nIn this addictive game you have to climb up by jumping and pushing off the floor. You need to be fast and agile to get to the top. The game offers many levels of varying difficulty that will allow you to upgrade your skills and become a real climbing master. In addition, the game has beautiful graphics and sound that will immerse you in the exciting world of the game.\n\nIn this game you will test your climbing skills. You must jump and push off the floor to get to the top. The game offers many levels of varying difficulty that will allow you to upgrade your skills and become a real climbing master.\n\nYou will experience a real adrenaline rush as you climb walls and jump from one platform to another. The game offers many unique tasks and levels of varying difficulty that will make you feel like a real hero.\n\nEnjoy addictive gameplay and become the best climber! Don't miss the opportunity to experience real adrenaline and become a real climbing master!\n\nNEW SOUNDS AND MUSIC WILL BE ADDED SOON!", "short_description": "Try to rise above the rest and beat the record!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24404038149280571"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974635_696095299242528_1260612326310729642_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKJKYn_v_hAQ7kNvwHyx4Wt&_nc_oc=AdqrzdYSl1S5RKKHDwBgYzMbCpiR4D8-CxkTiv9IXA200YXocSwAeafmouwzkOfvdBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM-4CGHjl-hPPUAutB-qEdhVQYCfdwGP--BVBHj56VaQ&oe=6AE4B2C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Never Down - Early Access", "platform": "ANDROID_6DOF", "context_category": {"cont
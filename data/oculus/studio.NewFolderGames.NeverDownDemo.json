3C4tYuuHwvVzMw0j9fOSTKzi1q1pjFr9MsROhXxOJb6MQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO902xQ1B186ZQ1n9P1zXXUwXKY-puAp1jTKZr-E7wd2w&oe=6ADCC638"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 never down.png", "id": "249064817920034", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035395_249064821253367_515865525793692077_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNG7arEA3I8Q7kNvwHQ3eUy&_nc_oc=AdqzoRe3J1kMKHo8BXLhdx6zhFmLmaMgt9K8tIKURnM3sguGT-_AfOn6ogZXWv4Wr8M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPFwOW8wcru8d7M4L1Jhx_XY6RGXyAJj6tgmKsnvIlHw&oe=6ADCD9C5"}, "display_name": "Never Down", "keywords": [], "long_description": "In this addictive game you have to climb up by jumping and pushing off the floor. You need to be fast and agile to get to the top. The game offers many levels of varying difficulty that will allow you to upgrade your skills and become a real climbing master. In addition, the game has beautiful graphics and sound that will immerse you in the exciting world of the game.\n\nIn this game you will test your climbing skills. You must jump and push off the floor to get to the top. The game offers many levels of varying difficulty that will allow you to upgrade your skills and become a real climbing master.\n\nYou will experience a real adrenaline rush as you climb walls and jump from one platform to another. The game offers many unique tasks and levels of varying difficulty that will make you feel like a real hero.\n\nEnjoy addictive gameplay and become the best climber! Don't miss the opportunity to experience real adrenaline and become a real climbing master!", "short_description": "Try to rise above the rest and beat the record!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null,
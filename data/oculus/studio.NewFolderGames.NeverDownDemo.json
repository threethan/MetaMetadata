ss=7f20f&oh=00_AQMB_9MnX260GofFbg9pl25V6J3bNVm6e1dvd0O1ZzRH9A&oe=6ADF76C3"}, {"file_name": "screenshot_00001.png", "id": "1277529756282261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982461_1277529759615594_6231929584456893384_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiQDAwuN7uYQ7kNvwGNMQ34&_nc_oc=Adr3pWoDeaVo3JYw6e3Cf6a2cCVLjBsasjFvtAuD0vFnU0Sl74D9rXUd-vIKKZbnlhE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMGMLSFVOh7wOvjOy1F0D-S07w9KWnWQ656qn1SLHOlw&oe=6ADF4F8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 never down demo.png", "id": "646662994251094", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974732_646662997584427_967387807271410904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTYtYa20OK8Q7kNvwFdIrvW&_nc_oc=AdpIoLMPwCV80kvet4er7cmOXR0yX_NDmVA3R7YMEYicCWk-OEZFd1bzvkRlTzeZVUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOF3IFcIjtI3HqF8TqayvShShw0ZF7w2g76F9PXDjB8XQ&oe=6ADF6E67"}, "display_name": "Never Down - Early Access", "keywords": [], "long_description": "The game is completely FREE, enjoy and wait for the update! \n\nIn this addictive game you have to climb up by jumping and pushing off the floor. You need to be fast and agile to get to the top. The game offers many levels of varying difficulty that will allow you to upgrade your skills and become a real climbing master. In addition, the game has beautiful graphics and sound that will immerse you in the exciting world of the game.\n\nIn this game you will test your climbing skills. You must jump and push off the floor to get to the top. The game offers many levels of varying difficulty that will allow you to upgrade your skills and become a real climbing master.\n\nYou will experience a real adrenaline rush as you climb walls and jump from one platform to another. The game offers many unique tasks and levels of varying difficulty that will make you feel like a real hero.\n\nEnjoy addictive gameplay and become the best climber! Don't miss the opportunity to experience real adrenaline and become a real climbing master!\n\nNEW SOUNDS AND MUSIC WILL BE ADDED SOON!", "short_description": "Try to rise above the rest and beat the record!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy-policy/meta-en", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24404038149280571"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974635_696095299242528_1260612326310729642_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKfq6j4eMusQ7kNvwGSaN39&_nc_oc=AdoXvDJIgTy07D6SstjVzIQj9RxmNs_4RX0AdIENGJS0IxeJnAU53rsjBgUVbMvv_oE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF0G6mw50K_pf2dl8Ew31gTPTjXZnGY3XUL-HfN9V2lg&oe=6ADF6CC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Never Down - Early Access", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"to
ng", "id": "2192188388294496", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822568_2192188391627829_5144241556982283884_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNpKZVayR9AQ7kNvwGW_t58&_nc_oc=AdpeDn73Eu36jCBQyCR1s18NTbzaq2B5cWwAiCgOlfTc3e-BDtGC9DCz_B_dMrWoMDk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm7VT-qgIjkKBlNz-gPzktwpwJw7y1LufHg40VNL5hbg&oe=6ADF625C"}, {"file_name": "Image Sequence_014_0000.png", "id": "969668179419366", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499627043_969668182752699_6158007705644321129_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9hjsVXzDwkQ7kNvwG2jcck&_nc_oc=AdrL0aGVdgGc7JFAk3aFdBcd4g7r_2araeoU_8N7tFjp6BF5IdmzdLNPh60ros_ow04&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4jxc3z-d8p9V5hNUZahwW7jNQjiJaz_VWdQ6ge5vDiA&oe=6ADF6D9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circuit Smashers", "keywords": ["CircuitSmash", "Gtag", "Robot", "Roblox", "Gorillatag"], "long_description": "Circuit Smash is a fast-paced VR multiplayer dodgeball arena game built for Meta Quest, where survival comes down to reflexes, positioning, and knowing exactly when to swing.\nDrop into the arena with a group of other players and face off against a single relentless, homing ball that locks onto a target and won't stop curving toward them until someone gets hit \u2014 or someone bats it away. The ball tracks its target with genuine intent, adjusting its trajectory in real time, so standing still is never an option. Dodge, juke, duck behind cover, or take the aggressive route and swing your bat to send it rocketing toward someone else. Every deflection ramps up the ball's speed, so early rounds start manageable and spiral into chaos as things speed up \u2014 what starts as a lazy curve across the arena can end as a blistering line drive with almost no reaction time.\nMovement is built on smooth, physical locomotion, so getting around the arena is as physical as the swinging itself \u2014 real arm movement translates directly into real momentum, both for traversal and for how hard and how accurately you can deflect the ball. A well-timed swing isn't just a tap; the speed and direction of your actual arm motion determines where the ball goes next, rewarding players who commit to real physical movement over players who just wave a controller around.\nRounds are last-player-standing: get hit and you're out for the round, teleported to a waiting area to watch the rest play out.", "short_description": "Circuit Smash is a fast-paced VR multiplayer dodgeball arena game built for Meta Quest, where survival comes down to reflexes, positioning, and knowing exactly when to swing.\nDrop into the arena with a group of other players and face off against a single relentless, homing ball that locks onto a target and won't stop curving toward them until someone gets hit \u2014 or someone bats it away. The ball tracks its target with genuine intent, adjusting its trajectory in real time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://auzzitech.wixsite.com/auzztralian-technolo/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Auzzitech", "support_website_url": null, "website_url": "https://auzzitech.wixsite.com/auzztralian-technolo", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER"], "id": "1147370268470551"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822355_1035326732354409_3485431821605562820_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkIYhsiW2W8Q7kNvwG3jkUz&_nc_oc=AdoRvVVwrTC9UuPZMxZ_UH8JtRS-vnok8u2AZ1qCyMXL8KH4jkpHmKHC0-3gYKIABeM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3JDfQFW8Cd8g_VAF7FcS0U0fQMeSI7mdu0W3I1BqEEQ&oe=6ADF644D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Circuit Smashers", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1784587320, "lastRevision": {"nodes": [{"id": "1147370275137217", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1147370258470552", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1314965247350525"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "2879922455674662", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314657_2879922459007995_747069774939603432_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_Culall0IgQ7kNvwEGuDyX&_nc_oc=Adp3gsAwwt4Sk09LWsIt6yBp3MB4-OpGFiECkfIeDeCkCLLNXpQocLGwns8W_EDWMls&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-v5B8-uyOoyrVafJStQMVVUBneAWtj0L6evApP9G42Q&oe=6ADF766E"}, {"file_name": "9cd4127c-1568-4c55-aa88-8b8fca911a03 (1).png", "id": "2135949086970913", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.
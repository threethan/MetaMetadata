60ros_ow04&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4jxc3z-d8p9V5hNUZahwW7jNQjiJaz_VWdQ6ge5vDiA&oe=6ADF6D9B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Circuit Smashers", "keywords": ["CircuitSmash", "Gtag", "Robot", "Roblox", "Gorillatag"], "long_description": "Circuit Smash is a fast-paced VR multiplayer dodgeball arena game built for Meta Quest, where survival comes down to reflexes, positioning, and knowing exactly when to swing.\nDrop into the arena with a group of other players and face off against a single relentless, homing ball that locks onto a target and won't stop curving toward them until someone gets hit \u2014 or someone bats it away. The ball tracks its target with genuine intent, adjusting its trajectory in real time, so standing still is never an option. Dodge, juke, duck behind cover, or take the aggressive route and swing your bat to send it rocketing toward someone else. Every deflection ramps up the ball's speed, so early rounds start manageable and spiral into chaos as things speed up \u2014 what starts as a lazy curve across the arena can end as a blistering line drive with almost no reaction time.\nMovement is built on smooth, physical locomotion, so getting around the arena is as physical as the swinging itself \u2014 real arm movement translates directly into real momentum, both for traversal and for how hard and how accurately you can deflect the ball. A well-timed swing isn't just a tap; the speed and direction of your actual arm motion determines where the ball goes next, rewarding players who commit to real physical movement over players who just wave a controller around.\nRounds are last-player-standing: get hit and you're out for the round, teleported to a waiting area to watch the rest play out.", "short_description": "Circuit Smash is a fast-paced VR multiplayer dodgeball arena game built for Meta Quest, where survival comes down to reflexes, positioning, and knowing exactly when to swing.\nDrop into the arena with a group of other players and face off against a single relentless, homing ball that locks onto a target and won't stop curving toward them until someone gets hit \u2014 or someone bats it away. The ball tracks its target with genuine intent, adjusting its trajectory in real time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://auzzitech.wixsite.com/auzztralian-technolo/english-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Auzzitech", "support_website_url": null, "website_url": "https://auzzitech.wixsite.com/auzztralian-technolo", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER"], "id": "1147370268470551"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2040725540150017"}]}, "baseline_offer": {"id": "2040725540150017"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784587320, "status": "PUBLISHED", "id": "2040725540150017"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1200591899815054", "version": "0.3"}, "id": "1028147986282504", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicat
dn.com/v/t64.5771-25/491825462_1550070092903882_3522358332193667762_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyQ0BI2gF2IQ7kNvwFXLuLX&_nc_oc=AdlkKXTjWqp9mIPI5A1sqGi-m31R5HS72Dru8sICYTNPLgwRBz4DxhSrB7Gxe-99ryE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvszVQeSod69iY_xRQ7RbHOkiiya_eTLfYHWE7ofatZEw&oe=69A2C83C"}, {"file_name": "10.png", "id": "850692057748523", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820887_850692061081856_2839646391553669632_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKW0YhnAdJIQ7kNvwGh5E5W&_nc_oc=AdnJmfn32d0_9sc3sCfrQYEKwC4ICIs-E5q5aU0nZMAPFvVkH8NsokS0sfLHACBLhHE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEPDgzzUjgc3KnWWqjO-r-J_BfwqY7auiRMSVvDBhrbg&oe=69A2F616"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Battle Arena: Fighting Heroes", "keywords": ["FightingGame", "HandToHand", "HandFight", "PunchingGame", "ArenaFighting"], "long_description": "Enter the ultimate VR Fighting Arena and experience hand-to-hand combat like never before. This game brings classic fighting gameplay\u2014similar to arcade legends\u2014directly into VR with smooth joystick controls, combo buttons, and responsive character movement. Punch, kick, block, dodge, and chain powerful attacks as you face enemies in dynamic arena battles.\n\nMaster a variety of martial-arts techniques and fight against unique fighters, each with their own style and challenge. Whether you\u2019re landing heavy strikes, timing perfect counters, or executing special combos, every move feels immersive and satisfying in VR.\n\nChoose your fighter, train your skills, and rise through intense stages to prove yourself as the champion. Perfect for fans of VR combat, martial-arts games, and action-packed fighting experiences.", "short_description": "Step into the arena and become a true VR fighter! Use joystick buttons to punch, kick, block, dodge, and unleash powerful combos. Battle skilled opponents in intense close-combat action and master martial-arts moves in fully immersive VR. Feel every hit, improve your skills, and rise to the top of the Fighting Arena!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25111435061840471"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820428_1249128793698604_7710336989687949354_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1D84ShOvdFQQ7kNvwFQljl7&_nc_oc=AdlQzU-ia7wLv0cjtrP96yjvwOhiL5OWHakO3-Bw02VFKwmmyQN-8ZtTdYGLO7_pVR8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvk0o7tmQNn_9HlpNW7-m5siOvu-lEc9gWiGVm35-SoNw&oe=69A2ED14"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Battle Arena: Fighting Heroes", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Sports", "id": "277654228600060
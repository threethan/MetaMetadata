sid=6e7a0a&_nc_ohc=AmpOfrLXt0QQ7kNvwHK_Va5&_nc_oc=Adq4F-F6-CTg6IRUbJ1NTflZuE4Qepbv2cYq4a5SZO14u7wlLx-XzYZiRbzPd73BlH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEO2j8VI34frZLpQEkW9Agu82hBzW7B-3dH4EJo6e7jQ&oe=6AB7E1F1"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GClVVxOluUIQ7kNvwGrEj1Q&_nc_oc=AdqOe5BBAF6LbJNbxN5N2kktdJo7UZo2i9w7wmLaiRShFTQbsuXN__VlM25WQUO4ef8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUC6VEsR2O3ke1rznZuwt0G-w0XvfpSAmdSR69lxWc2w&oe=6AB7C69D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJLGixvL_R8Q7kNvwH-L2OE&_nc_oc=AdoX6qrVFaGzezAkPrQOZqFGb4WZwZW0MyGVLBLk-cez_vqx1WZzpoDcCYBV7uV9Y68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-pZMghS9myb5hP3yP1RoF6Mu1P96YXkYi5mlhszFxXw&oe=6AB7EFC6"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtnG3XjRrQYQ7kNvwEXiE0v&_nc_oc=AdrHd2FDooOuDFEA1ICj1p9iwz2DIKbxQ64XWFkE1l_k1f98-3_shjZmi7uc8Uvv_0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0YJxEz6y6OHtAe2hFoKjnbQfKHM8R8TZz8lLky77x1Q&oe=6AB7D3F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
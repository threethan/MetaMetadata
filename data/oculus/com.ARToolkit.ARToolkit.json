sid=6e7a0a&_nc_ohc=pjPXrflBdhMQ7kNvwEiuUjq&_nc_oc=Adp8MLX_CvHYEaTtSML7YUWgq2PmtHNcy_b8OzNXSg999DJAAxQ6Ry8BHdBGYY_JKhg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a24u9OOjJclWF0XU4r-fAIdND3J96f5OLkMGmsGkq3A&oe=6A3E97F1"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5WIUGncYzIQ7kNvwE9vZxS&_nc_oc=AdqptL3fla4Ty0ktflImIMsTfv9Wl0-4iLHHdADlYrvy5UmYZbRAddSSVvWH498npqU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xzRz7f77XjSz0yS4Xq-XmPZTKs8Vh0NfcKK0Te6GErA&oe=6A3E7C9D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PO0jy9p-WdsQ7kNvwE96vAe&_nc_oc=Adqfdrt4besEBixyNlA-6KOYs3VMgLPNwYZ6Ymdgfl6Afkb-sQz4NdXoULBcMAs8mUI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r7zOx24rJe8kLWxWaPrYvjTwyHb8N760zTYIFv_Sdjg&oe=6A3EA5C6"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3G1XrvQ86EYQ7kNvwE2AvGb&_nc_oc=Ado31boXFTf-D_Blo0UIxwpcO-xUnWv-qjU8qe4pBNnsogWGMQjE5FwukQjSJf2nxzc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6DTxeAFAR_Dl2NONC4ML6o_ev_Lb6qJ7n1X-jqQEoIg&oe=6A3E89F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
kNvwF9Ycru&_nc_oc=AdlfMb4WJlWpcq4crraxz3o3bfuCKuhvH_NQpAtmZggMsdE8TEy1u1fFtzlDk0RFC5w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxsrFU-M78QMsiOLMNz3byuE6iCgBP1g1DEY5YRErkDBw&oe=69B3F231"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Zh2GQhzNjEQ7kNvwGsb8QO&_nc_oc=Adm_UYN8pxk5aq7syTxxh5Rc5y_eCsyR9PxqdFukILGG4KatxHM3ugo31sHkBT3WwNI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw8gxBPduxWYn4_AIf-wnD-eNdl5RFqhFTSV_3CBski5w&oe=69B40F1D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RJy0OklvGkQ7kNvwFajYx6&_nc_oc=AdmsM0nBPJq9mbB2PsB8EaLEAnOKVfYZCp_ZD1VGwo9UDLXDTtJ5MnmNZI3qSPumKbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzpeGJXsWG48Wco7MiIAn8GjVsuH--uhLswpyFPGAlx_Q&oe=69B40006"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHwTHSz92iwQ7kNvwE_1Uus&_nc_oc=AdkBv_a_3LtBixdSL5uhFkB9ybhqUdhgeVoNrB8vOuH19YJ0aQRrFkGyySN_CRLwyo4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRGlftuMeDjYekfghccJ_4Q5-LM4sTozLGKCktDugQtw&oe=69B41C78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
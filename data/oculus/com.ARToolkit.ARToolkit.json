sid=6e7a0a&_nc_ohc=th5pSyAfqQcQ7kNvwFcINM3&_nc_oc=Adrwl8QZkhxv-AuPgiGq9V9NXpGP_XVKCq6apUJFzfDPaUZees4xQrJW1ZNdghGy12E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNelmloPspnNghWeULA3kBgqpqbhpY6WAAHzZFDNR0W9Q&oe=6AC3BF71"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQ4Bnsm0zTkQ7kNvwGWw0fy&_nc_oc=AdqDaW9kOH7kZovXQAV44DXsrTC4zWdw4J_70oHebDRzkrenSCgCJoKIXnVJPX3rDlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFko5n9R1csjo4S8R9-4ypcH3Oq72VTjk62kdOtdkLLg&oe=6AC3A41D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZmZOXKUrlEQ7kNvwG2ak0X&_nc_oc=AdrDx1oYQlnc1riYwWyE_NkRra9Ir2kKrGBjcGOj5lY3nmuSdBXNHPfaQJ3-d7DkIMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr4P6_ua6hpVhrQMFyhXulK8FUdUSpzPGwg4CZlt_H_w&oe=6AC3CD46"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksYSfmAWLCYQ7kNvwHsT3ry&_nc_oc=AdqMB8RHtqJJJyOrXoVxsrBHrRZBklfzbTtLbwoIfWSwtNCX2GP-lftlDIdeDtTsz-Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy1g_MrSF9meHouwkfdKDpHkmXpCtppsySKlEZnl2Y9g&oe=6AC3B178"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UR6_7FXjIWcQ7kNvwEsoSLc&_nc_oc=Adpa4DCLS-41ApFzmXmn1H1YaDqNoTygF8Kn0P9R1ZHQvfakxcR0ZmGaGlOEKB_Oic4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX60ZYKldtwRiClZNhJcvz2yOoqEmH8ss2YsH9ZGBscQ&oe=6A8D79B1"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1C8cnAS04oQ7kNvwHJO5ED&_nc_oc=Adrn3FcfOVcflDALKptmfYYMg3HRXGRJZD_2mXTjxF58rLMaogCSOQIdgs9s_ObqDDA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoGV-V7prjgkhN4GbmOx08ok5R3ZkYeOyskE6wZFpFbw&oe=6A8D969D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fVJz2gh3-gQ7kNvwHVBVD9&_nc_oc=AdqBAOMA0iD5Gjr__ld2vXL-RB_T7Ue2PYXbiwytUnRH-9fCfTR65Nh3R7SBkmc9Xqc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaW8d2UGC8cy7cFl5Pdy8QohoufRDlZGfja0aHG0gUqw&oe=6A8D8786"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoEW2iset4AQ7kNvwERI8es&_nc_oc=AdpeF08YX4EMxkfj004xOMjLwXXWVFXwJteSRBsnZf6xA18kBathFYf1nBVUm8mzvYk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtiUh7BjD_mWRfk4BgOF__WHf-bQ0Dk9Vko2D0hGEI0Q&oe=6A8D6BB8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
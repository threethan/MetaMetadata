MYhWk4zVSsDp0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuM9thfwZBQLSmDtuzcOsML7_ilN_3ghak14vbSkXwhGg&oe=69A571B1"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Me5cVBXthngQ7kNvwEiNc7F&_nc_oc=AdkihVx36hrq67buprglawG6W7vfypiR9W5eMoPndF4vNdr10MWWFBzViDZX0TQL6rI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afut4j1PhvTmRgBPvjUMxwt4ay2Nq9XThRNhlqiLXWL-XA&oe=69A58E9D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsvjanQDczEQ7kNvwHWD2_y&_nc_oc=AdlkxbiNcq7C_M7Ql9zcS-liHD0EtzSmBRS-fGu4JvjY_vpKiTNGacxfMC2YClydxDo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftPJJBC1vjkHSEh3PFoR785iN0T-4pDzfRKf7NgkDfsUA&oe=69A57F86"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-DejXeZXzsQ7kNvwFVgmZ_&_nc_oc=AdmZFrTH4H3ZOm1nO-p4cM2mMHKz5gvwx3uK-VG-JBJRoSv_WE5law5JlPw1theV8jo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsSRfgTGJ9eP-JbP-LnKsPUi55YZpCtmhGXsTv6oUYFGA&oe=69A59BF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "
b=1-7&_nc_sid=6e7a0a&_nc_ohc=MmxaPbhAQvsQ7kNvwHtF2Eg&_nc_oc=AdozvbBR1XIHLHyMndSbTX1qtB9qZCgf7TcLMQMJo6uViS_YP_SmaqggYE6aV9m5Y_M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aHvYOMOkytCpvIaoH4EoCVcKab_qV1kYeyzAjkaK1TQ&oe=6A4680F1"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNts_8YDjvkQ7kNvwGkyMFo&_nc_oc=Ado8gUmCsJL_hDFIrDgjRN78QyHQfRpvbNhilzwbfyFBN6T8sghY5mqp_jDp0-yywIE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DAt_r6U3KHQrKhsMpy8NiJxu8hlZqWhf-flKjqeqPKA&oe=6A46659D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9G2sE5SKC6wQ7kNvwHM7ZMs&_nc_oc=Ado_gJfk8IVXBdgdzn7x9JCenaFdELp1j0kxZgOHO1en7I8SZ55yOJtcQyz3DrocsO0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Efw79-8o8bhr0G2UjG1fQALtepJaN677N88XPbt1xrA&oe=6A468EC6"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynU8w5QK-xoQ7kNvwHtz5gT&_nc_oc=Adp6HCiBJciTUyg0jx5F8MPxTfGiR1gwyJ8UrfPsRfAlETo0GDo8BWztYA56AQkdljA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dc_NHaNpgkccfobGWUQPkcUMz-ytuGcfkXII74jYLdQ&oe=6A4672F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "re
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlZo1li5HsgQ7kNvwHjL0Zn&_nc_oc=AdrK_2ocRsDF8-B8_A6c6ECdnMC2qXX6xUNHkCx4Rd789kFp2LnQkISaAlDmEHqdI_M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8qcOrbJbWNcMorfLVg_JsBgzzobV-eZVszER_lJuhXQ&oe=6A8ECB31"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1C8cnAS04oQ7kNvwGMWku9&_nc_oc=AdqSAPIbmt86iZ19bG-bkcC9M11KLxZQ9s3o4bNrjgAJ_uUKJvZIlOxnzGupe1yn08M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHvEiccvKiH9qvUQD4oiis7FdDwxakrOQKONI55VfkmA&oe=6A8EE81D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fVJz2gh3-gQ7kNvwEtlwT_&_nc_oc=AdrvQIveT7TpDX-wZwOz7Q_6iyiD-3ysjq2KX1voaMY8j1c_UWxQQYK5-xST3K6AyjE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnqJSjMeWJK_h2KGAMRiUzxufgSeA0MnltKFWr7zD4Gg&oe=6A8ED906"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoEW2iset4AQ7kNvwFriC4y&_nc_oc=Adr0wyQnO-EFKqpKvNSOwLcIXaJo-pa3vQesw26ibEUlVmjEF9hKdrGKyRaeA5fgHWw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnOnxRIs-Xi99y3K01eq92TftIinGQUCfWJ1gi22YviA&oe=6A8EBD38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
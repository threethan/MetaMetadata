&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kY9YmK2VUuEQ7kNvwEkG-Vx&_nc_oc=AdrnIc7E6urLtzi-j-6ZSiNwgrRY7aQxl6Jmh_vHm-v-VlvFCUjuCeMJ6yfhVmH8Akc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmmBkYl2WHBKF76v_qVmhx4OdU8N07GdkR0fLbbgEJIQ&oe=6A8590B1"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WK3K573v8zUQ7kNvwEj8F2I&_nc_oc=Adq22GUIvbzuSKZDzFckg-C57cv2HC41wIVs1EhMyF6EWVn6EAeJIl8FwH8N40dyxNY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH10-_neOa09MJkxfPMJrETxcPyQIafi-vN0ZgRgvGqrQ&oe=6A85AD9D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xzte-LcCbdMQ7kNvwFQF3uV&_nc_oc=AdrdxGdcYH1-4doQTT9yNTFsQvmu8qh5n0urKHKMcMavo2QGHpsWWjIVenWZk1hyWbs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiGGWO_BCg9CZ0Z5-0RX6LiLzQyc8upNctzM0MmX1upA&oe=6A859E86"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_ulsK8Ig7kQ7kNvwEZufbX&_nc_oc=AdqUuLQI4AUWI4NoVKefMNxOZ6j4ioiSgdcDgAFxiWmJKC1orCsDAppDj72RfujtJEk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOcNjBgkXRg0pO4bI5B-0mA3veKJ2hS601DQeX98zVDA&oe=6A8582B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": n
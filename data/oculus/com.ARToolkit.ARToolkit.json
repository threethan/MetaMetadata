6B1044FF"}, {"file_name": "screenshot4.png", "id": "1311881396606315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391890_1311881399939648_7465705297778564273_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9Zi54Ie9QQQ7kNvwGmIppM&_nc_oc=AdpZ3S39NvwzyhvxTQsDMtDtYel56rHYBuew2_fY0RokleMgkH6Virv61I42bDeapkc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVukY-1XE9iQVWY4P2pkLqmc8-kH6Mw7TyBZrDHWkm9Hw&oe=6B103671"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4CRy9JCza4Q7kNvwHgabCV&_nc_oc=AdqyC1W5ur5KWR-AKHNhY5zsrxFYb6AdaHqmlg2dgnRyK-grD4LzUgFScNo2td7MLOA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU9zzyVsYb4yxmZlT6DLdNtHYLr32GZU22kLR17eir5lQ&oe=6B10535D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM_scgG-h3IQ7kNvwEPTeaq&_nc_oc=Adp0wNPH2CjshESbX9X2_ZgoJQJSBjf1S-AmHrYZWS2x1vCPS912hvQko5FdUUrMBPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWF2lnhqMCbTWA1eMDT-YmCZMUafzHhpyBVgO-jjYHNOg&oe=6B104446"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oazS0yUlqsQ7kNvwFVJhZD&_nc_oc=Ado_HOs7EeDxk9r32_Lo0yhiBqa3p-jjdlmThDeYzbNFZ5Rhp504RG0cN3qd3DphrE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXYjfoQv8RLiu3tZDDE3xHqZfXMYeb_SiS8DnZ79mNNDA&oe=6B1060B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "3626
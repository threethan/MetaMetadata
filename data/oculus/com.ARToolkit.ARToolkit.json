fZ6zeVdKxyaJZE6TdOPrNNqgHPxs5mopTVsvma5mWZLoPSLK62m67r50A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dp90PgForJmWwvjvexD7jkEd6iKAYAH2r2lu2RMMnmQ&oe=6A33F09D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN2W-oiCV3oQ7kNvwFBbY-O&_nc_oc=AdoJtoxSTuA4azzf7NsU_6o2TnhavVSW4l7_HUYWQBCuLSWe0jKjC8FsJf7U308el2E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MNiZkil1H8yx-uAp-RtNWQ1iTqHvPEoVuKVw95E23Ig&oe=6A3419C6"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKB7qcOxx9MQ7kNvwEYrH0n&_nc_oc=AdrEjmom28IMwkKvZhpwjXsMnzpKE0L4q-rUoJ1oMbljQF5QHZ4dGIR6t05RHgE1WfU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_s4Eg7EaN6ETVXDLg5w-eWSH8BY14SdHoNL2eqeRXLg&oe=6A33FDF8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28592493583730693"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1285932825864392"}]}, "baseline_offer": {"id": "1285932825864392"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739899860, "status": "PUBLISHED", "i
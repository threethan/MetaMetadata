6AFF217F"}, {"file_name": "screenshot4.png", "id": "1311881396606315", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391890_1311881399939648_7465705297778564273_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMOoQ53nfHMQ7kNvwGHuxng&_nc_oc=AdqqzQbZtO3CbNV0eusmXFJZOnGah6Uei84aJhdUwrDWNW1rvCJw9JmSIXvIe_l4VKY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRY9R1mY_8CbrOZywbBLSmwNIraE32Gw-_b9yWqolauHA&oe=6AFF12F1"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciYYWa8leUAQ7kNvwFzp979&_nc_oc=AdpJLxGt4R08vqDy2S9_vr5LNE4gwuq9iJOxxrYK0zzpP4nVRSymJFgF-PpDPj79onM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyzLUd1o6Ad7suTASKwJW-aP8SSvyxDEH8S4tEbypMHg&oe=6AFF2FDD"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGxVGkeTLkMQ7kNvwEPJ5pl&_nc_oc=AdpeJBiqCRhCcPUUmMLYH6ArjKg1xPXgmEjs5tL7-MaRa_nMVFLmwapL7JRHlzlx-Z0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfjETzghobfOlr3dIzQMXSEUrqaQg5YXkGfC3vu59oZg&oe=6AFF20C6"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-kVUPoGp3sQ7kNvwHjatQt&_nc_oc=AdrFRYhsuJrlQhhZsD9kwws6fv2-0kSnaDu63zKaD5UXkLlRMH8elezMhZ3ok2pWc50&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdDZYVfEs9B7pRjSmhksrGPtujduJc55577lqXFTJZMA&oe=6AFF04F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "3626
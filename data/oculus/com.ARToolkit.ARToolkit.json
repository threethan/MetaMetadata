05297778564273_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEQIh7P9y3EQ7kNvwF9-TzV&_nc_oc=AdptYNlxdiw1ch9yFhooM7vonRuOv8nVP2jBUml_Z0erN6PUC1sbJtne-UYsoOo75r8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaycjdHN08CfwTkooyw5BzSdUJfnm1OkmW891gZmPvdQ&oe=6B06FBF1"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5149rkXV_ZEQ7kNvwHpJFBf&_nc_oc=AdrzeEytDKD_zUzcGECJU5QrMKzdy0HO-WLvF1x9ZDWCNPN8_2mNxIE85X1shua3S5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUJawDJbfDH1yKR77S1Pb72SjUID8vIGAVTYUnM43Yig&oe=6B0718DD"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUnk132OnRgQ7kNvwHsXtR9&_nc_oc=Adr5co032SR9a6LeUdwN-nG20B5FHMjy7tihUYHJXZJQ4NpjRPOIJw61a5xUeFAx0cU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeZjgLG4NULIVt_aD4XAsjjWbvH1Hf1h0k1H8dWQqCHw&oe=6B0709C6"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORiDgRKCP_sQ7kNvwHM_dB2&_nc_oc=Adr7FBwcb6mB0vm0IX6pLTq3kjT3LcfENGWPVUJ_OcHFz62xlbvtohOGuqqsPqsVkd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkRCnOjMvnk22RvHSMmwUcpVC_R_ygAwfF-rMd8iISQg&oe=6B072638"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_a
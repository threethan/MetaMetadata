sid=6e7a0a&_nc_ohc=LgIU5L8jkrsQ7kNvwE13BiU&_nc_oc=AdqZwjTTlhQfdUaGqOc-8fuhqZTo6hJsnt8v7rB05KdnLn3LbCwUS5XB97PlOsoV4zg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt-gDgNG7m1F9fUJmNuaawSN04syzRZL3L7rjs1vIqog&oe=6ABD27F1"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEaVDXmtLOIQ7kNvwFwV5m7&_nc_oc=AdokzFHmnPZY-vW6sHYKoOgMvrBVI13YTB_SseV2sdN7ncnADv-0yK7eh5VrU-_TFmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9Y3w6kGD2dFu-pOPtM3i7_0got3dmkuBbisMIeRe_tg&oe=6ABD0C9D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiCXTWEhTAUQ7kNvwHrX5-S&_nc_oc=Adrll9J7FG-cDd4aaDBL5QGVoxeKJ8eKrrR5f2G3GsXCaiKemjHZfVGmh9zcP0DQwIs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJU-s5hNCTYSO3Vz4GoCPorVNXzwy6rmSPBotLe54PXiw&oe=6ABD35C6"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zE4YBADSTMQ7kNvwENKcRR&_nc_oc=Adp3DQofzE0K7RpXoWkMbFyJVqwT_N8qEsDmBeUsvIcCHG-Cx9_nFPtOTRQG1G-8sHQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhnFOZ-hWbRBJZe2mBPEot5F_upyS18YvCszYpZG2QCA&oe=6ABD19F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
6AFDCFFF"}, {"file_name": "screenshot4.png", "id": "1311881396606315", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391890_1311881399939648_7465705297778564273_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FMOoQ53nfHMQ7kNvwErelu0&_nc_oc=AdqLcjRRW59cpnLKc5Gg4nBPJKe7NDC95gfHt_HhoLb4YlC4qpumjj-7rBS38F4vnWE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV0rC5sE8XZxRrRWfs33yAImB73yM921M5yBqr6t0OEg&oe=6AFDC171"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciYYWa8leUAQ7kNvwFf7CEq&_nc_oc=AdrpqBahpEgXYKC2mjKJoXo4ys3f9kZTFsU08DwCUp_BkmAvjxgFo90Zu2Nvgga70X8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDCn80N3PY8yHT2gSg7F3jUIukzXM4pP4o5L-CQk7nGw&oe=6AFDDE5D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBan1aO8JB0Q7kNvwHMQdvM&_nc_oc=Ado38NugfJ781OoHySgesY6lv29gUHaZqZEiDRip3jNtTTXJxoTVGLLv8jRZHhBlteI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFTuET7QptPcv_RWKtJVLKEol6e9TZ1u9W-oK_oLpIVw&oe=6AFDCF46"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-kVUPoGp3sQ7kNvwFoALkS&_nc_oc=Adpwco-SzutRw13ekVjr3Hn9KxJRF-JOSizwsxcVdO7nc1ZpLUmIZc04FPCRJUkQRSM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ50NdJyG-2GStLZSeWeiX-Gdx30zu05KwdRGCgIUeSCw&oe=6AFDB378"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "3626
6B05B8FF"}, {"file_name": "screenshot4.png", "id": "1311881396606315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391890_1311881399939648_7465705297778564273_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEQIh7P9y3EQ7kNvwGWbn3P&_nc_oc=AdpnvrWCAIuqq3A1upE_lNyt1GYt0yyJKkxjp_XU_fLhvggdSNpd4wXflCeCeFOrFvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTnyAUubu4LWR5zrqgK2aJSiINqwoV2fTHg7YpD7y-Qw&oe=6B05AA71"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5149rkXV_ZEQ7kNvwHJZA_s&_nc_oc=Adpit_k08R2yNruLxH_dbFLq9WmIKtHokujwm4Gs2udqbjTsTMQZOZ4RpxicXed1BZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNk7I4A7WQRYnwYcGtFs3LGH0F40rnS7u2P3RH8w39JQ&oe=6B05C75D"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYNaojVPK44Q7kNvwHq0iy3&_nc_oc=AdqUZw2VfOVw6-Bl4cOhvs4NKwT21R1xeo4ZF41RfQumPSSh5djQuoaUQrOcxjdY7ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT812T72yQSi9yXRfDSgR6R4anCZY-q0TVb0XLmWg4hUw&oe=6B05B846"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrtnbAoPElYQ7kNvwFGEP1j&_nc_oc=Adojct68M-vbYgK9KHsF_WMU3n1ot5-IvuzDOV7gIadf5sJ3OWhDXc9EZBQ2CBCsyPk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3VP4vTonMffkrNsKztHefncTEHdMsyyFNisN5qDGhBg&oe=6B05D4B8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "3626
6B0EF37F"}, {"file_name": "screenshot4.png", "id": "1311881396606315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391890_1311881399939648_7465705297778564273_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9Zi54Ie9QQQ7kNvwHJ-mRf&_nc_oc=Adp4IhRhFbG7be-wAjh6ny4xdq3r06ZLf70cJ4wX3Dxct7sBhacMs_H6G7gdR98YT5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWjK8jPy1QpIaj8gi359bUVPE8An2AspjtbwgUH9Kg-fg&oe=6B0F1D31"}, {"file_name": "screenshot3.png", "id": "3695883413967491", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391924_3695883417300824_2187456992037417636_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6CFdCR69cIQ7kNvwHBtZu9&_nc_oc=Adr5f9Hg_TLpqM8MJgxan5KILfKaT4boLc6emR8CR0xXAs8kB4gA3l2dZhgDlaTmDks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQULCUpXA6mw0pa2ibbv5IoDZGP02QJbMp9SwzyMLUq0wA&oe=6B0F01DD"}, {"file_name": "screenshot2.png", "id": "3440075976123135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393589_3440075979456468_6991229411176812551_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM_scgG-h3IQ7kNvwEDQOf1&_nc_oc=AdoGsCCAPnxjyWR9nkVYvEh_o1Hg9NAhaT2juAzIQGhjpC7xHNlvqitASw1kTo5w5q8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVXpfZz0uaF-f4E24F2CYXpM8nXHsyRditlqKqKmVhzuw&oe=6B0EF2C6"}, {"file_name": "screenshot1.png", "id": "1802645840499884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392016_1802645843833217_7383325292449785712_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oazS0yUlqsQ7kNvwFP-RLt&_nc_oc=AdprYDNysOarLqF5hFvnPfunr8avHLjf2_OBAMkHKW3YedFTSHYFkmxNIW1AmMy9A1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVoDR9FHNpfvirbeQk365tUAcoVuGvnyOwEbW4ZNDqe3A&oe=6B0F0F38"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AR Toolkit", "keywords": ["Measure", "Tool", "Productivity"], "long_description": "# Introducing AR-Toolkit!\n\nExperience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands.\n\n# Key Features:\n- **3D Precision:** Effortlessly measure distances, angles, curves, and surface areas with pinpoint accuracy in an immersive 3D environment.\n- **Intuitive Interaction:** VR tools attach for fluid, natural movement. Simply pick up the tools within the virtual space and start measuring without cumbersome hardware setups.\n\n\n- **Versitile Use Cases:** From interior design and architecture to educational demonstrations and creative prototyping, AR-Toolkit adapts to a wide variety of professional and personal projects.\n- **Real-Time Visualization:** See your measurements update instantly in augmented reality. Make quick adjustments to angles and layouts with confidence.\n- **User-Friendly Interface:** A clean and intuitive interface keeps the learning curve low, enabling anyone\u2014from hobbyists to professionals\u2014to get started immediately.\n\n\n", "short_description": "Experience a new dimension of measurement with AR-Toolkit, an augmented reality application designed to measure distances, angles, curves, and areas in real-time 3D space. Leveraging cutting-edge VR tools attached to body sockets, AR-Toolkit brings unparalleled convenience and precision directly into your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/theMatthewNewman/ar-toolkit/blob/main/privacyPolicy", "developer_terms_of_service_url": null, "publisher_name": "Matthew Newman", "support_website_url": null, "website_url": "https://ar-toolkit.web.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "3626
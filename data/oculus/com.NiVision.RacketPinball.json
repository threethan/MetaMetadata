2705478005178082371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeH3m04iXXQQ7kNvwHxQl9p&_nc_oc=AdpCUGwIFUMyoTybzbz77wzLgXn-ee6K2KUp2M7s8R2BA2oDBnVnAsuyZ_y0XpTi3dU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAvlOn2LXsKRFZDZxKwJYZO_ceZCXCfWeFSa63XYhSMA&oe=69C9295F"}, {"file_name": "screen_7.png", "id": "4003766239843634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569449_4003766243176967_4897689890097284708_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fwo7qaqMY0Q7kNvwGr6ZEC&_nc_oc=Adrr8daoF0ytpTGN5Urcik5daYU2AQxulEiHpnjIcmsYFPyGIXTzNna_vRHgNzEkIko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8poG6dLf4sjDRTSjDGzDBvAYqi9o29wGm8DNt3XiVhQ&oe=69C938D3"}, {"file_name": "screen_4.png", "id": "1738976126881485", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001725_1738976130214818_6361325355432545831_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44WCXYnRxJQQ7kNvwHOvyT2&_nc_oc=AdroDMW1QTwc2jGFApcQF1kpNxtKQ3ls9YiWOrikbG8wqPqsrs_fkcJD-zhdd7GILg4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWnKSNLR6ik7Uqp_0BCOfn_C-EVsF21OkYMfVlnu4MGg&oe=69C90432"}, {"file_name": "screen_5.png", "id": "1589861131640321", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982593_1589861134973654_2393026767069425346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=un9-7vJxdMgQ7kNvwFwXnb_&_nc_oc=Adr578A1WWN94_N9tuLaZcQmdtdPqsbHDoXnACiTasvPF-LFHLDtv8vBBsfPHMxQCoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOHCZU9PYOscM8TbX_3JcEVmVlwAs17lxeYnBtUYjIxA&oe=69C90379"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "2044842119302440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2044842122635773_4288047269727908331_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDlUc0wGvxUQ7kNvwHDCG3j&_nc_oc=AdrgAg77nMkimI_UaXb7uOf1ZcYs9UmUGNGArQuoELUH9VGjta2wsWhWc1cHfct7iro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYDpZ9uqXl6q5F3uhjgkDyAutebVd1VL_UqZFmIVYdEg&oe=69C92629"}, "display_name": "Racket Pinball", "keywords": ["flipper", "arena", "squash", "tenis", "pinball"], "long_description": "Welcome to Racket Pinball - the revolutionary VR game that transforms you into the ball-wielding master of an incredible pinball universe! This unique fusion of classic pinball mechanics and dynamic racket sports creates an entirely new gaming experience that puts YOU at the center of the action.\nImmerse yourself in meticulously crafted themed environments, each offering a distinct adventure. Battle through the swashbuckling PIRATES table, explore the cosmic wonders of SPACE, and soon - conquer the untamed WILD WEST. Every environment surrounds you with interactive elements, dazzling lights, and strategic targets waiting to be hit.\nArmed with virtual rackets, you'll serve, swing, and smash your way through exciting challenges. Master the art of precision shots to trigger spectacular mechanisms, light up target combinations, and unlock hidden features. Each successful hit brings the game world to life with stunning visual and sound effects, creating an unprecedented arcade experience.\nChallenge yourself in thrilling mini-games, compete for high scores, and discover new ways to conquer each themed world. With intuitive controls and physically engaging gameplay, Racket Pinball delivers the perfect blend of classic arcade fun and modern VR innovation.\nDive into the game, where pinball meets racket sports in the most immersive way possible. Are you ready to become the champion of Racket Pinball?\n", "short_description": "Step into Racket Pinball, where classic pinball meets racket sports in groundbreaking VR! Armed with rackets, unleash powerful shots in immersive environments inspired by Pirates, Space, and Wild West themes. Dive into the game physically as you hit targets, trigger spectacular mechanisms, and rack up high scores in this revolutionary arcade experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/racket-pinball-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://www.facebook.com/groups/racketpinball", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "it", "ko", "pt", "pl", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8376468142408792"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "870958542627820"}, {"status": "PUBLISHED", "id": "1087275406824351"}, {"status": "PUBLISHED", "id": "1203664988537831"}, {"status": "PUBLISHED", "id": "1089288033279730"}, {"status": "PUBLISHED", "id": "1464578724581903"}, {"status": "PUBLISHED", "id": "1698397260795206"}, {"status": "PUBLISHED", "id": "516031014870199"}, {"status": "PUBLISHED", "id": "1607210833260173"}, {"status": "PUBLISHED", "id": "540575285423553"}, {"status": "PUBLISHED", "id": "1110064203879065"}]}, "baseline_offer": {"id": "1110064203879065"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "870958542627820"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25975722285390106", "version": "1.99"}, "id": "3830403743875295", "channe
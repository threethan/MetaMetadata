2705478005178082371_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxeOzqHebb8Q7kNvwGeH8sc&_nc_oc=AdqiZXgtPYVDDS1668OFBvvqmRs9-28MAFBHGieLPMHrDnG4Q60Dx_1QmGbV27bcvZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwG8DO8Mm5tTo65HL1od6EzIffWzi10D5kiJxzRleXTQ&oe=69CA7ADF"}, {"file_name": "screen_7.png", "id": "4003766239843634", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569449_4003766243176967_4897689890097284708_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NpzoPeD7zD8Q7kNvwGRbqpH&_nc_oc=Adqw4_W6wD8YCyNLtUCpTxIDF2-60jkQWrjknUkdvKf9TXWRlwqO-5Zy6KNlIuaiFx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSGHjxZhDnK-AX-4_f4OWTo7B068SA8ldsIAYnSfxfCw&oe=69CA8A53"}, {"file_name": "screen_4.png", "id": "1738976126881485", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001725_1738976130214818_6361325355432545831_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44WCXYnRxJQQ7kNvwEWfU0b&_nc_oc=Adp1_rHH2Iv2zZYK-mU-HB-qQKuDYvDhpbrShV5kcNW9zgIWcmjweRvHvFShdWDlicw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKRzgc3G2B1hNv-RoVFITRmXZwCOmruP9nwR9BQGA4Vg&oe=69CA55B2"}, {"file_name": "screen_5.png", "id": "1589861131640321", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982593_1589861134973654_2393026767069425346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=un9-7vJxdMgQ7kNvwGIxogf&_nc_oc=AdrJdfEiC0DZaxqbk-L_wKkRsUJP9j60mpcoiBIqEQ9x_dvCjnP2sF06rcV1ZM4ngsg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtfFvU_jUz215NzT1CfJ0Xmt4pOfFFWJkvy01MaAg2Pg&oe=69CA54F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "2044842119302440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2044842122635773_4288047269727908331_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDlUc0wGvxUQ7kNvwF075fM&_nc_oc=Adp-eXceRRFqr1uSJuWEIk1Lk7n5rkDgiQ3z9i1BmMOUkPJKtDJTAlptfOfaRVRrVfg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQKOD-MURn-ZriwfyrstjG3RySmF8Vv4S568_hDUmfOQ&oe=69CA77A9"}, "display_name": "Racket Pinball", "keywords": ["flipper", "arena", "squash", "tenis", "pinball"], "long_description": "Welcome to Racket Pinball - the revolutionary VR game that transforms you into the ball-wielding master of an incredible pinball universe! This unique fusion of classic pinball mechanics and dynamic racket sports creates an entirely new gaming experience that puts YOU at the center of the action.\nImmerse yourself in meticulously crafted themed environments, each offering a distinct adventure. Battle through the swashbuckling PIRATES table, explore the cosmic wonders of SPACE, and soon - conquer the untamed WILD WEST. Every environment surrounds you with interactive elements, dazzling lights, and strategic targets waiting to be hit.\nArmed with virtual rackets, you'll serve, swing, and smash your way through exciting challenges. Master the art of precision shots to trigger spectacular mechanisms, light up target combinations, and unlock hidden features. Each successful hit brings the game world to life with stunning visual and sound effects, creating an unprecedented arcade experience.\nChallenge yourself in thrilling mini-games, compete for high scores, and discover new ways to conquer each themed world. With intuitive controls and physically engaging gameplay, Racket Pinball delivers the perfect blend of classic arcade fun and modern VR innovation.\nDive into the game, where pinball meets racket sports in the most immersive way possible. Are you ready to become the champion of Racket Pinball?\n", "short_description": "Step into Racket Pinball, where classic pinball meets racket sports in groundbreaking VR! Armed with rackets, unleash powerful shots in immersive environments inspired by Pirates, Space, and Wild West themes. Dive into the game physically as you hit targets, trigger spectacular mechanisms, and rack up high scores in this revolutionary arcade experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/racket-pinball-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NiVision", "support_website_url": null, "website_url": "https://www.facebook.com/groups/racketpinball", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "it", "ko", "pt", "pl", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8376468142408792"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "870958542627820"}, {"status": "PUBLISHED", "id": "1087275406824351"}, {"status": "PUBLISHED", "id": "1203664988537831"}, {"status": "PUBLISHED", "id": "1089288033279730"}, {"status": "PUBLISHED", "id": "1464578724581903"}, {"status": "PUBLISHED", "id": "1698397260795206"}, {"status": "PUBLISHED", "id": "516031014870199"}, {"status": "PUBLISHED", "id": "1607210833260173"}, {"status": "PUBLISHED", "id": "540575285423553"}, {"status": "PUBLISHED", "id": "1110064203879065"}]}, "baseline_offer": {"id": "1110064203879065"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "870958542627820"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25975722285390106", "version": "1.99"}, "id": "3830403743875295", "channe
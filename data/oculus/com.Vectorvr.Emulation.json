4.5771-25/499618284_925535693756632_5609229522178859767_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zpollipPWgQ7kNvwGSBnxF&_nc_oc=AdrzT7MKKaNuj7FAYeIkZUEXqoo1wbQ0Bxb01OpIFiEsmzANbNAi0ArWXg4ZefIk8ig&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X0VFYVRQ_TmzFW-LNvdUfTF3ZjBrISMLQOfOzI0xCUw&oe=6A09D1F4"}, "display_name": "Emulation", "keywords": [], "long_description": "The world twists and bends around you... Where have you ended up now? None the matter, though. You've seen it all before. You know all too much about distorted environments. Corrupted, evil, broken environments... Whatever. There's a newcomer on the way. Do what you've always wished to do.\n\nEmulation is a unique game that revolves around player-controlled monsters known as anomalies! There are multiple maps to explore (and hide in), so you'd best run while you can. There is a shop full of cosmetics, where you can stylize yourself to your desires. You never know what'll come your way, so stay tuned and watch your back!", "short_description": "The world twists and bends around you... Where have you ended up now? None the matter, though. You've seen it all before. You know all too much about distorted environments. Corrupted, evil, broken environments... Whatever. There's a newcomer on the way. Do what you've always wished to do."}]}, "developer_name": "Vectorvr", "developer_privacy_policy_url": "https://docs.google.com/document/d/12P-fEGfVWWjM9G3em_eUnj9EoJxNM_QZY0ssrsHUcBQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Vectorvr", "support_website_url": null, "website_url": "https://sites.google.com/view/emulation-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_
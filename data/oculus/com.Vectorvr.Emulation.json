4.5771-25/499618284_925535693756632_5609229522178859767_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysebbuGopREQ7kNvwEXa648&_nc_oc=Adooac6JHi9WGBo3LDQcOUt1DAB-bYpMTxY48r2aOwUNb4q7nVI9VrWf4j1m6QIb70Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_EK78BiBNJa1HrfEj5qrhoJ3HVebix6I7NY5rKp8BpA&oe=6A355374"}, "display_name": "Emulation", "keywords": [], "long_description": "The world twists and bends around you... Where have you ended up now? None the matter, though. You've seen it all before. You know all too much about distorted environments. Corrupted, evil, broken environments... Whatever. There's a newcomer on the way. Do what you've always wished to do.\n\nEmulation is a unique game that revolves around player-controlled monsters known as anomalies! There are multiple maps to explore (and hide in), so you'd best run while you can. There is a shop full of cosmetics, where you can stylize yourself to your desires. You never know what'll come your way, so stay tuned and watch your back!", "short_description": "The world twists and bends around you... Where have you ended up now? None the matter, though. You've seen it all before. You know all too much about distorted environments. Corrupted, evil, broken environments... Whatever. There's a newcomer on the way. Do what you've always wished to do."}]}, "developer_name": "Vectorvr", "developer_privacy_policy_url": "https://docs.google.com/document/d/12P-fEGfVWWjM9G3em_eUnj9EoJxNM_QZY0ssrsHUcBQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Vectorvr", "support_website_url": null, "website_url": "https://sites.google.com/view/emulation-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_
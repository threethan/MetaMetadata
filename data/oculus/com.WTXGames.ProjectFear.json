-25/75540499_3194767564001444_1685803223392751167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7l187aqtgwQ7kNvwFzaLBf&_nc_oc=AdmNmimy-0dpRiMTnPlSFCzjBZ4c75olLKwaKxKqLpdiVOBb5zL7cirTrkW4yGcYYDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvIiaOldX6a6QsXNfvtdUDgFkSv33g9_OSu-ztJ-_SLBA&oe=699DA9E6"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "431846395901814", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003268_431846399235147_5168739417591755339_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvBbo4Ep8cEQ7kNvwEe7oOK&_nc_oc=Adk0rgXqNNDRQdqVBoJhsIH0oyksr2aDX4r3XciCCNtH-_hHKN4CKN-hyBTbVTG5yPU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmEKmlUsFuvwITA1o9IS8zrvHi4pifqOpIv5UT6U0_Yw&oe=699D8050"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "3668440253424130", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001719_3668440256757463_7911871517630275973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NI2nl_o8y0Q7kNvwEWOL6O&_nc_oc=AdnUUX0qEIr8tJFJzoRl3z0KNqDIPvMyH7TmwIKDNX-1_viWsS8429MPDEWAp94ILvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFNuDmBFPT66sX-qUw-dtrho_ApcSJ15AOL-WcmNLb-g&oe=699D815D"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "1113854489840046", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251817_1113854493173379_3175713871006889954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0G0JwCY-gAQ7kNvwGr0NxE&_nc_oc=AdkWg1yioJ3qsMTDwu4RIJAt7AqawyImDS6MJ4ERPjnjeBoST_uW57rXe2AMtF6mpwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvWK6iFK6xR3oLrHXu3DcUA-MFhEMM6JmVBp7BKhqR_-A&oe=699D8CC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "787844696584874", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982671_787844699918207_1966340381990108941_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUFVBaljMQ8Q7kNvwF496Dw&_nc_oc=Adk6-8OIslTF7lp2DGimOhekEQXgCqJY0mPUA2wCmEVV-JXV_0jqumRbpJ_olSO998I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudymVYZOJ1aLXtGxoS0WIaxXyWxSTW39Qzwxschq7ybA&oe=699D8BCD"}, "display_name": "Project Fear", "keywords": [], "long_description": "\n\"Project Fear\" is a survival horror game set in a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it combines intense action with horror. Players use \"Gorilla Tag\"-like locomotion to swing, climb, and evade the primates. Uncover dark secrets while fighting for survival in this adrenaline-fueled nightmare.", "short_description": "\n\"Project Fear\" is a survival horror game where players navigate a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it features intense action and horror. Using the locomotion mechanics of \"Gorilla Tag,\" players swing, climb, and leap to evade the terrifying primates. Uncover the facility's dark secrets while struggling to survive in this adrenaline-fueled nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wtxgames-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/wtxgames-studio/about", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7077558059023826"}, "review_messages
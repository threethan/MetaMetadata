-25/75540499_3194767564001444_1685803223392751167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7l187aqtgwQ7kNvwErmSg-&_nc_oc=Adm43echnz-vs_HVh37WYaG3z7HzeiGVKVN2mVLvIwBDzdD7Zf1H7y5SO0Zvo3s8UHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsSZq37gsVmnqIpbPTwciialidWRaaJ3_O74zE6iwuRPA&oe=699C5866"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "431846395901814", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003268_431846399235147_5168739417591755339_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvBbo4Ep8cEQ7kNvwHNlF20&_nc_oc=AdmvqXAMb5Oiwvsp9NVq3ZoeUFr8QM7hZ6N_A98uWuXVaTMs2iXIUX5KnDH85s4eYPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftkfarWRVoxA_3q03HWrz8KxnRDYftycfwfqs45DBoMOw&oe=699C6710"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "3668440253424130", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001719_3668440256757463_7911871517630275973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NI2nl_o8y0Q7kNvwHVR7di&_nc_oc=AdnJTYBmK_SOre3TC9Fy1-qhhvp9DaClkhubGhp08BloObP7Jc9nuguWv3hV_3Brx6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvLlmxUgprVwftbaUT5kxvnBhmmIEYyrl3iY_02PAR-7g&oe=699C681D"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "1113854489840046", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75251817_1113854493173379_3175713871006889954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0G0JwCY-gAQ7kNvwH6vwxG&_nc_oc=AdlAjinLEq9PtYYE6bax_MZ6Hos6T640qVQ84E-iGlxL44PfEy9o0HwUctQct17Slwo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsBfrk2WT3K7ubuKfBBVj-RNFG0ZLd3QhZ1yTyW_hMXsQ&oe=699C3B49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "787844696584874", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_787844699918207_1966340381990108941_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUFVBaljMQ8Q7kNvwHeaKR2&_nc_oc=Adl6n7HVUOtRfVbi0G8B-hRQ2tPw1pv2f3zADRVeAHL0jsj4phV9-fKkqZkzCHMJvuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftDiMoxr3pwIEcnxiquBgMB0iPqVLxW6KdE2TZHdaGVrQ&oe=699C3A4D"}, "display_name": "Project Fear", "keywords": [], "long_description": "\n\"Project Fear\" is a survival horror game set in a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it combines intense action with horror. Players use \"Gorilla Tag\"-like locomotion to swing, climb, and evade the primates. Uncover dark secrets while fighting for survival in this adrenaline-fueled nightmare.", "short_description": "\n\"Project Fear\" is a survival horror game where players navigate a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it features intense action and horror. Using the locomotion mechanics of \"Gorilla Tag,\" players swing, climb, and leap to evade the terrifying primates. Uncover the facility's dark secrets while struggling to survive in this adrenaline-fueled nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wtxgames-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/wtxgames-studio/about", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7077558059023826"}, "review_messages
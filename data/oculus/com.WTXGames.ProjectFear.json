-25/75540499_3194767564001444_1685803223392751167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdyWPqGtU3cQ7kNvwFXvjmu&_nc_oc=AdlLsHYp4seoDkDwyPzlx2aAXlErSvCXlKAgeyBmK2LkIcFFMPHg5hfAACIJ66HgxCs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs2y1HGsIHYVCltEQv6bo-7NNAdxCcXjkQYZB58KHjEZQ&oe=699B06E6"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "431846395901814", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003268_431846399235147_5168739417591755339_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBu5y4JTjT0Q7kNvwEmhVDs&_nc_oc=Adk7sNyXiqr8E6jAIn-eilM1vP060QVSR6gzRI01ashLlPS7yRk1HWj-i16M17oWMbI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftZWO-L6XZluSSg7-r8wHpJaza9fTqd0wUFwkWFt2UydA&oe=699B1590"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "3668440253424130", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001719_3668440256757463_7911871517630275973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7YSnCuUluYQ7kNvwEeubZQ&_nc_oc=AdnAgmjamEH342nck5g9Chq3bcGaW5AJ14nNBtfharZklEJZD3979PdlP9nVB0GDl8M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuBpNzuVn83cvSkwkZHvt7G03NlQb4qaqUVjXXD2dLAYg&oe=699B169D"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "1113854489840046", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75251817_1113854493173379_3175713871006889954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyQ9v939XxAQ7kNvwGhloo_&_nc_oc=Adn3RoqVTVWaVF8V4SHRUtogLfBtszon59e-UxOhQXR1Ty7ob2c17DnpBm9qP_l-02o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuZQXmNAL73I9lYiIajeNWkJlmZFW7kSFrv9szRCgtmLQ&oe=699AE9C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "787844696584874", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982671_787844699918207_1966340381990108941_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUFVBaljMQ8Q7kNvwHuB4jq&_nc_oc=AdniHeEYLLGVHovpFdZm1nmyHRuptfewmOF0plJxVl5IflKLdhStV9jsLuzWHcKrFGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs87TLuaXhFxY2HbIS6J8viaWA1rqLXQPr55ycgMuvwrg&oe=699AE8CD"}, "display_name": "Project Fear", "keywords": [], "long_description": "\n\"Project Fear\" is a survival horror game set in a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it combines intense action with horror. Players use \"Gorilla Tag\"-like locomotion to swing, climb, and evade the primates. Uncover dark secrets while fighting for survival in this adrenaline-fueled nightmare.", "short_description": "\n\"Project Fear\" is a survival horror game where players navigate a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it features intense action and horror. Using the locomotion mechanics of \"Gorilla Tag,\" players swing, climb, and leap to evade the terrifying primates. Uncover the facility's dark secrets while struggling to survive in this adrenaline-fueled nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wtxgames-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/wtxgames-studio/about", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7077558059023826"}, "review_messages
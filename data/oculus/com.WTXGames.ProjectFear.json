il": {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "787844696584874", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982671_787844699918207_1966340381990108941_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxdJK9wdIZ8Q7kNvwEWPgU6&_nc_oc=AdrWauSi7fyNKEDntpmj05xzO0CBf-dHjnH40v6MQQP9YPUyLkZZXLZVDB0ny8XoDDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoUtWjDdahgUM8V6ozEQdbHRpB5hOHnbcddRKaFP0FiQ&oe=6AFDC48D"}, "display_name": "Project Fear", "keywords": [], "long_description": "\n\"Project Fear\" is a survival horror game set in a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it combines intense action with horror. Players use \"Gorilla Tag\"-like locomotion to swing, climb, and evade the primates. Uncover dark secrets while fighting for survival in this adrenaline-fueled nightmare.", "short_description": "\n\"Project Fear\" is a survival horror game where players navigate a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it features intense action and horror. Using the locomotion mechanics of \"Gorilla Tag,\" players swing, climb, and leap to evade the terrifying primates. Uncover the facility's dark secrets while struggling to survive in this adrenaline-fueled nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wtxgames-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/wtxgames-studio/about", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null
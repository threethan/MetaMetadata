-25/75540499_3194767564001444_1685803223392751167_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GdyWPqGtU3cQ7kNvwHQ9YTe&_nc_oc=AdlzCnOJJ53sLgLymjhDk6He2fqs0qoPbOIpF0smDMyTSOdnhnQQ32w0DZ2-77hzre8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv4XcOQ8X4q3mZPdZttLMXFjuERTWbwVP5bTpk6kUeyLQ&oe=699863E6"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "431846395901814", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003268_431846399235147_5168739417591755339_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBu5y4JTjT0Q7kNvwH7nAEl&_nc_oc=AdkGxJ74ZLIbVppp5yDULM4yO_8SaYFIuVIUm9oNdu3zf6eHoAXOq8Yzj0pr9RjBEnA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuBa8dNdd73ojc_XgBQzxqPqq4tgK0GznRjq6IhYe3nxw&oe=69987290"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "3668440253424130", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001719_3668440256757463_7911871517630275973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7YSnCuUluYQ7kNvwF8cAb-&_nc_oc=Admk0TjTrwOFvPnp_1aBYGqk5-UxHdLXKlzDBaZLjnzEBoO_rl9VCyqdnq3zDJND2sE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuPz6StUnl9aiL5xxlLVsYlgx6wTmyehECLQ2O-s1ccKQ&oe=69983B5D"}, {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "1113854489840046", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75251817_1113854493173379_3175713871006889954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oyQ9v939XxAQ7kNvwHpn9CL&_nc_oc=Adnhsz_G-4xFASEFNvmMFQ1OByKVOMCSy9qNwldgscwPMw8GwBj_y6JIZn9o2MCQICE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv4BRrK9xpeppALD13L05jH_59_jPiSUmo9hl1ELQ_0lw&oe=699846C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Main_Custom..._24.03.2024_12-21-39.png", "id": "787844696584874", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982671_787844699918207_1966340381990108941_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bE8RdZre5RgQ7kNvwGTWPCU&_nc_oc=Adm3o0bWKuedUUb9-y2JnVczJiRILjON5Gsx2dl8XbSpMhz3VITH1xp1h4SKHdDt55M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsEXDeRG4SkkbNTOlIq5I_UEOIjsw8F8QI-T6ov7VWx_A&oe=699845CD"}, "display_name": "Project Fear", "keywords": [], "long_description": "\n\"Project Fear\" is a survival horror game set in a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it combines intense action with horror. Players use \"Gorilla Tag\"-like locomotion to swing, climb, and evade the primates. Uncover dark secrets while fighting for survival in this adrenaline-fueled nightmare.", "short_description": "\n\"Project Fear\" is a survival horror game where players navigate a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it features intense action and horror. Using the locomotion mechanics of \"Gorilla Tag,\" players swing, climb, and leap to evade the terrifying primates. Uncover the facility's dark secrets while struggling to survive in this adrenaline-fueled nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wtxgames-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/wtxgames-studio/about", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7077558059023826"}, "review_messages
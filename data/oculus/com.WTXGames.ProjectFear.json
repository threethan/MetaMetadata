5771-25/38982671_787844699918207_1966340381990108941_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Rwd5mH-ny8Q7kNvwHTfsRz&_nc_oc=AdquBnf-nuoAO7wA5zlIt-Mb0m7x_iR1O1uzwGG2kO0CyHOG76R-bos1s5d_HltRPh4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXl599q4cbvfPjOFc933CToZxY5_FX_NObJ00iO0eFuw&oe=6A7864CD"}, "display_name": "Project Fear", "keywords": [], "long_description": "\n\"Project Fear\" is a survival horror game set in a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it combines intense action with horror. Players use \"Gorilla Tag\"-like locomotion to swing, climb, and evade the primates. Uncover dark secrets while fighting for survival in this adrenaline-fueled nightmare.", "short_description": "\n\"Project Fear\" is a survival horror game where players navigate a research facility overrun by mutated apes. Inspired by \"Lethal Ape,\" it features intense action and horror. Using the locomotion mechanics of \"Gorilla Tag,\" players swing, climb, and leap to evade the terrifying primates. Uncover the facility's dark secrets while struggling to survive in this adrenaline-fueled nightmare."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/wtxgames-studio/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Maxe", "support_website_url": null, "website_url": "https://sites.google.com/view/wtxgames-studio/about", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
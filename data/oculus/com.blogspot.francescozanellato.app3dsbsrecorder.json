-7&_nc_sid=6e7a0a&_nc_ohc=cKMsDVhXFgYQ7kNvwFYvcOe&_nc_oc=Adpqg8aGf08aG5VZBYc__izPr_16_nyEvMgzBxjOnpjkGVq6FTMtSMAQcs7UsHfPf-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW5yrKOYlNhUaI9GKV6SVad-4epj_UDrylIf5emNwR4g&oe=6AEB37DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D SBS Recorder", "keywords": ["3DSBSRECORDER", "3D", "VIDEO", "RECORDING", "SBS"], "long_description": "3D SBS Recorder. Free. This app records a 2D or 3D stereo video from the Meta Quest 3/3S. The recorded video is saved in a subfolder of your Movies folder and will remain on your device. This app will never access the video. This app does not contain ads and does not collect any personal information.\nSome settings and combinations require an app restart, in particular when the recording fails.\nWith the avatar/virtual camera, please turn the \"Preview\" off before recording.", "short_description": "3D SBS Recorder. Free. This app records a 2D or 3D stereo video from the Meta Quest 3/3S. The recorded video is saved in a subfolder of your Movies folder and will remain on your device. This app will never access the video. This app does not contain ads and does not collect any personal information.\nSome settings and combinations require an app restart, in particular when the recording fails.\nWith the avatar/virtual camera, please turn the \"Preview\" off before recording."}, {"images": {"nodes": []}, "id": "1101745222242552", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D SBS Recorder", "keywords": ["3DSBSRECORDER", "3D", "SBS", "REGISTRAZIONE", "VIDEO"], "long_description": "3D SBS Recorder. Gratuito. Questa app registra un video 2D o 3D stereosopico con il Meta Quest 3/3S. Il video registrato viene salvato in una sottocartella della tua cartella Movies e rimarr\u00e0 in locale sul tuo dispositivo. Questa app non accede al video registrato. Questa app non contiene pubblicit\u00e0 e non raccoglie alcuna informazione personale.\nAlcune impostazioni e combinazioni richiedono il riavvio della app, soprattutto in caso la registrazione fallisca.\nCon camera avatar/virtuale disabilitare la Anteprima.", "short_description": "3D SBS Recorder. Gratuito. Questa app registra un video 2D o 3D stereosopico con il Meta Quest 3/3S. Il video registrato viene salvato in una sottocartella della tua cartella Movies e rimarr\u00e0 in locale sul tuo dispositivo. Questa app non accede al video registrato. Questa app non contiene pubblicit\u00e0 e non raccoglie informazioni personali.\nAlcune impostazioni e combinazioni richiedono il riavvio della app, soprattutto in caso la registrazione fallisca.\nCon camera avatar disabilitare la Anteprima."}]}, "developer_name": null, "developer_privacy_policy_url": "https://francescozanellato.blogspot.com/2026/10/privacy-policy-3d-sbs-recorder.html", "developer_terms_of_service_url": null, "publisher_name": "ZANELLATO FRANCESCO PAOLO LUCA", "support_website_url": null, "website_url": "https://francescozanellato.blogspot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1328974080305407"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2671004596668013"}]}, "baseline_offer": {"id": "2671004596668013"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791529860, "status": "PUBLISHED", "id": "2671004596668013"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1332529433283205", "version": "1.0"}, "id": "1125056260044797", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328974076972074", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1332529433283205"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1125056260044797"}]}, "change_log": "Release Candidate Version. It works, but app reload might be sometimes necessary when recordings fails.\r\nApp reload may also be necessary when changing some parameters (camera, mono/stereo, resolution, FPS, MBPS).\r\nThis app uses the cameras (virtual/avatar and physical) to capture a mono 2D or stereo 3D recording.\r\nThis app saves the recording in a \"Movies\" subdirectory, but never access it back and the recording remains local on the device.\r\nThe app doesn't use internet and doesn't access any account information.\r\nThe app accesses the internal microphone, or an USB external microphone if \"experimental -> External Microphone\" is activated and a USB microphone is connected.\r\nThis app doesn't use any bluetooth device.", "created_date": 1791407360, "id": "1332529433283205", "version": "1.0", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1328974076972074", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "
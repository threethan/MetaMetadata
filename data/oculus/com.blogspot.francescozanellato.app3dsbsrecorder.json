697_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU3Ys_DP-6IQ7kNvwElljSW&_nc_oc=AdrRVUU9AVlihZzZb7t1QvTsl-zji2OYI80-pyHGGPTVF8X_kaJ4Jkepo0Pgo-heEOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-ua1RFCS2Pf0g2CVSaNZqbDzVYmDZEPqSQMDkdnl37A&oe=6AEB43EE"}, {"file_name": "Timeline 15_00009844_OK5.png", "id": "2593524507751709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_2593524511085042_4769121543599679318_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cKMsDVhXFgYQ7kNvwFYvcOe&_nc_oc=Adpqg8aGf08aG5VZBYc__izPr_16_nyEvMgzBxjOnpjkGVq6FTMtSMAQcs7UsHfPf-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW5yrKOYlNhUaI9GKV6SVad-4epj_UDrylIf5emNwR4g&oe=6AEB37DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D SBS Recorder", "keywords": ["3DSBSRECORDER", "3D", "VIDEO", "RECORDING", "SBS"], "long_description": "3D SBS Recorder. Free. This app records a 2D or 3D stereo video from the Meta Quest 3/3S. The recorded video is saved in a subfolder of your Movies folder and will remain on your device. This app will never access the video. This app does not contain ads and does not collect any personal information.\nSome settings and combinations require an app restart, in particular when the recording fails.\nWith the avatar/virtual camera, please turn the \"Preview\" off before recording.", "short_description": "3D SBS Recorder. Free. This app records a 2D or 3D stereo video from the Meta Quest 3/3S. The recorded video is saved in a subfolder of your Movies folder and will remain on your device. This app will never access the video. This app does not contain ads and does not collect any personal information.\nSome settings and combinations require an app restart, in particular when the recording fails.\nWith the avatar/virtual camera, please turn the \"Preview\" off before recording."}, {"images": {"nodes": []}, "id": "1101745222242552", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D SBS Recorder", "keywords": ["3DSBSRECORDER", "3D", "SBS", "REGISTRAZIONE", "VIDEO"], "long_description": "3D SBS Recorder. Gratuito. Questa app registra un video 2D o 3D stereosopico con il Meta Quest 3/3S. Il video registrato viene salvato in una sottocartella della tua cartella Movies e rimarr\u00e0 in locale sul tuo dispositivo. Questa app non accede al video registrato. Questa app non contiene pubblicit\u00e0 e non raccoglie alcuna informazione personale.\nAlcune impostazioni e combinazioni richiedono il riavvio della app, soprattutto in caso la registrazione fallisca.\nCon camera avatar/virtuale disabilitare la Anteprima.", "short_description": "3D SBS Recorder. Gratuito. Questa app registra un video 2D o 3D stereosopico con il Meta Quest 3/3S. Il video registrato viene salvato in una sottocartella della tua cartella Movies e rimarr\u00e0 in locale sul tuo dispositivo. Questa app non accede al video registrato. Questa app non contiene pubblicit\u00e0 e non raccoglie informazioni personali.\nAlcune impostazioni e combinazioni richiedono il riavvio della app, soprattutto in caso la registrazione fallisca.\nCon camera avatar disabilitare la Anteprima."}]}, "developer_name": null, "developer_privacy_policy_url": "https://francescozanellato.blogspot.com/2026/10/privacy-policy-3d-sbs-recorder.html", "developer_terms_of_service_url": null, "publisher_name": "ZANELLATO FRANCESCO PAOLO LUCA", "support_website_url": null, "website_url": "https://francescozanellato.blogspot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
 day.\n\nGood luck!\n", "short_description": "Cool Horror VR game based on the game granny!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/BlckSantaVR/privacyBeknightPolicy/blob/b1bf950ef1ed4c9ef296b3ebe266935c389e3e29/README.md", "developer_terms_of_service_url": null, "publisher_name": "BlackSanta.VR", "support_website_url": null, "website_url": "https://github.com/BlckSantaVR/privacyBeknightPolicy/blob/b1bf950ef1ed4c9ef296b3ebe266935c389e3e29/README.md", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "PUZZLE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1131551084368788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031372_550003979902906_6099930924081867318_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ua3eL-CqMkQ7kNvwEs1u-Q&_nc_oc=AdkKj_qeaCGIPN4CZDGbDlGQTDUYAhXrgtvj9bCVfFJlGPj8j19LebKmVV57vOplUHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftuN59XjXrhIfX0btwQZ-cB9T4jjvXKQ0w6XTzAGufeuA&oe=69A42D26"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Beknight!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1655845604, "lastRevision": {"nodes": [{"id": "47570801410647
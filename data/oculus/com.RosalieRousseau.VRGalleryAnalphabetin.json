wHysv4N&_nc_oc=AdqNMTyqf0pmZxbSsB6VGjm1Mr4ohgu5ilGhRbmC-ZbVfyfA66vZWIBFPQAo1I9Aid8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58wbABcTtlEFZHLo9h8Hzzw6Xe8GMQZ97iiXy8bAc9Jg&oe=6A007927"}, {"file_name": "04 Raum mit Gammas.png", "id": "981814697675883", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831056_981814701009216_7146791871344493203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmnby0jfYnMQ7kNvwEsCKKf&_nc_oc=Ado1Wq7zXmyNymys4PJLiRWdQhWo-fpCfidNwOyDX2X0lQWuNfqRj0N9Bmm_ScLzfFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fUxU17LM6Naw1fGN8opNS85D64IA05_lFYcDI1ja_Pw&oe=6A006F7D"}, {"file_name": "05 Textpassage aus slam poetry.png", "id": "947791144675899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_947791148009232_3544406172087872500_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d803o2wfLb4Q7kNvwE1PtbX&_nc_oc=AdpAUtwKUFUjcpgu5TNuSIn_cOVfaBC4F6GPraAHKzcxkvJshoDZal8WZcwUwIhYwm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cKc53R-_3kaSy83xuM1UnN93fIE9ZvzYTQbwI31hkHg&oe=6A0098A6"}, {"file_name": "Credits.png", "id": "923319820519536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820387_923319823852869_1297111853764385899_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y73uNkuwjikQ7kNvwGrPzh7&_nc_oc=AdoVyOqubDevZOpD9iYFFmVix4b3aoqRmEw6kUfmXL6jYCXGui-h6cVWtY3LRAEkc2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f6d29xlWp7zGGPUJYn0uQSShWKEnrP80eKrSTNS1lew&oe=6A0071FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR Gallery entrance.png", "id": "1121729590139146", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823270_1121729593472479_3819227708440234027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QoUJtIil8YQ7kNvwFrtwmH&_nc_oc=AdotA1vwNUeUDt5m6EXBXSt-yRUOzr72meFePZx2JWDd5pzt5UimaYtMsOlQ99Zmm7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6X50dLCvZgPZsy16tm4v51L3ayqXf_c2P73N9KUbD5uQ&oe=6A0089DA"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{2167804033956102}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{959629226719005}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{1261323232241492}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{1638410420634320}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1515864363495044}\n", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id"
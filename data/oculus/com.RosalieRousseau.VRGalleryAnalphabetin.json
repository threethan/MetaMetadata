3301554441447_5414469028825776973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgDcDF8FHasQ7kNvwGO3V-k&_nc_oc=AdoIItXICDxOghYQ86FjTO_jifzy4lp7wa0s3OWLO76_XfEWvdEh12jur-lOWsigDhQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoDDWScqC8VHhf0Nx-kArmSzvXqlOjm_xg0Vn1--KJHQ&oe=6AE5EFDA"}, {"file_name": "Credits.png", "id": "2059180124941386", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_2059180128274719_588050631174054856_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_IbFSjlXAsQ7kNvwE9l0wv&_nc_oc=Adpk8zeYHjRiJtW8TcOAg7OLHeIuTcAugAWpUVoJGx0CSgrGENvRJMFT2r1r9RmCTVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzu0eAVWHKmS2G_J4mrHZwVMYlb8MtgnAO4GNk1q1DsQ&oe=6AE61701"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03 Eingang zum Rundgang.png", "id": "2172839470212799", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819854_2172839476879465_4527144026837560202_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xst_VrwVl0Q7kNvwF4cXak&_nc_oc=AdoZQCkfkeIxE6LY4-VptjV4Zv4P0KSAUoQOBrV7ib0KR0bko8M_tPRrmwia2VqAkvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcI-uD1iWPqszlMmr6wz0tIrMyLzQZFk68_gxEUHyv9A&oe=6AE5E352"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam", "Galerie"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{1791704451809481}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{2043709919863078}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{860490972983037}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{2008443426432222}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1595955531508857}", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "de_CH"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26323297914018539"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_947333737925193_480073826341118375_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thCwoRCs--4Q7kNvwF760u_&_nc_oc=Adpuc5G8Lj
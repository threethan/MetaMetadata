wGtKvYm&_nc_oc=Adoh4DoahjKytVw4xKWIAp9-eUOviKMAOnbUPzZ5BNfOKaDsIYbyeYwDVIsmxwhv3ug&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zzUIviW43wo4stbMlLdIa5MKSgnCIhdXPySKui626mg&oe=69F5ED27"}, {"file_name": "04 Raum mit Gammas.png", "id": "981814697675883", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491831056_981814701009216_7146791871344493203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwHZgOZTls0Q7kNvwH8v5xY&_nc_oc=AdqO8np_XHzVZp66ajpxNTw6Bk1A74HL1TCZhZOUcGbIDb8nMeQwmcL8q0s1SEKU800&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2oqI6VlZySlVvRWfsCqjqerFzL7wMt10dizXvMvaTVzg&oe=69F61BBD"}, {"file_name": "05 Textpassage aus slam poetry.png", "id": "947791144675899", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491818890_947791148009232_3544406172087872500_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-NtVahnYG4Q7kNvwH0bwsn&_nc_oc=Adpoa4MAKpAdmVf-Hq6wrmDNIoLSI4QaYE8GqBhmxYVdT9NXha9mWOnXKyl4E9BI6lI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36eSdlgWW_yWh_u0CBQYS_YnmLia1t6Sf0A8rx9BU8sg&oe=69F60CA6"}, {"file_name": "Credits.png", "id": "923319820519536", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820387_923319823852869_1297111853764385899_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XesnCnoZ1roQ7kNvwHziM_q&_nc_oc=Ado3Ls6BVZKZw0URyM01jhQdwXjMJa3rAxHppa4swiP12HzmmUT-Rllwq9RrEzZ9VYc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FwXIQtjgR3cR59DSKH_xcClefSq_IYVw7tqj5MmDCrg&oe=69F5E5FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR Gallery entrance.png", "id": "1121729590139146", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823270_1121729593472479_3819227708440234027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F08QU9oIMJ8Q7kNvwE0eots&_nc_oc=AdqUI5SBHOv_T1BA6cajPVVkRQ3_IgQ64BeTXh3vcVX65vqr40qxpcavRQLR3EzcDUI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DQPQoK3kGfT3Pz9zyz8c-0EU71BMWFPWK8e3VL4vKWQ&oe=69F5FDDA"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{2167804033956102}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{959629226719005}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{1261323232241492}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{1638410420634320}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1515864363495044}\n", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id"
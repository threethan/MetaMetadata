g", "id": "860490972983037", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821115_860490976316370_4345433941919289494_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Y8dv6_vnCoQ7kNvwEJggGA&_nc_oc=Adq2CUicvzeSf6-LYLi5MJtBuC2HmF1q9iPRYW_arJKjVTVBaXjaP3b8fHqyqwcAuYY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fG3-VuBGeHCjyQc1EirHtxfIMQdvtOmw2XhLxuUIJPg&oe=6A395AC3"}]}, "id": "1626347558596127", "locale": "de_DE", "screenshots": [{"file_name": "03 Eingang zum Rundgang.png", "id": "1201828298594359", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821099_1201828301927692_6289500672755462959_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93vF1ZAvv30Q7kNvwGwKOuE&_nc_oc=Adpf87b_Ou3K49LBFhHON1Vt8LcQWu9ETCKvaYKNP8a6enEV-XX8hSrDZ1oBu9JXwEQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qa-JKyXV7lUwRxMIP0ehIXpowpmilX4gfSOnsLotMWw&oe=6A39471D"}, {"file_name": "04 Raum mit Gammas.png", "id": "1421443043083527", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823366_1421443046416860_2624630487140529760_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TteT89UKDe4Q7kNvwEOm2Og&_nc_oc=AdpBp_e9fGxUP7uf4IXSxojBeNgFnGbIwtkuqo2gwURye5NnXk1TpLIGrpbxU3d0aGI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-n7o9TYwQrUMeHWhe1cZOuxuCgQ5tRIbXu9_eEDGv7A&oe=6A392E43"}, {"file_name": "05 Textpassage aus slam poetry.png", "id": "2176282106507338", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823296_2176282109840671_2595563376200481141_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1AeNbC5LMkQ7kNvwG9B8ae&_nc_oc=Ado3rmeDKm5GZSETHRdn3iTAjbu8xK1zRyBm6Xbw-Y8jsSoS3f3F29HlSOxxZENPr3o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gNNCCOsprC7dx5YbuPy5aoDTjQKd9jSMApIS6f95K9g&oe=6A39338D"}, {"file_name": "Hintergrundinfos.png", "id": "1703301544441448", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823930_1703301554441447_5414469028825776973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8SJ0yuaRFcQ7kNvwGHrdY5&_nc_oc=AdoCqPW0XlZ0dR1H8SjY9IdnxaGCdbnFvijA6DVCe0U2kTKhLyU9D7ke2i0oei9R1i4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kic1E1iQ7OmrA_7gNN06Ifn5IzwIqtrVlw-hCTPv6yw&oe=6A393B5A"}, {"file_name": "Credits.png", "id": "2059180124941386", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491818849_2059180128274719_588050631174054856_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKdqDDpeRucQ7kNvwH8MqJZ&_nc_oc=Ados9xu-VhCAwOdkkVgo8QlOfPgAZSp8xH05Xaxx_KL9iLHLUGnbXFFwLjDgu97sxBo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LwmJW2DtukS9mvfHjXYn6DGL0jkYBLxhgqGYkjNVjtA&oe=6A392A41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03 Eingang zum Rundgang.png", "id": "2172839470212799", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819854_2172839476879465_4527144026837560202_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnMGOorWvbQQ7kNvwEIEgGZ&_nc_oc=AdoMe_9VCM3sp6gABNvtylkTKLmcnlTalsNsgiTUYhoAveWntTQeP5-391DF5iVgPYw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96TAhbYnLeF5sW12mzIvkUnbKQw_WsHB26z3V0b3f1BQ&oe=6A392ED2"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam", "Galerie"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{1791704451809481}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{2043709919863078}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{860490972983037}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{2008443426432222}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1595955531508857}", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "de_CH"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26323297914018539"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823930_947333737925193_480073826341118375_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KSSsiTdLGwQ7kNvwEazo8v&_
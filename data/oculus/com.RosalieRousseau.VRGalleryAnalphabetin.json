HH0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDM8k9eL5HY-z_dYYw1RQiJvpWc_KWz_HUTg-XVseXDw&oe=6B031C03"}, {"file_name": "05 Textpassage aus slam poetry.png", "id": "2176282106507338", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823296_2176282109840671_2595563376200481141_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=epW8tdnd2iAQ7kNvwEWDvZY&_nc_oc=AdrIDjGfehtXd3l1G2SjmpeP7lHoHDVgbDCS2QV_-xLGQSAIrBNPpWO36MxjDDRJ3VA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyZiQ4ciZOCbXnImUOVk4bAZH9GtGnP-qv9C-wcnMsaQ&oe=6B03214D"}, {"file_name": "Hintergrundinfos.png", "id": "1703301544441448", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823930_1703301554441447_5414469028825776973_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw32DfEwoBgQ7kNvwE04cnV&_nc_oc=AdpVgj9IqxX08UuIFvEdwncdbsX_3syGaBnXwD_Vlc5xt1CL5Byr-seKL6nXXgF9u8c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB_ji-nSj0syUjr_Lj3W-ZltgAjCRS__lsCWFGK-iqPg&oe=6B03291A"}, {"file_name": "Credits.png", "id": "2059180124941386", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818849_2059180128274719_588050631174054856_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLoQ-aHLTr0Q7kNvwFNfIR_&_nc_oc=AdpZpjMF6--W46cmsFM3BpZNPEjMERZ5iHsV0MlFmKhXOXKSE_JueCQ1Ku_uDvwdWTE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsHTNr17qW_iA18BxR8MH5gb4gMdzRAJzdJ1_jLYx8nQ&oe=6B031801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03 Eingang zum Rundgang.png", "id": "2172839470212799", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819854_2172839476879465_4527144026837560202_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQsIvDclEhYQ7kNvwHA8tIB&_nc_oc=Adp2pjKu7KQPbrBRDaQ-xn9LbC99t7cTmw7Al51lIJziv3_kTM2x66Ca9Kz93veZyUo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8oGdtmYs-svSbngFYMXCRe8SyIXqjVv496zd0Yz9Wzw&oe=6B031C92"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam", "Galerie"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{1791704451809481}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{2043709919863078}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{860490972983037}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{2008443426432222}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1595955531508857}", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
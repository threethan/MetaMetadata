3301554441447_5414469028825776973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mlxsU-O0VsQ7kNvwGad_v4&_nc_oc=AdpKqUneMSwDw3GJjuLEG2wjkDmQh8KPwaNSQYg1fysl4CsdOgZCXZqRWXXIXhqYg7E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VLsOj9P5TEjjKrsbjbC7xaiR7UbIvxl0gC8gHtjAXEg&oe=6A09C55A"}, {"file_name": "Credits.png", "id": "2059180124941386", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491818849_2059180128274719_588050631174054856_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-DGa7bMqbMQ7kNvwG9ApAK&_nc_oc=AdpKvElvw3yZFd3xH2bckHzNiWkWtNPGtzV-Q-gWlZgDDyRu3EPLMVIv-wLaYbl7Lq8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vER7HAR3NTZEK3W0YwOomfz02_SHKjlBmTKLL8UrnPw&oe=6A09B441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03 Eingang zum Rundgang.png", "id": "2172839470212799", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491819854_2172839476879465_4527144026837560202_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7f4ajLU1BgQ7kNvwH5gBzk&_nc_oc=AdpULDv_dI4GdQ9lQMiNzyPL1TNojhT1bOZm9pQzr9tbBchI5VtY_YIsfRk46WFcMAs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EAas_11ga8t4hKf3Zv1FyoLJdhLXheavr-TXG_Swk8Q&oe=6A09B8D2"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam", "Galerie"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{1791704451809481}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{2043709919863078}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{860490972983037}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{2008443426432222}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1595955531508857}", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "de_CH"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26323297914018539"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823930_947333737925193_480073826341118375_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpEP-UEUNbQQ7kNvwEGFacw&_nc_oc=AdpBXSn3Vj
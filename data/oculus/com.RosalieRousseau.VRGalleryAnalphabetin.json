0a&_nc_ohc=gwyGUYgVnbsQ7kNvwFkp9SY&_nc_oc=Adomw9lzGRFPdoMQv1AHwVZJ0o7-B4vCMuINTFwMlE9VusuRu84J7imcIAjzGrQ4l48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEZG73srVs85dkVscAEMbjBgFGMRY-4pYNQV6YcttHBg&oe=6AFDC7BD"}, {"file_name": "05 Textpassage aus slam poetry.png", "id": "947791144675899", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818890_947791148009232_3544406172087872500_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_oq6ISPr5oQ7kNvwF4q_50&_nc_oc=AdoG7YFMfvJoBiejRmkHLuGa9Rhy5eawW_3f46w0D3D5Xni2Sc-9bk7iJXMH0FfHZ7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4k8kOgdmCBls8fG6HwXgAkiGSH2MDenggvNUgQMuKaw&oe=6AFDB8A6"}, {"file_name": "Credits.png", "id": "923319820519536", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820387_923319823852869_1297111853764385899_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3ZNAGErmmUQ7kNvwHpv4-K&_nc_oc=AdrcQ7VCByYXZ6sPu8964S7bFVk-YHnezESKU0vEDa6Z16j5Dyv0aPLIzGnCw9-8kfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBZJ5MsQKxa27oZmlQGmR4QEvPi8-qO59srGRH43Ct2Q&oe=6AFDCA3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR Gallery entrance.png", "id": "1121729590139146", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823270_1121729593472479_3819227708440234027_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rH1aTlGJ0QYQ7kNvwE96ooj&_nc_oc=Ado7B-hJFw9AmD9oQWLW9TzNh8EZRHqeVqjFdbrRzqgHbdPAHJVJWglIoXSv5H14wxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXUrwpIHRgukpCYu2ISaKu1vOLI6bFD05NXA4Wu1Nebw&oe=6AFDE21A"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{2167804033956102}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{959629226719005}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{1261323232241492}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{1638410420634320}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1515864363495044}\n", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "de_CH"], "supported_input_devices": [
g", "id": "860490972983037", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491821115_860490976316370_4345433941919289494_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaN5XWuBtZEQ7kNvwGJt_HA&_nc_oc=AdqmOZc6ArdEwsTg2F8850V0O3ofwy6Ki6P39Lt571aL65ze3wZMpOXsr9DRVm2HB60&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoKWEJxUUwR1ZF5ma7UWWgenKgbv0cDf4IrIhnYWIC9Q&oe=6AAEB043"}]}, "id": "1626347558596127", "locale": "de_DE", "screenshots": [{"file_name": "03 Eingang zum Rundgang.png", "id": "1201828298594359", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821099_1201828301927692_6289500672755462959_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHVsUcmpKuQQ7kNvwG1Wdwu&_nc_oc=Adoj_SGW0ZAYADNEEHwjzWjbqL7h-Mg18Mf94UrS4vDmPQXrUQ81W0IokMw_FU2m9d4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzaiUwR2DLhxVnl7CkOzvzZVCQbHZrezJJjg93QSY_Pw&oe=6AAE9C9D"}, {"file_name": "04 Raum mit Gammas.png", "id": "1421443043083527", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823366_1421443046416860_2624630487140529760_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtsOYl8XOnQQ7kNvwGepEeG&_nc_oc=AdoOB31tCksx8V4cVVZ2qwdFPTn4mhAmyaO53gQl-RleEABHwAZmiGKXswS5nQoXujY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7GMrcyFhtL58hGjzJwM3IDAU-J8A2w92OQ-726KAtXA&oe=6AAE83C3"}, {"file_name": "05 Textpassage aus slam poetry.png", "id": "2176282106507338", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491823296_2176282109840671_2595563376200481141_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USsaR0zQ6SIQ7kNvwHnFqrm&_nc_oc=AdqSeC3ss3b7uyTRK8ILXCLXoaAXN4CpeXIE8DKQeiY14GcqUHafUu3VewNcAfSZBMQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-fd6WKa-pRnvuCLsqssCCxldI8DEfEYLapY4pDeywSA&oe=6AAE890D"}, {"file_name": "Hintergrundinfos.png", "id": "1703301544441448", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491823930_1703301554441447_5414469028825776973_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUXxLW5mofsQ7kNvwGyOxvM&_nc_oc=AdqEwXMK7S4o7gBh7fA8sMu45UJInewQ5aL-a_vj-oA9lXynd2GzgzlAxkSHCpjBc0I&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOlyB6lNsANJ7GsC4XgrT7OK3_P-zk5yS0FwVTpYtMEw&oe=6AAE90DA"}, {"file_name": "Credits.png", "id": "2059180124941386", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491818849_2059180128274719_588050631174054856_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhY3mxHFW-MQ7kNvwF2GI1-&_nc_oc=Adp6PpiZnIv4e44q-pjur3m3zl21m15Cjibz8OJacJBobO3O-RsKpEiP7pLC5t04G9o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdQoRteI5dgTAD5D2quUMf9-O0FN4n3Ns52HT7XphSKg&oe=6AAE7FC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03 Eingang zum Rundgang.png", "id": "2172839470212799", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819854_2172839476879465_4527144026837560202_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3w7gEWTQbkQ7kNvwFUQ6w_&_nc_oc=Adowf9KhCEGnXYMRHm-ySMDcPOGIjB3AfVpeJj5TZaRd3B89SuxEDFGCaqojIfE92SU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAwNByqzVROwQLuo-97xPu1YCP0h3sqsWLL9a6RWAsTw&oe=6AAE8452"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam", "Galerie"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{1791704451809481}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{2043709919863078}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{860490972983037}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{2008443426432222}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1595955531508857}", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "de_CH"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26323297914018539"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823930_947333737925193_480073826341118375_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CllC_3ZxuGgQ7kNvwFwOiFw&_
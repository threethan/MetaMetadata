0a&_nc_ohc=JMi5t-RZZVcQ7kNvwFEM5iy&_nc_oc=AdpQ8mV0Q-qOnjwGOeSg8oqADnIgD5btu9gQWkhDBMoXZK8UXUHFIzGngwTtlarkb3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjzzg6Bxq563BCU95hUTEnCymvl0K8YsgoUdaBSvejVQ&oe=6B006ABD"}, {"file_name": "05 Textpassage aus slam poetry.png", "id": "947791144675899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_947791148009232_3544406172087872500_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0Kq28U9bW0Q7kNvwF_Hdkx&_nc_oc=AdoxHXFLKwP4yJhguWrf4sF43wqGy4rC3nlnx0IQHcvAn9lKSmbFrbNwaDVOu-hAEz8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRao7aYdfZCOzC41sCSO6L4ZTfIVeNQncFBXwAeDL-ntw&oe=6B005BA6"}, {"file_name": "Credits.png", "id": "923319820519536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820387_923319823852869_1297111853764385899_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3ZNAGErmmUQ7kNvwHJoyhF&_nc_oc=Adrc9NH9TDnWa7DvH2Jp_BgxjsndgFD1bT6PkpzFbnI0lp6HVlUTy4Hy95WZqsxt1jY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5qa-gPDbMPTPinR1LNQBUzJ3WZBUQgKjdBuJZZqEeow&oe=6B006D3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR Gallery entrance.png", "id": "1121729590139146", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823270_1121729593472479_3819227708440234027_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNqxAocfv9AQ7kNvwEJed-A&_nc_oc=AdqExpY4ZCqM3hiiSlMMeqbrf2iBJi7wq-fLQHghTm1f4S98U_rWNlrY8XC3jPDSDV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxab_kJN5jf94RfFxdTNwWa92SgFB-fB4MwkmqBLT-2w&oe=6B00851A"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{2167804033956102}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{959629226719005}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{1261323232241492}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{1638410420634320}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1515864363495044}\n", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "de_CH"], "supported_input_devices": [
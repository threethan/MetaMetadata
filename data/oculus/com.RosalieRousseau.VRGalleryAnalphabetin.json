N_E&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbSZujqm-4b_OKUS-qRgm_xxNjncuqav5dhDbj6ey9NQ&oe=6AFF2783"}, {"file_name": "05 Textpassage aus slam poetry.png", "id": "2176282106507338", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823296_2176282109840671_2595563376200481141_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zweMOB77wOgQ7kNvwH14F4v&_nc_oc=AdqSqweudY-DaRk3jX57bEVX8lroPMYvkO5c7kig3naWbxMqeM7nv5K6Ki7LCkUUuw4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwZqQmdWAMtTFudh60UEyaXyZxdqT7FGOzyFQyfS2IDw&oe=6AFF2CCD"}, {"file_name": "Hintergrundinfos.png", "id": "1703301544441448", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823930_1703301554441447_5414469028825776973_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqlvCt597-8Q7kNvwGYTYxX&_nc_oc=Ado66SIU4QTsNrjNHAE5ScvXYP2J934QBzKiLJ7rzD4Pa_dF1cCYw9Ga45lQmR9RZTU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCla1ydYk2NPF2AU6nYshONEnzBnA5LMuceciV3F_bDg&oe=6AFF349A"}, {"file_name": "Credits.png", "id": "2059180124941386", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818849_2059180128274719_588050631174054856_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWj8p4uukrAQ7kNvwFooiEv&_nc_oc=Adri2FN2aU7XvcmTVR9T2nwEsVcuZ4XtmH9RQWc9-liiEtaMBbhYH0ujq4ElR9O4ch8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl3vtWcapvxhGDLntLTyo1J8W1mB_pE4sHL6llb5W-jA&oe=6AFF2381"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "03 Eingang zum Rundgang.png", "id": "2172839470212799", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491819854_2172839476879465_4527144026837560202_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mv5T9Y-xzQkQ7kNvwFG9nxc&_nc_oc=AdpIBhMXNXa_5CoC-eKiFQ393tgHr3HKEW1e5yVAeetZfLBMeQL_b3TetaS8oU1OL70&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8SwVbeAY8ZHuBNL6QqejQpdDrHnTtnJvOiEpPaD4qQw&oe=6AFF2812"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam", "Galerie"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{1791704451809481}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{2043709919863078}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{860490972983037}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{2008443426432222}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1595955531508857}", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
wHQTBZ6&_nc_oc=AdruDgtYwIz9zpo6Z5kRLJq46rTE_h-_jMolc2nfju2N2Qtye6q0IUNbgnaxpqeXdYU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dl0vJFL2UA846rQmWuFmB-jcrUYHon_O8Pgkxt2Rjbg&oe=69F89027"}, {"file_name": "04 Raum mit Gammas.png", "id": "981814697675883", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831056_981814701009216_7146791871344493203_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwHZgOZTls0Q7kNvwGAqEIG&_nc_oc=AdoBM80Z0A78vtsH6GAF64QSLHAvslwdP_XdVMsLZWoLZYemUEMpBu2fF-wEQxCWYZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xkNwwhPnX6ce2t5PpxfowoB_UcdBGuEtFv2vs8rsmjw&oe=69F8BEBD"}, {"file_name": "05 Textpassage aus slam poetry.png", "id": "947791144675899", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818890_947791148009232_3544406172087872500_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Dy2pHk5oO8Q7kNvwEW0MMb&_nc_oc=AdrNpnpCRuN5bVUfWc0BlWl2jN0dgU8A4MXpy-MaC2UM-kVlBhZa76odLkS_ECEHQSA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af26ztL6hqWzNo66zXcD_R7dAadYx0qWkDPSrMvbGYyHjg&oe=69F8AFA6"}, {"file_name": "Credits.png", "id": "923319820519536", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820387_923319823852869_1297111853764385899_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-0Dvta8N80Q7kNvwGPpVuV&_nc_oc=AdrO3Odv7HeqjRHJKUlGg0KfP7ESFj_byG6padzEwjbm4EyE5vuf0jRtl4oa7ntlfeo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25X9LMypNkmEiCrk7Tj_9ug0N7iJSCqoeJK8RlujRrdw&oe=69F888FC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR Gallery entrance.png", "id": "1121729590139146", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823270_1121729593472479_3819227708440234027_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PL3J2umh6CoQ7kNvwGSpibi&_nc_oc=AdphCMCCCMWGS0_dappp3zq8LiV6IrIp07syrVN-ymStS1RF06TZ7XHlDMutz2GC4Gw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3e_g7I1T1RVI32p7LlAN2GoDgZtuLMTnl7xCz2HD3K9Q&oe=69F8A0DA"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{2167804033956102}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{959629226719005}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{1261323232241492}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{1638410420634320}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1515864363495044}\n", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id"
0a&_nc_ohc=1BUhPPD_I7QQ7kNvwHnLaZB&_nc_oc=Adqf9nvNY_I74GjOYsIRJAyrwq4LLkfDWn-NnsCt98bd4KBUB56n4XhMBe7HfVamCTw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdgpxJCr9bOpXqsrF40ilpzj_DX95sUMZRoVV4AH1MBQ&oe=6B045F3D"}, {"file_name": "05 Textpassage aus slam poetry.png", "id": "947791144675899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818890_947791148009232_3544406172087872500_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnDicnz7oIoQ7kNvwGOGlEo&_nc_oc=AdoCbXR6DuvSXBTuGcDYNf1ZLzH2bsYUuf0ywGBocNdMJpJHdcjzTn0t8auz_J4O8H8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqUlWy5MbjUbxt18ADTsJ3UT6Fkhpw8EpMef4rYrhHnw&oe=6B048866"}, {"file_name": "Credits.png", "id": "923319820519536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820387_923319823852869_1297111853764385899_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjCD42whi4MQ7kNvwE6dOrS&_nc_oc=AdprlOFtyhln49tkfJLebiN3r56KZ5u_OqEcN2K83DVO3rvpKAxSLtzH_-AqHQmWYnI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnY7xizxG1UnUaPAVwllVZQ59UpH9zwBFC64dzFlDrMw&oe=6B0461BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VR Gallery entrance.png", "id": "1121729590139146", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823270_1121729593472479_3819227708440234027_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLpdpu7ACrYQ7kNvwGoVmro&_nc_oc=AdpwRmHH4A8zJDbiIy_dTD6XhO-HvOYgTfgdUDgpLxIQd6mAzjBKYZCLqGKUZfMbpZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYei2gN0IZY_IQGZ26N2xkl-MIJpx8FTBSpT-dBui1oA&oe=6B04799A"}, "display_name": "Galerie-Rundgang An-alpha-betin", "keywords": ["VR", "art", "kunst", "poetrySlam"], "long_description": "# Herzlich Willkommen in den Ausstellungsr\u00e4umen der VR Galerie von Rosalie Rousseau!\n\n(Hinweis: Diesen Rundgang gibt es nur auf Deutsch, da es sich um eine deutschsprachige slam poetry handelt. Eine \u00dcbersetzung ins Englische macht wenig Sinn.)\n\n{2167804033956102}\n\nErlebt einen virtuellen Rundgang durch die slam poetry **An-alpha-betin**. Zu jeder Textpassage der poetry findet ihr shorts, die ihr per Klick abspielen k\u00f6nnt.\n{959629226719005}\n\nZu jedem Video k\u00f6nnt ihr die entsprechende Textpassage sowie Hintergrundinformationen einblenden.\n{1261323232241492}\n\nDie Navigation wird euch in einem Tutorial Schritt f\u00fcr Schritt erkl\u00e4rt.\n{1638410420634320}\n\nW\u00e4hrend des Rundganges steht euch diese Info auch weiterhin zur Verf\u00fcgung.\n{1515864363495044}\n", "short_description": "\u201eAn-alpha-betin\u201c ist eine slam poetry, dicht gepackt an Assoziationen und Nebenstr\u00e4ngen. Der Galerie-Rundgang l\u00e4dt zum Verweilen und Vertiefen entlang des Textes ein. Jeder Text gewinnt an weiteren Dimensionen durch Visualisierung und Meta-Informationen. Hinter jeder Visualisierung steckt eine weitere kleine Geschichte und emotionale Momentaufnahmen als shorts.\nDer Rundgang durch die slam poetry \u00f6ffnet neue Gedankenr\u00e4ume und malt Stimmungsbilder \u2013 mal lustig, mal r\u00e4tselhaft, mal verst\u00f6rend."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rosalierousseau.de/DatenschutzImpressum.html", "developer_terms_of_service_url": null, "publisher_name": "Rosalie Rousseau", "support_website_url": null, "website_url": "http://www.RosalieRousseau.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "de_CH"], "supported_input_devices": [
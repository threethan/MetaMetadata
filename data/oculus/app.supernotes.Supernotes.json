73391934_953187603039922_98055981928953397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQv70t4cGNMQ7kNvwH1SNku&_nc_oc=Adrkwn_6g89-zKkemVlHEQixE2WdMNV4KehdRV7W13GDyAm-WgZz6uviNCOYv8XpWZ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2zkE-j8v4jLyespl-N6tegvZgR6kSQeTxA3zBLOUZhA&oe=6A830FCD"}, {"file_name": "All Devices.png", "id": "590450237225633", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393425_590450240558966_8808361668466090012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPublcmVBxMQ7kNvwEM2sQX&_nc_oc=AdpyblRXqMy4oWfMjN4IN8XudCiDf7WoehUZYEKNfiYPlgR108i4Nln08Bn33cNNXv8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPRRdwl4u8BgtrzFBy0iLEOt-Uf2Vd1qb2nU4FIHO7eA&oe=6A82E3C6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Supernotes \u2013 Notes & Journal", "keywords": ["notes", "journal", "app", "productivity", "writing"], "long_description": "Write beautiful notes that pop with colors, tasks, bold, italics, lists, equations, images, code snippets, and more. Explore the entire interface with natural hand gestures - no controllers needed. \n\nFor power users, pair a Bluetooth keyboard to use all keyboard commands and harness our full Markdown and LaTeX editor.\n\n**Build your Knowledge with your Hands**\n\nReach out and explore your network of interconnected knowledge with our hand gestures - grab, arrange, and visualize your notes in both 2D and windowed 3D to discover new connections. \n\n**Multitask with Friends**\n\nAdd friends to edit and comment on notes together in VR, even while multitasking with other apps in your virtual space. View side-by-side when browsing the web, watching videos or playing games \u2013 great for those walkthroughs and action lists.\n\n**Share Anywhere, Instantly**\n\nCreate share links and pop out cards in your web browser and place them around your room in mixed reality. Share your cards on Whatsapp, Instagram or send secure links to friends (they don't need Supernotes).\n\n**On All your Devices, Offline or Online**\n\nLeft your headset at home? Pick up where you left off with our desktop, mobile, and web apps. Keep taking notes wherever you are, even if your connection drops, with seamless offline support on Meta Quest.\n\n**Feature Complete**\n\n- Universal Search & Filters \n- Custom Collections\n- Bi-directional links\n- Hand gesture navigation\n- Four day & night themes\n- Social media sharing\n- Keyboard shortcut support\n- 24/7 customer support", "short_description": "Free your thoughts with Supernotes, the fast, lightweight notes app. Write beautiful notecards that are perfect for personal, work, and educational use \u2013 all your ideas, meeting, and lecture notes at your fingertips."}]}, "developer_name": null, "developer_privacy_policy_url": "https://supernotes.app/privacy", "developer_terms_of_service_url": "https://supernotes.app/terms", "publisher_name": "Supernotes", "support_website_url": "https://help.supernotes.app/", "website_url": "https://supernotes.app/features/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37119000191077685"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473397628_839551151678565_887977093172395237_n.png?stp=dst-png_s360x360&_
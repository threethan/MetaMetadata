ontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822581_2504234716661537_6319911094828857213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uviusSotpAQQ7kNvwF2yMls&_nc_oc=AdrkiR7DAjAc3GNjypFEVC0rSnKjTj1_oQ5Es1BvO-ZcaVQ2OdbPoOQatx9NEfAuLa4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICtGCPkztm40QZEL9P3-ERMpsqPi7QMYfugXC9K_AzKQ&oe=6AB14C24"}, {"file_name": "screenshot02.png", "id": "1328459315312555", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822883_1328459318645888_5834989203623867068_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QabM-OFa9J8Q7kNvwECi7vg&_nc_oc=AdpaFzha_kGr76EUGAYDZAhKfxuyLDntsrPmge-XfwujqZgvR_VasaowpvTaUdPfh_s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmGO_oM1-XIKW4SNy5y7GDdnRE-02FMdHAMxJ49vlOZQ&oe=6AB14496"}, {"file_name": "screenshot03.png", "id": "1524474328684253", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819396_1524474332017586_8136804002307548387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZMcCpp2UyAQ7kNvwFADgON&_nc_oc=AdqETZvPrBwJmmTdQXayucAffushp-o17qgl3DE_DyxU-40ueVNnHBzlS1fEr66yn_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkzQiLbyyHbDL-tEA5mtItLaDL5FF26sWRZv58PLepVA&oe=6AB14461"}, {"file_name": "screenshot04.png", "id": "785427324380604", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822723_785427327713937_3950590502301232522_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yEbg6ZgBm8Q7kNvwEJyVy5&_nc_oc=AdqU3GdD4EImoWD-9CwytpKVUhexg003LUmikwhPXYZkM5KOR1PVz0_TwGo8oiaqeYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItTWEilrpN-TOMRTfWMCRi1KpTqCr55XvYxtHmfLBioQ&oe=6AB14CEE"}, {"file_name": "screenshot05.png", "id": "2970000616541213", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820652_2970000619874546_2327628790379271371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGo7epJUMGcQ7kNvwH_xZYV&_nc_oc=AdpRw6pfSkfFvCoE_sI5cGq4io6eYlDQko41y-EWG4vKQ6BeWkvFgd4sWRi0uFlZTMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGovRLPvicmycTC2VyLNkN7o92vWRVBJFpmbxNgiviiQ&oe=6AB14DA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1295014982100045", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818916_1295014985433378_1368902271701280495_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tg6Mdn2szoUQ7kNvwETTETh&_nc_oc=AdqPWjIGMnuPfjMXm7ApoeceM9nbU52a-tIA1lmCFC3F1PRXPeVUgsvwqOd7wdTf06Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl0Jt8Ieb68XYCVWKwtB3Tv6QFHt2TdeUP6TQCkp5pMg&oe=6AB13B75"}, "display_name": "Santa Cruz - Living Shorelines", "keywords": [], "long_description": "Discover how sea level rise and powerful storms could shape the future of Santa Cruz \u2014 and explore how nature can help protect our coast.\n\nIn this interactive app, you\u2019ll join Otter 841, the famous surfboard-stealing otter turned storyteller, on a playful yet eye-opening journey along the Santa Cruz shoreline. From Steamer Lane to Main Beach, Its Beach, and Mitchell\u2019s Cove, you\u2019ll witness flooding, erosion, and coastal change \u2014 then test out living shorelines and nature-based solutions that can keep beaches, wildlife, and neighborhoods safe.\n\n\u2728 What you\u2019ll experience:\n\nImmersive 360\u00b0 visuals of Santa Cruz\u2019s iconic coast\n\nInteractive tools to explore storm and sea level rise impacts\n\nNature-based solutions like dunes, reefs, tidepools, and marshes\n\nA unique perspective from Otter 841, your fun and fearless guide\n\nWhether you\u2019re a student, community member, or simply curious about coastal resilience, this app brings the future of Santa Cruz to life in an unforgettable way.\n\nLet\u2019s ride the waves of change \u2014 and protect the coast together. \ud83c\udf0a\ud83e\udda6", "short_description": "\ud83c\udf0a Explore the future of Santa Cruz\u2019s coast with Otter 841, the surf-loving sea otter! \ud83e\udda6 See how sea level rise, storms, and erosion could reshape beaches and neighborhoods, then discover nature-based solutions like dunes, reefs, and marshes that can protect people and wildlife. With immersive visuals and interactive tools, this app makes climate resilience engaging, local, and unforgettable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies INC", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8955030347954445"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1346174657614869"}, {"status": "PUBLISHED", "id": "4208020999413003"}]}, "baseline_offer": {"id": "1346174657614869"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780006440, "status": "PUBLISHED", "id": "1346174657614869"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9243794919077985", "version": "0.14.0"}, "id": "1295396032295387", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename"
ontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822581_2504234716661537_6319911094828857213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6M2YFwGWRoQ7kNvwGgiVB0&_nc_oc=AdqmGFIUIkf78djspZFQ_ULwrtnKdYIjHklbqTDkHO9E4dmdXbI5K_2_FMj0GpJRBns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzBztwhrABNjK5Vjs8HBoxceS0inhR_YMhC2TNwcTZww&oe=6AAAB4A4"}, {"file_name": "screenshot02.png", "id": "1328459315312555", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822883_1328459318645888_5834989203623867068_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcoChXi241oQ7kNvwGde_wP&_nc_oc=AdrdYv18fpuyo06EnPmHJncOBkfXEurZG5Xap_YSfCPt8xFZ2B6qgSQ41yiR5LBesn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHKnrb56CA_yKDglIZ6eI32_EtG0nywJyuLko8FTRxww&oe=6AAAAD16"}, {"file_name": "screenshot03.png", "id": "1524474328684253", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819396_1524474332017586_8136804002307548387_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n01l-xhfYtgQ7kNvwE1mzqX&_nc_oc=Adr9yAPrf-PV7Ez3_6RLNMT97VgAzzY0NvUEokR9svbqIsrAJsEjpNhuT0ISUIj1QKo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2Ldysb0PItrMJyHwfi4MpuV1dC3Fm7dXtJ49q73kZEg&oe=6AAAACE1"}, {"file_name": "screenshot04.png", "id": "785427324380604", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822723_785427327713937_3950590502301232522_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5uQcplFIbsQ7kNvwF_zKzI&_nc_oc=AdrtCpRdr4CsryM5BLiMGHPCsUgYPhvLuS60H94zjmD_z_CPbtJqzDymjxMNKwNiE9o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKC3hwCHJVZX7Sz5aFnLX6z7Vb2u7vAXmcLii6nEqQCEw&oe=6AAAB56E"}, {"file_name": "screenshot05.png", "id": "2970000616541213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820652_2970000619874546_2327628790379271371_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rN-2ncmBhGEQ7kNvwGxvcNp&_nc_oc=AdrQoSljeftk8RsqcrK9Rav7hhGPlKZWqEd6_mW2p6ryP0-c4nlG-r2B_YyEF1HWEpE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrhKWeWr_jsOCFq5CiH7ThXmXEEXp98MVeN-G4UOEPVw&oe=6AAAB621"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1295014982100045", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818916_1295014985433378_1368902271701280495_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8KM0Q0eJ4UQ7kNvwGI18Yq&_nc_oc=AdridXoXVSZQK6z7R12zN-ZNXcL_JXYMekPC_iwliRLxjtF_IsqlcGc0X4EbZo4Z6Co&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8aG90Q8iJHO49EqTO0oFuMJf63KMYPfGfgwan2c2kqw&oe=6AAAA3F5"}, "display_name": "Santa Cruz - Living Shorelines", "keywords": [], "long_description": "Discover how sea level rise and powerful storms could shape the future of Santa Cruz \u2014 and explore how nature can help protect our coast.\n\nIn this interactive app, you\u2019ll join Otter 841, the famous surfboard-stealing otter turned storyteller, on a playful yet eye-opening journey along the Santa Cruz shoreline. From Steamer Lane to Main Beach, Its Beach, and Mitchell\u2019s Cove, you\u2019ll witness flooding, erosion, and coastal change \u2014 then test out living shorelines and nature-based solutions that can keep beaches, wildlife, and neighborhoods safe.\n\n\u2728 What you\u2019ll experience:\n\nImmersive 360\u00b0 visuals of Santa Cruz\u2019s iconic coast\n\nInteractive tools to explore storm and sea level rise impacts\n\nNature-based solutions like dunes, reefs, tidepools, and marshes\n\nA unique perspective from Otter 841, your fun and fearless guide\n\nWhether you\u2019re a student, community member, or simply curious about coastal resilience, this app brings the future of Santa Cruz to life in an unforgettable way.\n\nLet\u2019s ride the waves of change \u2014 and protect the coast together. \ud83c\udf0a\ud83e\udda6", "short_description": "\ud83c\udf0a Explore the future of Santa Cruz\u2019s coast with Otter 841, the surf-loving sea otter! \ud83e\udda6 See how sea level rise, storms, and erosion could reshape beaches and neighborhoods, then discover nature-based solutions like dunes, reefs, and marshes that can protect people and wildlife. With immersive visuals and interactive tools, this app makes climate resilience engaging, local, and unforgettable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies INC", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8955030347954445"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1346174657614869"}, {"status": "PUBLISHED", "id": "4208020999413003"}]}, "baseline_offer": {"id": "1346174657614869"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780006440, "status": "PUBLISHED", "id": "1346174657614869"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9243794919077985", "version": "0.14.0"}, "id": "1295396032295387", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename"
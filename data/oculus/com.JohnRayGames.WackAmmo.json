017014.png", "id": "1171226828034505", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473392025_1171226834701171_7732110338786660845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8iRloIP6kIQ7kNvwHiVZ7b&_nc_oc=AdrDOL6hu7QSZqh9dOWL5QyAfscblbRkLq9hu86oopSyO3kyhIBJQebpYf5wfoqL1k4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQED2JdeeF78vfoHXvgca6hENpAmq_DSyGZtxiUFASpgDg&oe=6A81B107"}, {"file_name": "1000017016.png", "id": "1020510112794458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392016_1020510116127791_1096840343013264339_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C97fLfXqeaAQ7kNvwHDS_od&_nc_oc=AdoA_askjZ3lW2pwr5Eelo-A1pia3C9z3YJPKE13JcPXEeivEEETCXW4xRs-GjfxGLc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEspAqTJx0kMBPKh9-skiEuM9I4VasPYn0bEXuz-zumXA&oe=6A819DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "284612080076581", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974910_284612083409914_181064660682537571_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSAvV2OhHvUQ7kNvwFSFXwz&_nc_oc=Adr03d7OHnjcFQgxOBdQDSPO_eEenqjihxRXHPd-LKOTN29kYxcEWreiHaP0413iGbg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdR8H42YT33ObovEVsV3THZQBGxFgL7dsujd01z-Y5JQ&oe=6A819674"}, "display_name": "Wack-Ammo", "keywords": ["shooting", "mole", "reflex", "arena", "trophy"], "long_description": "You are armed with a Wack-A-Mole game and a gun to eliminate your targets in each new gallery.  The trick is, you must keep playing Wack-A-Mole to keep your gun loaded.  \n\nEach level ups the challenge and keeps you on your toes.  Take your eyes of the board and it could end it all.  \n\nWack-Ammo is a fun throwback to the old light gun games of the 8 bit era. The hand drawn 2D graphics put you inside these classic shooters with the added flare of VR.\n\n* 9 Unique Levels \n* Different Guns & Wackers Each Gallery\n* Unlock Badges For Your \"Wall Of Achievement\" With Each Victory\n*Earned Trophies Come To Life In Your Home Gallery\n\nWack-Ammo is a must play for every Quest owner.", "short_description": "You are armed with a Wack-A-Mole game and a gun to eliminate your targets in each new gallery.  The trick is, you must keep playing Wack-A-Mole to keep your gun loaded.  \n\nEach level ups the challenge and keeps you on your toes.  Take your eyes of the board and it could end it all.  \n\nWack-Ammo is a fun throwback to the old light gun games of the 8 bit era. The hand drawn 2D graphics put you inside these classic shooters with the added flare of VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/wackammo", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9249440675166524"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75245820_500176119373591_7385347142142095459_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pl9GPB6sZM8Q7kNvwFpdJtt&_nc_oc=AdrYxfqqGHvJVOQJKg4-BHXKkQT9rAQcttKritdlCuEmD_Uuiu3QOWu110rRQ6sqsfE&_nc_zt=3&
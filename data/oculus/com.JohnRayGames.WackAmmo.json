110338786660845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUlrD1ovREEQ7kNvwEvtOP9&_nc_oc=AdnmMBLgLThz7pUZKh2ydyqAeOxlvhsZFC6rfWzuSWiDs_lV5JKsN96xRpBH7oZDJ_M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuKGiB7pZqrHovkJJE6UqNgKfJcE2yBE-IHjUBZ0fuwsA&oe=699EEF07"}, {"file_name": "1000017016.png", "id": "1020510112794458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392016_1020510116127791_1096840343013264339_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o82DI18Amh4Q7kNvwF3ELPj&_nc_oc=AdlwmAc6YfqjhpJO-oYlBUj_p36LtdmkfqkPfWDda7sD928XEXwj1MzkBk31uEWYCRs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftJOJSK7mba-BMgXAzUJ5EQjAERGoP0asYhLIARjsPH3g&oe=699EDBE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "284612080076581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974910_284612083409914_181064660682537571_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtMOOCpVK1oQ7kNvwGx65F8&_nc_oc=AdnbIAzSWRif78KSVPATUGdRSTKKjd6hkKaxTAzI3HPBl6ECIdmrr3vA8AnBp177B9w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftg98laERiLj7SrdcpH5f_A44GGqRYRHekeD7XYt1Xh2A&oe=699ED474"}, "display_name": "Wack-Ammo", "keywords": ["shooting", "mole", "reflex", "arena", "trophy"], "long_description": "You are armed with a Wack-A-Mole game and a gun to eliminate your targets in each new gallery.  The trick is, you must keep playing Wack-A-Mole to keep your gun loaded.  \n\nEach level ups the challenge and keeps you on your toes.  Take your eyes of the board and it could end it all.  \n\nWack-Ammo is a fun throwback to the old light gun games of the 8 bit era. The hand drawn 2D graphics put you inside these classic shooters with the added flare of VR.\n\n* 9 Unique Levels \n* Different Guns & Wackers Each Gallery\n* Unlock Badges For Your \"Wall Of Achievement\" With Each Victory\n*Earned Trophies Come To Life In Your Home Gallery\n\nWack-Ammo is a must play for every Quest owner.", "short_description": "You are armed with a Wack-A-Mole game and a gun to eliminate your targets in each new gallery.  The trick is, you must keep playing Wack-A-Mole to keep your gun loaded.  \n\nEach level ups the challenge and keeps you on your toes.  Take your eyes of the board and it could end it all.  \n\nWack-Ammo is a fun throwback to the old light gun games of the 8 bit era. The hand drawn 2D graphics put you inside these classic shooters with the added flare of VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/wackammo", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9249440675166524"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75245820_500176119373591_7385347142142095459_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfhHKhnw678Q7kNvwEGXfrW&_nc_oc=AdkKDrRjTw_5V7aiFCuONTH_9A-pfZrMW8a5E4RddIDUctJ7nVYT3Pu3kU1YEq-611M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuVb8yBVhPvRElHRLrl9OfNdBp2UQxGYSJIiymiZRqulA&oe=699F0473"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
}, {"file_name": "8.png", "id": "485635779381042", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036615_485635782714375_1385063564147581312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dHqcemd-_cQ7kNvwGtiURM&_nc_oc=AdokUC6Y1y11GhIlTZS8tR75VHiObxYoQAFKe2gAXrmJUUmkIcVWyTCrDTVKKTdnX5M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CWeCNlZdWRXVXcKBpiDxYzGCy6pGb-g6j3zgApWJTcw&oe=6A11B85A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "284612080076581", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974910_284612083409914_181064660682537571_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-oUs8H8sKsQ7kNvwGQtuJx&_nc_oc=AdpMmXDj3xJbPA_F5mQB7tv8ttJD0WW41dZicQ3L2_sw_yuaWHOG04cvmRJ9EhLv-Ws&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RKwsL2fr68ivLc1J8bVVj5w_l0P99ctxjZKFGoCg09Q&oe=6A11BF34"}, "display_name": "Wack-Ammo", "keywords": [], "long_description": "You are armed with a Wack-A-Mole game and a gun to eliminate your targets in each new gallery.  The trick is, you must keep playing Wack-A-Mole to keep your gun loaded.  \n\nEach level ups the challenge and keeps you on your toes.  Take your eyes of the board and it could end it all.  \n\nWack-Ammo is a fun throwback to the old light gun games of the 8 bit era. The hand drawn 2D graphics put you inside these classic shooters with the added flare of VR.\n\n* 9 Unique Levels \n* Different Guns & Wackers Each Gallery\n* Unlock Badges For Your \"Wall Of Achievement\" With Each Victory\n*Earned Trophies Come To Life In Your Home Gallery\n\nWack-Ammo is a must play for every Quest owner.", "short_description": "You are armed with a Wack-A-Mole game and a gun to eliminate your targets in each new gallery.  The trick is, you must keep playing Wack-A-Mole to keep your gun loaded.  \n\nEach level ups the challenge and keeps you on your toes.  Take your eyes of the board and it could end it all.  \n\nWack-Ammo is a fun throwback to the old light gun games of the 8 bit era. The hand drawn 2D graphics put you inside these classic shooters with the added flare of VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/wackammo", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "746400826676726"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "2313574049114059"}, {"status": "PUBLISHED", "id": "558323820641266"}, {"status": "PUBLISHED", "id": "3624764091160367"}, {"status": "PUBLISHED", "id": "1329799684739547"}, {"status": "PUBLISHED", "id": "954238643549570"}, {"status": "PUBLISHED", "id": "576675718533878"}, {"status": "PUBLISHED", "id": "1767128960777684"}, {"status": "PUBLISHED", "id": "1607217473473284"}, {"status": "PUBLISHED", "id": "1125388185186379"}, {"status": "PUBLISHED", "id": "245266807351669"}, {"status": "PUBLISHED", "id": "972039073407044"}, {"status": "PUBLISHED", "id": "960219351437940"}]}, "baseline_offer": {"id": "1125388185186379"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "2313574049114059"
36615_485635782714375_1385063564147581312_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIEW31M6hXIQ7kNvwF6SLWB&_nc_oc=AdlB76LQ_y4ZB2J4Hb2BaMz3BOUtsf8mQ1sC23iKqJKO8Nu1yDS84vI7YQ-fM7lGE_I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwroSMrOa8X7BDXn27uAxN7P6T6QKavcbPSbscfHCp0gg&oe=69BFFB5A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "284612080076581", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974910_284612083409914_181064660682537571_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUdNSfwrGzUQ7kNvwFUZWj9&_nc_oc=Adlad25rxGXiWf72PCHNm9rU_sie8TX2nsMh91eI5Jgsk87fMXAz1BZNVW25XTjr2T4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpqiuC5pisbJY8UyTmG1evi5Ieb4B1j4hzseIgP7eUeQ&oe=69C00234"}, "display_name": "Wack-Ammo", "keywords": [], "long_description": "You are armed with a Wack-A-Mole game and a gun to eliminate your targets in each new gallery.  The trick is, you must keep playing Wack-A-Mole to keep your gun loaded.  \n\nEach level ups the challenge and keeps you on your toes.  Take your eyes of the board and it could end it all.  \n\nWack-Ammo is a fun throwback to the old light gun games of the 8 bit era. The hand drawn 2D graphics put you inside these classic shooters with the added flare of VR.\n\n* 9 Unique Levels \n* Different Guns & Wackers Each Gallery\n* Unlock Badges For Your \"Wall Of Achievement\" With Each Victory\n*Earned Trophies Come To Life In Your Home Gallery\n\nWack-Ammo is a must play for every Quest owner.", "short_description": "You are armed with a Wack-A-Mole game and a gun to eliminate your targets in each new gallery.  The trick is, you must keep playing Wack-A-Mole to keep your gun loaded.  \n\nEach level ups the challenge and keeps you on your toes.  Take your eyes of the board and it could end it all.  \n\nWack-Ammo is a fun throwback to the old light gun games of the 8 bit era. The hand drawn 2D graphics put you inside these classic shooters with the added flare of VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/wackammo", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "746400826676726"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "2313574049114059"}, {"status": "PUBLISHED", "id": "558323820641266"}, {"status": "PUBLISHED", "id": "3624764091160367"}, {"status": "PUBLISHED", "id": "1329799684739547"}, {"status": "PUBLISHED", "id": "954238643549570"}, {"status": "PUBLISHED", "id": "576675718533878"}, {"status": "PUBLISHED", "id": "1767128960777684"}, {"status": "PUBLISHED", "id": "1607217473473284"}, {"status": "PUBLISHED", "id": "1125388185186379"}, {"status": "PUBLISHED", "id": "245266807351669"}, {"status": "PUBLISHED", "id": "972039073407044"}, {"status": "PUBLISHED", "id": "960219351437940"}]}, "baseline_offer": {"id": "1125388185186379"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768845600, "status": "PUBLISHED", "id": "2313574049114059"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes"
017014.png", "id": "1171226828034505", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392025_1171226834701171_7732110338786660845_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LU_OpuPGdnwQ7kNvwECHnht&_nc_oc=AdqfVLHoXGYwCAM8zgkpT2uw0id4tpzJWhhZICafrH0K8OSN974VeL6Aa57U9avVkko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3-Ly1Xb_wAaHHtk_I5WVWNVoaI0FEYF8toT8rWMc7rg&oe=6A4A5207"}, {"file_name": "1000017016.png", "id": "1020510112794458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392016_1020510116127791_1096840343013264339_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=go5HJ-gTDrMQ7kNvwFj8p1Q&_nc_oc=AdphdbnZUg718hLRkLTXjtpsI7-5JcjpChktS8_6O9c2TsAAgmMxwwtgqmidREJAEQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSK4JWUxes52sUHhX2K8HnORQjua-kO3EdiXLKErmszw&oe=6A4A7724"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "284612080076581", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974910_284612083409914_181064660682537571_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdkITzM1eYAQ7kNvwGcCHkV&_nc_oc=AdrYRvSxy7604HhY9KLhfpgX-vhvQgIk9038O1zgC5eJP9zESIlpr3mWRPcEw66wMmM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQiwQCqJNyqgr9N6PNdwG40kMPY3XobW_4LwGI327sFA&oe=6A4A6FB4"}, "display_name": "Wack-Ammo", "keywords": ["shooting", "mole", "reflex", "arena", "trophy"], "long_description": "You are armed with a Wack-A-Mole game and a gun to eliminate your targets in each new gallery.  The trick is, you must keep playing Wack-A-Mole to keep your gun loaded.  \n\nEach level ups the challenge and keeps you on your toes.  Take your eyes of the board and it could end it all.  \n\nWack-Ammo is a fun throwback to the old light gun games of the 8 bit era. The hand drawn 2D graphics put you inside these classic shooters with the added flare of VR.\n\n* 9 Unique Levels \n* Different Guns & Wackers Each Gallery\n* Unlock Badges For Your \"Wall Of Achievement\" With Each Victory\n*Earned Trophies Come To Life In Your Home Gallery\n\nWack-Ammo is a must play for every Quest owner.", "short_description": "You are armed with a Wack-A-Mole game and a gun to eliminate your targets in each new gallery.  The trick is, you must keep playing Wack-A-Mole to keep your gun loaded.  \n\nEach level ups the challenge and keeps you on your toes.  Take your eyes of the board and it could end it all.  \n\nWack-Ammo is a fun throwback to the old light gun games of the 8 bit era. The hand drawn 2D graphics put you inside these classic shooters with the added flare of VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/wackammo", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9249440675166524"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75245820_500176119373591_7385347142142095459_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YEhPzpHEkCsQ7kNvwEJLf20&_nc_oc=Adqxg2kFMDfxLgQqtFgYtbXqbIMVkdvxEGrtsg0Hb4evYugs5McBJhtj2jj4m83YURg&_nc_zt=3&
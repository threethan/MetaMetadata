A0F17DB"}, {"file_name": "4.png", "id": "1253776252811120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821696_1253776256144453_7370202677132028612_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pwxjVR9KgAQ7kNvwEL7h5e&_nc_oc=Adq9WywnkNQxe0PXz-GMnGkQGTHyJuXbNYAqVG1EnnQHOq86OmezOpcwTZrRDR44JF8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6keyJOZTfwJVg7qJMFdPJAmO9k5oZRaSG6LYG1dM_KFQ&oe=6A0EF52E"}, {"file_name": "3.png", "id": "1451243293210583", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618938_1451243296543916_459226909439439079_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_JaQbOA27AQ7kNvwFHPEWe&_nc_oc=Adql-X6B_1136MZmNs4XX8y1mSLd3iJsF8uzn4IL3TGyAz2YzUaFovLO8opPVfrhIwg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d3uVjHncS9ZALtBCyp5R8IuDaPUbj25089S8yIujAzw&oe=6A0EFCA1"}, {"file_name": "5.png", "id": "1720209355625707", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618069_1720209358959040_3218248321251489483_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_dF2mRutpxgQ7kNvwHrrrau&_nc_oc=Adpp9QgNH-uiq8vsiBDH5fTKI8rFcfw_aZm0IpCDTETXXIkhTLi8sxk6RXiSW8KGSBI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u2H9BvgrwPEHOspAOsZzNLKvPQah3H6GDtLjb5MkEaw&oe=6A0EFF51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StrikeCommand-Cover.png", "id": "2161951091270912", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618297_2161951094604245_8487009373145202445_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnKAYzHnoBkQ7kNvwGEzILH&_nc_oc=AdodxO0phze4PHbK1iJdSod_otD6AgRoFtiTkqmha49xWxcAnBTYKBSYZdwsKiJBGNU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QMGB3d_3T-lMEHNrfJFZdNfIpTIZHD-vgBOsgNFhC6w&oe=6A0F0B6B"}, "display_name": "Strike Command", "keywords": ["TowerDefense", "ImmersiveDefense", "TurretShooter", "AlienInvasion", "TacticalCombat"], "long_description": "**A Next-Generation VR Tower Defense Game**\n\n**Strategic Deployment. Maximum Firepower. Take Back the Battlefield.**\n\nThe invasion wasn\u2019t a warning; it was a total takeover. Alien machines have descended on Earth with a singular, brutal objective: strip the planet\u2019s Power Core and leave nothing behind. They\u2019ve already wiped out our primary defenses, and now, they\u2019re coming for the heart of our world.\n\n{1406752387915557}\n\nAs the commander of Strike Command, you are the last line of defense. But in this war, you don\u2019t just sit behind a desk and watch dots on a map. You are the most lethal weapon on the field. Whether you\u2019re orchestrating a complex grid of turrets or jumping into the heat of the action yourself, the fate of the planet rests on your aim.\n\n{1302894424989107}\n\n**Manual Overdrive**\n\nSometimes, automation isn't enough. At any moment, you can dive into any turret and take manual control. While you\u2019re in the seat, attack power surges by 50%. This isn't just a change in perspective\u2014it\u2019s how you break a stalemate and crush a breakthrough.\n\n{1927163108677424}\n\n**Loadout Strategy**\n\nVictory is decided before the first shot is even fired. Choose three core turrets from your arsenal to bring into the fight. Every map demands a different approach, and your ability to match your gear to the enemy's path is what keeps the Power Core intact.\n\n{752093197697181}\n\n**Global Leaderboards**\n\nSee how you stack up against the best commanders on the planet. With separate rankings for Easy, Normal, and Hard modes, you\u2019ll need to refine your tactics and master your timing to claim the top spot.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "Deploy. Control. Destroy.\n\nThe invasion is here. Alien machines are tearing through Earth\u2019s defenses to reach the Power Core. As Commander, you are the last barrier between them and total extinction.\n\nIn Strike Command, you don\u2019t just watch the battle\u2014you lead it. Built natively for Meta Quest 3, this is a VR tower defense where your direct intervention turns the tide."}]}, "developer_name": "WEWE Studio", "developer_privacy_policy_url": "https://td.wewe.ws/PrivacyPolicy.php", "developer_terms_of_service_url": null, "publisher_name": "WEWE Studio", "support_website_url": null, "website_url": "https://wewe.ws/strikecommand", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "zh_HK", "zh_CN", "ja", "ko", "de", "it", "es", "es_MX", "fr", "fr_CA", "fr_BE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26022429204081082"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619187_1235723355391040_1320695967582626221_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd0bSiBzvEcQ7kNvwE-bi76&_nc_oc=Ado9CpiuhGsvega2lYudyyqXlhyDsrfL2clOdAo7HMOr5cve_rZtuHrbeLsedXNG-4I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uVJRTlGIm2KOWaGanbwVIeE-O_vAktslVlgBEhNwYZg&oe=6A0F199C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Strike Command", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Arcade", "id": "159219
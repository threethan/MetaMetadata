=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXsC9wj45XYQ7kNvwFnQMqD&_nc_oc=AdqmUqiXUUUn5m-eYV5uiNKkEbrXaNjJEeVH5DJmm1DHdh1hv0X3-6LLRULyzHs_K-s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iMuY5--48WBJVYvkxAOnmxzjb4wv9Sgu5UKuUSBP66Q&oe=6A2437E1"}, {"file_name": "resized_croped_5.png", "id": "458798195351082", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974450_458798198684415_1033750759055308696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uzD3nW4ncSEQ7kNvwGSYwd3&_nc_oc=AdqwA_O76L_aP_xKVySYuJpURxyiTvNaRRFpaq_z4q92-06iZKs9YsulrczObq5FzY8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FmpgADmQHeRwJDQNjVra9-HU9ZScXbkfXZ7h6WHBHrw&oe=6A243954"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v4.1-Cover Landscape-2560x1440px.png", "id": "275361514246577", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982466_275361517579910_8819864672038584778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EgESWEmQyoQ7kNvwFnTZWo&_nc_oc=AdoeHo9u3fncRKrGOrKaegbkZwJwE8dMyBkBKphfPLTLI1449GGtAafocW4bua07A6k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e8kBMlcU1qsmn8tYtX6toc-_3QyERNJtLfNMR7rKfdQ&oe=6A24335D"}, "display_name": "Mafia Bowling", "keywords": [], "long_description": "It's proven that people which are bored, sad or stressed, have higher chances of getting cancer and diabetics...\n\nYou need something fun and relaxing after a hard day of work!!\n\nStop wasting your life being sad and tired after a day of work!\n\nGet Mafia Bowling VR and start feeling relaxed and fun right now!\n\nAll this right from the comfort of your own home without paying a fortune or deal with people you don't like.\n\nBtw, when you'll have your first 300 score game, email us to receive special gifts inside the game that other wise you'll work hard to get them.\n\nFeel just like in a real bowling club due to our ultra realistic physics system and mind blowing graphics.\n\nFreely move everywhere you want, not just on the bowling area!\n\nCompete against other players and be in top 20 best players of all time!\n\nSee your game's score in real time on an amazing TV scoreboard.\n\nPick your favorite ball and show to the entire world that you have the perfect game!\n\nSoon you'll be able to play against ", "short_description": "Bored, sad or stressed? Stop wasting your time and relax by playing Mafia Bowling VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.proeminentcode.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proeminent Code SRL", "support_website_url": "https://www.proeminentcode.com/contact/", "website_url": "https://www.proeminentcode.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272141278214800"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25603197236037836", "version": "2.1.482"}, "id": "128436835899003", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__type
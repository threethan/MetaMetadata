\nPick your favorite ball and show to the entire world that you have the perfect game!\n\nSoon you'll be able to play against ", "short_description": "Bored, sad or stressed? Stop wasting your time and relax by playing Mafia Bowling VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.proeminentcode.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proeminent Code SRL", "support_website_url": "https://www.proeminentcode.com/contact/", "website_url": "https://www.proeminentcode.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272141278214800"}}]}, "scheduled_offers": {"count": 63, "nodes": [{"status": "PUBLISHED", "id": "927467149635695"}, {"status": "PUBLISHED", "id": "1234887355404146"}, {"status": "PUBLISHED", "id": "2507272166341850"}, {"status": "PUBLISHED", "id": "1246591507346148"}, {"status": "PUBLISHED", "id": "3860410410917565"}, {"status": "PUBLISHED", "id": "1187884023165050"}, {"status": "PUBLISHED", "id": "1280011353868308"}, {"status": "PUBLISHED", "id": "1125209036133074"}, {"status": "PUBLISHED", "id": "759164276486646"}, {"status": "CANCELLED", "id": "1788671858381104"}, {"status": "PUBLISHED", "id": "1789090075297128"}, {"status": "PUBLISHED", "id": "1037925017826501"}, {"status": "PUBLISHED", "id": "1218
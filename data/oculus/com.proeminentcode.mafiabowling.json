698129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035449_855214055031462_8457158300282572468_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmMKTsp_UBIQ7kNvwFJ-z43&_nc_oc=AdptUmtHChJHYY3_XiX9GsNEZUGhpFcmjn0FiGFVGbPmeso6Y-LQZFSjRF-4jcpiLgE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAALd1tgp2PC6b9W5HxdD8QIUV6QFR5QOKjiFFrhlds7g&oe=6A53ADE1"}, {"file_name": "resized_croped_5.png", "id": "458798195351082", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974450_458798198684415_1033750759055308696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rMLv7cvE1oQ7kNvwHPtyZv&_nc_oc=Adr-ozYZudYa7kT9cHt1F6dwnAZ2jTVAawwHuGT3rCTvpicH6rSc9Mq-ham5LMvuW8c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBAkbDAR_7pQphtQ75ndKA_5McrP6HsgZnVg0hje2KdA&oe=6A53AF54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "v4.1-Cover Landscape-2560x1440px.png", "id": "275361514246577", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_275361517579910_8819864672038584778_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNunzNFQGLcQ7kNvwGMAdG7&_nc_oc=Adqrgn-_K70ubZ8WGHoBUiz6fpLMpugIrea1MEk9cFsniUNYg2sDu1lzICDv4faVSVQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxze0ODmVOgZV_eFPtfqrSPmcaXE2dqxt69MrZcr9AiQ&oe=6A53A95D"}, "display_name": "Mafia Bowling", "keywords": [], "long_description": "It's proven that people which are bored, sad or stressed, have higher chances of getting cancer and diabetics...\n\nYou need something fun and relaxing after a hard day of work!!\n\nStop wasting your life being sad and tired after a day of work!\n\nGet Mafia Bowling VR and start feeling relaxed and fun right now!\n\nAll this right from the comfort of your own home without paying a fortune or deal with people you don't like.\n\nBtw, when you'll have your first 300 score game, email us to receive special gifts inside the game that other wise you'll work hard to get them.\n\nFeel just like in a real bowling club due to our ultra realistic physics system and mind blowing graphics.\n\nFreely move everywhere you want, not just on the bowling area!\n\nCompete against other players and be in top 20 best players of all time!\n\nSee your game's score in real time on an amazing TV scoreboard.\n\nPick your favorite ball and show to the entire world that you have the perfect game!\n\nSoon you'll be able to play against ", "short_description": "Bored, sad or stressed? Stop wasting your time and relax by playing Mafia Bowling VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.proeminentcode.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proeminent Code SRL", "support_website_url": "https://www.proeminentcode.com/contact/", "website_url": "https://www.proeminentcode.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "272141278214800"}}]}, "scheduled_offers": {"count": 68, "nodes": [{"status": "PUBLISHED", "id": "1796237071194228"}, {"status": "PUBLISHED", "id": "994216040137052"}, {"status": "PUBLISHED", "id": "1246586557255124"}, {"status": "PUBLISHED", "id": "798488936622397"}, {"status": "PUBLISHED", "id": "1397362855020691"}, {"status": "PUBLISHED", "id": "927467149635695"}, {"status": "PUBLISHED", "id": "123
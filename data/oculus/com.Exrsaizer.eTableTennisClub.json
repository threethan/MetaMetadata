1n1BBRGIzp6t3SnQlZXgM4a8oHDMTsJnPc5lUGISy-ltXnOj4IPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo-LQeFneE262jUGMegPRSwjMH_g2KjeCJjPMa5_z-Kw&oe=6A9999EA"}, {"file_name": "meta_store_ss_3b.png", "id": "1566854954781869", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619836_1566854958115202_3181374433985079892_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVM03n_tqpcQ7kNvwHKwIwk&_nc_oc=Adr2_o_6LVEKe7jx3_6uX9QmNT7BOtdumz-qKB5MLzilklq1NmO5CQGoXp-K-RWTUNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsgr3S5sFlYLytVpxX0wlwBJ3IxVrnYf8iHaL7jWSBzw&oe=6A9994DA"}, {"file_name": "meta_store_ss_4b.png", "id": "1974973989806944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620921_1974973996473610_7376264963557096014_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qo1F3ng0M6gQ7kNvwFm7IVT&_nc_oc=AdpkTpkgR2zCGSBkx3w6WaP-8HDUfikWaePP-JjmO9kXPYqxVDlxORGM52_MCrV736Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqbfcoLgcNEHyykBuRniOiHgGHud5epA4MBLBkAsih2g&oe=6A9972C2"}, {"file_name": "meta_store_ss_5b.png", "id": "1019748120789784", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620429_1019748124123117_1596873266517979750_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pcbh6gCOZ30Q7kNvwFqoUuM&_nc_oc=Ado7-NkR-ZEaqchR-2eciEvoCMq7uD9ee3n27LkDGW8tTtusR5kTIZBpIHMvbHD7_88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI_U_2FrkU36FpNO1b_mu-YNZP6W5C8wmCWYs7oQRWIw&oe=6A997596"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta_store_big.png", "id": "1512862156975905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619808_1512862160309238_2890587988094344797_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2t0KPJ6pzh4Q7kNvwFJ0IFI&_nc_oc=AdqRKdmmFe4qd5vli1-12-t_Ppv6R3qxj7IfqqjLC8hkBtN0O3P38fGMCAHIdUjTtoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhqKRy_969bN1QXsaXy8XbvpnYHDSjFLWgaxGWSiAxeg&oe=6A999E1A"}, "display_name": "eTableTennis Club", "keywords": ["TableTennis", "PingPong", "eSports", "AI"], "long_description": "# Objective:\n\nOur goal is not simply to create a game or play in a silent arena. We aim to build a place where people can practice, grow, and enjoy table tennis together.\n\nWhether you are a beginner, a competitive player, someone returning to the sport, or someone looking for additional accessibility support, eTableTennis Club is designed to help you keep playing and improving.\n\n# Current Features:\n\n* Realistic table tennis physics\n* VS AI Player mode are designed for enjoyable rallies and effective practice\n* Machine training mode ( fixed basic pattern )\n* Play analyzer for real-time progress tracking\n* Accessibility-support ( wheelchair mode, yips prevention, spin &speed limiter )\n\n# Early Access:\n\neTableTennis Club is currently in Early Access.\n\nThe core experience is already playable, and we are continuously improving the game based on community feedback.\n\nEarly Access members receive ongoing updates, access to future features as development progresses and detail information for FREE.\n\n# Future Development Plan:\n\n* Physics updates continuously\n* Advanced machine training pattern ( additional pattern and coach menu )\n* Continue to learn skills and variable style for AI Player\n* AI coaching and advice features\n* New club activities and community-driven experiences\n* Digital variable rubber and Racket for flexibility\n* etc\n\n# Our Philosophy:\n\neTableTennis Club is developed under the philosophy of IBASHO, a Japanese concept meaning \"a place where people feel they belong.\" eTableTennis Club is only the beginning of \"exrsaizer\".", "short_description": "# eTableTennis Club\n\neTableTennis Club is a digital table tennis club where players can practice , grow, and enjoy table tennis at their own life as club activity."}, {"images": {"nodes": []}, "id": "1715695899471506", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "eTableTennis Club", "keywords": [], "long_description": "\u79c1\u305f\u3061\u306f\u3001\u4e16\u754c\u4e00\u5f37\u3044AI\u3068\u6226\u3046\u305f\u3081\u306e\u30b2\u30fc\u30e0\u3092\u4f5c\u3063\u3066\u3044\u308b\u308f\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002\n\n\u79c1\u305f\u3061\u304c\u76ee\u6307\u3057\u3066\u3044\u308b\u306e\u306f\u3001\u5353\u7403\u3092\u7d9a\u3051\u305f\u3044\u4eba\u306e\u305f\u3081\u306e\u300c\u5c45\u5834\u6240\u300d\u3067\u3059\u3002\n\n\u8eca\u6905\u5b50\u306e\u65b9\u3001\u30a4\u30c3\u30d7\u30b9\u306b\u60a9\u3080\u65b9\u3001\u521d\u5fc3\u8005\u306e\u65b9\u3001\u305d\u3057\u3066\u7af6\u6280\u8005\u306e\u65b9\u3002\n\n\u8ab0\u3082\u304c\u30e9\u30ea\u30fc\u3092\u697d\u3057\u307f\u3001\u6210\u9577\u3092\u5b9f\u611f\u3067\u304d\u308b\u74b0\u5883\u3092\u76ee\u6307\u3057\u3066\u3044\u307e\u3059\u3002\n\neTableTennis Club \u306f\u73fe\u5728Early Access\u3068\u3057\u3066\u958b\u767a\u4e2d\u3067\u3059\u3002\n\nAI\u5bfe\u6226\u3001\u5353\u7403\u30de\u30b7\u30fc\u30f3\u3001\u6210\u9577\u53ef\u8996\u5316\u6a5f\u80fd\u3092\u642d\u8f09\u3057\u3001\u4eca\u5f8c\u306f\u30d7\u30ec\u30fc\u30b9\u30bf\u30a4\u30eb\u5225AI\u3084AI\u30b3\u30fc\u30c1\u6a5f\u80fd\u306a\u3069\u3092\u8ffd\u52a0\u4e88\u5b9a\u3067\u3059\u3002\n\nEarly Access\u30e1\u30f3\u30d0\u30fc\u306f\u3001\n\u958b\u767a\u4e2d\u306e\u65b0\u6a5f\u80fd\u3084\u65b0\u3057\u3044AI\u3092\u7d99\u7d9a\u7684\u306b\u5229\u7528\u3067\u304d\u307e\u3059\u3002\n\u79c1\u305f\u3061\u306f\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u3068\u3068\u3082\u306b\u3001\u3053\u306e\u30c7\u30b8\u30bf\u30eb\u5353\u7403\u30af\u30e9\u30d6\u3092\u6210\u9577\u3055\u305b\u3066\u3044\u304d\u307e\u3059\u3002", "short_description": "eTableTennis Club \u306f\u3001\u5353\u7403\u3092\u611b\u3059\u308b\u3059\u3079\u3066\u306e\u4eba\u306e\u305f\u3081\u306e\u30c7\u30b8\u30bf\u30eb\u5353\u7403\u30af\u30e9\u30d6\u3067\u3059\u3002\n\n\u521d\u5fc3\u8005\u304b\u3089\u7d4c
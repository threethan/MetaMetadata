_image.png", "id": "1167677536908315", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfvJcb62QlkQ7kNvwE8UTnj&_nc_oc=AdlfObty-FD3KemBxTzNNLFht243-gk0wEiCOs-Yr-24oL-3FTlrHZS10SELy6ZTAu4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzD9gKKUBeRd3AGUARciLO7oA87jbgTlM5hUThusPzZSg&oe=69B3F10B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD1Gy8K-y7oQ7kNvwGWtRvE&_nc_oc=AdmaVeeBRNNGl9_8mobfAWBcS5I4MHaSPh76iNRrOW5rGqUZhwF2zI6wGFj-Z49Yt_U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx8EEAnFcgCKHMk1oj93pbFMF3TEfkjaQ3baji58l9yfw&oe=69B3FFB9"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M0n378nJmiIQ7kNvwEjR4fL&_nc_oc=AdlYOekHNKQ6yQecYyFltSR6EN5y0rHXtsWkyweIdsFUo40Pp7bY1zHFacaWPHFpn_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxwUlhElwhK8tzHsXvSa-n58GgDN3M6hozgDrbkxYKaeQ&oe=69B41416"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5t4DUfhjN8Q7kNvwEWNd88&_nc_oc=Adm4MZLC8PhtjIZVDPnUa4McJ0UwQvrmb3tWL-eaezgoKwYGJat8jgebCfh0lWWSucw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_LflbvJb4Mveo39Ecn4DUzkloVy7sJeY6nU0xYyq66A&oe=69B41DA2"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5tSffSG7-MQ7kNvwEdXphC&_nc_oc=Adn6dAsAcD1ccva3yRA-YJjBoy-22jvMoWPTelSxRfD4lJaNCQ_w0svcBGd79Gknw_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZs6nBF5CpDgceQPTUNWWvH6PkC_6Z2IXzVoO-vcS4bQ&oe=69B41F3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommend
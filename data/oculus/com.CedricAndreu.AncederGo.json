_image.png", "id": "1167677536908315", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTNqcNpEXR4Q7kNvwEVZwHK&_nc_oc=Adl1FDz4D-VeKnanLKaq8edodgAqNVKqmTNygLPsdo3FvilFKRZLKf56N56amgNYnGQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwAnHLu58yd-LDnm56p45nhp1HUCvxsW460Z7keyuAPTg&oe=69BA888B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtEA9FHcOdcQ7kNvwGliMXn&_nc_oc=Adm6wxep-aFxczZBpeb3LuZa_GdEMotHXxkgCg_lpMqSb4fZpcMWlDHlacrZ0--qaUk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyIPqA6QnP01c73MARbMQfPGa59MwtGp_Zuxff8fS02Pw&oe=69BA9739"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btEb-t9sKjgQ7kNvwGduIv_&_nc_oc=AdkqV505mlgr1NuXDGE0_dJrUSX5DN6c9LflGkCCph7b19Ciu0FbVlOTjxe_xrJRl4g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzy_u5hshm1IvbaPwnYq9-5mFxL6pkH6geOYKNn-Dkrjw&oe=69BAAB96"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwUoIhETSm4Q7kNvwHC5J7U&_nc_oc=Adlvi7eUmxs0xnG-YuhfPVZ3-p57nAkA-9XtXpXanq9sI6ps5ByibScr9HvFTzdX2Ws&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyCt5crBIhDXBUiMFNBxD8pvfmZAK8MpGLFymquLM3yLw&oe=69BAB522"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iVQKQO-0SYQ7kNvwHoIntu&_nc_oc=AdnKnzos34y414WVviLxKjBucrERxnjVOU6G1bWDyM1bO8gcG4oWDQ4eIvx0STLZUVg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx__138TV0HC1ycvw1ekVrqRg7-5T4MnTPP4WGEW3CKUQ&oe=69BAB6BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommend
_image.png", "id": "1167677536908315", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6WrbaWtzQoQ7kNvwEd9hPb&_nc_oc=Adliy56ZRgezMziO_iazR-KM1MqfXdImlQ-sNOJnSTbf4zjkIDLOxA_6UuEhbYSWQ8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdADrOC9V-RvPMmVa2epLeTmircsA_kInWTBQZIA9kxQ&oe=69BE7D0B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rf5LVtptXkkQ7kNvwEB-SEz&_nc_oc=AdniY3952TWMc84_atQTJONc_fG0YyjPzQ4x5DGaIFU6P2RiCRv_ElE-IwymFa4LXyU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1xjbG9Rv2sJ7TNQUqTs4fSbz1heoKWf8XQ9uKwezn8A&oe=69BE8BB9"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrToAb7QqFoQ7kNvwHayOiJ&_nc_oc=Adl1PcCRVJ2836RaLbfGDkty9AJyF5j2VCXbdAiv_EsMeFMZ9KrWCg1Src3ybmnLGvY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzuls-V1K4JzPlokkJbnZMPEBNb0ZMBqE79TCThjnv-Mg&oe=69BEA016"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7n5TKQF4SugQ7kNvwFEyzFJ&_nc_oc=Adleeh3RQ-RGXOYtffxTUC4mXlS4QmFwNsPc-tkIs0KjaVAblI7yabXhEvGzvBUYT1Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTRPKLtoFWAfPig0T1SA_-YnWHWptJgQzaQPDmHLDVwA&oe=69BEA9A2"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qsaK3FG7ikQ7kNvwH0oOh_&_nc_oc=AdnqcY_5Rm_2ItWHT1LqURQL4_qG46lrUaakYi7NjaZf5qVDkGZDBAzCJMyoyUNN0Vg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzruE9Hhdm9dp7Hg_zTweelveQwcHZf4t7n2X9x4S6M7Q&oe=69BEAB3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommend
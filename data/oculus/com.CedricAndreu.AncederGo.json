shots": [{"file_name": "migrated_image.png", "id": "1167677536908315", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZfWEPbQZ2oQ7kNvwHGzZCj&_nc_oc=AdqFr_54krj4pJIC2poTqTr9ZhGflD5ZjgWMT3Uouln_NvG94M3IximtqUNBRuCbXRM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hwxWjPswMJCHR0-wh8UwZ7ykks7JLNZC3s5btz3smMQ&oe=6A467FCB"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHxt64oWz84Q7kNvwEani7D&_nc_oc=Adq6BEiitaEE7KiMZPnJsbci5x7_Cq2pUmaTNXy4sD8bL7o6FyE664hzRO8ueQY5K5U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83MMmhFzc81MhpoW5Hq7bLk4tPWBklToDFtaK23LOHhQ&oe=6A468E79"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nt_4gUZPG84Q7kNvwFYFBgI&_nc_oc=Adrb6VVqJ8oEiNidpdcpsIZ82WZMbroHtjuTTELBX3A0NUym_gQ7jmAYQ2DjL958t8o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NzQxLhF1AE1WlDENSDveVQxxxsZ3N0qLuHOZTlva5NQ&oe=6A466A96"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAPxLFZdBRAQ7kNvwG8EYbD&_nc_oc=AdpTyWcQKJae3Lx7WsOGN5-xhbTCfyc2wq4HNxGDv3LuSLJF3niJD1p237WteW_ZXy4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2KbiqNvMVZQQOVGzNJ17BB0BZnCRQh3cwTr33c4-fqQ&oe=6A467422"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mSlV6botRa0Q7kNvwGjWo4Q&_nc_oc=AdqyE0N2uDt9IV61m9YBdQKpzfr60dg-_jBYzE5jovy40wznexl4UARNpeGHqBzBuow&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8BbqJ8WtFzb9n3CyBtzDI398xdo7ETu_pbuUI1I2K4w&oe=6A4675BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
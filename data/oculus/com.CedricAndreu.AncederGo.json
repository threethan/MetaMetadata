-ord5-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04lz2oRMRe4Q7kNvwHLkkLF&_nc_oc=Adm-k8s3Q1SULRJV5ibe-XxmB_SdwZxMFT9PSdqiuMgATOLPWf_WfFjhCrV6ngSW2TA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvpvTfn2G3rokR1LrsUVrWLJdH-2_8rZbDDSlDQdJbHrw&oe=699AE48B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Er7KGVA4cRwQ7kNvwGc3diT&_nc_oc=AdlEHxaJyhEZeANHi1HwV5yvqdwRkCEWcVt9qrW4bTsCO_9mg6Fr4LsELjmFI4YNS9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvxfA8vFcos96yVUZdCMBjjaebQAJiGaqqrM06LJoNaEA&oe=699AF339"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKgB_i0th6AQ7kNvwGy-y7x&_nc_oc=AdmPi5DzNiCEJpfQGfTksKaVhRHln8GAQuBN-DbhSxnH8xqMIBHz8Jx34WaMv1AyRvU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu2w25xqs4fcgIug1aSeZf7bg0UCuWDsDetaonk7VoHPw&oe=699B0796"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsbMCP9Vc8sQ7kNvwE1wpCB&_nc_oc=AdlvfaefZTOB-hoFsmJuFTFYV8TFCAnP6KC4VKN-FIXp1RwA3GqoaXABkvPy5zOQx7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsdfWL21hnxdNdu8SuOd44p2rp70zKDHd-6sE1KYMHwyA&oe=699B1122"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC4T3kA8ETAQ7kNvwHcJ6WT&_nc_oc=Admhu155xukG3l69cokTXZgPffcNA6E_-AyQsn_6BG69PWw1NYKgqoD4pfmGc9l0Q5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft4TF9ggRBqxuMgGo8i0UBXgP5oqLoijo9kaE8xfMXufw&oe=699B12BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN", "es"
shots": [{"file_name": "migrated_image.png", "id": "1167677536908315", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PixWiuIgFs4Q7kNvwGvhs4b&_nc_oc=Adrb6DNDdN0j1Nuz4rENSOGyEXBNhXRlO4g1yN2jwNJ6xT41siN_5bUca05kPru_SaA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeUz9cG1iCKRfhFaGDSpd4cc8drt5zBV6orjpLmKpVHw&oe=6AA9604B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX-bIv1P0zkQ7kNvwGCy8AI&_nc_oc=Adp-irlYPE5ftZcEh13_HGOH6T13Nz1sPE-gF9NgtT8r_rw3ldqkAF7ylDkx2qk_fzE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgdl7PneE7szsf8v-ai6_GWNphkJNbxo-ZoETWIG-pSQ&oe=6AA936B9"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PJ54v-b2RoQ7kNvwEft43_&_nc_oc=AdqnkENPK_9mjS-8n4icV1P8fhlKe5Gby7-QHoTOXxHcuqoB3LhECnMuDFQ0uNRNHs8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1tZQrooarcNVQe8ZYS4h4XdG1ZAGnh8Vns9WBVTuS8g&oe=6AA94B16"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z-IYgkF2J3AQ7kNvwHkiOpk&_nc_oc=AdprQXhhu15NqzRoPM1E7wNZTD5O1neWZvh6F496TYfB7IvBbpsp4U978MkUsufSL00&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqnuENa_vrz9fGkRrqNmakSxYl95BLdzEDx0pK8EjCcA&oe=6AA954A2"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfv0F7Kch5kQ7kNvwFXf2dx&_nc_oc=AdrmU5o4OnolQl1Zkth34YN1-XX4kctPphvCEVuDscwVlqnTmrF-agcP6Gapt2ccvs0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiuWGACOr9prq9ersm5z_PJDgof2qVA0pZ_LcKb1pUMQ&oe=6AA9563B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
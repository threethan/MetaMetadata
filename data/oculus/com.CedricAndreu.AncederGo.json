-sjc6-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8oEm0otIFQQ7kNvwHksFL_&_nc_oc=Admy5-3aghD_Hcv0OZjrrJBkZ004v7g1eZm4lSwu7DMJrYKtV3LPHhLE6BAnx_tPmFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft3pmzlR93dSod8PFwKPon-SnJksqQidvxbq-bzb-asmg&oe=6998418B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XddYLQK2K0Q7kNvwF9BFBa&_nc_oc=AdlDd3EkIqK23jTOKEmyb1-PG9-9z3Y0GTsYTK-2Ep9Lsh3VIFOtdaFNrv0VyeAOSlE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftBjrLEnuicMUn4t40hGQcOrs6AnFOw-bGivOE_4De4fQ&oe=69985039"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmNnxzLOMtQQ7kNvwGQ5hwm&_nc_oc=AdkuClUiD5iuC15aF-XMhtuvujidHPEJjrfftr2Yk7VeJ2Ep0yh6FD0VXTSmsLDh9ro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu7lVYjip1yY6uQNG3Trg_rxkUkzarzMAs8qJtYNjieeg&oe=69986496"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDUYZ8eBDLgQ7kNvwFo_Z9c&_nc_oc=Adkkxi-wTxSE3hEVPr7_u4yxnBQKMeuhQDIvMOpY-3mU27nuKBcOeo6dzg_nlFAL2Ro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu8sK1lE03tsNzK3gNEYrJ2sbEgw5HHH1cdoYtl9nI6wA&oe=69986E22"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsUlkzBYy7kQ7kNvwFUTQ0Q&_nc_oc=AdnYatcSHt2kScappllIOhL0Z6__ftTH3ZqHnGCsOiWv4Ix5JTWNNPaUawXVVcC9dl8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuhPpnMUGrgX80f_t8kmWbp0AeVhVrYKANWp1e7vRCokg&oe=69986FBB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN", "es"
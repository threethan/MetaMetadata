_image.png", "id": "1167677536908315", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M63zxlhQQroQ7kNvwH1KGBS&_nc_oc=Adlhu6D0mLeZnn0R5ZdJ9tFQxWnsthl9UMkWQ3U4k_7XMrdZkCDLW3-rdWordAoiF1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbDAowFOOmKnVFI7QAYO3Co4TK42ffqWguUf8Q1iZiAw&oe=69B6940B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf9vlVc2kAsQ7kNvwF7NEPb&_nc_oc=AdlFRZzLxyAekyndATCY_1LjOJoqIQ3d7WiyaRXbfbw8tYiNqOJN9apgjK0XL76Ao_s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWalm_PcYbqonYFRB8s44KvvriYWKdhTHB61RFweC7ug&oe=69B6A2B9"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JuMZiOKD4UQ7kNvwEmGIs0&_nc_oc=Adk8c5U0kQuyVjnQ4HNFvQJhMixBFoa0Hd8TQlY6t9f_FDvUEHc_EPahcPguIU6F3a0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxw3dXZg3_QLAyeJL2lIORJhUbPPJJstC_FfR-cAtvw8Q&oe=69B6B716"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81y7LS9s5aMQ7kNvwEOHJUa&_nc_oc=Adky_MkQUvfdfo5gUP_8aC-b1Jjpwr-F46SqC379IX-URoR2MRdKROiOt6hxVSkXt8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfztS5Qr915bOBy7ATug4q1qGbfnK11F534nSQg1o_WCBQ&oe=69B6C0A2"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCTOZ-hYWz4Q7kNvwGuLXGQ&_nc_oc=Adlb67A7imiQ3IcnFqljWXh5qa9YWPLHcp64n1M-jI0qO3xmvpNF6Vw5CYz5YKU9u-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzOicUr7xbxUI3lcVFU0BUYWLuSTHr_k92ZM7MkYpMDbA&oe=69B6C23B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommend
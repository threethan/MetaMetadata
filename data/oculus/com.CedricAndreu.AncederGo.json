_image.png", "id": "1167677536908315", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50X3ft1v2H0Q7kNvwFx8NT4&_nc_oc=Admll4VYesJy_id1b-OArhcqBxgO_5VlyxuDhXKdOFrvjRc0dFdwLDCoR4AvXm5nOyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxDFiREI-KvwhMAlym0-1ApZHPPaHeeW-03-qo_6kM4w&oe=69AC080B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ-Um-uGteAQ7kNvwGPa3L9&_nc_oc=AdkR77Nvcvl9atY0agG6rTpHExoxH7U2OIWAvI11YMbWH_c9Izqfhi-KyjlAob9NqnU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzSkYHd3sE8Jeh5MRt-FpOzP_ASB5gIQangp3kRVUD5OA&oe=69AC16B9"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjZqrvNQVRsQ7kNvwHcnn2C&_nc_oc=AdlqpMLW6ljnPFh0BJniGY9JyUXXBTBSGMKfFLdQV3hLWqGy_2ABxm-pcutE3OIyjAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy4J3P3z4vZY0bhHN0_zB1csCq1BImt9RZQB22lbNSGaQ&oe=69AC2B16"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV-6QidOMx4Q7kNvwEgWt8X&_nc_oc=AdkyP_NKKyl6mRYmZJ8tqZXDAEj4Orb1eSzhi0MT78xA4dy1eCcRN0WE1Z-p02J1k1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfweNK_TJ0PTTEeZmvt1IC02-teiwalgLFqGJwH6epDLSg&oe=69AC34A2"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrpNL1aFuMMQ7kNvwEKDoXA&_nc_oc=AdlBFgDTV0Iol_iTIc6J1CK1C1xsoEuBi_Tim6aYJYcD0BDhTQ_VWtkyo_kI6nhBeuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyKI1Y5mOyUV0lrUVUHD90lL4dErN4sSczZIPCT7xSnAQ&oe=69AC363B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommend
-iad3-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8oEm0otIFQQ7kNvwHp5e-Y&_nc_oc=AdnnLCkJr15cCM73JhrcZ2sUSeePkutuA8VEVaTgSdCP8MGy0Pu4fLH-bVhXZBbCOVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuGgSkn_DjkEW14etEsGwzjBVUvsT8LbdWppsuczPiSQA&oe=6999930B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XddYLQK2K0Q7kNvwF822z6&_nc_oc=AdlSDTCuPmiTM7TTpUqx4LxTTba4bvgCVscgYS0xGpH2lGR_4K170hNIk5-bx0qs1Ag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuYdz6GIFXy7NFEMg1w3juU2jjvIuDG9JjLNvz-VOHlSg&oe=6999A1B9"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKgB_i0th6AQ7kNvwF1bXjg&_nc_oc=AdklZK9obWl605o5qkbIfomIJ76G6PlfwRZmJ4OcaqITuABmd5ViUh1cAobE2sDq5WE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsSudwjS9O7V0uEDSzh3ZNp019bpykHglI2e6MlhX6HhQ&oe=6999B616"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XsbMCP9Vc8sQ7kNvwE_x2Xh&_nc_oc=AdmrMWgeLXGqruCkTDOUijxfTT7rZXeN4RYex07XkuUwTkomB5s67NO2wX7wn1qsl1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuoF0iwF8qsJ7sle0FZOhR4OaqjH09SulJNTrIRVZqoew&oe=6999BFA2"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZC4T3kA8ETAQ7kNvwEmCIDv&_nc_oc=Adl2FT3J-OLt4f9vvq_tvilKbbMES3iVYXKiQQNBnlJoM7lpb2ZB6gGIFYXHb8WK_pA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJOWbsv4aTmyeqkEvl0tGOzYSNjOu62PNbSkxnMFNFfA&oe=6999C13B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN", "es"
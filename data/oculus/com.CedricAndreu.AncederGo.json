_image.png", "id": "1167677536908315", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50X3ft1v2H0Q7kNvwF9sBMT&_nc_oc=AdmX4C1ql6nbIeEhRSyUoQ5Tl9qkQHUgLnJdF4GCNEqLXMlQ-OfNooLbDXJnt2r-PL0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7IJYGid7juMS_SCNZ7S_8tYadzVIflUYP6ZEAkhDipQ&oe=69AD598B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQ-Um-uGteAQ7kNvwFJ6PXv&_nc_oc=AdlwSXx29qCr1EgjhbFMouKqwidX1tN2mc-v_gnpnD1KdBueGoSfNe8G6SFVoJro7Lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxX_kHUs0PzCOmVr6upJrXDbRMAm1s9lhKIFX9a4vE4EA&oe=69AD6839"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZF7ezkpwd9YQ7kNvwHNSgy9&_nc_oc=AdlzhGyFGxYV5sXruhT6XVLB_6csjqW4eJJSF8kQM70zl8dDnCjv-ajSuYTIelw96Go&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwp2LsTuNogjwyk41OmufdCTe-zeqbYvU___Y6Y3Tf24A&oe=69AD7C96"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfkRJfCSEAsQ7kNvwEWbX8y&_nc_oc=AdlJLM5DL17OGA33_bqdimBhbd5Zy_FnS3bB2Y8WaruViny8VYh3nWUzFcJgg4sMfdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz6wnkhPRDQuhK5mmoERydpGShK1Flw5q2dmSmLAtiPtA&oe=69AD8622"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OWSYkVa7NsQ7kNvwF1aq5h&_nc_oc=AdkoaBp8d7J6SusrL7SCy6YaPY1yCJ9688dQLFu_kIR8STBqUk4nSoT_nbaXq3VRoG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7Pgh4RVztMc37_n7uJ10qchVqYtiZDPEXAgAQab7wmg&oe=69AD87BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommend
shots": [{"file_name": "migrated_image.png", "id": "1167677536908315", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zX4QrLCb4AQ7kNvwGt8BfM&_nc_oc=AdqX14MPg_WifPHqXWJxSpDD9vZRrPPeSh5b6xLbRpkMJtUZkvWG2HzvfLVVNjVnJHw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T-0LLlsCiMoIJykLET0XzE9Kwj1bNUYbY3ADIkMN52Q&oe=6A3950CB"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xABownRP9w8Q7kNvwGTqrFF&_nc_oc=AdpcxUFXTUJwycYyuDbnzrLOk9If3poGsEV7EuIqxiUeQc83A4rPXmOBmOUfOw6gDqk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V_JA6DaMlg7DZr4XwcbdqrrY4SzuzdVdIwmXIUZeVxg&oe=6A395F79"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iqin6UQjvqwQ7kNvwHLqZ8k&_nc_oc=AdrD5yc03ZY3kO3fTM4BpaWS_Votfgo6n2rWd5ZdF4KL_JlhesVHkPjNx8jVrkZeF9s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iGs8mffyU1iFDLdh4TuEMNowNiBhXVrAh1mKc7kb21A&oe=6A393B96"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btII9hKyBV0Q7kNvwEkxugJ&_nc_oc=Adpf5-JJ9FRoPcKy-l8tV2pMO9d27kupLpnndakBwFghuJRv9Jqz-bsLsMwPiKY4KR0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LaS_i7gKolV9e_JYArHEFptM9ijz--GLLGNPNZUJIzQ&oe=6A394522"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV29epWA-IAQ7kNvwFmyJBM&_nc_oc=Adp7h3C1ZV06g6OSCfcfutM0MeqvHUl3XT-4rjK7sel9s6uZQHj1crjFojdFE-0F5dk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pJNbJrPBqbW22q66mSBeKGUG0oTZuliYNl0b4UmtKXw&oe=6A3946BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "pl
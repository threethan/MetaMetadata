-atl3-2.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ULgZM7vYPEQ7kNvwGIGYQV&_nc_oc=Adl23X0NwRQCBBfqwUWqWP2lB3FDjms6XZp3FEGaJOE37ZLxcV94XJoNPoTX37cb2SI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsCZKOvC3j0rDHseBxC1uYo0Us9I_FAo5rLS6iBG-KM8A&oe=69A5708B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyJoldzlaYIQ7kNvwGt_iDu&_nc_oc=Adm6-P5bgk_gnlSwND__MmKHOxNOe5OUaA4ZkET0n2s2gEkw5xE-H97z-ZKl0J2Knio&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft8fkUEZADjpnosr2TzHni4m2BgfxyYjcqLoVlMZJ8YyQ&oe=69A57F39"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGaAC_zPB9YQ7kNvwH9gJ5F&_nc_oc=AdkXaLbB0A-Ib-dfSWomupbV0mao8U5uJ91PB7-1lGWABylutMauluiLs-xAhjqPJwU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsFAFDUn4y92W8obki8kZFpBT95IQsxjIDW68IDVkS0rg&oe=69A59396"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_y2Y7Lqb1QQ7kNvwHYd7gy&_nc_oc=AdkiPE7N5aO6U-V2r5OpOwvVsBhO6ZAgkmOYUdfF3fR-tsz1PgmGtbS5uxnG6g-c0M8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftrgvnCA19zWzjyKz6WeMfRdKYYWsBf63a7hv-E222naw&oe=69A59D22"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvKeUQi1PhEQ7kNvwFYI2gI&_nc_oc=AdkSIAryoV7yg-OuwP_xmU9JtlTDwtsYoX4C4aO7wap6UaoPNYnurkzq3Lu1gew_d3s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuLwVKKuidPPsqB6P2HM0f0Dgiu7ggDGhPkorh_8uo_Eg&oe=69A59EBB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN", "es"
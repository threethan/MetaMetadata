271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8oEm0otIFQQ7kNvwHksFL_&_nc_oc=Admy5-3aghD_Hcv0OZjrrJBkZ004v7g1eZm4lSwu7DMJrYKtV3LPHhLE6BAnx_tPmFI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft3pmzlR93dSod8PFwKPon-SnJksqQidvxbq-bzb-asmg&oe=6998418B"}, {"file_name": "migrated_image.png", "id": "501788590487491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmNnxzLOMtQQ7kNvwGQ5hwm&_nc_oc=AdkuClUiD5iuC15aF-XMhtuvujidHPEJjrfftr2Yk7VeJ2Ep0yh6FD0VXTSmsLDh9ro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu7lVYjip1yY6uQNG3Trg_rxkUkzarzMAs8qJtYNjieeg&oe=69986496"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/AlnwPA", "id": "2318252808459375", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974526_2318252811792708_7299150658735702016_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiAOY1JGef8Q7kNvwENfDmj&_nc_oc=AdnX_IuFZcfJlLkUuwdW8nQL5ywJcFZeE6uKYrPXA9vMS0LHYlpIiYL-4rLH4FKP7DU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvHcF5l1SrQoqVxtTWuNYJT5Wgko3rdS7cGuqRi61TpIw&oe=69986288"}, "display_name": "Anceder Go", "keywords": ["shooter", "arcade", "casual", "bullet", "shmup"], "long_description": "Anceder is an arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score you can. \n\n- Play the five worlds in a row to make a high score.\n- Original musics. Music are level-long (no repetitive loops).\n- Easy, normal and hard mode. You won't unlock anything in easy mode. You'll make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- In English or French (texts & voices). If you reach 3 millions, you can even set the voices in Goa'Uld (see your success list).\n- Optimized for Oculus Go\n- Playable with joypad or remote\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\n\"Insert coin\". \n\"Winners don't use drugs\". \n\nA bug ? An idea ? Please write details to cedric@anceder.com", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}, {"images": {"nodes": []}, "id": "211624136587519", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder Go", "keywords": ["shooter", "arcade", "tir", "bullet", "shmup"], "long_description": "Anceder est un jeu d'arcade de type Shoot-them-Up (shmup, bullet hell). Choisissez votre vaisseau et tentez de faire le meilleur score possible.\n\n- Jouez les 5 mondes \u00e0 la suite pour faire un meilleur score.\n- Musiques originales. Elles durent le temps des niveaux (pas de boucle r\u00e9p\u00e9titive).\n- Mode facile, normal ou difficile. Vous ne d\u00e9bloquerez rien en mode facile. Vous ferez des scores \u00e9normes en difficile.\n\n- Essayez le mode furie pour plus de vitesse.\n- En Fran\u00e7ais ou Anglais (voix & textes). Si vous atteignez 3 millions, vous pourrez m\u00eame mettre les voix en Goa'Uld (voir votre liste de succ\u00e8s).\n- Optimis\u00e9 pour Oculus Go\n- Jouable \u00e0 la t\u00e9l\u00e9commande ou au joypad\n- Scores mondiaux (si connect\u00e9 \u00e0 internet). Vous pouvez mettre des initiales \u00e0 chaque score pour comparer avec vos amis de passage.\n- Vous pouvez jouer allong\u00e9 dans le lit (menu options ou pendant la pause).\n\n\"Insert coin\". \n\"Winners don't use drugs\". \n\nUn bug ? Une id\u00e9e ? Envoyez les d\u00e9tails \u00e0 cedric@anceder.com", "short_description": "Plongez dans le jeu de tir arcade (shmup, shoot'em up, bullet hell). Beaucoup d'action vous attend. \"Insert Coin\" et sautez dans le shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": null, "developer_t
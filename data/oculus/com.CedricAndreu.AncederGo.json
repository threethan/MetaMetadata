_image.png", "id": "1167677536908315", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfvJcb62QlkQ7kNvwE2sEYu&_nc_oc=Adk4Spdyudz9umIjubGdw287R7ZxPtu_cQ-BE-SVE2Lv7fFu4h18ZjVULjGCyZsQ6Ts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKrPJnL5TZkgcwACzmFIMGnWF6FpPvCpTK6jCCIKYN4w&oe=69B5428B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD1Gy8K-y7oQ7kNvwGDRaEK&_nc_oc=AdmWms3Qul_xqO3knEcqpyKpDkvWQzwuIl6S1nFjBveEz3cWbWc0V6DJQhaXgPJvvqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7ivA6JMrxxowDehdOYOry40dr68F1oBnlv4upy-mUSA&oe=69B55139"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JuMZiOKD4UQ7kNvwHLh__D&_nc_oc=AdlhK6sllShi9L_5Bl1we-NRXd-NJtzlT317jEIaz0x2YThupNLUH5P_pUjHTZi2RaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_O70vEJ7zec_zVk3CmbEG61TEJvxIlZHC1watDuZvfQ&oe=69B56596"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81y7LS9s5aMQ7kNvwGnieST&_nc_oc=Adl7PvZZjqeI4tSagGafqhCnNHOOQSBs36aqR9OYmYA_MmvCrtABUepLVILwYh5DKlk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQ2rriqz4UWj-uoahoApMq1ZoHH9SkFV1DQH4yKMMRJg&oe=69B56F22"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCTOZ-hYWz4Q7kNvwF2Mgkz&_nc_oc=AdmrwO6r_2T7SwdHG6Cq5_W20V57yacZr4I2hALI9TCOH8h4-QICP3zFZi9HQyBQWV0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxG1VQ1we-2MwZP5_3r8xygA08fFp0FuBr92FFoiaqq6g&oe=69B570BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommend
-iad3-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oE4gW58fGp4Q7kNvwFwnKhp&_nc_oc=Adlg5OdTdBnCfT1CFYxXXnoOSLpxRffvE2_ex3kI4jVh4R31y1-bExp8_sEVgbsspIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvACIw9uTZqoTQhb0u50yfa6UWHuZxwIsUHrbOv-Ak1hQ&oe=69A6C20B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zq9uIxkyl5wQ7kNvwFKU5JX&_nc_oc=Adlk5TY6nuFz4AFy4YxFXpF6qgel5mDqL5N19L8YGXEk3dmVMhPeD3Va-SERrCI_48U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftxSHMCLeaow8i-HnCpg9ZrRJom_WK2jPL-ar25DQK0gg&oe=69A6D0B9"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGaAC_zPB9YQ7kNvwGKvFWX&_nc_oc=Adk-FkODh6KRKJY73lnUmB8rFTCa1IecHetE3sbinUX2IODxQOO140HidoCW572qT-g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuVwCv1yFNjSJaMKIY3QS1znSezGXwBvipuz1T2SunKZw&oe=69A6E516"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_y2Y7Lqb1QQ7kNvwH3O-_q&_nc_oc=AdlZ5DOqBJ6Xjs05MTa_1dXL6VJn5hkz6RMOE74LsTEHrV5X2gO_yBHTuj1TnznMV1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu_IEivOpbLFjp5yRAJ2hRaZ2PG6oy3wHT0ejyRDqLk4Q&oe=69A6EEA2"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvKeUQi1PhEQ7kNvwH13mZn&_nc_oc=AdlmCzqg195LXVOvn-kCeGVQp7Zrjfs6_IbwdXYKh2shHLskcVDnZTQTL1HIEAvlm7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0rHgxInlBrCe_Q7YlMhKfMO6i4_g5hTbLR5qiTBzsQg&oe=69A6F03B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN", "es"
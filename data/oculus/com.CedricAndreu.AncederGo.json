_image.png", "id": "1167677536908315", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oE4gW58fGp4Q7kNvwHhX0H6&_nc_oc=AdlIFMtrVs4k6dLRyCLaHWYwZJHcydcaO5nNicD5PwVUULAZFrj7xtVMujb81OUfo7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvFPUV6xusuRI8yzhVK-G0fuTb-z7eLhBaTBK-Sd_PIbw&oe=69A9650B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zq9uIxkyl5wQ7kNvwHBJX6t&_nc_oc=AdnSNE7hbkFxBR5Se3v078xeKEAUFGplSUTVcmu2-UrMy4qQjZbwMmuvSCKLXAieZw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afuup1XQxbp9BuDiy3YuNIioEoxzmGdprw1-u77wi8O9fQ&oe=69A973B9"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjZqrvNQVRsQ7kNvwFXTrPv&_nc_oc=AdmlCbIS__v0BF-JT5Z408wWYZ_Ef_lruVkuO5Xier5htiA4L0YhmTZh6Z54exZhEUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfszSaz45T8UEajx-mbqW60dItsfYzUzCpGl3h4-5Vsyhw&oe=69A98816"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV-6QidOMx4Q7kNvwEB_q9H&_nc_oc=AdllP3UudxYnjL-Da_ngmYkaPE3vbT5biHMywpN1qG6PHKy5rbtDb4ksoStQEcuRvRY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afvr9zqXkLpevSKELms6BIQG9VH34I0aiN_xD8sFZOD2FQ&oe=69A991A2"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrpNL1aFuMMQ7kNvwFIDOOB&_nc_oc=AdnGsMVpoigIZesBKzUE8GIHUUX3qvp7DdAUL74--1vkV5MZdF4Fe3dD8f__gVc8kds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuvgeOlOfuplD2RwCHgN666J_FFfO7hJtcQ8rq2KVf68g&oe=69A9933B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommend
-iad3-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8QgAUMugLAQ7kNvwH8w6Jl&_nc_oc=Adlwu7Tvif-SBktXdN_PSGBJRPv1OyreMSj16o-1d123NtMitp5MRaDdtAwi77BLz7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftNb8kdYHBQ5HN4tf5b9Hdy3CqdMiPcBwB6vf4dCV79XQ&oe=69A02A8B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LInamzTVabAQ7kNvwGuBMXe&_nc_oc=AdlujSZ0wGOdfEhNHUF7TtcU-t4S2SNYnz0MaqoMYkrQCQicgdz9ouc_OaIxtxUlsg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afus7GhwCkw6bGS6RSkj5oDSx7ja4sHWG1Wm4UZ_JuoqKA&oe=69A03939"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C854Fvt8IYQQ7kNvwHoIucj&_nc_oc=Adl7BCGEXSzBXGdi1by7CpgfsxxcqXeuBhOxNYf-8ZrnQjWeIljYYRkN196nJo5veIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfskiXgGtDCnJ2K_9LoQjfCS2GaPcEqY6IlvJL316GadnQ&oe=69A04D96"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3wXfWlttFoQ7kNvwFXB4KS&_nc_oc=AdnHN0bRAlTg2tOlvDsV6Ukr6u4Z2vVMDgyxIV2WJBMZmDms_7U_9UyGT5o-uD-_jOc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxISoCfaBxeLkAtOUtTDOMLY6M4CEcE4rw5OOLdZBypQ&oe=69A05722"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugQ_sW23b60Q7kNvwFthBc7&_nc_oc=Adkzb857suP2Xkybmv8yMANtzMh7aKIFjTJUoZgFzZyWr6PJQ_cNwyQm5f4TKBiNIIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFGpU_eTNVF_Iy9Q7xOIrPLU_y8BMYSaFmjCUFzcuq2A&oe=69A058BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN", "es"
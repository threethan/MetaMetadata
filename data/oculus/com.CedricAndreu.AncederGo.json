-iad3-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ULgZM7vYPEQ7kNvwHDId0b&_nc_oc=Admy-Yh-FXfm2XuCeMp9Aj319WKBLbKy9WLpSkRBqlEnJCMLiDNJP1qevt7wC0hUxak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftaWP3Zx9AXop2ScbPcSkuQ2GpvZGqeR7_ClFTWwaxgJA&oe=69A2CD8B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyJoldzlaYIQ7kNvwGj2vmk&_nc_oc=AdkzFeHTxixHpeEMfBlGaybwAHISulHtXWZdN10kDVr5ntSVRo3veg2Qpwg1TdGlq8w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvuGXYefh7abJMtoSLri3Q6W9xbmXUWfdZyoSnpi0ih3g&oe=69A2DC39"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JWasXBLIooQ7kNvwGC5c6m&_nc_oc=Adk4-oc2uwr4rXIABkLgIqp8YHy4b--Uz-h-3wIf8o5debGFa6rn3pccw7wGXWmbgns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu5l4AuCexHBva4ZM-ZvonLhSpUYVkTe4BxC2_lFEwRbQ&oe=69A2F096"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83FmOLHooW4Q7kNvwF9BOpS&_nc_oc=AdmyP3JXHua53Z8bLFj2xAG4YOS8lgrhg0RPEE5CopmibcvJeNWy_sx0myMyJfu37dE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunjIFbpw6sZpE-T-NDQ9OkoyzVe9bYLiOyx76BRFYJKg&oe=69A2FA22"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U4W5yJSr_cQ7kNvwGoM9uI&_nc_oc=AdnyljNm9O8Jy5pS28Hmc7fNYN0lotS1OmRL7xyZALG1G6nei4lpeQKObvp_ZN39ni4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsft-7bUIHvLFWu8V7MedddX76nXsvwtpLCuL3tq9c3_A&oe=69A2FBBB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "zh_CN", "es"
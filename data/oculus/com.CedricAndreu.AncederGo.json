_image.png", "id": "1167677536908315", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oE4gW58fGp4Q7kNvwGCplZo&_nc_oc=AdkHGd17ZAGjbVpnu-Rph4cxzBUcdobuXNIFXWFNdzxxqybLJk25W9yL65lZUSYyDNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvJADoGzU5eksXkSCVXsGZO7GXy3h5Qs_zuyAOYKUu8Tg&oe=69A8138B"}, {"file_name": "migrated_image.png", "id": "591811674740618", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982688_876759336001512_8999184167161823232_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zq9uIxkyl5wQ7kNvwFXQCtp&_nc_oc=Adl_W3X4lhGhIT0y47l0yqZLAbkIWwWywdNVYra6WWlJ1jrlEtEqHrjSOv8lgrwHym8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsPI3eQhve-mrLQ_IqJ9v7H3tH6YzHU4GRe5CMI4pqlZA&oe=69A82239"}, {"file_name": "migrated_image.png", "id": "582124092514203", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGaAC_zPB9YQ7kNvwEduPdZ&_nc_oc=Adm-ErxPwhfV7POKzvK0AphNmLxHItlPZvFzCH_I8hlqoNyMQAHpCXKPoCk_MOCGnMA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsJX3ZUtcMKFDQ6ihPiuG2epK1ZQjB-9ioukTlpKbYaYg&oe=69A83696"}, {"file_name": "migrated_image.png", "id": "214507646421385", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_y2Y7Lqb1QQ7kNvwF4qOPO&_nc_oc=Adk1gA_4f7GTxW-Kse3mjwSTRbOhLv_bY5WchsZmJnfW8lVFvsRDItNx4Zg17BxrN84&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftTlyY0N-1gOS_Zulb4szVkzVnHne4pAHWOGYNR3bSSrQ&oe=69A807E2"}, {"file_name": "migrated_image.png", "id": "160732235031751", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974579_2097317323685146_8736316079699132416_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TvKeUQi1PhEQ7kNvwFVwGKW&_nc_oc=Adkbxgx49xRF_1rVz2ACelSDTUU5t7WWDlwFHytBWWWcdBEVskt9MWdwy1DaL5yIrxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft7NowGJ96y1aaK5V6uFwwjkC5Oc-t33Cn1O27YbzypgA&oe=69A8097B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder", "keywords": ["shoot", "arcade", "space", "bullet", "shmup"], "long_description": "Bienvenue in the arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score.\n\nThe \"MORE\" Update : Now with more bonus, more sounds, more languages (Spanish & Chinese texts), more fun ! The Fury mode is now easier.\n\n- Play the five worlds in a row to make a high score.\n- Original musics in HD. Music are level-long (no repetitive loops).\n- Normal and hard mode. You will make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- Optimized for Oculus Go.\n- Playable with joypad or remote.\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\nA bug or idea ? Please write to cedric@anceder.com or twitter @ancedergame", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": "https://www.noixdecroco.com/ancedermbr/privacy.html", "developer_terms_of_service_url": "http://www.anceder.com/anceder", "publisher_name": "C\u00e9dric Andreu", "support_website_url": "http://contact.anceder.com/", "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommend
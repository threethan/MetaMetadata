g?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=khmVgkmkBhUQ7kNvwHE9LEe&_nc_oc=AdrV9GdI8u8iYqXSLYMyQ0S0s3gB7gx13E3xThQybl5evTi_zVdSyfESDSBw-7HcaAM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMrJUaSmwsa6Jk4QJ-k7S_w8i3AkVSO8-c-RXDLzUOow&oe=6AFC64BB"}, {"file_name": "migrated_image.png", "id": "661642501304301", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974645_820859614941200_7592492187703574528_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nA4yCdfzV0Q7kNvwHJl6E8&_nc_oc=AdrprUk2rEAxfWqzBEaEiOe_9Sb5FaSMhRyywPMZQYetKAMY52ADwnE1j4wjpoCJC7c&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS04orPZ1tGDwsDWVY__nQr8sJ0moISAuJ6JytcJuMgWA&oe=6AFC6322"}, {"file_name": "migrated_image.png", "id": "555096225359479", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982691_704271173302087_3298892117232844800_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-h9jZxd434AQ7kNvwH6p1YM&_nc_oc=AdpPWCTbDs4QTCgpRVuV8gKQf1o9ekG2w4XsIlYrABNmMLq5QVAk8lRZpRInEbPmB_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDtwc8kxt4HsMMm9FYvEvczPv7EQfKwJPu3S_JjpQZ5Q&oe=6AFC6ECB"}, {"file_name": "migrated_image.png", "id": "501788590487491", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974770_616761398764872_2926226150080380928_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOHxa4k1TIYQ7kNvwEEIpt4&_nc_oc=AdodOiSP2vTLi11RiNKnn6xen-L4HD1pIKI1cE-VLunbJAAwGwfXICszkwx0zJpKb7Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3rSKouXkUSFPVa8SfrHm2qZqksYtQ8gV4v8EbjozPpA&oe=6AFC91D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/AlnwPA", "id": "2318252808459375", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974526_2318252811792708_7299150658735702016_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1aATT2aQz0Q7kNvwHUHZuJ&_nc_oc=AdotHWC2KfBRlUh2lHAEiqISlvgeRZromL5-zk1iYoP0vdaI9OyPmWjZbFK0290S20s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR2g9JkH5uvp3jQUixceh2NQ35HN_JB8v8QYUgV3NbJg&oe=6AFC8FC8"}, "display_name": "Anceder Go", "keywords": ["shooter", "arcade", "casual", "bullet", "shmup"], "long_description": "Anceder is an arcade shoot-them-up (shmup, bullet hell). Choose your ship and try to make the best score you can. \n\n- Play the five worlds in a row to make a high score.\n- Original musics. Music are level-long (no repetitive loops).\n- Easy, normal and hard mode. You won't unlock anything in easy mode. You'll make huge scores in hard mode.\n\n- Try the fury mode for an even faster game. \n- In English or French (texts & voices). If you reach 3 millions, you can even set the voices in Goa'Uld (see your success list).\n- Optimized for Oculus Go\n- Playable with joypad or remote\n- Scores saved worldwide (if connected to the internet). You can set initials to each score to compare with your visiting friends.\n- You can play lying in bed (see options menu or pause menu).\n\n\"Insert coin\". \n\"Winners don't use drugs\". \n\nA bug ? An idea ? Please write details to cedric@anceder.com", "short_description": "Dive in the arcade shoot-them-up (shmup, shoot'em up, bullet hell). A lot of action is awaiting you. \"Insert coin\" and jump in the shmup !"}, {"images": {"nodes": []}, "id": "211624136587519", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Anceder Go", "keywords": ["shooter", "arcade", "tir", "bullet", "shmup"], "long_description": "Anceder est un jeu d'arcade de type Shoot-them-Up (shmup, bullet hell). Choisissez votre vaisseau et tentez de faire le meilleur score possible.\n\n- Jouez les 5 mondes \u00e0 la suite pour faire un meilleur score.\n- Musiques originales. Elles durent le temps des niveaux (pas de boucle r\u00e9p\u00e9titive).\n- Mode facile, normal ou difficile. Vous ne d\u00e9bloquerez rien en mode facile. Vous ferez des scores \u00e9normes en difficile.\n\n- Essayez le mode furie pour plus de vitesse.\n- En Fran\u00e7ais ou Anglais (voix & textes). Si vous atteignez 3 millions, vous pourrez m\u00eame mettre les voix en Goa'Uld (voir votre liste de succ\u00e8s).\n- Optimis\u00e9 pour Oculus Go\n- Jouable \u00e0 la t\u00e9l\u00e9commande ou au joypad\n- Scores mondiaux (si connect\u00e9 \u00e0 internet). Vous pouvez mettre des initiales \u00e0 chaque score pour comparer avec vos amis de passage.\n- Vous pouvez jouer allong\u00e9 dans le lit (menu options ou pendant la pause).\n\n\"Insert coin\". \n\"Winners don't use drugs\". \n\nUn bug ? Une id\u00e9e ? Envoyez les d\u00e9tails \u00e0 cedric@anceder.com", "short_description": "Plongez dans le jeu de tir arcade (shmup, shoot'em up, bullet hell). Beaucoup d'action vous attend. \"Insert Coin\" et sautez dans le shmup !"}]}, "developer_name": "C\u00e9dric Andreu", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "C\u00e9dric Andreu", "support_website_url": null, "website_url": "http://www.anceder.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "518668579472148"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binar
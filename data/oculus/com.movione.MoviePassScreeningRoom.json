ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa0UYUQmaXsQ7kNvwGLJMLq&_nc_oc=AdkCH7zSf0kL9Tz7N6ORBzuEtC9jQsURdfqSPzPfq4lYu5AX2qBfE-iF0dKbctyOYcY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvP8aodLLJIYZcSbG9610n8DnTRO8EJruan8Ih8iq2vHQ&oe=699D7F7A"}, {"file_name": "MoviePass_Screenshot-4.png", "id": "1115928930040572", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031358_1115928933373905_6713742863477326260_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wPWIIDgWO4Q7kNvwGgI_85&_nc_oc=Admso6ybSvvKYCOBHwBYA5pg_FV-6MVeY1Iqx8NJhjUkPmKr2i4uJnlWt5ZI7ovFhd8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvuRe90Vq1btJqncAjPwSqsmwq7mgYVLc-d-MRC4ryn9w&oe=699D92D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MoviePass Screening Room", "keywords": [], "long_description": "MoviePass\u00ae  Screening Room offers a comprehensive platform for movie enthusiasts to explore trailers, sneak peeks, and behind-the-scenes content from a diverse array of theatrical films. Whether you're a dedicated cinephile or a casual moviegoer, our app provides access to a wide range of cinematic experiences, from blockbuster spectacles to independent gems.\n\nStay informed about the latest releases, uncover hidden cinematic treasures, and immerse yourself in the excitement of upcoming films. With MoviePass\u00ae Screening Room, users can watch trailers on demand, gain exclusive insights into their favorite movies, and stay connected to the pulse of the entertainment industry.\n\nExperience the thrill of anticipation as you discover new stories, characters, and worlds.  MoviePass\u00ae Screening Room isn't just an app\u2014it's a window into the dynamic and ever-evolving landscape of cinema. Download now and join us in celebrating the art of storytelling on the big screen.", "short_description": "MoviePass\u00ae Screening Room lets you watch the world's best movie trailers and exclusive content coming soon to movie theaters around the world.  Experience these trailers in extraordinary 4k high resolution as if you were actually there.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moviepass.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "MoviePass", "support_website_url": null, "website_url": "https://www.moviepass.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8469456846403549"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "544832668373489"}]}, "baseline_offer": {"id": "544832668373489"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734445080, "status": "PUBLISHED", "id": "544832668373489"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24133257916263523", "version": "0.7"}, "id": "486678323818470", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8469456826403551", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24133257916263523"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "486678323818470"}]}, "change_log": null, "created_date": 1743671294, "id": "24133257916263523",
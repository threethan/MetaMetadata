RnZH&_nc_oc=AdqmTaxyKVv1Rj6VufmXKpsjVh6dUEeOmZFbR5g4TIT6-DCqwGsQ8fzzfwUNq7ZycZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSUDfcvdcPU1-2L-Yw9AEseIwMNP3xeTcKeRzBeQrL5g&oe=6AFDB2DA"}, {"file_name": "+com.movione.MoviePassScreeningRoom-20241210-085659.png", "id": "1600442953889190", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75269300_1600442957222523_424243975800373642_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKSth2wATQsQ7kNvwF04_EF&_nc_oc=AdpX3xJhc-JpxehKeUfsmZfALa7wC1HQzhTR5FSgLQmijbxZaYDxArxhoOYnq29jIbQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiz0dJm0zc08rmc7662uw_mFV5_GNRN1ipCX9TEuKsog&oe=6AFDB83A"}, {"file_name": "MoviePass_Screenshot-4.png", "id": "1115928930040572", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031358_1115928933373905_6713742863477326260_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2GxTv32racQ7kNvwEWw2FD&_nc_oc=AdptR8tTJ6jyWOtJ2YlaZWKHOMHLLWybGyyBTO31LWoa19pa-NHe4rho9WkjuZ7fOjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9fKN5JkxuwW1ahMcoCz5dSU2XKenGATG8Wjvx_QANrg&oe=6AFDCB96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MoviePass Screening Room", "keywords": [], "long_description": "MoviePass\u00ae  Screening Room offers a comprehensive platform for movie enthusiasts to explore trailers, sneak peeks, and behind-the-scenes content from a diverse array of theatrical films. Whether you're a dedicated cinephile or a casual moviegoer, our app provides access to a wide range of cinematic experiences, from blockbuster spectacles to independent gems.\n\nStay informed about the latest releases, uncover hidden cinematic treasures, and immerse yourself in the excitement of upcoming films. With MoviePass\u00ae Screening Room, users can watch trailers on demand, gain exclusive insights into their favorite movies, and stay connected to the pulse of the entertainment industry.\n\nExperience the thrill of anticipation as you discover new stories, characters, and worlds.  MoviePass\u00ae Screening Room isn't just an app\u2014it's a window into the dynamic and ever-evolving landscape of cinema. Download now and join us in celebrating the art of storytelling on the big screen.", "short_description": "MoviePass\u00ae Screening Room lets you watch the world's best movie trailers and exclusive content coming soon to movie theaters around the world.  Experience these trailers in extraordinary 4k high resolution as if you were actually there.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moviepass.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "MoviePass", "support_website_url": null, "website_url": "https://www.moviepass.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8469456846403549"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "544832668373489"}]}, "baseline_offer": {"id": "544832668373489"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734445080, "status": "PUBLISHED", "id": "544832668373489"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24133257916263523", "version": "0.7"}, "id": "486678323818470", "channel_name": "LIVE"}]}, "is_f
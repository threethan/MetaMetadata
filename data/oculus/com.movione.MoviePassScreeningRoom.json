"1600442953889190", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75269300_1600442957222523_424243975800373642_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lroNn-zqgQQ7kNvwEX6F1v&_nc_oc=Ado9QoG_LmSY_jyaPGjjhhMkAxrpNFyvbR6ejl1_Xn97jhfd4kUnfST4FcIyJrAVAFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9Vp3dbdA5vQJHyCKDSwy4ZHAd8vEYRo4NaacuxzUxTw&oe=6A6B61BA"}, {"file_name": "MoviePass_Screenshot-4.png", "id": "1115928930040572", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031358_1115928933373905_6713742863477326260_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4IMcN6wrFsQ7kNvwH4PpK9&_nc_oc=AdrgOkNpRvZ4nKYda7v5BwIBrMCRUt6-4QrmAi9biLka2H8X4CyEAsfUd77DXriy14c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV5QL40y9i22XLFu1iGkA-Ui6tj5eRl0LHxIgQpzuxlQ&oe=6A6B3CD6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MoviePass Screening Room", "keywords": [], "long_description": "MoviePass\u00ae  Screening Room offers a comprehensive platform for movie enthusiasts to explore trailers, sneak peeks, and behind-the-scenes content from a diverse array of theatrical films. Whether you're a dedicated cinephile or a casual moviegoer, our app provides access to a wide range of cinematic experiences, from blockbuster spectacles to independent gems.\n\nStay informed about the latest releases, uncover hidden cinematic treasures, and immerse yourself in the excitement of upcoming films. With MoviePass\u00ae Screening Room, users can watch trailers on demand, gain exclusive insights into their favorite movies, and stay connected to the pulse of the entertainment industry.\n\nExperience the thrill of anticipation as you discover new stories, characters, and worlds.  MoviePass\u00ae Screening Room isn't just an app\u2014it's a window into the dynamic and ever-evolving landscape of cinema. Download now and join us in celebrating the art of storytelling on the big screen.", "short_description": "MoviePass\u00ae Screening Room lets you watch the world's best movie trailers and exclusive content coming soon to movie theaters around the world.  Experience these trailers in extraordinary 4k high resolution as if you were actually there.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moviepass.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "MoviePass", "support_website_url": null, "website_url": "https://www.moviepass.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8469456846403549"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "544832668373489"}]}, "baseline_offer": {"id": "544832668373489"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1734445080, "status": "PUBLISHED", "id": "544832668373489"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24133257916263523", "version": "0.7"}, "id": "486678323818470", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8469456826403551", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24133257916263523"}, "release_status": "RELEASED
 the first step of our independant french studio, Charge-XR, into the VR world development.\nThanks you very much for your playtime and your support.", "short_description": "Defend your moon base with your fists from alien's astero\u00efds salvoes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.charge-xr.com/", "developer_terms_of_service_url": null, "publisher_name": "Charge-XR", "support_website_url": null, "website_url": "https://www.charge-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30935998806048412"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1309927530199537_8099409179798084592_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTby6Gbu5UEQ7kNvwHxj7XG&_nc_oc=AdqckjTjSV6AA0n0DgNSINnCVPqr7wjjeGILglX0K9QyUCFX9fhp6nAdloifGsR-HcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpB-EK1-x-jMNicanDGwmqlGz8zs11flz5IX5IiG1J9w&oe=69CE547A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Soldier", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_da
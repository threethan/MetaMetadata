5-2.oculuscdn.com/v/t64.5771-25/75272212_617158310623196_416998355452074862_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3me0MxNzsKcQ7kNvwFUjAAS&_nc_oc=Adn73CkV8727cgLFIWSmbOAh5COriubX_12TW2cVFI_d2icDL0slDF8YvjChjsqdBi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvGYUEEBkTT0j7duZxG9RnCn8pdvir345fwiSVzC0djxA&oe=69A44EF7"}, {"file_name": "vlcsnap-2023-08-22-10h57m42s214+P.png", "id": "1348234379411856", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031465_1348234382745189_3177250504073814562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcmOh8UKm5kQ7kNvwFRVBlO&_nc_oc=AdkGza5-w_7XaCfuQOl85j_GdckFAaBmowNetgKClemlcRKGRHLlvixMXDvTwxa8L9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfumZ5wbb3A4YEjdxHBQWST5TlZjiJN4P1x5QUBkOvoHiw&oe=69A44455"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Affiche 2 DIF.png", "id": "264140539798918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035450_264140543132251_1035826327353330839_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YH_sQrEa7Y4Q7kNvwERqus1&_nc_oc=AdlDorQbR-2LWQbRle8gB30SIYVkAudG1kM9WLOEpYs4qJaKb5DmHGIycbdr3t1k-Zo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvalWxMgH4hcSUPMoycuQeVqjITpR1peeXRvar3SQd-OQ&oe=69A4258C"}, "display_name": "Moon Soldier", "keywords": ["arcade", "indie", "french", "fight", "fit"], "long_description": "We now put Moon Soldier for free to support the launch of our new game : \"OFC - Obrakorp Fighting Coliseum\", now available in the Meta Horizon Store: \n\ud83d\udc49 https://www.meta.com/experiences/8665278936895637/\n\n Moon Soldier, is our first project in VR on quest. You are on the moon and you must resist as long as possible to the astero\u00efds salvoes of an alien's mothership. Likewise, your moon base must not be distroyed by the astero\u00efds.\nThis is the first step of our independant french studio, Charge-XR, into the VR world development.\nThanks you very much for your playtime and your support.", "short_description": "Defend your moon base with your fists from alien's astero\u00efds salvoes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.charge-xr.com/", "developer_terms_of_service_url": null, "publisher_name": "Charge-XR", "support_website_url": null, "website_url": "https://www.charge-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30935998806048412"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_1309927530199537_8099409179798084592_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6I-UVBmnieYQ7kNvwEtw9h-&_nc_oc=AdnTVqIoU8Px4KwV1-GKdDaKvgbZtjfy2vaDlW8GN9_YGmH5cNwafcwlMNkTpB_ZXAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvk5Ru-ljuC76_CwU863ZyzInMGvo2oXP1TDqNUuQGE1Q&oe=69A4247A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Soldier", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1693513195, "lastRevision": {"nodes": [{"id": "9785484091526524", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": 
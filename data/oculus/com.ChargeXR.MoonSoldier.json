-08-22-10h55m18s463+P.png", "id": "617158307289863", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75272212_617158310623196_416998355452074862_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BavcuH2DjEcQ7kNvwECrcIW&_nc_oc=AdlFwJL6SgP8KsNOCCH7MbVyEO8CjHvvETfx0Y4nUMhtR_pcK5dWvV7gx76W1inOclQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNhL799h1IlwS0R_yL-7hqrpbaQk_hA2solQgqaP19Zg&oe=69AD8977"}, {"file_name": "vlcsnap-2023-08-22-10h57m42s214+P.png", "id": "1348234379411856", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031465_1348234382745189_3177250504073814562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA9LTEXVfFAQ7kNvwFdL-0A&_nc_oc=AdljxQclJMIaHhpLHON0NfjMYT2pYBDW21dXvQEmi9A1wxNE6SBtzhjCHtShqwGkkgo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzhBWiklzkrnQmikxz9-TqMsr1_obv5_KK9M9SG9PEzw&oe=69AD7ED5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Affiche 2 DIF.png", "id": "264140539798918", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035450_264140543132251_1035826327353330839_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghZ4bDxcOzwQ7kNvwF4y7kI&_nc_oc=AdlJRlfKT2zZFwDRiAyEqIcvZgoRFVjQgUeiAxHALPBxrIl8TUvC3FAd0fHxJR_3xpg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWqjER139goDUVqB6q6zlCqtPeFjEWr5e2siZYPsITTA&oe=69AD600C"}, "display_name": "Moon Soldier", "keywords": ["arcade", "indie", "french", "fight", "fit"], "long_description": "We now put Moon Soldier for free to support the launch of our new game : \"OFC - Obrakorp Fighting Coliseum\", now available in the Meta Horizon Store: \n\ud83d\udc49 https://www.meta.com/experiences/8665278936895637/\n\n Moon Soldier, is our first project in VR on quest. You are on the moon and you must resist as long as possible to the astero\u00efds salvoes of an alien's mothership. Likewise, your moon base must not be distroyed by the astero\u00efds.\nThis is the first step of our independant french studio, Charge-XR, into the VR world development.\nThanks you very much for your playtime and your support.", "short_description": "Defend your moon base with your fists from alien's astero\u00efds salvoes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.charge-xr.com/", "developer_terms_of_service_url": null, "publisher_name": "Charge-XR", "support_website_url": null, "website_url": "https://www.charge-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30935998806048412"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031467_1309927530199537_8099409179798084592_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMKis9uLk40Q7kNvwEeetsb&_nc_oc=Admc-wc1e3VcgfCe-Pm-Fb80oeSzZ3KmX3R14OsICMF4QJSbpY4Sdz0D1sSw8GYN67k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzruU0SZ7YQlrGZWMLzrUUhycwE-zK1dt3REWFnTjs1Gw&oe=69AD5EFA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Soldier", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1693513195, "lastRevision": {"nodes": [{"id": "
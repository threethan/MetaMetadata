7713D"}, {"file_name": "vlcsnap-2023-08-22-10h55m18s463+P.png", "id": "617158307289863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75272212_617158310623196_416998355452074862_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68KuhPA7fVUQ7kNvwHzSaVt&_nc_oc=Adpuv4g2KPcQWKH9IQ74ECKt81XUAe-jX9kNuGWlv88zOFrgD1dVzSvxrAgIlor_Ucg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChbkhu6KsXKzWm8C0O459wTk-w-kO5xxS2UpzUTbfbqA&oe=6A676CF7"}, {"file_name": "vlcsnap-2023-08-22-10h57m42s214+P.png", "id": "1348234379411856", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031465_1348234382745189_3177250504073814562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cfJkkotk8UQ7kNvwHbJzPc&_nc_oc=Adot63linR6-_oGB_OvhhC6VSgEIsISqcmdbgnXbT2uAgg6_xrOwA55EIrqSZ_o89TU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_HqQfJEPVLtE6FCc6epxoXUo9RgyCoCjnecn6H114eQ&oe=6A676255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Affiche 2 DIF.png", "id": "264140539798918", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035450_264140543132251_1035826327353330839_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sw9NUhKKQJUQ7kNvwEgdA7x&_nc_oc=AdoQ6-hXkvfB8T3ju4dwrTzBoK-jKaIfu88nEDqGA01lbcj1UQckzvB1cIjQTNNufwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhgCuZO7nRcG_Kujp5IRyhGKNLJTt253r2j9RF74vh9g&oe=6A677BCC"}, "display_name": "Moon Soldier", "keywords": ["arcade", "indie", "french", "fight", "fit"], "long_description": "We now put Moon Soldier for free to support the launch of our new game : \"OFC - Obrakorp Fighting Coliseum\", now available in the Meta Horizon Store: \n\ud83d\udc49 https://www.meta.com/experiences/8665278936895637/\n\n Moon Soldier, is our first project in VR on quest. You are on the moon and you must resist as long as possible to the astero\u00efds salvoes of an alien's mothership. Likewise, your moon base must not be distroyed by the astero\u00efds.\nThis is the first step of our independant french studio, Charge-XR, into the VR world development.\nThanks you very much for your playtime and your support.", "short_description": "Defend your moon base with your fists from alien's astero\u00efds salvoes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.charge-xr.com/", "developer_terms_of_service_url": null, "publisher_name": "Charge-XR", "support_website_url": null, "website_url": "https://www.charge-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30935998806048412"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031467_1309927530199537_8099409179798084592_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5Nc3ezn1gwQ7kNvwEMCHMx&_nc_oc=Adr4rB6RmWOWxis5zZzKdpgbBKTRyCkCK1ntOMC7QTbiBVoy9ud4j4Q-5MDRuIVWYaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDIBTdlOAbnDDP45s-YEpdx6AiAOxMyP4BGLXicElcCA&oe=6A677ABA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Moon Soldier", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_da
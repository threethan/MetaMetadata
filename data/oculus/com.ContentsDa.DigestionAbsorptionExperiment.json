em.png", "id": "9389094021120160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974860_9389094024453493_6010834170972518892_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pw7uvD4G_5gQ7kNvwGBMI57&_nc_oc=AdmKjSGpZTu-Z1wkVTnF_W4Viac9SA0lw5ChTfW5o_fmS7a4o7i9AAUnhBI4fLaYpQc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftzQwqgKEKDbzgrF8TGbi3vQ7aM4QTV1sCjVc3BYk9LCw&oe=69A6E551"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Digestion Absorption_Landscape.png", "id": "760990872558213", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572923_760990875891546_6049348127562738334_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49JTOBdO_7sQ7kNvwG9Yv_B&_nc_oc=Adnb52zbrj1tH6S5vsMYwqu3Ch4M9fqozkRimXx97oi0AShoueWi6aFn7-BGMdv7fKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvTlcKXbJ0QXwbnr1yMDezpJMg-4v2H8tEFJdAVwLk8Ug&oe=69A6EBB6"}, "display_name": "Digestion Absorption Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "biology", "digestion", "science", "contentsda"], "long_description": "1. Crush Extinguishing Agent A into a membrane in a mortar and pestle.\n2. Add Extinguishing Agent A to 20 ml of distilled water and stir with a glass rod.\n3. Crush Extinguishing Agent B in a mortar and pestle.\n4. Add Extinguishing Agent B to 20 ml of distilled water and stir with a glass rod.\n5. add 3 ml of 1% starch solution to the first horizontal row of the test paper in three 9-plate grooves.\n6. add 3 ml of 1% albumin solution to the second horizontal row in three 9-groove rows.\n7. in the first row, add 3 ml of iodine-potassium iodide solution in three 9-groove rows.\n8. add 3 ml of burette solution to the second horizontal row in three 9-groove rows.\n9. in the first vertical row, add 3 ml of distilled water into the three vertical rows of 9 plates.\n10. in the second vertical row, add 3 ml of Digestant A solution to each of the 3 vertical rows of 9 plates.\n11. in the third row, add 3 ml of Extinguishing Agent B solution into each of the three 9-groove rows.\n12. Increase the temperature of the room to 38\u00b0C.\n13. Observe what happens in the 9-plate groove\n\n<Results\nA contains a large amount of protease digestive enzyme, which breaks down proteins well.\nB contains a large amount of diastase enzyme, which breaks down carbohydrates.", "short_description": "Understand the journey of food in the body. Learn how digestive enzymes break down food and how nutrients are absorbed, an essential process for health and well-being."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9065064380185103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036659_919972229725425_5856591376987081496_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M07WIW-s2DsQ7kNvwGN7jxJ&_nc_oc=AdmSAwS6yRfWZxO5glrEbhDoJOyq4odvdopVYtVmVnPF9s75OSLU3VwImQJ0AlHArVE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuMDIe8XTA2wwl-J9940hh0-xvxPoWkJiTVgaZJIefbaQ
=699B07D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Digestion Absorption_Landscape.png", "id": "760990872558213", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572923_760990875891546_6049348127562738334_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sj8KWY0RPvMQ7kNvwF-WXwD&_nc_oc=AdlYVJIoHiH0Dw3q_6cyHAabbssgDxxs_cyUhj9atCKr98nLhJdG57OHL2npvCu1Jws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuYjHQTn4d9N6-NOQGQjMiY2sF6_FlQX-porz4hrDkyJA&oe=699B0E36"}, "display_name": "Digestion Absorption Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "biology", "digestion", "science", "contentsda"], "long_description": "1. Crush Extinguishing Agent A into a membrane in a mortar and pestle.\n2. Add Extinguishing Agent A to 20 ml of distilled water and stir with a glass rod.\n3. Crush Extinguishing Agent B in a mortar and pestle.\n4. Add Extinguishing Agent B to 20 ml of distilled water and stir with a glass rod.\n5. add 3 ml of 1% starch solution to the first horizontal row of the test paper in three 9-plate grooves.\n6. add 3 ml of 1% albumin solution to the second horizontal row in three 9-groove rows.\n7. in the first row, add 3 ml of iodine-potassium iodide solution in three 9-groove rows.\n8. add 3 ml of burette solution to the second horizontal row in three 9-groove rows.\n9. in the first vertical row, add 3 ml of distilled water into the three vertical rows of 9 plates.\n10. in the second vertical row, add 3 ml of Digestant A solution to each of the 3 vertical rows of 9 plates.\n11. in the third row, add 3 ml of Extinguishing Agent B solution into each of the three 9-groove rows.\n12. Increase the temperature of the room to 38\u00b0C.\n13. Observe what happens in the 9-plate groove\n\n<Results\nA contains a large amount of protease digestive enzyme, which breaks down proteins well.\nB contains a large amount of diastase enzyme, which breaks down carbohydrates.", "short_description": "Understand the journey of food in the body. Learn how digestive enzymes break down food and how nutrients are absorbed, an essential process for health and well-being."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9065064380185103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036659_919972229725425_5856591376987081496_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDTq3SdgLxUQ7kNvwFpT08U&_nc_oc=AdlnAgxL-JiATm1gEkDDCJ5YwrLNhQbtr8FGHg30OX6uIb8737johHKn6nla5BhpQ68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvqzVzVjYwz_qcgBaDBTruFwMNU-Gh4eRc2uR8szxCXNA&oe=699B0DEC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Digestion Absorption Experiment - ContentsDa Science Experiment", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "104
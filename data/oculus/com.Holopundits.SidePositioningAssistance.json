": "Screenshot_Side_pose_05.png", "id": "515751047479513", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566677_515751050812846_1462125130731236590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9x_NedLwZgQ7kNvwGK3uqh&_nc_oc=AdrJ3PL1C-6pUPMuCWxrLMSptksbE1Vd5FSJ0dQlX_o99EfyI7fObibDcRmpxsGACfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-snlB2JVO35L-HjR3uMtTp-FIeFfcNZcG_dw3wWxQLw&oe=6A60CC62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440.png", "id": "1250290243014788", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_1250290246348121_2726061545124475027_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6g9XhIyzIwQ7kNvwHVemgt&_nc_oc=Adr8j3LoUapFZfW0Oyq1DPvxUt1Cu5Mzox8E3yeuAU2K6AovkUt5muBYyQMlHcyJ5Qk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBu23rZAsC4P7qnDWt-1Y60LiGDOM5T-VrV6NkKBPsZAw&oe=6A60C0B5"}, "display_name": "Side Positioning Assistance Simulator", "keywords": ["CNA", "nurse", "nursing", "training", "simulator"], "long_description": "This Siding Positioning Assistance tutorial trains the essential skill of positioning a patient on their side, focusing on comfort and the prevention of pressure ulcers. The tutorial includes preparation, proper technique for turning and positioning, and ensuring patient safety.  \n\n# Learning Objectives: \n- Remember the steps and protocols for positioning a patient on their side. \n- Understand the importance of proper patient positioning for comfort and pressure ulcer prevention. \n- Apply the correct techniques to position a patient on their side safely. \n- Analyze the patient's condition to determine the best approach for positioning. \n- Evaluate their own technique to ensure it adheres to best practices and safety standards. \n- Create a comfortable and safe environment for patients through proper positioning. \n\nThis comprehensive approach ensures CNAs are well-prepared to assist patients with proper care efficiently and compassionately in real-world clinical settings. ", "short_description": "Master the technique of positioning a patient on their side to ensure comfort and prevent pressure ulcers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8673710309314573"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "654852530888764"}, {"status": "PUBLISHED", "id": "875052144488805"}]}, "baseline_offer": {"id": "654852530888764"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749744180, "status": "PUBLISHED", "id": "654852530888764"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24690939523831729", "version": "3.0"}, "id": "474455075569833", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8673710292647908", "is_concept": false, "latest_released_binary": {"__ty
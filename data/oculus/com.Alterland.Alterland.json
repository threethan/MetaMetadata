nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwi7w1868pBcCHMGrDpzREoF5mtQnA6UDCHrdTKZPYSzw&oe=69C67F4D"}, {"file_name": "Sequence 01.00_00_37_03.Still008.png", "id": "1280264463498371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819980_1280264466831704_8948119458012445982_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zc1HA6_bHCEQ7kNvwEiyhFG&_nc_oc=Adqubs_z0H7GMuofIE71vMCL5Dj-GF8h9GyCX_8cGO-UvedzZH_XI2JAOaeF6ve3a7M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWOCXotQ9BezHZL9jOUFI10hsKbYbwcDlwss_LKxsy6Q&oe=69C684DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1825193875095351", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300897_1825193878428684_7328305366508183245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfcPTZFZ5C0Q7kNvwHyOlNQ&_nc_oc=AdryKQAfj2Pcd4o_VOSmJVOCNWCykqFHHP2HgTJOxk9kb_2FhOEg7PtbrxSe0tEESlU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiQ74N-09MdK1JTU9qy1TDsy9i82y1z3HirsrOKevDSw&oe=69C681DB"}, "display_name": "Alterland", "keywords": [], "long_description": "Alterland is a next-generation collaboration platform built on **Unreal Engine** to deliver **photorealistic environments, realistic avatars, and seamless multi-user interaction.** It\u2019s built for organizations that need more than just a virtual meeting room.\nWith **PC and standalone headset access,** Alterland is perfect for **workshops, onboarding, training, and education**\u2014all enhanced with **AI-powered tools** that simplify tasks and boost engagement.\n\n**Selfie-based realistic avatars** \u2013 feel truly present with your team or students.\n**3-level access system** \u2013 from personal desks to team rooms to full campuses.\n**Built-in collaboration tools** \u2013 whiteboards, sticky notes, 3D markers, polls, and AI Smart Notes.\n**Optimized for scale** \u2013 from small team meetings to large events or conferences.\n\nWhether you\u2019re hosting a class, running a workshop, or connecting a global team, **Alterland makes remote collaboration feel effortless and real.**", "short_description": "Alterland \u2013 Next-Level VR Collaboration\n\nUltra-realistic spaces and powerful AI tools. Designed for teams, educators, and event hosts who want VR collaboration to feel natural, productive, and scalable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alterland.io/privacy-policy.html", "developer_terms_of_service_url": "https://www.alterland.io/Terms_and_Conditions_Clean_15.09.2024.pdf", "publisher_name": "Alterland", "support_website_url": null, "website_url": "https://www.alterland.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "2687655338230691"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9515097408527929"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1438034310806002"}]}, "baseline_offer": {"id": "1438034310806002"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755853860, "status": "PUBLISHED", "id": "1438034310806002"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25973313885613021", "version": "1.0"}, "id": "1363754248281534", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binar
25/491822034_24169821055979907_1557949910951656606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ybl71YkFb8Q7kNvwGQFgqU&_nc_oc=AdpzdeBaQru5IMibVZGYzrZ13dgISpiyJtZASFgXfYyixkihfABf3haEngRB6YvlkU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBeAnjCPAYhzlo4K81fr_2YkWScUb2vvMATa72RFilNA&oe=6A9EB54D"}, {"file_name": "Sequence 01.00_00_37_03.Still008.png", "id": "1280264463498371", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819980_1280264466831704_8948119458012445982_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUu9V6CGBo0Q7kNvwFg-7YG&_nc_oc=AdqV9R60gyIz7hvizuE-LTaZv72_99V8qgwW09G8fl9qNOJ0awOm_o_AS9hHE3MQZh0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0xYetrikOrUVNZnhSgpxMYnrwqFunvO7sK5bdE6yjRQ&oe=6A9EBADD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1825193875095351", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300897_1825193878428684_7328305366508183245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5If8L7E11YQ7kNvwFdY6DF&_nc_oc=AdpN9wwjjp_ajmsp1kOw9pY3X_ABnh5fgPN6Tq5pyVc5395FItYV1EI9XmA0RhYJ5QQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb452N7IoI-XnSiL6Rk4Nbf5QQH3GloLn1R7gdyPdfAA&oe=6A9EB7DB"}, "display_name": "Alterland", "keywords": [], "long_description": "Alterland is a next-generation collaboration platform built on **Unreal Engine** to deliver **photorealistic environments, realistic avatars, and seamless multi-user interaction.** It\u2019s built for organizations that need more than just a virtual meeting room.\nWith **PC and standalone headset access,** Alterland is perfect for **workshops, onboarding, training, and education**\u2014all enhanced with **AI-powered tools** that simplify tasks and boost engagement.\n\n**Selfie-based realistic avatars** \u2013 feel truly present with your team or students.\n**3-level access system** \u2013 from personal desks to team rooms to full campuses.\n**Built-in collaboration tools** \u2013 whiteboards, sticky notes, 3D markers, polls, and AI Smart Notes.\n**Optimized for scale** \u2013 from small team meetings to large events or conferences.\n\nWhether you\u2019re hosting a class, running a workshop, or connecting a global team, **Alterland makes remote collaboration feel effortless and real.**", "short_description": "Alterland \u2013 Next-Level VR Collaboration\n\nUltra-realistic spaces and powerful AI tools. Designed for teams, educators, and event hosts who want VR collaboration to feel natural, productive, and scalable."}]}, "developer_name": null, "developer_privacy_policy_url": "http://legal.alterland.io/alterland_privacy_policy.pdf", "developer_terms_of_service_url": "https://www.alterland.io/Terms_and_Conditions_Clean_15.09.2024.pdf", "publisher_name": "Alterland", "support_website_url": null, "website_url": "https://www.alterland.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1063584910766706"}, {"id": "2687655338230691"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27259108867033510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821955_1076173974493966_4012036760638693916_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biJaXB-Di_QQ7kNvwEkxqvv&_nc_oc=AdqevNzHjipRygIKZa-NYh6WjmEAinZf6d2sUlUfLUYUWPIr3T6wIkbkBl7GND68lHc&_nc_zt=3&_nc_ht=scon
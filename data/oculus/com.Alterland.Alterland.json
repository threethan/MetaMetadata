2xhoeE6zlitTMQA853Us&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvZ_uoydt68nitkAzeNdrnvsvpjqs429jnMJ4vWntsdIA&oe=69A58D21"}, {"file_name": "Sequence 01.00_00_40_18.Still006.png", "id": "24169821045979908", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822034_24169821055979907_1557949910951656606_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuCLHUKWH2UQ7kNvwFS1Wxf&_nc_oc=Adl1M5WK1FrVi5REt_OB5bMteO_l7l1XqD-Rc6hh9Q4Kv7HlsNuslQfXmtDov2EvlQU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aftac77yqcs5MxhuFjPA0Nj2RbQOshWCX1dwEpTikpMN8Q&oe=69A589CD"}, {"file_name": "Sequence 01.00_00_37_03.Still008.png", "id": "1280264463498371", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819980_1280264466831704_8948119458012445982_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zZbDk-GkYcQ7kNvwFPeMkN&_nc_oc=AdlMXSMC-CofWizMRTMJw-lvxdA3i0oQlpDFemntZXUK6A56ouRrYTSEByNF0GWL3Uw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftStOq0n3rDW92V3K-tIoJXfLhRtZ1vNX97AJ_1ox0cEw&oe=69A58F5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1825193875095351", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300897_1825193878428684_7328305366508183245_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1C59Ag1jlGQQ7kNvwGAl90Z&_nc_oc=Adm-q5UQTzXPyNwE86F68BSNaGsjhr9seMKwHuy4AtrqCwisCJBbwJlWaD_ged3m4xc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftOHUHULYiYHgGJ2ZIW63mKKinUxQ7tYgbzSuVtUwBbyg&oe=69A58C5B"}, "display_name": "Alterland", "keywords": [], "long_description": "Alterland is a next-generation collaboration platform built on **Unreal Engine** to deliver **photorealistic environments, realistic avatars, and seamless multi-user interaction.** It\u2019s built for organizations that need more than just a virtual meeting room.\nWith **PC and standalone headset access,** Alterland is perfect for **workshops, onboarding, training, and education**\u2014all enhanced with **AI-powered tools** that simplify tasks and boost engagement.\n\n**Selfie-based realistic avatars** \u2013 feel truly present with your team or students.\n**3-level access system** \u2013 from personal desks to team rooms to full campuses.\n**Built-in collaboration tools** \u2013 whiteboards, sticky notes, 3D markers, polls, and AI Smart Notes.\n**Optimized for scale** \u2013 from small team meetings to large events or conferences.\n\nWhether you\u2019re hosting a class, running a workshop, or connecting a global team, **Alterland makes remote collaboration feel effortless and real.**", "short_description": "Alterland \u2013 Next-Level VR Collaboration\n\nUltra-realistic spaces and powerful AI tools. Designed for teams, educators, and event hosts who want VR collaboration to feel natural, productive, and scalable."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.alterland.io/privacy-policy.html", "developer_terms_of_service_url": "https://www.alterland.io/Terms_and_Conditions_Clean_15.09.2024.pdf", "publisher_name": "Alterland", "support_website_url": null, "website_url": "https://www.alterland.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "2687655338230691"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9515097408527929"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-2
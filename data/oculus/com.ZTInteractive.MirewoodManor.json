c_sid=6e7a0a&_nc_ohc=O6kd9KhnLpkQ7kNvwEG7apB&_nc_oc=Adlvu-t5qXOYJSdcbOf2iTsEZxmH2S8AE_Aa9-7Ft3qwUsFMCRKi8Hts5tDccm06p2E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwYmW8GsEkCINd_8gGSV2lCnU05ny3oYBQzccjexuYeMg&oe=69B7F5E0"}, "display_name": "Mirewood Manor: Multiplayer Haunted House Horror", "keywords": ["horror", "multiplayer", "haunted", "house", "puzzle"], "long_description": "Mirewood Manor is a story-driven haunted-house type experience which can be enjoyed solo or with up to three other friends. In this deep narrative, explore the large estate of the Mirewood Manor, where an unfortunate incident has brought you, our protagonist, into the scene to investigate. Solve the mystery of Mirewood; learn why and how ghostly figures now haunt not only the manor, but the entire world!\n\nFeatures:\n* All modes are 1-4 players\n* A unique and compelling story that clocks in at over 10 hours\n* Extra modes include Survival Mode and Tour Mode\n* Mirewood Games, a party mode with a host of fun mini-games\n* Deep rewards and achievement system\n* RPG-like elements such as Player Levels and Exploration XP\n* Plus much more!", "short_description": "Mirewood Manor is a story-driven haunted-house type experience which can be enjoyed solo or with up to three other friends. In this deep narrative, explore the large estate of the Mirewood Manor, where an unfortunate incident has brought you, our protagonist, into the scene to investigate. Solve the mystery of Mirewood; learn why and how ghostly figures now haunt not only the manor, but the entire world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mirewoodmanor.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ZT Interactive", "support_website_url": null, "website_url": "https://mirewoodmanor.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_t
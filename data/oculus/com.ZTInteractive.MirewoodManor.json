P&_nc_oc=Adoq9UP5YMjNJ9SXlAevYAgBvpgHs1g9jVShKnGnTu5QyZexgK7UyOzVbNe8LSMk750&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1zr8An07PIW0PGnfGnUBtD6331A9Xxq9UteVHUQhbhGA&oe=69F1F7E0"}, "display_name": "Mirewood Manor: Multiplayer Haunted House Horror", "keywords": ["horror", "multiplayer", "haunted", "house", "puzzle"], "long_description": "Mirewood Manor is a story-driven haunted-house type experience which can be enjoyed solo or with up to three other friends. In this deep narrative, explore the large estate of the Mirewood Manor, where an unfortunate incident has brought you, our protagonist, into the scene to investigate. Solve the mystery of Mirewood; learn why and how ghostly figures now haunt not only the manor, but the entire world!\n\nFeatures:\n* All modes are 1-4 players\n* A unique and compelling story that clocks in at over 10 hours\n* Extra modes include Survival Mode and Tour Mode\n* Mirewood Games, a party mode with a host of fun mini-games\n* Deep rewards and achievement system\n* RPG-like elements such as Player Levels and Exploration XP\n* Plus much more!", "short_description": "Mirewood Manor is a story-driven haunted-house type experience which can be enjoyed solo or with up to three other friends. In this deep narrative, explore the large estate of the Mirewood Manor, where an unfortunate incident has brought you, our protagonist, into the scene to investigate. Solve the mystery of Mirewood; learn why and how ghostly figures now haunt not only the manor, but the entire world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mirewoodmanor.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ZT Interactive", "support_website_url": null, "website_url": "https://mirewoodmanor.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "6443548
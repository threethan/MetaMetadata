=6A85A9C7"}, {"file_name": "Screen5.png", "id": "547691020320681", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974873_547691023654014_3294179828256468762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJA6bBoD_8QQ7kNvwG4gPeE&_nc_oc=Adqm225REi81BEAgcoAwxdpJjtA-J33ge8AuCvRNL-2StQk7ppD7v40ZSpTRD6KG32E&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNl4JuADCPL1JyrOcnAzSC26WOpzA__lXBJZ2s_0q9Tw&oe=6A859592"}, {"file_name": "Screen1.png", "id": "3208114706132545", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982441_3208114709465878_979077595306277777_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhJH_QZBJo0Q7kNvwEBOTOI&_nc_oc=Ado6Biixppn2AQYbBnVp2d3SMWv26_f6NZr1lQk6gXNPAxgWtzbPlZAVhXJbJYkYlHs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE69SjDt_9HKUB5hPUkp9kY3ZuBdASiaJBVw8vsdRNLcA&oe=6A85A880"}, {"file_name": "Screen2.png", "id": "917107466346214", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982492_917107469679547_3993462378037774303_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3pgkU9T7NXcQ7kNvwFyJwQE&_nc_oc=Adqof0BkNMBTdvOoc30mUtTcGZWuGlW2oTharimDkfB4cCcd2KagTg8Fu_k8VlwskX4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfgQHn9OwjXn4twRL2NmakfVI6BEbmfDh3FNkMjPM6Sw&oe=6A85A0F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MirewoodManorCLandscape.png", "id": "384151153761376", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984464_384151157094709_4703273435449012197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4ehyLPnB9IQ7kNvwESA2C7&_nc_oc=Adpo4PnS0NN6cpj5OVHpDcI2Wdv4614eSiigsHSySCkzqAbtv4Rt0CVky6cUPpqyBOY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEUMhpds_WiCCCqiqnhmq4_7fzy8HdtklYT9gvv6TFwA&oe=6A859FE0"}, "display_name": "Mirewood Manor: Multiplayer Haunted House Horror", "keywords": ["horror", "multiplayer", "haunted", "house", "puzzle"], "long_description": "Mirewood Manor is a story-driven haunted-house type experience which can be enjoyed solo or with up to three other friends. In this deep narrative, explore the large estate of the Mirewood Manor, where an unfortunate incident has brought you, our protagonist, into the scene to investigate. Solve the mystery of Mirewood; learn why and how ghostly figures now haunt not only the manor, but the entire world!\n\nFeatures:\n* All modes are 1-4 players\n* A unique and compelling story that clocks in at over 10 hours\n* Extra modes include Survival Mode and Tour Mode\n* Mirewood Games, a party mode with a host of fun mini-games\n* Deep rewards and achievement system\n* RPG-like elements such as Player Levels and Exploration XP\n* Plus much more!", "short_description": "Mirewood Manor is a story-driven haunted-house type experience which can be enjoyed solo or with up to three other friends. In this deep narrative, explore the large estate of the Mirewood Manor, where an unfortunate incident has brought you, our protagonist, into the scene to investigate. Solve the mystery of Mirewood; learn why and how ghostly figures now haunt not only the manor, but the entire world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://ztvrgames.com/mirewood/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ZT Interactive", "support_website_url": null, "website_url": "https://ztvrgames.com/mirewood/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "NARRATIVE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "support
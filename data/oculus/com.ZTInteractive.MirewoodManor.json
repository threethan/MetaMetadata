739293", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348040_428325952072626_97252268265496442_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Huhngn_7G1UQ7kNvwHMUGTY&_nc_oc=AdnFJl20PQou41bWCimStpnuF3cyz5hwTejluwq6LEA1cn2-wwPHCqTbVFwdkpHzZBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCv2KgMoJvxJQxMvg3grnMNVcACdbOQs5Img3AesIXXg&oe=699DA1C7"}, {"file_name": "Screen5.png", "id": "547691020320681", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974873_547691023654014_3294179828256468762_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR5324-stJ0Q7kNvwEhjsFh&_nc_oc=AdlgQxOv2S6Gkrhxd_IuvKSbmmbZ13DuA7k9K9XRpETHkOZF4XSbQ3FAITIdSijAM5I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfttcMu67ZFTlfDSEVhDoT758X2up3o6Uic0a7tQGq1dBg&oe=699D8D92"}, {"file_name": "Screen1.png", "id": "3208114706132545", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982441_3208114709465878_979077595306277777_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yX4qPa5OspEQ7kNvwFiUK7M&_nc_oc=AdmfujycgSxyrdjqJO49GihmlgguRfmB7A1Jw47i4UhTmCXgX4HSbCCrmIibfHk-9yI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvs2yWC1ayJSUh__T9dS4BtQI9X2rZ0sh8lzEzdlrB4VQ&oe=699DA080"}, {"file_name": "Screen2.png", "id": "917107466346214", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982492_917107469679547_3993462378037774303_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1Lcg17-xZsQ7kNvwG8yRHj&_nc_oc=AdkA9GBTUxWlUloz6kHkDjALKz1jap7GIN-KU4rQb5dT4VxDB_HfHxz43F5sXAVDygU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5niN4bJ5jr8aRZHFgV7jOWBPuH13ACrowVKQBBonn1g&oe=699D98F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MirewoodManorCLandscape.png", "id": "384151153761376", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984464_384151157094709_4703273435449012197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6BY6VZ48X8Q7kNvwGtg3oU&_nc_oc=AdnBunsKTF6y1cHjuQfEujCX4OP_00YMVSWmCkW8fFck3pp3F6oY_SHm-bKBkz0JUWc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftpRX5TEAvX00cpIYmuFbkUQlDzhRZTblVxcOun_9kYPw&oe=699D97E0"}, "display_name": "Mirewood Manor: Multiplayer Haunted House Horror", "keywords": ["horror", "multiplayer", "haunted", "house", "puzzle"], "long_description": "Mirewood Manor is a story-driven haunted-house type experience which can be enjoyed solo or with up to three other friends. In this deep narrative, explore the large estate of the Mirewood Manor, where an unfortunate incident has brought you, our protagonist, into the scene to investigate. Solve the mystery of Mirewood; learn why and how ghostly figures now haunt not only the manor, but the entire world!\n\nFeatures:\n* All modes are 1-4 players\n* A unique and compelling story that clocks in at over 10 hours\n* Extra modes include Survival Mode and Tour Mode\n* Mirewood Games, a party mode with a host of fun mini-games\n* Deep rewards and achievement system\n* RPG-like elements such as Player Levels and Exploration XP\n* Plus much more!", "short_description": "Mirewood Manor is a story-driven haunted-house type experience which can be enjoyed solo or with up to three other friends. In this deep narrative, explore the large estate of the Mirewood Manor, where an unfortunate incident has brought you, our protagonist, into the scene to investigate. Solve the mystery of Mirewood; learn why and how ghostly figures now haunt not only the manor, but the entire world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mirewoodmanor.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ZT Interactive", "support_website_url": null, "website_url": "https://mirewoodmanor.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_t
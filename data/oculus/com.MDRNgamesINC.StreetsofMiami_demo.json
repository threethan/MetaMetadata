e=6AE33D9A"}, {"file_name": "491823949_2485709858524557_9183837045460509577_n.png", "id": "1421224813148913", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310731_1421224816482246_2342771812143973116_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpAV7RAEuD4Q7kNvwE68nmd&_nc_oc=AdoZj7buBDURA4ZZJggo0sG2LPUGKgjqRjtIO4tj-yZWW_JezLQzoLjzU4H5Ot1rcXQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtN1INbGJIoSgEDESyrRI2sox4Ycdj2SZwKbmmo5g67g&oe=6AE342E3"}, {"file_name": "507828592_1535122661542115_2287720734739315511_n.png", "id": "1562672661858418", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499312454_1562672665191751_5980020160040167027_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JICz-ugZd8Q7kNvwH9sa5n&_nc_oc=AdpWQcX0CUW2WX17dj15OZV0FaW9NEJefAZ71DQouIk-9LzCnecn7KOuh-qcU8GB6y0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlMDbeVUgI5sxyIJxGxb4uKvhIdpwIpWtMAkhZJF6whQ&oe=6AE366CA"}, {"file_name": "491825415_1006717525636038_1506060177654414814_n.png", "id": "1805906400765496", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499295481_1805906407432162_2180950814267483999_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRv5-NKm8hMQ7kNvwGWG6Qc&_nc_oc=AdrL7LorZP0B2ZBGP2edR9HhO1CSMEXSBJA3CZeeEi2blrAW1Ffjly7A2-tPHaJ2vLw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUjDhPPvsbe2u6ytIk4w7Sn-GMsl4FfgHTUCv8ob9d1Q&oe=6AE35F7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "1365069768286580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823746_1365069771619913_1316123168741708737_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_54WizOLKYQ7kNvwErISdG&_nc_oc=AdoJzWbX_4TLmEgs3Gz9qh_OLKTFMO7NBQjUWPZPhN9iLZTw-MmoB8oSfD6xux1Z2jk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGoGwJMeRFBWIcNweqFrMI10sKL01uSNAYwCY2FIRZlw&oe=6AE33CCF"}, "display_name": "Streets Of Miami FREEPLAY", "keywords": ["Sandbox", "crime", "adventure", "shooter", "action"], "long_description": "Streets of Miami VR is a gritty 1980s crime-action VR game set in a semi-open world version of Miami.\n\n\n\nStart with nothing, learn the streets, make money, buy weapons, get vehicles, and work toward owning property before the city chews you up. The demo gives players a focused slice of the full game, introducing the core mechanics before releasing them into the streets with limited time to explore, hustle, and survive.\n\n\n\nAfter the tutorial, you will have 13 minutes in the semi-open world demo area to make money, buy gear, test vehicles, and experience the base gameplay loop of Streets of Miami VR.\n\n\n\n\n\n\u25a0 Join the discord & download the demo early! \u25a0 \nhttps://discord.gg/eaeJdCeVBv\n\n\n\n- Play through a hands-on tutorial built for VR.\n\n- Learn movement, interaction, combat, driving, and weapon handling.\n\n- Practice spray painting, fighting, melee attacks, knife combat, gun shooting, and more.\n\n- Get introduced to the core systems before entering the open streets.", "short_description": "Streets of Miami VR throws you into the heart of 1980s Miami. You arrive as a new immigrant with nothing, trying to carve out a life on the infamous Vice strip. Work the streets, navigate shady deals, and survive the chaos of a city run by crime, culture clashes, and corruption\u2014all in full VR.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/#684f5d39-058f-420b-9327-2c7a1bafac1f", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_s
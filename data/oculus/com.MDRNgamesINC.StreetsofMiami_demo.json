.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2tnE3AAtCUQ7kNvwEjGWmj&_nc_oc=AdrotEAfzEEX-8ljLyjT0zFjm0R397MRzTKGuKACBVDdBJAJjsU8hnspJZDz83x9ZSU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1DOzjzUcj9UPyfxjdRbtptvBzSUBO-MWR2QM0yi0OWw&oe=6AFC825A"}, {"file_name": "491823949_2485709858524557_9183837045460509577_n.png", "id": "1421224813148913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310731_1421224816482246_2342771812143973116_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fv8dqXSD0wQ7kNvwGHfIsF&_nc_oc=AdpwZCSP3_XmP5XlLS7XqjClV7uPcOs25qNfQH4QJSmvOCdyR0NArOWNTM7vo661pZo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI4jGUgohCxAFtyfIwX4Knx_ZQmKPxWJkm5qC85Sj1OQ&oe=6AFC87A3"}, {"file_name": "507828592_1535122661542115_2287720734739315511_n.png", "id": "1562672661858418", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499312454_1562672665191751_5980020160040167027_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DZ1wQHp0mIQ7kNvwFl1O1n&_nc_oc=Adqr2kTBqpPgdVnhGpkCxpTPlcvxv0vU-nrdj-M_OfX9DcB1_6egI1rzV2NFF4dajWA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2I4Ff33zgJi7O-OCSDFoGrba_u5ZOynUtdjQLFTit-w&oe=6AFC734A"}, {"file_name": "491825415_1006717525636038_1506060177654414814_n.png", "id": "1805906400765496", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295481_1805906407432162_2180950814267483999_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5XeEe8YlJIQ7kNvwGAPf6B&_nc_oc=AdrzXG7Pw5rJrdIRVtS8kE7pEykkHJOaun6EwLuSAciTHpyajYcZav0zu-VPmRZdr-g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ95TTkRUBoXP2MQJb_tdejmn6xfx0Amme7MJBr-dkszg&oe=6AFC6BFD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "image.png", "id": "1365069768286580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823746_1365069771619913_1316123168741708737_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDII5Iqn7RIQ7kNvwEp1kEr&_nc_oc=AdoiIhP-oJhvprVfYrMJdDpudga5rej-ZQxLl858l0_3_4XWPxzBBdqFDSH2QKyI_RY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQU6E3LyyJGQCKzCC29gbKOE8sykEM5dQljj93sw0Y2Q&oe=6AFC818F"}, "display_name": "Streets Of Miami FREEPLAY", "keywords": ["Sandbox", "crime", "adventure", "shooter", "action"], "long_description": "Streets of Miami VR is a gritty 1980s crime-action VR game set in a semi-open world version of Miami.\n\n\n\nStart with nothing, learn the streets, make money, buy weapons, get vehicles, and work toward owning property before the city chews you up. The demo gives players a focused slice of the full game, introducing the core mechanics before releasing them into the streets with limited time to explore, hustle, and survive.\n\n\n\nAfter the tutorial, you will have 13 minutes in the semi-open world demo area to make money, buy gear, test vehicles, and experience the base gameplay loop of Streets of Miami VR.\n\n\n\n\n\n\u25a0 Join the discord & download the demo early! \u25a0 \nhttps://discord.gg/eaeJdCeVBv\n\n\n\n- Play through a hands-on tutorial built for VR.\n\n- Learn movement, interaction, combat, driving, and weapon handling.\n\n- Practice spray painting, fighting, melee attacks, knife combat, gun shooting, and more.\n\n- Get introduced to the core systems before entering the open streets.", "short_description": "Streets of Miami VR throws you into the heart of 1980s Miami. You arrive as a new immigrant with nothing, trying to carve out a life on the infamous Vice strip. Work the streets, navigate shady deals, and survive the chaos of a city run by crime, culture clashes, and corruption\u2014all in full VR.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/#684f5d39-058f-420b-9327-2c7a1bafac1f", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "suppo
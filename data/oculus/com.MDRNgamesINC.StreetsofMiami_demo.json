LeVf7rS_9MV53gRs75VnrTXgUHabsWvmNfDrZ-2HzzGPSQEJ48bO-uE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNDF8lZ4uK9uj0qe_om2Ieq2ehenTV8j5pgBN8J9rYbQ&oe=6AEDF2CA"}, {"file_name": "491825415_1006717525636038_1506060177654414814_n.png", "id": "1805906400765496", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295481_1805906407432162_2180950814267483999_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ao-txKxw20Q7kNvwHRnIav&_nc_oc=Adr2K55nP8S8a9P3FZiIE22fAaOnKw_oK3JoHFJzuBMWu1WTG-mnxxdNXDQjomIc1mQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlksCsJbNXtfdJfa_kT94X7qB0l7htO1mcMdCSqIL6Cg&oe=6AEDEB7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_Lib_land.png", "id": "1005322211883601", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310734_1005322218550267_7838915588714389204_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqdlcbVeCbIQ7kNvwENH74b&_nc_oc=Adr18oKAI_0QeB7b7dC24L44d4Ec_Ebthip4SLbrahEJaqZRx5ZZKt0yqccdlp3tYw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOBQjtngqwOgOn0p9IFIQKNDqz4tRF9HXUrfxOneDUlQ&oe=6AEE07CB"}, "display_name": "Streets Of Miami DEMO", "keywords": ["Sandbox", "crime", "adventure", "shooter", "action"], "long_description": "Streets of Miami VR is a gritty 1980s crime-action VR game set in a semi-open world version of Miami.\n\n\n\nStart with nothing, learn the streets, make money, buy weapons, get vehicles, and work toward owning property before the city chews you up. The demo gives players a focused slice of the full game, introducing the core mechanics before releasing them into the streets with limited time to explore, hustle, and survive.\n\n\n\nAfter the tutorial, you will have 13 minutes in the semi-open world demo area to make money, buy gear, test vehicles, and experience the base gameplay loop of Streets of Miami VR.\n\n\n\n\n\n\u25a0 Join the discord & download the demo early! \u25a0 \nhttps://discord.gg/eaeJdCeVBv\n\n\n\n- Play through a hands-on tutorial built for VR.\n\n- Learn movement, interaction, combat, driving, and weapon handling.\n\n- Practice spray painting, fighting, melee attacks, knife combat, gun shooting, and more.\n\n- Get introduced to the core systems before entering the open streets.", "short_description": "Streets of Miami VR throws you into the heart of 1980s Miami. You arrive as a new immigrant with nothing, trying to carve out a life on the infamous Vice strip. Work the streets, navigate shady deals, and survive the chaos of a city run by crime, culture clashes, and corruption\u2014all in full VR.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mdrngames.com/#684f5d39-058f-420b-9327-2c7a1bafac1f", "developer_terms_of_service_url": null, "publisher_name": "MDRNgamesINC", "support_website_url": null, "website_url": "https://mdrngames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1772620654708710"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1049488567404956"}]}, "baseline_offer": {"id": "1049488567404956"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783514280, "status": "PUBLISHED", "id": "1049488567404956"}]}, "liveChannel": {"nodes": [{"latest_supported_bin
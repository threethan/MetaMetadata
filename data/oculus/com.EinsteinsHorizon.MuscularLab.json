screenshots": [{"file_name": "muscular_1.png", "id": "1340063578055426", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620856_1340063581388759_8462812069211230981_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYzFHbMcVdEQ7kNvwHo3Eq1&_nc_oc=AdqFgX8Sz4KWQ0bltUmPON3B5YmD0LZO57DnL2iBOSB_JiPnyMIdCfzRlUDECy3UFc8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_J1bOEQU8Q9PZT53ghoWfDgAUprYfhSLIfJLsg9n07w&oe=6ADCB493"}, {"file_name": "muscular_2.png", "id": "2032095134370906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619681_2032095137704239_8446937059744736059_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZeAm49m1G8Q7kNvwGZo7xc&_nc_oc=Adqm-zDica1h-KhGDk35UjvU9p9R7ToMvY3vfzbCPN4hUfD0m9sWiZAAvIq-doa72rU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9BKJFVohTivNPSrfeFG-e4RVowreqOc-uo2WyWKH56g&oe=6ADCC327"}, {"file_name": "muscular_3.png", "id": "27656401927298357", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622325_27656401930631690_4062622456933569027_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghqGMHdd7L4Q7kNvwGYLNl2&_nc_oc=AdqycB1-8cB6Q0bBLAK6dO3ydwPApxeSW6o-S2bgYYk1zvjxLp-lRP5kBok-elQVDOw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEQC8lZoSiDmUSwbcheiJ7F8JUdP9HBeGhNdDbiqlcRQ&oe=6ADCB129"}, {"file_name": "muscular_4.png", "id": "1357905829863971", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604302364_1357905833197304_2824551140688277032_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MO7W5fofuEQQ7kNvwFOk_Wv&_nc_oc=AdqN4M2wFpgVZnnYZv2Uj55ZnOZjQ1cdWEgJVjUkj06HojAjz34q3OgIIXAq1UQ4qUs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6zhaFY7GJ6m9U-GoIGawajl-R0TFd-qxLMSY5cKe29Q&oe=6ADCBBB6"}, {"file_name": "muscular_5.png", "id": "963446789848534", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622334_963446793181867_9204502701970882003_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IAcFWDaPqbwQ7kNvwGpvOv3&_nc_oc=Adq1mhXu0FDfHmhCe3anZFjnwaAg9NJcBKoJeKy7iqasUm7VdheouondVtlGbhxSV_4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU9FYf1HvtN8Iuh3ILVvYCs0P3itKpnwSWRbHQ78_lJA&oe=6ADCC16F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "all_store_trailer_cover.png", "id": "1515130970343516", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623345_1515130977010182_6173201055774125425_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orTSsbYPiogQ7kNvwFBaDak&_nc_oc=AdpBH8IQzCIC28nHoqS5SQU8wpETisJwQ7zk5pyqi8LWd2dFXYxLBE-8xd4OiPuwpxA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdfRsyNFh9z_zt-q2-Ky9po2KGda87KY5T4rYiR3QXgQ&oe=6ADCA85F"}, "display_name": "Anatomy Learning Labs: Muscular Lab", "keywords": ["anatomy", "biology", "muscle", "medical", "learning"], "long_description": "Step into the Muscular Lab of the Anatomy Learning Labs series, where the power and movement of the human body come to life in stunning 3D. Featuring anatomically accurate models developed by medical professionals and learning activities designed by professors, the Muscular Lab teaches elementary, middle, and high school learners how muscles generate movement, maintain posture, and work together with the skeletal system to support everyday activities.\n\nThis app leverages the Quest's audio, visual, and hand-tracking capabilities to deliver truly multimodal and active learning experiences. Students learn by seeing anatomy in 3D, hearing explanations, interacting with structures using their own hands, and developing spatial reasoning skills through guided activities.\n\n\u2022 Travel through medical imaging views that reveal the musculoskeletal system, similar to a CT scanner.\n\n\u2022 Select any structure to hear Dr. Hana Sato, your virtual guide, identify it by name and explain their function, such as parts of the neuromuscular junction.\n\n\u2022 Use natural hand-tracking to grab, rotate, and closely inspect individual muscles, muscle groups, and muscle fibers.\n\n\u2022 Assemble the major muscles of the human body in a guided 3D puzzle.\n\n\u2022 Test your knowledge through audio-guided quizzes led by Dr. Sato.\n\n\u2022 Put your skills to the test in a fast-paced Knowledge Knockout challenge, where you must quickly punch the correct muscle under time pressure.", "short_description": "Step into an immersive VR muscular system laboratory and explore how the human body moves and generates force in stunning 3D. Travel through medical imaging views, examine muscles using natural hand-tracking, and hear Dr. Hana Sato identify anatomical structures by name and explain their functions. Assemble muscular anatomy in an interactive 3D puzzle, test your knowledge with quizzes, and reinforce learning through engaging challenges designed to make anatomy more memorable and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.einsteinshorizon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Einstein's Horizon", "support_website_url": null, "website_url": "https://www.einsteinshorizon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1168940719636355"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1875960840043136"}, {"status": "PUBLISHED", "id": "822980347
ohc=mrlmmeO2hgoQ7kNvwE7nByO&_nc_oc=AdrKOd1IoFG3j_hrLlpeoNDycA_x2j4e9D4DRvbrcjMpY7POGzkszMR3OGmyJv7U-RU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcxqRtPz182eANq9yljzhdvZciIoQKboTqrUevJO-cZA&oe=6AFDBA3B"}, {"file_name": "beyondreal screenshot_4.png", "id": "3313529452308514", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75195911_3313529455641847_7609843881061908160_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ0X7h0auo0Q7kNvwFT1ro6&_nc_oc=AdqVM8z2DdoeZlBv7drIi5adkdjnhCZTbRlILeLotfkvPrfNbLIQk3hVCFHv0kbYsMA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr-R1nT1FjmiL1VUN8PVRHjFwIGTQTw5Fctbud02g0Tg&oe=6AFDD331"}, {"file_name": "beyondreal screenshot_1.png", "id": "1156354061672084", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75326676_1156354065005417_4604049573626302179_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEXQeq-qJGAQ7kNvwGw4vyc&_nc_oc=AdpfO5CnaUlV06hlZxL5hyGU8_mtf6ka42sLfCce_g9-WtCaRDpuEPvmdaIcjNLQPDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQi-3rtyCRXvn59kRyVOcnwPouGTa0-xxfBfwZ5esb8yw&oe=6AFDB44B"}, {"file_name": "beyondreal screenshot_5.png", "id": "1234367863780174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982640_1234367867113507_6515706368886082053_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSNWweU2dEkQ7kNvwGsDCVF&_nc_oc=Ado6-GLh4vQEXUHqzE54f8sePsdEiyx5Ann6TdsgyXw32K6xvKfXSV2xR6KCAOV1uVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRZcsV_0FGWK9KGLOXMGD-8Fm3phUJlerPVLpAiRTqjQ&oe=6AFDDFC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "beyondreal trailer.png", "id": "1524969777995754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_1524969781329087_1803815209289572873_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kvw8ana81HkQ7kNvwHNY763&_nc_oc=AdqC0ppdTPo1Ak-ukw2bCWR0qX0E2tARM4LF7EQQxJN2QqgKlo2x5T0IjWEBPdkwie0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEFVGHP8ZjIyoX1k5h4yWQY7nB6dUzbLRs1LBhanrYEA&oe=6AFDAF95"}, "display_name": "Beyondreal", "keywords": [], "long_description": "Beyondreal virtual offices - a collaboration space for teams in stunning locations.\n\n- whiteboarding as an entire location, \n- photorealistic full-body avatars with face recognition: be yourself,  just  upload your picture,\n- increase your productivity: use multiple screens, 3D tools, stickers, \n- create smart maps, show products and enrich your workflow,\n- use your VR headset or invite others via standard video streaming tools,\n- record and stream from multiple cameras,\n- work in impressive and exciting locations and have engaging and productive meetings,\n- make the space your own: brand and save your meeting space and reuse it at anytime,\n- connect  to your team and plan activities: play basketball, chess, chat next to the fireplace or even visit an art exhibition\u2026\n\nBuild greater things and have a better communication in Beyondreal virtual offices, which do not just give you a place to work, but immerse you in a engaging workflow.", "short_description": "Beyondreal is an enterprise collaboration suite that allow you to:\n- whiteboard with ease, use your corporate tools or Beyondreal self made applications, \n- create a space that you can save and reuse with multiple screens, 3D tools, stickers and much more,\n- use your full photorealistic body avatar, and face recognition to give presentations, create smart maps, show products, or play basketball and just relax and chat with a friend at the campfire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beyondreal.life/privacy-policy/", "developer_terms_of_service_url": "https://beyondreal.life/terms-and-conditions/", "publisher_name": "Anasaea", "support_website_url": null, "website_url": "https://beyondreal.life/", "category": "
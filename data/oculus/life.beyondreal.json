4.5771-25/75195911_3313529455641847_7609843881061908160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKNpFeKB854Q7kNvwHzwFFy&_nc_oc=Adr-7HqVg4UZGrB2QqVDiOs-aY3H61J5p2g8rJyzBA-62KanHsiYuNaGjWLAHOm_sMM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2j7jHW_tFbuXe6sxhB07wSZB6bnar52XeghNy1nlcuww&oe=69F0A8F1"}, {"file_name": "beyondreal screenshot_1.png", "id": "1156354061672084", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75326676_1156354065005417_4604049573626302179_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdeUjgX_8hMQ7kNvwGK2BYv&_nc_oc=Adqnbir2EfEZBMO_T-P32tfs02eAPAvIZCI4NO8pJ6D0ncCxBAtDadb4MzKyCP8HUDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af27nngElc85gfRk6uMpzsaw0AdI_8P6KxW4nLe2iFWxSg&oe=69F0C24B"}, {"file_name": "beyondreal screenshot_5.png", "id": "1234367863780174", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982640_1234367867113507_6515706368886082053_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tr0u9AjiLo8Q7kNvwHyY4lk&_nc_oc=AdohjeWEIXu_XK4XfujoVZCQPUYSdqHuHPw-zttZaN7UNHrCzlU2o5200I4t9Y0_v-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2BubjyvK6A8tkGTRocWU0yQBwD94If30I3OBFaaMT5hg&oe=69F0B582"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "beyondreal trailer.png", "id": "1524969777995754", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_1524969781329087_1803815209289572873_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HB0bYPqHwIQ7kNvwG_wjfj&_nc_oc=AdriS6y0E8aP_Mn89baG1sJ8e-XzS0N194iqiF5-L9iveodXafC8BCNoeE-uflUq-Ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af08Prl10tNdVCWypEJaLwIONAX7AGTpEDPrHUC3z0SSlg&oe=69F0BD95"}, "display_name": "Beyondreal", "keywords": [], "long_description": "Beyondreal virtual offices - a collaboration space for teams in stunning locations.\n\n- whiteboarding as an entire location, \n- photorealistic full-body avatars with face recognition: be yourself,  just  upload your picture,\n- increase your productivity: use multiple screens, 3D tools, stickers, \n- create smart maps, show products and enrich your workflow,\n- use your VR headset or invite others via standard video streaming tools,\n- record and stream from multiple cameras,\n- work in impressive and exciting locations and have engaging and productive meetings,\n- make the space your own: brand and save your meeting space and reuse it at anytime,\n- connect  to your team and plan activities: play basketball, chess, chat next to the fireplace or even visit an art exhibition\u2026\n\nBuild greater things and have a better communication in Beyondreal virtual offices, which do not just give you a place to work, but immerse you in a engaging workflow.", "short_description": "Beyondreal is an enterprise collaboration suite that allow you to:\n- whiteboard with ease, use your corporate tools or Beyondreal self made applications, \n- create a space that you can save and reuse with multiple screens, 3D tools, stickers and much more,\n- use your full photorealistic body avatar, and face recognition to give presentations, create smart maps, show products, or play basketball and just relax and chat with a friend at the campfire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beyondreal.life/privacy-policy/", "developer_terms_of_service_url": "https://beyondreal.life/terms-and-conditions/", "publisher_name": "Anasaea", "support_website_url": null, "website_url": "https://beyondreal.life/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "2687655338230691"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
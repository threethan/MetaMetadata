le_name": "beyondreal screenshot_4.png", "id": "3313529452308514", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75195911_3313529455641847_7609843881061908160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJskgKGF_qwQ7kNvwE8iDiw&_nc_oc=Adq-rWzaQg8dncN71yE2G9_pIxIHhtlsRWLMf_CJHGM0zvfCl7RrOXGW0WjSFapmjrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50HexKMYKX8aentNCdhjPuKoLzvgA4uKJa3qtnWH3ieg&oe=6A071271"}, {"file_name": "beyondreal screenshot_1.png", "id": "1156354061672084", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75326676_1156354065005417_4604049573626302179_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyLL60iOLC4Q7kNvwGwa-aa&_nc_oc=Adq-eFYTwOkYTZJy53ehbFcDpfTtvKcFiMliezXCwd4p7d79r-BcUKjAzu3WaJxzFbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_t7JBbvN1dkxUIWHeBRswpOGZIkFJarpDvRnToxwwyQ&oe=6A072BCB"}, {"file_name": "beyondreal screenshot_5.png", "id": "1234367863780174", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982640_1234367867113507_6515706368886082053_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6cBuYNOhd4Q7kNvwGw9R5x&_nc_oc=AdorR06uD4T3ZMlEGVCL4fZv-P9Wmq3wMt6alZbHiAGOAmMfFxvQyfLnRLayfo3UjTU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pFzj-mqORnOpHP_S7tnke6hEDEvlCKSJI-fLIoVBGMw&oe=6A071F02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "beyondreal trailer.png", "id": "1524969777995754", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974854_1524969781329087_1803815209289572873_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0h5lM_sSZwQ7kNvwGZZS71&_nc_oc=AdoQYKOQaGF5M7ooWO61xnMXZPhyvxAWZhh_BPNutg6TguwoChxRefXU9O-vTG8efn4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7duEMmhzK9y_fJmUWeVsz_M06xcJ-h_IWKxg3XxEU5RQ&oe=6A072715"}, "display_name": "Beyondreal", "keywords": [], "long_description": "Beyondreal virtual offices - a collaboration space for teams in stunning locations.\n\n- whiteboarding as an entire location, \n- photorealistic full-body avatars with face recognition: be yourself,  just  upload your picture,\n- increase your productivity: use multiple screens, 3D tools, stickers, \n- create smart maps, show products and enrich your workflow,\n- use your VR headset or invite others via standard video streaming tools,\n- record and stream from multiple cameras,\n- work in impressive and exciting locations and have engaging and productive meetings,\n- make the space your own: brand and save your meeting space and reuse it at anytime,\n- connect  to your team and plan activities: play basketball, chess, chat next to the fireplace or even visit an art exhibition\u2026\n\nBuild greater things and have a better communication in Beyondreal virtual offices, which do not just give you a place to work, but immerse you in a engaging workflow.", "short_description": "Beyondreal is an enterprise collaboration suite that allow you to:\n- whiteboard with ease, use your corporate tools or Beyondreal self made applications, \n- create a space that you can save and reuse with multiple screens, 3D tools, stickers and much more,\n- use your full photorealistic body avatar, and face recognition to give presentations, create smart maps, show products, or play basketball and just relax and chat with a friend at the campfire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beyondreal.life/privacy-policy/", "developer_terms_of_service_url": "https://beyondreal.life/terms-and-conditions/", "publisher_name": "Anasaea", "support_website_url": null, "website_url": "https://beyondreal.life/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "2687655338230691"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL", "PRODUCTIVITY", "SOCIAL"], "has_in_app_ads":
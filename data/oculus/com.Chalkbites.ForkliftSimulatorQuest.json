aO9gi1gfOXmf-QdYBZ92BIy0gtzMbS8h7CS5pWA8EA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--3JUbxKZ3Gg947cdlZEh0sLh3owze5pbr0ZPCsXEwhQ&oe=6A32AEC3"}, {"file_name": "Screenshot2_Labled.png", "id": "814450532441531", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974530_814450535774864_3105815850517796593_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCKa7uhpTk8Q7kNvwE_YjYn&_nc_oc=AdqLKdOCUyXc-MTvOdSxbXLI5WD66AmIdYmFDnikE8F6dZgXoebHwsmYB39jLcUcpP4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g_dnDhZpJOMrShVWYp8tUKfFgK61g25RosdvTjUtK6g&oe=6A32B9C2"}, {"file_name": "Screenshot3_Labled.png", "id": "513692952948015", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974469_513692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns1uhhURWAsQ7kNvwHo7MtW&_nc_oc=Adpe2_qjgNemfWa0zObK9l_OJZfcRNDFVfiOlVbiDDURgHhMfC3GqQg1xzf9zup97Dg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1p0Ib8QY9yjxBNw4XNOJUDIrGf_IyO2kqbsXzXn0nRw&oe=6A32A8F0"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI-C9eS8SKIQ7kNvwFGUhN8&_nc_oc=AdqzsCBRC5QSZXFlq3aJadRTt-pDzaJcG0JTqdLuHW_dWiFSQGSrduRPSfpiqW9gloc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r-K27n3XSCb3gKcyNWn_N5JIrjkXLmM913b_Y4_e9ig&oe=6A32BDE5"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk3fJAchVFsQ7kNvwE7BfKC&_nc_oc=Adr5hxPNK5jmd1ZdXWiTSEDgMoN9O8CnS-KmJ-so0xjz21W0j2abwPu6gdrONMeGCpg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E55av2MN7AxbueRdfGydhY3G0mrvkbhDc81YB-_bl0A&oe=6A32A4EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
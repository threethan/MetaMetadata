E7dHsRLDp4NcukrKWYsYrZ8xT2QqbilwJfMkrKqLFU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLvUhsVvZijZl383PcgrXGBUJMv1rxgYnTwbtkSljXPg&oe=6A8ACB03"}, {"file_name": "Screenshot2_Labled.png", "id": "814450532441531", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974530_814450535774864_3105815850517796593_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RSVRzLOE_YQ7kNvwGP3gVK&_nc_oc=Adq_RFiQGN1yz2-uCB1yBd1ue4BqlUlqh6_w5vKLILnJkZx8cbIRtLT7j53WVtTmvbw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNjX3bL-5ciok7qc_OHL0wPHw-I_inAvt0h0CEbFN9ow&oe=6A8AD602"}, {"file_name": "Screenshot3_Labled.png", "id": "513692952948015", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974469_513692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WI8sbfHgfkQ7kNvwF7swNl&_nc_oc=AdrfUFP9n9OCDwYwO6ifhPA3gVsLElM1TTbU5R_jvy22zkS7T01wKBKNNOjfqesOMZo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_qFJHD_6o0C_GTHBGt2fwKQ_jGlsihBY4L-U5QQMo-Q&oe=6A8AC530"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sd77SeCHJVkQ7kNvwFotTKw&_nc_oc=AdpHdC9zHhDtVgGf75tj2Mkrw2s-IlFGCamp-I_nk6tphkKf435pKZ03QfQU-TkeXEA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvuYCiGGYeCL9YM6rfsHMlliGi8Rk9ShiZx0w3Hstk6A&oe=6A8ADA25"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYW5yy0N7BIQ7kNvwEzRhGq&_nc_oc=AdoyAY-jntz67xEtPs1yYvjWVGxhCuhdnv-CIAWyq_Me79Pj9-W9MTfti6PYwZWLPJw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhrMOeNNfgGzWtk9JkVuB1q98_UIDH1PrhwnstTk33UQ&oe=6A8AC12B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
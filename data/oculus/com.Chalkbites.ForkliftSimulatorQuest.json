0ez9gonXKNGSv6T5XSfI6zR9IaFGaEnJHAGwL3Jn5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5BQPaCuTHoWBG2l9rftPjzXQb2MG-rCZVl-GbwQ4Xxw&oe=6A5B8D43"}, {"file_name": "Screenshot2_Labled.png", "id": "814450532441531", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974530_814450535774864_3105815850517796593_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j9TiUagp8UQ7kNvwEnu6sH&_nc_oc=AdpuMeNhhNDyQgmYDwq3zP1alNEO8i1DD2GH3kxBdAw3Qqz6X0hYVKO3sb2qRZE9F6A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3KQe79zryToUCEp3KcP_xgEqCxTNFtnD5c6qSXDxx0g&oe=6A5B6002"}, {"file_name": "Screenshot3_Labled.png", "id": "513692952948015", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_513692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaeIQ8GY-tEQ7kNvwEuoBEb&_nc_oc=AdoNk4I7ok7yU48hBKJM_266y4vUk1HNxZzSp9QKj4w57BYez0QlR2T-wLXK02q3GHw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtqxvVPSZ5OExK1Blwt0yz5fqYSN8_L9tNsY1k_WM6hg&oe=6A5B8770"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kt_7Grv9ytsQ7kNvwG9PPOo&_nc_oc=Adqp6uEtmkVVtYS2zDKGaNjg2KlT_J5fcYuYYY2AFks0OthRzvutdqAa2gricyRR7Mc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyZhn1b458wWpajEkDdfkFSmGgsoJfICvFbaFG4KRN6Q&oe=6A5B6425"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_do8FF3ru4Q7kNvwF4jLL9&_nc_oc=AdrIuqHPV_73ekjMO8p6eXcWPI3HhQFjBMDG5gJVnFD82WgEJGQEWysuLK5JgfN5CDg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoXX23HkPknRogfFbG4iXt8VlHyyXBgm7yHMUU4Jfh2Q&oe=6A5B836B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
_rFiiGqxg4UaKTuwWe-NrzxlVNyR49jnuyfGxj8a-TRw_Wg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImnyqlmeWxeYmrW4eGx6fGy-lgly4KwLQVPdMYqoKmNQ&oe=6AAE9BC3"}, {"file_name": "Screenshot2_Labled.png", "id": "814450532441531", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974530_814450535774864_3105815850517796593_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea_1aqsXhcoQ7kNvwHjjYZB&_nc_oc=Ado6TsBKKqYhCrqbfQgs8om8OcetLdfs5sQDwy9RTgLDi3eIx5L3sm-v7QdCdjppsxg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKesq_3EOCRpPaLzGPmOWahFvDg3-sZLUc3atwBEJHnQw&oe=6AAEA6C2"}, {"file_name": "Screenshot3_Labled.png", "id": "513692952948015", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974469_513692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GM21Y0VE87kQ7kNvwHz-Udn&_nc_oc=Adr43k2xRhNgPUZQmcW_sNAuBBiGXTzSv4SEIrvLMxO2wx61rxAcHDcHO02o8n3Zjbs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxJ4ylzAqtVCuTKl-ySBMCrN_qmtvRCpexyZ8vZjjRrw&oe=6AAE95F0"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQlArAvOLQQQ7kNvwG5NaDh&_nc_oc=AdoeSlFxQs9gOvIX5hwJ_zw4P8BcoCPgq0HCplWYztw3ckWv93LrkHSINV4r1G9HSek&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvy8aOyAcMK16pNgVrB4YRO-e1IMs3PuPr0zVla18wcA&oe=6AAEAAE5"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krQ4GnJSmroQ7kNvwHM3BgM&_nc_oc=Adr3CfMV_J7bLTHKrRnhnwqe2RzAuxxrVL9-bdeEOyTzTj40uiyXBRQF_HaKbaiPo7Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhy0GOC7LFPdyJwwCRvywTnD9cHq0pkwfPd18stZUL4w&oe=6AAE91EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nu
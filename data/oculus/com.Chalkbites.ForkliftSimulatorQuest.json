13692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1H3_bRbZK1sQ7kNvwEUAQFh&_nc_oc=AdpzYO8j7l12tIbkgWqW-QJty4eRTNSe-RomTbs_5BemBrc1aUGrGVA--80zhpM0-gw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwcS5yMNusqozUgDbSb-2z0NUsm51nSExORPlozBGW3kA&oe=69C3EAF0"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mrz52doHhxEQ7kNvwF0nbcU&_nc_oc=AdqfZU63s0o_9_YD4eokH6zoiq8H3_H1xrD2MxT1VDQxzLkZot0ASklsIYLbuLHITHU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM2iz1Pv1Z11JvSzzQ0xgDHDQmdK_TvopmMslSpiz-3g&oe=69C3C7A5"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0FJ7LU2MNwQ7kNvwEyEKK4&_nc_oc=AdrXmj1ZQeLyRRG0Z99MfJ72f9lbiXHT3VZj1nsEw4DqVNjBVPaXgChZkMNY5J9Xnnk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzW8sirwZ0GxYq1F2XsuozXxZPPJLfzFPJCZCDPz8Sz0g&oe=69C3E6EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1299128390588086"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4711996772160047"}]}, "baseline_offer": {"id": "4711996772160047"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1623448980, "status": "PUBLISHED", "id": "4711996772160047"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6336480763067519", "version": "1.0.12"}, "id": "122671859778295", "chan
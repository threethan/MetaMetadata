whfXhWSO8x_8QV3bOfjkzNAU1WOKGvgK8NK8FwFvrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBmRHa5e_OJZUdnuoBbI9jwaseSlmfKS1AzdtpWxfGAw&oe=6A4D0CC3"}, {"file_name": "Screenshot2_Labled.png", "id": "814450532441531", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974530_814450535774864_3105815850517796593_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHFJckGlgkAQ7kNvwGLhGsO&_nc_oc=AdpLwPbufZg9q2IRn7eDX1hKF4EkRM8-iDy17JgKeE42B1RzUk8OKZB9A5dUh4GxP8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTyVYMpaTa5Shmphy_9YSnVrKbbR_IMrUAC5bl3W7xzA&oe=6A4D17C2"}, {"file_name": "Screenshot3_Labled.png", "id": "513692952948015", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_513692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kbeeMt6id30Q7kNvwG6eli0&_nc_oc=Ado4Z6azSTzS84gn7ro1kVB2fMTnKQdyhKcw0QOfPQjbzGjWdFzrECF7mwEBp3wB8kE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgN3uCcx0otYRNywQVPqNNnEFeRQUMLYTbESPBxW0iOA&oe=6A4D06F0"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWNQp_YNMhMQ7kNvwEi3tYg&_nc_oc=AdrXzgXVIv4N4XiM2AsZaCcLZakyzDYGhfDO38dZ4dUWsRL4iO1jeGcW3_51tzjWTZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFhTNL9NJprKiY1-9edQrMlOSbAT0PhnCzCn1n6B2F-w&oe=6A4D1BE5"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPc1VjBj1x8Q7kNvwFMGeRY&_nc_oc=AdofEpQ0bruCN9IdbGATa1BjOCgZ2c97hQ9ySxhJvtXjYVv35myaPIE-5KoAnR8LGOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp4MARPPsg9aJwDp5B0UZPuU8OlQSMhX3L1l41udsGTw&oe=6A4D02EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
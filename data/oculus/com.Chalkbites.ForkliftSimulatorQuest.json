Y5T5iwv_K44pMOIFFZgJY8wAtrkcxHiDn7c4BCxiEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40yWV8DW5kSFjbcZInGH58Y7ckoCh1TyOk0V6RZliKXw&oe=6A0095C3"}, {"file_name": "Screenshot2_Labled.png", "id": "814450532441531", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974530_814450535774864_3105815850517796593_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWy8mPdroukQ7kNvwE96Xxz&_nc_oc=Adrx31aIO7KqE9kh9COLUq9HY33znhaq-pJLhiA_n7AJjhEucEh8roKHNC7-PoPDqr4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lLoKmar7biGv9C2MI4al2p_5HFTGZ47y24TSGyta1jw&oe=6A00A0C2"}, {"file_name": "Screenshot3_Labled.png", "id": "513692952948015", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_513692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnrVkoQHnf0Q7kNvwG7rJGZ&_nc_oc=AdoDS_m8waG3yzogTGh5pGsqEyWyqXCu1kY21WMtyvTu83GNVADDRVJUn4izY-bzpLI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yKP_13uUdj0YAvOsCHtxSywmP6HCBvvCz8Gt8Xh7zNw&oe=6A008FF0"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj0ulGfnLeMQ7kNvwE0Tjui&_nc_oc=AdpWn4bAHK-rhJ-TXKGycwBlwnd3ocBMpMqlgFd7TP4b8YwQNwDWxO1opUfB2CPZuok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RKK_SYdxIe-8p_OWY2QrxolxckkCk1Y92avlCo_AeVQ&oe=6A00A4E5"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x67zj19IklMQ7kNvwEJ-PLn&_nc_oc=AdoIbDS9ZvTIaYapR6MHOeRrXmQLkMIdAeCyXkRem-LKDSRDFNjLMAGF8q-GD9wodiw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T7g1EVIj6hT-h2AmEMoz61Bt_SbBNwltKn79sDI-Now&oe=6A008BEB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
06XGjvaNADFdav1KAuy56s9AjTFs27Lk2KG_8HAIbH1qwErqzE8xC7E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_5uxvuNkkH608WY-OJXmfqxDaIcgSFmSNm6AvI8GZDQ&oe=6A8EBF83"}, {"file_name": "Screenshot2_Labled.png", "id": "814450532441531", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974530_814450535774864_3105815850517796593_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQDp9uoxOqIQ7kNvwFsDxnG&_nc_oc=Adp8UXCycnR_5jl7Gj5HhjwRJ10Nwwjt5WKLUe6ofg_XDxzU8CFcWMu0pw0HolHarMs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3BRaTsrkN_Bg4HjR-s7GgFxCR6kSqbpluDOysH7tTyA&oe=6A8ECA82"}, {"file_name": "Screenshot3_Labled.png", "id": "513692952948015", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974469_513692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pVol3WT694Q7kNvwFrhqlc&_nc_oc=AdrmjiiMh5mZ_1bXPjevQuyMW69TjSA2uwNPMKsroxOp_1oGle5oRi-V9xbC_FKMdLA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGRmsstvYl7EmDt7p2DWICqjpvO0Ujae9dWgTAfzxH3g&oe=6A8EF1F0"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHqpJa72LcAQ7kNvwGoLIZD&_nc_oc=AdooPEvwsv3nEsM3UeZyCkd_C5mv0HRNEZstmbqwWaJraEuBeCelSJLC1APAgJUFm5w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETgu4040qx99vBDs-uc3vl_VwmHUD_659-83l3j88HTw&oe=6A8ECEA5"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jr5-KkSxL0Q7kNvwH9HkTl&_nc_oc=AdrVzC57K6CFD3gNaRvekd-0tP4JDTe8ZXqrNCu7InEB-WF1M6PlOcKyvxFyxxVWk1E&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa9Pdj7mXaTX7GiizVKpj2TaqQ3731RboZ54fUn7Rw1g&oe=6A8EEDEB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphic
=00_Aft5zny-FNSXbYzQRHpEx1jdnxFa6Qiy9VzdTapqo0qybQ&oe=69A2FB43"}, {"file_name": "Screenshot2_Labled.png", "id": "814450532441531", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974530_814450535774864_3105815850517796593_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmfmYc2Wwv4Q7kNvwGS5INU&_nc_oc=AdkGpLhSULRjtXc5__kzH1Fbn_vl28ceUKOER9o_qfowTarl-xaG_EyPjV84a2oZqb8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrSR7jBoj9PXkvBUxMRkdO82lG3K-TGzbpak7TK3T7Lw&oe=69A2CE02"}, {"file_name": "Screenshot3_Labled.png", "id": "513692952948015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_513692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq65aaqgN-UQ7kNvwH9iQKn&_nc_oc=Adke66eB81Z0qouUxwy6ynCjmk-ZOSFqFwlfZKLztujjPlf_83KQiUgCcKAoHv1Oh_M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvpu_5I1_WI5WW3myOj1_Dn_UQzfNjzSCy-EqrW95AoLA&oe=69A2F570"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m465dlRZaNUQ7kNvwHTdlLV&_nc_oc=AdnT5eQ0KLDksEBRguu-sP4gip3jkcBz2RHuc7ikrYTpaH5kXw25JlaYAYArFBkI_a4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs0j-cKLjwKDZuqHZCzvXmgHp8_BGRy66QeV7RGtaTYiw&oe=69A2D225"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DeJmQ5gt7A4Q7kNvwGsyYYz&_nc_oc=AdlZ4Z0kX1vDe8-WimY5vlRd75bjdRqrXUeYychsCi0xedCSCiUBeqAR-NW2zAsdYvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvzoHfddXGQ64c_4wXKo4Y3UI3yl2cOTLo-mO9ivqldZg&oe=69A2F16B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_m
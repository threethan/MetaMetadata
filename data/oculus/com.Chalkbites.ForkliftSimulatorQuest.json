0EM9rlHk8Qkusd5km-CZFN5NiaLucGmZ5lmRlTnV0Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfFJeQAf_nR3wwNm5ITlHMrjarOeVJ7M7_OmRSADlwUA&oe=6AA16CC3"}, {"file_name": "Screenshot2_Labled.png", "id": "814450532441531", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974530_814450535774864_3105815850517796593_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-qkoVSI3GUQ7kNvwE7FE5y&_nc_oc=AdowmJuugU7OpGiRNMEge4DmsjkwQMdxldNPxLNhdC9FnsRqZR3arlqmM7LtDkUWiIE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoUefrvSmtJxtff40WcAH_MYIeb-qctVrHuC2pfZPmHA&oe=6AA177C2"}, {"file_name": "Screenshot3_Labled.png", "id": "513692952948015", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974469_513692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPu6ePxWuRQQ7kNvwFa1fvv&_nc_oc=AdrP9NXVrs1EAgPaBFM6aTU9QSwy5NTPNv2nkTwtBxKdYrtuYpBnAcy6yG3ORuLXN0Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_aKXBHi4Cxy0BaKJQUomhzOODGBuh90R02vqCY9J3_A&oe=6AA166F0"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9cEQfMb1EIQ7kNvwFfUW-o&_nc_oc=Adox3BJQ7OvhxwiepxYxM9VxsD-E9dwgcyFT30ubO3R7i45QCey8hPU9ht8gCFNrzF4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkB3jllJrwRm9dqCry_1vNRg0ADV08GXn9cqQQiI__Ng&oe=6AA17BE5"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRtfund8bpYQ7kNvwEd0ujU&_nc_oc=Adpjr6butt0EtnlZUmTmZCDl17Gx-g66dT7xlqUI14SkAPyqsvxVAiD4on5kX-iHl-A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2MlPKTfAQ7QWjJC67vrY5_zb_b4Y1ikIiKZCHF7hjjw&oe=6AA162EB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
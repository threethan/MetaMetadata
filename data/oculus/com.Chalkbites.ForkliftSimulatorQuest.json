eNP6R3ohz8e5guGthOQ8V_LaFSVggEcTJ7mnOW2NWA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv6y5qptnoTy0f8fpFB8CcZ4R48adfoEnsQ_bBEhrOtw&oe=6A491843"}, {"file_name": "Screenshot2_Labled.png", "id": "814450532441531", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974530_814450535774864_3105815850517796593_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMPOhVNJ18YQ7kNvwFtqFQB&_nc_oc=AdquDu0cwUcW_n1IUvAFKWDVUvA79QtjerFJqc5hwYBF9xHoDjGL1rwbqBdfXNXN8Sg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSKfw_N7_pYHXLHgF5z6HLwQ1LfXbLypZ_RTbdNkNCUA&oe=6A492342"}, {"file_name": "Screenshot3_Labled.png", "id": "513692952948015", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974469_513692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dV8uD1ZqTmAQ7kNvwH55DzF&_nc_oc=AdqrKMj75AwUqUQiNqljx7_nP8N8FGwO67gu1H-Q5_T7gcRkBn5B5N0cbqHdM9H7bMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwEHYUTgqkD8XeyWmJG1O8nuMXsVQyKU14cRG3x5mqZg&oe=6A491270"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZQeWu03pjAQ7kNvwHsH1aG&_nc_oc=AdqkuGQpkDPumwl77r0tY7WjPn-z2JWQPruM1Zz4W9bQXXGsh-BzYPlNQgUYmO99uQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDy95_IjFn-qe5FrWk7eRmLpyF25eUyNh74o-apS-tDw&oe=6A492765"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2sWch4Wt0gQ7kNvwELfzYd&_nc_oc=AdpiEV3JarZgI4s2V18KThzyePcJt3RdKr9wnfnmGFcywJRTORNP1gCJjyq0LOsD-f0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKOJIh3kYhP_CVWeP9HqQ_a2Vh5fPWkQTfW_84JRIi-g&oe=6A490E6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
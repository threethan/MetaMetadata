o__NjZOpxKXz6GTH3GD3vuE4IuP_oaFON1KK7oe5NY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxz1YUuM2hCovEsIF0rjqDTWe5OcLWHMcZ-WjTJLHz4kw&oe=69C7E543"}, {"file_name": "Screenshot2_Labled.png", "id": "814450532441531", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974530_814450535774864_3105815850517796593_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MZ4CZFCWQMQ7kNvwF00Uop&_nc_oc=AdoywPXD8EPs9r3AUh93Rtb4klw1mg7hQbsPobQ1udoItMJTE5szuBsvWSPIrp1dFWg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQL7E2hQMfy8VPWii79CPxQpKbPIk8t7iw19Wrw1Jq1Q&oe=69C7B802"}, {"file_name": "Screenshot3_Labled.png", "id": "513692952948015", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974469_513692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ctOEtaZLCTwQ7kNvwGUe_Ee&_nc_oc=AdpK-QxfSlYKtkccrP4Y3xQJtoUUM0W0YmxfUP3vx51kjHNDS2LHKWPswxep2z0bxgU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqDLnAqXXcQZ4hqFzPhrtRMsoa1yM4QgCYlP4PfdigAg&oe=69C7DF70"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FGhR_Tr1GAQ7kNvwHsCQ8W&_nc_oc=AdpSF9YdshzawQuT_bqI4G_AO2ea-sWVG-qjU2qTDxoczOu3ITp1-7TiuWIXrn5_PAI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzW3OZFdt-bKylGtP6D3UyYurt0-IENv1ohns0oe2RygA&oe=69C7BC25"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17IAOq_uIugQ7kNvwFskhxk&_nc_oc=AdpsBLBEg1ilHfJiz6oJvFXpGkOARDuuJPpHpdEFmJWlvjw_IJ4ak_Dg30lcnLdmxhI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwWpxppA8Ym9ZK9gJZM2S2HWFmQe-te7KOuhC613z9sqw&oe=69C7DB6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recomme
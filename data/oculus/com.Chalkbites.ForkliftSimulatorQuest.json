13692956281348_5612835062481053040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBkJ5cpcyu4Q7kNvwEeMTg-&_nc_oc=AdrbYSCcAuwoFQH4CoISoLkm0vOqpLRfHm7QFAefQiE4oXrEK89zHyjRKZdcx8zlTik&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAWti2A1miBgyUcg1TCzpg18YyH75EYXj_BoAdgNy5gQ&oe=6A9ACF70"}, {"file_name": "Screenshot4_Labled.png", "id": "253993242921577", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974466_253993246254910_7581663587852564141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzy2q3MdJuIQ7kNvwFk5Ovr&_nc_oc=AdrXyQTcfuliOyJpirwfbgAEam239n26nDPpYvwtUQdcoRSTK_TpztNhrOy4KGpHPX8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1Kn7pXtzdqQskVpIEJ_qkM-9ys-5_7hLrkcOxKnn2pA&oe=6A9AE465"}, {"file_name": "Screenshot5_Labled.png", "id": "3077592172468912", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75451791_3077592175802245_7989182641424166609_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hb4yIrf5MLkQ7kNvwGCA4jw&_nc_oc=Adq1yHe2WoBiORR4wkmagKTAtaoZtm2WxgrsKCyzn9hgvwqpQdtBlSGYONJBBRJVff8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTJV1q0P1bjIlpVXSwkuUwg_UHqDu_GgwbTna-uS0Pvw&oe=6A9ACB6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Enterprise Forklift OSHA Training Simulator", "keywords": [], "long_description": "Learn to drive a forklift in VR. Prepare yourself for a forklift certification exam. A certificate indicates that you have been trained and evaluated to operate a fork truck safely. OSHA requires that employees who regularly operate forklift machinery be certified to do so. Tailored to meet OSHA safety standards, our simulator will help prepare you for your forklift certification today!\n\nThe Enterprise Forklift OSHA Training Simulator includes the following exercises:\n\u2022 Checklists: Perform pre-operational and operational forklift inspections.\n\u2022 Operate: Practice driving forward and in reverse. Learn how to accurately turn and position the vehicle.\n\u2022 Loading: Train to properly lift and move materials around a warehouse environment.\n\u2022 Unloading: Learn best practices for lowering and dropping off packages safely.\n\u2022 Explore: Review a 3D model of a forklift and learn about each component in detail.\n\u2022 Quiz: Take a quiz and put your forklift knowledge to the test.", "short_description": "Everything you need to pass a forklift certification, all in one place. Train to properly operate a forklift in a warehouse environment!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chalkbites.com/index.php/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ChalkBites, Inc.", "support_website_url": null, "website_url": "https://www.chalkbites.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "PRODUCTIVITY", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1299128390588086"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6336480763067519", "version": "1.0.12"}, "id": "122671859778295", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBi
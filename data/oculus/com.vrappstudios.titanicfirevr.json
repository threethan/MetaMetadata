=HWlcZvwqGUQQ7kNvwE_zy3K&_nc_oc=AdrzM-ZxPKy-9TEOAYnpSggUKKvxYqpenti5Vmx5xurUljfeHPegacne_o-wD_GQi_k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbepoRFQXSRzNcnsydemytG0f-jeps0xRaBHUE6fz6vQ&oe=6A5F63F7"}, {"file_name": "migrated_image.png", "id": "1455579301263684", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162682_361171721002884_3888747764430929920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrsboac_a2IQ7kNvwEQwJvH&_nc_oc=AdpzRffuZTLcoDXjah2S2UqDL6CvvGK6QtWGF40nn0sKivzwwrP56UdzcpLDlNp7FaI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoVWa9Lw5b_5hFtKGX7JOLdoD4lo9oomKE8aooMzNy4g&oe=6A5F857D"}, {"file_name": "migrated_image.png", "id": "1104802783201392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_495909240771767_5078010005236482048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGGsYSng2K8Q7kNvwHqhhDr&_nc_oc=AdqG-rWgmHwKGTOHEKOSi7_mdVZntsMuKEWRCnqrkTuXD8chm9dHsR-RkMF59pGVtbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh0GkfoOck15SnphG5TqLbKVeH6Ej83_7qePWbHe22kQ&oe=6A5F66F8"}, {"file_name": "migrated_image.png", "id": "671852696907459", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_1471153316334057_6433594180269768704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQwXu3LEiPQQ7kNvwH9s0ED&_nc_oc=Adqqo7VPZE4Z08R2Wp_aioA7d4vR3iBZHFvhdUJLGQYvpKWXemDFfZozrTpaqPnQl1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSl1SJzS78085IX6RaJAyUsb0502bj2l65g25eP_l_fw&oe=6A5F79DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1733302556979238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_1733302560312571_2987739616586498048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Izzwn5rb3IQ7kNvwFCcrTR&_nc_oc=AdqKodtJ4RJOiDTrC6CMAtbOsdiKPW5IlSaSh7zxJ0cexni4kU42KqvKclO5aMGHf-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK10ExCwGglV7usX9KKu71UWhguo46HT1U8PRbgfOerw&oe=6A5F89A6"}, "display_name": "Secret Fire on the Titanic", "keywords": ["Titanic", "fire", "ship", "ocean", "historical"], "long_description": "When the great ship Titanic left on its maiden voyage in April 1912, the passengers and crew were excited to be on the huge, luxurious steamship, promoted as \"unsinkable.\"   But there was a secret being hidden from the passengers... a raging fire going for days before the passengers even boarded.  Explore the ship in virtual reality, find your way down to the engine and boiler rooms, and investigate it for yourself.  Did the fire weaken the hull?  Why were they in such a hurry?  Based on historical testimony from the crew, and other evidence.\n\nThis is the release of the full version for the Oculus Go.  Oculus doesn't support Gear VR updates anymore.", "short_description": "When the Titanic left on its maiden voyage in 1912, the ship was said to be unsinkable.   But there was a secret being hidden from the passengers..."}]}, "developer_name": "VRAppStudios.com", "developer_privacy_policy_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "developer_terms_of_service_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "publisher_name": "VRAppStudios", "support_website_url": null, "website_url": "http://www.vrappstudios.com/TitanicFireVR/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4368216515
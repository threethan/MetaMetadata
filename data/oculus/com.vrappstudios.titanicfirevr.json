=StpsSv2GVY0Q7kNvwH_oNnT&_nc_oc=AdpjMGcLAUJA58P8fyKctHFsCokcl9PavPepk7DGISauE9-XpRKy8DOWf2XBsvvhUO0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0sBJSuzAEKsWB4JJQ--sWuwP8dpfChLdU6l2kygCuUA&oe=6AA3F1F7"}, {"file_name": "migrated_image.png", "id": "1455579301263684", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162682_361171721002884_3888747764430929920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVaPNxfGC_YQ7kNvwF0TX8Q&_nc_oc=Adq-QWIV006uLfxv1CEq44NH_N3VspHcB_jAyW98ImHPcqSxzkIEN50FaV8luiOxbo0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4YKAoIxYtKUG8yMhbmDZPb8msQ2Tys2Nes9vnm3bDbA&oe=6AA4137D"}, {"file_name": "migrated_image.png", "id": "1104802783201392", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162682_495909240771767_5078010005236482048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74tkbrcSE0EQ7kNvwGHoUn3&_nc_oc=AdpZTCs_XFz9Ltvz0YwdGV-c4sEBTPyeUe9V4HD61_f9dnvLAfizmvhKI8eTZ9zhlwk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJncSfJAn9b8S6Pw9VZMRbNMlflnHYSyS9TjOJ57CdQcQ&oe=6AA3F4F8"}, {"file_name": "migrated_image.png", "id": "671852696907459", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162703_1471153316334057_6433594180269768704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUYNAn9Egk0Q7kNvwH-XHPa&_nc_oc=AdowFfbQrxiHeDSBpKDtH7k5k5uUrH31afkfYYRNkfBgbtizYsq_VC1RqbMLVdHZ6Us&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKG7UGHJoWXY0CG-cH-Rf_13bjeJ7L0V3AmEW5bUfBFUQ&oe=6AA407DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1733302556979238", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162687_1733302560312571_2987739616586498048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ-bF1TnQwEQ7kNvwEF3VSv&_nc_oc=Adp7RemCfPnlU-S9HXWxuR44hnDj-RVRa9T33Wze157RQD-xje5KciNl2EqnyfSTF50&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm0AnDUCKx-b3o7WskdCDulossc9YV90ej8hpZyLPZ6w&oe=6AA417A6"}, "display_name": "Secret Fire on the Titanic", "keywords": ["Titanic", "fire", "ship", "ocean", "historical"], "long_description": "When the great ship Titanic left on its maiden voyage in April 1912, the passengers and crew were excited to be on the huge, luxurious steamship, promoted as \"unsinkable.\"   But there was a secret being hidden from the passengers... a raging fire going for days before the passengers even boarded.  Explore the ship in virtual reality, find your way down to the engine and boiler rooms, and investigate it for yourself.  Did the fire weaken the hull?  Why were they in such a hurry?  Based on historical testimony from the crew, and other evidence.\n\nThis is the release of the full version for the Oculus Go.  Oculus doesn't support Gear VR updates anymore.", "short_description": "When the Titanic left on its maiden voyage in 1912, the ship was said to be unsinkable.   But there was a secret being hidden from the passengers..."}]}, "developer_name": "VRAppStudios.com", "developer_privacy_policy_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "developer_terms_of_service_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "publisher_name": "VRAppStudios", "support_website_url": null, "website_url": "http://www.vrappstudios.com/TitanicFireVR/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "436821
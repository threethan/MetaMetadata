=po_7F1JM3OoQ7kNvwFW3lS_&_nc_oc=AdoluTE33EZ1-UUIROlhy6DoaWeLPik0QiAtge5R7Nspaf1rMGxVO9DZeK4SV9c2hWw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Cei_R9sd4p0DGxtNicS9VnnNP0RkkIgjZGoYFO1rugg&oe=69E619F7"}, {"file_name": "migrated_image.png", "id": "1455579301263684", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162682_361171721002884_3888747764430929920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=myLxHF2P3K8Q7kNvwGQSRej&_nc_oc=AdoUqdfHrI-16g956uNxoGCuYE7C24IFz2O3Os312clq6TjktJPDr14NeXETWUgw97k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af261d575gAhgNip_Tk1pbB-2lRCdhkuyM5CHwbUJ7wqgg&oe=69E63B7D"}, {"file_name": "migrated_image.png", "id": "1104802783201392", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162682_495909240771767_5078010005236482048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFqNM1jcQsYQ7kNvwEcLZq5&_nc_oc=Adp-OquB7Xp-nSrF9QWfD8AZ3XaXDOQtPbvMeT6O66mGnBsob8IekHHUiR1nYMzr6CM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QE1jGru8Wb3j8kSKraSYODCIA1PBqEGMVUhV6yVCkpw&oe=69E61CF8"}, {"file_name": "migrated_image.png", "id": "671852696907459", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162703_1471153316334057_6433594180269768704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZWZva41tB8Q7kNvwHfBS70&_nc_oc=Adp3oYF3SN_37QNm78hUf_WZd5bhEjkU4m-S6Dmo0HEmTSzY6UrSrVci-ZmyTpFHurs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VvHdj1vu-MX54WtvowAdlegKISK8xYjqVwYum3lx_iw&oe=69E62FDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1733302556979238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162687_1733302560312571_2987739616586498048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B58yGas6yw8Q7kNvwFohB7X&_nc_oc=AdqmXjsNt2CZTflVhVOXOJBOyZiJAmDuRRHCnh2dIHW-cUykKpH89_PrYBd0DgZMb1E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZVKy-zFNkXgz5RpbEUHiPtti9dDebW-0sKfCy1nZ6Mg&oe=69E63FA6"}, "display_name": "Secret Fire on the Titanic", "keywords": ["Titanic", "fire", "ship", "ocean", "historical"], "long_description": "When the great ship Titanic left on its maiden voyage in April 1912, the passengers and crew were excited to be on the huge, luxurious steamship, promoted as \"unsinkable.\"   But there was a secret being hidden from the passengers... a raging fire going for days before the passengers even boarded.  Explore the ship in virtual reality, find your way down to the engine and boiler rooms, and investigate it for yourself.  Did the fire weaken the hull?  Why were they in such a hurry?  Based on historical testimony from the crew, and other evidence.\n\nThis is the release of the full version for the Oculus Go.  Oculus doesn't support Gear VR updates anymore.", "short_description": "When the Titanic left on its maiden voyage in 1912, the ship was said to be unsinkable.   But there was a secret being hidden from the passengers..."}]}, "developer_name": "VRAppStudios.com", "developer_privacy_policy_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "developer_terms_of_service_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "publisher_name": "VRAppStudios", "support_website_url": null, "website_url": "http://www.vrappstudios.com/TitanicFireVR/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4368216515
=Txqz5cSvngMQ7kNvwF3pg1T&_nc_oc=AdrVnh5NJmmaJP3kafSkdyRElVZI6aft2a5wCs-SERXup44aYpvgtRv882x4kV0lljY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZOnI8DWSIibGKOr9AEMQKoOs-mXcmWNzWZqag6Tn3hA&oe=69EB5FF7"}, {"file_name": "migrated_image.png", "id": "1455579301263684", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162682_361171721002884_3888747764430929920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfdyMLjTQ-AQ7kNvwHgIxzO&_nc_oc=AdqJ0vVnovd2Uz_We_3hamYWkWcDC-GgxB3a2vypVEsuaE8EtIMR-9zjsLUyS1hLhvo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tR9ls9OWcUR_gfNodSEhQSholhPEgY9JuhMahXS73Yg&oe=69EB817D"}, {"file_name": "migrated_image.png", "id": "1104802783201392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_495909240771767_5078010005236482048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StUDIpEQa7sQ7kNvwHAVzsP&_nc_oc=AdqeIh7yFzQRfbNxu5d2Bo7nRiNFprf170Phol49f10KdxbqyOcpdUAJPBqNW0bgyac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1G0esBDjrFyc8bsSPbuHwjBxqbIqpelI6Rdf7csAEiZw&oe=69EB62F8"}, {"file_name": "migrated_image.png", "id": "671852696907459", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_1471153316334057_6433594180269768704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5iMCnn43nEQ7kNvwEyxeFx&_nc_oc=AdrTIA0jOTMrLYnnr4vNHXAW70OrENnRBxiN6JVf-FxwdjQKFgY9Yf7rwSdQSh8bqY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mAQuO8ys62HnPswK7WGCFPbG9r1PCvBzTOHw300RwFQ&oe=69EB75DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1733302556979238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_1733302560312571_2987739616586498048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyhxehH_2mYQ7kNvwG2eCP2&_nc_oc=Adqt-43Cql16m7quxfmEmRd4lT6khZzwvlSMv-ab7bkL03TSHkRWC7uKJymRO_xJzhU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YjJcYkc8o1jUH3CQbHM_4-rkJepf8nzzMgg9x7hbj4g&oe=69EB85A6"}, "display_name": "Secret Fire on the Titanic", "keywords": ["Titanic", "fire", "ship", "ocean", "historical"], "long_description": "When the great ship Titanic left on its maiden voyage in April 1912, the passengers and crew were excited to be on the huge, luxurious steamship, promoted as \"unsinkable.\"   But there was a secret being hidden from the passengers... a raging fire going for days before the passengers even boarded.  Explore the ship in virtual reality, find your way down to the engine and boiler rooms, and investigate it for yourself.  Did the fire weaken the hull?  Why were they in such a hurry?  Based on historical testimony from the crew, and other evidence.\n\nThis is the release of the full version for the Oculus Go.  Oculus doesn't support Gear VR updates anymore.", "short_description": "When the Titanic left on its maiden voyage in 1912, the ship was said to be unsinkable.   But there was a secret being hidden from the passengers..."}]}, "developer_name": "VRAppStudios.com", "developer_privacy_policy_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "developer_terms_of_service_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "publisher_name": "VRAppStudios", "support_website_url": null, "website_url": "http://www.vrappstudios.com/TitanicFireVR/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4368216515
05236482048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPsRkmDgyFwQ7kNvwEmskjX&_nc_oc=AdpeXLS6bN3KQUyPLqFOH9esBadB2kIWI8YCDEdf1RlyBiyjPgABvWBJCongEqv00BA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARuhgVY557yWibvyg8bd9NNwQxomVp_ysqKao6AXutqg&oe=6A6DE778"}, {"file_name": "migrated_image.png", "id": "671852696907459", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162703_1471153316334057_6433594180269768704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lk3D5aiee4IQ7kNvwG63LmB&_nc_oc=AdrpNsJXj98bEAw1krrkYl1PDtEmBazRN86macqNsGaGEtevDuN_SJ_RmawK-e5jxmc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDtEHRN1JQjhYEATU6y65EgxaMDkCKEI0S2px3nGQ-Qg&oe=6A6DFA5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1733302556979238", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162687_1733302560312571_2987739616586498048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd2P19LkZzgQ7kNvwEX-Jkd&_nc_oc=Adr0MXToT8NBijHIcRGpCtlzr11QLkyv0l4kBad897HdEWettYExpbpfNni34XxEZ0M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNd0021SY1WIgb0xyP6rw92cfCalYzvBMIpvQyrhz6iQ&oe=6A6E0A26"}, "display_name": "Secret Fire on the Titanic", "keywords": ["Titanic", "fire", "ship", "ocean", "historical"], "long_description": "When the great ship Titanic left on its maiden voyage in April 1912, the passengers and crew were excited to be on the huge, luxurious steamship, promoted as \"unsinkable.\"   But there was a secret being hidden from the passengers... a raging fire going for days before the passengers even boarded.  Explore the ship in virtual reality, find your way down to the engine and boiler rooms, and investigate it for yourself.  Did the fire weaken the hull?  Why were they in such a hurry?  Based on historical testimony from the crew, and other evidence.\n\nEarly access version:  Buy now (while on sale) and you will get the full game as an update, when it is released.", "short_description": "When the Titanic left on its maiden voyage in 1912, the ship was said to be unsinkable.   But there was a secret being hidden from the passengers..."}]}, "developer_name": "VRAppStudios.com", "developer_privacy_policy_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "developer_terms_of_service_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "publisher_name": "VRAppStudios", "support_website_url": null, "website_url": "http://www.vrappstudios.com/TitanicFireVR/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SIMULATION", "EXPLORATION", "CASUAL", "EDUCATIONAL", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "994451541278246"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3514439325343786", "version": "2.0.2"}, "id": "722912974569884", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1452652771522462", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3514439325343786"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "722912974569884"}]}, "change_l
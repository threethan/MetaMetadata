=RESh-3Q7rCUQ7kNvwEGGLDb&_nc_oc=AdpS0iZ1SKmhJrwCPlIBW2MzoldyWvAeor5TR6U_Lwgd4Cbn_D2C1F4cOy4lPZ3CVDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kHWa8FssyMEQDaoYsVV4qVYEW17CsVum-q75RS8tPQQ&oe=6A295677"}, {"file_name": "migrated_image.png", "id": "1455579301263684", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_361171721002884_3888747764430929920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOW7gSIVMmoQ7kNvwE0K4-w&_nc_oc=AdoidmQGVwbilaJfCXNBx1szqW1V7Uj2UlnNYRxecc8WtGVFlzdXSWbbd-iKIKDGxvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RjSAALmqQ3YTAWZ162OZFbnMFHjfl4nwv_Tp7Ema6kQ&oe=6A2977FD"}, {"file_name": "migrated_image.png", "id": "1104802783201392", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_495909240771767_5078010005236482048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8vPbtANmcYQ7kNvwEasAmM&_nc_oc=AdouliPETB5ncVvp7CCkie9tlWXqgCMhakhWv1pBRD8OUMs_psCLFi9dibzMfO7bKGg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af919SLQfzK2c4u7j2OPkbQgOSLNGzVsJpIlFOmdjh5SSA&oe=6A295978"}, {"file_name": "migrated_image.png", "id": "671852696907459", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162703_1471153316334057_6433594180269768704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RaJqv3SYJkQ7kNvwHrb9iy&_nc_oc=AdoVJbuENv9civhO-f3Ni4-6nXtqQCpZfSZl6Nx2165Hz6JDIZ36A80M24FaMw5tJLM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ScrDVaM0GU-2vQC7WRU7-rTfii7vm5tIULE-KI0r_0w&oe=6A296C5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1733302556979238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162687_1733302560312571_2987739616586498048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-cZySmNBC0Q7kNvwHIxEeQ&_nc_oc=Adq-9qCF_IcatptAkbbDsXL_2WsZm71CItArzODD3CPTaV7-Wt506mz9OjpXa2r7_VA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MaPMOs5HUcN6QX7jebC4hy5msLmqnEkDPeLie-IsCHA&oe=6A297C26"}, "display_name": "Secret Fire on the Titanic", "keywords": ["Titanic", "fire", "ship", "ocean", "historical"], "long_description": "When the great ship Titanic left on its maiden voyage in April 1912, the passengers and crew were excited to be on the huge, luxurious steamship, promoted as \"unsinkable.\"   But there was a secret being hidden from the passengers... a raging fire going for days before the passengers even boarded.  Explore the ship in virtual reality, find your way down to the engine and boiler rooms, and investigate it for yourself.  Did the fire weaken the hull?  Why were they in such a hurry?  Based on historical testimony from the crew, and other evidence.\n\nThis is the release of the full version for the Oculus Go.  Oculus doesn't support Gear VR updates anymore.", "short_description": "When the Titanic left on its maiden voyage in 1912, the ship was said to be unsinkable.   But there was a secret being hidden from the passengers..."}]}, "developer_name": "VRAppStudios.com", "developer_privacy_policy_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "developer_terms_of_service_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "publisher_name": "VRAppStudios", "support_website_url": null, "website_url": "http://www.vrappstudios.com/TitanicFireVR/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4368216515
=vR-VEW-6EzQQ7kNvwEzV9p0&_nc_oc=AdoM_zpESD8bydfkAzJ4nFDRVsIaylWVPX84mfrSpqqErWOV3_T22_5HFTE0L5C-LPI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM4kobLrUUm86kUNexqi3ezrUTztHrWPQNyp6EC92NpQ&oe=6A562977"}, {"file_name": "migrated_image.png", "id": "1455579301263684", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162682_361171721002884_3888747764430929920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=km9tkULrp-4Q7kNvwFwndOA&_nc_oc=AdpBTb4PScMUsQq0NEgT2tYIydrleiC0PHhOThUPbAgniN2IS0GLsPV-KwOaxJ9tFlU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpUTm-rBcHHW0pmvlKsYE79biRHsblZn4YZD66N0fdPA&oe=6A564AFD"}, {"file_name": "migrated_image.png", "id": "1104802783201392", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162682_495909240771767_5078010005236482048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYr2pqgp1FoQ7kNvwHDsqhM&_nc_oc=Adrj9L35eGMDTx41PGMuSERNjFrXnz4McEE4LdNNLC5-7lkATHMPgV2berVPlUHKAPk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxlDMiwo8Kh_c9LTk2wQ71Z3PwdQbnbr0WdnAaBI990w&oe=6A562C78"}, {"file_name": "migrated_image.png", "id": "671852696907459", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162703_1471153316334057_6433594180269768704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2TX_Cx0Du9YQ7kNvwFS2wSw&_nc_oc=AdrM5QT7X-uY8hhMrJNvRQ7UPcEPA59L1gVlVpNhDR_19K8_HKCtCUGM9dG9F1htIQ4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbLkq7yLfeLSUvvdvZAacGYgZQc3J7W3f5XDC7SoLjtw&oe=6A563F5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1733302556979238", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162687_1733302560312571_2987739616586498048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3VSkg6NeLMQ7kNvwFCj6X0&_nc_oc=Adretw7HTD-qNH9m_mdmBHdHZ09OlwY_xuij46-8OkVvrOYuVgBDb7oS46kkS-lFGMk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQLi7mhElHyMB-e51vl5R1JPVxtn7MdN7K_weZCcQe9w&oe=6A564F26"}, "display_name": "Secret Fire on the Titanic", "keywords": ["Titanic", "fire", "ship", "ocean", "historical"], "long_description": "When the great ship Titanic left on its maiden voyage in April 1912, the passengers and crew were excited to be on the huge, luxurious steamship, promoted as \"unsinkable.\"   But there was a secret being hidden from the passengers... a raging fire going for days before the passengers even boarded.  Explore the ship in virtual reality, find your way down to the engine and boiler rooms, and investigate it for yourself.  Did the fire weaken the hull?  Why were they in such a hurry?  Based on historical testimony from the crew, and other evidence.\n\nThis is the release of the full version for the Oculus Go.  Oculus doesn't support Gear VR updates anymore.", "short_description": "When the Titanic left on its maiden voyage in 1912, the ship was said to be unsinkable.   But there was a secret being hidden from the passengers..."}]}, "developer_name": "VRAppStudios.com", "developer_privacy_policy_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "developer_terms_of_service_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "publisher_name": "VRAppStudios", "support_website_url": null, "website_url": "http://www.vrappstudios.com/TitanicFireVR/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4368216515
=v9D8u7kjoREQ7kNvwFQgb6U&_nc_oc=AdoctCTJNnX9Kt8CFTlktOQ-RNzgtIOU_n7x_ty7iqsJF7foQnQUgAxHBZRwTKy1LR0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gIFBFi16hiJ69_BEUyR77eLBQWXd7FzbV-qY53DgwNQ&oe=6A36BDB7"}, {"file_name": "migrated_image.png", "id": "1455579301263684", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/11162682_361171721002884_3888747764430929920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vrbCR09uDMYQ7kNvwEEPayC&_nc_oc=AdqexeEmmomIoAwWYCWoaMm6guGev9cr_8zg1fzxwDa743-hJtz3IioaDIL9PnAFkvw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bQLgMsdoZaIHDEIGQ7cGE87Y343HGWWyx0pvgUriOOw&oe=6A36A6FD"}, {"file_name": "migrated_image.png", "id": "1104802783201392", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162682_495909240771767_5078010005236482048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_IIKam7X-8Q7kNvwGifrmj&_nc_oc=AdoT23j7_XoRK4pqPUunwEjPxnGD5TnfRentbnI3mtNCHtuwz2HxzycM-lIoip5mIJg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89hh9jkPWcTrtCrfe4wavbAzrh2Hk-lwHjhloQMfPAFg&oe=6A36C0B8"}, {"file_name": "migrated_image.png", "id": "671852696907459", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/11162703_1471153316334057_6433594180269768704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_lUEuniHT4Q7kNvwFJ2Vev&_nc_oc=AdqgHFyGyXBnYtuphjkT2TXPMgWepND0wwc8BkPCfdVTHT0HDRaaPp_EUGPYfOdQx9k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AVpfZA7qgH5j95IGvEzSoC1pZJU7CV1MzrmX92l7s3A&oe=6A369B5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1733302556979238", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162687_1733302560312571_2987739616586498048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVIGqqsvfkIQ7kNvwH1b3Qa&_nc_oc=Adoyde6nS079NNKMwMvpFKp31-rOewZi1jWFJu0VQ1DpSIoNZvMJFSx35XO2SgXhWdM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I6qgOsSuHYvYyezFLoyMiVADsikGdGWcwKu4jFuHCWA&oe=6A36AB26"}, "display_name": "Secret Fire on the Titanic", "keywords": ["Titanic", "fire", "ship", "ocean", "historical"], "long_description": "When the great ship Titanic left on its maiden voyage in April 1912, the passengers and crew were excited to be on the huge, luxurious steamship, promoted as \"unsinkable.\"   But there was a secret being hidden from the passengers... a raging fire going for days before the passengers even boarded.  Explore the ship in virtual reality, find your way down to the engine and boiler rooms, and investigate it for yourself.  Did the fire weaken the hull?  Why were they in such a hurry?  Based on historical testimony from the crew, and other evidence.\n\nThis is the release of the full version for the Oculus Go.  Oculus doesn't support Gear VR updates anymore.", "short_description": "When the Titanic left on its maiden voyage in 1912, the ship was said to be unsinkable.   But there was a secret being hidden from the passengers..."}]}, "developer_name": "VRAppStudios.com", "developer_privacy_policy_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "developer_terms_of_service_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "publisher_name": "VRAppStudios", "support_website_url": null, "website_url": "http://www.vrappstudios.com/TitanicFireVR/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "436821
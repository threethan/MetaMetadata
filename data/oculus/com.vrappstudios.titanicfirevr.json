=REWRpjjvk9EQ7kNvwGsJIb7&_nc_oc=Adr06i2Wm9OW_22Ki0bmad_yjhLBF-jqllHJlWNn3OZxej3lwZp11Dy9W_vsIi2C-ic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wRnUXG9TA0ZONat48idVuHWYibje1pfFSrsK1f2cxjA&oe=6A070F77"}, {"file_name": "migrated_image.png", "id": "1455579301263684", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_361171721002884_3888747764430929920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItOJQ1zXuBEQ7kNvwEwRJdd&_nc_oc=Adp92RBRzTdJhxcwTRXFfe8eozK16TY6l8KhgTKcAJJem17WijffQWw8NNruwSRIUKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69c-p6Mu-pwUfn22mTBF0d6v7MWJxCJ_RDwMb8ZBHiug&oe=6A0730FD"}, {"file_name": "migrated_image.png", "id": "1104802783201392", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_495909240771767_5078010005236482048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaxbORdKrkcQ7kNvwFLo3xn&_nc_oc=AdoGaFLkGZOdUrL3HV6xZCU--nYSSx4GnOjgmU5AeZ8zjtg1DuPsTebYIb1tgz0YoIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SoXUD4vRcfxknUyMB7Kqa0gUzFvNqDWz84mXHwXcLmA&oe=6A071278"}, {"file_name": "migrated_image.png", "id": "671852696907459", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162703_1471153316334057_6433594180269768704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTSx2slqt7UQ7kNvwHxyCid&_nc_oc=Adq7Zub4KM974mki1f-HsQV9MKHkBiSpNs3yVEoYUzPqcQBA39n1bA3xxQe0RG5TOpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ymE-UBV-r99A-krKQWY6p6Ncq6DZ5FFaUBVjP0DdTxA&oe=6A07255F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1733302556979238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_1733302560312571_2987739616586498048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XG-whWigll8Q7kNvwFx61j-&_nc_oc=Adqew528ZKEjbkJZ2TQbI_yGXa9VTmIRtNm9n1TCFLU7MXOPUHKEWUAPqP0VZHNcJ7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ztE1_0G6L-ZjKJv8ttj_x9uLjqGihbjLd4tQAK66XeQ&oe=6A073526"}, "display_name": "Secret Fire on the Titanic", "keywords": ["Titanic", "fire", "ship", "ocean", "historical"], "long_description": "When the great ship Titanic left on its maiden voyage in April 1912, the passengers and crew were excited to be on the huge, luxurious steamship, promoted as \"unsinkable.\"   But there was a secret being hidden from the passengers... a raging fire going for days before the passengers even boarded.  Explore the ship in virtual reality, find your way down to the engine and boiler rooms, and investigate it for yourself.  Did the fire weaken the hull?  Why were they in such a hurry?  Based on historical testimony from the crew, and other evidence.\n\nThis is the release of the full version for the Oculus Go.  Oculus doesn't support Gear VR updates anymore.", "short_description": "When the Titanic left on its maiden voyage in 1912, the ship was said to be unsinkable.   But there was a secret being hidden from the passengers..."}]}, "developer_name": "VRAppStudios.com", "developer_privacy_policy_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "developer_terms_of_service_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "publisher_name": "VRAppStudios", "support_website_url": null, "website_url": "http://www.vrappstudios.com/TitanicFireVR/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4368216515
=noPVqxddIVcQ7kNvwGNDIx4&_nc_oc=Adrbjlq6wVFTNChq9eGeBX0UmNhz6sOMrdUv4PufKv50TUAbbWzzciyv83-5Yusd1DI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbU2YSsKKcXq3gbCX5l-UkcJe9lguD2S-TnzNJ9h12OA&oe=6A81AAF7"}, {"file_name": "migrated_image.png", "id": "1455579301263684", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162682_361171721002884_3888747764430929920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhRsgpgA3fAQ7kNvwH2yPXf&_nc_oc=Adr368O2GmuOPFkTSLXWkutOLUXYPLEtMwi2rEi7dn_TORaFH1oBnWCMrPkzqZn8nFo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeHFI0SlPnOkK1RTt6Vo0OZKNUrdFS6b_ISl-BSdWDmg&oe=6A81943D"}, {"file_name": "migrated_image.png", "id": "1104802783201392", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162682_495909240771767_5078010005236482048_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Yy5KadRl-QQ7kNvwEOT0qm&_nc_oc=AdqYZtfNWL2HIYMyObSRhrU7ImWW9gXr4H8QXC03KBZuUs0y6gv9qpwW6tQL1dTe4qw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKGouA8BwJkWb_rtHtSD7nWSiTAXbjWqPr_I97xpCaXw&oe=6A81ADF8"}, {"file_name": "migrated_image.png", "id": "671852696907459", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162703_1471153316334057_6433594180269768704_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUJZxhx_xboQ7kNvwFPKxmE&_nc_oc=AdrFjcuS_ycXvWrg3_9IpQOOf93N76Chjw21EfMEJux7q2baNI5J6hewFyYSpTAXv_w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdrg1UGuY73dadZsc2c8575vTMO_3sqHygwds461L0dw&oe=6A81C0DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_thumbnail.png", "id": "1733302556979238", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162687_1733302560312571_2987739616586498048_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0SjICbB-JQQ7kNvwEww1Hy&_nc_oc=AdpP89iOfnVDbQkGOtPFdYN0oaOTw6QIZwjNC5SXUKrwOC8Ehl_0_nHy0rKqimYkhBg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeXiEvH5KMs66OoCwp3abG290YVGK-qRus0pnHqZQteQ&oe=6A819866"}, "display_name": "Secret Fire on the Titanic", "keywords": ["Titanic", "fire", "ship", "ocean", "historical"], "long_description": "When the great ship Titanic left on its maiden voyage in April 1912, the passengers and crew were excited to be on the huge, luxurious steamship, promoted as \"unsinkable.\"   But there was a secret being hidden from the passengers... a raging fire going for days before the passengers even boarded.  Explore the ship in virtual reality, find your way down to the engine and boiler rooms, and investigate it for yourself.  Did the fire weaken the hull?  Why were they in such a hurry?  Based on historical testimony from the crew, and other evidence.\n\nThis is the release of the full version for the Oculus Go.  Oculus doesn't support Gear VR updates anymore.", "short_description": "When the Titanic left on its maiden voyage in 1912, the ship was said to be unsinkable.   But there was a secret being hidden from the passengers..."}]}, "developer_name": "VRAppStudios.com", "developer_privacy_policy_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "developer_terms_of_service_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "publisher_name": "VRAppStudios", "support_website_url": null, "website_url": "http://www.vrappstudios.com/TitanicFireVR/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4368216515
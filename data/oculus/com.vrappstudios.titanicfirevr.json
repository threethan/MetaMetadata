ent-iad6-1.oculuscdn.com/v/t64.5771-25/11162687_1733302560312571_2987739616586498048_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyR4xjgKwlAQ7kNvwH9S9fV&_nc_oc=Adp7NPTBv_vN0DTDXaEXzO80_kDLhFfaLv-IPPnpZzccDzcg_Y5VVXeRm0qPN-E9-nA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSCd0XkAPgWOXuleCSIQCnaDt6-zPfhJmJUKCLTqt_rQ&oe=6B01EA66"}, "display_name": "Secret Fire on the Titanic", "keywords": ["Titanic", "fire", "ship", "ocean", "historical"], "long_description": "When the great ship Titanic left on its maiden voyage in April 1912, the passengers and crew were excited to be on the huge, luxurious steamship, promoted as \"unsinkable.\"   But there was a secret being hidden from the passengers... a raging fire going for days before the passengers even boarded.  Explore the ship in virtual reality, find your way down to the engine and boiler rooms, and investigate it for yourself.  Did the fire weaken the hull?  Why were they in such a hurry?  Based on historical testimony from the crew, and other evidence.\n\nThis is the release of the full version for the Oculus Go.  Oculus doesn't support Gear VR updates anymore.", "short_description": "When the Titanic left on its maiden voyage in 1912, the ship was said to be unsinkable.   But there was a secret being hidden from the passengers..."}]}, "developer_name": "VRAppStudios.com", "developer_privacy_policy_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "developer_terms_of_service_url": "http://www.vrappstudios.com/TitanicFireVR/#privacy", "publisher_name": "VRAppStudios", "support_website_url": null, "website_url": "http://www.vrappstudios.com/TitanicFireVR/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_a
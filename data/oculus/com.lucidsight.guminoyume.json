c_ohc=hkDGdR85LzEQ7kNvwF7xhH5&_nc_oc=AdqbVTELIaM1AtgeqZ2xLulAQsJZbYdfBPiQvABuv_uubiqlpqXL3AZzQp0ajHeWgEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxE2SbD1RsqEWYZr741_vhnjkY3pf1YqLivfRnaXejWRw&oe=69CE4C90"}, {"file_name": "migrated_image.png", "id": "3334266546713427", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138840_1711986285738652_1233354075_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWk_QY7yxugQ7kNvwFQFq3d&_nc_oc=AdoQZhhog4y4Lfhf9IUwmblBBhCpnJ5fTTSOFBW28QCTT8uALXKiC6jk3ODzq9ZPucs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5oYwtyQklLMTOTLscxb6_Vu_1K-DcBHHQ8R_9dDVUCw&oe=69CE4E16"}, {"file_name": "migrated_image.png", "id": "2797450333653667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162745_465791353616207_1881168938_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9lVl3zDY28Q7kNvwFvTzyn&_nc_oc=Adq0xSbOAsWsUQRmWcXvN7cnNDSW-l_c-ONTwAqMuIXwVjNVd3d9sg4QTTyWAYh0aB4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzP3tpkuN-VFrNc_COiVBV1gqo4T7RRDN7N1mImsjvMYQ&oe=69CE6514"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gumi no Yume", "keywords": ["puzzle", "classic", "gummy", "candy", "Sokoban"], "long_description": "Immerse yourself in Gumi no Yume, a virtual dreamworld where you can help Kon-kon and his friends navigate through puzzles full of fluffy marshmallows, jiggly gummies, and much more. It\u2019s a super kawaii candy adventure that brings a new twist to an old puzzle classic.\n\nUse your puzzle-solving power to bump colorful gummies around the game board and win your way through a 3D world inspired by the popular classic, Sokoban. Can you solve the puzzle before you run out of moves? Will Kon-kon ever get to eat all of the yummy candy he collects? The world may never know\u2026but you will if you play Gumi no Yumi!\n\nFeatures:\n-Many puzzling levels to play, with more added all the time\n-A colorful VR adventure sure to please anyone\u2019s sweet tooth\n-Charming friends like Kon-kon the Red Panda to meet along the way\n-Adorable music you can\u2019t help but dance to\n-Easy to learn, fun to play, a challenge to master\n\n(Kon-kon\u2014Nickname for Konpeito, also\u2026What the fox says in Japanese!!)", "short_description": "Immerse yourself in Gumi no Yume, a virtual dreamworld where you can help Kon-kon and his friends navigate through puzzles full of fluffy marshmallows, jiggly gummies, and much more. It\u2019s a super kawaii candy adventure that brings a new twist to an old puzzle classic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/7759324", "developer_terms_of_service_url": "http://www.lucidsight.com/tos.html", "publisher_name": "Lucid Sight, Inc.", "support_website_url": null, "website_url": "http://www.lucidsight.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ARCADE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "482003750172164"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1706603966272041"}, {"status": "PUBLISHED", "id": "1163445220429833"}]}, "baseline_offer": {"id": "1706603966272041"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1458111600, "status": "PUBLISHED", "id": "1706603966272041"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1284112374999148", "version": "1.1"}, "id": "767329063398487", "channel_n
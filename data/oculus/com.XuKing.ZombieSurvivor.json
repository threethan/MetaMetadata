, "ZS"], "long_description": "Zombie Survivor is a roguelite zombie survival game based on Mixed Reality. Players need to avoid the pursuit of zombies, rescue other survivors in the city and form a survival team.\n\nGame Features: \nSupport Mixed Reality desktop game mode, immersive control of survivors to escape, while avoiding 3D vertigo.\n\nGameplay:\nAfter killing zombies, players can get crystals for upgrades, and can choose any reward for each upgrade. After the level is completed, game coins will be awarded for players to strengthen their combat capabilities.", "short_description": "Zombie Survivor is a roguelite zombie survival game based on Mixed Reality. Players need to avoid the pursuit of zombies, rescue other survivors in the city and form a survival team.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://zs.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://zs.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24322246417466272"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974649_561486823457963_3197585628734881848_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&
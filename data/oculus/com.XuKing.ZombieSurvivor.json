rd for each upgrade. After the level is completed, game coins will be awarded for players to strengthen their combat capabilities.", "short_description": "Zombie Survivor is a roguelite zombie survival game based on Mixed Reality. Players need to avoid the pursuit of zombies, rescue other survivors in the city and form a survival team.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://zs.xuking.tech/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialXR", "support_website_url": null, "website_url": "https://zs.xuking.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24322246417466272"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974649_561486823457963_3197585628734881848_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZJbcLDEZ34Q7kNvwF-l2hL&_nc_oc=Ado_qZOe-UR4uDO4P_BLd7LjH9gA9OE9oQ0LHUwMjZ35TOT8H82ujTiVdJFvyjzDx6Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14FlrnhC74ARzhoFiM0OaDc_--cb9kp0yGCc0uzuuOeg&oe=69F1FEC3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zombie Survivor", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_
ent-ord5-2.oculuscdn.com/v/t64.5771-25/499628050_2842054882838007_1207555051739959634_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yc4s8AiODu4Q7kNvwFeX5TS&_nc_oc=Adp_aDA4o_IaJEiBADsG1EfRuyouUA1CV3MGmU-VE_NzWcGyZaNj3eAey85PUw-S7_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlKjn64L6M0uJhPLRwNfjXvQ7ifNfD-LG-wowoyzb5ZA&oe=6AB3E6EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "won.PNG", "id": "1610503917389722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593839439_1610503920723055_8113868596814087671_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soqc2Qz0nDQQ7kNvwFv4EfM&_nc_oc=AdpsNOeviaLohplOWPkmXTaYSkQpxZ48rVQF6ioYQ2FGlmgXgz_jbA1KTGsr2VmCSPQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILTicq-Y0fC7OzP2H3topl_kYRAh5BOpMiQd-AvCwthw&oe=6AB3C9C3"}, "display_name": "Project S", "keywords": ["RTS", "Strategy", "Tabletop", "Battle", "Robots"], "long_description": "**Project S V2 is here.**\n\nClassic RTS. Rebuilt for VR. Now bigger, smoother, and more immersive.\n\n**Project S has been extensively reworked with new animations, an improved animation system, redesigned menus, fully refreshed French and English voices, rebuilt maps, and upgraded VR explosions and spatial effects.**\n\nAnd now, **Multiplayer is available.**\n\nCommand your army from above a living tabletop battlefield. Capture factories, build robotic units, steal powerful vehicles, expand your territory, and destroy the enemy base before they destroy yours.\n\n{1593671992120931}\n\n**Unlock and command more than 10 different units and vehicles, each offering new tactical possibilities.**\n\n**Explore 2 unique planets across 8 levels, now redesigned for better readability, stronger combat flow, and more exciting battles in VR.**\n\nThis isn\u2019t just an RTS viewed through a headset  you are standing over the battlefield.\n\nWatch your robots move, fight, capture, survive, and explode right in front of you.\n\n**Build. Capture. Expand. Attack. Conquer.**\n\nProject S is created by a passionate solo developer using modern development.\n\n**More planets are planned as FREE DLC.**\n\n**Take command. Challenge another player. Own the battlefield.**", "short_description": "Project S V2 is here.\n\nClassic 90s RTS action, rebuilt for VR with new animations, redesigned maps, improved menus, refreshed FR/EN voices, upgraded explosions and better VR effects.\n\nAnd now, Multiplayer is available.\n\nCapture factories, build your robot army, deploy powerful vehicles, expand your territory and crush the enemy.\n\n2 planets. 8 levels. 10+ units and vehicles.\nfree planets DLC very soon\n\nBuild. Capture. Conquer."}, {"images": {"nodes": []}, "id": "1081374137972217", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project S", "keywords": ["RTS", "Strategie", "Combat", "Fight"], "long_description": "**Project S V2 est l\u00e0.**\n\n**Le RTS classique. R\u00e9invent\u00e9 pour la VR.**\n\nProject S est un jeu de strat\u00e9gie en temps r\u00e9el en VR, rapide et explosif, inspir\u00e9 par les grands RTS des ann\u00e9es 90 enti\u00e8rement repens\u00e9 pour Meta Quest.\n\n**Cette V2 apporte de nouvelles animations, un syst\u00e8me d\u2019animation am\u00e9lior\u00e9, des menus refaits, des voix FR/EN retravaill\u00e9es, des maps recr\u00e9\u00e9es et de nouveaux effets d\u2019explosions et spatiaux en VR.**\n\nEt maintenant, le **multijoueur est disponible.**\n\nCommandez votre arm\u00e9e depuis les hauteurs d\u2019un champ de bataille miniature vivant. Capturez des usines, produisez des robots, volez de puissants v\u00e9hicules, \u00e9tendez votre territoire et d\u00e9truisez la base ennemie avant qu\u2019elle ne d\u00e9truise la v\u00f4tre.\n\n{1490733139737836}\n\n**Explorez 2 plan\u00e8tes et 8 niveaux, et d\u00e9bloquez plus de 10 unit\u00e9s et v\u00e9hicules pour d\u00e9velopper de nouvelles strat\u00e9gies.**\n\nFacile \u00e0 prendre en main mais difficile \u00e0 ma\u00eetriser, chaque bataille r\u00e9compense les d\u00e9cisions rapides, le positionnement et le contr\u00f4le tactique.\n\n**Ce n\u2019est pas simplement un RTS dans un casque  vous dominez r\u00e9ellement le champ de bataille. Regardez vos robots avancer, combattre, capturer et exploser juste devant vous.**\n\n**Construisez. Capturez. \u00c9tendez-vous. Attaquez. Conqu\u00e9rez.**\n\nCr\u00e9\u00e9 par un d\u00e9veloppeur solo passionn\u00e9 avec l\u2019aide d\u2019outils modernes.\n\nDe nouvelles plan\u00e8tes arriveront en **DLC GRATUITS.**\n\nPrenez le commandement. \n**Affrontez un autre joueur. Dominez le champ de bataille.**", "short_description": "Project S V2 est l\u00e0.\n\nLe RTS des ann\u00e9es 90, repens\u00e9 pour la VR avec de nouvelles animations, des maps retravaill\u00e9es, des menus am\u00e9lior\u00e9s, des voix FR/EN refaites et de meilleurs effets VR.\n\nEt maintenant, le multijoueur est disponible.\n\nCapturez des usines, construisez votre arm\u00e9e robotique, utilisez de puissants v\u00e9hicules et \u00e9crasez l\u2019ennemi.\n\n2 plan\u00e8tes. 8 niveaux. Plus de 10 unit\u00e9s et v\u00e9hicules.\n\nConstruisez. Capturez. Conqu\u00e9rez."}]}, "developer_name": "Stephane Quillet", "developer_privacy_policy_url": "https://projectsvr.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XFX", "support_website_url": null, "website_url": "https://projectsvr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_in
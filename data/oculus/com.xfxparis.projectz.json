 {"file_name": "CaptureC.png", "id": "1725603555401643", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593878539_1725603558734976_2284037645436578568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlypaDTs_rUQ7kNvwEOc-7D&_nc_oc=AdqumhHeT6wwD9ZAONkdR-tK3feyfsKnCuy1Ibn8mExtu7kh0-YwRDCxjbQnKAGSdSA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfgtRPdqA6YA3iKvaYu8aiPCeLRhVk9uKmtQFVSQtgBA&oe=6AC647E9"}, {"file_name": "CaptureD.png", "id": "1062070169797919", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628411_1062070173131252_5639194320740018666_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSAnLiYUk8AQ7kNvwHyrQSx&_nc_oc=AdoS_idjO5xPE64hN7-nQ1AEe-preINWu19MNgmGHKi7Nta_jaC8DIb7XfscmmUK_mY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjTTa3BDqRxgB_fNXz_I9HYV18CfdIIxV-9hi3Dc5fUg&oe=6AC66015"}, {"file_name": "CaptureB.png", "id": "1077448674992401", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623131_1077448678325734_1375712021891819415_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0527fVw2DuwQ7kNvwG4MsQY&_nc_oc=AdqEqa7-Fp2Pjt6I01AeKl628H-py1NkNKCvqQFq-I8QpvQ4yz1-7OBz4JFWK9EfCWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO72u__hZlI9z14gBPLSibppis2BCjjji5PMUY8OTl4eA&oe=6AC67333"}, {"file_name": "CaptureA.png", "id": "3543227985840803", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620403_3543227989174136_4327203232275843921_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeS27mYJHXwQ7kNvwEGmir6&_nc_oc=AdppyzKKYlLzZUHVftWPJArMZ4Q-0KJ7QnuSCTW0BfCtKGvV18ToUIRrOr1iMix9T4E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvcNYaUwcdc5oU1IKX4cNoFK_rZKtPaBet74YxpbUvLw&oe=6AC66977"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "won.PNG", "id": "1610503917389722", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593839439_1610503920723055_8113868596814087671_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6W_Oty0LncQ7kNvwHyXtMw&_nc_oc=AdrnGUlX2-oY1Y76O9C2qdFDSnejDuarA7VwtvmMVzSZXT9eHmDKao7CwBzVKAbgoLk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTi9anC81IzE3lxnzkAkCYC6sQ8XYHGieVxomaQMB8Gg&oe=6AC67703"}, "display_name": "Project S", "keywords": ["RTS", "Strategy", "Tabletop", "Battle", "Robots"], "long_description": "**Project S V2 is here.**\n\nClassic 90s RTS action, rebuilt for VR.\n\nProject S has been extensively reworked with new animations, improved menus, refreshed French and English voices, redesigned maps, stronger visual clarity, upgraded explosions, and better spatial VR effects.\n\n{1565161271564349}\n\nTake control of a living tabletop battlefield. Capture factories, build your robot army, steal powerful vehicles, expand your territory, and destroy the enemy base.\n\n{1395987092656981}\n\nCommand **10+ units and vehicles** and explore **2 unique planets across 8 levels**, redesigned for clearer and more exciting VR battles.\n\nAnd now, **Multiplayer is live.**\n\nChallenge another player, adapt your strategy, and fight for control.\n\n{2168523010746964}\n\nDestroy the enemy base and enjoy the final blow.\n\nProject S isn\u2019t just an RTS inside a headset. You are standing over the battlefield.\n\nBring the war into your own room with Mixed Reality.\n\n{2583029285491420}\n\nRelive the spirit of classic 90s strategy games in VR.\n\n**Build. Capture. Expand. Attack. Conquer.**\n\nCreated by a passionate solo developer.\n\n**More planets are coming as FREE DLC.**\n\n**Take command. Own the battlefield.**", "short_description": "Project S V2 is here.\n\nThe 90s RTS spirit returns in VR, rebuilt with new animations, redesigned maps, improved menus, refreshed FR/EN voices, upgraded explosions and enhanced VR effects.\n\nAnd now, Multiplayer is live.\n\nCapture factories, grow your robot army, deploy powerful vehicles, expand your territory and destroy the enemy.\n\n2 planets. 8 levels. 10+ units and vehicles.\nFree planet DLC coming very soon.\n\nBuild. Capture. Dominate."}]}, "developer_name": "Stephane Quillet", "developer_privacy_policy_url": "https://projectsvr.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XFX", "support_website_url": null, "website_url": "https://projectsvr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "38565064059806675"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593863731_1746583643225673_3687195542237334102_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5vJZm_SO7QQ7kNvwF7hgOm&_nc_oc=AdrvzRWKT-UzIV3l8BWdE0KDQwqlapvGkrbj75YQdcb2XtDnl0-ljV6uI64bVwR-oz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM30gaoInl4RidAmdxkQ-O0lGmHs1AHacW6_LTDg8zGAQ&oe=6AC640DD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Project S", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Strategy", "id": "275629210202852"}], "release_date": 1781715900, "lastRevision": {"nodes": [{"id": "35020187714294345", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"app
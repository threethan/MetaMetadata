0817_924884170597919_3406350104019439407_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDxUaZ9wZ8IQ7kNvwHb_JuJ&_nc_oc=AdrKzvUA6UjdTyAbO0NLJDCy4J_TK_C1FKXuCEJJumL-7Ab0se8hi3ikA3vsdSvdaR8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIFJPRuGr_ztQ97X5bSrDnTJKKsFmdWZrswgpMJvOvqw&oe=6AB3E10B"}, {"file_name": "1.png", "id": "998232089451140", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623384_998232092784473_2328103235580800332_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9MpzK_xNOYQ7kNvwEK4qWU&_nc_oc=Adp2daeVJ47fGJH6ga4ErMALX-_RQUAVlHFsZrk1xDtK6Kip7zachSqqNc4FCT9IXe0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5cGlEiF6rZfI8Sx6GXoJTGWeMwIzhYEyFicoOzdW9sQ&oe=6AB3F6F6"}, {"file_name": "3.png", "id": "1982148652394545", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654867655_1982148655727878_6443745899874587342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lx1XvUWoNQYQ7kNvwEC5hpS&_nc_oc=Adqwmq1aSZWPVIY01YWRPO7YaQOS-1SywvVrpbVC9FJ-6tRSJGVgIHeOy3D6ADljksk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPBz--Wc22qmCZ9xx_SEyCp1SKoZ7ySpCmbYf5fUmNqA&oe=6AB3CB3A"}, {"file_name": "2.png", "id": "1483737686240246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_1483737689573579_7024275750668855584_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVmcNMW3q34Q7kNvwHBS00e&_nc_oc=AdqIi0prO6aqQn94Nq2u3SsN4knBKw4-k4CUd-dLbppnZJAJYfg3U4yIXPPvyPP6rDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUIOOTfWMKD8whpOgdFXLGKF34qFotDDPIBvvzVnHpAQ&oe=6AB3EF5B"}, {"file_name": "5.png", "id": "2435216086947015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_2435216090280348_3156147719830534193_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wxSHwedWU_0Q7kNvwGxkdLq&_nc_oc=AdqvLGWqkm7aSD3s_nF4aRwGbc8QTwwtaUlcuXdh9HDXpzWWoYGId4mYekxHAD2nofg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB_MggGlcsXW050Z3kP2uGzfwzURBOKcGdHb6bGq4yOw&oe=6AB3C32A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paysage.png", "id": "1307100734206067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_1307100737539400_265628498726652087_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJgkLBiuzCsQ7kNvwFGcX3n&_nc_oc=Adp9wMAS5VuJ_QxrZI0rQjkBDgq-BEIHbh7gbqz53AfOtMHLrHVjEgaspSh5ropG_8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9XLgXzq6sofHPJ0IfDu69m1eM6nR43w57Zq9Kkl1ayQ&oe=6AB3C534"}, "display_name": "Project S", "keywords": ["RTS", "Strategy", "Tabletop", "Battle", "Robots"], "long_description": "Project S is a fast, explosive VR real time strategy game built for players who miss the addictive fun of classic 90s RTS games and want to feel that magic again in virtual reality.\n\nCommand your army from above a living tabletop battlefield. Capture factories, produce robotic units, steal vehicles, expand your territory, and crush the enemy base before they crush yours. Every mission is easy to understand, exciting to play, and full of tactical choices that reward speed, timing, and smart decisions.\n\nIn Project S, you are not just watching a battle on a flat screen. You are standing over the warzone. Your robots move, fight, capture, explode, and survive right in front of you. The battlefield feels alive, physical, and immediate, giving classic strategy gameplay a fresh VR energy.\n\nBuilt by a passionate solo developer, Project S is made with heart, ambition, and the help of modern AI tools to accelerate development. The goal is simple: bring back the fun, direct, addictive spirit of old school RTS games and reimagine it for the Meta Quest era.\n\nMore planets are planned after launch as free DLC, bringing new environments, missions, and battlefield situations. A multiplayer mode is also in development, with the goal of letting players challenge each other in competitive VR RTS battles.\n\nProject S is for players who want strategy, action, nostalgia, robots, explosions, and a VR battlefield they can truly command.", "short_description": "Project S is a fast-paced VR RTS inspired by the legendary strategy games of the 90s, rebuilt for Meta Quest. Capture factories, produce robots, control vehicles, and dominate the battlefield in explosive tabletop battles. Easy to jump into, hard to master. Free planet DLCs are planned, multiplayer is in development, and the game is created by a solo developer with AI tools used to help accelerate coding."}]}, "developer_name": "Stephane Quillet", "developer_privacy_policy_url": "https://projectsvr.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XFX", "support_website_url": null, "website_url": "https://projectsvr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "35787802334199542"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1063945209763006"}, {"status": "PUBLISHED", "id": "27979696761616293"}, {"status": "PUBLISHED", "id": "2230132011068025"}, {"status": "PUBLISHED", "id": "1018735040646699"}, {"status": "PUBLISHED", "id": "2067623024140344"}]}, "baseline_offer": {"id": "27979696761616293"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1063945209763006"}]}, "liveChannel":
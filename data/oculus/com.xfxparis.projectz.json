h=00_AQKJbM0frZ8QDY8jkMJs8f6f2--I_HAFa8vzOAUXix4Pbw&oe=6AA14E2A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paysage.png", "id": "1307100734206067", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620921_1307100737539400_265628498726652087_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElHD4WQxWRMQ7kNvwHKZzBG&_nc_oc=AdofYtF8x9A93vcYua7N-LWhAWAXrT6NbLPL2lOhwH_Yh3WqUzLBC6Dv35OyVYL4QiA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaPbOny-Ocfh3kW6VOhIkG44igDovGWoEChU8mYU8tWQ&oe=6AA15034"}, "display_name": "Project S", "keywords": ["RTS", "Strategy", "Tabletop", "Battle", "Robots"], "long_description": "Project S is a fast, explosive VR real time strategy game built for players who miss the addictive fun of classic 90s RTS games and want to feel that magic again in virtual reality.\n\nCommand your army from above a living tabletop battlefield. Capture factories, produce robotic units, steal vehicles, expand your territory, and crush the enemy base before they crush yours. Every mission is easy to understand, exciting to play, and full of tactical choices that reward speed, timing, and smart decisions.\n\nIn Project S, you are not just watching a battle on a flat screen. You are standing over the warzone. Your robots move, fight, capture, explode, and survive right in front of you. The battlefield feels alive, physical, and immediate, giving classic strategy gameplay a fresh VR energy.\n\nBuilt by a passionate solo developer, Project S is made with heart, ambition, and the help of modern AI tools to accelerate development. The goal is simple: bring back the fun, direct, addictive spirit of old school RTS games and reimagine it for the Meta Quest era.\n\nMore planets are planned after launch as free DLC, bringing new environments, missions, and battlefield situations. A multiplayer mode is also in development, with the goal of letting players challenge each other in competitive VR RTS battles.\n\nProject S is for players who want strategy, action, nostalgia, robots, explosions, and a VR battlefield they can truly command.", "short_description": "Project S is a fast-paced VR RTS inspired by the legendary strategy games of the 90s, rebuilt for Meta Quest. Capture factories, produce robots, control vehicles, and dominate the battlefield in explosive tabletop battles. Easy to jump into, hard to master. Free planet DLCs are planned, multiplayer is in development, and the game is created by a solo developer with AI tools used to help accelerate coding."}]}, "developer_name": "Stephane Quillet", "developer_privacy_policy_url": "https://projectsvr.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XFX", "support_website_url": null, "website_url": "https://projectsvr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "35787802334199542"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "27979696761616293"}, {"status": "PUBLISHED", "id": "2230132011068025"}, {"status": "PUBLISHED", "id": "1018735040646699"}, {"status": "PUBLISHED", "id": "2067623024140344"}]}, "baseline_offer": {"id": "27979696761616293"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783465740, "status": "PUBLISHED", "id": "27979696761616293"}]}, "liveChannel": {"nodes": [{"latest_
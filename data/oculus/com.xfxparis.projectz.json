-7&_nc_sid=6e7a0a&_nc_ohc=qU5wtHXO8egQ7kNvwG8x4ES&_nc_oc=AdoALVmmcPQT2pI2Wk5Ue2-F3sXyQ99N7Gjsa2YInZgUWFVyZ2y27QXumy1Twl5j4Ag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJJBW6xo4j0-bf3_cJ3Zi5mj44bf6brx0dvXIPGCATcw&oe=6AC66FC7"}, {"file_name": "CaptureE.png", "id": "937023452349226", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620341_937023455682559_2341001192424456555_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUZlR_QZD2wQ7kNvwEmCbXX&_nc_oc=AdrhGCUAPZNibM86P3RnHhK6WP42rvzIA9Q-kbjBTgh3lDc9Ogd2pu8KYjoNGSMD8Sc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyPeGdw8vJGdhkMBt2PPLApErrcLBjVIROfW5bvCbFHw&oe=6AC64A43"}, {"file_name": "CaptureD.png", "id": "2266799224142530", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628875_2266799230809196_1898839304499945196_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PsgDoVoI1eMQ7kNvwFR-VWm&_nc_oc=Adoxjg5J0SPZdi0p3-pMHR7kDRnDan3orY7k-2QR-SudZsSgd_kPV3v5wGCq5CVAdoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6KVvGrizQm0UFG6JS5i80rZyoSkEwaMP8ryCa5SgQyA&oe=6AC66DD0"}, {"file_name": "CaptureC.png", "id": "2220349518540848", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620384_2220349521874181_8844704024378135360_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YK7lu9tnpC4Q7kNvwE7CQMx&_nc_oc=Adr9XBUx0wkuJYDIjHX-bw10lBge-w_2oqZqZKN0FjL5y-7qNFJ_zU9-7d8eZYduni8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNF45s5vHVct8idADK_KWOAmJKE9sUy2hDQMrZXfDezQ&oe=6AC6683C"}, {"file_name": "CaptureB.png", "id": "1443171434352181", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620559_1443171437685514_5022996904363133616_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqm4eYBTm8YQ7kNvwHEHWlJ&_nc_oc=AdoGL5cU3EQHQfjythVbAWiAoDG6Cvw0rZ_kE-iQ9gDtcL9Q2vwcAjYHw9NFFAu0GYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQC_o5b5Se7LoXIji7ib6CEfsGKZ9q2gjMdavLt32MrA&oe=6AC6632B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "won.PNG", "id": "1784790285973118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624656_1784790289306451_5858051745352447723_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gb9jbGVUQC8Q7kNvwFlHbwx&_nc_oc=AdqNGc9ccu5OE7KtC0vkXfK_O1rmh4qv-Qq17PefDVcfwHBSElvWwJbejJVzVbkE-ro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsiuuq3Epm7OMyvourrWU-ZJpMLKYFaVVnIxkREqxbOA&oe=6AC65F1D"}, "display_name": "Project S", "keywords": ["RTS", "Strategie", "Combat", "Fight"], "long_description": "**Project S V2 est disponible.**\n\nL\u2019action des RTS des ann\u00e9es 90 revient, enti\u00e8rement reconstruite pour la VR.\n\nProject S a \u00e9t\u00e9 largement retravaill\u00e9 avec de nouvelles animations, des menus am\u00e9lior\u00e9s, des voix fran\u00e7aises et anglaises renouvel\u00e9es, des cartes repens\u00e9es, une meilleure lisibilit\u00e9, des explosions am\u00e9lior\u00e9es et des effets VR spatiaux plus immersifs.\n\n{4554087361574158}\n\nPrenez le contr\u00f4le d\u2019un champ de bataille vivant sur table. Capturez des usines, construisez votre arm\u00e9e de robots, volez de puissants v\u00e9hicules, \u00e9tendez votre territoire et d\u00e9truisez la base ennemie.\n\n{2148332736073098}\n\nCommandez **plus de 10 unit\u00e9s et v\u00e9hicules** et explorez **2 plan\u00e8tes uniques \u00e0 travers 8 niveaux**, repens\u00e9s pour offrir des combats VR plus lisibles et plus intenses.\n\nEt maintenant, **le Multijoueur est disponible.**\n\nAffrontez un autre joueur, adaptez votre strat\u00e9gie et luttez pour le contr\u00f4le du champ de bataille.\n\n{2585573938601221}\n\nD\u00e9truisez la base ennemie et savourez le coup final.\n\nProject S n\u2019est pas simplement un RTS affich\u00e9 dans un casque. Vous \u00eates r\u00e9ellement au-dessus du champ de bataille.\n\nFaites m\u00eame entrer la guerre directement dans votre salon gr\u00e2ce au mode R\u00e9alit\u00e9 Mixte.\n\n{1397372281891759}\n\nRetrouvez l\u2019esprit des jeux de strat\u00e9gie classiques des ann\u00e9es 90, r\u00e9invent\u00e9 pour la VR.\n\n**Construisez. Capturez. \u00c9tendez-vous. Attaquez. Conqu\u00e9rez.**\n\nCr\u00e9\u00e9 avec passion par un d\u00e9veloppeur solo.\n\n**De nouvelles plan\u00e8tes arrivent en DLC GRATUIT.**\n\n**Prenez le commandement. Dominez le champ de bataille.**", "short_description": "Project S V2 est disponible.\n\nL\u2019esprit des RTS des ann\u00e9es 90 revient en VR, enti\u00e8rement retravaill\u00e9 avec de nouvelles animations, des cartes repens\u00e9es, des menus am\u00e9lior\u00e9s, des voix FR/EN renouvel\u00e9es, des explosions am\u00e9lior\u00e9es et des effets VR plus immersifs.\n\nEt maintenant, le Multijoueur est disponible.\n\nCapturez des usines, d\u00e9veloppez votre arm\u00e9e de robots, d\u00e9ployez de puissants v\u00e9hicules, \u00e9tendez votre territoire et d\u00e9truisez l\u2019ennemi.\n\n2 plan\u00e8tes. 8 niveaux. Plus de 10 unit\u00e9s et v\u00e9hicules.\n"}, {"images": {"nodes": [{"file_name": "23950fc2-a227-4b18-a5f9-1d80729bd908.png", "id": "2110622649541523", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620559_2110622652874856_7579983357817103206_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSTjN6ydZs4Q7kNvwFZ3vF2&_nc_oc=Adpdor695hLYz9YqJ6nbOIpUWodf3ZghB8G-KtY4VjLjkBmputGASTl7aMBR-QQsWrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe1btC_21rxAHRYjuNZLCMd0LpQTv8v_oErn3GRohAtA&oe=6AC65A5D"}, {"file_name": "84791b8c-4bd6-4be0-9355-cb8c8d4867bf.png", "id": "1746583639892340", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593863731_1746583643225673_3687195542237334102_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5vJZm_SO7QQ7kNvwF7hgOm&_nc_oc=AdrvzRWKT-UzIV3l8BWdE0KDQwqlapvGkrbj75YQdcb2XtDnl0-ljV6uI64bVwR-oz0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_
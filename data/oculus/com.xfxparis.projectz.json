uluscdn.com/v/t64.5771-25/654867655_1982148655727878_6443745899874587342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EwqLjEIxowQ7kNvwF55Xjh&_nc_oc=AdpvwNCgOc49-1aejN9ZqG7cYGHz4vTAq7wJL1YtXqNG_ePGYHh0p1OQYSWtm4DaXlA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIY3ps855zeBOAdK2Qek-urzKjIxvGz79-NVCyCIWF3Lg&oe=6AB7BFBA"}, {"file_name": "2.png", "id": "1483737686240246", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623295_1483737689573579_7024275750668855584_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Npid33DuqN8Q7kNvwG5O2hN&_nc_oc=Adpww3vU3h0W0jhgboJImHre3w-8IWDZCvsGeJt2tT3zo6ynfnIXndWqA7Y3-MRVkHU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnVkCqWdo80GylTOSHv2VI0hJkguDmHRS4DFzLQgpMEg&oe=6AB7E3DB"}, {"file_name": "5.png", "id": "2435216086947015", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622214_2435216090280348_3156147719830534193_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrBKoCaJheYQ7kNvwHbkUs9&_nc_oc=Adr5D3ZtEYeMn1SMnIdkJvHqeUqs2fkt8SBSDNI3sr0x1Sf44GN4lC4MsBXqpswh7nw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI35RIL1vO54xl7nQPAlAktU6sI_5zQDMNczI80WRBEVA&oe=6AB7EFEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paysage.png", "id": "1307100734206067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_1307100737539400_265628498726652087_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZS-Bul63u5sQ7kNvwEsokRf&_nc_oc=AdpZn4aIdCLKJXMC2k-fozQtaaVg3HOrXk4XwSnGnrV_QVfQQ1xBEmdyUFi7zHTOBFE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7ndCV08O7UauwwzFlurp6_Opfeu3FFaM2OxDvBwANag&oe=6AB7B9B4"}, "display_name": "Project S", "keywords": ["RTS", "Strategy", "Tabletop", "Battle", "Robots"], "long_description": "Project S is a fast, explosive VR real time strategy game built for players who miss the addictive fun of classic 90s RTS games and want to feel that magic again in virtual reality.\n\nCommand your army from above a living tabletop battlefield. Capture factories, produce robotic units, steal vehicles, expand your territory, and crush the enemy base before they crush yours. Every mission is easy to understand, exciting to play, and full of tactical choices that reward speed, timing, and smart decisions.\n\nIn Project S, you are not just watching a battle on a flat screen. You are standing over the warzone. Your robots move, fight, capture, explode, and survive right in front of you. The battlefield feels alive, physical, and immediate, giving classic strategy gameplay a fresh VR energy.\n\nBuilt by a passionate solo developer, Project S is made with heart, ambition, and the help of modern AI tools to accelerate development. The goal is simple: bring back the fun, direct, addictive spirit of old school RTS games and reimagine it for the Meta Quest era.\n\nMore planets are planned after launch as free DLC, bringing new environments, missions, and battlefield situations. A multiplayer mode is also in development, with the goal of letting players challenge each other in competitive VR RTS battles.\n\nProject S is for players who want strategy, action, nostalgia, robots, explosions, and a VR battlefield they can truly command.", "short_description": "Project S is a fast-paced VR RTS inspired by the legendary strategy games of the 90s, rebuilt for Meta Quest. Capture factories, produce robots, control vehicles, and dominate the battlefield in explosive tabletop battles. Easy to jump into, hard to master. Free planet DLCs are planned, multiplayer is in development, and the game is created by a solo developer with AI tools used to help accelerate coding."}]}, "developer_name": "Stephane Quillet", "developer_privacy_policy_url": "https://projectsvr.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XFX", "support_website_url": null, "website_url": "https://projectsvr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST"
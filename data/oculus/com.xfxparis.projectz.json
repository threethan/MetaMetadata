6403A"}, {"file_name": "2.png", "id": "1483737686240246", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_1483737689573579_7024275750668855584_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6aWhegShv7wQ7kNvwGaRgxn&_nc_oc=Adr9pHOHQEISPJioMNI-4UiTIBfyGTRNKVeQwRdTSQza4u_UquwDVCMx6uic7tCJT0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAzg6vuB6sWj-Cb44soYNmRZTLf9Z0nYSHSetRB3OEmg&oe=6AC6645B"}, {"file_name": "5.png", "id": "2435216086947015", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_2435216090280348_3156147719830534193_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXqCjqSgULIQ7kNvwH9Jipe&_nc_oc=AdoZJCB1_Th-7K1wR1UmPgUdjEgeWl5X02uyPeY_F3fpG4zYFGIAgJ_wXrrmCVAST-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2p3BJzESB6pXI-JpniDsacPzao2eQgudGBX9-FSfWUg&oe=6AC6706A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Paysage.png", "id": "1307100734206067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_1307100737539400_265628498726652087_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbMASfg2hSYQ7kNvwHUpOju&_nc_oc=Adp1H-sxx2FAnApHFOCgz_Oca_wwKcWqPOXyOCnMbkyHopukpe988tFYRjwz-8Si20A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0NVmaCLqvys_dTeYk6aVdIsrLYc9aGKfcsYTCG62N4A&oe=6AC67274"}, "display_name": "Project S", "keywords": ["RTS", "Strategy", "Tabletop", "Battle", "Robots"], "long_description": "Project S is a fast, explosive VR real time strategy game built for players who miss the addictive fun of classic 90s RTS games and want to feel that magic again in virtual reality.\n\nCommand your army from above a living tabletop battlefield. Capture factories, produce robotic units, steal vehicles, expand your territory, and crush the enemy base before they crush yours. Every mission is easy to understand, exciting to play, and full of tactical choices that reward speed, timing, and smart decisions.\n\nIn Project S, you are not just watching a battle on a flat screen. You are standing over the warzone. Your robots move, fight, capture, explode, and survive right in front of you. The battlefield feels alive, physical, and immediate, giving classic strategy gameplay a fresh VR energy.\n\nBuilt by a passionate solo developer, Project S is made with heart, ambition, and the help of modern AI tools to accelerate development. The goal is simple: bring back the fun, direct, addictive spirit of old school RTS games and reimagine it for the Meta Quest era.\n\nMore planets are planned after launch as free DLC, bringing new environments, missions, and battlefield situations. A multiplayer mode is also in development, with the goal of letting players challenge each other in competitive VR RTS battles.\n\nProject S is for players who want strategy, action, nostalgia, robots, explosions, and a VR battlefield they can truly command.", "short_description": "Project S is a fast-paced VR RTS inspired by the legendary strategy games of the 90s, rebuilt for Meta Quest. Capture factories, produce robots, control vehicles, and dominate the battlefield in explosive tabletop battles. Easy to jump into, hard to master. Free planet DLCs are planned, multiplayer is in development, and the game is created by a solo developer with AI tools used to help accelerate coding."}]}, "developer_name": "Stephane Quillet", "developer_privacy_policy_url": "https://projectsvr.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XFX", "support_website_url": null, "website_url": "https://projectsvr.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_g
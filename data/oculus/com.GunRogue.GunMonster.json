culuscdn.com/v/t64.5771-25/491820923_1896779314305714_7124677849101397633_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZU4iHYCN_TsQ7kNvwF3rMRq&_nc_oc=AdoRDhY4tGwaR1pKGMRLFp8ujHeadRst7zRQwpTfC5itNLu5pTUZybYEzpfkTq0SGPY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-2TQv45iqW7rAK1bmZVqCgwqdSbBd_vACwKvHybDDag&oe=69CA85BF"}, {"file_name": "6.png", "id": "25814349501570390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823930_25814349511570389_4690317007172507235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BamBoy3nyAQ7kNvwHH2gUR&_nc_oc=AdqjiEQvm0f4hK6Aw0WQ-b7v8Y_22nmWJJE9tSF1R1ryk91Blid7S_igooA7oIx60mY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfD3-GeTEuVGP_kZx15vPBp664DVurxYsllDdOnl5uOw&oe=69CA858E"}, {"file_name": "4.png", "id": "1983118219299489", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1983118222632822_5596147312233709288_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GqHLBVbjWAQ7kNvwFqL59Z&_nc_oc=Adp7RrfswOgKdfXFfxiD6oBTTQ8sD-7yLmWeYAiFc4yYuYDG62k0CVO9LXM3IW4w-ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9eNv2FnsnduJ47l5mIeU79Xyp8EX-OO0Twa0niRCh9A&oe=69CA6DFE"}, {"file_name": "1.png", "id": "960134656580315", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_960134659913648_3622645790100062902_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb7DQc7RDhMQ7kNvwFsqLjs&_nc_oc=AdqJGXqgnt8WmeWyeABQk8ACivAi4tUp03V1bZzHjxdlUgA3TfKGmETsj_Pu-9VFmWg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxP9KUt9y8FNG-Dq0Dhc22Pgbl6Ln6p5SofEF0v5PixIw&oe=69CA5E01"}, {"file_name": "2.png", "id": "731289389950962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_731289393284295_3546497114042560996_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9AcpujO-PgQ7kNvwFXj5C3&_nc_oc=Adq8GmUZzR2FOcefzLtKHHqBxmI1RCKy-fLWaPqjKbl1SB7pVeZ6a1JzlnJDY7ipbIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjKpA_jbwqGDxbgjZDE_fosUzfBz3shRzxHmd48kCSTQ&oe=69CA616B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guns & Monsters", "keywords": ["Dragon", "monster", "Battle", "combat", "shooter"], "long_description": "# The Dragon-King Beast Unleashed\nFace the massive, multi-limbed Dragon-King Beast in an epic battle. Target the creature's vulnerable mouth to land critical hits, while dodging its powerful lunges and devastating charges. Watch your progress with the dynamic health bar as you fight for victory!\n{1454993905972578}\n\n# Blazing Battle: Monster Hunt\nTake on waves of supernatural enemies, from floating purple slimes to dangerous mimic chests and cactus monsters. With a one-handed blaster, lightning strikes, and drone support, you'll need quick reflexes and powerful abilities to survive this fast-paced battle!\n{899519346390478}\n\n# Power-Up Frenzy\nCollect powerful boosts scattered throughout the desert as you battle your enemies! From meteor strikes to combat drones, these power-ups give you the edge you need to survive the relentless onslaught.\n{1468258681361222}", "short_description": "Dive into an action-packed desert adventure in Guns & Monsters! Armed with a rifle, you\u2019ll battle a variety of enemies, from red slimes to skeletal warriors, in intense VR combat. Collect power-ups, earn money, and face off against a massive reptilian boss in thrilling boss fights. Use your hands to reload, interact with the environment, and enjoy the immersive experience of combat in a bone-chilling desert landscape. Are you ready to take on the monsters?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534
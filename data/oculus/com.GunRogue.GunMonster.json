2_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DreEWxSPVUQ7kNvwHETUV1&_nc_oc=AdohBiy5F8doe8MvGTVs45_vOC3QyuOtydG99baDmrj6uKQHb2JQVPKem7yHrvWrm2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC1uZLQF_u4a07Sa1_i_cHrvAKBuOaAZt0uquG6po8cg&oe=6AB14CC1"}, {"file_name": "2.png", "id": "731289389950962", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825345_731289393284295_3546497114042560996_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ck9EvIjojrgQ7kNvwGmMLft&_nc_oc=AdqpFZTsWGIbyws7rhBKmw_dijxE9pYxu0hCUMoN3OaRKKxqH3RCkbDBu8z1eR67XwY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFi4ka1fX0khON_PakzixC0x7M1MdN0Uv55Kofg9c8nQ&oe=6AB1502B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Guns&Monsters_Landscape.png", "id": "982930431350450", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618284_982930438017116_7362928640957953725_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqDJlgJ8ofgQ7kNvwG8xj0y&_nc_oc=Adqsu-IaAXduCZ-fx6g1_3iA9zbrVabGtMcWvODyHSjvHA0Sn6mxg-8GITn68Lda02c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9RiehkhNtWbU-ONmKHMtTfMqKO890wOpBizDj6i5Krw&oe=6AB154E9"}, "display_name": "Battle Warrior - Guns & Monsters", "keywords": ["Battle", "roguelike", "combat", "guns", "Bullet"], "long_description": "# The Dragon-King Beast Unleashed\nFace the massive, multi-limbed Dragon-King Beast in an epic battle. Target the creature's vulnerable mouth to land critical hits, while dodging its powerful lunges and devastating charges. Watch your progress with the dynamic health bar as you fight for victory!\n{1454993905972578}\n\n# Blazing Battle: Monster Hunt\nTake on waves of supernatural enemies, from floating purple slimes to dangerous mimic chests and cactus monsters. With a one-handed blaster, lightning strikes, and drone support, you'll need quick reflexes and powerful abilities to survive this fast-paced battle!\n{899519346390478}\n\n# Power-Up Frenzy\nCollect powerful boosts scattered throughout the desert as you battle your enemies! From meteor strikes to combat drones, these power-ups give you the edge you need to survive the relentless onslaught.\n{1468258681361222}", "short_description": "Dive into an action-packed roguelike desert adventure in Guns & Monsters! Armed with a rifle, you\u2019ll battle a variety of enemies, from red slimes to skeletal warriors, in intense VR combat. Collect power-ups, earn money, and face off against a massive Dragon in thrilling boss fight. Lock & Load and enjoy the immersive experience of roguelike combat. Are you ready to take on the monsters?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28199634559648374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820855_1468616924904727_4516092301751828636_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyNhEJga4fEQ7kNvwEXlKPf&_nc_oc=AdqfpuTuaglfYLYomd9lo_rO2jA6DVoFxfAUpI5vkDirY6-dUGN_O5LtTga4ORNNd4M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkS57cVh
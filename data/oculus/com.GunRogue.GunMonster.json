=7f20f&oh=00_Af0N-vDbtLOUzkur-bOhHst0jE7lpc5fp1RONdYsJZojXw&oe=69F76941"}, {"file_name": "2.png", "id": "731289389950962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_731289393284295_3546497114042560996_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXj7G5dt4QAQ7kNvwFuwgyN&_nc_oc=AdoEiZU49knA7t5O5ResRZyUA4ddtR3IcjnVtUaYrCLIjl6tdEM2KyrgQKdgq-dMCus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eoVjvLkgJ0BD5bFbuY7emdrqwuFAgQuvwXQJtk8c9VQ&oe=69F76CAB"}, {"file_name": "6.png", "id": "25814349501570390", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823930_25814349511570389_4690317007172507235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRob7mrCA8MQ7kNvwF3hRz5&_nc_oc=Adr5N0qj9n5ak_U3QtyM10nK0aTVpepoPuYrrz5qamHkwffEE6fDxeCBm--BQ6xyW4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fKireoQuWt6DZ3MT1gMO_EBVdFoFqZRHuIAv2QyUThg&oe=69F7588E"}, {"file_name": "4.png", "id": "1983118219299489", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1983118222632822_5596147312233709288_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb0MO-jQd1oQ7kNvwHgaFwb&_nc_oc=Adoc3tUp_TwmMXRX22Gzd3CXs0ZoeqJ7C_W6qX2r6I8kjpP_MF9BpM_So-0Ud_JgRXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NynRV_gpmCEKewpLwPNpdIIj3b8svOtez3_EXpuROLQ&oe=69F740FE"}, {"file_name": "5.png", "id": "1896779310972381", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820923_1896779314305714_7124677849101397633_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEHbcT7Ws60Q7kNvwHINMVm&_nc_oc=AdoOOnF378idrMnBzsOXfNeJUV8v8M-PtPyj3o4wkGZ1q-7hqVRriPhyk4SRIs4-HDs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fCdWbiZ_Dde6dIRt8d4ugtEnKyjdXpFTygMBk1omCdQ&oe=69F758BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guns & Monsters", "keywords": ["Dragon", "monster", "Battle", "combat", "shooter"], "long_description": "# Power-Up Frenzy\nCollect powerful boosts scattered throughout the desert as you battle your enemies! From meteor strikes to combat drones, these power-ups give you the edge you need to survive the relentless onslaught.\n{1468258681361222}\n\n# Blazing Battle: Monster Hunt\nTake on waves of supernatural enemies, from floating purple slimes to dangerous mimic chests and cactus monsters. With a one-handed blaster, lightning strikes, and drone support, you'll need quick reflexes and powerful abilities to survive this fast-paced battle!\n{899519346390478}\n\n# The Dragon-King Beast Unleashed\nFace the massive, multi-limbed Dragon-King Beast in an epic battle. Target the creature's vulnerable mouth to land critical hits, while dodging its powerful lunges and devastating charges. Watch your progress with the dynamic health bar as you fight for victory!\n{1454993905972578}", "short_description": "Dive into an action-packed desert adventure in Guns & Monsters! Armed with a rifle, you\u2019ll battle a variety of enemies, from red slimes to skeletal warriors, in intense VR combat. Collect power-ups, earn money, and face off against a massive reptilian boss in thrilling boss fights. Use your hands to reload, interact with the environment, and enjoy the immersive experience of combat in a bone-chilling desert landscape. Are you ready to take on the monsters?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "N
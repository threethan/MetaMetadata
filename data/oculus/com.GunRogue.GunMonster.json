.com&_nc_ss=7f20f&oh=00_AQTg4ZrHMCK4lq9iLHq105Z5j1Ea5X79EYtOwdIsVef21g&oe=6B03314E"}, {"file_name": "4.png", "id": "1983118219299489", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_1983118222632822_5596147312233709288_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUS8arOvwCoQ7kNvwGrG-9l&_nc_oc=AdpyToPHLxB-ZcWk3SJeNjsA_QzsBV98FcedroZkLVT3svVcI5MWnBfpcldbbiWp30Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQodDz0EtfcP19LO_Xlqju4Yo1iZukiqmnjCimIo6YjNw&oe=6B0319BE"}, {"file_name": "5.png", "id": "1896779310972381", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820923_1896779314305714_7124677849101397633_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYhWUfS9x_kQ7kNvwHed-bv&_nc_oc=AdqapcBjye2PTHsHlzaVVC3n5WcPUxGnhaQorLHKdFWW74J0_MuoZkD6_e3Kg2kJyts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFhe3cHqg4BmXge3DXX2-TrYmSo1rAhUDhGT5LeZ86sA&oe=6B03317F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guns & Monsters", "keywords": ["Dragon", "monster", "Battle", "combat", "shooter"], "long_description": "# Power-Up Frenzy\nCollect powerful boosts scattered throughout the desert as you battle your enemies! From meteor strikes to combat drones, these power-ups give you the edge you need to survive the relentless onslaught.\n{1468258681361222}\n\n# Blazing Battle: Monster Hunt\nTake on waves of supernatural enemies, from floating purple slimes to dangerous mimic chests and cactus monsters. With a one-handed blaster, lightning strikes, and drone support, you'll need quick reflexes and powerful abilities to survive this fast-paced battle!\n{899519346390478}\n\n# The Dragon-King Beast Unleashed\nFace the massive, multi-limbed Dragon-King Beast in an epic battle. Target the creature's vulnerable mouth to land critical hits, while dodging its powerful lunges and devastating charges. Watch your progress with the dynamic health bar as you fight for victory!\n{1454993905972578}", "short_description": "Dive into an action-packed desert adventure in Guns & Monsters! Armed with a rifle, you\u2019ll battle a variety of enemies, from red slimes to skeletal warriors, in intense VR combat. Collect power-ups, earn money, and face off against a massive reptilian boss in thrilling boss fights. Use your hands to reload, interact with the environment, and enjoy the immersive experience of combat in a bone-chilling desert landscape. Are you ready to take on the monsters?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26311923285086187"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2933823563664241"}]}, "baseline_offer": {"id": "2933823563664241"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773985980, "status": "PUBLISHED", "id": "2933823563664241"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26345207508424431", "version": "1.0.0"}, 
-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8WPbhQrUgqn-qy_ezGOgfLiFfW_Ds8Yu17NHe-sgL8Q&oe=6AC2803E"}, {"file_name": "1.png", "id": "960134656580315", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_960134659913648_3622645790100062902_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFmNK34A4QIQ7kNvwFBxqLS&_nc_oc=Adp4vUI-R8OJBBiSWwLwBoQExxsAA0QHNyWc8i6PjvXzVIg8JlGp27cYQoSPU96tz_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwZN9_GUHIjSpDmtGOqkDan95i7b77ZDBvss6vg1L1tQ&oe=6AC27041"}, {"file_name": "2.png", "id": "731289389950962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825345_731289393284295_3546497114042560996_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-Jd_UqTSPgQ7kNvwEog5eH&_nc_oc=AdrOnzRodxcQHYhZ6vUbFjCX70yN03HOrREmZBFWhdvyDo98tk9Qkb82F0x-qr70v8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTTO7XFKbGkl94SXlRs6cUl4pGaLhJJqTF51c1h7i00g&oe=6AC273AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Guns&Monsters_Landscape.png", "id": "982930431350450", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618284_982930438017116_7362928640957953725_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y95w4wAZOzcQ7kNvwFr6LLI&_nc_oc=AdrAR8QeRTq4UPrhHg4erLMpgj0PAoW4HOAlvFldKZ0fLhVzOHTBptXqXzzTkJuVMwg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSGvrQJa4P8OFy67_UfMu-UnhLKQK7C2XEZ9yh-gsLmQ&oe=6AC27869"}, "display_name": "Battle Warrior - Guns & Monsters", "keywords": ["Battle", "roguelike", "combat", "guns", "Bullet"], "long_description": "# The Dragon-King Beast Unleashed\nFace the massive, multi-limbed Dragon-King Beast in an epic battle. Target the creature's vulnerable mouth to land critical hits, while dodging its powerful lunges and devastating charges. Watch your progress with the dynamic health bar as you fight for victory!\n{1454993905972578}\n\n# Blazing Battle: Monster Hunt\nTake on waves of supernatural enemies, from floating purple slimes to dangerous mimic chests and cactus monsters. With a one-handed blaster, lightning strikes, and drone support, you'll need quick reflexes and powerful abilities to survive this fast-paced battle!\n{899519346390478}\n\n# Power-Up Frenzy\nCollect powerful boosts scattered throughout the desert as you battle your enemies! From meteor strikes to combat drones, these power-ups give you the edge you need to survive the relentless onslaught.\n{1468258681361222}", "short_description": "Dive into an action-packed roguelike desert adventure in Guns & Monsters! Armed with a rifle, you\u2019ll battle a variety of enemies, from red slimes to skeletal warriors, in intense VR combat. Collect power-ups, earn money, and face off against a massive Dragon in thrilling boss fight. Lock & Load and enjoy the immersive experience of roguelike combat. Are you ready to take on the monsters?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28199634559648374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_1468616924904727_45160923017518
c_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRG8C8wh32Zzs0wFVLpUKMFYnCtQwBWiC7MUbwiGxQf5Q&oe=6B0B1A4E"}, {"file_name": "4.png", "id": "1983118219299489", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824292_1983118222632822_5596147312233709288_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SB4ChyJPyGwQ7kNvwHPulIG&_nc_oc=AdpRt6Nin4vTMc_lF7f9PAfAY09Lkyse80sPvR3mjcP61Rs53z-V7ulNbGYd2_RakL8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRdKkQCN4jRJv2BTL_mayTJgCyhBduz4RYYoJsIBrXR-w&oe=6B0B3AFE"}, {"file_name": "1.png", "id": "960134656580315", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823930_960134659913648_3622645790100062902_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNRh64JIbZwQ7kNvwEKxof3&_nc_oc=AdqhhLYdelUK9E2ZmPB8-RaB7cX4KXothZ7hkBWhWrUtS6gYDxRd9r7Fx7iKm7l2J5Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRagVZbCijI1e6b3dQ6Fon5X4iCLPfrEqllIMARPr8Mwg&oe=6B0B2B01"}, {"file_name": "2.png", "id": "731289389950962", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825345_731289393284295_3546497114042560996_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L4V6wtQmbAQ7kNvwEcGT9O&_nc_oc=Adqz4HmSyYzYYqtYlGzOgmmtxo42QFHtzD-ZNRxDPZpw63kpPOAVbXWVQr36Q_9BDSg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTT1iPEPXCad1aUYa0McUMhGSS0AStgfE3hTobELhlLmQ&oe=6B0B2E6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Guns&Monsters_Landscape.png", "id": "982930431350450", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618284_982930438017116_7362928640957953725_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBhYMk3wqS4Q7kNvwGJ2Y9a&_nc_oc=Adqd-RY-EJB4y_RsilQ1OI1dNraY3W9MAwnzEvDffFJQOM6oTv_XIM4lYLd2O0dlB_g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRn1F6M73S6TddQrJsmCzHi6v4JKz0HyA9X0BooMbMn3A&oe=6B0B3329"}, "display_name": "Battle Warrior - Guns & Monsters", "keywords": ["Battle", "roguelike", "combat", "guns", "Bullet"], "long_description": "# The Dragon-King Beast Unleashed\nFace the massive, multi-limbed Dragon-King Beast in an epic battle. Target the creature's vulnerable mouth to land critical hits, while dodging its powerful lunges and devastating charges. Watch your progress with the dynamic health bar as you fight for victory!\n{1454993905972578}\n\n# Blazing Battle: Monster Hunt\nTake on waves of supernatural enemies, from floating purple slimes to dangerous mimic chests and cactus monsters. With a one-handed blaster, lightning strikes, and drone support, you'll need quick reflexes and powerful abilities to survive this fast-paced battle!\n{899519346390478}\n\n# Power-Up Frenzy\nCollect powerful boosts scattered throughout the desert as you battle your enemies! From meteor strikes to combat drones, these power-ups give you the edge you need to survive the relentless onslaught.\n{1468258681361222}", "short_description": "Dive into an action-packed roguelike desert adventure in Guns & Monsters! Armed with a rifle, you\u2019ll battle a variety of enemies, from red slimes to skeletal warriors, in intense VR combat. Collect power-ups, earn money, and face off against a massive Dragon in thrilling boss fight. Lock & Load and enjoy the immersive experience of roguelike combat. Are you ready to take on the monsters?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres"
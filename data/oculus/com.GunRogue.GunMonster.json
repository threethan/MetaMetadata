25/491825345_731289393284295_3546497114042560996_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXj7G5dt4QAQ7kNvwFuwgyN&_nc_oc=AdoEiZU49knA7t5O5ResRZyUA4ddtR3IcjnVtUaYrCLIjl6tdEM2KyrgQKdgq-dMCus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1eoVjvLkgJ0BD5bFbuY7emdrqwuFAgQuvwXQJtk8c9VQ&oe=69F76CAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "593858738_1616824702844991_8276791469725361439_n.png", "id": "1307693197928458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618264_1307693201261791_6384249402555707096_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgYrXbPfHm4Q7kNvwENl0XQ&_nc_oc=AdqGprFqA_lfDm7hVdJmoN5z-WPavZkS4Vcm5ikn0ZCj8LRvUBhotitWqgeOiAr8L7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3D4FZgvRXCwmXW7iU2BA3AOkSCxArbdUrxXc7H9FX7mw&oe=69F76A0C"}, "display_name": "Guns & Monsters: Roguelike", "keywords": ["Dragon", "monster", "Battle", "roguelike", "combat"], "long_description": "# The Dragon-King Beast Unleashed\nFace the massive, multi-limbed Dragon-King Beast in an epic battle. Target the creature's vulnerable mouth to land critical hits, while dodging its powerful lunges and devastating charges. Watch your progress with the dynamic health bar as you fight for victory!\n{1454993905972578}\n\n# Blazing Battle: Monster Hunt\nTake on waves of supernatural enemies, from floating purple slimes to dangerous mimic chests and cactus monsters. With a one-handed blaster, lightning strikes, and drone support, you'll need quick reflexes and powerful abilities to survive this fast-paced battle!\n{899519346390478}\n\n# Power-Up Frenzy\nCollect powerful boosts scattered throughout the desert as you battle your enemies! From meteor strikes to combat drones, these power-ups give you the edge you need to survive the relentless onslaught.\n{1468258681361222}", "short_description": "Dive into an action-packed roguelike desert adventure in Guns & Monsters! Armed with a rifle, you\u2019ll battle a variety of enemies, from red slimes to skeletal warriors, in intense VR combat. Collect power-ups, earn money, and face off against a massive Dragon in thrilling boss fight. Lock & Load and enjoy the immersive experience of roguelike combat. Are you ready to take on the monsters?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26630583983220114"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818849_1084501297231958_5126474792391406878_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd3g21p3ClAQ7kNvwHk7iKQ&_nc_oc=AdrKIuovimsvHrINa0Oh1S-XwTrJxoDl0mOrdi_QE2q_bW7DaDv_nJ1HbImbJCroys0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0QxhPJz8iFz1-rP2BsGctP2EfxHWZNucZp14JMLAXB5Q&oe=69F73EDE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Guns & Monsters: Roguelike", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_nam
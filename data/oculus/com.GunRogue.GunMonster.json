culuscdn.com/v/t64.5771-25/491820923_1896779314305714_7124677849101397633_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHJ-X0HtAdkQ7kNvwFO06Dn&_nc_oc=AdrNMi3WYf4z7TgxOKo64dyFeTWgV1ByjnbRVKlRipm4KSM78HzTt5VySKyQLbl041w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yCd31gHg91vh1nlSyXzGSmAUfoFgCYk4vmnUYO8GQUg&oe=69D26EBF"}, {"file_name": "6.png", "id": "25814349501570390", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823930_25814349511570389_4690317007172507235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pRS-Co-iEccQ7kNvwHhE1JZ&_nc_oc=AdrpbL_d_X_PNHjldeuLfT22tfmuWcliSxCtFX5fmrszYMGmheYySPxJeKE-gBvrlPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xaUwhwbQkTNYrPImNEkvgH1EHKtbWkMiGOSRhnwK5Ew&oe=69D26E8E"}, {"file_name": "4.png", "id": "1983118219299489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824292_1983118222632822_5596147312233709288_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOU24kQ0N3AQ7kNvwG7-h6o&_nc_oc=Ado42ZW2KIwFM_KP9V5a9JS7mxHWDU8hzJCX02UKMAlqoFrmldApvG-4QZtYAB0_NtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03kxVP2XfuTRuhYuvkLQB4Nwz65Lvm8zEXdZj0Dd1Ydw&oe=69D256FE"}, {"file_name": "1.png", "id": "960134656580315", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823930_960134659913648_3622645790100062902_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPx_gvZfR8gQ7kNvwG0VdhQ&_nc_oc=Adqsp1a5DtwbUxXW3_LlRGwbix-ET8YC1983iN7gSn8VzH5_sN0neG3HhQYt9p3T6Yg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HgIoTl8jgqF7aRX637IlxdRF_3iPmXg1G14gvOihu8Q&oe=69D24701"}, {"file_name": "2.png", "id": "731289389950962", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825345_731289393284295_3546497114042560996_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4BVSMJYxAQQ7kNvwGtccXo&_nc_oc=AdqGdPwZ6HLo-a01lsZA78BBH0ejaxDhVo3Fadj2eQffPwCRkFPuZcFoaegDekc-0Qw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Vrgsig_kuzNWpXp_AqmLQARwLsAas5ApaqS6fKakoLg&oe=69D24A6B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guns & Monsters", "keywords": ["Dragon", "monster", "Battle", "combat", "shooter"], "long_description": "# The Dragon-King Beast Unleashed\nFace the massive, multi-limbed Dragon-King Beast in an epic battle. Target the creature's vulnerable mouth to land critical hits, while dodging its powerful lunges and devastating charges. Watch your progress with the dynamic health bar as you fight for victory!\n{1454993905972578}\n\n# Blazing Battle: Monster Hunt\nTake on waves of supernatural enemies, from floating purple slimes to dangerous mimic chests and cactus monsters. With a one-handed blaster, lightning strikes, and drone support, you'll need quick reflexes and powerful abilities to survive this fast-paced battle!\n{899519346390478}\n\n# Power-Up Frenzy\nCollect powerful boosts scattered throughout the desert as you battle your enemies! From meteor strikes to combat drones, these power-ups give you the edge you need to survive the relentless onslaught.\n{1468258681361222}", "short_description": "Dive into an action-packed desert adventure in Guns & Monsters! Armed with a rifle, you\u2019ll battle a variety of enemies, from red slimes to skeletal warriors, in intense VR combat. Collect power-ups, earn money, and face off against a massive reptilian boss in thrilling boss fights. Use your hands to reload, interact with the environment, and enjoy the immersive experience of combat in a bone-chilling desert landscape. Are you ready to take on the monsters?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534
i": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825345_731289393284295_3546497114042560996_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exd9pK3dC7oQ7kNvwHDdZju&_nc_oc=AdpuGK6J1mFzN0cWzyeG_vEJsyOrsHAjJldolk6ajDH1sK1gipJ268Q0yVefAxoW9gc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0GMCtICnWRqu-NZnD4cwKiCVEI17EqpG3qmKh8SgkDlw&oe=69F61B2B"}, {"file_name": "6.png", "id": "25814349501570390", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823930_25814349511570389_4690317007172507235_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bjvo5rIWcEQQ7kNvwFLySOL&_nc_oc=AdpodNL1Mr0pWtnCi__HbkZMcJAKNu-ajYmVTeepqCo8ytQpeA36UQtbT_VXG2VQUug&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wWWSyyVetq4uS7_vTgzW_9SdnTuXIdyUIHaN2ukG3wA&oe=69F6070E"}, {"file_name": "4.png", "id": "1983118219299489", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824292_1983118222632822_5596147312233709288_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jb0MO-jQd1oQ7kNvwHBlcmb&_nc_oc=Adpe7DZDQQN1aR2W5bKyqBdL3md3q4DoR-4jV82jIiD7bPemXwXQ9sG-g6HOROHpN3Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0i3s5vaAiiE8oyapk-DokxyEVCeTJ8BD76VNmCinr2MQ&oe=69F5EF7E"}, {"file_name": "5.png", "id": "1896779310972381", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820923_1896779314305714_7124677849101397633_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBhek1RBVtoQ7kNvwFSWknV&_nc_oc=AdpZXoKIVreyABbA2pcsCNirPbV3vBr-JEjUYqsu0AgGOFiw1GRbINTs4NwGBsHhSBo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KGmBrZasItFhWT1SI9Ezj8Vnfq8wnrJ5LhbeA0JUFlA&oe=69F6073F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Guns & Monsters", "keywords": ["Dragon", "monster", "Battle", "combat", "shooter"], "long_description": "# Power-Up Frenzy\nCollect powerful boosts scattered throughout the desert as you battle your enemies! From meteor strikes to combat drones, these power-ups give you the edge you need to survive the relentless onslaught.\n{1468258681361222}\n\n# Blazing Battle: Monster Hunt\nTake on waves of supernatural enemies, from floating purple slimes to dangerous mimic chests and cactus monsters. With a one-handed blaster, lightning strikes, and drone support, you'll need quick reflexes and powerful abilities to survive this fast-paced battle!\n{899519346390478}\n\n# The Dragon-King Beast Unleashed\nFace the massive, multi-limbed Dragon-King Beast in an epic battle. Target the creature's vulnerable mouth to land critical hits, while dodging its powerful lunges and devastating charges. Watch your progress with the dynamic health bar as you fight for victory!\n{1454993905972578}", "short_description": "Dive into an action-packed desert adventure in Guns & Monsters! Armed with a rifle, you\u2019ll battle a variety of enemies, from red slimes to skeletal warriors, in intense VR combat. Collect power-ups, earn money, and face off against a massive reptilian boss in thrilling boss fights. Use your hands to reload, interact with the environment, and enjoy the immersive experience of combat in a bone-chilling desert landscape. Are you ready to take on the monsters?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
imC-Nh2WGWv7okQcONMSg&oe=6A36B141"}, {"file_name": "2.png", "id": "731289389950962", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825345_731289393284295_3546497114042560996_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKAuCxG6HBEQ7kNvwEIbGF4&_nc_oc=AdoH-LGuXXkYLLW94R37BV-Ib_S1JEJv33Q71UhfcGBuKDgagqeoGp2ThX0EYhfq8Sw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ioKY761_IN1yZ2VmNhdpuM2Q94c7qsSsCrDBsvXgdtg&oe=6A36B4AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Guns&Monsters_Landscape.png", "id": "982930431350450", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499618284_982930438017116_7362928640957953725_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2U0L0ULYfoQ7kNvwF3cAHh&_nc_oc=Adoq_zn76gPSPb61Xd4ZPdQDaKksZ7ggg6UoexCsRpKPRqBPMGWXyFGPNcdf1DVwLts&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vIs1Zvesj3Q5LcQc3YyU0JOK9XZwpANuLJoDOtPyh0g&oe=6A36B969"}, "display_name": "Battle Warrior - Guns & Monsters", "keywords": ["Dragon", "monster", "Battle", "roguelike", "combat"], "long_description": "# The Dragon-King Beast Unleashed\nFace the massive, multi-limbed Dragon-King Beast in an epic battle. Target the creature's vulnerable mouth to land critical hits, while dodging its powerful lunges and devastating charges. Watch your progress with the dynamic health bar as you fight for victory!\n{1454993905972578}\n\n# Blazing Battle: Monster Hunt\nTake on waves of supernatural enemies, from floating purple slimes to dangerous mimic chests and cactus monsters. With a one-handed blaster, lightning strikes, and drone support, you'll need quick reflexes and powerful abilities to survive this fast-paced battle!\n{899519346390478}\n\n# Power-Up Frenzy\nCollect powerful boosts scattered throughout the desert as you battle your enemies! From meteor strikes to combat drones, these power-ups give you the edge you need to survive the relentless onslaught.\n{1468258681361222}", "short_description": "Dive into an action-packed roguelike desert adventure in Guns & Monsters! Armed with a rifle, you\u2019ll battle a variety of enemies, from red slimes to skeletal warriors, in intense VR combat. Collect power-ups, earn money, and face off against a massive Dragon in thrilling boss fight. Lock & Load and enjoy the immersive experience of roguelike combat. Are you ready to take on the monsters?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26803530079258836"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820855_1468616924904727_4516092301751828636_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTf_LAtVuyEQ7kNvwHuy_OH&_nc_oc=Adr1uHkJnOB_oXrJ_I5LRTLr6q9e5YHBo0fH_mWR_eEKHlC3QVbFx4yqiSvcn2MWspA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Fa2psZhzxvG9I9KvUUDe7MY3d_sScoNTjsRkqAobFdw&oe=6A36AF65"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Battle Warrior - Guns & Monsters", "platf
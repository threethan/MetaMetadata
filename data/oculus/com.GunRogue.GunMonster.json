oc=AdqE1G4tasmdt1TwRUSqHLNoTuTennq6C9JO_4pP_UamGqxByw0_0e4VbTrGh-SJb_E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3y33WdyB4KOXJgSV94qope5csr7fANAi9_iGyTmF-Iqw&oe=69F4916B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "593858738_1616824702844991_8276791469725361439_n.png", "id": "1307693197928458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618264_1307693201261791_6384249402555707096_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoQ-p3fXqCMQ7kNvwHa0v9f&_nc_oc=AdrD50JftWHQIbQFlb3O1qjYX2xUyBf79LrLyDdlyE6o6BH3-rZ5KzG85xhu6lPL5hs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0EXAhnp2X4iKeA9vosfZHnCv5aTo3jK42Me5APpYawJA&oe=69F4C70C"}, "display_name": "Guns & Monsters: Roguelike", "keywords": ["Dragon", "monster", "Battle", "roguelike", "combat"], "long_description": "# The Dragon-King Beast Unleashed\nFace the massive, multi-limbed Dragon-King Beast in an epic battle. Target the creature's vulnerable mouth to land critical hits, while dodging its powerful lunges and devastating charges. Watch your progress with the dynamic health bar as you fight for victory!\n{1454993905972578}\n\n# Blazing Battle: Monster Hunt\nTake on waves of supernatural enemies, from floating purple slimes to dangerous mimic chests and cactus monsters. With a one-handed blaster, lightning strikes, and drone support, you'll need quick reflexes and powerful abilities to survive this fast-paced battle!\n{899519346390478}\n\n# Power-Up Frenzy\nCollect powerful boosts scattered throughout the desert as you battle your enemies! From meteor strikes to combat drones, these power-ups give you the edge you need to survive the relentless onslaught.\n{1468258681361222}", "short_description": "Dive into an action-packed roguelike desert adventure in Guns & Monsters! Armed with a rifle, you\u2019ll battle a variety of enemies, from red slimes to skeletal warriors, in intense VR combat. Collect power-ups, earn money, and face off against a massive Dragon in thrilling boss fight. Lock & Load and enjoy the immersive experience of roguelike combat. Are you ready to take on the monsters?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26630583983220114"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818849_1084501297231958_5126474792391406878_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cV1ikq1v6LcQ7kNvwERGE7n&_nc_oc=AdoTDjVh3mbaiWNO4Kje4OBNOaMmQTYaAmbq36fdY8F3TTBqpE-wqBU5_-t0lzLKYgM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1NabFCp9q-mY0QAyfI1mKVTYFCEwH9KcLrIlSyI-692g&oe=69F49BDE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Guns & Monsters: Roguelike", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Action", "id":
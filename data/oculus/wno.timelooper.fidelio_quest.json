_nc_ohc=pjTTM2yI8PQQ7kNvwF4A0d5&_nc_oc=AdqCN6A6hJUZ9Wk7oH4-r-a-I-__TcJy0a3qIFoSZg3ryvcM--lKIZkutNAE3Xi5eZc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBXFFceNdimKClewqrugnVYPugBbXTQZ5rqfHYBz4z4Q&oe=6B084B95"}, {"file_name": "FidelioVR_3.png", "id": "713405346738771", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75295751_713405350072104_1466599814687883890_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuazmLmgJmYQ7kNvwGrDSuL&_nc_oc=AdrlKXUfnH16ITl7z4zzRAOCjcx8VT5iUmCwpsY4DBkI1FsBwXmmugd5EogLJvBF3iQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVbx74oAjiKfW3ql1QDXOiXA4_5G1YI3wxvnNx_yuMOg&oe=6B087060"}, {"file_name": "FidelioVR_4.png", "id": "643337413424415", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75307246_643337416757748_946780299442077138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vc057hAIXD0Q7kNvwFiPUH1&_nc_oc=AdqvExRFRVFmycHjSc3XkUM8PgolYshb8bd_TlUPITKp_Vya0pAdtY3h7uPhCvfaTc8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtmtyN7ClgwuG0Z0rmwQHX8XazfpJxz4y9n8NWS-x0DA&oe=6B084806"}, {"file_name": "FidelioVR_5.png", "id": "454799346390441", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75326678_454799349723774_5456456388540509282_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeH0-40zJXcQ7kNvwH3576S&_nc_oc=Adqdov1syT2x5VSTAP_dsXYfZQKa5toRmEjn2rHwcXIviPZYvcpEU9p2nE2ghljUMVc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0bh6bKNxd0Wz2hgbjGWrS9UY-Q6Q5HOTDDxlU1s0kLA&oe=6B086E99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fidelio-cover.png", "id": "1313813982691058", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003244_1313813986024391_5307810802291182721_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzoWKUOqh9AQ7kNvwHNRoz5&_nc_oc=AdpSpiV_9pIhDfIiW4cHZhmuTFPEPMMPu__fk7_pZgoKQLIWxcCSiPCq-noY8tr_2ms&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRokjX1iivNBrlJKd-t3URsJ73HuAktJFUEhFH1P8wZOg&oe=6B085E4A"}, "display_name": "WNO | Beethoven in VR", "keywords": [], "long_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister. In a secret underground cell, political prisoner Florestan suffers under tyrant prison governor Don Pizarro. But a light in the darkness is breaking: Leonore, Florestan\u2019s wife, has disguised herself as male guard Fidelio for the ultimate undercover mission. By infiltrating the very system that oppresses her husband, can she be the voice that overthrows it? Beethoven premiered this story of resistance, freedom, and dissent during a time of complete European upheaval. If his \u201cOde to Joy\u201d declares the universal triumph of peace over war, then his Fidelio is an inspiring ode to love\u2019s transcendent power over tyranny.", "short_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.timelooper.com/vr-privacy-policy", "developer_terms_of_service_url": "https://cdn.timelooper.com/wno/WNO_Fidelio_TermsofService.pdf", "publisher_name": "TimeLooper", "support_website_url": null, "website_url": "https://www.timelooper.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfo
_nc_ohc=1WkTW7zRC90Q7kNvwGtIp-U&_nc_oc=AdoZh48f0wFh_pV4tFcfvL4XM_7q0em9JshIB7RDXWTF4PcOJ-_9xpc7L_o910SQXwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKNJiF6xx3VotabtGCcL9jRkycodT-i09v5cB8Tc9XHA&oe=6B0C7855"}, {"file_name": "FidelioVR_3.png", "id": "713405346738771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295751_713405350072104_1466599814687883890_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VR3_h3YffsQ7kNvwG6NptP&_nc_oc=AdpyatgVfgocmy0eS7nOyMbv-Z5NBINW2AsBYTnwCw7hpnrLC3ld2ijxTW_wvfPp6ok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS3OrNA8GsBaXGii-tdd_gjk57yzl93_DI_ADB3YGhtSw&oe=6B0C64E0"}, {"file_name": "FidelioVR_4.png", "id": "643337413424415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307246_643337416757748_946780299442077138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5J9cu_axXoQ7kNvwE-jBgI&_nc_oc=AdoQl6kyeV9Coz3iBp_KaXSQ8SwlQC3gnv8a5pER0TUdWQtDiONCQMy9U8AwjnDJOO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQpg_uOWYIN7_nyE9ise-QC5d9MnQJIWfjQYiTyVTbmTw&oe=6B0C74C6"}, {"file_name": "FidelioVR_5.png", "id": "454799346390441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75326678_454799349723774_5456456388540509282_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saqcrwrx82wQ7kNvwGAI5_1&_nc_oc=AdrTzKRI4_KPhCGJLl8dkIcZJdR-xSeu-jmC1DSvUtZZIw0s5eKKkJzdDZ2bd7rLFa4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNR_HtKEi9mDLT8rFo0QuF8sLKfY9zW6a59a9FgYpCLQ&oe=6B0C6319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fidelio-cover.png", "id": "1313813982691058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_1313813986024391_5307810802291182721_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUi7HDAGe1gQ7kNvwEyUM8n&_nc_oc=Adpxhmj7j4AOeHtjJe0pGyENxkx3YLUKqshamMyb73KiSLNHTZyhBXx1ro3Iu9dWeZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuZ9V6VzwSK1aI8F1epLoa3rIYAgqnVnqDDXNnLbP85g&oe=6B0C52CA"}, "display_name": "WNO | Beethoven in VR", "keywords": [], "long_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister. In a secret underground cell, political prisoner Florestan suffers under tyrant prison governor Don Pizarro. But a light in the darkness is breaking: Leonore, Florestan\u2019s wife, has disguised herself as male guard Fidelio for the ultimate undercover mission. By infiltrating the very system that oppresses her husband, can she be the voice that overthrows it? Beethoven premiered this story of resistance, freedom, and dissent during a time of complete European upheaval. If his \u201cOde to Joy\u201d declares the universal triumph of peace over war, then his Fidelio is an inspiring ode to love\u2019s transcendent power over tyranny.", "short_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.timelooper.com/vr-privacy-policy", "developer_terms_of_service_url": "https://cdn.timelooper.com/wno/WNO_Fidelio_TermsofService.pdf", "publisher_name": "TimeLooper", "support_website_url": null, "website_url": "https://www.timelooper.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfo
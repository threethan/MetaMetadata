_nc_ohc=OnQUcgS3SAcQ7kNvwG6DhSa&_nc_oc=AdrpDD9cQuGLhMGw8hzqK3mBcchRVKZzO5qiy0kS4cQD5bSX4kfoxE7y5kd4b_TQjO8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMm8VwCvbriQqrZZV0Weu7VljVocNUWf5XhWYbCfpFJg&oe=6AFDBF95"}, {"file_name": "FidelioVR_3.png", "id": "713405346738771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295751_713405350072104_1466599814687883890_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teX5aAhtjV4Q7kNvwFe5cXk&_nc_oc=Adpv87tVBU4Ea-An2nvIKTYpeQncglYDm5gAkrPBSkvpVeF6_LjDl18PcJa36KZhowM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIdKjwTanA3EwszVAHZM1HEHzBB6Ov4ZjFuvKgt14p8w&oe=6AFDE460"}, {"file_name": "FidelioVR_4.png", "id": "643337413424415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75307246_643337416757748_946780299442077138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkfk_C3oaWIQ7kNvwH_zlHd&_nc_oc=Ados2acZBResUqGT32b5Rnp7ibV4r5qxqBX56ev7vT1qMyg5TG8p08Vf79fcVPZrpoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkKTOhonY1ssQ79N6iyoAQ9O3dIv9z-arCy3V9clhOnw&oe=6AFDBC06"}, {"file_name": "FidelioVR_5.png", "id": "454799346390441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75326678_454799349723774_5456456388540509282_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgnZXQ_m8EYQ7kNvwGcDn1z&_nc_oc=AdrIB5NdfRc6xzZMWDbAZVu4jJNcHvVzzi1r5vbThsQxaAHk0G3tl8gg5AOpAZUMSzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1r98KUxbQ6F9xrGrLvxYCd4Zp3XWF4yt2hvzaAg71IA&oe=6AFDE299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fidelio-cover.png", "id": "1313813982691058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003244_1313813986024391_5307810802291182721_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETdrDeUiNV8Q7kNvwFFF1pS&_nc_oc=Adp2cBnBcBvefr83buWlafE5qeDaPjt9Sn5K3x4TC0po9H7AiOhm2Im9G_aPRM4vFvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWvNk1rZit8W51O0oOuvvL-eUL3fhuA7m3ygbwX42unQ&oe=6AFDD24A"}, "display_name": "WNO | Beethoven in VR", "keywords": [], "long_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister. In a secret underground cell, political prisoner Florestan suffers under tyrant prison governor Don Pizarro. But a light in the darkness is breaking: Leonore, Florestan\u2019s wife, has disguised herself as male guard Fidelio for the ultimate undercover mission. By infiltrating the very system that oppresses her husband, can she be the voice that overthrows it? Beethoven premiered this story of resistance, freedom, and dissent during a time of complete European upheaval. If his \u201cOde to Joy\u201d declares the universal triumph of peace over war, then his Fidelio is an inspiring ode to love\u2019s transcendent power over tyranny.", "short_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.timelooper.com/vr-privacy-policy", "developer_terms_of_service_url": "https://cdn.timelooper.com/wno/WNO_Fidelio_TermsofService.pdf", "publisher_name": "TimeLooper", "support_website_url": null, "website_url": "https://www.timelooper.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfo
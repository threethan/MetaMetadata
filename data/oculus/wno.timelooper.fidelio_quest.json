_nc_ohc=hMoVTWD1kA0Q7kNvwHo8J8v&_nc_oc=AdqVKb4vwavVFCUYIlFXKXvDjeN1PX-nhnU4Ntv-zZOGW_H-tNEM5sWPSelyNfzKurI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRedD8sVqu4rvxUQ-6aSDGJRrBudiopLcv9WyvcvRvqig&oe=6B0DC9D5"}, {"file_name": "FidelioVR_3.png", "id": "713405346738771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295751_713405350072104_1466599814687883890_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VR3_h3YffsQ7kNvwHyE-5O&_nc_oc=AdqhwqoCJQGROHruE1iSc9X5_hEvqbwIaJb-a6ZyDP93nRCvOJU3jxa9YINHNJl3xF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfbZwf90yO6ijyyQk2uj121n1K9Ci0BmmpeZIz-ex-0w&oe=6B0DB660"}, {"file_name": "FidelioVR_4.png", "id": "643337413424415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75307246_643337416757748_946780299442077138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5J9cu_axXoQ7kNvwFsBxy8&_nc_oc=Adp9yJhmIq0x1xOPkK0zk-gfxqM1g5zd0IU1RJkbF1N2K2b08MmNR9bpJiDPbWVMi6s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsg4dpyg_tHcCy2CEAfG7wTmfRzi0-bt7pWV2DBbmj6Q&oe=6B0DC646"}, {"file_name": "FidelioVR_5.png", "id": "454799346390441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75326678_454799349723774_5456456388540509282_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saqcrwrx82wQ7kNvwHeurPZ&_nc_oc=AdoeNW8YUbIwtcNDYaVi4BAFbnRAcJ4nlsywXiYwRzU5PCyVu42Vn1hqjjDrlbB7U7s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMzi_MNvWaM0HDA913wb7q3tn-AC_Xd6-BD86ITKvKNg&oe=6B0DB499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fidelio-cover.png", "id": "1313813982691058", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003244_1313813986024391_5307810802291182721_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUi7HDAGe1gQ7kNvwHPA85s&_nc_oc=Adqi0EyKdIYPjLdIDE_8zY5LWhX-8jAsjEnV9HrXEa3hBHG-Ygwtp3Je7ZUQ2ItS8b4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuDglpAGIdUKMuXbOZoupwvdeB7CzjhmwZ3-Nl94GOhA&oe=6B0DA44A"}, "display_name": "WNO | Beethoven in VR", "keywords": [], "long_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister. In a secret underground cell, political prisoner Florestan suffers under tyrant prison governor Don Pizarro. But a light in the darkness is breaking: Leonore, Florestan\u2019s wife, has disguised herself as male guard Fidelio for the ultimate undercover mission. By infiltrating the very system that oppresses her husband, can she be the voice that overthrows it? Beethoven premiered this story of resistance, freedom, and dissent during a time of complete European upheaval. If his \u201cOde to Joy\u201d declares the universal triumph of peace over war, then his Fidelio is an inspiring ode to love\u2019s transcendent power over tyranny.", "short_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.timelooper.com/vr-privacy-policy", "developer_terms_of_service_url": "https://cdn.timelooper.com/wno/WNO_Fidelio_TermsofService.pdf", "publisher_name": "TimeLooper", "support_website_url": null, "website_url": "https://www.timelooper.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfo
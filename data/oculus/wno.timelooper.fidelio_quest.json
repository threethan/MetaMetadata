e": "FidelioVR_2.png", "id": "738580494182259", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982678_738580497515592_8808459678840508958_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OnQUcgS3SAcQ7kNvwG6DhSa&_nc_oc=AdrpDD9cQuGLhMGw8hzqK3mBcchRVKZzO5qiy0kS4cQD5bSX4kfoxE7y5kd4b_TQjO8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMm8VwCvbriQqrZZV0Weu7VljVocNUWf5XhWYbCfpFJg&oe=6AFDBF95"}, {"file_name": "FidelioVR_3.png", "id": "713405346738771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75295751_713405350072104_1466599814687883890_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teX5aAhtjV4Q7kNvwFe5cXk&_nc_oc=Adpv87tVBU4Ea-An2nvIKTYpeQncglYDm5gAkrPBSkvpVeF6_LjDl18PcJa36KZhowM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIdKjwTanA3EwszVAHZM1HEHzBB6Ov4ZjFuvKgt14p8w&oe=6AFDE460"}, {"file_name": "FidelioVR_4.png", "id": "643337413424415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75307246_643337416757748_946780299442077138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkfk_C3oaWIQ7kNvwH_zlHd&_nc_oc=Ados2acZBResUqGT32b5Rnp7ibV4r5qxqBX56ev7vT1qMyg5TG8p08Vf79fcVPZrpoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkKTOhonY1ssQ79N6iyoAQ9O3dIv9z-arCy3V9clhOnw&oe=6AFDBC06"}, {"file_name": "FidelioVR_5.png", "id": "454799346390441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75326678_454799349723774_5456456388540509282_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgnZXQ_m8EYQ7kNvwGcDn1z&_nc_oc=AdrIB5NdfRc6xzZMWDbAZVu4jJNcHvVzzi1r5vbThsQxaAHk0G3tl8gg5AOpAZUMSzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1r98KUxbQ6F9xrGrLvxYCd4Zp3XWF4yt2hvzaAg71IA&oe=6AFDE299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FidelioVR_3.png", "id": "498378238432715", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_498378245099381_8998595087939118040_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_NAK6GRxvMQ7kNvwHY__S-&_nc_oc=AdpHl7u8wSPVWHMAnPQLcESAfxgQbB8E4s0uOIttPgCyVTi4rqjkoVtevarfNabMOOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZlpVSPU49cd1ej5HdszNzKUCZwe5Ljqjs6SkffxoYVg&oe=6AFDD014"}, "display_name": "WNO - Fidelio", "keywords": [], "long_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister. In a secret underground cell, political prisoner Florestan suffers under tyrant prison governor Don Pizarro. But a light in the darkness is breaking: Leonore, Florestan\u2019s wife, has disguised herself as male guard Fidelio for the ultimate undercover mission. By infiltrating the very system that oppresses her husband, can she be the voice that overthrows it? Beethoven premiered this story of resistance, freedom, and dissent during a time of complete European upheaval. If his \u201cOde to Joy\u201d declares the universal triumph of peace over war, then his Fidelio is an inspiring ode to love\u2019s transcendent power over tyranny.", "short_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.timelooper.com/vr-privacy-policy", "developer_terms_of_service_url": "https://cdn.timelooper.com/wno/WNO_Fidelio_TermsofService.pdf", "publisher_name": "TimeLooper", "support_website_url": null, "website_url": "https://www.timelooper.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MOVIE", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "725785565228026"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "694434348283362"}]}, "baseline_offer": {"id": "694434348283362"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1651161300, "status": "PUBLISHED", "id": "694434348283362"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5809259935752148", "version": "5.5"}, "id": "4439779249386984", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4561659987178822", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5809259935752148"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4439779249386984"}]}, "change_log": null, "created_date": 1660671410, "id": "5809259935752148", "version": "5.5", "version_code": 45, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []
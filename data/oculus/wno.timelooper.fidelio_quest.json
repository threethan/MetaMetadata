_nc_ohc=NNW2LXyu7asQ7kNvwGzM5NC&_nc_oc=Adqew0WGmKWCTJIopeRuZkS-1HmGWR9uCfxaIm5pfN_a9PF7saYmXzq-jm8qeLuEoAI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaX1ZEeMQuXJF4wMsEcN7Y6VOCX5PbNN7vpUyr2iceSw&oe=6B01EC55"}, {"file_name": "FidelioVR_3.png", "id": "713405346738771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295751_713405350072104_1466599814687883890_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MI1dX3aBpv0Q7kNvwFenlhL&_nc_oc=AdqfFeUyTSD_t2vpouLHS_WZTSxf0IoWGyKVeqvAcxbjIbg4l8tKcpVOOf9-WC_Ssys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwVqqGvOHEDxduk1uXUj-4ieq34EEyzRckuGH-GRarJw&oe=6B01D8E0"}, {"file_name": "FidelioVR_4.png", "id": "643337413424415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307246_643337416757748_946780299442077138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2TElRAfTY8Q7kNvwHbLILC&_nc_oc=AdqcYrAy7QLJMwp_T_9Cp-khu3O47GojaRjhu30-ujjaa2FUc84iDHHDMA35cc5dlXQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuMTjTN6i_XS5tF7qpwu0z8jCrlI6MHn-fp_F6xU7qmg&oe=6B01E8C6"}, {"file_name": "FidelioVR_5.png", "id": "454799346390441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75326678_454799349723774_5456456388540509282_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_bMSQc-VmUQ7kNvwE68gxy&_nc_oc=AdqYt-jo_lJz5LHRs3gmsyMuSZkeNakSSAw-04BBYgQbqWVfuBfH43YA5AXJ9VV3V8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqbKz51rH1yzkRwbptG82aVC26debQp1lCPZTZMcAppQ&oe=6B01D719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fidelio-cover.png", "id": "1313813982691058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_1313813986024391_5307810802291182721_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lToOF8XPimQQ7kNvwHVgIgq&_nc_oc=AdppBy22jeY_TfDFpDq12Rxu_PkStd59Z72W8vH_4_d8yQK5LujFa8ElojhX_iEtAu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6b8PFqhh29XsnrH3277Zrv6hSXIZblgDNBSFJbGzxig&oe=6B01C6CA"}, "display_name": "WNO | Beethoven in VR", "keywords": [], "long_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister. In a secret underground cell, political prisoner Florestan suffers under tyrant prison governor Don Pizarro. But a light in the darkness is breaking: Leonore, Florestan\u2019s wife, has disguised herself as male guard Fidelio for the ultimate undercover mission. By infiltrating the very system that oppresses her husband, can she be the voice that overthrows it? Beethoven premiered this story of resistance, freedom, and dissent during a time of complete European upheaval. If his \u201cOde to Joy\u201d declares the universal triumph of peace over war, then his Fidelio is an inspiring ode to love\u2019s transcendent power over tyranny.", "short_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.timelooper.com/vr-privacy-policy", "developer_terms_of_service_url": "https://cdn.timelooper.com/wno/WNO_Fidelio_TermsofService.pdf", "publisher_name": "TimeLooper", "support_website_url": null, "website_url": "https://www.timelooper.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfo
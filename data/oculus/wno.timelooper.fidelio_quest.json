_nc_ohc=hMoVTWD1kA0Q7kNvwGF6MGT&_nc_oc=AdoRymLp8zCs5hnRG86X2Bxp1A5q9keW4rpO_2sfrhMAsW54efbTNrZOCHsUmHdELDQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWtvedLtg6p3Nh8Sgd68X5P677iSius1hXp5pFnSqkFrw&oe=6B0F1B55"}, {"file_name": "FidelioVR_3.png", "id": "713405346738771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75295751_713405350072104_1466599814687883890_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VR3_h3YffsQ7kNvwE1xT1Z&_nc_oc=AdqtDBIlQhRjqEPyx98Glfy3FMvr1OMC-SUA1n-FibjTO0Dbm_zQtf9hi5ij916Pwl8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXemDzocNU0Bkueh1Rd_MJbam7je5OoDkEKPF1mXDvlcQ&oe=6B0F07E0"}, {"file_name": "FidelioVR_4.png", "id": "643337413424415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307246_643337416757748_946780299442077138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vcF5Zjm9swQ7kNvwEwPJ4J&_nc_oc=AdrmLAe4SBTaXNIp0V71ohs2RjTK3HuGpELlFaEjSaKeqNGaHzjWey_nJIrsHSe0n6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWAamGYaer9DZ6QoXpPXptVHFn_PVvcUvRioRlhSSo4wg&oe=6B0F17C6"}, {"file_name": "FidelioVR_5.png", "id": "454799346390441", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75326678_454799349723774_5456456388540509282_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC9elzRBWv8Q7kNvwG044Qy&_nc_oc=AdrrVuKqAiXSh68STR5mEDcaY-AukTyhLLXPegq47EGc42J9fsAR9buSunsttwe9bt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVygt0HQqyfIv8EvAA4aNNEq6o6KGC98RXxJCE5lD_rKA&oe=6B0F0619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fidelio-cover.png", "id": "1313813982691058", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003244_1313813986024391_5307810802291182721_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkyjJS26DQAQ7kNvwGf91CA&_nc_oc=Adoesk5xke15aupoBlvnJSXy1OrAXvlPXdby7GDBhfAbX0rGsx96LMFWMtbzybUIYEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVjGprUxJovZZm42-UcvJhDcfIAwSwof7To1eq5YsFxWA&oe=6B0EF5CA"}, "display_name": "WNO | Beethoven in VR", "keywords": [], "long_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister. In a secret underground cell, political prisoner Florestan suffers under tyrant prison governor Don Pizarro. But a light in the darkness is breaking: Leonore, Florestan\u2019s wife, has disguised herself as male guard Fidelio for the ultimate undercover mission. By infiltrating the very system that oppresses her husband, can she be the voice that overthrows it? Beethoven premiered this story of resistance, freedom, and dissent during a time of complete European upheaval. If his \u201cOde to Joy\u201d declares the universal triumph of peace over war, then his Fidelio is an inspiring ode to love\u2019s transcendent power over tyranny.", "short_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.timelooper.com/vr-privacy-policy", "developer_terms_of_service_url": "https://cdn.timelooper.com/wno/WNO_Fidelio_TermsofService.pdf", "publisher_name": "TimeLooper", "support_website_url": null, "website_url": "https://www.timelooper.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfo
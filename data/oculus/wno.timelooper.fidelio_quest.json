_nc_ohc=1WkTW7zRC90Q7kNvwEeoiN7&_nc_oc=Adqh8XNKCcDjFuogVpXIiFuzcwehSqKU2Sa0PHk6FDk9lHTk20sJE08eM08554gcrWk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR389w47_W7tO65HrTtBNr5x8AwaVW7q78O8_EI_pE7wg&oe=6B0B26D5"}, {"file_name": "FidelioVR_3.png", "id": "713405346738771", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75295751_713405350072104_1466599814687883890_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuazmLmgJmYQ7kNvwFpaTIW&_nc_oc=AdqHjMIDjqal5TuIHipW_gmXl7ryilc5zl0fVUVLf8DSMBsCQEQaXf_uBZ9AZp4j-_o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAGFh65z86Iilj1EaFOlt0cY4Sgx3-5E5hSMqa-oFwuA&oe=6B0B1360"}, {"file_name": "FidelioVR_4.png", "id": "643337413424415", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75307246_643337416757748_946780299442077138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5J9cu_axXoQ7kNvwEL3Mg_&_nc_oc=Adq_A9p22XaLrFO5THuwN03yEcAhaXmc7iOblFfvhYN42S8mlom5Ew1YsAF7cqnCsWw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1VVWhOSrhuaIksn2cst6qIWsW5SusGq3_Yvbt-2ZCjg&oe=6B0B2346"}, {"file_name": "FidelioVR_5.png", "id": "454799346390441", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75326678_454799349723774_5456456388540509282_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saqcrwrx82wQ7kNvwEV1H5V&_nc_oc=AdrmKOriyQ0h9lMnh8aohd6CSVn2cP0ARkbo-1CHLkW11Iqo4biQTY1BjZnbm_Tp4vc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPg4hZ39yD65u1Sy2cS2jd48vJrvenkdxcCSWeYQSQGg&oe=6B0B1199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fidelio-cover.png", "id": "1313813982691058", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003244_1313813986024391_5307810802291182721_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUi7HDAGe1gQ7kNvwFsG1ub&_nc_oc=AdoiyRxGyIzWMJnpvQc-sVF7gyVrAelxOrDl2CjirwQXHs6NGXlCXXIDtbrLTAJPnm4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSXgYJJvYLR0mtK2OWa5TvpIeRnyMrEIVUMq1IP0e5_w&oe=6B0B398A"}, "display_name": "WNO | Beethoven in VR", "keywords": [], "long_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister. In a secret underground cell, political prisoner Florestan suffers under tyrant prison governor Don Pizarro. But a light in the darkness is breaking: Leonore, Florestan\u2019s wife, has disguised herself as male guard Fidelio for the ultimate undercover mission. By infiltrating the very system that oppresses her husband, can she be the voice that overthrows it? Beethoven premiered this story of resistance, freedom, and dissent during a time of complete European upheaval. If his \u201cOde to Joy\u201d declares the universal triumph of peace over war, then his Fidelio is an inspiring ode to love\u2019s transcendent power over tyranny.", "short_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.timelooper.com/vr-privacy-policy", "developer_terms_of_service_url": "https://cdn.timelooper.com/wno/WNO_Fidelio_TermsofService.pdf", "publisher_name": "TimeLooper", "support_website_url": null, "website_url": "https://www.timelooper.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfo
_nc_ohc=GnciW1FUodsQ7kNvwFMv7g3&_nc_oc=AdqQi7McaBduqaUJLTbq5gAoHtBty2YJ_qzYQ1JbSkiVfOulUqZUiEGzAXgVcLmb5Z4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQSajNy8ePBrVf4KnReZxckQkr8UgVKGh4ptd0wUVh7A&oe=6AFC6E15"}, {"file_name": "FidelioVR_3.png", "id": "713405346738771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75295751_713405350072104_1466599814687883890_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teX5aAhtjV4Q7kNvwEfdDQ6&_nc_oc=AdqDq9piyjkq5gSGNPVCOpetysKPdBbrlgYO0GUQGOYxp6WnEyLSSo0i2QhBxaxrhys&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-tucMyrbN0y6zAudv6rsUiCZAGj-8XJ1Od6XCt3rm1w&oe=6AFC92E0"}, {"file_name": "FidelioVR_4.png", "id": "643337413424415", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75307246_643337416757748_946780299442077138_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkfk_C3oaWIQ7kNvwEvLbaH&_nc_oc=Adrp5X9nyI0_CIOJRDkSRTxtWi4awCMCDE-2kxFGbkmwu96J96w7TsIjGY5FhLI4roc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_UXwUeGRGjPl1YZY0rTnYiu9jXlJKF7cophZWpoufog&oe=6AFC6A86"}, {"file_name": "FidelioVR_5.png", "id": "454799346390441", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75326678_454799349723774_5456456388540509282_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgnZXQ_m8EYQ7kNvwEUKEZ3&_nc_oc=AdofWjfmKMSPd6DoDgRRMZrbNfJCDW5yGMXfOpruUFffOBcN2EHXSgK-OB-LHkoiO2w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJwc8DtFCNd8zvScnA4dpKgx3_2Xzb3TxI8mJaIsiPTg&oe=6AFC9119"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "fidelio-cover.png", "id": "1313813982691058", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003244_1313813986024391_5307810802291182721_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ETdrDeUiNV8Q7kNvwG0CZzv&_nc_oc=AdrQPFAs2u6JwNXonV7UwhQY83iY8JgwHwLmgv1r7Kr0nqrhoLfTUIZkQlmHkgnApOM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSnqiVh_MeSS4SuMDrOUjf0e1PE9QUmbNyoAYc243sLA&oe=6AFC80CA"}, "display_name": "WNO | Beethoven in VR", "keywords": [], "long_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister. In a secret underground cell, political prisoner Florestan suffers under tyrant prison governor Don Pizarro. But a light in the darkness is breaking: Leonore, Florestan\u2019s wife, has disguised herself as male guard Fidelio for the ultimate undercover mission. By infiltrating the very system that oppresses her husband, can she be the voice that overthrows it? Beethoven premiered this story of resistance, freedom, and dissent during a time of complete European upheaval. If his \u201cOde to Joy\u201d declares the universal triumph of peace over war, then his Fidelio is an inspiring ode to love\u2019s transcendent power over tyranny.", "short_description": "Beethoven in Virtual Reality, directed by Francesca Zambello. Tamara Wilson and Russell Thomas perform two masterpieces from Beethoven\u2019s only opera, Fidelio\u2014including Leonore\u2019s aria \u201cKomm, Hoffnung\u201d (Come, Hope)\u2014accompanied in 360-degree audio by the Washington National Opera Orchestra, conducted by Principal Conductor Evan Rogister."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.timelooper.com/vr-privacy-policy", "developer_terms_of_service_url": "https://cdn.timelooper.com/wno/WNO_Fidelio_TermsofService.pdf", "publisher_name": "TimeLooper", "support_website_url": null, "website_url": "https://www.timelooper.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfo
t-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eNpfx8NEYEVKzU72mK9Fdo8Eu5AwkI0PjS9zszmRI9Q&oe=69D5176D"}, {"file_name": "Tophat.png", "id": "858023171586433", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_858023174919766_1312162633865839656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYhNDrDL-dAQ7kNvwFXz7-_&_nc_oc=AdrPZOcSTwgY4OaKT_0wmbCthW0uqO3y4WkxrWbJs_-S_fPQGzOWwonIkqsgGvqOphE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aSPMV-47E3EsSp1tsdwjMv5UEhpPTFp3pxyqaXeIhgQ&oe=69D508FD"}, {"file_name": "Menu.png", "id": "348608176867230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_348608180200563_6060700511899341453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrbuP6XAWQsQ7kNvwEKDfrg&_nc_oc=AdpABrDD0zaoBRUYiGh_1OEc36HmD6G--Dk-uJsWd9sbYYFWbw7RHkB8uzNwNkSuPtE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33O-FeqPLLbQBZHaJHvARZ5xvZSDkEKC_jPul_eh9_Ig&oe=69D4E5E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bricksthumbnail-clean-large.png", "id": "1074970913243281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974878_1074970916576614_3490804942913616657_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtXXLUa-KJIQ7kNvwFSeZd5&_nc_oc=Adp4HxQIUgSPW-Ack-WvdJyCIED5moQMhSOlLhq9P-UrvMfcyH8XsIiBh6DXOohqsKU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HUeAEoPbp9wZnI8UQPi9sNTwOjrwWAZln1ByE6TV7oQ&oe=69D50EBB"}, "display_name": "BricksVR", "keywords": [], "long_description": "BricksVR is a multiplayer sandbox building game in VR in early access.\n\n- Invite friends to a shared world and build creations together. Shared worlds include voice chat, physics, and the ability to save progress.\n- You're not limited by what's in the box in BricksVR. Place thousands of bricks on mobile VR with no lag, and choose from over 16 million brick colors.\n- Wander around your builds from the perspective of a miniature person, or stomp around and chase others as a giant!\n- Open your world to the public to show off your creations. You can also lock your world so visitors can't make changes.", "short_description": "BricksVR is a multiplayer sandbox building game in VR in early access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bricksvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "BricksVR Studios Inc.", "support_website_url": null, "website_url": "https://bricksvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "454232459568442"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974781_1151057708650253_8305288702707347772_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cidc4A2h8UUQ7kNvwE5CpzU&_nc_oc=Adrd9OB9P2AkqPawX5fV1EhiqvP9mtWKfntyUWm4E9dM7GKFz2DRD-6YjXclTXsLy_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T6c3UEoZ2rI2JWYU8INLW4SAIpkwNYqQGioFKgYqo4Q&oe=69D4E98F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BricksVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": 
t-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Nn6zyEBUCAArJs1e-zDFw77rn-3JKYMelHh42Vr6Ypw&oe=6A0F196D"}, {"file_name": "Tophat.png", "id": "858023171586433", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031396_858023174919766_1312162633865839656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFvdz7WUQx0Q7kNvwHChBqz&_nc_oc=Adok8Z07iRTm7hQ6yhYwVP8aqYKQgAnCDkNE25tXJydAxcK6X5kDoU02IM2g4RL51os&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wWYpBcJJY7SL5JVtot-9Mdd10PhcT7TtVe69lkGPCiA&oe=6A0F0AFD"}, {"file_name": "Menu.png", "id": "348608176867230", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974444_348608180200563_6060700511899341453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvSqH37S3hIQ7kNvwEt6Eau&_nc_oc=Adpu_kXg2BMUT-Ecd2HSJQL-7p8eG14U0o-gZS-TAwnTYDP107ZhjKKfI7MBfV7hFtA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ilwnpae5r7I7t9IHlIC1ptyT3cKH95qZooa4yCiZFUQ&oe=6A0F2026"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bricksthumbnail-clean-large.png", "id": "1074970913243281", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974878_1074970916576614_3490804942913616657_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-YqUCIbOwUQ7kNvwGI2mND&_nc_oc=Adq7UvrU4cnu2P5dV9usxXKhM9b0wh-xk4wucdAdnToRGY02UNjiuCE0f7-w1mlSvoQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vuN2k5F98B7gsJuGKQcLSkAxXqJlvBiHJcChahO-u6g&oe=6A0F10BB"}, "display_name": "BricksVR", "keywords": [], "long_description": "BricksVR is a multiplayer sandbox building game in VR in early access.\n\n- Invite friends to a shared world and build creations together. Shared worlds include voice chat, physics, and the ability to save progress.\n- You're not limited by what's in the box in BricksVR. Place thousands of bricks on mobile VR with no lag, and choose from over 16 million brick colors.\n- Wander around your builds from the perspective of a miniature person, or stomp around and chase others as a giant!\n- Open your world to the public to show off your creations. You can also lock your world so visitors can't make changes.", "short_description": "BricksVR is a multiplayer sandbox building game in VR in early access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bricksvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "BricksVR Studios Inc.", "support_website_url": null, "website_url": "https://bricksvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "454232459568442"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974781_1151057708650253_8305288702707347772_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3IpsLXXpnwQ7kNvwFWT-9t&_nc_oc=Adp_qvmyVlk9_Mut7E5p2zP0Ham93FWFPXLoFX8pAl_R4lUgBkN4aGtqfhgNY1QcVxg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v6yzIVNcg-PQL69Iu2dG352G32E6ndkhyT5YA13KbtA&oe=6A0F23CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BricksVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": 
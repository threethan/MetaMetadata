t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX7Haf1gDDAATCu93XrNUzZDNWJPHEP_sAsmSFO-lTxg&oe=6A7B346D"}, {"file_name": "Tophat.png", "id": "858023171586433", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_858023174919766_1312162633865839656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ps5soDAOGsQ7kNvwEuxrig&_nc_oc=Adqk88ZSXe_4glrl2CQ6OGQc69m4UWVL_5IspaKp_M2x8Jpj1Rg8a8TX6XjpZrsBUDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzl1Zlz6Q_rUr1j37rQJ1e5Y-NJXXNFjPPzObTEJioug&oe=6A7B25FD"}, {"file_name": "Menu.png", "id": "348608176867230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_348608180200563_6060700511899341453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axmqZZiOyscQ7kNvwF70pfy&_nc_oc=Adpl4F5zhNboJ4l6pA_UkOO272EbpOn31menhWOvIEmcamExS_8QI1rGDI6_YyvmaO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1HyoLBPmtF01jL6JyMH1tdpAR-bmZeFiuplrgDVhJCQ&oe=6A7B3B26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bricksthumbnail-clean-large.png", "id": "1074970913243281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_1074970916576614_3490804942913616657_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rH49JlZwKSQQ7kNvwGfpdmM&_nc_oc=Adp_RMqPz-s0fpgnmCYTxXySoYD1san3UiBT3uY8Z3UfkDl43HoamP_IBAlM6o7qVwo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbtpn_9mQ6w6RzTkiZqfUC-UC889R13tUQHp-IuO8KJQ&oe=6A7B2BBB"}, "display_name": "BricksVR", "keywords": [], "long_description": "BricksVR is a multiplayer sandbox building game in VR in early access.\n\n- Invite friends to a shared world and build creations together. Shared worlds include voice chat, physics, and the ability to save progress.\n- You're not limited by what's in the box in BricksVR. Place thousands of bricks on mobile VR with no lag, and choose from over 16 million brick colors.\n- Wander around your builds from the perspective of a miniature person, or stomp around and chase others as a giant!\n- Open your world to the public to show off your creations. You can also lock your world so visitors can't make changes.", "short_description": "BricksVR is a multiplayer sandbox building game in VR in early access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bricksvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "BricksVR Studios Inc.", "support_website_url": null, "website_url": "https://bricksvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "454232459568442"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974781_1151057708650253_8305288702707347772_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBFOBspFudcQ7kNvwGDoTjs&_nc_oc=AdodWbz2NNpEql7UWSbQglF3TQHNrwyxFqaEcRVCdA7qC4UgIpDpGw20KhLjqnlDthA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI-LW4d2iupaSIsFhecF77tiRElCdjvh5rFVIK-fnYxQ&oe=6A7B068F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BricksVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": 
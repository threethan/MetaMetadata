t-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfo0UUZTxr5wIQZGLckwWjnZWjSUDMrMeI65dirOQcBg&oe=6AD2376D"}, {"file_name": "Tophat.png", "id": "858023171586433", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031396_858023174919766_1312162633865839656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_I7GCkK31wQ7kNvwH3LFut&_nc_oc=Ado19oKaOsYH4sme7kt5DAuvlDMWTz8rbdd7D-rL3I0nOf5FHMO9hp5ASEqRlcIv9qU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlOTDruIOQebSNXvZr-fsfRG40BiwnTd5HTjTLjhI6lg&oe=6AD228FD"}, {"file_name": "Menu.png", "id": "348608176867230", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974444_348608180200563_6060700511899341453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT7QIwToPMEQ7kNvwHRSwa6&_nc_oc=AdrSls7lz6NXAt5qDqgPkU4lIKQDvzq1M7Mn0pJGIsIhDWH8nnUj1-KWt7Fd4Zudsi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYMDkv35V86fjiM435s0BuouBuudmaKRt7QlVtfDOZOg&oe=6AD23E26"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bricksthumbnail-clean-large.png", "id": "1074970913243281", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974878_1074970916576614_3490804942913616657_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBOSIqjbpWMQ7kNvwE8l_ui&_nc_oc=AdrcXmAnGh_AZx3syWBGr8sTo_FETEj_L3JYkQ0YMDmjjlPDVLbno1vU9F-HAkAvzwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbKUqPqmb-FEFn3c6EVtP4JkRyywZ4zWdZAH43q0RZOQ&oe=6AD22EBB"}, "display_name": "BricksVR", "keywords": [], "long_description": "BricksVR is a multiplayer sandbox building game in VR in early access.\n\n- Invite friends to a shared world and build creations together. Shared worlds include voice chat, physics, and the ability to save progress.\n- You're not limited by what's in the box in BricksVR. Place thousands of bricks on mobile VR with no lag, and choose from over 16 million brick colors.\n- Wander around your builds from the perspective of a miniature person, or stomp around and chase others as a giant!\n- Open your world to the public to show off your creations. You can also lock your world so visitors can't make changes.", "short_description": "BricksVR is a multiplayer sandbox building game in VR in early access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bricksvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "BricksVR Studios Inc.", "support_website_url": null, "website_url": "https://bricksvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "454232459568442"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974781_1151057708650253_8305288702707347772_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZPFY_so0HwQ7kNvwGBKR5R&_nc_oc=AdpLub13WU4aQnioEzRFMHRyx7Hr0ogv7GrWCIlZcUxu0ChMQzU8XNKxfTkA0etol_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdqATsXmUF4RCsBo0vB7Bau1g2LKG7kHJpeQF7lMtU6A&oe=6AD241CF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BricksVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": 
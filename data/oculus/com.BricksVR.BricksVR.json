ntent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtwPf6W1hQLi8A7_3XYZxFPXncHz6Eoyh-wZM5-SVf5w&oe=6AA412ED"}, {"file_name": "Tophat.png", "id": "858023171586433", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031396_858023174919766_1312162633865839656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGOhj2KB_yQQ7kNvwFWnFQt&_nc_oc=AdrB1mOnF5W0xigEz_gvwJp10ZeZRwuaELa2oRCl91h4o2FoukLrcXD0QOXLJ8SWPd0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBNoJ_DtIqxjaI78wkjuDRErnOf5VBnHgIjG8g6K984w&oe=6AA4047D"}, {"file_name": "Menu.png", "id": "348608176867230", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974444_348608180200563_6060700511899341453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMuAGHljfj4Q7kNvwHPCiZ3&_nc_oc=Adp1VJsiKE50AsDeW-O6DDwxEOlnv1i5qnzdFFn7Dzt1WxviIQ3qvvnciuVbR2DeZWU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQxeNpHCL6b5GpspeCT2vnZ3z4nQ1Nk-dvZIm72ViGvw&oe=6AA419A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bricksthumbnail-clean-large.png", "id": "1074970913243281", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974878_1074970916576614_3490804942913616657_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOh4inRG1hQQ7kNvwGfSf9c&_nc_oc=AdpF3-d9kto_ZQWZxGKPSqFXwt-rRZxwbuqmF0scvxIAzlGv-1aH08DixdcAy4brAyo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqjbGyiBXkdD_UrZQo2iaX9CHMEi7dNuZAxycy1CLtuQ&oe=6AA40A3B"}, "display_name": "BricksVR", "keywords": [], "long_description": "BricksVR is a multiplayer sandbox building game in VR in early access.\n\n- Invite friends to a shared world and build creations together. Shared worlds include voice chat, physics, and the ability to save progress.\n- You're not limited by what's in the box in BricksVR. Place thousands of bricks on mobile VR with no lag, and choose from over 16 million brick colors.\n- Wander around your builds from the perspective of a miniature person, or stomp around and chase others as a giant!\n- Open your world to the public to show off your creations. You can also lock your world so visitors can't make changes.", "short_description": "BricksVR is a multiplayer sandbox building game in VR in early access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bricksvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "BricksVR Studios Inc.", "support_website_url": null, "website_url": "https://bricksvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "454232459568442"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974781_1151057708650253_8305288702707347772_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Q2qjjr5WBEQ7kNvwGsJ4HD&_nc_oc=AdpXZpKAqQcRUb2EzPkgSky9nZT7TgzgBdTK-BTRAyTDG3WFRtNd82ezYwYGmOhNKj0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWNf37dzu93ocNOMAbuuE6PhVotQCLXFUKzoxPXuYvCg&oe=6AA41D4F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BricksVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_n
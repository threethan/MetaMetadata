t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3SfNywYJD0ymvXzGyKR3_22NjwNn5WBLs-Qni5sgJ2A&oe=6AF7216D"}, {"file_name": "Tophat.png", "id": "858023171586433", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_858023174919766_1312162633865839656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEEXnIZqnaYQ7kNvwFgUgOS&_nc_oc=Adr7XRL_GUkkt3uLZSZTF3xns6sBVRB45f66h5izazVu6bFCFdqfBzNkpHqGyN6zVvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc7kaXypY5F7tUy7zAwlfFJzCA8ZHom9EvKHKtmzkqlw&oe=6AF74B3D"}, {"file_name": "Menu.png", "id": "348608176867230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_348608180200563_6060700511899341453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1bJdwOMadoQ7kNvwHqEGvI&_nc_oc=Adr321J4r_GOUAMKTr4fN4CxlslzINAB4RC-sj0zkZJNrlyw5BlGG88OtQknJtPxAQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvI2kvCxbkLQGmSkuJ6WCTYCcryWCiQpT3fPx4ua1IUA&oe=6AF72826"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bricksthumbnail-clean-large.png", "id": "1074970913243281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974878_1074970916576614_3490804942913616657_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZSap4d-ahEQ7kNvwEEVwRE&_nc_oc=AdrX7EFAAavtyBZz6qatK6QO9DqnymleCGe7AIBgjk6iINXkKl4m0Ec-im4DV5CdVis&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNT9_xrWAzzjU-Tz-yIjVVPHaYCkVBL1pRm_auGewXKQ&oe=6AF718BB"}, "display_name": "BricksVR", "keywords": [], "long_description": "BricksVR is a multiplayer sandbox building game in VR in early access.\n\n- Invite friends to a shared world and build creations together. Shared worlds include voice chat, physics, and the ability to save progress.\n- You're not limited by what's in the box in BricksVR. Place thousands of bricks on mobile VR with no lag, and choose from over 16 million brick colors.\n- Wander around your builds from the perspective of a miniature person, or stomp around and chase others as a giant!\n- Open your world to the public to show off your creations. You can also lock your world so visitors can't make changes.", "short_description": "BricksVR is a multiplayer sandbox building game in VR in early access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bricksvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "BricksVR Studios Inc.", "support_website_url": null, "website_url": "https://bricksvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "454232459568442"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974781_1151057708650253_8305288702707347772_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByLrG4ab1kIQ7kNvwGc--DJ&_nc_oc=Adq2SZrAZUdFLA3_EBo6SJ9t9Z5v2hBAd85IfQZ2mP0G9fMHVSHXrBWa0FU9XaI5epc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhqBOxwOumWOeSvmz7wCoUDTND6K6Cyl6g3HwkYxFIXQ&oe=6AF72BCF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BricksVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": 
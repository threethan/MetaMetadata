67734379392_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxiD0_RAH6IQ7kNvwHIqkc_&_nc_oc=AdoEcQ_KGRIX8xRQyJ59s7eus5RXqCOLtRCfp9wN4Fox_oUbiHrmjxXHmYpBzIDYRQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoOf5pEdSlK09CpM0hWURNCPNYiXhaXbIC8CqzPGYGnQ&oe=6AFDDDB7"}, {"file_name": "5.png", "id": "745170709461069", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982727_745170716127735_2772788674438877613_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsRJudIeT9kQ7kNvwF1yw31&_nc_oc=Adq-tigHPMeOtrNXFOSXmWB1fkNBvr_f05j2ZMANFco7LowRD77RhfDeNfQwNqz4m00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvSSCEdKT4XneFZfkgsW6I3tZAqyV35Co5pCfjAqzLrg&oe=6AFDD917"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-splash.png", "id": "1444681069198918", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75549081_1444681072532251_8740814004794482348_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKhSASuFGH8Q7kNvwGxJngG&_nc_oc=AdqKWMetkL5kyxEIGNOYX0XpXJFzwalXrSSyznHLNlWM5ppcBIvN-5mF_RCu6g9g-64&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPzvozs2OL8PIp-kn65pq_kwCFDG_HrUCQdqsfbaP_jw&oe=6AFDC616"}, "display_name": "BricksVR - Early Access", "keywords": [], "long_description": "BricksVR is a multiplayer sandbox building game in VR.\n\n- Invite friends to a shared world and build creations together. Shared worlds include voice chat, physics, and the ability to save progress.\n- You're not limited by what's in the box in BricksVR. Place thousands of bricks on mobile VR with no lag, and choose from over 16 million brick colors.\n- Wander around your builds from the perspective of a miniature person, or stomp around and chase others as a giant!\n- Open your world to the public to show off your creations. You can also lock your world so visitors can't make changes.", "short_description": "BricksVR is a multiplayer sandbox building game in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bricksvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "BricksVR Studios Inc.", "support_website_url": null, "website_url": "https://bricksvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "645888506728869"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6183588651708053", "version": "0.2.40"}, "id": "431530467912721", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4018602774873329", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6183588651708053"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "431530467912721"}]}, "change_log": null, "created_date": 1678230504, "id": "6183588651708053", "version": "0.2.40", "version_code": 39, "release_status": "RELEASED", "status": "APPROV
uscdn.com&_nc_ss=7f20f&oh=00_AQASNJoP84dihhKs0wXRm14f8SW20VTildlWtCcwpIFvNQ&oe=6A5CC9D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-splash.png", "id": "1444681069198918", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75549081_1444681072532251_8740814004794482348_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDWdsgrVjjEQ7kNvwHnoEKS&_nc_oc=AdrhUjZV8n_deCrO8VveD4ch3G36Dyx8ZtpHZLhFyItIyIFUtfSwJz_7SkDzOnhhPjw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBImwpWdWg2Dyl_kV8M8mQ0XsTB-w4GBlTRevNPvpVjfw&oe=6A5CB6D6"}, "display_name": "BricksVR - Early Access", "keywords": [], "long_description": "BricksVR is a multiplayer sandbox building game in VR.\n\n- Invite friends to a shared world and build creations together. Shared worlds include voice chat, physics, and the ability to save progress.\n- You're not limited by what's in the box in BricksVR. Place thousands of bricks on mobile VR with no lag, and choose from over 16 million brick colors.\n- Wander around your builds from the perspective of a miniature person, or stomp around and chase others as a giant!\n- Open your world to the public to show off your creations. You can also lock your world so visitors can't make changes.", "short_description": "BricksVR is a multiplayer sandbox building game in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bricksvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "BricksVR Studios Inc.", "support_website_url": null, "website_url": "https://bricksvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_g
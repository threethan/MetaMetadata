t-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkkijcXrPcehYhTwj3XTFvUxC_CLMqqCo6XoVXme09mg&oe=6A5F84ED"}, {"file_name": "Tophat.png", "id": "858023171586433", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031396_858023174919766_1312162633865839656_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPgauR37GcYQ7kNvwHUlmPf&_nc_oc=AdqmMjCgztWofukbl4B0I7-G_q16oOtNeO34XaDQIAjKfICZXX-XfDmfYxkmBGj31NU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEn7I8Yh15E6HhF_Pp6cB1CvLhXZ7ZlNzhgeML95k4bw&oe=6A5F767D"}, {"file_name": "Menu.png", "id": "348608176867230", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974444_348608180200563_6060700511899341453_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pb6TN2MX_boQ7kNvwEl26Wh&_nc_oc=AdqDBsc-TzXpZeVCZDuRYbcMaxIJYDb1-F_qo8NIVGOhra4SCQ_JYiLAmnqZSDcwuQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4YR-NVjG7Ulxor6Uc7Y6fm9_oBU-mAsJ_Dmyrk_Xx5w&oe=6A5F8BA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "bricksthumbnail-clean-large.png", "id": "1074970913243281", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974878_1074970916576614_3490804942913616657_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twg8BEiVGlQQ7kNvwFEwTtw&_nc_oc=AdpMOqa6gfGWlrFCOvitajKqsON_xgE3QSB8u30l2h91KyPTm35XrqZXhkAo-Ifhzh4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXmKrYMUarf8fUmXCVq-BUqPVA0Jjo_iyrXXTJ-hDaWA&oe=6A5F7C3B"}, "display_name": "BricksVR", "keywords": [], "long_description": "BricksVR is a multiplayer sandbox building game in VR in early access.\n\n- Invite friends to a shared world and build creations together. Shared worlds include voice chat, physics, and the ability to save progress.\n- You're not limited by what's in the box in BricksVR. Place thousands of bricks on mobile VR with no lag, and choose from over 16 million brick colors.\n- Wander around your builds from the perspective of a miniature person, or stomp around and chase others as a giant!\n- Open your world to the public to show off your creations. You can also lock your world so visitors can't make changes.", "short_description": "BricksVR is a multiplayer sandbox building game in VR in early access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bricksvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "BricksVR Studios Inc.", "support_website_url": null, "website_url": "https://bricksvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "454232459568442"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974781_1151057708650253_8305288702707347772_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLAombX8PXQQ7kNvwFrXu5L&_nc_oc=AdrWSxPXNNXa1BUZns5Lp3ZQmEswWPljsixfDxdACorgbKOp11-32a3TkLQ8iRLEZ5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-fGB18qh4ZMFSKH5rJaZzY_EfSGtKZwgOCANCjiCDDA&oe=6A5F570F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BricksVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": 
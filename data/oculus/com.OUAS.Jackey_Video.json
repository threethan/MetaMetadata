gEBTwb_kXMQ7kNvwEssTOX&_nc_oc=AdkAb7Bk2MV5K0U_2_X81Bmd1PwXQ_f3rcmWDDrjzHklFLX9SpeL5N7yy4DU3HEXxro&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftVHq4jauz1cpd_DxwrTtqksCrBIXnY6jksG10uAiDz_A&oe=69A59900"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "4621584017932944", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75240098_4621584024599610_6859405396097084671_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfF78RkFW_QQ7kNvwEg1kg_&_nc_oc=AdneGQuVumlvQPRafvTXiSJgKb9-TA1TJj443rbwh40ItL_fXMIMnKUdIkKjbjL4ax4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftUh1CwquCC-YS-BgJin7Q9xsDyokRd6jPhxxDc_A7Liw&oe=69A5A0F3"}, "display_name": "Once Upon a Sea- Jackie -  You can only climb From the lowest place on Earth", "keywords": [], "long_description": "At a time when many tourism businesses are closing in the Dead Sea region due to the ecological disaster, Orit and Jackie Ben Zaken managed to do the impossible and set up a Dead Sea cruise company. Despite all the difficulties - difficult terrain conditions, complex bureaucracies, and military bans, the couple manages to make the disappearing sea accessible to the general public in \"awareness tours\" aimed at creating awareness of the ecological disaster at the Dead Sea.", "short_description": "Once Upon a Sea- Jakeye -  You can only climb From the lowest place on Earth"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_typ
0YCpq4lnf2DC0B61ENCBydg5JTbsXlafw6oJQYIFCGQ&oe=6AF9B7EF"}, {"file_name": "Shot2.png", "id": "2573603846116819", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031532_2573603849450152_1042195662266150907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jy0o4dK9VjMQ7kNvwH6XS5c&_nc_oc=AdoU0mn-ShGDpPHPzg4_-jrsj3djZLZgUadEFY0HCDa4POrLJk3AyTJ4RYpW0VcHtQ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX7v-WyoYK-StufnI7NYZHhbWzG_ou-5DpGfqQO1nS_Q&oe=6AF9BC00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "4621584017932944", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75240098_4621584024599610_6859405396097084671_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtyXBgpEw4YQ7kNvwE0Myav&_nc_oc=Adq8PZraElz327jIXgblFg3I0ER2kJ5egYXYrmtxxkIjjtXOmYvEKlVqU_ddHdPU3Mg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnMAQppP6ajqj_xwQt6Py4PnBBUDetH4I6L-2FqP4Law&oe=6AF9C3F3"}, "display_name": "Once Upon a Sea- Jackie -  You can only climb From the lowest place on Earth", "keywords": [], "long_description": "At a time when many tourism businesses are closing in the Dead Sea region due to the ecological disaster, Orit and Jackie Ben Zaken managed to do the impossible and set up a Dead Sea cruise company. Despite all the difficulties - difficult terrain conditions, complex bureaucracies, and military bans, the couple manages to make the disappearing sea accessible to the general public in \"awareness tours\" aimed at creating awareness of the ecological disaster at the Dead Sea.", "short_description": "Once Upon a Sea- Jakeye -  You can only climb From the lowest place on Earth"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_
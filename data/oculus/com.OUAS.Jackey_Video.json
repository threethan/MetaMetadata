qPVktc6z08bcmLqZ9Nai0KRBo7ngnUEg8DQ_bgRcfow&oe=6A451A6F"}, {"file_name": "Shot2.png", "id": "2573603846116819", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031532_2573603849450152_1042195662266150907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQQr7eQMgmYQ7kNvwEE2dr6&_nc_oc=AdoTvRT35hLuTLiRQh-aXmGF-usFoDKr2ofI6wvri2Gr_5oheB56h2mokO6Hlbc2XWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NsdyQeFXjSly2hMqsj6JeciU_BTol5auG9rsFiWRrQw&oe=6A451E80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "4621584017932944", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75240098_4621584024599610_6859405396097084671_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhdFvZazO-cQ7kNvwE4OkHn&_nc_oc=Ado0C58U8wgXhJXQGMWJGbigX6RUesgiyFusfDzwtSlYIFdnBLvlGipg2lfXiNoTb0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h9BkWB-uFvWL362X4eLI9QZFjTKeLRAz5XIZmGfbw8w&oe=6A452673"}, "display_name": "Once Upon a Sea- Jackie -  You can only climb From the lowest place on Earth", "keywords": [], "long_description": "At a time when many tourism businesses are closing in the Dead Sea region due to the ecological disaster, Orit and Jackie Ben Zaken managed to do the impossible and set up a Dead Sea cruise company. Despite all the difficulties - difficult terrain conditions, complex bureaucracies, and military bans, the couple manages to make the disappearing sea accessible to the general public in \"awareness tours\" aimed at creating awareness of the ecological disaster at the Dead Sea.", "short_description": "Once Upon a Sea- Jakeye -  You can only climb From the lowest place on Earth"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_
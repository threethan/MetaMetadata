Sn1wXut1rrF0nbtPeuRsSc_lva-VjrJk6oGlrNIeAVw&oe=6AF89EAF"}, {"file_name": "Shot2.png", "id": "2573603846116819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031532_2573603849450152_1042195662266150907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOAI99nDE-kQ7kNvwE5R2Hb&_nc_oc=AdqEpz6vNlOl1-XMSlFa2mOi1-fef8hkgwzyzKCZ_sUW5qTinxSRv_TiQ5t_xRoyGKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSwDTL976fAkaJ8J-Xm4r0j0XqI_nQNOcGqakx0kWMzg&oe=6AF8A2C0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "4621584017932944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240098_4621584024599610_6859405396097084671_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TtyXBgpEw4YQ7kNvwHPl5ZT&_nc_oc=AdoprHS-HQaBG6Cz3_4Q7oPxf2RBE3d_NMVau-xeMeA2Az-WUr0MY4mY5xYPltjrXzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlDCTZ-UntrCIdZF3x77E_j-Mp-U1NNkgpcX8JKp8PeQ&oe=6AF8AAB3"}, "display_name": "Once Upon a Sea- Jackie -  You can only climb From the lowest place on Earth", "keywords": [], "long_description": "At a time when many tourism businesses are closing in the Dead Sea region due to the ecological disaster, Orit and Jackie Ben Zaken managed to do the impossible and set up a Dead Sea cruise company. Despite all the difficulties - difficult terrain conditions, complex bureaucracies, and military bans, the couple manages to make the disappearing sea accessible to the general public in \"awareness tours\" aimed at creating awareness of the ecological disaster at the Dead Sea.", "short_description": "Once Upon a Sea- Jakeye -  You can only climb From the lowest place on Earth"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_
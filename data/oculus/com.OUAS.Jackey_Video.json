5xSFR6dCl4Q7kNvwFdbeUM&_nc_oc=Adn8Zd1D7DgLqfOldMq2vrmmlDkvtvYKPpHfphtFXUs6r_z6vMPX_BblCAKinepp-r4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftxqmOO5YoZY6ps0FevyeC4Z_g9oZy9F-Q0772aPKh4-g&oe=699B0D00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "4621584017932944", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75240098_4621584024599610_6859405396097084671_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9ivxVDqc98Q7kNvwGayv-b&_nc_oc=Adlob6i8FwXyAurbgdHC3w8uQMi4QF6VQs6loGy88bOQUVhFY8hvSOmLtd3UVvX3zZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftvduIuFYseLtDxKvTk1U7prIzsYbVOh6yByjmz6Qq3Sw&oe=699B14F3"}, "display_name": "Once Upon a Sea- Jackie -  You can only climb From the lowest place on Earth", "keywords": [], "long_description": "At a time when many tourism businesses are closing in the Dead Sea region due to the ecological disaster, Orit and Jackie Ben Zaken managed to do the impossible and set up a Dead Sea cruise company. Despite all the difficulties - difficult terrain conditions, complex bureaucracies, and military bans, the couple manages to make the disappearing sea accessible to the general public in \"awareness tours\" aimed at creating awareness of the ecological disaster at the Dead Sea.", "short_description": "Once Upon a Sea- Jakeye -  You can only climb From the lowest place on Earth"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_url": "http://blimey.tv/blog/welcome-to-our-blog-but-what-is-it", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_typ
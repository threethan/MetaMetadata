qTuKsvsSf19B5YNL3pahHREC0o-LYiILFVKSZsW9UiQ&oe=6A5B83EF"}, {"file_name": "Shot2.png", "id": "2573603846116819", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031532_2573603849450152_1042195662266150907_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7NhWNq3kegQ7kNvwGBaETC&_nc_oc=Adp81KleMtdd6J7Ycats2_mqnIOM-yh344I0wl1AP1IdQ3p9kbDkiVHtmOR5Xp0Z8zo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdpxJOtC16cpcClnItgATYY4nrrfx4AM0U-3x99yl1ww&oe=6A5B8800"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OUAS_Landscape.png", "id": "4621584017932944", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75240098_4621584024599610_6859405396097084671_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7qy8idSBvAQ7kNvwEWSOH_&_nc_oc=Adqn4XT4qRr_7DH3kaWZzS27nZHikwwCb_AQo3q9QMtpTF0OHe_9jPaV3NYyEruqqPY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0ynW2mkx-IkDSP7JC4PO9-4Z8Eje5AEDDGikpRZCeGQ&oe=6A5B8FF3"}, "display_name": "Once Upon a Sea- Jackie -  You can only climb From the lowest place on Earth", "keywords": [], "long_description": "At a time when many tourism businesses are closing in the Dead Sea region due to the ecological disaster, Orit and Jackie Ben Zaken managed to do the impossible and set up a Dead Sea cruise company. Despite all the difficulties - difficult terrain conditions, complex bureaucracies, and military bans, the couple manages to make the disappearing sea accessible to the general public in \"awareness tours\" aimed at creating awareness of the ecological disaster at the Dead Sea.", "short_description": "Once Upon a Sea- Jakeye -  You can only climb From the lowest place on Earth"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTB9QkEglEoGWqRiiejtmGluAKDptYFAgijYU1fjypF3J8n1QQQVWJ1R5-_1hUzRkqSCDwaxKOhSJew/pub", "developer_terms_of_service_url": null, "publisher_name": "Blimey TV", "support_website_url": null, "website_
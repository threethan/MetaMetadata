Q7kNvwGqFl_E&_nc_oc=AdmrjgVZpZrE8FDrp15LXAB7Xp9IhnT6nowcBgJBExJyw6rJ3Ax3S5_OQsmtT-RjCOM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsvCgFRJO6N-HhFfNVmB2tnAmp8mVSL0jX9IqN0RyvOFQ&oe=69A81E4C"}, "display_name": "The Wild - App Lab", "keywords": [], "long_description": "The Wild is an immersive collaboration platform that uses virtual and augmented reality to help architecture, design, engineering, and enterprise teams save time and make better decisions by experiencing their work together, immersed in a shared virtual space. With native support for SketchUp, Revit, and BIM 360, The Wild aims to shape the future of collaboration by connecting people and their ideas across distance into a shared experience. For more information, visit thewild.com.", "short_description": "The Wild is a collaboration platform for AEC teams to experience their work together, from anywhere, in virtual and augmented reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://thewild.com/privacy", "developer_terms_of_service_url": "https://thewild.com/terms", "publisher_name": "Wild Technology, Inc.", "support_website_url": "https://thewild.com/help", "website_url": "https://thewild.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "3169776599926239"}, "review_messages": []}]}, "cover_square_image": {"u
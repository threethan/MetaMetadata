_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ4n7T1maTUQ7kNvwGJ4B5I&_nc_oc=AdorLnb36EYFgXEuGlyCmSbwD6Kh_jJlp4Hzarj59fYNcKRpuLr46kcFv-OX8-B0__8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCUGjeo-qQwDq7iPD1g2FJS6laSkRMWMfqXFYkV7ORmA&oe=69CA8943"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rpoeCrhHGoQ7kNvwFyhWPo&_nc_oc=AdqJuE_5sf-5C6LSR00GjjEACzqUQ9xe2s4KmfsWZeVW2vhEeXTYwL3PauCP3aBFTWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDKPhhdW8i4p27SCmyB47NcnrXJ3rUaNUOD4AX6F0G1g&oe=69CA5923"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbP-5vcvxgEQ7kNvwF8NvS-&_nc_oc=AdrjhW7z-3viXiqAV-iGr92O7EFnho9heCxWaJwG1VFjpW4N2xDwaTILdCTNzR7kT50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzd1PhTohobtD8P9DL6bpPA3P_ZiNrtjNIRfft7Uul8Jw&oe=69CA886B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWmmJ5c7YhUQ7kNvwG3CBfX&_nc_oc=AdrR-OF0ICJefjYe4vOSC1fxhFn6GWruhKX4BPzoLSRsthwQxB7bACqyShnf_DRvHB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXjaL293ZjJ81JGjMEqt0xMjwMK9T9rugEgy1FY1M2-w&oe=69CA6474"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tt2T101WuoQ7kNvwH4-5EH&_nc_oc=AdoIO96WU7NQE8bBYqlWPskXoqK3sLpApbBeuS1oGR_vI77fZUAVpT40SrrU9noVAUs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPJKcd7vTxnPCl3xHixksJkOzk9XjP57MGVWpHJeSASw&oe=69CA734B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
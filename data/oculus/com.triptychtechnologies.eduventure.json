_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8_uDhTkrY4Q7kNvwH84CUF&_nc_oc=Adooxo5Yn1FcvWJsv4hS-kQ1hCun9pMf6YklUSuye6yVxqIp9o4dKwkBxNMglQ59KXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rNGo8UTqYNmV16iBOAN8Rdpg2s8VjzwkcFE9Vbi5VRQ&oe=69D666C3"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwfFAAUim6EQ7kNvwF2I7Nu&_nc_oc=AdrqkXgs1RriHmNKDrAJnsyEFPOd3Zk4NpHDSiucOOK1wLEqFp1jIWcllGblTJDmaSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uSNksbm6gT96d_LJfUka-gas7OJbTHNEuURiSFNvfSA&oe=69D636A3"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JdrHjBIbVUQ7kNvwHYmQL1&_nc_oc=AdoV2oD6IXOBuAH772DZr1QS13rx7f-hB4_21hK2i1mtSYjVGT1ZbxUs0Z4AZtZ-8D4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Wud_ova18gLSbKeXc_4240iY1G9Aqm_OyZ6GQbQuNLw&oe=69D665EB"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py-ainp_f3gQ7kNvwHWZUY9&_nc_oc=AdpQ5KuxhjyipriIqPguk1S0uID3u9lSEYedS-UdmUgtow4XE9FcC3ntUBGPoHJ2NCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WcgNIEYbin7EvVmKgbd9xD212ZqcKl9eCnAFSjX0w-A&oe=69D641F4"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa-7LtZZIsYQ7kNvwEsbjnm&_nc_oc=AdqsS5A8Z-vCt9qpiXLP-aymqt1itqUztPDqDE5KKdAOH-l2mAMv3lo5idk4a6-olCo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iwDxoXX0DJdZShkne88A3Ez4uyg8S7f2YJdbpdg3TOQ&oe=69D650CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
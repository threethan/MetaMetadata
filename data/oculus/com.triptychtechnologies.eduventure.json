_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FIbJbr2ApEQ7kNvwH_20VU&_nc_oc=AdpjYM8k26yCJA6QWx4Tmfc2EkiN3mRTt5tYxlWVbOCsKZHsMMd7YrwTmhhFw57isjY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iwNfprtZdfWYnDYVI1BwmrfsCegVSpxWUJpewXgaktw&oe=69E24443"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2rT93HURjMQ7kNvwFpGZbM&_nc_oc=AdoBU_QCu_yNrhSNmmqgrWL3MmfRENqzDXjsDA9nKm_fLxga3B3GZ3j1ATMwaTp7WeA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04PxsUOUNGQtsmqyrk2_MnvMsdbbLPSMoMMd_es_Rf7Q&oe=69E24C63"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0z6RoQLNxcQ7kNvwEXff2P&_nc_oc=Adr_U6H-jp6fRaQ8v4QV6z74MDANbUhCyXV7vc9c4UDQss-pjrcnWEc6yTYk4olv5Dc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q0Etd9yeDLf9a5vF02hNTq0GInucp8BLcaJccTmETDQ&oe=69E2436B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOreCN44ud0Q7kNvwHBFm_S&_nc_oc=AdrVjmddcHWrWGCQK5zlD4bEAWzEWTjeg1oKhHHSJsbV8CIXLd5d_N1tGuTxfSx-s3s&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19GXG8E8bAjASPHHOuEV04twF5Qko1O28ZceCk4pX91A&oe=69E21F74"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll5UfxWlEOwQ7kNvwEMl_67&_nc_oc=AdpRXrCBDtk1-doOnR4YPL5JR-ClCXeO9nJrWcJSi4QNiPSy1LTbWHVxrMQKLFX57fQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mlF4D1oulef6PRVFz_kCY-ytSXBk9nSyl5LY-hRvLxg&oe=69E22E4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
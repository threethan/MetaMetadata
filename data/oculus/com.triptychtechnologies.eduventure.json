_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5wpvUDkkf4Q7kNvwGB3twl&_nc_oc=Adq6Lrq55iV2Exls6Tin8SApNJDrbuEC22TkMyHFAmXfAzyGlxMYmMeOw_U0VCvAcTI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g30tXfymme_QBlw6lTSuOdzjH9FFOnR2V64lKN1zEEg&oe=69DA5B43"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J2cf5ocbjYQ7kNvwGeI42l&_nc_oc=AdqY7pcAIspxC0SpCap2cgkgM7wDnvkL4Anv-kdwz1eCb4BT4w7y3ruUBTHZ25H5rVU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wk4bZ5dDH4cxvGwFPRwTXN77WOLvPKSpDW-yXJW6_5g&oe=69DA6363"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyMnsxzx8bEQ7kNvwHU0_B6&_nc_oc=Adpp1f-xpOub1UdzkyqGIrnH8A28us7CDjWBiZ92Bn5fMiPYYjDlE6eRkyBR7GbJfnY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eA_sFDpa5J4ta7kENTERPakZv8Q6YMcMSSGgy3YQJUg&oe=69DA5A6B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aXWlm8pjuEQ7kNvwGz4Qkf&_nc_oc=Ado3KkiaNAyw3m-UQ4n74Cmzx2EwMeggn2Zr1rySGxy3TGD5eB04U3bs8ChGp-rs0f4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OKyEc_v-NEfJii8hoZxX5gGU44CPQPqxqfWdY6Zdcdw&oe=69DA3674"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69_fC0FTuY4Q7kNvwHFI9Nl&_nc_oc=AdrlbF3pOXGYqy5AQTqsJmPTQj-JZUHd0BgnMfkK8B3DTpnkWASW_c6Tf3-cnI1bZHU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xibzotr8pRijvkHCUaN4hq6X9DFt-3LJpBj03AVcn6g&oe=69DA454B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
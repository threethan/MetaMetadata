_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8_uDhTkrY4Q7kNvwGf4XrF&_nc_oc=Adobl0iOlYBSYwf-o0Ft38mB3MTHH3uH3PdUMQWAV-ByRqWsiThZuZuGHUY6lIFEgPM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UPdiZsM_fZTKSc9izlwFUqzBvx1dJgfVNpqJfx41wiQ&oe=69D7B843"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwfFAAUim6EQ7kNvwEUIk4c&_nc_oc=AdpdwIrODr0TTVxwo7TUL5XW8gbDm2xj-GyIwfYUaOPy4bFckKflbELFSr1xSTeorTU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jOt7s4vrkhi5Etf0JznMQDuL4zBYQvhO-T6hgO9gLCA&oe=69D78823"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AyMnsxzx8bEQ7kNvwEAWfQI&_nc_oc=Adqc3tggWCSr1D0ySHzNDvMJpedHajos2GSPC5H81HUQer1BArJgj3tS0O4bbiGdgXM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PK_-QXhhXML1ECzc8NkMr8IzLwxbx4V1eT2eEgzMlrg&oe=69D7B76B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=py-ainp_f3gQ7kNvwEC9uLG&_nc_oc=AdqCKPRg-YO9MaknLYWrVja5xvA05v5id9UgwJxmqUIEkPa-mwgw_4KACowssjRwbW0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VxTe0CysMjZR61zHxkprTWVx3bkRWv0-SwDGVGMb09g&oe=69D79374"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=69_fC0FTuY4Q7kNvwFqvsAX&_nc_oc=AdqyjktTO9is3E4niK2GIHzIhJQIpSeayyFSvW9oH4ghneK8_DKdMj4EkdSIYmYhsrU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Jx6I13Y-Xob4BaPuenOzA9IRycLVbZso-pijGGrpKfA&oe=69D7A24B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
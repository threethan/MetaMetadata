_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdG02_m0tkYQ7kNvwHUntli&_nc_oc=AdriiSUX-qG2BKlzU6Ri8jhvzluK3R75i3Hj9HfYTptBHPx27lOy1W-sbFh3bIHVA3g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxEN-qCwdaubRLU2r8G6RB-TqJk9kC7pysgH23cOYbSQ&oe=69C54343"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aol3ybe6XCEQ7kNvwGt2Ksn&_nc_oc=Adq-a0Ekp9ZPOxThha1vof9sChskp9aAdWVfnIXGCaP87HYEx1va23BH6sMDD36nVy4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwse19wM6x7swhtw0Psy8wUdmXHSMsUj7A-IWALxTlutg&oe=69C51323"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seJ8v50dW28Q7kNvwHbMPPN&_nc_oc=AdocFwY3xmzYMfbmSRIBfRRS_ZOO98a3ca1Pv7fewZl5eqwBAQPxZCbVGdRNX3WpXlU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwajOmMsDyY8wAYlkEStSAjgpdb2tc9s2JXfLLQqBzsgg&oe=69C5426B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbkNFuOuuo4Q7kNvwGXdLf3&_nc_oc=Adq51h2rpGYt1-jWab2jHsYQz8_3IIVl9mp8xR-LRsZbOrbSrc34zLhAgOePKHMuZj4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5sKavp352v-dRWGwOXKRJt7Jft-Xgk8q6E9VOgmL0Yg&oe=69C51E74"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M61dN07O9kYQ7kNvwFgjwkf&_nc_oc=AdrFRXOcGI0UUBnA300DljfFibyC9xICWLCt8USTc38xtu4dVJ72f_DMm9mymHmKScw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4EhVKyLncUh5sAIVrjJVrrMbBnLFk2tcNV1riy7fOng&oe=69C52D4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
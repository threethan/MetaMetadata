_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H82K1O8Tp8AQ7kNvwF6Irln&_nc_oc=Adrgw0_8oqUiCHAjEzj3OEahV42EgfuZpueGJsM7kYK1ALDhv2gRxgTmjn99A3QwbIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DWwiFWzvEfnZj5xiNr4a6c0_11OJrRckLOikVnIMyOg&oe=69EA2D43"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCMZY8v2BHAQ7kNvwGkeTlD&_nc_oc=AdraeQYVKTJqH_dmKVvcYjsb0ho0R1JwPNv-mou9LETyYAkUGO1WM7lKG4LjLKXzWLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-NF0JOPuFSJaktjx69fjRgam3KSb3m3T4UDZQy0Yrsw&oe=69EA3563"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gc0j6e-DQgQ7kNvwHeMq1n&_nc_oc=AdpzBE7IHxu-V9pUGYk8W7duQqVMcMRnccFzUmy8LscLs0vbIjhjiDLZgluamif_Rfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SBiFpv88SJn0rK55gm5dPsgkh-yDbXNK4casykPhZ7Q&oe=69EA2C6B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Prr18_c5SjkQ7kNvwGkumUf&_nc_oc=AdrP25I6nWITgwCveDPC1saDZ1qePXDKefLGNE8csQOgwOijnDaHEKqaoHiTc9gRKls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_POqaBVdntKVA0eT2L9TpQXtS2RpRYd4DQNc1BLrALA&oe=69EA0874"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60FB3lHSmCYQ7kNvwGHO3xs&_nc_oc=AdppxBao3qO1AOqC3rZwn2jsHWpPuSHqzLK7WdZ-ucRDaQy6aLNOeTu-Xc_CjK3D_-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02BorZs1FmLfsqmdCm4ipjbgA9ery6Yofh8iB_0nkP8Q&oe=69EA174B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
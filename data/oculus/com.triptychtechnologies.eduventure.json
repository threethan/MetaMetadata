_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY5S3_ZPjaAQ7kNvwGZn341&_nc_oc=Adr3WEtWIxrFFeUjeLb_YhHtHryMbSY3wsOxIV9Xnz_p1yDWYGBVb0SgwraCli_AzQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cf2b_bR3gVQdU7iXWMH5eAsmXDBrPhiRDqeEIGZ3jvA&oe=69E4E743"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NSQEI3ORlEQ7kNvwEVqKxh&_nc_oc=AdqIykT2babvVCEjRR-_3tUEI_vXUSs8oAaDAT80bUSa_LhB7Z9IGltQfZGUgK6mweo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V5OOdifvphS4gP4BeWJGXK-LdPWYoFCMDY5awdVSe0A&oe=69E4B723"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYY6h7ClrvMQ7kNvwEStCpH&_nc_oc=Ado4vRrxvgIadc6noC_jdL_gZj5M_T9DJgnnn5psPOmz2nUwo3bOfu2A8ixYm9o74s4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39UVvJKs88E2aai5GXlYNxtAgzKJ3Rjn7MXnyg77CaDA&oe=69E4E66B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqFjr4EssH0Q7kNvwElwE_c&_nc_oc=Adr9oyNyqr5cyTrr2fQ6czIis6Cx1D2LQ5CiZAOAf_S15KJ0tan8TN5JgOnpiUbKhGg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08_TM_Uwk18dTGlKeoTK0ZtziwuGMlNYUT9lEn5upipw&oe=69E4C274"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ9wI4geMEsQ7kNvwHU34c5&_nc_oc=AdqNvv7beKe5XcyqY15i8xwojwEaEWw2-3L40eZmSHlxlQRQRn6-lYsGJMdZdBbhn4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0D_OxXZnBCmtx0DtJn8OKshLHriTxumBiQ5J9KlhrrXA&oe=69E4D14B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
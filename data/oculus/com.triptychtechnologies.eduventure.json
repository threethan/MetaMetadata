_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5wpvUDkkf4Q7kNvwELbd7S&_nc_oc=Adpxu7GjoX5FRpNa1eUdOimQjbL7f5tY_e3RpONcApxZl6VCmJAgxYGQQY4C7UPrqAo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TyJCCQMNyhT-sTxQsk06SLmYhFUqZT0GdQLosjLizTA&oe=69DBACC3"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J2cf5ocbjYQ7kNvwHR-QYa&_nc_oc=AdqVOnR5Z4PO5ZkY2q09fe_fchn3emBYeARY9oYMMc-5F_xVfNqyHRLBW9l8HLLVWSs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LrxZa6HJRK2OiohLYV2vnhJ1xJZflr0GAE1wgy0nBGw&oe=69DB7CA3"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lW5zhOPbqGUQ7kNvwFD7f03&_nc_oc=AdpxYTjcDJlf-p2oycQTX0hQOuQJdXF6QwvKQxZN7cv7vBMMiDeGDBfWUp8mW5cUzPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22h9KEa-VDZ29EFwRqOPKXc6J_ILO2c4O2kew7F9Aoxw&oe=69DBABEB"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aXWlm8pjuEQ7kNvwFahTfR&_nc_oc=AdpLyzkwvd-IDXEKgjrn_0hLcEI18tmLK_2T8lFW3AUmbhR3SRsvObgJLOVELnLwNlM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wMjR_nPd3gO2Actqa8Epj3nTRaCR65LuqoAP6jeCjPA&oe=69DB87F4"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8gGbPHjx9gQ7kNvwHuVhdW&_nc_oc=AdoEdg4ZFrOssIVuf_pm6PfLRnIGTOKDXLtqB_7uNZ7CBBrfdPMn7czrbIXW7oT0btM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wSmVcYXZM98VNuaXkF3X0hD04p2n9LzCNsL4f4tIPJg&oe=69DB96CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWdK-i-dQ7IQ7kNvwE2724A&_nc_oc=AdovFng2yyVzYcjujemUzm1aBBBeyHl6bnwM7_-MUuGZLWS5O8y2d3DzjV14rVKk7BA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17qNYwJSYtHNibseemeKZvc0Um4EqKlyI6JGQ4g3nfxw&oe=69DFA143"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnfLUZ3tU4IQ7kNvwHGa0G1&_nc_oc=AdpMlDZ521MotZ-l9xua11U5lYZZHrh3FZPULglxfoeb6089VHWZjKxifoe3Lx2o8C0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uBqeqcIFo_wHv_YOPEyH9TJ4I2ei99AaXelXMESWjeQ&oe=69DF7123"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0z6RoQLNxcQ7kNvwHyAlV_&_nc_oc=Adr8Vxaes2_nbaiBWGyfvnbWUbluJh5hxJjDunR8Uw8iuA4AvZULS5U-4ip_Ur_a9FM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24PMjBGg3I9O3MdBpp856OWY-Ext-_WLq7-SXFVnbe5g&oe=69DFA06B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wsoYdYkoQYQ7kNvwHwiMLw&_nc_oc=AdqyPd3Y5O4IHuMpoykjOSGxJkvzv--UmlsTHshTFCgUl61kGd8baGGcVJMb-GqTn6g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VHBZl87P9MwZsyUcvE1X_KiiolquFrVpjxnp4dQOnhA&oe=69DF7C74"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ll5UfxWlEOwQ7kNvwG5dgww&_nc_oc=Adpq7seG9da0eIVMSvqKjSBu9ayAJ9Ox990z7KLSDsT_wVSl0bvGgTgTKXeqXn6rYds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3D-vAyWNJz5h2bZRaHb2bPGkI6OwRJ0yZv8aEphPpoXA&oe=69DF8B4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
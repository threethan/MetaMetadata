713ny&_nc_oc=Adnh2z8p2Zz9yUXXl5OW2mA2q2B7jJdhGf5ee5RWRYIE0Kfjepurym_weDbPyQiNh2w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfstfnCWhRttDE3oPfs0X4s6n5Pqmg6QYsiDsYm3hIRwDw&oe=699F07C3"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z5lb5Draz4Q7kNvwG09Zyo&_nc_oc=Adk6ofHOeqT20UECZ4yqCWa6HK5cE1eYXybLJUxcMIsud1GHPVm9oyBvJ1XVWqw6zRY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsq8MZhmehr0H7Sbvakk15yHqkajsKY9X_Q9dI9al5pyg&oe=699ED7A3"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=idhFVRA4GDIQ7kNvwH1gr9X&_nc_oc=AdnRKv1GJKLWF9RSVKdLR-dhwD9L75U9Kqnfxoqok0i7b-YTMfOhP_EYRw9fyN4Q65Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvW6L8Vtz0ydcu_Rg1IU6ltGQ0uWa-kCi_9BimDaB_JMA&oe=699F06EB"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNeQexkKX6IQ7kNvwEabu-G&_nc_oc=AdkVytUZprF8-adkgvvBWnOPyb47ndkB0EPH_4QFuh53GSCTFVdSI4x180W7oqlBFXU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsvTLxWfnjhI2Bp_cM35Q7r8iCnaEYQUBWbHOPembS_pA&oe=699EE2F4"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kz5A9cti7REQ7kNvwF3fUuC&_nc_oc=AdkLxR5n-q75H7JTwsYaCrlD3qoblmhNONF9jeI50ZP-1AcjAPVhcLK3HsLjjF9QQvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft5Ab9CI2XNmPwwBPSjxovULW_Xtt0A7SAYGULpfNKl_g&oe=699EF1CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQU
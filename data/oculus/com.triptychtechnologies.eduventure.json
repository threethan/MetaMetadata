_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IllpsqUymoQ7kNvwGd9lqm&_nc_oc=AdqHMzDtpFSOaFYFapxGwHo3zhnst-EM7hBXJCuw1Fw__3tuLC6fJ8C_wDudixcLev4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j-wIiSXrvXUDbr645Uaq57876aJlY3G7BWRDWqx-GsQ&oe=69F9FF43"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsoG7bq7sDEQ7kNvwFEr0U1&_nc_oc=Adrqwk0oiVghe0RmEPbr-ITpnqK7jBp743okpds178LrhHsGmXfu6tNluuF8_gzG-pI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kYtsKJ7nZfSSFLdlHNpUoUKs4_lDtkxT3QGHpA5o7Tg&oe=69FA0763"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvc9Q4_DFAAQ7kNvwFYvHgy&_nc_oc=Ado_MNIS46xKNOmqgNwBCz_4PK2wI8mBfavSsqV7u4f9v1mtNu7wFBMfVIm9_hUbLvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42vQ4gaTtK5CET4A05L_cCnUxxVSZ5vtHFQLJ5cPWmlg&oe=69F9FE6B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DNqX-c6nsQkQ7kNvwHLxqI5&_nc_oc=AdoRKROSzo0ao_1JTrXmokxSKBw84GL4oq6FGCqRkyHHhJz66Rbp2qUZL-HceCjP46o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dkTWdxSjv2VAlermGyp41Vni-QkqeZVtaPmGcZBGWhg&oe=69FA12B4"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkdJjBr_pU4Q7kNvwGHJx2i&_nc_oc=Ador7OieErqji5e6BQkcNMQPhrJG00AddSsA888jybP1DqlJfFGw4WT_AELmq4UEI7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PH0NmZ2GRCmHNCkCTY69VOJgao5hRqyL_1j4XOeJX1Q&oe=69F9E94B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
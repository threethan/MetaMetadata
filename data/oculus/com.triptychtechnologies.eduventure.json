_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMPNub7ottwQ7kNvwG26zq2&_nc_oc=AdoAbCKh_1DgROBCSOHeJLI9ldS5FpbgbzNSIPTArxIaUV-ndJVZxhENGvwIUb7Aadw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-woLGg3GeeKVQBoDxZyUD-iCL9WdKMjs6CLwa-xJ13A&oe=69D120C3"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLhYVD4leioQ7kNvwFUQv5q&_nc_oc=Adrmrqn84axtyw1mzSMnK30l1tlfkN7LaXL13MLpZuO58wcTt4aYZSdyBugd6FLS1x8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtQvOQ-lfJ1rV5KBBST5wYZcaOFY18m2bEr5mTs7kPlw&oe=69D0F0A3"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_oQuchB-9gQ7kNvwGz_Y88&_nc_oc=Adp_AAa7IvmHkhPY03bXkhmTpM5S-CZkTjj3y6Fqy3I36BpDhR4XXq3aCfsqTUeLQM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzg6FFPCPvHl7DcrxjPYJ89OqqpaIb4rt_ls4-zbWnD5g&oe=69D11FEB"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJk58bkjg-gQ7kNvwHxXXcX&_nc_oc=AdqO8IPqNJu0gplGecW4RDGN7qoqx6gMDtDgtbRXFH9Jdi_p0TqRTKsyXJxkjpcC_mE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtEh67H3TCOR_SE2ia8JIgPPelxPFuj4PkfHXWSH3xQw&oe=69D0FBF4"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dt75OY7W7H4Q7kNvwGOY6E-&_nc_oc=Adox005GxEE9fstW-5PgsVAY_XN0EQqst6dVP8l9L45imNqVOQl05p0A8Froi-d1xrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyFdqLqW_V6bZx6-3APHEg7sHW-HXcpxypblWcO43Q9lQ&oe=69D10ACB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
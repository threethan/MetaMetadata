_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJs0GkerASwQ7kNvwHcdC7M&_nc_oc=AdriCPZwEBj8KYhR_gkXOLRcvNQ0341-31MkXpCoIEPOLQGVu_iZtHbnxEizItCDX5M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I3fZJMXP8NCbYjHhs5oCpt75GeANFf5XACw0rdCeKAQ&oe=69EE21C3"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg5vhk8M0CQQ7kNvwEl6HdJ&_nc_oc=AdqMW12Xv3G1KmIeHaxXEmXhntIiGEjAXt53hV311lyQKgde1N6HM4IBr9mwPK3r6A8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z-5JU1W47kHM9aeeS52Ru4DBg-35F4-5lgj1fKRLkVg&oe=69EDF1A3"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_BbgHESndgQ7kNvwHGOc2T&_nc_oc=Adpqf1ybrZTibbBxEeBYzX8Dek2htq3zzaugb4_vfOvv2jXLtylIH2CtnRU2OkLVqMg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zMOQvzhOTvS_2ZmwLDhRbwIZbTtfCq8TPM27m89ytnA&oe=69EE20EB"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My4JgrMOnpwQ7kNvwEDf66g&_nc_oc=AdomaaaYJxpy32VVZXpDzNJZcnTFQjuITGHmYunVsyzrBwjwVbjSmREjPsoB40Qg3nY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I917gVgPsDBQBaWIdpiOGVLcTKm8oezhUwUdfTxFXyg&oe=69EDFCF4"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDsJXtW6XaEQ7kNvwGycOWp&_nc_oc=AdqzsBKoNpVsSnGdzcI8VDynAg29UEcey6qKYfhrjY0gg1_W4UYp2Ny77LuIAcGdzk0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rbzMtmTr5VEiuQVrW0GVy6K1qKTUikvivdKsIAAoURw&oe=69EE0BCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
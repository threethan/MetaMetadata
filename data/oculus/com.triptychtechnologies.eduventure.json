_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY5S3_ZPjaAQ7kNvwEolXT9&_nc_oc=AdpjDHkZjSrSqqqsOTG3j6nINVAmy4-K3nr-UHKuN3Xji5x85YXk-G-2MGDBdX8aPQ8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0g7i4toanCgsu1R183KuBdiD1B6UwQ8wsSBFeYiKwBzw&oe=69E78A43"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NSQEI3ORlEQ7kNvwH2ZPXd&_nc_oc=AdoPaZh2BtwYKefxm_fWDpxU-NgXwhbhoSdRkOQfiVqaxHyf4nlz_49lAw_m87mzRiE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U8FYaZcUjm59MOproqAclrqfkOiSGFNg1Kecw3vPtJg&oe=69E79263"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gc0j6e-DQgQ7kNvwGj45qd&_nc_oc=AdocbExfaa1-J_WRDR0_tKKhW92Urvhcy4koyE7bcm8E1wFRAWown6MSqiVcCICRcEA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EG9iEIS2L94-Nmw60sQCIir_fd3SWb2pXwUWmFv2VLg&oe=69E7896B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqFjr4EssH0Q7kNvwGZbmt3&_nc_oc=AdpL1_i5EW5-uns5zd5oKjdfqZC7WrPm1l9eL3BAk12UG3P7sbX1lfK8BUHabdl_4vo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3l9IA2ErRqWLc9l8URR7btjKxU5HPzKYNPSNRumy2zHw&oe=69E76574"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60FB3lHSmCYQ7kNvwHCS6b0&_nc_oc=Adoy3mZIXtYisi39j7VloNsxzw5LDWEYUj2UJzOz-jlvMH7HDPHiUtMPFuLoAMNpoIU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zNk76kZ3LpeOS0qhi-Y_mHknkO50MFW_9YERsFCTU1w&oe=69E7744B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
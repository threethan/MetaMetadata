_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gU82B0LQxuAQ7kNvwFEbrM2&_nc_oc=AdoY0bPkXXg2fmlbX6pLsgSoMHPGGq3e4XrkaNJjOjWwAwT6Ed1qiZQ08E-UDY_9gmU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKMMaR6mEIrXRW77j2Ahy0SOD0H1N0g1pnvwhq0hKiYA&oe=69C2A043"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5ZAivRYohsQ7kNvwFCROTj&_nc_oc=AdoHLLCo_1R6kbT2rJfBaztIid2ZOUGPLFZTPkDOU6sQDll_7fOlpwlzwuBaXiVOYsw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxynKFiBN7v0uZKq9Zi0mRJlRO6hsZ8rNxT3D7d8LGjJg&oe=69C27023"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXCjZsiMHsQQ7kNvwEDa7Ll&_nc_oc=AdohRLojnmkfiw45gUjfIwe-Uau46HbsL0KK77UAnqpD3flhORHmRm7ZY60NqA8MxzY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz18xf21Z2qOdAzcgPptru_yz6xqZzaOHiB_yVWlZlYZw&oe=69C29F6B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzuoLsCTV98Q7kNvwFaSHhP&_nc_oc=AdrC3909rHt2-VXDuSA1WQZ7m7FzZl-azo7kppT30Tjgfkd874Uq9S2oog0sp0j4O00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5_4tqrGtanFcltBCCwu0FqqPwjV-aZdGrNmjtDOdrNg&oe=69C27B74"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQE4DO9pd3AQ7kNvwGUmCpr&_nc_oc=AdoWRmY7HMZFop7xGqby-68QG2Z6e216mlASYXbVanJyo10-aeofxCeES8Kvn4TZ_rQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2LxuH95bRx_lG_azOBPNtpccYyNxxJEllFymZApzTjw&oe=69C28A4B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
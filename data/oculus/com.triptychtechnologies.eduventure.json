ZbXJ6&_nc_oc=AdlapO7ADUAFDGxKYeT8DIyeO4BSFtL6yYxzSQ40HHP0EU0VC-qmir5I1W97PsUCTfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvExIY4HsECAmvDxijfKRjGfoHSWffc5J8Fr1KuUCK3mA&oe=69A05943"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z5lb5Draz4Q7kNvwES2I7g&_nc_oc=AdlrWuuEsAsnJGhqIc446vB4YEqOw5yboBKi1TqlXbS3U6xXqmIWOYioofQlqOUFX_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDrzn1w4AJTlsPrWn0rkUJ1QQr5MNovTZvHvk4-s--PQ&oe=69A02923"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a5MhvH3qhAkQ7kNvwHjjfyp&_nc_oc=AdlcduzPE0-h8TRPVRN60-eZgkwDuzWyzUvIWC8Gz9FBAZbDte5WeWM1Zq9YSow2ilE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvHQVFMsjZ2CReFg20M-8TsaVBUN0sU9pSCUQWLr_9hUg&oe=69A0586B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNeQexkKX6IQ7kNvwH5OEVx&_nc_oc=AdkYCT5s2EsiF17_vtKG2mGi_sPkC_Lm14B5DUNftqom2CAIhsUv2NkfTOd4SWImnfk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsk5m8NqNMT4f15N-ljIJCI9164I9wsmUdFTZ8lgZqDjA&oe=69A03474"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZsY0DpmSBEQ7kNvwHcdJra&_nc_oc=AdleIfhSiD3P88d10powYkVc1fyq0c5TvtWoGuA4VdZPbH1rNBSgK-6L3NtiJ3bWugM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftE6jjcugNzrK40o74ek_WK_5PyRt6WXSgCaya368weGg&oe=69A0434B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQU
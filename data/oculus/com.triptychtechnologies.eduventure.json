utkuo&_nc_oc=Adm8c49OEznSDUGdm2XDZTgmnKgU2L_afk3cJjb_dIF5QaX9B1xmSdk1R16kprwqUes&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsuTfyEQDrYjFsqn-2UFvbPDv-R5ymL9WDswD4AMon6Zg&oe=69A59F43"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_eQOln6bv8Q7kNvwGJfdWL&_nc_oc=AdlVrWFoleY6G3yFKERhpPG-U737OfWP3XN9_NybaWZF4ECS_8wxSeh23Kll4tsW9VY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftmIg3s07s2bgWt6O9sVtmm-hrAEdcPDCFm5ybhFxDfrA&oe=69A56F23"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyfum_AG8YQQ7kNvwEWeEgo&_nc_oc=AdmcppIfCDrp2HsYYpEE76ENZLZYtoMHXn3IlMfE0JTAp6yQk11Fl_Eg76wXjnlfBmM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuW85jDSV8kUriNS9WqNLaA_DAY7Pz6Ys3Rnx54UHN6ag&oe=69A59E6B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjn8MGQ-z7UQ7kNvwFX8UiZ&_nc_oc=AdlnURb6ykG36_sfH7x-9NyCah9a3hJgpRx28TVgKOPzPsG_lkUXVMsajdVinhl_8Hk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afuu6CEQvx9YPq6OzKZa7lJDzHfAiyXvhDvtMI2oiPjVnQ&oe=69A57A74"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3H-9VzBI37QQ7kNvwEqdFP9&_nc_oc=AdkhS2Yd1xiI4HLi4rNrPSOfvAvqZw2ry_1dS--vuBFZMMpuO4PVeLdvYLcA4hnCskw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afvwegy8GZqfhhSI6EL3MeX9M6ZSt3b5-0P8p9HUKvkldg&oe=69A5894B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQU
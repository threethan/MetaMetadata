_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ4n7T1maTUQ7kNvwG_0vmh&_nc_oc=AdoMChlkdhxBvuHR1cfsJ4wak-xlhYShc-jtEVOg27Hl6un3CRhs9elZYwTxU8JAEOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxqelSeZwIPmKoJZqfJ2Z3BIo3o7C0wLHjC1j4k30g7YQ&oe=69C937C3"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rpoeCrhHGoQ7kNvwET3dGG&_nc_oc=AdoMPfNT0te9trlLIGqI_YPWTqCh6QDvfyO1oEH6tokLpf3ysnmTZgWSnYhwTPqo78k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2YHDNldYjxGDBtiXdT3yRUeTceNUIIu9a5eyu-7KZAA&oe=69C907A3"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbP-5vcvxgEQ7kNvwFxrT8F&_nc_oc=AdqGdvuEIzv-vEfd5rSnTOQL2Vsadeyu2J5W0AnGnGOtRHS7V18f0Ccqg8drNBYB2bk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyWtdHUZFswbpkei3gBGn0IDfXnySKVsdogblAPWWbbew&oe=69C936EB"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWmmJ5c7YhUQ7kNvwF3Qn7o&_nc_oc=AdrDU7RUMfK5OI92Ix1OosZ-ezkVdRqn2cVVW_9HCS4ynVxnzjTqsDAJ2EpMQI7r9EY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSAQEPd9kKCTINf3zGENb7H28nIyayzzTC626pRI5Zmg&oe=69C912F4"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tt2T101WuoQ7kNvwHPfwKH&_nc_oc=Ado02a_eyPCjtZyR3HftV_8z39yYh39TRK44z13vnGKBvoJxjuRozndQxjM73TJ9MN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2idy5e2CQIhc9jaQnylO3bG4tTNQnT_TOqDNTImVEHQ&oe=69C921CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
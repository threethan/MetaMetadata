_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FIbJbr2ApEQ7kNvwEC94Hi&_nc_oc=Adqn6_T2NMcz8-OORKTvOJ-24q4gVUOTAGRIF1Q8tUlBI5YIPnFA9plesdVZ5nTVT6U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vnmPoitGACW2H4k6FqKnBXPTUedGf6JhdyZMYtDnA7w&oe=69E395C3"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2rT93HURjMQ7kNvwGfjp39&_nc_oc=AdqPf1GG2Kk7o22LyO4VxTZB-_3_C1f2uofW3iI4y7w43OLevYoMUKS50_a9NVh2jXU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2noVoaa_qsUsJHHmPRyZcaG-OFaSgzxbqyVFyoUBQ1eg&oe=69E365A3"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pYY6h7ClrvMQ7kNvwFXQpsP&_nc_oc=Adoj5VpVbLzIMii9t3LI349foOFl19LmLSog27x6XFLEYazgWA4YJaLhq1SU0bgJAl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0giJajlheqjeYZs7OUNte6bxNyrpbBjv50MRVHCaw0Fg&oe=69E394EB"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FOreCN44ud0Q7kNvwE_Jruq&_nc_oc=AdpWkeT7XkTUhlGriCG9GnM5S6gLfwf-HXKO6BPbgaQzzrrSk7usv1yqCPqUJz2rUOw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mifagtBdbii2bFgubvlnUeZXfzYqggfym4PrVOy388w&oe=69E370F4"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ9wI4geMEsQ7kNvwF0Fb-4&_nc_oc=Adr2mDYh3aZXCFQ4JbLlwLq0SHnuh535d4hOiUrjky3JH8QZaz5qtiUyB962eaf-IlQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GXzdmBVlKPWWW5w8o-8sf9GsSxn3X0-lnBdoQZwvZzg&oe=69E37FCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
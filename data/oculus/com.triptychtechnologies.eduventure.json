_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbOQma9k9a8Q7kNvwFwuCdH&_nc_oc=AdpoJTLw8DNJ9wTvgdKCRa-vdGoNB_97QYA3n4ly6rYNQMTd0QhDBTvtPtr3wDJxOnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyjbt3eLohHvFT5gp53sBbRdWR0_wU7mFxEaTKvTVC1YA&oe=69CD2C43"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GaBz6V3R9fkQ7kNvwEjA0X-&_nc_oc=Adp-5YQef-m5osukXRSNQMYjUzwZIQqakPByC1b4r8MUcekloWaqnmZQ0nOs6_RsMGo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afym0LHyw9P1bcWG6mkKE0eQBiG5TjHO1NDWGYltI3cTTA&oe=69CCFC23"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-FXpqxsSYcQ7kNvwGAign_&_nc_oc=AdqSXHY1gmiKxbHmXJyjhXKhVjW_S24LfqTPFSbAm51YM7qdwiMczwMscEM14Qy08W8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxpWJZQ6Xp9JFxsSMvGbSTFFuIv116IqutJhn1LxjMEA&oe=69CD2B6B"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UUq2Era9iUQ7kNvwE-wZyR&_nc_oc=Adr6HiX90m1oTniZVY-O5nsAdXmLKFrl7aRU-ePwLofY9HPN11r9Yfz9i4Vg394CMEc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxB6R-C6dQpzimIeTMkc5PDEbgYsgxgaDgwTMRNIVUhuw&oe=69CD0774"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlN1Sqb9R8MQ7kNvwH6LSbk&_nc_oc=Adqzmxg4o6L-UymHM2A6fXxTHhq-HbQIS2FT9JxJH8B5tE0a4Ndctbhk4cmyJAFV5EA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyzYYcDXPWU_JWHnuWdSFz7s9bDBHXO7YmmOS2J9Cza1g&oe=69CD164B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
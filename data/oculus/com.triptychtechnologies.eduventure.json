_654047020608470_4211026165686781663_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ4n7T1maTUQ7kNvwE9nkRi&_nc_oc=AdreRewDu2vWEL1wdotdfNvcZWn3Nji_5siM-dCT3QO7cSSw4FyDBl5r3imr1lbocdk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxBhFTKhT9TBHF7zAP629dI4vuOZlhRDMCMb7pmWcs4qA&oe=69CBDAC3"}, {"file_name": "4.png", "id": "649962867375210", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392022_649962870708543_7069226501484520693_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rpoeCrhHGoQ7kNvwFh5JHJ&_nc_oc=AdrbLx2DxM90nAHgqL-FqHD7hp9Lhhbgqm9vEc0hYZ6TrFUpt74B9cWMMM3Fr_gAscU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWouxmzFLG7-r0BcN5-JxgHGwMrChynF3M7C4t-kmNgQ&oe=69CBAAA3"}, {"file_name": "5.png", "id": "1043421394288928", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392051_1043421397622261_1382991484820655275_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-FXpqxsSYcQ7kNvwFCJ9kl&_nc_oc=AdquHuSBfq6EXa8EekhWrtyBiA85gds4DS5HwehwNgGyZ0ZUsAkTuQvfD8nNIvrp-TA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpX7HC_f1afG-DzxGK3J6uNHbw7nl2TEoB-jzelhF6JQ&oe=69CBD9EB"}, {"file_name": "6.png", "id": "653371803890579", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391878_653371810557245_3651789750881457873_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWmmJ5c7YhUQ7kNvwGcFhhV&_nc_oc=AdqCwQAiofSuM2ybOh6aXBQR4v2PHqbU_0rRmOwdFLRG0M3UBGni9Sl-VNGSjGN8sME&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwkigz9fS13Rx2OJV1mh_yCb07xKP391L7PLxvjIafQDw&oe=69CBB5F4"}, {"file_name": "3.png", "id": "2048662878986601", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391946_2048662882319934_4317911612510387418_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlN1Sqb9R8MQ7kNvwHdwUbV&_nc_oc=AdogPENV6BbbdBqpEf3pmxzaw-GYStYXpmHf5-zTprwJyzsj0nfXqyFf4c2U2hbig6E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwnMGGaJLeDhHfzaoVG4pdeGasfVx7ar9fqbvlLiG7D7w&oe=69CBC4CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eduventure", "keywords": ["education", "learning", "study", "VR", "AR"], "long_description": "Eduventure is a groundbreaking educational app that brings learning to life through the power of Virtual Reality (VR) and Augmented Reality (AR). Designed to revolutionize education, Eduventure offers immersive experiences that make even the most complex concepts easy to understand and fun to explore.\n\nWith Eduventure, students can embark on virtual tours of historical landmarks, conduct simulated science experiments, interact with 3D robotics models, and explore the wonders of the natural world\u2014all within a safe, engaging, and interactive environment. The app is aligned with educational curricula and caters to a variety of learning styles, ensuring that every student can benefit from personalized, hands-on learning.\n\nWhether it\u2019s visualizing the solar system, walking through ancient civilizations, or practicing emergency preparedness in disaster simulations, Eduventure transforms traditional classrooms into futuristic spaces of discovery. \n\nPerfect for schools, colleges, and individual learners, Eduventure is your gateway to a smarter, more engaging way of learning. Experience the future of education today!", "short_description": "Eduventure is an immersive learning app designed to transform education. Experience hands-on simulations, virtual tours, and curriculum-aligned content that make learning exciting, interactive, and unforgettable. Perfect for students and lifelong learners!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.triptych-technologies.com/privacy-and-policy", "developer_terms_of_service_url": null, "publisher_name": "TRIPTYCH TECHNOLOGIES PRIVATE LIMITED", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
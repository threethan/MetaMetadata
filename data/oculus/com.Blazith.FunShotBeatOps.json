71-25/499303391_1523947541927735_8236963164727395841_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UH0y3P2loLUQ7kNvwEx-gOx&_nc_oc=AdmCet1xJWJqjc2zvlWnWQ91HGIFV1vOAejlRiX8NDaYmboVvHpB3sD6Cg6_1MzHgWM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwM2cb90bxG8qjZd7sagrd6EqYU46sTUD0oOqIB76u8mQ&oe=69B92F11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "2188703811627413", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823893_2188703814960746_6988630981475026277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_5XXNbjQ3oQ7kNvwFbY6SS&_nc_oc=Admm05vtINdyPx_qjf2WzXyCEVVNIcHcrxp-s3tfZa_m9SboNt8GpLg-1nFN3tUEKgM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxR3ueus_RCoichqrmUlHW0M_j0mvtiwTqEskVGSxDBgQ&oe=69B92ED8"}, "display_name": "Fun Shot Beat Ops", "keywords": ["Shooting", "Action", "Beat", "Shooter"], "long_description": "Fun Shot Beat Ops is an immersive VR experience that puts your aim and reflexes to the test. Armed with only your pistol, you\u2019ll face waves of enemies in action-packed arenas. Every shot pulls you deeper into the game, challenging your focus and speed.\n\nThe game is still in development, and upcoming updates will bring new themed maps and fresh content, ensuring that every session feels exciting and different.\n\nFun Shot Beat Ops is more than just target practice \u2014 it\u2019s about placing yourself right in the middle of the action. Are you ready to take the shot?", "short_description": "Fun Shot Beat Ops is a fast-paced VR shooter that tests your reflexes! Take down enemies with your pistol, dive into the action, and feel the intensity all around you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.com/private.pdf", "developer_terms_of_service_url": null, "publisher_name": "MesutKocaker", "support_website_url": null, "website_url": "http://blazith.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfo
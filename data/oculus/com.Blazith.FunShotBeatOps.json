=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsCqLnZFaJ-x_6Q5dx4q2oQRa5jotdArxedq6klEzMGfA&oe=699F0951"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "2188703811627413", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823893_2188703814960746_6988630981475026277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jqdqp97mHRgQ7kNvwEl0LZx&_nc_oc=AdmsyW6keCm6shjKQdeAhhKMlVfYajuYiEWBH8ccIEeW4BGQdrRWEK7Ans_Ro6Aq1UI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuViRwhGaxpkurOvIekDbmfSF2rEWKWknGq4rqdS5d8tw&oe=699F0918"}, "display_name": "Fun Shot Beat Ops", "keywords": ["Shooting", "Action", "Beat", "Shooter"], "long_description": "Fun Shot Beat Ops is an immersive VR experience that puts your aim and reflexes to the test. Armed with only your pistol, you\u2019ll face waves of enemies in action-packed arenas. Every shot pulls you deeper into the game, challenging your focus and speed.\n\nThe game is still in development, and upcoming updates will bring new themed maps and fresh content, ensuring that every session feels exciting and different.\n\nFun Shot Beat Ops is more than just target practice \u2014 it\u2019s about placing yourself right in the middle of the action. Are you ready to take the shot?", "short_description": "Fun Shot Beat Ops is a fast-paced VR shooter that tests your reflexes! Take down enemies with your pistol, dive into the action, and feel the intensity all around you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.com/private.pdf", "developer_terms_of_service_url": null, "publisher_name": "MesutKocaker", "support_website_url": null, "website_url": "http://blazith.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [],
t (3).png", "id": "1523947538594402", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303391_1523947541927735_8236963164727395841_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-MWJv0t0_sQ7kNvwEv4gpX&_nc_oc=AdrjcQr650l4hrlb7WeqODduIGEwo1Mh1GpsPvFnprj3JtnYgzwkODy3zcuK8JcphlY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60IHnV5gw-NypY0H5F0PkcKJ5okT6BMb6EK0dfFyz5eA&oe=6A0F18D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "2188703811627413", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823893_2188703814960746_6988630981475026277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4zhmAQSruIQ7kNvwE2ZwpZ&_nc_oc=AdrG9VZRDeMdndFb0Pd8oxrn33BBtxRcHtq9hUep1kbrK8rweB2pwjIJXkIZr3tb02w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4POvgdhrEyZ5FjEkQReZ51ZrOHo6rS4nnXFoRyRtPXTw&oe=6A0F1898"}, "display_name": "Fun Shot Beat Ops", "keywords": ["Shooting", "Action", "Beat", "Shooter"], "long_description": "Fun Shot Beat Ops is an immersive VR experience that puts your aim and reflexes to the test. Armed with only your pistol, you\u2019ll face waves of enemies in action-packed arenas. Every shot pulls you deeper into the game, challenging your focus and speed.\n\nThe game is still in development, and upcoming updates will bring new themed maps and fresh content, ensuring that every session feels exciting and different.\n\nFun Shot Beat Ops is more than just target practice \u2014 it\u2019s about placing yourself right in the middle of the action. Are you ready to take the shot?", "short_description": "Fun Shot Beat Ops is a fast-paced VR shooter that tests your reflexes! Take down enemies with your pistol, dive into the action, and feel the intensity all around you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.com/private.pdf", "developer_terms_of_service_url": null, "publisher_name": "MesutKocaker", "support_website_url": null, "web
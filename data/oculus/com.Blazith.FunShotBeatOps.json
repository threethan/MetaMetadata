t (3).png", "id": "1523947538594402", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303391_1523947541927735_8236963164727395841_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LNIHaOB8vsQ7kNvwHhaJfe&_nc_oc=AdrrkCrDs-1jO_aWfzTE_Yjj1KVUkkVvNGWpY9xw_Z1Qr8Xm9yH6gwxuZKBHP4ol1Kg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0lttelqGfCEGFynQ7OHKIMn2WzdBXxzmwpAjy6wlnxA&oe=6AB535D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "2188703811627413", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823893_2188703814960746_6988630981475026277_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kC-xr5DOyq8Q7kNvwEFti0I&_nc_oc=AdoG5kcBUseSwwoUinhDlBFy6LkKPcl9ZQialu4CUwvzZ0xzoKbywRs_XXTF3kS3mJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN3EFAimOdMRzeKV8mHSc1XPS3Vdlkm0Dk1C4EEzCOFw&oe=6AB53598"}, "display_name": "Fun Shot Beat Ops", "keywords": ["Shooting", "Action", "Beat", "Shooter"], "long_description": "Fun Shot Beat Ops is an immersive VR experience that puts your aim and reflexes to the test. Armed with only your pistol, you\u2019ll face waves of enemies in action-packed arenas. Every shot pulls you deeper into the game, challenging your focus and speed.\n\nThe game is still in development, and upcoming updates will bring new themed maps and fresh content, ensuring that every session feels exciting and different.\n\nFun Shot Beat Ops is more than just target practice \u2014 it\u2019s about placing yourself right in the middle of the action. Are you ready to take the shot?", "short_description": "Fun Shot Beat Ops is a fast-paced VR shooter that tests your reflexes! Take down enemies with your pistol, dive into the action, and feel the intensity all around you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.com/private.pdf", "developer_terms_of_service_url": null, "publisher_name": "MesutKocaker", "support_website_url": null, "web
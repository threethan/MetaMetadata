oe=6AF0AB17"}, {"file_name": "5A.png", "id": "821151567709645", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_821151571042978_6234089121180248947_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBygYmFVQKIQ7kNvwFC4sxt&_nc_oc=AdqXeJ325Hg1LwgBff2C_vtteUTJS9i-odQPcgm4kecxMp3FZLrQobwn0p6v5w_RvGI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd0_yjkwEx2MJMG9ULO5o0wV7FhU3P4YWgupPQfnbMYQ&oe=6AF0968E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1410369324626485", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824741_1410369327959818_5057080874294011664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JQRNIokPagQ7kNvwHLImvy&_nc_oc=AdpDreVxBp6lASYPk39Vo9boRfns0UiIdxHd5P7WXjsJ5dI-jhPhJgaf100tc9uln2E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJm8M6wlMtYKoREL3OwPVr0cgx8gQtfgziJ-SPD4mUBw&oe=6AF08060"}, "display_name": "Calmness", "keywords": ["antistress", "minimalizm", "relax", "holiday", "calmness"], "long_description": "Your Sanctuary, Your Rules\nWhy settle for one way to relax when you can explore dozens? Calmness offers a diverse collection of \"Living Rooms\"\u2014interactive environments designed to trigger an immediate relaxation response.Why Play Calmness?\nWe built this for the overthinkers, the late-night workers, and anyone who needs a five-minute escape from reality. It\u2019s the perfect companion for meditation, study, or winding down before sleep.\nUnlock the door. Leave the stress behind.", "short_description": "The world is loud, fast, and often overwhelming. Calmness is the mute button you\u2019ve been looking for.\nIn this immersive antistress experience, you aren't just playing a game\u2014you are curating your own sanctuary. Whether you need the rhythmic patter of rain against a window or the soft hum of a futuristic library, the key to your peace is literally in your hands."}]}, "developer_name": "Azai Gaming", "developer_privacy_p
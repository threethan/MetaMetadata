1-25/491823279_1575083184084617_6406961602886303743_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IWXLrIp0ugQ7kNvwEneHiM&_nc_oc=AdoFsgPHF5F2HHj3bWooLWjvgPCrus1kCV0qpaxcx7Qctv03i6QbEF6juChe1vyhGM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU_dKHxI6b2tP_GIJ82EZXlNjhtc312RE8NWJ0bwutkCg&oe=6B0EFD97"}, {"file_name": "5A.png", "id": "821151567709645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_821151571042978_6234089121180248947_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5BX6YgB7FIQ7kNvwH0wCv_&_nc_oc=Adq3zGBj_mBwgUMIQww-xT6ockur4eAyvFUBATZiCh-8mbCK2yLu8tzDQk3gyJ-x5VY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVmu-ph-YjvjqLyDLJnZ21XhVWIFaXhRxbcuFo4n7xkHA&oe=6B0F214E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1410369324626485", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824741_1410369327959818_5057080874294011664_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4rnzMpmNkUQ7kNvwGoo7DU&_nc_oc=AdqaLiO2huTq9VHZaJXapTmPv_PWz3u1jsbqTIZBq1ngWSGpN8i6w-WshUpG96UpP2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW8am4xT9VhOBndYt8F9WN4ZfftJOPjBDJaL4MNl8p5CQ&oe=6B0F0B20"}, "display_name": "Calmness", "keywords": ["antistress", "minimalizm", "relax", "holiday", "calmness"], "long_description": "Your Sanctuary, Your Rules\nWhy settle for one way to relax when you can explore dozens? Calmness offers a diverse collection of \"Living Rooms\"\u2014interactive environments designed to trigger an immediate relaxation response.Why Play Calmness?\nWe built this for the overthinkers, the late-night workers, and anyone who needs a five-minute escape from reality. It\u2019s the perfect companion for meditation, study, or winding down before sleep.\nUnlock the door. Leave the stress behind.", "short_description": "The world is loud, fast, and often overwhelming. Calmness is the mute button you\u2019ve been looking for.\nIn this immersive antistress experience, you aren't just playing a game\u2014you are curating your own sanctuary. Whether you need the rhythmic patter of rain against a window or the soft hum of a futuristic library, the key to your peace is literally in your hands."}]}, "developer_name": "Azai Gaming", "developer_privacy_policy_url": "https://purposeworlds.wordpress.com/2026/08/09/privacy-policy-of-calmness", "developer_terms_of_service_url": null, "publisher_name": "Azai Gaming", "support_website_url": "https://purposeworlds.wordpress.com/external-support-link-of-calmness/", "website_url": "https://purposeworlds.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27828511033497196"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313074_4941162299444387_7669105020805618512_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMMj8DRn4vwQ7kNvwHFu4zw&_nc_oc=AdqO6SWE0ra7K_J6lwQlWdgVkvnqDdt3s6UBQz2VAu0N2hlgYs-n_EZjoXj8cxA4T_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVIk0vRAJUX9tydZT8ZGh87NmL43V3RjAv6j_1spWTlGw&oe=6B0F124E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Calmness", "platform"
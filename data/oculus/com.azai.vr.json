GQrjjtw&oe=6AAE87D7"}, {"file_name": "5A.png", "id": "821151567709645", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824292_821151571042978_6234089121180248947_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0igCdGt6P4Q7kNvwFX8lE2&_nc_oc=AdqIJQ-T11ffwRIM1LHgUs3ujTkHIkuS53lmjwTM3YDVlK4x4TWq4j3BJMnZCCTlMgE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMX5bHsceHkIO2APruv9ANYImF1_cMdJMbfEloddbu3g&oe=6AAEAB8E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1410369324626485", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491824741_1410369327959818_5057080874294011664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NH9x4XigrzQQ7kNvwFNfM9j&_nc_oc=AdrAMLd0a5ADPcBd52pieFMHE0uLNfBbzYIMqiIx--5mY_1uEV7Amy8zLHY55pYdTS0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL33JucpwxOz_SegMGej79hDKPv4oxZOOu6KHpNxlsxTg&oe=6AAE9560"}, "display_name": "Calmness", "keywords": ["antistress", "minimalizm", "relax", "holiday", "calmness"], "long_description": "Your Sanctuary, Your Rules\nWhy settle for one way to relax when you can explore dozens? Calmness offers a diverse collection of \"Living Rooms\"\u2014interactive environments designed to trigger an immediate relaxation response.Why Play Calmness?\nWe built this for the overthinkers, the late-night workers, and anyone who needs a five-minute escape from reality. It\u2019s the perfect companion for meditation, study, or winding down before sleep.\nUnlock the door. Leave the stress behind.", "short_description": "The world is loud, fast, and often overwhelming. Calmness is the mute button you\u2019ve been looking for.\nIn this immersive antistress experience, you aren't just playing a game\u2014you are curating your own sanctuary. Whether you need the rhythmic patter of rain against a window or the soft hum of a futuristic library, the key to your peace is literally in your hands."}]}, "developer_name": "Azai Gaming", "developer_p
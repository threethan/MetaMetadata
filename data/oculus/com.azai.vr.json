oe=6AAFD957"}, {"file_name": "5A.png", "id": "821151567709645", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_821151571042978_6234089121180248947_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0igCdGt6P4Q7kNvwFIBt_-&_nc_oc=Adqn-pixVsyNguNUJXhWdI9KAmU_28O5l1n5aSnNNZLU0M2JWyWf4Q0Cket145cEG4c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ9dSDM8T80lsA-M6X_un7yvG1c5YZKWd963dj-DhziA&oe=6AAFFD0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1410369324626485", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_1410369327959818_5057080874294011664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NH9x4XigrzQQ7kNvwHmDrsj&_nc_oc=AdqrkPXyBblyTO1WfzAbh1Wy9jKU-XKQsSl4oBa2fgDYX7rM84r5Hq02CSdURuAZovw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7_UEJdbarIAB6zOWzPLtx86p0aZOH-i6vhafnWadRIg&oe=6AAFE6E0"}, "display_name": "Calmness", "keywords": ["antistress", "minimalizm", "relax", "holiday", "calmness"], "long_description": "Your Sanctuary, Your Rules\nWhy settle for one way to relax when you can explore dozens? Calmness offers a diverse collection of \"Living Rooms\"\u2014interactive environments designed to trigger an immediate relaxation response.Why Play Calmness?\nWe built this for the overthinkers, the late-night workers, and anyone who needs a five-minute escape from reality. It\u2019s the perfect companion for meditation, study, or winding down before sleep.\nUnlock the door. Leave the stress behind.", "short_description": "The world is loud, fast, and often overwhelming. Calmness is the mute button you\u2019ve been looking for.\nIn this immersive antistress experience, you aren't just playing a game\u2014you are curating your own sanctuary. Whether you need the rhythmic patter of rain against a window or the soft hum of a futuristic library, the key to your peace is literally in your hands."}]}, "developer_name": "Azai Gaming", "developer_privacy_p
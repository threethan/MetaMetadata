"}, {"file_name": "4A.png", "id": "1073895418330293", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_1073895421663626_3335985762934849434_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faSK22SJgtgQ7kNvwF9PVy1&_nc_oc=AdpqU9Rn8rXUo9j-b8mbm4dSlxzcBvDNaTgE12XgnOh5iuVoCHrIu-oDwnfvXDN-rHY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhRXtds8thcABhNb_Au799qr2ITHxRjlNpoMKryu8odg&oe=6ADDF93F"}, {"file_name": "2A.png", "id": "1575083180751284", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823279_1575083184084617_6406961602886303743_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EAdTSQrnFsQ7kNvwGyLJEf&_nc_oc=Ado5Wbl_9JbFy-5vlB4LsnPDjl5uV-gIXovQZLzYHKvSPJOd7eXdsRrNdhXq-4vTioU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN23NZh8xTlm1x78_g0gIm_RU5ABgm-6l8gpybcd1LZtw&oe=6ADDFDD7"}, {"file_name": "5A.png", "id": "821151567709645", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824292_821151571042978_6234089121180248947_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfY-_IEdgCUQ7kNvwFAG37z&_nc_oc=AdrPEboxuuEAjgLsGJxaJXnO1c1tZdtzjdjgngDd7l_g-txkJu9l8Clvlb5eodc5rXw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkSzv5Phk3PfbbH4cOK5-NFSJrwPUqSL7SKiZGc37iIA&oe=6ADE218E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calmness", "keywords": ["antistress", "minimalizm", "relax", "holiday", "calmness"], "long_description": "Your Sanctuary, Your Rules\nWhy settle for one way to relax when you can explore dozens? Calmness offers a diverse collection of \"Living Rooms\"\u2014interactive environments designed to trigger an immediate relaxation response.Why Play Calmness?\nWe built this for the overthinkers, the late-night workers, and anyone who needs a five-minute escape from reality. It\u2019s the perfect companion for meditation, study, or winding down before sleep.\nUnlock the door. Leave the stress behind.", "short_description": "The world is loud, fast, and often overwhelming. Calmness is the mute button you\u2019ve been looking for.\nIn this immersive antistress experience, you aren't just playing a game\u2014you are curating your own sanctuary. Whether you need the rhythmic patter of rain against a window or the soft hum of a futuristic library, the key to your peace is literally in your hands."}]}, "developer_name": "Azai Gaming", "developer_privacy_policy_url": "https://purposeworlds.wordpress.com/2026/08/09/privacy-policy-of-calmness", "developer_terms_of_service_url": null, "publisher_name": "Azai Gaming", "support_website_url": "https://purposeworlds.wordpress.com/external-support-link-of-calmness/", "website_url": "https://purposeworlds.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27730340916647542"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1425475852791582"}]}, "baseline_offer": {"id": "1425475852791582"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789115520, "status": "PUBLISHED", "id": "1425475852791582"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27858638980484401", "version": "0.5.0"}, "id": "1781496326122137", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries":
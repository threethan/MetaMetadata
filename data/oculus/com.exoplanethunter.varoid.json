392_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8iAwuXln6IgQ7kNvwFmQZMo&_nc_oc=Adr__aAICrNUOsLxFuQzuiiYcNQx8La6fYt1tpmwfuGtVNcCrr2642GZiPsevpZzpmY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVPr1dGF9ISD9dTc9RgFn9fSBjX7Si4VYlabOFNuQ_aA&oe=6A8D837E"}, {"file_name": "migrated_image.png", "id": "512593359452943", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982719_692677891206964_4366490016285720576_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4VEUS1G8d8Q7kNvwGWfr3Z&_nc_oc=AdrSCBQ7jOAIYYNYCXnbNoVGyzDJi98l6KOvtHwOFx1i8cKYjOAKoT9ZDSzZv7hyF0w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgoxj4hAvQtGQ3wDW0l_pAqw9VDDmuOWCFPCw3TLeucw&oe=6A8D7A11"}, {"file_name": "migrated_image.png", "id": "2087693461376444", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974718_2621018567985490_5810449912302665728_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YA6tCLyvOGEQ7kNvwH2qar5&_nc_oc=AdodPB0VA6QEAYUiYziWIB_8VaynU_tCP16CPjX44Iz-IzAbOI_gV3xKIZaYEE0GRd0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrQv2S-HlO6xC5uwM2OF6u4ukHskk65710__8dCIG_BA&oe=6A8D9171"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exoplanethunter", "keywords": ["Exoplanets"], "long_description": "We live in one of the most exciting times ever, thousands of exoplanets have been found. An extrasolar planet, or exoplanet, is a planet outside our Solar System. Even planets very similar to our own Earth have been confirmed which raises questions about the existence of extraterrestrial life. \n\nThe purpose of the application is to give the user a comprehensive and accurate overview of discovered exoplanets. View all discovered planets in the milky way. The application shows a 3D simulation of each solar system.\n\nData provided by PHL's Exoplanet Catalog of the Planetary Habitability Laboratory", "short_description": "View all discovered exoplanets. The application shows a simulati
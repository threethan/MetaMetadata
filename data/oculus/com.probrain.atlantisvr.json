uluscdn.com&_nc_ss=7f30f&oh=00_AQU7qDfSZxiltZ8c8IiDxXQIj_-XlLc40zkMzMwFdjMmxw&oe=6B0EF384"}, {"file_name": "screenshot_5.png", "id": "1345625772716490", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035351_1345625776049823_4037183177058777847_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UOTnVZvABwQ7kNvwHgMjBv&_nc_oc=AdpJKNuMPLC11mztde6ZTsfwDW_MWArHhjMpNFW6DFXMAGrYLMmls0RczF_IpLNQSmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVtadsX3_ts6Q8fdyIQvnRqCs80xO4nfWgV2ZqKT1f7-g&oe=6B0F20A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video_cover_image.png", "id": "209359605404583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974861_209359612071249_1729760973645596798_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK7-quwO4xsQ7kNvwGfbVC9&_nc_oc=AdoeQxUHxp5TcjXE3fvqGVTm-j8kaTIdhrwTNgvXP03Z8qDvDjUXBYqyPbgY3bHTZ2Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8TfJ_PxMrZd7FXPKPvlBZnhUV9W7gER8PNIvXv6NKAg&oe=6B0F0C55"}, "display_name": "Atlantis VR", "keywords": [], "long_description": "Explore the lost wonders of Atlantis in an immersive virtual reality experience.\n\nBy diving into the depths of the ocean you will stimulate the following skills: Selective attention, naming, reading, processing speed, and inhibitory control.\n\nUncover ancient secrets in this color and word challenge based on the STROOP effect. All while taking part in a unique and legendary adventure in the underwater city of Atlantis.", "short_description": "Explore the lost city of Atlantis, where you will stimulate: Selective attention, naming, reading, processing speed, and inhibitory control."}, {"images": {"nodes": []}, "id": "957061799410393", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atlantis VR", "keywords": [], "long_description": "Explore as maravilhas perdidas de Atl\u00e2ntida em uma experi\u00eancia imersiva de realidade virtual.\n\nAo mergulhar nas profundezas do oceano voc\u00ea estimulara as seguintes habilidades: Aten\u00e7\u00e3o seletiva, nomea\u00e7\u00e3o, leitura, velocidade do processamento, e controle inibit\u00f3rio. \n\nDesvende segredos antigos neste desafio de cores e palavras baseado no teste de STROOP. Tudo isso enquanto participa de uma aventura \u00fanica e lend\u00e1ria na cidade subaqu\u00e1tica de Atl\u00e2ntida.", "short_description": "Explore a cidade perdida de Atl\u00e2ntida, nela voc\u00ea estimulara: Aten\u00e7\u00e3o seletiva, nomea\u00e7\u00e3o, leitura, velocidade do processamento, e controle inibit\u00f3rio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://termos.probrain.com.br/pub/policies/Privacy_Policy_Probrain_addAtlantis_2024.pdf", "developer_terms_of_service_url": null, "publisher_name": "ProBrain Solu\u00e7\u00f5es Neurotecnol\u00f3gicas para Sa\u00fade e Educa\u00e7\u00e3o Ltda", "support_website_url": null, "website_url": "https://www.probrain.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7338419742950305"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1570022440341106"}, {"status": "PUBLISHED", "id": "789662679434549"}]}, "baseline_offer": {"id": "1570022440341106"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1736857800, "status": "PUBLISHED", "id": "1570022440341106"}]}, "liveCh
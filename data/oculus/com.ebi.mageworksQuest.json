nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRP-wODlfTzU6tc5dWWFB5bHw1I_nslcv21w0clfbnaA&oe=69AC1D73"}, {"file_name": "MW_Oculus_Screenshot02_1.png", "id": "810228000883721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_810228004217054_1061206612841900641_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ-eEnNi668Q7kNvwH6NGeu&_nc_oc=Adk1bhzQXUT2zG-GqCiQHShBOpA7zZkwthRS8Rd7OQ8rEMQYBnpNSuYg0UbFezZVAzA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxOquZtDKqLhSMgaL85Z37ecCs2wsHtoKLu127gi8S-kQ&oe=69AC1EBC"}, {"file_name": "MW_Oculus_Screenshot03_1.png", "id": "246546351566756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_246546354900089_937731810484100751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXgIIdD-y3sQ7kNvwGLZRVd&_nc_oc=Adn1ZSZUviFcNPTnuFjab7-3081FQUhptbOiPu2epgfXa2OrBxhDXoB2byxq1FuEACA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfydVqDC-i4O7sY3hHtqGZT4wQDHGW4t-KO9QT_SGgm0tg&oe=69AC3480"}, {"file_name": "MW_Oculus_Screenshot04_1.png", "id": "811037817325925", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575360_811037820659258_3093844724899004257_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfC_grEMyjIQ7kNvwEqqHLe&_nc_oc=AdnIVDVxGI0-SN9HMqgCLY7A0SWPzR81WOaCdsl1fOdEPKpw_BigIVS-eirWFoYYSqo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZjywPTKAhy5OB5oTrvXjkPDxyNEBGnSLfn2zsz8yDvQ&oe=69AC38B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1822462261440247", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974817_1822462264773580_3388714471754744082_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZIWEmInH8AAQ7kNvwEX6qp_&_nc_oc=AdlB1v3zb8IcGBdpCKbqo6q4LGtxjsZv0uz9WmMXscBNwme89g4hJ4JQF2OBqwBtKhc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzy9_PrZv88m_EySc1yVTrFc5MDordt6_kC0S-xNWAvag&oe=69AC0D13"}, "display_name": "MageWorks", "keywords": [], "long_description": "With your spellbook in one hand, and your staff in the other, travel to distant lands to discover new spells, battle foes, and collect staff crafting resources to build your own staff.  \n\nMageWorks puts the player into the role of a mage that has just finished their magic school, and now must venture out to explore the world...to pay off their magic school debt.  With side jobs like riding a roller coaster, or battling waves of enemies with newly discovered spells, earn gold to work your way out of magic school debt.  \n\nUse the observatory to find and unlock up to 25 spells.  Reach into the skies with your staff to summon a ball of lightning, or use the energy of the ground to summon protective shields.  Six different spell classes and a study hall to play with your spells.  \n\nUse your workshop to craft a custom staff to bring on your adventures.  Your staff ideas come to life with crystal shaping, wood carving, and painting. \n\nMageWorks is an ongoing development and is still in process of being built.  Most levels can be played through, but they are undergoing various tests in puzzle design,  art passes, and gameplay tweaks from time to time as the game continues to evolve. \n", "short_description": "With your spellbook in one hand and your staff in the other, travel to distant lands where you can unlock new spells, collect resources to craft your own staff, and earn your keep as a Mage! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/applicationsprivacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": "https://www.earthborninteractive.com/mageworks", "website_url": "https://www.earthborninteractive.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1008279844328894"}], "external_subscri
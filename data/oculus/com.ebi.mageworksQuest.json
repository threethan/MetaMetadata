nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9rC88TDWLYQgMOoMDbqGsx7u4Is_lvzcLAVvu2ixQbA&oe=69AEC073"}, {"file_name": "MW_Oculus_Screenshot02_1.png", "id": "810228000883721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_810228004217054_1061206612841900641_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KENiCTuDd1IQ7kNvwEZ-mGi&_nc_oc=AdmdkC20Ww7dIf1fPoODC9Ktj8FaTBMyC0eEEhanpsl2zv3Z6HDXhVziWE5khp9yllU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2Pvcxi2AQtKmQp647S_8bLHpNtUqEV6EhLScRu1-pvQ&oe=69AEC1BC"}, {"file_name": "MW_Oculus_Screenshot03_1.png", "id": "246546351566756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974840_246546354900089_937731810484100751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqmnBoY75UIQ7kNvwGZyUAw&_nc_oc=Admml6Q_zMSMvyvONjCn2XpRzSG3toN7Y0wvqYL1Y9G7CakrmG_kVw9jPz1lXszDof4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNGLRVf4kDFIvmgP7bJHGNqJpwz-n5X-v39nslSTXYMA&oe=69AED780"}, {"file_name": "MW_Oculus_Screenshot04_1.png", "id": "811037817325925", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575360_811037820659258_3093844724899004257_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN4CyMdZauwQ7kNvwEddz85&_nc_oc=Adl4638BvFGKBvTxqCkNx4CZ625mhyk0MEdaBRynta6P-XDUroYFoGMY0dNgrSmcwm8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxOR5KNbLEjY1qrDxtAB_EnzCuKco57I0Fju6uD3W_DOQ&oe=69AEA378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1822462261440247", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974817_1822462264773580_3388714471754744082_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GtPzxZn39AQ7kNvwG80wrW&_nc_oc=Adlf7S0MUwaQHIXj5SNjiF7Hcr7yT51JGMENJhah--Sue5Wo5Qn_cu-foq_f-f1hmFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzY3vIezZQEwqwL_W2Fp4uWgmyichwaBfr6X11UHg1JpA&oe=69AEB013"}, "display_name": "MageWorks", "keywords": [], "long_description": "With your spellbook in one hand, and your staff in the other, travel to distant lands to discover new spells, battle foes, and collect staff crafting resources to build your own staff.  \n\nMageWorks puts the player into the role of a mage that has just finished their magic school, and now must venture out to explore the world...to pay off their magic school debt.  With side jobs like riding a roller coaster, or battling waves of enemies with newly discovered spells, earn gold to work your way out of magic school debt.  \n\nUse the observatory to find and unlock up to 25 spells.  Reach into the skies with your staff to summon a ball of lightning, or use the energy of the ground to summon protective shields.  Six different spell classes and a study hall to play with your spells.  \n\nUse your workshop to craft a custom staff to bring on your adventures.  Your staff ideas come to life with crystal shaping, wood carving, and painting. \n\nMageWorks is an ongoing development and is still in process of being built.  Most levels can be played through, but they are undergoing various tests in puzzle design,  art passes, and gameplay tweaks from time to time as the game continues to evolve. \n", "short_description": "With your spellbook in one hand and your staff in the other, travel to distant lands where you can unlock new spells, collect resources to craft your own staff, and earn your keep as a Mage! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/applicationsprivacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": "https://www.earthborninteractive.com/mageworks", "website_url": "https://www.earthborninteractive.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1008279844328894"}], "external_subscri
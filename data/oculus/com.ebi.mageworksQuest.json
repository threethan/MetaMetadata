n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0yY-kiptuwQ7kNvwHA_psP&_nc_oc=AdpSpf4yiDd0aXNFwpW-CqJgAr1eFAOQpzfBp82qF7uQyY-N4oB2T5cIvRtwY7yB4LA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytNWJXS11y7JoyoHZEKuyfPrClMHR4iKZ34gjmp6VHSQ&oe=69CE6473"}, {"file_name": "MW_Oculus_Screenshot02_1.png", "id": "810228000883721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_810228004217054_1061206612841900641_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZukEpmiVnwIQ7kNvwGNpRga&_nc_oc=Adp5dL2PBJ7QXbrgPInYcemR3E-LyLRiiu20x6tpa6e4PXcjh2IsWCAKPzMJADTDtMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykuSAOquRiJxQ8Bf44bocW0fb62qkG_n6g6fAJhbiqHQ&oe=69CE65BC"}, {"file_name": "MW_Oculus_Screenshot03_1.png", "id": "246546351566756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_246546354900089_937731810484100751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhsUCCnR57QQ7kNvwE1R_PP&_nc_oc=AdonNFj1ryY0s-UDNBbc4QioYWuWd2xsfseFdcsBuR9S4GFSzV_cERDKeW8QwTqSbkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjUDrer7nUY-I1rKIuSp9VYPI3FkBRMxvHjJLmujMKlQ&oe=69CE7B80"}, {"file_name": "MW_Oculus_Screenshot04_1.png", "id": "811037817325925", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575360_811037820659258_3093844724899004257_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJoUWWEeam8Q7kNvwH3oO5W&_nc_oc=AdozdMiRvx1A_gX0RAuG_5wzTUHH5MpRV7cjL4Q9unUZb7bDkmgubYwrzg25otKXuQg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeIXWE_kcGwtabkDh7KwDD7eZqxbycXakLM2xxDBTjgA&oe=69CE7FB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1822462261440247", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974817_1822462264773580_3388714471754744082_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4O4CK1GMoLEQ7kNvwEsvyb9&_nc_oc=Adqe0PFYVCWvjZ1rrtaVpYWGOEe-Mk73UW-HjobKofbXyiRi1VYd2kYbU9r1qEpxBnw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxdhiZ-AepEtUF5xXsH5A7PZxgVVP4GjZpESwOcNjPJsA&oe=69CE5413"}, "display_name": "MageWorks", "keywords": [], "long_description": "With your spellbook in one hand, and your staff in the other, travel to distant lands to discover new spells, battle foes, and collect staff crafting resources to build your own staff.  \n\nMageWorks puts the player into the role of a mage that has just finished their magic school, and now must venture out to explore the world...to pay off their magic school debt.  With side jobs like riding a roller coaster, or battling waves of enemies with newly discovered spells, earn gold to work your way out of magic school debt.  \n\nUse the observatory to find and unlock up to 25 spells.  Reach into the skies with your staff to summon a ball of lightning, or use the energy of the ground to summon protective shields.  Six different spell classes and a study hall to play with your spells.  \n\nUse your workshop to craft a custom staff to bring on your adventures.  Your staff ideas come to life with crystal shaping, wood carving, and painting. \n\nMageWorks is an ongoing development and is still in process of being built.  Most levels can be played through, but they are undergoing various tests in puzzle design,  art passes, and gameplay tweaks from time to time as the game continues to evolve. \n", "short_description": "With your spellbook in one hand and your staff in the other, travel to distant lands where you can unlock new spells, collect resources to craft your own staff, and earn your keep as a Mage! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/applicationsprivacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": "https://www.earthborninteractive.com/mageworks", "website_url": "https://www.earthborninteractive.com/", "category": "GAMES", "comfort_rating": null, "comfort_ta
n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zb5LAaFfey0Q7kNvwGvEn_u&_nc_oc=AdqpL-wmuKFqvAViVT9_dSWiDC8GQDj0b6bStubIZ7BPRo5TusKsIXgYPn1mFfogOLw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjDWajKMZ5wsy_KkaO2JPwcUmXpYjDZdtgZNRRuwb1BA&oe=69CD12F3"}, {"file_name": "MW_Oculus_Screenshot02_1.png", "id": "810228000883721", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003247_810228004217054_1061206612841900641_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jQ4KKSVsPcQ7kNvwFpPlnM&_nc_oc=AdryG2_Q9cEtHWyY1Ps0UarO6OUL0FkAw0xk5UdOJKxVAhNAlL95i46PLt-HQTPhPh8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzM26CaxWKHrIkj9A5pVGcJOw3dUVj_A8KHOwtaooU8nQ&oe=69CD143C"}, {"file_name": "MW_Oculus_Screenshot03_1.png", "id": "246546351566756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974840_246546354900089_937731810484100751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6LHTqaJKHMQ7kNvwF-frnz&_nc_oc=AdpaB2XgWukw6II3t_KQCyWGNG-rqog9Z3-Xaenmu_wP_-U-34I-J-LxNP9OarwaVnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNBLHUdrEi4nv9iNGySqVbfKFEVZXsQnusBmKr41VM2Q&oe=69CD2A00"}, {"file_name": "MW_Oculus_Screenshot04_1.png", "id": "811037817325925", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_811037820659258_3093844724899004257_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJoUWWEeam8Q7kNvwHDruI9&_nc_oc=AdrltOy4x1eua3mlQvvh1J-Jys9ns00BJFu_NYh9_I08DFlGHOg500oaxKCa09E_MLE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGl7ngD_G6MJ-gVqln9TPUKPkK5ChdpkPGltUokuBZGg&oe=69CD2E38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1822462261440247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974817_1822462264773580_3388714471754744082_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_VgNguc5zgQ7kNvwHPVgOn&_nc_oc=Adqch_fo2aNFjI1mi3-nxyjq9p4nvdEmtguiIzvc4dRsdDrV4SlrSyyVH3sxPrYHQwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIdwjd76lV_nCP-uo4V7sRSG_ctCaGMijzYywkbBeyRg&oe=69CD0293"}, "display_name": "MageWorks", "keywords": [], "long_description": "With your spellbook in one hand, and your staff in the other, travel to distant lands to discover new spells, battle foes, and collect staff crafting resources to build your own staff.  \n\nMageWorks puts the player into the role of a mage that has just finished their magic school, and now must venture out to explore the world...to pay off their magic school debt.  With side jobs like riding a roller coaster, or battling waves of enemies with newly discovered spells, earn gold to work your way out of magic school debt.  \n\nUse the observatory to find and unlock up to 25 spells.  Reach into the skies with your staff to summon a ball of lightning, or use the energy of the ground to summon protective shields.  Six different spell classes and a study hall to play with your spells.  \n\nUse your workshop to craft a custom staff to bring on your adventures.  Your staff ideas come to life with crystal shaping, wood carving, and painting. \n\nMageWorks is an ongoing development and is still in process of being built.  Most levels can be played through, but they are undergoing various tests in puzzle design,  art passes, and gameplay tweaks from time to time as the game continues to evolve. \n", "short_description": "With your spellbook in one hand and your staff in the other, travel to distant lands where you can unlock new spells, collect resources to craft your own staff, and earn your keep as a Mage! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/applicationsprivacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": "https://www.earthborninteractive.com/mageworks", "website_url": "https://www.earthborninteractive.com/", "category": "GAMES", "comfort_rating": null, "comfort_ta
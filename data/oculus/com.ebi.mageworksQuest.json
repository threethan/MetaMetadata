n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuGh1oq16Y8Q7kNvwFuykNO&_nc_oc=Adqw79u6upXyjZGQUuIdeLWEHQy7B7_Apc03N4I1EJhoTA4fyv-qtcfGHNyAsa3RJIA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HxfLUOyEBLBqhJNbjk1wlDnQUMb20owubC-Lerr4K_g&oe=69DA41F3"}, {"file_name": "MW_Oculus_Screenshot02_1.png", "id": "810228000883721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_810228004217054_1061206612841900641_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LAxFHWdg6MQ7kNvwFgu-ld&_nc_oc=Adrc5QiBfBRASruV0SDo1M_lkps5PeA_y1_BDSJwzzReyAH7bM0W2QTYpKEgI-wLxHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0imZgtKnJyCz_axpDCZblE-iR_m4w1urpLxFa1m4TFgQ&oe=69DA433C"}, {"file_name": "MW_Oculus_Screenshot03_1.png", "id": "246546351566756", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974840_246546354900089_937731810484100751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w15Llr0z5_YQ7kNvwFdzXCs&_nc_oc=AdpBsh3wP2w40049xNrO4wJV7_83wVwXYrjtpLiQP1VL68yN02NfnFRvbAPgFBEEb7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04lUELj7ikFDZgxim4HK0yWWKnyMnNlfts-6I2GCH9YQ&oe=69DA5900"}, {"file_name": "MW_Oculus_Screenshot04_1.png", "id": "811037817325925", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575360_811037820659258_3093844724899004257_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dXbAO5ymCcQ7kNvwEbqJkO&_nc_oc=Ado-yPOA42WDjqAkxvtHKtu3Rl5MpK7DmhscO8uEV2H2-gr_0TW8EloyJ-iEHbi8XcU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MFmIfcEvVf1BMb78Gd1jr2E9QxER8S082ueU6rI1Cxw&oe=69DA5D38"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1822462261440247", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974817_1822462264773580_3388714471754744082_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My4gj82XMBgQ7kNvwHzcG92&_nc_oc=AdrycMfzdm3_3o5RgRb7Xm54LDZORUBVpVXyWs1IJWMcHsxPUck7iOToSh52_OEHJwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hHRquyVTfZ-cjVLvCfsOy1RKf3R8oFFfBU5di826Kuw&oe=69DA3193"}, "display_name": "MageWorks", "keywords": [], "long_description": "With your spellbook in one hand, and your staff in the other, travel to distant lands to discover new spells, battle foes, and collect staff crafting resources to build your own staff.  \n\nMageWorks puts the player into the role of a mage that has just finished their magic school, and now must venture out to explore the world...to pay off their magic school debt.  With side jobs like riding a roller coaster, or battling waves of enemies with newly discovered spells, earn gold to work your way out of magic school debt.  \n\nUse the observatory to find and unlock up to 25 spells.  Reach into the skies with your staff to summon a ball of lightning, or use the energy of the ground to summon protective shields.  Six different spell classes and a study hall to play with your spells.  \n\nUse your workshop to craft a custom staff to bring on your adventures.  Your staff ideas come to life with crystal shaping, wood carving, and painting. \n\nMageWorks is an ongoing development and is still in process of being built.  Most levels can be played through, but they are undergoing various tests in puzzle design,  art passes, and gameplay tweaks from time to time as the game continues to evolve. \n", "short_description": "With your spellbook in one hand and your staff in the other, travel to distant lands where you can unlock new spells, collect resources to craft your own staff, and earn your keep as a Mage! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/applicationsprivacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": "https://www.earthborninteractive.com/mageworks", "website_url": "https://www.earthborninteractive.com/", "category": "GAMES", "comfort_rating": null, "comfort_ta
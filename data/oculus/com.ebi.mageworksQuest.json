nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6ei4bKEg9atneC-Pv6mQ7LKL7tYyVYRY6XRI9_TFDYA&oe=69C13573"}, {"file_name": "MW_Oculus_Screenshot02_1.png", "id": "810228000883721", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003247_810228004217054_1061206612841900641_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN2P3JfZ6ikQ7kNvwG0-lJc&_nc_oc=AdoOxi0FQpc6j7tbww8FeVGO66C25qMx4faMWjG_H1mGOaDAqOlWqOx6lUm61DInoKk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzI7TbGNT5uV_uJvjiGbtEhQVhMViWa7x7OrfwvTmTncg&oe=69C136BC"}, {"file_name": "MW_Oculus_Screenshot03_1.png", "id": "246546351566756", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974840_246546354900089_937731810484100751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wo_2bejTf7MQ7kNvwFnshRI&_nc_oc=Ado7YdBSqvE8S9itgdY9lQ2uAJVmtGCmkk67uYdqgxKPvouhOfpzN7h4OIXdJ9KrGc4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzZBnOrAaFEo43m6slf0uTcO7SSW6aWYch8svI0rv8a2A&oe=69C14C80"}, {"file_name": "MW_Oculus_Screenshot04_1.png", "id": "811037817325925", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575360_811037820659258_3093844724899004257_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPBnyp7UT0kQ7kNvwFdWDl9&_nc_oc=AdqnGeE62VV7__WUatGxnhve5Vvkb51hhVxOzMQibv1ERfefcs_8oNgL0wHlQALz4QQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw18ic2kffcwiWA4EL0m-wCwJEXxH8IO33aaW8JZpuQfQ&oe=69C150B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1822462261440247", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974817_1822462264773580_3388714471754744082_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a34fi4abaqsQ7kNvwGrpGot&_nc_oc=AdoGTJG1FTXXYIVYLcFsHx9fjiS7evupg2-xlpH1c4bMa5wIhHJCECmEVgo9jeqUvJE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwp36xYAypPaL_0PGyOZQelYIIC4Zzu4jAfjf6pftLs5w&oe=69C12513"}, "display_name": "MageWorks", "keywords": [], "long_description": "With your spellbook in one hand, and your staff in the other, travel to distant lands to discover new spells, battle foes, and collect staff crafting resources to build your own staff.  \n\nMageWorks puts the player into the role of a mage that has just finished their magic school, and now must venture out to explore the world...to pay off their magic school debt.  With side jobs like riding a roller coaster, or battling waves of enemies with newly discovered spells, earn gold to work your way out of magic school debt.  \n\nUse the observatory to find and unlock up to 25 spells.  Reach into the skies with your staff to summon a ball of lightning, or use the energy of the ground to summon protective shields.  Six different spell classes and a study hall to play with your spells.  \n\nUse your workshop to craft a custom staff to bring on your adventures.  Your staff ideas come to life with crystal shaping, wood carving, and painting. \n\nMageWorks is an ongoing development and is still in process of being built.  Most levels can be played through, but they are undergoing various tests in puzzle design,  art passes, and gameplay tweaks from time to time as the game continues to evolve. \n", "short_description": "With your spellbook in one hand and your staff in the other, travel to distant lands where you can unlock new spells, collect resources to craft your own staff, and earn your keep as a Mage! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/applicationsprivacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": "https://www.earthborninteractive.com/mageworks", "website_url": "https://www.earthborninteractive.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1008279844328894"}], "external_subscri
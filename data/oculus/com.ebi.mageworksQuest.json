nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw31nu6J1hJZhEA_ZT5q7oe59ZRjuYmHeSDFCHOL6ftew&oe=69B40673"}, {"file_name": "MW_Oculus_Screenshot02_1.png", "id": "810228000883721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_810228004217054_1061206612841900641_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axUfRJ2EkSwQ7kNvwGu7HbB&_nc_oc=AdmeiyG2FQZFLDmYIgoMQkNTSTELPnc6FASc099KB6g4puu1xBi5HMG_ETwZ-UgZif4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzumGXHeT_VATSmOCx8EefBreW3vWlNJZmxzNBDrv4zFQ&oe=69B407BC"}, {"file_name": "MW_Oculus_Screenshot03_1.png", "id": "246546351566756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_246546354900089_937731810484100751_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFOtRkBsKRAQ7kNvwEDEsmJ&_nc_oc=AdnxclC6-Y6Nsi54YGCCBp7HjZAquax0RU5qwLPALA2w2hqoY9AXZgQQ2j6a3NHncyo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyi7QOPLxwzp3WKdx_1FmdrFwjK5IX6BI63opowSqs0ww&oe=69B41D80"}, {"file_name": "MW_Oculus_Screenshot04_1.png", "id": "811037817325925", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575360_811037820659258_3093844724899004257_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E8covfbq40MQ7kNvwG0YhX0&_nc_oc=Adk_o1YUHLmwrooHIaEuL56JhYs-K4Tyb7lh4nUoIkD05772lKOGsAvSg1dDuWmYxyw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhvkhOCSt8iYGXmsuHHQ1q6dKVckKWY4Ydj_34s1HVQw&oe=69B421B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover.png", "id": "1822462261440247", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974817_1822462264773580_3388714471754744082_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYcTvI46XRMQ7kNvwH-2mjN&_nc_oc=Adm8wHmpkFsMy3JHbEFZAq8l9rOY5Y2Ci1qs93x0sBgHyqEKIBgJUUwMsJ8ry3GNebQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4oHJ1Wik0F5dPY6_tArG6CHCS14LYoOqFgG5VBdi2LQ&oe=69B3F613"}, "display_name": "MageWorks", "keywords": [], "long_description": "With your spellbook in one hand, and your staff in the other, travel to distant lands to discover new spells, battle foes, and collect staff crafting resources to build your own staff.  \n\nMageWorks puts the player into the role of a mage that has just finished their magic school, and now must venture out to explore the world...to pay off their magic school debt.  With side jobs like riding a roller coaster, or battling waves of enemies with newly discovered spells, earn gold to work your way out of magic school debt.  \n\nUse the observatory to find and unlock up to 25 spells.  Reach into the skies with your staff to summon a ball of lightning, or use the energy of the ground to summon protective shields.  Six different spell classes and a study hall to play with your spells.  \n\nUse your workshop to craft a custom staff to bring on your adventures.  Your staff ideas come to life with crystal shaping, wood carving, and painting. \n\nMageWorks is an ongoing development and is still in process of being built.  Most levels can be played through, but they are undergoing various tests in puzzle design,  art passes, and gameplay tweaks from time to time as the game continues to evolve. \n", "short_description": "With your spellbook in one hand and your staff in the other, travel to distant lands where you can unlock new spells, collect resources to craft your own staff, and earn your keep as a Mage! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.earthborninteractive.com/applicationsprivacy", "developer_terms_of_service_url": null, "publisher_name": "Earthborn Interactive, LLC", "support_website_url": "https://www.earthborninteractive.com/mageworks", "website_url": "https://www.earthborninteractive.com/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1008279844328894"}], "external_subscri
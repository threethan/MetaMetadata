g", "id": "690035643621518", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391952_690035646954851_6205194700179650029_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDQzBWO80PUQ7kNvwFDtLP0&_nc_oc=AdqxgelaGq8jGI1l_bYIRDWPTm7gVV41O2akZwInvXV6PuVJ2W9z0XCr6zkRRZuwPcU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0T5WnR51ehSVe9kWeL8HO6x2Zn8ohAlTw4pI-YMnhvQ&oe=6A53815B"}]}, "id": "1904997866865166", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "872501445242339", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827960_872501448575672_5268426417228113862_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vO84eNZ8k-wQ7kNvwE6OK8Z&_nc_oc=AdriYMhqqiFEhlxq-5UPrz-5P93kSmlfrY0_1m93fTSfjJIQbJB5L1685unZimCJeOY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7HUpjR46QoSEVeNC5aMEqi-EVrKdsO6AQY-dca3uDdA&oe=6A53A925"}, {"file_name": "2.png", "id": "618248767899096", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392000_618248771232429_769363731829780634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_gqkbzQME4Q7kNvwGUXk85&_nc_oc=Adqbh8mwGHSr_emNZz316GRlfuOzcvFIKNL01KIawLu6AwLDnrIzEGTlz2JZ-jWTqhQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBZvBNxmODq_Wbs-1UsWfkjd5YskJ1x9CkTrJyXl8i8Q&oe=6A537F2B"}, {"file_name": "3.png", "id": "2068123797019166", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393511_2068123800352499_4907238828204511114_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-bG0UnF0xEQ7kNvwHp0CpS&_nc_oc=Adp_UkANOsGC7BacAfT1anSKGNRcAUmogiWK_T_3dMQITAhjgyOOeP09LQXVOW65lRs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtpJUPVdZArQYxKn7mNjp1QY1cUtVfzCNNGzWOhPZojg&oe=6A53952E"}, {"file_name": "4.png", "id": "2806616269539559", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473393328_2806616272872892_6049972215679222164_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RH2Zi9vqxOoQ7kNvwF0_slm&_nc_oc=AdqHdyT3hVyBXDuXFHg8nGXizItkIEk-8qumvE5W_7TI5WHgudwN7tEdmuUEtFtuAag&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArHIioDt1lu86K0n_5NqQscxzeTucsnMQT6gGQTT7bLg&oe=6A539E3A"}, {"file_name": "5.png", "id": "1326031028476925", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393909_1326031031810258_7807791415471821315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OunpTJp2eCMQ7kNvwFPKahA&_nc_oc=AdqfH44UkqmGZzTqoL-tDMsBOSTaq30fx-FLtAwxybu8qkL8pQt18sk6Sl263gq4uK8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDnDO76sLWUJEDDBJrg_mz_okYYaXOu2-l42WlWzcXlQ&oe=6A5388CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ABB Virtual World", "keywords": ["Engineering", "ABB", "Industrial", "Technology", "Automation"], "long_description": "The electricity reaching your home, the robots building your car, the systems managing power grids across continents -- ABB technology is behind more of daily life than most people realize. ABB Virtual World is where you get to see it.\n\nThis is a free, public VR experience open to anyone on the planet. No ABB account. No engineering degree. Just put on your headset and explore.\n\nWalk through full-scale environments built around ABB's real-world technology: industrial automation, electrification systems, robotics, and more. These aren't concept renders. They're built to reflect the actual scale and complexity of the systems ABB deploys across 100+ countries every day.\n\nWhether you're a student curious about engineering, a professional exploring what ABB does, or just someone who likes well-made immersive experiences, there's something here worth your time.\nABB is one of the largest technology companies in the world. Most people couldn't tell you what it makes. ABB Virtual World fixes that.\n\nStep in. Look around. Understand the technology that keeps the modern world running.", "short_description": "The world runs on ABB technology. Now you can see it for yourself. Step inside immersive VR environments built around real power grids, factories, and robotics systems. Open to everyone, anywhere on earth. Free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.abb.com/privacy-notice/external-stakeholders", "developer_terms_of_service_url": null, "publisher_name": "ABB Information Systems AG", "support_website_url": null, "website_url": "https://abb.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26989027060754931"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824618_2384344481937190_8087469256375648925_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kE75fpCCSlAQ7kNvwGDvqFi&_nc_oc=AdrLRhLvtmn_c2UbIDPHfWMY0loI4swU8Si1ksWG1Wq6HktEnAoodqfaG-hIqJ6_qG0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn59IIFBYquFsmamfAB3orfBVvb6JsoBxQGv2IxvxRhw&oe=6A537C36"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ABB Virtual World", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "relea
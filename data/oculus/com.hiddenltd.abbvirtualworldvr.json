8LokdKF-HVp6y94aZnSQ&oe=6B0B462E"}, {"file_name": "4.png", "id": "2806616269539559", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393328_2806616272872892_6049972215679222164_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOXKS-mTfmYQ7kNvwFtyq2R&_nc_oc=AdrJBWRLoHo3HEks4oXfBkY4t1n3DoOvAWA_ZT4JA4bIHVgIiYmw2--0YM0ztpezBYc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZcwyZUOuBi_hiBqOF6ZWvOVvYloi3gMyP1wXT2_AdYA&oe=6B0B16FA"}, {"file_name": "5.png", "id": "1326031028476925", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393909_1326031031810258_7807791415471821315_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIJ1H-gMyXcQ7kNvwHErH_z&_nc_oc=Adp_-ZpVJQncN68SEAo77Exk79CzV3NH4gM-Ejl2H9MX0GxEt5monV1p-4cDYZN8NXQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQROYEk6lx5QTiRldjfJJnxuVFL57cOp2tKeqsmwwyqCyQ&oe=6B0B39CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ABB Virtual World", "keywords": ["Engineering", "ABB", "Industrial", "Technology", "Automation"], "long_description": "The electricity reaching your home, the robots building your car, the systems managing power grids across continents -- ABB technology is behind more of daily life than most people realize. ABB Virtual World is where you get to see it.\n\nThis is a free, public VR experience open to anyone on the planet. No ABB account. No engineering degree. Just put on your headset and explore.\n\nWalk through full-scale environments built around ABB's real-world technology: industrial automation, electrification systems, robotics, and more. These aren't concept renders. They're built to reflect the actual scale and complexity of the systems ABB deploys across 100+ countries every day.\n\nWhether you're a student curious about engineering, a professional exploring what ABB does, or just someone who likes well-made immersive experiences, there's something here worth your time.\nABB is one of the largest technology companies in the world. Most people couldn't tell you what it makes. ABB Virtual World fixes that.\n\nStep in. Look around. Understand the technology that keeps the modern world running.", "short_description": "The world runs on ABB technology. Now you can see it for yourself. Step inside immersive VR environments built around real power grids, factories, and robotics systems. Open to everyone, anywhere on earth. Free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.abb.com/privacy-notice/external-stakeholders", "developer_terms_of_service_url": null, "publisher_name": "ABB Information Systems AG", "support_website_url": null, "website_url": "https://abb.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26989027060754931"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824618_2384344481937190_8087469256375648925_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WS7c5Nyhkd4Q7kNvwFvOA1J&_nc_oc=AdryicuZie0plUwPKvHzae3Ihep1Oo-Oa8O53wW6SDhrCfQh9Kwrq8ORQPra_s6YyWU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQaMLfAm7mbwKGAMJ8h6bpIEFMW5EcD3jlEhgvsirJXJw&oe=6B0B2D36"}, "is_concept": false, "is_test": false, "
nc_ohc=9ip9KySONH4Q7kNvwGFEeHT&_nc_oc=AdqwwCg3rCDe3xgGvLqEJrPcVU-pMBrNlnUuBlIKO69m5IlrA9OrM-SV2nTzdWHb0Nc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rAfqeRuaJDxk8KLYjNM5gjxso1kc7z5JCUWaoxQoAog&oe=6A41293A"}, {"file_name": "5.png", "id": "1326031028476925", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393909_1326031031810258_7807791415471821315_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_C427x5FahoQ7kNvwEIdpcJ&_nc_oc=AdpbzDFzXz2VqRjHB6X_EuV7Z4xFIGfycnj646EHrP-KVtLIJxlDFG128rgOrgvicKc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8buImn3kPfB99puZvqam_eRbv8cT-QahXfxa72xaizwg&oe=6A4113CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ABB Virtual World", "keywords": ["Engineering", "ABB", "Industrial", "Technology", "Automation"], "long_description": "The electricity reaching your home, the robots building your car, the systems managing power grids across continents -- ABB technology is behind more of daily life than most people realize. ABB Virtual World is where you get to see it.\n\nThis is a free, public VR experience open to anyone on the planet. No ABB account. No engineering degree. Just put on your headset and explore.\n\nWalk through full-scale environments built around ABB's real-world technology: industrial automation, electrification systems, robotics, and more. These aren't concept renders. They're built to reflect the actual scale and complexity of the systems ABB deploys across 100+ countries every day.\n\nWhether you're a student curious about engineering, a professional exploring what ABB does, or just someone who likes well-made immersive experiences, there's something here worth your time.\nABB is one of the largest technology companies in the world. Most people couldn't tell you what it makes. ABB Virtual World fixes that.\n\nStep in. Look around. Understand the technology that keeps the modern world running.", "short_description": "The world runs on ABB technology. Now you can see it for yourself. Step inside immersive VR environments built around real power grids, factories, and robotics systems. Open to everyone, anywhere on earth. Free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://new.abb.com/privacy-notice/external-stakeholders", "developer_terms_of_service_url": null, "publisher_name": "ABB Information Systems AG", "support_website_url": null, "website_url": "https://abb.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26989027060754931"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824618_2384344481937190_8087469256375648925_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqGh9Om8tcEQ7kNvwEkkBdL&_nc_oc=AdoHKB3cWX-3c1eG9wToWAUHQ3r8YT4UceStpJ5aeMyKjlLO5sU75xpRRC_hAS9fQ9I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9S1UuIf9Rg-itjAgWgYST1P-cXDmq-QVEQHv84JuhvA&oe=6A413F76"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ABB Virtual World", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "relea
6326483522_3819282581841757537_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnDOlmflMRAQ7kNvwHJU7gt&_nc_oc=Adraqokz88QIM9gexmzW0O42tfhNkOmiYN5CwkxAgAdDN5-hQGuGJrHKmd78YdvJYIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlrePp1pSscVXRowlRlRduZ2oBgsTUXj_bopXHdikVIw&oe=6AC25E6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VD Movie Player", "keywords": ["movie", "player", "cinema", "video", "theater"], "long_description": "Stream movies from your favorite websites, or enjoy downloaded films in stunning 3D and 4K.\n\nSupported Formats:\nMP4, MKV, AVI, MOV, WebM, HLS (M3U8), DASH (MPD), DRM-protected content\n\nViewing Modes:\nTV Mode - Traditional flat screen with passthrough\nTheater Mode - Large virtual cinema (20m distance, 90\u00b0 FOV)\nHome Mode - Media browser\n3D/Stereo Modes: 2D/Mono, Side-by-Side 3D\n\nFeatures:\nPlay/pause, seek, volume, 10s skip, restart, passthrough, hero lighting, spatial audio, hand tracking & controllers, screen scaling, anchor positioning.\n\nWatch your local videos or stream from the web in VR.", "short_description": "Experience high-quality cinema viewing. Stream online or watch from the device with Passthrough TV mode and Cinema Theater mode."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vd-website-ashy.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Veda Studio", "support_website_url": null, "website_url": "https://vd-website-ashy.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "
9854_2209495283309252_1317301711492378193_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uft-HauuLqUQ7kNvwHuSLpL&_nc_oc=AdrQzfsPd47HKGbhUSgAP7eCxXoBh-N3VVhg0SRUmDnHv2ILgcU6L9CGLsQBkGndbNM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZAPu81w0G4LCalpMLD1CtWQ4_rN7Ofyc7pXKkGVQIjg&oe=6AF9CC39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "893219347092707", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/673573223_893219350426040_94088085880939600_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3T0TqD2v_MQ7kNvwFV4RIs&_nc_oc=AdoNIs0tC_Eyas-lltxeC5oNZLfckRcpjx-Iwd-uNJPhMMF5KCloNV4RR_uG-qPkkyM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTAUDF_ObDSpuWmgyOhnrTCa94jOrhSQcZp7QFwR8eVA&oe=6AF9E506"}, "display_name": "Flight Simulator Glasgow", "keywords": ["flight", "simulator", "glasgow", "jet", "pilot"], "long_description": "Flight Simulator Glasgow puts you in the captain's seat over the real west of Scotland.\n\nTHE REAL GLASGOW\nReal satellite, elevation and map data: the City Chambers, the Cathedral and the Necropolis, the Armadillo, the Hydro, the Glasgow Tower, the Finnieston Crane, the Riverside Museum, Kelvingrove, the University, Celtic Park, Ibrox and Hampden.\n\nTHE CLYDE, LOCH LOMOND AND STIRLING\nDown the river past Clydebank's Titan crane, Dumbarton Rock and Greenock to the Firth. North to Loch Lomond's islands, the Campsies, Stirling Castle, the Wallace Monument, the Kelpies and the Falkirk Wheel.\n\nFLY UNDER THE ERSKINE BRIDGE\nLow down the Clyde and under the bridge's deck, 45 metres above the water.\n\nA LIVING CITY\nTrains on their real tracks, CalMac ferries on the Firth, Whitelee's turbines turning. At night the Hydro, the bridges and the stadiums light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on Pacific Quay, the Glasgow Tower out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nCity approach, Ayrshire coast approach, Prestwick hop, down the Clyde, under the Erskine Bridge, Loch Lomond and Stirling, a scramble, Glasgow by night, a city tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.", "short_description": "Fly the real Glasgow, built from real satellite and map data: George Square, the Cathedral, the Armadillo, the Hydro, the Glasgow Tower, Celtic Park and Ibrox - then down the Clyde to the Firth, up to Loch Lomond, Stirling Castle and the Kelpies. Start in your own glass hangar on Pacific Quay, talk to air traffic control, fly under the Erskine Bridge and land at Glasgow, Prestwick and Cumbernauld."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorglasgow/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorglasgow/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1291630857376220"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1096201636496423"}]}, "baseline_offer": {"i
80388_1740166779585607_838951026_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN42Gb-l7jcQ7kNvwHWh9vi&_nc_oc=AdnwQBsR1Dh7G20pS6GjnybcqKl1-_NlBam8ItJKOWqV2MsB6-IUQPk4A_MkE6FH_D8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afssl3EQjaS9IWj5gCCPpFpW_Nc2yqHaUL_85rKxVdQH5w&oe=699C4285"}, {"file_name": "migrated_image.png", "id": "497193594489932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331131_1731629120411245_1994321274_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOs2EP27QVEQ7kNvwFS6xUH&_nc_oc=AdkzYnDuit2OdNFbSmCAwG8INTCFxm5KDA2A0yrxQ7d9yCHe--mi8suvJkRmFx1oxlQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft-XWOl2wHqae-7Et-ja7nfvAy7vol-9nT0Vat8VWUjig&oe=699C4520"}, {"file_name": "migrated_image.png", "id": "238525697282421", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680435_1228794587145259_1416268766_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8sAAGWgWIgQ7kNvwEBjNfR&_nc_oc=Admk3j3Cqez51dUXTK3eB-gB7xQvREvby7k9DyPimkd0tedClo063iViQNSosoINeLI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsIYzc3gwfvaperve1vgxs_616A5d7JmDHg4UYfV1raxg&oe=699C3D2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Teen Wolf from TURBO SUPER NOW", "keywords": ["teen", "wolf", "mtv", "girl", "hot"], "long_description": "Turbo Super Now is the home for our favorite sci-fi and genre VR in the Metaverse. VR for movies, TV shows or even originals.  If it's cool and mind melting, we want to show it to you.\n\nFirst up is Teen Wolf VR.  We love this because it uses gaze-activation in the storytelling.  The story actually changes based on where you look.  Seriously.  You may not notice, but if you look the wrong way... well, let's just say things do not end your way...", "short_description": "Turbo Super Now is the home for our favorite sci-fi and genre VR in the Metaverse. VR for movies, TV shows or even originals. If it's cool and mind melting, we want to show it to you.\n\nFirst up is Teen Wolf V
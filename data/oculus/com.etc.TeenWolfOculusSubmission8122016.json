80388_1740166779585607_838951026_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_f-gE_3ID54Q7kNvwEUwAxX&_nc_oc=AdoKS-YhKqrmPKUCXX_nRa6tOJ0Mv17ND8gNGN6zDAqiUk1JzmbNYvNq_eYPaM_-g-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3bwVBplbm6AxVBYYQJjfPuSUfyTwU0tVkrDg-Ft19PAA&oe=69F0A285"}, {"file_name": "migrated_image.png", "id": "497193594489932", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331131_1731629120411245_1994321274_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJnSlAasA-wQ7kNvwGnVQk9&_nc_oc=AdpoIDPQf6wpmrnnKe0NgshvwUgF6CL95gwiGViJ1at9XWv28jJeSYKEyl8s_F_f5uw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af27sVQzUv86-Tg8svOS0KVlbCMqPZvGXWnXLTNSHwlaKg&oe=69F0A520"}, {"file_name": "migrated_image.png", "id": "238525697282421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12680435_1228794587145259_1416268766_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=on9UDDUOOAQQ7kNvwEpyhZa&_nc_oc=Adp3_YKlGEWTZUUO4RSC8YXHnesFVv-Cf8cmMJ6F1MYPQYStiGPYRlwxVaZAbYZCxyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af14bHc3SbVDc2-Knau5HRhPr-nF9G93uad1v4_jnJOFjQ&oe=69F09D2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Teen Wolf from TURBO SUPER NOW", "keywords": ["teen", "wolf", "mtv", "girl", "hot"], "long_description": "Turbo Super Now is the home for our favorite sci-fi and genre VR in the Metaverse. VR for movies, TV shows or even originals.  If it's cool and mind melting, we want to show it to you.\n\nFirst up is Teen Wolf VR.  We love this because it uses gaze-activation in the storytelling.  The story actually changes based on where you look.  Seriously.  You may not notice, but if you look the wrong way... well, let's just say things do not end your way...", "short_description": "Turbo Super Now is the home for our favorite sci-fi and genre VR in the Metaverse. VR for movies, TV shows or even originals. If it's cool and mind melting, we want to show it to you.\n\nFirst up is Teen Wolf V
600357087486966", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12680388_1740166779585607_838951026_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knB7XESZmSUQ7kNvwHBAvUS&_nc_oc=AdmzYEMoWOQDqYBA4joSgWN0_yx0LmtAv_01SjSxy1NcY_o9L3rLoIOBDE0V0HUEW9c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfysPf2oc-BPnWjoMXgyxd_qWZtgV61Hn63yZ44wp2taOw&oe=69B6A085"}, {"file_name": "migrated_image.png", "id": "497193594489932", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12331131_1731629120411245_1994321274_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edvls4T4eOcQ7kNvwHGkEhD&_nc_oc=AdkatP2jGdWnHokIfSnuUZKn0O9wLiJ2pdG6NG4x1AhbQptafCD_9F2jGstwstwJ6fw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz3Jk8RfK6OK1wxG3F1aZcfEi6h8iPM-4TYdOuzm6gmYA&oe=69B6A320"}, {"file_name": "migrated_image.png", "id": "238525697282421", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12680435_1228794587145259_1416268766_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGkgGbZQpmQQ7kNvwHxNXsq&_nc_oc=AdmP_q_crISWBEZ1_HW8cfllAnWuZTsO-ByIkE-k6IjzFGD466y1THj5Q5wCDTH253k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWp6Kla3foNyO6OEmENNObM63BKGWhXB0UEljbSY-BOQ&oe=69B69B2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Teen Wolf from TURBO SUPER NOW", "keywords": ["teen", "wolf", "mtv", "girl", "hot"], "long_description": "Turbo Super Now is the home for our favorite sci-fi and genre VR in the Metaverse. VR for movies, TV shows or even originals.  If it's cool and mind melting, we want to show it to you.\n\nFirst up is Teen Wolf VR.  We love this because it uses gaze-activation in the storytelling.  The story actually changes based on where you look.  Seriously.  You may not notice, but if you look the wrong way... well, let's just say things do not end your way...", "short_description": "Turbo Super Now is the home for our favorite sci-fi and genre VR in the Metaverse. VR for movies, TV shows or even originals. If it's cool and mind melting, we want to show it to you.\n\nFirst up is Teen Wolf VR. We love this because it uses gaze-activation in the storytelling. The story actually changes based on where you look. Seriously. You may not notice, but if you look the wrong way... well, let's just say things do not end your way...\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mothandflamevr.com/privacy", "developer_terms_of_service_url": "http://www.mothandflamevr.com/terms", "publisher_name": "Moth + Flame", "support_website_url": null, "website_url": "http://www.mothandflamevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "MUSIC", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2740920939550355"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139280_542672552584784_1959271213_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NJBZH2FwrwQ7kNvwHYQhZW&_nc_oc=AdntMabuESWX3s7w7z1N4StECvki6e_bz7cR2IWtYjNO7Fzx-gVLw6Scq4-EB8r9dLk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6BtM9pOs1MtTujBoscVqhg4UDlK7rm5uo0_8BaV6pDA&oe=69B6AD07"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teen Wolf from TURBO SUPER NOW", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1472022000, "lastRevision": {"nodes": [{"id": "1218214141568333", "release_type": "SCHEDULED", "administration_status":
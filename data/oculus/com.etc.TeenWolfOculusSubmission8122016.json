hows or even originals. If it's cool and mind melting, we want to show it to you.\n\nFirst up is Teen Wolf VR. We love this because it uses gaze-activation in the storytelling. The story actually changes based on where you look. Seriously. You may not notice, but if you look the wrong way... well, let's just say things do not end your way...\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mothandflamevr.com/privacy", "developer_terms_of_service_url": "http://www.mothandflamevr.com/terms", "publisher_name": "Moth + Flame", "support_website_url": null, "website_url": "http://www.mothandflamevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "MUSIC", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2740920939550355"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139280_542672552584784_1959271213_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NJBZH2FwrwQ7kNvwF3VWHs&_nc_oc=Adm471cFWTnrhn_S3ejbVDCCtgzXecYHNuK2yk5qjPqgK-7kXV2O3-sYCiYsFmFpknQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afys__LEykN4TXI2K48cHRQwLhbTqIIDVNeY5mCeHHuR-A&oe=69B7FE87"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teen Wolf from TURBO SUPER NOW", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1472022000, "lastRevision": {"nodes": [{"id": "1218214141568333", "release_type": "SCHEDULED", "administration_status":
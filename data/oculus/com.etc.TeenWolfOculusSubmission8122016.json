600357087486966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12680388_1740166779585607_838951026_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knB7XESZmSUQ7kNvwG52r5l&_nc_oc=AdmvgEuGsC3hhBcGZI2xq7RhxrZe2QAJNlvbvKhOWu8Qr_jYp67GI2KlN0v3M438t3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzySAH6m-Q1CT2DKnGRC3sfpiZozNKYGi8zACneWChdHA&oe=69B54F05"}, {"file_name": "migrated_image.png", "id": "497193594489932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331131_1731629120411245_1994321274_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edvls4T4eOcQ7kNvwFZADXl&_nc_oc=Adk8m34JUJy0vQ4kXRU1GjZMLc6BsMHyEZjS1F7H55x9_sFWdwt8JAP7CvOCawR7ze0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXREUNF5WDV4SIbha2eebn4a-U3jGjz3nHfnkx6GLFBg&oe=69B551A0"}, {"file_name": "migrated_image.png", "id": "238525697282421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12680435_1228794587145259_1416268766_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGkgGbZQpmQQ7kNvwH3goj5&_nc_oc=AdniXFzkbeYLhsf5209EyLAlC-U4QCk5eLtwThgpCaL_8UVnpSVVGdOhJXZ0sSjux6o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5veCfihuzjBOALSdeppCWiaOgbV1uVBXaNcnlE4pt5g&oe=69B549AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Teen Wolf from TURBO SUPER NOW", "keywords": ["teen", "wolf", "mtv", "girl", "hot"], "long_description": "Turbo Super Now is the home for our favorite sci-fi and genre VR in the Metaverse. VR for movies, TV shows or even originals.  If it's cool and mind melting, we want to show it to you.\n\nFirst up is Teen Wolf VR.  We love this because it uses gaze-activation in the storytelling.  The story actually changes based on where you look.  Seriously.  You may not notice, but if you look the wrong way... well, let's just say things do not end your way...", "short_description": "Turbo Super Now is the home for our favorite sci-fi and genre VR in the Metaverse. VR for movies, TV shows or even originals. If it's cool and mind melting, we want to show it to you.\n\nFirst up is Teen Wolf VR. We love this because it uses gaze-activation in the storytelling. The story actually changes based on where you look. Seriously. You may not notice, but if you look the wrong way... well, let's just say things do not end your way...\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mothandflamevr.com/privacy", "developer_terms_of_service_url": "http://www.mothandflamevr.com/terms", "publisher_name": "Moth + Flame", "support_website_url": null, "website_url": "http://www.mothandflamevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "MUSIC", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2740920939550355"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12139280_542672552584784_1959271213_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3NJBZH2FwrwQ7kNvwF3LOEk&_nc_oc=AdnZSbOPu-ouRP-AkLDAG3EPVScgfSkitXJKB94f7K7s57mZ6AbMJ5tivFwhyMxdcuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOg9-VVYIHUERubcViA4vUEKOvWnLb1AK1gC2WZ3BZ0w&oe=69B55B87"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teen Wolf from TURBO SUPER NOW", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1472022000, "lastRevision": {"nodes": [{"id": "1218214141568333", "release_type": "SCHEDULED", "administration_status":
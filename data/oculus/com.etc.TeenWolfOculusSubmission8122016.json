600357087486966", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12680388_1740166779585607_838951026_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL3d-vkwxSoQ7kNvwGODpgN&_nc_oc=AdnS7gQnLim6tQdQcKtEODpnuoPn94AmGyasBPGBKJjWwtJVdaBacJXXENqI8RlLY0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxed0YtRULDXEGTRvXWZGQLxNxUzkhjr_sTgac6ESiIbw&oe=69B94385"}, {"file_name": "migrated_image.png", "id": "497193594489932", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12331131_1731629120411245_1994321274_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aM_3eR4_lJYQ7kNvwHPd7gj&_nc_oc=Adkipez1jfSvtGV7HDlWH_jXz1CpQvBEYhRsvaHjqRBgmOZ09CPjMFqR0Dxxfu0hs5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzObADLPuJANeYQSn56LdfBFvB9ilbIKDpk7rS8bH9vuw&oe=69B94620"}, {"file_name": "migrated_image.png", "id": "238525697282421", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12680435_1228794587145259_1416268766_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvNRnW2vU8EQ7kNvwG2iU6J&_nc_oc=AdkiZ59mGuMy1UpgOKOtQuV68T31fqBxhdREZBw5mJZsm_hZDNOMU9MQux7TT8GXkw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyiBvgdnpkyljNtb98P_leoxgu9kZbkEI7gODMp1-vuyw&oe=69B93E2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Teen Wolf from TURBO SUPER NOW", "keywords": ["teen", "wolf", "mtv", "girl", "hot"], "long_description": "Turbo Super Now is the home for our favorite sci-fi and genre VR in the Metaverse. VR for movies, TV shows or even originals.  If it's cool and mind melting, we want to show it to you.\n\nFirst up is Teen Wolf VR.  We love this because it uses gaze-activation in the storytelling.  The story actually changes based on where you look.  Seriously.  You may not notice, but if you look the wrong way... well, let's just say things do not end your way...", "short_description": "Turbo Super Now is the home for our favorite sci-fi and genre VR in the Metaverse. VR for movies, TV shows or even originals. If it's cool and mind melting, we want to show it to you.\n\nFirst up is Teen Wolf VR. We love this because it uses gaze-activation in the storytelling. The story actually changes based on where you look. Seriously. You may not notice, but if you look the wrong way... well, let's just say things do not end your way...\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.mothandflamevr.com/privacy", "developer_terms_of_service_url": "http://www.mothandflamevr.com/terms", "publisher_name": "Moth + Flame", "support_website_url": null, "website_url": "http://www.mothandflamevr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "MUSIC", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2740920939550355"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12139280_542672552584784_1959271213_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gzTUgOiuYcQ7kNvwH-iMHB&_nc_oc=Adm3P-9Q2tFUpmAn9Frv2jBI8vgX-uKLQ_9bcK3c-isXIt_ocjXISmJM3hVXAi9smvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwBfD9oMxOKefeIdhc6QXTPkaLHh7Vd0qfkADqE99P8Fw&oe=69B95007"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teen Wolf from TURBO SUPER NOW", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1472022000, "lastRevision": {"nodes": [{"id": "1218214141568333", "release_type": "SCHEDULED", "administration_status":
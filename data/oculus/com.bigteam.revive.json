NhDBqT7JEriLOEg2mRPxZWpVuRXpcYw1mH40ay4Q&oe=6AC8FDD2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kA-F2jf1KIQQ7kNvwFlj16G&_nc_oc=AdrlN5jEf9TsD0iuUp-tVoF1jWgTquZB8XrHs90YOdut6_KmMNg8wJfXD-dCdyQi6gw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzIGiNmAJc5B06ADwjZAHtDqKxuNLn5K1YdAmdCUY80A&oe=6AC8F9A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZksPI7EkR-8Q7kNvwHgWk46&_nc_oc=Adoyz-Af0a2qEeXl3BYpgFNglbbRmC-wwPievGBDOFIx4rrh9ikOq58HsKrRuLyizhw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdYs6aWevM8K0tTLLTZ-BIc4uW8_r-8VxecEZERqA4Tw&oe=6AC90F62"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
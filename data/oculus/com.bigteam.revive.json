7f20f&oh=00_AQIHDPvZKNuy-4KfYL0bV8dB1rIPWJ7g3dzbyRWsuSUQcA&oe=6AA413D2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xTfk1suzgEQ7kNvwFZPh8J&_nc_oc=Adopza4nkxYmC3DMsLvcQ5-ggNNmNvJBaswoeelcHkGpY9N0TLHEE06NSPrYEjoDeYo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYbP_JJVsrtYirBeZpTNuM-2QjtuMBOAUWDWYPK2aFeA&oe=6AA40FA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpAGSzqAtLAQ7kNvwHTWMOH&_nc_oc=AdqnaZWYFRpQwapVhYmSvj6ZFVBpH7OFwD-y-9ph2lUVQP8mXMhBfz7FzUy1VqMYynE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI02PoS7VyFdSnLvzK10xjhePhT1g50vor9G8knV176sQ&oe=6AA42562"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_reviv
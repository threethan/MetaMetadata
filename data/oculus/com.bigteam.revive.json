lXDWjsZj9czvkiWrjyyMxHiU9H9U3ytkFQu_r-Uw&oe=6AEF3952"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWzdRosNFMQQ7kNvwFNxQMu&_nc_oc=AdpQjC0ewGc3rDUC-4nvx70CozocAXdTs-W_oEm7lKsLsNz5n1S6fY8Yow_gwT67yh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgie1rCqazswHndrkmTaJRndJ71IQMwvqDX80fLeLQzQ&oe=6AEF3528"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr-JyeumAl4Q7kNvwFKHzVp&_nc_oc=AdpZszeeHg3buy6XEJno8-izTh_Tl1lc99NWDrZVPwdt6AkPkkEmK37WZhXjv4kEtfA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyeL_xp0aEbRrqugYns41hsUnBK7rAM3e5BHDEDeaBMA&oe=6AEF4AE2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
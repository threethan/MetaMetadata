nibGKs3gPjHKnoAnAyO_djZGGxq_rmgb_aob42iQ&oe=6ABA7D52"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fiBprmLbQsQ7kNvwFrpLbT&_nc_oc=Adphs3qzOd0do_nHqbzw92jcG8QnTLuFSAG6MeSpNJQwJ4xo4DTr6nsw0N7Qo84Ivi0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxTxnir7Kg9O3ci0P3bD0ImH5smhkVOQl0OM4edriX1g&oe=6ABA7928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqBkWX9U7rMQ7kNvwHBmJwv&_nc_oc=Adr2lCxRiIwxH6_NJFSl0VAwpMZlpLM1eSaR2ElvOoaYHq9wqh_yR8oEi9Z_xMQbqAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLL4Zc2aLRObWjGUn7HK5SF5U_MLnSL_Gmh8Xg0SZHbg&oe=6ABA8EE2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
wW4UZQ&oe=6A75EB28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzGR_XlWKy8Q7kNvwHCSoW5&_nc_oc=AdoACq-LcpcEMN6ioRc4atkvEtipC65i49FOQZDbbrehN9hu085Gw1gMXxMLnOXx4Nk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6QvQVwp80AGoUvBSC0HGcRSSrk4JeZgAJy9-4U0oFcw&oe=6A75C8A2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "developer_terms_of_service_url": "http://www.bigteam.co.kr/terms_revive.html", "publisher_name": "BigTeam Inc", "support_website_url": null, "website_url": "http://www.bigteam.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_c
dPin0NV1pjD_atoGmkFeRAcVOB7tptqz5-z2ZdIw&oe=6ABBCED2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fiBprmLbQsQ7kNvwFfsXuH&_nc_oc=Adpa-Px19EWTOH1xpshLkVx4vyu7Lh27hfmFbl9gHM57zd00s5p0RlSlF2IYiA-S8RI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7nw2EFDiA2DwBADU5ESyG-QpFbFxM2215PVK0Tr40fg&oe=6ABBCAA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hqBkWX9U7rMQ7kNvwFkkxbC&_nc_oc=AdokM2p1OK_6oTX1XXventauHwGiWUSEB29YJo5N4Z5ywoymuvoMQfT9kjeIxSThQSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICvQKHqamppZ7-IJu6hhc6QiJX1ub-Loq-S9ZFCntm0w&oe=6ABBE062"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
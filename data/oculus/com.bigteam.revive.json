y-viW3oyWleLmJqzX8x3Iv9RYtNgpUWasbU4iLEA&oe=6AE35BD2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYAgxOxukkUQ7kNvwFUkv3T&_nc_oc=Adrp1G7hxWCt64Vmv69gFc9Vl7rwls4hUqWbrflBNEonoRYSuczuSA4FoPdODjsCKD8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKg72gmnYl1eGnMSbTgQuB7WhP_XSz0j_JJkdqSEGDvQ&oe=6AE357A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTgnFp9QVNYQ7kNvwGRSGgJ&_nc_oc=Adrw4wjq7E8YEWTMNewS1VWCG0BeoiU7NqgqFeiHEHez91kquvGaUcMldrZAU8We8FA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0J9UJ5iqtkvitrpUX00CDiDxTuQEg2tdwHXz3P4WIMA&oe=6AE36D62"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
56XPYQDjQODSfI4eEn1wSukg6shV2R0IXVjFq1PA&oe=6ABD2052"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ok81rjeQH7EQ7kNvwGs9nLO&_nc_oc=Adp0mlW2R0AZRWo3-oqFHKW-tRgJXVsvowr4YqrWCTpOJNbk-jZ__VkZweQZQOOZDWc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx8s9f6ZdrsGxMPgjxrhWSPyR0Ods1FG_l8UUFQ6aNCQ&oe=6ABD1C28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NLTtgspKoeoQ7kNvwH7ZbUV&_nc_oc=AdqhYietIjcC03F1Fom3UNcVGdEgpYUBrcbwCqMQ3sY-B0EvF_OF0IH72c6H8J7M-8I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx4joUQEbQlsjZUJwwK0FhK4iglXluVvxKDU87QL8RCQ&oe=6ABD31E2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
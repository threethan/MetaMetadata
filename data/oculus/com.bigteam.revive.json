4&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTcRY6rNn-YQ7kNvwFwirqP&_nc_oc=AdpAxj7a01pN3PzEqxQWYwupEVOp1n3UdNI4LkUKpdGViZJHrWbGUeyC8NMJ9KoZTos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrvzB8mALpPm8AAYtLUk8lEuk9dTQxU3tLrtN6CMo75w&oe=6AA69C0E"}, {"file_name": "ReVive-App-04.png", "id": "626826476370038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392196_626826479703371_5020311105848761461_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KzeZzbMrtD8Q7kNvwEtozT9&_nc_oc=AdqXJbrk3Abxb8pv8QJ95s6PC-5-kLi1PKn12zppJQJj4CTDkZp2IUKWl-QGpyswKLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE3LgLsGix7RyVdnV-Z2Vm5aCGX2M7-G_2o1Psqc7BUw&oe=6AA6B6D2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhpcmzXsWIgQ7kNvwE1i-CC&_nc_oc=AdooJxxxxVV0sLpImfKtH431Bsf6wFGf6PbtziLQcWqQHrYpykF_1GNOZkYOia7Jajw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIAxD-ato48ZTEJGBGKcwT3z7kkTAQEYfzlCeVc54ngQ&oe=6AA6B2A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrwiDIf_Cu4Q7kNvwFIfyBd&_nc_oc=Ado3ySv94beG01l7PgWHvzYg5t_kHoyye2_v0CSmG3xOqRRKMwV9LNT2vVvjy65-GYI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLijRIa7ENfUR9czu7glvrhI4I6j0a98gPQ8EErr2Q2_g&oe=6AA6C862"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ibigteam.com/privacy_policy_revive_en.html", "developer_terms_of_service_url": "https://www.ibigteam.com/terms_revive.html", "publisher_name": "BigTeam Inc", "support_website_url": null, "website_url": "https://www.ibigteam.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28274998488798881"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392127_1010681580523224_1073021653430277053_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8ppVO-6fowQ7kNvwGFFsSA&_nc_oc=AdqLBYKSKnA3Mybc7hewWBu8Or2LIxFZv5wWr3wdJuwy4RRHyPwsJlYHuMDGOf7YKV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOPKscDupJFCn9R9QcWYe_pd-GVHTId1sA64yGHYomVA&oe=6AA6946C"}, "is_c
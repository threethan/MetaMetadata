9Q&oe=6B10439D"}, {"file_name": "revive-screenshot-06.png", "id": "1850707559078991", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391961_1850707562412324_374201352071772028_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgXKO8uYpXcQ7kNvwH0VgAu&_nc_oc=Adrwt_O8Ht3Pcfyin_J_i-2ZuFdRtW76Q8jzmj3FrhIj0paXs9XmU3QJlnZpDPqknSg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-vu9dIORpK-PdVaSzaLRUOUes9QYzC2JIDEElLOZw_w&oe=6B104C4E"}, {"file_name": "ReVive-App-04.png", "id": "626826476370038", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392196_626826479703371_5020311105848761461_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naYzLK1NVUMQ7kNvwGmw11x&_nc_oc=AdrGkSL1U_DXexCq2k-LJWS60ftoNAeVZ5uyvHrQDY0Am9g5LeUO-ogaU_eX-NJS3_Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVYmOnn1ptMMVHUi-lPPQSgKIiRHdTMESuvt39BTdoVYQ&oe=6B106712"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rsuRKYrtcKsQ7kNvwE1g5qg&_nc_oc=AdqOinyl7IolvgVgbmBSpopsEOgeFUurc552BOZMFjqjTnxjlC1RxjjKvhGK5kul1Fc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWJZgs8GxQLbuHrMflY-yzlEM_YdxFiaSEH5Xe7JlVyvg&oe=6B1062E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVTlZzJO1LsQ7kNvwEvYD94&_nc_oc=Adrq6ywMDla32oaINLwMTh9WfzYhj0VUIagcIgm6ZmCpeXnYMvQhmEet-e-KvWs-qcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVBBR_pRZEnbmEtwP2GMs4yHLynaR4tGUdBq7rz2hR9pw&oe=6B104062"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ibigteam.com/privacy_policy_revive_en.html", "developer_terms_of_service_url": "https://www.ibigteam.com/terms_revive.html", "publisher_name": "BigTeam Inc", "support_website_url": null, "website_url": "https://www.ibigteam.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28274998488798881"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392127_1010681580523224_107302165
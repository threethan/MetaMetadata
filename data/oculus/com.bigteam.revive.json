0KIwPSd1HB2AaXo3fAitJQnylndATcqswinP746w&oe=6A9AD952"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N_3zyBWOhMQ7kNvwGzZJ5k&_nc_oc=Adq4CQMsNloyermPU8cY2b_176avDszOoeoxwRKD4AS8E2UOsupqOPC6ax0kRjKiTfc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSN09Xbeh9rKGEA_0VaQIYhfwwnE9ATp_n6_jRj9sBbA&oe=6A9AD528"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBEeWM5Os-0Q7kNvwHsLhfH&_nc_oc=AdqTi4OaaVjmkPTpxcWDUFGG0VOGtq1z-gmLK6KHxaEb2DpmHVkK20J7THn3jCsBcOc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWJrFH75Im_YGUDe4druG-KRMzTfmrUnNkd8Tgcl0Oig&oe=6A9AEAE2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
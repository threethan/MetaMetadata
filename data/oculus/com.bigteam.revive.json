XdQRLicqlYBwTDX7qfjOV0ZTLskXZClSO2gO3f6Q&oe=6AA2C252"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xTfk1suzgEQ7kNvwEobHXu&_nc_oc=AdptXx5nvI2czATu7lvEuDTTuSIkYrvpjKBjy4KvpkXRx0T8A5oAWykisRhvP3S0sEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNnvTkPgX94yNB8yI66yUg6BI8e3pejZDcnek-G46Heg&oe=6AA2BE28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpAGSzqAtLAQ7kNvwFtsgLV&_nc_oc=AdoUvUOFoWhyqrcem3K7tLn9bxOglz4HdANYnfIKVJg3AFZYpOH2vHb6s6Yez4hB3qM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI13ByE3_R6DpiMM1p_fpiyNQ364bhcvlo9LSbeRXrsPQ&oe=6AA29BA2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
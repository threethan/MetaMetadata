JuhXy-8YPZuKU35fbrI_rk_K5hh9s6hRKSDU4Pjw&oe=6AE0B8D2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYAgxOxukkUQ7kNvwF1bGQO&_nc_oc=Ados-zz5c4_csognvlB81LCBYhe_4vwaZi72co5VO8IVOEyPM_92yBrR3-Q3YauOSmQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMXzY6Ca442FIazMtbkNaqVWfJNDZPIvn5LPYDTZoV3A&oe=6AE0B4A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTgnFp9QVNYQ7kNvwHJhPWm&_nc_oc=Ado83ghZJheFcAE64mf12hQO6dN4Akrqu9dAAAnoKJOF2ZHEJ-D5XDsWdTTIIHi1jKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvCoSh1v5xKhpcpO1tVJ4SzrujftYZzkVdVBdK2hjEEw&oe=6AE0CA62"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
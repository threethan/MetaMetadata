2HiWyRBuUZj9sA8Vi2URYgAM7Vcsj0Hfa6K-lWcw&oe=6AAD4E52"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do99R9hFiYMQ7kNvwH9W4CQ&_nc_oc=AdoM7e4zp217UpLzEZupWcO6mRoMcgJPvG9T5p8i6i_zupaIGh5fBz6AgV1yeBxdaKI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUuh0RVaV6iF4hw7tMwtrdLhMWAdcQO7MbIj21W7W2qw&oe=6AAD4A28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC8L0S47N-QQ7kNvwFsWwk_&_nc_oc=AdpktLu_GXh6OYbmwzAYrtz1X0mVzMLEFaFjQ080Bi4p924oBURxVJbvKKgEm7jbGRo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfvqjikGlHDrEOfli74w1Tcqd7zq9OWhz08Pqywya5Gg&oe=6AAD5FE2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
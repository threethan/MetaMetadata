VKk4QjLI8QwrObfDsqkcyJBNlQl1nuYv0fDkHi_A&oe=6ACCF252"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2W8A9IVTgcQ7kNvwFUuIeS&_nc_oc=AdrSK1SeXcbxq8yXIgUdpXzPJ4FW8D7FoKT2um0bFj2HexWWcXE0ctrBDdsyRjHe_YU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhqSxq1odqup-fQTQz5yoVEfF5UGBjzaGlKfou5_SAYA&oe=6ACCEE28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ke8NI5cvKswQ7kNvwEp0uEH&_nc_oc=AdoRl7QaLBFOA5V8GW8nvvtdl03xQv-21O2xxa8M_VnE7Qn0ha9Q_Qedj5lGYlDOZoA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyh5WXD5Vmj8vvwMIZgU16aeYSQRCGr2K0pyklsDZenA&oe=6ACD03E2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
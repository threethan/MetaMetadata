1qRCs_93Lu0lMuTvFlpw2fFwbTFrsN4VANKd0fOA&oe=6AF873D2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SaXgfJgGZSQQ7kNvwELjoHt&_nc_oc=AdoRxlVh500Pi7N-BIbY_E6aKRrEC7YJXIYCnMLkxHL1oEaOqzuK3Hb2wlYueHJYZQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhw0CDUvOlhead8SAQIMswDUaAk7Ul-Yc08AQZYl85tw&oe=6AF8A7E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tY557FNJ2RMQ7kNvwEhyOIK&_nc_oc=AdokhGRsdYnk7c7uGY19rsaeKvu23U3s0HlLoURs8UtPTnslpxmIDH5w-3TczxsZswA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPc1LTrhsC0O3Y_seeyC4mtjL0rUz_gK00wUP0K_5Tiw&oe=6AF88562"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
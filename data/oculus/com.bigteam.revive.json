4&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDDxfZ5_Y_AQ7kNvwFqSZW5&_nc_oc=AdontVv1O8jyJnmnT7T3gWY07I4nlib1UQ_NoHht_qSzZAQm9GdF-bgfG3eOB0zOv9Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGQKAye6ZNAfXnfSDvpcipZhio2qdeqniVqD0Zi9QTDg&oe=6ACA6CCE"}, {"file_name": "ReVive-App-04.png", "id": "626826476370038", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392196_626826479703371_5020311105848761461_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDJ_uBJcWacQ7kNvwFXRlxm&_nc_oc=AdoHpg2wmLGj00-YVvQ0K8r2gYw6Z6sJDeDmsYlOJVoxHO2cCpgShcmxaVfZltwgdjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7BUBVLmleLgRkMqeRuEo3uUEf3PskN946kTF21jmmKw&oe=6ACA4F52"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kA-F2jf1KIQQ7kNvwEXpU6T&_nc_oc=AdpjQktYtKCEpxWeRXuf5Eq1gdShTT5yEkViDQb-OVqS6oqDt7yLeWf-_0tEQ_TMw-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdmCOm8d0aXgPLZinGLORgXIdIieK31DkfR1NSo0ZCaw&oe=6ACA4B28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZksPI7EkR-8Q7kNvwGdfH82&_nc_oc=AdoujHEgCqoxQmZb-6-KQCuow2p33HpD-WRN8so0_eUVED8u8qiOyhsMYFOLqe1RmWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuqTfAT53XaS_SnLlWfYTJgdFO2TmWUl5eMskvNszWpQ&oe=6ACA60E2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ibigteam.com/privacy_policy_revive_en.html", "developer_terms_of_service_url": "https://www.ibigteam.com/terms_revive.html", "publisher_name": "BigTeam Inc", "support_website_url": null, "website_url": "https://www.ibigteam.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28274998488798881"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392127_1010681580523224_1073021653430277053_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n_bc-GSo8IQ7kNvwGVwjcx&_nc_oc=AdrgYraMhRBQgHeWXrm003_qCB7uuWCuTyl3NvzxcxR4gkG6TrZ_5fH_xALKHDLyYS8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXqVHrim8yDrBECG4GFsGfVp8r2qaCltagqevjb7nb5w&oe=6ACA652C"}, "is_c
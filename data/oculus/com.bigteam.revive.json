rQSMOhEpwrTIttWGN-o4WasIEocnSYKtS_V5ys9w&oe=6A9ECDD2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CVA8Yx4rBkQ7kNvwGpKxQE&_nc_oc=Adq29eNYSWKD3PyPeQh6tPqDAFwwPiTMlJTHf3r-HeJHMhz2A7BBov0W_w9wiCRGZ44&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrIGoIxQd0sgKCqWk4WM4ElkHj1QEN-0Hw_3HKcwsuVg&oe=6A9EC9A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQIRltG8rA4Q7kNvwFNuyNc&_nc_oc=Ado3oajCr2rNrSHTPZ2OeNWqwSdFglEGYCSdlOzOIJBq1uiSut8t9D6TC9cqyH0gLWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj_ioHgYCvp6Da_SFgKzy8rOCHIL2dOGBEWakuLsi3DA&oe=6A9EDF62"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
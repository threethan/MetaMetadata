kZ4vucOQrSuYRoc-ysLLXdwqYFLoXDBxds7osCZQ&oe=6AE5FED2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD1ZvZvp7VYQ7kNvwEXv6v6&_nc_oc=AdrZJQhUT3KL-091PaWaEYfIFZbK6vLoE0XUDCXJ8V-M5QkTAjrrM0JORsUr1ZH-eHQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj8AjVOH0HqHOwdeLWHTA6I5WjdYYBsTMfdFAFmp4WrA&oe=6AE5FAA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzfEL4IxN8YQ7kNvwGoZ8Qd&_nc_oc=Adr9ciJAgxDeA4bn84-q3-WiYHztn8MJKz3WSPVxLKlAZ4AzRlipiOYSj2v6Bco_ioM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpLIovOMlJypszYCxBIkg48AcWUygMRvAKaD2EY2kTNA&oe=6AE61062"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
mu7mGovGkGir3oIGD0UZ0KyZ80xwwLwBcjV3m71A&oe=6AC65AD2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsloBSQHBaQQ7kNvwEnPjWs&_nc_oc=AdrmBf4Bzktc8jTq0SAoKPgfi2D9AA9haUXXCIRXJpVyOZPhf9kIIHNrKCKdAKppcik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOh0b2hmuKzS-enRGn5omWQAdhTX4NUaYlqz6v55Nz66Q&oe=6AC656A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0GIVO_WIXAQ7kNvwEFMVVT&_nc_oc=AdqIwm-RpV8amYAA1ne5ZMKrM65QikpsQrn9foDE4PlArQC87FcknY719C6AECLJ4HY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOToOvEr-DwGCIQB16iQNajnX8XYBWpEdUhF0C16usb-Q&oe=6AC66C62"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
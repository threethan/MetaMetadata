4&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RJHyhwRnCwQ7kNvwFQ3a9b&_nc_oc=AdrGu43MSVKrSq10rSLakDkD_JqdAzc9ygtDh7T8BhwTbyArK3vGgPasPJl4KY4LqAE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKs2J0tFTAveKXIHcgqN15Xg-_F0Q-bvfNM6ZIPFjcig&oe=6AF0A84E"}, {"file_name": "ReVive-App-04.png", "id": "626826476370038", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392196_626826479703371_5020311105848761461_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwdkSe_Ml_MQ7kNvwFjls_M&_nc_oc=AdoYOBky3E-p1349WP8vg_U1VApEczS7BugTg_RYqJzP0JG8fTXg3uUwsfJc2cN2eO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEHBslyUDiGGTAxVr4HgnUKH-kdJAK97KgnRR4P16s_w&oe=6AF08AD2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWzdRosNFMQQ7kNvwGb_728&_nc_oc=Adqv62dnrW3qzWwq4Y4C6htriROHvUGshKt7vcGwZE01Ay4Su3usrt1tYgCWFx8Wnd0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1JD3V7rn3zMdyNnyrQVozu6ae3CztyknstYymWk7_Vg&oe=6AF086A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr-JyeumAl4Q7kNvwErMrCs&_nc_oc=Adq79GeDzpT2JuxCd0IKf8SIzclcum7zC6_sM1RvJj7Swlx_TJ4s2wo78-MOXK98w-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8f-z44FOJ7qdmCtBMAkBDFxqrQU0Xu4D7t2AgZfSeOQ&oe=6AF09C62"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ibigteam.com/privacy_policy_revive_en.html", "developer_terms_of_service_url": "https://www.ibigteam.com/terms_revive.html", "publisher_name": "BigTeam Inc", "support_website_url": null, "website_url": "https://www.ibigteam.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28274998488798881"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392127_1010681580523224_1073021653430277053_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NQTb5IFTKwQ7kNvwE2wWSP&_nc_oc=Adr-wzRf14tmpzpkR9oxYRUZrchw4YfekSfh9R6LgEUZ6n9ubmT_l6gcg4FU5Cui4TU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZYqOfns6Kx7tCcwdiBRcTbA1EJF68HuD9h2IL65jkhw&oe=6AF0A0AC"}, "is_c
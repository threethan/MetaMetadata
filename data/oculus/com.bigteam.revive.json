D6bGK8sMyQC8yDz1j-tuZsJCqsqx7-WAKcEOOduQ&oe=6A9987D2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N_3zyBWOhMQ7kNvwFp6Iaj&_nc_oc=AdrKM_dMEmyDNCo0Rp98kAmCd3R25kVPey6pqBmrC0lp2LvP7fpziffosRXLUOfBin4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeqpnjEuxrvYCYOUs4K8LvcnFTovhHP_mFs_Afm3cqGw&oe=6A9983A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBEeWM5Os-0Q7kNvwEhpqN8&_nc_oc=AdrWlid9Mdhp-jEnnT19ndRfazJGEVjEy7MG_w-n_yG6XEdVoa6G18fhqFL1TZs-pvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkrit95aqb_EMWZRaUZkwwYfX8WX3BtmGqNbjnEZbl_Q&oe=6A999962"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
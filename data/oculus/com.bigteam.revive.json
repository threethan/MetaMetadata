tent-atl3-2.oculuscdn.com&oh=00_AfsekKMGBTafeWVtMsrHsrSLm1_SpzDTGHQ5u_lJEM1PNw&oe=69A5878E"}, {"file_name": "ReVive-App-04.png", "id": "626826476370038", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392196_626826479703371_5020311105848761461_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vajs35wf_QUQ7kNvwFv0dEF&_nc_oc=AdljvpSwVrkK9xLMtVVuydN0WnYpjQ7i5sRy8sLNm4P3igdmM6nVE6D8P7r1d7X3o6w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsbP2oqsaW0s8Tg-ZbXQ1kVe_aYjyA_SYoh57oFC3orWQ&oe=69A56A12"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zupkGF8PEqYQ7kNvwE4n70l&_nc_oc=Adm4rdeDANPQHWDNAc2iih8Dh3R8Jk664hdR37P3Qg3OltTGQRPEB2V6qLULyrJ6jzk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvICQ7ntIMkRM7fCgP5TSHp7Dp7Cu3uH6Cw_F--_e4o3w&oe=69A59E28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyKiiB8Us2YQ7kNvwG1Rd54&_nc_oc=AdlOZIspsV5-wbFLts0wWYrz2Bap3UenxzW56Tqh95FlI4SoCCCZUj1dBWdw6yPA9hA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvDto9HH9mGPwVKPKjBMfY4hNecEv-jbu1qPZcXecaXQg&oe=69A57BA2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "developer_terms_of_service_url": "http://www.bigteam.co.kr/terms_revive.html", "publisher_name": "BigTeam Inc", "support_website_url": null, "website_url": "http://www.bigteam.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9641081059283906"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1807568076706237"}]}, "baseline_offer": {"id": "1807568076706237"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743606540, "status": "PUBLISHED", "id": "1807568076706237"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9640967662628579", "version": "24"}, "id": "1367396574673022", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "91622917
9Ws0DaKgEhQT2NCMRj1bnVCaNevip_blJDNvQTrw&oe=6AE75052"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD1ZvZvp7VYQ7kNvwEzjFmG&_nc_oc=Adpr9L8Mj6N4j-YZH44UUDj3wy2G6yDFrGGH3Cuj5KDaDbc_oOqXEOfqWXOOwMyBqrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuZqnbwTouOGpVO_lcQFH6bxjmTAUWkhPIV5GE4jXi4Q&oe=6AE74C28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBbxzRzlFKEQ7kNvwH_-Xmp&_nc_oc=AdpYqo7Or-bXA50CCg0-Sn61IjNty8COOVkjUqTnetI1bZzNb0rLs-km_0vXvxrDIGg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIizYS2GFcuvRIe96X-0HysBoA810iRyuIUy9r7UJaNw&oe=6AE761E2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
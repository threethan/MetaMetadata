slyUDiGGTAxVr4HgnUKH-kdJAK97KgnRR4P16s_w&oe=6AF08AD2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWzdRosNFMQQ7kNvwGb_728&_nc_oc=Adqv62dnrW3qzWwq4Y4C6htriROHvUGshKt7vcGwZE01Ay4Su3usrt1tYgCWFx8Wnd0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1JD3V7rn3zMdyNnyrQVozu6ae3CztyknstYymWk7_Vg&oe=6AF086A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr-JyeumAl4Q7kNvwErMrCs&_nc_oc=Adq79GeDzpT2JuxCd0IKf8SIzclcum7zC6_sM1RvJj7Swlx_TJ4s2wo78-MOXK98w-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8f-z44FOJ7qdmCtBMAkBDFxqrQU0Xu4D7t2AgZfSeOQ&oe=6AF09C62"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
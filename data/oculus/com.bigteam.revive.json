H_ZChBCb0sTqgcTeVosTHojN13MCKThSnoTK6THA&oe=6A983652"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N_3zyBWOhMQ7kNvwE0xaa1&_nc_oc=Adp_2tsksNkVKmMPpmyYQop35bMNczpHt-mkFkmeOzP6MR0PHsYsNI5DDqigrJoGR9s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9aUSZN4EYm9Jk3-ZyAhbG1jbMEeIYl9HMswZP8T5C1Q&oe=6A986A68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBEeWM5Os-0Q7kNvwF95nuN&_nc_oc=AdrBFzcD9SS5ab5coNX5DBls0MBy38TQFVuuEp_VZJXRs4spftSXSb33EXCKqH7VG7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ77VNF3mJEqzCPlqwA3d6UvAZqrB1CcTc50QrVnH1_1g&oe=6A9847E2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
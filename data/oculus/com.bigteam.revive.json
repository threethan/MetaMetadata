vIaWPmPQn0IgrHTVIr5Wtmzezl5HWyvuGIzVsN-g&oe=6A9C2AD2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N_3zyBWOhMQ7kNvwHF3mo4&_nc_oc=AdomtclBW_QDhYXB17lvpM4toV64yUkW-7h_i9PRNeJoa2xmRRGK56bOIpqe0nZv9N4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg0JKqozFtzRwQJJE4XhvJSqvWwfSdNSVhKQY67WoAhg&oe=6A9C26A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fBEeWM5Os-0Q7kNvwHq6z6x&_nc_oc=Adpo5UnZ47V4ip3r-Q706C6MmgIld_iYX4kJNstSoKtOpwlm5BO3G4gNmHvGegjDnwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqva6gaBy4iobXAaAN4kKBludAIGhTy_XwicENWfiWjQ&oe=6A9C3C62"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
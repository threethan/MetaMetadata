4&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RJHyhwRnCwQ7kNvwH4V05p&_nc_oc=AdqAidhz0zAVR8EyysOcFuG4clOjj85J5_QURmQ07y0fkiG-ap0GYlAWz6DT2WtHsNY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN7Z6zR_ADV9X1MYAgtwtSiToTpMh9r3X5UiQnq0fA2A&oe=6AEF56CE"}, {"file_name": "ReVive-App-04.png", "id": "626826476370038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392196_626826479703371_5020311105848761461_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsdAlQ7Bmt0Q7kNvwFNe6oc&_nc_oc=AdrfNWEL3E0rVidMviqBxrTvFCTopf76z0WMlloWV-sWKr4ZgwnWysaO40Wm6zxv5yY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnDklXDWjsZj9czvkiWrjyyMxHiU9H9U3ytkFQu_r-Uw&oe=6AEF3952"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWzdRosNFMQQ7kNvwFNxQMu&_nc_oc=AdpQjC0ewGc3rDUC-4nvx70CozocAXdTs-W_oEm7lKsLsNz5n1S6fY8Yow_gwT67yh8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgie1rCqazswHndrkmTaJRndJ71IQMwvqDX80fLeLQzQ&oe=6AEF3528"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mr-JyeumAl4Q7kNvwFKHzVp&_nc_oc=AdpZszeeHg3buy6XEJno8-izTh_Tl1lc99NWDrZVPwdt6AkPkkEmK37WZhXjv4kEtfA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyeL_xp0aEbRrqugYns41hsUnBK7rAM3e5BHDEDeaBMA&oe=6AEF4AE2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ibigteam.com/privacy_policy_revive_en.html", "developer_terms_of_service_url": "https://www.ibigteam.com/terms_revive.html", "publisher_name": "BigTeam Inc", "support_website_url": null, "website_url": "https://www.ibigteam.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28274998488798881"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392127_1010681580523224_1073021653430277053_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NQTb5IFTKwQ7kNvwHaPOEf&_nc_oc=AdrgLwOFRuqUMt0VgDY3nsEWg5btSZI0iI4H-mEMMzz45_3sijvDO62QD0Yk7Jtq1KA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp_KdtqEB9OLbyrOcO02l3-IE_pil1xuP7v8skhAPSUQ&oe=6AEF4F2C"}, "is_c
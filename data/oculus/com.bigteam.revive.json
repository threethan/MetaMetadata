BVLmleLgRkMqeRuEo3uUEf3PskN946kTF21jmmKw&oe=6ACA4F52"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kA-F2jf1KIQQ7kNvwEXpU6T&_nc_oc=AdpjQktYtKCEpxWeRXuf5Eq1gdShTT5yEkViDQb-OVqS6oqDt7yLeWf-_0tEQ_TMw-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdmCOm8d0aXgPLZinGLORgXIdIieK31DkfR1NSo0ZCaw&oe=6ACA4B28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZksPI7EkR-8Q7kNvwGdfH82&_nc_oc=AdoujHEgCqoxQmZb-6-KQCuow2p33HpD-WRN8so0_eUVED8u8qiOyhsMYFOLqe1RmWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuqTfAT53XaS_SnLlWfYTJgdFO2TmWUl5eMskvNszWpQ&oe=6ACA60E2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
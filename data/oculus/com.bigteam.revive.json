7f20f&oh=00_AQJen8qZoaGtZsa365BxgY7DZOaV5UUlkoRQGnr2SyJF3Q&oe=6AAE9FD2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=do99R9hFiYMQ7kNvwGi2vC5&_nc_oc=Adpiy-Wr0QeY67r9NSXvmI0F7Ww2QXWtX-lWW1jcuAxUNVXLvLizXl_jow-RxY7Dmjc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSWeH5B_BkZph3pSpOimttb279IHDaOuYNF6gYCWcbZg&oe=6AAE9BA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC8L0S47N-QQ7kNvwEBw_Cg&_nc_oc=AdqfEcCYOyZJRvncWXEENMBtx_KTH0FwnLlUhUubZCc9B6fkD1VnJawJ3AyCdpVE9yQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOeju68pEDeqxX5G0jWdqu8hY6RIoCM7DhG9kTu6LL0A&oe=6AAEB162"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_reviv
7f20f&oh=00_AQL0WSnptCjgwYz4kRmPGKS1n4a2xbv5JgZeInagBxg2MA&oe=6AA959D2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WvMikzu2bMQ7kNvwFOORGd&_nc_oc=AdowNSkhQJFLBQtnl-cxqZN87dGWECeu0uoG51ySc7xsC_A6B159Ipt6kmMOvE1HW1I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQL-LswmvaWyok1j71W2dljEXhKO5wFXibTnTk91RuPg&oe=6AA955A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUhhoy9LDRoQ7kNvwG49vBk&_nc_oc=Ado0YURFWu7s6aUJpHz7UKX8PxEl9gIM-BkcAMU7arhC_ANhpWPos70JuI6DxVY-sU8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSTTkvtQSMmDRVsA6lBBddRsm3XiLMx7h-E61krUFpqQ&oe=6AA96B62"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_reviv
Dw&oe=6B085A9D"}, {"file_name": "revive-screenshot-06.png", "id": "1850707559078991", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391961_1850707562412324_374201352071772028_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNjIOlnI2g4Q7kNvwFmmuTq&_nc_oc=AdrYffThj2wNsMdaEdgEnoi0ZmstJbMMPAmJ4pCJm0f6d2gj4_IHZtJIRrwxaW6ygpg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa90vwiVbTqZkJ7ZYdJWguXzQq99ItJqgcqrnTvtgRDQ&oe=6B08634E"}, {"file_name": "ReVive-App-04.png", "id": "626826476370038", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473392196_626826479703371_5020311105848761461_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwtwfCDV-t8Q7kNvwGE6pEf&_nc_oc=AdoVhh9-cTKdns9Ayc9x9qimBvCunEBSerz5MoPbgENWU0Ymmw6TRhdijNvJmkeDoWw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkvnoJePlNmulbhUfB9ZSjPgrn1kBZQNpklcaFN1pdoA&oe=6B0845D2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxAvZx2x3AMQ7kNvwECzJQA&_nc_oc=AdrIv7LwBuwTkWXrOhMEN6TXkswppWbX8yQB2VpooOJn4BH8HHIMyQr9O9r-QJqk3hQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuesFbOoVCI0Lw0lKvzZiINQBKzoORt131sAgbz8mr8Q&oe=6B0841A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmSde1uSQEIQ7kNvwFkQb7A&_nc_oc=AdpKBCIXht7eS84tRsb9fdeegic872rSOuem4UL0yzI-px5m82N--tx8hDRFqpWR4bQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnuHr1iYrKkzu-K8UxZFKPVI9Vzg-ym-ZsEWz6ajn_CQ&oe=6B085762"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ibigteam.com/privacy_policy_revive_en.html", "developer_terms_of_service_url": "https://www.ibigteam.com/terms_revive.html", "publisher_name": "BigTeam Inc", "support_website_url": null, "website_url": "https://www.ibigteam.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28274998488798881"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/473392127_1010681580523224_107302165
cQ&oe=6AFF201D"}, {"file_name": "revive-screenshot-06.png", "id": "1850707559078991", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391961_1850707562412324_374201352071772028_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33-jB6olM0AQ7kNvwFiC9DE&_nc_oc=AdqKSPNltRM9TeacV11bsf1O0JXcAPMggh7Tls7JLSIWT3U7o4lKK_CsSqkEIRsw3NM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMHVmnKQYHnA0IoCgF5aAbSdj_Wj_K_20I-6vkdbF-2Q&oe=6AFF28CE"}, {"file_name": "ReVive-App-04.png", "id": "626826476370038", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392196_626826479703371_5020311105848761461_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9rDcFlr2X0Q7kNvwGJvqeO&_nc_oc=Adp4oZpaxBiYH0gIWXUdDiZLHr2GcipP9v6NhQI3NMPIC5rQ3MGvq-gXdzeJeJo3jds&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQROMS1KSvB6VCJHI-F2taXJrbqbs9HWDQWI2w0t42khQ&oe=6AFF0B52"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2VIRiYsntMQ7kNvwGcRE83&_nc_oc=AdrExYlfPVQcXD8YielHzl29C42onzb2gMe5svfs8nDiRKEE534Hjm0x6XMUngy_KPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy9vpoHjsACUxzeMaWJkwMWppkzEyboW6OBEP2UUM4aA&oe=6AFF0728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8m8yezfyGAQ7kNvwH_qhET&_nc_oc=AdrBvOAYD5FwaD9qrQDkLT0kNWi93195vBo5_nrCoq8zA8z18WmLMHwBc-hHpAcSZC4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3zV1h40p_wT6N1Yn7bwX8-Y5fjbdLuAt7SFcrqK8zKA&oe=6AFF1CE2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ibigteam.com/privacy_policy_revive_en.html", "developer_terms_of_service_url": "https://www.ibigteam.com/terms_revive.html", "publisher_name": "BigTeam Inc", "support_website_url": null, "website_url": "https://www.ibigteam.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28274998488798881"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392127_1010681580523224_107302165
GbYAb6lgXFJyVdv8uI_EQ4MNyYoe0ZstLSpKKq_Q&oe=6AAAAB52"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WvMikzu2bMQ7kNvwE2L0L2&_nc_oc=AdphFG0njl5F0Lghi1uG9Av7NmXpJB5fL07KK_O9fZ1jBbIArj1wklNsl8WZRCZzoe0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUXnHf19YybYw4gvzVfSjNFGmB_xjKyMp2OZWqTLXKaw&oe=6AAAA728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jUhhoy9LDRoQ7kNvwHxeIoR&_nc_oc=Ado3TUjqFvIMlKTcgct8-yuGBBRmPKDU-mgOuDBx5f0sRxp_E3Fsm-SCLU5tyYKV3Hg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF3Es-IL_r4m43UnIb9zHcuHznT9oyLWSnxcS89oQUCQ&oe=6AAA84A2"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.bigteam.co.kr/privacy_policy_revive_en.html", "develop
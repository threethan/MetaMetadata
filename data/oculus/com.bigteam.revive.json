4&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAJj5SKQeP8Q7kNvwGMUfXd&_nc_oc=AdrrV4XfxvqeBIBgYFWqpj37n11BbxmAPw3wsjlML2NgIg7q0UxYsTHTEL3JXnxChSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWKuHCva4unIVtTC7kZOKc14RiPGBMk_uXf0MAb-A0fg&oe=6AC1324E"}, {"file_name": "ReVive-App-04.png", "id": "626826476370038", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392196_626826479703371_5020311105848761461_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EobvsMBd_8Q7kNvwGecBPe&_nc_oc=AdrglbbsD-9kZ3gNgE-bYcRTOpk3UcjKSsHupmEQgY-7KSfiCtMKsJ_TmguH2-KbYss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZGXd3Hx6kwkEnqdu9rXGL4TI6uhU81Q48rvy10hzq5A&oe=6AC114D2"}, {"file_name": "ReVive-App-02.png", "id": "484088517774422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392185_484088521107755_1151797770014867788_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78Ua6cPZDwoQ7kNvwFnnXaW&_nc_oc=AdpY12cTlzUOWGXN4PQcBanu1tY4Bvg7qyAYGdObhtB42zzv02AWeZNP8kG2RC57gsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhcT17qfxDqtnREXbG26J1ImNi3IU-DjhsiEZ0p0o4og&oe=6AC110A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_logoXpng.png", "id": "1389690219110882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392138_1389690222444215_139767472560893_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfwFf0I-ZYIQ7kNvwEKb6R5&_nc_oc=AdqjdCop_5Rz4TuL-9XYkjRsBE1KKLRIcYNX0Ejcqd0fC3vkmxOK3L2iqfrWAcZJ98k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmVXY8vY5UUNzY_gSo0RhAV09X2p2iFO4XWEy-zg-2xg&oe=6AC12662"}, "display_name": "ReVive", "keywords": ["ReVive", "Rehabilitation", "Stroke", "Community", "nrc"], "long_description": "ReVive is an innovative program that uses virtual reality and augmented reality technology to help rehabilitation patients become socially engaged and independent. The program is designed to help patients safely train and regain confidence through simulations of various daily activities in a virtual environment similar to real life. ReVive focuses on helping patients become socially engaged and independent, not just physically rehabilitated, thereby improving the quality of life of patients and maximizing the effectiveness of rehabilitation.", "short_description": "ReVive is a program developed to allow rehabilitation patients to practice various tasks they may face in real life through simulations. You can have various realistic experiences in your home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ibigteam.com/privacy_policy_revive_en.html", "developer_terms_of_service_url": "https://www.ibigteam.com/terms_revive.html", "publisher_name": "BigTeam Inc", "support_website_url": null, "website_url": "https://www.ibigteam.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28274998488798881"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392127_1010681580523224_1073021653430277053_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ni1GiUo2k7YQ7kNvwHYMlmn&_nc_oc=AdrKvFHDcGCuC6_sSeni6yMelkKMcaqHld5CWinF_4zQnNX-9I5dwwxPfu5bRw0r72c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMug4knI6KehtuaLtx6zT7v80YpqGyLiTA2CqhVyENFGQ&oe=6AC12AAC"}, "is_c
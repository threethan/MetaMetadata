qhprU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu3y7845jtXteUb3At4Hmm9bOye-3xdFM_3SJGXAs1wA&oe=6A707B10"}, {"file_name": "gal s5.png", "id": "1197082031144663", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75280177_1197082034477996_8323040905996963597_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-sWk0ivwtQQ7kNvwHCeSIP&_nc_oc=AdpLivpRloFkxhBKOIfoQZT8a4rHXnWeYR_ZF3mxXrYDUbY7TecTd0GJNHX12_TiUeU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjoqSjggTa0e6Ch--CA5RVEGD-k0emU9n9_0p3tS2nhw&oe=6A7092CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "prox1.png", "id": "624281065885082", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75326673_624281069218415_3816302253552308813_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WX7k-w3A98Q7kNvwHGdanM&_nc_oc=Adpy5FT_aLSVAVTqqdnGJhHZ_nTOiD9b6WBdDzs_y_Jpgo5pB9rcwDHl1dgks3cWB-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHos7na4bvgb1wUnltz9uVHLIrMxqmpF_k3hMXKsYlc0A&oe=6A708664"}, "display_name": "VR Gallery ZOSU Smash", "keywords": [], "long_description": "VR Gallery ZOSU Smash:\n- Visit a beautiful gallery and smash any painting and many objects with over 300 pastel paintings from the award winning artist Dr. James Southworth.\n- Simple and fun smashing ability that can be enjoyed while visiting the beautiful gallery.\n- Smash with swords and hammers!  Bonus blade slice area and drawing canvas area.\n- Beautiful paintings from around the world including, Turkey, Europe, Northwest USA.\n- Paintings include stunning landscapes and pastel colors, as well as cityscapes and people.\n- Additional bonus paintings in pastel and other art mediums by Dr. Southworth and ZOSU (as marked).\n- Climbing is included for most areas.\n- Bonus object spawning station for additional smashing replayability, or simply reset the level.\n- Object destruction based on where objects are hit, objects take varying damage to be destroyed.", "short_description": "VR Gallery ZOSU Smash:\n- Visit a beautiful gallery and smash any painting and many objects with over 300 pastel paintings from the award winning artist Dr. James Southworth.\n- Smash with swords and hammers!  Bonus blade slice area and drawing canvas area.\n- Beautiful paintings from around the world including, Turkey, Europe, Northwest USA.\n- Paintings include stunning landscapes and pastel colors, as well as cityscapes and people..\n- Additional bonus paintings in pastel and other art mediums  "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zosustudio.com/", "developer_terms_of_service_url": "http://www.zosustudio.com/", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "https://www.zosustudios.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4750315168402824"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "609869723804453"}, {"status": "PUBLISHED", "id": "3591497864419566"}, {"status": "PUBLISHED", "id": "1278903129615129"}, {"status": "PUBLISHED", "id": "1229828547751764"}, {"status": "CANCELLED", "id": "305666655249245"}, {"status": "PUBLISHED", "id": "792939301844814"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1678384380, "status": "PUBLISHED", "id": "609869723804453"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "And
", "short_description": "VR Gallery ZOSU Smash:\n- Visit a beautiful gallery and smash any painting and many objects with over 300 pastel paintings from the award winning artist Dr. James Southworth.\n- Smash with swords and hammers!  Bonus blade slice area and drawing canvas area.\n- Beautiful paintings from around the world including, Turkey, Europe, Northwest USA.\n- Paintings include stunning landscapes and pastel colors, as well as cityscapes and people..\n- Additional bonus paintings in pastel and other art mediums  "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zosustudio.com/", "developer_terms_of_service_url": "http://www.zosustudio.com/", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "https://www.zosustudios.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4750315168402824"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "609869723804453"}, {"status": "PUBLISHED", "id": "3591497864419566"}, {"status": "PUBLISHED", "id": "1278903129615129"}, {"status": "PUBLISHED", "id": "1229828547751764"}, {"status": "CANCELLED", "id": "305666655249245"}, {"status": "PUBLISHED", "id": "792939301844814"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1678384380, "status": "PUBLISHED", "id": "609869723804453"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "And
Qkg9M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX14YZvb3xk9BUaJCVTBRK2-OUUxZm-ZK9DV0-f-PDZQ&oe=6A4BC950"}, {"file_name": "gal s5.png", "id": "1197082031144663", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75280177_1197082034477996_8323040905996963597_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-uDzrnLCdQQ7kNvwEON0Dr&_nc_oc=Adq8FZchOnMo8BonH_EMSBxpYdU4xdQXBXh67Q-iAFETrA9MIi7hDQ1zTEeoaFfSGs8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXqbgfZF5Y46xIVse7INuDfUAx2d8xQR6gZX7hKHaqDg&oe=6A4BA8CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "prox1.png", "id": "624281065885082", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75326673_624281069218415_3816302253552308813_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAfF3bfH6PgQ7kNvwEFZMbx&_nc_oc=AdoNi_rCOBUHH2ybJoR0lKWxJ-fdOx7mElhTWzGMEuOT13hrZOFKi3f2FVyxTm5eUGQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYYhxBIDP0VKAYBRrGPlBX_ctydh3ALIhlVxdBefqSoQ&oe=6A4B9C64"}, "display_name": "VR Gallery ZOSU Smash", "keywords": [], "long_description": "VR Gallery ZOSU Smash:\n- Visit a beautiful gallery and smash any painting and many objects with over 300 pastel paintings from the award winning artist Dr. James Southworth.\n- Simple and fun smashing ability that can be enjoyed while visiting the beautiful gallery.\n- Smash with swords and hammers!  Bonus blade slice area and drawing canvas area.\n- Beautiful paintings from around the world including, Turkey, Europe, Northwest USA.\n- Paintings include stunning landscapes and pastel colors, as well as cityscapes and people.\n- Additional bonus paintings in pastel and other art mediums by Dr. Southworth and ZOSU (as marked).\n- Climbing is included for most areas.\n- Bonus object spawning station for additional smashing replayability, or simply reset the level.\n- Object destruction based on where objects are hit, objects take varying damage to be destroyed.", "short_description": "VR Gallery ZOSU Smash:\n- Visit a beautiful gallery and smash any painting and many objects with over 300 pastel paintings from the award winning artist Dr. James Southworth.\n- Smash with swords and hammers!  Bonus blade slice area and drawing canvas area.\n- Beautiful paintings from around the world including, Turkey, Europe, Northwest USA.\n- Paintings include stunning landscapes and pastel colors, as well as cityscapes and people..\n- Additional bonus paintings in pastel and other art mediums  "}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zosustudio.com/", "developer_terms_of_service_url": "http://www.zosustudio.com/", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "https://www.zosustudios.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4750315168402824"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "609869723804453"}, {"status": "PUBLISHED", "id": "3591497864419566"}, {"status": "PUBLISHED", "id": "1278903129615129"}, {"status": "PUBLISHED", "id": "1229828547751764"}, {"status": "CANCELLED", "id": "305666655249245"}, {"status": "PUBLISHED", "id": "792939301844814"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1678384380, "status": "PUBLISHED", "id": "609869723804453"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "And
NvwFUCPAg&_nc_oc=Adnr2Im9aQY2n4qhclrVwKF3rJIIoefb5YHlauV1-xsS957s-Yo2RyqMrLTjMpiyp_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwN7oivIxmrg2Yjc0FAZqFXZ48KaJuU_8CjRzJ3qQ0NAA&oe=69B00ABD"}, {"file_name": "screenshot3.png", "id": "910085638157695", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820586_910085641491028_8348605737488375462_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8UVeaJBF6qYQ7kNvwE1lMf0&_nc_oc=AdmmCuYsah7seZwR-tfresrnad8fUDNQyk9CaAaUvMPtcpqB1X9i8Hb8UyMNf9jDejc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8SfQbxxgfpQHuA6JgaoWkKvXgNL4aOn9mXKDFPxLouA&oe=69B002DE"}, {"file_name": "screenshot4.png", "id": "1982894195623320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821725_1982894198956653_1840294563104143078_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0h24mfQDQ6kQ7kNvwE0wPgs&_nc_oc=AdlQYv0ogkJ5ZJUBtGire8eVLaPWXp-bqR2_TY7mIaZnVDdyzpG8mwsFCrVZtbFIgtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNVlIzYc40_PeWnJ0djgau6QB16pkXU_bArtlyAjSESw&oe=69B0166A"}, {"file_name": "screenshot5.png", "id": "1864004277875304", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820428_1864004281208637_6425938893441817704_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruDWGIcHCAQQ7kNvwFfXcow&_nc_oc=AdnyyN2ml7M3iQe2AvqNfYoaOzm76JthKFpTzl7qlNHoWw_UAhsydY5Ar4F2735YIEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGf12Z0C1fagMq5AnHJ8kpB09vf-h-086fgsaCJObQFQ&oe=69B00943"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RIBBLE", "keywords": ["tag", "multiplayer"], "long_description": "RIBBLE is an immersive virtual reality (VR) game that places the player into an interactive 3D environment designed specifically for VR headsets. The game focuses on natural movement, intuitive controls, and realistic interactions using motion controllers.\n\nBuilt with Unity, RIBBLE aims to deliver a smooth and comfortable VR experience while allowing players to explore the environment, interact with objects, and complete in-game challenges. The gameplay is designed to feel immersive and responsive, making the player feel truly present inside the virtual world.\n\nThis project was created with a strong focus on performance, simplicity, and accessibility for VR users.", "short_description": "RIBBLE is a fast-paced VR game featuring hand-based movement and active gameplay. Explore a unique custom map, climb, jump, and move freely using your hands in an immersive virtual environment designed for smooth performance on Meta Quest headsets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16WE19tnM89EF5DmWGZbISsxeA9E6pZA4c2YrAW_egQQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Hecys Games", "support_website_url": "https://www.youtube.com/@hecys", "website_url": "https://www.ribble.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25872609355692251"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2301904840313907"}]}, "baseline_offer": {"id": "2301904840313907"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769803680, "status": "PUBLISHED", "id": "2301904840313907"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"
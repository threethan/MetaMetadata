NvwH9LmL_&_nc_oc=AdksvSKr1tAGCOvHmNRdoFFfMjs-bs6s-YuqrQnx9ebRkbUXihzeZg12VDyk3Y4BqQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAW3BE-L0WGvx3kFETUYb7qEM7BTgpYsUu9RlJg6AT1Q&oe=69AC163D"}, {"file_name": "screenshot3.png", "id": "910085638157695", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820586_910085641491028_8348605737488375462_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwXSXjVSyfYQ7kNvwGMOoZC&_nc_oc=AdlyYLMLZ7IaRqgJJO03by4_CfhgEJzE_yIeAXX7U52xHywWMM_moeG_KZqcm6UqWVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5UZYTy8bROYZ71yRsuKg-tf8DGQWpUkUmUWMryYrwVg&oe=69AC0E5E"}, {"file_name": "screenshot4.png", "id": "1982894195623320", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821725_1982894198956653_1840294563104143078_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9hG_M1CleEQ7kNvwH9wqQ7&_nc_oc=AdnGysdYCddSEutcmlemR9M29exwHj6v4ipPiWpGyfrq7RNzzsHELfGWUzFFmiwjyiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWnK30jxCZvVAKRyvry3ZPHRLiIPHJ385KZx7hT9X1xQ&oe=69AC21EA"}, {"file_name": "screenshot5.png", "id": "1864004277875304", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820428_1864004281208637_6425938893441817704_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHwNTeisqJsQ7kNvwFiEA6P&_nc_oc=Adn7jYx57g_OEZGtVL7JJtkC48ogr4ys0w-cfgJdVQj3GV4ja2TvhfBuYqnqN-H_OrQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2_1Z64266KJWD6klcdAhIcTTDyBFEXY93RG9TnInXKw&oe=69AC14C3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "RIBBLE", "keywords": ["tag", "multiplayer"], "long_description": "RIBBLE is an immersive virtual reality (VR) game that places the player into an interactive 3D environment designed specifically for VR headsets. The game focuses on natural movement, intuitive controls, and realistic interactions using motion controllers.\n\nBuilt with Unity, RIBBLE aims to deliver a smooth and comfortable VR experience while allowing players to explore the environment, interact with objects, and complete in-game challenges. The gameplay is designed to feel immersive and responsive, making the player feel truly present inside the virtual world.\n\nThis project was created with a strong focus on performance, simplicity, and accessibility for VR users.", "short_description": "RIBBLE is a fast-paced VR game featuring hand-based movement and active gameplay. Explore a unique custom map, climb, jump, and move freely using your hands in an immersive virtual environment designed for smooth performance on Meta Quest headsets."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16WE19tnM89EF5DmWGZbISsxeA9E6pZA4c2YrAW_egQQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Hecys Games", "support_website_url": "https://www.youtube.com/@hecys", "website_url": "https://www.ribble.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "25872609355692251"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2301904840313907"}]}, "baseline_offer": {"id": "2301904840313907"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769803680, "status": "PUBLISHED", "id": "2301904840313907"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"
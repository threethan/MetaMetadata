e": "1440cover.png", "id": "939484898381397", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824216_939484901714730_8157414902503280186_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWF5BrbrxIQQ7kNvwE2nvsM&_nc_oc=AdqL1cJKvBRAF2SU4obrrJOqvyDrHL2HeN7PnjjKAxwQebet6qiQiJcgnDm8c77qh4U&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkcYCLbipADIrhOVQ3KoBmRv0jEFVG0zCDtQzqZBEnng&oe=6AA417B9"}, {"file_name": "k2 storesquare.png", "id": "835463346312695", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618271_835463349646028_8786418211315180381_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyvEqoAsUMgQ7kNvwGOwzTR&_nc_oc=AdqUBs_ZGyRTPQPZ8mHH_G3iwCthBu8BADj9-nScG9dS-CDmYZxwl_qMawZO-oC7cEc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEUukVljnYUVb8KsSAxonTOAW949AE3Uy_QDqQgJ_wIw&oe=6AA3EF7C"}]}, "id": "641864095259553", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgwpbXkuDKQQ7kNvwFTsZxj&_nc_oc=Adr6-kG_FJo1Z7Eqtu_n1rTA-SZEBJVHkWlTCTl_fAh_VG75dcU6T_sLm2MpiOTjmW4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrsJDAMqnFHFitoVMuXXvgT9YkgP3h2BOzkOd_og3WoA&oe=6AA408F3"}, {"file_name": "Capture (2).png", "id": "1444188850130136", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491830599_1444188853463469_7375342923422000036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQGW6uO3NPkQ7kNvwHBZKe3&_nc_oc=AdoHh6KKCWXbtVbL9bqEo0F7xNvD_JmEP-IJSyliZZ7R6vL_4zdzcTBzaUMF63RY5vw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC4ZuGPvIpcNWhUAWo6brJFMJVtpM5OQlSjAjV1oKn3w&oe=6AA3F46A"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgpT7BTSa90Q7kNvwEwQM9i&_nc_oc=AdqSoRmO1HkC-grNOnGQdU9NFAzC0kcbTvmkNuwWT20lkoqyuSdbUyZTYtzQhwY90oY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9AQVavDvGTW2GgaaNuf7JlDM7r6w8qlpMsyAfOjUGJg&oe=6AA41D41"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8p3W8jKLLoQ7kNvwE4nBqd&_nc_oc=Adokq50NkEmAjxfTXcAJTdISiw6XsJDj9DeXu6_4GYDCnaE3CtL5Ew-7Ti6QMq2P8V0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoPG9PdbxMtA5ENXeDJi5FSnFaySaT4zh2z8gtYdEEQg&oe=6AA40E66"}, {"file_name": "1007(1).png", "id": "1605271954215026", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499625160_1605271957548359_1793312081502853557_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40drZs1Ws-cQ7kNvwH_QgVe&_nc_oc=AdrWRC4b_XY2t9c3DR7YTZI3xxw89_I-6Pt1KToU_iiFvXPw1QKBjGUFVl_2SWiNvq4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISWwJCryRpCfv6H4zNl4tskb6eNLy-fvIZA7peWa2-5g&oe=6AA3FDEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "BECOME A TESTER TO RECEIVE OUR EXCLUSIVE FOUNDER'S BUNDLE\n# Your Dimension Needs You, Guardian.\n\nReality has fractured. Join the Alliance and fight through portals and reclaim worlds consumed by The Apparition. Wield powerful phase weapons, battle interdimensional foes, and restore balance to a shattered multiverse.\n\n# Core Modes\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op**.  \n- **Survival** \u2013 Endless waves on a **Global Leaderboard** for bragging rights and exclusive rewards. \n- **Player Battle** \u2013 Forge custom maps, and compete in PvP\u2014 with friends or online with **Online Matchmaking** {792444113494594}\n\n---\n\n# Play With Friends \n- Fight alongside other Guardians, or battle against them\n---\n\n# Gear Up\n- Deploy K2, throw plasma grenades, or wield experimental tech like the Gladiator Axe.\n{798255319782596}\n---\n# Earn Rewards & Level Up\n- Complete Missions, collect currency, and unlock Guardian Helmets and Weapon Upgrades\n{1612792543035085}\n\n---\n# Join Our community Discord: https://discord.gg/7Urx5f2wsf", "short_description": "Rifts. Apparitions. Synthetics. Your home is the map\u2014and you are its Guardian. Quantum Strike transforms your space into a sci-fi arena with dynamic mixed-reality combat, enhancements, and co-op. Rise through the ranks, upgrade and customize your gear, and join the interdimensional fight. Test your skills in Survival, take on Missions, and battle friends. Private Beta now open (limited seats via our website). Wishlist today to join the first wave."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/qs-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_mo
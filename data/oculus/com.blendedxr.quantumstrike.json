.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF06dfkJB_hN0yx49ygJvoqWdOqEpU163iwbhLQNnbGg&oe=6A562BEA"}, {"file_name": "screenshotAmenity (1).png", "id": "2014359539357102", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491830147_2014359542690435_3520654462865960175_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8Wblwx74XIQ7kNvwHiBrFl&_nc_oc=Ado09N06Gd65Idu1OGNlj_OcWckevwltAt4CmquRpCghZ6tHTK9pHjTVMkBwBtMvqtI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqGFLH-bri03SoR7f9vXOLLuRWhIvOhshAT_PF5lHqgw&oe=6A562685"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tn4UjFMp4DEQ7kNvwG500a8&_nc_oc=AdqYoxclI0kb6FHBhYWTOd3WTHM6J6qa7nwR9XSmMTQLFgQTcQ3kLoi1nTD7D5KF_es&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9ll6agjEV1fGNx_kksqvytrScnuZGYIRHw-nLiRjGDQ&oe=6A5654C1"}, {"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgwNm_0OYZ0Q7kNvwHnurgP&_nc_oc=Adq_iH8T_E3W_ZdVLinOq_rA08hCQnJAPD_QzVmfNGMREYfl72QiBZi-jxeEvMyIsYw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOWai-t0CWj4Hut5mDtU6kz25qD-aPiId0DUdjM5cM1A&oe=6A564073"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQWxLTYoDroQ7kNvwGTmOnY&_nc_oc=AdpE0vs1HhM1-epOCthqgjyAizMqhZK0HvnA4fPnI-5w_JtjGFJPzaXcn7YFbQJMT_8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwkr8jnoZEF08DasQz23GeyJ1Gy2pv081ifkG6kHVWMQ&oe=6A5645E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QS16;9coverA.png", "id": "801195052747564", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819980_801195056080897_3076448756038429623_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8o4DpL0LxkQ7kNvwEjxTib&_nc_oc=Adr9cyXk9fcnpW2sGANvel7eDPxV0L2tYQ7PZq0z_mAprMUhu6t8rC1LIcyBIjSS0lo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF8ROtmWpqxvr2QY5yxeyFVx1LDPixuHtony-TpPkabg&oe=6A56597F"}, "display_name": "Quantum Strike: Mixed Reality", "keywords": ["multiplayer", "shooter", "free", "pvp", "zombie"], "long_description": "**Turn your room into a mixed-reality battlefield.**\n\nQuantum Strike is a fast-paced mixed reality passthrough shooter for Meta Quest 3 and Quest 3S. Portals tear open inside your real space, enemies pour through, and you fight back with futuristic weapons, shields, upgrades, and help from your AI companion, K2.\n\nPlay **solo**, team up in **co-op**, or battle other players in **PvP** \u2014 with support for both same-room local play **and** online multiplayer with players anywhere.\n\n{1488139402427954}\n--\n\n# **Features:**\n\n- **Mixed Reality Combat** \u2014 Turn your whole room into a sci-fi battlefield.\n \n- **Solo, Co-op, and PvP** \u2014 Fight alone, team up against enemies, or battle other players. \n\n- **Local & Online Multiplayer** \u2014 Play in the same physical space or connect online with players anywhere. \n\n- **Weapons, Gear, and Upgrades** \u2014 Build your loadout with advanced weapons, land mines, plasma grenades, experimental gear, and unlockable upgrades. \n\n- **Level Up and Earn Rewards** \u2014 Complete missions, earn XP and currency, unlock Guardian helmets, upgrade weapons, and expand your arsenal. \n\n- **Custom Arenas and Matchmaking** \u2014 Create battle spaces with Forge Mode and jump into PvP with friends or players online. \n\n- **Leaderboards and Replayability** \u2014 Survive waves, climb the leaderboard, and chase better runs.\n\n- **AI Companion** \u2014 Get tactical guidance, mission support, and answers from K2 along the way.\n\n- **Built for Quest 3 and Quest 3S** \u2014 Designed around passthrough, room-scale movement, and fast mixed reality gameplay.\n\n\n{792444113494594}  \n\n# **Join Our Discord**\n\nhttps://discord.gg/7Urx5f2wsf", "short_description": "The Void is invading. Turn your real room into a mixed reality battlefield where portals open, enemies attack, and every fight happens in your space. Play solo, team up in co-op, or battle other players in PvP with same-room local play and online multiplayer. Upgrade your gear, complete missions, earn rewards, and strike back."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://quantumstrikexr.com/quantum-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://quantumstrikexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26604925049130274"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307935_852269373852177_1523780842524145262_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mPD-NX0X4SkQ7kNvwGDsaxo&_nc_oc=AdrqCrPkwmVia6WcGNMHtLUyCOyp9vCgSdncIkZM9ATKZ2ukKkxMWl4LP0Eu2OEwdy8&_nc_zt=3&_nc_ht=scon
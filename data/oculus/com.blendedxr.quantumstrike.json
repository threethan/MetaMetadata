7294658027433", "locale": "en_US", "screenshots": [{"file_name": "Capture (2).png", "id": "1444188850130136", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830599_1444188853463469_7375342923422000036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i-ic2tKtewQ7kNvwF0d5rd&_nc_oc=Adqie2SxOmXg6pdaOMnRJb9zGslwZ8e4ScpkHgngpwtyxFZeM4GYn6uX0zOmiNb7DTs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3t_i2r3yGwoVokNk04d-Yy5o7Rny19hVEYEVBHWxDi1A&oe=69E0D66A"}, {"file_name": "screenshotAmenity (1).png", "id": "2014359539357102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830147_2014359542690435_3520654462865960175_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qic7dRroO8gQ7kNvwHM1SfS&_nc_oc=AdoltsJVIMI_oFqAJnffu3gO5B0rrQ5-eBzk0vOiC2NMTTNhOW1TBZnErJ7vbGzGsuI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1so-NVYuOKJ0eKsU4eRmp3dKmkXOo491UWcLRz4AmR2Q&oe=69E0D105"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eF9X6fJ0oMQ7kNvwFdy2jr&_nc_oc=Adq8hs3091UXIcBW9r-PwbT832aGrFNs-AY_gFur_8osoKHDn1donlCkzBsGaCM8xt0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N7iyexwBfWUTcoiUufaU34R6abAMTUC_3VpoqMOCxsg&oe=69E0FF41"}, {"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zjju0j_e2wQ7kNvwGuARfj&_nc_oc=AdpNz5RNwahL742DthXdKdUzdADkKVxRZF9XNIQsFbenowx8jeKKRp8xoywc8eaZbnk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a_Hty-cCQcQQBoyZSZwU0NtcylW6FftXU9HG1I0qEaw&oe=69E0EAF3"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOE-4u5xruYQ7kNvwGZEdrf&_nc_oc=AdpQYEMMcwyCY_IiFf6sw4rIt7Loz2Lmb4O5BKSxeQLyMruXafZPWYBoEg3WP0iOUAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mWwGgGvmCm-Q26niFRglv2m_pLlA_HbxaBAQ4Suw7mA&oe=69E0F066"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QS16;9coverA.png", "id": "801195052747564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819980_801195056080897_3076448756038429623_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtdw6Qakha8Q7kNvwEBUbGf&_nc_oc=AdqK7IAOzA-OEllh9GURpj7B82wrRCzi-DktX8ebK17PzhEeqxq4w-fw2_6Ndu1uGgI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Twdvy3FyxLQYH_V3GkJXD1kSrqSpZFiY2DiKpznbLSg&oe=69E0CBBF"}, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "# **Welcome to the War, Guardian.**\n# PORTAL NOW OPEN (11.15.25)\n\n**Multi-versal genocide is already underway...and its not looking good.**\n\n**The Void** is succeeding in its crusade to erase existence across dimensions\u2014deploying hordes of mutagenic **Apparitions** as their instrument.  \n\nThat's where you come in.\n\nArmed with advanced weapons, and guided by your sarcastically loyal AI companion **K2**, your mission with **The Alliance** is simple: \n\nFight for what\u2019s left \u2014 and take it back\n\n---\n\n# **Core Modes**\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op.**  \n- **Survival** \u2013 Endure endless waves and climb the **Global Leaderboard** for bragging rights and exclusive rewards.  \n- **Player Battle & Versus** \u2013 Forge custom maps and compete in PvP\u2014either with friends or through **Online Matchmaking.** {792444113494594}  \n\n---\n\n# **Play With Friends**\nFight alongside fellow Guardians\u2014or test your skills against them.  \n\n---\n\n# **Gear Up**\nDeploy land mines, throw plasma grenades, or wield experimental tech like the **Gladiator Axe.** with A.V.A - your Advanced Virtual Armory\n{798255319782596}  \n\n---\n\n# **Earn Rewards & Level Up**\nComplete missions to earn currency & XP \u2013 unlock **Guardian Helmets**, upgrade weapons, and expand your arsenal\n{1612792543035085}  \n\n---\n\n# **Join the Community**\nJoin our Discord \u2192https://discord.gg/7Urx5f2wsf", "short_description": "PORTAL NOW OPEN (11.15.25)\nThe invasion has begun. Portals are opening across dimensions as The Void unleashes its army of Apparitions. As a Guardian of The Alliance, you\u2019ll fight back in full Mixed Reality combat\u2014taking cover in your real space and striking alongside friends in co-op or online battles. Upgrade your gear, complete missions, earn rewards, and defend reality itself. It's time to strike back."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/quantum-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24980818294874299"}, "review_messages": []}]}, "c
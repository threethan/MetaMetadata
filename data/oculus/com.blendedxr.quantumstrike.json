.png", "id": "939484898381397", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824216_939484901714730_8157414902503280186_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ict8WvwesloQ7kNvwHG71my&_nc_oc=AdroxV0IVSQLM3dCL1D2nv3ChJNWiDzIyfYKSfcaSKGHA7by9y3hLRppRzHB2Z69LeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDRAZ_PQT1BnZbOCu8O0cQTzjh57GFsqOxt7czCeJ_hQ&oe=6AF48339"}, {"file_name": "k2 storesquare.png", "id": "835463346312695", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618271_835463349646028_8786418211315180381_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8W6jasYKuIgQ7kNvwFIn5uP&_nc_oc=Adqfr1Hgvlos4WX20KGsFnsjkkFk1iFzM4aUTJKlFQEhEEPA062DZDEZQ-wTSLxiMx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0bCWy6KKLSx2ueoIRuCfl9wuomb48MQquIIvY4_9lGA&oe=6AF4933C"}]}, "id": "641864095259553", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5R4xr6PVIkQ7kNvwHSJSrO&_nc_oc=AdoU2AHGHnzk1KnCBeUcg9KgwoHo2WHAbpGjd3eEsiuBoLYqoLXk-XJJyNFSqUvnn60&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrmFiG_F5cQ1RQRxLzr5rLJh8I2C_uMVDIRjWyFjTGMw&oe=6AF47473"}, {"file_name": "Capture (2).png", "id": "1444188850130136", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1444188853463469_7375342923422000036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwdZa7MWOrgQ7kNvwFGyNXa&_nc_oc=AdpCL2nJDKjU04l_v5PefM2LPVw_XTdpVxewSVEaNiScMY9I9gp2UYMcw4UyXI4JR6Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCuJH2k_nkshswtV0jszSwimjDFolyAsrDPP0IAj0OPg&oe=6AF4982A"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pi-qv9wq8EoQ7kNvwG9bmDF&_nc_oc=Adpi810QmkYGB7fAcoI9zjlacdClV9SXmFhPCqP6PuqfMMr8t7VE6w1i_IOn2hnCVgk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZZ7Fk2i1Rp8vH0fmNdBkz3C3TABQAoDHALvyXJ-oLiA&oe=6AF488C1"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=057WFF_WzjUQ7kNvwGVEz4l&_nc_oc=AdreBySOiqrbNDv1q_xqVWYLuax5FgesLoRfwiBtVTOo23A8Q3t0URbHF_KlruLESpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmjhDipZRyxmPMPM3v3kyUAn07uUPj_5vQ7Cdj9efyHA&oe=6AF479E6"}, {"file_name": "1007(1).png", "id": "1605271954215026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499625160_1605271957548359_1793312081502853557_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fPuZ9-G2jkQ7kNvwFVJDsf&_nc_oc=Adp804pfrBRrakMqr9_GSTjuvwm__aN-QdUTrsnxzu9gfzucFvbCsIQuKGwx_L0V1Kg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXYhPXVr4lfIVtIlnQuXmaH_I3mtOJTOqv0dNBwOQpgQ&oe=6AF4A1AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "BECOME A TESTER TO RECEIVE OUR EXCLUSIVE FOUNDER'S BUNDLE\n# Your Dimension Needs You, Guardian.\n\nReality has fractured. Join the Alliance and fight through portals and reclaim worlds consumed by The Apparition. Wield powerful phase weapons, battle interdimensional foes, and restore balance to a shattered multiverse.\n\n# Core Modes\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op**.  \n- **Survival** \u2013 Endless waves on a **Global Leaderboard** for bragging rights and exclusive rewards. \n- **Player Battle** \u2013 Forge custom maps, and compete in PvP\u2014 with friends or online with **Online Matchmaking** {792444113494594}\n\n---\n\n# Play With Friends \n- Fight alongside other Guardians, or battle against them\n---\n\n# Gear Up\n- Deploy K2, throw plasma grenades, or wield experimental tech like the Gladiator Axe.\n{798255319782596}\n---\n# Earn Rewards & Level Up\n- Complete Missions, collect currency, and unlock Guardian Helmets and Weapon Upgrades\n{1612792543035085}\n\n---\n# Join Our community Discord: https://discord.gg/7Urx5f2wsf", "short_description": "Rifts. Apparitions. Synthetics. Your home is the map\u2014and you are its Guardian. Quantum Strike transforms your space into a sci-fi arena with dynamic mixed-reality combat, enhancements, and co-op. Rise through the ranks, upgrade and customize your gear, and join the interdimensional fight. Test your skills in Survival, take on Missions, and battle friends. Private Beta now open (limited seats via our website). Wishlist today to join the first wave."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/qs-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"]
e": "1440cover.png", "id": "939484898381397", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824216_939484901714730_8157414902503280186_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zTT6n8RJGQQ7kNvwHhxlH8&_nc_oc=AdoUK__hmPhG752i2MXIeHvpqFOPPj8Pe8Px_0qimxv8vkm1hYV_Fpa-KfP3Tksbv8Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj9FgvtaqwMlt5o2xoVCic4nHwEcW9ghn3zpBoOy407Q&oe=6AA95DB9"}, {"file_name": "k2 storesquare.png", "id": "835463346312695", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618271_835463349646028_8786418211315180381_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVp5WudpFsEQ7kNvwEM53Ci&_nc_oc=AdqqnDq_zoqtTQxnntVUG-S2CFTAv05CZD9UuOGpb-qbmUAnasuCw0qJLcC04HEUwXE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBuQbz6I4THOkBYk4mvLyR5gFZwVQC0zswjI5CIfuofA&oe=6AA9357C"}]}, "id": "641864095259553", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfeFwqKlBQMQ7kNvwFxfavy&_nc_oc=AdpNZ9q1iLTsmMM7VPrsOlInp1R85NMf7GQK2QRzcScDAWT3YyzsH0iu37r0owYpZjA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsOERV2JnAtXnEI6N9gihV78MB_uwZXW5vyeO-TqBx1A&oe=6AA94EF3"}, {"file_name": "Capture (2).png", "id": "1444188850130136", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491830599_1444188853463469_7375342923422000036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QkYYG0SErIQ7kNvwEzk3Hi&_nc_oc=Ado9MsK6LpXd4Al3Ptr8n4UVOOx-XUJz3sx3sjwMEfY576tS_q-c6Yu7GJTzujASNcs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCH5MoBborwxGeCj8dAYM76bf7XEAUKHAumsmPzAONqw&oe=6AA93A6A"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBkj31HrVmYQ7kNvwH7TUYO&_nc_oc=Adp4HWmhco1u4BtTbjbC0eey3qhnkfvBIzkb8lPcWugd15ZQ9KzUc-JaYMGjrMT_py4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0xPzBa_F-x36711tdGWZNLl_k4ANvVJLLKYHonIUspA&oe=6AA96341"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XtPhLcUus8Q7kNvwGNdde3&_nc_oc=AdqVYs4Up9dE8Br9URk1V0msVhk-oA1nOwIZsd6X0Ft1s6COvyfVyUZRqnPfZV9uVQI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0OI6FPwid8AWARRFICA1Huaz3pP2wtFKovNFTnnS59Q&oe=6AA95466"}, {"file_name": "1007(1).png", "id": "1605271954215026", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499625160_1605271957548359_1793312081502853557_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30kWVnb6crsQ7kNvwGCTarH&_nc_oc=AdpTrj15EN2nGZKL2otbLqPDYoBEJQ_PAZg42Yv-33CMj38vnnpxoHnLshfWfnN4-ng&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl3ZomehsroE7ukhQ2-f6rqtCOB5UIxQZ78Kw2ankJzg&oe=6AA943EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "BECOME A TESTER TO RECEIVE OUR EXCLUSIVE FOUNDER'S BUNDLE\n# Your Dimension Needs You, Guardian.\n\nReality has fractured. Join the Alliance and fight through portals and reclaim worlds consumed by The Apparition. Wield powerful phase weapons, battle interdimensional foes, and restore balance to a shattered multiverse.\n\n# Core Modes\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op**.  \n- **Survival** \u2013 Endless waves on a **Global Leaderboard** for bragging rights and exclusive rewards. \n- **Player Battle** \u2013 Forge custom maps, and compete in PvP\u2014 with friends or online with **Online Matchmaking** {792444113494594}\n\n---\n\n# Play With Friends \n- Fight alongside other Guardians, or battle against them\n---\n\n# Gear Up\n- Deploy K2, throw plasma grenades, or wield experimental tech like the Gladiator Axe.\n{798255319782596}\n---\n# Earn Rewards & Level Up\n- Complete Missions, collect currency, and unlock Guardian Helmets and Weapon Upgrades\n{1612792543035085}\n\n---\n# Join Our community Discord: https://discord.gg/7Urx5f2wsf", "short_description": "Rifts. Apparitions. Synthetics. Your home is the map\u2014and you are its Guardian. Quantum Strike transforms your space into a sci-fi arena with dynamic mixed-reality combat, enhancements, and co-op. Rise through the ranks, upgrade and customize your gear, and join the interdimensional fight. Test your skills in Survival, take on Missions, and battle friends. Private Beta now open (limited seats via our website). Wishlist today to join the first wave."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/qs-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_mo
.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBR1tOHyNwbAOlWjMJ6cQzo133znu_CdHwIDSVZSIdLpw&oe=6A5CC36A"}, {"file_name": "screenshotAmenity (1).png", "id": "2014359539357102", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830147_2014359542690435_3520654462865960175_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWQNfiC9o2cQ7kNvwHmE8qp&_nc_oc=Adq73GoBLzkrvx_Bc7DJmHcLZNihy9BSQGAUxYVqEtfanfeCtf7uOLVGI3lhMAaTx2s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrgjZV-XEmUAi-BA7d_ioGwyFyvhFW5mF77yTplIOA_w&oe=6A5CBE05"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3KudLtCiUsQ7kNvwGO6iVZ&_nc_oc=AdouoMiElYAkgAIxGMW23fj3wIxaqpg5lrp_bvaGYfo5GHyDKo4wbhi2vuEdIZD18dc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQp3YoxeLcHkAt-KHnNaZug27XRLxNqgKn_Ely9jEmeg&oe=6A5CB401"}, {"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qz9lAv50tocQ7kNvwFaAJi3&_nc_oc=Adp9X8dVvTEqwufjzVmb8l4IwViHybCADseH_M0UyfmT7-Yea99iecKB0Dglnkw09d4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9VoPVCFd18tqqW9y5aiyOFiGaNcOnT34jobKRmRkhqw&oe=6A5CD7F3"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YIREJvi1B0Q7kNvwHlnW_4&_nc_oc=AdqBThX56xqbeikdS13tASc7v3KJGYklOCtnhOTL7EnsIh4QtNIqJNtrwM3NnrvgzwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBATGPndtzIXtF_ivUtNB3fpN8GHhwmJyv1juUrw6xAjg&oe=6A5CDD66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QS16;9coverA.png", "id": "801195052747564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819980_801195056080897_3076448756038429623_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4h9omRZK8cQ7kNvwEqr52l&_nc_oc=Adp0FwhZvHGqz6t_NF75QzQ9vvd6rm5oXrqhASnhI3Pg5Bh2Z1W3tZwi5uDgq0-KcV8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDIQfiEXohdGSSAIJMnf31_6V4dpxAnlY9SbN1YhPr7A&oe=6A5CB8BF"}, "display_name": "Quantum Strike: Mixed Reality", "keywords": ["multiplayer", "shooter", "free", "pvp", "zombie"], "long_description": "**Turn your room into a mixed-reality battlefield.**\n\nQuantum Strike is a fast-paced mixed reality passthrough shooter for Meta Quest 3 and Quest 3S. Portals tear open inside your real space, enemies pour through, and you fight back with futuristic weapons, shields, upgrades, and help from your AI companion, K2.\n\nPlay **solo**, team up in **co-op**, or battle other players in **PvP** \u2014 with support for both same-room local play **and** online multiplayer with players anywhere.\n\n{1488139402427954}\n--\n\n# **Features:**\n\n- **Mixed Reality Combat** \u2014 Turn your whole room into a sci-fi battlefield.\n \n- **Solo, Co-op, and PvP** \u2014 Fight alone, team up against enemies, or battle other players. \n\n- **Local & Online Multiplayer** \u2014 Play in the same physical space or connect online with players anywhere. \n\n- **Weapons, Gear, and Upgrades** \u2014 Build your loadout with advanced weapons, land mines, plasma grenades, experimental gear, and unlockable upgrades. \n\n- **Level Up and Earn Rewards** \u2014 Complete missions, earn XP and currency, unlock Guardian helmets, upgrade weapons, and expand your arsenal. \n\n- **Custom Arenas and Matchmaking** \u2014 Create battle spaces with Forge Mode and jump into PvP with friends or players online. \n\n- **Leaderboards and Replayability** \u2014 Survive waves, climb the leaderboard, and chase better runs.\n\n- **AI Companion** \u2014 Get tactical guidance, mission support, and answers from K2 along the way.\n\n- **Built for Quest 3 and Quest 3S** \u2014 Designed around passthrough, room-scale movement, and fast mixed reality gameplay.\n\n\n{792444113494594}  \n\n# **Join Our Discord**\n\nhttps://discord.gg/7Urx5f2wsf", "short_description": "The Void is invading. Turn your real room into a mixed reality battlefield where portals open, enemies attack, and every fight happens in your space. Play solo, team up in co-op, or battle other players in PvP with same-room local play and online multiplayer. Upgrade your gear, complete missions, earn rewards, and strike back."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://quantumstrikexr.com/quantum-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://quantumstrikexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26604925049130274"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307935_852269373852177_1523780842524145262_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76d6pjrNBAsQ7kNvwFB_sgK&_nc_oc=AdrzkXIZCAiI_sc_5mcccGZoD-tcq4n8DBPMe6ML5k2fQQWgdjPJS8J19Zp0kO-KBww&_nc_zt=3&_nc_ht=scon
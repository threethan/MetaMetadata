7294658027433", "locale": "en_US", "screenshots": [{"file_name": "Capture (2).png", "id": "1444188850130136", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1444188853463469_7375342923422000036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dt65RD6QREQ7kNvwEbypKF&_nc_oc=Adqfxy91OdfSqzdcKaah7A9avCug1NNVHBmOFOkx7OWqKv_NKK3uYTQusf88bqhKadI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uaFr-xG1KpKS8eREODiXB0KWk4a80txIi0iNMLi7L2Q&oe=69D3A76A"}, {"file_name": "screenshotAmenity (1).png", "id": "2014359539357102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830147_2014359542690435_3520654462865960175_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gS4ZFQZWGlAQ7kNvwEKNMfc&_nc_oc=AdrODED-Va12kl9yjByg8bBB3a7h9gJfUmdmweaSbfDg3wm-UGILKJWOuh9JLBIbXbY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ToZTtTZme5dFMpNXF2BmxHeCo28MXA2weecD6Ms5s7w&oe=69D3A205"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0gJX7GstXYQ7kNvwEfQM8j&_nc_oc=AdqwLQ6la56lQUh6i8e4_Hl7lD2PUkwX28c7Rrqq7SzXudtGpnzqOKgKToLxBJduhxU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z35xn3o2xL4t0wyyIgDFVemTGnORduFNUZgCjPXr8XA&oe=69D39801"}, {"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c53u9f8B_v4Q7kNvwGkOkk8&_nc_oc=AdotoBaoiMiA5BDGw_xhj-qOD2A-MT2f3SODVU9AROwVW2gZX4CscbwH0X-09cZIlws&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RPX3TpmHr1VBdJlYmMkMvmkiCYbiwoH1lHcnH5DAohQ&oe=69D3BBF3"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRGgYPYXEKcQ7kNvwEmdfvN&_nc_oc=Adoyg1gJHU2JTVOn8d6hDMWDzv8FBLIM45-89N7morLQgYSz5daClj7h1gSe6WX3cz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ySOIK6XiyS5VeSFDEdmPzXvAOdVoHhmipWrRWrTwp5A&oe=69D3C166"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QS16;9coverA.png", "id": "801195052747564", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_801195056080897_3076448756038429623_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xXcpj6y1VEQ7kNvwGdsP_e&_nc_oc=AdpFzlf9aL7OqWIGwuuVtKysRAR7_-yabmGXiecLtOv0x2tu0_p30HlmXBIjDGUyepE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NvqwmABZ800HVge2T1k0iJtr1K_fZT3Q0vmxVBtmdug&oe=69D39CBF"}, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "# **Welcome to the War, Guardian.**\n# PORTAL NOW OPEN (11.15.25)\n\n**Multi-versal genocide is already underway...and its not looking good.**\n\n**The Void** is succeeding in its crusade to erase existence across dimensions\u2014deploying hordes of mutagenic **Apparitions** as their instrument.  \n\nThat's where you come in.\n\nArmed with advanced weapons, and guided by your sarcastically loyal AI companion **K2**, your mission with **The Alliance** is simple: \n\nFight for what\u2019s left \u2014 and take it back\n\n---\n\n# **Core Modes**\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op.**  \n- **Survival** \u2013 Endure endless waves and climb the **Global Leaderboard** for bragging rights and exclusive rewards.  \n- **Player Battle & Versus** \u2013 Forge custom maps and compete in PvP\u2014either with friends or through **Online Matchmaking.** {792444113494594}  \n\n---\n\n# **Play With Friends**\nFight alongside fellow Guardians\u2014or test your skills against them.  \n\n---\n\n# **Gear Up**\nDeploy land mines, throw plasma grenades, or wield experimental tech like the **Gladiator Axe.** with A.V.A - your Advanced Virtual Armory\n{798255319782596}  \n\n---\n\n# **Earn Rewards & Level Up**\nComplete missions to earn currency & XP \u2013 unlock **Guardian Helmets**, upgrade weapons, and expand your arsenal\n{1612792543035085}  \n\n---\n\n# **Join the Community**\nJoin our Discord \u2192https://discord.gg/7Urx5f2wsf", "short_description": "PORTAL NOW OPEN (11.15.25)\nThe invasion has begun. Portals are opening across dimensions as The Void unleashes its army of Apparitions. As a Guardian of The Alliance, you\u2019ll fight back in full Mixed Reality combat\u2014taking cover in your real space and striking alongside friends in co-op or online battles. Upgrade your gear, complete missions, earn rewards, and defend reality itself. It's time to strike back."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/quantum-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24980818294874299"}, "review_messages": []}]}, "c
.png", "id": "939484898381397", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824216_939484901714730_8157414902503280186_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KaLJESz9UgQ7kNvwHQp8jW&_nc_oc=AdrPYFr0u4MXR6AxpzsAM9fzfRnE-EKYh1F3F9zxcFwfayjA0loADexCT3sWVpeDq8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoGS23lYK5zSP0kg8iWV0R2cAeWyvunRoCKqU62p_Cgw&oe=6AC26A39"}, {"file_name": "k2 storesquare.png", "id": "835463346312695", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618271_835463349646028_8786418211315180381_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2w--IUgnjEoQ7kNvwHYhvzt&_nc_oc=AdqLOgK0tOmR8SnmiA6TUyM2SzYB66p7sK7HzHlRzSxjyKDATr1GlyoMqmHXaNLUYQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg23t4Hc57rZ-R2zjrmd-hj89j5dUL1UVX4VW8bcbclg&oe=6AC27A3C"}]}, "id": "641864095259553", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpIe3avaIioQ7kNvwFed4nP&_nc_oc=AdqDVhGI0r-pIsiiY5c6aTXmkhaGBrqW6JiSQshoPFOatuEZ26-lJ-Q38y7r4i_6Q98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXbNrdCBzAXRb9vxaMKacnZHTDZt6t3WbefVgZv3Y0Hw&oe=6AC25B73"}, {"file_name": "Capture (2).png", "id": "1444188850130136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830599_1444188853463469_7375342923422000036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJwJX88q6ZEQ7kNvwF8azzk&_nc_oc=Adq1qWPVRjpbvKTs528W864oxofi_wJRnhMSP-whaVIyPnsQzy00I7IqwxD6ACk43qI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMTN17iEixNwwRhUedociykt2FfsOUzIZY-X31bdztTA&oe=6AC27F2A"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_plQ-Cwsj6wQ7kNvwGAPd0J&_nc_oc=AdqQq7ZaNU7k1RxrzRDokGRwppTL5XyZXlOH8Q68us8GteSuqB5V7U2gKdXZ0jbKvtk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7FgbP4Hn99Fk_Jfcfc25f_V9fbkFk1i8h_kgf8J7wZA&oe=6AC26FC1"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzxWw2ipkd4Q7kNvwFtAd26&_nc_oc=AdoMXYRZQ4AozU5DF_MoOdXEC3ZqrLIgYEzJqxl30FW9jByjipnXhx746q2eKwxUAoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwtbqIVcHby67UlRFLW_kdWXM9X8GzEwEbxDsWkq-QqA&oe=6AC260E6"}, {"file_name": "1007(1).png", "id": "1605271954215026", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499625160_1605271957548359_1793312081502853557_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poLSBBaG92IQ7kNvwEBZsPp&_nc_oc=AdomgLMPvE_NYAuLXBm4QY-RNwnk9qps9LqGy_oLTUiivNdjvkgNNKose0Fpt8WCNaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKNnXTaknczB089QpUiCkuzz-Va3egw6I5qBkIVOcS7Q&oe=6AC2506F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "BECOME A TESTER TO RECEIVE OUR EXCLUSIVE FOUNDER'S BUNDLE\n# Your Dimension Needs You, Guardian.\n\nReality has fractured. Join the Alliance and fight through portals and reclaim worlds consumed by The Apparition. Wield powerful phase weapons, battle interdimensional foes, and restore balance to a shattered multiverse.\n\n# Core Modes\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op**.  \n- **Survival** \u2013 Endless waves on a **Global Leaderboard** for bragging rights and exclusive rewards. \n- **Player Battle** \u2013 Forge custom maps, and compete in PvP\u2014 with friends or online with **Online Matchmaking** {792444113494594}\n\n---\n\n# Play With Friends \n- Fight alongside other Guardians, or battle against them\n---\n\n# Gear Up\n- Deploy K2, throw plasma grenades, or wield experimental tech like the Gladiator Axe.\n{798255319782596}\n---\n# Earn Rewards & Level Up\n- Complete Missions, collect currency, and unlock Guardian Helmets and Weapon Upgrades\n{1612792543035085}\n\n---\n# Join Our community Discord: https://discord.gg/7Urx5f2wsf", "short_description": "Rifts. Apparitions. Synthetics. Your home is the map\u2014and you are its Guardian. Quantum Strike transforms your space into a sci-fi arena with dynamic mixed-reality combat, enhancements, and co-op. Rise through the ranks, upgrade and customize your gear, and join the interdimensional fight. Test your skills in Survival, take on Missions, and battle friends. Private Beta now open (limited seats via our website). Wishlist today to join the first wave."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/qs-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"]
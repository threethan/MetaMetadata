.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qr68bKrgdXkhXXfuV9OqoMdxl3wlvjMR7dP5Wmhr4-g&oe=6A259CAA"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwozADfJ6N8Q7kNvwGR2e0o&_nc_oc=AdotKwJFgtup33e2dyVKTasE0o7-XWMbqSdC2lbQyYdA0vp2-ThZoMtUU2_i5oOQvJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93NhayeQhFewmMl_-2ws841Vwg7BDCqIDy69xTqNDs3Q&oe=6A258D41"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SjA1LJzLSMQ7kNvwFZcLs9&_nc_oc=AdpX5A3bauJxqQPOjpjZwmS3Mlgvpm4OSLoif7W1d1Jf2V5ASGS8mJedt_HbRac6fZc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wZLuI94CNx6xSRLpxfblo-ip3I5D82PawiLaAWrAwiA&oe=6A257E66"}, {"file_name": "1007(1).png", "id": "1605271954215026", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499625160_1605271957548359_1793312081502853557_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYjCzoo524sQ7kNvwFOJRM7&_nc_oc=Adpa9pK8COoV_6YoEefGP53OgD1LRncmu5pjsG_BT_awfxCh7iQf5hI9_l13rhGK4RM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96tc_3TfzkXloRvprV7RjhfNfGAfpcX9bvg3LWfo8b7w&oe=6A256DEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "BECOME A TESTER TO RECEIVE OUR EXCLUSIVE FOUNDER'S BUNDLE\n# Your Dimension Needs You, Guardian.\n\nReality has fractured. Join the Alliance and fight through portals and reclaim worlds consumed by The Apparition. Wield powerful phase weapons, battle interdimensional foes, and restore balance to a shattered multiverse.\n\n# Core Modes\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op**.  \n- **Survival** \u2013 Endless waves on a **Global Leaderboard** for bragging rights and exclusive rewards. \n- **Player Battle** \u2013 Forge custom maps, and compete in PvP\u2014 with friends or online with **Online Matchmaking** {792444113494594}\n\n---\n\n# Play With Friends \n- Fight alongside other Guardians, or battle against them\n---\n\n# Gear Up\n- Deploy K2, throw plasma grenades, or wield experimental tech like the Gladiator Axe.\n{798255319782596}\n---\n# Earn Rewards & Level Up\n- Complete Missions, collect currency, and unlock Guardian Helmets and Weapon Upgrades\n{1612792543035085}\n\n---\n# Join Our community Discord: https://discord.gg/7Urx5f2wsf", "short_description": "Rifts. Apparitions. Synthetics. Your home is the map\u2014and you are its Guardian. Quantum Strike transforms your space into a sci-fi arena with dynamic mixed-reality combat, enhancements, and co-op. Rise through the ranks, upgrade and customize your gear, and join the interdimensional fight. Test your skills in Survival, take on Missions, and battle friends. Private Beta now open (limited seats via our website). Wishlist today to join the first wave."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/qs-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "reco
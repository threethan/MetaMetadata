e": "1440cover.png", "id": "939484898381397", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824216_939484901714730_8157414902503280186_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTMBgAgN1OsQ7kNvwErEA3C&_nc_oc=AdqB1_PKJiK7XKUWcBtifzKEHcMjydlIlaGX90CB2Yyjqhnx0pXLHkXv4T_V1Gc5xEY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlWCjfzhl-rVkGNuTF_YERLaUNRWckR-LUSs18Rv3IGw&oe=6AAEA3B9"}, {"file_name": "k2 storesquare.png", "id": "835463346312695", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618271_835463349646028_8786418211315180381_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIUQZY1sBC4Q7kNvwFxIkuE&_nc_oc=AdrfCAPQBIiBIN6g8y-zpa1wtlX_agMpEvwV-GvWEiGXLJoA5Af6HNJlfYjYOa4Y12A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiDRDYkVlzfxNgnGPZs6e6zskKBKweduqtdlUjoh1Upg&oe=6AAEB3BC"}]}, "id": "641864095259553", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_z2usH980HEQ7kNvwEd_rzy&_nc_oc=AdpRwzTEECKLumeaZoOUhjUJL14Iwi0uwWYy3XkHacdQ6ue0fnTfROHT96wAqvC1Tjc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJer1lYHK8g_Yberisht83ZCFiKg59nDFngq0sglt2cOg&oe=6AAE94F3"}, {"file_name": "Capture (2).png", "id": "1444188850130136", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491830599_1444188853463469_7375342923422000036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZuhxoVASr4Q7kNvwH6b4eR&_nc_oc=Adpry4gB8hUt56eSI0KiyW0EA72Zbp1L_ZGAVgJX1LAtnnlK6ukJEeR7HmAddAN3UBE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJP7xqQXf_LZ0hUQmAmHndLWDdbtcHDRTFb_jzud11Edg&oe=6AAE806A"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_CkL_jRGLMQ7kNvwGouRkl&_nc_oc=AdrBuqT6ztvgLXYoMxNOQ0puk0MVB8EMeotNV_OdxpqZR651rCdGwIJvWdRxcR_KW4A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKy85MEjhvYCh_WHaPatk_MlN8Yfa3xukT8xZMbqKlhAw&oe=6AAEA941"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foesF9cHAk4Q7kNvwG5wLhX&_nc_oc=AdrfyoBdjECDp1_EF8pxmhIeQWtQEqf-efJYeBsz0qHstTHe7KkkbPaOebqYoP27X9k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFGZWpljeZzF1bGg8jOYB0-7NkWoGq5jKblNSTq33WRA&oe=6AAE9A66"}, {"file_name": "1007(1).png", "id": "1605271954215026", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499625160_1605271957548359_1793312081502853557_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_h5Ell4t9pAQ7kNvwGCMbJR&_nc_oc=AdoC6LHHbWlwVeKdz7AgOu6iobLp-cvecm_i03xhIupBmeVDq6f2Tsqk6XDgngac3jw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZBCRSZll9ypd7-aFzqFm5QYWyrXcRnwFDKoS-8TZgmw&oe=6AAE89EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "BECOME A TESTER TO RECEIVE OUR EXCLUSIVE FOUNDER'S BUNDLE\n# Your Dimension Needs You, Guardian.\n\nReality has fractured. Join the Alliance and fight through portals and reclaim worlds consumed by The Apparition. Wield powerful phase weapons, battle interdimensional foes, and restore balance to a shattered multiverse.\n\n# Core Modes\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op**.  \n- **Survival** \u2013 Endless waves on a **Global Leaderboard** for bragging rights and exclusive rewards. \n- **Player Battle** \u2013 Forge custom maps, and compete in PvP\u2014 with friends or online with **Online Matchmaking** {792444113494594}\n\n---\n\n# Play With Friends \n- Fight alongside other Guardians, or battle against them\n---\n\n# Gear Up\n- Deploy K2, throw plasma grenades, or wield experimental tech like the Gladiator Axe.\n{798255319782596}\n---\n# Earn Rewards & Level Up\n- Complete Missions, collect currency, and unlock Guardian Helmets and Weapon Upgrades\n{1612792543035085}\n\n---\n# Join Our community Discord: https://discord.gg/7Urx5f2wsf", "short_description": "Rifts. Apparitions. Synthetics. Your home is the map\u2014and you are its Guardian. Quantum Strike transforms your space into a sci-fi arena with dynamic mixed-reality combat, enhancements, and co-op. Rise through the ranks, upgrade and customize your gear, and join the interdimensional fight. Test your skills in Survival, take on Missions, and battle friends. Private Beta now open (limited seats via our website). Wishlist today to join the first wave."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/qs-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_mo
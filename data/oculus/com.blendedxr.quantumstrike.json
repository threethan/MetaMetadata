//scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBUBrKgc6x8Q7kNvwEUuNAE&_nc_oc=Adl6pm_tK6P3ydPXNieRSFr6IvKkWgNpgq0rKH0V_dldD76EyGEPkfY-DOrYV0R2j5M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwc_wlUhUCfAoGDQVHRQN1hb8q-1x0jJCfxLrocLXk3Ig&oe=69AC0B01"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_iSCxbXjY4Q7kNvwFH6BUF&_nc_oc=AdkeYEOvsOBgz_aMfiwT3mI882jR7ZIerGa0qGq0jnTAYLENbp-LzM5undKcjnuyS1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz2udGKJHQ-Ioe-AQvr-cmnlenavJZt7pxj9RRc8XjLrA&oe=69AC3466"}, {"file_name": "1007(1).png", "id": "1605271954215026", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499625160_1605271957548359_1793312081502853557_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1n49_GBj4hUQ7kNvwHCMvpR&_nc_oc=AdkwqteRf7lMMfbwCmHa7cHSsx5nfespuyQs7AFanMoIWHLZJSrLB4QZn-H5nnPa5j0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyKBsITdc296OGFGH9JS_08khU1dGMlk2PXjgpbf_fdhQ&oe=69AC23EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "BECOME A TESTER TO RECEIVE OUR EXCLUSIVE FOUNDER'S BUNDLE\n# Your Dimension Needs You, Guardian.\n\nReality has fractured. Join the Alliance and fight through portals and reclaim worlds consumed by The Apparition. Wield powerful phase weapons, battle interdimensional foes, and restore balance to a shattered multiverse.\n\n# Core Modes\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op**.  \n- **Survival** \u2013 Endless waves on a **Global Leaderboard** for bragging rights and exclusive rewards. \n- **Player Battle** \u2013 Forge custom maps, and compete in PvP\u2014 with friends or online with **Online Matchmaking** {792444113494594}\n\n---\n\n# Play With Friends \n- Fight alongside other Guardians, or battle against them\n---\n\n# Gear Up\n- Deploy K2, throw plasma grenades, or wield experimental tech like the Gladiator Axe.\n{798255319782596}\n---\n# Earn Rewards & Level Up\n- Complete Missions, collect currency, and unlock Guardian Helmets and Weapon Upgrades\n{1612792543035085}\n\n---\n# Join Our community Discord: https://discord.gg/7Urx5f2wsf", "short_description": "Rifts. Apparitions. Synthetics. Your home is the map\u2014and you are its Guardian. Quantum Strike transforms your space into a sci-fi arena with dynamic mixed-reality combat, enhancements, and co-op. Rise through the ranks, upgrade and customize your gear, and join the interdimensional fight. Test your skills in Survival, take on Missions, and battle friends. Private Beta now open (limited seats via our website). Wishlist today to join the first wave."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/qs-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_m
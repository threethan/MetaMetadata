 "Capture (2).png", "id": "1444188850130136", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1444188853463469_7375342923422000036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waUev1MOnqwQ7kNvwF2fB3Q&_nc_oc=Adk2ifGULegj-gFSghNoxSmRnt99Jz2yY03wMOceP8cT70-4l3a3E2Pcne36l2f23pg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz0aVj1HoN6ofc9cezvvzRFCf2KhUrOIx8-mAQ1TdFJCg&oe=69B9496A"}, {"file_name": "screenshotAmenity (1).png", "id": "2014359539357102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830147_2014359542690435_3520654462865960175_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cbqGMtIZfYQ7kNvwGl86Ju&_nc_oc=AdkJ0uxrVQWdZ0NpPzxhpgRwOx1nqqzWgb3trPAIsyMnfV4RH66X-rFnoqQObjxZBWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWEy-qcG4voSVcPaGa0IpTc74iq6cJZ_ALawLD_Mkz_g&oe=69B94405"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gdk8yTA3zucQ7kNvwFXDiLI&_nc_oc=AdnAQ4e3hcVxVACPyvqRzHJu3k-tLVD2WMOtelr9NaArWKq3-saImQwM86LRteJc94o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy6xtzk6W_E_qZo690uOsAEkPmsSHruTcoZMrAfBkA4Eg&oe=69B93A01"}, {"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTIzE4Gi8fUQ7kNvwFtkung&_nc_oc=AdmovgYjl2gWm3QcxldtlfoB4tY7oWWrV92NYBbv-UVslqRkLk_Kvk-bI-d20yiQa08&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQNBTCCA2m22GtleBGCnKcPqN3iBLx4dQ0Md8TQuNZdQ&oe=69B95DF3"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ua-D92CHVKEQ7kNvwHJicek&_nc_oc=AdlQM5eo19wFKFpZTDqAu1iKphFJDolgR77kTSESdKwqFWbRHZXOs-skbPignJlxdPg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyXN_n4cPGMkZo5APorWDl_3YvsG1MQIMpBvDyafvyDow&oe=69B96366"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QS16;9coverA.png", "id": "801195052747564", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819980_801195056080897_3076448756038429623_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TlSpGvn5z4Q7kNvwEhkv-T&_nc_oc=AdmLUD34LMPCLdI9aE9joRJ5_ZeBhIPnrVEyRi35TC0dusLXvCmoYfAkkwXMfd_TqA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwqkFwU_AWFVz1fAVIEUyzsARroLHiza8KijnaKIrZIYA&oe=69B93EBF"}, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "# **Welcome to the War, Guardian.**\n# PORTAL NOW OPEN (11.15.25)\n\n**Multi-versal genocide is already underway...and its not looking good.**\n\n**The Void** is succeeding in its crusade to erase existence across dimensions\u2014deploying hordes of mutagenic **Apparitions** as their instrument.  \n\nThat's where you come in.\n\nArmed with advanced weapons, and guided by your sarcastically loyal AI companion **K2**, your mission with **The Alliance** is simple: \n\nFight for what\u2019s left \u2014 and take it back\n\n---\n\n# **Core Modes**\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op.**  \n- **Survival** \u2013 Endure endless waves and climb the **Global Leaderboard** for bragging rights and exclusive rewards.  \n- **Player Battle & Versus** \u2013 Forge custom maps and compete in PvP\u2014either with friends or through **Online Matchmaking.** {792444113494594}  \n\n---\n\n# **Play With Friends**\nFight alongside fellow Guardians\u2014or test your skills against them.  \n\n---\n\n# **Gear Up**\nDeploy land mines, throw plasma grenades, or wield experimental tech like the **Gladiator Axe.** with A.V.A - your Advanced Virtual Armory\n{798255319782596}  \n\n---\n\n# **Earn Rewards & Level Up**\nComplete missions to earn currency & XP \u2013 unlock **Guardian Helmets**, upgrade weapons, and expand your arsenal\n{1612792543035085}  \n\n---\n\n# **Join the Community**\nJoin our Discord \u2192https://discord.gg/7Urx5f2wsf", "short_description": "PORTAL NOW OPEN (11.15.25)\nThe invasion has begun. Portals are opening across dimensions as The Void unleashes its army of Apparitions. As a Guardian of The Alliance, you\u2019ll fight back in full Mixed Reality combat\u2014taking cover in your real space and striking alongside friends in co-op or online battles. Upgrade your gear, complete missions, earn rewards, and defend reality itself. It's time to strike back."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/quantum-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24980818294874299"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307935_852269373852177_1523780842524145262_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHqS59o3dJwQ7kNvwHxocEp&_nc_oc=AdlAgXEds_x5IlTKh1fPUb_iF2RBUKNY0DvSdEysU8LEWhP4lgi5MblWsZe0YIWZnKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQ-fM8hCy0_rhKQ71EAL-zOjbneTrkJMrqF2Ha0DP_KQ&oe=69B946A6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Quantum Strike", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1763701200, "lastRevision": {"nodes": [{"id": "24327240396898762", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24327240360232099", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "791121166607484"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "enhanceWeap.png", "id": "25001477832822082", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295542_25001477839488748_7500751628813562997_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ra-EeuqCaxEQ7kNvwGf7KWS&_nc_oc=Adll0XwnVQx3L4ouV_3m0PD3u0Hy6_XQA-GI_1vxOdDdPo6SnTZ0QFlLphuXFTL98mM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfztblJN0Ac_b-RCcvM72bY_HbL-JTXdHsZP_4c38h4TIQ&oe=69B940BE"}, {"file_name": "AvaStoreWBackground2.png", "id": "1863243054583048", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620432_1863243057916381_9210075728327547340_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q22F06WN9Y8Q7kNvwGw
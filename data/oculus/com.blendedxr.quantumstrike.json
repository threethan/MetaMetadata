.png", "id": "939484898381397", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824216_939484901714730_8157414902503280186_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQ41SM51B6EQ7kNvwEjxRNQ&_nc_oc=AdpKsm_91kI8L_VdoU8XGD3fJ0JpCd_XIsQEnL7MJd9S2XBI3P_gAxBEg8tBtzwIFes&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdqLqY0M4K0WRYDN6-UTDTsuA9wE-7VF0BU3cEoXfF4w&oe=6AF877B9"}, {"file_name": "k2 storesquare.png", "id": "835463346312695", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618271_835463349646028_8786418211315180381_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obdWZm-KpQoQ7kNvwFq47MJ&_nc_oc=AdrBGACQnBuFLRaYSuDsmZ08ANJ5v1J0UjOFDqvoOT0O-0tPnG8FWPSSfX1UFlVgJt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQJeyUsu88UmF_UljLHQmL_lVvYpQnUqRdZX2YzI6N5Q&oe=6AF887BC"}]}, "id": "641864095259553", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62bvWuwQyHoQ7kNvwEaavQR&_nc_oc=AdpoIb87A37dlTiIpDsK8DrTUCI6s5bT3_5qrkAfYo4GYJV7D6_X4pEpj5l876vwB_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQklAyQT-sb_MrEh8-3DgKVEIJDFRHSF5gyP5O-J-f9gA&oe=6AF8A133"}, {"file_name": "Capture (2).png", "id": "1444188850130136", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830599_1444188853463469_7375342923422000036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCaUFqczqdUQ7kNvwHnFInU&_nc_oc=Adr-t4D1XUnFXuZnDoACZv_XaValuuQnzkGwn9-vMiFLGCZZN3J5_4oF4JWMMudiLIQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaSnejE7VQhTt6o1rMv6DUjZXG0ikYyixdVVExljTNqw&oe=6AF88CAA"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biSR9fl34goQ7kNvwFOpCUH&_nc_oc=AdpcgG08ljuR6OH0yeLh1YMraEFIqMK1R8w1Frk-RW7njN0Ns8ipeJbJorMSzJDVtxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTC7t3UP5TfKCztfet9ykard1d6dkCEZFnWWLfAOJfGrg&oe=6AF87D41"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jD8jUSc5eMQ7kNvwHSFDzX&_nc_oc=AdrlKlKME94HsFBvknuFZ7_fxWhc6Qrec52E6FRY5fgoSBs6gQFoSx5XbuVYaHDqM04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNYDy9VoQ7UkPmBwJ0_rD8zwKdxN5Hz1B1ilOXuvZECw&oe=6AF8A6A6"}, {"file_name": "1007(1).png", "id": "1605271954215026", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499625160_1605271957548359_1793312081502853557_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rO0U2zI1O0Q7kNvwFUZJMP&_nc_oc=AdoyQdkF6avGAXk4t5LtIRRM_pfRtT4tQfHo5dh1T7euhtGKx5oQn9hz6fuaBWiVP1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZTLK2jLJjlXb4Ol9N-7xZXlcZpn5MWulqlru0cc1Vhg&oe=6AF8962F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "BECOME A TESTER TO RECEIVE OUR EXCLUSIVE FOUNDER'S BUNDLE\n# Your Dimension Needs You, Guardian.\n\nReality has fractured. Join the Alliance and fight through portals and reclaim worlds consumed by The Apparition. Wield powerful phase weapons, battle interdimensional foes, and restore balance to a shattered multiverse.\n\n# Core Modes\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op**.  \n- **Survival** \u2013 Endless waves on a **Global Leaderboard** for bragging rights and exclusive rewards. \n- **Player Battle** \u2013 Forge custom maps, and compete in PvP\u2014 with friends or online with **Online Matchmaking** {792444113494594}\n\n---\n\n# Play With Friends \n- Fight alongside other Guardians, or battle against them\n---\n\n# Gear Up\n- Deploy K2, throw plasma grenades, or wield experimental tech like the Gladiator Axe.\n{798255319782596}\n---\n# Earn Rewards & Level Up\n- Complete Missions, collect currency, and unlock Guardian Helmets and Weapon Upgrades\n{1612792543035085}\n\n---\n# Join Our community Discord: https://discord.gg/7Urx5f2wsf", "short_description": "Rifts. Apparitions. Synthetics. Your home is the map\u2014and you are its Guardian. Quantum Strike transforms your space into a sci-fi arena with dynamic mixed-reality combat, enhancements, and co-op. Rise through the ranks, upgrade and customize your gear, and join the interdimensional fight. Test your skills in Survival, take on Missions, and battle friends. Private Beta now open (limited seats via our website). Wishlist today to join the first wave."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/qs-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"]
.png", "id": "939484898381397", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824216_939484901714730_8157414902503280186_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-CC6e9YH-0Q7kNvwEEp7Q7&_nc_oc=AdoQS24rDTfBtvHwSLywva1smiYMFXp5LDLF6v2XulVrb8WW9b2idTyiSA0Pt9od-Ko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE06rpJ1LGnUXr_EhEM754GPQPqi4AdIfbT813MKnPW4Q&oe=6A7EF579"}, {"file_name": "k2 storesquare.png", "id": "835463346312695", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618271_835463349646028_8786418211315180381_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzR1cV9qVGEQ7kNvwEN5AYa&_nc_oc=AdpJw0oIXt6TXhRCO0ci95HP6yfxyDJr75FRab0rnMoXpjvZXsOM5CtQswLtAziop8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb3Fah148z8P4AH0K9dyy57QzA382zsYhHOP2eUsk8UA&oe=6A7F057C"}]}, "id": "641864095259553", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9v9zBIFqGwQ7kNvwGnmnhN&_nc_oc=AdoMZ4HLMxPb66ypYzo0cEU02yw6AVP2iVGXmX-pTNN8r6L7_jm9iudKQDEUjDhm9dA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7vPPr3Z8UjqcEnpcoNBU2CtFwUI0RrXhlyqdtQ1wpsA&oe=6A7F1EF3"}, {"file_name": "Capture (2).png", "id": "1444188850130136", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830599_1444188853463469_7375342923422000036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39JdsWQnyogQ7kNvwHzjevO&_nc_oc=AdpNpHkoDQ9cr27yi8POPMRbhgzLAJ1ErGoG4IFTTDSYs6R-EtZ8h1m5HmOOvBtO_PA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK4odxbBoDdBuXYWaeECWk_1EUQjb31Ecu8C4b_ggtAg&oe=6A7F0A6A"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2SQJu7F7e4Q7kNvwFyADPz&_nc_oc=AdpkNGwKckwg6WZSTnlw4zWEnPR3lM7u3bUhEzRyRKYFu_E5VhTDbXKn81sT_O3VigQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgW2kfR8D1U-Bs5Zbkiyp_wFTA4nJDREW8dIkohGtaJg&oe=6A7EFB01"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWW5YWH7OhYQ7kNvwF-ecjz&_nc_oc=Adr4Ph8yp7Qx5qN9o25N4XfT50uB1UlXFVJJ1-DIInuxmWPl92fBeI_Ys0RLY-1PPYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX2hVNTzebQZ2ESlrG1UJzNw5pvQ_G5uGyrw61uU_p2w&oe=6A7EEC26"}, {"file_name": "1007(1).png", "id": "1605271954215026", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499625160_1605271957548359_1793312081502853557_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrhSZOK-bJcQ7kNvwFkf61y&_nc_oc=AdpL1rvybokz5CC6XQ34cBcaY4CeqYkcHw8oRjW3Zs4gHRvAQArsePkRaLRQyvFxWuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeRgBjEKL0VqfKFpy688yF2RAOPEMke7rVRYP9O8IdVQ&oe=6A7F13EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "BECOME A TESTER TO RECEIVE OUR EXCLUSIVE FOUNDER'S BUNDLE\n# Your Dimension Needs You, Guardian.\n\nReality has fractured. Join the Alliance and fight through portals and reclaim worlds consumed by The Apparition. Wield powerful phase weapons, battle interdimensional foes, and restore balance to a shattered multiverse.\n\n# Core Modes\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op**.  \n- **Survival** \u2013 Endless waves on a **Global Leaderboard** for bragging rights and exclusive rewards. \n- **Player Battle** \u2013 Forge custom maps, and compete in PvP\u2014 with friends or online with **Online Matchmaking** {792444113494594}\n\n---\n\n# Play With Friends \n- Fight alongside other Guardians, or battle against them\n---\n\n# Gear Up\n- Deploy K2, throw plasma grenades, or wield experimental tech like the Gladiator Axe.\n{798255319782596}\n---\n# Earn Rewards & Level Up\n- Complete Missions, collect currency, and unlock Guardian Helmets and Weapon Upgrades\n{1612792543035085}\n\n---\n# Join Our community Discord: https://discord.gg/7Urx5f2wsf", "short_description": "Rifts. Apparitions. Synthetics. Your home is the map\u2014and you are its Guardian. Quantum Strike transforms your space into a sci-fi arena with dynamic mixed-reality combat, enhancements, and co-op. Rise through the ranks, upgrade and customize your gear, and join the interdimensional fight. Test your skills in Survival, take on Missions, and battle friends. Private Beta now open (limited seats via our website). Wishlist today to join the first wave."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/qs-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"]
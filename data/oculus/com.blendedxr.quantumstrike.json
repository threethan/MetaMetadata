=699DB3E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "QS16;9coverA.png", "id": "801195052747564", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819980_801195056080897_3076448756038429623_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p60qgqTMqycQ7kNvwGUjdP1&_nc_oc=Adl61_xgmY-x3yeV0YCe0La8cfTGOOfIzP_9a0malZ-R-O9xYP3WdDyS4MQZJ9_Hk5U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvCU9oQjagTHeHFN1dzJ1nvMbBUByzFpu1aQ9LM3vjMZw&oe=699D8F3F"}, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "# **Welcome to the War, Guardian.**\n# PORTAL NOW OPEN (11.15.25)\n\n**Multi-versal genocide is already underway...and its not looking good.**\n\n**The Void** is succeeding in its crusade to erase existence across dimensions\u2014deploying hordes of mutagenic **Apparitions** as their instrument.  \n\nThat's where you come in.\n\nArmed with advanced weapons, and guided by your sarcastically loyal AI companion **K2**, your mission with **The Alliance** is simple: \n\nFight for what\u2019s left \u2014 and take it back\n\n---\n\n# **Core Modes**\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op.**  \n- **Survival** \u2013 Endure endless waves and climb the **Global Leaderboard** for bragging rights and exclusive rewards.  \n- **Player Battle & Versus** \u2013 Forge custom maps and compete in PvP\u2014either with friends or through **Online Matchmaking.** {792444113494594}  \n\n---\n\n# **Play With Friends**\nFight alongside fellow Guardians\u2014or test your skills against them.  \n\n---\n\n# **Gear Up**\nDeploy land mines, throw plasma grenades, or wield experimental tech like the **Gladiator Axe.** with A.V.A - your Advanced Virtual Armory\n{798255319782596}  \n\n---\n\n# **Earn Rewards & Level Up**\nComplete missions to earn currency & XP \u2013 unlock **Guardian Helmets**, upgrade weapons, and expand your arsenal\n{1612792543035085}  \n\n---\n\n# **Join the Community**\nJoin our Discord \u2192https://discord.gg/7Urx5f2wsf", "short_description": "PORTAL NOW OPEN (11.15.25)\nThe invasion has begun. Portals are opening across dimensions as The Void unleashes its army of Apparitions. As a Guardian of The Alliance, you\u2019ll fight back in full Mixed Reality combat\u2014taking cover in your real space and striking alongside friends in co-op or online battles. Upgrade your gear, complete missions, earn rewards, and defend reality itself. It's time to strike back."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/quantum-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24980818294874299"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307935_852269373852177_1523780842524145262_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1IIKQEGZ3wQ7kNvwFCM8ra&_nc_oc=AdndmE8w2VAh1CH055QaZ0-wKnWI_Ha3s9uv-qhg94W6qhdurOQiz5_TeJ
.png", "id": "939484898381397", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824216_939484901714730_8157414902503280186_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJxEhM0eVhAQ7kNvwGDXA90&_nc_oc=Adqr7ukMjPcNaYEmryeJXVaqFowlzkrBI3VNVNTyRuq6vbs7F6Vl9SJNwew-i3oF26I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMckdvn1ngIHpqqDRnOYKx2GnewbVQeimyaFstR1ilufA&oe=6AE20E39"}, {"file_name": "k2 storesquare.png", "id": "835463346312695", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618271_835463349646028_8786418211315180381_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el5T19OrR5MQ7kNvwFLzVLe&_nc_oc=AdqOhu3EF_eDZIRI_NtqV-VtIieesWbzx23WK1OdUn9Ek0Qo7GoTRcLkxNzqcr51xf4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfyZtMB-uMjvVE48ZsMiCDncGHwKHmz7pci2WQhBNMSA&oe=6AE1E5FC"}]}, "id": "641864095259553", "locale": "en_US", "screenshots": [{"file_name": "Screenshot 2025-10-03 at 2.16.11\u202fAM.png", "id": "2643275906013245", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303769_2643275909346578_8285521432771330416_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5yNTMzp8bUQ7kNvwEo6Aon&_nc_oc=AdopEx7LVu-oLkqmh6Wzrq6vDa9W1GhnnnMIL8GlH8lTTDTmjAF4yCJX5RoL2g_77tQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW5FF3OqdRBD_PPO4AvnX0yWAMtgvFSkDDl3_argpCCQ&oe=6AE1FF73"}, {"file_name": "Capture (2).png", "id": "1444188850130136", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830599_1444188853463469_7375342923422000036_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIuL8u-SqeEQ7kNvwG5x4iA&_nc_oc=Adqo1mX4yOc72DH9_T6nDAt_INlYCFUABpI9kPkteI9DO89O7WaC34dOr8IUQphVZ7w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWMrXYzNy_6qgq1qM6OrPR9DKLYFecBEClx5spovEfjg&oe=6AE1EAEA"}, {"file_name": "1007(4).png", "id": "823483006875363", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499297224_823483013542029_4542305503744939917_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqeoLj_6dL4Q7kNvwELJxoF&_nc_oc=Ado8dJZpP09vwawOeTHBLJzkJbfh2uzdRjIOtOjBwvw-xhojtFbH2siFSKxVJ3Bu8zI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK0jG9UV5mPJAKJPD5WJmb_UVucUbMlhPzWhR3ZqAvOA&oe=6AE213C1"}, {"file_name": "kb (1).png", "id": "24366187793045307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830027_24366187799711973_4164696915924467988_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI9juSLRUrkQ7kNvwE-2Ll7&_nc_oc=AdobBi6GeCBdOuE3Mc3Uuoa0Mu88UDHF4uZEaUUjpWtezy5p0sizZXsFFJiwsFtjVq0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU_d4dH3vK4m-cdnO7pOp8BNyC99MImopIyJTRD8kpPQ&oe=6AE204E6"}, {"file_name": "1007(1).png", "id": "1605271954215026", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499625160_1605271957548359_1793312081502853557_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wuHgzla8iM0Q7kNvwGu303B&_nc_oc=Adr3EbjhEoABAKBX4IPuyuv4yJHrRTouW77Ij0FXCmMLoJWh6L4brnkZ42Mb_4eqdz0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7htiATAID19YVx3c0rGWh44E19T8tkkevCMLphZ9obA&oe=6AE1F46F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Quantum Strike", "keywords": ["coop", "quantum", "mixed", "multiplayer", "scifi"], "long_description": "BECOME A TESTER TO RECEIVE OUR EXCLUSIVE FOUNDER'S BUNDLE\n# Your Dimension Needs You, Guardian.\n\nReality has fractured. Join the Alliance and fight through portals and reclaim worlds consumed by The Apparition. Wield powerful phase weapons, battle interdimensional foes, and restore balance to a shattered multiverse.\n\n# Core Modes\n{1488139402427954}\n- **Missions** \u2013 Complete objectives to level up, earn currency, unlock loadouts, and uncover more of the story. **Solo or Co-Op**.  \n- **Survival** \u2013 Endless waves on a **Global Leaderboard** for bragging rights and exclusive rewards. \n- **Player Battle** \u2013 Forge custom maps, and compete in PvP\u2014 with friends or online with **Online Matchmaking** {792444113494594}\n\n---\n\n# Play With Friends \n- Fight alongside other Guardians, or battle against them\n---\n\n# Gear Up\n- Deploy K2, throw plasma grenades, or wield experimental tech like the Gladiator Axe.\n{798255319782596}\n---\n# Earn Rewards & Level Up\n- Complete Missions, collect currency, and unlock Guardian Helmets and Weapon Upgrades\n{1612792543035085}\n\n---\n# Join Our community Discord: https://discord.gg/7Urx5f2wsf", "short_description": "Rifts. Apparitions. Synthetics. Your home is the map\u2014and you are its Guardian. Quantum Strike transforms your space into a sci-fi arena with dynamic mixed-reality combat, enhancements, and co-op. Rise through the ranks, upgrade and customize your gear, and join the interdimensional fight. Test your skills in Survival, take on Missions, and battle friends. Private Beta now open (limited seats via our website). Wishlist today to join the first wave."}]}, "developer_name": "Blended XR", "developer_privacy_policy_url": "https://blendedxr.com/qs-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Blended XR", "support_website_url": "https://discord.gg/ZdCS25Pxtq", "website_url": "https://blendedxr.com/quantum-strike", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"]
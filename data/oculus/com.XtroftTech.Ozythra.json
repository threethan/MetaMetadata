d": "756846256919953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_756846260253286_2667587212092208172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVJqaERu3fAQ7kNvwGer9vR&_nc_oc=Adk9MXs1Xg5lFhLVWIIGpTdMzcAw2qnnlKSeNpCG8d1HYmi3Kpe0BSnXs62E4Vp34uY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDfGDGlsorKoSDyNw7-aGeYuCplte9vdheyJMOq9Hdcw&oe=69999277"}, {"file_name": "Sshot5.png", "id": "1551408359285017", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823878_1551408362618350_7101349989365794900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfUBwPCmOYwQ7kNvwHR9y7F&_nc_oc=AdkdXkle1KxJCOQZdGV7kvlksItnAnbgXBJbEW7jDHcI_jMc4aJ8iUkFXJKp9Hwl6rM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuGV0VSTrXjKSrAD5C5tfbsydv6E48RGJ3M2-_bQ-qI8Q&oe=699997C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OzythraCoverImage.png", "id": "889923820087748", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821230_889923823421081_733930062851386398_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykYMUXUMeawQ7kNvwGvboZa&_nc_oc=Adm8B98pOQYZfd7kg2Rdlr8G10TyR5yR80uKm9tc5eUlUOY9MrsbgJF2ahl_-tafIZ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvaxClMVD77rO-8vXYsWPh43m90HnYWV-JO4sDHTE_JWg&oe=6999AA9F"}, "display_name": "Ozythra", "keywords": ["mixedreality", "storytelling", "nature", "scifi", "ozythra"], "long_description": "Ozythra is a cinematic mixed-reality storytelling experience designed for calm exploration and wonder. It blends nature-inspired visuals with subtle science-fiction elements to create living narratives that unfold directly in your physical environment.\n\nEach experience in Ozythra is crafted as a self-contained story, with more stories and worlds planned over time. The focus is on mood, presence, and emotional resonance\u2014designed to feel cinematic, poetic, and immersive.\n\nKey Features:\n1) Mixed-reality storytelling that blends seamlessly with your real environment.\n2) Hands-only interaction using natural gestures.\n3) Calm, cinematic visuals and sound design.\n4) Narrative-driven experiences focused on atmosphere and meaning.\n5) Designed for relaxed, mindful exploration\n\nUse in a safe, clear space and remain aware of your surroundings. Ozythra is best experienced at your own pace, allowing the story to unfold naturally around you.", "short_description": "Ozythra is a mixed-reality storytelling experience where nature and science gently intertwine. Explore poetic, hands-only interactions that unfold living stories in your real space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xtrofttech.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Xtroft Tech Limited", "support_website_url": null, "website_url": "https://www.xtrofttech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24536815022666863"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1587188245520165"}]}, "baseline_offer": {"id": "1587188245520165"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769147160, "status": "PUBLISHED", "id": "1587188245520165"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25174710145544011", "version": "0.1.3"}, "id": "1219208070240119", "cha
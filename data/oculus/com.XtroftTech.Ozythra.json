d": "756846256919953", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_756846260253286_2667587212092208172_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVJqaERu3fAQ7kNvwGPiRtk&_nc_oc=AdkSrxF9N0GEIT_CpAMeEYv-I8QyQXNHUJ6HLmin7xNUmQH_y2sGp8CeVSSkylZHkOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftcCX7WMzy6KLlkyUNIjoURfssCVBiggNO99ftsmAREOw&oe=699840F7"}, {"file_name": "Sshot5.png", "id": "1551408359285017", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823878_1551408362618350_7101349989365794900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hNBFc-RnTgQ7kNvwFXlB3H&_nc_oc=AdnZvUgQl1vP4O3Bnk1uywNiDVzqjnxhCCBTwuViepuSbB3qPRcIoGpWzsxqPA1fVyc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvupTaV9J4HDiBTVqn3WEltJ1vR9NhgJlBalTQhQHCdBA&oe=69984641"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OzythraCoverImage.png", "id": "889923820087748", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821230_889923823421081_733930062851386398_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykYMUXUMeawQ7kNvwHFb02l&_nc_oc=AdlT0NHrpWfoDFZfYCiaxMNppeobkqwF8U2WXa9TAmUbtrmn6iAcN4GVsLJSGIF5kww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afus53idZKTQgEVjb1Kzh8L7LDKLGKZtB8YquJHElh27dw&oe=6998591F"}, "display_name": "Ozythra", "keywords": ["mixedreality", "storytelling", "nature", "scifi", "ozythra"], "long_description": "Ozythra is a cinematic mixed-reality storytelling experience designed for calm exploration and wonder. It blends nature-inspired visuals with subtle science-fiction elements to create living narratives that unfold directly in your physical environment.\n\nEach experience in Ozythra is crafted as a self-contained story, with more stories and worlds planned over time. The focus is on mood, presence, and emotional resonance\u2014designed to feel cinematic, poetic, and immersive.\n\nKey Features:\n1) Mixed-reality storytelling that blends seamlessly with your real environment.\n2) Hands-only interaction using natural gestures.\n3) Calm, cinematic visuals and sound design.\n4) Narrative-driven experiences focused on atmosphere and meaning.\n5) Designed for relaxed, mindful exploration\n\nUse in a safe, clear space and remain aware of your surroundings. Ozythra is best experienced at your own pace, allowing the story to unfold naturally around you.", "short_description": "Ozythra is a mixed-reality storytelling experience where nature and science gently intertwine. Explore poetic, hands-only interactions that unfold living stories in your real space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xtrofttech.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Xtroft Tech Limited", "support_website_url": null, "website_url": "https://www.xtrofttech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24536815022666863"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1587188245520165"}]}, "baseline_offer": {"id": "1587188245520165"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769147160, "status": "PUBLISHED", "id": "1587188245520165"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25174710145544011", "version": "0.1.3"}, "id": "1219208070240119", "cha
d5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyc5uzM6IabZgDcwYJcOcbRUM94m41-XWATmCJ9jZaWeg&oe=69B7E4F7"}, {"file_name": "Sshot5.png", "id": "1551408359285017", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823878_1551408362618350_7101349989365794900_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwiIDoVJ4CUQ7kNvwG-vxOk&_nc_oc=AdkfiL41VU8TB7PeA1heSDmXvLwlJtgWSay7QxLk5ElmFlSpBZMsbTs8aXAgYD7oNXs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwkQlVa1W2MRHDjvEaCb4nhJ4K1kMovyL6xA3kUbDgKMw&oe=69B7EA41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "OzythraCoverImage.png", "id": "889923820087748", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821230_889923823421081_733930062851386398_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUv3JyXJ0gkQ7kNvwHXb-Xr&_nc_oc=AdnPOHeHOlqhLp5RY9VkDuZCz7WkGU04lbY9bHfM54Ep29xEM8RmJC-d5Z9HDf0jbOk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPAvYF_gQAqR_vHimiZ0YASg9AZBSa9UHHa6VjIMg9ZQ&oe=69B7FD1F"}, "display_name": "Ozythra", "keywords": ["mixedreality", "storytelling", "nature", "scifi", "ozythra"], "long_description": "Ozythra is a cinematic mixed-reality storytelling experience designed for calm exploration and wonder. It blends nature-inspired visuals with subtle science-fiction elements to create living narratives that unfold directly in your physical environment.\n\nEach experience in Ozythra is crafted as a self-contained story, with more stories and worlds planned over time. The focus is on mood, presence, and emotional resonance\u2014designed to feel cinematic, poetic, and immersive.\n\nKey Features:\n1) Mixed-reality storytelling that blends seamlessly with your real environment.\n2) Hands-only interaction using natural gestures.\n3) Calm, cinematic visuals and sound design.\n4) Narrative-driven experiences focused on atmosphere and meaning.\n5) Designed for relaxed, mindful exploration\n\nUse in a safe, clear space and remain aware of your surroundings. Ozythra is best experienced at your own pace, allowing the story to unfold naturally around you.", "short_description": "Ozythra is a mixed-reality storytelling experience where nature and science gently intertwine. Explore poetic, hands-only interactions that unfold living stories in your real space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xtrofttech.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Xtroft Tech Limited", "support_website_url": null, "website_url": "https://www.xtrofttech.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24536815022666863"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620921_2146185119544113_7236427127716095593_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KmUTFx3r57YQ7kNvwGq-T4q&_nc_oc=AdkpgnLMe75AT0toYTGY-2quPpAAp7-OSKRarriaJDu1V7xzdhLacewzUno1sIi-HYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwFbZHwIULjLqoWMBKOXEwVQACxqOEXVKzzj8R3Fmy9uw&oe=69B7EB3B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ozythra", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1769147160, "la
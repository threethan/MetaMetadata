&oe=69AABC99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vision Board VR", "keywords": ["Visionboard", "Meditation", "Happiness", "Goals", "Mindfulness"], "long_description": "What do you really want in life?\n\nDid you know that your thoughts cause your emotions which form your beliefs?\n\nIn Vision Board VR, you will be able to create your own Vision Board, a collage of pictures, words and quotes that serve to remind you of your goals and purpose in life, and represents whatever you want to be, do or have.\n\nAs a result of creating your own Vision Board you will start to connect positive emotions with these visualisations. These emotions will lead to beliefs and these beliefs will manifest into your reality.", "short_description": "In Vision Board VR, you will be able to create your own Vision Board, a collage of pictures, words and quotes that serve to remind you of your goals and purpose in life, and represents whatever you want to be, do or have.\n\nAs a result of creating your own Vision Board you will start to connect positive emotions with these visualisations. These emotions will lead to beliefs and these beliefs will manifest into your reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.visionboardvr.com/", "developer_terms_of_service_url": "http://www.visionboardvr.com/privacy", "publisher_name": "http://www.visionboardvr.com/", "support_website_url": null, "website_url": "http://www.visionboardvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PRODUCTIVITY", "EDUCATIONAL", "ADVENTURE", "EXPLORATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "
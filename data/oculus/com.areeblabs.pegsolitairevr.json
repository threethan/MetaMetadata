5771-25/491823757_2278140909650214_9088421938265119901_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TaNOiz0EvTYQ7kNvwHELReZ&_nc_oc=AdpXxGS8jzYRj6Td6lwely3S5I_N8bOCm4w7NJQ5ZrALKjRVws3x8wPwR89mguBoOfU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNQM8TLn7LhHlIjxC068X4roCLw27-SBI5sB2lTh0pMw&oe=6AF5F2E1"}, {"file_name": "04-classic.png", "id": "28154467254175476", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827987_28154467274175474_7114578236622841868_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpK5cWu4PwgQ7kNvwGZPaJ5&_nc_oc=Adr9NT1BwCAg4l2gjCjQStop2mWfKVqNhX7wESK-eHFeNMSfl1L0ghN1D80zyShgR6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkE9XTRrWuwIOxTZ2_hgtliHrl0nR3SoA3QMiXmjtAPA&oe=6AF5EBB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peg Solitaire VR", "keywords": ["pegsolitaire", "marblesolitaire", "solonoble", "tabletop", "puzzle"], "long_description": "Peg solitaire, at your own pace.\n\nPoint at a peg, choose an empty hole, and jump over its neighbor. Each jump removes a peg. Your goal is to leave exactly one peg in the marked center of the classic 33-hole board.\n\nStart with two guided lessons, including a chance to practice Undo. Then choose from 24 challenges, all available from the start, or play Classic with 32 pegs and an empty center.\n\nTry another approach with Undo and Restart. Return to your active puzzle with local saves, and keep completion marks for the boards you solve.\n\nAdjust board size and height, recenter the tabletop, and set sound and haptics to suit you. Play seated or standing using either Touch controller to point and click.\n\nOne purchase includes both lessons, all 24 challenges, and Classic. Single-player, with English text.", "short_description": "Play peg solitaire at a quiet virtual tabletop. Jump pegs and leave one in the marked center. Learn with two guided boards, solve 24 challenges, or take on the full Classic board. Includes undo, board size and height settings, and local progress saves."}]}, "developer_name": null, "developer_privacy_policy_url": "https://areeblabs.com/peg-solitaire-vr/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Areeb Labs", "support_website_url": "https://areeblabs.com/support/#peg-solitaire-vr", "website_url": "https://areeblabs.com/peg-solitaire-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1306238605907024"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_2604199950016560_2962895027950704888_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4JVd0wv4DAQ7kNvwEI0vcw&_nc_oc=AdorlNuLwoA6TQrcKY-4JUiSIniU7256x5OJ6oEsvTJWDDJ-6dqa2zFrSNCU68DeQVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp2fYLctLIn64Jo4gq0PDcLdwMDVG1SfRPQQmVisXOJw&oe=6AF5C11C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Peg Solitaire VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Tabletop", "id": "1676485315806614"}], "release_date": 1789690920, "lastRevision": {"nodes": [{"id": "1306238612573690", "release_type": "SCHEDULED", "
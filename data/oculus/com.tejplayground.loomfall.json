wkpi7jeP7mdG00bz5fhg&oe=6AF8748E"}, {"file_name": "screenshot_02_hive_2560x1440.png", "id": "1653004713052071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1653004723052070_2417575926186223081_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5SAjWrVR8UQ7kNvwEDo4Nx&_nc_oc=Adok7ryrcE8biPrjuW-PvLvnqizQ0_Jz47kIzgeG4OrNe_50c7M-5_daLvT3SsMo3sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrBnpDD1_6_pUBpnKn7ps1MEuOPr764sz9b7Uht26Lng&oe=6AF89A1A"}, {"file_name": "screenshot_03_ruins_2560x1440.png", "id": "1609002407380959", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1609002410714292_6363361054352831559_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N3e1aYVUUyYQ7kNvwFgfIO2&_nc_oc=AdoSgwrdcRgz0M1kLJy4eAhV1aFwI8hH0tnOl4cpOYER6aj_YYH7aOVfquvKlyQ-cTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaFzn5KsYMU7QUp1W4mRpnSaHmJWugy0ZtVhbqA2NtuA&oe=6AF874B5"}, {"file_name": "screenshot_04_lair_2560x1440.png", "id": "2348050812399559", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824741_2348050815732892_1741298461632706129_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFUXH57Wo4sQ7kNvwHkBwTr&_nc_oc=Ado0tUmDqWTFqiW_451_mgRlHny3wEn-NLrkpjxuK1qJYipL421KGzdXWkTLgHOH6-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQXuRqKvIKBu4qGuiWEPvy6imD7SDeMcb-kUEa27NSBQ&oe=6AF8A3AB"}, {"file_name": "screenshot_05_web_vista_2560x1440.png", "id": "1445025857528571", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_1445025860861904_5882622466926515709_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5cle-P0Sm8AQ7kNvwFrle7Q&_nc_oc=Adq34Nxj4N9_E6sdCygBViTDr4JzC1dcj3nX-ok2A1NL5EkqxZdd2CTAS3Xztdwc8xU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpKuccKPI5YqO4v726o6MpIxvfEapGbjXj4XfbUYgjkw&oe=6AF8A516"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Loomfall", "keywords": ["boxing", "punch", "fitness", "arcade", "passthrough"], "long_description": "Something is weaving a web through reality, and your room is the first thing it catches.\n\nPUNCH YOUR WAY OUT\nNo buttons, no guns: your fists are the weapon. Punch attackers as they fly at you, knock their glowing shots out of the air, lean out of the way, duck under energy walls and clap to clear everything around you once per wave. A fast, straight punch counts; a soft touch does nothing.\n\nYOUR ROOM FIRST\nThe run starts in mixed reality. Portals tear through your real walls, the Weaver watches you through them, and giant insects crawl out into your space. Survive and the room shatters around you.\n\nFOUR WORLDS, ONE STORY\nFight on the web through the Neon City, the Hive, the burning Ruins and finally the Weaver's Lair. Each world has its own creatures, music and sky, and the Weaver comes closer every time. Hold the web through the last wave to see it fall, and close the breaches in your room for good.\n\nBUILT FOR VR\n- Attacks from all sides, with red warnings for the ones you cannot see\n- Hand tracking or Touch controllers\n- Seated or standing; seated play keeps attacks in front of you\n- Combos that unlock powers: Power Fists, Second Wind, Shockwave\n- Story, Easy, Normal and Hard; a crown for beating each\n- Win to unlock Endless mode, with its own best scores\n- No locomotion, fully offline\n\nLoomfall is a short, intense arcade workout made for Quest 3 and Quest 3S.", "short_description": "Glowing portals tear open in your real walls, and the things behind them come for you. Punch giant bees, hornets and roaches out of the air, knock their shots away, lean and duck as they strike from every side. Then your room shatters and you stand at the heart of a colossal web, drawn deeper into the Weaver's world with every wave."}]}, "developer_name": null, "developer_privacy_policy_url": "https://loomfall.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "TEJ Playground", "support_web
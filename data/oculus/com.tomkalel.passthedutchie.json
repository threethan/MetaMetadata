uluscdn.com&_nc_ss=7f20f&oh=00_AQTMQC1CKLTUG8lvAJ-OruPH6qvvvG4KFsHmQ5RpFZdK7w&oe=6B084CFD"}, {"file_name": "05-the-basement.png", "id": "1377562304223093", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/654944867_1377562307556426_9113969691430045330_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfEmLi7rLdQQ7kNvwHqeR8o&_nc_oc=Adp2bC2n9tS4eqmgqR7uuBodqfYJx1Ic41laK76sgC6N0Ylkh4rJublTOtL8fXJ50I4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQytNf9bmSwjtQoPkVV-N5uX8ulHKvIBhuGlqHH1jqWUA&oe=6B085D17"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pass The Dutchie", "keywords": ["social", "hangout", "cards", "party", "multiplayer"], "long_description": "Pass The Dutchie is a social VR hangout for groups, clans and competitive teams. Kick back with your crew in a 90s basement, then head down to the bunker to plan your next comp match together.\n\nHANG OUT\n- Up to 20 players in a room, with voice chat that stays in the room you're in\n- Join the public basement or make your own server: public, or private with a 4-digit join code for your group only\n- Two card tables with a full deck, chips, an UNO-style deck and a dealer screen with 25 games and their rules\n- A bar with four beer taps, real pouring, bottles and shots\n- Darts with a 301 scoreboard, foam dart blasters and a boombox with radio stations\n- A tube TV with a retro console, four controllers and parody racing, pod racing and shooter games\n- A movie projector with public-domain and open films\n\nPLAN YOUR MATCHES\n- A code-locked strategy bunker with armoured doors and 20 seats, with its own voice chat away from the party upstairs\n- Map layouts on the projector screen, a laser pointer and a neon pen to draw routes and calls\n- A chalkboard that keeps your plans saved for next time, and a host who controls the door code\n\nComfort: snap or smooth turning, comfort options, block and report tools.\n\nMature content: depicts cannabis and alcohol use, crude humour, cartoon violence and gore.\n\nRadio music by Kevin MacLeod (incompetech.com), licensed under Creative Commons: By Attribution 4.0 (CC BY 4.0).", "short_description": "A 90s basement for your group to hang out in, and a code-locked bunker where competitive teams plan strategy for their matches. Up to 20 players: cards, beer, darts, a retro console and plenty to pass around."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/passthedutchie", "developer_terms_of_service_url": null, "publisher_name": "Tired Wizard Productions LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/passthedutchie", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1700921480735423"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1444720195390229"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1801425117813195"}]}, "baseline_offer": {"id": "1801425117813195"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793735520, "status": "PUBLISHED", "id": "1801425117813195"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1503436866185228", "version": "1.0.10"}, "id": "1499403745570823", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binar
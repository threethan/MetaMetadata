ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/761640323_2024614975143603_3672836705403899497_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tj1uAK9UjlAQ7kNvwEixYOj&_nc_oc=AdqdrZn3yjdQKYumkW2r3VCkreXC6ZMMoPdepl-V3vSQGGCNDnjRaO0J5rNx5CMepXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcMZCdFFPQGXlsDmDOQ1Dse_yns_Ic5G9S4CTdl--V7A&oe=6B0DB921"}, {"file_name": "Screenshot 2026-11-04 at 7.01.png", "id": "1670604144429999", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/836569829_1670604147763332_880510084040674169_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJ6G8gFgRUIQ7kNvwHlylJi&_nc_oc=Adr16PC9KWjZTB0B-cnaCyTRdntpNY6FnlDwYqe9S3-I_7NB2hRq-w1NebfLVV7gP2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSfRZvwTwF9p6Co33G9xnE7ZMAXSgr-WaZiukNHizJYFQ&oe=6B0DA1B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Glossy Pass the Dutchie Cannabis Logo2.png", "id": "1876857596874375", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/747795579_1876857600207708_7365799756919686680_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF2vLQ0dSa4Q7kNvwFghC-X&_nc_oc=AdoeN7cukzj6QWU6EofxJY-CNhtJwgBlhpH79B82uiwHBNqjhrZIjMrMpytBTvzDM8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPm7YJeY7APjAZgMZj_D9v5iOn6CV7F5spVHpeAVtBiQ&oe=6B0DB1BC"}, "display_name": "Pass The Dutchie", "keywords": ["social", "hangout", "cards", "party", "multiplayer"], "long_description": "Pass The Dutchie is a social VR hangout for groups, clans and competitive teams. Kick back with your crew in a 90s basement, then head down to the bunker to plan your next comp match together.\n\nHANG OUT\n- Up to 20 players in a room, with voice chat that stays in the room you're in\n- Join the public basement or make your own server: public, or private with a 4-digit join code for your group only\n- Two card tables with a full deck, chips, an UNO-style deck and a dealer screen with 25 games and their rules\n- A bar with four beer taps, real pouring, bottles and shots\n- Darts with a 301 scoreboard, foam dart blasters and a boombox with radio stations\n- A tube TV with a retro console, four controllers and parody racing, pod racing and shooter games\n- A movie projector with public-domain and open films\n\nPLAN YOUR MATCHES\n- A code-locked strategy bunker with armoured doors and 20 seats, with its own voice chat away from the party upstairs\n- Map layouts on the projector screen, a laser pointer and a neon pen to draw routes and calls\n- A chalkboard that keeps your plans saved for next time, and a host who controls the door code\n\nComfort: snap or smooth turning, comfort options, block and report tools.\n\nMature content: depicts cannabis and alcohol use, crude humour, cartoon violence and gore.\n\nRadio music by Kevin MacLeod (incompetech.com), licensed under Creative Commons: By Attribution 4.0 (CC BY 4.0).", "short_description": "A 90s basement for your group to hang out in, and a code-locked bunker where competitive teams plan strategy for their matches. Up to 20 players: cards, beer, darts, a retro console and plenty to pass around."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/passthedutchie", "developer_terms_of_service_url": null, "publisher_name": "Tired Wizard Productions LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/passthedutchie", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_proces
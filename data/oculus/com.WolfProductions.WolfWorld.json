639207147391848_3039590265803870880_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zk_x0IQhA_sQ7kNvwHXkVDi&_nc_oc=Ado62QOaN4yLk1_5nF-jS3E_2uc506izSMXG-Fuddmx87i09U4Mnr9r82lRl30RJ4vs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-HkB3ktCgNmUxemMIVjD_gN0IiMpoU2xGoXiNBXyCrQ&oe=6A5F7FD5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wolf World Remake 2.0", "keywords": ["Wolf", "World", "Exploration", "adventure", "fangame"], "long_description": "Hey there, Pup! Welcome to Wolf World, the very first version of our amazing virtual world. We're so excited to have you here and can't wait to show you around! Our goal is to give you a fun and unique experience that you won't find anywhere else. You can embark on epic quests, meet new friends, and explore the vast and beautiful world we've created just for you. we made our experience fun and perfect for you. our world is the best and we made it the best for you because we appreciate you\n{24208634898755570} if you help this game reach our goal to become popular like yeeps gorilla tag and Orien drift these game have a special something and that's you so can you be our special person", "short_description": "Hey there, Pup! Welcome to Wolf World, the very first version of our amazing virtual world. We're so excited to have you here and can't wait to show you around! Our goal is to give you a fun and unique experience that you won't find anywhere else. You can embark on epic quests, meet new friends, and explore the vast and beautiful world we've created just for you. we made our experience fun and perfect for you. our world is the best and we made it the best for you because we appreciate you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ww-studio/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Wolf Production", "support_website_url": null, "website_url": "https://sites.google.com/view/ww-stu
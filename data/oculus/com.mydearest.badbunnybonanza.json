Ow3aOVELOoUQUXaUgsy_TVV98tAsV3jbEX6KiseMc-QPBlvMO0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jmGOjYHJmVN3--DcOGvsBb-058M6E9ul9nLl4OkWAAA&oe=6A0C6D66"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeCG7T2IFSIQ7kNvwHAEYMG&_nc_oc=AdrTlFTO1OG05ZgnhUbQ0oC3CYFGrSbM_lFl31kldWTmyjtEmz8VHBfnyNiYam0IDAs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rz3JezNFNRAVz4FlnFcNLaE86Kshr4rDZ5y26ZZCrJQ&oe=6A0C57FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNNwOFeY7-wQ7kNvwFwO-hT&_nc_oc=AdoWfrlF784t11CslwTBpJl6P9yTLX8Q2iA8P43zjM6fRoAbLE4bceQPh0R05W9H5HY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Zbd7wxQ-CQe3pF30DJs29AvlKK7O6pJPbUmXmA184MQ&oe=6A0C759D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
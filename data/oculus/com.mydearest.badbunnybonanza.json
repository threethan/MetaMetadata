13085960_1626693538717808173_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsD__AW_N0MQ7kNvwE9l59Z&_nc_oc=Ado5KrqHDGEcGgbpSpn1bA6J81O1HQLt2uXuORomKS0UtXSKJebiW6JipOExjr0ahQ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o82J_2jrEdRxWmjXpjHUQgOjcW2G5jFCzKiavlKghkA&oe=6A33FA66"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFgy8tZHmWYQ7kNvwGRDVvn&_nc_oc=AdroRWp_7GHQUawZGt4WIiwgbYRGFhFa4eP_3cCgQApbI0RvRiod00gfFwZNGqMRcAc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SURt8w1IUvGrCTHyehUvGERw-8T47cgRimiBhAN5yBw&oe=6A341D3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f81G6SxGDkUQ7kNvwEqWK7X&_nc_oc=AdoOCbJa5chOhChh5C0jXlIUDeN3x2yKP9Cr9w430jyrRQ5mdxLUm63NXOFFD-K7aAc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hSJXLVGj9tc-EgA_6UCuqDbnVBqWNr1Zpwzg-M0FFlw&oe=6A34029D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\
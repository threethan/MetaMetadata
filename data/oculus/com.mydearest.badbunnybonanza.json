QIeBWH8UZMw1f-Lj8IXlof2d_57vhI2Dqm_ERH4lS_yTTGRZ5I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K5VRTRuUluU-1Z6cNj_F1jw5R42Zuj2r2k5IcHXxuaw&oe=6A2579E6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIWDQOAjd2QQ7kNvwFMJpt6&_nc_oc=AdqNaRdmRCwVjHmA41pt1GY3Jqx-qiRlOh4m0Yn5VGv50hJZR9ymP-fXIukmXoW0jyc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZimyxwZImOO_DHaQmEEF4VHjHC192e2xELqbl7iUMhw&oe=6A259CBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISZbAosCgNEQ7kNvwENW-6a&_nc_oc=Adpl-99U-4sW2w1NKP8OkC-xD7DFHUOapa8bu81QmOlFwQs5HRgrk54NI2lAKelswHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__i31Iu6Ke9HF5IlLosOZ9mSmFi2UN6gb5bmbwRR1gmQ&oe=6A25821D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
18_09.\u9759\u6b62\u753b016.png", "id": "1055880709752627", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499618217_1055880713085960_1626693538717808173_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcYXJbh_3EAQ7kNvwE-5Zg0&_nc_oc=AdohYki2jhEgpEHHFJSKsigzPre8scq9kUEDZxAnQChJGxcPu811FOndI4euSb5iKCc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXdQhyyLe-kCwSEXZbgx3O0cur9XKGNDDQsG0ZIZm_4g&oe=6A8D6826"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54-DAq6gXAIQ7kNvwFLs7eB&_nc_oc=Adre-xHi_RateBXxx_ohvDmLJQZoSGCfYNYiamsEWTbJKOD3mESQdBl3_v0L7HHGrZQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGSmXMekghb-oUrZIdo4XEaTgaKmXI05CF3p1wbYIiXg&oe=6A8D8AFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bU_1xPb7x0Q7kNvwHK187f&_nc_oc=AdoIcnEVPz5XUSg8DBrdNpSc6oIbszX8N6vn5VUlBleXAh0nefqxR16IaVVoBIAQ-ko&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSqFpnpK-3hIZRLf0-EM0dn95q4PExijOSerMdAB95dA&oe=6A8D705D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys aroun
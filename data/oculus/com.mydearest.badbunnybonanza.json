9a0dWgqlM-louNhrQb30d-0Vz3XRKfAUtZecKp6DwA&oe=6AEE0A8A"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_07_18_09.\u9759\u6b62\u753b016.png", "id": "1055880709752627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618217_1055880713085960_1626693538717808173_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tUBmN7E3IAQ7kNvwG9usFV&_nc_oc=AdrI7ZiLXcaDNXRkfM5nZZ_vAKst1Y6M5kuRXOGFFh34c1Bl70N7J_z9wrrolAXXlkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9nyV0vqXuqX8MrnULTyCHEANe3FwP1YtVL0AsrhX0qg&oe=6AEDDDE6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoiWUK5_HugQ7kNvwHZYWBO&_nc_oc=AdrGqRCr_AdkBmSGnbCXZnfcOx13j49zHYs5dM_ve5R0E7ETlHa9gu-0XonoT_fQ5HY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjk-iObOdrCBtn6M7u7dQwebbOU5aMDjAdVB6xQqX4KQ&oe=6AEE00BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bk7OMMuWtowQ7kNvwFGnyph&_nc_oc=AdqkYC6PaQRBgmbCHdRrWdvq0Jzw_zjNbuXIu0K5LzfVOXqk-jWPI9G_aZRwAFFAHqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrqtgGIidHb-JiiHTd9LKNG3LVjM-WIEGxkiIKNddsOw&oe=6AEDE61D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud
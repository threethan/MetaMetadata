_09.\u9759\u6b62\u753b016.png", "id": "1055880709752627", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618217_1055880713085960_1626693538717808173_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JefZvLw_JtIQ7kNvwFd8ouW&_nc_oc=AdqF4PJ9SyFEszEzfJoPjrg8WfO0nVy_CXgBdbQtZl3zrkXxzCs5fIw02yI9rAxAhVI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zsbbgEVGWWBNZaEJsAabtbVM_15sOrTJ8ohNVImTblg&oe=6A394066"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UI_bZYCdkL0Q7kNvwH-M7bS&_nc_oc=AdqwZ7XUHQ3V0Bpd3bW1ccyvq4M2Eyi7NHIa6JX87bS6ka2H9Sl02ltlF24uSwUjtaQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IhJohwiM_JN5iMBUNoAOIsfMRDPQlgch4yqmzaMDe3w&oe=6A39633A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xoy_VBLI2IgQ7kNvwEtQwBo&_nc_oc=AdoVWoxhpPcc7MOR2Jz6XZi95N_9i1OcdRcmIQCAwYApIfjPLb-jJahBorKx2jmZYsY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nc1-2IBexUds2O91xw4RgeSOH6CSlxXmu3DiBJ7jagg&oe=6A39489D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around th
1kw_rt43sLuPgBdkURO07srmiJZGiGyT49KpQbt2hONMH6dXBQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JaN3CdybXjdDOVHw9yzc3oMqe3F66rSw1LrwKMM0BQw&oe=69DF9A66"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPSChU2deLMQ7kNvwEWt9Ja&_nc_oc=AdqRkRWmuJv6WRk7BcnNKbjStywpKe0ls1HvV2DEdkLyapjXNjBURdDu7Ij9fu0stZg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZXZjBwwpdY9YeU2vsqlrSu-PB-oA94Skn0ltPGtx1Eg&oe=69DF84FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gWfdCBpo1kQ7kNvwHkRlBQ&_nc_oc=AdrHuhTEN8vrfRMxg-5qLVkmjPsRwxG-bSDNTyjUjxh6DD0E7oIE7V3ET_3hemjNcKw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Mb--flUd4eoIkC1Sul1p3B4hSl5jdGHcf0eYb0mT7ig&oe=69DFA29D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
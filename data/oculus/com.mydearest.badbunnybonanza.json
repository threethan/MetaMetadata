njtG2lEqU4C_7FC7XzFCYfJZY8x8HZIXMkagmigCI4ejlHA8RM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ee4u6VW0Kh9ZDwUwIXcPdFr54dXFGVvLfm-JwlWomwA&oe=69D3BCE6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tEpIHgsZUG4Q7kNvwFGeki_&_nc_oc=Ado3iWJSEz-w9pew7SDvRU8dDMhdc_QrLSfiRuRl3-oCSb8iHmuTZyVmyZ8nciWgdHM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06fFqf4eWUMvVjrNs4DszuJc0lk_mWCDpkn_9J3LJKQA&oe=69D3A77A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vhkore88qfIQ7kNvwEn3LcH&_nc_oc=AdqYj3ANeopBwjVjtdfOzitwj0YXLRynfw06jAwlj2aSCpISN1WxCj1IPP3XdMwCKLA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3G9YeCRO6webRKfHYSd8j-QL15Lh8ptHYozOoGl6tKMg&oe=69D3C51D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
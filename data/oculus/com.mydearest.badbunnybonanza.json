f3R_p-Eqsgfnt9SGnAbM898HRZzaN9GJJGPHujg-kp5txkQtvU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytqZHNorPZZBe6S7dXXDgCzW4WOa_Wbzpl9ZdMkKd7pA&oe=69C3EAE6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aam9g1C-WQYQ7kNvwEPluGa&_nc_oc=Adoke1eZV9lGGZLEDDRONtuRt8bNlQyLYbY0YI48ver6fEuOaMZM33lJGLhIHFUardI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuclF5lbbHvYVR0gml95_Ojs3Hsv4wTDZA8K_KJ3s7tQ&oe=69C3D57A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YFYD6RIPgcQ7kNvwGADlHF&_nc_oc=AdrB_J3fBEwdkN8exj_8uFuouv6XYqwmMekpNYQ-qUuI6e5FM_yVknL4IqkPoBLgDgo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO9b8cX_U5qt_iv0B0jLceNh1M99wOKScGt9Vpg6JD4Q&oe=69C3F31D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
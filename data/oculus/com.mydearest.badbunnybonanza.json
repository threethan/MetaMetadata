_w4FNx0-UiIOoFn7O8GGFWggFrO2v2csHXp7ftwTFOCGbas_RQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yVLwJNPnnjVTDUODqm2P9PPLlaLcMhe4IBBaoW6b7tA&oe=6A01E166"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNJjYNYPM2UQ7kNvwEcQUTW&_nc_oc=AdrJINkj1umzMUQ2ty2d4WBiDBUIW3o8-TZ36tU1IeIEGfrgXtokbT3o_V4SFDk1w8w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aClGmfOkwBqC9jcqNjYpBWxzEt6OUhIeabMbLoeV9hg&oe=6A01CBFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3uhTuJXdLYQ7kNvwGOkcuG&_nc_oc=AdoWB5TqYudyRMepN1hvxwNeg3HKG46fH_CSQYOAXWRm8Iy5JmUdUAf5rH99E7WF1VA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70uT6TvIFsWga5Ab7ruTnnolYNS2W_kw9uyKVVLqAu9Q&oe=6A01E99D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
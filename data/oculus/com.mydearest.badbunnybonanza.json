AxGgTDI2Lv9xnGVjfzpghNymZjhdTHKcviN2ngA3WTuGPFdOAs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12CjsbN-cU90ZzzA0eCq-94NzUGZm9aN6dkjQM--HK7w&oe=69E8D4E6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioaxVyjQKoQQ7kNvwHkp4XM&_nc_oc=Adp9BqVnooeb4XPx3o61fe4n7luNgiZlDNdYsFIBA5U1BRzrBvE199VNdc1rFYizmRY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1U52lMnfkoB4sYi1zPFHncKTBETMMmmv3_s7AUrY-Eqg&oe=69E8BF7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a3zUlpMI94Q7kNvwFG2qSx&_nc_oc=Adqssi9HviTTXHzin9Jt3lU1evOWLf30INAQxvAlVL4lmQ6--S-2Td_HiItVi1-Jwik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HaaXG4eTk3pvzixheUt5j5Xrj3YVbKrFnNhyEnX0biA&oe=69E8DD1D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
rsQwXAgX2FBGSPu841il1e_6IXShxjjwx0_I_JpIU96LIh7Vlk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ijYwwdA-TsKn5raZiibzxY5syCkn9hcMgOinv2Z4CCA&oe=6A218566"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fm5I9WClAM0Q7kNvwF1jWGU&_nc_oc=AdpA4m2Kq32cB79HEVmQxsi8SjMBaaRD9qVPEpeCo1l4v2Rt0oTwiPTuOUX9UJXPtog&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ywNb9hRn7whGk2w9nfG_6Vwju7HyxD0VBSxYm2dyF9Q&oe=6A216FFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZCxXuPuwmsQ7kNvwEm8JlG&_nc_oc=AdoTKDZGMgH51j-_B0vNKYI1FYFH4tP8cm3o1tCbLk8TKAzPGQNx4114hoyjkjWcUoE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XYiGcKB2qLCny8oEOv7vUBJY-11Iwbr814wZwnH9rEw&oe=6A218D9D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
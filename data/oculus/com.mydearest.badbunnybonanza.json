13085960_1626693538717808173_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zi0J3vqN3kAQ7kNvwHRplBF&_nc_oc=AdrLDVyblsqdhf6MgkiS4xwpOepYPwUxa7Cyy-NkRJ7QaDCXJ_dOW8YgGp2JSUYmG5c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-eWYH_U0HtZaTIRxM9erPiUpq7U0d_OcyEM_vIenm17w&oe=6A32A8E6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bz4iSLCQaQQ7kNvwFXSjFC&_nc_oc=AdqrdGER7GZPV_1Lm8IzGmVojUZdvDBkdAQyK1BQA8FERtwLck03YkmKTTglPFkn21c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XyJ3mMWnab2js0qKDsjW6IK66KlLBopSk5Wy1hsR7Aw&oe=6A32937A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f81G6SxGDkUQ7kNvwGjQi57&_nc_oc=AdrZJaWamkp8oXtVJy5BvI4wektYqYG6bl5SpETe1GfowfPA0r1iUWnxB1al0TRh6pk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88ooElfpKnQBuHPoh4LzpRLWr6XADC-6kcQEkhQ4bOlQ&oe=6A32B11D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\
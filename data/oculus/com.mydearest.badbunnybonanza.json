NASy_BXWp5auIcdTfNUV8cpTqZxmkSlXx7ctsk2gVoeqB0eGDo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eZPblh-Bg31Y8-k9QS3lnZASBtraJCZG-B6xNhUhAew&oe=6A15A7E6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APEoyKVABeQQ7kNvwENIJmF&_nc_oc=AdpijHZvDvChWvzocpWzLWxTjby9CxJi5rWeu3gZwF5Mp9fEA4XvoFfWKuxWvJGTE7Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VEgpVDFO4QLT37w0H_hWL1dv_349GzBCPJN-ZiDmTdg&oe=6A15927A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX28SggOGnUQ7kNvwFRmI2B&_nc_oc=AdrODPl2AQukB3xLdYZk0tTYMOM0Qi6jADn0OKfF8CDPksJazCgfEyGaIkB_LqEQUPM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JML2pkuyvIOjyeMzapkol-D3aA7ZAZjRkptkpIWQfFA&oe=6A15B01D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
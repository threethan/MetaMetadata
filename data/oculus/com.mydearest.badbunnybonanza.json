F6llSah4hZtoth9u58hoWLRk1V4l1vDeWjdj3lIx0BzJ1RouJk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9H4s5aOmmZyXNhU60uHNzWYepq-o13Eh08GqC4xA3K-A&oe=6A242866"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIWDQOAjd2QQ7kNvwF3eO8x&_nc_oc=Adpt88QEV3sFo7ZW6CTaLxRXaevzHpNsucKnyUkMsea-hTbUXiCQqRUc86q7qy8nREg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Qr3vi0x4OUhn5iNmIxHYuOIAIPPPSjnGuQyoaF4XSng&oe=6A244B3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISZbAosCgNEQ7kNvwEZkuhe&_nc_oc=AdrSf0eVS-kyM2HgOxiEkiksIrjoykUzh8rUAzJ0z4uMObhg1TPYr-NCo39stsJnobQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zFEirGn3721YF82IFi0o_rJosqpkdowzteb161EZYbA&oe=6A24309D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
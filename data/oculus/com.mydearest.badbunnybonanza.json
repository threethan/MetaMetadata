CzEN5s5U2hLonNzTx000TRNNJdxPLoeyA_aoTYwbZFWQxOjcY8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aul-DTUsApvXV3Ph6t-xvNvzJ-jD7EgpBLWkfeBTl2w&oe=6A2ABFE6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTheFiNarUEQ7kNvwFUnSrp&_nc_oc=AdpUisStydpPHhTS7mak1qoxOFyU6t5MQEipd_hMGaCFzvgfaLcVFDRnuN_2kj2hotE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d6s1lc3NcSYou9LVSXl_7J8S9P3emY108V85DCp8jsw&oe=6A2AE2BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJMDoCEX8o4Q7kNvwHgxUTm&_nc_oc=AdqsqIC-DCMVze0kT14_9YCRNO25b4J_ELAZCdoMJdwQSv4j_B5d36GfhRFnN2qbCrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dp9DULgAgS3GEpS-anyIT_C8lM2oozYtM1NrGExrtQA&oe=6A2AC81D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
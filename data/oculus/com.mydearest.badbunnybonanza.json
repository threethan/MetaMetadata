nWAZFfJc69VKQ0Dx9fOx-sY0G0LQji624UAYBq4-rdxDrMXaOc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3wU4BcKFTFjF_JfgJ4MtePL2Zy35zurci4ueKhsjU6Lw&oe=69F4B266"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0A-eIC1IDq0Q7kNvwHnEjyO&_nc_oc=Adoz15bRmTAHX-nMYLa5mwjlAoxV43tx7L-5-i9dbHS1C7P2hIHgLV45E0L0V5fec7Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CgGuEs2WRQVCtgdbaOaXLRxEBxUK2x8zpEplgyP0GaA&oe=69F49CFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klPxRZ2evxsQ7kNvwE5byYH&_nc_oc=AdoVxKJUaxp9laf-jQGsWD5OdB5o5nmG_HHXRbRZYWhB7xcpMBtjWZb_wrLhbmTKHCE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af120hGnOICj_7VtQER71yqokt3rIK42vkRMOFmC9Wadug&oe=69F4BA9D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
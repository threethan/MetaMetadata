i8w_f7UFXz_C38NnBy5zBiSVMhuRFbkf-thC4xoL_ru8nPfLLM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yu0sqp0wUuSzELzizYl5WYssm4AHnb60zupaYbQ0nTA&oe=69EE1AE6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VukPiKmB73QQ7kNvwHB0GCd&_nc_oc=AdqF7NGnVo-cJwi8jz8vBfvZYCSkVH7yfKAcBl7CwibkVwZpzt92wTci_Pa9tzfalZM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26QXHh8rU3HlFajFMdbFwGSCTLVevuzi8bj0JMDRSVQA&oe=69EE057A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6xMHDPXKS2oQ7kNvwEG58B1&_nc_oc=AdoOVW8ezbr0gT1f8AJEW2_OdlAtsXAvPdAJi994BefoOWDgbUJ8pBc6McQZtAKP2FA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0t4GGTY6a4q2pf522WudbYl5AlbhBRZkkU2UJ1RJi9Tw&oe=69EE231D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
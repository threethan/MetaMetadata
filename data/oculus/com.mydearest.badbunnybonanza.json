iUxXXmczt0GYHs-UpopoAflAJyyOoJJK7G8Kt-wO48Ij_gZ3qI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D2FhUuMPNCeLgHxN6Ct1FNajlL6wg5QKZ5CNjFA3SsQ&oe=6A281CE6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTheFiNarUEQ7kNvwHDaP4f&_nc_oc=Adpintm_k_0JQn4Vt5_q_TmzWLprVVF9ZBz2wR3AJiul6BJlTaeqX46wz5qyR0NF2-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w5MptTSUiQKp6HKyHz49lqIN4xtwdYT3Fw254ZOLqtw&oe=6A283FBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWLJ4CNO510Q7kNvwGkoKPW&_nc_oc=AdofXEs4bLA9F9Bm54qznphdNrptlaoagsiqx3ufCgXLuqAyCNZRGCmJvA-j6VptBXA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PjWhcx0canbLcAqHiT-zhSP6Yth0pkO6djArehScfRw&oe=6A28251D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
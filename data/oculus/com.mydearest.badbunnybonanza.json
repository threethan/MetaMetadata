lNCWwgSo0Yv_PK3y1CJRSUvQiprBhpvust0tQ8a5JWjBpJR_6M&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f3YMAMRsahDBEV8Dmq7isWfftgSWfG5pnFCPSXkTdww&oe=69E23D66"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ih8q9uXkEQQQ7kNvwGut12n&_nc_oc=AdqeCgpQTN3TCblu479fcrayV_3u40_QcncO-LCr279XtrXdHd6BgsrWruDo33D3cxA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vvznaTIQXVNoTC5YhwjMbaZd1EVMeI18pflBeywWc3A&oe=69E227FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gWfdCBpo1kQ7kNvwHZDUkY&_nc_oc=Adov84XmODJ2vCu3I6i8hU1DrDw5sEO1H0VT_njDf37YrGUPSaTWBqQMP95_awwZYVw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31XG-GxYffrxAm6zko4f51uKy_CtPRnf-IXO6fTt42PA&oe=69E2459D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
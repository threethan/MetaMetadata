7KjiAAqBzDzBa6lJXzo0xzi3KiYEPt94NMhyy0sJRw&oe=6AE73ACA"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_07_18_09.\u9759\u6b62\u753b016.png", "id": "1055880709752627", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618217_1055880713085960_1626693538717808173_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Ej-rPiOEmMQ7kNvwH6aDQ4&_nc_oc=AdrGG4OtlkOFIWibVLrbAor3WHvrmVfYygYWBEQQFMpJmQNn6BsmzCZVtCh5-MAgQ2o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmQvTbhtAMsrQcFObWf4P9js3_8ffNS_Zn34YFLv__Wg&oe=6AE74666"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HvBL9lt2csQ7kNvwFnVEqp&_nc_oc=Adpp07uv3bdKfSRyMb8xk8jVLnXcj2aclOaWntfkiqbmzHLosjtVKKViv1OqMVIRzKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPziaQ6CZFPc33eLWZ23ZAPw5JF3u2KbnoSUe1i2IDbQ&oe=6AE7693A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6SzciJxwfwQ7kNvwFGiXwJ&_nc_oc=Adrq633R2xxEmnZ3vvblSfGLbGEWbnxaevJeP9Fn9J7wlv4gz82PP716eRf3v9-1Kn0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8vL8Xgj0KV9t9gO42utyCBE_QAhAMjwL--OjNWGfzcQ&oe=6AE74E9D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud
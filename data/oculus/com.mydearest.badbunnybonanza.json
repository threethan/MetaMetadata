bd-K_T7wSBrIKbNQQGS-n7DBHp-mFfveczeR1C-5Qw&oe=6AA6A14A"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_07_18_09.\u9759\u6b62\u753b016.png", "id": "1055880709752627", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618217_1055880713085960_1626693538717808173_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4pnFL-iBbcQ7kNvwHimlCl&_nc_oc=AdpDd_4F31sOblenHsx8CKx57aPH1IUbCTieKlJbeTGt-p5cibdvhXsquDlMGuuozSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ2ZYDNQJAlKhYvfDGK_DlAuZwDzzwyoHk_a2UCWa8YA&oe=6AA6ACE6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGpUN8R8GHcQ7kNvwG65x8F&_nc_oc=Adou438137Qz3tcUHz9tuiLMP92yRKBfHsQ-ZTeBakvxOz-kgAvEGg-mM1JckbtP7yw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0HfL627xkeOvQTTmTaMRWHp3L309Bt4YqbncJ2vKsuA&oe=6AA6977A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XXBPx7-ccMQ7kNvwHdqshU&_nc_oc=AdqVIyyfw3nWougwigybO0OzGfwROXHtlTIba854xFOzaLyWJxq-epOOytu6Y8bFIgA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_9Kw6x4cakQb3PO_HhrdzYUbdAUGMhGP5KlKPsdRvGw&oe=6AA6B51D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you clear each stage is entirely up to you! The sky is the limit!", "short_description": "\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n"}]}, "developer_name": "Bazooka Studio", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/badbunnybonanza.html", "developer_terms_of_service_url": null, "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9528391457266701"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn
13085960_1626693538717808173_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zi0J3vqN3kAQ7kNvwFL5H1l&_nc_oc=AdrnaRrAshBbuxp06fRe6_0h4Oq1pIdLhEItG-_L5jtnwSToaXDlF2ref4LQvE5zDyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82wmSYtYOlVN0LSqgHP8TUuDIWsSSSInjeE5kQaOqB4w&oe=6A315766"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bz4iSLCQaQQ7kNvwFVF4Xw&_nc_oc=AdocmvnAcXDybbhXSvTPK8_etEAKr2jG__nx6vVN40A2QiPFp9kSLQftRnTvj8pFEcU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nkiuwmB2oksX4SnkMqtPNnDxieMqDpcqRUxb4oW-_GA&oe=6A3141FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtdVRvgOiWsQ7kNvwH1CJCs&_nc_oc=AdpQxCh_qtq4IoXHjHkHllvkWyPVTxJCNFQZinqfC7bBUaCr1T_C5e8Hcgc2u7vjBTw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MdmaUgvmvxg5oHqLbNqn2PE25TBmAIVXRK0DXwRI3kQ&oe=6A315F9D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\
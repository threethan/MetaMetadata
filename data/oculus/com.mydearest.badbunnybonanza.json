hL6rFg_oVVoGsGjPkqHGSB-A2hG-w-x7OUWEGf2VMUrfPH4Crw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OBO3QcZ1ySpuT3wE__PS9O19VVJZyeG7U_ik0BYL-GQ&oe=6A1304E6"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6jQ9x5axNYQ7kNvwHjg7-m&_nc_oc=AdrxMyLboYt8hDY3gl3aK0Ejcixw3uKSgqpn3lzDoHgCTmVfWbD60-6UH7pfV11rSmI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZJhsjwFecIEnmP7KL2PY-MI4rpBzXMSy1ia5K6EOhsA&oe=6A12EF7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX28SggOGnUQ7kNvwGTgazo&_nc_oc=Adpu4PlXVarxu9-Vsjm_BCoq9YR8Cld6evQz0REyLsZwthB73uTvUd31h3E9ni8_tec&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a8ow9jpCTnF17GUXY5gLjhYy0JCnDwzYdcCAWphXUlg&oe=6A130D1D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
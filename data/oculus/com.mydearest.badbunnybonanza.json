YA480Q0gw1hWU9HQfE_LwjfYEd8EFEjbwgyGopUg7rBouYJOCw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W_M8CE1FkZH3E-XcFv76Xd1XTD8ZyiM7cgtTCAJY7Ng&oe=6A2C1166"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-Y9i4i4uCIQ7kNvwFCpXEK&_nc_oc=AdrJDZn4rT1-9qiTaEOZV8UklOk2LdVDYfCAJhQPon762l2Bwlch4ysFsPBn4kdxoec&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YQmC680lvgmUSzty4gPH_AEayTggj7QhRPBWf2VeULA&oe=6A2C343A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJMDoCEX8o4Q7kNvwEfiani&_nc_oc=AdpUC3SgRpX9sc2Pfz6T9zAHrf6PEsYxi905W89MtEuvtTBKr1GwDV8YQmUraOQSWB0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9biwkODf-HL7sMZn5zGS-sNmbiKXU-J2RtAnZY_-ON7Q&oe=6A2C199D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
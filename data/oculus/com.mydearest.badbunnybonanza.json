QQSdx62Ta0mNdLTH6nqj2OPDVyxvSijjJiE7pkmOTdmho4lPbI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mQZ0qoCS9_ExFbFvwTRRkgW_CVYpLBNnpd9lqRDinxg&oe=6A1C3F66"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUMma9wwJCUQ7kNvwGyeV6W&_nc_oc=AdoryyfBkAj21oFppZpkayEhi1AxUe3YR4hb4umUNLMjif3mCiIcsYQ8Xv1MUYPnBQU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72e49VBj6cn3nXqtL9p1qyoo-A21l5jMu2EVKnz6YsAA&oe=6A1C29FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqX-SKq5VgEQ7kNvwF68a69&_nc_oc=AdqlV6BqUB9WPhitC8dw4xIsm05od_ZWVeE6zptDyqG93Gzc8vgR8GyiVWzZIW89amU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zQcuUyDUUZFnMoSZiaHCwCGi28IfygQFme-x4F-hnOg&oe=6A1C479D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
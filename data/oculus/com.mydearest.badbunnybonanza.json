p3-kQ1HTGguUIIZS75-r2qA8MNLfsECnRDePKq9_ltLT6J9hZo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQYvCb_ktr5CG130LJ0-W1rlErl1u1LCyX4MG755Wqgg&oe=69C53C66"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUzWq6ilR_EQ7kNvwEpbyIB&_nc_oc=AdozHbtFMmavA4VAxA5LQTg1Qh9vtW9VHOwUpS3pl084lrVsbG0yk7CJb8PKqqQUqf0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzw0LgGqyQyZeWE7P3xu9CCMEV2eIDWN2sF3hNOm8btYw&oe=69C526FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YFYD6RIPgcQ7kNvwFEAMGd&_nc_oc=AdodI3g3WJpctEOi1pIFH3qDxYtTyV4cXwc6Hq47eSNjtvxKtuDV5RV0xuguXR1BrO0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyT533OUoKtXFPZ3lpgh_fjDl5GnCLXCdbtvIb8l-RT1A&oe=69C5449D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around the room, rip apart stuffed NPCs, enjoy doing everything you're parents told you not to do, in this hilarious physics playground!\n\n\ud83d\udc30 Over 13 Unique Stages!\ud83d\udc30\nWith more than 13 exciting stages, discover endless ways to achieve victory. How you
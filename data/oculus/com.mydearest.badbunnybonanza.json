_09.\u9759\u6b62\u753b016.png", "id": "1055880709752627", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499618217_1055880713085960_1626693538717808173_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzO2mUyuPgMQ7kNvwEEDkVn&_nc_oc=AdpdUkKRWXJVj0XgfrAKDov-uSuOu8vqlL9ZrtHo1kyt_Tv_Ml80P2uwx-wMRtDN1JQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cr4QyD8PqjlbKkb-6TQiEHG5A9Gfn3vbZ-uk7OyYjfg&oe=6A466F66"}, {"file_name": "\u30b7\u30fc\u30b1\u30f3\u30b9 07.00_00_13_00.\u9759\u6b62\u753b020.png", "id": "1874068993435096", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499349026_1874068996768429_7489400502973245992_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HU6hPIusHKAQ7kNvwEBbFNL&_nc_oc=AdrRaMrN4r7FXLFc7aOgeVuiUG4W2SHb3_p1ne1mrTjOVa_80qpsrpMuAyVn_K64KNM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af921jNu-ULXmxeCP4OP59-XXWek9Ol327Bx6UX2i0OU7A&oe=6A4659FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "2825875957604900", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499617698_2825875960938233_5209709702361359124_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klY2DCiR3IYQ7kNvwH8smhu&_nc_oc=AdrtFOoulWSphMkxLugkw0LJT3v3wDrPG-yYPr7nNZkM00G_-JUOaMIMy3ZFLc9hoKM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Dga5zkY5OALgX4WItWpCTeFmJRygMOpfiC71oqBt0Bw&oe=6A46779D"}, "display_name": "Bad Bunny Bonanza", "keywords": ["Bazooka", "shooting", "physics"], "long_description": "New Stage Update!\nClimb along walls, get launched by gigantic fans, and swoosh down massive slides! Dive into the action-packed new stage now!\n\n\ud83d\ude80Blast Your Way to Chaos!\ud83d\ude80\n Bad Bunny Bonanza is an explosive VR action game where you have cannons strapped to your arms and use physics-based mayhem to reach the goal!\n\n\ud83d\udca5 Fire, Fly, and Destroy!\ud83d\udca5\n Shoot enemies, propel yourself into the air, blast toys around th
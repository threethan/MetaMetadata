9Rj9oyugQ7kNvwEQtnti&_nc_oc=AdqHoKAvsUK7rRRqPm3pmo3fbvL-yhZ5YGI7DtkUgFzKdnXDXDLqILVb72YDjM4CJb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgXLp9CqOEbf5hU7C8f3XIwVG5S_YFSo3GchanL7BXWg&oe=6AEDDB1F"}, {"file_name": "migrated_image.png", "id": "137617814347959", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138835_1666230393589606_1940447322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaUNmXVpn9IQ7kNvwGG8MsE&_nc_oc=AdqsWtB9AKo5zPrnmiNxxwKJ91_zLgrK__oORgq54PbWBkPk0__tlBNebWpoDiqVtVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk1ao8zkJTJNL00Zqg6sm-kt7jsoAqCkEMZzt53qy7VQ&oe=6AEDF8E5"}, {"file_name": "migrated_image.png", "id": "658915161561302", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138838_187526161591862_770596670_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoypeYVaojsQ7kNvwEKs35J&_nc_oc=AdqqTmcCtp7TE57p1xrEToOvngTtCTkbShUeItLQfXCjhLpUZwWIjLx_hyp4aVa6kZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsLi9n-kxEk-ICS99-Fqx4g93FqtjfPK8Bw5UsdeyCnQ&oe=6AEE0CB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Esper 2", "keywords": ["adventure", "ancient", "explore", "puzzle", "scary", "temple"], "long_description": "\"Esper 2 improves on the original in every way.\" - VR Focus\nHave you ever dreamed about moving things with your mind? What would you do with such power? Here's what we would do. Esper 2 is a game about using telekinetic powers to solve puzzles. Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens. Travel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious multiple times. With an all-star cast, interact with a dynamic array of new characters, voiced by notable actors, Nick Frost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game. Solve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.", "short_description": "Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens."}]}, "developer_name": "Coatsink Software", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Coatsink Software", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "zh_CN"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "690471005663981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162698_647254262129833_8937871292808298496_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzlnCB3zwdIQ7kNvwHfqlrk&_nc_oc=AdqaYHllz2-53fm9uVeqVsKHTMYrFPUqlRRJ9bIcJVFkoQWtBpJZn6oCMu54XvN_JEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtogGSrBbdtUMRPqH2gTi3c-3FycwjMsbmcrb7gECVYA&oe=6AEDFCEE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Esper 2", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1449734400, "lastRevision": {"nodes": [{"id": "916769
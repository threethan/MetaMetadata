Vxg5f1eDw&oe=6B0B36A5"}, {"file_name": "migrated_image.png", "id": "230704458105048", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138834_1639242906335590_237046970_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzkZE_911CQQ7kNvwHWmeAK&_nc_oc=AdqfS9qnI7m4gCJ8wXW4HNZs9RdK4AW7YdYjZ4AHm8OgZVat9TcePR28KiWU5AOpoLg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQe9aRxBv8cpzRALqqmJ2oN9HdcVLybE28RMde6unmPw&oe=6B0B145F"}, {"file_name": "migrated_image.png", "id": "137617814347959", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138835_1666230393589606_1940447322_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbGO-RAkVp8Q7kNvwFKFsL-&_nc_oc=Adr_B8_ublyUNNUc8QkWhbCIFiMvS_06iCqmVIkW7-FxahBF1cNgLHii4znj6Gco52I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTvTb0-T5gHzw-YhODwcKSwEme54LQxHM3Eyf5a10BnUQ&oe=6B0B3225"}, {"file_name": "migrated_image.png", "id": "658915161561302", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138838_187526161591862_770596670_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHM-9qxiuWkQ7kNvwHi5Rwl&_nc_oc=Adq3e-8pt209yLPhOGoyHxcMotjrfCaDni_wNQCrOwXzqdapHx-dxgoCwffEuEBy59Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT8_5eDw7b6hgSmIWOE66a5FVKILNd--TUrm44iMdGC0A&oe=6B0B45F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Esper 2", "keywords": ["adventure", "ancient", "explore", "puzzle", "scary", "temple"], "long_description": "\"Esper 2 improves on the original in every way.\" - VR Focus\nHave you ever dreamed about moving things with your mind? What would you do with such power? Here's what we would do. Esper 2 is a game about using telekinetic powers to solve puzzles. Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens. Travel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious multiple times. With an all-star cast, interact with a dynamic array of new characters, voiced by notable actors, Nick Frost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game. Solve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.", "short_description": "Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens."}]}, "developer_name": "Coatsink Software", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Coatsink Software", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "zh_CN"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "690471005663981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162698_647254262129833_8937871292808298496_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcBZ7q3C038Q7kNvwGMT_4R&_nc_oc=Adr0FVcV7oriqxKhSNo8ywapI87lVxd6W2rJ8TTmH1nCUVH0YCYcAAhpU2V_eRhoM_8&_nc_zt=3&_nc_ht=scontent-a
cJjEP43wQ7kNvwHHNheu&_nc_oc=AdpuQcPlwRf8B5EyCMETemhgzunky5DsS4C9zKhWrLbHb57LJ-C5f-UxB1_QiM70sGQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRld3a-QNZlrt3jn0t34uy7T5htgmX1ck3GqBtL7WwDA&oe=6ACF889F"}, {"file_name": "migrated_image.png", "id": "137617814347959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138835_1666230393589606_1940447322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHyb54cQpMsQ7kNvwEMXSEp&_nc_oc=AdqrTPrzmiEM68phf13_9-efwwn4NOOjb0BBkGuEfHQOLo77dkq5tuLkwoPDjes57OI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkvzTld3BLSoyLIEb9EtZYtENCDlYIJ-zJUskcZJpg_A&oe=6ACFA665"}, {"file_name": "migrated_image.png", "id": "658915161561302", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138838_187526161591862_770596670_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3m9ihDWyLjwQ7kNvwE2231H&_nc_oc=AdpY5v9f1TXQwgyb2uYxe9KxLH_eczFTn3N2ubnf1P9A0inb-M-aMRV3VUZKlMPxKrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3j4CIbFhXU5Uq7f0B4_vK8zDXSx4Gu4JmjcK1Q2Lypg&oe=6ACF81F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Esper 2", "keywords": ["adventure", "ancient", "explore", "puzzle", "scary", "temple"], "long_description": "\"Esper 2 improves on the original in every way.\" - VR Focus\nHave you ever dreamed about moving things with your mind? What would you do with such power? Here's what we would do. Esper 2 is a game about using telekinetic powers to solve puzzles. Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens. Travel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious multiple times. With an all-star cast, interact with a dynamic array of new characters, voiced by notable actors, Nick Frost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game. Solve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.", "short_description": "Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens."}]}, "developer_name": "Coatsink Software", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Coatsink Software", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "zh_CN"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "690471005663981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162698_647254262129833_8937871292808298496_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7KHip8mLx8Q7kNvwEQ2Sjq&_nc_oc=AdqaA7ijM4gwHNGop9EVxRRnBVVXRvHW0qCz_rXJz9kXevggdBXy8tRgRmiwGxjxqaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMd-DraxAPvk0gxiDC3YBL4QR37mvc7pyXE5EXe7HwDyA&oe=6ACFAA6E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Esper 2", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1449734400, "lastRevision": {"nodes": [{"id": "916769
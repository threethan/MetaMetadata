ohc=gl0-FiMyvXYQ7kNvwHIrg48&_nc_oc=AdrH9CC9a-7o3DLVUmfmh0BwhINOS1lSNt3Cg-9whVuggg2wrtSAPd4uofALcr7aUuM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HxMiZoQBNv6JI2ku94Ip9-pI8-5srn32Xd9jWDntnKg&oe=6A393D9F"}, {"file_name": "migrated_image.png", "id": "137617814347959", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12138835_1666230393589606_1940447322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUxhl0Uo4c4Q7kNvwFEiPgE&_nc_oc=AdrVqjp24te0KcCgqFXDkLqS_ZJl-VhpXWv_KY84Habge21gVPOcn9uJydvM7BA4djE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Myl3zdrpnW5bs1un4oC2MgGK0bOrFRZ95_MtFfmMTPw&oe=6A395B65"}, {"file_name": "migrated_image.png", "id": "658915161561302", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138838_187526161591862_770596670_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUp4MBq7JXcQ7kNvwHJ-45L&_nc_oc=AdpAtlAYbYDhWpS4MdYa1ysU7RcAo-Q9SJ-NmI02yTgf8qoRAEYlG7g2hBO_rMZMt-A&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kHyOpd7YDFGyqLs4vHQ3E_MifFvm-vwZBjgpWmuWq3A&oe=6A3936F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Esper 2", "keywords": ["adventure", "ancient", "explore", "puzzle", "scary", "temple"], "long_description": "\"Esper 2 improves on the original in every way.\" - VR Focus\nHave you ever dreamed about moving things with your mind? What would you do with such power? Here's what we would do. Esper 2 is a game about using telekinetic powers to solve puzzles. Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens. Travel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious multiple times. With an all-star cast, interact with a dynamic array of new characters, voiced by notable actors, Nick Frost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game. Solve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.", "short_description": "Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens."}]}, "developer_name": "Coatsink Software", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Coatsink Software", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "zh_CN"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "690471005663981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162698_647254262129833_8937871292808298496_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gw3yAqK5PbMQ7kNvwHiTQaH&_nc_oc=AdqCyE5iGx0KJud0_e0ojERJ9TKNDY94BceJriTj_7diBLQUZGoPiKSPHYyFqIS6rP8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lQJSKasDTAQ_tnI5O7iLiljzYLWTPHQR_xgZjCRsO5Q&oe=6A395F6E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Esper 2", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1449734400, "lastRevision": {"nodes": [{"
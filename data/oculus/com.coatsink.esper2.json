ZwBbwTEh0kg4j9s3TYGWJTPc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBwRqqifdBeB8UTDUOhv2SmeSs0y1x2kuIJpvyAXuegQ&oe=6B0C52D4"}, {"file_name": "migrated_image.png", "id": "503321780338489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138837_168540880162056_746872534_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MYxl1soIUkQ7kNvwEPeYaK&_nc_oc=AdqXNT5-Zdb6DavbdZiT18ecDUdUd_EyzkCfpDk1DC99Pw6Sids_aFGF9V2XnlL7ozg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT32ED7vgnbZZHlarhX-rNMYwh_g4Da0x1lWgd-gXNRAQ&oe=6B0C6ED8"}, {"file_name": "migrated_image.png", "id": "317970062496183", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138956_943674482388488_1585284624_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oD1VbD-tWYcQ7kNvwHI_YlD&_nc_oc=AdpfwZZTHFLoieIBFRE-PI25WSrWRFFsNOvahqc5FrA6bedoavCh_Z0nwQfAUOpDQko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS7e_q3mIE_J2TUoA0mBRGFd6pN4ERFtu-2DwF2BRFooQ&oe=6B0C5327"}, {"file_name": "migrated_image.png", "id": "2621831821470831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12138906_509470305893641_385075339_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubL8vpI3VIEQ7kNvwH0pIzF&_nc_oc=AdrfhayzaHLR203y6EzKslbkx0o2YAykUm144E8WOJhv5fQnC7VkpvSHIiJ0Up7xGZ4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSsM4XPUrlYg7DD7h01bYtNGDdtsBWJCTJEjs5E1ulgpQ&oe=6B0C597A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Esper 2", "keywords": [], "long_description": "Have you ever dreamed about moving things with your mind? What would you do with such power? Here's what we would do.\n\nEsper 2 is a game about using telekinetic powers to solve puzzles.\n\nReprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with the recent outbreak of telekinetic powers among citizens.\n\nTravel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious, multiple times.\n\nWith an All-star cast, interact with a dynamic array of new characters, voiced by notable actors, NickFrost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game.\n\nSolve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.\n\nGood luck.", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Coatsink Software", "support_website_url": null, "website_url": "http://esper2.coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1391442884658925"}}]}, "scheduled_offers": {"count": 25, "nodes": [{"status": "PENDING", "id": "169304840335352"}, {"status": "PUBLISHED", "id": "267665527194499"}, {"status": "PUBLISHED", "id": "155458938459072"}, {"status": "PUBLISHED", "id": "444932469511841"}, {"status": "PUBLISHED", "id": "1589288141365517"}, {"status": "PUBLISHED", "id": "480091232725513"}, {"status": "PUBLISHED", "id": "1540336519353702"}, {"status": "PUBLISHED", "id": "2255423794717953"}, {"status": "PUBLISHED", "id": "329640184438583"}, {"status": "PUBLISHED", "id": "488007708197059"}, {"status": "PUBLISHED", "id": "277212782747913"}, {"status": "PUBLISHED", "id": "610345819319
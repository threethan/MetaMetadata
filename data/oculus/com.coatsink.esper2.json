_AQFPacqIvWI9hAgWCGAd4ftLQsIRO2bzLb2FIqx2NFyHTA&oe=6A7EEDD8"}, {"file_name": "migrated_image.png", "id": "317970062496183", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138956_943674482388488_1585284624_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjXf387pnRMQ7kNvwGVJ_KI&_nc_oc=AdrCC86HsB7GGmrQl1JQol0EtqLaf3VCpApTK5zvYqVVLckq_qxBHwU02_9HoIa4VEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGi5PICBdBnaSf6botYpieemtRoOzVKxpEf5XJiu0gD_A&oe=6A7F0A67"}, {"file_name": "migrated_image.png", "id": "2621831821470831", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12138906_509470305893641_385075339_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k57EhSk3N9MQ7kNvwFhnqt_&_nc_oc=AdomGCL8Lzo4zAlxAwcsbzJrI0P69C9gwIoJFfvETxiwchjZWulsvpX8bVSUEhzRc7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKZC2o2yQtU-Fvl88hEPgdqsf4IVmVktQo6l7BImdYSg&oe=6A7F10BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Esper 2", "keywords": [], "long_description": "Have you ever dreamed about moving things with your mind? What would you do with such power? Here's what we would do.\n\nEsper 2 is a game about using telekinetic powers to solve puzzles.\n\nReprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with the recent outbreak of telekinetic powers among citizens.\n\nTravel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious, multiple times.\n\nWith an All-star cast, interact with a dynamic array of new characters, voiced by notable actors, NickFrost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game.\n\nSolve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.\n\nGood luck.", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy
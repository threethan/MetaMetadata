 among citizens.\n\nTravel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious, multiple times.\n\nWith an All-star cast, interact with a dynamic array of new characters, voiced by notable actors, NickFrost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game.\n\nSolve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.\n\nGood luck.", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Coatsink Software", "support_website_url": null, "website_url": "http://esper2.coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["PUZZLE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1391442884658925"}}]}, "scheduled_offers": {"count": 25, "nodes": [{"status": "PENDING", "id": "169304840335352"}, {"status": "PUBLISHED", "id": "267665527194499"}, {"status": "PUBLISHED", "id": "155458938459072"}, {"status": "PUBLISHED", "id": "444932469511841"}, {"status": "PUBLISHED", "id": "1589288141365517"}, {"status": "PUBLISHED", "id": "480091232725513"}, {"status": "PUBLISHED", "id": "1540336519353702"}, {"status": "PUBLISHED", "id": "2255423794717953"}, {"status": "PUBLISHED", "id": "329640184438583"}, {"status": "PUBLISHED", "id": "488007708197059"}, {"status": "PUBLISHED", "id": "277212782747913"}, {"status": "PUBLISHED", "id": "610345819319
ohc=sZbhO1F0iloQ7kNvwH-BYlr&_nc_oc=Adp95NSUBSEKGnAHAVpJU4_9JYbKRsJG4rNNSu8OQ2Q1yS6v6G6SHYvsd_xeoYukFX0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gdTmJo1rxZJIWUkcMdTRKOq6TJMIAuv8RFkfPjuSZDg&oe=6A11B09F"}, {"file_name": "migrated_image.png", "id": "137617814347959", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12138835_1666230393589606_1940447322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQpRsHFh34sQ7kNvwGhheUS&_nc_oc=Adq2K_uPgzD5yvaCqLtc_2J8BTs8P1SUKYegAIrr69D9kULF-gKDLBGPPlEUPADB6qo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NdALSv2e4DD48gwPm9dOdK8r_5eAaSYx4FIujLqOsUg&oe=6A11CE65"}, {"file_name": "migrated_image.png", "id": "658915161561302", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12138838_187526161591862_770596670_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wh2FsY9x0NAQ7kNvwE36H2s&_nc_oc=AdpBEIC_dHACJkafR0NXb_W5h8gPLy7QT1qxlWhkTaVxyq1nX2avW5JKGBqrB377CLo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HRL0EkQdqWzEih8txDCXR_Se5eMrSg8IUAtVC9emGGA&oe=6A11A9F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Esper 2", "keywords": ["adventure", "ancient", "explore", "puzzle", "scary", "temple"], "long_description": "\"Esper 2 improves on the original in every way.\" - VR Focus\nHave you ever dreamed about moving things with your mind? What would you do with such power? Here's what we would do. Esper 2 is a game about using telekinetic powers to solve puzzles. Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens. Travel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious multiple times. With an all-star cast, interact with a dynamic array of new characters, voiced by notable actors, Nick Frost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game. Solve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.", "short_description": "Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens."}]}, "developer_name": "Coatsink Software", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Coatsink Software", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "zh_CN"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "690471005663981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/11162698_647254262129833_8937871292808298496_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U5C0owAqhIQ7kNvwFhWfla&_nc_oc=Adrpo8cU5pswvtQsi9d6SET5ih6oxNnIa5-oK_T8mU8_R-DQmQwc9dpHK2EcJ6S-ERA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KSPTVW46U6n81z1It_QKrJM9QJySj4-i-euu458_t0g&oe=6A119A2E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Esper 2", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1449734400, "lastRevision": {"nodes": [{"
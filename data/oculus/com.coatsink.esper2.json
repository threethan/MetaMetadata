0BpLw74AA&oe=6B09ACE5"}, {"file_name": "migrated_image.png", "id": "230704458105048", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138834_1639242906335590_237046970_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vq22FORnZf8Q7kNvwGq2FPD&_nc_oc=AdrCfgVC6zdWY8zQlyD56qqmhYFLlsS00-MdHuDn-IYkjuHAuceU1TBDYFwy_w3yJwY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc43bi0Foui7GxvtXGcqJaD8o0aIAgMzsKkHkKM2Y8Nw&oe=6B09C2DF"}, {"file_name": "migrated_image.png", "id": "137617814347959", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12138835_1666230393589606_1940447322_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPjqS4htKRIQ7kNvwFE1dZ0&_nc_oc=AdqeoP0sdfjt0tjVnX0tvEulDsp5uAPzoDiJ13uxFpDyZ3Y5LGjuIdt-bBMw-kytTTw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpmzKCm6mJGYKFxa5-DVZyZu9xLG2eXcMixdwJAURZ-w&oe=6B09A865"}, {"file_name": "migrated_image.png", "id": "658915161561302", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12138838_187526161591862_770596670_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHM-9qxiuWkQ7kNvwGYYt6C&_nc_oc=AdqDldHPou6nM_Q_tH04H1l2b3LBIYLqxhNmbm-0Cj6Zah4jXlg6DoCBCs-RrFmKDhc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXOMvj_lo4JckMiAI0S33QQhqofklvma-0HmtO0mv3xA&oe=6B09BC39"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Esper 2", "keywords": ["adventure", "ancient", "explore", "puzzle", "scary", "temple"], "long_description": "\"Esper 2 improves on the original in every way.\" - VR Focus\nHave you ever dreamed about moving things with your mind? What would you do with such power? Here's what we would do. Esper 2 is a game about using telekinetic powers to solve puzzles. Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens. Travel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious multiple times. With an all-star cast, interact with a dynamic array of new characters, voiced by notable actors, Nick Frost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game. Solve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.", "short_description": "Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens."}]}, "developer_name": "Coatsink Software", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Coatsink Software", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "zh_CN"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "690471005663981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162698_647254262129833_8937871292808298496_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcBZ7q3C038Q7kNvwHswClQ&_nc_oc=AdofANzDJeX6zU1cdtKcuwpv86JWIGgok-W4jpFGIOE5HolEm-f4fCBvZk_8q32SsYw&_nc_zt=3&_nc_ht=scontent-s
qF7JsWdCL4Rj8AdBZRhfLgjN1SR0lu9Ri5y-8p_QuHYaB2RJ2D7L_w2IzrE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxBgza9XWElC0H4raJ94ne35QUtK8TBjcaw1fFan64MKA&oe=69BD509F"}, {"file_name": "migrated_image.png", "id": "137617814347959", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138835_1666230393589606_1940447322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3SCvZst5VAQ7kNvwHFdlxA&_nc_oc=Adm0fJVdgkFBbJ-NZrMtII0ngSf6fdX69eC4BzS5Gz6pZCpzjmeRGxOwfupIoTz3k4k&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSJAH36UyE0FlCTqFaksCi4DE1b-PoPQLEGCnZwYnBCA&oe=69BD3625"}, {"file_name": "migrated_image.png", "id": "658915161561302", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138838_187526161591862_770596670_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_FTTcAgV-7QQ7kNvwHvYoLl&_nc_oc=Adml2GolHm1753Kv6k0j4ttgImAAhWTaJYo0eyCXEV955gSWWpBZ5h1yQFOxYnFWw_4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxdV8_RfuKvzjkXc8UXw9Za2uYnBiwt78_afDy3Psc2IQ&oe=69BD49F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Esper 2", "keywords": ["adventure", "ancient", "explore", "puzzle", "scary", "temple"], "long_description": "\"Esper 2 improves on the original in every way.\" - VR Focus\nHave you ever dreamed about moving things with your mind? What would you do with such power? Here's what we would do. Esper 2 is a game about using telekinetic powers to solve puzzles. Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens. Travel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious multiple times. With an all-star cast, interact with a dynamic array of new characters, voiced by notable actors, Nick Frost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game. Solve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.", "short_description": "Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens."}]}, "developer_name": "Coatsink Software", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Coatsink Software", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "zh_CN"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "690471005663981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162698_647254262129833_8937871292808298496_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ga2eqA_ikdQQ7kNvwFndlsu&_nc_oc=Adn21lMgb3tr5ZrwVUqE78xmSEKcKZOTyFIGidv9vbTPran_3asDLz26zjIpA15oiRs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw5X-c75TFJqR3rd8aEuc1A6qBRp_Y-7_GJ-kC-p0cjrA&oe=69BD3A2E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Esper 2", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1449734400, "lastRevision": {"nodes": [{"id": "916769858405575", "release_type": "SCHEDULED", "administra
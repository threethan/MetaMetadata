6zWlcvU8Q7kNvwE0jDRq&_nc_oc=Adq_HQm5AcSXrteqRrM7VS9eyshMYNV_jf0gSHUIYJsm4AGqeC-evaZxWhrBKpDR7vA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-e5Emu6WklHrn3XMUDyfpQQt5thJvVamb0cwSG7KgDNg&oe=6A281A1F"}, {"file_name": "migrated_image.png", "id": "137617814347959", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138835_1666230393589606_1940447322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HKO5oPMCfUQ7kNvwEoTnlh&_nc_oc=AdoqtXje48-nu0d-bbO0_SmRd8tSnpGSgH8an045-v0fzymvvTauC7-xLWG4MItvMFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kp2Xh740xBw65wUsxypaVOEBmu0QJlGvX6LkZwID5cw&oe=6A2837E5"}, {"file_name": "migrated_image.png", "id": "658915161561302", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138838_187526161591862_770596670_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CTIexUyK1eoQ7kNvwFeQ2-8&_nc_oc=AdpB4XpPTOFVWRmnUaV8xjdzJd8qO-KgskZsWXwZuw7auF3yJKkwBZ1u2Q0Y7ePh8gI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HIy951j_gq8JoqdkQU6TI-Qu22_-nPdH3KrKlpjkLKg&oe=6A281379"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Esper 2", "keywords": ["adventure", "ancient", "explore", "puzzle", "scary", "temple"], "long_description": "\"Esper 2 improves on the original in every way.\" - VR Focus\nHave you ever dreamed about moving things with your mind? What would you do with such power? Here's what we would do. Esper 2 is a game about using telekinetic powers to solve puzzles. Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens. Travel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious multiple times. With an all-star cast, interact with a dynamic array of new characters, voiced by notable actors, Nick Frost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game. Solve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.", "short_description": "Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens."}]}, "developer_name": "Coatsink Software", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Coatsink Software", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "zh_CN"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "690471005663981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162698_647254262129833_8937871292808298496_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XK9rs4QfO_wQ7kNvwH43Z-7&_nc_oc=AdqNPkSodONBjsSv5eYDSvYlb_1c5KEvzaq9SrgAK7DRG9EvHBRKJliackOtC7Ph2tg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QuvakXd_98PqjFBRIUqfh5nfdCWDbCSdglFm9Gp1Aaw&oe=6A283BEE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Esper 2", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1449734400, "lastRevision": {"nodes": [{"id": "916769
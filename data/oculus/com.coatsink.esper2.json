ng", "id": "137617814347959", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138835_1666230393589606_1940447322_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYOcHtXiChAQ7kNvwEyPKqb&_nc_oc=Adnnq3q18wGsbNlK_BpVsPEma3SaP4V6rNsJNIyuXJKWEgp4uCmxJ-FR2a-7l6T0OB4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvSPUPXRXVDGZaRiZX9p_xgZDgCs4j3ZsZflNEsnh4leg&oe=69A57B25"}, {"file_name": "migrated_image.png", "id": "658915161561302", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12138838_187526161591862_770596670_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTg-1AO_I8oQ7kNvwGBYVAZ&_nc_oc=Adl9tHNfSizHS8ZA6CSBtv6z_2cBpuDE4BeWeb-3GutGRpW7kJqek_s0OaGyUmZrs7Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuD4EIhcoet1iEkRArh7PJuthxcYDgFtooydW2C8IUc_A&oe=69A58EF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Esper 2", "keywords": ["adventure", "ancient", "explore", "puzzle", "scary", "temple"], "long_description": "\"Esper 2 improves on the original in every way.\" - VR Focus\nHave you ever dreamed about moving things with your mind? What would you do with such power? Here's what we would do. Esper 2 is a game about using telekinetic powers to solve puzzles. Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens. Travel to exotic locations; solve puzzles, discover secrets, stop villainous plots, and fall unconscious multiple times. With an all-star cast, interact with a dynamic array of new characters, voiced by notable actors, Nick Frost, Lara Pulver, and Sean Pertwee, who join Eric Meyers, the esteemed vocal talent from the original game. Solve a wide range of unique and intuitive puzzles, while trying not to aggravate the game's characters, because they'll let you know if you do.", "short_description": "Reprising your role from the previous game, take up your new job as an agent of ESPR, an organization set up to deal with an outbreak of telekinetic powers among citizens."}]}, "developer_name": "Coatsink Software", "developer_privacy_policy_url": "http://coatsink.com/privacy-policy/", "developer_terms_of_service_url": "http://coatsink.com/terms/", "publisher_name": "Coatsink Software", "support_website_url": null, "website_url": "http://coatsink.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "de", "ko", "zh_CN"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "690471005663981"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162698_647254262129833_8937871292808298496_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJLZwPiD1KMQ7kNvwEcJXKG&_nc_oc=AdnhoyUDPP_O_1leUgO1SD4WGe8O_FAeuEaEToJt8_zbqRnNOMQ0OeYtHSpjKurqjMQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftsOVYVJIswwsQSKcMqyhx0Bys57UYElgpRN_GOJn0Vmw&oe=69A57F2E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Esper 2", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1449734400, "lastRevision": {"nodes": [{"id": "916769858405575", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "779304552192363", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email"
hyana/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8404490296272757"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1276307096834950"}]}, "baseline_offer": {"id": "1276307096834950"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732254060, "status": "PUBLISHED", "id": "1276307096834950"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9037646249623822", "version": "1.0.7"}, "id": "970193131578133", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8337946642927123", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9037646249623822"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "970193131578133"}]}, "change_log": "Authentication Removal:\nSimplified the user experience by removing the authentication process. \nUsers can now access the app directly without the need for login credentials", "created_date": 1735799019, "id": "9037646249623822", "version": "1.0.7", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nod
-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRZ136muZwd3WwwQhXTgOYVWLeCvRuq_J7rpMDvdUWOA&oe=69BD4285"}, {"file_name": "RiversideSerenity.png", "id": "1686825485497088", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75647715_1686825488830421_7855314277286972442_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WCmDYupztUQ7kNvwHCF80e&_nc_oc=AdkpaG1CdTX8LVZXW9rbpKp3j2P5-tibu3ivPL_BZVPhwKmBS-ItzIXshauw_hAPARQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZbuVc-GDttqBvhQesK-l4kAhmga1ERXiiPAUKGXHanw&oe=69BD5165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt1.png", "id": "435641968965144", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974735_435641972298477_4395841369576491320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVqJF0AQF4oQ7kNvwHCEHSp&_nc_oc=AdmHi0CRi-pVWctYCEKJPW6sZ6eWCx6GE34oplyJM-p6S1XmRR3isdbRgqvTUZKerjs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjywCTBjRILdC3aScG11Kh6xC8y7qfOxYhviXah6UXgg&oe=69BD360F"}, "display_name": "Dhyana", "keywords": [], "long_description": "Dhyana offers a transformative approach to healing, merging the ancient wisdom of Indian therapy with the latest in immersive VR technology. \nThrough carefully crafted environments, Dhyana guides users through the practices like, box breathing\u2014a time-tested technique for alleviating stress and anxiety. These immersive experiences are designed not just to distract from pain but to actively engage the mind in the process of recovery. ", "short_description": "Dhyana offers a transformative approach to healing, merging the ancient wisdom of Indian therapy with the latest in immersive VR technology. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://customtechnologies.biz/home/privacy/dhyana/", "developer_terms_of_service_url": null, "publisher_name": "Custom Technologies Design Lab Pvt Ltd", "support_website_url": null, "website_url": "https://customtechnologies.biz/dhyana/", "catego
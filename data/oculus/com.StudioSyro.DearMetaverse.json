g?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8je38YtRWlIQ7kNvwHNBknL&_nc_oc=AdrcQ17cuA1TvB50q8RcG4ybMNlGu5Ny4QNnmjGgfg0NipLoEe8wNiw8bDkHps7UlPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN2FjOGGW4Fz4x-pSEiHow2X2VRnAcy7p1nqhvyDPpKw&oe=6AF47ED1"}, {"file_name": "499618440_950057304264444_7510685055886344824_n.png", "id": "28798475659846985", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654859273_28798475679846983_5735251801408585129_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2ijxM2kHbgQ7kNvwGTJ11x&_nc_oc=AdqNFqcnO7Mz9Fqc0a6FG_WIuMyAnJjwMNaZf2kcW0WLnHybjaHIIZM56mlcLoP1CQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSfBBhrsKhGEZMqoUjGCh2LpmAVfe5HXkNuRgo5SpBpQ&oe=6AF4983E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "998541329583143", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311597_998541332916476_870158904082030328_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lP_1tMySoFkQ7kNvwHWkY60&_nc_oc=AdodJqSM7sSVDE-EOXhHFHBdS78qSl1AXoz1BqdHeNHG3YlvuB1B-71LkBBf1XHtJ08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQELnFgPXIMsrnceykpSOAkj4AVQ51T2pdxF0U15KlxTw&oe=6AF49F3B"}, "display_name": "Spatial Mailbox", "keywords": ["messaging", "communication", "mail", "mailbox", "creativity"], "long_description": "# Welcome to Spatial Mailbox! \nA new way to message your friends!\n\nUse your hands to compose and send fun 3D messages to your friends and pen pals! From birthday wishes to silly memes, getting messages is more fun with Mailbox!\n\n\ud83d\udcec **Send & Receive Spatial Mail**\n{1159832932967818}\n\n\ud83d\udcaf **Write Anything**\n\nType or dictate 3D messages with expressive fonts, depth, and animated effects.\n{1392716735572742}\n\n\ud83d\ude03 **Place GIFS & Emojis**\n\nAdd expressive GIFs, emojis, and effects to bring your 3D messages to life.\n{2041960456555294}\n\n\ud83c\udfa8 **Draw Masterpieces**\n\nCreate fun 3D drawings with simple brush tools!\n{876531158161591}\n\n\u2764\ufe0f**Send Fun!**\n\nSeal your letter up in a customizable envelope and ship it off!\n{1412554887182087}\n\nLAUNCHING SOON:\nHalloween and Winter packs\n\nSincerely, \n\nThe Mailbox Team\n\n", "short_description": "Spatial Mailbox is a free VR messaging app for exchanging spatial messages with friends. Use hand-tracked tools to draw, write, and decorate your message, then deliver your message straight to a friend\u2019s virtual mailbox. Will you send heartfelt messages or complete chaos? The choice is yours!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spatialmailbox.com/privacy.html", "developer_terms_of_service_url": "https://www.spatialmailbox.com/terms.html", "publisher_name": "Studio Syro", "support_website_url": null, "website_url": "https://www.spatialmailbox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "28936823872636742"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305050_1305721964221413_1378372331430779132_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgapxT6_9jIQ7kNvwHSBr8O&_nc_oc=AdoSIOOPAuEYaqZijJ82yln9zhkBi_0QWozwJxt_txZ8DPwGWP45iosm-PibcLvieM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn
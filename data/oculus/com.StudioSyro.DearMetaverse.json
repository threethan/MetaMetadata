ng?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uVdE0ReWJsQ7kNvwHP8nXk&_nc_oc=AdpvSyiTx1jPTJG88lIQdW-zq1VRorVsK7tx0bPkgfqCZeuLyC6o33WvIyaGztEPaPc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV4ILjJX3DztQ5ndFFIarAD5zMZMft4mEQmmf7LqSFSw&oe=6A6CB451"}, {"file_name": "SMB3.png", "id": "1887047132271629", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_1887047135604962_478297711471331395_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uXBkYhX5e0Q7kNvwGSBTJf&_nc_oc=Adqu77vQBnBGcPyKR3-0x2S34wWhgWlGkOWZKIPe47ZS_Tpq8Y0U90Z1-E_idq5bRlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnOx51c6b4sGwnADydghv1g8DPyB2O4HRKOFby6LNTsg&oe=6A6C8B3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "998541329583143", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311597_998541332916476_870158904082030328_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6kpL6AoX0QQ7kNvwHEQ49w&_nc_oc=AdqMaJcg1-AZ4xyH5XgKInRECSideZXBeydjsyf3MqXydcOLcD3NSwoKyn2wX_6BKiE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdEca6MePGCj11OsLiNJ_cWgM5ueplz0xnTZQyly2TRw&oe=6A6C9C7B"}, "display_name": "Spatial Mailbox", "keywords": ["messaging", "communication", "mail", "mailbox", "creativity"], "long_description": "# Welcome to Spatial Mailbox! \nA new way to message your friends!\n\nUse your hands to compose and send fun 3D messages to your friends and pen pals! From birthday wishes to silly memes, getting messages is more fun with Mailbox!\n\n\ud83d\udcec **Send & Receive Spatial Mail**\n{1159832932967818}\n\n\ud83d\udcaf **Write Anything**\n\nType or dictate 3D messages with expressive fonts, depth, and animated effects.\n{1392716735572742}\n\n\ud83d\ude03 **Place GIFS & Emojis**\n\nAdd expressive GIFs, emojis, and effects to bring your 3D messages to life.\n{2041960456555294}\n\n\ud83c\udfa8 **Draw Masterpieces**\n\nCreate fun 3D drawings with simple brush tools!\n{876531158161591}\n\n\u2764\ufe0f**Send Fun!**\n\nSeal your letter up in a customizable envelope and ship it off!\n{1412554887182087}\n\nOUT NOW:\nThe Summer Pack!\nMake your messages more tropical witrh over 12 new summer-themed emojis!\n\nSincerely, \n\nThe Mailbox Team\n\n", "short_description": "Spatial Mailbox is a free VR messaging app for exchanging spatial messages with friends. Use hand-tracked tools to draw, write, and decorate your message, then deliver your message straight to a friend\u2019s virtual mailbox. Will you send heartfelt messages or complete chaos? The choice is yours!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spatialmailbox.com/privacy.html", "developer_terms_of_service_url": "https://www.spatialmailbox.com/terms.html", "publisher_name": "Studio Syro", "support_website_url": null, "website_url": "https://www.spatialmailbox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "27767796936206114"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305050_1305721964221413_1378372331430779132_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jd5e7N5gQ1sQ7kNvwEg23Gg&_nc_oc=AdobySo3dAHBiW_gxLv_mSKcmWO6Jfxi6VnbhpHj4R25x0QBNwgdhawkxr38bXFgEBA&_nc_zt=3&_nc_ht=scontent-sjc3
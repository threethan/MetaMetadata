": "985226397159650", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307409_985226400492983_8207624562039533088_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjCQemmjHmwQ7kNvwGVX81u&_nc_oc=AdpEjTn3UYmm0fJAn5zyVEpqAdOzHe35YceGh2Oe_j8OrdHJelCynY7tHY8giPoTMZs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGK56bbqBUTMBjDtIRRH81FFZPh8odXTtAgkJ2l0li2w&oe=6AE0C2C5"}, {"file_name": "TextTool.png", "id": "1229645078120613", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296201_1229645081453946_2602537216809768206_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ta8c5xqR9rwQ7kNvwHF8SYH&_nc_oc=AdoNfDwnSPQaFgV-UW1UAnE9U7ZpZvvMFdPzJZUrVjT5RMEI1zpQLtp5a41nuAkv4ik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCBioMrd2_rvBZu0FhTVXX_LUqnH0FHcygB_O_D6qzYQ&oe=6AE0C961"}, {"file_name": "emojis.png", "id": "1440095157345894", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831273_1440095160679227_9175729624173159440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZA5Xu5f3wgMQ7kNvwH0Pet5&_nc_oc=AdryK2h6ieS73LfVWaWS5nzHW--59e0_WjLqGPHuIVkO47P1Mz_QU3uGe94buhxrXxg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI6r5hrAskFbRdaemtQ9TUpN9mBYanUuJUZx3sMxFk1w&oe=6AE0BEC6"}, {"file_name": "drawings.png", "id": "1250279539986138", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830032_1250279543319471_5762355672284679861_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrsQ5aNpzw8Q7kNvwH-eQP-&_nc_oc=AdqJ87j9eTvY92EtXgVg6v9k3MPtVj30StpQKjobYHlxvaJPgjp_qzt5jWgVtdOVrs8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMy63FhGk0yIG8ymtRFjjJP4luEAscvh_4Lwtmpz_jAA&oe=6AE0B337"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "758312620198178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298205_758312623531511_3363769476488943806_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoRUxuvLDeYQ7kNvwFGuJdL&_nc_oc=AdoiRXRn553fNXtW0PVDWVHZYbjQ2BxlLefZrJSBuaeVw52fNKmDFUcYVPpYxZGF1K4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH1xSbmqI95LwDn_REy7A7Afi0PGRXpqbuF77NHvLtDg&oe=6AE0BD3D"}, "display_name": "Dear Metaverse", "keywords": ["messaging", "communication", "mail", "mailbox", "creativity"], "long_description": "Dear You,\nWelcome to Dear Metaverse! \n\nHere, you can use your hands to make wild 3D letters and send them to your friends- Heartfelt confessions, chaotic memes, or whatever weird idea pops into your head. You\u2019ll get stuff too, straight to your own virtual mailbox- sometimes sweet, sometimes unhinged, always surprising.\n\nIt's a space to stay close, be creative, and just have fun with the people you care about.\n\nThis early version includes:\n\u2726 A working mailbox that shows when you\u2019ve got mail\n\u2726 Hand-tracked tools for drawing, writing, and decorating\n\u2726 Fully 3D letters you can grab, open, and explore\n\nSincerely, The Dear Metaverse Team", "short_description": "Dear Metaverse is a delightful VR messaging app for exchanging spatial messages with friends. Use hand-tracked tools to draw, write, and decorate your message, then deliver your message straight to a friend\u2019s virtual mailbox. Will you send heartfelt messages? Or will you create memes and utter chaos?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://studiosyro.com/dm-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Studio Syro", "support_website_url": null, "website_url": "https://studiosyro.com/dear-metaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "r
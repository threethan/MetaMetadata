0a&_nc_ohc=6zoOpfr1Gw8Q7kNvwEKTfT-&_nc_oc=Adpn3TovV4v4aFcA09iG8xX12MoiakoOLh5ACaE2jZUhAWFTwSqJERHPyZQZCRYlALE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJZfTT6D_7USLHv2s4ZeXH1GGBaZw3JniRrCUs-etFLA&oe=6A565146"}, {"file_name": "SMB2.png", "id": "971164351974681", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823790_971164355308014_49599584670862000_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tH5dlwXLmkUQ7kNvwGrmvhx&_nc_oc=AdrnnINVsQcOQ0X-jxx1IPGEOVeHzLX3ATyAxDOW-EJRCnCztS2aNc70b8jMha_S_ig&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmc48f3G3vzDE6Q01tHPWi7DiXC88pDYxdqUMZoUMIWQ&oe=6A564AD1"}, {"file_name": "SMB3.png", "id": "1887047132271629", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823341_1887047135604962_478297711471331395_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kJGsX4uS6_8Q7kNvwGYtOqQ&_nc_oc=AdpMD-5yTTkR0HAKy95CbvxM3KEd9Z-lElaSuQAbBoCupLuXFD3npOMnO30MZ-4fuBs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3ol1e3304x7MGFfvMVM53rvwPTIW-vCt4q73w6WRPGg&oe=6A5659FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "998541329583143", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499311597_998541332916476_870158904082030328_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XM3lkodd0kQ7kNvwFawu96&_nc_oc=Adp6K2GZBHLTB2zQ1hgfQ0RaRc7KbEu4tvcixLfa_jzwo2bK4T2k7iUMF0ebf1TdDfY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdLPTbLY5GrwgqiR0UfOoSsd84ebAtbec1K8d7WX0bEg&oe=6A5632FB"}, "display_name": "Spatial Mailbox", "keywords": ["messaging", "communication", "mail", "mailbox", "creativity"], "long_description": "# Welcome to Spatial Mailbox! \nA new way to message your friends!\n\nUse your hands to compose and send fun 3D messages to your friends and pen pals! From birthday wishes to silly memes, getting messages is more fun with Mailbox!\n\n\ud83d\udcec **Send & Receive Spatial Mail**\n{1159832932967818}\n\n\ud83d\udcaf **Write Anything**\n\nType or dictate 3D messages with expressive fonts, depth, and animated effects.\n{1392716735572742}\n\n\ud83d\ude03 **Place GIFS & Emojis**\n\nAdd expressive GIFs, emojis, and effects to bring your 3D messages to life.\n{2041960456555294}\n\n\ud83c\udfa8 **Draw Masterpieces**\n\nCreate fun 3D drawings with simple brush tools!\n{876531158161591}\n\n\u2764\ufe0f**Send Fun!**\n\nSeal your letter up in a customizable envelope and ship it off!\n{1412554887182087}\n\nStay tuned for seasonal DLC packs, new writing tools, and fun updates to keep your mailbox fresh and surprising.\n\nSincerely, \n\nThe Mailbox Team\n\n", "short_description": "Spatial Mailbox is a free VR messaging app for exchanging spatial messages with friends. Use hand-tracked tools to draw, write, and decorate your message, then deliver your message straight to a friend\u2019s virtual mailbox. Will you send heartfelt messages or complete chaos? The choice is yours!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spatialmailbox.com/privacy.html", "developer_terms_of_service_url": "https://www.spatialmailbox.com/terms.html", "publisher_name": "Studio Syro", "support_website_url": null, "website_url": "https://www.spatialmailbox.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULT
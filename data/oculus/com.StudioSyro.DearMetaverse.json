8", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830032_1250279543319471_5762355672284679861_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MKDzbvYI4sIQ7kNvwEwVzRC&_nc_oc=AdokmR74NUrtfcFT7rCr4HHI0uwV9pCmwytNO6nqiAnX1jtULb7tyo3YTVsH0BQz8Ko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfI35YhYSvFyBt_6gquHyl4vNpZxWiNp3ve5xG9SXdiA&oe=6A579737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "758312620198178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298205_758312623531511_3363769476488943806_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLsLGnxU42wQ7kNvwHS4YTV&_nc_oc=AdrmgoZg1EBiMJTbt4oB54CDBSa-36o2LBG2aRGuUrONu7FHn9GbYbC0XDnG-FW1sx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5uIHCY9baM0D1RuXCIqD_5qJKl2wZQ8uV3HA1vfOVkw&oe=6A57A13D"}, "display_name": "Dear Metaverse", "keywords": ["messaging", "communication", "mail", "mailbox", "creativity"], "long_description": "Dear You,\nWelcome to Dear Metaverse! \n\nHere, you can use your hands to make wild 3D letters and send them to your friends- Heartfelt confessions, chaotic memes, or whatever weird idea pops into your head. You\u2019ll get stuff too, straight to your own virtual mailbox- sometimes sweet, sometimes unhinged, always surprising.\n\nIt's a space to stay close, be creative, and just have fun with the people you care about.\n\nThis early version includes:\n\u2726 A working mailbox that shows when you\u2019ve got mail\n\u2726 Hand-tracked tools for drawing, writing, and decorating\n\u2726 Fully 3D letters you can grab, open, and explore\n\nSincerely, The Dear Metaverse Team", "short_description": "Dear Metaverse is a delightful VR messaging app for exchanging spatial messages with friends. Use hand-tracked tools to draw, write, and decorate your message, then deliver your message straight to a friend\u2019s virtual mailbox. Will you send heartfelt messages? Or will you create memes and utter chaos?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://studiosyro.com/dm-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Studio Syro", "support_website_url": null, "website_url": "https://studiosyro.com/dear-metaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24702560376063134"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1742104823830163"}]}, "baseline_offer": {"id": "1742104823830163"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782838860, "status": "PUBLISHED", "id": "1742104823830163"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27620456997606776", "version": "0129"}, "id": "566346189645884", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9146278305451259", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27620456997606776"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1783700407, "id": "27650787741240368", "version": "0130", "version_co
l, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "758312620198178", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298205_758312623531511_3363769476488943806_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=17btA1ZAv2UQ7kNvwG6r6pL&_nc_oc=Ado09KG4yX80N3beVovdIp6zR2t7X_N_H1JUyQfToU4doVjYRiMAntvinP7Y7kIUC5g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOIvLw25uUAsbyc1H0H745FsOMO1tp8w8hWbhblwMoBw&oe=6A9D80BD"}, "display_name": "Dear Metaverse", "keywords": ["messaging", "communication", "mail", "mailbox", "creativity"], "long_description": "Dear You,\nWelcome to Dear Metaverse! \n\nHere, you can use your hands to make wild 3D letters and send them to your friends- Heartfelt confessions, chaotic memes, or whatever weird idea pops into your head. You\u2019ll get stuff too, straight to your own virtual mailbox- sometimes sweet, sometimes unhinged, always surprising.\n\nIt's a space to stay close, be creative, and just have fun with the people you care about.\n\nThis early version includes:\n\u2726 A working mailbox that shows when you\u2019ve got mail\n\u2726 Hand-tracked tools for drawing, writing, and decorating\n\u2726 Fully 3D letters you can grab, open, and explore\n\nSincerely, The Dear Metaverse Team", "short_description": "Dear Metaverse is a delightful VR messaging app for exchanging spatial messages with friends. Use hand-tracked tools to draw, write, and decorate your message, then deliver your message straight to a friend\u2019s virtual mailbox. Will you send heartfelt messages? Or will you create memes and utter chaos?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://studiosyro.com/dm-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Studio Syro", "support_website_url": null, "website_url": "https://studiosyro.com/dear-metaverse", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "cont
&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmfIKcYVBz6mVpdFTrgKGKS_ilKpGjE1dU2ZecPyR0NQ&oe=69B7ED2D"}, {"file_name": "d2.png", "id": "1348747349771776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393425_1348747353105109_5857341392316421343_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ux2v_rfZz8Q7kNvwGTySZg&_nc_oc=AdmTe5E4ROCKVCutKCLSEjVOCtrDT_qvCQQcloWHhIRmysc7OCNBtN6W3iEHhd5ZUZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfztlHprpHWjZ386yMvQwfeqPbnBKgf7_Zv0HqtuUWYuhw&oe=69B8138B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440 (1).png", "id": "1172724274267644", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473392103_1172724277600977_3293392158693963099_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBK-MRR2fugQ7kNvwGSk2rE&_nc_oc=AdkMwcQ_LpLN2VCWJ1wikIfqXF4RXSdjVXXpNg-tmPzcZDR6rZorgtMEL0k4hbYY51E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwtHERXFqcJ-XCiJpgg9r8sif9cTstBAUD7X2oPBy3_sA&oe=69B7F19D"}, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "keywords": ["puzzle", "MR", "handtracking", "adventure", "sandbox"], "long_description": "THE LOCK is a mixed reality puzzle adventure featuring brain-teasing lock puzzles that can be deciphered through magical locomotion and spatial teleportation. In the mysterious world of THE LOCK you will find yourself immersed with:\n\n- 55 mind-teasing, carefully crafted puzzles, intricately devised through multiple layers of spatial complexity. Each puzzle has a unique theme accompanied by a soothing music soundtrack and an ancient riddle to unfold their own mystery.\n\n{923875563145359}\n\n- Unique spatial teleportation mechanism that take player through multiple layers of geometry to solve complex puzzle, where player need to plunge inside and zoom outside between virtual and real world (like in the movie \"Inception\").\n\n{924025185989756}\n\n- A puzzler that is super easy to learn, both comfortable and relaxing to play. Playable either in the comfort of your home (MR mode) or in the middle of mysterious ocean (VR mode). Intuitive hand-tracking is also supported.\n\n{1080607603374929}\n", "short_description": "THE LOCK is a mixed reality puzzle adventure game featuring brain-teasing, artfully crafted puzzles that can be solved through magical locomotion and spatial teleportation. Player can plunge inside puzzles like in the movie \"Inception\". MR see-through and hand-tracking are both supported for more comfortable and intuitive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1FS8x5FSTlzzehIqNSESRjB7LBqhj-GkuHriRpBUXprM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/the-lock/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29858759143768671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392107_919073630212859_5645905122871550324_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mcjOme76DoQ7kNvwFDuJTl&_nc_oc=AdnPwj6wVG04ty56liMr49-zXXfpqeun7OXlE6OfOR4y7cLIchIsNJkaKcN_wEDFjI8&_nc_zt=3&_nc_ht=scontent-
0_5041851538174696694_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQAfT-qaXz0Q7kNvwGHVEme&_nc_oc=AdrQG7EGMt84jx7UxFeGRu5ejktaAG8R08A8Tjm52-bat5T0yFRbu59fceFjVNy1BTg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ciJnPSYd4Pq1FIsOEwPoKpKTZrnXxHnmVC8eMUPV7JQ&oe=6A47CCC7"}, {"file_name": "20241202-230117.png", "id": "1107653664085990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003253_1107653667419323_8933847123868056455_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reGntIKYxP4Q7kNvwEzROZN&_nc_oc=Adqtg6hnELHxcazLwcyJ7jusfXDg2RcRvTBRUIHcVZIcWMoy_IU3LYKHJPT7RSDLVJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s-J64KKiWlj6FSw_LlTAwmoFYy3iG-eDBNO6SrMIa5w&oe=6A47D8ED"}, {"file_name": "20241202-230124.png", "id": "1107129930796893", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974842_1107129934130226_300948338118447476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dnyp_TubsaYQ7kNvwH6whzJ&_nc_oc=Adr3neUQEy1eXSXEoLmqGGFDYIBYAXPIpEM2vm5K-IiM-c8tFK8PXIZrmplMB_-GJMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86iMyQLTBmvHoYfGbSFTwF5aDp6qEJZuGhXZl7YDvk4g&oe=6A47B9DC"}, {"file_name": "20241202-230100.png", "id": "1936185390209332", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036659_1936185396875998_2445752291192180561_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg2ye8XJ2Y8Q7kNvwG19C-v&_nc_oc=AdqzGSmNwnnoQXI2kN98qcZ4K1wWmTkMZ7Ik9IXRrOn-KfPPsJIqmymNDL59ewUt5G8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R6cAqlZJFhorKhArpCYfzvFs7-SymEl1YzTT_K4tbbg&oe=6A47ADD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440.png", "id": "892983949714000", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468707676_892983956380666_6380856907655038511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sutDH3IXHKIQ7kNvwEbYZDT&_nc_oc=Ado3KApMjmvP9fJOujqmTZMf8SlXrOrGLwbh9I7JSTTwq6bQElWGEgX8cb24B2wT7Os&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9snTpnjRrhw8q0uAsk8YAmUA0qmmVglpJ7Gbu-FC2ffQ&oe=6A47CE02"}, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "keywords": ["puzzle", "MR", "handtracking", "adventure", "sandbox"], "long_description": "THE LOCK is a mixed reality puzzle adventure featuring brain-teasing lock puzzles that can be deciphered through magical locomotion and spatial teleportation. In the mysterious world of THE LOCK you will find yourself immersed with:\n\n- 30+ mind-teasing, carefully crafted puzzles, intricately devised through 4 layers of spatial complexity. Each puzzle has a unique theme accompanied by a soothing music soundtrack and an ancient motto to unfold their own mystery.\n\n{923875563145359}\n\n- Unique spatial teleportation mechanism that take player through multiple layers of geometry to solve complex puzzle, where player need to plunge inside and zoom outside between virtual and real world (like in the movie \"Inception\").\n\n{924025185989756}\n\n- A puzzler that is super easy to learn, both comfortable and relaxing to play. Playable either in the comfort of your home (MR mode) or in the middle of mysterious ocean (VR mode). Intuitive hand-tracking is also supported.\n\n{1080607603374929}\n", "short_description": "THE LOCK is a mixed reality puzzle adventure game featuring brain-teasing, artfully crafted puzzles that can be solved through magical locomotion and spatial teleportation. Player can plunge inside puzzles like in the movie \"Inception\". MR see-through and hand-tracking are both supported for more comfortable and intuitive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://skycampstudio.com/the-lock-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "http://skycampstudio.com/the-lock/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_
Si8fGyKsLaMDx5Pj0IjpwvxcZf7QzlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BkOdTctQu7ril0FFxKK2tzfC_c3DEVuL9VnORTpJ5JA&oe=6A0D9EAD"}, {"file_name": "d2.png", "id": "1348747349771776", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393425_1348747353105109_5857341392316421343_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlC1r6rC15UQ7kNvwGwP26i&_nc_oc=Ado2VXfD-Wu062m2Sv42RjD29Lv7-wfjGLndiB8tCN_1gD0t1AHK2kaNZs6HJOOS6sg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NedPhHlWp2T2YjREra_Ok9_aOxgODnf2lrQkqrq9F5Q&oe=6A0DC50B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440 (1).png", "id": "1172724274267644", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473392103_1172724277600977_3293392158693963099_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAf5JjQUyVwQ7kNvwHi80co&_nc_oc=Adp0T54wHWxRll-wW5RpJ4X1hm1b395PM2V-h9T-hDq8hy9WR9NWNu1S_ztfrquQCK8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nUt8CN_fGz5pNfvtQrV-U5PZ4YyQpgVtCc-ccTn8vZw&oe=6A0DA31D"}, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "keywords": ["puzzle", "MR", "handtracking", "adventure", "sandbox"], "long_description": "THE LOCK is a mixed reality puzzle adventure featuring brain-teasing lock puzzles that can be deciphered through magical locomotion and spatial teleportation. In the mysterious world of THE LOCK you will find yourself immersed with:\n\n- 55 mind-teasing, carefully crafted puzzles, intricately devised through multiple layers of spatial complexity. Each puzzle has a unique theme accompanied by a soothing music soundtrack and an ancient riddle to unfold their own mystery.\n\n{923875563145359}\n\n- Unique spatial teleportation mechanism that take player through multiple layers of geometry to solve complex puzzle, where player need to plunge inside and zoom outside between virtual and real world (like in the movie \"Inception\").\n\n{924025185989756}\n\n- A puzzler that is super easy to learn, both comfortable and relaxing to play. Playable either in the comfort of your home (MR mode) or in the middle of mysterious ocean (VR mode). Intuitive hand-tracking is also supported.\n\n{1080607603374929}\n", "short_description": "THE LOCK is a mixed reality puzzle adventure game featuring brain-teasing, artfully crafted puzzles that can be solved through magical locomotion and spatial teleportation. Player can plunge inside puzzles like in the movie \"Inception\". MR see-through and hand-tracking are both supported for more comfortable and intuitive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1FS8x5FSTlzzehIqNSESRjB7LBqhj-GkuHriRpBUXprM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/the-lock/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29858759143768671"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392107_919073630212859_5645905122871550324_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZXuouyG85sQ7kNvwHSqlC0&_nc_oc=AdpViOItRl8bONwYflTtAuU7f6VxRBJa1qQNvdKBK
0_5041851538174696694_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQAfT-qaXz0Q7kNvwG_LMc5&_nc_oc=Ado_WFhaS7gyXcN-LCnNJmbs6Vev47RsYCixUnZXHicXHo46o_xZlwapd8UFfLAnOic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKcdt98m-hzjLxCqTWO8dC0XdPMA0e9y5XQ2H_wa8fbA&oe=6A4A6FC7"}, {"file_name": "20241202-230117.png", "id": "1107653664085990", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003253_1107653667419323_8933847123868056455_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiCVPQqu4xgQ7kNvwHA95Ao&_nc_oc=Ado7l_CMzYjDdr2oL_Ji__y0CIAtkW-uhdCTD3h4yq62D-1YubKJVQFYBGNfaE1c6-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM9k-WPEMO16e0Qw4f5r0RR6o3pZpJeggznNSFbC0PSA&oe=6A4A7BED"}, {"file_name": "20241202-230124.png", "id": "1107129930796893", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974842_1107129934130226_300948338118447476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW8MUbTOBLEQ7kNvwFzwtxY&_nc_oc=AdpgC2AT8wSzYPffg57_igJb6hcvvzMBqvbkofO4LDR01BbnXLtQo5_uHH_OTKrZz3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSJGU8wE36PXLEYoeAKOaeHuW8rJHgqzxoJaIrFO6GYg&oe=6A4A5CDC"}, {"file_name": "20241202-230100.png", "id": "1936185390209332", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036659_1936185396875998_2445752291192180561_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6mzaUgJlYcQ7kNvwHlHxiQ&_nc_oc=AdoLVwEv3hf2ZghuE1ObYdzFUC6lz_y12E36zEG17HgEHsmXqJfJriqGiYSki8qqnNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1hgPhgZRG9AV_TK1H7N927ZaA_wNQ-wIkJEAMj0WpUA&oe=6A4A50D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440.png", "id": "892983949714000", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/468707676_892983956380666_6380856907655038511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5eQDRaM7b8Q7kNvwFP-okY&_nc_oc=AdokVqHli0YfXYscoqsH3_07aeks4O_aPNjTiegNdYtlbGiq8Ej3rLrDqKwhaHrcPW0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwkOePPTFtHzqUVThUsS48RPWOe7L9ya6ilixr8cqQMg&oe=6A4A7102"}, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "keywords": ["puzzle", "MR", "handtracking", "adventure", "sandbox"], "long_description": "THE LOCK is a mixed reality puzzle adventure featuring brain-teasing lock puzzles that can be deciphered through magical locomotion and spatial teleportation. In the mysterious world of THE LOCK you will find yourself immersed with:\n\n- 30+ mind-teasing, carefully crafted puzzles, intricately devised through 4 layers of spatial complexity. Each puzzle has a unique theme accompanied by a soothing music soundtrack and an ancient motto to unfold their own mystery.\n\n{923875563145359}\n\n- Unique spatial teleportation mechanism that take player through multiple layers of geometry to solve complex puzzle, where player need to plunge inside and zoom outside between virtual and real world (like in the movie \"Inception\").\n\n{924025185989756}\n\n- A puzzler that is super easy to learn, both comfortable and relaxing to play. Playable either in the comfort of your home (MR mode) or in the middle of mysterious ocean (VR mode). Intuitive hand-tracking is also supported.\n\n{1080607603374929}\n", "short_description": "THE LOCK is a mixed reality puzzle adventure game featuring brain-teasing, artfully crafted puzzles that can be solved through magical locomotion and spatial teleportation. Player can plunge inside puzzles like in the movie \"Inception\". MR see-through and hand-tracking are both supported for more comfortable and intuitive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://skycampstudio.com/the-lock-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "http://skycampstudio.com/the-lock/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_
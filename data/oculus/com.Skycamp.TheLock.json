JBi1cV9hwroAZGP4NVM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs1ttf4QdtL5QDhfLk9-PMoaGD6PTwjEgad5GFiNcNfwg&oe=69A985DC"}, {"file_name": "20241202-230100.png", "id": "1936185390209332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036659_1936185396875998_2445752291192180561_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2vjnJOjQkYQ7kNvwGST-8v&_nc_oc=AdnzbfXFj5GExfqrIV7CVpmnpmUXs3eRFbfnWfV44rRiuJWDyU0JoI7b2YfXiYtBgOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftn-28dJvM7uNwRJbs4TYleBENP1v7KD37j9fCCDh5Sdw&oe=69A979D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440.png", "id": "892983949714000", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/468707676_892983956380666_6380856907655038511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ztd3rdoD37wQ7kNvwHT0dKU&_nc_oc=AdnVNWWQ1n5y1GayuqLlgKe2dvS1wXfK0QmU4lwoQBfZmzlJG_qG-mwDvsqaPYDkaiA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afuy_0gBdkZPNNE-pf2hLe9UcgpgCK1KRSWbJ4M99bhiSg&oe=69A961C2"}, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "keywords": ["puzzle", "MR", "handtracking", "adventure", "sandbox"], "long_description": "THE LOCK is a mixed reality puzzle adventure featuring brain-teasing lock puzzles that can be deciphered through magical locomotion and spatial teleportation. In the mysterious world of THE LOCK you will find yourself immersed with:\n\n- 30+ mind-teasing, carefully crafted puzzles, intricately devised through 4 layers of spatial complexity. Each puzzle has a unique theme accompanied by a soothing music soundtrack and an ancient motto to unfold their own mystery.\n\n{923875563145359}\n\n- Unique spatial teleportation mechanism that take player through multiple layers of geometry to solve complex puzzle, where player need to plunge inside and zoom outside between virtual and real world (like in the movie \"Inception\").\n\n{924025185989756}\n\n- A puzzler that is super easy to learn, both comfortable and relaxing to play. Playable either in the comfort of your home (MR mode) or in the middle of mysterious ocean (VR mode). Intuitive hand-tracking is also supported.\n\n{1080607603374929}\n", "short_description": "THE LOCK is a mixed reality puzzle adventure game featuring brain-teasing, artfully crafted puzzles that can be solved through magical locomotion and spatial teleportation. Player can plunge inside puzzles like in the movie \"Inception\". MR see-through and hand-tracking are both supported for more comfortable and intuitive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://skycampstudio.com/the-lock-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "http://skycampstudio.com/the-lock/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27894321333545805"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1090823416504601"}, {"status": "PUBLISHED", "id": "1986572881927842"}, {"status": "PUBLISHED", "id": "1547005760011437"}, {"status": "PUBLISHED", "id": "558515210636910"}, {"status": "PUBLISHED", "id": "871527468475103"}]}, "baseline_offer": {"id": "871527468475103"}, "is_approved": true, "firstOffer": {
0_5041851538174696694_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX7Nt2LhHO4Q7kNvwEQH3wF&_nc_oc=Adp6Ym1dmh09hAjub7skpEpkJldipRSsg82lULGnSmF2rsTPsFk9018Y_Yp2AS9aeXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0FNzez6jKauQFrC4MfAZcY5hFf4k4DDTyafPE5nDcgA&oe=6A4286C7"}, {"file_name": "20241202-230117.png", "id": "1107653664085990", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003253_1107653667419323_8933847123868056455_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nWhfU7DXQqgQ7kNvwFhOwx1&_nc_oc=AdoKPjLEaPT1gMp1S3odo-9A_MDJxwLdH0KpHQge1muKIBnRctnN7yDfV0GxzEOo3E8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91iKRdpW5pIO3hU8m3XaYKGzvs3gagLdFHiaP2vL8P0g&oe=6A4292ED"}, {"file_name": "20241202-230124.png", "id": "1107129930796893", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974842_1107129934130226_300948338118447476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kprXXuErAZ0Q7kNvwHibqHs&_nc_oc=AdrhmhjGQXv7M3CCsbyrsQYKMMAUbQwkEq6Hdtrgcj55CM6PfYD0ENASDrekzDU0CMk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jBU00w5q7sn0FdkqrvlzRNi-Mjnfli71EpTijVvdxLw&oe=6A4273DC"}, {"file_name": "20241202-230100.png", "id": "1936185390209332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036659_1936185396875998_2445752291192180561_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7rgqxaDm8oQ7kNvwG7etER&_nc_oc=AdpMs8rXyAgN-bxJ71kS4XYYva2_DrtEO9-znZgJsEbq8U38DW27T4_DSmA-b_QnS6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K5tHFVrmHW5RL74Yh664QAND0Yw1SoPLOc0QVLpri3Q&oe=6A4267D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440.png", "id": "892983949714000", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468707676_892983956380666_6380856907655038511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kj_Qur4mkwgQ7kNvwEonj1g&_nc_oc=AdqWB7EmZXupre8I7bL16SOc3sK0rr390dhy6abIUcNx45f3x2eyMSJ1REiYOzHMxwI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vnq-EvFMtb_KzTMAIp6zb2b_VwvvHumOG-D5oF8oh4A&oe=6A428802"}, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "keywords": ["puzzle", "MR", "handtracking", "adventure", "sandbox"], "long_description": "THE LOCK is a mixed reality puzzle adventure featuring brain-teasing lock puzzles that can be deciphered through magical locomotion and spatial teleportation. In the mysterious world of THE LOCK you will find yourself immersed with:\n\n- 30+ mind-teasing, carefully crafted puzzles, intricately devised through 4 layers of spatial complexity. Each puzzle has a unique theme accompanied by a soothing music soundtrack and an ancient motto to unfold their own mystery.\n\n{923875563145359}\n\n- Unique spatial teleportation mechanism that take player through multiple layers of geometry to solve complex puzzle, where player need to plunge inside and zoom outside between virtual and real world (like in the movie \"Inception\").\n\n{924025185989756}\n\n- A puzzler that is super easy to learn, both comfortable and relaxing to play. Playable either in the comfort of your home (MR mode) or in the middle of mysterious ocean (VR mode). Intuitive hand-tracking is also supported.\n\n{1080607603374929}\n", "short_description": "THE LOCK is a mixed reality puzzle adventure game featuring brain-teasing, artfully crafted puzzles that can be solved through magical locomotion and spatial teleportation. Player can plunge inside puzzles like in the movie \"Inception\". MR see-through and hand-tracking are both supported for more comfortable and intuitive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://skycampstudio.com/the-lock-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "http://skycampstudio.com/the-lock/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_
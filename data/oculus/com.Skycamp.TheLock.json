oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEp4Q-0h-QPv1LIkmtJiFecr2p-3ZFFzrtWczu22PjPw&oe=6AC7A88B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440 (1).png", "id": "1172724274267644", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392103_1172724277600977_3293392158693963099_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0gZCg7Mz7cQ7kNvwHrxfcL&_nc_oc=AdrqJlzF7OWiLSekuCYLPSfZa3LYozbt-qPNe-tFisFCn-OQBaoMl8WsI8FOQV4uJ30&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNW5OhUKT74Uaey82Z4WeTjRfjmVoCCwxZkIIAv-lGJA&oe=6AC7BEDD"}, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "keywords": ["puzzle", "MR", "handtracking", "adventure", "sandbox"], "long_description": "THE LOCK is a mixed reality puzzle adventure featuring brain-teasing lock puzzles that can be deciphered through magical locomotion and spatial teleportation. In the mysterious world of THE LOCK you will find yourself immersed with:\n\n- 55 mind-teasing, carefully crafted puzzles, intricately devised through multiple layers of spatial complexity. Each puzzle has a unique theme accompanied by a soothing music soundtrack and an ancient riddle to unfold their own mystery.\n\n{923875563145359}\n\n- Unique spatial teleportation mechanism that take player through multiple layers of geometry to solve complex puzzle, where player need to plunge inside and zoom outside between virtual and real world (like in the movie \"Inception\").\n\n{924025185989756}\n\n- A puzzler that is super easy to learn, both comfortable and relaxing to play. Playable either in the comfort of your home (MR mode) or in the middle of mysterious ocean (VR mode). Intuitive hand-tracking is also supported.\n\n{1080607603374929}\n", "short_description": "THE LOCK is a mixed reality puzzle adventure game featuring brain-teasing, artfully crafted puzzles that can be solved through magical locomotion and spatial teleportation. Player can plunge inside puzzles like in the movie \"Inception\". MR see-through and hand-tracking are both supported for more comfortable and intuitive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/the-lock/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36619206701057181"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392107_919073630212859_5645905122871550324_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrL-RR8eNM0Q7kNvwGHDp5T&_nc_oc=AdrxK2htW2RdT_3xF_gh9TElVARIhWPtWKSg1a1saQVVzHZlCSIA3laIRbO86Sy3Wi4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyjHbcK7KASi7eM4v_43yvJE4HOy9ueERUJ6BN4o8E4Q&oe=6AC7A6AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Tabletop", "id": "1676485315806614"}], "release_date": 1735393980, "lastRevision": {"no
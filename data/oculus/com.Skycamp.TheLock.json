0_5041851538174696694_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aK23Qra4hGcQ7kNvwHQBzUE&_nc_oc=AdrJf4zI_DAwszPN9zMd4jga_Wta7pZ76LYNIfd5Lz33YiQXcqC_n8a8x4QWmLYQ-u0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYPnNqBBVX5EjE5LqEAvcRNF1OnzfZu6PN2W_1eoOozg&oe=6A4BC147"}, {"file_name": "20241202-230117.png", "id": "1107653664085990", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003253_1107653667419323_8933847123868056455_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DiCVPQqu4xgQ7kNvwFa9-E1&_nc_oc=AdoI-ErXgLmhNmj7QMfD4GPbUqev7_lf7NViBVkykZh91P8qii9USLrKnc4K9NsrHYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxzYzdC3FC_UUMp-Aj1A9LYO_q10vylUk9zAD9b5auuQ&oe=6A4BCD6D"}, {"file_name": "20241202-230124.png", "id": "1107129930796893", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974842_1107129934130226_300948338118447476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW8MUbTOBLEQ7kNvwElUhgK&_nc_oc=AdrtQj5fdDy_7Ps3R68c33X-UfW0Shv5MMfTN-t4Fzyv288UuMM5ko1ztYMkILqe6ck&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-jQ6Slj1TRH5E0aPUjvrGf9MRGJXYbpg1AyofFhWOxw&oe=6A4BAE5C"}, {"file_name": "20241202-230100.png", "id": "1936185390209332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036659_1936185396875998_2445752291192180561_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6mzaUgJlYcQ7kNvwGnhmkz&_nc_oc=AdpEt9NsN5HBvjx9c_0Q6aXUUM0129jCez2K-dzAL2eBXX6RD6T9XtFN6orx0NKjpeY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-XVtKyej_dl8byFcCthW_2yLN-hEua3ROQl9tPTtDUg&oe=6A4BA255"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440.png", "id": "892983949714000", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/468707676_892983956380666_6380856907655038511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5eQDRaM7b8Q7kNvwFq4Zp0&_nc_oc=Adq8CXYapV1ByBsJne2J3BZwy66XIcAmEkv-yrFdiyWf3t5hyxl3Zu3UJtSsyqoZ9CQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8rPobfl0RGcskn1L_-0jn-9sBfyBVdoCth0OQAvcQiw&oe=6A4BC282"}, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "keywords": ["puzzle", "MR", "handtracking", "adventure", "sandbox"], "long_description": "THE LOCK is a mixed reality puzzle adventure featuring brain-teasing lock puzzles that can be deciphered through magical locomotion and spatial teleportation. In the mysterious world of THE LOCK you will find yourself immersed with:\n\n- 30+ mind-teasing, carefully crafted puzzles, intricately devised through 4 layers of spatial complexity. Each puzzle has a unique theme accompanied by a soothing music soundtrack and an ancient motto to unfold their own mystery.\n\n{923875563145359}\n\n- Unique spatial teleportation mechanism that take player through multiple layers of geometry to solve complex puzzle, where player need to plunge inside and zoom outside between virtual and real world (like in the movie \"Inception\").\n\n{924025185989756}\n\n- A puzzler that is super easy to learn, both comfortable and relaxing to play. Playable either in the comfort of your home (MR mode) or in the middle of mysterious ocean (VR mode). Intuitive hand-tracking is also supported.\n\n{1080607603374929}\n", "short_description": "THE LOCK is a mixed reality puzzle adventure game featuring brain-teasing, artfully crafted puzzles that can be solved through magical locomotion and spatial teleportation. Player can plunge inside puzzles like in the movie \"Inception\". MR see-through and hand-tracking are both supported for more comfortable and intuitive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://skycampstudio.com/the-lock-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "http://skycampstudio.com/the-lock/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_
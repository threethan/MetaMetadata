": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031647_438266685996924_8179681639688953815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PG2c-lXgDYIQ7kNvwEHwEHt&_nc_oc=AdoAH_7t2m91cfGhSx3IoGI7DIdIkPUeB504BSV19V-eOg6LJqG3tdR7KWhyxUTXr18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xDM_Xl2Itvvl8z2zsk5SwM3eyyZE0EWPgTfyJbBBNMQ&oe=69DE3CCC"}]}, "id": "2075825119515870", "locale": "en_US", "screenshots": [{"file_name": "20241202-230136.png", "id": "1711623913020102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_1711623919686768_8711437443453864251_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcvEul3B3YgQ7kNvwGqmy2u&_nc_oc=AdqsxMuVxtwZmzb-Vd21Yisr5KsO072AhhZ292PTkWp2BDbVk6yKY8IROjCkxTFTbyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YPkC8O-TAZakOUY2gx-DI2nFVvCpI9nHImKWZognj_w&oe=69DE214E"}, {"file_name": "20241202-230145.png", "id": "567856426029467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974877_567856429362800_5041851538174696694_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4DF6huBUmIQ7kNvwFk_EVD&_nc_oc=Ado6ElElullhnQoKy6Qik4m1vy5ZA-zjFiXzjfGknfqRQlcm1l5bsccIUhpHVmOnIe0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x3cvRp7JnhqffCfvTdB9kKJJsBQNfYt-ss0xoHEbo-w&oe=69DE54C7"}, {"file_name": "20241202-230117.png", "id": "1107653664085990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003253_1107653667419323_8933847123868056455_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBV9xsiAjX4Q7kNvwEjWM1Q&_nc_oc=Adq0RdznW-oMDo18asYl_6rqsEvDKaUIXwMKDSQVIi9DEwQr7BAnkjWc9maN4vTRZhY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rq-1knN9bBJ5Av36LLFtyU42qrADlJc1KIbeWokjOEQ&oe=69DE28AD"}, {"file_name": "20241202-230124.png", "id": "1107129930796893", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974842_1107129934130226_300948338118447476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urAw_IHT8wUQ7kNvwHLLOQV&_nc_oc=AdpanjMeBylUhd4y4syJbkxmQ7ac6uKGbmTJh_PaXdpGnAwai-yGpysIdpKi_NtSIwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y2qRiiQffLD2EmQC-Q6RUnTkoNwn5RIPnFdVfbwBs0g&oe=69DE41DC"}, {"file_name": "20241202-230100.png", "id": "1936185390209332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036659_1936185396875998_2445752291192180561_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ewl9jyh4gSoQ7kNvwHUgOvi&_nc_oc=AdpE5POAl8Gx733WY3viaZZsU1nWhXydvgnsvpbG-rMRAykjkct0fix7nK2GQINq4ik&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RbIPoD6Bl6l4qd1yffp5R_nqfYRbPHhkkOsj9HkRfFg&oe=69DE35D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440.png", "id": "892983949714000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468707676_892983956380666_6380856907655038511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-aa75Re-dwQ7kNvwF-HSyA&_nc_oc=Adq-cwPKWFH81kyK2nYaORmWVe8x0PkjkO9j9KwlDh1c80uAV61AbSNTvyFLTCTmQac&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Zh2s6e2fdHskT7SBzh3C9GESPLUZiiHQ3cY2uJuxS5A&oe=69DE5602"}, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "keywords": ["puzzle", "MR", "handtracking", "adventure", "sandbox"], "long_description": "THE LOCK is a mixed reality puzzle adventure featuring brain-teasing lock puzzles that can be deciphered through magical locomotion and spatial teleportation. In the mysterious world of THE LOCK you will find yourself immersed with:\n\n- 30+ mind-teasing, carefully crafted puzzles, intricately devised through 4 layers of spatial complexity. Each puzzle has a unique theme accompanied by a soothing music soundtrack and an ancient motto to unfold their own mystery.\n\n{923875563145359}\n\n- Unique spatial teleportation mechanism that take player through multiple layers of geometry to solve complex puzzle, where player need to plunge inside and zoom outside between virtual and real world (like in the movie \"Inception\").\n\n{924025185989756}\n\n- A puzzler that is super easy to learn, both comfortable and relaxing to play. Playable either in the comfort of your home (MR mode) or in the middle of mysterious ocean (VR mode). Intuitive hand-tracking is also supported.\n\n{1080607603374929}\n", "short_description": "THE LOCK is a mixed reality puzzle adventure game featuring brain-teasing, artfully crafted puzzles that can be solved through magical locomotion and spatial teleportation. Player can plunge inside puzzles like in the movie \"Inception\". MR see-through and hand-tracking are both supported for more comfortable and intuitive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://skycampstudio.com/the-lock-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "http://skycampstudio.com/the-lock/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27894321333545805"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1289112749779309"}, {"status": "PUBLISHED", "id": "1090823416504601"}, {"status": "PUBLISHED", "id": "1986572881927842"}, {"status": "PUBLISHED", "id": "1547005760011437"}, {"status": "PUBLISHED", 
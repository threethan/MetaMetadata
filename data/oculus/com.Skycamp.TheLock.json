": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031647_438266685996924_8179681639688953815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXbqhXJ8biwQ7kNvwHvlsEH&_nc_oc=AdrWtu2OeJRpte1QNUtwoXhPVOoqupfyhkcsxKSptR6uQplBqWCTZKReM9FsCFvWFE8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0YUEGtxhEgR_NNNPk1iU2TXsyPi67b5fLM5B4Ttk6Pmg&oe=69F354CC"}]}, "id": "2075825119515870", "locale": "en_US", "screenshots": [{"file_name": "20241202-230136.png", "id": "1711623913020102", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974676_1711623919686768_8711437443453864251_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMouCn9P6v0Q7kNvwGFUM0O&_nc_oc=AdowBgLUlgXZtnZ2ritzXsJ-XogHoTp4h8EEdGbrxex-2o44EIESpwouH1ARdLsu_XI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NthYPuVBQ6PmhNE1kmJm5mAst2wAhHfskZk03sxrmSw&oe=69F3718E"}, {"file_name": "20241202-230145.png", "id": "567856426029467", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974877_567856429362800_5041851538174696694_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biJvylM76p8Q7kNvwHPikdU&_nc_oc=Adr036AhOBcGP5yWMXGgBC4Wq4eMxLOl8PL-IXk7M1oBDANvODOLkCMbrVULRcAQOlo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1zw8fbFbIxrguiRcY2igqWWSA84jYRmEjrU3Mti1_6yg&oe=69F36CC7"}, {"file_name": "20241202-230117.png", "id": "1107653664085990", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39003253_1107653667419323_8933847123868056455_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVjQtIvnnkMQ7kNvwEKmSFE&_nc_oc=AdoPBy8KRv2xDc3rKuoxrBta90LnS2-zCs6ARnVbuWwYoWlOjuhFAo9YlPRbALk9CNY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af28a2ab65NTyX9XgyF136KC63RqQpwVxvhmbKFH1HRPHw&oe=69F340AD"}, {"file_name": "20241202-230124.png", "id": "1107129930796893", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974842_1107129934130226_300948338118447476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvSeWh3xZb0Q7kNvwFOwYd7&_nc_oc=AdpJVL-ipLNABhY2K-J95A8DV3c01Jajlmt3-w738O37kOgW6zWfgfrZZ_hqnIRBNw0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05ZEo1mIvw27ZAdvAhhov7y-7NK1Yf4KYoqjcBGs9Y5A&oe=69F359DC"}, {"file_name": "20241202-230100.png", "id": "1936185390209332", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036659_1936185396875998_2445752291192180561_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjlGtx3IqSEQ7kNvwFkubiC&_nc_oc=AdpxPJznVy4k4eCOi-A6e1g07W5U0iNNSQDOCJzaznXLuvWxMT7PDZAocEGTrmUetk8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25y43NoUa_8YT-o59HcgJJRP7ri4QV3bx7aaLofQ59pg&oe=69F34DD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440.png", "id": "892983949714000", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/468707676_892983956380666_6380856907655038511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hg0bsY8KEQ4Q7kNvwGZx7xv&_nc_oc=Adp9HkvyIxw9e9cgL7NG_jhzLydX_4IeczD1r6qsfylyp2-qkFehyoDzeWdcNSvHB4A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af370CvaMDdvzfu9gXpT_WRC6_W-Zao9ZuMdwScXHUBWeQ&oe=69F36E02"}, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "keywords": ["puzzle", "MR", "handtracking", "adventure", "sandbox"], "long_description": "THE LOCK is a mixed reality puzzle adventure featuring brain-teasing lock puzzles that can be deciphered through magical locomotion and spatial teleportation. In the mysterious world of THE LOCK you will find yourself immersed with:\n\n- 30+ mind-teasing, carefully crafted puzzles, intricately devised through 4 layers of spatial complexity. Each puzzle has a unique theme accompanied by a soothing music soundtrack and an ancient motto to unfold their own mystery.\n\n{923875563145359}\n\n- Unique spatial teleportation mechanism that take player through multiple layers of geometry to solve complex puzzle, where player need to plunge inside and zoom outside between virtual and real world (like in the movie \"Inception\").\n\n{924025185989756}\n\n- A puzzler that is super easy to learn, both comfortable and relaxing to play. Playable either in the comfort of your home (MR mode) or in the middle of mysterious ocean (VR mode). Intuitive hand-tracking is also supported.\n\n{1080607603374929}\n", "short_description": "THE LOCK is a mixed reality puzzle adventure game featuring brain-teasing, artfully crafted puzzles that can be solved through magical locomotion and spatial teleportation. Player can plunge inside puzzles like in the movie \"Inception\". MR see-through and hand-tracking are both supported for more comfortable and intuitive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://skycampstudio.com/the-lock-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "http://skycampstudio.com/the-lock/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27894321333545805"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1289112749779309"}, {"status": "PUBLISHED", "id": "1090823416504601"}, {"status": "PUBLISHED", "id": "1986572881927842"}, {"status": "PUBLISHED", "id": "1547005760011437"}, {"status": "PUBLISHED", 
": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031647_438266685996924_8179681639688953815_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKQO3WTu_f0Q7kNvwGnP1Dt&_nc_oc=Adoj3KE4OD0y2PC5IcvzC2ndQjYomNvnQGPn7ailFCL50dzMSxZNWRGeF0c2YtrVoUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DJ7XzjMRudGEggGQS9N2sT5FT3pbPmZDai3xRbKB4MQ&oe=69DA484C"}]}, "id": "2075825119515870", "locale": "en_US", "screenshots": [{"file_name": "20241202-230136.png", "id": "1711623913020102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974676_1711623919686768_8711437443453864251_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNNCzfKNOAEQ7kNvwHFMDYF&_nc_oc=AdriQqVb_u3xmQ5TD6eithlvEQrOQnsYTq9SuFF3bBpj-g0QqZjAhntqpKPoXbCJDwo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ks1C2HTHu9HBOT4UXAICcsaBk1BAZjrpiYcEla8ss_Q&oe=69DA2CCE"}, {"file_name": "20241202-230145.png", "id": "567856426029467", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974877_567856429362800_5041851538174696694_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qm1F2hMif6cQ7kNvwFAnOvY&_nc_oc=Adoj9My-eUVSA6wZ4mFQpOxJvmAN2wT3wtQNXAH-ULeKqcHF536NsRIyQdA0VJRDCqs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lPxAlNEyrzKjUA211lnl10UslulnbBkIIliB74e-JhA&oe=69DA6047"}, {"file_name": "20241202-230117.png", "id": "1107653664085990", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003253_1107653667419323_8933847123868056455_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmVjoQUADtUQ7kNvwGvQ91X&_nc_oc=AdrfbWecqJdoFc_9cXmwUWr-z6JZi9FyG88eMy9WD9eA0sK5pvF0AahM2rwHt9_hY54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ROeTkA1O5Tb2jZUBlw6u3xc5Axrb2aUSsLNNyd2gFVA&oe=69DA342D"}, {"file_name": "20241202-230124.png", "id": "1107129930796893", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974842_1107129934130226_300948338118447476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uER_GyLX4o0Q7kNvwGz2_0T&_nc_oc=Adop4CFiqSN_XFQpGQOEARKQGMoxnA-ednhNDsXyNx48yEKxxOWLKloVoEmC2eQYFpk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Pxp5kjU4wPXRuixgP5pLDqGYxhBQTJUWDGtb7sw3Ovg&oe=69DA4D5C"}, {"file_name": "20241202-230100.png", "id": "1936185390209332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036659_1936185396875998_2445752291192180561_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LywQCLU2JCsQ7kNvwENY-Oq&_nc_oc=Ado0WGqan2s9elyx9XUankm55Z9_1ANTceqy2JwCvLID9PkAmOA3DyG22Sl64zBgXlE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w-7lmiMz1-hYybmq4ice1FRzSbGvx-Ul9O8bz_9BXSg&oe=69DA4155"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-Image2560-1440.png", "id": "892983949714000", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/468707676_892983956380666_6380856907655038511_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voB6ECp0XUYQ7kNvwHaZrj9&_nc_oc=Adq1hb7MY6gOZaGrZcpoF8s5tPHg5YDlbawiV6uA4r1gayfQrMTFUC2LycUWXtveQ_E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2E2afpqIR2vncZjvPofJi6QZb3W46wCs1W69C5EEm0FA&oe=69DA2942"}, "display_name": "THE LOCK: Mixed Reality Puzzle Adventure", "keywords": ["puzzle", "MR", "handtracking", "adventure", "sandbox"], "long_description": "THE LOCK is a mixed reality puzzle adventure featuring brain-teasing lock puzzles that can be deciphered through magical locomotion and spatial teleportation. In the mysterious world of THE LOCK you will find yourself immersed with:\n\n- 30+ mind-teasing, carefully crafted puzzles, intricately devised through 4 layers of spatial complexity. Each puzzle has a unique theme accompanied by a soothing music soundtrack and an ancient motto to unfold their own mystery.\n\n{923875563145359}\n\n- Unique spatial teleportation mechanism that take player through multiple layers of geometry to solve complex puzzle, where player need to plunge inside and zoom outside between virtual and real world (like in the movie \"Inception\").\n\n{924025185989756}\n\n- A puzzler that is super easy to learn, both comfortable and relaxing to play. Playable either in the comfort of your home (MR mode) or in the middle of mysterious ocean (VR mode). Intuitive hand-tracking is also supported.\n\n{1080607603374929}\n", "short_description": "THE LOCK is a mixed reality puzzle adventure game featuring brain-teasing, artfully crafted puzzles that can be solved through magical locomotion and spatial teleportation. Player can plunge inside puzzles like in the movie \"Inception\". MR see-through and hand-tracking are both supported for more comfortable and intuitive gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "http://skycampstudio.com/the-lock-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "http://skycampstudio.com/the-lock/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27894321333545805"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1289112749779309"}, {"status": "PUBLISHED", "id": "1090823416504601"}, {"status": "PUBLISHED", "id": "1986572881927842"}, {"status": "PUBLISHED", "id": "1547005760011437"}, {"status": "PUBLISHED", 
ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974753_422862763571688_4983364457357549015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dKuA6fAleZ4Q7kNvwEg5KXq&_nc_oc=Ado3epDZyzVaCmTeOz3ky_kH3QeCiJvEokzT0PSutxpKLW02TqBLJpzw5iGBLSKWJAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0M4EIuQvQNI11xPWE5xLyTIe-RaQBUnWbdNsLEjigNBQ&oe=69F09CAE"}]}, "id": "1636738150446325", "locale": "en_US", "screenshots": [{"file_name": "\u672a\u6807\u9898-1.png", "id": "380239744821656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625133_380239748154989_7491302269616489662_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kUHZScGHMHIQ7kNvwH9SmLD&_nc_oc=Ado_TrDaHoxL2ORX2SVVx86NuvpLhMEuwcCe1sTVuQG6nbTME1vqrHPcjmjBpPnR5X4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0uzzzpYRTBtoJ6VSBStuMvobf-MlKNBD787KY2bXvoxg&oe=69F0A382"}, {"file_name": "\u672a\u6807\u9898-2.png", "id": "700011775544485", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_700011778877818_7456029647155466558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y-jgZyIsSfoQ7kNvwF8aqil&_nc_oc=AdrFmn_dp9xnDOD-bROOtare6UYH4KxMMruLv3RuPlrBqbkG_qeLIdqb-Ayu_Q2HRmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2J7jVjwjDun-CJZrlS97kyoYM_G3f-f7CQflXnFXPNTQ&oe=69F0D189"}, {"file_name": "\u672a\u6807\u9898-3.png", "id": "946317580531345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575356_946317583864678_8273661520756002294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3hg11WJxr-8Q7kNvwHthCeR&_nc_oc=AdoTa9FkapFmas4kTLg6SWwjdnmA-wNf0gavBPJztSoYidBA0IN9jOg5jvDXuyBtYfA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3xf385t0lAUD3bthciwi4iGJB4B_zgbnYt8ky-ektDtg&oe=69F0B9EE"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em4SeksdE1wQ7kNvwGHdtO5&_nc_oc=Adoe2frcOg2ffwVmbSxyxlS_s252mE9yv4r6uaKcPjgSWokz6u7l6lzp7k15HWPRBQk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3_m8A4haucXsPjOtCgR937Z5i6f8hBgkc38La31VRgHA&oe=69F0C236"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgYUaXVgKfkQ7kNvwGL_1HS&_nc_oc=Adrf4FhDCdJMdKemO6epgcYbriufTYIaYzg7SX6Agq1PyB3-XawNGsLTcJ75IPKmJ1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0XOuQpX2m5VqmF0aP3G06LckTFvNi-gID97cK2qihDwQ&oe=69F0A2D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9khZV73ExuMQ7kNvwGKJFZ3&_nc_oc=Ado70duhVWZ_eQswFVlAQtSF0s9cvfwE3Dp5UGg0YOleTJOsLMjZwuLA_YADV70wy88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0ZsFpPc_fteCSFh73ogZfgfQMRYusCI5m6jui2JBlF3w&oe=69F0A349"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "8063455167001253"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "361235854569
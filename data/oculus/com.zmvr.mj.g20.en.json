": "422862760238355", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974753_422862763571688_4983364457357549015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9k8J8FzF4MQ7kNvwGHtTBN&_nc_oc=AdnJA4UqRrnmldAsonBONYa14puHtOCKXvX4MSyQBgGOuPyxH_VIPD55Z4dpKKn-nXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaPbQu3DlypJnRI-YTKkCimYWK_d8PzZ6hDSFLr4MJ1A&oe=69B69AAE"}]}, "id": "1636738150446325", "locale": "en_US", "screenshots": [{"file_name": "\u672a\u6807\u9898-1.png", "id": "380239744821656", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86625133_380239748154989_7491302269616489662_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NljZXPOxLXwQ7kNvwECzsFd&_nc_oc=AdlX1cz8sU6xarK-jNm3gvCgqd12D4inR523TrajrOftWCjbqQ3k2kTHMPj3VnCs6eU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfykQYQuPTzvMVpzv_RmLWqJsnTd1cJjewgpJOWBPBsXew&oe=69B6A182"}, {"file_name": "\u672a\u6807\u9898-2.png", "id": "700011775544485", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036602_700011778877818_7456029647155466558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKFnJXYmjmcQ7kNvwErIpzv&_nc_oc=AdmxQoUxO5kOykB19_fR08EtpzSHZrYSsODNAABSQqG62L3MGo5HLU5gwutpW0-V8jk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNez3u2bgKpN_52srYfts56slTQk_lCUpiqkKvO3h1bw&oe=69B69749"}, {"file_name": "\u672a\u6807\u9898-3.png", "id": "946317580531345", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575356_946317583864678_8273661520756002294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndMlqYGokCMQ7kNvwGewve1&_nc_oc=AdlgK_QsUia3ysq1hO0i5PAcZkxC3fU_5tf4X2V8Ata69VHs1MF8rRNdexT3_LuuLdk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1mEgzaX08x7DsoKzdJ7R5ehnT0fhk2B-IKY6hvUcBAw&oe=69B6B7EE"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fbc2vURy0CsQ7kNvwHRJ8zY&_nc_oc=AdnFltrpAxjsaFQbrokI76bY8MJQPfH3L7P_CTJIk6HbvKUO_-xXDa6eXZwIWpCR_Uk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPkO5VP_s3rsSP-lQwTzxRfAXrr9oGjRmI9URgYhSXFw&oe=69B6C036"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7tDbbo7BcMQ7kNvwFPbF1o&_nc_oc=AdlmbfNRaVOr3ABIFQyjJ8nSryVKbpZIQcFqD88ZQSo_jxdnjrj8MXu_tqUSIndE9Cs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxA7ukIHdCFat25e9b_jYmZeHi23t0KdC-Sj7yYxt4IHA&oe=69B6A0D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wba6nfDdGpcQ7kNvwHB3xMh&_nc_oc=AdlcAGaFTZ8CXzEDW0AQ9P-bQ0BcsyYxIfbBeq2I96he-2cXj44LZPBNlYpvq7jrUs0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyaku5S_LLWHFYJwziVJwVa8Xx06mkqQy2hnf6WonyDdg&oe=69B6A149"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGL
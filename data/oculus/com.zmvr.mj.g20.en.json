ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974753_422862763571688_4983364457357549015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG6NQyOfy90Q7kNvwFB6_xq&_nc_oc=AdmkBF68yEAMkP42vJvWyNc45eLjbrHsKg_C9UjAKB2Bh26nXyrPLwn-D0YsFDT23G0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsKDWXXOEWvyC9xgfKReVycwkNHhTVS643KziF4rzeoeA&oe=69A2D42E"}]}, "id": "1636738150446325", "locale": "en_US", "screenshots": [{"file_name": "\u672a\u6807\u9898-1.png", "id": "380239744821656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625133_380239748154989_7491302269616489662_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFVYUilGOhUQ7kNvwGGoxuq&_nc_oc=Adl-Af_ZiSdG2zA2gSKmMRGxSVGIGe2b-jQXrqEDYga6kcIuYyyJrSGeH2HRGQZzsi8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsFn_vltRYg6B0PqBwLw-Nq_eWTnnx843DMtb583hzgwQ&oe=69A2DB02"}, {"file_name": "\u672a\u6807\u9898-2.png", "id": "700011775544485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036602_700011778877818_7456029647155466558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGBxgQ0RoAMQ7kNvwGWbcLf&_nc_oc=AdkbVD_cRiZtBVhrJF24K8P_9GeSLDIDxy5eld0el4-AthY_b1LkIwtlKRVB0KFg38o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftZo1yR-G8RwxocYMnw_j0qBv64Uh1_vkwq8CouuGsE2Q&oe=69A2D0C9"}, {"file_name": "\u672a\u6807\u9898-3.png", "id": "946317580531345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575356_946317583864678_8273661520756002294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud0MnjdxCvwQ7kNvwFlbqV6&_nc_oc=AdlUfIf4d0WMmddOKoBVk-0V1hZW0W3QEAGvI2BVVpfxIXqFk2fr59xfc0dY3xYp3xI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuHl3hU_ODR4bgzBQvzAee4JXp25DBmTLp7-88WdRAn3A&oe=69A2F16E"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUpcLuAALOcQ7kNvwEeW9ZL&_nc_oc=AdlEsyeaRlenE8GkbwMBwTbug-qSKGbCueUJNnfOIrRQzFIgRPT8WmI9s2cQkZD8n8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvV-GuAZKWRMu5lDVEpPHSwZIl2QOyFneQTKvSA3IL-0A&oe=69A2F9B6"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL3V1x9K45EQ7kNvwELqkmg&_nc_oc=AdmbFUXXMvxZArFj2qhIdViK-QeITkN_UKRsLclQedYgR0WpQ9LAz28TWBHnzOhlqOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftQA3mMyNjgFdBLC9m9nol5cPH1vOfeRoizGpmCuZurQw&oe=69A2DA50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpvak-gN2OoQ7kNvwGlRVqu&_nc_oc=AdnMy3hJPd-8XV8EVkDfIDC1W--3hh-Trl7P8E3YtC9woGix4v3DJUSa8yABgUuPYZs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsmMZcRRP_k4tTFQL783xn5TrMXhPbalRfB5JlGlQFlAw&oe=69A2DAC9"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "8063455167001253"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "361235854569
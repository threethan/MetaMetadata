=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8asDf_B9fjgQ7kNvwHkFmW-&_nc_oc=AdpIKCa_wP2qcDU9t7muIV4Swsa9KL_YGwuGXjKFCn4vdavTvUSeFZSGa7LdM0NYAPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQga1WyWgRmFjq4Pq2cYf49-eihIu-X5g4SanudpMBQrg&oe=6B071EAE"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDMONqfOsMkQ7kNvwG54Wju&_nc_oc=AdqQvkBo05JQ8hu6lS57mVD1_bgzrBCo8skmFSDutrkD7DLLzbYgmFcJP_ACmj1bMjE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_zK1zbt1j6NfjE0ufoYWAcKdXY8XK-fQKCYckKkNr6g&oe=6B0726F6"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoW69aORh2IQ7kNvwHNZebe&_nc_oc=Adq-f_m-AdDiePv2zi_nWLT_yv09zQOZDoNeqJPuFuiUqOptP8hpU3eXvxqMNcZ3Z08&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5puUqn21OPMOK50pjf089u04360QqPjwnnDIlGEoHcw&oe=6B070790"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeU-8iFGxicQ7kNvwG3WV90&_nc_oc=AdpjCM9JGHyLkV9Ppth_HvQKmMTpcR8DTxu7o7nsjCnTorCVl8ljHnMW20X03S_CPAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKCKZDFv7eWrILmomR2YHcaz3PWqgXOjWfOoN8cYfWuw&oe=6B070809"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496848
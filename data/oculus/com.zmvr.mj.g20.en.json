512 - \u526f\u672c.png", "id": "422862760238355", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974753_422862763571688_4983364457357549015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDlWz4MqRykQ7kNvwH0fNdc&_nc_oc=AdphCqI-bBflZyzwgXL4eK93fTFSVVcZ7YP6mB1r-finHrBxJz3Jazxg-X0Bk81xqC4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LtlRZPJbt38li0Zq-TX1CNpN6s3P9tvxhdQN_u43OWQ&oe=6A1078EE"}]}, "id": "1636738150446325", "locale": "en_US", "screenshots": [{"file_name": "\u672a\u6807\u9898-1.png", "id": "380239744821656", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/86625133_380239748154989_7491302269616489662_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcVFDAa4KfsQ7kNvwH0UIbV&_nc_oc=AdrCEalSJj-n26Hy8ZN16RnAt4z4MeEaSB-wRYI6TD8YN2FCp97Q8AEKFplA3nd_DmQ&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Z83lAHWt608r0yWBBGlLFhM2QavxA2cyvV250texTAw&oe=6A104782"}, {"file_name": "\u672a\u6807\u9898-2.png", "id": "700011775544485", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036602_700011778877818_7456029647155466558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhOwNENnkoMQ7kNvwFvNo1O&_nc_oc=AdoarDkZ3yOhWqXmLzX3hkc7-f9689ohz-OWpx14m82ewG9i7rjyfxbct6jBPxtjS-k&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PX3TCX2UTehwYs3FjBN2CJDwUqwlmrJgnO55V6QVblQ&oe=6A107589"}, {"file_name": "\u672a\u6807\u9898-3.png", "id": "946317580531345", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57575356_946317583864678_8273661520756002294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtEC0LnVbGAQ7kNvwHDh7xP&_nc_oc=AdqxXjqCoIGGbp1piCqZqq_9GQ_1Zxsq1SVK_Te7x21g56gqDbQZF4PxGVHRResPSrw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65UMEqpvRCFwDN8EMyLLF0TShR03ay-0keus-QztayPQ&oe=6A105DEE"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eqpbd-wQ12MQ7kNvwEg4P6P&_nc_oc=Adrv_HJd69UK5HEX6mAY1b14cexyjK_gFd2gCjMlqn7LJYlS6BlUfLAL5QicTZzF7_E&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uxFpX7hCMPEWXrGyEcOA11Z_oOBjUELrBRRU6suSzEw&oe=6A106636"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNNEIiHABIQQ7kNvwGyp6R7&_nc_oc=AdqaRVPf8CcuBAUIQ5L99iT2IMTYJJX7b4barv5hSCOCNKyLKOeuBRsUqJbyyI0J2-c&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7u_b8xwptHAkI_XC2c1qRhabuz8X7InktdIynAZv564A&oe=6A107F10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8zV4gWZJ6kQ7kNvwFugzu_&_nc_oc=Adrf2awwbhjnA8F6PHqGSofknGiaNlIOBrDckPgBvFxx9hXG3Mb9yCNeIxoXdSgJ1WE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uh4l73dfqesyxNzmw0SkZDNBed4mhRqFvS6kaKfwauw&oe=6A104749"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], 
file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vIVf1dFsEsQ7kNvwE1XHmf&_nc_oc=Adomq4aF5Lhw5l21KFFPWDUcGPrkKJYmp7vuBSNPO4Ev60dIF2gDcwRMAkrwM6GXVJU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3Uhq6frmGwW9IXYU-_Y8qoXGMkOaWdUIu6VUBLLDtiw&oe=6A7D9A76"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sl0Oe1JAJVQQ7kNvwF5RCt8&_nc_oc=Adp1gWb43Ju7D0RsErm0Z2NTtzBj25pukpFQtoKnbbpl-3Z1TywPQCjjwamI4kI42N0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOdLtvCQa5j2BF_5d9Y7PqAfFKxZl490pjMjFMd3RNnQ&oe=6A7DB350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Af2e3sRmB6AQ7kNvwGHgwkz&_nc_oc=AdqkXPlabR9Ec63AOAZXkD43BLXwNaF-btQ_FjEO4S5p0eK5tMhQP9IvYZzErWsXI70&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-xc7TC83lnkanv88EuimmhrZANrrUVQM5Nnx_eKe7HQ&oe=6A7DB3C9"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974753_422862763571688_4983364457357549015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r65fEDyGD4YQ7kNvwFL-mYY&_nc_oc=AdmiO7RHpOq_TOAraiWOjd6H0PwgRLH9FcV2DiVLiYTiyFhiFwqTLCIZjF4j5PqyKd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvtfBbVYuPv3PHKdHum8QxhYeeq3Ut-nFGtmdCrQVz15Q&oe=69A6C8AE"}]}, "id": "1636738150446325", "locale": "en_US", "screenshots": [{"file_name": "\u672a\u6807\u9898-1.png", "id": "380239744821656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625133_380239748154989_7491302269616489662_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmd5fFo-BcsQ7kNvwHyp_Av&_nc_oc=AdkhFyJ0aYPtuyUBPUB4Dvvk8OUNnA9qKWTOJ0V_FTloFtp1ESyRHt9qPzC8TKjOoNU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft-xVgmoFlreLPrZ6m7UhQp3dpKJUrQh66IOUbslKIEfQ&oe=69A6CF82"}, {"file_name": "\u672a\u6807\u9898-2.png", "id": "700011775544485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036602_700011778877818_7456029647155466558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-V0O_SA0BoQ7kNvwGrh8M5&_nc_oc=Adl1z6yRvBRPLx4I5MAgvUEm3QBCg5bwbsv2Byk6mPmyDMWUOa3pgy0eUsmXODdszUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu8hnCRaA0GW_knF0Z0F9sz73chqxNr8orM5EVsoawVpQ&oe=69A6C549"}, {"file_name": "\u672a\u6807\u9898-3.png", "id": "946317580531345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575356_946317583864678_8273661520756002294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PRjyHwt2ygQ7kNvwH4hX4f&_nc_oc=AdkOlSa2r32D-NCG3l_oNHPLbdOY1Zc8e1p-jQoj6ayhkktVhi05flmEVMKydhHtRKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftlTvZprKCYHih0bYHPGH7cVLVmu9DHhcrw_7NdSw4Zeg&oe=69A6E5EE"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81Ny_DCn0BIQ7kNvwHrytOv&_nc_oc=AdmurCiKO7Jv8PFrhDliyKfwuwVVnoSEhEI4_I3y490bNJOF4Yawj0IfW2-6oXOjF0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftqokD5s0ZvXsxycNvE7Mmlslqd68YkQznzvkdUzWi3Eg&oe=69A6EE36"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxoV-FR1Pc8Q7kNvwH2nkEy&_nc_oc=Adlc2yq9e7t-2bNFqt-kyvtcrsTAIDnuWZS4ulnyXreMFYLbF550NaUC3sk3kh9jOG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvr2jzDr-SN_EF61msPAmgd9naat1eigvXqaFeSHBhiug&oe=69A6CED0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiHkeC09ZPEQ7kNvwF1zBu3&_nc_oc=AdlfN2EDuHRX33bvNRsnbmesHXpeGU9gFqOuQTycAtxcI67GrnB4ZznWwaYyuT34tt0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs7Bzt7Ol2qZEJOqVM5-Hy5hFEaHHRtcbSNRzeL_lNbqg&oe=69A6CF49"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "8063455167001253"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "361235854569
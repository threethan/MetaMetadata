ps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974753_422862763571688_4983364457357549015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S58sfj6CdHIQ7kNvwGy23gH&_nc_oc=AdkqnRvcW6ErB5dEb9Kx-UcOLf-TL6zSA8gCdq8Q2sCeyn3PFIfTW7X03ws-LTYO69U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfteFupAdDc2TN1ASPRquyh_Z_XnbdCmWP0v8q6ePZKc0w&oe=699999AE"}]}, "id": "1636738150446325", "locale": "en_US", "screenshots": [{"file_name": "\u672a\u6807\u9898-1.png", "id": "380239744821656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625133_380239748154989_7491302269616489662_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StfpomUtnEgQ7kNvwGtI30-&_nc_oc=AdlP5PVdH9pJ77QyF1FYi_BB-4Zuka4YcoozszqZke0P6RKkz56JjS82R_hPNAroEHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aftkg4STb4NRtKrJWn5zzTzNfiCoSlBZUSA9eBfpDpKaUQ&oe=6999A082"}, {"file_name": "\u672a\u6807\u9898-2.png", "id": "700011775544485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036602_700011778877818_7456029647155466558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3MtDWzlR8YQ7kNvwE5HStm&_nc_oc=Adn7oNZw50kL44SBK9upf4iAW-p7lh92RK_YIL4aBHzm_m6VE5DRC4CPRhWWoOMNZiE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsgGBX2OsF1D1jC8gDVUBoac5xYnPmdAbeKK6OLbDKaHg&oe=69999649"}, {"file_name": "\u672a\u6807\u9898-3.png", "id": "946317580531345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575356_946317583864678_8273661520756002294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ia9Rg7YqWKAQ7kNvwHrYqJd&_nc_oc=AdmiZN75pQD2f2GZUx79lDRHUYu5-QR3AEyWDg_skAGOwe2CkjElS-_1PaFivhoXOOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftfVcCgvGP7yf1bSHDj5LnqN4kB2g3WpvvqzuFnvW-s7A&oe=6999B6EE"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3iPYrcvFpsQ7kNvwFnTZ_r&_nc_oc=Adl3Mzm4PY0tXrF-mcjxVYrzWM_UvVyzwxZDGW0Z3tcgaj7GCSYAy_aUf3HiFJ6Vkj8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsKLX72WbFUo3Xp5aTkI6vF_gw0aBg2NXJB45o5cFUjlA&oe=6999BF36"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uwP45ploGwQ7kNvwEFMwkY&_nc_oc=AdkW0EbUcCgVw_JoYEFMNR2nNhSMIasYQNGDDm4Ne5CWJk5HXk78khqFdcWpbB1zwuM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvtV6bQGXzX6K4QFYCPFl2oukuB7dL1K263Yb8ClIhiJw&oe=69999FD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vcq3hQU2G8Q7kNvwEQ7kfX&_nc_oc=AdldqiORJ2e-qjG1ckrUG8P8BgSXA1cgM5vfsN_3xzlrWaKXqWws7_eMwSftUgyWARc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftmLU2iN_AdwVxoj9WSTrsbX_BSNHHeCiozUDX05wiWGQ&oe=6999A049"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "8063455167001253"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "361235854569
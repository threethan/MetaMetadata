": "422862760238355", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974753_422862763571688_4983364457357549015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lDMogUUCB8Q7kNvwFpq08g&_nc_oc=AdlZklyQFAuZNQttXKs11BesuCCoi6KO8fowxf-ZqJB_U381vEE89XUMSJCn3MlPFS8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3UE8FbO4Tr0S4Ep2kZOAmu_uXY_Py1CFQyFjeqN36Mw&oe=69B2A62E"}]}, "id": "1636738150446325", "locale": "en_US", "screenshots": [{"file_name": "\u672a\u6807\u9898-1.png", "id": "380239744821656", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86625133_380239748154989_7491302269616489662_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pudUFJ4IJnYQ7kNvwFS3B4t&_nc_oc=Adlwjfk_2ryqLmon-YXc3bh1ueBY0fhpmv4ulUM2GzmOpRXGmgcLcMFp0_YsDH3TEwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxIzSEPRHmMVNccSGbTn6--0i_dsBBlN2zp93R3DE_uQg&oe=69B2AD02"}, {"file_name": "\u672a\u6807\u9898-2.png", "id": "700011775544485", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036602_700011778877818_7456029647155466558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p11OVczwvmgQ7kNvwGoLm_t&_nc_oc=AdmeiGwzK3RJ6JqZlYHmi2fI-teZOMy5vp673vFbVLbxEQFiR25tGD9OvgwDGe-rk3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxqbnhVWTikyHD7Tzgs0ydY1F9A1FBb6tNTST_4JR8sXA&oe=69B2A2C9"}, {"file_name": "\u672a\u6807\u9898-3.png", "id": "946317580531345", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57575356_946317583864678_8273661520756002294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OV-I00Xn8EsQ7kNvwEy71NU&_nc_oc=AdlYYr-LiDVWryAc-SX12B0CJVr8S823Pu0H5gkcsLeoFEWyqoa-hT2eR50M1yVmE8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyFSYYRovCKJyyMZ8rTSw1ZKo93j3Sb7fjc0dU_7PvTWA&oe=69B2C36E"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9EvyDOzV1gQ7kNvwHkeoKU&_nc_oc=AdmzUwe4Gn771H-GLlzRaM2iUNkjBky9J9cUaOnENtKp_cgaFl6Ean3Syatk2Z37xdw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwOGGYukfKdkxWSlW594pwBn3tuTfRDAlmWybH4JpsL8A&oe=69B2CBB6"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TPhm9og1MIQ7kNvwEq9STI&_nc_oc=AdnHrF-K1smRMOqkrrvzn_dNS3HAfNjnobPl3m_RJGgXoIRSCsFBojioTgD8_9eB--I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyogKt1yam-rN7bw-31ctvA016UKcriL_Z3ZmCX8Z2wZQ&oe=69B2AC50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iafl-QHBdmMQ7kNvwE_a82A&_nc_oc=AdnK2Z98Rea0j8y0QEd0XV6Wv8Z6Ibj-aqo5Ygr2OOdtBFmekuwJZbO8dnWp5qY0ga4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyHYlNOqbYJZmX2u-_sKxVkTooMX6gw7i8qoQg5Ku87BA&oe=69B2ACC9"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGL
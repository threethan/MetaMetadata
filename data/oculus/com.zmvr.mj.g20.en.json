b-512-512 - \u526f\u672c.png", "id": "422862760238355", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974753_422862763571688_4983364457357549015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vgk1Vl5v6eIQ7kNvwFoTU4t&_nc_oc=AdrP8VkpfEMbi-BzyKKujW_fuH_wh3-yS_rfjA41JNYcD4uMOBUwYsyaSxx0LIbTFZA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XO_Kb3wrWSfDLXWyyh9KjkuQv8YhXr7EL6TX7HU72lg&oe=6A22EDEE"}]}, "id": "1636738150446325", "locale": "en_US", "screenshots": [{"file_name": "\u672a\u6807\u9898-1.png", "id": "380239744821656", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86625133_380239748154989_7491302269616489662_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRyxopQJrKYQ7kNvwHqCab-&_nc_oc=AdrFnlVWXznQAvmx7AJulrcxDHxdT22GfNrYFR5IfH0VQesX9YnBGPJfvLy17gliWwk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DpTNrpL30YoH2QO-SbMHiLrg1m0TCAIifdq0_NUcsqQ&oe=6A22F4C2"}, {"file_name": "\u672a\u6807\u9898-2.png", "id": "700011775544485", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39036602_700011778877818_7456029647155466558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9xfGD2aIqAQ7kNvwFwBEV-&_nc_oc=Adp4QiIXhP_eJ1oTz2yEd83RwkboDwf3NG4Vw1JjtdwIpKDgReElmklhDrrxyQ7TM_0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tSLMtQMbEt5hCjSrZV261vzbv3Fu2m9OFDaTEmRyRcQ&oe=6A22EA89"}, {"file_name": "\u672a\u6807\u9898-3.png", "id": "946317580531345", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/57575356_946317583864678_8273661520756002294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iL6t9bWbXAIQ7kNvwEDdJL4&_nc_oc=AdqzxGP-IRPRPvToylLtzWnjRhTQlKfjM3yVjPn4bs6_iuVwZdLp8tAmFCFp0qkIFJw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eiS-EfPHnpeCuXMpl2OLgq2A5LkKYEO77ykMJvZBtTw&oe=6A22D2EE"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgAbn-TBIvIQ7kNvwHWIHwM&_nc_oc=AdrnqZbKfTy36eo-EianndgyZp6HZR5ucsu0hLATtx0PGPTbotG8hUqhhWQw9XaNW8M&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sqRmS80ouW3TAozoM6qP4fr0FYojaD56BM-_UZEkjDA&oe=6A22DB36"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNac_qvI1z8Q7kNvwFP-rea&_nc_oc=Adqx9vgPIPqjJ3HhTnTVRKNtqPWwan-6LGB3VtdQhiY8C8fvldZDVU9mXuP1wP8nfj4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ribbJUWdATISTMIsoGy60nQtsivrR4XRhP1NmR7_gpA&oe=6A22F410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtJWxMQMig0Q7kNvwEu-ziV&_nc_oc=AdoKwRAPALklwdYF0jTYDyk7z8cY-4MS0poqEsB_1IkxdaKPjHz1NFUGL46Y0ExWsbo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_17wqMdu5qsvkwqHN1jSTQ-yvVJhcOWg2c2yFL4wPXKQ&oe=6A22F489"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_mo
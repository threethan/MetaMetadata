": "422862760238355", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974753_422862763571688_4983364457357549015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BQ-6TCdjXRQQ7kNvwHMKbv2&_nc_oc=AdmedxbCzcNEtW9-6hILoU_76lrQO4jWfrbhAbCyVGKFIfnIzUKypJQ1FfUuLk82QdQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZXmEkLREuhL0sNMKD_IRQ4AXlc5v48Cpo9C-5qLWm4Q&oe=69AEB1AE"}]}, "id": "1636738150446325", "locale": "en_US", "screenshots": [{"file_name": "\u672a\u6807\u9898-1.png", "id": "380239744821656", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86625133_380239748154989_7491302269616489662_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXhGv9sq6YwQ7kNvwHpltml&_nc_oc=Adm_wPVb4c3prlPwOvQ3TXsTY1_qDiTatXFM9GXrIjz6-IwnUIjVdNFIO-U24yyAF7k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEUGSasC3SKgoAPpohyzDlKoZIPUE1bqIv_zgqYtvP1w&oe=69AEB882"}, {"file_name": "\u672a\u6807\u9898-2.png", "id": "700011775544485", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036602_700011778877818_7456029647155466558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLoybu-DKdcQ7kNvwExFkfr&_nc_oc=Adk3YVv59vKAg-VclmVxtLn0Qyci7dS1ixIyiQDemsTIRJmYY_CqfKQWvygbIgGWnds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-4fvz8KpqFRZNWWvy4N3NFnyhKd2HA5r8axZ_9e-r1g&oe=69AEAE49"}, {"file_name": "\u672a\u6807\u9898-3.png", "id": "946317580531345", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575356_946317583864678_8273661520756002294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-enybZvnYEQ7kNvwFxEbet&_nc_oc=Adlg30OKt2SMmJ8ejMQymy5tTEEjEVyazGVNEr9IP3Rq3iIIdQ5LbONAsjMqQ4Sm2U8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRVFYV-B-RGl_l6GUAZ7C3KicBZnLFsA3Byg5Bmuxrng&oe=69AECEEE"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WlkzvNzyX2cQ7kNvwEizGbk&_nc_oc=AdkXebfRb0NqayTZSCDhtZshlKmzNbKZ90xv59Nci0RT-Y1fvh0c_5QvHOMkMCkgYiQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpOa5-_sF7DAPoiwVF_Qg71bWipfx3Fxf5JCt6K3sDdw&oe=69AED736"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16cmkkP_ZzkQ7kNvwHUteWE&_nc_oc=Adlam4q7nOQRh7iHzn88MFdFgh_a5qTKLq64Y7Gt2vdve3CGzdyNTVI_SxKiR6aYjU4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMaA3fP0vLFXN3pCgl5tYfbgal6rs6vPT8s5Q2iMwU6w&oe=69AEB7D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12MUSMGauh8Q7kNvwFIYbsS&_nc_oc=Adl_n2YjgEfpUNzgc7uvsojXC-UJESokhgvnCuvMAGUgniI1VtFubN6bBp972owNiEU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEiYPiTN4zAQx9z-a_561ZD4drOGH4NPoFM7LXvC25LA&oe=69AEB849"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGL
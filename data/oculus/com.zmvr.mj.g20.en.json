=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8asDf_B9fjgQ7kNvwGA0pRr&_nc_oc=AdqR6rwJ1XRldXc2fvCr9FqLCEfTUXRIeKJFKH2ZDJw7lSyuJ8Z4O7TR9KvCQcM9Gzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR592lGJuYWUdjiICm_W4fjlNkQhLVY6MXc7_wntknaDg&oe=6B05CD2E"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDMONqfOsMkQ7kNvwGN8vjv&_nc_oc=AdrqjCgu_9I_UuHMJqaLzgPyCxNzGUiAcEYt0QZ1IVVzH2o3NFeVi9yedtM6xolgGBA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQv86pxknQ0tGdzji9z2K9iZgzePKg5xFgFqQKvgOvVxQ&oe=6B05D576"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoW69aORh2IQ7kNvwHJalYb&_nc_oc=AdrApKKH29Tj8A_53E3kuXvAFCbHtlmzCpO7R0OFqyQccLAHuCU6BsMYDHifd03l880&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGeqC_DsHUaPiiNgc562YW-OD-Vl6H5zFu7xh4y9BK4A&oe=6B05B610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeU-8iFGxicQ7kNvwG5ppQu&_nc_oc=AdqqUNzrMpIBq_wAZ3cNOtUJZMP-4TfPaFZdt0PbyGNzdVr1CMZI0uA3NmbW2fNna14&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzNZOC-OCNi0jEck7TZenkW--0CISuC8n7uUYrRFCalA&oe=6B05B689"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496848
512 - \u526f\u672c.png", "id": "422862760238355", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974753_422862763571688_4983364457357549015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reBTMhzVObUQ7kNvwEwAvnm&_nc_oc=AdrYJRqT44sc6FnUm3Gi8p4BOEc_wSGH5idnnix24f4CYZG65YiyTRJL4QS6N0ZLP4Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l6TcR4j-ao8DdWP2caPuMRS4u_tWSMpEvNM7-kfiTbw&oe=6A05ECEE"}]}, "id": "1636738150446325", "locale": "en_US", "screenshots": [{"file_name": "\u672a\u6807\u9898-1.png", "id": "380239744821656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86625133_380239748154989_7491302269616489662_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdBtqSXlY2EQ7kNvwEel68V&_nc_oc=Adp2jjy8hFfiv4z41CUqCdpXY_fyKSbhgeWdCDykRncj6rvoiJ6uBX3O3CkSrNRORGE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L93EIBScECvQPfukGfCM1PbXilhcNXKgWQuxV3sv7yA&oe=6A05BB82"}, {"file_name": "\u672a\u6807\u9898-2.png", "id": "700011775544485", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036602_700011778877818_7456029647155466558_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT2BrWqy-1sQ7kNvwEQDdAt&_nc_oc=AdrVLdFxm5CUiBj7SD5WlrCaNC6H543CvDq8xo97ROF7asiFWKe976Y2_D-NPm7dXRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gd7iSMu2HtuOP_AT3tBtk2EwOKhbdtJT1uc94FK5oRQ&oe=6A05E989"}, {"file_name": "\u672a\u6807\u9898-3.png", "id": "946317580531345", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57575356_946317583864678_8273661520756002294_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZzem4rsL40Q7kNvwEQPT7f&_nc_oc=AdoQEwj3nGfepxu644zvz523NCF2X21CmXBSIHXo01kNwGCbYo6GWYzekOpdjInrYko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Np2HQPntZeIetUr3a9mpBv1EEqIZJJrruBDjr5BjUhQ&oe=6A05D1EE"}, {"file_name": "\u672a\u6807\u9898-4.png", "id": "260515627113920", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031326_260515630447253_3465056129930861774_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivkD4AP_RxMQ7kNvwFP5-bT&_nc_oc=AdpFxkUjxQ12wmGdgmEYdVA4v6x74WO7HhPNPr6RGPN_NEAbxjbJn1v8BtjZv7SoF8k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pw_dZR-3Ws1SUM8olj6LUJTPE4fOEhzkvIIgEmDhFMw&oe=6A05DA36"}, {"file_name": "\u672a\u6807\u9898-5.png", "id": "259854423859745", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982439_259854427193078_4865613335001406957_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZACDFwJoZQQ7kNvwHCGinw&_nc_oc=AdocSiGPkMaoiaYFIgfnPBxOyeoZY3n-JuUz5pEU17Gnr_lu2uJO4eOwFMNWKkkudQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54ThdNMiQKQThYg8y931nW97JZ5pYmKMt12wkqojz5rA&oe=6A05BAD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "App-Lab-2560-1440.png", "id": "408109501808200", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974819_408109505141533_1485763930178356982_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZjPI7tCU1UQ7kNvwGG2S5R&_nc_oc=Adr5AQDGS3SkTsEnH0hMurJtr9mL-gES6Lz2DNuWbo3351kQxIKK4jzQJ5VLznJrbgo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hYEEho4uW9n_XW9jmZI4dKRpOnFUo9DHS00jQ3yJCCg&oe=6A05BB49"}, "display_name": "TheOtherShore", "keywords": [], "long_description": "In TheOtherShore, it is necessary to constantly upgrade and transfer positions, create powerful professions, and pass high difficulty dungeons. This includes three major games: Desert Town, Underground Palace, and Iron Reign.\n\n\n\nDesert Town is a multiplayer survival game with a wide variety of zombies, ranging from ordinary zombies to mutated zombies. Players need to constantly improve their skills and equipment in order to survive in this perilous world. The game has realistic graphics and terrifying sound effects, allowing players to experience the horror and danger of zombies firsthand.\n\n\n\nUnderground Palace is a horror adventure game where players navigate through layers of levels in an underground palace occupied by zombies. Players need to constantly improve their survival abilities, learn to summon monsters and use high-tech weapons to better protect themselves when encountering zombies.\n\n\n\nIron Reign mecha series is stunning! Brand new profession, cool skills, equipped with exclusive weapons, activate armor, summon magic dragons, summon angels, and sweep away all obstacles with Thunder Grid! Iron Reign is not just a game, but also a journey to redefine survival rules. It is a cruel and beautiful wasteland, a dilapidated city ruins, shocking, and the roar of mechanical armor resounds through the sky. \"Welcome to the Steel Forbidden Area, humans.\" Here, you will embark on a brand new journey of conquest. Are you ready?", "short_description": "The OtherShore is a comprehensive scene that supports multiplayer online socializing, upgrading, training, equipping, teaming, and other functions. Prepare for battle on the other side and rush towards the dangerous and challenging zombie world with teammates."}]}, "developer_name": null, "developer_privacy_policy_url": "http://dreamland.zmvr.com/TheOtherShore.html", "developer_terms_of_service_url": null, "publisher_name": "App Lab", "support_website_url": null, "website_url": "http://dreamland.zmvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "644354873106712"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], 
ontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003238_218046497733638_5150065473720899441_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1nBFH7Xx4YQ7kNvwEEEvhi&_nc_oc=AdoBUQms4zWJk_MC_7rxmY00LvdFLgyQHbPN_IB1rgJO3ukYlp5EYxmkUPtikelsvWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9uzoWsiogbUjjQunR5H0lkeWljcSwy5jfxc5rYLniEw&oe=6B05AEA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jungle Jamboree 2", "keywords": [], "long_description": "In this VR game you are a legless monkey that uses their hands to move, In this game you can meet other people, Play with friends, Or just play by yourself, The choice is yours, There are many fun mechanics in this game such as Climbing, Running, Jumping, Swimming or just walking, There is also a big variety of maps to explore with more coming in the future.", "short_description": "In this game inspired by popular VR game Gorilla Tag, You use your hands to move, You can Play with friends or randoms, You can explore the maps and more, If you are looking for a fun game to play you should consider this one.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/jungle-jamboree-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Chaise Parker", "support_website_url": null, "website_url": "https://sites.google.com/view/junglejamboreewebsite/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "RO
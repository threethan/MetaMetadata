77588123814723584_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D03731eKIwkQ7kNvwGzKl3F&_nc_oc=AdrkGBnxbLnGQrPnOPk2JSDj1LBPyU0MZ8SD3FaQRH_MSPVC98Fa95EDQ1PDXi568zk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG79YSVfVVmL4bIW3ZXOaSWE1VdnTT7rw4X0rZrpKT_lA&oe=6A8582AC"}, "display_name": "Trapped VR", "keywords": ["horror", "scary", "escape", "granny", "game"], "long_description": "\u201cThis game is inspired from escape house mobile games that have become popular recently\u201d\n\nExperience the horrors of getting trapped inside a haunted house in VR.\n\nFind keys / objects to help you get through the locked doors.\n\nLook for clues to get access to and explore the hidden parts of the house.\n\nTry to be as quiet and careful as possible because any kind of noise that you make will get you killed.\n\nP.S : Immersive Multiplayer Co-op Mode coming soon", "short_description": "Vintage Horror Escape House Game Experience"}]}, "developer_name": "Escapade Technologies", "developer_privacy_policy_url": "http://escapadetechnologies.com/privacy/", "developer_terms_of_service_url": "http://escapadetechnologies.com/tos/", "publisher_name": "Escapade Technologies", "support_website_url": null, "website_url": "https://escapadetechnologies.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "ADVENTURE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1454098625414772"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/
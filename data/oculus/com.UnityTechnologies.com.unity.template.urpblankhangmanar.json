qYImDQ1CSTfwQV1EZHwgx_kpX1AjQ&oe=699C5FB8"}, {"file_name": "Screenshot (89) (1).png", "id": "968227355426354", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393320_968227358759687_467014829416351637_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2LpNJUJ234Q7kNvwEWh4Lk&_nc_oc=AdkXzmhlYQo2mZ11rDJUoRbztaIm5V_nS-xb8oJ5695lylDgp2mJMG5HCwU1KoKWB8g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuUvsV3TzZ_-F-cSlhWZBFf2ZH0rztfWeuI50ItiqvtVA&oe=699C5831"}, {"file_name": "Screenshot (85) (1).png", "id": "1191401969375352", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393450_1191401972708685_7215048818130542464_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMaqPayGUBcQ7kNvwFRWZxo&_nc_oc=AdkKo8IsTWxSLtjh1ukuAQ4TZu2R2lbfB8-GTQ47TXJejfJRmekrXUA3JK_8yOlh264&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv3Wj0zJh78rrzQlReHsdiyyPcGJSUN2wzoaslHedXLSg&oe=699C4DCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Hangman2560x1440.png", "id": "1038953601598195", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393491_1038953604931528_2055110725748090748_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-bdKlYbt0gQ7kNvwF01NIg&_nc_oc=AdnI9gQWkGDOmTvWx2TrGh4D0Xf6arYXjKlQgKi-aiOIuLNrDr7f9KDnhWxhg8AtyQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuXzbJywoaqg9s0jQ4Bsoj0VLbQ4n30PoxaKUTuRdz4sA&oe=699C316E"}, "display_name": "Hangman AR", "keywords": ["AR", "Word", "Puzzle", "Spelling", "Hangman"], "long_description": "Hangman AR takes the classic word game and brings it terrifyingly to life in your own space. Using augmented reality, place your hangman board anywhere in your room and test your vocabulary with over 2000 unique, carefully curated words, no repeats, no nouns, no mercy!\n\nChoose the wrong letters, and your NPC pays the price\u2014gruesomely. Each of the 4 immersive maps features its own deadly consequence:\n\n\ud83c\udff4\u200d\u2620\ufe0f Pirate \u2013 Old-school gallows justice\n\ud83d\udd25 Witch \u2013 Face the fire in a medieval witch burning\n\ud83c\udfd7\ufe0f Workplace Accident \u2013 Modern mayhem with safety last\n\ud83e\udddf Zombies \u2013 Guess wrong and get eaten alive\n\nWhether you're into classic word puzzles or just want to watch chaos unfold, Hangman AR delivers deadly fun with every round. Place it, play it, and pray you guess right.", "short_description": "Hangman AR brings the classic word game to life with a dark twist. Place the board anywhere in your room and guess your way through over 2000 unique words. \n\nBut be warned\u2014every wrong choice leads to brutal consequences. With immersive AR, high stakes, and eerie environments, it\u2019s wordplay like you\u2019ve never seen before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://delaberestudios.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "De la Bere Studios", "support_website_url": null, "website_url": "https://delaberestudios.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9407970065945752"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "805317075898211"}, {"status": "PUBLISHED", "id": "1522989998928382"}, {"status": "PUBLISHED", "id": "1668187624590906"}, {"status": "PUBLISHED", "id": "825304246622346"}, {"status": "PUBLIS
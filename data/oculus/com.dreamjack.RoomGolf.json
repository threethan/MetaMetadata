 rough, bunker and pond in the room.\n\nYou can enjoy all 18 holes + special halls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dream-jack.com/index_roomgolf_vr.html", "developer_terms_of_service_url": null, "publisher_name": "DreamJack,Inc", "support_website_url": null, "website_url": "https://www.dream-jack.com/index_roomgolf_vr.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "786310435694265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75416840_5703755899642580_6344671955468634874_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1niKp8aaU5IQ7kNvwGfgcvu&_nc_oc=AdoIL5ISNncqCiIEDyTmOlMhdPH30nF1zzs8UHP2exSXn5q2t8va7RWP5RHi3jRoSic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTacLwnzqkb2SuFS1jXj6RW_yLJeqXlXEcHWR4BU14SKQ&oe=6B0DA8E0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RoomGolf VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1654123912, "lastRevision": {"nodes": [{"id": "4486283698070494", "release_type": "SCHEDULED",
n.com/v/t64.5771-25/38982678_304234178458123_1784585116664279049_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kl8ui35Py9QQ7kNvwHI0Wt3&_nc_oc=Ado-sKtH263aNh1mfnR2uO2S1cLEo9r_100E1UiuCgVND7-KO5B3LE0fy0_ufuQp4zA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQkt-9KuQUXaS87XO86Sz1utza9Kx3P65r6iLg7TcUFQ&oe=6B0DAA6F"}, "display_name": "Chess Mate", "keywords": [], "long_description": "Wanna play some chess? \nThis game provides you with everything you need to play chess and have fun. You may wonder what's unique about this game. You can throw the pieces all around the room or at your mate. If this is not enough for you, then maybe try winning with an Alien-Ai, or just try to play against the pigeon... anyway, nobody is reading these descriptions, so go ahead, watch the trailer.", "short_description": "Wanna play some chess? \nThis game provides you with everything you need to play chess and have fun. You may wonder what's unique about this game. You can throw the pieces all around the room or at your mate. If this is not enough for you, then maybe try winning with an Alien-Ai, or just try to play against the pigeon... anyway, nobody is reading these descriptions, so go ahead, watch the trailer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lookstar.pl/chessmate-privacy-policy-sb/", "developer_terms_of_service_url": null, "publisher_name": "DoeButchersGames", "support_website_url": null, "website_url": "https://lookstar.pl/chessmate-privacy-policy-sb/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SOCIAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_mem
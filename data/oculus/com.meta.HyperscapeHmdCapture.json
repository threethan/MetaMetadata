GbKRrrwtV12jcnXuwTMVTT6jbr4nOAO6nzauZ_EKDzodsLYzdYaIA0hQ4MUwGs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g5hUr8c-pFTIbYSheYvNqFPfz03XpWENAhEsW66PFwg&oe=6A09DF92"}, {"file_name": "Screenshot 2 - Preview.png", "id": "25021037514148921", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499308125_25021037520815587_9135327288602903868_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLk0cc1LUKQQ7kNvwEc5Gxm&_nc_oc=AdpNM0Gs-dDYd_Z6XLy5wBm_FJRclqaNOI_CAN-Uy6M0RYs8Xl7FnMD7zxK4AdRF86s&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zgzLnF2vJPdRrzEUToFGjb-ETbLueyCBYMI9q4DjHZQ&oe=6A09B662"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape - Capture.png", "id": "2837424193314938", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491820578_2837424196648271_7119166417314038947_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYaCLp6ZlNkQ7kNvwF2Tnon&_nc_oc=AdrPBwSCZ8MFXf0559nNGalNAzI78QXb53rMqe1sNvWswpZoCwr7nQjlYyuTKf_ZTjM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i84nQKX_XmrcZBcyCn8fq__RZ-yE8FvBLmBgqOZi7tw&oe=6A09D2B5"}, "display_name": "Meta Horizon Hyperscape Capture (Beta)", "keywords": ["photoreal", "scan", "hyperspace", "realism", "gaussiansplat"], "long_description": "Hyperscape lets you capture your real-world space in just minutes, then creates an immersive, true-to-life digital replica that you can visit from anywhere.\n\n- **Bring your real-world spaces to VR**: Hyperscape lets anyone create digital replicas of their physical spaces, with high visual quality and realism.\n\n- **Simple and fast**: You'll be guided through every step of capturing. It takes just a few minutes to capture an average size room. \n\n- **Featured Hyperscape worlds**: Check out a few digital replicas for inspiration to see what you can create. \n\n- **Built with choice and control**: You control what you capture and those captures are only visible to you with your Quest device.\n\n- **(Coming soon) Share with your friends**: You'll be able to invite friends to your Hyperscape worlds through a private link, letting you seamlessly hangout in your favorite places, no matter where you are. \n\nThis is the first step toward our vision for photorealism and the future of human connection, as a profound new way to feel like you\u2019re physically there.\n\nAvailable only to Quest 3 and Quest 3S users that are 18+.", "short_description": "Hyperscape lets you capture your real-world space in just a few minutes, then creates an immersive, true-to-life digital replica that you can visit from anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/supplemental-terms-of-service/", "publisher_name": "Meta", "support_website_url": null, "website_url": "http://meta.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9959579567475390"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25666391586367602", "version": "13.0.0.31.461"}, "id": "1043508541170963", "channel
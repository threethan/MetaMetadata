g?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUPQkx4iqAwQ7kNvwFOFdKN&_nc_oc=Adm8n1KUc7SxsYeAkhdM2YcSZ-yQ74N2t3UCnFruEnWk7ECkUjssGu2q_zuVWuzhnMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuAQ5JDMGyeRuMWp2rXFyCpoVsf8wg5fN-pHauILszugw&oe=69A44922"}, {"file_name": "Brushwork_Screenshot_08.png", "id": "667910758343621", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031630_667910765010287_8383872961959468997_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXoqMaZiJm8Q7kNvwGiU7iV&_nc_oc=Adk_lMxCBk23jn4gRhAoGbVjXuEA94sJMi-N5KIG0vns6TSPiWy7isnc49aGik82Hxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvvY6N9hwRuO3RBbhLwLqf0fzuZD_6BqYFfVb2tBqZavA&oe=69A42DDE"}, {"file_name": "Brushwork_Screenshot_07.png", "id": "813131183324119", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035407_813131186657452_3686359764945663007_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdXgYjvl-PEQ7kNvwF_p0CX&_nc_oc=AdknP-9pqVJGzDjRC1pfSLwVdslb9dNFODUnluppDkMpGS-mAp6khiE8cj16j-rzslE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvTPUrifzQTy_-TC-AHWvn17ArLCUPDpeW2-mdk2tbZSQ&oe=69A44F18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Brushwork_CoverLandscape_01.png", "id": "495436912381188", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_495436915714521_1972750706282903248_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZ3EnVkazJEQ7kNvwE5GKGu&_nc_oc=Adm2dSNFOIG2rQOMZ4mS67qmtgHgvUQ3-E0coIkht4sM6HyraALGuah2jxP4XC5ylKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvknwNMgaTYVz1HuBpD2nnqCAshAz_rNnd_p0LXXjLz4w&oe=69A4230C"}, "display_name": "Brushwork Studio", "keywords": [], "long_description": "Relax and unwind as you create beautiful, realistic paintings in your own art studio. With easy to learn controls, you will be painting in no time. \n\n\ud83d\uddbc -REALISTIC PAINTING-\nMix and blend colors to get the exact color that you need. Brushes can even pick up more than one color at once.\n\n\ud83c\udfa8-CUSTOMIZE YOUR STUDIO-\nHang up your paintings, choose from more environments, and more\u2026 Want to paint outdoors? Brushwork Studio allows you to change the environment and set the right atmosphere.\n\n\ud83d\udd8c-BRUSHES AND TOOLS-\nChoose from a variety of brushes and tools to express yourself. Paint the smallest details with a fine brush, or use pencils and charcoal to sketch and draw.\n\n\ud83c\udf10-IN-GAME WEB BROWSER-\nUse an in-game web browser to search for reference images or follow along with a tutorial video. You can even listen to your favorite music as you paint!\n\nCreate your next masterpiece with Brushwork Studio!\n\n", "short_description": "Relax and unwind as you create beautiful, realistic paintings in your own art studio. With easy to learn controls, you will be painting in no time. \n\nCreate your next masterpiece with Brushwork Studio!"}]}, "developer_name": "Sunset Division", "developer_privacy_policy_url": "https://brushworkvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunset Division", "support_website_url": null, "website_url": "https://brushworkvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "721041525526938"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38
g?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9oSBRs1LOQQ7kNvwG63M54&_nc_oc=AdnPgGRGnZCISrE_QINReKhLxqJk1ia0WRO8JyFKCGG7oO1EPy1_omE6q86PmgBv4fY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftxX7i4KaQc4Rq370lQ-seBJ6z2-dTqupzvZZ4FsORurQ&oe=699B0EA2"}, {"file_name": "Brushwork_Screenshot_08.png", "id": "667910758343621", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031630_667910765010287_8383872961959468997_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mr2rRfh7jYQ7kNvwGjEszo&_nc_oc=AdkjOXgTkx5T_Dr_vps1nveQoNy-6r-0ni6yhFhqMzfga2F_xsi0hC-JleXdqIBbXYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsD9t0vp_tXO7grtYNf-uED4bzdcmkcXd9GKU-c3U4QeQ&oe=699AF35E"}, {"file_name": "Brushwork_Screenshot_07.png", "id": "813131183324119", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035407_813131186657452_3686359764945663007_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_Et1soMYdAQ7kNvwFQCEGf&_nc_oc=AdnYWWvNAkjkNZtZ0ioLtYdFBYvMSQtjKD9NdtOnKTY_yGjlWCZjXFLTXBgnmd9GUbA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuI-v36ZJQOyN1qv3ngo4qC7sT_FTvnDALiGVvX0jQchQ&oe=699B1498"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Brushwork_CoverLandscape_01.png", "id": "495436912381188", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_495436915714521_1972750706282903248_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3UiGtgn4TUQ7kNvwHj-LVe&_nc_oc=Adl92znYwPeZacCgE3MbUJy7MPVGWK4ghzPMlh_cEZlpEvVZPP7eLhmoVB6RWdc1CSU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsz2-i43HzaIJ2IwI64_ruKKXljEuOpohJRkcDLmexzUw&oe=699AE88C"}, "display_name": "Brushwork Studio", "keywords": [], "long_description": "Relax and unwind as you create beautiful, realistic paintings in your own art studio. With easy to learn controls, you will be painting in no time. \n\n\ud83d\uddbc -REALISTIC PAINTING-\nMix and blend colors to get the exact color that you need. Brushes can even pick up more than one color at once.\n\n\ud83c\udfa8-CUSTOMIZE YOUR STUDIO-\nHang up your paintings, choose from more environments, and more\u2026 Want to paint outdoors? Brushwork Studio allows you to change the environment and set the right atmosphere.\n\n\ud83d\udd8c-BRUSHES AND TOOLS-\nChoose from a variety of brushes and tools to express yourself. Paint the smallest details with a fine brush, or use pencils and charcoal to sketch and draw.\n\n\ud83c\udf10-IN-GAME WEB BROWSER-\nUse an in-game web browser to search for reference images or follow along with a tutorial video. You can even listen to your favorite music as you paint!\n\nCreate your next masterpiece with Brushwork Studio!\n\n", "short_description": "Relax and unwind as you create beautiful, realistic paintings in your own art studio. With easy to learn controls, you will be painting in no time. \n\nCreate your next masterpiece with Brushwork Studio!"}]}, "developer_name": "Sunset Division", "developer_privacy_policy_url": "https://brushworkvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunset Division", "support_website_url": null, "website_url": "https://brushworkvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "721041525526938"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38
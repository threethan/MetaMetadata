D6FWl5Ot_ycVbV3O3CYTePNzGpM9rxHTP-lT7dYDV39sSZI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvDqTtEXHySpQUrC61KdyTAfqIpiGyo5GqOKru6D7OPDQ&oe=69986752"}, {"file_name": "screenshot05.png", "id": "475609780399649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75429286_475609783732982_8975305124680428910_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKHbOsVzToAQ7kNvwHQ259z&_nc_oc=AdmoyEpYhXJrebmdA9rppAGL80hwo_Kw0nuifHjnnSrGZ295prjgPx3lrDpdhWe8-Y8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftDVzL4v-N3hwtAUCKcDP5IKQ5p4VeFGtYCH1te81P6Uw&oe=69985E28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscapeEasel.png", "id": "1401697960210798", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031350_1401697963544131_2556062175966046941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0bFBt9OA3kQ7kNvwHemKYX&_nc_oc=AdkeWsnTCSBCzobHB-7_u2F31Tavxm3SZFFoO1MzT1QcuwZzQv4uBaesaaY5qRuulXs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfufQblMlUm4NCECiYEJz1ANjKw-6UjyzQ4Km1hcqh_Lnw&oe=69983EDA"}, "display_name": "Brushwork", "keywords": [], "long_description": "Paint your heart out! Relax and unwind as you create beautiful, realistic paintings in your own virtual studio. Cover canvases or even the walls! With easy to learn controls, you will be painting in no time. \n\n\ud83d\uddbc -REALISTIC PAINTING-\nMix and blend colors to get the exact color that you need. Brushes can even pick up more than one color at once.\n\n\ud83c\udfa8-CUSTOMIZE YOUR STUDIO-\nPaint everywhere around you. Splatter paint all over the walls. Want to paint outdoors? Brushwork allows you to change the environment and set the right atmosphere.\n\n\ud83d\udd8c-BRUSHES AND TOOLS-\nChoose from a variety of brushes and tools to express yourself. Paint the smallest details with a fine brush, or use a paint gun and make a mess. Clean up mistakes with a sponge.\n\n\ud83c\udf10-IN-GAME WEB BROWSER-\nUse an in-game web browser to search for reference images or follow along with a tutorial video. You can even listen to your favorite music as you paint!\n\nCreate your next masterpiece with Brushwork!\n", "short_description": "Paint your heart out! Relax and unwind as you create beautiful, realistic paintings in your own virtual studio. With easy to learn controls, you will be painting in no time. Cover canvases or even the walls! Make your studio your own. "}]}, "developer_name": "Sunset Division", "developer_privacy_policy_url": "https://brushworkvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunset Division", "support_website_url": null, "website_url": "https://brushworkvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2158230701002064"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "797176889597476"}, {"status": "PUBLISHED", "id": "1472021693835566"}, {"status": "PUBLISHED", "id": "2540852179603403"}, {"status": "PUBLISHED", "id": "1236037011511217"}, {"status": "PUBLISHED", "id": "1575911873801548"}, {"status": "PUBLISHED", "id": "524873363856740"}, {"status": "PUBLISHED", "id": "862190262678349"}, {"status": "PUBLISHED", "id": "328113242121752"}, {"status": "PUBLISHED", "id": "825303935363053"}]}, "baseline_offer": {"id": "825303935363053"}, "is_approved": true, "firs
0i7JtkAUc96MjSjcOnKiowxJa8iie1lNQ&oe=6A4E4DDE"}, {"file_name": "screenshot02.png", "id": "290724556122312", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974466_290724559455645_4126081024026600058_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXzuhp0PKJoQ7kNvwHk_bxc&_nc_oc=Adqp-i3XexU7PNXLmfiXt7qSyOHdoCbrP2wTSUTA9D7LOuOxJjRI-0fiTxTITtY4UJo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCszrhLU2hcbghrUkIDLKqziqt0gZF5lHlYx6TNvrADmg&oe=6A4E5652"}, {"file_name": "screenshot05.png", "id": "475609780399649", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75429286_475609783732982_8975305124680428910_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nc_YVxj3Q9QQ7kNvwEP0QLW&_nc_oc=AdqyNV3jo1R0pTCrlzE3aI_kKLsvq5aUfm4jOsBRCMJlD_wHuB0EXsj2ddTcN9v7C0g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-Bpfmwvo7mBMVae6cv7hmiRRWgLsNXQ1Yy9lnjPoZtg&oe=6A4E4D28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscapeEasel.png", "id": "1401697960210798", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031350_1401697963544131_2556062175966046941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ehMnMfDy3cQ7kNvwFPJThm&_nc_oc=AdoZsG9VMWiUQ4plhgcddfY44lOzpBMIgzAj8qKDi4qSKIc7_cRMUNGYRjZlQH6nLy0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBACN1046e-fidV-YrkQ4Qzi1KjJbywQI4uL75G_71iOQ&oe=6A4E661A"}, "display_name": "Brushwork", "keywords": [], "long_description": "Paint your heart out! Relax and unwind as you create beautiful, realistic paintings in your own virtual studio. Cover canvases or even the walls! With easy to learn controls, you will be painting in no time. \n\n\ud83d\uddbc -REALISTIC PAINTING-\nMix and blend colors to get the exact color that you need. Brushes can even pick up more than one color at once.\n\n\ud83c\udfa8-CUSTOMIZE YOUR STUDIO-\nPaint everywhere around you. Splatter paint all over the walls. Want to paint outdoors? Brushwork allows you to change the environment and set the right atmosphere.\n\n\ud83d\udd8c-BRUSHES AND TOOLS-\nChoose from a variety of brushes and tools to express yourself. Paint the smallest details with a fine brush, or use a paint gun and make a mess. Clean up mistakes with a sponge.\n\n\ud83c\udf10-IN-GAME WEB BROWSER-\nUse an in-game web browser to search for reference images or follow along with a tutorial video. You can even listen to your favorite music as you paint!\n\nCreate your next masterpiece with Brushwork!\n", "short_description": "Paint your heart out! Relax and unwind as you create beautiful, realistic paintings in your own virtual studio. With easy to learn controls, you will be painting in no time. Cover canvases or even the walls! Make your studio your own. "}]}, "developer_name": "Sunset Division", "developer_privacy_policy_url": "https://brushworkvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunset Division", "support_website_url": null, "website_url": "https://brushworkvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2158230701002064"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "921322594046194"}, {"status": "PUBLISHED", "id": "2144205676325144"}, {"status": "PUBLISHED", "id": "797176889597476"}, {"status": "PUBLISHED",
544425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031309_643172550877758_5812527835769292231_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bd2p4kUvKvoQ7kNvwGbIP64&_nc_oc=AdoJsZdB63xtlVjn1gwzoVRn4I24nlN45fx8tBcTJa_zoK475ROHUfKutaKq1spMtDM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa2nNzZqeml3wuwGNiy0UU7wNq-zQv5FBzJpPKLWr4Eg&oe=6A4FAC22"}, {"file_name": "Brushwork_Screenshot_08.png", "id": "667910758343621", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031630_667910765010287_8383872961959468997_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7k-w1XJ3WMQ7kNvwFv9pjK&_nc_oc=Adrru-GZcJm0JFwHK2YzNodxyDc_9D3-zpF49QQI_Rb2Ca3f0l00tqaDqZvgZeduoS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8afDcaGsI3tgqdBl4mKPgR0EuXJ9JHAPtv1tt64z5rQ&oe=6A4F90DE"}, {"file_name": "Brushwork_Screenshot_07.png", "id": "813131183324119", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035407_813131186657452_3686359764945663007_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZB5tgDaQD0Q7kNvwFP-UVP&_nc_oc=AdovCZPO_pVll1BHKXEj-rfWDgsjJcOV1Eguu4teuszrdVuScGKQybCqYoIwjQlhEZ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4SR9TeUlyFD9YhW4pVTHrnMDdqhdUt8_AkO-1k-fdCA&oe=6A4FB218"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Brushwork_CoverLandscape_01.png", "id": "495436912381188", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974653_495436915714521_1972750706282903248_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRTraMsvTYwQ7kNvwHM6Tu-&_nc_oc=AdoTyWr5m2ELFfz9wk1pCQZcTmWdFqjEgIGXPpq2IJAD5aFHAaki4c5yhkXTfFJGJLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS-mwXvlOnuz-Q0yMgmIMqyOvaVyzBLR1djxIHjGaXVg&oe=6A4FBE4C"}, "display_name": "Brushwork Studio", "keywords": [], "long_description": "Relax and unwind as you create beautiful, realistic paintings in your own art studio. With easy to learn controls, you will be painting in no time. \n\n\ud83d\uddbc -REALISTIC PAINTING-\nMix and blend colors to get the exact color that you need. Brushes can even pick up more than one color at once.\n\n\ud83c\udfa8-CUSTOMIZE YOUR STUDIO-\nHang up your paintings, choose from more environments, and more\u2026 Want to paint outdoors? Brushwork Studio allows you to change the environment and set the right atmosphere.\n\n\ud83d\udd8c-BRUSHES AND TOOLS-\nChoose from a variety of brushes and tools to express yourself. Paint the smallest details with a fine brush, or use pencils and charcoal to sketch and draw.\n\n\ud83c\udf10-IN-GAME WEB BROWSER-\nUse an in-game web browser to search for reference images or follow along with a tutorial video. You can even listen to your favorite music as you paint!\n\nCreate your next masterpiece with Brushwork Studio!\n\n", "short_description": "Relax and unwind as you create beautiful, realistic paintings in your own art studio. With easy to learn controls, you will be painting in no time. \n\nCreate your next masterpiece with Brushwork Studio!"}]}, "developer_name": "Sunset Division", "developer_privacy_policy_url": "https://brushworkvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunset Division", "support_website_url": null, "website_url": "https://brushworkvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
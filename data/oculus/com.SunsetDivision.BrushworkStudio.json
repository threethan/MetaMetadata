544425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031309_643172550877758_5812527835769292231_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0_W86Wy5pAQ7kNvwFyEYaN&_nc_oc=AdrHOfrVtW_tTV6D6o98AsntGh2MHxG5-fH8zmxz32oKoonkE4PY59A2gRlhwtyWwJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsTDvCP2vU8hBxetCCtJmgDwhV2MDml4HpgLKIGS8btA&oe=6AAAA3A2"}, {"file_name": "Brushwork_Screenshot_08.png", "id": "667910758343621", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031630_667910765010287_8383872961959468997_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uL5rPgd92MQ7kNvwGhPLQz&_nc_oc=AdooIdWKxZd9kGInmwco2NymChE3520YlKkLyZMpnLop9tkLvK7mqOMg4_PvZ8x7viY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKX_PYiGDtFpKhd808J0_zudSJM_i9Zb1C18pvxRQNt3g&oe=6AAA885E"}, {"file_name": "Brushwork_Screenshot_07.png", "id": "813131183324119", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035407_813131186657452_3686359764945663007_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHucX_Bwy_kQ7kNvwH6LoUX&_nc_oc=AdpZmAYvZad7aN9fPyrpgviBsZ6LtbFqneQmuCENXm3NYNNV0fTaxBzBAfPIB3g-aEQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITd7ulLbeGPxYmxbHQDi74LnANAdE9C2b2KSWPem4tRQ&oe=6AAAA998"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Brushwork_CoverLandscape_01.png", "id": "495436912381188", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974653_495436915714521_1972750706282903248_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFcDWMF66QkQ7kNvwFXPVuu&_nc_oc=AdpETQ9v3Ndk8jmPQ4Wsn7q906MEInHBpXfECBIV5-EKGitJzZ491qAZyNM7d0Fz3BA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr0FoakXSQWzZ35Jgwhr0cynNH2inzzOtzJk_lL-2yZg&oe=6AAAB5CC"}, "display_name": "Brushwork Studio", "keywords": [], "long_description": "Relax and unwind as you create beautiful, realistic paintings in your own art studio. With easy to learn controls, you will be painting in no time. \n\n\ud83d\uddbc -REALISTIC PAINTING-\nMix and blend colors to get the exact color that you need. Brushes can even pick up more than one color at once.\n\n\ud83c\udfa8-CUSTOMIZE YOUR STUDIO-\nHang up your paintings, choose from more environments, and more\u2026 Want to paint outdoors? Brushwork Studio allows you to change the environment and set the right atmosphere.\n\n\ud83d\udd8c-BRUSHES AND TOOLS-\nChoose from a variety of brushes and tools to express yourself. Paint the smallest details with a fine brush, or use pencils and charcoal to sketch and draw.\n\n\ud83c\udf10-IN-GAME WEB BROWSER-\nUse an in-game web browser to search for reference images or follow along with a tutorial video. You can even listen to your favorite music as you paint!\n\nCreate your next masterpiece with Brushwork Studio!\n\n", "short_description": "Relax and unwind as you create beautiful, realistic paintings in your own art studio. With easy to learn controls, you will be painting in no time. \n\nCreate your next masterpiece with Brushwork Studio!"}]}, "developer_name": "Sunset Division", "developer_privacy_policy_url": "https://brushworkvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunset Division", "support_website_url": null, "website_url": "https://brushworkvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_inte
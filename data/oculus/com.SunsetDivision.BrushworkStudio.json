E1DydO5uTKMTa02ijhm5qsHR5zIZwGmow&oe=6A159D5E"}, {"file_name": "screenshot02.png", "id": "290724556122312", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974466_290724559455645_4126081024026600058_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=05lJy39Fu1oQ7kNvwHyawiy&_nc_oc=AdodhrDAxXBTtZGPjyrU9j4FOzRdq6QZyP8zD6TAxQB2tG04MWEWXcb09TTSPN45yjo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-p-7pT2L7FgqXSTDim_BA6lmhq7LjEeNDJST49F0hqg&oe=6A15A5D2"}, {"file_name": "screenshot05.png", "id": "475609780399649", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75429286_475609783732982_8975305124680428910_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuKCmb0bHPAQ7kNvwE376_q&_nc_oc=AdqIQ71XtkTKvQrb0Tbrcg4p56ic1PP0c8gtdZEMrY-4zWEZUn2vC2IiWW8K32clPMo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4374UlW6GO4KwSlpcLgM9ViQBvLEcizFSb5nJ1ushslA&oe=6A159CA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscapeEasel.png", "id": "1401697960210798", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031350_1401697963544131_2556062175966046941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eNTHQwWRqUQ7kNvwHvnEni&_nc_oc=Adp3LQuYJd_F-jwvsO4ZhSujBjQOhtceuH0jVJKWMRj5_HRLyeidvA6YVMoeL7GpfCo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sNnYyNw5lDFWmq4RuCfuvbkil9-95TrABIWMOs0uj7w&oe=6A15B59A"}, "display_name": "Brushwork", "keywords": [], "long_description": "Paint your heart out! Relax and unwind as you create beautiful, realistic paintings in your own virtual studio. Cover canvases or even the walls! With easy to learn controls, you will be painting in no time. \n\n\ud83d\uddbc -REALISTIC PAINTING-\nMix and blend colors to get the exact color that you need. Brushes can even pick up more than one color at once.\n\n\ud83c\udfa8-CUSTOMIZE YOUR STUDIO-\nPaint everywhere around you. Splatter paint all over the walls. Want to paint outdoors? Brushwork allows you to change the environment and set the right atmosphere.\n\n\ud83d\udd8c-BRUSHES AND TOOLS-\nChoose from a variety of brushes and tools to express yourself. Paint the smallest details with a fine brush, or use a paint gun and make a mess. Clean up mistakes with a sponge.\n\n\ud83c\udf10-IN-GAME WEB BROWSER-\nUse an in-game web browser to search for reference images or follow along with a tutorial video. You can even listen to your favorite music as you paint!\n\nCreate your next masterpiece with Brushwork!\n", "short_description": "Paint your heart out! Relax and unwind as you create beautiful, realistic paintings in your own virtual studio. With easy to learn controls, you will be painting in no time. Cover canvases or even the walls! Make your studio your own. "}]}, "developer_name": "Sunset Division", "developer_privacy_policy_url": "https://brushworkvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Sunset Division", "support_website_url": null, "website_url": "https://brushworkvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2158230701002064"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "921322594046194"}, {"status": "PUBLISHED", "id": "2144205676325144"}, {"status": "PUBLISHED", "id": "797176889597476"}, {"status": "PUBLISHED",
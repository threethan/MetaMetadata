621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKjVTga8GksQ7kNvwGW0P_g&_nc_oc=AdqHaeBBgUtlpQlL6USH7j0hmOWsMtK2Zfhv35F88iLVjlCTsH-vyXT5QvChTzj13l4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfJSsQ9Ia3wgEL5AxUTayc_t5RLlA6ImtLZNQfu6z_-A&oe=6A4A66B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQsBJW-l35YQ7kNvwG26ov9&_nc_oc=Adqr8Vcq_iQwihwYfwIbEZrrU2OuhvlquGH2svqL8SeV0tgk5-e9ZHd9Z7LCVgMYc58&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2R37FpqsiZT5ZHDa1LqIsxS43cqqRYD8_i-oA2eyHEA&oe=6A4A7695"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=THUa1um9sXIQ7kNvwFlq1S8&_nc_oc=Adqfh8lZRJOjGZ-1Z8HgXjaekxbW3BDZEvzueEfokdyNsMuXTj85gAJy0KveO6OLDms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEIrtfh6JZ5aTnSHWfaCSm9slFMTRlFVp5mpso7pobMw&oe=6A4A85C3"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxZoVAtXfWQQ7kNvwGjmaP0&_nc_oc=AdpS9E9QUmPdFUDzgPZ-p5BPdIrPeJaO8MOiNx6rPVfE3HAVvymSna87ZjLGkdvKXZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCKXhUXGwiMAsmJqjZvTj47qRqNrnuR9i3Xm6NRCzwhg&oe=6A4A6380"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LidHvBCSNFQQ7kNvwE_N-xT&_nc_oc=Ado2YxSBf4UjMT7Y9wNRVttTzjkKreCl0LtaJyt7uHBE3Y6Fe_qpIdV01K9dC0_WFPQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBWBBh32CPeY9d2-Z24OdoMADiIr1DEUhxDOmCu-OtnA&oe=6A4A559E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPn2BU2x_SAQ7kNvwGYg0ML&_nc_oc=AdpB3QTpI0BC0SkOkBwlAJeJgCf7jnCtmF6MIX8FY19kvONpj4s2-fVEkhsxEzbgtrs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoL3OgpWpmXgtOUCbCOI_Z1hoNfc9wCBzgI2c3WhJnSg&oe=6AD0DFB5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNX0vJlDtMcQ7kNvwG1ROrx&_nc_oc=AdpC9TZhPnSLUoi3RHVdX9hMfsXOItAL-qgRjylDlDn6VBL55L4LfwNE2SwXfPMZCFE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkBZnCM0LXB26lqYgGbexDwEQjoH5tdbXqXkMsW99NJg&oe=6AD0EF95"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEpchzCIVJ8Q7kNvwEvyhJV&_nc_oc=AdqIxfT06vvVfiZSHab9GbNibgvAp0USegZxyHuekZSK7H7Qd8ojY6IS7X6774-wVf8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq5jhM5awHm_bcHFteZbpBFxELvoqS6uzPX3Ak3rMCKw&oe=6AD0FEC3"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLk_KzmXSaQQ7kNvwF8aF_c&_nc_oc=Adqb_FbL0NkLsdbZRAfjsasQ91_VthAHkcX_eGGCnGRLX40vhO-5F28ryJAxKEX8arw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkLXRZ_EovPmTmL6lVFzr_Z4xZYP0pdetjQrTT1D0w8Q&oe=6AD0DC80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6_O7vflmZIQ7kNvwEKkASq&_nc_oc=Ado-Akre0c8dJWt7-rQ7IsdC1KcwVSg2KztJZUM5v1nbld3Tbhvsx_S9f3B4uL7RJBg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxsrYHjGLUbnTWwHzilXgE1POpKfojKDfqAVpl4BCBRw&oe=6AD106DE"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
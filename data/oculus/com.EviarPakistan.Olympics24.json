621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LZQiaTo5xMQ7kNvwGHDdcT&_nc_oc=Adq2ajrWAStybLuhXIhJeG0aJjvTwtELV-6k-QkbgdaVah26c01w3ItR1zSHb-FKdAs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ--c55i_-yWhSVjJfRocMIyxuYh0pYVWWMRC-iU3VJmA&oe=6AF9BE35"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aX_L-Mpr0oMQ7kNvwF3zq5s&_nc_oc=AdpkvZck6D0uRg-yPbQBWR0asLd5LnqhpWd7_21SS91un1Bxqz9Qg9Ya6u_W6hur41I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXPDm2RIvTW7CQV25yHJGL7b_sQhlY9fFruOWONe7Qow&oe=6AF9CE15"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g87KDNXCwIYQ7kNvwGIWZm-&_nc_oc=AdraMXX_sQ8Y59v1Ter1IhxMG2qxj28WeIZ74M3fTO3tUdi7YxOkc55Z5pJYlFsbW4s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMERfg3AMpsfhika-esw4QcJ_y4tMFjPrbsCGlWtHjlA&oe=6AF9DD43"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZbvfVN79vwQ7kNvwGAMXW3&_nc_oc=AdrYs_qZG8q2SYkn59KNOxrLTwyVKkVXWdPyHeLyjS9bP8i8C81RPtTat7DyJWKCJWo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvMduxmmVv5y8ZOzJ1Rf7CKy9kAFwbO8GCPir-BPBTHg&oe=6AF9BB00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q35UiCBmQaYQ7kNvwFbLfKW&_nc_oc=AdrQ-qsYGbj7vYh3kzymMLu3M9PhkZg6k9lSS1RVJSAfjQhb0YtAvWlBzueUbwyhj1A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBiQv8jBwi5AEZlr-JpSP4hngeXUcdzdtmI-AYvRZROg&oe=6AF9E55E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
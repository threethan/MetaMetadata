621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFlcjlpwFKUQ7kNvwGyKUIZ&_nc_oc=Adps3Our0XB2KMoZmxhFeClVbjIlQjYSENm26VyZKwdXyUUe0N-aAor0VDgCReUkrBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm4-n6NaoY4SyhJxH2ROo4TgduTcvB3V2-eltl8olwqw&oe=6ACE3CB5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNX0vJlDtMcQ7kNvwG8tuch&_nc_oc=Adq_MEwWNFMZ35ZWGw2JRfqsCSTT22rK_qEfsMn4bXrixd_AWAKbJEjLgeHZBhZQUiw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFHlksYVMPO9MedSl2PdEtNRS7fyU0dGBfqLALNJIY7w&oe=6ACE4C95"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEpchzCIVJ8Q7kNvwFIiGnw&_nc_oc=AdqWyTWVfeg4YlA0aoep59i1yN6FJR3iqnGHFik6RoY-rYRSAvzKCCK9m6I42Fo5Hfo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzfkP7fEFHBNNub0eiQ-NHM9hZfJbobczkC7g_vG-lKw&oe=6ACE5BC3"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLk_KzmXSaQQ7kNvwF2GS-s&_nc_oc=AdrsGH8CxKQ_uL41FhuZGFjsBonqZi7FzawleGKnKRd571yQ-UajHKd-FqlCgFIcejE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPw2ArAo7E403BGlvYmWOCS0VbEu-Syqj8nVPcSUNYxw&oe=6ACE3980"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6_O7vflmZIQ7kNvwHDxSbi&_nc_oc=AdouExYr3fyjJDqhouU1lYcadwyN1tTRfjjGF-m2rYokGwgkV9c1-dCdvPHNpUKWHfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcaA8OxApJHz0k1iTkVZY3V72yFUcvhVUQbbxiRuBprQ&oe=6ACE63DE"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
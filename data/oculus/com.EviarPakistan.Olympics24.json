621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLx66EyZGeIQ7kNvwGfOZjx&_nc_oc=Adp6Ht0XYCSalDPDFuxoM7rk9KOjKkq5uNHfEW3MxuBWMd9-upUdb4rOIjYYSZVtUBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDr5B_rZKEkOuXgdHWH2bG1L7Juadf-T0O1_6Kl-1seg&oe=6A95C475"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EQKRgWJtokQ7kNvwGGHaS8&_nc_oc=AdpWisIIf5I5aQjcVUi0qB0OJU1xdqMUu_kfKt6n4iARVHg8LtyERaIzG6N_PJvLrjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOJrveetQr3o31HOrGdXbmKS3MRkrw_Gbpj9S6wq9iMQ&oe=6A95D455"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgQH_Uln6XcQ7kNvwFzIMRT&_nc_oc=AdoKmIBafZPSoO3sw4Nkq6_BjoAdNPv4N7g_P4sKB0Kx33Rd-2BL4uSadUwhgdf5WYQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6bMy9Xia7KWq3lm7qfZs3n68YB-iHBXHQvZgujreXMQ&oe=6A95E383"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXyL70axj-0Q7kNvwFuwtJR&_nc_oc=AdpwM2ftyF5mwglIKXqtuDh1uGH4yVOYzv4kvpZNVDd085jyCl01Yq0rWlKMjlBWdJk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfHTou969ly6p8ge-9gnsbmL6999JU663T-kgSyix8uQ&oe=6A95C140"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJJe0Yf4cvgQ7kNvwHX2YB9&_nc_oc=Adqhz755UXfBWyVS6vrofps84sDpHcVOuCtx4ubeD3_Fi26img3HF-u33J1CuzzwQkM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcBkoL22x-ZyT0L80JXuZ4sOOm8C_cba_74AbRaly4PA&oe=6A95B35E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpL40_vA0owQ7kNvwGDpCxI&_nc_oc=AdrALnA8T1OYilWbWOIsYvudg40-V5ghM9_7C_FasKfIJVhRKhuUlV_RD2lKckehevE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgnMUGkM3mAB6g-DQFrRWbnmhj4YVkT8p3QwERTi3mYQ&oe=6A92B0F5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EQKRgWJtokQ7kNvwFm4Vrg&_nc_oc=Adqh-ufNvCO_gRrzTd_TUOMff2RUqSI3hh4CZOCRleQMZtX5iy5Go52TS5gDei4udJc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM_SwAxpU7tXOaG8QbGRAw_d-U7ex-JbWLOgu3QDnQ_w&oe=6A92C0D5"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygOzJI7T8BgQ7kNvwGmwPpc&_nc_oc=AdruCw_CHu1D7QAqaoW59QFMJQyJmX_9RWOdqN-HBoojmeC7lcPilncDEktmFrO5lqQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH610R0ML0TNEJIKxsmAdMqih_Kqb8GXhgm0yZ-Eh9qMw&oe=6A92D003"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZkate3lEi0Q7kNvwFAi0FE&_nc_oc=AdqkPtsgHLYZUTABVxisVj01p8gva74O0zAWugkeOo9xy7PJDeOzw37Iz50GmdvrvDs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiRvUlzLUhFMxrotH62rv2cfYJmv85Vqjla1n9Dne3Jw&oe=6A92ADC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czYTK6hvDLUQ7kNvwEmEYFn&_nc_oc=AdreARka6ERWIjoUuK6XlCgJh9bSdInYcY_-5LkNDMg_HyLmTZRVdWfIgPf2eLWKM7M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzPSrrUpHwpqPH1iktS8PZ4FVHI8ZiK1ZlvD8fwIyttg&oe=6A92D81E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
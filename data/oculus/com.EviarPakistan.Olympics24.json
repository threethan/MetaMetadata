621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAg6ktFUkjIQ7kNvwENW5_0&_nc_oc=Adp44GFZt1imGDshUxn8tdeXOdixP1Ql56AnOlHpVwcu7UOzkXi9zWB3AfZaZcAWzeI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BZfvrLecgExXhXvvUohDNL0LNTjBClGL1fmLPtqrCnw&oe=69DF9D35"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmj621h8r1kQ7kNvwGr1Cf1&_nc_oc=AdrRq3tvsujCrsvsECaz4JYz881bVY68kEiOjMbID65KL5m4GzSi9Gh9B1_H0-MRm94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ies2Vba9ShRjb1STFmOsvENqJ6ldtRenumdCs4kI_Kg&oe=69DF74D5"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5siwGu_2AQ0Q7kNvwERs-_s&_nc_oc=Adp7zZxxYOy1PkRdB6hzdzmBtEA_PKYgzXzpTltHFPBxO1oDAjfdAnmf6y_io6MXiy0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hGaxrKEiJtKyYEX0TbQIAojGu6YcSGZvHgahogGOBRw&oe=69DF8403"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiLXHEjfIBAQ7kNvwEVaUve&_nc_oc=Adpc8LYqBuVRfjI-7LcjPbFrVKm0b8ryK44oH_x0BHoMvHLppwkR0uir2B56RHvFXD0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28xgDcohPexfsg7lM5KuAMwvm8Wz78AzwTp3QVPLHCmA&oe=69DF9A00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZT0PmrCp8sQ7kNvwGQhWXT&_nc_oc=AdocI91ZU1D0QnkkPGd8rSrRViuKaqlGCdhxN5gBKXPBs873XN4b2zQLmEIBEe_b2xM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PfpyqAgRvgJ7EJx5cHBYyXAQjItBGL7kvYzRDZRFLgA&oe=69DF8C1E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTRymLLJmD8Q7kNvwFS84lS&_nc_oc=AdqnYwCS-rwMvDk0pdkukxtSFSMqk1dyZKtrBiAmAtJlUjONhYOhoy4gw8HNQNzGw4I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUQma_7c1iV0etJ3m7DrSfyIlbIsP-AQSNxs9ApZyZMg&oe=6AEB3DB5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akQbvL4j718Q7kNvwHimrVS&_nc_oc=Adq2-yE8JANjehmg_zMhr6oEYotjxT35lzyD576qCOeg9ACOL3Y2ZxgE7QYFV80Dk_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIBd3W9DC_jwpP1Gkok_OhhL7XYzBOPpZUYzNTV0JmEQ&oe=6AEB4D95"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRWZ22DI4kgQ7kNvwFtbL8R&_nc_oc=AdpQpFLDhXgYkwi5Fo2lL1kSlFuRsnedO0EC02yowRA1Bg1C4RYirM4Yu-t2IvbSL0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXX4X-06UB1KHZ2ZFSVKZN6p0ldhBWqa7-97ERPq0cpQ&oe=6AEB5CC3"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyA4HqkvK7EQ7kNvwGmngVl&_nc_oc=AdqTRoJGUR_7wPiM04IpoiK2Rjgh4wKw_HAhs871IitP8Xp2-guUsd35cOyJjskJyug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwp_m4K3bb992khS5uJIC2oqJhzMSezjkQ51kNVZxdfA&oe=6AEB3A80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9UHeIkq4PwQ7kNvwF6l6SC&_nc_oc=AdqfIrN-pjf1BGGHS_yn7hCFnFQsOLjlSPz3ARqCNktE613pNWClNRnesH0hZs1KciY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQd_prTOmCcsNzRl8h9fQHmgLiI-NCA-SnQmzvEy6cA1A&oe=6AEB2C9E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ar6LwaGBOoEQ7kNvwHDloUB&_nc_oc=AdqLU2R_mo-7tCH_ta2u8_GjfJOXG5vaQ7J0lKKjiXk3b8NkIgQK3M2f1qTuqFX8d5w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0LCmLajlhYT_NMPy9hh1ZO9Hf7TH14YsuJkcMHH-Rrg&oe=6AA169B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1nCTRYqb4QQ7kNvwGvMA58&_nc_oc=Ado9bOkodnXEbP9f5IV72dV9-METqZjQSIDMbAduAdk3kpXAYgU1D_mmX2L4KdH-9p0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL4QTlwm6k7OD_npGH0iBJsqnicCSIBBFULDUFAEufKQ&oe=6AA17995"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cunp-CIeW8Q7kNvwHeEPMs&_nc_oc=AdqfNIqU-v7fhuMNhULLzi-TCwuAhUibL4wdDVBdh6yagp3Abdf2OHG3RvlBzHYz0tI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHfb3gbX6S8pnYCvuN1Du6621hIGMrsYIwUX3510zouw&oe=6AA15083"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Glfof597WBoQ7kNvwHPnbhJ&_nc_oc=Ado8gB2TqHGqhz2p1OvqUTY-I7wf2aKz07D3nFk37l13DTakjDxlUPb-VFZ4qHuwnBs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlXrae3Mz0WkHU3iZZnVK1e6HhU4RHRsTnA5Yl5rrspw&oe=6AA16680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYZkzQxf4PMQ7kNvwFzJc8x&_nc_oc=Adr96AJ1dFW-0nqE2sNdIIBkvPOoDm85Y1ONYGhcprVkHV9BC3G3Ah_GQcqd_mKZDHg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKS9nf15DA5dbJevmVlulpbXCTMZ57qnsgug0CAX26qA&oe=6AA1589E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
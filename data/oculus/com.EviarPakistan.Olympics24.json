621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_qt-R6i9tcQ7kNvwH2Sd4a&_nc_oc=AdrWOTB1e1H4p-YxpVZNbxF7luApXonxQM_fkLjWn56g96rIa9QMG2Cjf9iY9tjfUis&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAozwar7qjO4Ejiuf7_tbLQK69aT3T3IjDbpaMzk4tXSQ&oe=6A6A0AB5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNR7RbGj-VAQ7kNvwGg7T9B&_nc_oc=AdqLVUef9Nvgpi5HcKD7Xh46OGkE6zey-r66o_oiUgRML4K78FKHI66JJF2k7kkah4Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZhrvpEbTSD3tCS1jzIadhnlLEpAsyhVNsC1Auna4CSw&oe=6A69E255"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTdJyG2hBWIQ7kNvwEhg1QI&_nc_oc=Adqlwwy4kWMgujwnZqZI0EjrYtsIxVj2oHbJI-nsmCgOtyICcIwa--AGec4AR-GHhtw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCF6R_DR4n3jS65Ok9x2vFm6Xrz8oMqBHTj0dhATdByig&oe=6A69F183"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tMBzasEkzwIQ7kNvwEIKVV7&_nc_oc=AdrzMqLMnXrML3P9D1PbMy8kQJAvZS9K1u1Vfd9GQVbrMYI4xA4qxlbSlnNiBMN2DyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0vDet5gunlJYt26r3natLNGEGsIvZOuWlEBNdZkLsuw&oe=6A6A0780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQXNenNPxEsQ7kNvwH_ZfjK&_nc_oc=Adqe-km4r0-wiS8ROJwnE06TG3bmodWS5fRnEK1gfYaHS4ysIw7jw5YfNs1ndyzDXVA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKDlDxYJ_T1Iou9A5EmD9aB5RqL1USh-8sL6ky6mSsOw&oe=6A69F99E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
593_185969621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfMkgTGbl_cQ7kNvwH-lGj6&_nc_oc=Ado_rstJfWpcRq8uFP-pQT2df2ZTFmQuh05qHPHSYNrqWGXhGPCu-Lwes3HeCNeLjoo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx6vSGtZRVOonQbXg0YVC_90eh7mTFKUGi_IX5V92fdw&oe=6AA952B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDm5ySv_0WoQ7kNvwGfEkis&_nc_oc=AdrfpQ_89UJ-PpmohHfMELsTlQ_1AgPg9UImSjnoPAD9_qKjAI2oiw_ZvSih5ef-JN0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeytUvdl2iwZXfHH55DpGFzOvjTxy4kswIVNRfUFnI2Q&oe=6AA96295"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mbjHbd674wQ7kNvwHJncau&_nc_oc=Adpns8UGtnH7_FP_9-3pZzqaFetIw7wbXaferBlWQ0Zi98a29CYOEO2TTT_MhM4anI0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbvcfD0EFu7YyFT7U305TrErHVjp-VlDO6p8RZ7yus1w&oe=6AA93983"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOHbgj7ah2EQ7kNvwFPe3iJ&_nc_oc=AdrB5mlb5OJUmtJ8ROnm3r7Lk85jUX45eOlsPC4aWjVMKgIPQJV8qIe6MAS1UsaaFt8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAAYYrLlfiCijwjEUTIRt5pQQ6KguGXa6zLmiFSFB77Q&oe=6AA94F80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNsXtJTd8JwQ7kNvwGcAt-F&_nc_oc=AdrQ7IhDjNQuFR5PRPKUP4dwDqXzTgccXBF8ksekrMJBAIEj_h8V5RFXIJlR2KUxw4U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy06w-KW90VDDjMdfffx396Ht9iaDdjVfBfCaEj8M1sQ&oe=6AA9419E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_
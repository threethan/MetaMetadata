621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg_WZdjUXFQQ7kNvwG9t8qo&_nc_oc=Adrps7iC6IW609buNLRwSlvGoQxVTZA0S7UrJ78eoW4kVLUBMjn01DHZdImdlx6NgTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B6QLYB2Bx8gng77Q-THU8cA2erNwmpd0v7HNHA5UeyQ&oe=6A3BE635"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJw7lEJbss4Q7kNvwGysV_a&_nc_oc=Ado-dGgwVVPwS82FJYpOOBfTgGdbiWGjP3SUYzkkMyxPqF1EKkDSOrT5LmOO7UwSMtk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZWUzyQiuHmp7DiefIwpFkQ19mFxGKWdNOfF0EVTfwTg&oe=6A3BF615"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wN9KKn_ESkcQ7kNvwFHGGUq&_nc_oc=AdqII2dhQQdNjLNAP5DkL5uYj3q74KBIdI35RvECopBkQv9TBYzMuO-JNJ9ne2AHEYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hBXtoBFSRaywOw-i5qv1jhoEJMbKNLuwerKbQ5vPc3A&oe=6A3BCD03"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8BQrSXim6kQ7kNvwEvY9WL&_nc_oc=AdpKYJl_NS_eh-xYUtjpx3hq1y6qSPwlyZ444MbLNclPWwYnaT1M4kbH7ns4Dhf6tmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E5vgpF4IriZM3arNEz665rpC-DYcHSxeYUnu4zvmSJQ&oe=6A3BE300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkytH_6DlMIQ7kNvwHRTYGh&_nc_oc=Adp2LHduY3MBRg7n8CJnEihXZWxWPgk2p0WlZtjJ9iHoY-P78ojtb-oEvtfeWgpDqbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Jv599L2PwPYkx1ALZiAwURPzog5rWlYX6DTyNi4qexQ&oe=6A3BD51E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
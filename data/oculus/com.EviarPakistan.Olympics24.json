621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm59895p3dQQ7kNvwG85S-b&_nc_oc=Adr77Nqps0Uz0Vo5IuEkviXB89dPuZcDe-9kbsY9bbBI5FHMoQsDMVThc-Z4VE9g4Vo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZtZkteRFy9C10_LmjRENjan1mb3uP0KY5bY7885lkjw&oe=6A75E835"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1323zPFqCcQ7kNvwEh_gUa&_nc_oc=AdqhGL6QAGs4cRC6vuiUMqpNtCGVkciYL0g6SzmAmtq_X9yhfzM_7WQjcKGx9GTp0MI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3yahu6tJszYr4ZVJoHXuWSWY07QVmOlu-vApBi23VtA&oe=6A75F815"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCl5CZQKMJoQ7kNvwHlje60&_nc_oc=AdqJZ7s1Nbg68tL9SfFsmsQZoBFeGKHrFKRfXZ6rFuC6v9S6eWZZAYr9JNTqyzhd4a8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnr44tx-Mw5is0FCumjSfd42imEs67cCTgorUUc1lnPQ&oe=6A75CF03"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMxRDwHZZyAQ7kNvwFYbzq5&_nc_oc=Adr6fSTQ4mkFFXP_osQA7ZEeNKcS8-XbarheD3JOaiqur-uAF0AvNc2BZESVQ7tO2x4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhqna0Ame69VKiHRKjMwSpPcFPtwzsLR1H3nIorrVKuw&oe=6A75E500"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IS1eEl6bD9IQ7kNvwGOAXCg&_nc_oc=AdqObkhyqUgplqAuOmZxBvzJTPAP-Ue0p-als1L1Eds_wHa8cd979W1EpOelENCsR-A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHJA9C63R7QvM8NgD4gYcTQjcBTQ-nTCsqUECj5b_iHw&oe=6A75D71E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
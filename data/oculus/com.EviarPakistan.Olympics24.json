621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BEpDxV040OkQ7kNvwG0E7oo&_nc_oc=AdpiAV8sFHH1zGUTNVijqUf4w87SHUUTHkw-3Gqv2c6VtQxLiYZ3MD_RQjgngglx0fo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8bUUyPV4kIeMPB6UUQT1W_9L1vsiH8kvmvEvBbHcjWw&oe=6AAFEA35"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syZfjJt3uAQQ7kNvwHl6MGA&_nc_oc=AdqGs8J8oHZXYmv4ujhPaAk-RYoAs2p67gtJ2_DNZq16ZCVJao7D-hT-uZGObAQqABk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDXyQPqumzWIprPiUw3ExKr7bWh8s8OUryyHH28uMJkA&oe=6AAFFA15"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r88AaLEO3Z0Q7kNvwEZVRr9&_nc_oc=Ado5KffvmSGEymv-Bm3JidzOIovT9hE94gCfKXwaSDrNHCiabQtXfqqVLIfKpkSYOF8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK51Q1EwVah5GdRIi7ZXEwMAvuSRqSphhOVwwSTCwD04g&oe=6AAFD103"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsR91vtqeVAQ7kNvwFC-Rej&_nc_oc=Adp3jPPJMmiXNQWanUN4gL0sR-Nokvc01f5Tp0RDPPTjdU5Kq78v6Wq8XQVjGfWyG70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiPjPVQEfTjTCnMGXpvUTcxFKcInsjkLE5BLX1NECSGg&oe=6AAFE700"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpCQGQV4AREQ7kNvwEnWge2&_nc_oc=AdrQ0cehVJUJrVYlMVELTl0XDIPBvysMv3gGQys1AihDqBbBKAXGK8JseJDpgaXyoxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsm8o5otmb92cc3cxI3WW-yqR2XebHLKfFiVSfRc1fBg&oe=6AAFD91E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZX6mTEg1_cwQ7kNvwGSbOzr&_nc_oc=Adr81cvGRnEF4eImJ0zp637YWbiyCuEnRtsdNsxP3lCiby5GcWyexGh96r3Actf_cAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbu8W6TS0M0E74FHK1qLjKLnaVCimyBM4XOOa9kA24bQ&oe=6AF326B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEoFOz3m_WAQ7kNvwHxyxMB&_nc_oc=AdoIk6c54GdUoPMS_j9yeeMtXN3PBQ5MTnCZRf5E1GHxTJOcq_T3W2siDXYEYBiVXe4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy_W2lBnuZnvjAyCtW_7kYAvHGVtXcH8in0VHCb8wJmQ&oe=6AF33695"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLBqzcgAB1MQ7kNvwHa4y1V&_nc_oc=AdoUlmP7LA9BPMU67uVM99fhApu0bZ2F8dDU0Ej7EQA-ZAd1h2SlurwdhhTHkoijUHI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2sEK5bfYZkba79NW7Aukbvdx_mKeSVN0KNtG_DclaHA&oe=6AF345C3"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvASOKZGvJEQ7kNvwGkdQ7r&_nc_oc=Adqr0u1_zykPrimLf3xChrHDzUDSz3khMLuHzQAyfzol6tcjjqZ6bMfh8TwVsKuwrWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSF-Ax-eT8Lzik3_gFB0A1_986ucey-PsD9amixxuiTig&oe=6AF35BC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugnepREbHmcQ7kNvwGDqSPA&_nc_oc=AdoTER4_jZjvXVZ7tv9gzpEqVHSxpQeTz_D1PB3wXeik-Fo8vQzNk-nOpFfLLT9Ce_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZV1dbu_vHky7-I7s6Tei3O2XIYLyxjD9RgYrozMPtvw&oe=6AF34DDE"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
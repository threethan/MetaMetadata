593_185969621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QSNmF_hJ-EQ7kNvwGmDyqH&_nc_oc=Adq0-WR37-RoUcChLGiNz4Scn4sChyrYLgAVgyOhPl-VsSqWSk7ngQCF7ozKprJfYxg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzq7zvT7HjX2Lze-mi2lmV-pTeX5kgD0HyHMJZevngOA&oe=6AA40CB5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiqHE7nY1O0Q7kNvwEtQUXR&_nc_oc=Adqm9ytTUSN7Bj3DSoSS2B0nuKSHE8BLYWwBWqxmOI9fkpQyxE0RSciPwQFA8m9W_C4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnYtm-kbQRNrZKjhnRmz6Eved6R7gPI28uL9DiOhLqIg&oe=6AA41C95"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tGaB4qFLM4Q7kNvwH0_nfw&_nc_oc=AdplmNohtUv5dd8YObW0EAlv16iYwYWzRFpOVJZf6XPPs0dPWHJI3MQqISJlLb5GeZ4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkkB3WaJNZGQlontVF07rc-6Yuo1f1UaIXuMoUisd4Fg&oe=6AA3F383"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qq7m8-lYs64Q7kNvwH3oIHh&_nc_oc=AdpEcTJ42dbPY5BrW62-MWbe6ftsPHQiknPyE5xICdOPkk0lkgk6dtQjVPr-CuzBfSM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx4QJ2WTpECUCJQi9B_p-81G2EOc9Qqax5B6N76NHugw&oe=6AA40980"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Q5otxkmueQQ7kNvwEK3bnu&_nc_oc=Adr4IdQ9aDzGl_KHi5eu_dfZtXpkNsBSshM8OYdffKzobS6X3349dCDGQvdcfYPkhsk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ4zrG6oev3VtBJ21zf4gGkXGBJ_PG52aBv0tF059MXQ&oe=6AA3FB9E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_
621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2A9swVNdjWcQ7kNvwFugVEB&_nc_oc=AdpyJJjnqxUKYhxgPu6qWG2Hf69kG62nVWNtuCOEtb71izRDiIBrrGGdC1G3CFk0G_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEI86TK8fx66R4mQ67eH8G_zGERS7UFLBBndBMdfkOzNw&oe=6A7B2E35"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3MCc67N5fAQ7kNvwFqr-5C&_nc_oc=AdpkCJnur9Y1LsKaJKlY39iNNtZ8thevHTT3-FneGUzlVdPXdayPIgkH0b_5uFB0D_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX42duGrmTkrxHvsjsZ71RhTLxfaqDsn9xjvYDwtTVJQ&oe=6A7B3E15"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1Ku5bq9_vUQ7kNvwHOJzvb&_nc_oc=Adpnu6ZvdEyUAl7ojydwaFQUwFf-tVzal2O4Krgg5Qd0IWD2vHIkoKxly671Rw2CX9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErRoyY7aQ06urodVClDOMPuMId4RpbdF1_ZvWsPfZS2g&oe=6A7B1503"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-pJPcSV36MQ7kNvwF2C9YY&_nc_oc=AdqDZ8gQ5fnVrGA6zRY35Xl-xTwa15OBrFQAwQ0OBaQKFuAqfw4JHzEc7glioEp7-a4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5aae8DBEPs1l2YKFBt8YQBIr4s1HZU2sTwM8zRQSWeg&oe=6A7B2B00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oUy-2PyAOsQ7kNvwFkzJcN&_nc_oc=Ado9p0iJuEZ2hAuNK3GeUck930DHUdAR170U7tHK95a-MwZGVWmOd4EMg4ld9ctJF6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_BOYCzVYHmxl6QUtHuJ-gadAT0xJ9xYMZUHq-384OYw&oe=6A7B1D1E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
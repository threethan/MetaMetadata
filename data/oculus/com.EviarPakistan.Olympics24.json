621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg_WZdjUXFQQ7kNvwFAopnI&_nc_oc=AdoJl1WzRTb2WX6ghQG8TEtog44Xeru1BOgC9JskFRhAdGZndv9lx1lVVaTO-aizQvk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83VqYv7jUAxcFJbU5k-StZbWcK19ez2Q9p4BiPbV5iqg&oe=6A3A94B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-LMDuny6SIQ7kNvwGPV_uW&_nc_oc=AdoK-kE4LhfQwPx9qnkjuff99X4mAs0fLOTSlHl68upuPmG9Rak14E9Wnfy7-ph5CJA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CU4vCNLPv9n-VwmsnQCS9_vRLAQBcf86Z5w-3NVmI0w&oe=6A3AA495"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qclKzefZOisQ7kNvwH1Lcwi&_nc_oc=AdrJWGvnRWSn9Lq_WXhxEQPYr8f5V1xgtdLQivkTHHrLQ67bYUOeKnclx1JvdB8yOEU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yUqHyM82sLJvQDgJXn2fDrBRGtlGvUGw2DeMiDcODuw&oe=6A3AB3C3"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8n5TLkldLnYQ7kNvwErEz9h&_nc_oc=AdrTXQA_8eUjLQ4tlG1wBa_YMnM-WtuF-CHbnJtFSk4mIAljdZaqQZLTAdXfcweeeWU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rug0IfgtKbYzKcGp0fvXH1EzUl7eMS2_1tGl5ZEl9mA&oe=6A3A9180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkytH_6DlMIQ7kNvwFLTWXb&_nc_oc=AdqH0sEV3Myi6Q2UyimMB1nQFSFY4_AxajRSkV61nL7QyVlP3ZJsOh5jlXgSXGwbE44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HV_0OAPAcPewLiZcR_rwJhR0fnQC6fjlxfQxkIFASxA&oe=6A3A839E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
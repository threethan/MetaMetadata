621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqB1Ftwy29YQ7kNvwGY3RkO&_nc_oc=AdpBO3zt9oJ4EqJwybCJSfC4t8VL7xSXeZ7G7h8juT-Hi-elPfMzYoEjkqxaxOQyQlo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jtjhGmTkgMDSyJOfQSUIAKlO6MjbOy7e2rDwFiEP1vA&oe=6A1AF0B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VIaOIFh0JQQ7kNvwGvt-cY&_nc_oc=Adrtsl0j1REIAyLoMem2GEdXE8b0OITJJWKFD6dOLUAZtPNrObYHs0Mqaxo1P0DZLc4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zqF4W06L-cxCHChzygZVgWAvk_Aqf6Gz770ay3eqD6Q&oe=6A1B0095"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPcf3Oi8FQIQ7kNvwHBk0RI&_nc_oc=Ado8njGqcYsZ3zwaoAfLw1PE3EP3ylbgai04FPGtSkfZb964lVR04vpt7gLHZPBGx1s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HkZJ_FV9n_KmSuWXkPuVdWm36OGFggcGKvXAKWQYojQ&oe=6A1AD783"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OfGl1zXWmQQ7kNvwEOFZGA&_nc_oc=AdppmBwpSRgzqtvApp50qNEpnUejNR5oyG_RdHONH2AWjJpE3_GfrFvr4UKUy_AB45g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KuvSS81VbkHncLprVI2NQSLa80Fw2BaDNW16oUSRTww&oe=6A1AED80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umI6z-Jj_KAQ7kNvwFctK4T&_nc_oc=Ado5dg1AYaTmKGdZuvHrOq53aQwRwodv-eGuTbClqnES-zodjTb1gFQZaUkri0a_rNY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73JH0m99SbMpHWvoEWaFw9x4UPXr2g3Oza9O8eelYMbQ&oe=6A1ADF9E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
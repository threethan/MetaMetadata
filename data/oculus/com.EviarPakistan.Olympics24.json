621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc8zOKo9YiUQ7kNvwGEOuQ9&_nc_oc=Adp5OU_qgrrIdRRNvvbUgIYF6a_2-NEiK8xu8JnMi6Hc061AQ3bkjm-hg5w7jLJrCSE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgZqZSe7jKwKCfjzWoSvpGyKAsZjVCY9Nojp3l7lTs3g&oe=6AE20335"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZoLvAt6B7IQ7kNvwGgYxo9&_nc_oc=Adrx0b8RWG7eu6JVwhCKnqytfpJjFiXAcEhsNdsxDih7_FyLj512wln4DYQ4ei3SxwA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRJCR0txhNtY6pTqtNWA4Zt7nvO_J18P2zik-25t2rkw&oe=6AE21315"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLDgeayuSAwQ7kNvwG7Egxg&_nc_oc=AdpyWkjLbKAKXwg0hUbfJcDat24kR0k4UsmLu0qCQS3F7UWRykJJwWwP_HijSis_GzY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFeGXI_vBGA6Epl-tA0OiBsVJACsfVju_RjXnzRHQxkw&oe=6AE1EA03"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyzAmNe1G2UQ7kNvwFE82nN&_nc_oc=Adrw-tO_HKDUHtvY7QKTLJxVV5XOqKHvj4yp4XnNuNtb1MiEPF6jjHtLLz4mMbIeTPo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMih9QRkXt3UHKxRelF80RHFdfBoU85Sdoiltj5gGqONA&oe=6AE20000"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfg0kaPyp-cQ7kNvwGaxT0N&_nc_oc=AdpHahU7N4gjQjhbcFMxT_YDhre_ILIdUdEspVdfaC5LR4mzMSuQwhLrMv67wzZ3B-0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwy11QqKiaXCjTrbly7gLOtLYg4SDJPSx2vXmQjG3ROQ&oe=6AE1F21E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
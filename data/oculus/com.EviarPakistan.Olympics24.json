621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGXWHV4XqmoQ7kNvwHNX8xT&_nc_oc=Adr0Qqv0dSY-PMyjLWhVq5d_EBlJhR-f7xobXyjdxOylJBDiIcPqpHLPDy2SRF0FuGs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FLtwnTHouGYUvtmE3ffxM_5K_Ext20qs8DVaQxEV4YA&oe=6A2AC2B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-dyjvqDpWoQ7kNvwFHnQZ6&_nc_oc=AdqPbQ3oYsZWjHBv0OU4hS4nuYILcQHy7HMWgeVl6feAEP_H9S4uIEtfPAWU5IHbWos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-smtkp0mTMu7Zy8XXN1HGrs3y94AKg2f2lw3-wZ7rBuA&oe=6A2AD295"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPSNjrjI3FoQ7kNvwGZBnPI&_nc_oc=Adq2sHvSsG57R8XurLNiJmPcOE2uiitSJ7jRy5ieUZQQak4aAzcfhRWPkMkTtT_zX90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l0GjlOZHP6WUCrypbtpTcLu1bWvmeGTEnNSvYXts1HQ&oe=6A2AE1C3"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ix986esdmpUQ7kNvwEZHz7y&_nc_oc=AdqFLMK-HXsNW3HaVmGnow-G-ceuIF7nf0JRJGnpbqiWXAC_E7TflC8N010zZ1Iyv-c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I14sLd5Y83tTsbW6ofdZWsg1uqQMReeF-UDfYP6EIrg&oe=6A2ABF80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ot9HRpyS8wQ7kNvwFX5VGV&_nc_oc=Ado6DlC5eJw0ZB_FbNpETgpjW6Z50MtFV90vrj5_LsrnxwvQRLX-u6BsPz-GvofV9HE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vo6GsjM4wjq2ynSnBflp7oKwFHU46iOe_YOl8aUB5aA&oe=6A2AB19E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
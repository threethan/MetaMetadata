621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqB1Ftwy29YQ7kNvwHlZbVq&_nc_oc=AdqeTio8tetP5JxIINexF2HO8TQM3JBA3nWISlTYp2eNRjhcZydFZ_QlKJB7x_EChmA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g-odTOtUXDZ29VSuqyC8vlfS0lFbnO-rCBZyNegvyOg&oe=6A199F35"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VIaOIFh0JQQ7kNvwEjViUW&_nc_oc=Adp6N3LBTWjS2-kVi__aFh_GKqUav7SgiasnoDZBQV2rpvbpISJDEyVqIyDW4TZgb8c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m5uTTIWAV2qIknmcr0xiy4Ovit9Sb0EZFt4jY4Q6kBA&oe=6A19AF15"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPcf3Oi8FQIQ7kNvwFE5S3s&_nc_oc=AdrmaLPdkp6_jtLQr2Y4L584RCOT8ermXgd5xsVMlwY_PmAH2x1B8AXh6kk60srNAJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cyKolxbSzMSDfUH7_MA3qkEPWivQFtn1vs_drg6QFOA&oe=6A198603"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OfGl1zXWmQQ7kNvwHN4n0-&_nc_oc=AdqxKLcXbfqX4rQh0tlnEl6nKlcc6paH0yLFQK5HLJGyjEiIVziCVf9MU_x-LKNgVOo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oW2yWVR31Q0CZT-TxnP6kqDX8c6z3wTVBlXiDjNEqJg&oe=6A199C00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umI6z-Jj_KAQ7kNvwH9uRHH&_nc_oc=Adq-xUp1gwvyIydXRvXqOa_WiuLb4_5k_bgN0d9mX_xV8YbbHOFZZji0Q2iOtBJYRf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uUEQxc4LVcrnY2WYOyYva24uByAjjf2ztsJgYZY83GA&oe=6A198E1E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObD8HKesmBsQ7kNvwHD96C3&_nc_oc=AdrDzplT6DALEPPEVZ0nHzecGJnxyIr2XUNb9b9LBAP3XV857V5QsZePlxz2BlbIBZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK56VMxWOcKVy2xSZM-HMJ1quB_9nLcdNOeNS8pr4_bQ&oe=6AF083B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kPMBI_Flk0Q7kNvwEGe89F&_nc_oc=AdpnZykps6q4H3wSe9UQ2KCe7d3M1Scme61nygARhsZXGqT7tyMAX6SkDxwNDf3Npsw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOzekeZuZ7eADTqD44eTvKCVn7bn_ARbpJMKVC95D5-w&oe=6AF09395"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4GVJU7dr9YEQ7kNvwFSc7e8&_nc_oc=AdprEHlBzWYyHZAfLoPU-lu8gP2DXMDxk9Ff4ds5m3NZpR4JiVcOxawoRxq1_Bs66SA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStT7eOPblwR-8L-ZQDo3gdS2_pAHotnYosD1RKfowBQw&oe=6AF0A2C3"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_4mZ5gX4YAQ7kNvwHKK6cc&_nc_oc=AdrIIqC1DCUCDBUgjEeUPi7XAtW4t-q9gphQpuQ5AAV6jTrFVV8YY7d7dYRoNUhlB7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3zvuNmNOJ8p2NQLM_QzW84k879FpCN-dEeVDA5pIjYA&oe=6AF08080"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAYf44zri-wQ7kNvwGOvYqR&_nc_oc=AdoLAK-eHtrx6hWnU3a46asLs266BinxCMjkM78_nt2UOT87tz1MzndhSdnKdSRS-Ug&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjaY-be3dANBqV382XAK5K-cbupeqPdrfNwKKVMPUs-w&oe=6AF0AADE"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
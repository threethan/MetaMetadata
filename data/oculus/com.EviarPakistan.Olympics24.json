621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpL40_vA0owQ7kNvwHsVF8I&_nc_oc=AdpeUTIUi63ZrES3AECIYWy2wp_BRpFFW29ivE1Gd-ClBLIZXudIpI2ax2Xxj2DMkQo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFo2oESaWWYf4kqMtk3o4RLKI1eZWWYwqcbj1rLmx0TgQ&oe=6A940275"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-EQKRgWJtokQ7kNvwHrO_bT&_nc_oc=AdqWVcLzTOeZwfxY5NAnY63q-T9poPlJE3Kv0KV_L88FFs_s9Dxtq1sPQTW3dc6q96o&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3F_vIYAR4Zcx1AxBaccPgz5iVz1MDLtnYTf1slC5NBA&oe=6A941255"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygOzJI7T8BgQ7kNvwGFQbjO&_nc_oc=AdqxuMquTCcaES9Jj147mvsd_4JHTKcDQ9Y8zg6CfWTHH5uif2WLbDAtgkM6g4HRREQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh9Gbovj9XATZxiPDIubG00NtrWrti_D68HwKSu6YWNA&oe=6A942183"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZkate3lEi0Q7kNvwE3YGG-&_nc_oc=Adr4-ZBmbtVCZraoiCfOT3W89v5QGDxmhY5niKmWSHtBla5m216AX1EwRr93F9ok5no&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0XhinHefN2U08eF_TL6p5ZVLi3j5oShA4eRzjw1j9wQ&oe=6A93FF40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJJe0Yf4cvgQ7kNvwH8_VMp&_nc_oc=AdpZ6-wr4VTAlXDzNuf_k73bgr_N2AWzlveurrQn3Vaaqb8-zbMDBs3PV3_r4v5pDA4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFASutgBww2lCPy4RrDkz1NyfJY36r6PjwUQv1oBJzNlg&oe=6A94299E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
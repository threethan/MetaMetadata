621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDNVZvyv16MQ7kNvwHI8_hr&_nc_oc=AdoLy8H9jkErjJP7pOwYzlFDbdg4aUqns-PVl-mIyGAKQc2ux9uQKvZRV10L0pQK6Ug&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CKg9qKyMQzfURz3lNpEiI1oDfoEZoL16o8dXcRoyNsA&oe=69E634B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZDWht6ELQQQ7kNvwFlvsrA&_nc_oc=AdpFSM446PuMFHQUnPmswDq_Po-rIKVdluFeTBKPY10grQt-530f1EFH3F_rsVmevxE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TMzcErba3TyMvJO5xyDgg6zqLJkVx51jwgtSx5CPrgg&oe=69E64495"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCyhnAMK3FMQ7kNvwEY7ak3&_nc_oc=AdpVLiMimUbUj9ls3eTBli7FA5_u29LspQx4-uWJjYiaXOTzowNVycncWFVkUi0pAJ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-nU5e2mMGvj3kKuDdtuMwRZJQxZZ9RPEtI3_tMSqCxQ&oe=69E61B83"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfwbBNpZoPMQ7kNvwEuqHOL&_nc_oc=AdoaPWf-wmnvgJY47vU1Fkk7UoKqShKqIT4C0plfIFWrFM5gEgRbfUPXvrwicJkgkto&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1glK3nLOAHlt5BiBc-ipv1L0xaKd5DMrX1mavHfOqWug&oe=69E63180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvGYzILZDOUQ7kNvwERdt37&_nc_oc=Adq-461vcMLH3RicIRR87dUwIgER63QU7YG-hOBnQ3Ad2i3Zpl-ZbBIyvqodYdAt19M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3z3CyN7gPSXGjh3y4IhROp-tFB-xYSda0iD0k7Ax6A5Q&oe=69E6239E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
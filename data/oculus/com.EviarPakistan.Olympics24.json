621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klY6Ri_2XbsQ7kNvwH366io&_nc_oc=Adouq37CZH-z9BcQ4TOQa-ThPMdIv9sMjARZMJNeWHlAaaAn_6dCFh7Ss0t_zNLfOdY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J3_2-Zz6jDAFfijOVWv0BNbdSGmj1qwk3YUMSv2mslA&oe=6A3FDAB5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiyJG8qOVlwQ7kNvwEv-v6L&_nc_oc=AdqIBzcXTwTJvvhkhhfTQ0QIBZ7aHAUZGeW-LI7pWm2uXRJ9G_zcno_Sj98M1QKWrIA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jpeiM1RFC2mdaqLRQ0rLq-n078dQXtmsb_54sNT35Zg&oe=6A3FEA95"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf4HaD7At6oQ7kNvwHmA0kN&_nc_oc=AdrDHqQ7FPrg2S4t9fFbIsU0CJD13FB--_h5t-IpGmbAI2Y_cVV49rbHT98mbOQrGlQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aftaqafSTty8nEmFWCl0m7MHdHuRHPx0MXv9qNjGnGw&oe=6A3FC183"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cV-YiMCxuwQ7kNvwE2MOtm&_nc_oc=Adqt8_eTW2O1NQDV76xmXOOkz5S27xhBQSrIRLeFPIAb8gevLq2FkPFvzuCB9wZh5-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zQbhN8_QrvoVWg8XqxV512DvYUHCRCSS5jWxotgiPjg&oe=6A3FD780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbO7FX6P9_QQ7kNvwGskCAt&_nc_oc=AdqSG9pBcgWfqV-28Tzfv4gQwd5nUtukFgud462wDIgGIcNwxFR4uyODBMlTlQdyrdA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DYUnsSx7HDvu7lcszHSTkv-5YJzTI7pDf4hiczblv1Q&oe=6A3FC99E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
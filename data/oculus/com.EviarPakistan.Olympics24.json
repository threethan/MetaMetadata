621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTRymLLJmD8Q7kNvwG2L8xA&_nc_oc=AdrrBej1AwGTBJUrp7dthMLQCIAulFEqVJo4T4TO2isqP5A2xue7_PcroJnlx58mxik&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKjFyvF133P_W5CDVfrMsaQXl3hYMRJp1TqtKUc1OFuw&oe=6AEC8F35"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akQbvL4j718Q7kNvwG3kG-3&_nc_oc=Adr1PD_k7D6txmTLcbCdSENL31YwL94UXkGGdCW8SGAxwR5ZIOLDehDCOKPSV6bUOow&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkpl0JVlgPTuCOl7EgTSFE7zKsMAZ7dtERHu4qE4ko8w&oe=6AEC9F15"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRWZ22DI4kgQ7kNvwGUMDfp&_nc_oc=AdqhR529Z4iMykq15tsnan1jLEgsuvqlu0iL2caiTWQCbE876e9hUGmkdoe9bWabE1A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReKd7HSQ2_gfAn71jumSC-UAmeAqq1bZKxEdy9xn4LPQ&oe=6AECAE43"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyA4HqkvK7EQ7kNvwFpZhy4&_nc_oc=Ado4g5tUPe-Jsr251HCp7g66fVYal-oeDVM1hhvof0ViEMYllsv5Fq2pzGdiz0cpsNE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHobjQuA7rdE8AdEw7uw8uFdOH3SAFeL1hNmPs9lotwg&oe=6AEC8C00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9UHeIkq4PwQ7kNvwF0l5NH&_nc_oc=AdovSNiiyRXOiLvFSpJYzJyi3kiGwm6fLdhvCpCU8eiJXgOQ5739j0V3VQxMFLPE5-0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoRBL1pW-VxtNxYUt_-M2KJIW4LyEPDU4Ta6M0Lz4I3w&oe=6AECB65E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
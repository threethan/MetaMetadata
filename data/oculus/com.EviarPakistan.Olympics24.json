621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gr8TLG8Z6h8Q7kNvwE11u60&_nc_oc=AdoLpESdKvjl-lhQWJ_aXvtytwI3_B4PmxXaXzYUe8oepVOoa3QPszm10wH9wbxZO8E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwwHfXi0ijr7VUQeJGM_KqWBe986QZ-YqshmFCksewfA&oe=6AB681B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R7-_owVQw8Q7kNvwG-1Phw&_nc_oc=AdqkeBeNp6F2GSblzLyB9F-pA4MfMzlVvtnj6DAVrve62xFWLdrZfCLNuR9nHjOg1RA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj6zikPCBw7eqLgok-v6uWcszOtU8zHGQo-LC2UR3HFw&oe=6AB69195"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chkiakNFhr0Q7kNvwE_OlgW&_nc_oc=AdoRJ-IXho02Nj4Vbn2VYEMIQLodlOWTc1Kx_sCxM8s3cyhoTVVr-B4cYy46Vnoi4YE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2cSATj0SxCYVZCMZIfL08TJtQcqbQO4DKtNwVe3fNqQ&oe=6AB66883"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGIZRM4zJHwQ7kNvwH9wDIg&_nc_oc=AdprmZlHj4ESWtaPSVh39HDoQ2AGiS3DeyeAc0jQxpthtzc17fQrzNBSBkH__Fe3XZw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0uXXKvO4QG4ggcdf3AI7qrkWUDIZ-E9FVRmRAOACS3A&oe=6AB67E80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBjZ8avqN44Q7kNvwEb1Xcb&_nc_oc=Ado9aMbi4DCpNR1wclyvF4zMrUBXxCAuax1LJtbT92jxzbGtTwdAZAGsWi68vP30lIg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPRaX3yMFbpL12OfADshSXIt7la0rHDLdFrl1bYYeAlg&oe=6AB6709E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
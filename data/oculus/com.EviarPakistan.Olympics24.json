621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ny540uYwzkEQ7kNvwE2Jqtc&_nc_oc=Adr0RBQfnbr1MguSGqc_TRXrBoMYydZNTqsTOnt0yrGDn7mLh8DgBWfg3sSrqRwRmTc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuBP7Ab93vPucrGi2jKd5tK28mlEW1oCjZjo6Sa6WDxw&oe=6A81C5B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4yjH91VWVgQ7kNvwEPHDva&_nc_oc=Adp8ROASDYMfcfa9f220FcrfjNlWTSIN7RxgzixAJgUujmBk4RQ3vs2h-ouD7tYC4mA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrcWO0C2FZFDnhtW-u0wkNPmtI6CAayTXnKwi_T1DBIA&oe=6A819D55"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuQUNyqwWsIQ7kNvwGZQOoQ&_nc_oc=Adr4vuoC2wHWQK2zi3QqTYWYn_t_UyQ82sy8c0f41iowL0oj5YwdnCCFVC57WWMonE0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0UlanCfDHOfJXW9kNP9WFUbXeaZcwpuz4hwdz04Eixw&oe=6A81AC83"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHy4CHsjAncQ7kNvwEXFiuv&_nc_oc=Adrfy0uitgzfjsMwOE4KdTF2z6U1pj3gWHbyI9CMRtVhtZlqJL6rKofm5TFpYFGSbps&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5Jlaa41t9G108b06I0necvzvCM915Se62NC7nAy0fUQ&oe=6A81C280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pPaOp8yCY9MQ7kNvwG6N7Ni&_nc_oc=AdpEHZoHQ-168x9ikivdShuhFAsPNz_KQbOTlH6OFP_RRgn0WH_LeGrsLQ7l8zqUutc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkh8TTh3Ju6zcksKTkvqlmiLdUZzsTjdc1xBj-uJug5A&oe=6A81B49E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
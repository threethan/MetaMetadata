621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS5poqUS5kgQ7kNvwEmlO6Y&_nc_oc=AdqmDPtHSIIF88WaEmVBU4D4i9q5KOmQrkjG1toimP06Vj91q_yri1o54zoznDdw7Zk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV-WioLZCEiEMZAvaleMQ0Sj7VuQnd-BnhcIOfF-U6FA&oe=6A6DFF35"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y67TZWjG9vIQ7kNvwHt4A8U&_nc_oc=AdqXT3b0iZqgigK8O8I-UlU-HvTUBpq_jVKXTjIEUUFAlEzcx1EsR0xe477Ocl8qQCw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2XfiQhjQPlTekcmcKXjEhL7SwMASjMQr_PzkzMRCozA&oe=6A6DD6D5"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-rLIg02YuwQ7kNvwGzVble&_nc_oc=AdrDlDDNFGxzhtS-VmUilDJxDHTH4PUObdkfseqKfSvHZ0SyRoNoSCkf2VSSeLXoDxE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9PHSlJBzOVPK_u9Ouqf9FkXe_k_-8h2cUeC3NX5MtbQ&oe=6A6DE603"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oVS2MoGfXIQ7kNvwE5EPQR&_nc_oc=AdrvkFDS6AerTGQcPWtA9VgrP6N2YZbjJzTzk-_nVwEDjpcWbCIGtSN5rmzDQETxwWA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp9jqvlyWsRF7A8Wtrg1_ULPLkphTqdKwO6dLK80NyQw&oe=6A6DFC00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuduJ_6b2SgQ7kNvwFQgx_O&_nc_oc=AdoJGIawhm4vVhgV4LAV1RZ72jzaJeW4NklxPNUNM0j0VutzeagZOsUH-1g3Jw0x8d0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDr-o0Z8TBgoUoUC5i-5mvSyZLQX1p7M5UQtEb8cIFqGQ&oe=6A6DEE1E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
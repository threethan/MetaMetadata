621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IOcRWBYwjUQ7kNvwG5U1MJ&_nc_oc=Adrc387xgmvziFmcvy33PY0Lg-h_j4bBEZBNysx8oVmPi5BEQky3Elfues7MjIWt7zc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxfL6G_Glw3R7UyhL3pc_7HDUS5QqMEtQfX5nf7sJuvA&oe=6A900DF5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olyQy4O9g1EQ7kNvwEPgSii&_nc_oc=AdohUYyKM0vLGMvCT8rExzuPXu-LcluU9vjXf35Y8ZPiVLYR_Eo2LccTbsg3YEdOEcs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-ESvHII6lEjpKbzAFrjHhEQyBJZpbVGh98Mv6E3WErg&oe=6A901DD5"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PG9Mkw1BkOMQ7kNvwHDO0Nt&_nc_oc=AdoJkC4eMCmPasn_bdX-8OFHiR7yt9_N-ESl3kMrHnVY5gF0nwtTRUfoznuJGAzNUjs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt8UuoCpHivBYbrAEI2XSExi-dxvv0JArDjiMMinw7Sg&oe=6A902D03"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txl3FLSwkfoQ7kNvwEM3brq&_nc_oc=AdoFzBQPH4w2WLHVbPX7CreTopngxHEG7A8TSAs9W6UC8mQsnBHrPbkpoaopoOpPn5Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4TDZcVD04ijS2UhVBUvztt_w6m6ATKFHCd17tUk2r3w&oe=6A900AC0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czYTK6hvDLUQ7kNvwESFu4Q&_nc_oc=AdpCajkhz76AnIkFYU-_CMysxg_FP6hWUWDpt9FT9xPT4fmG8YRQ9thNtJCgeMKGYjg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1ntXWhjTAuYkpJXLlVuwgqBBckKNRgCM-QAiBmsTOyw&oe=6A90351E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
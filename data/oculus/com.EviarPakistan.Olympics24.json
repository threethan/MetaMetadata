593_185969621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRtKcEgvaJUQ7kNvwEvkB4m&_nc_oc=AdocvjanwwZV8bb7dVJRDT4bvI43nwGFECO5ZOfhVbRp6wwqQ8-VkCRpmlTGLX6_17g&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fUA98oLqBr_Xl6I6ASYM-EmvumZbEE3KJzUpAWjgseA&oe=6A11B635"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1dcUQyFsBcQ7kNvwHGC03g&_nc_oc=AdopKje3I-baFpdrURxmrzUdKwjH30TH_kB_2sb1dQwsBSlGTrF4mMZCT7eCFi3aQ3A&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hzC-ykqCFpw8c9wisVrq0ZkZB_l07q4znlffPBIAgzQ&oe=6A11C615"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4LubDw3BZoQ7kNvwEp6DDS&_nc_oc=AdoTu7xdfsJ4Gc9v2aO3e1Jg9zoiJWaNqLGEKjDPW43vLMxC9jCVBzhhdaOOSvV9uts&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75XhoSOxeuA-iUPLyRNfuInH5xAJV2cdhNNSUuvKjGuQ&oe=6A119D03"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7dUWbo7EfasQ7kNvwHereHg&_nc_oc=Ado9EF32szyRVYLwrZeRdrq_snRc7v7NKnG2r6xnUnNL_O9vJRkQ0-pBcD8QH78lU2c&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aL_8xjrB4rYytS4L_pjiXXCtwV6DrcK3Wot8WqgEzgQ&oe=6A11B300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoQDAj8ZtbsQ7kNvwEFpr1O&_nc_oc=Adpvy2GmPltlOGs2pgcr6DmBKjhWXL1x2Xd-VlcH2vTYMce2ShF3-GePfgB02hTx1Qo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hv22WsnFKcQqzWegTTSdmDYBXMy0w3FC6gK91cJXYEg&oe=6A11A51E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_
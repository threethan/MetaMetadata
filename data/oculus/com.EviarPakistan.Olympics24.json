-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DrRBWXjPpcQ7kNvwHyzGPs&_nc_oc=AdoNdpKLLNfUS3K7ej7BTakRlKj9oEeb3DumVyHhdvBAdkY9Eh0hnRTn3yw6HaKOwFA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLu9yIC3z7Ax7h351vLEq4toRWQokBNCZCjdINGvDbNjA&oe=6ABA8615"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrrisa5XOH8Q7kNvwEdS6-M&_nc_oc=AdohH1Dy2-VPG_6Zc0p3Q9H0_4bxKi8NSyMwx6_Xn7QEFzkp5loleoXjZtUwHhYGHU8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuxYJ5bb03Ew7l6AE8sk3lUQGva-mzE6h1BT54PV15FA&oe=6ABA5D03"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSQ7VdVjj2wQ7kNvwHPsjOl&_nc_oc=AdoFErfcap6GYM9h31zqkXK_4rhA8QoVGmXO5L6AS3dgCiKB7JKwPp7T3BDWngw65JY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQxryQu-qMMno0i0S60owcWJWA_yQQ70CRN0sKoSfBnA&oe=6ABA7300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O782jMpSsMIQ7kNvwGYpcxQ&_nc_oc=AdpOXh8VQqJVuxAGLpD3y599QZjEq2tyfDMBGHPjOjOmTqLwYJ5tZJJTjUMnqZp7PPc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFIABQQMCsqpkNqDaOap_n6CH-pPiueAE46KYAFUpuXw&oe=6ABA651E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI
621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuwiz7h8wF4Q7kNvwHBfbrA&_nc_oc=Adr0yAVTpXnJvMmVwZnaQzjLLnGmE_c6aMw810WpS05sKFN-gzjJ04tmcTvJz5YAVeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOMJIz35EppHakzGU40KQFa0puS7iUU4-8N2YuRhS-qw&oe=6A60D035"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=28nHIAElDoEQ7kNvwHJHej8&_nc_oc=Adq5qzBCFNqXXkDgJA75xowZHmSAZSbCJZtpu93_lMFgg5Rrdpo3gUQ5b_ggvoqgVvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3Z2cYHCiJIKDE9tJo5sWLshUZC_b5zCxZccdmQt_wZQ&oe=6A60A7D5"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLnOXpeomC0Q7kNvwFzZEg1&_nc_oc=AdoJJDtm3TgM9LRkArjnt2MqU9IJh_ThBoN_1jKXqesFNJJG_GRCSzxvvinBtzNDZHo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkWoHK346qAjPUHTfLCRiEQu3ZAXyKODRTSx44OjS39g&oe=6A60B703"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HN4PKdg_m1wQ7kNvwHdjUcb&_nc_oc=AdqXMB3qxBWptqw7KrtN6ng0ulS2rGHahsFdbXu0gZp-pNzXNPb-RELIdYw0bI0PSJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRIDrii_idjiOOZGaSULHGT_94ZdUp-ld_OG3xT31t5A&oe=6A60CD00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-67qxgd3s0EQ7kNvwHhyGoR&_nc_oc=AdqMknLk0mLq4DDMTzrKJc5xKBCpIK4jUcd-m8prr9iZhb80SwWi7VVhjnYFc8v7MXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8J4cS1Z-8sYlIr4ZgaPaHzs1VjITd6EizkZGGNONkQg&oe=6A60BF1E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
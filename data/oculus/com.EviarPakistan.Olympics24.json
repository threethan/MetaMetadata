621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klY6Ri_2XbsQ7kNvwFUBIVI&_nc_oc=AdqsKkPZT5FFik92yHQ3Kd2K9xw72_-pxD1gcj-eUC2tQno3Q05pGf4Cbeqa8hcJ8ec&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GSmrTH3_Wxut2dZpU-Cjz85F1phKfeMQJEQQMud1ZgQ&oe=6A3D37B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJw7lEJbss4Q7kNvwF5JZuJ&_nc_oc=Adp1-tUWMx8uFXAXeIXu90zjeg6S5FKh3jkD6OeeuoUWVKl-RdcV-DcUKWP4qwV9LHI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UVB3k6C-c9LcoDN7AJzAhEszWSEyamS5m9j1NDP299g&oe=6A3D4795"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wN9KKn_ESkcQ7kNvwG8rUqe&_nc_oc=AdpRUgHyMyICZBJfqzY2aQm6hvm6flwF-rOy5_jLNC-qWLGgpeD6uBcT1xVoc0HnU2I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z0q4cFRD7LFoRRuj9GfFxb13O76-iMM26E1FngpzM2A&oe=6A3D56C3"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8BQrSXim6kQ7kNvwFEAL2u&_nc_oc=AdowyQRO_BBC5YpSi0SHKrETcNCxIRNdJMxqoYF7-9dr1JbE-fCX5LfcxeHAAeFsykA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kMg2dxcd32Uqe2v6kLgFxVQoowWrVNBieKBtMyqoZmg&oe=6A3D3480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbO7FX6P9_QQ7kNvwGFryak&_nc_oc=AdokZPVTgy21fE0Zu0rFnkKD5xkPLr1vV3cs9zbrVMsQabvO0v6aEje5WmP3Mga-dM8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rN9lzCnWOO4kEIv_L7ZkiIxKzFavR6OOV9GyhW0hd-g&oe=6A3D269E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
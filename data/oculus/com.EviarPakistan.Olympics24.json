621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDenV6ZjKjsQ7kNvwG_5FkL&_nc_oc=Ados77kG0CdcYm6Pln9X7kLiz32mgFR4TzdnIw8OElxQsfXFS2hf0a_KKtaPGU59sCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNfq-TWOiPvsUEPVlmBlZCUwYU_pGTRUCht0qiLwiDbA&oe=6AB7D335"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R7-_owVQw8Q7kNvwFVdZ6-&_nc_oc=AdpKH7H4vbtUNlrdDdMFg2evAZE7j0g4ECTkgG7j8hPcl16v1muSAf0Cg1N-rW7vf4o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCSzYdGl1UbVPnZzbnZpbzDmGqdvqnWRBT6cZwimdd5w&oe=6AB7E315"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chkiakNFhr0Q7kNvwFl7DgA&_nc_oc=Adqt5ESLSNQhV7qUJtjZ49mT21BUliUUqat9RD37_R2y7fuo7oNy5_OLcTQUG6wcuK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkXiyTQIrzNJjqcFEcxDuexiGSpRkpWGty1dpWgOLUaA&oe=6AB7BA03"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGIZRM4zJHwQ7kNvwHRo3Wh&_nc_oc=Ado_vHkkXkUTdfxVk1vgFsCY4xE9NcoeA1rePKvaeQAAcSxgjgWFElc28dbZ0kcuTiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKASyv-NISFn7QIr-BhhXwPillCanvAvAwoVdbKSObD_A&oe=6AB7D000"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O782jMpSsMIQ7kNvwF7-AW5&_nc_oc=Adq8ESb3x5-7khlQITEgP0Xl4onl_dIZ0YhMm8xqK61odL6aUN3AKwfa_B8HsOjtOx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjsGgPI0tTghle0LBYZLvQBqOhogwFctHsZLxx6wk6Cg&oe=6AB7C21E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hw7dd8Lr4bMQ7kNvwFgE5VK&_nc_oc=AdrQTOxCe4L2e_JuOXzS-wDfLcUvQQWZs6Q1RsDt0waUBKs4Mj0khUhdYQH320LIwls&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O7es3baMmIvPoKkoeXFkHk_9vXW2_QCejYB79Vdf2OA&oe=6A09CD35"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksUXOE7kb5gQ7kNvwEQYDha&_nc_oc=Adp2fEO3Qkq3DO8gjhdvjvCYB-fYLIwQdz6IGrbXr4Gu3tImiwKIgeLg8B1Xzyy_tIY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tNaH6CB3Rlw1huwamSWYrlAHF6Ad4DaLh1-VOUHpe7g&oe=6A09DD15"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auh2pknEpGwQ7kNvwF-Ld18&_nc_oc=AdoXuRW8_CNOl3ySSIB3Q65jY0qd92P3aw2a3JTChOgPhfyAu4uILkideuxzFonW14M&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68ZUQclUyd688cQgSl8ygu2JXm_Bb74gQ3o6iCnwmt2Q&oe=6A09B403"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTPyatEaxuIQ7kNvwHTJK4N&_nc_oc=AdqEUJfuXG1-9duDq89CYCrQY_2YpVQMFtWWam15kNYJ2Pv-sAPjsLdc6UvY-eNMdnE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZLAf8XBtHdfQkftxi3ueUQ3SzXa04QUfsfrlb1u-7MA&oe=6A09CA00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwAxE0GbKqAQ7kNvwEyjBIG&_nc_oc=Adp2qnFinn9D1EURRDREbH_XXJvq89t5X5bosS8ET8pl1WRiuCHDxZ_IfuulhDre3IQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45yX8vC_ct-fgqNoweRqt8UtoU-V06JHcaGJmkyDsOyA&oe=6A09BC1E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
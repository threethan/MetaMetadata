e1cMcCEyANzh2udrQNKW83g&oe=69A17E55"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqcsWBiz930Q7kNvwEacNPR&_nc_oc=AdkkOtUMv8HBgTYfBSOmQyuyvYl1k9RqLf1uXLtVoXPCU5UUj_f_-LIRGlU3e7vVw4A&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv1RTF237qI9QmXepRdGiwjzCgt_SCVSqNUZgBkQYVDkA&oe=69A18D83"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiQra8Rt03IQ7kNvwERG6AH&_nc_oc=Adlh8TZEugnC7IE6IDfHfXeLR2pT8jf-5Ow3z9zXNZtqBjzyCEh9UpXzQS_KL9D23M8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftUTJ01U713dQgzjRGA9A9A3k6bDpf6vn74gtAInLduJA&oe=69A1A380"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwlT1ds-VL4Q7kNvwFQ9p7W&_nc_oc=AdmNPj-I6YxDI3RpLzxi0V21ND-myWy-G2HMjuzZ1mbxUW_pftn-uS4HMibJ9NFFyVs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvw-7j2fuvZHHRPidJs2dkqRaFbL-UQt2kyRhzqoBy6Ew&oe=69A1959E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7159569217426873"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2072142839820738"}]}, "baseline_offer": {"id": "2072142839820738"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1700500317, "status": "PUBLISHED", "id": "2072142839820738"}]}, "liveChannel": {"nodes": [{"latest_supported_
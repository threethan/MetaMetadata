621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qaefLxRpAkQ7kNvwGL8RT6&_nc_oc=AdobhDw_jDPiCuvhX_JlfeTMz_IuToW1NhvkL6zYIFB2cCEHi_0CgFDpOtgfSjPaieQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BNnD_aw6CE3GN2bmBLENYsBHG8EqznXR-6H1hdpKEfw&oe=69EB7AB5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IXqxJUJgvgQ7kNvwHy__CI&_nc_oc=Ado-PSeRmrSyikbI0oOAKYRsealrCQbBIPMs1RLaZzeOyEbyxecFxUj-9OVc6pOYKEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0x_ptbYLQhlsI_7NDCQ3t2ygmrddK3IwaPqpWWd3o-LQ&oe=69EB8A95"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=har88I8H7kIQ7kNvwE8FhHB&_nc_oc=AdqsgR9faxWeQDXlrZSwI1KWHtZE5b3zE_l9esJLP5yt2wsIwP_goHMlJvIsk1PpbKM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KSEQIDADlQcgU_J_lofCw1REXNlat2V5IqBpmV0xT1Q&oe=69EB6183"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqn0HF1ScYsQ7kNvwGtnFpW&_nc_oc=AdqBVdA_MxwltO5CD-hFXLNlmBVjNMtbhygJGjZ71hQmyI6TBF-BsacY446uxytz0Cc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tnCg7K4FOCn0pSJFDPfgrxpg2euxSYIXaMgnPO15qhQ&oe=69EB7780"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eeSDyFO4DdcQ7kNvwHIU7HD&_nc_oc=Adr_ZMCTcK-Jx6x8e7ZE_NqYg7ZPlBKK8vBy__DmZVoduA0dnldDj7HDFFJ9h1WpsCE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OyLg8NuG2rNlOtDSszKm7fP760YXPmT_oh1XVnysw2w&oe=69EB699E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
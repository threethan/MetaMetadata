593_185969621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRKJSlfLhaEQ7kNvwHbf7JT&_nc_oc=Adr4H11znHve5o0x2R6QZN5iPA6xgUkGNkeL4Eq-B-TV1SZigYPVrSs7KlNym4qSrkw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJJu1UHMRAKxCTQoj4jASpvi5zckJ-ISXgReX-sSHhnw&oe=6AAE98B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syZfjJt3uAQQ7kNvwGlKfcw&_nc_oc=AdpuWH2H_lWUMMsdu9Wt7m2kKXiaHy4M3Zeo2IYJN-Ga3nvO9TuLFEYm4HJ5x2qoxMw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcw9v92B1Uu54VAivnGMw1y44oy8z2h46r53uaCRXDBg&oe=6AAEA895"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r88AaLEO3Z0Q7kNvwE-Uf8_&_nc_oc=AdoDt0BVU7_yeVb6d6zXo6KJDFc9Rnhfs00NGAOxqnSGDxAQuI5YBgAOnYm_Uf8jmuM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIUktrqKRL1UVcWBI1_vFpE_DC5_L29_yAjo-O2DEItQ&oe=6AAE7F83"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsR91vtqeVAQ7kNvwE1EF0s&_nc_oc=AdqwiXJWgL5NqoxarnU2VJuSvj0ehTnTyDHa1kKZFmjXbjO9CcM_DRj8oAG3wjcTelM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEkMPgFa1khR0KbBcvWcC6o_4rIlaIw8hSeWmRBg2-yw&oe=6AAE9580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66SntGqL4xwQ7kNvwG8BiDC&_nc_oc=Ado8cC4bxCVf7mtJt7oT6eA7OJ_8ZCZxnbABMO-BjOyG843LdPhVEhk4BF4i-8fT5bs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm-bBNjf6WvTF64fvZbKeovMjMGghHVQCJCEq0fXtXcQ&oe=6AAE879E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_
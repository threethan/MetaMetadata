621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6QSNmF_hJ-EQ7kNvwGahjRY&_nc_oc=AdqcBFjt_JMOFpPG0DJdrF-e3kxAsAPMLEdLU8eiVLyn6G07lpp8j24GDvjuF73fJfk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg9jUWrbrsCkGZ-6B7Grsszt3Q84AlAWUjc126yp9c-g&oe=6AA6AFB5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pDm5ySv_0WoQ7kNvwFzjPd2&_nc_oc=Adqe17VNy5o-PXm7GW3DRzDO8r48Ude32H1W7xIjPfKivRSNiMfLFjqKdcCFFHyNFRA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOPPJ0_yASTNT4_qzSIroSspmYCwtPksEyBcyrLNthWw&oe=6AA6BF95"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mbjHbd674wQ7kNvwFQqdan&_nc_oc=AdpQnsjcLgQ-XJrc_zO5w50Bt6Rs1AnkUKz2zSk83db8GMZUgYFtEUDDXO83EC0vxl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4oFv0MgQgWPjoEnx-f6UgbGSzkZ9IbVd1AcYa1Gvf5w&oe=6AA69683"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOHbgj7ah2EQ7kNvwHdC5LK&_nc_oc=AdqAzqqfbIaQptLcYwFFBwlRSf9qwTM76ho6W-yNTmE7jy5_7rMSqWH4WarWS2c7nuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfav1d2w6z7w-ol_pGF9eBPQsYm4oFnTTaj6TWustmgA&oe=6AA6AC80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Q5otxkmueQQ7kNvwGqJ_V9&_nc_oc=AdqvzhUN4pXLWhpshOb4KYXLLbpZtiuDKqnHJSi_FsPzXuFx_ThgY67TrHmsuxvw99k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlCqIMASvpMYsjMVnjfqitfyzCWAOw7y4V6l5sZItJvQ&oe=6AA69E9E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Au3EFu1Y5SgQ7kNvwFL3Nug&_nc_oc=AdqrnIHsR4ysHyw9O3vjX7qVd3lNMogOHoUViE3DEmH9att0ld-r28qcWgD54Zr53l8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-b35y9ErSVfilRCXTVr77HBXIpQoQW3aYL8a2Qox7TA&oe=6A661635"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoSEUC7Fqq0Q7kNvwEFXOU_&_nc_oc=Adqg4Gtxr6AhZ1pQaT_9WGt_XyKzvywUavnrkvsEIo5BK82twLU_kD4xtmycYmlgolY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKuLSQyj5Eox8XF4lhWBL7YPuTa9L9iIoHxAgy9J_H_Q&oe=6A662615"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y93Nq0aDtCsQ7kNvwFyQ6D2&_nc_oc=AdpGUP4oQWCzPf00tBHYvcZck3CfRMXbdmXNtiZzgngDtCQ--8-iGZltrfgNdqgElh8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYm7qzLPuHaHQs171gMjQwSpFByrqs3ujC2LM8d-z6bg&oe=6A65FD03"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-KBMWN0CmoQ7kNvwFBzcE3&_nc_oc=Adr7kBfCDze4h_tkOIIyj3bnzbCI8LtokBYLKhcu4yK-5dskoo8-In4232FEE8SfX9w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXTZWqxnebuQGwEPC39TfA_XJEoLdNmbrCTRtgWYZSdA&oe=6A661300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBNngaRTGgAQ7kNvwEV7Bc8&_nc_oc=Adrc4AN1i2lVBXpUn-QT7sG_luEv4MchNqoubA6IGp2Ta4_lP1ErILtXfUoG8Scyyes&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4yYSodXpNU-lvtaRiPCT44fipUvBRZ3QytcPf5zK5Cw&oe=6A66051E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
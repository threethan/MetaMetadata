621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDiJlWfl2foQ7kNvwGr00Gv&_nc_oc=Adr374_-5P9uQFgRerGZ06B9vVJRWe1e3nHLXyHki1g4l3KVy_y-2AY3dBd1FGOxBBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8wUA4raerF0mObz4W_u2uxAka2UYVB5DEweE0PohNlg&oe=6A9C23B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kf4AFE7DSRkQ7kNvwE_fx50&_nc_oc=AdpKPQMj_7fTg-GyJEqUjNUz-OPRQbUS3lxFUdhjhP0E2JzcWQHLDd2RnESG8ZRJNjU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAmGjPXUsm91Crdq4eNpQ1T6E7FYidROQt9guSR3SmDw&oe=6A9C3395"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUK2Prx-JggQ7kNvwF0BF7L&_nc_oc=Adp5uhbENmif3TgqjPRWA05IX6Ca0ioW9y7kLvbP0GpdtRAUbVviKq82LmVly93tWhU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSstadrP5Dl7plMrazDTQ37wOzG6Au9NyX2KgiPh52kQ&oe=6A9C42C3"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NDRgAPl5NcQ7kNvwHuIRzW&_nc_oc=AdqxyEq-wPp8L3E-Af7v7Lo-XJTi-ZkblXZHN_nJGzZlERppW8l02mK9CM06fmJx-hM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIutZ21jAl7pvJ6QYFQ5215cQNTH7yUMzKeqKA6NQe-aQ&oe=6A9C2080"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y76aCpxC_CYQ7kNvwFY4CPi&_nc_oc=AdrBuFcdDiwFUqWfQJxaLm11zZNuA7VVJWdG7FIELvRK6aIz4iHy-ROM4ELPQ6Mui7o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVchEjdI-pIgKDBPQeL9hKzgoO5Xam_Rb51cKtIsn5yw&oe=6A9C129E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
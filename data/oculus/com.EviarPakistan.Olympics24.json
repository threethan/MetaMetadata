621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljz7ECfq7CsQ7kNvwHJ2cR3&_nc_oc=AdrriZv6XPjiq3LL-stJkoD5-icNPx4s88xuIl-x-1ow0DfiTONMCuPcp8sa1bjHiPc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0EHwNm9we61XS-rRnjHcSf0EUVuv1arpVCVhKZ9JfPg&oe=6A9980B5"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sIIjLgG17IQ7kNvwErrloz&_nc_oc=AdqVWC--Ck00qQEuow167toST1vDTudZERJYr3uVdgAtL2dM5ZE9yQa-0WLGQYK0vCA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkG43ZzNEQSrPqHmU1kcHHVZ3e6TVF-vXehALoiusnQw&oe=6A999095"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KgQH_Uln6XcQ7kNvwGt4047&_nc_oc=Adq4l5sg4ZIvluzKuPxogQ5JIXBn2kPchxX_VQtn79h5q5-rXgpyIIcWXN_-uY-gW1E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs7QFPT5HiXi9CiWnZfftmtgq1VaOaHKpG6aNC1Kx15g&oe=6A999FC3"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXyL70axj-0Q7kNvwH72GSk&_nc_oc=Ado0YWsCnGZhLEdXtyJdPG0FqnHn2s2tfLUctfClj_wlgDw9x0E3Zd-DJM4cjQ8bwWM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZ9kkHfIP3zqhLiTHu1CyWpkXTWslGmP1QIR5f9W6XEw&oe=6A997D80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWarqc6ClZ0Q7kNvwFr454m&_nc_oc=Ado4eNXV8yqFC2dO9fV7hKtH5mOXOepfGnkURSc8y1E8gPnW5CLoX7Jbfn5V8ky-ju4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIMmhTE70Abpa5ktKifTaBf-b2p1_OJJxqOBVpjBbDmw&oe=6A996F9E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
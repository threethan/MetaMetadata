621223517_7432663363842578426_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3yJVaoTi_QQ7kNvwF5p0jZ&_nc_oc=Adpoh72tJ91c7pnGBXMCpOFOuIiyUmLsgAx1CN88XRatD8CBcAW7DmOBq2rX6TK46uw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iuOxNcNw8sov1kEJJvOkl-cd7kfmh1jwj2ZH9K7rPwA&oe=6A43CF35"}, {"file_name": "diving.png", "id": "869553044912016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKU_WBfwqdEQ7kNvwGgMlTj&_nc_oc=AdrMVmilDo4hY6HXRHvGC_9dmipqQ6BsQ73VVbXYFIhRqxgSAa87yl305BiC6Uzbtfw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OMsXLeJIz6Ol-CGKF03Idih7Mr0E2aO7RLdweSutzYg&oe=6A43DF15"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2HkEZIzwJEQ7kNvwEp4Dnf&_nc_oc=Ado5e6uFD5CV4hsvWmvtMs8gyl6FkFdMvaKEjAz6ORRRWwsf0YMDMlI6YM-pcYTb2JY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CfRy2f--N-dAnWsAquUuwTyR5xIFs8ItbQU1EzSISFg&oe=6A43B603"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDW-5SxS0KAQ7kNvwFMe1dt&_nc_oc=Adriw2__WIow4SnXtGiDnODtPxzEpfZBbqhsKuuQaFVjn_qDJKJRw4iqG4tfwHC4des&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DgW1pRFi5Wp3CczCREqeTms5hBZW2GHrNirlFd6DJ7Q&oe=6A43CC00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md26xdxN5uIQ7kNvwFKA8KM&_nc_oc=Adoua78_NJkWuDHjoR5TOWN9ltlDf0Ohtk6YejXeeLF7q2je64yCmIvpLIAvg5JS1rg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JUbeg4xI7ZgINb0VVJ2xerRkUtDXmxL6gjQaYsd6dUg&oe=6A43BE1E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
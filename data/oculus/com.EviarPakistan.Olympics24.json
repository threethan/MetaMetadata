-1.oculuscdn.com/v/t64.5771-25/38974852_869553048245349_5005444033660396893_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUb1l9jKDWEQ7kNvwGVlnXE&_nc_oc=Adr-4Li1e6gTVTa27Pj_LwvE0EgociwNSucdRX00jHr6MPxPXWzKlVsNQ-i1Ohdl9YU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43Oo5iE2xr4Utxn2Y7Fv7PEyXRq0aXQM1oU6irxlNAYA&oe=69FDFF95"}, {"file_name": "boxing.png", "id": "711014594249776", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982686_711014597583109_2198621665380926973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rX0-0tXnAzgQ7kNvwEheR6M&_nc_oc=Adqg60aYrOWfzNLeCPr3IvD0CieDMWhSCJot9p5x3iax6zZoQ6u2ReHdilyohEt1YTc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l3CIMZfcvZh3OkKs40sZznwg6f2sBRPO6vIwEqiiIDw&oe=69FDD683"}, {"file_name": "archery.png", "id": "347698447743938", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974650_347698451077271_3624768890856818854_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yoKLXUG26oQ7kNvwGsRRkr&_nc_oc=AdpTJjBMcShGRnMWHu9d2FavJGNiDKViCI-9FEIbAndhD69aX6IlahULhP9LFwrij28&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fpw8QhU-kL7OA2poli_yBdmTpRyLWketkvFos9_c67g&oe=69FDEC80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440.png", "id": "1726120731229844", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75340705_1726120734563177_864537722303111268_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hu0B7h6aaxoQ7kNvwHUaLfP&_nc_oc=AdpDjan0qCi7JCM3tVyZLKKHMvv4LoLno9vkz6Nd6PQZQR1Zzduot0_lqbfNh_8cnxk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5obCtanvTUx_GT4laffq2DFoCkjELcOC2FaJiER0Qt0w&oe=69FDDE9E"}, "display_name": "Summer Games VR", "keywords": [], "long_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer.\n\nThrilling Sports Lineup:\n\nArchery: Test your precision and focus as you aim for the bullseye in this classic event.\nJavelin: Master the art of the javelin throw, harnessing power and accuracy to achieve record distances.\n100m Run: Sprint against the clock and rival athletes in a heart-pounding dash for victory.\n400m Relay Race: Team up with fellow competitors in an exhilarating relay race, passing the baton with split-second timing.\nDiving: Execute graceful dives from varying heights, showcasing elegance and control.\nSwimming: Dive into the pool and power through the water, striving for new personal bests.\nBoxing: Step into the ring, where strategy and quick reflexes are essential to outsmarting your opponent.", "short_description": "Summer Games VR offers an immersive virtual reality experience that transports players into a world of athletic prowess and competitive spirit with a variety of engaging modes, including Practice, Single Player, Tournament, and Multiplayer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/9a19a826-b2f7-469e-9603-d434928e44db", "developer_terms_of_service_url": null, "publisher_name": "Texas Ego Films", "support_website_url": null, "website_url": "https://www.texasegofilms.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI
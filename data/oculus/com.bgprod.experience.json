dow into today's vehicle systems including the engine, brake, drive line, and cooling system.  Learn about how each system functions, the challenges they face and BG preventive maintenance solutions to these challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ReedBG/BG-Experience-Meta-App-Lab-Privacy-Policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "BG Products, inc.", "support_website_url": null, "website_url": "https://www.bgprod.com/training/bg-experience-for-automotive-professionals/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5746500582140944"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "596987732788907"}, {"status": "PUBLISHED", "id": "369375456102206"}]}, "baseline_offer": {"id": "596987732788907"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733428860, "status": "PUBLISHED", "id": "596987732788907"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9190744381049863", "version": "2.03"}, "id": "410588504946539", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "574650
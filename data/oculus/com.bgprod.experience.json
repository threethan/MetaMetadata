6p1HM&_nc_oc=Adp2x68Iwy6E1bUeDWpz8x76ICTWAr6o0fC0Qzp6WTjoMxtLCPiGExIBbzfp-wEaJYU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfAfrKrnrdV4MRT_BPimpITfae4_lCsiqP1nTn0Tt8DQ&oe=6A857F49"}, {"file_name": "BG-AR Images-Engine Performance.png", "id": "1152282242885342", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974863_1152282246218675_5755833074224209115_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liiH-XK2uoAQ7kNvwExNjix&_nc_oc=AdrJnVOxXQ-Ia7piqfVOD69KP5nfQpVosYxDaKUD3NxDLKNchrIj4_2DOv1ZTjNMPDc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIlKx38RKMR2TcUuuwX2Zm8ThaoGCGX24S9MYldBMlpw&oe=6A85A87F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BGE_Thumbnail_1440.png", "id": "939616784619937", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974748_939616787953270_5329666247029762824_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDduW6sLvm4Q7kNvwHa_1k_&_nc_oc=Adr-cDptOCcukuf5OlAmzFXNE9Amx2tfcb5Eow4nECSphP9HUYX34y1OfqxnP7UTPZU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL7tgNuuwG7GDLvIjEov85YjjrAq3y1cqsLn3nNciHQA&oe=6A8597FE"}, "display_name": "BG Experience\u2122", "keywords": [], "long_description": "BG Experience provides a window into today's vehicle systems including the engine, brake, drive line, and cooling system.  Learn about how each system functions, the challenges they face and BG preventive maintenance solutions to these challenges.\n\nBG\u2019s purpose is to ensure every vehicle owner understands the importance of automotive maintenance.  We want every vehicle on the road to run better and last longer.  To support this mission, we offer the highest quality maintenance products.  We study the latest technologies so we can supply the appropriate chemistry using the most effective delivery method.  We provide products, equipment and training to nearly 50,000 service centers worldwide.  \n", "short_description": "\nBG Experience provides a window into today's vehicle systems including the engine, brake, drive line, and cooling system.  Learn about how each system functions, the challenges they face and BG preventive maintenance solutions to these challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/ReedBG/BG-Experience-Meta-App-Lab-Privacy-Policy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "BG Products, inc.", "support_website_url": null, "website_url": "https://www.bgprod.com/training/bg-experience-for-automotive-professionals/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5746500582140944"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "596987732788907"}, {"status": "PUBLISHED", "id": "369375456102206"}]}, "baseline_offer": {"id": "596987732788907"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733428860, "status": "PUBLISHED", "id": "596987732788907"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9190744381049863", "version": "2.03"}, "id": "410588504946539", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id":
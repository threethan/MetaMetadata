t64.5771-25/491823271_1199820065252682_8218055009503839861_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUCtoU08oR4Q7kNvwHp6RH6&_nc_oc=AdrPXKlNZy15eJqzCIa57A7BUzT5EKXlKcn4Cn5QGrOOEGSmOR_vajoLf4VrZCp6t7g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37NSfAWbc8OuVXedn752_kvgWEkguOHfT4yEuW62LqzA&oe=69D7A79A"}, {"file_name": "com.GabberThomson.CardboardPanoramaViewer-20260222-091727.png", "id": "850013294753940", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491824322_850013298087273_8393068354760020124_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3G1x4uVAwBQQ7kNvwFPE31s&_nc_oc=AdqNwx77_030Dv5VRhx195fhsMavAYXdOc-YdEdnFZEBF75cdqCdjDIkDdw5s0IgMfY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XsHvdpz6JXSniQyJiUqdP6Lmh9fZvLk5-ORkSeSnK9w&oe=69D78ECA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "1354272846287562", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307466_1354272849620895_5236010008322001817_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6LX0MGkYe8Q7kNvwHsMNyH&_nc_oc=AdobCMpVpHInKsdlOyVMLlj_VrgWcQN4ex_eK-UHCUbBGqnu2MilwNwTXFOULMz6T4c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lhhcd1oz7fXMBn7Lq4waCSFmlZfzIJikLWz3uVpzyJA&oe=69D7A460"}, "display_name": "Cardboard Panorama Viewer", "keywords": [], "long_description": "# Cardboard Panorama Viewer\n\nA simple 3D panorama viewer for Meta Quest, created by a beginner in programming with the help of artificial intelligence.\n\nThe goal is to display panoramic images taken with  Cardboard Camera in a stereoscopic and immersive way using VR.\n\n---\n\n## Features\n\n- Displays 3D panoramic images in VR\n- Extracts and plays audio from image metadata if present\n- Lists available panoramas in a simple menu\n- Stereoscopic effect can be toggled on or off\n- Possibility to zoom in!\n- Extracted images are saved to persistent data for faster loading\n\n---\n\n## Where to put the panorama images\n\nWhen installed, when **Menu** button is pressed for the first time, you will be asked to grant access permissions to the directory where panoramas needs to be uploaded. Choose or create your directory.\n\n---\n\n## Controls\n\n- Press **Menu** button (three dots on left controller) to open or close the file selection menu\n- Press **A** button (on right controller) to toggle stereoscopic effect\n- Use the lever of the right controller to zoom in!\n\n---\n\n\n## Created by\n\nA curious beginner with the continuous support of ChatGPT and artificial intelligence.  \nThis is a learning project, built with passion and experimentation.\n\n\n\n", "short_description": "A simple 3D panorama viewer for Meta Quest to display panoramic images in a stereoscopic and immersive way using VR.\nRelive your memories in an immersive way, with 3d and audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/gabberthomson/cardboardpanoviewer/blob/main/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "gabberthomson", "support_website_url": null, "website_url": "https://github.com/gabberthomson/cardboardpanoviewer", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26817032534566017"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/4918199
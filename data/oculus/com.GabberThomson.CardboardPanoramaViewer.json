ohc=UV4bFmpzlaUQ7kNvwEBLxWa&_nc_oc=AdpEOqycrUy_li_XieTre8krZrHkrTQHYD4CrtB3AAbRPgYekrf5SsD29H50L149K0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1xH6d3eM7IBwB9BEMQ7oyypsABKTwq-HSE2q_M6QT99g&oe=69F0B41A"}, {"file_name": "com.GabberThomson.CardboardPanoramaViewer-20260222-091727.png", "id": "850013294753940", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_850013298087273_8393068354760020124_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmrPik3K0mUQ7kNvwGIs8kQ&_nc_oc=AdqjmzcbGKT4TiLUMwtBW_uKxnOIIKQWwB9YHPkL3p7g28lC5jxjkjh-vtyRGjnHPns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1zQVZ2Up8o4crm95ahtPU6u-N3iCVL0v5pN7id43NU1g&oe=69F09B4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "1354272846287562", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307466_1354272849620895_5236010008322001817_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgwA8Zgt0woQ7kNvwFaqHGX&_nc_oc=Adq4C_4SWUbmMkGrretK6D5eM8aN6-iVYb3wbLz-9UyD7yW3Q_q9wLGmbKOO0vWaSVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0w4Nix971vq8deFUBug3744U0k0U5idJvPhMrre5s0MQ&oe=69F0B0E0"}, "display_name": "Cardboard Panorama Viewer", "keywords": [], "long_description": "# Cardboard Panorama Viewer\n\nA simple 3D panorama viewer for Meta Quest, created by a beginner in programming with the help of artificial intelligence.\n\nThe goal is to display panoramic images taken with  Cardboard Camera in a stereoscopic and immersive way using VR.\n\n---\n\n## Features\n\n- Displays 3D panoramic images in VR\n- Extracts and plays audio from image metadata if present\n- Lists available panoramas in a simple menu\n- Stereoscopic effect can be toggled on or off\n- Possibility to zoom in!\n- Extracted images are saved to persistent data for faster loading\n\n---\n\n## Where to put the panorama images\n\nWhen installed, when **Menu** button is pressed for the first time, you will be asked to grant access permissions to the directory where panoramas needs to be uploaded. Choose or create your directory.\n\n---\n\n## Controls\n\n- Press **Menu** button (three dots on left controller) to open or close the file selection menu\n- Press **A** button (on right controller) to toggle stereoscopic effect\n- Use the lever of the right controller to zoom in!\n\n---\n\n\n## Created by\n\nA curious beginner with the continuous support of ChatGPT and artificial intelligence.  \nThis is a learning project, built with passion and experimentation.\n\n\n\n", "short_description": "A simple 3D panorama viewer for Meta Quest to display panoramic images in a stereoscopic and immersive way using VR.\nRelive your memories in an immersive way, with 3d and audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/gabberthomson/cardboardpanoviewer/blob/main/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "gabberthomson", "support_website_url": null, "website_url": "https://github.com/gabberthomson/cardboardpanoviewer", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26817032534566017"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819982_25271904782422394_5259768824594766764_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obRAwy-WtbYQ7kNvwEloJKs&_nc_oc=A
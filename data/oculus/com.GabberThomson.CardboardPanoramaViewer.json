-25/491823757_1243585517579033_4833109709414390429_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=La-Mc2R-kWcQ7kNvwHOXbJ0&_nc_oc=AdrYzpWeAXJeyi6I8KSaRUDR9Xk6j0BqEVUcxQZlqjRZ29UAKk4k_2o7cOvzdcFAdKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABUPMBI_S3JbawSlV7PCRmv6FTQBRTe5DOI1vXzaYk_g&oe=6A5CBE9D"}]}, "id": "942487365001714", "locale": "en_US", "screenshots": [{"file_name": "com.GabberThomson.CardboardPanoramaViewer-20251024-202917.png", "id": "980879777626932", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830615_980879784293598_8749047047950237428_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdufonXED8sQ7kNvwFKokOy&_nc_oc=AdrSsveKpSkQW2_0-DGDM-jcxmIgTrV0xV8EJYpIHuw7p5HXBqF8bLrHr0mGqYtTcxw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM6H6fgkF-Wpv__D0wNjzqbqe212IfjJwUBiPadvCnRw&oe=6A5CD3EF"}, {"file_name": "com.GabberThomson.CardboardPanoramaViewer-20260222-091316.png", "id": "1731222151596007", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819859_1731222154929340_4502908238836567698_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wRFqOu5PpkQ7kNvwF-fMgN&_nc_oc=AdqvMLMFM-z8_L4pedYfwK_ZvwVrGcv_5bEo8ovaubNZS-FBVF1vDmWxw4YUdXaX2Uo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZNNgMkRaiEDzzSdZQtRS9RE4JlYdkpbui6RdQ7oKBIw&oe=6A5CB6A8"}, {"file_name": "com.GabberThomson.CardboardPanoramaViewer-20260222-091523.png", "id": "1562601755047431", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491829165_1562601758380764_3143381918319375789_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojmvLr8g6K4Q7kNvwGUoDlj&_nc_oc=AdpzktDiXouPduWHuJl-PX-JWXvjLD-a0Vud-uvz05dHG-1NHUVSMZ3DMzrJTdRVs7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCplj9f_x3KiLW1aznTGG1zKYBrJ_thqkmfc6vf19kSDA&oe=6A5CBD3E"}, {"file_name": "com.GabberThomson.CardboardPanoramaViewer-20260222-091704.png", "id": "1199820061919349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823271_1199820065252682_8218055009503839861_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEqU1wia8MIQ7kNvwGvMQ_C&_nc_oc=AdqPFRYa5J6NT3I-F87VkRxKqX9VdnJfBG4HUUpo_UVJYI53IMLXkpznTVUG8Znk12Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPk-ID8UP_KtxMKGQ61jRf_LGE6hGZywSEftjnftqFYA&oe=6A5CCF1A"}, {"file_name": "com.GabberThomson.CardboardPanoramaViewer-20260222-091727.png", "id": "850013294753940", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_850013298087273_8393068354760020124_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4f_p7o9hbaMQ7kNvwF9JmYh&_nc_oc=AdoILisgmqD1Jw807Y58HGyLNKXc8hMSki2BvXIOw1-q2N5_V8mNYl85WXYnYMefz2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUUk4NFlQJFbfQxKfuW9GBgEDCRd8ZRDIoS-m7BfBoPg&oe=6A5CB64A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "1354272846287562", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307466_1354272849620895_5236010008322001817_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCgkNPEyK5MQ7kNvwFXeh3d&_nc_oc=AdqYlZ0bMJdsmqLXyTQ-MMZRv4W5DIifWid2Z2ejEj4EP4QbswzlsuR9v3FbbirLWLo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeRLwqD4C49C5Znjo8DZylejVSnycwJ6b4iFmPfGfNeQ&oe=6A5CCBE0"}, "display_name": "Cardboard Panorama Viewer", "keywords": [], "long_description": "# Cardboard Panorama Viewer\n\nA simple 3D panorama viewer for Meta Quest, created by a beginner in programming with the help of artificial intelligence.\n\nThe goal is to display panoramic images taken with  Cardboard Camera in a stereoscopic and immersive way using VR.\n\n---\n\n## Features\n\n- Displays 3D panoramic images in VR\n- Extracts and plays audio from image metadata if present\n- Lists available panoramas in a simple menu\n- Stereoscopic effect can be toggled on or off\n- Possibility to zoom in!\n- Extracted images are saved to persistent data for faster loading\n\n---\n\n## Where to put the panorama images\n\nWhen installed, when **Menu** button is pressed for the first time, you will be asked to grant access permissions to the directory where panoramas needs to be uploaded. Choose or create your directory.\n\n---\n\n## Controls\n\n- Press **Menu** button (three dots on left controller) to open or close the file selection menu\n- Press **A** button (on right controller) to toggle stereoscopic effect\n- Use the lever of the right controller to zoom in!\n\n---\n\n\n## Created by\n\nA curious beginner with the continuous support of ChatGPT and artificial intelligence.  \nThis is a learning project, built with passion and experimentation.\n\n\n\n", "short_description": "A simple 3D panorama viewer for Meta Quest to display panoramic images in a stereoscopic and immersive way using VR.\nRelive your memories in an immersive way, with 3d and audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/gabberthomson/cardboardpanoviewer/blob/main/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "gabberthomson", "support_website_url": null, "website_url": "https://github.com/gabberthomson/cardboardpanoviewer", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26817032534566017"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/4918199
ohc=KATWuHHWhOgQ7kNvwHGPOIY&_nc_oc=AdlVJ8W6zimq3og746jJjH63ATBxTkW3cMMgX4a0C0HUjkzJFxYPHNM36nIogrZWNcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvy9PuPcwzHMREcVLjvvAy3LREwufFxFqfMfWVZidFARQ&oe=69A6E01A"}, {"file_name": "com.GabberThomson.CardboardPanoramaViewer-20260222-091727.png", "id": "850013294753940", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824322_850013298087273_8393068354760020124_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU4vlVNhq70Q7kNvwEYKqzn&_nc_oc=Adn2vcrsJdMDK69PiVZ7yvAUS9oTAVJLk0815rJMuCwcSB2qr0K_fp8kpwi1LGR170c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsUgELkitV7cFBJONTAGduBdLN-o8WrRAvvG3k9j6gHxQ&oe=69A6C74A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "banner.png", "id": "1354272846287562", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307466_1354272849620895_5236010008322001817_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwPZ0BrggLgQ7kNvwEDYdT2&_nc_oc=AdlcEz3pNWV507TEwVA5DoKxHxWw0Qj_WUkldXmkxjGagnMVX_WmrSNcXz9BsjeKqsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyRpjXT0qOaK38atdwFObIAeEFQuSq2I9BODIWJFS0hQ&oe=69A6DCE0"}, "display_name": "Cardboard Panorama Viewer", "keywords": [], "long_description": "# Cardboard Panorama Viewer\n\nA simple 3D panorama viewer for Meta Quest, created by a beginner in programming with the help of artificial intelligence.\n\nThe goal is to display panoramic images taken with  Cardboard Camera in a stereoscopic and immersive way using VR.\n\n---\n\n## Features\n\n- Displays 3D panoramic images in VR\n- Extracts and plays audio from image metadata if present\n- Lists available panoramas in a simple menu\n- Stereoscopic effect can be toggled on or off\n- Possibility to zoom in!\n- Extracted images are saved to persistent data for faster loading\n\n---\n\n## Where to put the panorama images\n\nWhen installed, when **Menu** button is pressed for the first time, you will be asked to grant access permissions to the directory where panoramas needs to be uploaded. Choose or create your directory.\n\n---\n\n## Controls\n\n- Press **Menu** button (three dots on left controller) to open or close the file selection menu\n- Press **A** button (on right controller) to toggle stereoscopic effect\n- Use the lever of the right controller to zoom in!\n\n---\n\n\n## Created by\n\nA curious beginner with the continuous support of ChatGPT and artificial intelligence.  \nThis is a learning project, built with passion and experimentation.\n\n\n\n", "short_description": "A simple 3D panorama viewer for Meta Quest to display panoramic images in a stereoscopic and immersive way using VR.\nRelive your memories in an immersive way, with 3d and audio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/gabberthomson/cardboardpanoviewer/blob/main/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "gabberthomson", "support_website_url": null, "website_url": "https://github.com/gabberthomson/cardboardpanoviewer", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26817032534566017"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819982_25271904782422394_5259768824594766764_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qgCyOR-UmgQ7kNvwHNijuY&_nc_oc=A
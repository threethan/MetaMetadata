pcPgVfK30-atNvI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQ9axJtRxgz5r6mTjqicxTgEOGyxmexSP6DQa_ImXcug&oe=6B0DCDA8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Truck Simulator Game - Truck Driving", "keywords": ["truck", "driving", "simulator", "trailer", "tanker"], "long_description": "Take control of powerful trucks and experience the world of truck driving in Truck Simulator Game! Get behind the wheel, explore different driving environments and test your skills across exciting driving challenges.\n\nNavigate roads, control your truck, handle tight turns and take on parking challenges. Experience the responsibility of operating a large vehicle while improving your driving skills and completing different objectives.\n\n**Game Features**\n\n- **Truck Driving Experience:** Get behind the wheel and enjoy an engaging truck driving simulation.\n- **Powerful Trucks:** Experience driving different trucks and enjoy their unique driving characteristics.\n- **Challenging Roads:** Navigate different routes and test your driving abilities.\n- **Truck Parking:** Take on parking challenges that require careful steering and vehicle control.\n- **Vehicle Controls:** Accelerate, brake, steer and maneuver your truck through different situations.\n- **Driving Challenges:** Complete driving objectives and put your truck driving skills to the test.\n- **Immersive Simulation:** Experience the challenges and excitement of operating a large truck.\n\nWhether you enjoy vehicle simulation or challenging driving games, Truck Simulator Game offers an engaging experience behind the wheel.\n\nStart your engine, take control of your truck and begin your driving journey!", "short_description": "Get behind the wheel and experience the excitement of truck driving in Truck Simulator Game! Drive powerful trucks, navigate challenging roads and take on exciting driving and parking challenges. Test your driving skills, control your vehicle, handle sharp turns and explore different driving environments. Experience the challenges of operating a truck, improve your driving performance and take on new journeys. Start your engine, grab the wheel and enjoy an immersive truck driving experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/next-bit-games/privacy-policy?pli=1&authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Next_Bit", "support_website_url": null, "website_url": "https://sites.google.com/view/next-bit-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1517523588107089"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296209_1855511112250305_5028350191199233730_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf4U7GNgf98Q7kNvwH3xr_P&_nc_oc=AdouaazNLPO1mWD8GQj63DW34_Zrs3RQjNDKcx5YFYha2a6E9hLFvW2K1LTbMhyG2zQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlGF3Qrhb_Agmucbt_T1PJB_YoA9qo34lMi8SsIobb3Q&oe=6B0DBB6C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Truck Simulator Game - Truck Driving", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "33152918813227
5_7504187064509191864_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39MSXcsErZIQ7kNvwE4_tW9&_nc_oc=AdqRIDfNrUbZTAShqe6_iiroxv_wLgm_2JX6pGuEEavHlr5HRCzGb9y3QfS7Vx_qKLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT41tGmfNWaKCPpw7XqTDkqXPiVVbcZpcDnPSf5_8QXBw&oe=6B01E2AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timeline 1_01_00_41_32.png", "id": "2533979840427912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604375581_2533979843761245_4203134658402181211_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JV6g7kBgzgQ7kNvwHoPOfk&_nc_oc=AdpZ65vSax8E1zbgKOoqEbdLfen9kU9B5xk38Es6QCND7krfNQk_ZalzQ2U3FRdNBKQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRInhuJ4ixGBdviRqIsBLL3LWA8wP3l5DhownAJaUQNJw&oe=6B01D3C6"}, "display_name": "MudiAppVR", "keywords": [], "long_description": "Step inside Agrigento Cathedral as never before. Created for MUDIA \u2013 the Diocesan Museum of Agrigento, MudiAppVR takes you through the cathedral's four historical eras: Norman, Chiaramonte, Renaissance and Baroque. Each environment is rebuilt in virtual reality with photogrammetry-scanned statues and architecture, guided by a narrated story. About 7 minutes, available in Italian, English, French, Spanish and German.", "short_description": "Explore Agrigento Cathedral in VR across its four eras: Norman, Chiaramonte, Renaissance and Baroque."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aniclo.it/mudiappvr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Palmeri STUDIOS", "support_website_url": null, "website_url": "https://www.nicolapalmeri.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_ap
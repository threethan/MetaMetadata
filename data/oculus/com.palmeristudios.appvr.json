5_7504187064509191864_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXdOAOJLGn8Q7kNvwEuuI3o&_nc_oc=AdoHFHYW7zCZugaRksmO8kslCrVAT1JQCRbA3rRgGTIMwbGvprMT5Qw4NDjU-aIEluA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5Vs5BBdEXwi-HTVEOTIvB9jeCFBaMWKNKuCrO2OFX3A&oe=6B06F06B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timeline 1_01_00_41_32.png", "id": "2533979840427912", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604375581_2533979843761245_4203134658402181211_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dn3xZx-sphIQ7kNvwFsc7C5&_nc_oc=AdpFDdI-2U-w-4lCCMzp6kfdllOM0fVZ6FKVq0HOn2rsCe1ltIFqcBWjQoSbtuGfQWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGM8NcyfsQYisQoGcWvMNufW_LL215_JBFJOvn33sTMA&oe=6B0719C6"}, "display_name": "MudiAppVR", "keywords": [], "long_description": "Step inside Agrigento Cathedral as never before. Created for MUDIA \u2013 the Diocesan Museum of Agrigento, MudiAppVR takes you through the cathedral's four historical eras: Norman, Chiaramonte, Renaissance and Baroque. Each environment is rebuilt in virtual reality with photogrammetry-scanned statues and architecture, guided by a narrated story. About 7 minutes, available in Italian, English, French, Spanish and German.", "short_description": "Explore Agrigento Cathedral in VR across its four eras: Norman, Chiaramonte, Renaissance and Baroque."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aniclo.it/mudiappvr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Palmeri STUDIOS", "support_website_url": null, "website_url": "https://www.nicolapalmeri.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_ap
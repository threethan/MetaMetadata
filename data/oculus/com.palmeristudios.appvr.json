5_7504187064509191864_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXdOAOJLGn8Q7kNvwGFmraX&_nc_oc=AdrfPaUTgptl6rbY1_7KZpGWFnlEfiuPv9cmMkWe1Wlhze4usyG0hPnnCWv2_-5dS94&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtUQXQ-pUsAIScGiXbcu86m1LEfFXoYPQI0eD7SfJZaw&oe=6B09CBAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Timeline 1_01_00_41_32.png", "id": "2533979840427912", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604375581_2533979843761245_4203134658402181211_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxOrKGaVaM0Q7kNvwE1go4J&_nc_oc=AdrsK92p7F4Dq44-ENy_rO9ZasCwcCRWQFXGbWYvwBTpMP4yJ7ijqtVzBANsKyA14_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhhPNJZW73U238yLrI4UQwbWeuFD1eGgJOHjn_xi-LUw&oe=6B09BCC6"}, "display_name": "MudiAppVR", "keywords": [], "long_description": "Step inside Agrigento Cathedral as never before. Created for MUDIA \u2013 the Diocesan Museum of Agrigento, MudiAppVR takes you through the cathedral's four historical eras: Norman, Chiaramonte, Renaissance and Baroque. Each environment is rebuilt in virtual reality with photogrammetry-scanned statues and architecture, guided by a narrated story. About 7 minutes, available in Italian, English, French, Spanish and German.", "short_description": "Explore Agrigento Cathedral in VR across its four eras: Norman, Chiaramonte, Renaissance and Baroque."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aniclo.it/mudiappvr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Palmeri STUDIOS", "support_website_url": null, "website_url": "https://www.nicolapalmeri.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_ap
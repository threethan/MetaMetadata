5645_7504187064509191864_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb6cajkVat4Q7kNvwH8oKop&_nc_oc=Ado1mo9vi_uIdHQ1J0hK5FZs58Ni19Gy7DTc2a-vnFgmtPJ04RP-1VrU6wqfZQxffuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVETTtQAOCkY0O6pgSZcj9Tuunu_gi6Q4q3hQUOy9mKLQ&oe=6B0F11AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MudiAppVR", "keywords": [], "long_description": "Step inside Agrigento Cathedral as never before. Created for MUDIA \u2013 the Diocesan Museum of Agrigento, MudiAppVR takes you through the cathedral's four historical eras: Norman, Chiaramonte, Renaissance and Baroque. Each environment is rebuilt in virtual reality with photogrammetry-scanned statues and architecture, guided by a narrated story. About 7 minutes, available in Italian, English, French, Spanish and German.", "short_description": "Explore Agrigento Cathedral in VR across its four eras: Norman, Chiaramonte, Renaissance and Baroque."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aniclo.it/mudiappvr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Palmeri STUDIOS", "support_website_url": null, "website_url": "https://www.nicolapalmeri.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "es", "de", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1837915267343773"}}]}, "scheduled_offers":
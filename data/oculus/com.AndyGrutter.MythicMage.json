dn.com&_nc_ss=7f20f&oh=00_AQTQFfSHTFRrkLm2Dlj75iKTF6EFqgYRQUZfYXjI_GwWwQ&oe=6B01E662"}, {"file_name": "3.png", "id": "1004822956801894", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1004822963468560_3757747066569249029_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBcbv2nnLVgQ7kNvwEnmC1-&_nc_oc=AdoAlSZ366iKBCdqJwOe56HPRqgq_2i63MwKOaVEzNCNrI14CDpTufuUgm2J0X0YLbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdg0relQfxMr2QMxM0n376IYGa96AhvBSsw7UpDDyFEg&oe=6B01DD84"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlaUSf0RK_cQ7kNvwEbi6Px&_nc_oc=Adrh9DBjEDHP-8NHKW5xJIshjDs5P0uWzwKnoSu7dZ7cZV9BIfGuKMNJqxM6SboJ5-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT0g5rj_qDGxwa9RkdwEjknRI5-Q6cXHvkhoY8Glxpwg&oe=6B01C4D3"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBkyoxYlxFwQ7kNvwGVrEjS&_nc_oc=AdpUyTKGW9jMcZ8uInaOkLGKoMU5ADBIyvYHQZJtc2p5M4JnDiSs4WCgx9D3YvPAJlc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt8cqoG2cwbEVSGPnQFQz_1gtiUPwDGhxAlrfwy2X9yQ&oe=6B01CBD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GX4Sx-d1fcIQ7kNvwFvvp1U&_nc_oc=Ado_z712Vccsqt_dU7FUVLa58sVfqckeC10sQOF69HmzEXXHLV-6x66IqcrtDKliIQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmCiN7SY9CToeNQSaUvAwhQca7oVG_LfQs0LqmV9W-aw&oe=6B01CD22"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_
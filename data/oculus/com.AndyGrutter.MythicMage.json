dn.com&_nc_ss=7f20f&oh=00_AQRNTBUJH8sN8Ad5kEO6SgFru4ZpoesZZdmxiNyo0Lq66A&oe=6B0845A2"}, {"file_name": "3.png", "id": "1004822956801894", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001726_1004822963468560_3757747066569249029_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sE9ORQzilhkQ7kNvwEYBScj&_nc_oc=AdodDHW5g6FjioDFRpf7rVWkOG_iNizTyKmYi8rdZBmJmhCZW5BVSZFQF6HmfaWk75c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxFzNarL3Sud7q6sA9PzpVW8VUgChTXl3RVAwxgB-RcA&oe=6B083CC4"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BU_YoEDSTkQ7kNvwF0t70w&_nc_oc=AdocZxkx873PbNPS33tLCy6gCPKNugODiF3Wtd-_8br0nSZr3x5DgDoDgKstsCzGt-I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE8wdqBD1ygzdSXQtzadxhGdiiGY1svmjFi1v7vIDt5w&oe=6B085C53"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3U8EYPZKiUQ7kNvwHZFkO3&_nc_oc=AdqkCvsMfBIC5652RgjRqEUlTlhSiptrSi3wZ2obs1FmS4sOLQcoslKBQacjpd5t4GQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqMP2NRhpbvyi4CIUV9vPO8AYKyQJritl4gseI-velkA&oe=6B086354"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J404GU7hU8Q7kNvwHnNsx6&_nc_oc=Adrht4RpLbEy5nVczdisr7pquBw1PyCDWEfJZECJlxs25XD0MHdzh2pACRau7gA0o1I&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZQ3xSo-GpntAu3N9BVKfiSAbIjZJQNyxnERWJ_ic04A&oe=6B0864A2"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_
dn.com&_nc_ss=7f30f&oh=00_AQQ0IdhfxvwNauLN_mtJs7NjeoAaK-4jRqTIhi-EdtZJOQ&oe=6B0DC3E2"}, {"file_name": "3.png", "id": "1004822956801894", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001726_1004822963468560_3757747066569249029_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDvLX4eukBgQ7kNvwHNZDIf&_nc_oc=AdohrTuSTorOGywgnKAqKPMSeFkUPyhcJIANyVujdHlZ2Av6ypGFTjPR_H7V16aWICA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRyYSjOpT20pBc4iIiNn15taXblN0FK5uzLycOzcdQCKw&oe=6B0DBB04"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aosO5QlYEiQQ7kNvwGr2e86&_nc_oc=AdpTusKGB5gU-F7YOiDIlLqGSBpilVZrUaHWYBfDcGc1TwFgF0SOjClaRYjoeoe0qpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfh25GhpAHd66K0aCvqLoftTa7mpgrpOUHC3CR4d6ZKQ&oe=6B0DA253"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=23npkrXPL5YQ7kNvwHjm00v&_nc_oc=Ado71spJK1wcx6pxoXTsw1yqVzqI7qB1MB4MnahTQPhcbxRUex5jnuc1c-IMiJOVAuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRkRiK-fACIzZdbBljwQS-iazw-vRpKk_Zz9w9PXnU3Qw&oe=6B0DA954"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=857gpoiIUIEQ7kNvwFQtGp7&_nc_oc=AdrAlgdUngh3xupIfLPehEA7wFMt2AtWscooLkePnu2bCbX7Ll4yMzXIL9fPe3JaVw8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTmGJ9t6EdOdMxEcaDxCvaLUYRb4c_42aMHMyuc3W0z_g&oe=6B0DAAA2"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_
dn.com&_nc_ss=7f20f&oh=00_AQTm8jnGV3SoedT1BiBJgVM0zp3KdCBzE6f1hnt_wnE8qQ&oe=6AFDB9A2"}, {"file_name": "3.png", "id": "1004822956801894", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001726_1004822963468560_3757747066569249029_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UXVd17NA8IQ7kNvwHlG74K&_nc_oc=Adr00z9DJtVccOK3l9LPn_qUllJQi8U8FFSu2yE730o9WiCGqzUHbSdJkDBTHCDa62I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz53NecWSjqBHGQDTaAmiKEsVTWlMnGFzJvd7Z9BHnjw&oe=6AFDB0C4"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLqXYic345oQ7kNvwEwrbdf&_nc_oc=AdoVnAla45UhIK8MhUIvieialWRPxsKdA0ASH0X-jTn-gKmVrXrWoRsyOtEss0jE_Gw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9z2i3LhYee6TD_5-gCjmI5Qi-_bcEGKdKnZlNJvs8RQ&oe=6AFDD053"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnuufxJsoG4Q7kNvwEclVoa&_nc_oc=AdoiW2s1GV3kMxCzFWX36myt-39hv1rk07GvpNVZHEGglbWERgKqKZQLVIur6095ESU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJWrSJUrm40pqY6VNWCRWXCISGCyw_OUT27AOUX_uuKg&oe=6AFDD754"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRXN6CAqBCoQ7kNvwEc_Xym&_nc_oc=AdqFvocj64GcgiGjQ4x0zexx8C5nrS_toyeCyMACBN2_thxMSKRYSTY4XKBS1d2BYzc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Os9VbbHwv01H7fmq3s0qTw1HT30jV7Ll2wBug7_GFg&oe=6AFDD8A2"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_
7066569249029_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qD-pgB57hxMQ7kNvwFgsEeT&_nc_oc=AdrcrN-ixyOD3bbiUnIu5s5AEhXVAUf8nFh8JStrv67VxteiBPqp0hbjlKrHhN75eDI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MFHF-kKBIx9wv1uL6C10URDJRG11drMho6rp5qDOt1w&oe=6A467044"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1RNKCxJFVIQ7kNvwEwrumf&_nc_oc=Adq_j9iaxfKOC4EYwU8m9KFRbdCXIc_f5PMe83BmFSNPss80fgVqzNC-Q3YLyS5-xBw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RVvj3urHs87Sne6SFEK-tOhgfC_iLodOUGDV66KTuRg&oe=6A465793"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1CruTeAVgYQ7kNvwH8oL0S&_nc_oc=AdrOw_gaFwAVXA_dwEQAwygoJaIMe0BEsIKO4exdjZzRFRtlmENhuuXt8Di0YWUyI64&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__ZckeuEFrsYlEzup4ewpO_O5RTYaILPY0gCWPv9btGQ&oe=6A465E94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOrmfvPefYYQ7kNvwFSEVTV&_nc_oc=Adoj-wDBVI4W1UMzPVRy0FaroHB1jFPAOI29wX3ci4EY2_OlqMybc3EwdZSLJGVba-M&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9e2Ll929ZiVv_43wdA4-nFZ7iazJ05tgzQPs4qCOzBA&oe=6A465FE2"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26208992505413930"}, "review_m
dn.com&_nc_ss=7f20f&oh=00_AQTaSBgggJyKjEc-ripHDQHqx6EPLVmjtDgVNoEjkztD6g&oe=6AFF0B22"}, {"file_name": "3.png", "id": "1004822956801894", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001726_1004822963468560_3757747066569249029_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBcbv2nnLVgQ7kNvwG4V58r&_nc_oc=AdpgllBq4KJm2CdXA2PaY_dbMqh7QBMuNc2z3zyf21BYS1z4PoomKjg-Y1qaGEYLx54&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmyV-92SBSXgR_gUH9LtN_R4i9FAKAT0bgFw934eJtkA&oe=6AFF0244"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLqXYic345oQ7kNvwFKW3x-&_nc_oc=AdpUqUlnWhneMCvDuUAyYykJZEPZzEfzlZTJjuxMYPAp0AUkwAR7dkLnZ7KfkOAFSS8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwltg2rVwuM_Mk4I7pDrRZdquzVMYNC7xf4gsfyFWxVA&oe=6AFF21D3"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnuufxJsoG4Q7kNvwEWbzwE&_nc_oc=Adp2-lSnj54Cei4GB_k3pTdG6ruyYqJb52yreqBuHhNdh3iNj5WjgGEi8wrHZkNf9ak&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkMPv-PjME3TODyxaCKTdCC2HNmbRp4r2Q8P6RtVZbLw&oe=6AFF28D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRXN6CAqBCoQ7kNvwEefFHT&_nc_oc=AdrNIsmldRy5hho6QH11ehvi6tIU9_gvFnNNhlIRj9dVYpbYCWdIbViZAls8N7XkGWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOVXRhyrFnAYM4BCVOGj-wursL1wZtbMBneX2NFX86gQ&oe=6AFF2A22"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_
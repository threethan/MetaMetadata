dn.com&_nc_ss=7f20f&oh=00_AQSKt4tZOBUUbB164XiqJM_aT3xi-SUjuFFfbhKh8rrovQ&oe=6AFB16A2"}, {"file_name": "3.png", "id": "1004822956801894", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001726_1004822963468560_3757747066569249029_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UXVd17NA8IQ7kNvwGCefd3&_nc_oc=AdqDKGNHvERqya0jgO3zX8dpZbRtyFlhcIbUvZiiZAizKx9f6nv1PLkKXwBZ9saFLc0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsOQfWQF5YVvUmli0QOFlSFqxhE4YnBVdLek5JEZkmcw&oe=6AFB4604"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zInookqsmb8Q7kNvwGq4E4S&_nc_oc=AdoL3Rnovd-XsjajaQJX1DtFKVHCIVm5uaH67TUX53_nPHo5mg7lkC2479klYNB93Oc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5RtJbOrBCDBxk-vwNAVFqU9jm026pQtHbLrgDSiArNA&oe=6AFB2D53"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMcY6A8PhdoQ7kNvwEvLCmS&_nc_oc=AdqOjluOmJPXlmhabhIwz52a_Qsl4XyOvobirJ873JjIStI016vQRjW1amT3WrgVPhA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGgy4NUt_nv29y5zChMLRM_lwBiF64ya2cozSeBFkHMw&oe=6AFB3454"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWqaF1rR2GsQ7kNvwFSrd9-&_nc_oc=AdpthuC_1c-M1DosDd1X4TNeK3kFNkC4URhADBq7CYG_HBUMi5bGIXrQhcDVUMzaps8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdUtTOdPPmDuHd7HgZpgacqQRYUQe5GB6ZBTTQf5ZSYA&oe=6AFB35A2"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_
dn.com&_nc_ss=7f20f&oh=00_AQTov2uEGh20hnho26NYpovylrcWSutfjqlLehqq2vmnxg&oe=6B05A2A2"}, {"file_name": "3.png", "id": "1004822956801894", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1004822963468560_3757747066569249029_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJCxX6hgiQIQ7kNvwFEilcg&_nc_oc=AdqmlWoX9piIekqVESRagpsMyg9OHBffL2Jl620xRXQToA9yQzslvOviLQBCxVWmFp0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpb4sX8g-sxIpbK0-fbfwLEU9XrUNN-Z5_IRd7J0yWRA&oe=6B05D204"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_SguB0ufY4Q7kNvwH7nREa&_nc_oc=AdpibgsNSR9uvOGRHpHa9TS10m9ru5_ma-atEIq9SYV-O30YRJm4ZpFyoz6_nzs7S0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4vn6-EiLRaUZ9JjFO2Td8pIHcFCj9q0kHXFb8lnj2Gg&oe=6B05B953"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku6mYK0QSXoQ7kNvwExsPmY&_nc_oc=AdrPEkIdUtEyfCQp2VslHlDqtpxsIJMhlJ5o7lN349faTgCESKMiW4ium95u-vSgAeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXz2D2GROg4HOha82lS-0YD5gamURCo0k0nbyH2isUew&oe=6B05C054"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ov7Xh7Yr8qYQ7kNvwFrARpp&_nc_oc=AdoPcG8oJ83ewfWMb3qoDkHk4TpEOLXNDBZCMy9QhqUZlMOi0CrSS1N0GkI4SxxvU-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR62Nl4XOUUj4esvHmUvobFZAzEOX0Dxo5dWHXDdaPZ9A&oe=6B05C1A2"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_
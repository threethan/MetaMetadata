dn.com&_nc_ss=7f30f&oh=00_AQRtD8BQetGEOp29Ae8NHZ8Qcxh_2466QmbQsk3-FK5WQQ&oe=6B0B20E2"}, {"file_name": "3.png", "id": "1004822956801894", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39001726_1004822963468560_3757747066569249029_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDvLX4eukBgQ7kNvwE2jktD&_nc_oc=AdpFeGOfeR1a_7fMxj7RZ64oV85LE4FK-acLCW6NlvMlxooF7xAyPUZh-cZCTHRD9Bk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoELPd0DPv8fyZL-AnAivYtn5hv5XDTBgr7Aqoy2eDyw&oe=6B0B1804"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BU_YoEDSTkQ7kNvwE8cjIS&_nc_oc=AdqWAqPG7z85v_k6aTuvXvP5DAz5ERfBHyhhsFEt1_q7o8ssn50Ze16ZdksVZwya_UQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS4X0VeMehnkNKPfY-QKELBqvXVh-rcGOWsNJH-kOVXVw&oe=6B0B3793"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3U8EYPZKiUQ7kNvwEh-1Hu&_nc_oc=AdpXaaMYyy3vNHz1AkmYe_33ug3D3JZIkFY21TyE_ar-VQ6tTOLphSSzilTmEbOsb6I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSAOL9t2fbhyPNK5PQzx0kFrku7lHVVPGKv8EbWpYRk_A&oe=6B0B3E94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9J404GU7hU8Q7kNvwE5PRz6&_nc_oc=AdpZ62pptz3TppBRvvy_SD3Le4xDmEG2CwwhnQdlyTI_l4fh0U7eFyz026l1K2Vnfpw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2Rtf9kzz-DpNf8aVAmSOndJ_LQoptswAc9Xf-FU1vug&oe=6B0B3FE2"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_
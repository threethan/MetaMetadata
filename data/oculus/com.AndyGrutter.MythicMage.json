dn.com&_nc_ss=7f20f&oh=00_AQQUk3ocTTnMKaXfsTCQQk-HMTyKCvJ0QoJcif3v9L3few&oe=6B06F422"}, {"file_name": "3.png", "id": "1004822956801894", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001726_1004822963468560_3757747066569249029_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sE9ORQzilhkQ7kNvwHSRbOC&_nc_oc=AdpciWdXw-1j8K0qeGlr88VPk0L454uE0sXlKXt--YaBPAqzh-vfIVbb4pyQxP-0aXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpFQrPudRodCD5rsstV4FVx1d7v4wG832AAlG9kM9c1A&oe=6B072384"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_SguB0ufY4Q7kNvwEFirHA&_nc_oc=AdpknE4Renjq4BU0NKeJykiYhgkO_zwyuRwNn5z2xY8lAh8wAQ6_4wsVwYsa9ns_ztM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRKxrh1ML6j5wR8J6WXeIfxoiQBR-I29m1TT9VinS_9w&oe=6B070AD3"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku6mYK0QSXoQ7kNvwEii3Im&_nc_oc=AdrHxrbc59sUqlGbWlji71Cnafx02tY66EsgyJ4BLk2vAQBYVwJnBWA82bQXJXb0P8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWcCAo5gkjpUYs-DXMK-90XsH-uzmI2Td-GNH92B7x9Q&oe=6B0711D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ov7Xh7Yr8qYQ7kNvwEYilaW&_nc_oc=AdqBx9J3eXNblbg0par9R4rIxuvmARx9uGbTcA4GiQXG9GeXpFVuZXFkagLMrThk72w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJKlsGhVWDrw4ms2VpmKBpfHgnm43bgAabQbrxUrWynQ&oe=6B071322"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_
7066569249029_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81pqLBhRfMYQ7kNvwFukKsg&_nc_oc=AdroeM1n1cbg5rY4wSalIH_m5pmkzUqJTuMW85v8AsuVe6ydqGaz7t1rUzTCRiHtBO8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn9yhXsmZk-GnW95R2a44mO1Wplfr6G6mQFKYDuoJlnw&oe=6A7DCF44"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ukjy9uN8K60Q7kNvwFg6tqa&_nc_oc=AdqX5vsPULgGl4chCh6Yul4Hz31idzTI2t0wBVlQNntWP6jW7Cg7Kam5FZ3prLQMfMk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGZueWnQJTqVpi8tohoVXsvIcGPxNoM8y1aRCQ1oIJDw&oe=6A7DB693"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LiMQGD95ie0Q7kNvwHUC1mq&_nc_oc=Adpx_2BL9fxdQIPqE8Le0KA2J-IVTjWy47jQ1Q4etRLWBWhXQ2yNAk3_YDNMvXRBxsc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe-XOuc36UVQpDpwAHnziu9bbIbW4J7i73sC7cpUo_0A&oe=6A7DBD94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9BDXl4CCbsQ7kNvwE_imwA&_nc_oc=AdqYso_Z6mq1k0bORH3bNUa8eJ7eUsYoDzhsBM_gDr8DcY_16dzk3aZPgQj98TPohbo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4a-TvQPJS7tI9rrsKz9nUVSOrrcy5JFcNNSaRKE-Lww&oe=6A7DBEE2"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26208992505413930"}, "review_m
XZS6_u31ZaW1hIuW9MEaioT_yjmhSckIKXTjsTioEhk8r8-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsNOENgHaKfpKz2pk2iwrCe6II9An_P6c6vxv2ehtpoHw&oe=69A6EAC4"}, {"file_name": "5.png", "id": "890415998302566", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031495_890416001635899_5520843411784371906_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xX8NdfL80cQ7kNvwEJg-Zz&_nc_oc=AdnjdWsF7mMm11U56_RL3m8KD7dRAsqsBNUewRYDd59IwahIIjSKou3esUSAkviBAUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjmkSf4XtUwYs0GbTAeUPlzoYn96ZZRDh3_1lUR1T2BA&oe=69A6D213"}, {"file_name": "4.png", "id": "628814941870205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035322_628814945203538_4770203885935459241_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZZhHzjUZ-QQ7kNvwHzcv54&_nc_oc=Adlz5z-Tts8QaPU-HQWtCqrdaNKpT2c4D40HHQQI6_9pFW9u3GjWGmOaobu30PFBa_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsaTvPsFXhVw-Ky9vsTd7-83cmYeZcdlyGd73PvTT2cmA&oe=69A6D914"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape 2.png", "id": "624916828951306", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031653_624916832284639_5364896033089899053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPGCxOt2jhAQ7kNvwHlDkSG&_nc_oc=AdnbSJ_qoK62sDtdhfx22P0CyLgzhhI0YhoCexNOelVC-5sMYW4K7DsDpy7DzBhLd20&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvMYFSyxBFRYS0oaZSeBjMASEaKAJ0XKvu2UFO6PV8b3A&oe=69A6DA62"}, "display_name": "Mythic Mage", "keywords": [], "long_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?\n\nFeatures:\n\u2605 Infinite procedurally generated dungeons!\n\u2605 Terrifying monsters to battle!\n\u2605 Environmental hazards!\n\u2605 Shop to upgrade abilities during a run!\n\u2605 Permanent upgrades and unlocks that stay between runs!", "short_description": "Did you ever want to feel like a powerful mage as you explore dungeons, fighting scary monsters and discovering long lost treasure?\n\nMythic Mage is a dungeon crawler with procedurally generated levels. Fight monsters using melee or ranged attacks! Face giant bosses! Upgrade your stats between floors! But beware: if you die, you start again from the beginning!\n\nUnlock permanent upgrades and new enemies the further you get in the dungeon. How far can you get before you perish?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/10aIJbCE7sSdmNKTR-5PfX8bTVjyPkZ6BY2cwRRS9wGQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Andreas Gr\u00fctter", "support_website_url": null, "website_url": "https://www.facebook.com/MythicMage", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26208992505413930"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982552_447432793505627_2608790852213389260_n.png?stp=dst-png_s360x36
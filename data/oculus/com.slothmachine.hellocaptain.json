0717696_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sd-rL3AcueUQ7kNvwFJaSIW&_nc_oc=AdoEaf1zur8Dpu87Qc8llhHFrMMCDvuTN1EexhtZQyfvuwrHKS_mULKvjM86hekWc40&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfJ53-POBwBU2s72gHcb3OMbBWu5DqK6I28n4SX7g4hA&oe=6ABBDD79"}, "display_name": "Hello Captain - a Short Pirate Story", "keywords": ["pirate", "short", "story", "dog", "ggj"], "long_description": "Hello Captain is VR short story about being a pirate captain. Command your simple crew and have fun at the sea.\n\nHandsfree experience: Use only your gaze to control the actions in the game.\n\nDo you know Game Jams? 'Hello Captain' got its start at Global Game Jam 2017.\n\nIf you liked this game, we have published two other VR short stories:\nFeast VR,\nGo Shrink Yourself", "short_description": "Come and command your new pirate crew, Captain!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.slothmachine.net/feast_pp_tos/privacypolicy.htm", "developer_terms_of_service_url": "http://www.slothmachine.net/feast_pp_tos/termsAndConditions.html", "publisher_name": "Slothmachine", "support_website_url": null, "website_url": "http://www.slothmachine.net/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "CASUAL", "MOVIE", "NARRATIVE", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "fi"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "980361376238320"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727894_438644293133869_516060
=6e7a0a&_nc_ohc=1YHAvOvIla4Q7kNvwFPA83a&_nc_oc=AdmaVGIbeaq_VXYTJM2QCmrhuJ63f_FBbh9gdYvqnpIVn3CXAl0c0lAq42F88I9a2vI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuxK-lQ43QlGKmnRaqsTTew53j_abQKmlMURmCl7fTjDw&oe=699AFE09"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4cT6oA4O3cQ7kNvwH5gAWT&_nc_oc=AdlU0W3qZ3dP_BPuP6iNrSLyQxjIAZvY40MkFyhY0HM5kgaszeo-PDyIJq31Ld31mDs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuCYyZmJhah24im75Xq8LRnmpwXMkU9GA91eN9VnKP5uQ&oe=699AF7A6"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yPvFmNGxZgQ7kNvwHrL9Rb&_nc_oc=AdmswO-Uy_uXD77jNSVRq2SKS5IFKdv1Czc3W9-eVtw_Bx0O7NVtZlHgxf9-jp2LdXA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvzs9e-YGm_NMg926BplBHL6RHi4Ouze6dTSu7YbhC2pQ&oe=699AFB94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RKmY0kMfVYQ7kNvwHs1NOO&_nc_oc=AdkhwrPvkacv-M8CJalAg26tsK-BKrHv_hikboodek4peOMCFFUwl9L1ZwvNFZW1K1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsTmsyevGrCDhdCyp7DIGcztAJHO5s5842aqeTNWvsj0w&oe=699B069D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
=6e7a0a&_nc_ohc=1YHAvOvIla4Q7kNvwFbWe4z&_nc_oc=Adk8amnfxUFR-VYhz_whhpET23cES1TG70E21mKIJaMDF-cuQrwvP6ZS6q7zSmGMoXc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu4YuQHoYN_feyKrFhFuW2tuCmgqfWi36KV9_eJyORelw&oe=69985B09"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwsp-f93tmsQ7kNvwHC91OH&_nc_oc=AdksExylqBhs4ulAIkB0neD0RE1oHo6tztXeJnR3MC-QLzbi23Cf50dwTF6xdXXcLBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvlwDWZ8r0VcdYijrQS74mR5JJ_bbdeDbhyhSqaKMy0aA&oe=699854A6"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkx3SF5KPoUQ7kNvwEedq-Z&_nc_oc=AdlxCyRF0gEC9MMZ__Hd_o9CZBVnTXcHc62D2vGwLGPYHQ7jbijURK0fOuCoEeGMMD8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afskwv9GYUH9AEwi4zCbBWxLuLcZWkyP-HWvOnpK9sQ4Gw&oe=69985894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql5KidCBho4Q7kNvwF76xr4&_nc_oc=AdkKzxXPQjkoUMuqgcUCZyOCI1iYWiMzdzqNWhWI2VRSPhyYraRUa9tcsHLbIxnVJFA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuODrRaEONeyXkR3ym2wd3rDEUnFTRbRmbXOop317a_kw&oe=6998639D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
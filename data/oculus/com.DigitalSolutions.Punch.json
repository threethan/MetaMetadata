NRJRR0zcusjOS2kH1ACIA0WE_qI0zKVBImA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDRS4eIgXujk84KmJfZHmqRjr1_nvzLcvpT5z6Li_faQ&oe=6A8C2B44"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUilfnKtmVQQ7kNvwEWN8vT&_nc_oc=Adpu0urOk7I83qw45PE_IspzwnQ_4meO_4LUR1jH8s0PihUJZxAB5L-Fm397FIQokNA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEktqrF3625n5qkl53jR7_f5uTMyK289otQJJL2X_OPoA&oe=6A8C4089"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47WbIpcN4dIQ7kNvwGCfi3o&_nc_oc=AdoagTlAnlAmizsEB5gK_i9mO017ADzxePPX_3uWrTNCIIpHs_3W9ezYjf3HjJhU_vg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHI_yhSYFS9e2aExh3wFY-4efH__1hE1DAUDzXtLOLtDw&oe=6A8C3A26"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QL9aOCrD3F4Q7kNvwH_9BAT&_nc_oc=AdouJ90nPMk1C9Etn64BipYvPEWytnJMBd0RNRndjiQgsMLN8nHkeCKNntPQFpPoTYM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5KSdd-ZtlR2ywKs7-Vi8EKjGb1DbxAR-Ni_82nhJ4uA&oe=6A8C3E14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhjiYuL49-YQ7kNvwEFX5ys&_nc_oc=AdqHNaKJ0CjJ0gIXOf5T1mypvSy4qrvxWfYc4B_Y-MUPaCkudRhAiAxwMQMnYE8TyZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdrS3dNBO-F6sHiQ4cBfMNf5M21NZUQie2OTpZiqoBhQ&oe=6A8C10DD"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
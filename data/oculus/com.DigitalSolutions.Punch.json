FQ-HXPzIj886xCDtN5wkzLrFTzYnDwdPtrgUlg&oe=69C90D44"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0WFxlSR4BYQ7kNvwG2PxE8&_nc_oc=AdpC4jpUGByj9LEdCLes05a7pAJkiRZqw-8c4c2NDQ5qbChVJhWo-yZ-LG10h2a8xxU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhfB8b1EMtqBHM-uHx9O3Qn4gr8RL1BngCtPmDkmy3iQ&oe=69C92289"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j68p5z0XzD8Q7kNvwEKCNsB&_nc_oc=Ado0NUnjnNF1BP6o6zjU9tXl_hGY8_xnzfOjBK7HFyOryRzlT6MFT1c7KIEfNVxbQTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5LU1hHDAOHZh9vALh7G7kx8iruYdZjVLmgUic9S415A&oe=69C91C26"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2e_3qUrZgwQ7kNvwHkvErW&_nc_oc=Adrj3eMKa5qGt7_YNTtjpkIbniXbD2qtZsgk3EZ6T3JX2bZr0lp8tvj67bQ77JjPQDQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdCVlMIOyncjl-ky06yypEtZxwOQXKtWjlGHTYnTK71g&oe=69C92014"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2UZr7ngfj8Q7kNvwHmFDLH&_nc_oc=AdpREOTLZHIMq5W4FmaocqzdyvsyhZnvsZfMJcomfX_MyzmALaITYChPj-8Txna_Uwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0T6lCxKVaM7DxFf6KGLqTYH8E1BkcTcPZbUcYlRyRdA&oe=69C92B1D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "e
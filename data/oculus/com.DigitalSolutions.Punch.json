ng", "id": "1307234017850357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnXsxzwZD4sQ7kNvwHZNmVH&_nc_oc=AdlgU6PwNUDPJU9Ckq5TWk0kk4q7t_JxBtXXPvGUJRYSB6vWP2aHnfM7MtGIvFGM6q8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwWuFo0wLboTshtosQuBsRViteyaRzU6i82xCaLSM9gA&oe=69B40A89"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0IjO9h88owQ7kNvwGX9UbI&_nc_oc=AdkOF34_95uq-Os4mAU4Be6ieaEAiBNvN1DKaJKj0IJAS4nr85HjrYZ4RiBUddBmXPM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyB4Vfl75Atn8lI433KBWdjZloJeiD6mAiJCOFSZLhOLg&oe=69B40426"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kE1hKnTxcoQ7kNvwG_s0JB&_nc_oc=AdkNYYJ51Gq3iWe3_V_f98f6lDhsA93UUK7ls85GdoJikMlZT_5wdV0t_Atfs54szlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk4-bo4R7CppryGj0VZybPjL0n0iXF0cgg1k2NAylKAA&oe=69B40814"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNC5lUMk_qYQ7kNvwGerQT2&_nc_oc=AdnHRxfwRBChAoXZa9xu_0GO-_ztihG1VW9sFyIeN3Vg1aBeNAPsJxnIg1s7Ez7t5_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKa8PXuG1UJkVPl6kY2R0wvFCXORwOEuF20GjFmzh7QQ&oe=69B4131D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
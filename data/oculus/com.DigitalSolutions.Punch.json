037353132020_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oySkDqMOYIgQ7kNvwFPkHnR&_nc_oc=Adrh2kwuNZfbJSicLdi8QGBjsG4PbNaf0j7YAWO9agRsnG7ek67SDvQjUCqO8bO9JjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk8W6IIcFuAGvFCXacAHfojI2KoNuEncrY0GkZlXj1fQ&oe=6A984104"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OqoUYZuUIcQ7kNvwHTDQI6&_nc_oc=AdoWKV72Vge8uzR5poPq-0jfA41Yi5h3D5cUlfDUvr6x9_FYYZ6iprJ-3RgMfQb_Fuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvESK29FEbFz-VbQsavTgN8MsJ-bGuoWhSAN8kxyPL5g&oe=6A985649"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HiXT2IgCuWMQ7kNvwGEPQ6M&_nc_oc=Adp78_nEjBQ3ECtab-48PvhMqxP7NzTWiG_-2EjXJ8NqLyhxAV84boNMDDmTmZKo57c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKseGH7vEA29G6AHUCB2u7CguvpM_iTl6JsFrQvTsgyAA&oe=6A984FE6"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YGnUK4gIhbsQ7kNvwFFyp2G&_nc_oc=AdoWhv0EcuUvvYoYuoZ_xlAvbKNZ85TEtXlhpj98exPqcca7LOvol7lxl6bso53cHyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLWHaMAANRjNohZ9-Xd0MLj1bAxkJp3KqgGOccKNvyCw&oe=6A9853D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6knL20QseOUQ7kNvwHOYANO&_nc_oc=AdqbTDEKqYsuRSgVz708d94bsUZuxQ3eACLxIMbaDksJeE6YMSUUPruquw5nfupyubA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjrkfDDIl1RznWPg00I1DBYFZzk3MSG6MiLGRKbNnjuw&oe=6A985EDD"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_r
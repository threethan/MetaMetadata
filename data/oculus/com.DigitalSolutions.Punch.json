842494448299524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kE1hKnTxcoQ7kNvwG_s0JB&_nc_oc=AdkNYYJ51Gq3iWe3_V_f98f6lDhsA93UUK7ls85GdoJikMlZT_5wdV0t_Atfs54szlw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk4-bo4R7CppryGj0VZybPjL0n0iXF0cgg1k2NAylKAA&oe=69B40814"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageandscape.png", "id": "1490583565559120", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619078_1490583568892453_408736166888004412_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWtUKqikquYQ7kNvwFC426Q&_nc_oc=Adka_e8ka9W_PDaM1d-holjbPgIC_E4U5wzcN2pFRvnW2S4_qMdUsAjA4d3FVGbjY2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzG8toSBaiyHmX7HEEFERAAlqaYpyaB-U4TcbIvl8WFTQ&oe=69B40168"}, "display_name": "Punch", "keywords": [], "long_description": "Step into an energetic VR challenge that keeps you moving and punching nonstop!\nIn this adrenaline-filled experience, various heads \u2014 human, clown, zombie, alien, and more \u2014 appear in front of you, launching balls your way. Your mission is to strike the incoming balls with precise punches to destroy the heads \u2014 but be careful not to get hit!\nAt the end of each level, a powerful boss head appears, and you must use your fists and the ball to defeat it. As the levels progress, the pace quickens, pushing your timing, focus, coordination, and physical endurance to the limit.\nEnjoy three thrilling game modes: Fitness, Football, and Classic.\nWith immersive VR visuals, responsive sound effects, and realistic motion tracking, this game transforms your playtime into an exciting fitness challenge. Whether you want to relieve stress, stay active, or simply have fun, it keeps your heart racing and your body moving.\nPunch hard. Dodge fast. Move strong. Feel the energy!\n", "short_description": "Step into an energetic VR challenge that keeps you moving and punching nonstop!\nIn this adrenaline-filled experience, various heads \u2014 human, clown, zombie, alien, and more \u2014 appear in front of you, launching balls your way. Your mission is to strike the incoming balls with precise punches to destroy the heads \u2014 but be careful not to get hit!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25195709663401923"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619113_1360975039055921_8428499192525708231_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIpLwCoXGFEQ7kNvwE7xkCQ&_nc_oc=AdlGBfO16HCsOOA7r7FqPzZ-fQVefE3oZ01ybJuJMSp_OOUtnmo3_CwaoyhoaBhVQ4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyj6gdt9L-vF1ZsLNqq9n-4gfUOQf25QUqKKrZwNyAp5w&oe=69B3ED71"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Punch", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"},
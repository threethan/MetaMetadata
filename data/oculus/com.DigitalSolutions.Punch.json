037353132020_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYIAPwYYUrgQ7kNvwF6b5ke&_nc_oc=AdpPox_Exse8jvNkG0u4ITWbkvyBeiCWZVr1_XE63IXNMxIdF4KEZk-D1wK4Armt1Ls&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCCWp6FYBhRHePjYOK7yUIWFAXAs13-pZMnJZsmcLjow&oe=6AE8AC84"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBFak3M2spIQ7kNvwFGoCw1&_nc_oc=AdpG5Q0712gMMi20_nRIbndJEjYYe00XwZpJ78Mkho3iwFCOngRy6OgPAFEhIYwA4qY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdzET7UHc8D1-7sYUrZjf_LFNO5AA_gBqf8_ML0UjMMg&oe=6AE8C1C9"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMFWYAX13wgQ7kNvwH6NS54&_nc_oc=AdpjqfrmiJcDFxTVZ9Ew9Xhlcvl6wT-zDea0Iu7IdAKu9cRufykm8fJN646sSPunJXw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRk69gDMBzUYlBC-Fpy3a-koQv7_Vg4tShLvZZGe4Ys-Q&oe=6AE8BB66"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzq1QpG0_zkQ7kNvwEaiKrq&_nc_oc=AdpUs7b14e7yWWkbHqOCns8kVrAk6z4zfKHFQ1bO_XZF2Y_Yk50c3kGdTv9MgXD4w6w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqgySBoJDX_5AchY4GdLMG2vXEd-u5Kzu7dgnMK_zZIw&oe=6AE8BF54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGWd6S1sebwQ7kNvwGo4TOo&_nc_oc=AdoFJV3pK12VrRm_KBjTFgW-PW53UQcSI65V_qNZkvp2C6irX6YcD51i_R06u-eazi4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5Vk_grWNzVcZyGr-tE7VCQpOhtB3IIKNNz0wgNsypLQ&oe=6AE8921D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_r
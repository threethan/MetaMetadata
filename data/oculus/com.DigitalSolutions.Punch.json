WdZViPkpPJ-J4ZsK5SJeezr_ObiBQw6mdEk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4qvc4fW_MA-WHXGTxXElPq5MrI6LQvaZTEZsiskZAcA&oe=6A2C2604"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qm7yl9uG5AcQ7kNvwHMbnUb&_nc_oc=Adqe1nSihVvIkSWEdCewc0ql6l_tlucK_B-2x52Qow7UZJyY9fCDUypY6IlXbTu_lec&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PykEQ1_KbsChupfvkPfnOXJJLLde14Zau6zQT4coC_A&oe=6A2C0309"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DHimVZ7RYsQ7kNvwGSzIan&_nc_oc=AdrVwccd77gnVsyQJjNkmgcZeW5w6NbgN1jA5bhg2NCbfIHlB2gZ9v5yq4eecedTcsM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ic4wrIfL0IGGIxlGRuR1TJXhkKbDG9L95ATyp_z4ugQ&oe=6A2C34E6"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDsUkvzEyJkQ7kNvwFKm5yB&_nc_oc=Adobuhxwk9woLzIw5FvU-lvu5W4Wsrmkh0AJCfQVL_8kWPoj_YnEK6EBlLe6KzYe2MQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8crmwkyA68qdSfTD5B_tBp_DxdtwFEK-bskYZDKnqxkQ&oe=6A2C0094"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOTe8HOJqQQQ7kNvwECdw9B&_nc_oc=Adq5hNgtnYFJ7CsypwjwdP_RJ5lYBkB2HNDiGGnwhFIkVaTkiSfzKao3RuEQDbawkbU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ti1YKyBuF8Pv6xm4V3zrTkmTDZkZb5323iRTcBcPWrg&oe=6A2C0B9D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
gogo.png", "id": "829481226435378", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827071_829481229768711_7920571266177043091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ii4fGGUTmQQ7kNvwGOaDfl&_nc_oc=AdlyvnmBMOjogN11P8_9ePbQrqEsyj0qoZXEUOiLs8QvtVeSrcpKP1ArcqKyeVmj7c0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvi8WbJxUTVrM6x4RcnwgggNhXCIW69ocgeugyhA_mloQ&oe=699EFCFB"}, {"file_name": "Portrait_Cover.png", "id": "809849865093960", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818925_809849868427293_5512702468765257090_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2nmW9Eyc48Q7kNvwFBO7Sj&_nc_oc=AdmltDMB3eRJHqvyJjn5-WPOGEOv4y8OyoXeAzymxdIHTiTBV1-xB-VEQ3MtE4Oe-pU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsv2kD1zwTKpd1G5S7tIpBJx4DjmRCXBiwjV3PUGkAfFg&oe=699F0973"}]}, "id": "1486585035956041", "locale": "en_US", "screenshots": [{"file_name": "circus.png", "id": "1464957134788898", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_1464957141455564_4000681213640934986_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNFFkjiWT3UQ7kNvwFU7dY3&_nc_oc=AdnOSs73eW44NBFyyLZxNmhN2N5psulbeyLJMHTYTBLwfp4PqSfNHaWV7s3Vj1EWdDk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuJWEAHR604eNw0JpPWLUe0itB6xXiSBGd8Fo6rj-sV-Q&oe=699F0802"}, {"file_name": "Alien.png", "id": "742553942131231", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_742553945464564_64000037353132020_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1z5MAXaPAEQ7kNvwGPwFeF&_nc_oc=Adn4Rldv6PWA2kj_JJVNSGBZ56yBEJR7JsXysajs-dTmF01jS3lSRQeQaXjb_B1QeUs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvDZrzV0gW3AVYUw-zT6nj7lAekWDOtLvkiwrLUGwoLMQ&oe=699EDD44"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWuenmPEpz8Q7kNvwHJbj-T&_nc_oc=AdnRQCaltsTwhex8VXkgWfgNM0Z1UdNvntduP2pkvTQIt-_LzPDrwjFGXjBYF_zx4Tw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvCYN0xRLWJWQ3AJD9qFtHfQAbeKL5QLsMwNrVhifRS2w&oe=699EF289"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSUN5c7YZS8Q7kNvwFsB-Ow&_nc_oc=AdnbyfWxwzaeikciMjDUqgGZQza_BRFlH3NvbbkkMkypKkjwHPZioVu6s6TogQqnIPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvNhpy6feyXAsr0lml43gd7Pc6L-C52Ya2YyhEtOAtgiA&oe=699EEC26"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-DyhCSMB1YQ7kNvwH9FFZ3&_nc_oc=AdldLrfFdPFp3V-Gek9PT3LK3Es7Ioo_6LCHgQZ2DlD-atpQnHBr-cd49jc5mbupFsE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftZOxBHz3q0UMJI_XZHLf27KEWL7ILBjL__8soD80l6kw&oe=699EF014"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IkSWLBEwb4Q7kNvwGWo0eY&_nc_oc=Adk8fo7jPKX6Xebx4JND1luec6IQxq5FTUpFAf_2ZMGEKe6GR-fhSuF3xIcrK-i2SHU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuX1fxf-oXousGt_JFsJzETzjtDuFjBmfXaPgK_glqvHw&oe=699EFB1D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
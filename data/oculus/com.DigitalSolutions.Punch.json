037353132020_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q2QvVgLLPEQ7kNvwHIZrBj&_nc_oc=AdrEMypLf8gqZvQaCe56YJEfXD_k6GJdCgqMsghx43ymwUuooeB0Blzka_tD4ahFZsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZPhMXJJnaskNnsr0Q4gxBwxBfWwjgQiETOKxX_iEHXA&oe=6AB54204"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrj1GRkFwHcQ7kNvwEa3FjH&_nc_oc=Adr-Rc7G3e6d3bEAYgSiZFFVxG3vhhpDY0Gu8QIhoeVIRGBRAdiXvvIB1If_A2wh1mM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd29PARjIAQNLXEQaLTDi0LIVXekBnZovomqWh0FRV0Q&oe=6AB51F09"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiLINqu6pwsQ7kNvwENVPyz&_nc_oc=AdrniJR0UF0qxbE8uBf3tOYIrElSMjbT1muiCHzMfxGousBVjIK_LxmSL3I3PAbST94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLseqA0swDZsMSaPB3p2tZdc0GQas8D60v4bcizTtQOQ&oe=6AB518A6"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIivD41FzwcQ7kNvwHZYEHy&_nc_oc=Adp8FZw9pEcw7uSYtx1wD7fCRQI70wtjCz7fURKiQM_d7ssbxjcelxv_RACWRn1fU9c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL89rc0DvDQGX3CZO0uC0p2YjiRWx2o35IMXO5i5RC7VQ&oe=6AB51C94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccZ-yxFEdI0Q7kNvwHBb2Bb&_nc_oc=AdoUJmO_HsM0gT6SYVdFsICxCuI0AqQJ10QUwIo8BBhvYNswbAyhNI2yN0fBUHo5RZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1Uncp75fqVoQYQwj2UdHK4GWAdgkkrhYF4ohLs3cM0Q&oe=6AB5279D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_r
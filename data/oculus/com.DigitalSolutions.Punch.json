Po_VRT6v5VAB1TtBBhQehUukumrf9-c5ZQE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DcnrzjYv6EvHblBhf7u94vuTyWZ_ZPw9EAb_qyz1m1w&oe=6A1B0284"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qz9EL86lAuIQ7kNvwEhDcQT&_nc_oc=AdokAPK9jXcntJJfDzoFMoUFSJFLq0P7_J3ZCNujlUI8U3lKQLAfLmeqBKaYHTwKQ1k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UgGmOMe5ZN6xKp6VuMOA5NnFJH2xAbdZv65WlZJR1dA&oe=6A1ADF89"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIrpc9QbXVEQ7kNvwFjmeem&_nc_oc=Ado5rFaDJHVoChFqa8dgyulUaSmj9SFa7xhZ2fujt5Hs7RPxhY5MhMLu6MCW8YcNpik&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gbPHwSkn8EZYy3U6MszxumM30DH8mqN4gNKUG75zs0Q&oe=6A1AD926"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5aqmAmgsFUQ7kNvwGFncP_&_nc_oc=Ado9j4tIH1swxqGEDgYjVCCyqcf_cgUhE4i2QAHuNqzuT8ikjgdbp2ws5Vg6Yw3IziE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ma-rl7X08ptBtUHSB2CiyNP1KVvR6rt54GAk1aJmu-Q&oe=6A1ADD14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me-7sJCV_aUQ7kNvwFrv2jl&_nc_oc=Adqk0as_4IukZAioTYPk8aODU3ZsryStiOhN7pCLJCb5s4GLrLDdxp5Cvk2X80HpTc4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77aVhqcgQ5huerRFaHpfcP0LvxutBXJyA8DR8A1n-xNQ&oe=6A1AE81D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
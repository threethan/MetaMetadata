4t8_KZNxeBGAxEEj5yHRBbCU-hOB_2JB2bM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LC7rHGrg1-z54BWgE6bIE8HfVaPBAS3crmMxKhPSC1g&oe=6A340F04"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOBW7KKb7WYQ7kNvwEesQk0&_nc_oc=AdrnZwisLkLouGZVnnDWnjGHYneEjsLoAs2YkR3_Kk0WPouaaYxiXBErC3voZ3zCTRs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tOI4osODN-Czrs-dVPJjuaXsWfP-CRDbzNN6JdfYBpQ&oe=6A33EC09"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-lzmenr2ksQ7kNvwHQ-St-&_nc_oc=Ado3l36-ensjAumjaoU-B3k846Rc_8G5-vQ8sU1NBnjPIgnC9WGyYFVk5Xwegeqmfqc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2fDkDM0e-MO0GDwLhsv6FK7nfdpxaoMVUMbYFoKMBhA&oe=6A341DE6"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ov-pSTH2LnQQ7kNvwHMDBzB&_nc_oc=AdrPHukzrKMY87kmg1X2ZHj6z-2Ijeck8vJHpt0jLtz4whFvmVfgr1Q6KLNPSMDawVQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_i-ZJnS-FZiTaa6TY6aOsdzylp5ZoTGdVCwtkbSlcqZw&oe=6A3421D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5NbGKmYKEkQ7kNvwGQtGJH&_nc_oc=AdqI7iMMkY_1Hl4K5wPwW-qL0aHLVDuhgihUC8cFBnmdn5MFtNa1YVPWdDBGmqkaa94&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yariaPMny9acwWIXNY0SKwbDGSSqbPcBy9LSe25fLaA&oe=6A33F49D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
b5iXlrNt9hFhPvJQtToens5lv0FsjWum3AI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvBWoMMb47IIGIcPI6_HrkYw4iotp4Z2aJHGKRy2NVbg&oe=6A6CBF84"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CF0vCy29MJsQ7kNvwEBzjBt&_nc_oc=AdrsuITXTy3wx39sqr6EUlhEe8Z4QyksTyEdiPIMllvWevuMz-fay5KuxjS1jj-TBOc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqUtLxkd0BcZaUchqUTTcGgnYCAMBZ2K3ZpIxhdoqdRA&oe=6A6C9C89"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kgSfGcSj4rEQ7kNvwGERTAg&_nc_oc=AdoOgtXctGTLPSiCwsf1fio2KCO_-gW2eL-UVloQ-FOFMOOyCE7DazYEdeon34keaNo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwgnL72MVQ8SmF3QZIw1jSnYzNDr-L079ZHhybeHK6RA&oe=6A6C9626"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OskpbpyIgdcQ7kNvwEjDd2b&_nc_oc=Ado1aCeVFgQC9ztf3CH2qlw5xjgj6MdoNFtO7_JKlJd6eSIkd2zurXuKOBSpBCyAdR0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnawfpom8QvKHHnIOp554eexxme7gKpDuiRkxCB3f8GA&oe=6A6C9A14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lKKy0qxqh0Q7kNvwEnImuL&_nc_oc=AdqovnaRAh9ASmTMIf_8U-4W7nKrM0DGteV_RuqF9JSG6SWksu6y8In22IZXJFifW_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsFVHwod7WqvppWYBWehnBzctCTzzV6B_ncmNXJHPl0w&oe=6A6CA51D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
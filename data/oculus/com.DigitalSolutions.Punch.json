5xQeTyrywYqzA5ET3Uts26zVi2on2gGFhHU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89xi8GVLjd95OdWWP_2L1LA9J-hbxI_eyljT7-C96E6w&oe=6A301A84"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRFSk8SkwKIQ7kNvwEZ6z-W&_nc_oc=AdrGTrWbPJdsrifMSkRhh0xF_xjhuWQw9CIKeuOe9M6O3PA2TEqRX4pcJlG_v3kWSaE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XjgOMSuwfqR9nG_u1CVCe0BsvyLh6pY6_Wcw04LCfxw&oe=6A2FF789"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqrywtzHMI4Q7kNvwGjJEJl&_nc_oc=Adomjo999SNbJzjKZ5_CKXin2s4aJz5jhb1lF7D6yWu3cVLkj3YwVS8C6A9r7HxeFzU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OSCu_UPew5QMBdzxMjwRYLMYpY6ntwkFP1HRnjOHSUQ&oe=6A302966"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjQqdJ6AM30Q7kNvwFomsyb&_nc_oc=AdrUTf2v39RYPWk-oVcrU_1DhcKYQot9lPnJHEeiKgJ1ISgJ81jThC4vPBNc-uTg3vg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zOp5Zv-pPp5O-a0DOgC0vWcSNwJNWjZn6As-3dKFnAw&oe=6A2FF514"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcIn8EFOgOMQ7kNvwEApi7z&_nc_oc=AdoahnlKa9tJ26GSNXw4ec0qbpUiSi2g7UtPePrjWUz4NuGZglZmAEv3AelA18SVfN8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91DDMm0prthvjka9G-q0Ze3p2JpZHUDPYzcCRMiW39-w&oe=6A30001D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
ng", "id": "1307234017850357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PKY3bYDoVCkQ7kNvwFUrnNI&_nc_oc=AdmpYS4k69Qvtffmiq8rbusR817oNIpnQNRnweOeCcU3nPzBolDzLVfbMLyO3N3btCU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTW_cf4cru-Q_utJsW8BiSY4MsxvuMdjebk8e--pLsjw&oe=69B95089"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psW5KJQd8vgQ7kNvwEZQpDJ&_nc_oc=Adlb9NIen3otDKMmJHrrQ6CIuE5MA7I4ObJTvJzYdAT73_QT6F7nR9usGUlFulr_zcc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwa-L4eo34cBL6r7eNtIfGaIwAGraTkXgxByhmE-lcUdw&oe=69B94A26"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfej-M8_B6AQ7kNvwGRzf91&_nc_oc=AdlDcUcBhtuU4rLAIBCH9UP2VM6T9XYygA3oMwId3pklQrZqeJffA6acoGO_XQfYbVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQJaEMHMWXGmSu7jL6Pu0j9fZLBcJ2aGTjtC1VV-ASSA&oe=69B94E14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCSyO2ZrJ5AQ7kNvwFeyB4o&_nc_oc=Adk6jeyxG4Z-ARr6bzaEIY-dHLBvFc_AKfpie6zpFT4KVs85N1jakKjgmh3xY3d-a2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMRtQ23Jb4tHPSlNGw2INqGgq1FlJIfFHAQX5df6By_w&oe=69B9591D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
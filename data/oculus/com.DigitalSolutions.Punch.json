F5bZYR-704Nrt7LaCcMcRS9gHCq8ogah7NQbDQ&oe=69C518C4"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWyJPDO-CSMQ7kNvwG4Cowb&_nc_oc=AdpjqGZobPRvKPkk1Z5hfHuc98yi15XRFSULjtQvt8pqmJ_24wEFqwezo7Z62R9y9AM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHtRD8hOpJYrGMrCR8oz8yn3v6EEZgT06wCovMVmtxqg&oe=69C52E09"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOdvXWZ2PAUQ7kNvwHA8Wjp&_nc_oc=Adr65I2hhTJy6nqhw1peMFljtabKVfEZLmP7omOHQcYhM7bS1fql3rk7NFcyJp9kYP8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyrEoZO5BOJS1IU1iwGDwgloEEr4HQsc-XQNXu6lFi5MA&oe=69C527A6"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xx4gmXym8tQQ7kNvwHuswTJ&_nc_oc=AdogNjFQ2EnYK86XfxUHDir1TFpO4NAObBhFqHSQDW_goruIY_KXzsd8RG11afi5aA8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwo9oGvZY5dzbta5rdUc0qNl28Qp4QHCjp3jQXGO_Lpcw&oe=69C52B94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJfr6GcLeI8Q7kNvwFKbqbT&_nc_oc=AdrmDDlKTclY28mQJJucSoIMR8crnT0Y28t_6iFyY0MQNecVER6MZPgBLh2bc0pYuE8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxN34ysWqokJC2lZ5jp5bQfnCWb0kH8jma3vBxO2k3_Ag&oe=69C5369D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "e
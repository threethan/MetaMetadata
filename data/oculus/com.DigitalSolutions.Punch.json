IqHGbfY1fpoI1LT0LZwGb88QnYn6X1rv5AY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CmAlDZDorApm-A1rUUM74qv69u5PSSEdYUyb9N-IhtA&oe=6A453284"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bo_JfHsgiyAQ7kNvwGFbn3y&_nc_oc=Adq_PEUtKMeDj5sPJ80xNaTO1JzyqwQVbNJiM6_9JyD2F0L05SpMrfYo9wkDNQ4DP0s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9d0cTopnQSASj_HZO6Wg4J-YMNA-QgShF4T9Bp-PR9Q&oe=6A450F89"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR9kbY6Bkq4Q7kNvwGAX5Ps&_nc_oc=AdrDm-XVcm97jsjOmcPb3q6duDwesIQK_z3C7onkg7X7amjFMCGZ9AWmZrGn0e6iow0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wy4EupW3mNMLMV8qK2P1TInpbHvQaQ8uzo7TD9Bg_HQ&oe=6A450926"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvSYiK85OFgQ7kNvwHVIKRL&_nc_oc=AdpO-a_klrg3PPmT_wsmqjHbEsSBIzpq03q19BvKtgXfIJzrjNJVGj5-tcJYXtAzgQE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BwPHwJFExyPK1DYdR5MZIs75KMgkNprd13mPnA9EcXw&oe=6A450D14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5f5E7PacTEQ7kNvwEeYdtG&_nc_oc=AdrfRMk_LgvXlU_fSRc38SJ50TBGWKJg4MsXubYrKSwG6yYBZLmkCpKKo1ZQOTVnnvg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vzmU_CMYVvXcfv5hc1zuNGhTduSchSSNsIlxaTmdgrg&oe=6A45181D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
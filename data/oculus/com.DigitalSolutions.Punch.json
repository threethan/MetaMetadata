GoT-dWU7ziiUgMDU-OBfudGMRd2DVwtMhYqZHg&oe=69C275C4"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IKNBPtfp5gQ7kNvwHrKLkP&_nc_oc=AdpQKMHksNJXSRWGTeg4Wf7dXUqkAuPf1FBcQURvcMm86zV2_zRC5W1fGnOGVyUARd4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNDR2_BBeChwVYLJsWtJ5e2s7EoClPp7jEBR-wYdHhAQ&oe=69C28B09"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYDkyqes-sQQ7kNvwHh8Lzr&_nc_oc=AdrBGsBa0rcy0nf0WQDJ_wcSCkhtxLVjlbpDU8RhJUA3b47keWApWEvnqo2Hhs-V5vA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbwoImfRqVyw4jeoJ1l-HW-0aq_fKYaTHjhqL1ra3Izg&oe=69C284A6"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9EiuPhCGcIQ7kNvwFi7k_O&_nc_oc=AdphO5UTxnFlOpjHv-OSJEf4hAQCji42KMhQE0-kuvIQKUyHAr4BQiAl-lOuN6fnPW8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwLTxSShUOis1QR6FL_snMNQv73QHWDnH-B-87V8777cQ&oe=69C28894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJfr6GcLeI8Q7kNvwEHV-aB&_nc_oc=Adr16V_9yLgUt1Bo2QcZ8DsmdCQQqM1VwOXZyifXwXHWANgWzQ4VdRFUqy7vUffuGe8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRQjSlXeTUYd46mneOQVCMY9_QGFKg8ld2iwl9N3IHpg&oe=69C2939D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "e
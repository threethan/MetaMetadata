M0E_F8oEmx7aXwC6d7M74bb65rusrA3_9AY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mm5l8yp-r7s_-TNRt9yYsE3kLKiOzbvEzN9ebEFQWAQ&oe=6A316C04"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRFSk8SkwKIQ7kNvwGy9ARI&_nc_oc=Ado_mzZiF0OQ0BfO2eeckQ9MZwVQb8sIFjPtBEeJGhKLBn8fiWQ5VqCkDMCjpaslN1M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eY1wam06953w1MM7ulHSMVd4so1Fb8GQfWPuJa1fQsQ&oe=6A314909"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AqrywtzHMI4Q7kNvwGx_Oxj&_nc_oc=AdrJ0POo2snHtggpeBf3nyXBcD_3mjPVvqgTHJz0TH9qmU3Wu5MNoeNgBr38fRa8WsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SCoX2kYTuap2bGz2Jx_T5pDIkJe-dG3r-9iUNV-IV6w&oe=6A3142A6"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjQqdJ6AM30Q7kNvwFUg8Dv&_nc_oc=AdrWAvddd34k_Z0s_aVMcUEqBwsW8Tb1W77y6xIX4subJxA1cJgG0UUQ2HiiieBYn_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aOOfxvZ1nuI0q8S0vihDqJITHqW4mwbcnjGx8aUMTww&oe=6A314694"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5NbGKmYKEkQ7kNvwFbp4Wz&_nc_oc=AdpNlE9h4H6L2Wq0SyyBT1d6IxlWL2VA7gv753hfBWMbEo25qiDys5_JJpaRdCoU1Pc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Uz5Aac649J7DJvBAoRiCnBMWldrQCeK5EaEodU8J_jQ&oe=6A31519D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES
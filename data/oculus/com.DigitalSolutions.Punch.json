ng", "id": "1307234017850357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNmHsjFy-p0Q7kNvwGnWmHb&_nc_oc=AdlnVDSMd-my6nWyPk94H1w2IpgW3gjenLPE16HABegAQmYnlxyl3GixxsETH2_JEZk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afysw61LpJfSjNKEO6xBujzcZnqcIQsJ37N8y7crRuZZ2w&oe=69BBF389"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psW5KJQd8vgQ7kNvwGvbUQu&_nc_oc=AdnivQKMrr5b510WanxX6EuuUNGczMPRN29QcK0t8vSfGZZ3k2Rij5sLtFuFrCEv76c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyI9ZYZNT0VY7s0B5bGBzpkMVmSvs3J3xx-5IUPI-LCVQ&oe=69BBED26"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfej-M8_B6AQ7kNvwHbyBoy&_nc_oc=AdmAG7S3-GkjONS4cXOf9iQF_AbnxB9FkTGHjkcIoHyZEPnSYIRqMtjc6m46ZtnAf3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXcaX-0Tm6ybJoFAsL2YDpzxHfxS1JlmX1nTfeTMb0qw&oe=69BBF114"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0PIICzMOGAQ7kNvwEdRw1p&_nc_oc=AdmRtu9E5U5lVtyvWIcTYkaEzZK49qM5rkDqhdcSq_yoJoU90GQXCHYdLFy3sQmEwMg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzXRuQPah39VrVOlFZiLOOLnBlwX2kehDNpK2sJRekb4A&oe=69BBFC1D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
ng", "id": "1307234017850357", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnXsxzwZD4sQ7kNvwE6w4Sw&_nc_oc=Adn2if_mprUOMQ_-EnW3PsQtB2gA6Te1dTuQMxgjdCDtQF_G0pp7wFVJQHSsPew_xjs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzn1B1Gg5A3E-8PTM2I6nd4GRmOY85TaD8WSMSOFhL6eA&oe=69B6AD89"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geYP4jUKeAYQ7kNvwFzw0AY&_nc_oc=AdlX_1oOmAobYzSNF6DYyTGa8gOI98Yj5J4UTkg9gEd24Cx2ZXv1gRaYzOJs_NDrs7U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMDN2lgb5WnbE_pxBarwZ5eX9ptIFORtAErnzgb64b5g&oe=69B6A726"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDmx9bi7aSQQ7kNvwH6tlPu&_nc_oc=AdlZAhIfyR-DeseIXuV4llh0EevwWo97syaq8VxjvIxq92oQ3-26May5WQZTHBAKxNI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuWt9dqgxGBWLgjOoiZ1VmkDkx7T2UXJnBBFJaxfsUTA&oe=69B6AB14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCSyO2ZrJ5AQ7kNvwGG57d3&_nc_oc=AdlJFAF1n-Zjpo-teeRIhvTC8Xq7a6Nnxwgn4JC2QWW0R56_nI-YQhREK4J5Rm4sfAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyB7qbYim2oRSAs-vrOBwWkIUoDOnmsaI635WUVna1Vgw&oe=69B6B61D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_
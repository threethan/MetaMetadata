tEW7O6zXCrUVfxUPKHjJl0Ss5Eg-FbL68sQ_kw&oe=69ECA5C4"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kviEgysP350Q7kNvwG8oroF&_nc_oc=AdqAOOOfM_AO1DGLyHAXCJs26QGcfY2BE3-__vNApmV_qAcLlbZm4-UTr799kL0kIb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bxAkdXEygDeuTbaKC_CUUu1TRKf5pnzmAIzXYCS4BTQ&oe=69ECBB09"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iddfe-0jfJEQ7kNvwE2eQnr&_nc_oc=AdoWX_Wnj6zxsamHZnVr5bOahM8dfJ9jtEqK7oyq2ITU7C1YTSdpXMc3-Jq8VtW9pjQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20i9hnnwLoxt25v2bI9HMN_2aDwTxfuI50JEGw42bE1g&oe=69ECB4A6"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z15FPidOuYYQ7kNvwFk_icI&_nc_oc=Adqa_PPCqRaU17nz54SyTMAoHQLiqDTk_nuVaVMSywmg_Voj23w3vK6E189JqaDuTFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af130qGHJZhGY-usQYZHjism8Oz-XpclasSIdMOObvcmAA&oe=69ECB894"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tey4-V3W3VgQ7kNvwE-o6wu&_nc_oc=Ado7N6ZvIc5wtw3Evw92II1xu12D6_eZVBx4hzH5z9xmsu33gQ3TsuB2eCn1GyZFJyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0uFkEpQ_rjUTfZRDZoIkE4YSSiHdhkgqAPl82oXUvLkw&oe=69ECC39D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "e
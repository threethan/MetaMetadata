gogo.png", "id": "829481226435378", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827071_829481229768711_7920571266177043091_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ii4fGGUTmQQ7kNvwFXv914&_nc_oc=Adkq28K3Fy19jKRLGD-5oPaViQX64S9M3-BAjpm7LsNQYg_YqvRyoduGApMrsaJiwYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvn6hTSJwHqrQINyAAjiM6XoyyKKRFJw8ZynTWSgd-f9g&oe=699C59FB"}, {"file_name": "Portrait_Cover.png", "id": "809849865093960", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818925_809849868427293_5512702468765257090_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2nmW9Eyc48Q7kNvwEcJ-fv&_nc_oc=AdlrZVOgyL0kHPqkp7Z5MnZnVTDxgHFBP7kCB7l9qrbsV7jspuAG1nhbRAWnhq4C3LY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsv4jzvUe2kRmGqyO9YMb1ZeEbN1Sk70xd61jYbq9CUQA&oe=699C6673"}]}, "id": "1486585035956041", "locale": "en_US", "screenshots": [{"file_name": "circus.png", "id": "1464957134788898", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618297_1464957141455564_4000681213640934986_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QAdFGoUTIAgQ7kNvwELj5uC&_nc_oc=AdkqQCvKkLASdJqwyajtbsEo2BLvsQpJRNmsfzgE0rFLVqNuL8CUgELseAN5ENtMnck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuOqmAeP7F6kLEMzM8GcXpsgBgXvKInxlN1lZbMG7K3NQ&oe=699C6502"}, {"file_name": "Alien.png", "id": "742553942131231", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618251_742553945464564_64000037353132020_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFVxAOeMSO4Q7kNvwGvCwHl&_nc_oc=Adn2NwVKS3fveuldUTzTvkpc6KdyXTAKiUyAPi9-eOjZ4dh3_suBRqnpLIGwlMXHEco&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afses4NGaZp85MVzIo0rsM1Mc0tmXAx9-YchaXbP6qIzuw&oe=699C3A44"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWuenmPEpz8Q7kNvwEPWQ4b&_nc_oc=AdlPWkBV1Y4uTkShYkal8pWQBi1o3A9qhfP2PJ2jHTl5XnYUJIizWZh93fbyCt2XRvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftmHsKLt_hRWQhaIG-eITzd_SKC6EcynutsduttBscbyQ&oe=699C4F89"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4cT6oA4O3cQ7kNvwHSR4vs&_nc_oc=AdnbGqqLjSUGhIPK0DArr5UkvKIEB0kKkIfZet9egAEtPxpmZ-j8dpIyDKpft11xdIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvD_SSD4iIr0roC-5OrtOvDxwJgGgR8TSrXjuNMXP6qQw&oe=699C4926"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-yPvFmNGxZgQ7kNvwHcLI7B&_nc_oc=Adluam2c8nQFk9Q4O-Bqn6V1Vxw1yQ1MxgmMTf-9grsfmghjtOD2Af0sikoezUaCKP0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfubQr_vCJu3E9cTffzdqJer6EYBbCRfrOk_cx1CS9V3Iw&oe=699C4D14"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RKmY0kMfVYQ7kNvwEpsyUU&_nc_oc=Admm17Mvqh3BWOGSYUkMp9avzuxtm6ZJJCit3V60Gkj5emHT_dWzgcWEccJf3CWeiG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft30ZLJG3ar6mMKj6wDlagZt2x_0QghSLv5R4bjzItbRg&oe=699C581D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_device
Z2twteutUVO38T1vg7NkXApyJB8B0E9-8vhn_w&oe=69C7BBC4"}, {"file_name": "Human.png", "id": "1307234017850357", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499622285_1307234021183690_6637124464378073832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0WFxlSR4BYQ7kNvwGgvhuj&_nc_oc=Adr4WXtW6yWGPsCpsravhDzuZbZ74nbmMJ7hocpZKx3ozhcgU5YXMOJS8BYmD3nJGwQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEubWLnoDkoKhqdsZRybWWNh2_DmfbTfac7Kt8GcC0mQ&oe=69C7D109"}, {"file_name": "Vampire.png", "id": "1236324461869531", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620921_1236324465202864_3562161874881016074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOdvXWZ2PAUQ7kNvwHRf66V&_nc_oc=AdopgyBxkX_zgiTV_KFk1HHuxJj3QCF5RwW4fEySZbPnIppv7kaDSgHoH4rdh7XrX1Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfytxuvSgV5UsasC-vNMiv6XSsNpPJc0kVBMNBSo2AJFHA&oe=69C7CAA6"}, {"file_name": "Zombie.png", "id": "842494448299524", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491821954_842494451632857_7253738921866676091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xx4gmXym8tQQ7kNvwGKa-5a&_nc_oc=AdrWPrUU5_GFjrBkk7WaAIsAqGSIzB2uxZI6lN6HhY59ml20rIJYUO5Ff2A5RGcsFIE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxM0LgcIcf3KMOersqrFXxtO_FTMVDFcY4c2JQoceXjOQ&oe=69C7CE94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landspace.png", "id": "1316553903545444", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820559_1316553906878777_2929707450559990758_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2UZr7ngfj8Q7kNvwG_h0LS&_nc_oc=AdpEV4Dxheh5Q5GGzBJ3SNPuy5nGefxi4W8Jdl8B_19-1c9WNELOX06VJoNOd1wIdOM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIlfZC2I5kyju3vBa_MlQNzhdbXiJ0b2irsMNJkXhhUw&oe=69C7D99D"}, "display_name": "Punch", "keywords": [], "long_description": "Get ready for a spine-chilling, adrenaline-pumping VR experience on Halloween! Punch game drops you into a dark, haunted arena filled with creepy floating heads that are just begging to be punched. Armed with only your fists and lightning-fast reflexes, you\u2019ll face off against a terrifying variety of foes \u2014 grotesque zombies, bloodthirsty vampires, sinister clowns, and eerie human faces twisted with evil.\n\nEach head moves differently \u2014 some lunge, some dodge, and some even taunt you before they strike! Time your punches, unleash powerful combos, and keep your guard up as the intensity rises with every wave. The more you play, the faster and creepier it gets.\n\nWith immersive VR visuals, creepy sound effects, and atmospheric Halloween lighting, Punch delivers a mix of horror and hilarity that keeps your heart racing and your hands swinging. Whether you\u2019re competing for a high score or just blowing off steam in the spookiest way possible, this game guarantees endless fun and frightful satisfaction.\n\nPerfect for Halloween parties, horror fans, or anyone who loves to punch creepy things in VR \u2014 step up, throw your best shot, and survive the night!", "short_description": "Step into the ultimate Halloween VR showdown! Smash, punch, and dodge your way through waves of creepy floating heads \u2014 zombies, vampires, clowns, and twisted humans. Each punch sends heads flying in a burst of eerie effects and laughter. Fast, fun, and fright-filled \u2014 test your reflexes and survive the haunted onslaught!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://www.digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "e
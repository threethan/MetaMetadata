D-6dZY9nqnNGgPX1S5swe-eTCJsbe2Oi3ZLg&oe=69A451A4"}, "display_name": "Pollynexa", "keywords": [], "long_description": "Pollynexa is an exciting Virtual Reality (VR) game in which a pollinator like a Bee or Bird comes toward the flower in the player\u2019s hands.  Watch it player \u2013 you have to AVOID the pollination by getting your hands out on time before the bee or bird gets you !\n\nA player has three chances to avoid the pollination within 30 seconds.  If the player is successful, the game goes to the next level of difficulty.  You have to play it to feel the level of difficulties aka challenges.\n", "short_description": "Pollynexa is an exciting Virtual Reality (VR) game in which a pollinator like a Bee or Bird comes toward the flower in the player\u2019s hands.  Watch it player \u2013 you have to AVOID the pollination by getting your hands out on time before the bee or bird gets you !"}]}, "developer_name": null, "developer_privacy_policy_url": "https://pollynexa.com/privacy-policy/", "developer_terms_of_service_url": "https://pollynexa.com/terms-of-use/", "publisher_name": "Not Applicable", "support_website_url": null, "website_url": "https://pollynexa.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "454841770075720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.o
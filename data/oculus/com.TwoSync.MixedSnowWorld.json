771-25/38974663_299048693224576_6811708882832108729_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-Q3M12rSjAQ7kNvwEb1meU&_nc_oc=Adokj08EYErVgznAfgKZ_TcfS3Z7Qgg8sxGGIyseEAlfkn2zuuEaLNUepPFkZqbusGY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLij9T0Gch1uGH1uyn0dKY33vuFhfBCWQle7j87FH-4fA&oe=6AAE83AA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mixed Snow Worlds", "keywords": [], "long_description": "Your Home - Enchantingly Frozen. Welcome to \"Mixed Snow Worlds,\" an innovative auto-adaptive Mixed Reality game that transforms your home into a magical icy realm! It's all up to you: Armed with a trusty snow cannon and a special flashlight that unveils the hidden virtual world, you embark on an enchanting journey to protect your home. Adorable yet mischievous monsters pop through walls, eager to freeze everything with their chilly touch. As you navigate through your familiar yet transformed space, every corner brims with excitement and icy surprises.\n\nThe application adapts magically to your home's layout. Move freely in your space, interacting with your objects in a completely virtual world. Join forces with friends in a unique collaborative experience. Formulate strategies and fight side by side, enhancing your defense against the icy invasion. It's time to turn your world into a snowy playground!\n\nKey Features:\n- Auto-Adaptive Mixed Reality transforms your living space into a virtual ice battleground with the power of 2Sync SDK.\n- Explore an immersive ice world within the comfort of your home.\n- Defend against dimension-hopping enemies with your snow cannon and flashlight.\n- Engage in a captivating storyline, evolving from home protection to self-defense.\n- Seamlessly transition between Mixed Reality and full immersion.\n- Collaborate in location-based co-op gameplay.", "short_description": "Your Home - Enchantingly Frozen. Welcome to \"Mixed Snow Worlds,\" an innovative auto-adaptive Mixed Reality game that transforms your home into a magical icy realm! It's all up to you: Armed with a trusty snow cannon and a special flashlight that unveils the hidden virtual world, you embark on an enchanting journey to protect your home. Adorable yet mischievous monsters pop through walls, eager to freeze everything with their chilly touch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://2sync.io/housedefender-info/", "developer_terms_of_service_url": "https://2sync.io/housedefender-info/", "publisher_name": "2Sync", "support_website_url": null, "website_url": "https://2sync.io/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "185738864131567"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "7445378198881116"}]}, "baseline_offer": {"id": "7445378198881116"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1715169600, "status": "PUBLISHED", "id": "7445378198881116"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8754782287956272", "version": "1.3"}, "id": "2381290652042691", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Appl
25_02_19T14_43_32_000Z.png", "id": "9737612239606565", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391847_9737612256273230_4546458706342792660_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lBH8_zI-r8Q7kNvwGBPVTU&_nc_oc=AdpqJs5VC7TsE9gYZCkVpI7Tj6RfbGPFl0Uxix57F2XLv7bb9oibQlt3NBVYFE39wvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11gfS8TEcMsA1l_ugbL8KVZ2s0q7Axv3vYd_uF2WKXgw&oe=69D26EE6"}, {"file_name": "testStore.png", "id": "1179241860526032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473397150_1179241887192696_9063424579328925995_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXkpEz7LnuIQ7kNvwFVNvx1&_nc_oc=AdrPuGRRmkLVRC03N_PUpE-CSUTbK7A_4Alg3ijaHAvGMp5N7d5QnbYq7pFmNIa9Gqw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vbViT1BCrw_ccGzd3TxfGUGkHXpYYbA0dAkSTs5ETBA&oe=69D270CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1136035814969398", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391797_1136035818302731_5387050525264737201_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-refTEE8H8UQ7kNvwFbDJiH&_nc_oc=Adr5SEE1AlV3Mx362ASS-U05l3Ecd5H7juVEQn54o5E2EaDL12W8OeX1gthggbLfX-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sPhvXWdfqR_aoLUxz7RI38uoV5whCRXXCZCFpJZzj9w&oe=69D25CC7"}, "display_name": "Watermelon XR", "keywords": ["Watermelon", "XR", "Mixed", "Reality", "Game"], "long_description": "Bring the fun to your real-world environment with Watermelon XR, the ultimate Mixed Reality fruit-merging strategy puzzle game for Meta Quest headsets!\n\nUse hand tracking or controllers to drop, grab, and merge fruits in your own space. Watch as physics-driven fruits roll, bounce, and combine into bigger ones, until you create the ultimate watermelon! The better your strategy, the higher your score.\n\nImmerse yourself in a unique, reality-blending gameplay experience where your surroundings become the play area. Can you master the art of fruit fusion and dominate the leaderboard?\n\n\u2705 Mixed Reality Gameplay \u2013 Merge fruits in your own environment.\n\u2705 Hand Tracking & Controllers \u2013 Play the way you want!\n\u2705 Physics-Based Fun \u2013 Fruits bounce, roll, and merge dynamically.\n\u2705 Addictive & Relaxing \u2013 Easy to pick up, hard to put down.", "short_description": "Watermelon XR is the ultimate Mixed Reality fruit-merging puzzle game for Meta Quest!\n\nPlay with hand tracking or controllers as you drop and merge fruits in your real-world space.\n\nStrategically combine fruits to create the biggest watermelon while enjoying immersive physics and fun gameplay.\n\nChallenge yourself, beat high scores, and experience Suika-style merging like never before\u2014in your own surroundings!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/a073853d-9c30-40c7-8673-6dcdf0480149", "developer_terms_of_service_url": null, "publisher_name": "Banana", "support_website_url": null, "website_url": "https://www.youtube.com/watch?v=9Z7Qni4Grok", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9159442470804497"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "2443326082783640"}, {"status": "PUBLISHED", "id":
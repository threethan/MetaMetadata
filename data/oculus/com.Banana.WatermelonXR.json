546458706342792660_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6mCjjQqFg8Q7kNvwHUBZBT&_nc_oc=AdnmOWDVKdr013zVyWdNtEdNGjRDOpy30LKVMfvV9PGAuFpCVwqW2ExmLCLDO_vQ-ug&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuUIv82G7jtH0bZZEtesfZoMS3K4Tt7QvDrpszaW0Wdmw&oe=699B0FE6"}, {"file_name": "testStore.png", "id": "1179241860526032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473397150_1179241887192696_9063424579328925995_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvZlAM5wcrAQ7kNvwGe5Waj&_nc_oc=AdlQZh_0lAIg4w8sqIVxW4De0YFE1DF2XaI_I2fLfeL4J20_xjNSNLZGeRe4_kqw0hg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuIxz7Qttb6Wcdl_9JH4YBlR3UL8aZfz-6CuMXccyvrAg&oe=699B11CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1136035814969398", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391797_1136035818302731_5387050525264737201_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RLP4sOt3IbMQ7kNvwGbazb0&_nc_oc=AdnrOPkOmRePHki5_37ZHq1zN4DuZ2qbT7Qbs_4kPEBe4EKHYf_A7im0Bq-YMyudeK4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuoGWq1ZENXNP8zy1xVKmtiAICpSv3b7NzKGbpSE3nQ0Q&oe=699AFDC7"}, "display_name": "Watermelon XR", "keywords": ["Watermelon", "XR", "Mixed", "Reality", "Game"], "long_description": "Bring the fun to your real-world environment with Watermelon XR, the ultimate Mixed Reality fruit-merging strategy puzzle game for Meta Quest headsets!\n\nUse hand tracking or controllers to drop, grab, and merge fruits in your own space. Watch as physics-driven fruits roll, bounce, and combine into bigger ones, until you create the ultimate watermelon! The better your strategy, the higher your score.\n\nImmerse yourself in a unique, reality-blending gameplay experience where your surroundings become the play area. Can you master the art of fruit fusion and dominate the leaderboard?\n\n\u2705 Mixed Reality Gameplay \u2013 Merge fruits in your own environment.\n\u2705 Hand Tracking & Controllers \u2013 Play the way you want!\n\u2705 Physics-Based Fun \u2013 Fruits bounce, roll, and merge dynamically.\n\u2705 Addictive & Relaxing \u2013 Easy to pick up, hard to put down.", "short_description": "Watermelon XR is the ultimate Mixed Reality fruit-merging puzzle game for Meta Quest!\n\nPlay with hand tracking or controllers as you drop and merge fruits in your real-world space.\n\nStrategically combine fruits to create the biggest watermelon while enjoying immersive physics and fun gameplay.\n\nChallenge yourself, beat high scores, and experience Suika-style merging like never before\u2014in your own surroundings!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/a073853d-9c30-40c7-8673-6dcdf0480149", "developer_terms_of_service_url": null, "publisher_name": "Banana", "support_website_url": null, "website_url": "https://www.youtube.com/watch?v=9Z7Qni4Grok", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "275629210202852"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9159442470804497"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1341425388006778"}, {"status": "PUBLISHED", "id": "1218079533634764"}, {"status": "PUBLISHED", "id": "3874627939494259"}, {"status": "PUBLISHED", "id": "828495663011516"}, {"status": "PUBLISHED", "id": "811510357877170"}, {"status"
_name": "com.oculus.vrshell-20250305-201637_2560x1440.png", "id": "1170047507988227", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391845_1170047514654893_6390040409339429783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbgk2hVzdUgQ7kNvwGns0sb&_nc_oc=AdraHcwCIs_JGV2W6iMqBBaSG0ceHwDVO7SggFmAGmVsSels4-COB1G-9XBEdrJfdAA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc7w4x0Cd-BKtMGRpt8m4eE0CfzNQQI_AFEtpH_Foqfw&oe=6ADF6471"}, {"file_name": "com.oculus.vrshell-20250305-195520_2560x1440.png", "id": "1206442077762851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391836_1206442081096184_3250412453376422396_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtZK9tsBGG8Q7kNvwEwPcUK&_nc_oc=Adqid7RHJw1AGnWOl8sMis1sx-Vqw1XB0xG7Qe9thg-Qdd6zWm1P6gPrbxyaomv4TgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9MSujYns78EwHIqXSyIV_rR_EWvxxB8mZH3pnhOkKKw&oe=6ADF5F6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560_1440px.png", "id": "1637239166998413", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391781_1637239170331746_3404903030809642688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gz0L_Vy-nNcQ7kNvwFAeVT4&_nc_oc=AdpkZJAg6-1X3VBZILUHJnw2vzrobg_S7WQzIyncbVBNVlNu4_muRDw4r1vR6V1SAFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkrJ4HdvlclmM6u7xwAYG7t-TvTGOltsZglGsFY8vYag&oe=6ADF73EF"}, "display_name": "Parallax", "keywords": ["travel", "photo", "spatial", "tourism", "volumetric"], "long_description": "Immerse yourself into volumetric six-degree-of-freedom 3D photographs. This app contains thousands of such photographs taken around the World. \nVisit Scottish Highlands, bustling Indian cities, Thai islands, Iceland Ice Caves, Zanzibar beaches, Caucasian mountain passes, and many more places! Explore thousands of photographs by browsing thematic collections, or simply relax and travel through the feed containing photographs in a randomized order. \n\nEach photograph is created from either a single stereo VR camera shot or a single smartphone shot using the AI-driven technology developed by Cinemersive Labs. Parallax delivers unprecedented level of volumetric realism unmatched by traditional VR stereo-photographs.", "short_description": "Immerse yourself into volumetric six-degree-of-freedom 3D photographs. This app contains thousands of such photographs captured around the World. Travel to India, Scotland, Iceland, Thailand, Tanzania, Israel, Georgia, Armenia, and many more. Enjoy unprecedented level of volumetric realism unmatched by traditional VR stereo-photographs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cinemersivelabs.com/privacy-policy-for-parallax-app", "developer_terms_of_service_url": null, "publisher_name": "Cinemersive Labs", "support_website_url": null, "website_url": "https://www.cinemersivelabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8502792283156345"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "657665786658358"}]}, "baseline_offer": {"id": "657665786658358"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741955340, "status": "PUBLISHED", "id": "657665786658358"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "bina
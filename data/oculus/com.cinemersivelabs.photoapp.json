_name": "com.oculus.vrshell-20250305-201637_2560x1440.png", "id": "1170047507988227", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391845_1170047514654893_6390040409339429783_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clP-PLCeeo4Q7kNvwFXUm-c&_nc_oc=Adr7SJBBvYWk0p25nH1IZaEJ0bC9k9eO-c9o4qnYL9-0kaqlkySst5wJ7nnPvIUXpa8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gFo_lhhDrg536l3PB_7PinON8YFJWjcd1KkNLgjckeg&oe=6A2C1871"}, {"file_name": "com.oculus.vrshell-20250305-195520_2560x1440.png", "id": "1206442077762851", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391836_1206442081096184_3250412453376422396_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1q7HAQOE9cQ7kNvwHNlYd0&_nc_oc=Adreqtok85AXYnJjAXnqojbW-o_SvglP62QjzZn49Qx6FwA_IQJrmbaCJnu-VvwgFZ8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__KonNmPBkWUnD26wNkOjAfDJ76hhAt9WP69hD8MKWrw&oe=6A2C136A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_art_2560_1440px.png", "id": "1637239166998413", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391781_1637239170331746_3404903030809642688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lBD-8qjEQYQ7kNvwH7IbrL&_nc_oc=AdruYEwL-cxv55cLCIj15qDQ9fpZPQIKO1_-CjZQ4fIbYas5-0YHtQVTJwXuyXrGIJ8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4Q8qUl7yI0s3YgV3xDBNBZRUdR944NXcaCzRhxsXzUA&oe=6A2C27EF"}, "display_name": "Parallax", "keywords": ["travel", "photo", "spatial", "tourism", "volumetric"], "long_description": "Immerse yourself into volumetric six-degree-of-freedom 3D photographs. This app contains thousands of such photographs taken around the World. \nVisit Scottish Highlands, bustling Indian cities, Thai islands, Iceland Ice Caves, Zanzibar beaches, Caucasian mountain passes, and many more places! Explore thousands of photographs by browsing thematic collections, or simply relax and travel through the feed containing photographs in a randomized order. \n\nEach photograph is created from either a single stereo VR camera shot or a single smartphone shot using the AI-driven technology developed by Cinemersive Labs. Parallax delivers unprecedented level of volumetric realism unmatched by traditional VR stereo-photographs.", "short_description": "Immerse yourself into volumetric six-degree-of-freedom 3D photographs. This app contains thousands of such photographs captured around the World. Travel to India, Scotland, Iceland, Thailand, Tanzania, Israel, Georgia, Armenia, and many more. Enjoy unprecedented level of volumetric realism unmatched by traditional VR stereo-photographs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cinemersivelabs.com/privacy-policy-for-parallax-app", "developer_terms_of_service_url": null, "publisher_name": "Cinemersive Labs", "support_website_url": null, "website_url": "https://www.cinemersivelabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8502792283156345"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "657665786658358"}]}, "baseline_offer": {"id": "657665786658358"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741955340, "status": "PUBLISHED", "id": "657665786658358"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "bina
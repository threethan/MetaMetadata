1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXC-y9Nv7DSdIHnlc158liIeAqFF9xl3ZoxpkWP9EmJfg&oe=6B103B6F"}, "display_name": "Parallax", "keywords": ["travel", "photo", "spatial", "volumetric", "world"], "long_description": "Immerse yourself into volumetric six-degrees-of-freedom 3D photographs. This app contains thousands of such photographs taken around the World. \nVisit Scottish Highlands, bustling Indian cities, Italian carnivals, Thai islands, Iceland Ice Caves, Zanzibar beaches, Caucasian mountain passes, and many more places!\n\nEach photograph is created from either a single stereo VR camera shot or a single smartphone shot using the AI-driven technology developed by Cinemersive Labs. Parallax delivers unprecedented level of volumetric realism for sinlge-shot captures, unmatched by traditional VR stereo-photographs.", "short_description": "Immerse yourself into volumetric six-degrees-of-freedom 3D photographs. This app contains thousands of such photographs captured around the World. Travel to India, Italy, Scotland, Iceland, Thailand, Tanzania, Israel, Georgia, Armenia, and many more. Enjoy volumetric realism unmatched by traditional VR stereo-photographs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cinemersivelabs.com/privacy-policy-for-parallax-app", "developer_terms_of_service_url": null, "publisher_name": "Cinemersive Labs", "support_website_url": null, "website_url": "https://www.cinemersivelabs.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
content-sjc6-1.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB7B3jtPtmoQ7kNvwFkdAZP&_nc_oc=AdntttgnruJoJoSa597K5b4iWt47B7g_IK2Kva8lil8NXUXmjNQYjcYoskTLhWwfWsQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw97eMSNpf7tqs-HrDqzN7hb-yF6VKipBqEtzV8Y9xR6g&oe=69B69685"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIM
wzqOUO5g9YQ7kNvwHz42wO&_nc_oc=Adp2dWCGhe0I_LJ-cjbc1G1Sky-RKhBS8OItgSiVNqutOiIIArfrioRGhnb1175Qe-o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3g_JHZaOX52Zqwycke6cnbCS3y1p0XwaAYM8RxjIVpg&oe=69C7C3F0"}, {"file_name": "oculusShot (12).png", "id": "4060036160762301", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982483_4060036170762300_9092854240462410101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0TLz4wL5W4Q7kNvwHOCgdS&_nc_oc=AdoXqICGRh39DS8SC6h2Cr7mvY1kHGLPKCFQa7hwiqKdWjSLnRowaY3v3ut6Hd0aJ_A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBHCZvxKmYD_pjg4psDDEmxK-pgYTitPgod7I5X5hwvw&oe=69C7D743"}, {"file_name": "oculusShot (10).png", "id": "156395513139515", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39001709_156395516472848_2336230638676150599_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Stk-uh9GyjsQ7kNvwFFn8RY&_nc_oc=Adp7K8GBp4_j6oBYqqIy6bmgtSbH7pM1GF8FwEvJ1DR_wbw6D12rMoi2c2ASKq0v_tI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2mA8gCEm2GBf-6LuqyPNjRUmrS6vnOJS1S1H9OARo0A&oe=69C7E6B4"}, {"file_name": "oculusShot (11).png", "id": "1112707089552805", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rmhM_HRgRnYQ7kNvwH1IFjz&_nc_oc=AdprX5M_0kQlF-CnlGxxOu3WIgt83F3OLU9Zn8qEkabhQ9VAzGfSxWchsA2Whn6uHf0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpRkMl20dk-VLQs0pk2p0bxMn_o2m_ymW6CVTh5F96GA&oe=69C7BA05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RELAXATION_MEDITATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "984225675636794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982448_519845085792778_7228462893574455273_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NKShcZlgWUsQ7kNvwECogMl&_nc_oc=AdrNEG5ip-tnVjhdcG31IgNMotJbWglF_mpR_GNfyDUPfzqhwjyIn7sIhQXV8nDgpQY&_nc_zt=3&_nc_ht=scontent-fr
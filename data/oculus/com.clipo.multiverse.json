0tDc5OjXgAQ7kNvwF-zN6H&_nc_oc=AdosWhiPCridKLA_j8HN37CEyA_9AoKawBa7GqzhP-dW-_mzXL8y7Nxrv0H-NAoKpbw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaJGyVKjbQ4UCN1YsnnjJBddlNHkFp94PcOk8dspPIQA&oe=6A7B0FF0"}, {"file_name": "oculusShot (12).png", "id": "4060036160762301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982483_4060036170762300_9092854240462410101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbpXEMcGxSMQ7kNvwEMNJ1-&_nc_oc=AdqRlKIkgFhzfkAQ3kbq5lvxqjmwrk7ZbG78PTI8Qjn6M9ES8v9-uda5OYH6sgg85GI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmf1CIqlg7WzggARLrvwJUNcfSJ3Fa8Nm7m28QgE_Gww&oe=6A7B2343"}, {"file_name": "oculusShot (10).png", "id": "156395513139515", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001709_156395516472848_2336230638676150599_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRAml11tP2kQ7kNvwFq7lWl&_nc_oc=Adqd8v7gW76KrBkod-r4rl6pGwdHABYBJQttF94EFHJghbHEG_WbqYsc9sY4KU8_ub0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFTupNObwR1lDJWESo8nG_a5JjOFrq7lgMNS20QFiFvg&oe=6A7B32B4"}, {"file_name": "oculusShot (11).png", "id": "1112707089552805", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=740CFGYNck4Q7kNvwFqcTsz&_nc_oc=AdpX82shjpxmE1ATg5_RkbcyY7lhvy0LjFQSUxmV_An2ubOm2GVV4Qfg_qDwvSqkYLQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1zgS_00rh7jFGSEmzwZi0rYFebNW2GoXaKR22HvMQ7Q&oe=6A7B3E45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RELAXATION_MEDITATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "984225675636794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982448_519845085792778_7228462893574455273_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqoJ4xri5_cQ7kNvwGy_umk&_nc_oc=Adpx983E9HXYANoIDYKG5dGD-1xJ56GbiwdN7qIC6_mUvPpuSC8KNu_bYzXX1HAlPQE&_nc_zt=3&_nc_ht=scontent-or
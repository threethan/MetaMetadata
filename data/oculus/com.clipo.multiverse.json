-925_sKXLsQ7kNvwHJhDPo&_nc_oc=Adp4synfYbJ2E-elsDmDqUQ3S-Dvr9h6E7hiPU25dvihVaYnsNbo2lAkLwk6te2Z8IE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2O0U4PQ22c4AtZrJjrboxryFhdJZZk4QoN_92bo_00w&oe=6AAC0FB0"}, {"file_name": "oculusShot (12).png", "id": "4060036160762301", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982483_4060036170762300_9092854240462410101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wE_S9L6XfXQQ7kNvwHosFcF&_nc_oc=AdrPPaVcBFCTuPFt1sXzzLoH80EI23WGRpw3JGPdnIqspmsZjQqY0FwD_fCJpgHTWLo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0iTh6erLIHMLs13H7h4XuU17GYkMd-BgEiqJE6MRXpg&oe=6AABEAC3"}, {"file_name": "oculusShot (10).png", "id": "156395513139515", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001709_156395516472848_2336230638676150599_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3mjYq_MJ4cQ7kNvwHTECL2&_nc_oc=AdrmUITpFSeY294_cunxu46ngViuI0n7rR6knK_gQ7B8S8erk9-h34g9oAiMnDJDdLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNKAXofAPThin_rt4lfQtMMo1SjFnIgJcZbT0vjaH5sw&oe=6AABFA34"}, {"file_name": "oculusShot (11).png", "id": "1112707089552805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PDCr3rSS2Z4Q7kNvwG86S_i&_nc_oc=AdqKZPCOoBXtC4e3AX7Pco53-BeMwRVsUTOmbhQisjhrINAD_wHK7M0Zp6H8p9krDus&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItEkfhfYsZcZP8-cbZNczOwGzvP-0GQT_7TUGB6hDswQ&oe=6AAC05C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RELAXATION_MEDITATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "984225675636794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982448_519845085792778_7228462893574455273_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-FBG7DJyEoQ7kNvwHtBsuE&_nc_oc=AdrDBbuuxYFEfmwtWCq0sxm_Yl4LTMku_K-KtX6_a6Q-Y8rdzEmJgtEGkQYGoT4WvBg&_nc_zt=3&_nc_ht=scontent-ia
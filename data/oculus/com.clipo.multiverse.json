lkjTmA4a0HhurO-bQaO0wVxDednezVtLc27esmck7UIjPbFoUqI6dF0tojcG5Ble4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1pRSTMW-50kwpJgavsRKqoYkkOIaytqYNct2jiCRKMA&oe=69BE8970"}, {"file_name": "oculusShot (12).png", "id": "4060036160762301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982483_4060036170762300_9092854240462410101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_k9dfeBRLwQ7kNvwE-sTUP&_nc_oc=AdnmSdAIDRpfQKUOXXFc7sNIRhuI1Bcyb4a8CfzaNmiz8f58HaYJ5ciegtUoBjhAmGo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCiE38KPTqpvaXarXaxNOuXzWFnIAohGgxQmfhgJCZhQ&oe=69BE9CC3"}, {"file_name": "oculusShot (10).png", "id": "156395513139515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001709_156395516472848_2336230638676150599_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WnhsJMA41EQ7kNvwHuWUjD&_nc_oc=AdmqoPVUVZTTIzC2XEVseHGRqv6ClnCct0cbpHbZOjUuzAtE_NTyCQ6ZqI8XPjun2AA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-6HhFT2rqM180xQ0ZpL1CYlKhTxJOY_VnYtryfHoJGQ&oe=69BEAC34"}, {"file_name": "oculusShot (11).png", "id": "1112707089552805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5BwdtVcmUgQ7kNvwH0A0h8&_nc_oc=AdkB7Yv21g3vnqdVGSJ1PEqllPpzs72absuSqA8bBc1febQdY_hBxj2gv2rITFnLk20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPri6SI7xsJPHjQGlSv6Oj32sme1nBCX_FIY_T732e9Q&oe=69BE7F85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RELAXATION_MEDITATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "984225675636794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982448_519845085792778_7228462893574455273_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4BOhuWtT0kQ7kNvwFt03q5&_nc_oc=AdnZZoQDm5kwmaAuTIbAeKsB4uiDoOmbvqE6CKknIYNeC5btQePjyRxJoP7FscqOGEE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzE5RzgIqxZj9
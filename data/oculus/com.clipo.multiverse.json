lDUL1unQzisZ4ifhUFsR3rTIxGMrUPgRew-eICUN3022-afeXAbSEUwABOsyXmwyM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxcCyHgPEWWvLEZKbcusvOXXrapagyWt4L6VO4XTlpBMw&oe=69AC1470"}, {"file_name": "oculusShot (12).png", "id": "4060036160762301", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982483_4060036170762300_9092854240462410101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AKHK96eqBMQ7kNvwGXVOB-&_nc_oc=AdldZBANp_AdUFtCsry2Q2AbI0khLte8EcMWBkq23qEKJQroNjdpfs6vJ-GVFpDnYqw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyc_CJYUGu9cgD4t5GTKIxneVrKi-Bb5CDwDxEY2ecPjw&oe=69AC27C3"}, {"file_name": "oculusShot (10).png", "id": "156395513139515", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001709_156395516472848_2336230638676150599_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDO2Iq7njg0Q7kNvwEoYV9k&_nc_oc=Adl-WIxxIl_eNQzwCbWPLIq6jg0L-8zDY7qDqczpovQnpB2KCKv4dkJED7MEJhZBESM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzA7sk0gcDBwHJAxNaapULRrZ5zztfiL0gM0fxx0cNF0g&oe=69AC3734"}, {"file_name": "oculusShot (11).png", "id": "1112707089552805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Ghf9YwD3GcQ7kNvwHyKPvX&_nc_oc=AdnvuqhB_tAOG_3EDtYcG57RJyW1uBjNg4bvzGz1oknbG6RNCgczNtVjmpA4SvfOjME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzuupGYaqcRxUaxfb9PaaNdVys-mAC_ECI72KSX4S3jGA&oe=69AC0A85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RELAXATION_MEDITATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "984225675636794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982448_519845085792778_7228462893574455273_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZOpEc1TtL8Q7kNvwEp92SQ&_nc_oc=AdlNqdSMZgPahjKcgXD-Ph5v-fDW8CbU4VbH-H8RMhN0XDWaBwKoLmTfBn4Fo7WSkiY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwWSH9wylPeKL
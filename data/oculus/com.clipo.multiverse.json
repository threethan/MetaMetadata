=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv71iGrRxBpYoqa8sWMPF7_GuLoRvy0i3gowNXrS1cybA&oe=69999F70"}, {"file_name": "oculusShot (12).png", "id": "4060036160762301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982483_4060036170762300_9092854240462410101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5nYNLwWY0gQ7kNvwHQmK2N&_nc_oc=AdlAakw_CjUGXHsn5aHYuygUZkbohTXUzlJ2VoZXwnBspBs30MC5bux7d044Gq74zsI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4gebdZX3iOD71eFNWHWlFhegSYI_GABz1ZrqKeS5-gg&oe=6999B2C3"}, {"file_name": "oculusShot (10).png", "id": "156395513139515", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001709_156395516472848_2336230638676150599_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qla-Qtht7CQQ7kNvwF7xXUI&_nc_oc=Adl8eEOFjJzvt5CdGJ7xAQFVlpbasN2XfzlisA0SeCsw_iiAbwu7AUJHRGI4kNwxRyc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfswcXAArOX5MGP8nEM0AcI6SwTRBx9-db4vSnyu2TS5Bg&oe=6999C234"}, {"file_name": "oculusShot (11).png", "id": "1112707089552805", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkcJ9JjKcAsQ7kNvwEOrw1x&_nc_oc=AdmabFNEDhRan5lJd_KYcJFU706wBdEMMh8v1kO2Ck-lyoR-uuVH8BmsF-aSxUKAA30&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvJI5sPQx_wjWDmy7Vpz-23Xus9z5EnL7Ln8VXRG2RIGw&oe=69999585"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RELAXATION_MEDITATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "984225675636794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982448_519845085792778_7228462893574455273_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WVILdxozaEQ7kNvwG_SMPy&_nc_oc=Adlsuveogyh7vRsCm7XDdRGwR2S-IvsMrEw4vwK8g7763KKrSqmoHLh7__mE_cpMGb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5s2Ew-ZGWK9R2LhPHZanVxRnqM8m8Q9YwDpnGBy5beg&oe=69999947"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,
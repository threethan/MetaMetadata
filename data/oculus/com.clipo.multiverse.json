Z_3ZKRX3wcQ7kNvwGf2cEE&_nc_oc=AdrdWsUMURX3eoHEvrVJbCAi4BaJVn8nZP8LTDaJE-LGaGH4yhRalsDa8kwv4plsmfA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEsaaAAbnKf5N5i73ue7-Kb-5GLJCMensqkPTGjwd2EA&oe=6A899070"}, {"file_name": "oculusShot (12).png", "id": "4060036160762301", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982483_4060036170762300_9092854240462410101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIzOlxEy2t4Q7kNvwGTqJyt&_nc_oc=AdoWDbToYcS3sMvuRD3dyMjmvQfoLmJbQCAMcWSg4VnmP-uPVidjgMwNPqfiCmRJKJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkF1o99jg9wTYaCo0Kus3FEaeUqs5JJBERdIyF1ujanA&oe=6A89A3C3"}, {"file_name": "oculusShot (10).png", "id": "156395513139515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001709_156395516472848_2336230638676150599_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mj-sV3kMNYQQ7kNvwF5cQxl&_nc_oc=Adp-StGmmyMx-_jaI8Mj9rULAtGTRJpYGQMNtymk0Nar5lLs_35g1rEwTeOu-uX3PMQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN9gZ5i8XaHCsonviECdb9qSGlTfJKtO23ecDlKypzBw&oe=6A897AF4"}, {"file_name": "oculusShot (11).png", "id": "1112707089552805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g52kW5guOUQ7kNvwEJxvOC&_nc_oc=AdoLoVVKuD5GyZlvA8ljE9H67rMxtM9cglwPSvwhEh94Ffe2lTuJYdIDNTtbhzgFIFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEB0i9U8-LBnyVfdMmRfFWmVcu2NHugGS3nF3Z1yono9g&oe=6A898685"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RELAXATION_MEDITATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "984225675636794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982448_519845085792778_7228462893574455273_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_U7IisEWKcQQ7kNvwGV1dRL&_nc_oc=AdoCyEKz7DhhmRjhBiYkVBn9sLBsuOUtQyjkx2gETbx_Zz2EQc7lhOh5a6st0E83sUY&_nc_zt=3&_nc_ht=scontent-sj
=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvX8eUW6Yyby1IVPC_kZ46c8zLQ8rCrVKxHNmAMqqlO7A&oe=69A18870"}, {"file_name": "oculusShot (12).png", "id": "4060036160762301", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982483_4060036170762300_9092854240462410101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Itdj-p5mjk8Q7kNvwF4UW5e&_nc_oc=AdngEoO8vizuqhIx1J0hIzIEO2iD23YHX8KcdN7ws8OPNY2YyuBGql7pQMOz321HK74&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu0Pb_KyXb5wVZ_jK1tDmDEC6xC2KAYHED_xoffpiz1NQ&oe=69A19BC3"}, {"file_name": "oculusShot (10).png", "id": "156395513139515", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39001709_156395516472848_2336230638676150599_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWK_kZeJUeYQ7kNvwE3FZnr&_nc_oc=Adk7ZEIw0J-GaWpQDrNm8doTH9rIl4byRxHr2P6OfoL3hVaECCjhGoLiIgizW3m5n6A&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsMnqA-0zJe9ISnO4_3lhPwVm1udaUg7MApL3X_SKqtKw&oe=69A1AB34"}, {"file_name": "oculusShot (11).png", "id": "1112707089552805", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24iQKjnzkb8Q7kNvwGx1hEy&_nc_oc=AdnGP6Ltmd9r2SCxCZu_lHBo_D4EYC1KvZ2cvX3GU0nSPuCfqRYGRvoeJ7IPkpW4AGA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft19eWInE4q1hCNVmT2bha9EZ8wE1bMWzUr5ChXT2zUAg&oe=69A17E85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RELAXATION_MEDITATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "984225675636794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982448_519845085792778_7228462893574455273_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elEz68_5PKwQ7kNvwGE9dt6&_nc_oc=Adm4xEB7O7NRggk0amOJQpN5pP-dq5H8VlgRWL336M296HwHMg_uP5SG9cuhVA5aTRQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuK9uqCBM1H_5I2BXzJ6M1ULmVsjfpgOF_uye_4u4vseg&oe=69A18247"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false,
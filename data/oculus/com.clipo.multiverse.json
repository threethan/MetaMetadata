_4WJO4FNGoQ7kNvwEt6Fyd&_nc_oc=AdpfQv_djuw1WwXIxX67hRN5_Uj3m7yS2Rms7Pwx2D5BtTTHWyYnZXS4IkYLLzzq9y4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGYLHv7VkFLltt8YXFAQmIQdTwIOl5TyZ4xBeW-P4y7g&oe=6ACD0530"}, {"file_name": "oculusShot (12).png", "id": "4060036160762301", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982483_4060036170762300_9092854240462410101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zJ_-tCGvegQ7kNvwEbly0q&_nc_oc=Adp4YRBY8_NCGfYdIi6xKnLMr-_0uz9mJNYM7klV6-9j_GQdNNM44_ABDx9s0K_hnU0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9R_NME9_cfXHKli3OwRBRkDWDf3QQwHFL9MXAwoOzEA&oe=6ACD1883"}, {"file_name": "oculusShot (10).png", "id": "156395513139515", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001709_156395516472848_2336230638676150599_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXjb2Ja8i9MQ7kNvwHZS9U_&_nc_oc=AdrzQYRgM-Ewz06FABvaEGfiCB6-c9ZxZ5Dst62WuC2G4Tc6dB-BYy-rZ3o5lR2DAmY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcW6U3QbcM6ekrtUttrg-XKn59FSpG9GC8ztwOopo1rQ&oe=6ACCEFB4"}, {"file_name": "oculusShot (11).png", "id": "1112707089552805", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKgtu-Q9AukQ7kNvwHatQsM&_nc_oc=AdpdENGFvI4uC5x8Bo4W9eyKwZcJMdpyuP1EfZfiX29WbtAJdVff7nUzcEcR3IFHi58&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5lHwbk_Z0LYG_nOWENUZxXe85opwnJlmnMHcBs7bCJw&oe=6ACCFB45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RELAXATION_MEDITATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "984225675636794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982448_519845085792778_7228462893574455273_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpnC7nG_2KUQ7kNvwE0FIqV&_nc_oc=AdohOXvmTL4RO4XeFFHrt9i96CkRjCCuibayBg5Lhpw_-8wNu_9HIqkl-z4BZjU8NCs&_nc_zt=3&_nc_ht=scontent-sj
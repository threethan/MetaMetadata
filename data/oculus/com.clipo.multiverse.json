nMTqVdVDloxKXcrZ7RGM8Tprq4epPz91mtXsR_U1_kMGuvkzb7p_Rd1BvHSwN64UQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwiihf9BpZ2J1J1vKljJVZ9nKNRteHIw-HQnJr9cq9_lw&oe=69B7F1F0"}, {"file_name": "oculusShot (12).png", "id": "4060036160762301", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982483_4060036170762300_9092854240462410101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qstvPPTfjvIQ7kNvwHwh947&_nc_oc=AdkAWR5LmwBVztpHMsnF7eFkI0X_n0X0TAb7476HcO7kMhnEWkztvNN5s82RVyHduwk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_0tYcMVPv1jdXsZ5oCq3SpDLG-xLgrmGWGfcKMaXo7g&oe=69B80543"}, {"file_name": "oculusShot (10).png", "id": "156395513139515", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001709_156395516472848_2336230638676150599_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Sr1py9A88QQ7kNvwGEwVfo&_nc_oc=Adm4-obkVmfU1ztgTIwI_P1acq2fOsI_yzrlZYkykg181HowK_AtWd5f_MugLCxnbCI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3oBmUbFSlUJ9Gho_XW23ygeeFX241BtUZZQ7y1WzzhA&oe=69B814B4"}, {"file_name": "oculusShot (11).png", "id": "1112707089552805", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MB7B3jtPtmoQ7kNvwHb_oev&_nc_oc=AdlMWrwXoQTQpPU-pvU49EqBLApcGX7p2YhZgmyKfV-59OkT8gn60aXz2WIhaU0GXMY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMs5S-qooeQ3gfmemNtBXcOFCdkiwRQAQi0w33hI67Cw&oe=69B7E805"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RELAXATION_MEDITATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "984225675636794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982448_519845085792778_7228462893574455273_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dtwdh_ib628Q7kNvwFh-Trg&_nc_oc=AdmfRfHf9xIDe0OrMKxmbhi2K8chTD62Due2ffWCCFhui2pACBcAukGeBEaMaIAfEx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwfA_9j81Qeh6
lSEBFHa8IYEFkS6iUzLoZHStYlbulYKbUNDpekVWLXgzMJM1qUt5-o1N6pXLTrEeA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxopY3VffYNMkfcDsHgSTTb_jJA5k8mZB0jilu6jKWQUg&oe=69BBE670"}, {"file_name": "oculusShot (12).png", "id": "4060036160762301", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982483_4060036170762300_9092854240462410101_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KkrIHwAzhOQQ7kNvwFboaqx&_nc_oc=AdkV8ImSTvkLxfSK4pPBeU6bFL7dVf0F9JHqb__H5Ze-MHYpbbLiSiU6pNJqs_sPTzY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw7Vl4jKNcMhvgQMWe53HbjdqbQPDp9CJSI0vlJ8QpcoQ&oe=69BBF9C3"}, {"file_name": "oculusShot (10).png", "id": "156395513139515", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001709_156395516472848_2336230638676150599_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WnhsJMA41EQ7kNvwGY5mO_&_nc_oc=AdninEqRNYm0trKtgOnQ5eE0iRPqvN9P19ScfSJEHdffMHj5p8I1IBt5CpMgIVOK09Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzpCacl2i3KMnMNIynqlg3mbCgZGwcipOZq18NUjiWcwA&oe=69BC0934"}, {"file_name": "oculusShot (11).png", "id": "1112707089552805", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982448_1112707096219471_6388808502129061033_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_UUDjQliJcQ7kNvwHQCnrS&_nc_oc=Adn9mqH2mjC_U88YPAhgC0hACfHXMaqZBTpBaVfCrP7cFvRfQxffHXIk_Mp2or4s530&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhVvFhtvNZtSapd2uT-oZuPtbm0ZcRCxK6FPf4sTKW-A&oe=69BBDC85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Multiverse", "keywords": [], "long_description": "Dusty multiverse is an official Virtual Burning Man experience and it is an interactive and immersive social platform that thrives on artistic collaboration and participation on a global scale. You can enjoy many unique experiences just like a live Burning man: For examples, performers of all types can broadcast themselves live to a global audience and gift their art in many ways. Participants can also communicate in real time via live voice chat. You appear as a customized 3D avatar and will be able to see some of the official Burning Man honoraria art, along with some of the famous Burning Man Sound camps. DJs will be broadcasting live music 24/7. You can dance with others, and you can participate in many interesting social experiences.", "short_description": "You appear as a 3D avatar and can communicate with others via live voice and chat. Attend live music events. Dance with people (well, your 3D avatar dances for you). Explore a whole new dimension."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dustymultiverse.com/privacy-policy/", "developer_terms_of_service_url": "https://dustymultiverse.com/terms/", "publisher_name": "Clipo Labs", "support_website_url": null, "website_url": "https://clipolabs.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RELAXATION_MEDITATION", "MUSIC"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "984225675636794"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982448_519845085792778_7228462893574455273_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUIyHnrrnuIQ7kNvwFR2A6E&_nc_oc=AdnWZ2kxDPT-sPuFhdW5No0ioHISypMgVfj-SaIhKF35kRCFS51Kukujqiz4KgTiuYA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwn48T11BVdYq
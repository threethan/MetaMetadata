r Maintenance micro-credential program. It is intended to complement structured coursework and provide guided, experiential training.", "short_description": "Humidifier Maintenance is a VR training application designed for immersive, hands-on skill development. As part of the Immerse Learn Humidifier Maintenance micro-credential program, this app enables learners to practice real-world maintenance procedures in a safe, simulated environment. Access is exclusively available to enrolled learners for guided training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26536049342714284"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "979976011154936"}]}, "baseline_offer": {"id": "979976011154936"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780318560, "status": "PUBLISHED", "id": "979976011154936"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26942916932027521", "version": "1.0"}, "id": "1301837725218994", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"n
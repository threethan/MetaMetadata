}, {"file_name": "HighresScreenshot00001.png", "id": "1973321166646458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_1973321169979791_8454371638280537632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRyeiwxs8s8Q7kNvwGBTwQP&_nc_oc=AdqkAycbVSvhZOV07vtrTC_IuB_wPNqIOd5JudkDcANOqBK9jslQlRwyu31EO05t8fA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXoS9agMisUsXczu8WmTZsrI7LMpAWuLk2cCkK26bf3A&oe=6AE9F3C4"}, {"file_name": "HighresScreenshot00004.png", "id": "971600005767340", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622334_971600009100673_4542441735576311731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85ldjXXkajcQ7kNvwHdM2aP&_nc_oc=Adq3sPznUiX5sZ9URUVzPI26r6VwIDqnzk2EjLksKevR4-oZdqRCFJBcpEJpVCiZ1II&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR2RNde9AinRCvab7mePGYRcBtiPwT4YEx_HYkYeo_gg&oe=6AE9F9A5"}, {"file_name": "HighresScreenshot00002.png", "id": "1676111680203218", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314667_1676111683536551_6439688014204147993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ipkxev5JRk8Q7kNvwF_PwJz&_nc_oc=Adry22Pci99aGAB8VOBSo0td5xtzTXo-Mb6H-K3hGBUldlZYbbF0sSZ4g7yOrMi8fPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2JZAYTsHDwXZOkpeoXHvBBvFBysDdKzq2EQpjVdp3Fw&oe=6AEA02D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Humidifier Maintenance", "keywords": [], "long_description": "Humidifier Maintenance is an immersive VR training application developed to support hands-on learning in equipment maintenance. As part of the Immerse Learn Humidifier Maintenance micro-credential program, this application allows learners to build practical skills through realistic, interactive simulations.\nUsers will gain experience in inspecting components, identifying common issues, performing routine maintenance tasks, and following proper safety procedures all within a controlled virtual environment. The simulation is designed to reinforce learning, improve confidence, and prepare learners for real-world applications.\nPlease note: This application is exclusively accessible to individuals enrolled in the Immerse Learn Humidifier Maintenance micro-credential program. It is intended to complement structured coursework and provide guided, experiential training.", "short_description": "Humidifier Maintenance is a VR training application designed for immersive, hands-on skill development. As part of the Immerse Learn Humidifier Maintenance micro-credential program, this app enables learners to practice real-world maintenance procedures in a safe, simulated environment. Access is exclusively available to enrolled learners for guided training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26536049342714284"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "979976011154936"}]}, "baseline_offer": {"id": "979976011154936"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780318560, "status": "PUBLISHED", "id": "979976011154936"}]}, "liveChannel": {"nodes": [{"latest_supported
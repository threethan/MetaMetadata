-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_1973321169979791_8454371638280537632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL2texr-VjoQ7kNvwFnXx2j&_nc_oc=AdqSOqbTJJ_6p5ULyxy-mHPnVk8nt1pxNAHqkulbFfYLThPxhjzB0Ad5CbpGAjn36pk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GghHwofKLuu7DroN_fvl8WLp8WRmOpN_Dpvwv-nqfQA&oe=6A2D6D44"}, {"file_name": "HighresScreenshot00004.png", "id": "971600005767340", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_971600009100673_4542441735576311731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_HBIPZsGAMQ7kNvwGpW7gG&_nc_oc=Ado8Ki7Y8F3ZNKmzVCvY2rSBu_tklSe6c2FdqK9hfzrAlr0T_FuOdFSc-9LFWvH6bHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9S-z41BHBol7KFEA1FWiM172d52lS1uazXd0ZccZeYzw&oe=6A2D7325"}, {"file_name": "HighresScreenshot00002.png", "id": "1676111680203218", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314667_1676111683536551_6439688014204147993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzKKwEc2NmYQ7kNvwEk9SeE&_nc_oc=Adr_van0uYalMZaXZxRbUL2biM-xM59WuTYSuyv-j8tsVfBxi3LAzUK67-6PNIL6IHo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vR4kolPvYsm2nrXOsxka3hVC-MiZztvegdfoJdY7oHQ&oe=6A2D7C54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Humidifier Maintenance", "keywords": [], "long_description": "Humidifier Maintenance is an immersive VR training application developed to support hands-on learning in equipment maintenance. As part of the Immerse Learn Humidifier Maintenance micro-credential program, this application allows learners to build practical skills through realistic, interactive simulations.\nUsers will gain experience in inspecting components, identifying common issues, performing routine maintenance tasks, and following proper safety procedures all within a controlled virtual environment. The simulation is designed to reinforce learning, improve confidence, and prepare learners f
-ams2-1.oculuscdn.com/v/t64.5771-25/499622325_1973321169979791_8454371638280537632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK8HOcSUsl0Q7kNvwGxjXps&_nc_oc=AdoS72Z5YQoez0AlavH6sxbrh9m7_bIcjLb8ARW7RyDYEGyL16-nlLsby4cLbr5GG0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wY6q_dtrjR74ywkxakVHfM8FBWHbzBzZ_g01ZHd7grA&oe=6A3161C4"}, {"file_name": "HighresScreenshot00004.png", "id": "971600005767340", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622334_971600009100673_4542441735576311731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzA5dfFRw6YQ7kNvwH6b5S1&_nc_oc=AdoK3jZoFlStKFTwTUBEe8Yw5EFBZ1T3eZTLpo3O-yjgvJYi4I9ufsvCR6O_GTw5T34&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UtG_TttG10wvxGzNkETmCHVxdnxJSU3mkaek-LyHp1w&oe=6A3167A5"}, {"file_name": "HighresScreenshot00002.png", "id": "1676111680203218", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314667_1676111683536551_6439688014204147993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0mu4bTAR5oQ7kNvwFNX4Jv&_nc_oc=AdqGcGDo5YFN7-sejRmxJBQa7-blJ0cWQ53lkUSx1X6CQadUdkD8UJ5sD5O1XaFokEg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZQv1IVIlUJRp21pXwAVyxvoFtDu3fm1gZLcFoDEFhYg&oe=6A3170D4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Humidifier Maintenance", "keywords": [], "long_description": "Humidifier Maintenance is an immersive VR training application developed to support hands-on learning in equipment maintenance. As part of the Immerse Learn Humidifier Maintenance micro-credential program, this application allows learners to build practical skills through realistic, interactive simulations.\nUsers will gain experience in inspecting components, identifying common issues, performing routine maintenance tasks, and following proper safety procedures all within a controlled virtual environment. The simulation is designed to reinforce learning, improve confidence, and prepare learners f
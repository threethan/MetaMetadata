ured coursework and provide guided, experiential training.", "short_description": "Humidifier Maintenance is a VR training application designed for immersive, hands-on skill development. As part of the Immerse Learn Humidifier Maintenance micro-credential program, this app enables learners to practice real-world maintenance procedures in a safe, simulated environment. Access is exclusively available to enrolled learners for guided training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26536049342714284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622919_1702171410807466_8484663147715677832_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0fmyxyQ1F8Q7kNvwGGZEIN&_nc_oc=Adqa85qlCOd7Ih_Fa0KtHE1ZG-QV2CFvLXpDum6cCdOlbGv-4tHdWbKXbq6cYpaPxjI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUXpGzZVrvd6eNRz0ZcuE978nxouJ8ckH3hoa5qjBRsA&oe=6AFB1681"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Humidifier Maintenance", "platform": "ANDROID_6DOF", "con
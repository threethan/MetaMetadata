-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_1973321169979791_8454371638280537632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK8HOcSUsl0Q7kNvwFKd8IB&_nc_oc=Adq4c_nFpVriCTz87gIbCQNDGzthTTcjdH8oBZOvZx0qCPngcT4MdhD5MQYIJcyRePs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rNN9Rxr5HcfbfushJSWgeOnRmGIgOeJyH8k5okAzCVg&oe=6A2EBEC4"}, {"file_name": "HighresScreenshot00004.png", "id": "971600005767340", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_971600009100673_4542441735576311731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_HBIPZsGAMQ7kNvwERArTE&_nc_oc=Adq4FUdbAvmsL_McjlK3ZRD9CGGEU0Q4pyZsqDWK_5u4_9Kd-MtW62XyyL9g-KSCwjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Z4zWzYh0cXWsDHr6EPdHVpXcaNZf7thiE4FryUr6RUQ&oe=6A2EC4A5"}, {"file_name": "HighresScreenshot00002.png", "id": "1676111680203218", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314667_1676111683536551_6439688014204147993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0mu4bTAR5oQ7kNvwGs9_h0&_nc_oc=AdoPpimIXjxT_2OoBXtZM9hw6leEtQ3fmtlVyyVfYd24PNOeuC--Gbri1nZwF8mhzME&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9I1leNBSHMZisZH2dKYOqc4TP_g6lny1XTr1dmloyrLw&oe=6A2ECDD4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Humidifier Maintenance", "keywords": [], "long_description": "Humidifier Maintenance is an immersive VR training application developed to support hands-on learning in equipment maintenance. As part of the Immerse Learn Humidifier Maintenance micro-credential program, this application allows learners to build practical skills through realistic, interactive simulations.\nUsers will gain experience in inspecting components, identifying common issues, performing routine maintenance tasks, and following proper safety procedures all within a controlled virtual environment. The simulation is designed to reinforce learning, improve confidence, and prepare learners f
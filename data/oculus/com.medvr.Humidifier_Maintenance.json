-atl3-1.oculuscdn.com/v/t64.5771-25/499622325_1973321169979791_8454371638280537632_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK8HOcSUsl0Q7kNvwEEVDje&_nc_oc=AdpTCpDK00LvOLiGX99lBcNAo3QLrf3YzEt11Aayeex_s2AOzM1rzkBlFlcPRAyBiVo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZZanH7-Jd--wg5L-6Z2JSG_duN7OVv-8rBoWa7q21Ng&oe=6A301044"}, {"file_name": "HighresScreenshot00004.png", "id": "971600005767340", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622334_971600009100673_4542441735576311731_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_HBIPZsGAMQ7kNvwE-0tGY&_nc_oc=AdoTEwRYy_zK6gln_Y2lciGqvr68hPnL6HFKVR0A3uo07phWZDG9QHXNk_iXyF9p6pA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Rp6Cy5Q8t6r_NNDfYi12VQZBHoCCMYb6Py5NWaX0Qkw&oe=6A301625"}, {"file_name": "HighresScreenshot00002.png", "id": "1676111680203218", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499314667_1676111683536551_6439688014204147993_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0mu4bTAR5oQ7kNvwFDCODA&_nc_oc=AdqVU6YMwzO7ePH2CXj4fB41wpLpjwzc-zR_yKx-SRtTe9bnPvrc8_RPx3y9Vgm4n9s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aay205sCWyvpWDhn-BH7Uq0_PUylTSQ-UsejqiJO7bQ&oe=6A301F54"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Humidifier Maintenance", "keywords": [], "long_description": "Humidifier Maintenance is an immersive VR training application developed to support hands-on learning in equipment maintenance. As part of the Immerse Learn Humidifier Maintenance micro-credential program, this application allows learners to build practical skills through realistic, interactive simulations.\nUsers will gain experience in inspecting components, identifying common issues, performing routine maintenance tasks, and following proper safety procedures all within a controlled virtual environment. The simulation is designed to reinforce learning, improve confidence, and prepare learners f
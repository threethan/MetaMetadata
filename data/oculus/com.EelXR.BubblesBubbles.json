, bat them around, or pop them with spitballs. There are a few other bells and whistles to discover.\n\nCards: Test your aim by grabbing and throwing charged up playing cards like a certain Cajun comic book hero.  \n\nMore activities coming soon.", "short_description": "A variety of activities to amuse and delight as you while away the time. "}]}, "developer_name": "Hawkwood Development", "developer_privacy_policy_url": "https://hawkwood.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hawkwood Development", "support_website_url": null, "website_url": "https://hawkwood.com/apps/bubbles-bubbles", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879023615483233"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031487_1555956499138329_2097078995681586218_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jF2SL4940pIQ7kNvwEdGydS&_nc_oc=Adq3Tp-qpV04jIsnkDJct9Ii8UcTJskBgya_09BrZHs_SHRR7njkqqcNAQEv3RkKDkc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8GLL6ciQQ10Blcm6JBdH_-As8ScrPdQC-YHGeWs8pcg&oe=6A8ED2F9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bubbles & More", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}
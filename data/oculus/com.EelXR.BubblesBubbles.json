 and whistles to discover.\n\nCards: Test your aim by grabbing and throwing charged up playing cards like a certain Cajun comic book hero.  \n\nMore activities coming soon.", "short_description": "A variety of activities to amuse and delight as you while away the time. "}]}, "developer_name": "Hawkwood Development", "developer_privacy_policy_url": "https://hawkwood.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Hawkwood Development", "support_website_url": null, "website_url": "https://hawkwood.com/apps/bubbles-bubbles", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8879023615483233"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031487_1555956499138329_2097078995681586218_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5CFSh53Kz8Q7kNvwHmG5Sx&_nc_oc=AdlPXVQC79jqpvuKhVFxBosxn-mrBP93Togr2bG9Z-4bzh_0uAmwp5X5yj0uctv9bv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfykApmCD-K0YaqdZZuCT3_P9G-HE6cH_9e2jp4ZMvsYIA&oe=69B54B79"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bubbles & More", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}], "relea
 Got Mail - Stealth Office Simulator", "keywords": [], "long_description": "You've Got Mail - Stealth Office Simulator is a stealth game that is simple to learn yet deceptively hard to master.\n\nYou work the mail room at Greedy Inc.  It is Friday evening and the bosses are looking for employees to work the weekend.  You have to finish your mail room deliveries before they catch you and ruin your plans.\n\nYou've Got Mail is a game that will test your memory, push your time management, challenge your patience and test your nerves.\n\nAre you good enough?", "short_description": "You've Got Mail - Stealth Office Simulator is a stealth game that is simple to learn yet deceptively hard to master."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/youvegotmail", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "STRATEGY", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1172657663647602"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "2124287881709240"}, {"status": "PUBLISHED", "id": "791627423348408"}, {"status": "PUBLISHED", "id": "1040964451087184"}, {"status": "PUBLISHED", "id": "1084198750211879"}, {"status": "PUBLISHED", "id": "1709711582919005"},
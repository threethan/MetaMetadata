 Mail - Stealth Office Simulator is a stealth game that is simple to learn yet deceptively hard to master."}]}, "developer_name": "John Ray Games", "developer_privacy_policy_url": "https://johnray32875.wixsite.com/johnraygames/youvegotmail", "developer_terms_of_service_url": null, "publisher_name": "John Ray Games", "support_website_url": null, "website_url": "https://johnray32875.wixsite.com/johnraygames", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "STRATEGY", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8049347391839373"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982530_3014015918738874_3583919829806151303_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwiedPmHkRIQ7kNvwEbJH8p&_nc_oc=AdoO9OdYEGnoFviZEKcWDdUJf4d17R70mD3vvL3kHlCyYsPwAZHGnHixjK6RYpj7ATs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af995OH5c-oCkLq-UZTIr8VEFgDIGx3GxLYj6u_YQcZAvQ&oe=6A36A3AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "You've Got Mail - Stealth Office Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1669137486, "lastRevision": {"nodes": [{"id": "5631025483671588", "release_type": "SCHEDULED", "adminis
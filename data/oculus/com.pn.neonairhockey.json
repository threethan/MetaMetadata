ns6sOb2hYeRhoo36g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXNCrGnPYOvzIEBZFULO8hBGAHxDasYiTvWG0o09YZJBA&oe=6B105122"}, {"file_name": "screenshot-4-goal.png", "id": "1457603146331711", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1457603152998377_4015615163053438539_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEmvrY5Zw58Q7kNvwFrD0In&_nc_oc=AdpCjcyMMHYqUJxIXShe-CG02K2hj0n7Xh1r1jm1e64_-RRKcMrTB210tI0RsQgjPfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTwknFnKzE0DAzPYJ1vYfqv3MiYGbRbsCEGWhIfr4Z-A&oe=6B1038CA"}, {"file_name": "screenshot-5-win.png", "id": "1668093664896425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_1668093668229758_7948635727935533561_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeckB30WasoQ7kNvwE8kozs&_nc_oc=AdrzeK2fKTrDTCjgVaf6uqXOVDhGUZsO1WIm2IUDR-_wNZRzzS5cNM8_7rOowFOKHpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVchV-M081yFkNwJ_cOPo1rsb6ddUiuu6tM9BHKe6f0vA&oe=6B1048F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Air Hockey: Neon Pulse", "keywords": ["arcade", "hockey", "retro", "airhockey", "glow"], "long_description": "Step up to a glowing air hockey table and play the arcade classic like never before \u2014 in full VR.\n\n**Air Hockey: Neon Pulse** drops you into a synthwave world of neon light and pulsing beats. Grip your mallet with your Quest controller, read the puck and slam it home before your AI opponent does.\n\n**FOUR AI LEVELS**\n\nWarm up on Easy, find your rhythm on Normal, sweat on Hard \u2014 then try to survive Insane. The bot defends its goal and punishes every mistake.\n\n**NEON ARCADE STYLE**\n\nA glowing LED table, retro grid horizons and neon glow everywhere you look \u2014 the arcade hockey table you never had at home.\n\n**MUSIC THAT PLAYS WITH YOU**\n\nThe soundtrack reacts to the match: every hit, rebound and goal pulses through the music and the lights.\n\n**PURE PHYSICAL FUN**\n\nReal arm movement, fast pucks, sharp rebounds off the rails. Easy to learn, hard to master.\n\n**FEATURES**\n\n- Classic air hockey (table hockey) in VR\n- Single player vs AI: Easy, Normal, Hard, Insane\n- Neon synthwave visuals and a glowing LED table\n- Reactive music and light effects\n- Made for Meta Quest controllers\n\nGrab the mallet. Feel the pulse. Score.", "short_description": "Air hockey in VR, drenched in neon. Grab your mallet and face an AI rival across a glowing LED table \u2014 from Easy to Insane. Classic arcade hockey with fast pucks and a synthwave soundtrack that reacts to every hit and goal. Pure retro arcade energy, built for Meta Quest controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/porconova/legal/refs/heads/main/AH-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "Dzen Team", "support_website_url": null, "website_url": "https://x.com/PorcoNova", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1407665362435716"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "29756595007281758"}, {"status": "PUBLISHED", "id": "4576860995865553"}]}, "baseline_offer": {"id": "4576860995865553"}, "is_approved": true, "first
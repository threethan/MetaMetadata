_IATLYa4iPCJKQyt6jX1PXJcMWCeHv4ujeHkFjW4HVw&oe=6B0DB6BD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover 2.png", "id": "2977514519268309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_2977514525934975_7289237136476559117_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2UH61i9Y1kQ7kNvwFEwnmH&_nc_oc=AdqtszWez1nY-nFweckRGqK4csUeuzLSlnnGp30Ea4q11I1e6d5xHQiLu2QjTdgfNuA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQNfi38FH0FGWEcqu7e-kmraGdiZKmdolZbsbps6zKUZg&oe=6B0DB877"}, "display_name": "Air Hockey: Neon Pulse", "keywords": ["arcade", "hockey", "airhockey", "glow", "air"], "long_description": "Step up to a glowing air hockey table and play the arcade classic like never before \u2014 in full VR.\n\n**Air Hockey: Neon Pulse** drops you into a synthwave world of neon light and pulsing beats. Grip your mallet with your Quest controller, read the puck and slam it home before your AI opponent does.\n\n**FOUR AI LEVELS**\n\nWarm up on Easy, find your rhythm on Normal, sweat on Hard \u2014 then try to survive Insane. The bot defends its goal and punishes every mistake.\n\n**NEON ARCADE STYLE**\n\nA glowing LED table, retro grid horizons and neon glow everywhere you look \u2014 the arcade hockey table you never had at home.\n\n**MUSIC THAT PLAYS WITH YOU**\n\nThe soundtrack reacts to the match: every hit, rebound and goal pulses through the music and the lights.\n\n**PURE PHYSICAL FUN**\n\nReal arm movement, fast pucks, sharp rebounds off the rails. Easy to learn, hard to master.\n\n**FEATURES**\n\n- Classic air hockey (table hockey) in VR\n- Single player vs AI: Easy, Normal, Hard, Insane\n- Neon synthwave visuals and a glowing LED table\n- Reactive music and light effects\n- Made for Meta Quest controllers\n\nGrab the mallet. Feel the pulse. Score.", "short_description": "Air hockey in VR, drenched in neon. Grab your mallet and face an AI rival across a glowing LED table \u2014 from Easy to Insane. Classic arcade hockey with fast pucks and a synthwave soundtrack that reacts to every hit and goal. Pure retro arcade energy, built for Meta Quest controllers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/porconova/legal/refs/heads/main/AH-Privacy-Policy", "developer_terms_of_service_url": null, "publisher_name": "Dzen Team", "support_website_url": null, "website_url": "https://x.com/PorcoNova", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1431835463352039"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824307_2302253633874765_7812970411820459682_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9hdz8cHGe8Q7kNvwGf2MCU&_nc_oc=AdqINXHyPyl5oMas5_WhFfD0WcNqBeqhgxooL2NgY0MhCPN4y-5QAft-z0uhaEOhpjI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRalLQLGxvCt1LEFuPFdKf5J23oxQcwZh2tLUu4BWYu5Q&oe=6B0DC6DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Air Hockey: Neon Pulse", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "45
3tmKDAuwmOL7vhKj7T7SDQ&oe=6B045D7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 copy-1 (1).png", "id": "1373968550004905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974594_1373968556671571_2926488797433788158_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwA_k7RINKcQ7kNvwGmKjg8&_nc_oc=AdrIoQDmaS1ICiUy331Hw4YzHGJVtjNQzqvSuZTA59iZb2JgZ7oRDxdPNBzhf7uRD3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOcdcIug_eUX4jXfISQRzWAnp3GD_IqUODQVK88J0MoA&oe=6B048A68"}, "display_name": "Planet Jumper VR", "keywords": [], "long_description": "Do you enjoy arcade shooters, sci-fi environments, and awesome music? You'll love this game!\n\nGo from planet to planet as you fight against futuristic robots and drones in this arcade shooter. Each level puts you on a different planet to kill enemies, take down asteroids, and gather as many points as you can while listening to the level's featured song. Compete against your friends for the best score in the survival game mode to get your name on the leaderboard.\n\nThis game includes 6 unique levels, an infinite survival mode, and multiple secrets hidden throughout the levels.", "short_description": "Do you enjoy arcade shooters, sci-fi environments, and awesome music? You'll love this game!\n\nGo from planet to planet as you fight against futuristic robots and drones in this arcade shooter. Each level puts you on a different planet to kill enemies, take down asteroids, and gather as many points as you can while listening to the level's featured song. Compete against your friends for the best score in the survival game mode to get your name on the leaderboard."}]}, "developer_name": "WonderSense Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1X22wcjKD6tT9sjzxa3leN8VH3gJMsGai97ceO_vfffg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "WonderSense Games", "support_website_url": null
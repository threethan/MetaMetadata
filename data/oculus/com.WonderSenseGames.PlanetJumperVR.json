c=1JXbZC6rbsEQ7kNvwHuIgaH&_nc_oc=AdqU_B4tRjj2c_V3jimlkd_X-H7w3DHt5ax76o8fmav7y92hf6T9dfqkti5fYKa46Q8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z67eqF8I4aLV7k5qOCkQnzfLeI66zv0px2PpcC-2snQ&oe=69D90DA8"}, "display_name": "Planet Jumper VR", "keywords": [], "long_description": "Do you enjoy arcade shooters, sci-fi environments, and awesome music? You'll love this game!\n\nGo from planet to planet as you fight against futuristic robots and drones in this arcade shooter. Each level puts you on a different planet to kill enemies, take down asteroids, and gather as many points as you can while listening to the level's featured song. Compete against your friends for the best score in the survival game mode to get your name on the leaderboard.\n\nThis game includes 6 unique levels, an infinite survival mode, and multiple secrets hidden throughout the levels.", "short_description": "Do you enjoy arcade shooters, sci-fi environments, and awesome music? You'll love this game!\n\nGo from planet to planet as you fight against futuristic robots and drones in this arcade shooter. Each level puts you on a different planet to kill enemies, take down asteroids, and gather as many points as you can while listening to the level's featured song. Compete against your friends for the best score in the survival game mode to get your name on the leaderboard."}]}, "developer_name": "WonderSense Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1X22wcjKD6tT9sjzxa3leN8VH3gJMsGai97ceO_vfffg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "WonderSense Games", "support_website_url": null, "website_url": "https://www.wondersensegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "644354873106712"}], "external_subscription_type": "N
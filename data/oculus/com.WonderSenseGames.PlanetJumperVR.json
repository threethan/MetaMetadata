c=_-NBSMY0AXIQ7kNvwGcQfV9&_nc_oc=AdrlJLPcWPzNkeCU7uq9b16trPZJkKMLOrNLApR4I--IY4hLf01Fu4236bIJG8718Nk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9g7Bv7IjXjZ6isiW3v9C17HGS1CJPCL4snuE8nyibmw&oe=6A983728"}, "display_name": "Planet Jumper VR", "keywords": [], "long_description": "Do you enjoy arcade shooters, sci-fi environments, and awesome music? You'll love this game!\n\nGo from planet to planet as you fight against futuristic robots and drones in this arcade shooter. Each level puts you on a different planet to kill enemies, take down asteroids, and gather as many points as you can while listening to the level's featured song. Compete against your friends for the best score in the survival game mode to get your name on the leaderboard.\n\nThis game includes 6 unique levels, an infinite survival mode, and multiple secrets hidden throughout the levels.", "short_description": "Do you enjoy arcade shooters, sci-fi environments, and awesome music? You'll love this game!\n\nGo from planet to planet as you fight against futuristic robots and drones in this arcade shooter. Each level puts you on a different planet to kill enemies, take down asteroids, and gather as many points as you can while listening to the level's featured song. Compete against your friends for the best score in the survival game mode to get your name on the leaderboard."}]}, "developer_name": "WonderSense Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1X22wcjKD6tT9sjzxa3leN8VH3gJMsGai97ceO_vfffg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "WonderSense Games", "support_website_url": null, "website_url": "https://www.wondersensegames.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "644354873106712"}], "external_subscription_type": "N
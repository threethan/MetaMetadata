2-wdss&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbD4nwunrF8BtJLPW3ywpW8m5NSRR0RYGFZcpLsjq7CA&oe=6B0851FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 x 1440 copy-1 (1).png", "id": "1373968550004905", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974594_1373968556671571_2926488797433788158_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3H_oHf-15oQ7kNvwGfdhLn&_nc_oc=Adq6180Td79toJEGSDO6sRFSTifkIpX5vRgV0TurQ_tiZ9yLnXOf-K6B5iBHXA0ZQ_0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc2aMNXYYDc1mSgfv_gkc-SfyFbuE7Mcg7mlzjjtyiZw&oe=6B0846A8"}, "display_name": "Planet Jumper VR", "keywords": [], "long_description": "Do you enjoy arcade shooters, sci-fi environments, and awesome music? You'll love this game!\n\nGo from planet to planet as you fight against futuristic robots and drones in this arcade shooter. Each level puts you on a different planet to kill enemies, take down asteroids, and gather as many points as you can while listening to the level's featured song. Compete against your friends for the best score in the survival game mode to get your name on the leaderboard.\n\nThis game includes 6 unique levels, an infinite survival mode, and multiple secrets hidden throughout the levels.", "short_description": "Do you enjoy arcade shooters, sci-fi environments, and awesome music? You'll love this game!\n\nGo from planet to planet as you fight against futuristic robots and drones in this arcade shooter. Each level puts you on a different planet to kill enemies, take down asteroids, and gather as many points as you can while listening to the level's featured song. Compete against your friends for the best score in the survival game mode to get your name on the leaderboard."}]}, "developer_name": "WonderSense Games", "developer_privacy_policy_url": "https://docs.google.com/document/d/1X22wcjKD6tT9sjzxa3leN8VH3gJMsGai97ceO_vfffg/edit?usp=sharing", "developer
cGVS603QPyv170NQ&oe=6A354BAC"}, {"file_name": "2023-01-26_16-34-26.mkv_snapshot_01.18.466_1440.png", "id": "3465087683770757", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974780_3465087687104090_5745773893023703044_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2XVEaqILZEQ7kNvwEK5HO0&_nc_oc=AdpSuTrBz61P9yGYQ_Rl3uP6Ki3xBkSZxzT33r_Kd0oteODNiTUm7PwvlXbdabMJga8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lj_HvT0rmQWskTX8mjJyduNfrb7Pf1lTDTW8WBCSAMQ&oe=6A3554E0"}, {"file_name": "2023-01-26_16-01-54.mkv_snapshot_00.25.826_1440.png", "id": "495260649347486", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974891_495260652680819_1612014108408918328_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_7GnEIaA-QQ7kNvwEpMscr&_nc_oc=Adoo8yqVbp5dGJxm51wl9p5XJUJb7L2ZGGKBy4peD1Nr0lno55yyM5qx3IV7eC9bros&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TyCVclrXcrcfRrd14a4A1PktL7zxKOVlME366qedUIQ&oe=6A3543C3"}, {"file_name": "2023-01-26_16-57-00.mkv_snapshot_01.20.540_1440.png", "id": "910860627004003", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974801_910860630337336_8867062962642311624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYPyhz_d7Y0Q7kNvwFvOA8D&_nc_oc=AdqRr_nTkXdOQrrnmsSpak0Y9yjZ1nb1GwgensOKl1v39LDKZ3O1yE4NfLq2JTMjyHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eseQEY8aUsvBnA-y4RfHMVb9VJglz9fEFUv-G6pEV7w&oe=6A356D7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Unification_release-trailer_thumbnail_quest.png", "id": "222585180139802", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003238_222585183473135_4209265122119070746_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSrMjzBQ8LEQ7kNvwEAi-k3&_nc_oc=AdrGKaOPD0dBtG0DXwCUDwwKuyK7S4ssIqNpJOFNg4R8PIddQ6_re_Met3NHGXZYijk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o0__fonGUaIdc8pEyJxHIgb36jpIMUQyZzkawVoeJAw&oe=6A356125"}, "display_name": "Unification", "keywords": [], "long_description": "Unification is a gravity-shifting VR parkour roguevania. Descend from the orbital factory into the layers of the black hole engine. Explore vibrant shifting architectures in a harmony of momentum and destruction... assuming you\u2019re able to overcome the traps and inhabitants in your path.\n\nFeatures:\n- Fluid and powerful physics-based movement: Feel momentum and the wind rushing past while leaping into chasms, vaulting over ledges, weaving around traps, and shifting gravity at will.\n- Kinetic tools propelling you forward: Swing above traps with a grappling hook, or glide past with a parachute. Go in guns blazing with a shotgun, or slice with a katana. Forge a new path with a jackhammer, or warp through with a teleporter.\n- Procedural destructible biomes filled with traps and enemies: Navigate through voxel cave obstacle courses with branching paths that test your reactions, knowledge, and control. Feel free to explore the depths and get lost. The handheld mini-map and conveniently placed teleporters make it easy to quickly get back on track.\n- Dreamlike upgrades: Push the limits of physics and imagination during the journey to the core with fundamental changes to the game mechanics\n- Carefully crafted controls and haptics: Each action is positioned on the controllers to allow effortless simultaneous usage of all movement and tool capabilities, inducing a flow state of control.", "short_description": "Unification is a gravity-shifting VR parkour roguevania. Descend from the orbital factory into the layers of the black hole engine. Explore vibrant shifting architectures in a harmony of momentum and destruction... assuming you\u2019re able to overcome the traps and inhabitants in your path."}]}, "developer_name": "Troy Spencer", "developer_privacy_policy_url": "https://gist.github.com/troyspencer/7c0c9a0f5b23daf767866b9416a145fd", "developer_terms_of_service_url": null, "publisher_name": "CrushPoint Games", "support_website_url": null, "website_url": "https://crushpoint.games/unification/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "594037376072421"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031410_902154230876115_3864919587216907606_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=91Z99GgXZHEQ7kNvwEwqYGP&_nc_oc=AdpbkeCJoLvXL1elkuuO_MLQwq5Wvk7F2wimrXJHKCmtIgpNbKx2MT4ky-lMDNBOrfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QjYOHMMdNGGOr4PsbwtGVPqI6kUgkA7fA0xvMmF36sA&oe=6A356A68"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unification", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1673028000, "lastRevision": {"nodes": [{"id": "2913332638947797", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4244393598953009", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4728819813796814"}, "iarc_email": null
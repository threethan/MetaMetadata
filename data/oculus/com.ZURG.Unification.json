01-26_16-34-26.mkv_snapshot_01.18.466_1440.png", "id": "3465087683770757", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974780_3465087687104090_5745773893023703044_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSMdg9d5IvsQ7kNvwFhGt4z&_nc_oc=Adp51QjQYXrpzyX5Ij6FZrl02oswkYPiO3HPK3dNNU7s76cO5qvG7wt6okU5rrrFfWo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0HJhoEsZ3Pd7D_-vnhAqcEg45a_oOzwxDCHAaDTu-M5Q&oe=69F21860"}, {"file_name": "2023-01-26_16-01-54.mkv_snapshot_00.25.826_1440.png", "id": "495260649347486", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974891_495260652680819_1612014108408918328_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLCPrr8NfHMQ7kNvwEwwYH0&_nc_oc=AdrcdK-flgs-Q5x3SoDPKBkIYw44wSJnJen5TpugmRSDomnuSG-gKCmy8q6w6YHJkpE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Sdj5alCEvpl-_6-Mpf8mqVDItMmNHaDz4-Hbjv3ZMbQ&oe=69F20743"}, {"file_name": "2023-01-26_16-57-00.mkv_snapshot_01.20.540_1440.png", "id": "910860627004003", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974801_910860630337336_8867062962642311624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Vo6wU6ai-4Q7kNvwGE7AbS&_nc_oc=AdpzgNnzlfH4-vbTMGEuojmq-Rq1AWJkrmlmyXbrRusJbaSTlYuosW4whXoXYVHdqQA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0H27LZ2lxYzlYozXki6-J0FJ75P6XzlB9G-Im6o17zDw&oe=69F1F8BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Unification_release-trailer_thumbnail_quest.png", "id": "222585180139802", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003238_222585183473135_4209265122119070746_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMb9R4LEacwQ7kNvwG7n9AN&_nc_oc=AdoJZuCGn7lJgUqDK5SmFxpH5tF2ACpkDQPjLpY_gL1tOxeHBlHXiJAE026c-XVT-dY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3nZsy6kGnVWtpatP0qwLW419NLq0B59Xo9qRs4r1ShBA&oe=69F1EC65"}, "display_name": "Unification", "keywords": [], "long_description": "Unification is a gravity-shifting VR parkour roguevania. Descend from the orbital factory into the layers of the black hole engine. Explore vibrant shifting architectures in a harmony of momentum and destruction... assuming you\u2019re able to overcome the traps and inhabitants in your path.\n\nFeatures:\n- Fluid and powerful physics-based movement: Feel momentum and the wind rushing past while leaping into chasms, vaulting over ledges, weaving around traps, and shifting gravity at will.\n- Kinetic tools propelling you forward: Swing above traps with a grappling hook, or glide past with a parachute. Go in guns blazing with a shotgun, or slice with a katana. Forge a new path with a jackhammer, or warp through with a teleporter.\n- Procedural destructible biomes filled with traps and enemies: Navigate through voxel cave obstacle courses with branching paths that test your reactions, knowledge, and control. Feel free to explore the depths and get lost. The handheld mini-map and conveniently placed teleporters make it easy to quickly get back on track.\n- Dreamlike upgrades: Push the limits of physics and imagination during the journey to the core with fundamental changes to the game mechanics\n- Carefully crafted controls and haptics: Each action is positioned on the controllers to allow effortless simultaneous usage of all movement and tool capabilities, inducing a flow state of control.", "short_description": "Unification is a gravity-shifting VR parkour roguevania. Descend from the orbital factory into the layers of the black hole engine. Explore vibrant shifting architectures in a harmony of momentum and destruction... assuming you\u2019re able to overcome the traps and inhabitants in your path."}]}, "developer_name": "Troy Spencer", "developer_privacy_policy_url": "https://gist.github.com/troyspencer/7c0c9a0f5b23daf767866b9416a145fd", "developer_terms_of_service_url": null, "publisher_name": "CrushPoint Games", "support_website_url": null, "website_url": "https://crushpoint.games/unification/", "category": "G
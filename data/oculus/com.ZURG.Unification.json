iBErukkrM-wK5FKg&oe=69FC9B2C"}, {"file_name": "2023-01-26_16-34-26.mkv_snapshot_01.18.466_1440.png", "id": "3465087683770757", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974780_3465087687104090_5745773893023703044_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBjKdo3bua4Q7kNvwHzAYWC&_nc_oc=Adry_R1A_JDEfaL3geC3n4IaFZl1IYyqBB5bha8GUrTFwmgLUP9M63dDxfZmXZVy7Ng&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FN0vVtn9e4YnYiIBdeVIgt5S14EW2DNAxk_Ji64MQLQ&oe=69FCA460"}, {"file_name": "2023-01-26_16-01-54.mkv_snapshot_00.25.826_1440.png", "id": "495260649347486", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974891_495260652680819_1612014108408918328_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hp7sPqdEo-QQ7kNvwHwSHFm&_nc_oc=Adrl2S_X-JnYlEDlpDxRn3KfbPHXxsIeUcd3s2TXlaYM-F27tBudJ0jUxN6vGPQtt7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KvIAV2bUc0F5g4IKjb_tln9v2-dNSOUjZPDfm9mTKeA&oe=69FC9343"}, {"file_name": "2023-01-26_16-57-00.mkv_snapshot_01.20.540_1440.png", "id": "910860627004003", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974801_910860630337336_8867062962642311624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulKKTIWvYZ4Q7kNvwFD2L4I&_nc_oc=Ado6ye8NPB8BFB1nH4Td0H5qr5DFapCUCgbHO7sNhqUjUQzk4cGxFYLhCYkEl4qxwa8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_VIQelJZGGeGuWduw6V6ZGrZ_K9x65Lf8XeYSA-0j1Q&oe=69FC84BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Unification_release-trailer_thumbnail_quest.png", "id": "222585180139802", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003238_222585183473135_4209265122119070746_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxGa_wwrarMQ7kNvwFL28tg&_nc_oc=Adp-J0vi6QHtP0S4v6-oI3dVRF9gnkvAzVhMvsHF0n_v-EX8VoSA2S5T6gjMxCVT9W8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HM-GkgrEIi6vH5P8SvxgBiAL9tOA2mvTt8bJIULIe2g&oe=69FCB0A5"}, "display_name": "Unification", "keywords": [], "long_description": "Unification is a gravity-shifting VR parkour roguevania. Descend from the orbital factory into the layers of the black hole engine. Explore vibrant shifting architectures in a harmony of momentum and destruction... assuming you\u2019re able to overcome the traps and inhabitants in your path.\n\nFeatures:\n- Fluid and powerful physics-based movement: Feel momentum and the wind rushing past while leaping into chasms, vaulting over ledges, weaving around traps, and shifting gravity at will.\n- Kinetic tools propelling you forward: Swing above traps with a grappling hook, or glide past with a parachute. Go in guns blazing with a shotgun, or slice with a katana. Forge a new path with a jackhammer, or warp through with a teleporter.\n- Procedural destructible biomes filled with traps and enemies: Navigate through voxel cave obstacle courses with branching paths that test your reactions, knowledge, and control. Feel free to explore the depths and get lost. The handheld mini-map and conveniently placed teleporters make it easy to quickly get back on track.\n- Dreamlike upgrades: Push the limits of physics and imagination during the journey to the core with fundamental changes to the game mechanics\n- Carefully crafted controls and haptics: Each action is positioned on the controllers to allow effortless simultaneous usage of all movement and tool capabilities, inducing a flow state of control.", "short_description": "Unification is a gravity-shifting VR parkour roguevania. Descend from the orbital factory into the layers of the black hole engine. Explore vibrant shifting architectures in a harmony of momentum and destruction... assuming you\u2019re able to overcome the traps and inhabitants in your path."}]}, "developer_name": "Troy Spencer", "developer_privacy_policy_url": "https://gist.github.com/troyspencer/7c0c9a0f5b23daf767866b9416a145fd", "developer_terms_of_service_url": null, "publisher_name": "CrushPoint Games", "support_website_url": null, "website_url": "https://crushpoint.games/unification/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "594037376072421"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031410_902154230876115_3864919587216907606_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfGF84k7-hkQ7kNvwGZ6vwn&_nc_oc=AdrHCCAD6oJzn-KgyIZ6qMXUjtIhIxLmle4GMnKC8gYEUvyhp3NBQMaTzBJSb-nui_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4E37kx3kKmbBszs3G8v8u_Yp8QIA34oMboA0_cFplEHQ&oe=69FC81A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unification", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1673028000, "lastRevision": {"nodes": [{"id": "2913332638947797", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4244393598953009", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4728819813796814"}, "iarc_email": null
wG5wT1n&_nc_oc=AdrALQfYj-iLvOQoyl4lmYMmeanVxuUzJ0Y9a5dOoTX1AEb_4wi1T9UvidI7y0J-I6w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc7UNfhcJQnt2h1wHZIsH50YuhpphjRjGzREb1k0qdxQ&oe=6A5B657E"}, {"file_name": "DD_4.png", "id": "621413143042193", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982491_621413146375526_1093358764251678158_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfUCv9Z0AIoQ7kNvwFy4HxI&_nc_oc=AdrlN5OxtdMcxbyYp2L0LSrNOrdVr50PDaBgZK-ayMSJgfkIOLsnhx3QFS4BZsaJurk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxS3EPNbynlJM0IH1I_Ywwbg_j-k7VHHne1RldJRtJlw&oe=6A5B7A4E"}, {"file_name": "DD_5.png", "id": "723776272644093", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035446_723776275977426_6882373117266150392_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ZQ-237HA40Q7kNvwG647Lw&_nc_oc=AdrVwbXKcqdzFsUDxsavrPl2o9lpdvszb0a1N4UGLdsgFFuaxIlZGXNH8yr_ZvrGbzQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7TZ_aYjnEdOV0qm40kKynBVuZI0usI6SfzjeVb5TwBQ&oe=6A5B6311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DivineDuel_VideoCover.png", "id": "554342616720334", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75451775_554342623387000_587836032314581877_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM2GsWA6QtoQ7kNvwECEIPH&_nc_oc=AdpdkWi8jBYP3ZRPknr1Afv_rj5zfb53WtgYbTm7q9fWPlZFo1QAbgx3rpkYPyoOq1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgpPZS5XyoA75bPo5E4TSKqY093KKvVENzdOMa45TrIA&oe=6A5B8AAB"}, "display_name": "Divine Duel Release", "keywords": [], "long_description": "Divine Duel is a tactical fighting game that mixes Fantasy and Sci-Fi themes to bring you a fresh take on PVP. Forget about ordinary weaponry and prepare to experience an outlandish arsenal that includes weaponized musical instruments, mythical creatures, and a meteor.\n\nThe game combines fast-paced gameplay with a strategic layer, rewarding players for quick thinking and creative ideas. Duel others in a never-ending struggle for the fate of the Multiverse and prove that you have what it takes to win the Divine Duel.\n\nThe glory is yours to take.\n\nFeatures:\n\u2022 Choose your Celestial and duel players from around the world in real-time\n\u2022 Use over 40 exciting weapons, spells, and summons (dragons included!)\n\u2022 Experiment with your loadout - drop a huge structure on your foe if you have to!\n\u2022 Level up and unlock useful boosters that can improve your fighting potential\n\u2022 Try multiple game modes - classical duel and card-games-inspired draft\n\u2022 Move or die - as simple as that", "short_description": "Divine Duel is a VR fighting game that mixes Sci-Fi and Fantasy themes with crazy weaponry. Step inside the arena and defeat your rivals using a combination of over 40 weapons, spells, and summons at your disposal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games", "support_website_url": null, "website_url": "https://www.divineduel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "748943376800407"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1375022840344674"}, {"status": "PUBLISHED", "id": "8935920846517290"}, {"status": "PUBL
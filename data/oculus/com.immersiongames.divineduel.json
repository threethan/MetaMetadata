aPOhePt4IViY90-k7ZAHQ&oe=6B005100"}, {"file_name": "DD_2.png", "id": "1840932986283218", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036614_1840932989616551_5744833253047701719_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XOg4hZV1UAQ7kNvwEpZPBp&_nc_oc=AdomVlSShW8wDL0djOBTmAsTvS-Khti-ldvGAE5TC7gpIOvL0dO7eTW9ieFM6IXHVXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeI6Oh--vyGtJ0jUFshpYBPnKL1eemNfJOJFP19c68Cg&oe=6B00693E"}, {"file_name": "DD_4.png", "id": "621413143042193", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982491_621413146375526_1093358764251678158_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7D90WKJly4Q7kNvwGXpi1F&_nc_oc=AdpuLnUwa94Pk0MoTdt_miXkb4DIva4dmrqWc73BKCaFWfPW4Uoc3lANDr936m4HyZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUen6HeudIKqrLZ7sKvcFJHXUJWsBKtI7eGCOZRt2QHQ&oe=6B007E0E"}, {"file_name": "DD_5.png", "id": "723776272644093", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035446_723776275977426_6882373117266150392_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2yxeSc7A80Q7kNvwElKu1v&_nc_oc=AdpgkKkL7MctMwrwAXgCRoIkReQbtP0VtAyxnRVCM34V-fOHnIdOx5aWEDr-VoFvGFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkD0TKE1Puz1s276tgBwRx7wE2tH-dVMvxEgsonHqeaw&oe=6B0066D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DivineDuel_VideoCover.png", "id": "554342616720334", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75451775_554342623387000_587836032314581877_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4og92lfnDEQ7kNvwFkVcQe&_nc_oc=AdpEUpjmYUN6vbOoOqYLGdUcU6_O9Viax5rVlX2Erkqumnq_UbTt7Wvzjwoyu23VvSY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpS0Dz5kQ5KYj0zWCCDWxKvAr4XXJx-HVsG2rDB9eEzQ&oe=6B00562B"}, "display_name": "Divine Duel Release", "keywords": [], "long_description": "Divine Duel is a tactical fighting game that mixes Fantasy and Sci-Fi themes to bring you a fresh take on PVP. Forget about ordinary weaponry and prepare to experience an outlandish arsenal that includes weaponized musical instruments, mythical creatures, and a meteor.\n\nThe game combines fast-paced gameplay with a strategic layer, rewarding players for quick thinking and creative ideas. Duel others in a never-ending struggle for the fate of the Multiverse and prove that you have what it takes to win the Divine Duel.\n\nThe glory is yours to take.\n\nFeatures:\n\u2022 Choose your Celestial and duel players from around the world in real-time\n\u2022 Use over 40 exciting weapons, spells, and summons (dragons included!)\n\u2022 Experiment with your loadout - drop a huge structure on your foe if you have to!\n\u2022 Level up and unlock useful boosters that can improve your fighting potential\n\u2022 Try multiple game modes - classical duel and card-games-inspired draft\n\u2022 Move or die - as simple as that", "short_description": "Divine Duel is a VR fighting game that mixes Sci-Fi and Fantasy themes with crazy weaponry. Step inside the arena and defeat your rivals using a combination of over 40 weapons, spells, and summons at your disposal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games", "support_website_url": null, "website_url": "https://www.divineduel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "s
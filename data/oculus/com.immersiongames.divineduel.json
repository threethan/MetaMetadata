NpYRjrzcokqA0YDYya_WQ&oe=6AFDAE00"}, {"file_name": "DD_2.png", "id": "1840932986283218", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036614_1840932989616551_5744833253047701719_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XOg4hZV1UAQ7kNvwEKXqBC&_nc_oc=AdoYsJ6BC_yJjIj_QFjCFg1Xfe4_7FX0xyP-gis8rgnfiQ-QBYKgeKOXwyY3U9rKkM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQn5t9OJSa_AkP6SiyR7GaF2j66mLUnPZfmQzcaE1C9w&oe=6AFDC63E"}, {"file_name": "DD_4.png", "id": "621413143042193", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982491_621413146375526_1093358764251678158_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJ2s2OE5Z3sQ7kNvwGHXCoE&_nc_oc=AdqChgQ-bErrd6ZNikBU7R5l5wZSKmHhYbHDtHQzC6t7yFGGAteYuTAp778O3B7w3QM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5Dj4g6rQoDsXA_u4ak4TShymVJDVodrAR6GnOFrzD2g&oe=6AFDDB0E"}, {"file_name": "DD_5.png", "id": "723776272644093", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035446_723776275977426_6882373117266150392_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7BYoBp3adsQ7kNvwEwvNDo&_nc_oc=AdrMTNVNCFPMxq8iUK0x0bdimZIZeRb9sPnTpZXcDDXHg5h-w91D0RC4SnLJFlBlfQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuSPed0V8TTW5pHQ279V5UaOEQ4BlaPQNDWsh7xctffg&oe=6AFDC3D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DivineDuel_VideoCover.png", "id": "554342616720334", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75451775_554342623387000_587836032314581877_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqU1wzrm_nkQ7kNvwGz_mKV&_nc_oc=AdpwHohqDNi7PD5QssiPUDNTFJHqhhNxHTPD8W0d6WF9ZR8OKB_VELMZ4ZmrDAwCWn4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHVVk7pbMZn0Ax3t0bBJ-fxrqNI12TnKWqdY2c8sLutg&oe=6AFDB32B"}, "display_name": "Divine Duel Release", "keywords": [], "long_description": "Divine Duel is a tactical fighting game that mixes Fantasy and Sci-Fi themes to bring you a fresh take on PVP. Forget about ordinary weaponry and prepare to experience an outlandish arsenal that includes weaponized musical instruments, mythical creatures, and a meteor.\n\nThe game combines fast-paced gameplay with a strategic layer, rewarding players for quick thinking and creative ideas. Duel others in a never-ending struggle for the fate of the Multiverse and prove that you have what it takes to win the Divine Duel.\n\nThe glory is yours to take.\n\nFeatures:\n\u2022 Choose your Celestial and duel players from around the world in real-time\n\u2022 Use over 40 exciting weapons, spells, and summons (dragons included!)\n\u2022 Experiment with your loadout - drop a huge structure on your foe if you have to!\n\u2022 Level up and unlock useful boosters that can improve your fighting potential\n\u2022 Try multiple game modes - classical duel and card-games-inspired draft\n\u2022 Move or die - as simple as that", "short_description": "Divine Duel is a VR fighting game that mixes Sci-Fi and Fantasy themes with crazy weaponry. Step inside the arena and defeat your rivals using a combination of over 40 weapons, spells, and summons at your disposal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games", "support_website_url": null, "website_url": "https://www.divineduel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "s
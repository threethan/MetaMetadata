yWAxy6skelL0gKEk35AWA&oe=6B087240"}, {"file_name": "DD_2.png", "id": "1840932986283218", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036614_1840932989616551_5744833253047701719_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh52Rs9WzeUQ7kNvwFdxMbT&_nc_oc=AdpwzXHFBw-kVFtvX76UowWHN4R-JBrugQVMVwbb5jVIAkDF5a4aSeASf7bSPx0XgQU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoCJTiYg34QhZfdIqbK_GWC9xtP5iBvk3A51YK3rS_yw&oe=6B08523E"}, {"file_name": "DD_4.png", "id": "621413143042193", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982491_621413146375526_1093358764251678158_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqigbH-t8jYQ7kNvwHv2hDu&_nc_oc=Adpj05CZLEW_1dZh-rM-YCkx40tAD09H-cBu5C0R3qEYjbqdgXmsRRsp2kMHMLZ3Kds&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV-VIE4z9HYYMUFUQlMbpLd4RuwHNC0-KUVZE34we9Tg&oe=6B08670E"}, {"file_name": "DD_5.png", "id": "723776272644093", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035446_723776275977426_6882373117266150392_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCoumLUCbs8Q7kNvwGUX922&_nc_oc=AdqPKxrbrNcC-AaDHPcio_y2BjPXxhnlLOrHgcFGi6QAaiSHrmvd-7dIja2Scj9XDCA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Pssqo30zBv_bhK3WeFsIHmk8pG6O6UY0ITPloANkhQ&oe=6B084FD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DivineDuel_VideoCover.png", "id": "554342616720334", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75451775_554342623387000_587836032314581877_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQCcenpylUYQ7kNvwG4OBjP&_nc_oc=AdreL2rB4W2-rsUC4XwI5ujrzI2iMcA2SqPSYtEssrI41_fxQLwOgx3phGecf-oEsH0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6LEB3uvMc7WRPHBpRKEJUFD0MiNG6xZ9C-ap6Bar9rA&oe=6B083F2B"}, "display_name": "Divine Duel Release", "keywords": [], "long_description": "Divine Duel is a tactical fighting game that mixes Fantasy and Sci-Fi themes to bring you a fresh take on PVP. Forget about ordinary weaponry and prepare to experience an outlandish arsenal that includes weaponized musical instruments, mythical creatures, and a meteor.\n\nThe game combines fast-paced gameplay with a strategic layer, rewarding players for quick thinking and creative ideas. Duel others in a never-ending struggle for the fate of the Multiverse and prove that you have what it takes to win the Divine Duel.\n\nThe glory is yours to take.\n\nFeatures:\n\u2022 Choose your Celestial and duel players from around the world in real-time\n\u2022 Use over 40 exciting weapons, spells, and summons (dragons included!)\n\u2022 Experiment with your loadout - drop a huge structure on your foe if you have to!\n\u2022 Level up and unlock useful boosters that can improve your fighting potential\n\u2022 Try multiple game modes - classical duel and card-games-inspired draft\n\u2022 Move or die - as simple as that", "short_description": "Divine Duel is a VR fighting game that mixes Sci-Fi and Fantasy themes with crazy weaponry. Step inside the arena and defeat your rivals using a combination of over 40 weapons, spells, and summons at your disposal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersion.games/game-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Immersion Games", "support_website_url": null, "website_url": "https://www.divineduel.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "s
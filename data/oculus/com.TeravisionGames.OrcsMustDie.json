14IW5wzbZOR_XtBFMhw&oe=6A819EAB"}, {"file_name": "Trailer-V3.00_01_03_07200.Still034.png", "id": "1214460297180020", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818916_1214460300513353_3602577242586209028_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX7yg0Sjt0cQ7kNvwFYVDId&_nc_oc=AdpOWIp8CL8PMFnq3ZsKzQRU5GZAjCVV6hzbgnNFA_XfiyHLPrqnzjM8NGfqj6AM7SY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0pu6QsdogRXs637Ck5D-0zJfLloM05lGkVVg0y79dSA&oe=6A8192E8"}, {"file_name": "Screenshot 2.png", "id": "1441341214038222", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491822883_1441341217371555_3405729337681733011_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMs2DHVy0fwQ7kNvwGfqjGP&_nc_oc=AdpTeJlkpD7cGybC3buc_G19JFoUxd2ocvxZzJwVhQwqmyfd0P-xFjbu-OLBMfTSRug&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHonL6J_HTbte3wVrKUAcHC4jZN4szDouvKP1kmHhXLUw&oe=6A818F19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-cover.png", "id": "2106009323268111", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499303746_2106009329934777_9212337123312059598_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1oGnQayCmYQ7kNvwGdzjpE&_nc_oc=Adpy-d3zrIF77gp4R7tgx6W7zWMMRCyYuppw1esXYri7Kkn-O_guX_KU0LWRPGZPwGM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEprcZQDkaVN6fPllf1Cn3JwG-HIVfqtSoaXbHtO4FtXw&oe=6A81AC4A"}, "display_name": "Orcs Must Die: By The Blade", "keywords": ["combat", "fantasy", "melee", "action", "humor"], "long_description": "# The orcs are back\u2014louder, dumber, and smellier than ever. And this time\u2026 they\u2019re in your face. Literally!\n\n**Orcs Must Die: By The Blade** brings the legendary trap-slaughter franchise into fully immersive VR. Become a War Mage and defend Stormwreck Island in an all-new story as rotten rifts unleash corrupted orcs. \n\n{2138213180338173}\n\nSwing swords, trigger trinkets, punch orcs in the snout, and set **ingenious trap chains** that rocket screaming orcs across the room.\n\nExplore epic fortresses, channel powerful magic, and experience the most up-close (and up-nose) orc-smashing action ever. Fight solo or team up in **2-PLAYER CO-OP** to build traps, heal rifts, and doom the greenskin hordes with style.\n{3583850891756232}\n\n**Mix brutal melee with comedic chaos.** Build deadly defenses. Become a legend.\n\nStormwreck Island won\u2019t save itself\u2026 and the orcs aren\u2019t going to punch themselves\u2026 Well, some might\u2014but you should help!\n\n\n{3396006790564956}\n", "short_description": "Step into the chaos of Orcs Must Die: By The Blade, the first VR entry in the beloved action-tower defense series! Fight hulking orcs face-to-ugly-face, smack them, launch them into lava, and unleash hilarious trap combos. Master melee combat, place ridiculous defenses, and team up in co-op to protect Stormwreck Island from rotten magic and rowdy greenskins. It\u2019s bloody. It\u2019s slapstick. It\u2019s gloriously chaotic. And it\u2019s all in your hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teravisiongames.com/site/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Teravision Games", "support_website_url": null, "website_url": "https://www.teravisiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": [
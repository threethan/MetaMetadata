=tEGZhB5sOlAQ7kNvwG2E8vO&_nc_oc=AdpWT8XndAHKUypSz1F_xPOZL4fvGNTAGUVtZHtFOekioB3ZObzBGcsfS8THJ4PVP5Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4tpU3SZJVhXfOS-I8ktx1oNPWdbPOuIQoniG4fnOPeg&oe=6AE1EA43"}, {"file_name": "04-playback-umthatha.png", "id": "1626390792291558", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619382_1626390795624891_8102318949456754630_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9bPptSoeVUQ7kNvwEhuEqE&_nc_oc=Adp6AvDrkzPMBVLehGQqVlSgqI54QyBeasuoUeD3UV8HntEHvUbrlJKeqk1nz4PINBI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwfYj_h3g5Q4TIR9bPHPwlVoD6rHFasfVMq5OyTANWlA&oe=6AE21576"}, {"file_name": "02-detail-bo-kaap.png", "id": "2145521026356037", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499627502_2145521029689370_8512080503116758164_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3qbX4gKTR7MQ7kNvwFJxtDE&_nc_oc=AdpU7jLQbfOwfu-sy-5Mea_ktpy7urJXmPDLULeY1aCcAONV1sf3g7XX_8REWz3ofx0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK3TrJUDRBg6HGnYSkdDAII6Bn9jqdgyDW-wTXykk_-A&oe=6AE214AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Eutoria - Immersive Media Player", "keywords": ["Eutoria", "VRPlayer", "MediaServer"], "long_description": "# Eutoria \u2014 Immersive Media Server Player\n\n**Your media library, in VR on Meta Quest.**\n\nEutoria is an unofficial media client for Meta Quest. Built with Meta Spatial SDK and Jetpack Compose, it brings your self-hosted media library into a spatial VR interface: sign in, browse movies and shows, open episode details, and start playback without leaving your headset.\n\nEutoria is compatible with Jellyfin servers. Connect to your own server, then browse movies, shows, seasons, and episodes; view posters, synopses, and media details; and play videos directly in VR.\n\n**Playback**\n\nPlayback is powered by Media3/ExoPlayer and optimized for Qualcomm XR2 hardware decoding, helping deliver smooth video performance on Meta Quest.\n\n**Key Features**\n\n- Connect to your own Jellyfin-compatible server\n- Browse movies, shows, seasons, and episodes in VR\n- View posters, synopses, and media details\n- Play videos with Media3/ExoPlayer and XR2 hardware decoding\n- Spatial interface designed for Meta Quest\n- Integrated sign-in, library, episode details, and playback\n- Your media stays on your server; Eutoria is only the client\n\n**Compatibility & Requirements**\n\n- Meta Quest\n- A Jellyfin server and compatible media\n- Network access to your server\n\n**Note**\n\nEutoria is a third-party, unofficial client. It is not affiliated with, endorsed by, or sponsored by the Jellyfin project. \u201cJellyfin\u201d is used only to describe compatibility.", "short_description": "Browse and play your media library in VR on Meta Quest. Compatible with Jellyfin servers. Unofficial client; server required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Euphorill/eutoria-player-privacy", "developer_terms_of_service_url": "https://github.com/Euphorill/eutoria-player-terms", "publisher_name": "Euphorill", "support_website_url": "https://github.com/Euphorill/eutoria-player-privacy", "website_url": "https://github.com/Euphorill/eutoria-player-privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_HK", "zh_TW", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
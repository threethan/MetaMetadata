757_1087498780927692_6093678602908700158_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3_jeoLcUHsQ7kNvwGREf7m&_nc_oc=AdqUb1sA-nMJJu_246N9je5YcB8_jzeFU84abeyormmwXVifozaFV-Uo5E5l7WbPCY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMrK8-hb3GyrmzvVU4kfLVCswU8H0GoIQ9tbrcmywg_A&oe=6AF7466F"}, {"file_name": "3.png", "id": "1403901371904893", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823279_1403901375238226_3672092229827160176_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-5OKr2OrtQQ7kNvwHOpYuu&_nc_oc=AdrHUCMKwtAci7x-Jz2cpwdq2EemPEkSG9F2lIqe0FjhmOnIOx3uCMFBXZCSpvb1y8k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0BWuJ5AS1oqhNBQgGNXA2VI_JM8DhiIcwRmFgZNwe0A&oe=6AF73759"}, {"file_name": "7.png", "id": "1738733367203998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_1738733370537331_5828554505386600494_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6meooy7GoC0Q7kNvwELz5Jq&_nc_oc=Ado2mv1AlutnQclfuYmu9YH1hOp1MzGg7EDfH01d6Of0aB1sG69t-ZbV-uAowMkO3zY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdJn0gLesWZvgLgntCkdMBkY3s3FUEKssI9PSPCCZzsg&oe=6AF714ED"}, {"file_name": "8.png", "id": "2307700076638935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821796_2307700079972268_5975977836809654142_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jD1VlkDIDsQ7kNvwGmNOK_&_nc_oc=Adr1TakviAKc45mBegVBCTmkx00qrP3Ctan7b4QV_wDlfRXLzFp5PBRVXKM99vT9jfQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmaPQgEQAj8qtPp4pK9e9_b43Y7uz4wAWLbVdAtJGHtA&oe=6AF717C0"}, {"file_name": "6.png", "id": "1050121254728187", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824700_1050121261394853_1046449654294316910_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3ZZStzwtl4Q7kNvwEqps1g&_nc_oc=AdpO8Q4AAr3LeFOaqtIKTmjnCKo_nnEHY1f0x4QGIK7X1cTh3MnOFicFwdv-leiVxNE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnrqCVYQdrXbpLKO-bmz2H70mQW2DV7IDF3GpQCBKHPg&oe=6AF747DF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pop N Ride - VR Roller Coaster", "keywords": ["RollerCoaster", "FunRide", "BaloonPooping", "MotionRide", "FunGame"], "long_description": "Get ready for an exhilarating adventure with a playful twist in Pop N Ride \u2013 VR Roller Coaster! This isn\u2019t your typical roller coaster \u2013 while you're speeding, twisting, and turning through scenic tracks, your mission is to pop as many balloons as you can!\n\nArmed with virtual tools and quick reflexes, you\u2019ll aim for colorful balloons floating all around the track as you race through exciting environments. With every pop, you rack up points and push your coordination to the next level\u2014all while enjoying the thrills of a roller coaster in immersive VR.\n\nPerfect for casual players and thrill-seekers alike, Pop N Ride combines the excitement of a coaster with the satisfying fun of balloon-popping action. It's easy to pick up, fun to replay, and guaranteed to bring smiles and adrenaline rushes!\n\nKey Features:\n\nImmersive VR roller coaster experience\n\nFun balloon-popping mechanics while riding\n\nColorful and dynamic tracks\n\nGreat for all ages \u2013 family-friendly\n\nCompete for high scores and master your timing\n\nPop, Ride, Repeat \u2013 Experience the ultimate VR joyride with Pop N Ride!", "short_description": "Pop N Ride \u2013 VR Roller Coaster is a thrilling ride with a twist! Speed through dynamic roller coaster tracks and pop colorful balloons along the way. Test your reflexes, aim, and timing in this fun, fast-paced VR experience for all ages!"}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_ta
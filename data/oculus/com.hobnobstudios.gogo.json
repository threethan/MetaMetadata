=6B0858E9"}, {"file_name": "Ads\u0131z tasar\u0131m (1).png", "id": "1589403068748080", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819982_1589403072081413_1579771152714421319_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj7lojnxA9YQ7kNvwGOiRRz&_nc_oc=Adot5u37HzI7vKzftOjZ2Dn55MUp6y6UoH48hOqokByC8wfmaA_w3l2PWL0ZhKQ2jJs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl5KKJZpY8o6zahkL2P6dx4ppLrTSOcBpf-Tt92OC5aQ&oe=6B086D31"}, {"file_name": "Ads\u0131z tasar\u0131m (2).png", "id": "4266693033576529", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823286_4266693043576528_3156404355754471008_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtXS96SeP98Q7kNvwFr5I2p&_nc_oc=AdoSzTRmLjDg-KSB24QRH5CXNUF2E-9k9Fen4TDqH40DwWgsWaUqAm7aVHkDBV8TiRc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjAXRSpexBTvz-Z1KDf4B1NClnQ-Ixfh9fwGexzz9aRA&oe=6B085E7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "865848829380242", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823271_865848832713575_4995527471215978700_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1qUu1-IC3sQ7kNvwHWPOrj&_nc_oc=AdpQXOdwiyXMjGaHRrpH1LuHVCxMkksnKI2rw92GDJPhCUkQaKvSz85H4dV--yyfTSY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7aJjvOT6Ap8_4Ss5WT6czhysBqRbN_LPCtOLNW3wV_g&oe=6B08427A"}, "display_name": "GoGo VR - Hide and Seek", "keywords": ["Hangout", "Competitive", "Friendly", "Games", "Action"], "long_description": "GoGo is an exciting, fast-paced arcade game that challenges your reflexes and timing skills. With simple one-tap controls and increasingly difficult obstacles, every second counts as you dash forward in a vibrant, ever-changing world.\n\nYour goal is simple: survive as long as you can while dodging obstacles, making split-second decisions, and collecting points to rise on the leaderboard.\n\nDesigned for players of all ages, GoGo combines addictive gameplay with colorful visuals and energetic sound effects. Whether you're looking for a quick play during a break or an intense high-score chase, GoGo offers endless fun and challenge.\n\nCan you keep up with the pace? It's time to tap, react, and GoGo!", "short_description": "GoGo is a fast-paced reflex game. Tap, dodge, and react quickly to survive and climb the leaderboard!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hobnob-studios/ana-sayfa/gogo-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HobNobStudios", "support_website_url": "https://discord.gg/DfKUcTTufz", "website_url": "https://sites.google.com/view/hobnob-studios/ana-sayfa?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26202969559329444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823351_1308659921198462_2049540849538648569_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLUCIpYJKtcQ7kNvwES43zY&_nc_oc=AdpYJfY_NGlWjgSA_r--CZRu9Y03tdc_sMW8t41-e54TjzmXH_XuXOjUNbJGF6ZTU7k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh
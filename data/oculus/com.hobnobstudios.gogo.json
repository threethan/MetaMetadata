=6B0EF069"}, {"file_name": "Ads\u0131z tasar\u0131m (1).png", "id": "1589403068748080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819982_1589403072081413_1579771152714421319_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zu3ImuQnC2oQ7kNvwEtH_i0&_nc_oc=Ado4-dlNPpcg21vQMdVhfQbHZgQ0HDWt9tNdw8wY58eMAN4U1Ys47dI6vXvHU1Vwttc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU3Hy4aYK19wOLcvgKVVaRzhcV9lsIq5qu0Vf5oZCbOvg&oe=6B0F04B1"}, {"file_name": "Ads\u0131z tasar\u0131m (2).png", "id": "4266693033576529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_4266693043576528_3156404355754471008_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbhJk6NIijAQ7kNvwGkurHj&_nc_oc=AdoZYBa9BFKP5UWdlKr4fi1rJXE_0kVEcjbMNfMkSxO05CnSlQJ_uQAhtctjOZ6FLQY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXA_n3Ya5vJjvM7W7qld1cT771RYMswNSN9x04Ahc8usg&oe=6B0EF5FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "865848829380242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_865848832713575_4995527471215978700_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtMkQLmqGKMQ7kNvwG6ntus&_nc_oc=Adq_Vbe4Q9sxYNgg9cC9cYWMtuJS3D_vzcue8QAgilx1YsRM81ZMjv_MtWROFdkLrpU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVr7zdXVvgXjHS6dnY2ewx8D4N-kb8k2xIiJhYqI7cLhg&oe=6B0F123A"}, "display_name": "GoGo VR - Hide and Seek", "keywords": ["Hangout", "Competitive", "Friendly", "Games", "Action"], "long_description": "GoGo is an exciting, fast-paced arcade game that challenges your reflexes and timing skills. With simple one-tap controls and increasingly difficult obstacles, every second counts as you dash forward in a vibrant, ever-changing world.\n\nYour goal is simple: survive as long as you can while dodging obstacles, making split-second decisions, and collecting points to rise on the leaderboard.\n\nDesigned for players of all ages, GoGo combines addictive gameplay with colorful visuals and energetic sound effects. Whether you're looking for a quick play during a break or an intense high-score chase, GoGo offers endless fun and challenge.\n\nCan you keep up with the pace? It's time to tap, react, and GoGo!", "short_description": "GoGo is a fast-paced reflex game. Tap, dodge, and react quickly to survive and climb the leaderboard!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hobnob-studios/ana-sayfa/gogo-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HobNobStudios", "support_website_url": "https://discord.gg/DfKUcTTufz", "website_url": "https://sites.google.com/view/hobnob-studios/ana-sayfa?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26202969559329444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_1308659921198462_2049540849538648569_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGSoTAyVE6UQ7kNvwFwB9Fh&_nc_oc=Adq48yFNmFKvjmJB6GzUrRqT4eezN6KIGNYCuU-Ha785iMtf80oUMlePegscHivGxzs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh
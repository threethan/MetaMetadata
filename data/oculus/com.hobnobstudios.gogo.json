=6B070769"}, {"file_name": "Ads\u0131z tasar\u0131m (1).png", "id": "1589403068748080", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819982_1589403072081413_1579771152714421319_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj7lojnxA9YQ7kNvwET2QPd&_nc_oc=AdpKdDMY3CiMiKOQre1qS5DgqlQad7HDUSVImqt8yX2fXAj8isk-xNcZzi5NYDVzOr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4AFdBScWrSJt_DOkabs8xtohM_qqO6IfL4D63IAxk0g&oe=6B071BB1"}, {"file_name": "Ads\u0131z tasar\u0131m (2).png", "id": "4266693033576529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823286_4266693043576528_3156404355754471008_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtXS96SeP98Q7kNvwGU9eOo&_nc_oc=Adoo405cx9aYZDx_UYcJjPsI0t2xK2VhskEcQlf7ZRuBTPKuhZXWLZffkGZ52ZkfMvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXJ3tJEyokaWN3OceTkuA_e0bMYkTKNQ7futkGgIU3nQ&oe=6B070CFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "865848829380242", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_865848832713575_4995527471215978700_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A1qUu1-IC3sQ7kNvwF3HpwP&_nc_oc=AdpXnOyqgIgWHwEs05ZWEtRhsLuEnMDKqM1IpsVusHJgLs5czMA3JQNhldMAO_VchHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNVc9f8n-dND2DQEnq9At3j3ttCvcmdH3kuqLlZp_3XQ&oe=6B07293A"}, "display_name": "GoGo VR - Hide and Seek", "keywords": ["Hangout", "Competitive", "Friendly", "Games", "Action"], "long_description": "GoGo is an exciting, fast-paced arcade game that challenges your reflexes and timing skills. With simple one-tap controls and increasingly difficult obstacles, every second counts as you dash forward in a vibrant, ever-changing world.\n\nYour goal is simple: survive as long as you can while dodging obstacles, making split-second decisions, and collecting points to rise on the leaderboard.\n\nDesigned for players of all ages, GoGo combines addictive gameplay with colorful visuals and energetic sound effects. Whether you're looking for a quick play during a break or an intense high-score chase, GoGo offers endless fun and challenge.\n\nCan you keep up with the pace? It's time to tap, react, and GoGo!", "short_description": "GoGo is a fast-paced reflex game. Tap, dodge, and react quickly to survive and climb the leaderboard!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/hobnob-studios/ana-sayfa/gogo-vr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "HobNobStudios", "support_website_url": "https://discord.gg/DfKUcTTufz", "website_url": "https://sites.google.com/view/hobnob-studios/ana-sayfa?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26202969559329444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_1308659921198462_2049540849538648569_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Wkqhkj99IcQ7kNvwE-sEMT&_nc_oc=Adp32OB38v8hDNfDbZD_r-4vvvBikOlAmwcM9hgYVdOFsQB5azWdj7OurMB3d5mhOp8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh
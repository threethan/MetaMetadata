FC6BDD"}, {"file_name": "25.png", "id": "3788937731247518", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823940_3788937734580851_628870562278519704_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6RVoGfDG0kQ7kNvwFeBvC0&_nc_oc=AdrUCVmx504Z-uErRnZRqcuneYDxi0xwNqf7LBrzj_kOPKkOofw91dhSKww6ksHT41Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaF4_FA2Ag9Jieuxz4sXeWu_KX-b8bmz7NitC1SYS8sQ&oe=6AFC7474"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TCG Card Shop Simulator - Supermarket 2", "keywords": ["supermarket", "simulator", "shop", "superstore", "manager"], "long_description": "# TCG Card Shop Simulator \u2013 Supermarket 2\n\nVR Shop Management\n\nEver dreamed of running your own store? Step into an immersive virtual reality shopping experience and discover the fun of managing a unique trading card business!\n\n**TCG Card Shop Simulator** combines the excitement of collectible cards with the fun of shop management simulation. Explore your virtual store, organize products, manage your business, and experience the satisfaction of building your own retail empire.\n\n## Run Your Own Virtual Store\n\nTake on the role of a store owner and experience the daily challenges of running a retail business. From organizing products to managing your shop, every detail brings you closer to creating your dream store.\n\n## A Fun Shop Management Experience\n\n* Explore an immersive VR store environment.\n* Organize and display collectible trading cards.\n* Discover colorful card packs and retail products.\n* Experience the fun of a business management simulator.\n* Build and manage your virtual shop.\n* Enjoy an engaging first-person VR simulation experience.\n\n## For Fans of Simulation Games\n\nIf you enjoy supermarket simulator games, retail management, business simulation, or trading card collecting, this game offers a unique virtual reality experience centered around the world of collectible cards and shop ownership.\n\nPut on your headset, step behind the counter, and start building your own virtual retail business!\n\n**Are you ready to become a shop owner?**\n", "short_description": "Run your own virtual supermarket in immersive VR! Stock shelves, manage your store, serve customers, and grow your dream business in TCG Card Shop Simulator.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/namigamesstudio/privacy-policy/meta-quest-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Nami Games Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/namigamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1272999462566887"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1298355896697910", "version": "1.0"}, "id": "1440284737960806", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1272999455900221", "is_concept": false, "latest_
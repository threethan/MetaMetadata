dn.com&_nc_ss=7f20f&oh=00_AQFe0vK1FSieAURrnDAKoX5BmTmqcZDicAPM3ueNzCil4w&oe=6A8EE533"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Project_3.png", "id": "1686683892204452", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391893_1686683895537785_2742684447871003937_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRA_zJQ6NeYQ7kNvwFGEdlC&_nc_oc=AdrFdlUrCv3OGj3fzt3_PhSX1WbAS-JFSKEce0cyKrjuAlVyveEWRcQdTLTtM-uTbg0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDG7_8_rloXvWVnY1_ig7W2bLKkO3LgKUJgh8rinzosg&oe=6A8EDA29"}, "display_name": "Monkey Hub VR", "keywords": ["MonkeyHub"], "long_description": "Welcome to Monkey Hub VR!\nMonkey Hub VR is an immersive social hub with tons off fun game modes and maps such as Monke Games a crab game inspired game mode featuring unique Korean children's games or the horror mode were you break into the subliminal side of Monkey Hub VR and fight the mysterious entities.\n\nExperience a world like no other with not just your self but up to 10 players. Monkey Hub VR is a huge world with much to offer and is a place for everyone to let out there inner monkey! \ud83d\udc35 \n\nWith immersive VR gameplay, chaotic fun, and high-stakes challenges, Monkey Hub VR will push your skills to the limit.", "short_description": "Welcome to Monkey Hub VR!\nMonkey Hub VR is an immersive social hub with tons off fun game modes and maps such as Monke Games a crab game inspired game mode featuring unique Korean children's games or the horror mode were you break into the subliminal side of Monkey Hub VR and fight the mysterious entities.\n\nExperience a world like no other with not just your self but up to 10 players. Monkey Hub VR is a huge world with much to offer and is a place for everyone."}]}, "developer_name": "SpokGamez", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-hub-vr-policy/home", "developer_terms_of_service_url": null, "publisher_name": "Spokes", "support_web
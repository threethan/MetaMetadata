1958_973605031391271_5772193790674601249_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_6RvT4FfKMQ7kNvwHF97DK&_nc_oc=AdpM2JYkwFc_EFuHWByiny0FWAa363VsHc9T4vifvW0nCCXKievbC6adx8Tm9AHsqhQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Bs1O6nZ9E8vHjVWCsuEhzghhRWqYn3V4--a69gRTAhw&oe=6A1ED5B3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Project_3.png", "id": "1686683892204452", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391893_1686683895537785_2742684447871003937_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubzyr3lSIWEQ7kNvwEceBKF&_nc_oc=AdqJk5NTUwHJh5x1ec1CGYk_fFb81NE0P2y0ch0Lyxd_OaO9HZUUc8Ljp0N5htNhW_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dmpgbmrCTiU8ARuYNvKSO_xd2yN2uVmLAUgq2e5zsxw&oe=6A1ECAA9"}, "display_name": "Monkey Hub VR", "keywords": ["MonkeyHub", "Tag", "Gorilla", "Monkey", "Fangame"], "long_description": "Welcome to Monkey Hub VR!\nMonkey Hub VR is an immersive social hub with tons off fun game modes and maps such as Monke Games a crab game inspired game mode featuring unique Korean children's games or the horror mode were you break into the subliminal side of Monkey Hub VR and fight the mysterious entities.\n\nExperience a world like no other with not just your self but up to 10 players. Monkey Hub VR is a huge world with much to offer and is a place for everyone to let out there inner monkey! \ud83d\udc35 \n\nWith immersive VR gameplay, chaotic fun, and high-stakes challenges, Monkey Hub VR will push your skills to the limit.", "short_description": "Welcome to Monkey Hub VR!\nMonkey Hub VR is an immersive social hub with tons off fun game modes and maps such as Monke Games a crab game inspired game mode featuring unique Korean children's games or the horror mode were you break into the subliminal side of Monkey Hub VR and fight the mysterious entities.\n\nExperience a world like no other with not just your self but up to 10 players. Monkey Hub VR is a huge world with much to offer and is a place for everyone."}]}, "developer_name": "SpokGamez", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-hub-vr-policy/home", "developer_terms_of_service_url": "https://mhvrtos.my.canva.site/terms-of-service", "publisher_name": "Spokes", "support_website_url": null, "website_url": "https://mhvr.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9569857763076644"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391998_1155460796163245_5139862569660055667_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfTNr_JC_DgQ7kNvwGZ2Ld3&_nc_oc=AdpbNXPhomK7f2USgV-dkEk4Jw_YgXUu8u_C3hWf8uDHZSE9ET0T8dM7KaKU5F-ZkD4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uj5aZg-PGC-j1jL7liKT457Taxk23cXRYaC_k5kgZGg&oe=6A1EDB06"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Hub VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1739481360, "lastRevision": {"nodes"
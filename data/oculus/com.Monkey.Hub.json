1958_973605031391271_5772193790674601249_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Vle46QUndkQ7kNvwHnTftS&_nc_oc=AdphbETCEvxS8XdghHB45IOaVrd-_dXDIZi3hPU602CtD6G4HLYHcvrxDAOAi6pdY54&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0ArLTwampdXt8xmBWAoNaf1-CMKSafCCnmxg6KveKmw&oe=6A426E33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New_Project_3.png", "id": "1686683892204452", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391893_1686683895537785_2742684447871003937_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94qQkjZJ5CUQ7kNvwGSzyUf&_nc_oc=AdpgZt9sjCc2t2mB6VI9yKT7I7lT3-eyQ3SekuPWQwvQz5Vv3OQzHMer_V6pSSquH0Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WDHYoV9QaePF9bilDa_POiP68IvHCNAAFpwI14OK2CQ&oe=6A426329"}, "display_name": "Monkey Hub VR", "keywords": ["MonkeyHub", "Tag", "Gorilla", "Monkey", "Fangame"], "long_description": "Welcome to Monkey Hub VR!\nMonkey Hub VR is an immersive social hub with tons off fun game modes and maps such as Monke Games a crab game inspired game mode featuring unique Korean children's games or the horror mode were you break into the subliminal side of Monkey Hub VR and fight the mysterious entities.\n\nExperience a world like no other with not just your self but up to 10 players. Monkey Hub VR is a huge world with much to offer and is a place for everyone to let out there inner monkey! \ud83d\udc35 \n\nWith immersive VR gameplay, chaotic fun, and high-stakes challenges, Monkey Hub VR will push your skills to the limit.", "short_description": "Welcome to Monkey Hub VR!\nMonkey Hub VR is an immersive social hub with tons off fun game modes and maps such as Monke Games a crab game inspired game mode featuring unique Korean children's games or the horror mode were you break into the subliminal side of Monkey Hub VR and fight the mysterious entities.\n\nExperience a world like no other with not just your self but up to 10 players. Monkey Hub VR is a huge world with much to offer and is a place for everyone."}]}, "developer_name": "SpokGamez", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-hub-vr-policy/home", "developer_terms_of_service_url": "https://mhvrtos.my.canva.site/terms-of-service", "publisher_name": "Spokes", "support_website_url": null, "website_url": "https://mhvr.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9569857763076644"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391998_1155460796163245_5139862569660055667_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=js9HxARaSakQ7kNvwFffHVU&_nc_oc=AdrrR5_fZbI9K43kD6y66zEHH8aNy-oDUfy6jR5VycyiOv1kgDUQKDjkcX37FS_p6o0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YvH7ObHpVyEUwkMJuzUQ9eewrUh171T4E92dgTEXWbw&oe=6A427386"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Hub VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1739481360, "lastRevision": {"nodes"
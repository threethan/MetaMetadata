nc_ohc=c07YnTdu_JoQ7kNvwEoN-KL&_nc_oc=Adod_eMiP9Z-n2uulSF8BP8SSNOVRx0icObrKry-AYRfuQs-aL9ctrdM5ZwjWAZhcOs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNprebhkza24N_eo504_49knrOgjqJpewl6T5znQEOBg&oe=6A5B736E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDwyU8GimC0Q7kNvwEzxRC_&_nc_oc=AdoQoeNQz-ioAZYkgvncCfXPxhJnYnHboj25KeAQWyANacekCn07A7b5iDyycHPUUfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-R7vElanKDSjn-MxJlVHgZjwGmK5V0NxuKyxO3KT0iA&oe=6A5B9664"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6J6dkPFDNcQ7kNvwFcoxKm&_nc_oc=AdpPwc2qhp1A3ohxARsjwIKiDBn1fJByMKABF_0MNmn6F-eTGYNfEiYbwfAjZDmzOOo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiKkeTn_cz4MXzLZw0iydxlflLjjJhS7ZJ4VygA6XdfA&oe=6A5B61B9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_91h8SZDgoQ7kNvwHTFUut&_nc_oc=Adqh3K6hylkmldrblWJ-d5r7SkSaDczbU3qOL6JHtNZWg2hZ0gVZXz5RKWbePuy3F5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcdUO91vbysrIBktBCL-38m7XEX8YXJHavI7zzF0XleQ&oe=6A5B840B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DfCjTAtItMQ7kNvwH27m_V&_nc_oc=AdpyeQHhW9BWF4VLcamb_JHRmFSFgOKTPQin8IJHXJcqBB-znJK4RXxP-b9AtUSO2Xo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjWMIS7iW0EjVPiDoO9Es5zaj5Q_5MvImN1-PoFqTp8w&oe=6A5B6E49"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
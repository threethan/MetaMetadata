wEOO5kV&_nc_oc=Adr4goOBRpqi84rFJB2dw9EStOqglN_NmMu4X-RRSwYnYWvPhXJ6JZMFeyFmXCnSJyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59L7GWHChq7LqMPhsss6nhCzNvXoRWIAFxjPl4R10opQ&oe=69FB58E4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EF3f0rLiH6cQ7kNvwG5e8gB&_nc_oc=AdondXENFKgRLljKaC4kuAf6Y_KnIcZAYo53_giK-yuaxBGgV9oB8sMYBqEr13GoBf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72fVnqiTRyE3mIYeWYm-hiJ2YOYRSzHpIv7h3rFZHbDQ&oe=69FB5C79"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-e36iHpKpcUQ7kNvwE8YXgd&_nc_oc=AdrcPgnW-GZdiKbXLILLq5hV07dkpZJP29tlPhqeLW3_nY3-endb2_KLQ37TdN-v_0A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zPzzdG7RII0hxBk-4FnXDCZicV4PH41udyqErVdV2IQ&oe=69FB468B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DIprFMJXpQgQ7kNvwFuJ_pJ&_nc_oc=Adr6YvQYENmyqT4aZLff8VuejIk0d6x2PyB31wa6X40g6D0Cqegm5W5y2L4QEZe2xxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JzxGPGSoVB_7NFUjIQzhOlasdTuOzyt4QAp2GwDmpeQ&oe=69FB30C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2058949310950990"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1128126651013165"}]}, "baseline_offer": {"id": "1128126651013165"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1627668480, "status": "PUBLISHED", "id": "1128126651013165"}
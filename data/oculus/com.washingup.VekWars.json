0a&_nc_ohc=YFqp5K2xmNkQ7kNvwERkDdz&_nc_oc=AdoiEAY9k_ga1iRsQF0STaQ4VwlsOa3uj_o_h5CSd4DtymYEXMhEWDpNVWnEB4s66U0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-w4sUMR-0_ZdOYC1h2iLho-XSWZJOyor9m0khDhWNrAw&oe=6A22FB2E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhSnbd1NSBwQ7kNvwFkljFC&_nc_oc=AdorKgmW2jKEOeOZSWk1V07JNCkNRMKvPTtNBYqxQpri0vYR1w9rsrIiGX3L9vQF3yk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EofTcC-P_EjYmvU0ix1KyI5zBVlS3pmUN5-HL2Yc-lw&oe=6A22E5E4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDQCxoWaIfIQ7kNvwEXZC-l&_nc_oc=Ado_AwFSFeMK0QU8rb5pROaRYdWrp3KyrCyc5QK-F7r5kSGdoSB4hQC2YjLHbtrQoWU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HbUIff9axZz3cyoKo3jVfTD1jkxJ7rfWbe0z10cJEWA&oe=6A22E979"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke1z9MnvfGkQ7kNvwGXpAyv&_nc_oc=Adom43FR6ESXbcaRLimTCu5BlWrUViOgd5WxmBQTIIKPucXaMsa5Q3OgueFBdt9-jwU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vAnoV_W1UZjLX41lq1QCkfp_PR9qWxbEKZlNjhu-vQQ&oe=6A22D38B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpTsGrKQqVEQ7kNvwHr7b52&_nc_oc=AdpOukhEtYYOriH9k6uiDeFxlFTjXwbBhJwRv6olRouqnxRfWBJ1YwJkhwZsvUEmgJY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ypikPORKNaxi2QMC8B1OO6HJFHSI-xz7FWnmS3IjICw&oe=6A22F609"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
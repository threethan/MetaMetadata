nc_ohc=oH-biQY8HvYQ7kNvwFImq15&_nc_oc=Adpc5Ywe4RwJ75wJ3hxMTAkakThtCZQaoIg4_3_Zb1sWHRzv7IJQbl3fvnN8_PIIp1w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HDEdGV5_Zn_5bCmcW5J6xW1HlUVuzgqbfeh9jnG_k8Q&oe=6A0EFC6E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGlmBrdk0PgQ7kNvwFUy58E&_nc_oc=Adr6sK_SKIn6jEllO78BgJHdr4kSAJ7dU4ldSxODX280Tl6SJbeKI9wCYpommOu1XWs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VyFr9Pgo5ONbRQ77pvgKLnGDXlb-8FgluTabvu0ZYXA&oe=6A0F1F64"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=POgVmMHu9swQ7kNvwG3NBvO&_nc_oc=Adr716LcffhcRaUKtFSuE0KRLBoTxF6VDS6fyYH5IQmFe6Poa27fRB08U3cPIAos5dw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L4hw793JbLipcUbuA8AJlM34O98uKFXRV97CQrwiKcA&oe=6A0F22F9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2hUS9CH5bYQ7kNvwGkSvBx&_nc_oc=Adq2oWbTFbHWd5UupipsbMcepf78ctxcmxc-a82DmblO1tbL6JeT9Ko8kuP6cJyceYU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mX4EoWdZDVrUn7EgLhT_PPAk_c0BqyAU1OcU5zbQ2YA&oe=6A0F0D0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pau5tPgSeMUQ7kNvwFoqfT6&_nc_oc=AdpOT3ULjQAbVQ7evwVSZxQC8mQjPVaOIGJxQa_tgE9udtvDTX9qJiGzcawSk4pHH5A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i7pCplgzS7usYE-wTPd0Fs2P6qP6_EvB2qCAGfOBFqw&oe=6A0EF749"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
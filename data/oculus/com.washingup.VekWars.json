nc_ohc=08O8P80I-d8Q7kNvwEo8Umy&_nc_oc=AdqsF4yWHk4gzUrt-iw7sWpjbQJaO8nFqcRfNBAne-_wLkDaxP2-iZEmwKwhuvoWeF0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y5DOgMU0vbGppvqhiARhgILtoWOWq7m4ZY-TvGrVpRQ&oe=6A3BCF6E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttohRrst3HoQ7kNvwGcAFDT&_nc_oc=Adq2eQv9CbuIHKM9Zscb-L-23ODeiqurnM48asfl-g_frdkCib41oqIQZS-xl0FLfDg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xFih2E1P6V99arc--2FeCha1kTGbhcCeUMiFwtGKhBw&oe=6A3BF264"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvFosjT644wQ7kNvwGiXMqP&_nc_oc=AdpK6mK2NFUUI-PBE_2rRRCEpt1TMI36w5W7h-7cY-yhggwaXStClgU8IDdhm3COexw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9djC4Q6RonEJQFuTj0iBnBDlorNHpU-_9LKjemgSRqDA&oe=6A3BF5F9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXObVrT_rP4Q7kNvwGplHli&_nc_oc=AdqbSg_k5v6bl2145icTn8v_vu730qp0WLOt6o7ZL5sCxsMLQGkjIYIpYit-1e55A_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HhUdWP_dzYv1sYNg5hjvKlQms2JKfuKBlGZjZHvp7pQ&oe=6A3BE00B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2Fqq-PkSTEQ7kNvwFGhZgu&_nc_oc=AdoP_wnaxyNtY5DKywuWAM_VF2zNnBRnN6ap-WneSLKvFQ17s9j95pPSS17JLFRIKuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NpwbmQDntaKd-w8ODJjv0CksaQZ01_WeeXBBYCRzgkg&oe=6A3C0289"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
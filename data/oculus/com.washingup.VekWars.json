nc_ohc=Nl_5sahgOYYQ7kNvwHTs3CW&_nc_oc=AdpxOOMev8E4UoBphddFYgqKXCTLo66I6DwarwXJY0NOUfNPAWqe3F6Hn0hY34vzHtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lg6GrteV9hCDbcGUV9p6qJ-eFZK0Xb-Kug8gKr1yL7Q&oe=69D64BEE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o266MKwk6QsQ7kNvwHGn_Wv&_nc_oc=Adpag7Rtqm6yuSR1f6EPdspyU0mznYEIk8oDpUs-DyxN_OxenURcwCBsB9Exnh8Oakc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_jlvjJjhZeVY2PwAgx9KCoFOXL56u_4qrMhfyjCQbrA&oe=69D636A4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VGeQgTEOVYQ7kNvwE76AFP&_nc_oc=Adq9bLjhVMm44R09h2tAdpibXTnYHWHrESbG4bTICefZdu4vFl3bMimvW7mMKbb9OuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VOej1XzYPBqxSJq8T7rD5MfQfkzvLTr7k8XDhvBrELw&oe=69D63A39"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsBPsRAxF-wQ7kNvwEdgZp-&_nc_oc=AdozwtgD3I554SoJP8FZ9tYfR8kbEjYyXTTX5cpcxzs9wP2wd7AHpMrhDGPrP6en2s8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kdm59P0e6kW8zchjbZr02n6FL2KlJEHBFriJITxqETA&oe=69D65C8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmgXShsbhOoQ7kNvwH7Zxi5&_nc_oc=AdplqIz2LsZGcOtQ_L_rzTqejXImR5SzOwjUKAzbT6k_PDb2w5hWwiqXwPPORtvCDig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10cdFV1jZRF7XViFw_8_miiKCAo6ostFqljJp-7S-UKQ&oe=69D646C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
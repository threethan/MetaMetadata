nc_ohc=BsoVi51VNDcQ7kNvwEl_tHk&_nc_oc=Adot734vbjjsmDvgmLMkSHmyDtRh7o0X7TmobUF5h4s73W2NLre6eaNS8glF7JfGr_s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9lpdW6fxeIymiSjdWy5kLw_LYu78gnA_GzCiD7YqJqw&oe=6A4BA16E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSzuBKiCw04Q7kNvwF98coc&_nc_oc=AdoviRlJaaQvYzIGqxRqT3z5NMVIAGNFp_x_ifkuBkOdU_Hkcx1pb-IWXZJmDKpPRnI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLF2d8kP1589RgKS3xCIW67QZWZ98XKxtKa1Nl_bTxlA&oe=6A4BC464"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0sn__de8DcQ7kNvwEESZx8&_nc_oc=AdrTfje2fnZ9KTTKjYtA202tzQqDlR4ce1cgCh0bm10tXG53M6kRC6yrqqnSl782KOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiYJxzuihRDLYLtiUkcSWpu5FErjoqM72Wp6yYjJMbbw&oe=6A4BC7F9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ehPZH3o86hQQ7kNvwF22oNw&_nc_oc=AdrX6FQdhN0G6dMNXoSX1ZTMfJKCCYp-1hroR0VRwqUwNfKtGjiJF0SHylQUvKD0NGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhx19elLcFMTX17KbCPl0yr4Q1EnBOGuMDlnwgLAYSWg&oe=6A4BB20B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVc_a2tuRnsQ7kNvwHPFC-b&_nc_oc=AdoTaYSPMSdHG6tXL1Hek5D2v79lgEsA1gUI3CNJ-WoQQgNSIphqwK72S8uplKYOibU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnVDZVQ8Tn5ei2ZyqzOR8y-K-XJi0aQvCWoabvVxVMUA&oe=6A4B9C49"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
nc_ohc=KZTLYpihb6AQ7kNvwHogvhk&_nc_oc=AdojxIiXRmuZqj4XWIpwcTdS_xT4qt9srw91dNyXwdaLx7rppSLnHCfThce9Hhnl_WU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRppdofPOH5nsqLhhJ-MNBUn2I8UumOlLOKsCjWKi47lw&oe=6AEE022E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmriduEz6d4Q7kNvwFQ7qPg&_nc_oc=AdrhOflbSOzCt58CQeyKdRy4Q9MWaPTFYrUZJVydxD_WKkvG_NIOih5e0efhUC5qSSI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRal4yjaisaDbbq6Znb1ewDoIYc3NKyzfMIE0DzRRS-Sg&oe=6AEDECE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJKNdtDAil4Q7kNvwHPdu5E&_nc_oc=AdpcL_jgpy50dW3fqhNeJBgq4L3-KiXUW1KzXsngjUS4eLjDzb6-JCTHZyfGcXTV0PI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJz5YqDCIrHtusL3trnmTqsTSz9LEJ06EyUlME46DNXA&oe=6AEDF079"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcWPlwTeajoQ7kNvwGT_y_C&_nc_oc=AdqNiv3tVWf_16idjW3R8EVwEdv0bTp5xaFf9TMEwNa3sImOlO3Xm0fIZZIxIgI2miw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNV_8pZTOf_qWTlmjQjNh_m906W7psd7roiQzRjrrndg&oe=6AEDDA8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVbs0xs5TboQ7kNvwHlZOQ4&_nc_oc=AdqQYCDCGOfxO8niXiPxEwNRidWUWfaOqjVIyN9Jz2QUygEfq2DGcqhN8103kpQNXVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOFhwra838STRp2dMAY7CiGFaBamDlFjOx0No7wOKJfA&oe=6AEDFD09"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
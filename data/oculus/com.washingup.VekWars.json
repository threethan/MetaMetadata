nc_ohc=3ppVSPBElP0Q7kNvwHrZcGn&_nc_oc=AdqZ4E_aDqNGB7dEqcgoHwDr-OiJPaCusdkVC5ijdLrSxz5Rk-Zcxn9n3cYog5FYObo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyjkMQOp4CGitQG2rt71l0MVBgh65HAoRTKKpauEcXng&oe=6A732E6E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dYcA1Ayi-CYQ7kNvwGTBclp&_nc_oc=AdooG36YAQjIG91-cPcJY5CODgG-yyqa179T9Zi3ByzdKM3v9gjzEganGortdS_CNIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_DFcFf6th3ljU_4zS90IFplC8RsC3_CMlpWrdycyDag&oe=6A735164"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUFlkWAoYSMQ7kNvwEui_U8&_nc_oc=AdrVhoJZLTFoaYuNtbFDNWeRelNc1JI4Y9PZ_aLBn7uN3tTas5RsEck3F2dABgohEm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeDlkIilwduH-ahWi31hPHcS2KfAMF9XgcWKybeLT2XA&oe=6A7354F9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdvS_eMg20QQ7kNvwFcw7Ll&_nc_oc=Adp7Lu3I38N4sWK7TWoGg3FSM7_UpDKlnnp038nghT3lVLIytu4shLA3Pyex3-0ndw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrhep__AYQZsc5QYx7BTHqH3tqzy56CanTumvcw7PZQw&oe=6A733F0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMb8gSEp088Q7kNvwEILFYo&_nc_oc=AdoU7RAq9ZUTx0uP7OCIcStSxFibxScen-Av3Yuaazi5JtRdI8lOvKhpGNdLwMOBDoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGozj4-mBrlRBGbGZj2gYx-KRV13p5hk4tO0fMPaZKMJQ&oe=6A732949"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
0a&_nc_ohc=JV-QtiZuffYQ7kNvwFuSXUD&_nc_oc=AdqvGzXHUgZqzl-Tr-MfibOxVRS5Q8aeOVBZGwHkhMdVRqJ9nEFxKItQNbaZG7ORzc8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNocH5Bo7JZ0Lziro0nqwhjoLLJL_YBvr6xCR2W8E6Iw&oe=6AA93BEE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9naZMtShEPcQ7kNvwHvPKcU&_nc_oc=AdqsjDyVePSm8AVtYkuZ59s5n5morcCNHkIFsaMd9enKpKo4cesvcCLbXl5UKteiwvI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyZsYtEocPVdoX24zfQMasKy6ozFTAVWSctzpFYKaT2w&oe=6AA95EE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pD4dvWH42twQ7kNvwHgmgDo&_nc_oc=AdpVJgjqBDpKyqtPk5u5YXys87487LbVlNaHlWeB77tuj-ny9n404OtnIoAb_A0lym4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsJzbO8UmlhgEslW8anlxTYN-gucmGp6YqO2J0UDN5kA&oe=6AA96279"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EArsAkLrcJoQ7kNvwFWh2pX&_nc_oc=AdqsTzBuoI0i5oLhUCMahiQCPvEn4FsVYkMJieP6rUtz1yrPbIsxhQF9vx0MT6QzWTM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfHbK-CPFUXn4jcl-8Wua0yafUcvZlKb0yqqUhLjOpeg&oe=6AA94C8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dN4XWPodER0Q7kNvwEyxG2G&_nc_oc=Adr4H-kAnJ4FA7cN9oDC6ya-EZHwpyq4zxFLBcui2T6ZydB4QrCOpt1W2GOr5iHxm-k&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwd_Rn_TN1ogpqeQmPdGEUX9z2EwkJl01sk-Nv-rEU1g&oe=6AA936C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
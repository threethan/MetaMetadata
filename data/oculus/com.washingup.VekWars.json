nc_ohc=rydaDPKmzOoQ7kNvwH8UvWF&_nc_oc=Adq_3prUHG1DC9FIa-kL1V7NfATFg_aF9VOK1GhHDA8uDfKyXm8Vcg2yQqmmdv8QVxk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRX3vj2EDLFktdZgsUTHy04eLkzm2su4hbM0JFa20lQg&oe=6AA5476E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6NIFziORXYQ7kNvwEZuKai&_nc_oc=Ado6mzPr5Z2xbSDmy7PlGGQrt5dvFlobfVHP9V_dtipQZ8nrKlFzL1bnxE1i0-Zt2ks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFax3q79tNRQkrKkFBLdLZR0x1nuFr7K8SIb8503Uzxw&oe=6AA56A64"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0P1esR1IeNMQ7kNvwGkOSv-&_nc_oc=Adovv7_9DL0idiyp5OXMmPQ4KTrnc7mBujgPZhF1u0rzsoQbObIFF9vhUoNaQo3Li30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILJPgFnkzlvNXN2Uv5T_HxXii_gfZEGV63cCiueEjAGQ&oe=6AA56DF9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fi38Rz56XzMQ7kNvwF7RTLY&_nc_oc=Adp5CdQrqLwgiauvOuNXZdVG_VDey-azwH7JZPLhX0BQ1ZfaJW92gNXhMozATRPM4bE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlN4XdxAG8WRGqgH4xObl5YZ7n2-oPqBNNpmkg5JEpxA&oe=6AA5580B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5Sw-UrxHbkQ7kNvwEs2iGd&_nc_oc=Adps0bzErbqMeD-hK3gkGz6tRkrE66_OYDQZQH3taEbnhqulltg5_uRvOVlujAVggWU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKH2oUgRoFTKrctH-CtRJZQ_T4uKVVNe3FASRk2g6Tq9Q&oe=6AA54249"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
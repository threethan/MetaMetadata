wG1cSNk&_nc_oc=Adp-i6BUlqEwAb94oOm8c1MSPuYwcOdGtvLD-NIX8q9-lXUpSyFTNzlnQl_rVNXMD5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlKYDsP-SeO83axw7uPs5MUqK5LTwk8JLyHf9q2Fczmg&oe=6A75F464"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5AQoUolTagQ7kNvwFliwEJ&_nc_oc=Ado3q89RpWwQsFjIp-guVeNqwGJ81SikCKPMarHTu_8ZCuQFbKUjWM_VrPLMO7TNoEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXXsIz3Smry5PCdca4ub_B3CPo5vOPQvN18yh35g3hWA&oe=6A75F7F9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdvS_eMg20QQ7kNvwFC6AN2&_nc_oc=Adqgi2TjpVVYRGHso3NmyyzMtIMexnqM4VUsWmzhBw0s_QiNCegKK5b1fUB6eFlr8ws&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENw1gw5hgSTvjitCQcKth6avAqzP-hFLjJNXRrbITdRw&oe=6A75E20B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxfJ2DKvGGQQ7kNvwG7BTHy&_nc_oc=AdoW8mPbPqo4TqeTFycmZjf6OKZZXrVIsdCxpYxTkJmXhVzgnIs5GTE90Ddw4fEhLGY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlUyfNsIsFrDHRpzE2Vuw-5tuwIRvR3P5Qm5CgBau91Q&oe=6A75CC49"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2058949310950990"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1128126651013165"}]}, "baseline_offer": {"id": "1128126651013165"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1627668480, "status": "PUBLISHED", "id": "1128126651013165"}
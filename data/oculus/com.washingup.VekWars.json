I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvknVppz5LdZ2z_Cgico4jDcfdmyKaMYA9MJMDnu5mrTA&oe=6998556E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_HfF9YkM0gQ7kNvwGECHBY&_nc_oc=AdkgPujAs3g5crixTWJyUT6tjZQIxYATfKeySaxlFWw5I6Fwx2nz0Jwy0syXppK6mLg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsuNNClOQ3cspjQ7TorCtD77BWl9aJ6F-t9jbkQLM4vJg&oe=69984024"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9EOwf1xAM4Q7kNvwHzNaFq&_nc_oc=AdlIwi5y6ehKgq6DGstOgInSYo3T52EkcSvqxhr4RV-BPSWfV31hEMZSrFc3bkRZQLw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsGz7Uw2DckgrsUkJI5yVKkSKLrU-2CZKzGV5zC8sB9cg&oe=699843B9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tI3bSQIcXr8Q7kNvwHktmD2&_nc_oc=AdmXEpaPxbcIotwNbkxOCOYNJg0fZOq3VTEY1uQ6fG3W-9jKTxPfd28J2zuH6AhBWI8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsVQfVIW6S9Tmp9nGKo2U_l-DZFL6yyE1AfbaTQHf3LQw&oe=6998660B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBt2bA9_I0gQ7kNvwGWqIwY&_nc_oc=Adk3MEyKISoftb9GYQJtl3UtCtm9txb1xx8c_Fxg_q9uSsyyuX00kADuRbtKs9GXemc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aftf2gD_RxbuM0ZFc6GqEfK-Isi-_jlOHeik4pLp-TsRSg&oe=69985049"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes"
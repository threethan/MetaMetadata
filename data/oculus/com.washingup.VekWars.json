nc_ohc=KNW8fniSQuAQ7kNvwG6N-m8&_nc_oc=AdpZI4G4kNAGN27EO1cTSGYlCV8CAq0a0OXBWDY0y4FBJHZcYat2QJbc1yAYvI5LrFc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMP0QHkniC3XyLrgHB4b-UKfv5GNUvJtQNsQtcSoTiuwQ&oe=6ACD0CAE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nK8rPJt2xYwQ7kNvwHoTa8V&_nc_oc=Adp0SOTqMaGpJQdFEYW7wIg7Wq8qgP05J489e7lOJeGJ_h1bNs9a0tHlErPHB-j6w34&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn_IM8w9lCJeYtOL1JFr2t1BpkgLScjqADMoUFOli9PQ&oe=6ACCF764"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV3-eI5vgKsQ7kNvwHJASDf&_nc_oc=AdqjARweA0vdyX7gLoAFeR8rsmA2UU-XcbOKOh306qIprTksd5RW-IyVqSiVxmZxB0U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNn5VtRTiJ4ZnHuHc0PfsTIi8pBnr820af-XHo42T6IQ&oe=6ACCFAF9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_laQLO5mB0QQ7kNvwEzIGuK&_nc_oc=AdoZyMKy7b17bQgnnwA187gzQn-sTlzWWieZIiwALAAGzlwPnqNbF4orA5MFux31jtY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmKQyBxbgsjpijfMX6fAWl8NqLpFrl3-YzF31SSuXMAg&oe=6ACCE50B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txZY0-iQrcUQ7kNvwFphT9V&_nc_oc=Adp7D5tmnj1UT4JHYhEdazw49AgxyH-RMrLkSVRPI9R93T6aqVaJpJLo_hS8rfwjZBg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ9p4UycYxVPraqplCrZPjBPLbx5IwUKCqm7j0_YBi6Q&oe=6ACD0789"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
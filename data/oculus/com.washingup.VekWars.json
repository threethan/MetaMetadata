nc_ohc=0b3bA7QfEe0Q7kNvwE0HeJu&_nc_oc=AdqOCWQQ4cPDf6v_H-uHAyYfk6uXjll6-jJdA8iGEsn9-J0Sb5oLH63pgz6I31Jh1XU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHOtBSkXpo-xBnICXswdUERsenJhm_hdppCPSuP5cU-A&oe=6AE76AAE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWc_KyegjowQ7kNvwGmTi_h&_nc_oc=Adpo8yOqwm8od06jGWfdygVu_YG8WjqcE4rDR546rB2JTHmQcsoWcIBPax-2esygdRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXT7_m6PUl4QWfLE6HH2BdAtd4ZC-JMgQmzGxTHb0-ww&oe=6AE75564"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sedUI-ys6D0Q7kNvwF9Xus0&_nc_oc=AdoKrL6YHfdrSSQMlZO4EFs9_oii8PZpLHBehlUUxOjs99Kd5xOaKCWXGvghVhLCrLU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS9-fXZ7CzD3bZY5gd3Wpu_7Q1hmdcapanqzla2A8_Pg&oe=6AE758F9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A9waNzEeQWoQ7kNvwFCXXoL&_nc_oc=AdoJc_vCrNauEYdiBRXnJGiRc9b1Wm1L4trSX20CwoVU2axomjEXODsHECF3fWXZDjw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7sYs1xGCM2QV012HCFcbOcoC3wQnAm1adGEoVgXnLJw&oe=6AE7430B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeO8LSxrwZIQ7kNvwEcZplq&_nc_oc=AdqWLNM2NryAtZIALOD3U-3RYD2vIkOCd_iJGqUcPcX2zkgdBzuUb0wIK3PAz-tha4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUFpEkJFTwH9NSe0AM2xwh-JYnGUcqd1OLtLB0M9wkLg&oe=6AE76589"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
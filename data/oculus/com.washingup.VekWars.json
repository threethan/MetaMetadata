nc_ohc=CkcfQxZfQZwQ7kNvwHkyux8&_nc_oc=AdoZPSlum7QXYY7ylC_aMxjjOE5tIjeJIREGALQNjWFgDueDEYsPYv-QadgxhDCZXFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKb6Gcc_Tko6Y4BJe4gvQEAtA7mE1S7mfjgl5Rh1aXgyw&oe=6AABDEEE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eV0D7-PTYSwQ7kNvwE90Bxw&_nc_oc=Adrw7h6qCpoXFUIPAEZnRO6pCwqZBlbOBYVWfTnmBy9iVWgE8cDhrKYWxbRoekIvLTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjv7-khtVIr0MeHbUEHbkOZ_ivil74HeExJ1mIA5uz0A&oe=6AAC01E4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doG74INLQVkQ7kNvwHDaQgN&_nc_oc=AdrwNTMR3mhR7NNje-gItyYX4hbkYIA4OgC4cte1wnEGrj_4skHJyDZYtjjo8Z7Hzog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4PMmxRWHyW1Ef4oxS23S2f4Vtx4g0m6RBTPuXDbSKRw&oe=6AAC0579"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_Hm_1Nlp5MQ7kNvwEjMzn8&_nc_oc=AdryGZ_Rdcw8hSfzCF6aR9JAnEhKWJw7zDxwxpOQ4FK8jdKJDy5ygBAoItc_VIf8Y7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBUEeFl3MMIg-_Oa9dftXfnzrU7vcmj6tNPLnb5JdOjA&oe=6AABEF8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dN4XWPodER0Q7kNvwHvNiMK&_nc_oc=AdqEUxwntUZ9RVp4w5xCEcPIUCcxjGX7mJg68XVX8mFqLbhxvNPhN92muOa3KGjQGEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAvRzxVOYAn7JZtGkITubXk0i5TiQ958V1Fq8Eo3pUWQ&oe=6AABD9C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
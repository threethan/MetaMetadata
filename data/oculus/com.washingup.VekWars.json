nc_ohc=8dxQ0lMT_Q8Q7kNvwHPFhUY&_nc_oc=AdoNbnoNHooaLsTsVeeOhYGZvI_cLXhCGEK2sWEBEyQ50FosoSstq-sn45F5Emecfns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oJzPdoF9malTMOwxFHbB5q766mXhl3d05VbfIcCPtSw&oe=6A35702E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PVxy6YsNlwQ7kNvwFNmwzQ&_nc_oc=AdqOLByMOgn43jwz4Y9WQ2jb7WTZcDkpKNqIAw5TRx-zvnfZShiy2MycuKljEiGXgxo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DUfr3uBKkuHHjuOFs5BcSdIH2VZlEq5r9Pd3Zmf39Gw&oe=6A355AE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ImALyTJDjkoQ7kNvwEPRd9l&_nc_oc=Ador6OpI5YBHFITKuj8Ek4U1bx9SXpKnQmZlmWS4yiueIiZ6gkMhj4udWD9DW36xZrs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98Bfz658fRHml7E3xxnytymVXMOLlG9_vt4YfgbDWV-A&oe=6A355E79"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7Ir3tLOQTIQ7kNvwGSp_Sa&_nc_oc=AdoEOHvCGUjJMOD2Mpkwko2THAxndgY1InmYVK9MXV4mIuKkjf5sn4Q3vh8wOvEVRB0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JmJiYnEaZSOiOEIqx3sspM5W8ihtDcAxnofsuF6HlIw&oe=6A35488B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zq3X1vixezoQ7kNvwETWfjb&_nc_oc=AdorCH_zrIsJ32S9vrznyKD_qIuTldlhp4Ij-BQRJkgJRuGhwDeAV_QWdJp7eopzz9E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OOOE-FIZ-g60dasmZK7z7qGM0THnWpXukr4wfeGr1vw&oe=6A356B09"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
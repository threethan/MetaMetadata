nc_ohc=foJ6c3nUKkcQ7kNvwHS2mWn&_nc_oc=Adpz36hMWPA6cW6KF2gILELY6gQZT-dTGGk5ch2xlvBO2FeOCRtVq1C6H96wZxq6OMw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjUzPrRdef-sefIHA8_MIQLkpNl78dNFllmndg5DcYMg&oe=6AB2766E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4gSV2KUsh0Q7kNvwEdp_5h&_nc_oc=AdqUFv_Jj_7pgfGwftv-x4eq2E4C3J7dXNGpydAgky6CJBbjtUDBBVSpLBI28aqM3C4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTmklBZMxrJDSI-GaLJQUQMRdIVYvn_jPWkEvZ6vx5lA&oe=6AB29964"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaQuYmhvOW4Q7kNvwEH7TJx&_nc_oc=AdoDLxWJFrJsNSzapwX8YBYhMDPt6n6mqg8hshIwdoCHNwgXRbk0N_yVz-aYKWx6eAY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZW3PbuW7MzdRF60lePMSCQAse-t0bm_TQoJpidEvoKg&oe=6AB29CF9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT3G0zJLZAwQ7kNvwG92HW-&_nc_oc=AdrOzMolSqRk5jJqZNV3jN92lB02-7xmZunf5XaU9GPZ7PNdSPTvr4i3-D6ohMBh74I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLopOSpDtCod1sm5Oa1gxDDmLx35DfMfMvwQAG3IcyXDg&oe=6AB2870B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgieH4MhWCUQ7kNvwE-xjaK&_nc_oc=Adr8PqVs3RE1ngrBOfyX7jXqW7LwelXhjsxpQrZ2f7oNIpfwgqMyysa1bxvt0DBJv90&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL7EOSm4422gZ2VVlFX23emG5C6BRInESjdWUn7JYkhQ&oe=6AB27149"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
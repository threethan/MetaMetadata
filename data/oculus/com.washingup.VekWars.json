nc_ohc=vRCPHam1vIMQ7kNvwFKspOc&_nc_oc=Adr4La7pyTluQ1ab2QUQJE8mEdXOCrqD33gNtWVeLOoXScfz9Cialq0AZk49AYzKpOw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR44duINubODIgneF5eTzx0Wq5KUPrz5pE1tLxBjx5nw&oe=6A6F39EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Yrcxs5KIf0Q7kNvwFdM-TO&_nc_oc=AdpyT6snRdphsuCS-vIHj9c7myC4biMH1xQUJPB61kF1XAg1fIampk4GF9FeeXHdASQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBU076uiP4wth0HmTgL88rmGRvPnmEY6U5prcL7T3uLmw&oe=6A6F5CE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fw5K7gDavwYQ7kNvwHy-1Bd&_nc_oc=AdrpoAhzzeNde4YiXIshCEClVEttmEGtJUjaNnYGAYW0PrEAdTZV7SjxLRadolwfiLw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQQG3tVZf8NCTIWvnxY3vl2ep_iZBMg-L7j_8v94C5eA&oe=6A6F2839"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9kpRVU2OsoQ7kNvwHromuv&_nc_oc=AdrM77GUn-ODBj_Kg9qVXf74n-uXLPjj5beoAsE7dN9UDyKuEFbZ6-Vy9xgcVa6jnJk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCg7HHeNnowI-YhNkT9D8h_85eVQ1OFLDB3ItJwTtranA&oe=6A6F4A8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZVqhixbjt8Q7kNvwH5Eq__&_nc_oc=AdrksQafjRxERDF4BlUObPSeaGTpzuOfsQW4oMNTXshGGWY0r1ta7RJ4u5mspUyTSZs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIuP_kLGHKvC_Qp7X5JoDWPnmNq9t7L5pT8ufUpkiYig&oe=6A6F34C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
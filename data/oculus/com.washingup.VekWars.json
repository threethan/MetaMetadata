nc_ohc=lKMC6315_x4Q7kNvwFOjOVI&_nc_oc=AdpLGUryHp9DRZ6Yt2Q5K48Cg9R2Jx01tCZvoL_CT0BeSX6r8jzeF49LfY9CyGrAK3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1q81gG2Q1W3l-ShN7Og7WrpGOImjFr--lIvx2t-P7vw&oe=6ABBB0EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeXeEirn7LoQ7kNvwF_tcmH&_nc_oc=AdrC5_ceJ_38VviWedzr6JgF-6btYz24A83sFC_IqSps--fbuej7-EvKk5ezCjIMIio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzZhQ4skxA_gnHgQZs3J4vDGLkVBenqgv_fezuGxU4gQ&oe=6ABBD3E4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KuCNJ8K5fQQ7kNvwGrQqnz&_nc_oc=AdpDKs2Xr_aa_z4ASIZvxvA6JLdx0AdDJ_1cYnToGEgfgK3lLoYOr8kQz0ShPxuddhk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUIk8FTgs_nGVqLqIztDmqCCs7a7rTk9eO3vjW_bLZ2g&oe=6ABBD779"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yv-C0pLvrSgQ7kNvwFZuzM_&_nc_oc=AdqDnm3oEt5rXCeA03Q7HAaVEjmwsDxdoKGTt-9w7hTk7EnuEp4eHyaMxNIry0wAQpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICswPHDeturihFVjRzjMlSlqGQw7ngl6scLfyVuj_eLg&oe=6ABBC18B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LnDxYT_nG4Q7kNvwEtgfgO&_nc_oc=Adq4aej2peKx8VvFukw_0Wiq9YKECh1JnmUaVm0m2I6hoC1-fiqixw4ZTXpl3GdQELQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWzRqYB7J2qPWsx6w2UQ_3GMTmvL4IW28Owr5kuKDn8A&oe=6ABBE409"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
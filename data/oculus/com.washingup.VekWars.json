nc_ohc=VxA3fD1OyfEQ7kNvwFjW7XF&_nc_oc=AdrdfyhN5MJNIkwVouiybrfIPo-fM2cF9e3mOH5aBg3Z9IfZjKVezRQR5_M0hWuneds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP28JR8sOU5ZXy5bKP4D_KfORwqj1Rb8vd7wbUFKsPr7w&oe=6ADDF7EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5I40S3_u40Q7kNvwHi21ZD&_nc_oc=AdpcPKg5gnv-ca2A9cQyRChxKb90N4O8-ZsUNt9zvR_wtcsAqGocE-Qcjnw4Y-BEwig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEnuSm_76Zne8uMpSmiDOcLtINW5nuuLoifXVc6RYptA&oe=6ADE1AE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dvb9mS0B53IQ7kNvwHLXMlZ&_nc_oc=Adr6aaMUIPr3riZ1tBYYdWjorHJNrxMchnyE_g3MYVavFhsPpbAnvn_3ElTvk08HwIA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNk4rrrJSnFzbL-iXxWJgZYT-gcUVy29zpuHJqa6tri1g&oe=6ADE1E79"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy-3jLJuIZ4Q7kNvwEnNffV&_nc_oc=AdqVNmqZXPwpBjej3fTB8kr1uA7QA60M2Y2lgpDCWoYFov5SOncx2INBLslFcc0m5FI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOf-30n8zu6-82A2ANkXHIxHG1k_4IO68N3mwWmblgi_Q&oe=6ADE088B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmlfUyGXz0oQ7kNvwGeRv0Z&_nc_oc=AdooO4z1brcX7EWfu5YTTh5t4oa6RRjgqapWUE9SOI5LEiqoYAo9CJBkFc1u79-DRdo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyl8kSrxmnQ16Q_0SNcyoh6JnQr36Mw7WO17UFlDZ_dg&oe=6ADDF2C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
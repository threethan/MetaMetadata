nc_ohc=lKMC6315_x4Q7kNvwE54KF-&_nc_oc=Adp2dh1ylHRhOgsYcGT0DIxP5wAr4OPpyzQi4h85jHcmKU5a7mgz3Kl85IB6WAepQnU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcgPMS8Li-QJwPD_Vbj3WXmUT3mMOUYSXeyTMeF4yIgA&oe=6ABE8C2E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Nc7P_UxFbEQ7kNvwE7dCIS&_nc_oc=AdrLeEcGjHLnRi-rglGCHtNSfU0eIgxvhJC6vpwZ-sbG5R8LHCA3pQu008iE8uLybdM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF251qRXyBuzZ07j4Ev0HPrmM0V3jR5YZe1OjacaW-qQ&oe=6ABE76E4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KuCNJ8K5fQQ7kNvwFrFJn_&_nc_oc=Adpi1DgHJkCKtVVefwGPrgpZAt3ArYrkytK5UGlrQPW_Lf9t-2v8Iex0ixTqEg4qAt4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEiaPf8CQI529lAoCdWVFySD5sQQ1AswbOtPtl7_l_LA&oe=6ABE7A79"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhoR-3_a93gQ7kNvwFKDJ45&_nc_oc=AdqvzU9HDAKDp9-kyvPYWqWBpqCNmIIDGQUfUZ-kNIK29WPDtcljMnsCm9joFwuXYVM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOF2cfMrhC_s0aOT05uu-qsehONqrkyJWkj3o6ZmNubg&oe=6ABE648B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v78W3lIjGiUQ7kNvwFLRTId&_nc_oc=AdqXpgIzZSNyEuU0j6LEt-KrxyCtGdDqZD-l2-Z81J1GzRvHVC897Z2OcMyF5gASXnI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhKWoCS49D20eN2lPSfzPIIP9E8GU0WfksROaCWlsdxw&oe=6ABE8709"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
nc_ohc=FQ93RyA7GocQ7kNvwGUl5-A&_nc_oc=AdpHBX6Rjl-rTuby4T8ydGL0dBw3oSOZEdFd2h4WZvbaMMDFkdMVdQuAb-yKj70i7k8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PHH2lC5oHGaSxAqwtnJTjhyApyhklUFuitnHzr_iBcA&oe=6A0864EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DaXpj6CNGMcQ7kNvwHYiNG4&_nc_oc=AdoND_6QEQWqh7d2QMAfgmEwFZ4aUT8QZqfoB06ZHC5yjEbBdgAO60JxRxG8mlIdxss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dqnvPh56q36FRecw7-ZTil0smqw8-uxhyR9VsKOQPXw&oe=6A0887E4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umG1lDD8_C8Q7kNvwHn0TrC&_nc_oc=AdpGdIPF127_UyO6W9-rVRKy5b6QTQXZbNsf3vbO1mpzZDl59_0cCPNdmVfyLHicmyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6C_7Ap6pZeogx4QnUgxF65s4ZzeODwLqrH_Wz9-XakSg&oe=6A088B79"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0Bqao0IizkQ7kNvwEw87xv&_nc_oc=Adph9BI9MMJHX6hmk8GSmDtbd19MqYEpYYAgum8IVsG3Mml5TA8VNLU0uAySIzO4Tds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BTRgEmNtNqWfpclMP4YsHdJ20G1cE6nZJCrX-NXU6Ww&oe=6A08758B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C18FubVb2wUQ7kNvwGh3834&_nc_oc=AdoLKh8BLclFaGXiV3RVkFSmqWjuoFWjXZGSozxfUANXHrSgEB_LugG1HnsoJvibDeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QJQhNgcByl5EwjD6eiQo-Pq5j898xSUmH_ROXuSeN3Q&oe=6A085FC9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
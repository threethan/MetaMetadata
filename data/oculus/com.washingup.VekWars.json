wFEORpz&_nc_oc=Adof9oS5Be11ImZc9YMSMyZlJGl2l2RBNlPf4PH3BWfPP_qFhJK4Sb3NY1NpyPN1VqI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yPe3DD9ogCXbz5Vp0ovfJfZTAk3050wNWloFhAfHzJw&oe=69F8B5E4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiOLT-xnig8Q7kNvwGy-CA3&_nc_oc=AdqaSDT6oARJjQmiFQBFiL0uOl848-_9fP4vNzmDMJfSWLWEL-nuxP3UuK3Y7savciA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af19kaH2jBVFuWrDMM26Iy6wm0IXC98G1rCy62qm2LuybA&oe=69F8B979"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-e36iHpKpcUQ7kNvwHQTUCx&_nc_oc=AdpnTP6cXFYSD0rrxogbi-DZkcooU7vpV_SriaqGLzHb57mI5O514zdkbnGtFdBvrT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sZWx0j1bF9kBH-S5ST-g81dwctGyPjF_9KRuCe-7kdA&oe=69F8A38B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fQkgM3BFD8Q7kNvwHK7CMA&_nc_oc=AdrSv0TAtxZfx2mP7-NLCDRp27IJPMdjD-s_gKyl7yRUcErOAd1TP1XaHQSNnaK7GZk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2LuZjhFq0pcl246mGHqdYLkBA4sZNadPvjRS3qOm_6dg&oe=69F88DC9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2058949310950990"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1128126651013165"}]}, "baseline_offer": {"id": "1128126651013165"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1627668480, "status": "PUBLISHED", "id": "1128126651013165"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4580870808646909", "version": "0.10"}, "id": "321535339314860", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3955718291162167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4580870808646909"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "321535339314860"}]}, "change_log": "Changes in this release:\n\n* Lots of new and reworked sound effects. \n* Completely rescaled world to improve sense of depth.\n* Radar now flickers into life at start of game.\n* Controller models have labels explaining the buttons. \n* Crate radar blips now blink when they're being stolen.\n* Bosses now appear on radar.\n* High scores are now encrypted to prevent cheating.\n* Oculus menu button pauses the game.\n* A ton of bugfixes and tweaks.", "created_date": 1636817996, "id": "4580870808646909", "version": "0.10", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3955718291162167", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "4580870808646909"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "321535339314860"}]}, "change_log": null, "created_date": 1623514393, "id": "4117152611685400", "version": "0.9", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"
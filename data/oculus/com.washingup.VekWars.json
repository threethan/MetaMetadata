nc_ohc=diSXNmEQL-MQ7kNvwE2mjap&_nc_oc=AdpOBV1u835ND7ImWiSU2kgdk-AIFlZ4_DxNo56uNuq3qG207cv8b02uJxIcaMRd8Fk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Gw9c8LIW2QlWd9WZ4eFhdTQsma8xwx0gy2Xn5vSSXyw&oe=6A007BEE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOlqhZkbVLwQ7kNvwHAy1Hk&_nc_oc=AdqT9V9lfkvwpYQsUrb0eSD1paCvzxD5nnsu2fNBQoV2tQ94KmRBE_3jFpepr7gkJPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U_9MazacnZLU_efK8He23hBBM6erXgeEaa0BJnFAI_Q&oe=6A009EE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oF7jc6YRnQ8Q7kNvwGeW6d8&_nc_oc=AdpRFBpiOjNVnuQOc50PS6_zLAlNnI92l1ZSWcOCE91Eujy_2SDn4z_KMSDziAtZZqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53vRyT4KdhEeOVi69K_elEJ7B1UP7gTMAdw0guYcTk_w&oe=6A00A279"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2chJecrzVqcQ7kNvwEUUGLa&_nc_oc=AdocZ3EZOwq7ijVt1nBgugZKJaBcbz8G4alPkLucF4O8T-SwtPtNNnU9p4yliMjyVds&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52fPi9xSNgkANGQyFxeix-kGUNxw-V1OCX5JdZwTJXXA&oe=6A008C8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMXyTNmKeroQ7kNvwGicT1h&_nc_oc=Adp3XyqA95_Muh817a0C5x3Bpa560jagqIEqQAq4XaBa7sSJSntHoG5oyO8112BuWJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70LbfolSsuAPPj5CmX0G8gDSpfQ8MndpeAvSempd0U_Q&oe=6A0076C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
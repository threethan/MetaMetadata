nc_ohc=Po8cA4i4uWAQ7kNvwGt6rA5&_nc_oc=Adqb4XdIAtOtE5doY2Un5Xh4YhSnJYlOF1uwzZp4ct_8iZNgYXGSmpOPDFfT_jkXQuo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GUv3BjDeBUdsIYBORW0OzAKREEhwf4lRFMaUhA7TU1Q&oe=69F7416E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmlZIvYEEgIQ7kNvwFh_y2P&_nc_oc=AdqoGGEt6CXaUVm4qe58pR0dOYyaddYK-3eZT7CGoTeV7USim4n4wGsbUHTJiFM7f0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ALQy5q7C7XnvIIumukRnGcZ3k5iFKWx-h3BoBB4pSKw&oe=69F76464"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiOLT-xnig8Q7kNvwF5lAHG&_nc_oc=Adoi1qJ8D0MQ0zTtZLF9xEOTZq1VcrkLFkIq2n-blDpNL3SN5BA6yPRr9ckgSV7_Oks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2E78X5PYBxJ4zHDH5LWXvOuntmyCV2U_NWNAifKh0LBQ&oe=69F767F9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujV4T576380Q7kNvwHBrOqm&_nc_oc=Adokd_R1vsbEb-s7bJiuAWUj72Tafg9MII4CTRWevK0lh2kcKzEZP11xP8SnWinRf6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18ZvGabbCKOeaoAuf3pjRB15-2b7ebpmeMwHLvB7FwJw&oe=69F7520B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fQkgM3BFD8Q7kNvwFN9RkO&_nc_oc=Adq27OEHGTECGqJH57HLdkwNSHXDb6jZK_9ay-y1HDfkZaLvu15xv3vIi8QE9VwMHNk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qMBG5zPM3lfxt9xVuld5pM1y8NZHWdCGENGiTqW6c0Q&oe=69F73C49"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
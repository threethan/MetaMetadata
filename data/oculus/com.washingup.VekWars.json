nc_ohc=GMM30k3HZkEQ7kNvwFoaMFU&_nc_oc=AdqDjTmOHP_3lEH4mR5CjwfcRDw0OdYzHKEiz2Z0_E7lCJecNFmubxdlslXFwhFFX_Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyw26eAwfo30Vd94K-qfyqQZnKugmXJNZwc9WcChZTTw&oe=6AA0016E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30KYnCu4rY8Q7kNvwEefYUN&_nc_oc=AdomVRcWHYbH4RepIuJp5Ecut35IpDKxmKhbUDQ8Xb53WhMz3tbobUVZLLOuZkNDdzs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy1kUfb9LyX5qAkilDm-IhauHmc2bg7WK5hGa4PVekgg&oe=6AA02464"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGMSsHF8xK4Q7kNvwGglgE2&_nc_oc=Ado5C5tL0ujDkKl0d3E9aRJ375y_yCHrZtdMjD0J-WMw2WVLML8q0SLi0bUlguIIsss&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXutEYLRHTQOQPhDGPSmvqysDL3FmWizcGQ-Vc0hplxg&oe=6AA027F9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbeJxD63gVMQ7kNvwEYSiao&_nc_oc=AdpaznyyrF8bxwGvwWaduVyfpneNxhBnfk64ZtMh7NHaahTit9_nqM5QcYFD-P9XoUA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIENgGvkrUJqiqRRs8rvtisydZ8-I4Ybqvz9UL5RH9pyw&oe=6AA0120B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAzp9Hx4ToIQ7kNvwFwUHI0&_nc_oc=AdpnXcizjWrveGwFlC9t9LxSh1sXm1LETWsieZw-31UGZQULlcbDOTlXR9zSF4vWhOc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ2ztdWi2WmxM1VBPVAzhKV38x7s4mAFPeLOm0jdt0_w&oe=6A9FFC49"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
nc_ohc=tmGsLupuzdMQ7kNvwFl0SvR&_nc_oc=Adp0Egb0ULJNDJWf2LhRl9dnTPt5_bnNXzyvI2TjwrIKLrdkeRx8AITiIMSjemaAuKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWRei6Y3T8BcCz7CtgTNMYClwSLExU3DnStm2D18XSjQ&oe=6AEF53AE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmriduEz6d4Q7kNvwGjC94c&_nc_oc=AdpQZqg2FVdM82L8eLYxHKt32SMmNp4QBWS7LddKih9boovlw3El3fEY9AAjkrKfJT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEU24E6gUXDK1wSslcMi9vUnNrpuyKPf3mKeRSkKBN9w&oe=6AEF3E64"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97eCJbFUcfwQ7kNvwGOWFZi&_nc_oc=Adq-WwbJ1HzG5IZ2lY1ub76NKj8aaKW0q3IZ7R9Uwjkpepq28_wlWHEiyvOhGZaS_vk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQROP_qsQmWJLUCMOqsA8_k5XF3H1gdU6xoilg9SE3xlA&oe=6AEF41F9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcWPlwTeajoQ7kNvwHmYBO6&_nc_oc=AdqFZTTSD0lZTXwB8kdIInn8-f_WUnB_7IA7NvV6dLm8JIiXO0PN6eOxGxQNC4USuTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIgnLROtm0nrkbWNtXpc-fwt9WGpn9YEP8RvWt_hsNyQ&oe=6AEF644B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVbs0xs5TboQ7kNvwFdS3p9&_nc_oc=Adr7WFbBixlilI4onjJjmm4hszmSo6KF3avH5POOjagNAh04Nzbiv7cekHW_NRcoYHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6P3fsPi9q54v8pkT8yGk0B6PQLXCMYEeGkPZ-jw-oGg&oe=6AEF4E89"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
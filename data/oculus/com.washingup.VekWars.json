nc_ohc=BoxS6nqlNzEQ7kNvwFSSSNZ&_nc_oc=AdpzcdfbL0xP4F3rDJ45THe_us0ElA2ybPbSbkXvf4WBYnnOWHC7mpLWOBvUtjEWfe0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0BTE37rybRwkaOEo6iPnULJll2hCSmXTMW5qft5sE8Q&oe=6A79C5EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKpMyJ26qgoQ7kNvwGHcNt4&_nc_oc=AdoV_9joZ_6sxae9cn88qIIzIZ3AB2XN0BiyVVZ5IXPfEfhWkAfNmXQq6-FJUzQAnxk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgREvtemwEgSZmukN6aV66hb93YM0A_2NtDlOe8OnCjA&oe=6A79E8E4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmPLdAqefucQ7kNvwGGyLoQ&_nc_oc=AdoOuL_KtpCxZj8I-s999LJKHZ8MliVmy-3HoIOt7BOYM-T9vsFqugrdUx84aPGj6gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvnIDqNfr2p0u_hgqwHLU7HDW2KnjGrujn7aAwx6RgDQ&oe=6A79B439"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEV4umPhWicQ7kNvwH9_cZq&_nc_oc=AdrPzBzB2fr-Q-HPToSDaBmtgLAozKqc8kx8zMqPWlpQwYHdx8omdGYe8jkbRR3i-dg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6xn3A7ztRl6mtwPA26r12yuyIQNmyy1_xMwuq1O-0Fg&oe=6A79D68B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuFN3lsymDUQ7kNvwEUIIu1&_nc_oc=Adp46OYSHsEaLOgI7QifdTeIuLjZR1bIGltQV64tN0r6MjC9XE89kwos5kbrb68SxUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA0Yg0Tggto6t5tV9qgAStgHTqHq955tqTkCXli29P5A&oe=6A79C0C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
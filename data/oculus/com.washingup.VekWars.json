nc_ohc=tWagEyI8dkYQ7kNvwEeXQBz&_nc_oc=Adqfe6CG_x1-vMjoS7t97JWJx8KRQUmz2sNDuohqMtdHCWmQnbeegkHgpSwuE2Bxtys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMngu6vdGJQSvHzUgqr_xfM__oqWdjbKAceGUdK11EIyg&oe=6AE09AEE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5I40S3_u40Q7kNvwGuD9eL&_nc_oc=AdqG50AOH97Ea1EJ5rDtfKxihC1I75JMW47fBXCJcO2D0vNz0KQKwLd94_J32BE50VM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIWbzcfA1vysytTGxWZuFFBeJ9J7NQ7cA3jortnq4qaA&oe=6AE0BDE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwNNHndOZwwQ7kNvwGx0tHy&_nc_oc=Adof7vmPXAD15QwMNeHSYlGs3JQkZ7FGPxaJYjtqqgjCttgb-wNrZfqQb7Xe5VZBESY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQlMneJYaDqnlVkNtiAKT95ASJuil0hgrDJM1JZz9v4g&oe=6AE0C179"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oy-3jLJuIZ4Q7kNvwEyNBtc&_nc_oc=AdpeidLfxXktSJQz-x3iJdMVA4Za8PCrInwbs4tGiKPPddvqWUBg_uTXgr6-1gvk4-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNilabsmQR-ybLodZ7g7U2GE_Zc7Ntw2x87rbNPDQOthQ&oe=6AE0AB8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dPGfaMQedb4Q7kNvwFl7mNh&_nc_oc=Adoea7YkjAj1O0yocE6aH6fJkKaUUUWNDxojLcNDVAiZeJ7fVi6mxcW9HMOv_Qq4oYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfK-YqJwjLFV051gjbvXIXN6QcO3N-v9a3sl_MCbvTsw&oe=6AE0CE09"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
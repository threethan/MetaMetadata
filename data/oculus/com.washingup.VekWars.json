nc_ohc=uPQM57isI3EQ7kNvwEc62te&_nc_oc=AdqPMRyq_2tFkhbAkBc8xPF9TSRQX8wkrQUBhWvQE-n_EohlfNPe10TcdqiiE-ngCWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JaWY3GOG9G6Y5yVjYfc3feYXk1q8YYnipkQRCBOUxXQ&oe=69E4CC6E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50w1xUT2WbEQ7kNvwHnwNlV&_nc_oc=AdrKQz0aLXYjytMhySqxlCfv0Jr6OzRnwjqFxAwX2Q67tcP9JW9vsIMdh1w-8t825Ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z5VndbT0QwVk6QmYskntTjxJSaeroTW6ETSoJr03eyQ&oe=69E4B724"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw37RbsL3EUQ7kNvwHECjFN&_nc_oc=AdoG_KfSwfkFT-95LIoVvvPU47a0GgmPZoBnz3VxAcA1WizZPMYrRsUrO081EHaKIMc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35YhIA7MbryCIvo53RH338Q1RuzVPmi5pWb_etlJEO-g&oe=69E4BAB9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvv0iO0wMgcQ7kNvwGOT5Cj&_nc_oc=AdoVaif1rpp_-ixSYs9UxVukDLQGicKCdPsv9eMbfxKBO5M-1gA308qlOeT-_CuvNic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jeXR9u8VVPLtaPOUEHun8Fb4e_Up8Roh1Z-R8OwDw-Q&oe=69E4DD0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF-BYW3FEVsQ7kNvwEZZJfX&_nc_oc=AdoP4ag4U6BFUbwruiwZABjI__kHzA_91hdAELpy2AQI6ez4R1p3nwDLcYY0kPjbBoM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h5i7rPsriR1Ld-7V3lFhL2CQBJEsKXyzPTKXxP08ZPw&oe=69E4C749"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
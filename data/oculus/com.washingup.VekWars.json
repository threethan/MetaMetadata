E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afud0yf-hnFBSqKiHc2wcMUMjdEQ0d4wDJbauKluaL9FdQ&oe=699D9B6E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_kmdAz9nNgEQ7kNvwEPQcdO&_nc_oc=Adn8rJflZu22vuECRVUvAaWdiZzzq_Fy7K0qcRTS-vNzD8kjgUGldgvuGVX8ojDzSow&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuBd9NWzvKEcDOoIi37LmSt_7xjOqFvejNVQn5-XsT5fw&oe=699D8624"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTACPSNKU8IQ7kNvwGoep1L&_nc_oc=AdnaEAClFYkBAbCloRC197l-0X4P6my5IvRddzCFU_fsUV6Gwq5mGVJfkovzVwgz9Uo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGAnGtnCYsPRG3vhQocZzxqhZAC3JC8nCf9v878yrggQ&oe=699D89B9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7PUYO4-TYIQ7kNvwFpw7ty&_nc_oc=AdkZW32I08o1zUr2Lv7Dvyl0BvzO3Bv6nA1aC-3gEjkY5ooPg-jQF26nuu9MiC-qwW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuuNJnWTZOWIpTDj0XGD85kfFafqYAcoKihawhOjmUN2A&oe=699DAC0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCC-UnxM6QQQ7kNvwH4TGIx&_nc_oc=AdmTQQqF_nXBrWctVQjvceXrvJultqD5BB3JYQ_e0fbxIE5CzNFw1-mecr9z2fgRbW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvdYVkzSd3ifjZwq45RvM_asf8Vf7C28tdSiOOmxgVbiw&oe=699D9649"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes"
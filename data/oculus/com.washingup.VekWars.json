nc_ohc=wPP0lm7XTywQ7kNvwHNt0tn&_nc_oc=Adoqvppv8O9cBEl3G9751-r_jyM8GtyzVQm_Tp_rgqIEaBHaSTPQa3Hs1VvIDdx2gRE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAy0Nu2E4yQ-lazrxbaD9AvwF0q3RZtm-qLOMBt3C6MA&oe=6A65FF6E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wA8ahkQCI0UQ7kNvwETNLvI&_nc_oc=AdooauFkTGj9B2N1GHsYJyBGGwyeV2i66r3T1KKM36c96brJwDaqYv1j_uj2RnPBbck&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3X7i_m-jHngSOukC8xBeJvKrwW5h8_TyWx9Y4FsUQuw&oe=6A662264"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cQ0rOtQ4vWgQ7kNvwEu998T&_nc_oc=AdqlInVHPGZbUuOtkHu1TqF16AB4TMVXqU_SIyr66Iix0pKttzrUcMo5raFRFXpyStU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj4oGyPpTIBYqpRL0BvFBReDhjbzy3sht5Jy9V30TzzA&oe=6A65EDB9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPQeSQZjzxoQ7kNvwGSK7tr&_nc_oc=Adr8Edx7G060OrSQoI-UoGXmPNtsjqBzebn1zM7GJp4cI7-xTM5P0rPbRtw0tgoSmlk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwRwVRtm4aKV3jtfRdJBcffTQXF5kBWnU9KP-cz5AN-w&oe=6A66100B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDknSaKWT-gQ7kNvwEcPt-q&_nc_oc=Adrm4t1lQxHxAL5nMlJ6ALc4mYvJ3MAqKZNjkDS9bBBo_hXExl82B2DYn1zj9bRULtg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEeH65bv-yrjYBmR39l-O2I2DDiC1v34HUljbHL6SNTA&oe=6A65FA49"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
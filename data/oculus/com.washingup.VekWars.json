nc_ohc=7H9u-79jvIwQ7kNvwE-5aiL&_nc_oc=AdoMwlc9nGXiz2h9ngL5fzFjJ0NzFIacdBRVrLRt7wuakeZMNaMCucym67YxyY0ULdI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5coTXPmZ6RxzqMcZ724tOC_i2eYmXVrM4AecC8s_XPgQ&oe=6A0C596E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGlmBrdk0PgQ7kNvwGg3fJp&_nc_oc=AdpGabjHbo2aS0jaCyDt9fVFX9ymy-nK8NiXsjN99W8Ea4f95RM0YSgCRWoVBkZ6x8I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ywlGDEcG2BxgHDhEod3NVEYaUgbGH_FjxSP7GD4tyDQ&oe=6A0C7C64"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLi6yIsAvHMQ7kNvwHBQ8D_&_nc_oc=AdomZY6O9WWfwBqpHbvLmoONkCgH4Hb-xf5gvSnlfiRoyKCBj3nAQqgv-vp0ZPRqBps&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65T11UzsL6667WhPCxPrpUIBEE2XNUtA2Uk76weJ5_eA&oe=6A0C7FF9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2hUS9CH5bYQ7kNvwFT4xKR&_nc_oc=AdpxCChJLPbN04Q6vt2aqrYUpIVwLXoeO1prZLGuCKKN1IcYKCwbIKPy73_rET1nQsc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57ys6KX2kKUIcFQJGAgr5spAjOz2cTjoeFKEiOMUlVMw&oe=6A0C6A0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0uM26p4mWEQ7kNvwE6U-q8&_nc_oc=AdrEVQ_u7vxbLg9ATYHa6m8oj0uyG513jg86-8ysu045tdjd-TaHsYFTblaBDqhXM-s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i2k1ieV_58LbUHW1JrRzMNPzssme0smgjOv0unSSooQ&oe=6A0C5449"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
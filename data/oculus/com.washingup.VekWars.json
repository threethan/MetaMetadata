nc_ohc=5X3tKJRszVMQ7kNvwFvsAzG&_nc_oc=AdqiQHTBYUvo9-xoz4fZ3uG4dbo7rrDc3apiwTKFWAyykBpaucYKwIxUigO09HsLbKE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgaQPXdR7axV7UhcodmxvPJHmYYu20Znmz4taaK-rZ0w&oe=6AD3A42E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrVcy3RG0SUQ7kNvwF8Ckn6&_nc_oc=Adomc5A0cbfRgtaSLIzeN6DfdBAfSwkkO1JzzyDUndVbwH1z4PRAsTgvgF5zhP6-UnQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjrqkCj9Pz_TCaXPB-okHf_girKgEEmAEcecb5bj4hNA&oe=6AD38EE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIrQJ7afJxcQ7kNvwGbwlvo&_nc_oc=Adqd3xGKVNPRe_2j4oPx1Htmz2DjSg01KLRTlS_EiUXH73eoNP4INQNg0n5WuojCi1Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCXdTuWthhjw6mq-RPwzhnOiDLT6dczuvyVlQsK2rOHQ&oe=6AD39279"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0I2aUD2VoEUQ7kNvwEkmFJW&_nc_oc=AdpVmVPGW1RCGKA4uZ_tPECJk1f8eeFk7muLx3dF1Z7d_JwIoPrxv-nzVNobJy7zbKk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwth5KA8_HmAfVx8e-y42d0mJcQ3WFFqXihstTh-j5dQ&oe=6AD3B4CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onWsPZ4hI3UQ7kNvwGYRuUU&_nc_oc=AdqhdNJZeVbSfESvPTpQb6nMZmXdLM9ZJ2QyFW5dof26TwhchonsPohzXcAGc68TK7U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7vvWE0DXGLTWTYI5QApWi9V7u0Zxg8yqHQPgqu2kHZg&oe=6AD39F09"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
nc_ohc=pwdsN7SWT1YQ7kNvwGoSHrl&_nc_oc=AdoIqZc25MFPh2xVAY7IqV0RJ-3dOqJ03wpAXg3HSlx6eNoSqkrmFlZYLQV7aA5yQAo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0hr1Cp7mPSXp7Nm8NqQS3kG9-tQ5VrfBpIImdJiht_eA&oe=69EF586E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvqV1JHC8_UQ7kNvwGCp007&_nc_oc=AdrhnfmcFMn-EsUnxlkAF7uskGqA-8sZP01O5KOxVxUB53XxUUTFxAaU4L_nc40d4Uk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fmxgkX-sTUOyUggmvAzdyASEInZwf1xTfJYFwgk06XQ&oe=69EF7B64"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB4iJcfCAKkQ7kNvwGqp6o0&_nc_oc=AdpligGcVbkDOY1RnHGe8_c6UGIjHEA38Q9g2ftd-pjAB9LNGKbKYqi2_vH-vSAkgZ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1PFBXf9ZKeoGLv7eSpcbJ_pCHxZ4yS5RxH39ow5S4mHQ&oe=69EF7EF9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4HLOMwqYQKUQ7kNvwGZGy6D&_nc_oc=Adrw1VFC0xipJFAtnWRC0aUYyeSNslrtZIaL2UrGe0JNFtIaDxD1QZ-2nY2dqrt83VM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1n-D9BkoSjWxpD6GJHXee1xYhD9UR1XSZgyYUsy_Y8lA&oe=69EF690B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y5J6ZKjD3cQ7kNvwHl6OTQ&_nc_oc=AdqYVTqF3YY3tWCXP7eHSQ_vmq6-b0xIClUpJ62hZ3VCoAEXfNNZVVJGKK7oavMZbEw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af02Wb-VRMRbwQSJ1jbE_unIS0zLcoRZcrYgo-B6G9kK8w&oe=69EF5349"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
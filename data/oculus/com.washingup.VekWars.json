nc_ohc=_ov13Y7IC30Q7kNvwE609iZ&_nc_oc=Adopqf692EH_hJSdRp7fn7sihl6TbOLFnv5epRTu-47dYKYCM7Ff5Uxl7Lo5UwoVGoQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgEe5hnjODU6pZ6K1WWtFYl-H-iz2ZXxXnSxp4xQdTSw&oe=6A9C0CEE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxIYldJuCnoQ7kNvwHHEV3S&_nc_oc=AdqIuzHQAN61_dJuBT3lss9Z5L0csiUxAK-b-WYFm4aBRsQdQvH9EFiU0e92so1uWWw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkX9Yqqu0w_5FVmrvuHsYFYgGYNJN3Z4eHoyLwvX_Tfg&oe=6A9C2FE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ttbGhxq5CQQ7kNvwFefycX&_nc_oc=Adr-cXss_H0Mq9mPD3NuQduyj8n0fd5376UspSR0KMdC0LDHFVF5e83G-KKj1KzR0_0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1EXwAaYXCrGBScRfoUQKlcOIwAx2cRZj8J8cOTWhhpA&oe=6A9C3379"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWuqOgzvmVUQ7kNvwF1N8Os&_nc_oc=AdqIXNFkQLvz4cJeVQyFnUNEsTRkMmvRyZ51de2HpW7Q3TzIzjCf2mMnJoqlJZOwZvY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKTFvaRpRO3CbLsyIhiHS-DlmaymhL9mZL__yXQO8JRQ&oe=6A9C1D8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPhjDjxBIdcQ7kNvwGpP6DX&_nc_oc=AdrBgAmjd7G9qxYnDEvFBfvKJwnZuuiiys6FLFTKW9kavuoFAi01n_Fdrz--P2-VdnM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE-HK0KQThj8Bqam-h0WRWOi7SREQ4LGMnam7rBpYnmQ&oe=6A9C4009"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
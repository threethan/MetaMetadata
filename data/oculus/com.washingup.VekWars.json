nc_ohc=c07YnTdu_JoQ7kNvwEbClL_&_nc_oc=Adq_6-lziniMxEd-uWnhpwufWRDYRhdmKCGaehopDrx2iHNwpCquUqx2LXJQqGKEUcQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbRuk-JLFlH5cmBLPAp9ct3yN6Pb_JDqHu_tw5Tu5gsA&oe=6A5A21EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4vJ028sX2MQ7kNvwGwELMM&_nc_oc=AdqIXsAx-9ypa95MZ53187PPG9a3b-6-C36JIuNzaql4mxgKzL1_98K_Q3eA5dZzBxA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoXYCtxEQ4lDcGmqfyvP1y7Gtxpn_1BpT70BLH6TRWmQ&oe=6A5A44E4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6J6dkPFDNcQ7kNvwEIA6LZ&_nc_oc=Adpnod405nMx1DPyc5Ioq4fKtoY0UPt2-wdKEZh1e5Vzk0wDz4F4sm6gL0W11x81PG8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3-7b7TPxuWbZ_KTaOm_SqBJMfvTaEJUrzGxfqMUUBnQ&oe=6A5A4879"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNhhem673vIQ7kNvwEh7h6g&_nc_oc=AdpvBcPU_MQLzmbIZSe5qye-1vxcQ1towj2F_QZ0SZc8Okdkd-NDXhcRB25O1NJJpG8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz84DNa0qh0nexkHMVzUW_le6EoGH4IkVmlFygnZr5Uw&oe=6A5A328B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DfCjTAtItMQ7kNvwHAejbP&_nc_oc=Adqm0ngJiP2lFyf-msGiAazLnn4VIV4997RZYjujs1fMM4XkQmvrxmMgsa22qnDsHpw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB4bEhrSI79bct5AxP1AxwqA4JFwwZ1je8gdtwCwG8ow&oe=6A5A1CC9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
nc_ohc=Kav3DGtHoBMQ7kNvwEKmmlV&_nc_oc=AdqrATMzJMzctVlQUkHYSqxM0rXCFMDThqH1J6Ug07KgP2zYk6nBmCLg2ITIJWdth3M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGraJ3SJkdFS9FMNHnlYAZ6ViiWaMfC2VBTJFcG9AAsxw&oe=6A81AEEE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihbMzmf5UG4Q7kNvwE1_A3k&_nc_oc=AdqNxVOhoyte5VdfIM4FkrCcDYUXTEZet_OkYfBdek66Ht7J-u5XlIKWcZ9CITgo6P0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZfeAPe2o6tf13JNCeg7kVF7HnneupfA9mEfrCSGmkQA&oe=6A8199A4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lkSPvJ-4VkQ7kNvwELKuEv&_nc_oc=Adq4B4STNVA7BBFiznlDbai3D41sufvkSHmycvUu1xcfr-U9AQ6kl2hVtMSihHThC_c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqwNPOIHaXkMa5mJODxZTfIP4D1nYwdWK2kYYl8tqP0g&oe=6A819D39"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRj36CK5fNEQ7kNvwH52AQn&_nc_oc=AdrxtaCjwi4cDeAItdOygH-I0EL7xfjDnyE7sPSc75c6WCWM0tjEKal6v_D9aQ5SKNU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWBUCLB4T8KIj5SzP-4k0jyhtd9EeIcy7Xv0uc3yEgpw&oe=6A81BF8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qG1_Ep_eVkcQ7kNvwEuE5mh&_nc_oc=AdpD8oxD8Lhd5sjLH5fyahTsmOZNEEhOdlPrZzsgGHoV5qjXaK2t2IzOUCXXPpB_Rfw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf5JXw-sSd8-ezSLJIom0DQtcShJcyCp4PBF98fw5Mlw&oe=6A81A9C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
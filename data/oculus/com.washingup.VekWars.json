g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1ma19UiexK7e_D3zbanBTJb2D9fXdJOEjV6xYuaOjrBw&oe=69F0A9EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Apis4pnGjx0Q7kNvwGwBd6w&_nc_oc=AdqW0ORHj6pGPSVLPZkOTTAFYRXvc4UAwxhNF7li-CkIjrVJAYmEgZ2kmlhvmz2rh7g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1t1P12l5zYO-3eimrQU6OAfPFzs-cRVcddj5GqjnrAXA&oe=69F0CCE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB4iJcfCAKkQ7kNvwEnQ1kj&_nc_oc=AdpUlzstjmMeOWXRZbXSQfJGov0FJkVG1i_7iqRTt139XyUpYWgspf-2HXg4a5aA7Y4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1IiNgrgmjszkLL4fYMZiu8fthAa7nkyjNcVCC_nU1CJQ&oe=69F0D079"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ7ehw6oPbIQ7kNvwGwmf26&_nc_oc=Adqfnz0uPbUNqHvJlLDmfCG07sH5OqlE3B9a-C40__37lavDRW3TxbMz635vGZ9olQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1qPhsTtO92rdSPyjMgVjmFUOTMKF9nWBXRcKpxbQFnkA&oe=69F0BA8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y5J6ZKjD3cQ7kNvwHN1BJj&_nc_oc=Adr7hYy8gTJP1we0dDUC_8RNhPRTH0rv6xpOxUkn0IH9c8-hVjiU1QzTAWX8lkrBc_E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0pQJJ2tDe3Y7NTN8p8xmrVzv5TXOab4ugxPhZdCve5mg&oe=69F0A4C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes"
nc_ohc=BoxS6nqlNzEQ7kNvwH97eOD&_nc_oc=AdqWGX71uozSXWo08dI1Z2bJLrNqt1Pa_ojp9J8I4811vGptz4bLy12wBaD8HxfMqZI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJwqdmTQRLd2TtopLFXjxSo_e_orCde5brZ7-UNsfykg&oe=6A7B176E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsgH5tzycZIQ7kNvwEr9wq8&_nc_oc=AdpCtKWcZyHesQgoUOIr8nGrp81zX4S9cIhIUma0Y76xn-Kl8Vmp4WcTrLmSAIbtNZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSgTpWdVSSeCr41qtRUnMytpt78Ifvp4Wuwbnp75P95Q&oe=6A7B0224"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmPLdAqefucQ7kNvwExD8-P&_nc_oc=Adr5B_rbdNCdvuD3L-tU31HoKjLMYWH10oyz7CQ9955I77zQzNRtMRdhfRev5etCLiY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWX42wlfIRCUsjkB4BeVLsdM8qPALJfr3533SUpGy1XQ&oe=6A7B05B9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnL9dGivfYkQ7kNvwHjn4TJ&_nc_oc=AdowSi4otWpJcuSv73P460L-GOOvANZL3uzS0_6jevxZoJfIyPpDptGoyKyaVw-f8sY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1jgZwODo5Smm4BxKbaxcRbSR7lNQFsOtDUGsmDuz0sA&oe=6A7B280B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuFN3lsymDUQ7kNvwFpFPgh&_nc_oc=AdpVjhVM5ALCIonafq9SK_wvC04M3iVGpf1SR6SvCiHe72G13VzO2_udfcUVRcM7TJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAcg8JHjj9pCPCia98DVE4YE_CU2RcreB8T2ksqM3kgg&oe=6A7B1249"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
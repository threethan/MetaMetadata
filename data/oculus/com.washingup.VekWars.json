0a&_nc_ohc=djtdSWUqFicQ7kNvwGUDzH8&_nc_oc=AdpEFvpuszClylJeBphLyrG11l9Okr7JhT7tQeHZ0OCpijwY9JTuqpGGAsYKJHasdws&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xiWBYbWzmFU1t-CrtcQmofqLYJeGxEWJ42acZ0QdytA&oe=6A465B6E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6d_Yqmm663IQ7kNvwGyCg53&_nc_oc=AdooYwbUrJJfe9ptcGfpYoVDtwopZNkVLZWokLlXA_FBlLYq3wHMO6-FxMwXIw_Q_Po&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1nPjfSgX5pXlloVkOCxhWwD3YwC3KQDdQP8zPdmRiIg&oe=6A467E64"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2ts0BaYenEQ7kNvwGtaBbM&_nc_oc=AdoJV05RuTBQu2ORcAzWuANlqNbsP5J4UQczQdMmdBrX7h1G7JCEq8KVX4-NiLXkpMc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wlzEPnTFm77-YaWOGdbrxnrd3oDQMR0clRcwi-MrlTQ&oe=6A4681F9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XuORGNvBiQQ7kNvwH00CIC&_nc_oc=AdrPk0VL-bn2D9UvMHcr3qIGiljbkZitp7szkPyUmix4B7UOd8Oo7_J8Vo0d5qa0rbU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FlzvNMi69-4rZsqtVugvro03570CcMbDjP4oAiSVysA&oe=6A466C0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpYNb0r4FycQ7kNvwH3CKH4&_nc_oc=Ado6hcoW8UcvDa4jFpG4s0dKP8t2QEH2UsL44QMX4D52SNh-3rGopQElsLZPHvm7X8g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KaFJ7g5uVzU49uUGNO0kJm1o9PTw8X8eEF5GuTrR9mw&oe=6A468E89"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
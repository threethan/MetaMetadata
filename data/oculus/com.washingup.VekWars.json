nc_ohc=EpJi0nunz_0Q7kNvwEFeTq0&_nc_oc=Adp0y9iXPYCMebcgFBvcSj9hl11wi4-yQ8FRZwg2jcXH7HXxcLCYksOg3lwcJ8pw0dc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-LlhNU48JDhSH73oVf8r98vp_-h_GcYmYjUhGlQViqw&oe=6AC3D22E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8X0DcZwkMwQ7kNvwFAwgtS&_nc_oc=Ado-EctGxtwLHS4O9kSUsZJGZQGiv6L2M8qbuXQQUVIocu8Io2PwvQXMRVEvJTkrVRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgyElozrDzlV6QY0fadXofjZpm-GV9cfpkZc7YS1kHVw&oe=6AC3BCE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR_weDOOEdsQ7kNvwE-EbgO&_nc_oc=Adr8T2EpmsCHixsUaPcM7XIi9dwtrgINWjb9-8gcBD8oXgyr6EM_aqpFGiaX3muPZw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIXVp5d_8f2JFYZgygoHoqTCo7BVgK9sKgfURLb_UDvA&oe=6AC3C079"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Op5Eh04zlQcQ7kNvwHzmD6d&_nc_oc=AdorEaACpRV7G2hxNuCkhlsl5dFjsVCECPdCVYVyiliiCt8PRZsk0DUVRLRKP90u29Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcAKTzGsHNDIvoyPCQhbcWPIKsL-TEZPuMZSGJX-lJwA&oe=6AC3AA8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fExned2xh2oQ7kNvwE61-_3&_nc_oc=AdpQ3JW7V45XmEpmF1a5Ty0mFXKBrznNmx_OzbTfVKxSzH4pSXCIHDejL8p3oPj5jbo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-2_838N2HpJX9oe-qK_v__4FUmt-aO-iZCNnzvPHpTw&oe=6AC3CD09"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
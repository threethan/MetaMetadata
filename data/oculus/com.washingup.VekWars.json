nc_ohc=FQ93RyA7GocQ7kNvwGjwaFW&_nc_oc=AdrK8VwUbkgS-0dAwRxMWw8_cinE4Uvj4H4m2P5GQj-KkruNwTVvoLJqLr0g7zlKolg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sRimAO5Y-P8dbTg7PRPxHVXScGDaBDsNN7z-eySZx8A&oe=6A05C1EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1lHb_IYiViIQ7kNvwHdSaIu&_nc_oc=AdoH00Ya1bvcmcaGPLoG1FYqa2vOeqck4ksfWPHqjDI5R9oAd3hByVgbdopoajLwBSg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q63OPZo_zAKzFHGnRjENkm0J0TkW-nToXz5Oied1J7w&oe=6A05E4E4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umG1lDD8_C8Q7kNvwEqvUUp&_nc_oc=AdrQXCgXAhr1h1kE1rG-XBwHCJ1StCR6LLCfVCzNn1a2t_IZINsbMQvanPRp3LoJErE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JyjGBG1WX-GyURcrQtjz2_bWNAfuSS26_Fc8XgPAUUg&oe=6A05E879"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5XdSoxFGZAQ7kNvwEGNjZv&_nc_oc=AdqEX77JpnGNf2Qa_2qQrxYzRQsp9nEjRWOjoyUQKG_HD-d9ozeS7cVEmfm3imadLOM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r3Hh0baHVha1GRG6nqYP5IU6LtDO2BveSos57NVnF5g&oe=6A05D28B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7BuBgL_YVAQ7kNvwFuLeTk&_nc_oc=AdpLXW5GGWlgjMEEp16-RVZkBwcEoumqfsq2WKoOb69nJ94WsO3k44J1LgOpMzjBHqo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gwXWLOyCGGjnQtImyA8O6kRHJFZzkEH-Cmm6VVoM0ZA&oe=6A05BCC9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
nc_ohc=hrd9lMOgY7EQ7kNvwE4kx_b&_nc_oc=AdqPZCG0Pf_HmrRb1KK_L43PH5NlNwup_2yFlGTo1V6NN9mQ_G8qONo4AB8jWfN75Ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VaE38RVjVGSfqXHWlHUrSGKgmwLkSM5Zcek_RNXJuXw&oe=69D3A8EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtXagE6zfxUQ7kNvwHm5r39&_nc_oc=AdrShxDosdCgYlkLTh3FegMUO3dXtCMDvyYzPQ79NUR6Jb2OzchwpD9yGJxpQFFL1TM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qhXNvjDx03qD8fF85iM1J_PfA8qTLRztNIPs4kvF5Yg&oe=69D393A4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4QOAWrjnigQ7kNvwF5eanV&_nc_oc=AdrHhQZrjb_teAaCUo72mZ0p0wR5GglTvSi2zg1yYkkYFveu9ruJrBQNuU6dGrnplyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Aa_mZ-z_sYrLs7GXZo7TE8d1QMRZelkvpa-vz1942rw&oe=69D39739"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCOjzCYkbWoQ7kNvwEirjbz&_nc_oc=AdpY4uSBzLQWlO0HHyGrZ9ljse0sGLUrIaWv1RxMrSlNH94H4mmxMOgy53XR-Bjpq8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aVv_A2e-0-VhH4Q2Lj7MRvcr-0LTU26yFqH-NvePduw&oe=69D3B98B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmgXShsbhOoQ7kNvwENTvAj&_nc_oc=AdoH1UGLDyT375Ej_H25zJqlM_4xaRuVePkZYECKvxQTVvxypQecRi3hkKTQreqWr_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v7FJUxmSriODGY-lH_Y2WEgrfxyKpTPvbZeUUS4U1Vw&oe=69D3A3C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
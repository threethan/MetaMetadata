nc_ohc=6EkG6e6Z0p4Q7kNvwGAjdJ6&_nc_oc=Ado2QURimHnlIfIdcTFhsXtvJ_MUiEHTQxMpdaUG-KU2r8vaQj6Np6DZ1HdaynxueNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Yc3BktulyMBj0-Br04P3khXybRr3XCXDu_MFLf0ViJA&oe=6A2EA06E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=geiZEkdRKT8Q7kNvwFDoUNN&_nc_oc=AdqBESMPJb6V89Ja4nE1la5HhDkfmrPxhFFsccfxAS7xCj3R4HToEETX2bfjzEskL58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CZoWK_tzOWA9vQE1RxkbQzWcSwKkf_xikV_s_GCm0xg&oe=6A2EC364"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUvtDDliOUkQ7kNvwGnDQuZ&_nc_oc=AdqDU3WdgKCCr8Oc_nvOkmPUzACFu4impg9Bc32lQHXa_XBKrhaG38lgXwh_RWf0qrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hH_n8pFzhso-JFvv44M9eA_Rb9yNcHQwjrFKsxDhJyA&oe=6A2EC6F9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSxPhnHf5EwQ7kNvwG93T71&_nc_oc=AdqdgSqwY1sfGNgTlqiXEumYrwALsmDykxMazLrA8r3fL4rw76k79zfl9nElRjXjsp4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iuW_sXR_3q6-bYLKhpzZHIrIx7qadjAP8djeHfzSF-A&oe=6A2EB10B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwUpdzO9i8QQ7kNvwHmVVrf&_nc_oc=AdpxYnhU5Lod-sBde-vXiwr_zFjAIEiX31cYtlMFLSS-fkZnSRythJQpbKX4NVtR-UY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bBgCIzIQsTjG5_hAA1zpqI0Sbnu6JZmn_t3LdX9jDyA&oe=6A2ED389"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
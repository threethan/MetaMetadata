nc_ohc=BoxS6nqlNzEQ7kNvwHXicaQ&_nc_oc=Adqj-yOyPE-MGw4IIXs6OmwuWsn7YAkI6UHi23kMbMeFvwf30fzPVhPnT_-vPErVuJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi5aeS876I1I6WILuI9ZohAIgXSpoQyuQmDyluO0OiTg&oe=6A78746E"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKpMyJ26qgoQ7kNvwEY7oxZ&_nc_oc=AdpbuR65U2v-9zynqDVDhubAv9K6gXrw68zcoV4V9Tkz0bGLretCLFECWnFJLVeGFBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn3ExB40dOc8S1ItbzmGuY3nN99pHcJgWYDf8Gifkxkw&oe=6A789764"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmPLdAqefucQ7kNvwFu98PV&_nc_oc=Adrd9IPkTt-7MHGHjx-EvElNE3xq5fsF5SbeU-zUdiUt7Z7FUCRylpt4ha6Sd5NzWJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6yhDeyq9zMrjKj4GCr0TRed4y67QKt6miQkcy2o6yjA&oe=6A789AF9"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEV4umPhWicQ7kNvwG9rFqX&_nc_oc=Adpfovav_nF3fv9AKftPFPTyfJt88olxJtWmwS41ENH3enHahfJYoOENREVrABVTs4w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV3GCPt0kNvwJ5lUKlj0DpLKPRgTtTO__eMev0Je1yfA&oe=6A78850B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxfJ2DKvGGQQ7kNvwFSfx3S&_nc_oc=Adrb913IgGQHB7pJhM2NQr58K8SBSDmKYZ3Rdo5-b63H_4toqxSdBrgWZce47bmG5YQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlXvMreRaj7aRtNP3pCUZs9QAiFy1k40VVcS-fBNFtlw&oe=6A786F49"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
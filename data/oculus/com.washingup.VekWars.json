nc_ohc=oipxmAyq1-sQ7kNvwH5Fu0z&_nc_oc=AdpnNWwdRTH2gNm_jU8RE4AX1uTp_vid5z9UEmcH-O3Rt-brdEYTKxdX7SrkhMyq2RA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24oY61yalFcaIhVf9OPG1uJAn-LLRxIuOcHvWWOU57Bg&oe=69DB91EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_MQ1XnxR9cQ7kNvwHRx2me&_nc_oc=Adq5f_r4jmrksY79Ysq60x7BhkkH5Is1N8To_1LR8tupiFMjex9SX6DRknp0mm7ozys&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22nJlCElWiPxZpUO9p_WhiR_Wt1pmCV1rUfytg_AkXNA&oe=69DB7CA4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UATU1aMbikYQ7kNvwEbZOLP&_nc_oc=Adqu09Sj1gEsDWUpT4_w9CXnPJtIIQdGs9SNtybllGSTRrFPW9EXnZ39jWryZvNNIoQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IwhFSC5AE4aC9BJ31pWJTywdjccf2FxuNUWltbvBTBQ&oe=69DB8039"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeVoa97ya28Q7kNvwF-cIoL&_nc_oc=AdordRjPfwzuNa5nMVruEeTAi1FuQroMs0xEJL4mz6pBB5-mTGW4BC_zVrsJF547YZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MZqA_XpLZ2o-HW7FYmYav4GKdYPInBHT1-FOfsvCLkg&oe=69DBA28B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ORcwFbSMZiMQ7kNvwFfw9rW&_nc_oc=Ado9qfdeGJ00NUQWygYiLYg9BrpMf14Tj0x_aKnFPYpmvOg6clFjvhHswLtK-3NQ0gI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P0w3hCowL8cVkU63xS4ijMFY5bnYLgeWOplqRnBJ8ng&oe=69DB8CC9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
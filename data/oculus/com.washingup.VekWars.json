nc_ohc=KCZLANE7rQYQ7kNvwE3LxLK&_nc_oc=AdqcYb8GRSK7-VyPMKS-gITNF0UVlHHCBSgsrTKtwXbC7IUekb9XIo1tfFeE2nJZShg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XWDWH-n3hp2xQxt_deETt60uo7RZCjBM1tkNLVr7Ylg&oe=6A1D7CEE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO3YYOs-gzMQ7kNvwHDKPwL&_nc_oc=AdomGf9ZjE5d_IPdDUT77Unie5J0e3qPBShp2dTP3qIyJZQMKCiqnGSha7mUwyTouzo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64UPn_-Zc7_6eBgmztsbFpJ9qJCJ9osaVWR5IWBsSHdg&oe=6A1D9FE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZF-BzVuDpwQ7kNvwF_fFa3&_nc_oc=AdphTD2a3oSMbScbbmv3IJY-l3aqFhjFWW6ZXGmMO5VMHQqhvYWiBQxy7AU9Gbd2dbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LkxufIpzvpfXWkpiLLUK-p3a36YAIb9OEmOjl09S-YQ&oe=6A1DA379"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNO-D0FV4lIQ7kNvwHX4DBP&_nc_oc=Adoz1K31WzY0bbgwUMsNBJ1-ToBs0W23tjkIwiymBpEfGfoNk-3ZTvUZQdLnnnOvaH0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jJXKAUN3l5V-hN2Jm0flomck_Mh_udLePt5ix5yYhCQ&oe=6A1D8D8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJnZPCZ0KusQ7kNvwFq4fxV&_nc_oc=AdoEaRWh6suSx5ojPtgK2G0XUTH8Z2XYMsBhy-o2ffV8JYJCNql9YrZ7TOuRa1te9tY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mQ7vW5FDf7fKIqQToo-acOUq4gy_V30jjDb2wBh_I7Q&oe=6A1D77C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
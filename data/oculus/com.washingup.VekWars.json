nc_ohc=4qiaAf3_UuIQ7kNvwEUDBrc&_nc_oc=Adp1cNYVYmertE8lVSivgZk1tk8ZFnKd6r0j5GzCb3LX_AddC1HLvAWsyhFRim0cQcU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXijW6HI-kdn16YKdHCpwDmDpuBY8Wvb98wi8PcLf2Vw&oe=6A7F0BEE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihbMzmf5UG4Q7kNvwF_Lj2I&_nc_oc=Adr_7RjeixDXRlHtGzkeH2mZEILUJCDanOSXXJDAr8f95iN_TcWjbPyNsT6EouCz_EQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIgWjam2jlfrM7h97yWDGE-kue3srVYBn5FkA4E5WqXw&oe=6A7EF6A4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTs-8pKfomwQ7kNvwGS5xQR&_nc_oc=AdrIqzbr1grzFMqrbWPPVpv1uBfPYNhZt8CJH8Ni7isXsESWwJFHOj_zTp8PGlPhPCU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeLFsU0KMfhxf1HcWbHXaRsVaIfwei2fAR82XPZudG7g&oe=6A7EFA39"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRj36CK5fNEQ7kNvwGgpMpC&_nc_oc=Adrpbrqj4wNqiLfhQb86oYbzTzGYZnFJuKjML1d9Q--o68xlkXRmlXuYs850wJI5QBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnFb0pSzhYKRIiBI5ZcufQLs8rMGp4e1IQhPb7URpn6A&oe=6A7F1C8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U8-cQVPB8AQ7kNvwFPbc0d&_nc_oc=AdpDlnGg_dvTag8pvkTHlSYvfOUECgGjUM8dtqDCIdK-ihnrdCu7dYB8m53itBw6fsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBmPcfxPwCUWzgy6bcqYPzdOZeVr-szZjh3l5fgdgNWQ&oe=6A7F06C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
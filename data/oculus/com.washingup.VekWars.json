nc_ohc=lFVVt8wjResQ7kNvwF5CvmK&_nc_oc=AdrqtoY8TBhlac_KvYhxcVSv503A3oagcDrEzCLjurJPF57X_daPE21qwT-kN4-D-ho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAdN1vqTJ7LIk_ammNFydjXz0i2FQ6V6O65vCjoRzmvA&oe=6A69F3EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgsxJbS3wRcQ7kNvwE1ZoCI&_nc_oc=AdqNK9TkpLyxUvvaOvLU58PJPBsFnprcDS5bsG5oTW1LcXRO6QR9UvrUqoU8HgDFVXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSyA6jYaR6JIcaa6fWRxLPej83L_l8GXiqhimyd99Bag&oe=6A69DEA4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBgdEGrI5wcQ7kNvwEjL8bT&_nc_oc=AdqKMmGKZOvkbU_NahdSHlG6JqZ4wrjusk7fgRwumFiz4jECldCFBoADYXTEf-Cq9x8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnN0SK-gCoQnx1i6noiGbcPp6jOXBAg1zsc0sMQLOQaA&oe=6A69E239"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXJ_xjO_L0IQ7kNvwGW67cp&_nc_oc=AdrbQFi1janGeMQj6agWS2bOT_ZDqviVP-OtoPOzcIsAlj3_epD-dlsGelnIXF0I2VE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByl6zgXcKIP2fVQoI2WqkOBaFkFt21oKJIzlpq8di_PA&oe=6A6A048B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GExy5PGxLpQQ7kNvwFvRbhc&_nc_oc=AdoLU6t7M5O_8yrxDB9yc6YaGfLYj4Vm_qLDQo9KVrq3_aOfmlZOpzhCtRuszRh9ptE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNVLOdXK42-Crq05-Gr2GHLN6aIcMtsLhgIAuXfZSyzQ&oe=6A69EEC9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
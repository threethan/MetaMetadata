nc_ohc=dn5TQTwWLyAQ7kNvwHOMh8F&_nc_oc=Ado11tRYmsDnHM4yauJV-x0l1bUPhwfv3Q9vkNqP88d7GF1LAX5Z4mMPDZh-iIBCqxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKucNu914P6L5Q2vahfh2f52zfVQWK0gwDROo9WtA-npA&oe=6AB3C7EE"}, {"file_name": "vlcsnap-2021-06-12-14h00m25s657.png", "id": "340707407397440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036687_340707414064106_2314165390838311878_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4gSV2KUsh0Q7kNvwGyBr6b&_nc_oc=AdqfXSWcDSQ7rXdD6AWz18KoepYj956Hlryl5sTo1Bh4BQ3V8GImnlC54pVT_5-SMe0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJg8L-vcg0e_HrLIkOlQG9rJezbtH5OgIapEm4qrTEDg&oe=6AB3EAE4"}, {"file_name": "vlcsnap-2021-06-12-13h54m10s607.png", "id": "977519356333595", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75297585_977519359666928_618276497729463444_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9sNlllxhvX0Q7kNvwHPZbMj&_nc_oc=AdqZ9wKh0DsDLIsRlk9N3owHnHleEB4IlMn-Cc2S9jlUPGIuK9EragDleKtFnPlda88&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc0q3mi0AjwQrH15pFSjfdkD6mqh4Hqr1MXrhksHJmjw&oe=6AB3EE79"}, {"file_name": "vlcsnap-2021-06-12-13h55m37s312.png", "id": "813667725942033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974650_813667732608699_4135009108225206640_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT3G0zJLZAwQ7kNvwF_Zxzj&_nc_oc=AdrMZIa2ba_TDMCxx62IQIWI7u_CO6o_Qy7mJd2y1zSqO7YIMKlQ1_LP0I90-OIagLM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhyvMssRKwYkgv0ky7Z4BLMW6lIYUyFKvdY4GqpJ9BLw&oe=6AB3D88B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video cover.png", "id": "555819285824415", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974503_555819292491081_4245145935810136201_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgieH4MhWCUQ7kNvwEDGFBg&_nc_oc=AdqMusomSeFf7PChLm_sxet0hWBM5WYCiigGvsMqm1m_muJo72q08a-KpuSOTK9Zzl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhkcXIes4z_6ROIibqCjMxHOnpCPthgChgcfxk0yKhyQ&oe=6AB3C2C9"}, "display_name": "VekWars", "keywords": [], "long_description": "Sometime in the mid-1980s development began on a technology that, had it gone to market, would have changed video gaming as we know it.  A complete virtual-reality system meant for arcades, utilizing twin head-mounted vector monitors of the type used in many classic games of the time.\n\nSadly, funding for the project dried up before it reached completion, and the first game for the system - VekWars - never saw the light of day, continuing to exist only in rumor and a handful of blurry photographs from the period.\n\nBut now a team of digital archaeologists based in Austin, Texas have successfully extracted the source code for this game from a dusty 8-inch floppy disk provided by an anonymous benefactor.  We are pleased to present VekWars - fully updated to support modern virtual-reality systems (or non-VR monitors) and playable for the first time in over 35 years!", "short_description": "Defend the crates and win the war against the evil Xilorian Empire in full-color Virtual Reality!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/b42fed67-d13b-408e-8d07-0373d591f257", "developer_terms_of_service_url": null, "publisher_name": "Washing-Up Software Projects", "support_website_url": null, "website_url": "http://washingupsoftwareprojects.com/#/vekwars", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lan
FD2"}, {"file_name": "Screenshot_Wheelchair_07.png", "id": "1301110867710392", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031553_1301110874377058_105540335935781830_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MHaF24e8KukQ7kNvwHA4Jfv&_nc_oc=AdqDkZxBCp9GLDcQZJKLN_T-a_cMaeJlCxXU6dPDik4zlGRBpaInXaAdVQP4e5rhemo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2QZQF7VbAZ6iUwQqVqKiWG3Pdr-fw8cttwEC_HOH2PQ&oe=6AA96918"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_Wheelchair_04.png", "id": "1310890330123232", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39036627_1310890333456565_592960263825966664_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u10VyxBJk3IQ7kNvwGBX4iq&_nc_oc=Adr1rbxLDdfuo9HwNQthI5E3cXO5iuN8ZAUptDGbRzxsavgQpXvnmHGWuz25R0CdBEI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNgTXJ2Qhv8zDp1cVp77mV0TNHmaElZ-MQlTQPKJEdQQ&oe=6AA9636D"}, "display_name": "Ambulate to Wheelchair Simulator", "keywords": ["CNA", "nurse", "nursing", "wheelchair", "training"], "long_description": "This VR tutorial teaches how to assist a patient in ambulating using a wheelchair, focusing on safety and patient comfort. Steps include preparation, communication, positioning, and maneuvering. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\nBy completing this tutorial, learners will be able to:\n- Remember the protocols for assisting with wheelchair ambulance.\n- Understand the safety measures necessary to prevent injuries.\n- Apply the techniques in real-world settings to aid patient mobility.\n- Analyze different patients' needs and adjust the approach accordingly.\n- Evaluate their own performance to ensure best practices.\n- Create a safe and comfortable environment for patients using a wheelchair.", "short_description": "Master the skill of safely assisting patients to ambulate to a wheelchair with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7584697754988719"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "692717226894396"}, {"status": "PUBLISHED", "id": "1079844440360930"}]}, "baseline_offer": {"id": "692717226894396"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1749742500, "status": "PUBLISHED", "id": "692717226894396"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8955732907885190", "v
681915796_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kte8MUP5fukQ7kNvwGg1E95&_nc_oc=Ado7XoMZpQcsfnaKrubF_LmonOmWDlEwgDS7vAUx2IIO3x-q83MGEukiDyagWLe3jMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXxJAKupo6dKuxvkYOjmkkcxO8RS0oHIeIBqZgAoWmmbQ&oe=6B1034D2"}, {"file_name": "Screenshot_Wheelchair_07.png", "id": "1301110867710392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031553_1301110874377058_105540335935781830_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMh-0fSecG4Q7kNvwHJtqGQ&_nc_oc=AdrtewsblN8Ek2gQSgw8NNzSAPsFrgtfKK7n5xLGlNe_c0TOfoKWksmV4I-RZj7nkEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWDIZgd_NXal5GuEuqkUPeLE9kYEMYS2hr5A7iQproq9Q&oe=6B103E18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_Wheelchair_04.png", "id": "1310890330123232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036627_1310890333456565_592960263825966664_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1G3Tz0V2oIQ7kNvwFFil8M&_nc_oc=AdoOYMtiaR19sT_zqpAoktBHOiNFfBpf1O8mxBsAHkojYvAreegTTQ8Vk4wmOvOPVkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUELWoOr0ycM1Y0uRP3OLnTrsEdqlecuJhMNzhfNAU0mQ&oe=6B10386D"}, "display_name": "Ambulate to Wheelchair Simulator", "keywords": ["CNA", "nurse", "nursing", "wheelchair", "training"], "long_description": "This VR tutorial teaches how to assist a patient in ambulating using a wheelchair, focusing on safety and patient comfort. Steps include preparation, communication, positioning, and maneuvering. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\nBy completing this tutorial, learners will be able to:\n- Remember the protocols for assisting with wheelchair ambulance.\n- Understand the safety measures necessary to prevent injuries.\n- Apply the techniques in real-world settings to aid patient mobility.\n- Analyze different patients' needs and adjust the approach accordingly.\n- Evaluate their own performance to ensure best practices.\n- Create a safe and comfortable environment for patients using a wheelchair.", "short_description": "Master the skill of safely assisting patients to ambulate to a wheelchair with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7584697754988719"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "692717226894396"}, {"status": "PUBLISHE
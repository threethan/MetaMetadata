681915796_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kte8MUP5fukQ7kNvwFdjld8&_nc_oc=Adp3exBygu0mYYbZTKZxWM1W9F7HRoAFsNO8_wO3ufmOrE_2I_yh5npYAxjyv-sS2mQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYVwVu_HFSK-8KOoCeEQ9CvANBPKiZDdMxrtbjM80OeQ&oe=6B0F1B92"}, {"file_name": "Screenshot_Wheelchair_07.png", "id": "1301110867710392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031553_1301110874377058_105540335935781830_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGKN_LfGNAIQ7kNvwGmCUdS&_nc_oc=AdqgqOxee86Il5a20KTJ89qat9277wEA4Pblq-Had_SeOuf-HvuIAucNjKsoe0lHS3s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVqF7M6xGOEcctZ385szJFYTVZMKbFK12oYBucZXmBRdA&oe=6B0EEC98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot_Wheelchair_04.png", "id": "1310890330123232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036627_1310890333456565_592960263825966664_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1G3Tz0V2oIQ7kNvwEtcBu9&_nc_oc=AdoOioIEOIHiducmI4siOywL_4gU78W6c-p-K2fpsiJqFy8MVlPvy0yFW9GM0iWtsSc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWpEHyFldNfEkxp-jaBWhYOnrlzrfz_tsEccfbrI_1bjQ&oe=6B0F1F2D"}, "display_name": "Ambulate to Wheelchair Simulator", "keywords": ["CNA", "nurse", "nursing", "wheelchair", "training"], "long_description": "This VR tutorial teaches how to assist a patient in ambulating using a wheelchair, focusing on safety and patient comfort. Steps include preparation, communication, positioning, and maneuvering. \n\nWith multi-language support (English, Spanish, French, and Arabic), this simulator ensures inclusivity and accessibility for a global audience.  \n\nThe experience is enhanced by an AI companion, acting as a virtual mentor, to answer questions to reinforce learning.\n \n# Key Features: \n- Multi-Language Support: Tailored instructions and narrations in four major languages to cater to diverse learners. \n- AI Companion: An interactive assistant that responds to user queries, and provides clarifications to meet learning needs.(NOTE: Generative AI is still experimental)\n\nBy completing this tutorial, learners will be able to:\n- Remember the protocols for assisting with wheelchair ambulance.\n- Understand the safety measures necessary to prevent injuries.\n- Apply the techniques in real-world settings to aid patient mobility.\n- Analyze different patients' needs and adjust the approach accordingly.\n- Evaluate their own performance to ensure best practices.\n- Create a safe and comfortable environment for patients using a wheelchair.", "short_description": "Master the skill of safely assisting patients to ambulate to a wheelchair with AI guidance and multilingual support for better learning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "fr", "es_MX"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7584697754988719"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "692717226894396"}, {"status": "PUBLISHE
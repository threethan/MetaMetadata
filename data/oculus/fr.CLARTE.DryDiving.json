fs1JDbL8CJ3Qv27DM1_XztD4xNEdb0L_XEICFx9-OCblw&oe=69A6DEE3"}, {"file_name": "screen2.png", "id": "5490610187726349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75278190_5490610197726348_1811300334213347436_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bW-GrtYWqjsQ7kNvwFaKFg1&_nc_oc=AdlILUnV9STVM0rP6fHWRXhrNFzSY_GFc9_CP_heUZqtFGvtP0oiTJWePTYLxF60_VU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftGM9Yb7CCproP3w-lDKb1AZHsSKu6kKwp3UF3ah_ZFrw&oe=69A6EC00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1270655497004281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580063_1270655500337614_2963898565556583484_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgLIlWx9zA0Q7kNvwHQQz9v&_nc_oc=AdmEpOw6Ur2x1Y3wo6evdjiiUT8iWzhBZrglx03iTRc02Bh-VDffMhb_5XJfKYxRf4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsK9gfT9cnjiTufFsn6mxYR3EjC8JsoPGa0FdkSqJHEDQ&oe=69A6DB4A"}, "display_name": "Diving with the Nuestra Se\u00f1ora De Los Misterios", "keywords": [], "long_description": "Welcome onboard the Deep Scout, a personal submersible that will bring you deep in the Algeciras Bay in the search of the wreck of the Nuestra Se\u00f1ora de los Misterios, a fictional Spanish ship that was built in 1565 in the Cantabrian shipyards. She was a merchant ship sailing round trips between Cadiz (Spain) and Madeira.\nYou'll be provided with cutting edge technologies to explore the shipwreck and discover her destiny. Ad\u00e8le, your personal assistant, will guide you through the steps of examining, identifying and revealing ancient artefacts.", "short_description": "Explore the seabed in a personal submersible and discover the story of the Nuestra Se\u00f1ora de los Misterios, a ship that was sunk in the XVI century.\nThis experience was developed in the Interreg Atlantic Area TIDE European project."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/6d247654-0620-
fv6b_6vIWTbcsRJ0vbFEwQl5Xz1APmXVN_A9Sk-2VY_xA&oe=69985E63"}, {"file_name": "screen2.png", "id": "5490610187726349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75278190_5490610197726348_1811300334213347436_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSZ8kiMw2cAQ7kNvwE5OomK&_nc_oc=AdmaiTyizqqQommGdQkhLjTkSKgNXikdmyd1ShwwtPr7w-SjtfaqxqA_AaxVQu4Q7Ok&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsHiXobsy50GbcL9f43ABJdNEtijX4bfIOfhBgvpCWpQw&oe=69986B80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1270655497004281", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580063_1270655500337614_2963898565556583484_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uqz90Wmn5wQ7kNvwEST_GT&_nc_oc=AdnYpEOABTikBNrVnUC24ahuShB7H4Yj-L7_orjKCx33gAAKba4x8Fs6mgjsSie0sJE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftM1QPWfaVMwzTaXiYbAFYL3O-k4ZJaUVp9H-iEzbg4RQ&oe=69985ACA"}, "display_name": "Diving with the Nuestra Se\u00f1ora De Los Misterios", "keywords": [], "long_description": "Welcome onboard the Deep Scout, a personal submersible that will bring you deep in the Algeciras Bay in the search of the wreck of the Nuestra Se\u00f1ora de los Misterios, a fictional Spanish ship that was built in 1565 in the Cantabrian shipyards. She was a merchant ship sailing round trips between Cadiz (Spain) and Madeira.\nYou'll be provided with cutting edge technologies to explore the shipwreck and discover her destiny. Ad\u00e8le, your personal assistant, will guide you through the steps of examining, identifying and revealing ancient artefacts.", "short_description": "Explore the seabed in a personal submersible and discover the story of the Nuestra Se\u00f1ora de los Misterios, a ship that was sunk in the XVI century.\nThis experience was developed in the Interreg Atlantic Area TIDE European project."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/6d247654-0620-
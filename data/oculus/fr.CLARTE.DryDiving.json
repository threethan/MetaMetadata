7kNvwFlsdxV&_nc_oc=AdlLSB-tZ_uZ3ReSJIWpJd9RyRhAQNao827zdOXcpC8ZXbepjWBmU_WNcb2bmmluYyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEiUHZXEbyIV8YOyUsIq1dWq5Q94SnEWANuo2ihqBf-A&oe=69B14CD0"}, {"file_name": "screen5.png", "id": "774120880402845", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75557066_774120883736178_3286820836422471422_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMwDqc6AU68Q7kNvwHpLoES&_nc_oc=Adkp5NFmo0Jzsa3a_BKbxOCq5k0gIl9toNWvWeODghw_HzQrwxVuum9iG_3sfsRadnk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBKHcZEq7DgGFWQtBqhPriJ1i-_2o_r3OVvFQaS80qZw&oe=69B15219"}, {"file_name": "screen1.png", "id": "1376970466044473", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404389_1376970472711139_3211618457292333072_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNTDH8q9y2sQ7kNvwF-_dcv&_nc_oc=AdlcUPmS9nN4efctDzxPqjXnWROIClhFQ028m-dJQsG8i5_7ug-pcCcaA2uWD3dtAmU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyUQAcCDLDi_e0yk5i5HqFmdXBuB1CGG2_AYGE9xYCjA&oe=69B16AE3"}, {"file_name": "screen2.png", "id": "5490610187726349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75278190_5490610197726348_1811300334213347436_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3iWHyVy3bsQ7kNvwHZWq86&_nc_oc=AdkUeP9rD0ofKT5t8x3APIShD4HzFSKUNAH77Q9KSb85VjWLya92HtHJ1WegHeFMtKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyHmSFZ5tfOwTqDWQoOytyI0_jMH_dwtRVYZcKkPSJ5_Q&oe=69B17800"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1270655497004281", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75580063_1270655500337614_2963898565556583484_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1Ki27Lgc_oQ7kNvwEkw5gH&_nc_oc=AdmcE_7O__iKEJ-ZK7GGeY2y0m3Atb4ztuGLz3xIiAI2aZQEJLX_KjlLrRmZ4vG-6bA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7SRKVxdyOh8uJ0UrtxGWh48a2EmpHzsEYQdlRy5UuPw&oe=69B1674A"}, "display_name": "Diving with the Nuestra Se\u00f1ora De Los Misterios", "keywords": [], "long_description": "Welcome onboard the Deep Scout, a personal submersible that will bring you deep in the Algeciras Bay in the search of the wreck of the Nuestra Se\u00f1ora de los Misterios, a fictional Spanish ship that was built in 1565 in the Cantabrian shipyards. She was a merchant ship sailing round trips between Cadiz (Spain) and Madeira.\nYou'll be provided with cutting edge technologies to explore the shipwreck and discover her destiny. Ad\u00e8le, your personal assistant, will guide you through the steps of examining, identifying and revealing ancient artefacts.", "short_description": "Explore the seabed in a personal submersible and discover the story of the Nuestra Se\u00f1ora de los Misterios, a ship that was sunk in the XVI century.\nThis experience was developed in the Interreg Atlantic Area TIDE European project."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/6d247654-0620-405a-b7d6-2ee7e82a8095", "developer_terms_of_service_url": null, "publisher_name": "AppLab", "support_website_url": null, "website_url": "https://www.tide-atlantic.eu/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3449667415304178"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscd
ftYvN_Ofoc8YpWYOpoLbp9kCsWgADMAgKug4uTnSI97JQ&oe=699DA463"}, {"file_name": "screen2.png", "id": "5490610187726349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75278190_5490610197726348_1811300334213347436_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XF1ybg9QMQUQ7kNvwFGztkV&_nc_oc=AdncX1cH3t3BQ6-Ph2Xahr1xB-JXuNmBl_LXudcvKWhO4R4YU-Vntl42FO1eZa5bR-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuvjNwzCwxUr7SzWI-P1CNkM_ZO8o6I6A77FJZ2xngd3Q&oe=699DB180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1270655497004281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580063_1270655500337614_2963898565556583484_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxXiSr7otKEQ7kNvwGdAVUW&_nc_oc=AdnYCCJlfkAbeqi0Gfzwh7kGojVkUBuVFlkJz7hWFKaYXi4LNFPqQpLvZxxVeM7vdRo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupjPirXf0kIpO4cOac5Kv5_UnmKhFqt1HhqNBwM50ujg&oe=699DA0CA"}, "display_name": "Diving with the Nuestra Se\u00f1ora De Los Misterios", "keywords": [], "long_description": "Welcome onboard the Deep Scout, a personal submersible that will bring you deep in the Algeciras Bay in the search of the wreck of the Nuestra Se\u00f1ora de los Misterios, a fictional Spanish ship that was built in 1565 in the Cantabrian shipyards. She was a merchant ship sailing round trips between Cadiz (Spain) and Madeira.\nYou'll be provided with cutting edge technologies to explore the shipwreck and discover her destiny. Ad\u00e8le, your personal assistant, will guide you through the steps of examining, identifying and revealing ancient artefacts.", "short_description": "Explore the seabed in a personal submersible and discover the story of the Nuestra Se\u00f1ora de los Misterios, a ship that was sunk in the XVI century.\nThis experience was developed in the Interreg Atlantic Area TIDE European project."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/6d247654-0620-
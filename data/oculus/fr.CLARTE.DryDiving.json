7kNvwGCls1k&_nc_oc=AdlwkR3cZ5cP1hgpevwtiW6gQXpROEXSH58gETyd5Glo0mxugqaYst5nde1Xj8q8U2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvnjkZqvZQEMN8_fiNmcupo4MbpAkoikqap84rcT38Bw&oe=69AEA9D0"}, {"file_name": "screen5.png", "id": "774120880402845", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75557066_774120883736178_3286820836422471422_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMwDqc6AU68Q7kNvwFMAGpx&_nc_oc=AdkL0z8FWnC_yM_HgaOJ9YbnejwZ4A0oJeJfcZ_QyBJ0tgZSzAFY8sEqUesvu27l67c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzenMulCJ9fHBQLx_TLXQ-sO-YuXf8HX0Ldv7BQ94FnHA&oe=69AEAF19"}, {"file_name": "screen1.png", "id": "1376970466044473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75404389_1376970472711139_3211618457292333072_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve979cHpp_0Q7kNvwFUjtLd&_nc_oc=Adn1-fxP5GQ7K5juugHK-Bn6-m5PiMa5YveNNmoQTtUDdIb-_XTik_VFIdRo5S8IzwQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyb2KkHNBVkzw4m80Rxqc4FPu7Y8I9cGScVO-cqAUTdzw&oe=69AEC7E3"}, {"file_name": "screen2.png", "id": "5490610187726349", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75278190_5490610197726348_1811300334213347436_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3iWHyVy3bsQ7kNvwHp7Goj&_nc_oc=Adn-nLrH7Yp7-ekJV1q5cnbhwRemKpuaAFBDNklGJO4dyVAE_mACMdnx-Xj5PfW2K8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzHDcx5dPyOJVYyhRzDtH3OjlQWpfLIGHe8zuUv1aAAuA&oe=69AED500"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1270655497004281", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580063_1270655500337614_2963898565556583484_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og4U57DNr4MQ7kNvwGJ-IDi&_nc_oc=AdklYMZfyVm45bbPMt_hkudfmy1ha7s7now8ujniqBm7RTpZrW5F6oePfIyw--4hWqA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRcnv7h8Z1qqGzGp5nyXx0OySEwMutXzzp5k4tEoNw2Q&oe=69AEC44A"}, "display_name": "Diving with the Nuestra Se\u00f1ora De Los Misterios", "keywords": [], "long_description": "Welcome onboard the Deep Scout, a personal submersible that will bring you deep in the Algeciras Bay in the search of the wreck of the Nuestra Se\u00f1ora de los Misterios, a fictional Spanish ship that was built in 1565 in the Cantabrian shipyards. She was a merchant ship sailing round trips between Cadiz (Spain) and Madeira.\nYou'll be provided with cutting edge technologies to explore the shipwreck and discover her destiny. Ad\u00e8le, your personal assistant, will guide you through the steps of examining, identifying and revealing ancient artefacts.", "short_description": "Explore the seabed in a personal submersible and discover the story of the Nuestra Se\u00f1ora de los Misterios, a ship that was sunk in the XVI century.\nThis experience was developed in the Interreg Atlantic Area TIDE European project."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/6d247654-0620-405a-b7d6-2ee7e82a8095", "developer_terms_of_service_url": null, "publisher_name": "AppLab", "support_website_url": null, "website_url": "https://www.tide-atlantic.eu/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3449667415304178"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscd
-tiLLot8p3KTRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2F8rcDqyK4y8blfaoYBJuPNerK4Tp44Vkt99PCkGytaQ&oe=69F0CD10"}, {"file_name": "screen5.png", "id": "774120880402845", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75557066_774120883736178_3286820836422471422_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0S5KZJMmfUQ7kNvwGZsbq0&_nc_oc=AdpfN4re7rZYlUx5VCnjwYGKt9gRDgD0COC02-29omdvikKER6hz1iRf1dCtd4MZE0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1xOubYVeEq-OwdcI9ea7qTfnxaTvF6rJrumeiCfCNdZQ&oe=69F0D259"}, {"file_name": "screen1.png", "id": "1376970466044473", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404389_1376970472711139_3211618457292333072_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kerb_vE6ePMQ7kNvwGaquiq&_nc_oc=AdqwyaWtge-CYNE4bD2wKHqblvsG06lQnmTY99iF55alJmm-cN-0gufa_5GE9Z8JrIg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0xafT5nmsYeZHe07OutAvbl164muUQlD5FZfdTMJEAsA&oe=69F0B2E3"}, {"file_name": "screen2.png", "id": "5490610187726349", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75278190_5490610197726348_1811300334213347436_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcGDeYYgZ_wQ7kNvwHo9R_h&_nc_oc=AdrbCKiY1b_cd2-LJ5GGgAMigzZPAZP9e0cIgUW5rfmid_cJkFtRD1q5w2KIpE2Xq2E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0wtaQfekMXu7BCt4qb2JzArQ9i2G709cAfYDGvA9MGAw&oe=69F0C000"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1270655497004281", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75580063_1270655500337614_2963898565556583484_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAzaE3XjSdsQ7kNvwGuk04C&_nc_oc=Adq1dk0jFOy9xgJBhR_68FJqZPnexDkOjXrgE2W39LpWgFoS-rs9dVfsPyU9_e1r6Zk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3P8RHWPjOYCtv4Ej1LvKiCqbo5nU2d9yjy0e5ILmMnwg&oe=69F0AF4A"}, "display_name": "Diving with the Nuestra Se\u00f1ora De Los Misterios", "keywords": [], "long_description": "Welcome onboard the Deep Scout, a personal submersible that will bring you deep in the Algeciras Bay in the search of the wreck of the Nuestra Se\u00f1ora de los Misterios, a fictional Spanish ship that was built in 1565 in the Cantabrian shipyards. She was a merchant ship sailing round trips between Cadiz (Spain) and Madeira.\nYou'll be provided with cutting edge technologies to explore the shipwreck and discover her destiny. Ad\u00e8le, your personal assistant, will guide you through the steps of examining, identifying and revealing ancient artefacts.", "short_description": "Explore the seabed in a personal submersible and discover the story of the Nuestra Se\u00f1ora de los Misterios, a ship that was sunk in the XVI century.\nThis experience was developed in the Interreg Atlantic Area TIDE European project."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/6d247654-0620-405a-b7d6-2ee7e82a8095", "developer_terms_of_service_url": null, "publisher_name": "AppLab", "support_website_url": null, "website_url": "https://www.tide-atlantic.eu/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3449667415304178"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75278190_527180645434948_3637155434376102044_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_s
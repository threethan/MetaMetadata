73", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75404389_1376970472711139_3211618457292333072_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1XitI8tNUcQ7kNvwHjFi__&_nc_oc=AdoXX2f8hwIfCgFy7ey6OmeDR5OfHrU3LU5MZm9bYjHQTAM11d5w7xAzrB5MuIBTq30&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1lrccmKgOj6ogxVqwKO4j70Iz1CDffaAueRAV8PRgIg&oe=6ABFAE63"}, {"file_name": "screen2.png", "id": "5490610187726349", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75278190_5490610197726348_1811300334213347436_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rC6JYn7AOfAQ7kNvwFU9uh4&_nc_oc=AdqMFYr72eClOxzpS0btt5AU06dkMuQRaDasMQd7K94HC3D7LeWHbVyUbI4c5eAqHCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1s-dNTBadmFiZu_8kuehD5xFdaAsoed0jxfUlbvngyQ&oe=6ABFBB80"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1270655497004281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75580063_1270655500337614_2963898565556583484_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDKDf2nvvt0Q7kNvwEpemZf&_nc_oc=Adp--TpxYKApE0U8vhTg_FHlH73x8S87CeTabIqisDy80KnKT22OJlxYH-EeWRDRAHk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNI0czn4cX9BnQGMI8pABpEB-tvAyQqdHTPTygHs435hw&oe=6ABFAACA"}, "display_name": "Diving with the Nuestra Se\u00f1ora De Los Misterios", "keywords": [], "long_description": "Welcome onboard the Deep Scout, a personal submersible that will bring you deep in the Algeciras Bay in the search of the wreck of the Nuestra Se\u00f1ora de los Misterios, a fictional Spanish ship that was built in 1565 in the Cantabrian shipyards. She was a merchant ship sailing round trips between Cadiz (Spain) and Madeira.\nYou'll be provided with cutting edge technologies to explore the shipwreck and discover her destiny. Ad\u00e8le, your personal assistant, will guide you through the steps of examining, identifying and revealing ancient artefacts.", "short_description": "Explore the seabed in a personal submersible and discover the story of the Nuestra Se\u00f1ora de los Misterios, a ship that was sunk in the XVI century.\nThis experience was developed in the Interreg Atlantic Area TIDE European project."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/6d247654-0620-405a-b7d6-2ee7e82a8095", "developer_terms_of_service_url": null, "publisher_name": "AppLab", "support_website_url": null, "website_url": "https://www.tide-atlantic.eu/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3449667415304178"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1668387250256320"}]}, "baseline_offer": {"id": "1668387250256320"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1677718020, "status": "PUBLISHED", "id": "1668387250256320"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5581763871928936", "version": "0.4"}, "id": "7334238709980814", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4644390438999622", "is_concept": false, "latest_released_binary": {"__typename": "And
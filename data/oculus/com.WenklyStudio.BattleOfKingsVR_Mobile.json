6768_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPMkuRNvCVwQ7kNvwHpPGsb&_nc_oc=AdpVceXr3E3KMpaP-3BUKHPX51XO_KAgN2SHFkwSxKTi1hnyzsxR6MDiw8gckWIr1KY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK67QyvWDK7Bhmb0sDlLb2bSszJ0nUbXg2V3tWsNcJqLA&oe=6A998198"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt1.png", "id": "139070946809199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386286_139070953475865_183562607263744000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G5B4m0ATPUQ7kNvwGeTLo0&_nc_oc=AdoSuc8ZJbIqnOpJfO3syUs-ZOXNk9DZDjUef1vt2F8Qo0fpPdGi7iYMQHLkOQ_RF2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfXLjNYEryKEwhy7D0UIN1IW2PmPNII94I5tr8_lczfw&oe=6A9982BC"}, "display_name": "Battle of Kings VR: Mobile", "keywords": ["RTS", "Strategy", "Multiplayer", "Tower", "TD"], "long_description": "The time of war has come! Take the command and use your strategic skills to defend the siege against your fortifications. \nYou can\u2019t win only by defending your Kingdom. Develop your economics, assemble and upgrade your army to defeat the enemy forces in a real Battle of Kings.\n\nKey features:\n- Towers of different strategic usage\n- Classic tower defense levels\n- Battle levels (featuring defense, offense and economy)\n- Battle PvP mode available in multiplayer or against AI\n- Different environment themes\n- Lots of possible winning strategies", "short_description": "The time of war has come! Take the command of your kingdom and use your strategic skills to defend the siege against your fortifications. \nYou can\u2019t win only by defending your Kingdom. Develop your economics, assemble and upgrade your army to defeat the enemy forces in a real Battle of Kings."}]}, "developer_name": "Battle Of Kings Team, Wenkly Studio Sp. z o.o.", "developer_privacy_policy_url": "https://wenklystudio.com/", "developer_terms_of_service_url": "https://wenklystudio.com/", "publisher_name": "Wenkl
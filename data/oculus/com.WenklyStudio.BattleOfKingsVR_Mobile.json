6768_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iFW0V0UXycQ7kNvwH-Kp7J&_nc_oc=AdpKwyrT593SOSlgPd45vf7Lu6pGLZff8YU9XJO-XXTcAQAdwP6EPqcpsqwEpcgbVIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RfAptJDeirANRL66LvKZdP9Qcm4i73pc_yy3IXDP-VA&oe=6A3BE718"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt1.png", "id": "139070946809199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12386286_139070953475865_183562607263744000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLrfw1xIMY0Q7kNvwGYox46&_nc_oc=AdoRpNZZnyAH0tFfXF-l6tN4DZTVAtmHgT3LZAQYK1L7KQftmlPZvxz1ZVd5X-Nskbg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J5seJWET2PRjwCL2Ac-HUljqaXst11C1xdEWdoTpmxg&oe=6A3BE83C"}, "display_name": "Battle of Kings VR: Mobile", "keywords": ["RTS", "Strategy", "Multiplayer", "Tower", "TD"], "long_description": "The time of war has come! Take the command and use your strategic skills to defend the siege against your fortifications. \nYou can\u2019t win only by defending your Kingdom. Develop your economics, assemble and upgrade your army to defeat the enemy forces in a real Battle of Kings.\n\nKey features:\n- Towers of different strategic usage\n- Classic tower defense levels\n- Battle levels (featuring defense, offense and economy)\n- Battle PvP mode available in multiplayer or against AI\n- Different environment themes\n- Lots of possible winning strategies", "short_description": "The time of war has come! Take the command of your kingdom and use your strategic skills to defend the siege against your fortifications. \nYou can\u2019t win only by defending your Kingdom. Develop your economics, assemble and upgrade your army to defeat the enemy forces in a real Battle of Kings."}]}, "developer_name": "Battle Of Kings Team, Wenkly Studio Sp. z o.o.", "developer_privacy_policy_url": "https://wenklystudio.com/", "developer_terms_of_service_url": "https://wenklystudio.com/", "publisher_name": "Wenkl
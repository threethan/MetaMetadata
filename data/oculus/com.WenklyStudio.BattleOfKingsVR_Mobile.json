6768_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iS8zoOIRDzMQ7kNvwFJOoBp&_nc_oc=AdqPGcqD9yTQeF2Lb2PPHSZYfbviKRm8O6a4TD2Imop56LtXJxSKZmhYBH0MF1nvJZ0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHReYyfPJIbo-72Cenus52s8N3i8iOxhHMA7mRsxOpv_A&oe=6A900ED8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt1.png", "id": "139070946809199", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386286_139070953475865_183562607263744000_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYca7D1HSWEQ7kNvwEBXe6-&_nc_oc=AdqkTJMQeHOeuAlJfri_Ko_W5X0oRxWloDziDsydbifYgCDwWCgeAShzSHUZ8mxTq-4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvwLyVGSEE8w3AN65QbmzsaOGcYYUizLT3oxzhYynmIA&oe=6A900FFC"}, "display_name": "Battle of Kings VR: Mobile", "keywords": ["RTS", "Strategy", "Multiplayer", "Tower", "TD"], "long_description": "The time of war has come! Take the command and use your strategic skills to defend the siege against your fortifications. \nYou can\u2019t win only by defending your Kingdom. Develop your economics, assemble and upgrade your army to defeat the enemy forces in a real Battle of Kings.\n\nKey features:\n- Towers of different strategic usage\n- Classic tower defense levels\n- Battle levels (featuring defense, offense and economy)\n- Battle PvP mode available in multiplayer or against AI\n- Different environment themes\n- Lots of possible winning strategies", "short_description": "The time of war has come! Take the command of your kingdom and use your strategic skills to defend the siege against your fortifications. \nYou can\u2019t win only by defending your Kingdom. Develop your economics, assemble and upgrade your army to defeat the enemy forces in a real Battle of Kings."}]}, "developer_name": "Battle Of Kings Team, Wenkly Studio Sp. z o.o.", "developer_privacy_policy_url": "https://wenklystudio.com/", "developer_terms_of_service_url": "https://wenklystudio.com/", "publisher_name": "Wenkl
.png", "id": "1451142325880584", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819980_1451142329213917_3529361324006788146_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GLCqthJC0kQ7kNvwGQm1Dp&_nc_oc=AdpGSNExqR8BSxKCTQQLQvYe8Hp2u8colNoaf20kAXgVhQwqjyCq4fjUSQknWoeujHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhNESnwRxVFbVvMyDYc-C54_4Qs65JLcpNmiAXqcWwgg&oe=6AF5EDD7"}, {"file_name": "\u87a2\u5e55\u622a\u5716_Start_en.png", "id": "733762122710540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819983_733762126043873_8986367884510769117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYRGR1O4T4sQ7kNvwEcZGHH&_nc_oc=Adox-dGdfjOyZxO3ULaud5mRxgJHExA4OcVfVVoYrm7dox4pvv-I9Hd9Shy6n1KonR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6b6tn_Yp6FWmbT5XyBfi-sIWes-GXCeM5CtT58Kk6dw&oe=6AF5ECCD"}, {"file_name": "\u87a2\u5e55\u622a\u5716_005_en.png", "id": "4006506956229553", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818925_4006506959562886_886962986091600680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJf-dV7ttDQQ7kNvwGxYS-N&_nc_oc=Adrd9vx8c647_pAm8UnkqRT0fLN2nmlIhGCduNajOxpA-wQCQZSriaBmMtEW2dkH-qg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHU77OeBVEQFrXp58AfWZ03WgNN4nrMewJwJvvUM06Kw&oe=6AF5CBE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "1414149362958847", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823431_1414149366292180_6413016103247393244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO41z5dflxEQ7kNvwHwBdIT&_nc_oc=Adq_k8Pni8t99Nx2pYQYEXbjJinQcN5e_DG_Dto0Z1uCSAOhaGXEcd7A7-xS5J79Prw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlcxz7lSsFu0vOWBXQ8Ubl_YlSgNpRTEkcIap62ba0og&oe=6AF5C843"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Free, TW)", "keywords": ["CPRTraining", "AEDSimulation", "MedicalTraining", "EmergencyResponse", "ResuscitationPractice"], "long_description": "# Trial Version Service Update\n\nHello, and thank you for your continued support!\nPlease note that the Trial Version service will be officially discontinued on **September 7, 2025**.\n\nDon't worry\u2014all features from the trial version have been fully integrated and will be regularly updated within the Professional Version. When you upgrade, you'll keep all the familiar functionality while unlocking new advanced features and exclusive services.\n\nNew customers can get a **7-day free trial**. Upgrade now to experience a more professional and personalized service!\n\n**Professional Version Download Link**\uff1ahttps://www.meta.com/experiences/24070258989326707\n\n=====\n\nBreak free from traditional training methods with immersive MR emergency simulations.\nBy integrating Mixed Reality and interactive hand-tracking technology, this solution delivers a highly intuitive training experience with real-time feedback and full learning history recording.\nThis program follows the American Heart Association (AHA) public guidelines for CPR and AED training, ensuring compliance with international standards.\nRescue actions are naturally replicated, training effectiveness becomes visible, and instructional quality and emergency response efficiency are greatly enhanced \u2014 ushering in a new era of emergency simulation training.\n\nIf you have any questions, suggestions, or wish to exercise your privacy rights, please contact us at:\nhuagingofficial@gmail.com", "short_description": "Experience immersive MR emergency training with advanced hand tracking and instant feedback \u2014 empowering you to learn critical life-saving skills with speed and precision.\nCPR & AED training designed per AHA public guidelines.\nCombining MR, gesture tracking, and real-time feedback, our system offers intuitive emergency training while recording each session to improve learning outcomes, accuracy, and on-site rescue confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huaging.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "HUAGING Digital Technology", "support_website_url": "https://www.huaging.com/collections/cpr-and-aed", "website_url": "https://www.huaging.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "vi", "id"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24608531298777589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823398_1223375529586585_3117119178924933258_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXKUr_Ru6YoQ7kNvwH0bjF8&_nc_oc=AdpN6GatwXT8k803eAqXa-Yf5XyPi17lZ-XagKz4HFWydAPBuomeDudjjLO6X8fOCgw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQptGsNFiOKDYv01_r4UZPgOKC_EOjUISBIo9JFtOw8qQ&oe=6AF5E801"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Heartbeat Rescue: CPR+AED MR (Free, TW)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1752025680, "lastRevision": {"nodes": [{"id": "10061532283904065", "release_t
1_1854340612088978_5850742372458720086_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raJyrSw2PhsQ7kNvwHzZs0A&_nc_oc=Ado5Qvn4jyUOHyAWrguHSlOJatcWs5LFccratNkUFrma5sPyS2rM_gnluADNbAtr47s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBLsIXbN2uzbFnzw_yl0sgCkbNLupDsMBg3Z9rzWvS-w&oe=6B0B1A35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_TW(en).png", "id": "1415969616192774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820956_1415969619526107_8775771946972576141_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xP8bEPNBEicQ7kNvwFsM2fF&_nc_oc=Adpdr5SaqnehPYzY91GmVlfMJjYsBfuaIGGYbDPfH3hqmsNX8CC7yU_6uQ_d7MjazZM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8008w9cUpCYSiQh3F3V9aC8VAVTFGgLR6rDcOl2pU-A&oe=6B0B2284"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Free, TW)", "keywords": ["CPR", "AED", "VR", "MR", "Training"], "long_description": "Break free from traditional training methods with immersive MR emergency simulations. By integrating Mixed Reality and interactive hand-tracking technology, this solution delivers a highly intuitive training experience with real-time feedback and full learning history recording. Rescue actions are naturally replicated, training effectiveness becomes visible, and instructional quality and emergency response efficiency are greatly enhanced \u2014 ushering in a new era of emergency simulation training.\n\nIf you have any questions, suggestions, or wish to exercise your privacy rights, please contact us at:\nhuagingofficial@gmail.com", "short_description": "Experience immersive MR emergency training with advanced hand tracking and instant feedback \u2014 empowering you to learn critical life-saving skills with speed and precision.\n\nCombining MR, gesture tracking, and real-time feedback, our system offers intuitive emergency training while recording each session to improve learning outcomes, accuracy, and on-site rescue confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huaging.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "HUAGING", "support_website_url": "https://www.huaging.com/collections/cpr-and-aed", "website_url": "https://www.huaging.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "vi", "id"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24123505383946852"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1049149606794692"}]}, "baseline_offer": {"id": "1049149606794692"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1752025680, "status": "PUBLISHED", "id": "1049149606794692"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24608688302095222", "version": "0.1.7"}, "id": "1100947848725756", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "10061532260570734", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24608688302095222"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name
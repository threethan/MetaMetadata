.png", "id": "1451142325880584", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819980_1451142329213917_3529361324006788146_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKD37WDCkI0Q7kNvwE9Ptu4&_nc_oc=Ado2yWw1J0OlXCSM1DSBn_BwPRnFpyP3unETRr1nQK2hT7kGBXX8GTRqHXUipKvnoSQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOo_JPAH050I15ThZFi5bnnu-Ymw-BKoMGtczOyGdBSHw&oe=6AD3A6D7"}, {"file_name": "\u87a2\u5e55\u622a\u5716_Start_en.png", "id": "733762122710540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819983_733762126043873_8986367884510769117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7v1ymwirVoQ7kNvwFjQq15&_nc_oc=Adqd9HNmsOecxrhzJVmDMMBlU5cRrpy1chOCIkN0mzKULei-JpfBOqSDYekIhagGB_I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg3dJ3UuTIXWQVWo9VQ-u2yOCc-f5uIsKucQ1S4xyFgQ&oe=6AD3A5CD"}, {"file_name": "\u87a2\u5e55\u622a\u5716_005_en.png", "id": "4006506956229553", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818925_4006506959562886_886962986091600680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uXYwtHiU2QQ7kNvwGllLq2&_nc_oc=Adrub7XDRt7_xhXYAci9yT7YKcHifRTMjTyzcyQKqu21jJqQHHPWtKgpxN-LImXXdio&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3_rBKa_Xhl3Q11DNZDqn4yYJqvyVNDExp2TDu9sGPkg&oe=6AD384E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "1414149362958847", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823431_1414149366292180_6413016103247393244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWXGqCDnd0EQ7kNvwHW63_5&_nc_oc=AdoxRBIA78A1yWkjfXfiSH_6Km6DEmJXKtaMoCwkIzrv1XRfdN2uZwyN4AYslwjjzXU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6vIwrTLTlDiP-EX02Q-2GnS4Pcaj39Ww6DcFit4AKog&oe=6AD3B983"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Free, TW)", "keywords": ["CPRTraining", "AEDSimulation", "MedicalTraining", "EmergencyResponse", "ResuscitationPractice"], "long_description": "# Trial Version Service Update\n\nHello, and thank you for your continued support!\nPlease note that the Trial Version service will be officially discontinued on **September 7, 2025**.\n\nDon't worry\u2014all features from the trial version have been fully integrated and will be regularly updated within the Professional Version. When you upgrade, you'll keep all the familiar functionality while unlocking new advanced features and exclusive services.\n\nNew customers can get a **7-day free trial**. Upgrade now to experience a more professional and personalized service!\n\n**Professional Version Download Link**\uff1ahttps://www.meta.com/experiences/24070258989326707\n\n=====\n\nBreak free from traditional training methods with immersive MR emergency simulations.\nBy integrating Mixed Reality and interactive hand-tracking technology, this solution delivers a highly intuitive training experience with real-time feedback and full learning history recording.\nThis program follows the American Heart Association (AHA) public guidelines for CPR and AED training, ensuring compliance with international standards.\nRescue actions are naturally replicated, training effectiveness becomes visible, and instructional quality and emergency response efficiency are greatly enhanced \u2014 ushering in a new era of emergency simulation training.\n\nIf you have any questions, suggestions, or wish to exercise your privacy rights, please contact us at:\nhuagingofficial@gmail.com", "short_description": "Experience immersive MR emergency training with advanced hand tracking and instant feedback \u2014 empowering you to learn critical life-saving skills with speed and precision.\nCPR & AED training designed per AHA public guidelines.\nCombining MR, gesture tracking, and real-time feedback, our system offers intuitive emergency training while recording each session to improve learning outcomes, accuracy, and on-site rescue confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huaging.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "HUAGING Digital Technology", "support_website_url": "https://www.huaging.com/collections/cpr-and-aed", "website_url": "https://www.huaging.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "vi", "id"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24608531298777589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823398_1223375529586585_3117119178924933258_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-75T8jOL0oQ7kNvwE6dfKP&_nc_oc=Adr8kkmhpQ09AWRplnWuTP0rAUKjjaFZqCcywRy-NIcuT8E_IIoIDg2Enz8Yh8zpO4U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyKA9oF3hjyui4KHZty9BLckyTCRxXYA8T6Xr9tfkFkw&oe=6AD3A101"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Heartbeat Rescue: CPR+AED MR (Free, TW)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1752025680, "lastRevision": {"nodes": [{"id": "10061532283904065", "release_t
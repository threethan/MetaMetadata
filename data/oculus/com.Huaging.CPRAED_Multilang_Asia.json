.png", "id": "1451142325880584", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819980_1451142329213917_3529361324006788146_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiqPNRj04hQQ7kNvwG9Wc-2&_nc_oc=AdpgxC4XAC7eDKFsWlOZCZWTW5OVaHw45hyAAcAuy8o_Df81xz58dK17tPbkZ3e125c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1Ab_hZauXaRQWKqndOsrQy7_hb9kFCYiWSnkcRZJjeA&oe=6AA15597"}, {"file_name": "\u87a2\u5e55\u622a\u5716_Start_en.png", "id": "733762122710540", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819983_733762126043873_8986367884510769117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gqTqRlYnNMQ7kNvwEJ8B4a&_nc_oc=AdqxfWJHq-M75xhM4F_2aIN_3a2qoM1llqzbzh0CHiGMh2tfUpYJZtj9YXjdjOUGxpY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_pBkihc_gyJdyY4BVX563fapaGgDDNw1CYpw0ZzRsHw&oe=6AA1548D"}, {"file_name": "\u87a2\u5e55\u622a\u5716_005_en.png", "id": "4006506956229553", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818925_4006506959562886_886962986091600680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YHWNHdEaWkQ7kNvwHYh4V8&_nc_oc=AdqA6lTtUExqFigC2qvxUTBytjBliKNgPizrsTz5bNHPkLxQvjSzdkg-ZUWUM-4FLGE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNtgqvnoJIQE3XElhtB0rhAcDdEdopygHFno20R24IsQ&oe=6AA16BE2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "1414149362958847", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823431_1414149366292180_6413016103247393244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7c8lS2VM78Q7kNvwEQ_23Q&_nc_oc=AdpnzZr17zWLcc9LBI-bNbnILxdBuO6AfVWHgKF7c1seKKZaBcx2zJgOPQLezm7qz1Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZDNjN7KXqmLyfUv0W804rowguCLr-uHC8iuwPatHOcg&oe=6AA16843"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Free, TW)", "keywords": ["CPRTraining", "AEDSimulation", "MedicalTraining", "EmergencyResponse", "ResuscitationPractice"], "long_description": "# Trial Version Service Update\n\nHello, and thank you for your continued support!\nPlease note that the Trial Version service will be officially discontinued on **September 7, 2025**.\n\nDon't worry\u2014all features from the trial version have been fully integrated and will be regularly updated within the Professional Version. When you upgrade, you'll keep all the familiar functionality while unlocking new advanced features and exclusive services.\n\nNew customers can get a **7-day free trial**. Upgrade now to experience a more professional and personalized service!\n\n**Professional Version Download Link**\uff1ahttps://www.meta.com/experiences/24070258989326707\n\n=====\n\nBreak free from traditional training methods with immersive MR emergency simulations.\nBy integrating Mixed Reality and interactive hand-tracking technology, this solution delivers a highly intuitive training experience with real-time feedback and full learning history recording.\nThis program follows the American Heart Association (AHA) public guidelines for CPR and AED training, ensuring compliance with international standards.\nRescue actions are naturally replicated, training effectiveness becomes visible, and instructional quality and emergency response efficiency are greatly enhanced \u2014 ushering in a new era of emergency simulation training.\n\nIf you have any questions, suggestions, or wish to exercise your privacy rights, please contact us at:\nhuagingofficial@gmail.com", "short_description": "Experience immersive MR emergency training with advanced hand tracking and instant feedback \u2014 empowering you to learn critical life-saving skills with speed and precision.\nCPR & AED training designed per AHA public guidelines.\nCombining MR, gesture tracking, and real-time feedback, our system offers intuitive emergency training while recording each session to improve learning outcomes, accuracy, and on-site rescue confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huaging.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "HUAGING Digital Technology", "support_website_url": "https://www.huaging.com/collections/cpr-and-aed", "website_url": "https://www.huaging.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_TW", "vi", "id"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24608531298777589"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823398_1223375529586585_3117119178924933258_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEVvOcDXQ_sQ7kNvwHzsTZ6&_nc_oc=AdoTfhx-uStpYjCzc01yUSo9xYML4ADYbfTAndB1z4RAgYpfhzT6vGcmnYqCcS6SROQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj4liy4vT57QTkAZ4BZGytXfKIptomwamwCBWACAsukw&oe=6AA14FC1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Heartbeat Rescue: CPR+AED MR (Free, TW)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1752025680, "lastRevision": {"nodes": [{"id": "10061532283904065", "release_t
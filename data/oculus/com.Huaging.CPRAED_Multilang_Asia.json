4370133_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJNJXQDtlfIQ7kNvwHYEdYv&_nc_oc=AdqfwktzNJ6MBTnoVXe7DezosX3HAc_jWUmstzDspnfrq1PCfhpPVSLmO1SHlZSzero&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3Luy8WpF5qjWV_m7LM5ESeI3JqF_sxIcDlFBAjurugpA&oe=69F21776"}, {"file_name": "\u87a2\u5e55\u622a\u5716_005.png", "id": "1854340608755645", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618351_1854340612088978_5850742372458720086_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfbvQepcz7YQ7kNvwH_nhv_&_nc_oc=AdpLMGdX24MPRPmoDzzetq3JrWt1Q6LfqlIqntSccM-ocRDBPUUyhYULoneUQIvwCww&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03TdqD9KBe9lASFhG26hhyKZthmrAjW66HiRqMlNnkKg&oe=69F21275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_TW(en).png", "id": "1415969616192774", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820956_1415969619526107_8775771946972576141_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZ7xEC-uNX8Q7kNvwEpmAd_&_nc_oc=Adr8xFz3JPF6KiwVFaGVBvTzRxDMjVwQHiIFH2hASRa9oEQO_4QeQB5WsyvXFCM687g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3LzSl3xLIdlH8ROkH1QPTVC0kCB0yKM2YqMIakQ9cDfA&oe=69F21AC4"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Free, TW)", "keywords": ["CPR", "AED", "VR", "MR", "Training"], "long_description": "Break free from traditional training methods with immersive MR emergency simulations. By integrating Mixed Reality and interactive hand-tracking technology, this solution delivers a highly intuitive training experience with real-time feedback and full learning history recording. Rescue actions are naturally replicated, training effectiveness becomes visible, and instructional quality and emergency response efficiency are greatly enhanced \u2014 ushering in a new era of emergency simulation training.\n\nIf you have any questions, suggestions, or wish to exercise your privacy rights, please contact us at:\nhuagingofficial@gmail.com", "short_descripti
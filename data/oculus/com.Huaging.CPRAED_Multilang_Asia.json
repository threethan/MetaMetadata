/t64.5771-25/491819980_1451142329213917_3529361324006788146_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJtGrGzfkmwQ7kNvwGkRudD&_nc_oc=AdnGZx4lfesgSqTJwt3rFFbBmZx7wdTY2GGyndmtmXGAeujN60f6BRQCPi7XNcu8njE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJ9GjR1SM7DLP6EtGNGF-SaHMGJWOH1whWYicazkQIgQ&oe=69BD4217"}, {"file_name": "\u87a2\u5e55\u622a\u5716_Start_en.png", "id": "733762122710540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819983_733762126043873_8986367884510769117_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHykehaks_gQ7kNvwFZqGD5&_nc_oc=Adn-wKYYBas4DSipwdR2fB1MnvTt8RuihNDXliYuax8wHrYStdwRUFMzJ8cYjbJUXZA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHN3DLOhNXBOyUk2f7MpBAUWDqsO54DC9quD7sYHdW4Q&oe=69BD410D"}, {"file_name": "\u87a2\u5e55\u622a\u5716_005_en.png", "id": "4006506956229553", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818925_4006506959562886_886962986091600680_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeZCqa_ClkwQ7kNvwEqcpdp&_nc_oc=Admhtb9ZY7mBBb-2y_FEVqrYETyUYJ6cNR3bbtx7ehGo1h6OV18sU2_X46Zi5h1TFm4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxn4RTii8k59X0yvO6xvWinPgA3g5L5dBKbbIfUr5kjxQ&oe=69BD5862"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "1414149362958847", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823431_1414149366292180_6413016103247393244_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6SPuYVqkXMQ7kNvwEiz75l&_nc_oc=AdnZNXQNdUMyNaJzdioSEsJjXZhoPxJ-HzsninPcNQjSs26rkVzKdVZ3v7JCnbqRHj8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzvEaT_QlcY1kId5a1lz84D5k7qLkG_80QLARTSJfWXRg&oe=69BD54C3"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Free, TW)", "keywords": ["CPRTraining", "AEDSimulation", "MedicalTraining", "EmergencyResponse", "ResuscitationPractice"], "long_description": "# Trial Version Service Update\n\nHello, and thank you for your continued support!\nPlease note that the Trial Version service will be officially discontinued on **September 7, 2025**.\n\nDon't worry\u2014all features from the trial version have been fully integrated and will be regularly updated within the Professional Version. When you upgrade, you'll keep all the familiar functionality while unlocking new advanced features and exclusive services.\n\nNew customers can get a **7-day free trial**. Upgrade now to experience a more professional and personalized service!\n\n**Professional Version Download Link**\uff1ahttps://www.meta.com/experiences/24070258989326707\n\n=====\n\nBreak free from traditional training methods with immersive MR emergency simulations.\nBy integrating Mixed Reality and interactive hand-tracking technology, this solution delivers a highly intuitive training experience with real-time feedback and full learning history recording.\nThis program follows the American Heart Association (AHA) public guidelines for CPR and AED training, ensuring compliance with international standards.\nRescue actions are naturally replicated, training effectiveness becomes visible, and instructional quality and emergency response efficiency are greatly enhanced \u2014 ushering in a new era of emergency simulation training.\n\nIf you have any questions, suggestions, or wish to exercise your privacy rights, please contact us at:\nhuagingofficial@gmail.com", "short_description": "Experience immersive MR emergency training with advanced hand tracking and instant feedback \u2014 empowering you to learn critical life-saving skills with speed and precision.\nCPR & AED training designed per AHA public guidelines.\nCombining MR, gesture tracking, and real-time feedback, our system offers intuitive emergency training while recording each session to improve learning outcomes, accuracy, and on-site rescue confidence."}]}, "developer_name": null, "developer_privacy_policy
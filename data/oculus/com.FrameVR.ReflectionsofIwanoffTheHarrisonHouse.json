/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlTWtRb7th8Q7kNvwEyepby&_nc_oc=AdpNuTYEEXIsoEUi8BfgiEJmuMZHDDYUUcJbGGSr65iyAN-tGuBAroyPxyiKQJlxfGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERtXvpmAHFPPWfmMEPP38vi6czuEGSyc7dVar68BgEYg&oe=6A7B1378"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydfljQryn_oQ7kNvwEoEG8x&_nc_oc=AdrB2KtkDrQHR8AW-w5zGH9TGVMSlV9mSUDt2nKmPNMZJ8Yd4p_Y7TGFF6DEcQ7Dqdk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqrxOYaWkZEcCLQH4y70SUx_0tkKNUJIRyu3YsCFWW3g&oe=6A7B0EC3"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ip7KAwvUeRYQ7kNvwGBb3R_&_nc_oc=AdpcyhhsF7pYi6mU6AYtqNBqyB7O1NYltc8KKRPEstWJHqRXlVjvC7DyOFedJYgQJx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP1XPWstUVbI7Aa_GOZYj7nhH3PffpnN2j3Bpdu3lz4w&oe=6A7B0680"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn1yXl1v1x4Q7kNvwHME6rS&_nc_oc=AdoGqHqBXMMP8raU3yNfkimcUW3nF6q-i5gay6LwZn5ah5SytW5-Yhjy7yFyvBziRu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwQswZMuzZj9rMtxxHbX68Xm4WGyMVlVKkfIq-KGfdlg&oe=6A7B0A4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWn-RNHIBrAQ7kNvwEzzKx_&_nc_oc=AdphqipnYA5z5iBDHAZUqcSyByURJX2JZwNDQW0cT8mpe8ZFZM4_uHTLFs49Cr5jaw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRnBk4BoBANj0JAShYz3epfjF3YntSpDq0iSfrEcAj-Q&oe=6A7B0959"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
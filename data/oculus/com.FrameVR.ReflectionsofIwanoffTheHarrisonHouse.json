/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaDLQi47lnAQ7kNvwHs7fJ1&_nc_oc=AdpUYkSDsK31kF0nWXXRN8Or1aLNtW58za3OphBVu7vB3p5EGu9Kkbxg2mzpdN7K-Ys&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZwBCpVB2MFuWc7KzEAKE_jphGw1FteShK_-HzhTncwA&oe=69C7C778"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3uvBLF6PwOcQ7kNvwGe5yhm&_nc_oc=Adrp00i1hOdyWqzolGu3hNATTjVBAtZOLvMfdvPtweBMjosG7X8CyZISpRTHS9-VZ44&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNiXW17VT2EbITe34yJqU_ViscF2R9GgN3Q25d9GvRdA&oe=69C7C2C3"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqbOWuwjVVgQ7kNvwGQalfd&_nc_oc=AdryKJtANvT2Pmq-piBSeEerwuLHrkVa9LZCMqY82A_pM-uLN8PnLB-KyxIdgCO2mc4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxB0fvMaPwAgWrypAExWOLn_i2m2g5-l_F-zEpHtg7KRQ&oe=69C7BA80"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr6LlUjmBxMQ7kNvwH65s00&_nc_oc=AdqlYgT3Fs_Oywj-Id3DFgLndXCTMgJmnmOS1zFd_YM2QyAVqalEx6hxlYxK2GsVdoM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgeyULDw8yHmhtBwZ2pSiz1dnS66vYFcyPwQBEPUzuCA&oe=69C7BE4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QloJq-1htQ8Q7kNvwH9JaZP&_nc_oc=AdpOKSot3K2zq6_Qa1dBZGNz11SXF7cJEdON7s1trlz_5YTTXu0vPgMeg8TYpK4Vxz0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6DnB_jGpUevbR0C0heW4jp_i4lDMTQT4L9XHKTPez_Q&oe=69C7BD59"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
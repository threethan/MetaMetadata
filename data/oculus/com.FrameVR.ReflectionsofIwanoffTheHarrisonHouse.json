/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knt8ZpT2mHsQ7kNvwH-nLKW&_nc_oc=AdomTpPi06K1F0XSeuFDTyYHw2dTBytsS1_p3EVC5XY-cEKqor50ad23oC04nsJmmTI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O7LqJ2FnlpKrMBlxB4U5R9m0nQf2oYRfjPqDPpqiSNg&oe=6A2C31B8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEcxNdrf6DYQ7kNvwFOQvZB&_nc_oc=AdoDfKnEP3hlD6CEpl8Fwb0vhBKxRrfq09ksmm4p2SZP4lq5tHS5bepzgxKGLrm4J8w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DUmypvvtlP9AtlxFnDfUaQgERi6w4bGY5OuqImXeZqQ&oe=6A2C2D03"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmgF-zStcAQQ7kNvwG_-36Z&_nc_oc=AdruI39BNuB9KX27tR6buQs5r7Czc-hPER_MIjH1u2NqgDL2u0k-mYS_wSi0XltWlnA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mAUfcA5WGLbt8chTiq0-EEpSoWbBEmj38VAFhNeEhYQ&oe=6A2C24C0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4x5QtVXDtAQ7kNvwEGoR-L&_nc_oc=AdqM-NFBN8Gt1N8y9RXUmU9ue-I5FR1AI4z-lX0UdSCTnBd3JeF-hUoICTUsXBecNmE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qmElLlKPuZZlyunUE8mDGKae7bOOixymkAMMI1UP9cw&oe=6A2C288C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX4ne6S4bTsQ7kNvwFHJn2x&_nc_oc=Adra1ck8JvbytB94zLGAM6OjM3cvGdPcaCskxUfbIFwMMCiOx02Z2Gbe-vXDm2s2Qns&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ztAwpSYWLPglsGo0IUl3vKQoz5X88YvLxKmsuwXsQDA&oe=6A2C2799"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
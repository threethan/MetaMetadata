/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yu2DEbgPVJQQ7kNvwG4JplN&_nc_oc=AdrzLXCumY6dPEAXa9DduQpRqqGcdT2hHkoG98-W5F2cWb06eGh5ARon85cVAvwTnyY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrWQgyC_KXvfeTo0e2Bo1_zuuCL0UqEvUZUDPztD0wag&oe=6A9AEFB8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBzlaLjIkA8Q7kNvwGIl8Xf&_nc_oc=Ado_hY_SZgDGGxm0wDIlU_-_1fOo_Ur782Az_IfIJv1sQ9gA-EDbQPjHd8A9vAO79nQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIddz92E6OoHaGrk5b1IM6HGdUZpOMOsra7ojtLn3j4_g&oe=6A9AEB03"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8O4PYKZDgYQ7kNvwHsANt0&_nc_oc=Adr4M03ZRHRD3UDME87S_xK8Ne-OQ74chmwcQ63uEFLmk9BJ3Rbz8VGMMdrC0qOv84A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzRteGbkaTOPYnzQwrn0ApwSNAZWpGSc0l6j1Td4IWgw&oe=6A9AE2C0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in38BYjhlcwQ7kNvwHmNFcg&_nc_oc=AdrifgGLexc9-ROE0mCdo8uR9N495kaXfDb-sF_xgMhrkWIdipoFXMIVOx5zzl4IMpw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3wUvIbY7E6hV9toALzfnm8fRpe8vQj3mo32mzK7STRg&oe=6A9AE68C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McKVFLrUogcQ7kNvwGngEub&_nc_oc=Adp1iHLiSRuGWbn4uT34Sd2GSw_o6x-Y184fPPkjCtN1QGSrZk4Af3mf-dcXa0htzNc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU6j-hl_UhHtORgdMVjeZRW-XmfRDH6W0L19zU7Ww9XA&oe=6A9AE599"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
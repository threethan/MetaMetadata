/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KsXQFCHEM1cQ7kNvwFsNhRc&_nc_oc=AdpqjjwpW4ZcnLjwDf8gCu28LsLtHJ3jtw4bJ7Um5WFV7LOE_r-FoDxoLXDoOS2MgAc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYqF_4VPekzD7Ud_CY8D3dBirnBDTE3Tc6sq-SQt90lg&oe=6AC7C2B8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XR56zL57hd8Q7kNvwG4JIr4&_nc_oc=AdqqP6FaN1QnrV_QRFa9b8T75K-jvbLAcpkqJE9ewVnDiVNGbfu1Ao9oZ95d66HCr2E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWIHCVynt1Dl_vPuHCn4e7nFE3cWM2_nkOk8nF54xFqg&oe=6AC7BE03"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM1mfwdvyfUQ7kNvwF_Tfxz&_nc_oc=AdrmBzDAKNnGMyAoO9z2VFpHyVxfl7FmB1YJaLaYov52FQ3cwSUIPJujy94NM0KZs48&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgxWF-kOUuLLu8invUb1C0in2bzyYOlJrzQf2S9cslgg&oe=6AC7B5C0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhNt4j6GikkQ7kNvwGJmQ2N&_nc_oc=Adq45p8fI0rp2Fx_iTmh0GuSq5DvlsC2HjC5sZlozAhUgkijkGLn8v_tYr4xTeqGR-U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZ6F5bWViU82zVoDXHSFjTjgA2mayDY6t3edTXJyMtMw&oe=6AC7B98C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOqSlAX9w18Q7kNvwF1uCaQ&_nc_oc=AdpaEgEoRWEjAhrCTQs6QJhGn3ms18masidLLUb2V5dizUSNwHuZP_hfP-EiZtJcngY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5av0dUY9MlrgSj5IuOAgX5zMcmLxtEaPis8beegUigQ&oe=6AC7B899"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
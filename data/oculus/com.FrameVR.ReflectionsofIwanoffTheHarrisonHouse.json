/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMBOr344yVkQ7kNvwHDwtEJ&_nc_oc=AdqPjI98hmlVejJs4NqSQiXkAZPWrqqnY4thzTTADkwhudnDXz-vrx-upBo9r82lT2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68_OEv1gGBZgWPiaRNcJ0MOC4JPFErQxm82gK_ACBk2A&oe=6A070F78"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAb0aQwFSlYQ7kNvwEoDGRC&_nc_oc=AdoZYtF9umXE0hvFdfESgGPMFlxzAp8SO0BI0f7gy3xC6l31ZAFoEEt7zd9Z_sR3nxw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6idzt8jVIWiWlQUUCRsuc37EpEx0IoQYiCepzK8IsHPA&oe=6A074303"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5V0FaUmB90UQ7kNvwHM_Yt3&_nc_oc=AdqPV7MM6NF-ceGNtftrH9PHbiZcNLpAFO_EfV1CKxqtnu3NOln-7K34yTIZuEhog7I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RQFCRUNq36WDZw350CNbHZh_RLfbA5XHgHpSkpf-TMA&oe=6A073AC0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ml2ByxDxRCYQ7kNvwFhLufV&_nc_oc=AdouX4FpQ_jOD1PSxYRFe1rD09rXXRmMsxFLn6-H008qgBWmpEG_ZfEuVXa-akof6bI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Xd6dEl93iqytqNIpFfbwk-O5CB1TjFFdMs2znp7tMvw&oe=6A073E8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJlbHOCmp8YQ7kNvwFx7bYQ&_nc_oc=Adr_gcedxrbK5i9s7bnb4IGSJ7-bRiGWbaCq67u46B9cwpILywWT8g4QjZYdJwoA_-Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KuI3v6UQ8SAmfwYrTlH3Q3fPHD4T_oXB7-pXyGw2pRw&oe=6A073D99"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
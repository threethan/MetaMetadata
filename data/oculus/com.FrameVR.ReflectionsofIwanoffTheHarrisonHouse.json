/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFCaJ16A31UQ7kNvwHwfAqW&_nc_oc=AdpPOGnta_qF_ZAKR2NwgCIzLorvTUC1OUZb09pWYCBz-wDVYCtYfFGvyN_JnhtvXpA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlmKDdStt55BG9c9BRna1gp5s4xEP1UAn579lt4OetJA&oe=6ADDF3F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6s35Ef6H8EQ7kNvwHYoe6Y&_nc_oc=Ado52ypJemwyMqIY4AGg1F1WR4NsjyCYVKY689QrIUq9yeS-Ga1bVjzbaIG_AaQrmg0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOtoL6LagK3qxlsQHwvK7IYJQyfVyIvX4i5vz2JCYdxg&oe=6ADE2783"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9WhSBGgXBTgQ7kNvwHfQWtt&_nc_oc=Adrs4JK6arPupRelA4J5XrYFff1XjJqfW1MaZ7jqiaNI07J4WMkd7u4dqNKn_1klYFo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6W70y8RPalsCHNmjcLzyYg-2h8S4PGStK7erqQdAj3w&oe=6ADE1F40"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sy9Ylt6uuKkQ7kNvwHBNG3q&_nc_oc=AdrPFQvDiYIVSWAlHryIF87JtHikiMYNiiCB7FsHc9YxdXtGm-fbX8pWAnxg_q_mMyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPazZs76giQX86jC1IDYsAGMMR68I20XXyntmgbnCHR6g&oe=6ADE230C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhmFkPnuclwQ7kNvwGhfXvl&_nc_oc=AdqEvKw2QYGQgQ2YYiFMXtFYqcAj4vPXBMz3OIU-sy_EcLiZdLxlvc-KVpiZKCt9P0I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUEDhg5nfKEA9EtVotayTArD_vClrRHmNVoGsRVGC_zQ&oe=6ADE2219"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewOMh50q7-EQ7kNvwFcberu&_nc_oc=AdpgwObkytn-EAm_EtHeq6_abK8E_7k13wa5y-TlxLroUgAQJTMVU-JgbrY808m5yek&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ks7cOcl6YukGRXCPuZr_LJFAYJhrmiyjhc5xrlScXqg&oe=69E76B78"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFedkJq8grQQ7kNvwHXQcKW&_nc_oc=AdoJx0l1fqsoJkCOxdLZY7K2Hau_3-oP6IV5iKdXv_JI-qm8hM_Hro-0aitauHSbL48&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DWJ-iFyBh2Sy6vZ_IbkVl2WCB0BZ5chmBjGrzxbiRSQ&oe=69E766C3"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HAxjsoVZfEQ7kNvwGADRFT&_nc_oc=AdppkAkw-HxmiHyfoZE5vDFf2SrX3k8xydD4BK8RBwTWxgS2RzowfEAhE8mzacRm_Xc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NQlJwcjHi5SrfN6-406d10la18ujC5oBrM7BOysxkKQ&oe=69E75E80"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTjR-kOwynEQ7kNvwEGe8-X&_nc_oc=AdrZcp-JuFq_bASN3ZnlcVtqD0V6U-uaF4fFjLI48U3zZ8AL8sM5NVRPZ51hoYviOQ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZzT7dKtA1eZNL6X_m1OAQy2fjsIq21gylcU3rXD2GUA&oe=69E7624C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=niTcR7gtBb4Q7kNvwGDTAqL&_nc_oc=AdqNWMu4TDiQjswgv8cyhP6K1U0gereMy6UXQTSKhwS3-LO_1gLuG_sKccprIvXpNwA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QFi5PEJ--jg9dm5vbaVlLSA3xCYkqHMFhMoYfS3QjhA&oe=69E76159"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH5XPqJlwNEQ7kNvwEpsBSB&_nc_oc=Ado-9ETV0rMmGkKhWDXVY2PtNGrOD8uBt8NfFnsvDUFGPv1YwnkHsjmgChHCNOkYIyA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PmK-JrhbznKkpJ9bdnf4Y5KYcqIcboL3c6PLLi2Mgrw&oe=6A2448B8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jijk0FxwZsMQ7kNvwHD73td&_nc_oc=Adph3al_jwL4MIAktP8HVK8SAsRwZ-p0m_NMpi0naDyCpqLH-RZ4DsFTA8MleK7YNfM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xmvhsGIpdus8WJHzVQg9j52fKNEroyF0UKqIbuP5fqQ&oe=6A244403"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VkL4EGJNv3UQ7kNvwGonMKP&_nc_oc=AdppCRixAvc-Pomc74Bu0haBL_a06n3KQc3X4s7uYOQPtXZwce74nzKPA34nqfp3weQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82fzcGqgwrNbPiRBvQ1E2GgQmQb_fiI4Msp9cQCo4AFQ&oe=6A243BC0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBZda8z-XJoQ7kNvwFadRqi&_nc_oc=AdrDSOZh8I1JcJ01h515GckRVs9_76mTQXz2F6W2stZGaUjzj8c6ZWB0jEw7dDSwaEg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mkMjxlslqXJMzEUmAPdlRgEXy0rfhiIufUPS1R2QMfg&oe=6A243F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaGxi3dChqEQ7kNvwEtxb98&_nc_oc=AdqnLciRmxS3WNX4k10m5ZkJmOT3wKMAQu1nW-WmzIGWa2W5NjPd_JbZlkFt002kqDk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cy-tXuldo9AQ2nMjrCo5fiyMS4tG3GD0LnTWcajBjlQ&oe=6A243E99"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
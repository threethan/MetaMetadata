/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7iOJqr0lGYQ7kNvwErdK1a&_nc_oc=AdrcSBltZBN6nvaNxbwg7ub1ZAWY_CcBdeoUmlrWNDs8fKaRgcOmCPSgG6lYlS3_iWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aX0Ka-r281bVHRijJr9Q6QKL0dFIRY87VgbpfbPe-kQ&oe=6A4262F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrnZ1PaXytgQ7kNvwGzu5PA&_nc_oc=Adq7i8YOWZ6-M9XTm_YaxhGwFd4mj93o1aZ63YOcglmFi3hEOTlHA1zoRwYubi1Q4SM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9V49XGPTLt7OJCijebEVepRNs55HIF28sNJEtjnHuo2g&oe=6A429683"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwEJDTOvQfgQ7kNvwHSMhEA&_nc_oc=Ado9zXJaBXEkEPgjLNiXf_5Q2wfzczU5qcWsl0eRwuTSrcSbddPZodsI8hYTabGIMOY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98XEpijyG0qIXG9X8OdZmoRnbLH5Pvxm1pd25rPpwhfQ&oe=6A428E40"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ik5roaNMX5YQ7kNvwHbP91U&_nc_oc=AdqYx_91fozuwfnmN_GsYcUIapIn5MmMQ7Ukb1TmaXim9EvYSawiHnHc-yNnJ-4frfc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DqUBxpYwfK0jioEIMjGAGtD4BzYepit3LJq6SO9km3g&oe=6A42920C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylHdRqzdqIkQ7kNvwGXHWjo&_nc_oc=AdqMXWJz8J-FAqZGfctsat--XfKwtCUzVf8eDJiklVF96ebfyCDD_xoysfl_v9kmCQY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-D7i2L9bDPek8F0w_rwo9CU9JgNh7pZ2vKymaEc6rqeg&oe=6A429119"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knt8ZpT2mHsQ7kNvwGZ6w9E&_nc_oc=Adq7Bq-2gnOlUCxwaGEx-6d-NGaelEWbdmpDE9kzMiDa9koOQlQ-1mCCZ10JgIBCN7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mjpr_vj4avMaCafrMUq07BpQUhU-fhoixIYwoBtMQqQ&oe=6A2E9C78"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZaQZgwmT9UcQ7kNvwEAEDh2&_nc_oc=AdpMutMgIr42NHWQl6SjX9V6QyoCxaNj4dSYnA-nY3v2wPpeO2E91__pGO7r4R0yhLE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HXFAIAxNub1_cTg-jaJH41ZEVxegH8JNfXeAxSl7q5A&oe=6A2ED003"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmgF-zStcAQQ7kNvwGwm835&_nc_oc=AdobZO4LL7LeMgxGtumJiobNr0OxTFF4hN21VJx3R8RSWxkaET2ZAaJSm9fQY-u6PJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ygUPFK9KUBKhnhyhZcNLnhdkyncbLoi4ZPxFRxxM8Rw&oe=6A2EC7C0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVo9Q5X2etEQ7kNvwHiQEcs&_nc_oc=AdpRS79qqzSrTCeziUMk0pNBJPiAqOFAMslkweH0Yk9uPn0mkDGAkS3L5uPB83WB4Wk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vF2QOFvAyKBVSsvDHzp6t_zkQPlna0CbEdy8-O0aY7A&oe=6A2ECB8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DX4ne6S4bTsQ7kNvwHCjHEu&_nc_oc=AdpsIUufs4qzgk4k5YieXDJ0f9yfglaiowDA1Gm0zL8n1uLppn4UCC2zObVLRNN_Q68&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-o-HdTC9Q2ftG3bD5h2XvUup7pXmME_OIH0fqfBtJeCg&oe=6A2ECA99"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
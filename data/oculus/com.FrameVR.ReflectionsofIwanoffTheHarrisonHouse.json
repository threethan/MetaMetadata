dn.com/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4D1SSGpzZEQ7kNvwEZ0MO4&_nc_oc=AdrmJT60zeQlQUsoxTxhjGHhHjmV-Ba4i3xYap3mI2wWeXatwUq-xxthWUHcUEG5FF8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI87f1NvouylTYCiVpPf5obvugmjdZrrESVFtDRfTQQcw&oe=6AAE7DF8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlZHTA_ypjcQ7kNvwEH-GJp&_nc_oc=Adoo7ApCzL6TFHXaF_PyZeGBN1qOxaVJR4d7NG05416QKdoYstHeEFTEBZp15XVZk84&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYTnbLE2JSpAYAD-FnyHIqLE5PrjHJUk7wn9geHMhPcA&oe=6AAEB183"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kd5gcQGICVMQ7kNvwGiiYnU&_nc_oc=AdoU0GjXEZ_ItPmUAyCL4_YilL8Tw6i6tPmDKaOm7hKz_Hc0Cltqhx2VnIglpvFakf0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWZdKQx8Nz98-O2rZvHXjQ_bnQbhIdZvgZ5p8N0sjgsw&oe=6AAEA940"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6wJYa0F_tYQ7kNvwGEuzyJ&_nc_oc=AdpkoKW0L1dJH8jnBp1D_rQ_wzVJ7Ft03cZlno2G73AcO972O4QhKV9vyhqsyB4rTZo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWYYVJWPj1xbXURrlI-zCwe03FfEr2VHvxPJKbgkTpYA&oe=6AAEAD0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_iiNwcQ0bsQ7kNvwEN2B_A&_nc_oc=AdqX4oU9CWyNPzim-Yk27z3fR-Y0eq8H2bsCM9vxPaLmyqKof2Ya6KfaRXPOpFcaJDg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVL_Q6e7WV8I4Bz5BOy-VkJuKC-Uz2fQE8pFa-zQ4pvw&oe=6AAEAC19"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["RO
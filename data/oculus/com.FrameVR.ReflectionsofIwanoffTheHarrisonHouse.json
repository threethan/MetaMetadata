/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UbUO69056pEQ7kNvwGJHcSR&_nc_oc=Adr0XI4HdGYhpU4ZKGqTktNq2kDeZWde3bZBqEF0b4akBeC5ItXUvgz_BReVyHJgqbk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oc3_uZ_Ld1q152loXypqVtT_Nl6aUfuniDSMS9YgZhQ&oe=6A1832F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rldf_rTEL_4Q7kNvwGFFN2r&_nc_oc=AdoNHhgOT7FQ4AiuJrGCVFNuFlhCSZdTZBWFulkhieC3CW2y3y1d7Utulewiulm5FWg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UcaKIzcBiHD5ZXtqR3OZUWvUepSReVdeZ5WSL_bpkdQ&oe=6A186683"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEHRfGr6S90Q7kNvwEBlEJp&_nc_oc=AdrkNvYKAbB6rsj1DIsPJQqYNErRLzdZ3IqXm-ZhL_NVhyT3q1cnEq7SnUHZJ9HlMHg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52jfvvM6S21iq4mkthvVW5Ls9-FGKtEv_Tm3AiTof88A&oe=6A185E40"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qKnF2uY7nOwQ7kNvwFdQNc2&_nc_oc=AdpKBa-pGw1lcxScMTz9x7-fzpzXPdjWxNa8m7-EuMAFv3OGDjN3Twy0Z3Ti7_r4x6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wHl-g3D3oTyZ73TNlzPEnaSJjOpEwFf6SOmhTD5A0zw&oe=6A18620C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXuJA8FZrBUQ7kNvwGASoLu&_nc_oc=AdrloJxb87bikAZiXRyTxA1HkMCVYMk8D-IVNJ9uOnjamd8a3AiKSe-OlfWMXZ_70bc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BGqWQuNnWy4qKw8d9F158ZFuMUc8Aw3jRA4aG9m2B5g&oe=6A186119"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkkVnAERa6YQ7kNvwGCbiBb&_nc_oc=Ado9hEMtxTFCJyNR2xuQX9MY6iT0rmj97Tjwcr4T4keIJJTseGniBBJgNhW2y-S7Koo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_QRTzKzaKBZN9NuRUj3RVC3JkCSJszx9BO3jhXZDwsw&oe=6A12ECF8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4y0oVg2358Q7kNvwH1cnov&_nc_oc=AdrFKeDotIFpG-HH7A06g8YLON6nVfgmUBbMslOooC_D47eJxD0rycS1mQ8h9KsXRlY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xJnBgr5kxJssXhCX9FJ5n1ZKnJvKoX4HNdz0xpJrGjA&oe=6A132083"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgTBExw5IKoQ7kNvwE5Jfs2&_nc_oc=AdqvY28dnnM0Xoau_Mofws4FxMIkoLHf28JWHeu25YpL795X8PqfCT4ITvepzEDFdwo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52ZpdSJ69bMTkuYUQC3lLdr9kLKjeGDw9elbwvBUldlA&oe=6A131840"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6J_WXPDNaPAQ7kNvwEw3OIl&_nc_oc=AdpNm_tiQ52raF5dJU-zKDd0FEbS5Z3CYqP3wI65AdQXkpciccJMGNRApD28Vpa1f8Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77gAMOAFjfw58NJRv87BscMvcenR88fKP1Xz12hg52Cg&oe=6A131C0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7S_C-_lbnToQ7kNvwFO11xX&_nc_oc=AdoWGZ5QRBg8ydpt1EHKVmeK7WDTNYUR5qyTsanqJ1RcLMeDqx2iQzmin-_U-9NZsb4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mwNP4Ic6hVv9rTGMGYuhvy42ml4SnwOyJP12exyTeDA&oe=6A131B19"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
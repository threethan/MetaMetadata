/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wEQytZY3ezwQ7kNvwG0H_R-&_nc_oc=Adpr245b1lwNyfbSOAxNPgorzUw0ASlbmwZC-j55OSZp-_SgRORQqVgpYXz507lAVOY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwU3emd_zvv885iwrqmlFKeGD3fk3uqOfh6Pl1F_-t0KQ&oe=69C3D2F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIW-MYMV79AQ7kNvwE3qCN7&_nc_oc=AdpLYozzKUkErKHRxpMVNSzWRgrEQ5r7vVvKtxTY49-Uez_8JQhTkOBP8RJ3_y4fHkc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0a4VOJieUUhh5uMlxAIJlKLQESsg7-1sBfHerzS7ing&oe=69C3CE43"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCpxAgf3EwoQ7kNvwH16kx3&_nc_oc=AdpJ3JZI03GkdQ6Tiiz6m8VR3MV7PBLvmVU4xLWjeNoj0x0qo3Ge0doPUbggNg3fIFw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgdWC7_jAM2_ScTKLy9UvuMP-QSg6E9SHt0a71ThJ26w&oe=69C3C600"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUKiNLg1XusQ7kNvwFeKRBa&_nc_oc=Adp1XMJ9IL2CETEAWPHL19DdGOdj4T4Ey2zz0ZhBh52M9sXL21Y9aXzTeUcD7ufQBEQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzhv3ZLvuq1U-VSkBJb62ed8jlE7STUr05N9LPeujPt_Q&oe=69C3C9CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UKmsF8M5EcQ7kNvwEVXtW9&_nc_oc=Adpx4oM7sVbGeKrUobKz-p88Zpbt7q69AqyDM9QH80Umaxy7tzCYP13cnlJG6hli4YA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdIAhOXV_PO_xoq0_YFlLJZZgIeIaZwapiI6QNPxyRvw&oe=69C3C8D9"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOC2SGIxwMsQ7kNvwEcfDDf&_nc_oc=Adrr7Sfpcs3ZsoWSG4p6uQLHn0O4eq1oEQq0Go0pJytQ1zlIM7awnNZW3aBJHVaND5o&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDu6UKg2HZbPNVscfBbPG2anjR-AFBCEKqTpGPGh7Bxow&oe=6A562978"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl6DFXeyB6IQ7kNvwFLfNMX&_nc_oc=AdqoE13OTwWQg7_44eFZpm2c8t2B1yN0BlSnGAbk121QsaLqlguL_0lWVmnC6zlMITE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtea4BwVcpmUo1ccmuxAiTU2i8f3ziMYRVngOZYqNguQ&oe=6A5624C3"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWIgd-0Fxh8Q7kNvwEAhVnA&_nc_oc=AdoCAu2lhEpN51ErJLubXreXxO3mDmd6KHjuPiIC3So7Im0ACu7LVhSoOdk1kHRuX30&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBOZ59smOVeCTB8A8S7sExl6SRAd7X2Evc6km7jmECXA&oe=6A5654C0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYrZ41ztjQIQ7kNvwFnS7Dp&_nc_oc=Adow9YLMEVHtoDkW1cuS3iFC6SqVyrCu6ZAhTjhNVeReNcfT1WGf0SZPUsf3thCdjOc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2bXjjQ_RqTaoFa2-Pu2P7dBWu9igXyauUi2uIS8wwZw&oe=6A56588C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Q0T5vD8Ao4Q7kNvwGGAFTF&_nc_oc=AdrwXCwrFb0RHPmv6EnlKu7rNpRIapdPnIk5hd7vbJFhdlf2unRQk6i5TXvWAIB2J0s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmBYdDPUhaCJfQ9xzAw4QTq1i5LRe65tZizCOlmisZjw&oe=6A565799"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQeNUw5mJ1gQ7kNvwFWwEpU&_nc_oc=AdoaLVJbIqccctwifuQZtdYBYHM1ScucJbZtomukhcCwynhncD8Hco98IuR2AHmGqCU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dc_LylcnsECoWV1bRiHsGFuusp-KnfHczZMSmWhQoiQ&oe=69F5EBF8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRYjk5ZofTAQ7kNvwHQAOCu&_nc_oc=Adp0ifEeHZYoi2dxa4NfWYf6PrrZpHkj7Tu6AF4_0cC3f7Qor5-mJl1gCTVs8U-T9Bs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vXQrvkDaPE0G9PqYbmlGxRK1R0Pb74wAp5WcEY_Oefg&oe=69F61F83"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBpsbaXYCAYQ7kNvwH-QJCR&_nc_oc=Ador2Qr4_7zj4nvlZYfL7rWraHtt40dMBtZ0dwYGjAWLzWnGL9yGO6HLRU-JCJewZJU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Meo50zZI9rucG0zRTxidiAeHlRSshBshHTKIKvmb6nQ&oe=69F61740"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7AqxmfTgBQQ7kNvwEjEjOm&_nc_oc=AdqGFSySEQWZWY9AaIxDJMLR4pGyXX2wpdF_SeQpHwzVEPfAvYYXe3HB_aBN-MsSfTA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14zdYnjFHTWTBkhxsIVXg8jjH2_01lf1UqXpzHbWYg3w&oe=69F61B0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezSn2440Mq0Q7kNvwGYDnQh&_nc_oc=Ado4AI7XJreUl3fztfsc8dlORp-lZiJrBMvzm3EgMYR2QKA17h0drCQ8o2HaMmGEyhA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FOOgjDTsQqaCQ12ALZAesU3tQZzqhmlu43LOYjLQpAA&oe=69F61A19"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
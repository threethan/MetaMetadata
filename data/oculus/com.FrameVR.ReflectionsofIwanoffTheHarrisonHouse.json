/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kx9v6DfUWtwQ7kNvwGiE9gM&_nc_oc=AdqMu31VCHF9VfJTOPaE4n5Q-FsUuwJWhXiQBrTvnBJ30wTTJonFfb26IN1iYTWcX7I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW2ZfyRRf4e7QFyDqcFbP6eLkSEXx4CQrsth1emzgZXg&oe=6A5A1DF8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IteFqCgc_bwQ7kNvwHIX70U&_nc_oc=Adp54mNhmImTBNo9MwzaJw8W84cp6VXHqUC1EwQRGT9hHzorz5t5Ig96jJIT-MtEK3I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkIAustR0XqLbtnZjsv8MiD0wmfJY62uXfkoQXSF1zgg&oe=6A5A1943"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5oFBRjdbbQQ7kNvwEx9ETS&_nc_oc=AdoPcJasJvZ7L5DG6f63BfosrBeqZVMSEzgSsqsnFft1Y0UccZJzqZ8gc_m6p1Z6N9E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNxCpEKJF-Pol-scI3NyV3jWRWEoAhgkgTtitO5wBNvw&oe=6A5A4940"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvUK4KqKgFMQ7kNvwFg2VrK&_nc_oc=AdqF6H9OR0nBHMRWU4YGZD-knBKdRYpMJFFXaJIhen0FezH2qzd5mdPMHL_TzPL2hL4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrZHuQYdnSMsPnkOMAmJSS0JKD63Et1XyDsVAWuX2j0g&oe=6A5A14CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4m3qp1yibsQ7kNvwH4bm5W&_nc_oc=Adp1Yd5Abd8pyvdGRZ25qPBMwqqlfZyKlB5xrVUPFTBsIic3ZdpkQ2Rrkkd0GWgNVck&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4AujNB2Q2dfMg5xgIGQkZHo2qQCNG4bhOGpm9nksyxQ&oe=6A5A13D9"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
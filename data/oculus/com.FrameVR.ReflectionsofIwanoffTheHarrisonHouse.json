dn.com/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlTWtRb7th8Q7kNvwFpuxLP&_nc_oc=Adqro4_QDsJ9X8dJi3Fx_71MWfcfH3KZt1Zz_ZzcOVizMUTZDIEoODQNoc7zk1yrung&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSkNSvovT2l0OJeZ8f8R6O0XLotn6CdRJaYEyri3F0_g&oe=6A7DB678"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c13IGEf6WLoQ7kNvwEzkGRd&_nc_oc=AdpYcccXihw1_NSPrDePIz7Snikb5sxMtZmL5HqP5UaVuBwQATvDmIoPMvw4i13YBl0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFogo8SkZUXO9_imZu2pGwTFxIHbr7aH7Mh1Ug9lxyCzw&oe=6A7DB1C3"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ip7KAwvUeRYQ7kNvwEZ12PE&_nc_oc=AdrgP9y3Fcw2OWofATh1VihDDHmktF8K1VEYWdIp4TUcd5vDT2rVAcyENfQLC8vd6mg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr-lMQk3eO2nWbk6zxyOiBPrAFw21uQMzOsFhcbUHG7w&oe=6A7DA980"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szr7SRQG1jkQ7kNvwHEGhK2&_nc_oc=AdpgglUAwOIKkQ25HSLKbpBzdkzhzTZJNbGuUUndV76NuVvjJm71nDLhaQpgPqnQoW8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKev2Z3MRGkU0reH_F8ENUd04U2Xg1rGS1OZA9oHn3hg&oe=6A7DAD4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWn-RNHIBrAQ7kNvwEk-uku&_nc_oc=AdokLixMMlR5fg_rmu7qBZNjvlfV0QcjHEQP1Yu_F4X2p1m9HYGAJSYJfujldtHyx5s&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm5nEGnhLMgjxHlPChBBIgpFWF0oWJJ7BJGoTbulADbA&oe=6A7DAC59"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["RO
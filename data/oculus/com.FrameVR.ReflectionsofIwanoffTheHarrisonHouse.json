/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zZ86afKMd74Q7kNvwExavgC&_nc_oc=AdpCdMlMam9CrwGgmDMmwAByw2dUdloUWaYgT7L9fE-3GXS1du3lhmt0-ISB2RamuYE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLlQRLixesbtvJnw3XqlPsWIjXivuZuFuTe5TG1QvH1A&oe=6A71D8F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YA_VnNxHB1IQ7kNvwGhu_Qm&_nc_oc=AdrJvaAS3SO2j-O0gL9uWWbGYRUtHYkwFFeaMYgtK74fPmF9daqHx3NW2uHJYlcw9Tc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUrBaoWlioejbvBA4e7AD1JYoYVgXZAFIHnD5RKHoycA&oe=6A71D443"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulS8JQQf8-oQ7kNvwFEHj_W&_nc_oc=AdpKCuJQqgPSY65oILzKhIa74nJ6lUDcK2Ao5Fv1FRgNWGRg9ioJnsI1AoZHgdO8UCw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYqwa0p1ytekU25OlQJYa4_X17JKqnGdZQw7aKT1Iz4Q&oe=6A720440"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4DDZ6_vo4sQ7kNvwH4Ith1&_nc_oc=Adr3pf-V-uCtGG4u6jjTPk53rF7LcpxVDTCHfp4amYx5ciPpezd9uo2QHBNPPOoGK4w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRZ3xgENFRckZatoJLS0UdMaw0O4bDjw7Ihj7igKZzHw&oe=6A71CFCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yr_xsOwYPd8Q7kNvwEUFiCP&_nc_oc=Ado7cEtPpl-R6QLwuZx0iWFCiK5WAIwkKd1hi7LgDQ_xdk2Yx0eXTwO1IH3BCytME-0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHD_x7JeHp1ftbqjlgN9zoqB2sLC8YJa6maO3XrZJ5KRg&oe=6A71CED9"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
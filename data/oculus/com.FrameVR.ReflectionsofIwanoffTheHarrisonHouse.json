dn.com/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=on-3fKZvrX0Q7kNvwGtUvi9&_nc_oc=AdqYanCHOWiJnCNCyQuk_U6Ov7bfRpKV8BPQsBG8u8wQK3IQ4_UT9hD4dvxxL1B29o8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-l3NXX8YD64Kelpx-hU5D44XsPmpDf-NpRB2ZiuIavw&oe=6AA937F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNS2bJQmiDkQ7kNvwEFKtT-&_nc_oc=AdrvWv2EC6GXIgHamVClYYX4a5M4vEsFprMPDABKZV_uChGtf1gHLFmW4CggjWAJlNQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTE0vVNOndNYpbqbt7sqXjzjRHs6kNeFEzPkj9yFvPkg&oe=6AA96B83"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94hvRWU6LwAQ7kNvwEtQg0L&_nc_oc=AdoIrFcM4V1sDSuSt35jS4S1ntPhQp1l049HiKknsvFcgR3RPDGfct7O0pA7psNzVhk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCaQ0pQfDgWQiytNgMwCZDzmaKN1EpLebu6vEPMzv-Lw&oe=6AA96340"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MI5NRYNp_EQ7kNvwFiBO30&_nc_oc=AdrTYrDj8syTYf1R7uDASeGKU7On1ETHsWEd9DrjylFwKXtyBPwpLe4jGBHjf559CIk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-IU3u93iq8Rs8iRW2aYNjMB4lrRg-ZiZHCnPENoubQg&oe=6AA9670C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyit61iy96QQ7kNvwEcLgTG&_nc_oc=AdosEV54VLkLDsBHxAT-sgoZLlzdsKA8D_l8lu54n-QH5SOh2-EEXvUc_cW2oJnbqFM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhAnaTF6aDfkOsLJO-kZuNUwrdj6f21BQBiPMR5BdacQ&oe=6AA96619"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["RO
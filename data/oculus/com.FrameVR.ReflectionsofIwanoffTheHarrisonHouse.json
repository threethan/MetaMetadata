/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sES9sQCLo-UQ7kNvwG2JPI-&_nc_oc=AdrKBLKtnq7cMd0wUgGv15s_naKQL4pB5pA6IyklY1Xe15sXIXY1LVaSG_Bz0ASUhMk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-z1Aa-3CIRSrXdVqgsXg-wYmmQGmDG9bsavxVZ7ipLQ&oe=6A941FF8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ke5t8HmaRjUQ7kNvwGMxxu-&_nc_oc=AdoCgRAJH2MQ8NO2LvstsCD2p0jqcT9uy-wmzuok56JDcrzLAjRnNxNV-nDSfT3JBjs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRz0qY0oU67Wvlw6slGDjWGroyj4SHvbZuceg4CvzkSQ&oe=6A941B43"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OBJjVAE8qMQ7kNvwFRIVWp&_nc_oc=AdrValkT7l3ootd0-p6BEvvOzUuiOZu8xeAVLsHFYkhUnIFb7pG62vJbG7EpjTDyE0k&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-mMop_w_Re95iuTl95e2376R9jMUi7GUiaJb8PHhIFg&oe=6A941300"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naAsCcW8OM0Q7kNvwFe8pYn&_nc_oc=Adr6MLYT6q8-lrVJ5BW3vDFbpjSU0qJk03W_GyT85L6EtGomwIAcpjcms_DBWwUDSMM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoGDwZBL3RsYwVMqAT5fEJUVBrb89JTDRPN61OrBporw&oe=6A9416CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyWNLVYp5hAQ7kNvwEtgQkV&_nc_oc=Adp5u8ZQiRAFHlbaQoEWDQcaOsxo6rY2ozscR6MlFGoTsDkAI0MN5IcLcWw4HEOjdPw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6u7_AQphDThYiJVy4bU3c9G0Op3gTlwulHn2bNPfGOg&oe=6A9415D9"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
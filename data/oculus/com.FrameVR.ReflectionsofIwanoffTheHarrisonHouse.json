/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-GtUc3k3JcQ7kNvwFuFfmh&_nc_oc=Ado4mLwzqTRyze9x7wN1bLdZXx4Jwg1a2WEaB6NZC5fz6DBEoFcmLoAnWe_6ghCdzYA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5htTs9SIUrNeD--PmNKtOQeqM7oFU-W39aqUxcLC43QA&oe=6A0C5578"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxF-iwW-AL8Q7kNvwE60LUX&_nc_oc=AdoJnrsaNPxxd2ICRg9XugDIbLB66Rl_StE106V1vubGn_kPvFs-vOqh1IPt7JIHH9U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v8bHPmNSjpAYc0pDPNlNbdNTnbwt-gVb1QYNZiF-4Eg&oe=6A0C8903"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzigBy_6thIQ7kNvwE8XKMS&_nc_oc=Adp5kIpd7yNkD9SLklFNRQtlIY4Ydn5zBV5CLBRBnASVqYeMtKuW5GmqUhf42Vj3o24&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HyttgT87J75hNy-oD-qMzG47EN_Um6wtQiBvo8sPhaA&oe=6A0C80C0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZRdL_z57UoQ7kNvwH1etQ7&_nc_oc=AdpTLSjEAZgELUYykGPps2jh-9EQFW1fD8un3shlypTF6OPYJM2oEdqFeLndWHnMKD0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44uF94ZPViPA0-Ny6enmsu7WqgcfdVM-8mSFgjS6FlLA&oe=6A0C848C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_WrP4lpTm0Q7kNvwE6bL2e&_nc_oc=AdqNe7PY6xRfn4oQGh8YkRCvThJed_od0HPzWg5pXGhNE2iAnRQtd8AHmDv1cLM9q6E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GJ-zYEov4xFxemAljLzruB8T0M4RZw9YPzRUxYz5HIA&oe=6A0C8399"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHpQpgu9UJsQ7kNvwEfIBcM&_nc_oc=AdprqYNysGntUslOe-umORCt2WUmaG8vzhLggdofvl63KsZWH6mf42XWP4awshekIhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQXSvQet4OpaTcpnAUe0VvMRyEEHLP5eeUeZs3xFa9uw&oe=6A6B4178"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdKwYeqOPjYQ7kNvwFMbRAe&_nc_oc=Ado-iDp-HXeShngpm--FWczdulGymu5NpY3JUqRwbsVVSHlXWKzPlA2gc0NnOVh0eh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmkvT0_zwGF5vYrvSOv7zbDgcHjZpNeGZx9kssPaNoWA&oe=6A6B3CC3"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCg53D_ceM8Q7kNvwFwQeMi&_nc_oc=Adq7ZRDMw1zmKmJEZnlqZpQNWAWeXC3W3pFItRkydtbep4g53yQf-3YY4YS9Z1Wu1yQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiQ0BFQw-8m0jzRolGggkt-Yr7l427zVKv86Lsi0R2SA&oe=6A6B6CC0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-Hf3g-9-4AQ7kNvwHlsG8C&_nc_oc=AdqK8An5TJalHSaPILh1vwxsPLx_b0FMB3XV5HuISwficKhkaxFCmzTdQv8zOUVJEIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkCpWvy2Cboj9yd1HyDCH1is8qQIu5_kS58JCvvkLGDA&oe=6A6B384C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPhPPiJd7uIQ7kNvwHUBKXR&_nc_oc=AdpQzmE3h5juIg80_WEi_VY7rsD54w37a-WwDJDYoBWdIQTMtzRbCQ-hVpJ_2MIfhgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALuvIdJX7SoyRnTi4W0_XUZKgNvMKlCNFr3ZbYFpxuag&oe=6A6B3759"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkkVnAERa6YQ7kNvwFcF4vw&_nc_oc=Ado9Zyv8YoUHAZ_-2-fg5uAUddm0yJLgNcmupKZ6A1uZHKq8V85crXgw3KazWwH1gAw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ud9SMYMD61OsnC-q4doK6URmpyI07vZuBzve-82AZ8w&oe=6A1049F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5sEzM_pGEcQ7kNvwF86ZBP&_nc_oc=AdpbK-JK8azArNoLcxNi-mNth_UhVjdfsYO4ADCh1rnfEKjljLezq6wDV80Pu_a7q-s&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CyFt_u8EgweGu4_m4bioRaAyegDExTWEiFKMRU-Ci1w&oe=6A107D83"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgTBExw5IKoQ7kNvwEntuVS&_nc_oc=Adr4a8eOKyvR1ki1c1Lr-zHVUt9x6Mxpw1oLBWMTIYJqhZBSyaI3yixn52bW5wVOjHg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dI0qQCWMIe_jQMCbpiLLhJrOLLL1ehF5WFZ69A48YPA&oe=6A107540"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdbZp4JLf5kQ7kNvwHUOdsV&_nc_oc=Ado6GibTNL6aY0pEQTJ0lTbcAKXX2lxMv2v6nwGnaJ0jAvLo5A9dmTz7bIfFbZmvfKM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZSM6ajWzMNlPMw9UkGQcSyOWQznl5ynct5iPfUDhFRw&oe=6A10790C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7S_C-_lbnToQ7kNvwH6T9qE&_nc_oc=Adprmar_AjF2v3_nmoBZu2IPCpeY76k9XEaGcOTzsOGxQ-tjWZRECZnDOuLbcrSYS40&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Of1PbfTU9qCw5r9OyyyZUsj2BSN16W7EP1pzqUY1ivg&oe=6A107819"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
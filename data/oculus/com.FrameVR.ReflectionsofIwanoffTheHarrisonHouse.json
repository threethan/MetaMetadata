/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9XvUhSyTKkQ7kNvwExFGJF&_nc_oc=AdrrumJXZqIfQwZFOFqyOCHibVY_i1gBMshjGoWz2CxQl05F7pzQHg98JUENZPQMlsM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06AJBiBRLJIKBIwzTtVeKP1yIgBGpRcTv627jlmd7OmA&oe=69D79978"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0SdlFC5ndIQ7kNvwGV1PNU&_nc_oc=AdqYzLD-znbiy1uIRRdhPCx3PbP3HAz2WUPlH1ERU7r9HUGQ3piDuPgKe7vVC2w6Qo0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UTIPgnNedKqO8iY6uUF7vyly_VXPHi8296xu1f1U-ww&oe=69D794C3"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDRc1wQCf9gQ7kNvwHwPgqc&_nc_oc=AdpvVuxIgCQT2kBwW1RTX2uFsrMuNuhERsU6uxCZF7F619MQJenWkOT2-L2xrZnFKM4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uHX7FEklFeZPt8tuWtF2TiEIBQhyODV9319gU_N9OHg&oe=69D78C80"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yAJxr-50eYsQ7kNvwH7Y0WN&_nc_oc=Adrepgy84K2KH2vd0E2TKd99Z4nt4NDPBdjK8cBBderZqeEgoxQXTfQr4PWdNVwBj8g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r2GMSbPQNJgbFHI6kEmDnHuoLB4YXWtUvwqjZcWvlAg&oe=69D7904C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOvYe8al6RYQ7kNvwH-BlGV&_nc_oc=AdoC043t7VYYCf_vKI6MP6vTjltegP0FwweLUFDyPohy1E4u0A5PsmoWwXuVxNZxsD0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-YBYcLGXPjoNAxIe-8uFf2eG6OknPbbPWN0Kzy6LFXQ&oe=69D78F59"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U7ItdpY3eMwQ7kNvwH1v85A&_nc_oc=AdqmV6gePye_D6U58DnOAylznv-lyM3KGGsLcHyTbYAnadtNEJIJ5JGrVxt8BRIZYsw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEegVKKFK3Uu8l2Q8Zv5CtDiIfVdW7dM2yzm7EXNG1Zvg&oe=6A86F0F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnm6tJYSRLUQ7kNvwGbyGOK&_nc_oc=Adpk1VtCrK11ESBMdSJW3xm-kq5KDDupoCqbRW22_4Un_yPuepfjxZueh-oLs59LtYI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhJZ3tiSsgBYS5ZIJKw5HtKFWmlQusM0QZEANKsOl2XQ&oe=6A86EC43"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UB-CXESRucgQ7kNvwFskcrw&_nc_oc=AdoXpsgeu4MyOVfCH7sHNborU_alp9-cR3FKCxNp-dBvuaHgDXUm7FAcSDuE48X_RHo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhJv9UO549c7TO_pH88Yc8t42DFEhIYmQpeKVEYfoweA&oe=6A86E400"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nUPjwLqThuAQ7kNvwFwz-5E&_nc_oc=AdpLtEgIMZocCNDqhEpwH8RRgWTQYDu-AaefASvN4RgD0FFkYlJVzDE3_ff-Fat3DmU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDEJMfObhIO8fwrFtDezU_ZpFPdKJ8SzRgPnip5bse9A&oe=6A86E7CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIvI2yc60WAQ7kNvwFnPZ7g&_nc_oc=Adrz3YlzY_7txQ-pI61h7MCMXsPXSHYnm85tWZ3pejAsVWxv6xLVsy9P0SNt5vURTGk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKYOePoQrEIC7uSYF9_kZcyDNqNRvWJWFq0OXWAEZ-Xg&oe=6A86E6D9"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
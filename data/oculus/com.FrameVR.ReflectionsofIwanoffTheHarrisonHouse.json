/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM43Ann6wuEQ7kNvwFkFSaN&_nc_oc=AdrZDYifcD4_xZ9a0yzplZwApht6hDWxPMLqNPBOpy3y_uBngogV2QcfMMru9Z0UwUI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32alYNCKQ2MujcEhEuASmrEwia5FdXvk60CBP8d7R6tg&oe=69E22578"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqUpjMynlm8Q7kNvwEAVpFu&_nc_oc=AdpYnILPdNTIZ8hYWuDYW6qV1rK9JeN0Mzp-kHSgqXFT5lB7P4FGz7Oa0QlMwl1ya8w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zN-ajs_WtMG-2P3VlPO7JhqUB0FD5AHfX_AjXbwSBQg&oe=69E220C3"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRqh9AQChbEQ7kNvwH_JA33&_nc_oc=AdorEdVpanDyIth-VjyNp7Tz7t771mz-5mxt2kwlXLX2nkEBaw58SnJs86Mp_DXzUkc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05PppxgDMbdNCRZM-r8t_aZRiNoUkWpmUu6rZgRO1T3g&oe=69E250C0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27IqrzDzGPIQ7kNvwHWpCEd&_nc_oc=AdrTKK0iP-du-bayvozEmUlG-8rHWQXsRGP72ZihhPo5J2yLOA9CebQquhWbRGrDKkY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PH1Wn4CCNMyYOn8Nrqyv6OpvM_Tt-dcGmMyi3ocvNTg&oe=69E21C4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdtOjReujc8Q7kNvwGPcxp8&_nc_oc=AdrK2SRjt4Qzb5_0f-NzKoICW0nqPByjdqKVtrA3eyQwkQc3KkjvwHqF1Tit4vx1Xmg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TOpAWFtw8Cx5AoONfpzV7TqSYhnPUe2pV2_NBAQqAYg&oe=69E21B59"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDfHDTj-q5sQ7kNvwHDPKiG&_nc_oc=AdpkPW4Hn5HrEgdFaAYDblad7-cQCaIv89mqifAN_eekmJQnosXhgfB9lWYWbhQwAOM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAVBbUyqYT2CWIUQfHr1ew6VT2hURrFsN22jW662dq3g&oe=6AF9DBB8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mv01h_uV9J4Q7kNvwECsRx7&_nc_oc=AdrKmzHsAwCAimKkPFX6lAcaivFe7He7F2yG8kscVxD16TIp0wE6hlqSD2tFj2RnUUg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVqc4YIMPWYeI0-_l7GBJtgvjnEUfXWk7FO8iasF-gNA&oe=6AF9D703"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2NZNLsF_IkQ7kNvwFZwr5u&_nc_oc=AdpmYobPTQR0iMprpqjLcsFw39gQOTcFrRvsa_0B61WX1Y0wRpK1Z1ZiWxm5k3HReKo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCYiCd43sf9CuIlBzsnosPTZbBHqAqAiBCcOFsmtUuYA&oe=6AF9CEC0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDIZhRJT4vgQ7kNvwFCDm47&_nc_oc=Ado0Yv6ZpK0LsaWv1WVfiMQw3K5vPjmHq2pES4qBQP3E6sBmwzcnF_pX5H9nR18u2i4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP2JTdveQ33T3pMakaXAtKZsbxVcO0hd9yMgsFJwDetg&oe=6AF9D28C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89x2YfK8Ll0Q7kNvwGI0-5N&_nc_oc=Ado_paZdHe8Ze-Q3ab-pF67ucApb1Bg6rz6-9T_i_iVMj4HwJMelQvQ2cwrVQ_nMPc0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWdQPYGrhoBPF_CE_LeDUHOZOgVv_wdtBbhQtusd9ckg&oe=6AF9D199"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
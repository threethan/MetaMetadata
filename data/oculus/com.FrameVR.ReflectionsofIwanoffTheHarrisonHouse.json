/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XB0jPhPCxPkQ7kNvwEmQ8iD&_nc_oc=Adoy3wEPX-nbGe6QvrO3Y3LJnhSUJu6tbvngu7BIpA2vGU5qhrYlmDUJ2pJp5lnOERg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_K6lQ4yus0EjPomTQ6TA1dX3SWHGrCS7Q_PRSQNVkm8w&oe=6A3C03B8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOUARlodqnAQ7kNvwEEwA_z&_nc_oc=Adpa03EDCEBaMbGgAkkoNS2f8b7OpnkJSELw--EpWL2j9yQOeHz8lZGvod7mjQubMr8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qFfpQbTVEUUmF4eVZOe3wBL5A5f6XS7HYTmJ2tsg9yA&oe=6A3BFF03"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqlFBKnyG78Q7kNvwG9Yed8&_nc_oc=Adr2Iki41TbmbJCCohWBhis3RGTc6MtxZEOCr-uxWtBzVRMN92CCp4pUUh_4QToNMcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85WEYkKCuKs250F0UepgAZ29vvu6MXlC-M-NWJApVihA&oe=6A3BF6C0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBq5TjovYdwQ7kNvwEjy6Gd&_nc_oc=AdqJPTIsW9-qlikTSGy9IOrIg7coLU6ZjFMseCCqfUB6vKEgroSQ3J_HPR4z69PNwqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98o4v7eBwWz5J_E43uwYrlG3b7pCOBYWaGEyZMSQEK0w&oe=6A3BFA8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WHrxH1YMekQ7kNvwGJBhjH&_nc_oc=AdqJA9UkJfhsxd01c7F1UFrt4LWKBxRSetxfnsSGtm-hl1ILCpZKu5ppexv6dRjO2Ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__8Jvf_i2JMzr1WyYqNQ4dztPc5zSE0ClWHxrKESl2NQ&oe=6A3BF999"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9XvUhSyTKkQ7kNvwGv4asD&_nc_oc=AdprrSYVSq-EDhRa-gMADt_elDF3vu0FBQ8uYjOdnXWIk2wZjz6yXatVF_KdrC9KK8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zbj7frGHT-Mv9FwDEB3ASRo263z_FBtPJ44TL8eiAVg&oe=69D647F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0SdlFC5ndIQ7kNvwF9KYCl&_nc_oc=AdoophEC4UFzn5bTh0pKx0tzBKqEMHmiL0q22F-kGL_S-4gx7qlzLJvmjpPLsjCtN-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Bu1Xq9Fm8lN9-Fe_1NGEdAQ_71Tp3d0pYk_HoCJOUaQ&oe=69D64343"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDRc1wQCf9gQ7kNvwGqn3Dp&_nc_oc=AdrjrMozHLhn8lnHMtxh9XGKtoXeCNUkn4D2aUcP5Zy83szJhHZsTcEmr8_EYhe5cJs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0703zce9T5nVFnckmOW-H0jUviAHF7d0EhHkTG0bUAaw&oe=69D63B00"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaqrhokY4noQ7kNvwH38cXm&_nc_oc=AdqWKjhb5NfJp9wdeJu2UPoiHKSpF6DJRmO2vQuGtm02HnW7wPP5Z5a12fsqM4rp_Yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iA8hdRqUZxCxONi_WjywhJWKnfJYd4uqqn-XYbi2eVA&oe=69D63ECC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOvYe8al6RYQ7kNvwFLM_cu&_nc_oc=AdrfX4TOX8q7CqyOC92UCgWo7n-ps6j77DXrY4M8GBmfxAH56x_jKJBTPkcizRYFtQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24PBwdCSfFPEh_Y-li-e5P-j6N8J3w3_D3Rja_JMYeyg&oe=69D63DD9"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
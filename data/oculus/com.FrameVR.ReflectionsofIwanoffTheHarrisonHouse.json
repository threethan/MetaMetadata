/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7iOJqr0lGYQ7kNvwH8eyQD&_nc_oc=AdrOvpwE5E3QHEckDLJ5ilJvN53qQYH_Nh8aqgvSa2VQK2WOK8Oyo0z1ehIHeVcKyEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zoXdQlQnZO7RC8WO5gUnZirmDH9UWN4M_7Z3WKjmsrw&oe=6A3FBFF8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFpDKEcweiUQ7kNvwFFBfYV&_nc_oc=Adrrs7-5i8zg4UWtRVsNCOCa2RbZEXNNuxV4gUthnNQI9wg7zEy2hyhEE6AK8AQAEh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yFIIE0F26Ch8r94pEzLMdNHrCLvh9cNlE-6q4vt4rZg&oe=6A3FF383"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwEJDTOvQfgQ7kNvwEbVLWT&_nc_oc=AdraAyw-fOqQouaLUTU1cRziHLPqlWcwQotMMKBGHvugPSUlhEH8H2WQ-wkrh9qI87s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rxYdf5ONmOtmAS9p39pdh0XPrhLWoz3M98B_Gda6vxA&oe=6A3FEB40"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVKP_oSzig0Q7kNvwEj1Edk&_nc_oc=AdokTrA4FLHTF96TwGnHNftxc_h0kHemQrYYy4pK-iliwV0YGiQNaK8y-hQrSBvsxhM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_g6IlH8_v6Ce5OXNMzxNyCpouWRkIFWG_Kl6cDpzoMQ&oe=6A3FEF0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylHdRqzdqIkQ7kNvwFnLV1N&_nc_oc=AdpHNWhNnQsUCwXxYS8J35fQTWUACCTTlVaSAZifQXKTdRGnjCvw23X4AHa_CPI_fwY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i9vT5JKjYTPUZRSPKMZHP7WoSWFHW97lLwRqfnFo0rQ&oe=6A3FEE19"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
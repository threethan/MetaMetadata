/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZpvac7xXgEQ7kNvwF6EzQz&_nc_oc=AdqDSsi9Tb7C4ctbukhZl26uIIDxjNKTWOF0aJhuldfiMuvVfykeEZFSJK4ME3n-c5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ttj653n8qHHYgG7-_5RJ_e1YePxFnUI1lXZslVu8vMQ&oe=69EA0E78"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTEUBhCgRIEQ7kNvwEcl4mI&_nc_oc=AdqQJJRsV1-O6hL7rrJH5dH4TnTzd25ScWS-sYuH_tlDOgShzfz_b_O_j1uaGy2ILx4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nGaCUsZiYQ_v9UFQDBNNJNxjy6dUoe8Lmp4MdZ1hnlw&oe=69EA09C3"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FwI43vq44oQ7kNvwEivKmM&_nc_oc=Adr-FnYHe_tqt1bLRW-oer6lXdES2Ew9anYnzJ-ibMUZvsUiE6SYBcRG3krsrnpQcF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sU-U63bpdQjuHa2qGh5Jkn5y6YkGEu3JgIxh-rRfhGg&oe=69EA39C0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WTjR-kOwynEQ7kNvwHr3RHw&_nc_oc=AdoSN64jFBlt4DrH_EzdgWGL0mcEb-jG36blsPk-r3UU-D8v7SsHEdPSj202KEx3_80&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sL3--WuXxr6ATrtGfaEw-gatO-THPq5JZ31lGdEAszA&oe=69EA054C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emPUJkOB-5YQ7kNvwGjht4E&_nc_oc=Ado-y-cQHGbQe652kfQNyXjeWCrQeUOb9G6P6X6GM5WW__RvpIndbMpNfEUNjg0sl5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0whEppCIoKrsNas9erPYkbOkwZoP7FJzz0HILBH88lZA&oe=69EA0459"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5r8A7qHhaxYQ7kNvwEDWaIQ&_nc_oc=AdqKjLOI_vzQYgU3QK7aUAiYhusf-l80gTcaZlg5YWhIxzvfyjPykmKmg6jNgVEV7nc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_4D6O4qIiT8bI8MuLi-ZUBUu3OuNlOY1Fp-FEVLys8A&oe=6A9EABF8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHWI2mMN8tIQ7kNvwGB1f6D&_nc_oc=AdpMrGH4zvkwyBvg2qfBzdPHNasDW7OIe7HFPWG7dV4VYILM5HfMDUdCluojgfwb5Lw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaC86m-vmPiGf3H36O6_sV3lwaKXLoF8xjlXxjSPAyQA&oe=6A9EA743"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5txtA1SmZ0Q7kNvwGw4FuF&_nc_oc=AdogGbq14sDdW2dyUdeaOYYKwIHKJm8Ry1pATNp2PHVd9qmO8iTOVbrj3a6x-zSL4IE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLstJezXDXKdC97w8QLxCHRPBdXHMNixWCmfD8SKQ9mqg&oe=6A9ED740"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4JIR_en8CQQ7kNvwHzvdh9&_nc_oc=AdqAgD6lYxcGpHlYhq4_kQywYs7T3xYeMHasMJB_wtHUtsnuiolJ43RicmWygxy6EI8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7PIE9nN2nS4_vWaQ0__XbbfWK7ZNFWaM5p5zF881pkw&oe=6A9EDB0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOqPbNCI86cQ7kNvwGcw2g5&_nc_oc=AdpwXemGOeU_kitG8tcfk_cgIZ5Cibjy4QSj-WYBDvdWBOoq4UIuQbW923r7nQmWue8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIb1zGR53J9nMIEf9Zbca5dxawVtcVATkVYV9qGt2jJuQ&oe=6A9EDA19"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
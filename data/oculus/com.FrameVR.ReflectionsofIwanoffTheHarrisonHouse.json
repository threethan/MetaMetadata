/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8FPDdFG60AQ7kNvwFLiD3a&_nc_oc=Adrm-Vzd2QGf3EwjkofT_qiPdFc78nU8P0MMbD7GRy0gibZTmYCOdoMY6x1xZ0tIAQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VmeauwrG5qegtcLohxWhGXhiOhLZXo4rMtGPiA2p_gQ&oe=6A47E138"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwOztCe-yCsQ7kNvwHHO6hz&_nc_oc=AdqAojfVBFOg3ZT30dGIARSaVNCrxN_mVQt0-YXaKbu-UKOlzBT8xBiGsjFzgn4tNLk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dxmeuR7rqofXDYvr8r8rC-sgyp9R7MypSPijC21D9Ag&oe=6A47DC83"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8h7CqUh3ckQ7kNvwHI0Kh5&_nc_oc=AdqgyqIBHK1TWusAcZYzgz7IB6R-hj3Ur8FscYBYTKzCT6S_9x9dBW4zyD1WqGEN5X8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-y6u10U-BgeRNzigBLG9vhdcpetXVpSBnosMwEzUJXGQ&oe=6A47D440"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foudbH9oN10Q7kNvwF7XSyd&_nc_oc=Adr_mlzLpwvRZDVTdr-PZZ5nlBR58kxp2Gd7lvlits1yM3-2WWUN95ikQRnlMrhWPrE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_js7rK5Hm_9qseSb6A_JkOvT1Slc_PVzxfP3uqtMZouA&oe=6A47D80C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JF0J6Aod5PwQ7kNvwFkFykq&_nc_oc=AdpYVEWkhUw0RbyrekqLMnwK_k9z_eCRS3KIeJpOuR_2xv-TVVR9tLEIxlcl6t5kxwI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af817mBh87xSJGZQdEeI0MR5Npu0Bkpxq-IXF1GKiYWvTQ&oe=6A47D719"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
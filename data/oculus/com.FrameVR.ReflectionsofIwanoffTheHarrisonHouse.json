/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDhBnwskpbgQ7kNvwGJT8w8&_nc_oc=Adq2X1DkNAGaAokLhlurX6IbWtDkyFY_eAo0mCb-Ox6pgDShNzLPFNqEUe-WK7EmJVw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARrpvPxj4qPi3r6-stRf_NtbEzbiZCdoh3oxvmXXGOcA&oe=6A4CEEF8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZgcKya1uXMQ7kNvwEt-c0s&_nc_oc=AdrmpAHmwxWXukTc-zLDALhxUygNhpHOOdpbDCzArbJ3GIYioT-y9wWtj5ULbgWjFEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuSW3C4_01B4wfQGn8AoA7CbGp40VsRH2TT6z7Ow_oXQ&oe=6A4CEA43"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECaFykrlFLUQ7kNvwGndJwD&_nc_oc=AdpZa935rnE547b1HRgaDIdJ-71o4_QUXoyeFGBQEul_tQ4BEvrtAqc6KkNi4XaPzUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDunE7rq6-GqyTz_Laoa1wGkCy4w332adFsmL-qVzcAqw&oe=6A4D1A40"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2QyTLCV5EIQ7kNvwGPcTf_&_nc_oc=Adrc2NTyqm4yOzWMhg1e7__X5YV0flivuMzz9NTyyY3lhOv3XHqmhXhxQhi6js229UQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnGGLGgqI_ffLcI0U2ze5FJ2l6SkiuaYgHSXQ2-E223g&oe=6A4D1E0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Gi8GvprBZsQ7kNvwFD1yzb&_nc_oc=AdrOIWzD6s7y0baNLJDhijgefLOm7Os3Jlv0I3t0e_z_5W0oBKPlt4TU59z1kKt4y4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvg66YMxOPGrVKd--WoUw-29D70HyxtM_Mll5nzUOyvQ&oe=6A4D1D19"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
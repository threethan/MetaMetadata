/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD-nsPs1s5kQ7kNvwESas9C&_nc_oc=Adq3kZgB0CJLppd3Rl3db7vZxVcySEY7VhH79Clr5k8z3BK4w0BT_hfUnDZFWe0nVkU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDT4PIUPanMWedEuW5GEY4cyMCXxs1BxjuSQDv6fIJ3UA&oe=6A4F91F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZgcKya1uXMQ7kNvwHp3INA&_nc_oc=Ado89G6WHHtHXEE-_EDirM-m9gpselCbOgV7jjsCyp2Z_D3ZlAuamAsGfPpdWXRF4q8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbSQ96hE6J_hijO6EY-0ldTe4dWN8ak4JgturfJMS6-Q&oe=6A4F8D43"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f42IvU_YCYIQ7kNvwEIHZeV&_nc_oc=AdqDJ4Kdw5rd9b13f6-4LPTydEUbYhGhCIvEXGjv2Dqp9gkDlFeu9qyRnSt1OHJzTG8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCT8tvtCZS0vMtQYO7C0PA1fFRGOh0zB9XZbJDG6NWj0Q&oe=6A4FBD40"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fto3_vY53VgQ7kNvwG1KaoV&_nc_oc=AdozbXeRN11kZY_YpSLTsSE6FoBSq-0fYbC3ePlfjkj18-xK_nzvhk7uTcUY2ihyONA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTqCoTYZVmmDqpXgtEgL8FyWmQ9e2Vga7Dd1TE86KIfA&oe=6A4FC10C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iONmggX2q4Q7kNvwGVDSBx&_nc_oc=Adp2uMDi9y9HQ-z2doCfm1P7pIuKtwOStUP6fjP4uYszDFiZJuJJ5HDoSyeEK_MM66o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwy8rvFafxmpO1Hmd1auwFoyB0QuiyLyCVbYvfJ9dEcQ&oe=6A4FC019"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
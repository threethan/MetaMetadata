/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4cE2ZUmU7BAQ7kNvwERB9c9&_nc_oc=AdpeFQ_mAJ6W9jEjZrYPE70IkkiEYVIuhXuD5s4gLGBHKbs0qVZKX4788VjdHUx8-9M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ord3QYjYs3LC8EMq0QPQtVFOHulKLfHg8EPtX8W1sxQ&oe=69FF2678"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTUkX57d5ccQ7kNvwEFlRB2&_nc_oc=AdriABYfKBCb-UQ5-bHrn5GemPAKTNpXWQMbLteo686UbznU_fAGdXr7VL5JG4Bc5d8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Hcvk6NM_WbXc7TWAuf_51-ZJI26VuZni_2by1nriTiQ&oe=69FF21C3"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEGAf3800lsQ7kNvwHEYYah&_nc_oc=AdomtysYtMsedbhRpknB_px0aZ2IMAGcRtffDLApN2uQ8I0mgSyDYTk1M9G64zL0Vzw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hCuJfAvwHgv9hR5Dwkh1R3CruIO-wxkvYErlkNL2X_Q&oe=69FF51C0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WiuvIkRfFt4Q7kNvwEXYzA2&_nc_oc=AdpaVRhJ8PV_hyqWRqIW4LOZdXqWXf-ZJD-ac-J5_O1wIVrfHFz0_cAk62_bUx5wQEg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O-wJ7FZLMWN_tJsZI_rxbAz0PEtqVsXy1G8MQEC0Hyg&oe=69FF1D4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQJRh-VKm68Q7kNvwFWT-qo&_nc_oc=AdoIAeZ3DB9Mw_NcvAfo9X7PxEGU24IijPwr5r9L9ZzJNqcnGS444Wk6qR5WCAi8XlI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78ZAtyj_dpInzAHABYiuald_K8mssWeg1m6-iiEv4qFQ&oe=69FF1C59"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
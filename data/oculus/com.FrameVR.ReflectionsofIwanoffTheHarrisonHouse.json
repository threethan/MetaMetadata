/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vslbm7fui9oQ7kNvwF9Zk6S&_nc_oc=AdozHG_GykfKOv59wqrgLlSSm0fl93AzRveZ4-84xs7O_BjXjfvVA3524RQBMcoA_Ck&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYtQM1Nc_ddaqvsYvolvhG3uxHXm7SlyCUSSaPPsBYdg&oe=6A917CF8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSCVbtWcEt0Q7kNvwHc4Jge&_nc_oc=Adrq0VDYhnqB09KtuE5t_aF4VSMJezxRiY-8npSzp2wCg75jW-r65f9F11HrHcCpJyg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgglby4pZ8muycErr2OgnHBIJ34MF0Sv2eA0iNRwbS1A&oe=6A917843"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOhraefrWJ4Q7kNvwGsWXfc&_nc_oc=Adr_q-Uzr8zmezpzpue3R1-xzw9YXYz2nU-nJjv-oHGeubEm_sQ7yQ_tDrtOAEtezq8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZxwki_8bHS43WuKKxEeOUuRxu3Om5SLR69N4t_dxBsQ&oe=6A917000"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naAsCcW8OM0Q7kNvwHjauO7&_nc_oc=Adqje4g2C2aoBBTVcqyAHmKREPOJIMRjwp4GM9W6GWqD_Z27DmRs_K_6Yzouw9royz4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERUUwXvlbyMG_4tSHQ6fXsMtmOMPxGvulrGnYyKmueFA&oe=6A9173CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bgre2FPZR8Q7kNvwFZ9yLv&_nc_oc=AdqtkZyIe6AUHCCzF019hFdNEbx0xGzuTUQvF87XTN1oaTixd1sdQAe6x2E4XSAZoHk&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqP1nyR-AMUzhKzdTJrc5R2kY9nHtg0Bf_LgrgM9rVYg&oe=6A9172D9"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
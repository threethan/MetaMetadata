/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZpvac7xXgEQ7kNvwGwFe08&_nc_oc=AdqQmU2DLdzbgiZCAP0STDAWeZ9NTcDD8OWiEaeddr9CgrPSoiA64JULrgc-GHpvEto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34-2cH7rksKVhdfQiLKPgYpm26E5Sd474wNbfm9uod8w&oe=69EB5FF8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTEUBhCgRIEQ7kNvwHBaXyB&_nc_oc=Ado6kEJFwo4OvB4Ekg-GtmmeVsWODiRMgrgu3zmBIrxBvk9jBJ9GOeEaeN5srUExV7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yYo1tMwzYr59Gpgrk81-hWwt2Ygn_i04DorkxCr73QA&oe=69EB5B43"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FwI43vq44oQ7kNvwGVVbJM&_nc_oc=AdrTsa9lofCzCakjxIZHTKv8mLdCiKoXwWQoKyAo4jJ7DSYRwplOdpcHA_NL0FIiXbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08vH6UyHNH07eziQ5YcSnXjui5syEKvqlpp3yOjmmKmA&oe=69EB8B40"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVLyniX47HUQ7kNvwFLTi13&_nc_oc=AdrWPzXxUKd6yjBkLqjkBGXp6UOBJj4nXtlu9BBkAYt1xB7zp3cw17QP8Ft6zy1fK64&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZVSRTHpix-XHV-AX8yxsbhSEI8QSPBz97JetFcdfuuQ&oe=69EB56CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emPUJkOB-5YQ7kNvwGhBZfm&_nc_oc=AdptDdBgORTzOMdK5whCI1_q-HRTs_qkeVnA0cd88sZ76tKCZF7h3o_Iu1VTQxd7t6M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0L4EbtbjTbHit01SXpX8q4tUKNNpKW4osr03kH_Lzkiw&oe=69EB8E19"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
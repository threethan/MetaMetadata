/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDhBnwskpbgQ7kNvwEygmbi&_nc_oc=Adrle8AIXlcgmYv3VGiYe-Ov2IDXYXp4G9JrCHAr4t8oTaPh7aR9gWviIZGlHrjXUVw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAciJMuoRxO0tR3TZaqZvxKnuW0qJYrs-eAJ6hJ_7fRKg&oe=6A4E4078"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZgcKya1uXMQ7kNvwGiS9ea&_nc_oc=AdpTpY5Dn0K-qzTqlXgdPa1ghhq1BMk8Uytewpyz2vwlwoWOdtNwC6zn_QZ9uVhVp2U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTic5Irq2MKDftMokFnI6clJ-QKERLa6WsQMO2ybljZA&oe=6A4E3BC3"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECaFykrlFLUQ7kNvwH0AWF_&_nc_oc=Adp8Dlv0SswR-P3vKMWUJxzdUXzjbs1bRB7c6UUlraqp0JdGCnLlPqI4_hOLo2rxwKg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0gr480-KH4aOJIf_M8JF_uawM3Li0GyGOZh4TKUHdkw&oe=6A4E6BC0"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fto3_vY53VgQ7kNvwEZ0-pY&_nc_oc=AdoWAVwLHmApJaLkqpEKjrjGwQbxjoLnldSB3r60zOgB0DVISKksvoBzr95ahkV9hF8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCv0ilRPy5kX6tlfqaVmbxiBEno-8NYaO4DKlTyYkhrJQ&oe=6A4E6F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Gi8GvprBZsQ7kNvwF0ML26&_nc_oc=AdozK_VllmE8d_0D-2axQheylsC1gw6bFQjTlTm23dA24NQnmACDDVC8Fj08Oxmpvns&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuOlCU48RgBIXviKmb7Nc8HWPfOBs5pAuVxaa162rImg&oe=6A4E6E99"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
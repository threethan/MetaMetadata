/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QM43Ann6wuEQ7kNvwGP1R-s&_nc_oc=Adrp-Ub0eATT_DitraNb5b3Qu4RcTJcfTxyTNrBvf9a6s3KazR62cvWBkaVik-lNOq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wO5xmqwXxD_CA5dPFOEbIiKrBf9UPXasM3QeCH_1e_g&oe=69E0D3F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QMbHAXqfiGEQ7kNvwHsGQMO&_nc_oc=AdoF-QOx3NhL91QdSL5uKh2KSNE5nsB7k4-CPaxWe6ORdk-2P8Yac7_2TJkvO1_HpWs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21-1BOnF98H6wZUzgOPmt7tjv6vcvqg_VUc7jdln773g&oe=69E0CF43"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRqh9AQChbEQ7kNvwErC2Vq&_nc_oc=Adp8Nr-JgJRg_4kzWW9R0gO5fO4OwbKEJQf6F3oGUBiedsaX6LcW4ox2aGo2HeyR4R4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tNGAyP3u9JZxPQjoXiPmmWz-64mm72T6HD2hrdMVS-Q&oe=69E0C700"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27IqrzDzGPIQ7kNvwEwV4xS&_nc_oc=AdrvJHdWXt_PXXqg5OiqJJxdKovHhZyN428UGEjzl-sO29RhkQZrTuiIY1UwFEtR6DE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tdEnKFVYoG0fr0xPuRj2IELj90VY56r0qbRqJsLzIpw&oe=69E0CACC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mdtOjReujc8Q7kNvwHz2iGq&_nc_oc=Adr3jcnnRRvdg5sWlyhW1Kkwr0QXZ9L5bDsSvq4RzPcUWhXBBGsqixEY40v1PhEIv3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AF2j4j1JHxtM3Tlbx1EHmarRf6Ir9xIZJNnpZS7Dhzw&oe=69E0C9D9"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
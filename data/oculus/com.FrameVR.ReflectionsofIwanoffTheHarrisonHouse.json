/v/t64.5771-25/43997709_284390333284552_5922630025287499276_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PUluyb21jIQ7kNvwHrvTIZ&_nc_oc=AdrGusEKMR1z8gM_e2BRCXi53LvajVdzm3zslnUTs5esKq1Cs5zgTZe7YuAslCilu3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nYI9U9DmsiFDZxvZ370-3rZ0lzRy1z4lAkFCJUv6uWQ&oe=69D3A4F8"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Kitchen_View.png", "id": "456777365382053", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035435_456777368715386_1045742576725972018_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HpWYrmNdfMQ7kNvwHkTTZQ&_nc_oc=AdoTFOtVFcutGHx84sdaG3cL39jtUmov8lFOSEKBVWTDzZ_El8rvKwq-eCjq-1Nh8FY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eNn6AoDuemtBYsa02zRV0lZZElvJSUVC3rHeVzqOwOQ&oe=69D3A043"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Living_room_View.png", "id": "759645368067491", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974782_759645371400824_5325344563140275767_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MESgR316nz0Q7kNvwGKQObx&_nc_oc=AdrDQZdn6WM6jqC8fZ-gAiER2lBKF-2vkR9i7_EHCt-Kstf0PTX1Ezw2aPwVsAwk1L0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zsNefCZPlcthJGZItMv9EIrUhqRRQfAhDS0OWKQh2Lg&oe=69D39800"}, {"file_name": "Copyright2021FrameLabs_Iwanoff_Outside_Terrace_View.png", "id": "167780328596964", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036677_167780331930297_4936414287540923154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaqrhokY4noQ7kNvwETPjG8&_nc_oc=AdoSanPmPI3hdDZ-yGkDh967jZciLJZfG5qW0GqLALObGyn_wWtLPbkxHQdtXMTxOWs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af191XUgrs4L4xRAQSssVUC25NwMN_tUsVprf9VoocJYtg&oe=69D39BCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape_2560x1440-01.png", "id": "3059867757627988", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036664_3059867760961321_2646142156216282751_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mhITDrtzR0Q7kNvwFmhFQz&_nc_oc=AdqiAGE7FVe1Fyumfn676FgSRtJ4c1UhuI8x5i_HeUFNoum45ch72OutESAzpKNgfIc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30eA7IaU0lXjcE3Cj80Ui3roxsiqs8cWB8b7bTge3yyw&oe=69D39AD9"}, "display_name": "Reflections of Iwanoff", "keywords": [], "long_description": "If you are a fan of modernist architecture, in particular post war brutalism then this is the app for you! Reflections of Iwanoff rebuilds a long lost post modern house designed by Iwan Iwanoff. Iwanoff was a Bulgarian avant garde architect who operated in Australia from the early 1950's to the late 1980's. In Reflections of Iwanoff you will be guided on a personal tour with award winning Australian architectural historian Stuart Harrison, on the tour you will learn about the principles of modernist architecture and then get to experience what living in the house would have been like.  ", "short_description": "Step back in time to the 1950's and explore the avant guarde house design of the cult Australian Architect Iwan Iwanoff "}]}, "developer_name": null, "developer_privacy_policy_url": "https://framelabs.com.au/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Frame Mixed Reality Labs Pty Ltd", "support_website_url": null, "website_url": "https://framelabs.com.au/title/reflections-of-iwanoff/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE
tl3-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2SKg7oCXBwQ7kNvwETTItL&_nc_oc=AdreA6iUiHWKQH3Fp6fQhAdSmchpM0RYeQzCTSmDrVPOge8uRxLG67qCyjo7G7KsByo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2r9ngkocihnSZbWhkpe9Ap48Gho4PysZSYp8wga-BFQ&oe=6B0B1276"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwmRq8Re4LsQ7kNvwGkFl09&_nc_oc=AdoS7RvJNzDSarrBjUUmsfToMa_IA_Bl6RNxfFY0rXyloWPZmPZgcr9wdfZthY7Tbsc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8R46DMZ5cgyi7_z9AkMU5BiZabgtoaXkewI_A9vFzJQ&oe=6B0B1229"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJvrrNyGlbcQ7kNvwHm8PVZ&_nc_oc=Adoxv6Wyqk-hic0GtmF3YooMYWHGNgST2akfa1nqLmpEat-Mx6eGCrZCsphhNRerhwU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR2Ge90n2TsLlFeUTlrFahp4tKoUdqFZ6g4z-LMdrsWzA&oe=6B0B2462"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8naw59qnaf4Q7kNvwGbHZil&_nc_oc=Adrd1nEl5GRWNQ2cjJ1z7Nu9fUodI4NrKW8S3K3NEOsUL6tPRBpTngNH_qE4GyZoSV4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTKNGm9lH5mE-XqA73RY6hEaFz9uv7OzgiaSDE8_4BI-w&oe=6B0B43F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAKCFzy7zJkQ7kNvwH-VMBI&_nc_oc=AdqxmtWOY2Ypq6we6IfLjnPDWFEBycqPCpLz93DiVW0--O9RrwvauqLXEvb7242UK_w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmdOuEhFEXTSQhqJP6mda2QNVTWLX6YHrgJbFSkmIvDA&oe=6B0B15EE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": nul
89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1fj9DQ0-NUQ7kNvwG5XDQA&_nc_oc=Adqyc7rsADvZ_c0R-36JxviDT_nzYJRhlLCvDIjb6UCBsppK0SN8yCDLNd_iydS2bQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vzUP5XnQcq2TdJlxJRjywj0fwJ8xU8G8Jh1NTsIq7oA&oe=69DA4FB6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x30JIY3kAHsQ7kNvwGLXINU&_nc_oc=Adogu7rSBafLJLKYhP8IribGgwpM7h_pXQZq_seiEYbk5cemgTrBKm8gYCTa7Cl6Dto&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bswi2jAfSZQGOE1n8EUFFVpnDD0ohbLFD2VfenwUhKA&oe=69DA4F69"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnbhzbqgDCUQ7kNvwFpJEc7&_nc_oc=AdqprlaKURH4XN7JxtVnkzaVVxQopa8Cr3G3Pgf_9YcTXzqnjcHHIoyO3sLK6gO1Nn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CdgJTJiCqUGSu2iGr6kb5Xnve4dTNYvx8YfmjdGhf7Q&oe=69DA2962"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zDkxRkqwpQAQ7kNvwH_YMKG&_nc_oc=AdoQx5_5_eR91o9t5M7c0xw6S1Y0FRUq9G7Hgr2yjDwU6kMifoKAYNM5RVpKM9wfX9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JIdYtkQsb7BpD4OwiGC-kiAXzy8VrY1bxIEpFBPJB6g&oe=69DA48F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6s0gBi8xGOMQ7kNvwE1UtGZ&_nc_oc=AdolPsGL0VMJKKaa1nMI6iz5FVvrn25oOTWHW5eB5Qldx0rCtCQBLArHplcZEfqsS2o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NO4_bBH8la_cxllxAxYY1XZR0NhN_slDkp-gsg0A8gg&oe=69DA532E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0VUDqDQHs0Q7kNvwHaWcpf&_nc_oc=Adoyt2ltLFFmGs052NIiZxW8YGEhmh6NHAgna87qjHU7xZU-hukq7yttQhtwUvIy-K0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GySvo0g-GYmJwT71NViV1I2sH5BoIpMm6qRM-FvLf1g&oe=6A0722B6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJcl5QX6ZgQQ7kNvwERx9Fk&_nc_oc=Adrq8fUhhp-VGbdX3e8c6Z1eiXtHBDhbOSt-qufBlI8iSTV7mz9F3GgOSt4996btL4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r4Yb42jR0qYCwJtL_kN8AZgTLpEED98WsEpYIdhpjwA&oe=6A072269"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KO1ZkrgesZkQ7kNvwFVX__6&_nc_oc=AdpNyS7OOIkDLH1HjWfoUYEoXa2H5FKycpGfhpiK8NGLOsmCwBhvv325fpwnK7ji6Cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i-evkgxtkqzV1Hg8mcUeXTb2W1HKDrghm7zELcsidxQ&oe=6A0734A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rcpO2beXXAQ7kNvwFL4zfM&_nc_oc=AdrVubXvilswyUJp6LmnMrnGej4QGYUwD5_SQeJcimt6VCNaFWPck1nViiw3gRyOZ7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KN9EiFnDtFpC_ikzvnwhOcXw4Jaf5mHqlddm7GCLP3w&oe=6A071BF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8XFZbhqKN8Q7kNvwG1SxJL&_nc_oc=AdrBijTRSxb0tIKoOq33v0wj9EdOB-mh2w3LZqBBalOxAp3g56QT1pKx-2dYLozkUqc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eEjfOovYYEym8ewGFw5hnhNSAkJILjFb57XXQm0QXWw&oe=6A07262E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
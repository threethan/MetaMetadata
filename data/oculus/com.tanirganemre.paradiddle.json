89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00ojqa1O7xEQ7kNvwHy131x&_nc_oc=AdphMqbQosdObP3ryCbPsVi4P81yM7tKTnMi07zNrYduUFZQ57oqAU_gH-mddSyDQjY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VHuViJGQ0RJw0taBhRBt2zAJ_TNMaTCK1W-1XQxouGg&oe=69F4ADB6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9xyVKmDcgIQ7kNvwEHnVVa&_nc_oc=Adr1vkdjMaSlfz50RDW_sdD9hzJRxNFSxN1_QFJiroISC-BbcIoLKfDWF0cC8bW0Fec&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bDlKMc8gBvizlfza_bw4SqbDE-TKlgzF17TU-4N3EVQ&oe=69F4AD69"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkPSecDkOCUQ7kNvwHFl3Tq&_nc_oc=AdpiMC4FMyMu8Bxcnal8PcPQNgppaXQCNYL95hpmiFYeMV1YyU-l1OCdVRoNMCcPcsc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MgdxaRw3ONlmvYXnx3iWLz4wtVwlpxj1Rw9qqp10GhA&oe=69F4BFA2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZO9ocoHBuXcQ7kNvwFYOa5E&_nc_oc=AdpibnlgKjm6qNp8Ujtj2hNZ0-uJh1ro0qsDKfN_3gD4siXg73m7kMPoQjZFb5wjc1Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3DyUT9eUb7V6sD0m6a9jWhWcbwOp9EBXc0jhTLvXubNw&oe=69F4A6F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABPnanbRYFIQ7kNvwFbtN7l&_nc_oc=AdoxytUrCMLLVv3sFgPKe5_RMXZgUYq8amSbezzLv1K2mVKk5Kra4cIrIVA6bF43kjo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1txRYy9GRd0mU4T1diWCaPFsAR6pZIAl2TJXCGsDIG0A&oe=69F4B12E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
6656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BA8p43Cm544Q7kNvwFop8bg&_nc_oc=AdljhjMnt2sLPdcUy4FfPu4ibjq7PlHSkE3dqCXw26LbEdzwlc3Y2gpMEZ7laUZFeOM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsGR0ua-Zi9Dxs5A0ztjXgtk0adQK7W9CurLUZ7oORU0Q&oe=69A19F36"}, {"file_name": "pd-screen-2.png", "id": "2332569856899945", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38974820_2332569860233278_8835659424562109361_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeHDzDO8Ky4Q7kNvwGqcShF&_nc_oc=Adm0ZaBpdcsEy0JXXLyIDRfHiYH5aU-fmlKVTP3U_eI57vSaruq4gstR-elU7_M9B08&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afso7nVnOgN2zEq5EAiEJK-Qrk4OZiUk0HgKBaE3Yq9aRw&oe=69A176B6"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m6amE42g2EQ7kNvwF_JjSH&_nc_oc=AdmOfXUDLtrBiUZw_ciSGStzSWSUB_-03djqYNhze7Ju59zuaF5bDCPtiZFeP4l6MUQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvJoYdG8jeYaHjxBkXFcaeJR_kqk1RJSI0ifwvguLWTog&oe=69A178E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uOr1bx-omIQ7kNvwE3wf45&_nc_oc=AdnlpFQzTWBo553s8wfWIJrAWmXQCL85QPu156gPsb4IqG9WgWJ4aRNcWaQrCmZZv7A&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afth8sByX6VfrpK4bqA_w9awCWsWeghnEc1L7craOQrLfw&oe=69A1A2AE"}, "display_name": "Paradiddle", "keywords": ["drum", "beat", "music", "piano", "instrument"], "long_description": "So much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!\n\nKey Features:\n- Flex your skills in the built-in rhythm game mode: adjustable difficulty for 30 different songs, plus custom song support and cross-platform leaderboards.\n- Create your custom drum kit from a library of 60+ percussive instruments, from mallet instruments like the xylophone and steel drum, to auxiliary percussion such as bongos, tambourines and timpanis.\n- Pick up the basics with 10 beginner-friendly lessons, perfect for drumming newcomers.\n- Use the new multiplayer mode to perform for your friends in free play, or compete to get the high score playing the built-in songs.\n- MR passthrough support empowers you to play virtual drums in the real world. You can even connect and augment your physical kit with the rhythm game mode and lessons.\n- MIDI input/output support provides a powerful tool for composers, and also lets you augment your own electronic drum kit.\n- Set the mood with 4 different environments: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nSo much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
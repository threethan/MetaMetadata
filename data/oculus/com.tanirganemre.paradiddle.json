https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iSn8bOXiC0Q7kNvwGWw3G1&_nc_oc=AdkfMlrVXH5Pl9ok6q0wIVw5dJUpZp220QzQYTkQMVL4xjx22LvWEZzTffkoVzGUjQE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuqnYrwrb8oLc_YmNU41W-9kpXJwTSHK758l5yWC_TNMA&oe=69A836B6"}, {"file_name": "pd-screen-2.png", "id": "2332569856899945", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_2332569860233278_8835659424562109361_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAldI5NrQCEQ7kNvwE-LT-V&_nc_oc=AdmMPw43zSXuxstgXdBt1JXWOC6vaEbnOTMqJ93jOjeC7LGEqQtgkwTGGzhqL-qv3sg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfumlVoJpnnVik5QnfhwGaZlab9PGFYtGMN5ofleArdiGQ&oe=69A80E36"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yz7wKCNzXsQ7kNvwHTS21I&_nc_oc=AdkBIF_8M4Jp1jktRiLoeEuJRcEOlDQWvq_9MM3QE57CkGNSAtyOCzadP_eU-SvXBM4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvRZZXEH2Q1GP7xkhSNYxJP9nCU4-gQdDV_wAXcJBd8hQ&oe=69A81062"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0l5FLEPV7EIQ7kNvwGuAkac&_nc_oc=AdkNgQ56v7jZHr16TUh0nMo0SaRxu-ATX3tnLboN_qtzyYfofnSFzi1ITgpxGq-Phew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsbEjesjDuxyH1MDP7njpSkWmnevAP2Q2k6s0RqnO0nRA&oe=69A83A2E"}, "display_name": "Paradiddle", "keywords": ["drum", "beat", "music", "piano", "instrument"], "long_description": "So much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!\n\nKey Features:\n- Flex your skills in the built-in rhythm game mode: adjustable difficulty for 30 different songs, plus custom song support and cross-platform leaderboards.\n- Create your custom drum kit from a library of 60+ percussive instruments, from mallet instruments like the xylophone and steel drum, to auxiliary percussion such as bongos, tambourines and timpanis.\n- Pick up the basics with 10 beginner-friendly lessons, perfect for drumming newcomers.\n- Use the new multiplayer mode to perform for your friends in free play, or compete to get the high score playing the built-in songs.\n- MR passthrough support empowers you to play virtual drums in the real world. You can even connect and augment your physical kit with the rhythm game mode and lessons.\n- MIDI input/output support provides a powerful tool for composers, and also lets you augment your own electronic drum kit.\n- Set the mood with 4 different environments: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nSo much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "COMFORTABLE
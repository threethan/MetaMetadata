89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUeP3TkpNLoQ7kNvwHMr_Jx&_nc_oc=AdqWYeLQ7uzEzzl3IYiujU39D-LQ7s58V6yvy3vDF6MfOy9w0lQ0GmmbCkWIiAUA8QA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vfx2aAQRC2F175d7KWtxzG4hgx4-twdl-WxdH3kmRow&oe=69F750B6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxXoRAfRdDUQ7kNvwET-4qz&_nc_oc=AdrrSfiL90j4eKvpoqebWeynXPwimSsCGeJXmDE1_OMgkoU11zDmpeldeCYfLk47VB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HlVe8upMhJbsOpoGHE1LO2SSltUmJDq1R29pc0oN3RA&oe=69F75069"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkPSecDkOCUQ7kNvwGhx2fo&_nc_oc=Adoh4cLnoV0rwQWndnfgvip8NdFsnFrCjbA65HuXmZgdfBaMp4kzcSihKIYR4eFj_78&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1liqGk8La1dPxmuDe9wx6g4z_VrUzUVkF4s-WzSbPArw&oe=69F762A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYDk3CJurBEQ7kNvwE7n9kz&_nc_oc=AdrKtLInuGnu_cVzK7RNTx36ZpGSzGVPotn4MTuUojk0ztyXCQCB4gQ6GRv01Ewz37Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1X2_O5kYYKFGvfsuCic0uR8eMwMIo9k5W_w4xbi8Pr-w&oe=69F749F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABPnanbRYFIQ7kNvwGA_Sij&_nc_oc=AdoTMhwg27Wq9wpERZGVLd6c54FJyXmd9lNq4BDXKN6fjmC4CND63Z0IjtCIp8P2_vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fLmpYmHIK1L4YQbLy4SAppSRrYzItuHhYaR-7M_-Bqg&oe=69F7542E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
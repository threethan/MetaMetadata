89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_BSqVciUzkQ7kNvwEVzBcc&_nc_oc=Adpeui0HWMayRnDazaSwU58swW47PFj2C2SaTu_bRotXvr-mflIEFdQFo6YQ9ETncVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pZDhrm79bYuSjLcD9DFLSR4WDMokN929n0m11sLDrhw&oe=69DE4436"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYh8e10hRHwQ7kNvwEnbPm5&_nc_oc=Ado4CtjrB4IDFNFu6rI8qbytqHoGLJvSlxa5ReKU_sRX_pTyJs6GYpgxz_3QVR0CtMk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lohsLeYWu_ElTwP9YvnB1JQ4RrtmJtzEInfHndvX2jw&oe=69DE43E9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jm597C5tY0Q7kNvwG8zACn&_nc_oc=AdqEi3t_ZZ7B5ubtol611rXC0X1XZ7l047H-Tzo4rzswUxwJ9MiI6EahNg8javvuWk8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17rqIGbXVpGwPr7aKT2Ra2KOpSeztwJh4B4SPsP-e7cg&oe=69DE5622"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SegIbzYlmk8Q7kNvwFfy9r-&_nc_oc=AdqGo1LZCMNqDpGxruX0mmLnBtQE7i6MGibehHRv0OOLyUx0j-8ZxJu3O2uOX6B-bII&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jxlMAsj0zVDPqJqkXeluvb2W0LRDbnQJgylqnhrHnRQ&oe=69DE3D72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3Jx8e86DFUQ7kNvwFdNJFe&_nc_oc=AdqYrulQoggG5JLUqxMzEp0ubEuboX0UXstTn0ecun8PVM0RsTPMhZsXf0i6BRuxShc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pfG34-buHqvpfJ0VYkBX1Uw9FioaP5d47w5EnCuEGLQ&oe=69DE47AE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
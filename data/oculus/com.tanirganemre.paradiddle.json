89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOq_M9B69_AQ7kNvwHUd5ZJ&_nc_oc=AdqNSs8JWQV5BzHDuDWvvDVWgC3FFepMgQleJuCcP1B8WNy7RuI_8YG3S7nV0F40e2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fx9YDk-IM93hED63G3pwq5fKYE2HdJhHIfxp4inZyBg&oe=69D3B836"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8FtP9IszAQQ7kNvwEMc3fX&_nc_oc=AdrAFDijVqWwVjdkpEOGdh0Jxfn8_D6Filtlp6pLKpvLOKFnTqTyatUA8ySay36uwc8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1quTBVML0T2ioLbiLCSgCvHtVw5z2PgqfNRgOVK3TPWg&oe=69D3B7E9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGrXqpJpwfgQ7kNvwHogGVJ&_nc_oc=AdrM9__o6Mdv2IIpyGknEXqHpWH1-RF8eZpTW00imIWWqpCDBY8B3ZdYbHBHQODNdhI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ua2IraCHv8ODtFpyTbLG_M3a_O1uNhCTZ2nWFmOVUhw&oe=69D391E2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEg83gbzeWQQ7kNvwEqF9_1&_nc_oc=Adrsfo9e49Ef2uOHzVyHFUHRc8_nShaU33aofgrH-AGUDUiCRsnQerXGF7MI9N3ll1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EflSmqNqsJCPWegkf5Shs5XSM-pAXdKsVgYQONlI_uQ&oe=69D3B172"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lG72vomx6kgQ7kNvwEgsXPQ&_nc_oc=AdqBeTJ0jUq-CMV1YBdTq_E9Mquuc1UJ2KhbTjztvsiNqfXh0leFwiOnj2dqjesNFW0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oLDp0jdcPl0p9dPkcm-vvaF8EMM-OL4BhUVhOy4vYcw&oe=69D3BBAE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
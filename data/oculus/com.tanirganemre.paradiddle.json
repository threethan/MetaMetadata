89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LB6A949Fxj0Q7kNvwG10nk6&_nc_oc=Adpzx8N93TfA8PLzotA3JXarMqnHYugmWf0gkkVyk4KIqWGTqbNuVEo9q_g50a0s6MA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QvpkCUJMN8CysHxZ4Q6S87XvFmEWA-RDb6ZMcfUTqug&oe=69E38A36"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAsuOsqq6nIQ7kNvwHgUBGu&_nc_oc=AdpWbS886ql8k_XmsMgPMlYaGIufm0e3KyV_KYDgb-8_hMlgpEwfJ3EffMuUv94uGUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pb0sJ19GPxdgIA7VfFa0FEvl7u6NMtLyd_ZbT_PSTgQ&oe=69E389E9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPzTxcacGL8Q7kNvwE9jpyc&_nc_oc=Adr1yxA71RuEvWpor9yhdFolR7x53uop1xDZn36yzlIDJezlOGGAV0Ub2Ab2dmdRx_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1T0crsdqsAoCdjxR4RK5qWz3n9V504KguJoeinaBO09g&oe=69E39C22"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5PRN0I5rN8Q7kNvwGuB8CM&_nc_oc=AdqSiYUDftJJWCPpnNmnp49UGvD8KjjBlWYgfNb2TZ7awlFd_dyUJFLvZzTY4vrbUnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BipBCfK6Ayl1nATHJZV9AV-jlPVgdULybKYc7YVEw4g&oe=69E38372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZlrr-oy7eMQ7kNvwGhGbYu&_nc_oc=Adpreno8f9zJGuNbm8svT-pbY0wKfjWjjADfXa5z1o2234MEQw2pzdCiDz2A2aY_yqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FOATcu_ru0JQiuF3EK4uZdkQzSCsHYwgfKQes63Y8ng&oe=69E38DAE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
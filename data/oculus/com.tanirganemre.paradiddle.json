-1.png", "id": "1148192932456664", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DjVMLgsfiMQ7kNvwGiHj2v&_nc_oc=AdqG9AUwUL1L8-SUHy1kQ15T_n5nbw2hEfVQLBsTvdwp2XXU2B7Yu7wpS_Fy3joH40k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iaOTG8bMDOuYgAb_1n5e8Wfiz-BVngqErHnF0aVDLxg&oe=6A11AEB6"}, {"file_name": "pd-screen-2.png", "id": "2332569856899945", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974820_2332569860233278_8835659424562109361_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlmRnijPmskQ7kNvwHz1URF&_nc_oc=AdqW7cP7vEOOVdBBe6cWVhGtRiRGrYkeUYcd_QpHIBRZPCa_GfDgEvzB6m44-zWOSbc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wxHeQ5V_nApbn5Gjup_Hq6CeVt5NuWMZmKqcqXxWpDg&oe=6A11BE76"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJPQWEO7FVcQ7kNvwFDDGp1&_nc_oc=Adp2NDJofvwgycRYIHACpkEF3pYN4kRqIdjojMV3QqNHMexqJ2BwmFu0LD8waiZHDCE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ahEn2hOwMklvo9xf6XBe6VmHMrDenZozzvCAgafRQ7g&oe=6A11C0A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i8ijjQGbRUQ7kNvwEL5prE&_nc_oc=AdrkKmJxXI1pRkKUOpXlM_H3CvYGVSUwqUcUfJ6XQ2XXIWPEuS522LcDtORZawMG9dU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ngl3ljrMZ9m-CGtF-lKX9XpffuYY-N069BDxKmBwVNA&oe=6A11B22E"}, "display_name": "Paradiddle", "keywords": ["drum", "beat", "music", "piano", "instrument"], "long_description": "So much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!\n\nKey Features:\n- Flex your skills in the built-in rhythm game mode: adjustable difficulty for 30 different songs, plus custom song support and cross-platform leaderboards.\n- Create your custom drum kit from a library of 60+ percussive instruments, from mallet instruments like the xylophone and steel drum, to auxiliary percussion such as bongos, tambourines and timpanis.\n- Pick up the basics with 10 beginner-friendly lessons, perfect for drumming newcomers.\n- Use the new multiplayer mode to perform for your friends in free play, or compete to get the high score playing the built-in songs.\n- MR passthrough support empowers you to play virtual drums in the real world. You can even connect and augment your physical kit with the rhythm game mode and lessons.\n- MIDI input/output support provides a powerful tool for composers, and also lets you augment your own electronic drum kit.\n- Set the mood with 4 different environments: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nSo much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradidd
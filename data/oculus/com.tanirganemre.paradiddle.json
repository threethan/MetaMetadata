=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDqjIX-Brb0Q7kNvwH2NEHF&_nc_oc=AdrXMtMm47VUPPLwweF7e2RCjSq8mbmleUCG11Ml69845wWq1ZW96Qb6PlNHZ3ZQl8o&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82f7gpuHdjZcyxmcwQO3bjqBAvFvL2z4Tv17nq7QWBGg&oe=6A394B76"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzmpjxagU24Q7kNvwFWQUTa&_nc_oc=Adr65pgOjind4-jLWjsq3TReELGluIAYTYDUiSv-cLJ1uDFs0VQhZurRa2qpYrFUEgk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r1aQR5NOltCrmmmtx-GSt_L6LPv0foC4rdDBUlNJ32w&oe=6A394DA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD63p2_lTh0Q7kNvwGSQUh-&_nc_oc=AdpIVpreMZiRYUhrTnjETxTqONleFEaYwbdoOLiNi62AVLhj6HAFFFimEPBPGi6v2SA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90Oi9ljnYtpSWb90br69lIlsS07-sCnCJgfB1yHHja4g&oe=6A393F2E"}, "display_name": "Paradiddle", "keywords": ["drum", "beat", "music", "piano", "instrument"], "long_description": "So much more than a VR drum kit. Learn to drum with **step by step lessons**, flex your skills with the **built-in rhythm game**, and build your own custom kit from a library of **60+ percussive instruments** without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!\n\n# Key Features:\n- Flex your skills in the built-in rhythm game mode: adjustable difficulty for **30 different songs, plus custom song support and cross-platform leaderboards**.\n- Create your custom drum kit from a library of **60+ percussive instruments**, from mallet instruments like the xylophone and steel drum, to auxiliary percussion such as bongos, tambourines and timpanis.\n- Pick up the basics with 10 beginner-friendly lessons, perfect for drumming newcomers.\n- Use the new multiplayer mode to perform for your friends in free play, or compete to get the high score playing the built-in songs.\n- MR passthrough support empowers you to play virtual drums in the real world. You can even connect and augment your physical kit with the rhythm game mode and lessons.\n- MIDI input/output support provides a powerful tool for composers, and also lets you augment your own electronic drum kit.\n- Set the mood with 4 different environments: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nSo much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app
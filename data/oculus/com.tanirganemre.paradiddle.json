89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjbttV0uFdAQ7kNvwEoEATc&_nc_oc=AdpVnCZ9pLCrFllkNfLVo05lK2SjlRokmjYGc7EMAl51KLS2rm3nz-ih8Wbrvm4y3Yc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwG__VecgvmDWZBmll3t9rcnjJ7ToKWrcwH3QjwUDO0ZQ&oe=69D11536"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyAV4n2rMEoQ7kNvwGvwiZW&_nc_oc=AdqcAwIfPMFzBbYTZzS2dfRL5XgOTO8pZuN2r15b2dCRhYnhpI7_iQcX2N77m_Llymc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzsgm6ZQBef86uahQT_zAGLnTv7zpf5sThAUuZ2HLPXcg&oe=69D114E9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGrXqpJpwfgQ7kNvwFKf6CE&_nc_oc=AdpPw_3vzmVOQdiQTxbClroBUPsfVSeZhAX9DNdn8pCw0UVOwlI-aZ_fk2p26G9Kcrk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPFB75Hp7CxI_XKXEXaCX_JcBeiIL4CNizoxOBhsnX_A&oe=69D0EEE2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79AHnyVb2e0Q7kNvwFsEHAC&_nc_oc=AdobF-syystu66Ldtx_wddB2xIt5rhIx35-ofBsK1rOJk6BH48s9YQuVa3hCqhIGhYw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxksCMeL1XOADg_saT4qwgFNEteDpCkPfkbara3HjMNRw&oe=69D10E72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lG72vomx6kgQ7kNvwGQWIZL&_nc_oc=AdoV8xybCZXj_iPyLDPcM5MiOcZGfGnFsuZoHJNLnqvWTrTu7jqy2rjTi5FddfHAvjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVp12XR2nC6gW0Y00432pJhhtCwcG_QvgSmENse4c1jQ&oe=69D118AE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
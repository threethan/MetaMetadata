fw6-2.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvRn3g8xtfIQ7kNvwHvK7i8&_nc_oc=Adr96ex7pnIICpTpZOG47gXqxsnCo8CLV47EgRO-wc7L-Bo8hjS-jDgYm5SPfUjYKQQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR31xvvnumn98tgTSWF8nl8yxG_8PCvz8sKsfDB9pnjAQ&oe=6B086F76"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwmRq8Re4LsQ7kNvwHyznBj&_nc_oc=AdrJXLPabjdDZd65CRP_A7lMwdD8pKVXhCrAQEHTZrHzHQRPma2-ht-oxEKn9ysH6HE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbS8RWQ-9nqbKeN775XCk0P9pTLOI2kmhmLzGedHpHTw&oe=6B086F29"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtrY4P_MfeAQ7kNvwH-PTox&_nc_oc=AdofQnXKzMLeqZ8wPen_jT0sPD6oEdbSdNfuJQgpeL1wQtdBe7FjYlCAT5PcVZ3hvcs&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVnL3apbwh9QoT3y1SE7mOoKZLikeiatTLKHDA0SQZJg&oe=6B084922"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8naw59qnaf4Q7kNvwG9_AJh&_nc_oc=AdoKD5nJvR8iQnjd9zWo162hjkDeoSsEcAa6QE3y1BC_RgWAErcnUt3m3ADgwpBt5Kg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK17ok7KWM1LAU57zCGu7qZWYJyXV-ZygatR3KfRge7w&oe=6B0868B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sntmkk_feoAQ7kNvwF0Jw5_&_nc_oc=Ado-RuYpv5c68D4_DxGMTX_7gbZn8zu0OLXZoPJ4fCkwYzVHGOWQ8a4lXfFBvbNtXhk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoQZyjlIr57gV-6guWAn17nYSucEvxIY1ulopL1l5mPA&oe=6B083AAE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": nul
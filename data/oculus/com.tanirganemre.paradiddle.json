89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1fj9DQ0-NUQ7kNvwHbRGcL&_nc_oc=Adpw6pC9jHddlXK2uppDiaXj0n6zJOt0tOOLR0kmdZDkb5lnUGUP_6KJsa4-TKCifnE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15Y3UTNsBjxt-ba-xLxx538zAsliA03Va9gjE3LNsG-g&oe=69DCF2B6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYh8e10hRHwQ7kNvwFVgDcn&_nc_oc=Adq9a1-1jGxvegjiKa0vgz6_XJF0phcdwuQz4V1SV0nkyQqaLch3m1-a0rYimRvAAKs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LLPxUzt5K1I0qIdw-l7hXSg6cZbqdhrYoxi8BMM7DpQ&oe=69DCF269"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jm597C5tY0Q7kNvwGGUzfe&_nc_oc=AdqMxuRDF47ezAo23BNVYCoCrI0X1oGJGTQYKgicz91A-3w_piPN1IeyP34xNj8lT14&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nBymFcfY_7Q4uU8XHtDHxtEy-Zm8lWjN1sFp1m0_qdA&oe=69DCCC62"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SegIbzYlmk8Q7kNvwGfWclR&_nc_oc=AdrBOUlP14sVEly07b7SpNuhiXHqoT4BMInnoZECXwLJBMbvc9G6FJyg-DS0tKBz-eM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3d6Ncv6UWnobQmWm1IOAJJLKrcWPC1TPNQpHqhhgD_8w&oe=69DCEBF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3Jx8e86DFUQ7kNvwGyRojr&_nc_oc=AdpO_01t5nrsG3eWsyR-tJxzISIsW62JqawV0HdvLq1fJYybhyHVCr9Ex2rwnRcpNRI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12qTRChjzQZuA2OV4LnJ_Dx0c2YqiufUZhWhrMY00s6A&oe=69DCF62E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
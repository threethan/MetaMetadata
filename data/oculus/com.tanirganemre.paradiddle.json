c_sid=6e7a0a&_nc_ohc=OPskV6by-xsQ7kNvwENx6Hq&_nc_oc=AdoZrW2XwXrmlFFzlrSFa0Pqsc9xhyCyLfLRSB2g8U_l-Pnm65EfGcZ0CQXI8gZQHqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd1pakzi7X_C6OE_ugMhPMowGOhi4ldvglX-f8wD5ETw&oe=6A6219E9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-u2DU2ha00Q7kNvwFVfi9B&_nc_oc=AdqfiuBfTnqk28hO-1suhUHEEkLeRo6woU4akbBiMGohq5XWP-CEkZLPk1ZfcaVGxSI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd1G_tqAvdznjmVrTxCtL0EuDMN4FrZfm7o8TBdoyQqw&oe=6A622C22"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6XROohNJyQQ7kNvwF0KKBa&_nc_oc=Adp6hjZLnQL3mG88HidVEDuacwmAMcxke84x5mxPXLE1b0yqEEfrqdMXo1mo8hji-W8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYFrm3YtQr5I-HcgdjCXoI0tciRc6A3qKipwI6V7aynA&oe=6A621372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovrzFG14738Q7kNvwHyfRW9&_nc_oc=AdpelSVkdb28xjG4ZbLDALdtxcAXKmlIGm9AMN83ivtxKPtspILBabrH_zYz_5CFHN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvm1J-bMkrF7IM032vy8InbFd2N2H580vHwirbzCMO_Q&oe=6A621DAE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["e
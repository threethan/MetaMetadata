rd5-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDwkNkqVcT4Q7kNvwF3MkNB&_nc_oc=Adqh-gxsTwhwjmU5ZR4hm3SWEtT3Jf2V4qx-I53E7w_hHO5-pIHjjPgbsqBEXjh-2j0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpZ0lKG2Y8w1oZH7Ca13gymmpw_f3qeJ6oOYn2Pi2YRA&oe=6AFDE376"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuiQ2Rw-wsAQ7kNvwEYYk_V&_nc_oc=AdqyQ5Ye0dBGj9vsPUvYRrvJPei9Uka8w-vPc9yL50_X9NEEMte4EfFY5phARW2ehVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPuFo4lTOO3LRER2Bzr2VQD8gR8OvIkJauSHqKRcEpVA&oe=6AFDE329"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhFmyN5hIRMQ7kNvwGrqqxR&_nc_oc=AdqGGmr0SAfkx2lPJpv2sGV2-zS6tkMaRmKIK40c762KjhyA8Y-hvzBc-gzdgVAIwBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6zbM4Lz6XiAXmQNsbfmOXVZQFrNoeMm8S6GMXwJvOdA&oe=6AFDBD22"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LspaHokUDUQ7kNvwEI7Pr2&_nc_oc=AdpH58QA0X35fWHHxw6J-kmfouayFVLKjrt5tkviNn5rE33NIkD3a-EOwNW_DEKsa44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTReJcA-p9PMycYYz6OSDP58i4_f3jBui7uGuyi03r26g&oe=6AFDDCB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZnYT5z1bBoQ7kNvwGD2rfB&_nc_oc=Adp9qyqm2RiwAm8vc_AP7XBh2kTVvnPOKcyHbwK1thjCfl8O-JuUtNG42t4SAKR3wBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0YJ91xSTE79BgG114NBGptigtoKA4egV1iKEbk6EnXQ&oe=6AFDAEAE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": nul
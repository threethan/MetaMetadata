89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIYqwbZUYqoQ7kNvwHjFXtl&_nc_oc=Ado2CKSQ4zbWVKJaRpK6LNy-cqHROZRyvIflpjg03vItohkvvsVrsOa5h_wul6sqHow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GyCXaCjTi6ypurHfT2ZNa9Qd0_o_P4I88E-5yBnQLCg&oe=69EB7336"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUXGNQiGnVUQ7kNvwErY80K&_nc_oc=AdqMQiC_cGm9hkhdA2DCD1HxHKijyFqN82NVoJ5zDIX5FN2gDfT6nSAVkK5ymrmnLwI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UFIPY-7YQPkrDMQH1JF6r9xdJQtbrfBLkQi7_nfyQlA&oe=69EB72E9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USzW8-Kipg4Q7kNvwGglXyw&_nc_oc=Adr-kEe8LhA2p-h4654LK0Uaec2w10TP_jzuyOXsWEg_4iHfL2TYve_rYqAyzgbisrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TNhDNCWsybD5HAUghV5tDBE83VzFrZuZEQX45FMKhOg&oe=69EB8522"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qy40zDJuAj4Q7kNvwHijJMe&_nc_oc=AdqLz31P322cRbWJg1gaHM-ye9W6nr_rdJQBHHQfRF64GOCJ3P46igSmYYl-HwJ8fUA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xqS4TkPDzXg2uVBAikMPO1V55qNTGkPaa6C59UPYQSg&oe=69EB6C72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAxILyAU8cgQ7kNvwGnKR9m&_nc_oc=AdpVro5TccRDFQtDbbHP9YvrX0NXxg9FLTLqIWPh5XsIUhxGf7FpA8tmsLDDa8BQMYs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RepKe5DNuVeXykW-9yvmsWRLe9UGwgRDxcxF2j_8_zg&oe=69EB76AE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
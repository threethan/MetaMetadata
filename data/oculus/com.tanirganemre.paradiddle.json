i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974820_2332569860233278_8835659424562109361_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dU0K1eaX5jkQ7kNvwFZj_qz&_nc_oc=AdoxLCe0C36MkO3lL0SvQ5Z19ibBqsk_6ln_QC9NA_4iEaq2wR-f38YfA8tVP-47RYQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53-aQ5PGXsC-QspENDSYeiBdAwpm3uwe2eNB6IgdlU6A&oe=6A1855F6"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6n6EC9l2DroQ7kNvwFT2Pib&_nc_oc=Adpzqn6TGhE-8SB6QwZOLPGmXBlzdqnPReH_vgoiJCsq-m4WiH7N3_IzBmE9AtIJKmA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HRXxY0fUeCs87G_rfQ2vHYWKaMv5VoUV3Kl7eKD4cSw&oe=6A185822"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ho7YXWMJunMQ7kNvwHD6bFT&_nc_oc=AdodFZzp3slozKxcJJBM5FnYFZ9F55QR6ctwzipDfc3DaG9HZnPDoqG8BwXFhwlQjCU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ZTYlHZLXQAW3sH6QQ4O9w5nWbN28sYe9FMtPmn-izdQ&oe=6A1849AE"}, "display_name": "Paradiddle", "keywords": ["drum", "beat", "music", "piano", "instrument"], "long_description": "So much more than a VR drum kit. Learn to drum with **step by step lessons**, flex your skills with the **built-in rhythm game**, and build your own custom kit from a library of **60+ percussive instruments** without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!\n\n# Key Features:\n- Flex your skills in the built-in rhythm game mode: adjustable difficulty for **30 different songs, plus custom song support and cross-platform leaderboards**.\n- Create your custom drum kit from a library of **60+ percussive instruments**, from mallet instruments like the xylophone and steel drum, to auxiliary percussion such as bongos, tambourines and timpanis.\n- Pick up the basics with 10 beginner-friendly lessons, perfect for drumming newcomers.\n- Use the new multiplayer mode to perform for your friends in free play, or compete to get the high score playing the built-in songs.\n- MR passthrough support empowers you to play virtual drums in the real world. You can even connect and augment your physical kit with the rhythm game mode and lessons.\n- MIDI input/output support provides a powerful tool for composers, and also lets you augment your own electronic drum kit.\n- Set the mood with 4 different environments: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nSo much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEME
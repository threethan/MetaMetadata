89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybCCp4HWmbkQ7kNvwEAPqt5&_nc_oc=AdrnmYr1pKlu-MMeiAx3r30tLpUxmSCWcZYpR0gbkGYTdDLdfNsAq5PcTBEKGt482LA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11kwIOqMD-lThyNoOzOU7lbUiCUzNJVtFE6JJEkWtUMA&oe=69EF67B6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1vgrWEiAb8Q7kNvwHvhbY2&_nc_oc=AdovvxO-KJviWtsKlSNJZE5Aw6G4qRUPYOYhwS9d5ZF8VbSNRNKcv75YyEHyw7hjFVQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0kWkZoXDcpC9LRvS27CoI3iAq0zgmp-p1UVHyl2CqiuQ&oe=69EF6769"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WT0f3G8GJEQ7kNvwF-A_XV&_nc_oc=AdpaoZsAljTXYcNOdUG9aVXFaoDTi4zcgKwgAOCORMvWp-gvXuGFAINIxV2d_h1CA2E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1piLc_S65o7YCbawnODhceBF9cyKM3u0lPiVKwz-CJ8A&oe=69EF79A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AghT1SBJBPUQ7kNvwEaPCUC&_nc_oc=AdpGIV-eEVhHAFVLjvTkhnL29UFDZfRWicxeOPv_oSjZLpjWSnmdGSnlxjtfB0uZstk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0PzoSNyIFR-jQSOMVbCy3rO_hV_x0kCovFe2grNN6B1g&oe=69EF60F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOhFhsfdwZQQ7kNvwEN3Dhl&_nc_oc=AdrKv-oBN1xL6Pa3vA8zhPvmoFewQjuT-jNo60EXqNCbvnhlDRDkaMH8PY0755u9PJ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07vP5paGoIzeewB9WCufsYrIOb_KTpJ5CdJrkWm8hzeg&oe=69EF6B2E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOq_M9B69_AQ7kNvwGBjBXe&_nc_oc=AdojvHhFH2nDANNbDJEB4y3w2vPxGK-3o_74Ap9RuaQBPM08E2vK-AoxxW9XyI89_sA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hGbhUCphza-1V6B711b5T9Ruz5BUrW6rh3Z2usE30jA&oe=69D509B6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8FtP9IszAQQ7kNvwFmxiM_&_nc_oc=AdpeahG8PQjsRPPNxQId1tkcNf9tyGivb9uMkE9KXohRojMHb9gA4Kz3ZIW9ASWYbtE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1X7zCjsl0qxvKhAWJJg9lunkoriqtPKTaeFx9VKvVTIQ&oe=69D50969"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mw4fqKcpzNcQ7kNvwFbXpyY&_nc_oc=AdpUr-2WsRK9yfEZgqaaTo0rEOJAnaAyiu75hBwZzrdZjyMiB7opouSVnkuMZTyHj74&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FtQUjwfA_ALyMlFCJGNLuPyze78lG_ZNOpHynjPN1cQ&oe=69D4E362"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEg83gbzeWQQ7kNvwGL_D9-&_nc_oc=AdqMnP3e6Cg0bcLf1hsITqdKu7K1ItJXVpDJTfcQOCWGnU1CV7OCef3lkZzBtphab8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UlkQEVvoaXHYmy9ABIydSaIKC2XlDib48g2fTjuDjyw&oe=69D502F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd88nzpVT3gQ7kNvwFauuGa&_nc_oc=AdouQdplUxMxaw7xfLZ87fp2UgYax4S3UPIloHddcKxKW5hKkS_pCZGz5_CN5Xgcq-Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G2zQmy-de7v3BsGHTUjJ5HX46F1XVwf_hK3PEi_Bj6Q&oe=69D50D2E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIYqwbZUYqoQ7kNvwGgpPUT&_nc_oc=Ado63cwDlCHIa6eLjQjsb1w728sDlmt8lABrqrJscZqt_0HEGWg82hJjhsoA1CR-QqA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K4xVdp9JQ4ECBROwxumxLaHi4KIBSqcKojIWdvCr1Xw&oe=69EA21B6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnXY3WeakkMQ7kNvwHSuwEy&_nc_oc=Adp3HK3Hk0MO_VoRt2nGmfifFGx_4ansAhvky7zKRwG_1b9FJt_aJtexB_TPu_S1gKc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pcWycQHsU6f3SAIE84I5rdHzVp9hQ6r9TawhHZk3QEg&oe=69EA2169"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USzW8-Kipg4Q7kNvwEkgtsa&_nc_oc=AdpwYFeGSyQt702QpXFvaFbs1Vfz8E8TIuxvQPmNlAearXHBLzeDQPf20DkgMD8Tbl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LWTXazQR-Ej_PzS3i9qclT795pzYMOF7CmlSz2F-4Pw&oe=69EA33A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKd-hWK3lRQQ7kNvwHhF2Zh&_nc_oc=AdqIobM1nTBFCIO7gKU12K5ad4_g1J-GP6rJUy1Iami6s-bQJ8kBFuF_opc3wL_MvIc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z_tI3bBXt0EYV-vONF9pC1co_h0pneDepT5Ag4Cq0Iw&oe=69EA1AF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sAxILyAU8cgQ7kNvwHal8Ql&_nc_oc=Ado2h6ByLprwHXaW-g2GCBeAWyiMqTgN0aiVXScS2PJ7W0RvHJN4AcI5SjpiICeQOWs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UQanwNI9ZnUZq3qx0J93p33B-m_GHDw6Vs87w14enjw&oe=69EA252E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
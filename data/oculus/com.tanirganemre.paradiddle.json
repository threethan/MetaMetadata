89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUeP3TkpNLoQ7kNvwGJKxlW&_nc_oc=Adq68i8IlLXZeyZCMItpz-RcLLvevYPw43L9Eu_ZJqfeAkT5VprnJHn-gSG1OxVhMvo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Coyx7eqEDlb-ejmVHmU0styOvTFPT_C2BPkp10MQwDg&oe=69F5FF36"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9xyVKmDcgIQ7kNvwEAA3OE&_nc_oc=AdrjrcAN6eScBUEgOHrOqU-5vr4czkpg67FLdeihUBB5GACU0wuwaxKtoD2NSX7rIpA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Jvx2JErKzU38MqVg8qDhXTaorkTJsHh2dDmtPrCwXDQ&oe=69F5FEE9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkPSecDkOCUQ7kNvwFmx4PL&_nc_oc=AdqXGSN4kvQTSVLtKCwc6ZEJeV7sAfVysXDJBDhXuyy1JIbK5DBzdSJi5Z78hY_61Wg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1HZGm6IS-HnbpKtxdtV9s7VCfee0l5kycyoDwMLQMg2Q&oe=69F61122"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZO9ocoHBuXcQ7kNvwGY6owM&_nc_oc=Adr_MnKi9Cpl1zOAC9nuvupT_cUOiUaJI40qScADtCgNTQ4fsPj7amMPnr8eBOWIwrw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3U32XF9d4D9DxvED9Ubgq7XZRvDqXyRWEYR37SExWY_g&oe=69F5F872"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABPnanbRYFIQ7kNvwHUrlR5&_nc_oc=AdrNZYaza-2QPtqS4moMjtSiuZNn-6IyehItZlP7Fc1W0bUiHjA0nRw2NL0GUvualYE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AZ8VjvP-uphACiVXMUQk5dHjtwc0e0H28KbS2XCXIUw&oe=69F602AE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
", "id": "1148192932456664", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOq_M9B69_AQ7kNvwFtBgWf&_nc_oc=AdpEl3JQCiRf9PScWHsZXyzuBaEWmNe1xA8U8aJX_-T1tdo-Rkx_5OQYfMwnz0mnCiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iamhpHk22o6g4GQmjV615Rt6WmrlOSRqJQC1mkemAWQ&oe=69D266B6"}, {"file_name": "pd-screen-2.png", "id": "2332569856899945", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974820_2332569860233278_8835659424562109361_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bo4ybdS72WsQ7kNvwGAMpoS&_nc_oc=Adol2p1_2yLpftmosBHfZtb7QjWC01Cu1hHcjlCNvpgxvqmAH4c29wSGCXxk9s3beTc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NUX9z9smImqw7YhmDJg-idi5mSAYdEfHcKfTFY2PZiA&oe=69D27676"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGrXqpJpwfgQ7kNvwEWjx3_&_nc_oc=AdouAYRPkuY3Xg2wYzasDWEfaHmy3BSo3m0olXzQGhjovSxqQx4pD25Ot-h9ZLaVXEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36B4yKS6e_fn1dLEovowmjTDnlC4TX9ENid8TUi2jOcg&oe=69D278A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lG72vomx6kgQ7kNvwEtNXLT&_nc_oc=AdobpkSW4Osy5Ml72kplzWZkWeR_5129T7XxiOBDRl7q3CZuGyy5oS3hlVmZJOjH5yY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Un93NeF2Qjb0U9p2zwKTV4NThnuAoGuqRDBS5Pr1yXA&oe=69D26A2E"}, "display_name": "Paradiddle", "keywords": ["drum", "beat", "music", "piano", "instrument"], "long_description": "So much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!\n\nKey Features:\n- Flex your skills in the built-in rhythm game mode: adjustable difficulty for 30 different songs, plus custom song support and cross-platform leaderboards.\n- Create your custom drum kit from a library of 60+ percussive instruments, from mallet instruments like the xylophone and steel drum, to auxiliary percussion such as bongos, tambourines and timpanis.\n- Pick up the basics with 10 beginner-friendly lessons, perfect for drumming newcomers.\n- Use the new multiplayer mode to perform for your friends in free play, or compete to get the high score playing the built-in songs.\n- MR passthrough support empowers you to play virtual drums in the real world. You can even connect and augment your physical kit with the rhythm game mode and lessons.\n- MIDI input/output support provides a powerful tool for composers, and also lets you augment your own electronic drum kit.\n- Set the mood with 4 different environments: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nSo much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7056409527730786"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982551_221613090771607_8620078170120975747_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BSw_RfESkQQ7kNvwH_98oO&_nc_oc=AdrxEenJ0y84N_ObgI8wFflEoIQFH0giPIL1ThUlYJq_4UxTKVsyLeKdJrVDvstHiII&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WPgECbqdGPIUw_qZ3Krf4IrNapay3HSYrPsJIcYo9Bw&oe=69D25C28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Paradiddle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1700157600, "lastRevision": {"nodes": [{"id": "5719805458057873", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5719805344724551", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "798253584109839"}, "iarc_email": null, "msrp": null, "translations": {"nodes
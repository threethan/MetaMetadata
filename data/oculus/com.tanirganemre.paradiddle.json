89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCElL5kwUBcQ7kNvwHUziqQ&_nc_oc=AdoEXCrCA_hbAiMYORH83szzTQNQfZipM6ZuNePh3uA84na5ASSKifB3YqsOtHMyrdE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bIkgP-HcHkpgj7zOtqp9xnmwYCZ9k_XrRZIQh2-1Gag&oe=6A105D36"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE4kiWp78iYQ7kNvwHkVsVA&_nc_oc=Adq97hSJNz14dYDrtQbCnoIsAdjcNVQtRrtC7KSj8yiQTYq4w4DRI7obANhunWyUIOs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L5goLbVutvG0K7RhWG_4heemAqWgykgdUBQxqsyWZvQ&oe=6A105CE9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJPQWEO7FVcQ7kNvwHKjgRm&_nc_oc=Adp-g2hwxZwgGBxsC2Ea0yMEIQDKyMjq1h_n68SKs9bX1gOzNh5wm-4gZ9SwUp-YVfo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HO0jOfmAcwEmI56Be0kCNSFVp07D1Oarlea_e8GajIA&oe=6A106F22"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab37U3lR3ioQ7kNvwGhkAud&_nc_oc=AdoljU9Zfm-QeFxYjrrwBycqowvBJdNA3tvi9HwRcJl3vSersqs0O85jWKAXlQ4wgeY&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eF5r0z7zt37oaxMzsM1sgBkEef0eFl2SmaeQbVidnfg&oe=6A105672"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i8ijjQGbRUQ7kNvwGLE0lG&_nc_oc=AdrUhvIVExhWA4dUpH5H-M9KARr8DVwhunaWqeWejLsGtsF_zg0mZ2WJPDciNcigYsY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kvw0kFOmm0fc9aFdR8Y0YitgxcG1j7Bw-MebIG-nf-w&oe=6A1060AE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
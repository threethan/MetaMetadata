jzq7wmk4QNivei8O3mJhh0fYA&oe=69F20AB6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1vgrWEiAb8Q7kNvwHnjt5W&_nc_oc=Adq14Imm_sbT9OiF-kWdHnQn-C0YLMLV4RuCI7TQ3_9Su8bjp0qj9fc2OozCOHVlsgA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3G_06tYGJ3Z7In7bDAmBcZOGGQYTIctoxQEfiPo-qFVg&oe=69F20A69"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOmhF0BXEncQ7kNvwG23145&_nc_oc=Adp5QfBmDJXsM2swkKuCrfd1ZKXXir-yKSD400IwI2XoGOiDmVqsP4UO8femMfIc2pc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1qYjLYJue54yqXwZGx2_qQSo5g96rPjvES-MDiH_ba7A&oe=69F21CA2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AghT1SBJBPUQ7kNvwHjBrWY&_nc_oc=Adovyc7Rka82429IcjTcK62_OzXuTLhzAqtfT2vb6bVitF9OBSFxxS1Uda5ajpVDsfI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lqFxQBPuLFUZBoe4ZKo4IpEMwhbgeUXr8APGEem2dvg&oe=69F203F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCjcRprOvvoQ7kNvwHsneNH&_nc_oc=Adrt1wYwO7WpD67IA9t-a9TzgH8dch8Jol5lGf7cp4A9nQLjA9nPoKVIUgBhGa-EvS0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0QKFmlMaNv8eQXzRlyJWB-ZOeWWP-Fw7vjOJUhd3Ng8w&oe=69F20E2E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "SIMULATION"], "has_in_app_ads": null,
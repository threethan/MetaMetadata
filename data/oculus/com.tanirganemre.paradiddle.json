89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNMY3RMlLtwQ7kNvwGA8qMm&_nc_oc=Adpt9X4hchcUH4MNx4RXUPyKYE2b0_l0Tx1Qvfi5y5ET16lYx3Og72t8XzXPBqbUeCo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzb2qDI8roV1e6961MLgr3BPeiyafLIh38_bLUfKmQEhg&oe=69C3E636"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLUtz6Dg9KoQ7kNvwFJkZl5&_nc_oc=AdoKPS2f8LKEO-pw_GQK6sV0YVwo35rgByyRrw1ZY2-xGMQrQt12gAsG0DUDDMCyn9s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyTKp4R94eE7J1yqmo6FH0PGjTDIs-E3tD9psUZXsWwcQ&oe=69C3E5E9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reQWb4rJMBQQ7kNvwH9Wxvw&_nc_oc=Adpczgdw6mwg2JzmQILmVChibmD6abpj1gWg8zTdyisFzK7K6rQRrIDiDGttpaYk_f4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzfGbXE1e4u8SFPa8U4WPEEjKEqGyUfDgNTaeC-yXStqA&oe=69C3BFE2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyUH15sj1NYQ7kNvwEB-JYd&_nc_oc=Adq7NR13zzGAyMY4UjBfTrulw0y2YUfAnGfB1nbRqpdGCviL24X83U0LN_dW77FekEI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztCm22tGtSnu5Y9pQUagMhLxMbdxJcqM83qROoiiY6gw&oe=69C3DF72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ya0D_vIa9bAQ7kNvwEVH-2q&_nc_oc=AdqUEE66yifmqA9NLqEUy-xJOqAJ-q7jYJOkBVVFuVz9pVLv6YZP6wodlba94T2fxSU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOR2LrR4kbsS7hn3E2RwSwwbJFWwSd0s3ucdEQjvoIxQ&oe=69C3E9AE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
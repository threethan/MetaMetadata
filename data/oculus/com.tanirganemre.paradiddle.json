c_sid=6e7a0a&_nc_ohc=ApRIYh5vg-0Q7kNvwEhNiaB&_nc_oc=Adoc1WK8SPVUY1JyjLilBZ0WwIon8u4F9YwwrUMxRmPPxv98aCNUSzfLqNc8nagFU1o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhBZ2KLzw8LDJecMp8l9QIUqOyO3voeJKmA7y6MRM0Mg&oe=6AAFE269"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qjfahNSNcMQ7kNvwHih5hY&_nc_oc=Adq1V5F3aU_xgiB5-DiezStLrUd0XZ3SSBSQJNKac5pIgf7ZTj-DH2Keze-2p_cdCd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL4GQWNOnYDTm4UEQmmcfFRj5IcaZ0PgtODNxZmGeXuw&oe=6AAFF4A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7I1FjADzcAQ7kNvwGZSdyw&_nc_oc=Ado94_Xm6S25ocX3z4yLC_C0MaG3VzgBtXzfKZ1Ae1ESo-CuAQNcuyyyqLtXVi8eMyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL83ku77nZoakIMaM5NAs7Mt5Q-n9fuXsKeDIe8WYK2lA&oe=6AAFDBF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMFDXi6goDgQ7kNvwGb15Ji&_nc_oc=Adpd9OZ0whgXlAyNRaPSyWyiZz1nGbXDQ2CBSImnYA-jcNBmWteHvQe4ksJvAE0AOwE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI2Dv7FOd6JrMIOmmxo_7nWJz6Phm_3AT_zZJeSGX6oQ&oe=6AAFE62E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["e
89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZlkWQflaj8Q7kNvwFBF8wB&_nc_oc=AdqVTrblkSPNL1mbNUGpvXPoZ1uOGwpnLkOC8lCACi91eSDwCuGNAq4NbuMqMGA9Mz4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XPulY86x00_IfZHa_vEQ4QgqJJ0xYP7Xv631SRAjVdA&oe=69FB4536"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QD9HHxIXaWIQ7kNvwFNVHvd&_nc_oc=Adop0LWVnlRPy8UoJcI7Bkooaj-We844TE1qlLeWDRMFmmpHSgnFDJjuJR-aM96yKp8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k3BA3v1iT38uHSaxbX1CSGSsi17SE-AjMbmDtdIb1LQ&oe=69FB44E9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxYeBL2mFkQQ7kNvwHPox52&_nc_oc=AdqMTYlQKgUUkaHuy0yrFThuMBFrh6oxfUAmcmd1HzDl62WLvzJ3B4UxlvS1-4NlPZM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6avJ-N7xUI_5RO0F1NBZ9e_Ef2S4HTGuWPPUVGhy0hHQ&oe=69FB5722"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kD6tm3NfecUQ7kNvwEGk5dT&_nc_oc=AdrWRg1_Xn7pjW00Km6wXhQj1XNzbVpKK-YrRytoHZSH5ICuQ1uRf0QRVW9F9Oobcbk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uynxC879gBmPDkx3uR3ZoJTjMyvpbpcajuuWc0LYKsw&oe=69FB3E72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlp-9q54E-oQ7kNvwFrYA9U&_nc_oc=AdrFfcq1atjzHL-kjwzDbOgHeSWNfI_KsehpFQ4FitGA_LuMh_50UlaMfSxzxVfieNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_m12ZaS5f6yp4YhEYkI4AXT9t69vKbDFbhAgX09lojQ&oe=69FB48AE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
ad3-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvRn3g8xtfIQ7kNvwEUKNU2&_nc_oc=AdpP6rZzgSSTuAGzkbfHddWW5AunEbvk8BQ1AwBMdlIZ3HruRu7zD20QRn3J36hHHbY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ52LX9dbzFcnb2JRTf8WVDiXhgxHH6HAqSdzPl1vdmsQ&oe=6B071DF6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuEWRG3OYl0Q7kNvwGHPio2&_nc_oc=AdoCTYlSlZ36BgC-4uC5usTvmK54FkKu7E-IBGQCbOxlrMeZfGFRJuTaE4caipzDkdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVoYFd4GSRRlfIUD84CUZo0grh7S2kSpn-OHa1ApVJwA&oe=6B071DA9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtrY4P_MfeAQ7kNvwF0TVxL&_nc_oc=AdqEt2MmlSyktNM_rDpmgYfOrFj9eWZamGdKsxq9PgNzZIjhpmkybphqO23upJGJ4m0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlZYXDNaxp2TZP3KPOEZtS7dCfpaNA2uFusPd5ZELUeQ&oe=6B06F7A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OILcMBiBqQUQ7kNvwEEWzAC&_nc_oc=AdqcPGyX9loKMbRAVJkaUwqU9f4gay2FxBpZ3GNR7LNd7JbwGAr2mGkrj5NPApGGEk4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbRV1G1BugTdRcZTy7_kj_02jfkfcD6ZfJeTUg7qjCGg&oe=6B071732"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sntmkk_feoAQ7kNvwFUGPXS&_nc_oc=AdouW6GG0Ywd38RbvMm3cwEzAGpmXiYKpe5FHb4Sr3Lalu1dAreLPJ-fWPQtz4LDMNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2NygkwNsUnKf553Ic6eQEeLSVLrcmwpW_wwstijrMIw&oe=6B07216E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": nul
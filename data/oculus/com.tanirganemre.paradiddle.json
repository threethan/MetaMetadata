ttps://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPBxy_8l1QAQ7kNvwGo8Ub0&_nc_oc=Adot25V5sC0G_Y4GwhjCcRNY0_DFBXAEHnMwPHhTIBNFCrl1QndNHEpt_hT1xoQONlo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54VkmgFVC945YY7KwQGIlYZpiRNlziA2orDZ9yYjzRQw&oe=6A1C3A69"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eR4a_e-YRt0Q7kNvwFUvtPq&_nc_oc=AdpI99T2C7vViaCOYBRXondgdqSuDep9oTAyexJVNhCoIMgj9RCB4O8P7h0B4Gnww18&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48lX3vdwUTh1OjUR_ox5kHQwtSBim_EdGqhgnutXCO-w&oe=6A1C4CA2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAefpW5M32cQ7kNvwEjFR9-&_nc_oc=Adq9GeHGIzRThyxwa9NWF1NGhzOr3nSmINdP8HEVgv2JyI2a25UEtMbyp7H2crq3Ibo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ujdh04MqubeL2meAaA1llUtWnacd-bTK4LPNvjQLA4g&oe=6A1C33F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuviMpuqhm0Q7kNvwH8rBAb&_nc_oc=AdrtAHo1eSEMH8R1C-OeRuBsVJS2QQbREM-8HN71teiWtBk68hPG9qU1niAPC4KmWMs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6V0IY6Lyb7KiZDtOOTAKS0hVM11HWNs1EHuG2JJLRi1w&oe=6A1C3E2E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "
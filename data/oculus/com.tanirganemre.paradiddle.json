ea5-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_wRn_TV_VwQ7kNvwHQAggA&_nc_oc=AdpgfRjAC0FYyE9fwMXGjP15uYF7YRzl7MFJBV5XTGR6pEW83YMUZZFyOEVKBfhBcNY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIS9Weo2I-CXBkWmMQ1SQh9aZbkzLUKAEmmdRH7IS_LQ&oe=6AFF34F6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuiQ2Rw-wsAQ7kNvwGrBI9K&_nc_oc=Adp1pP_PhJOPMTg535oLFe0-Yg7WyVoXQrtJzWoOKXu3jRWgX7fPvSKL-NBV39tAwVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAl0BUPRA3inYQ-tlsL-flqIOfBQU-Fs4e9dnr0nqCgw&oe=6AFF34A9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhFmyN5hIRMQ7kNvwG6ClYE&_nc_oc=AdoW21pXMVsAVgdfR1cNCOslo4lnSRABGW_LHaCs8OifqZWRVF7TnQWS3DydNiSop8Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxuMhhz7FLpkvEqufwbinaVOUhfLI7KrBlpViW30_dKA&oe=6AFF0EA2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LspaHokUDUQ7kNvwHFvgE1&_nc_oc=AdoCq41HmwAkcah2Dk0QNvQL4BEcCPIK93f2XST9OzKH2k1V8BK1-aLK1WkVgK-VNc0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWs_4wJnnpd8qNIUE8OLcAoCNsMsJ_h_VVXDO0o1s14Q&oe=6AFF2E32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZnYT5z1bBoQ7kNvwGO1BBP&_nc_oc=Adp_KHOHboSSIl2Ajyd6A59OGvShHSwzThtHEv8tbt6AWeO3uQYemPxjFGTfaeuF5bo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkhA8DMPhAu-Cqs5W9zB1kwKaEPcz9TmOCp2b_1Q0BXw&oe=6AFF002E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": nul
89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Xi4NE6hT5MQ7kNvwG750kb&_nc_oc=AdoCz2Q02AIlu1oX83-gr_NVUnUgdZjmpQ6vgSF3rEZoqzBCIbM0szihGQkcyUzO9cs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeM_HVu2LIwQOZzbSbMZxdwsxzwAys1G4dDFnqabLYFw&oe=69CD20B6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGE7Z6l7qFYQ7kNvwHHZMEq&_nc_oc=AdpBHXn_LVF4IJIJbN6rj0j3avifHiUtJ6DLqq2jJ_bUMm0EwjLGanJZ8idGLsgZmwQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEHUIQvpAqRfMldulUD4sOix3Uvflahq5eiT1g8aFlQg&oe=69CD2069"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf3j-oOfCfYQ7kNvwEAuN5T&_nc_oc=AdoAlSuASKOiR9xruSU-AgxC9a_4HARH4O7ZzvhpVI4BFWy-x6a7C0n_ebmb2jv-Glk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJKTPfrwpkUAt2zI5mVX420rUpxrZiSNDfXkXK2EbiYA&oe=69CD32A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUEz7-a8I2EQ7kNvwHQi7P4&_nc_oc=AdpjeoKc-D5A9YlfgYmKo5AiY0sW2FOl9jlJTE-IF0dYFtDtblNmfwKUHOT220CvIBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1BKMbMts8bu4NpnaJ_4suePwVvMuWe1YhrpLrVSKgNA&oe=69CD19F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_JEb4I15lAQ7kNvwHJ7Rpl&_nc_oc=AdrjvekUzIB9NtjFiNs88lGZSUMtABsW1Sa8hLPK4_5v41tEHmxFrE_jB363-CYitaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzD8rVZ-fpGmNDYm9e7O9S3vI14fcqHHrYEKQ8aTV04PA&oe=69CD242E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
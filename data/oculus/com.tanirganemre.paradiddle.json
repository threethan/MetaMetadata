ad3-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol7JkTwszC0Q7kNvwGhpaKz&_nc_oc=AdoW7HquN6CfJc4XD2KNcizgCiI6qzaF8nuQArU0E-F2wdKK9RPeszSh4_6b6o367EQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIINwk1kL94xTgWmyqhNgw3mUPRK0FYYTaS-Aw4jnKSg&oe=6B05CC76"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuEWRG3OYl0Q7kNvwF4N5_D&_nc_oc=AdrvC_BV-ms8ySUn7LlIcIgpeyMQe63oMA3qEfWZimT2bU6LK1tSYIouwPAZx22t-tM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwtrkjThFjc6iRwr11tRtEPjoN-h4utFGfMz6Nd9cWBw&oe=6B05CC29"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DtrY4P_MfeAQ7kNvwFpI_CR&_nc_oc=AdqBOdOPTB2SpOmh98elMfRnJxH-eymv9Dag8NoKlq_lS9VvZXeP11hkyaUtFg4Clpw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvtglFuYjyI23cZOhD0P0maiJ4eaybLhb-MKJtfjHn6w&oe=6B05A622"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OILcMBiBqQUQ7kNvwFCCDBK&_nc_oc=Adp9AN26VNB2_CEjP506l2yzfXBx1otZuJ35YGg_pRBs--E00zozbqWH5WpONVKbyes&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdF0SJy6aHSfMcR-oxEnKL3_85pKUgDik8KEfEF4osMQ&oe=6B05C5B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sntmkk_feoAQ7kNvwEv6_vi&_nc_oc=Adq-D9RDc3xLlT0dSCzECK3UREB2-GjMZrHCcDFhdWe2N5f5T6FsqEttuzl06KlO0D4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgJwO_B9webnq-zbi1744IEhxBhL_2jy96WLaMZm_UXQ&oe=6B05CFEE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": nul
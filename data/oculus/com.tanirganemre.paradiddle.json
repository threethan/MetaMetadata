89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DjVMLgsfiMQ7kNvwGpM1Uw&_nc_oc=Adrw3RRuBpX7jdD9-gSKmb3Zhy5wP0MlJSasDBhrYY80qpfMzvunbSavrNvJqAktKPU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SWErINIcV1-ZyM_NayCGWxNfMMy4yye_Ks38sr8WkKQ&oe=6A130036"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mku5sEuDaggQ7kNvwFl2yYe&_nc_oc=AdruZsrOjVYEawgAlJMoyzkGf7Egj6CAZ3u5xa2u_u55-1OvXMglBAzXaP-iNZcnjNE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Miw_gzqzW6xXsGu5M1SmhHxvDdh-Kn51in4EzE39-4g&oe=6A12FFE9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJPQWEO7FVcQ7kNvwE3Trwi&_nc_oc=AdqN2qYmwItEpX7-_3DSpOPdy4I_-ZGPPA0jOdQISB1lueJgV6YFUKPDnjzeR8W1XZc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yqLUJWD4T7jRJr0rGLs7rYL8tdsIjzRm3RudhjOx-oQ&oe=6A131222"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7-BDj1skZYQ7kNvwFmWH_6&_nc_oc=Adp8MR_5x1BXonFOOKPkfffaAJVgownVt_49LmlNTbOQNLn1beFqU7gvJfco-dws3zw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4igeQLHW7NXUzNGQPYTLNWoyUiehZ4ORwAQzB9krXuyw&oe=6A12F972"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i8ijjQGbRUQ7kNvwFVmc1a&_nc_oc=AdpFsyRvkujrBSdqIAsortWjJUAYBI9etQXx6xvJDIKAaJd9Y1TAL0bRCHAqgQ1hKrA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qgmfrQPqPAS4QhEdvoou9zgebC9blkBH7j7tISuWvsg&oe=6A1303AE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
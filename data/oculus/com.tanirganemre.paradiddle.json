rd5-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2SKg7oCXBwQ7kNvwHW7m-d&_nc_oc=Adooa4yRs1mKPyJXRvJVDDhyv1Vc0XoVakV-7eNW6RojVIDKgXBIgEoPJ51Z504JIKU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ6WIgs18zIN_O7rUIx7l93l7M4BSdBrOq4l0KXF8b5jw&oe=6B0DB576"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6xmi-NtUHwQ7kNvwF4tfwC&_nc_oc=AdpdNULTumh1B2gi-Pbx_iLGrntCGncG23HpZuOmv_OPwV1MNyfxEM6SFxReBboOtR0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWccv4lMvO3A6nFCkNXIduUcrCYAyyoL0m4JmGHEtM0Q&oe=6B0DB529"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7IMvmdUyHYQ7kNvwGWlVoZ&_nc_oc=AdqQZZy5qRXVlgjSvZoTnCom9Jqt_nZw3PgJx9B94G-xhrSYhacF9rR7Q3tD7gF3kRo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSN7UOszCUuJtM9SOoPwZNOQA5zgCwmrPiiMJjPBcHbCA&oe=6B0DC762"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtm3tnh1vkUQ7kNvwE7hSbB&_nc_oc=AdoVo209U0ZXW-nRzNP6cjfpCkxl79N2vtm5YBrtv1a38Cvt3nsywJsBhJSZC8FKX8I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQsFHVvNSRHzZUB6J7gy8NeqtUKgMIFv2vzG0hMRBqGw&oe=6B0DAEB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IRy-yhG5GgQ7kNvwEsRNGQ&_nc_oc=Adoz2UYZOEbtJgTxlOvHHWeksYbrttyiVHF7OeqTLjwzYD90HAE__UK9Qw4QvZKMjrg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR4YpaJu4gfX1FH4_0lbsRKzbkc5Es-WAQ-qXtSmFk8gw&oe=6B0DB8EE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": nul
89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Xi4NE6hT5MQ7kNvwHVa3y9&_nc_oc=Adqpq1krZmm2uCHC7KYRacy1TyZnpfU48oMhE73CeBIqJQl8cm61NyrKPPHUC_L3YuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgeHX313kh12at-UQ3uOxG9u2EvVSyVcuPRWQUARbjcQ&oe=69CA7DB6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mr5ku0u_ZYQ7kNvwGPmZ4D&_nc_oc=AdrKW1-MV2E3adXtDKCafUpKKT1TJXDM_HyjmQaygwfURM_HJIJDslh5K1kYVyHwhBk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9-WLqIPJ1h8wQLqErJMvnvU-4uVAkQA_JID0ihvSyPA&oe=69CA7D69"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPjtGsC525gQ7kNvwHm39-x&_nc_oc=AdqhyGRb6AV2wmk0emQ-6N-ZH6kPrqUej-Y4tiI5m-FgXXqpNlwEMtN2JLKPNXBIR8s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6JNVfH8yazjkvZs7-jv73Aw_xAbsND12t_AKrLXUJ8g&oe=69CA5762"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7dJtRgK6BMQ7kNvwEFg-tg&_nc_oc=Adp06bCN5C-OL8dddPAdRQKv1Y2VM0dpk8oz4DtdF5Z-qa46cZ21R6sVA6qKgdl6DXs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHVcyjCc1EZC-IQG-L4aYKePPYD06vJsClMypFl14uLw&oe=69CA76F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHSf76u_wp8Q7kNvwHoPPUz&_nc_oc=AdrXt31TorLkOTIbh9dBixbRnqtHrc_c1ZDH97Lu1uSG1E8PN_Ze8PLgUvA98tkKC6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsM5bR3Wovtk8bv9x3818n72ImxX9LGCp_va60Y9UxVA&oe=69CA812E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
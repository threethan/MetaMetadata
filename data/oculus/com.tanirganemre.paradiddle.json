625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DjVMLgsfiMQ7kNvwGiHj2v&_nc_oc=AdqG9AUwUL1L8-SUHy1kQ15T_n5nbw2hEfVQLBsTvdwp2XXU2B7Yu7wpS_Fy3joH40k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iaOTG8bMDOuYgAb_1n5e8Wfiz-BVngqErHnF0aVDLxg&oe=6A11AEB6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE4kiWp78iYQ7kNvwFT7wYE&_nc_oc=AdrfQSwNTEHe63X3xterRDWnYtP0ld0XP5Xlj93pi4ofWRxMYKY2IVXHCpmJgtEFAa0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76B4UGP93lH1a1VknooE1GEwjMdt9I0Cs3sXOfzsQbEA&oe=6A11AE69"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJPQWEO7FVcQ7kNvwFDDGp1&_nc_oc=Adp2NDJofvwgycRYIHACpkEF3pYN4kRqIdjojMV3QqNHMexqJ2BwmFu0LD8waiZHDCE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ahEn2hOwMklvo9xf6XBe6VmHMrDenZozzvCAgafRQ7g&oe=6A11C0A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ab37U3lR3ioQ7kNvwH-fA0o&_nc_oc=AdrAqOGafgWXS-MtUNXbzojziJW4HLQf42EEIec3PTiBMUkMpRoT37EKrI9ZAJZVOZw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HKQci0MAmK7XVytuNsdaywvWVHihKtHrnom_HTGy_ew&oe=6A11A7F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i8ijjQGbRUQ7kNvwEL5prE&_nc_oc=AdrkKmJxXI1pRkKUOpXlM_H3CvYGVSUwqUcUfJ6XQ2XXIWPEuS522LcDtORZawMG9dU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ngl3ljrMZ9m-CGtF-lKX9XpffuYY-N069BDxKmBwVNA&oe=6A11B22E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comf
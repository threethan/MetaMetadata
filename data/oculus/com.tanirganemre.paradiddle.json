89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_BSqVciUzkQ7kNvwEX16_3&_nc_oc=Ado4TWH7CQd8ZAAByXIIX0nnkC_WXsWB9kckO5Vos7SefXAjaoF84nOB6ioEQ3T2_rU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qHyt7CHG8oxo1-ruUMdl99WCjMI1XhySSYTnlDhj6wg&oe=69E0E736"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsQdOBgCQMsQ7kNvwFKn4IS&_nc_oc=AdojlbOgiKGm2fN5IjEe2kDb3LN27QOUC1yXr4ebj_gC6PGKEid9OsNzfAGloh8YGPI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af259R6wbT6NFLmm2h7Bwxx-Fuf2bwmc32UlsQwgtT4kGw&oe=69E0E6E9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPzTxcacGL8Q7kNvwGxwmrF&_nc_oc=Adr9y-18Pr4gBWvfP9SxLuS6GeG9Nm4r1Cgw_FIAJvG-9LPVyr7udVpQ4q0GjPJSbcM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gkUIO4Ao7MrXRAQcy9mw79Ck7aHheXOXSSBKM9zr5Pw&oe=69E0F922"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4QuEzbYhhMQ7kNvwF4IqZ0&_nc_oc=AdppyhhZebwySh5aqBvNRwqij54jXp2QietU_wg9M4G4qXCEGSOCtQLh3LwVmtO-joo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3AVCBQTcXOb2Uk_n2peqx6Ob8H16SUrNVzoOqnoKsP1Q&oe=69E0E072"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZlrr-oy7eMQ7kNvwEXIKbW&_nc_oc=AdqPGo0jhE5tCaVWL_7p-FzQmAtMWWVjMw5xWdXAI6sm0iX8NwUX_TU1GSNtwYgHRPg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SREE-Hv-CTgD5YHvT7TRpcm6uqQz7JV1qacrA2FkLTA&oe=69E0EAAE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZlkWQflaj8Q7kNvwHpR12I&_nc_oc=AdqkNFfmgYXRR9FZS1zpJmHQPPSH3VYn0g-NN-QHb0mr1jrAYPW53N6i9YujH8EynL0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6p-k04jOXWsY9eIQbPc3i8n8qwtm6PsoR8rYG4sS6A4g&oe=69F9F3B6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxXoRAfRdDUQ7kNvwH58wcb&_nc_oc=AdrBvpdO9mgk-r8PuNIOnY470TgnMzrGEpLGeHfi6zDdsdDrtQ85HV9jXaA5R8IF7C4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j4v0bBgs0pUVjwr8WNrizPN6KALte5PEJWj5iMp_Vbg&oe=69F9F369"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxYeBL2mFkQQ7kNvwGlmJ_D&_nc_oc=AdrHHJdAE2uqd_nv88rIDO58s9lIXvcFGmOxKTH1_R51pibLAtSmi48WSqVxb3zNczg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TVVsvHKoMoThRVGzzqlqy0wc0b1b3YXJlkFKF5GaLJg&oe=69FA05A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYDk3CJurBEQ7kNvwG_XA0o&_nc_oc=Adprb3-n_RRM_6F4obALtQb-PTmffzaU7qivNa_cRst-xy2A2YnVDAxeq6fcuDwTdWk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MGRuDgVEyGe-Szm0o-0fy_7GC3x39bbAAmuFPABkRpw&oe=69F9ECF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlp-9q54E-oQ7kNvwHv5iwn&_nc_oc=AdoNtvex0VF6-bUpTfEJdwJVGn-7GU-0IRl9AryMfazI_1XkoP-AuOqbPYZ-8DiQY7g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jUnJfrqXGSdQa5XB2WHjIRTEgXtOYpqbkxT__ZGee9A&oe=69F9F72E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
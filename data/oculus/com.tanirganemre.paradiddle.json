ttps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNR668QpQ-QQ7kNvwFrPFhs&_nc_oc=Adpq8vgcG_MnkURnnAV-OEgLeFEy2s1YJIpwvnzZNfGt1m6o8GZCztN0N-b0cfq9IdE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o5SoxFCoWIg6Ksf88Q_wM1iibWzADgw3bSEv1eHhqdA&oe=6A218069"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzzicdO1nvkQ7kNvwEktNsc&_nc_oc=AdoZA5bcz-r-cF8UeapsDC6JZHvoa91hh_JohII0F9hZ5eDDU-6naTfNaIkRyIKn8Rk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6Pfx1AqapO_07yBlzUM_-Lx39Gj-ohPYgF6bWtTz3QA&oe=6A2192A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XT5JAkL4o60Q7kNvwFgF8_T&_nc_oc=AdpOdk-spWYZls3lSBVWex4y047XkZaFmgsSf8szq2o7V_8PziSIa88OTScnYAor6L0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D1Al69-4NoV1wqrN7alqU5UvyXoVP1h2zvYgxxtm3lw&oe=6A2179F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLsbVyKhfowQ7kNvwGKhj8Y&_nc_oc=AdrwC8h6g00j6WieSiR3xCqEdpYh80WjBxudmFcVZpSrkkf6cxiXkjftbgFCmJ_EmZo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8rJkw5BcYypjeYXSu8mHZWHYOe8YmXXB5FqA1aR1pg9w&oe=6A21842E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "
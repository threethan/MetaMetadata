ad3-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol7JkTwszC0Q7kNvwEkHSCl&_nc_oc=AdpPYEXwF1JHxyrz4x8TQw2WCMJl3n6BeRjMgUNM3CB0-e5HAbi2PrcCTNdzV2MQnEs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEjNXmF90dbWr2UMF4oOPJvnSr6-tARgxFu3baMzyN_g&oe=6B047AF6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuEWRG3OYl0Q7kNvwF0hLVd&_nc_oc=Adqp7Eb8k2BHsdZYcZ64adjZAh_wMcPhgWYWoyX8pqYwApySVT8vh8rmBptMQHk1hCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUskafaktsdgycc4YQFlHM2U1avs5wKCmBUoQ3N8jmNQ&oe=6B047AA9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftXktxJqcuIQ7kNvwHK-xoB&_nc_oc=Adq1JAomnaWZ6fVwu7dQy1bGyYsERZycHusYgUqcCSX_nOs4gDQfLsMrUEdFkKMc52o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkwIHGUN7qZRjB1cF4MlXuGmSSUISKv7oxYiUkgYVG3w&oe=6B0454A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OILcMBiBqQUQ7kNvwFiLKQT&_nc_oc=AdoklhoVGjsODTJK8b9DSVh596L4D2BYtdPm7X1nOf8EzmumyGOLi-C_lvtxW7SmZlc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQiqm5va2-uNq-bCY798D7XY199voGGNMvgZfe2gAsDg&oe=6B047432"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrT0PAZadMYQ7kNvwHv1rS-&_nc_oc=AdrKCmLG1ox7iGhGBpvum-E9lni88e-w7Z9QA4nV5xs9kMJgY25VOM8zqMVBAazIBNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmmQHl1NrAClQXCzbYHqPSj4D2hMgIQ9lXTd5ZK0mXYg&oe=6B047E6E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": nul
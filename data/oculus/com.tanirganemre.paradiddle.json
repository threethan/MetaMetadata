jc3-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol7JkTwszC0Q7kNvwFPyx74&_nc_oc=AdqxysfBuPKYtBTwTBHGqCG0VElHZrk0u2fXsviVpoz6q4t-jaS8eTgZjmKEOCMxx0s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlsNOHZu54AvhQBTiFW8KRag8fa3BmaPMAfoxcPvfUyQ&oe=6B032976"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W55gJZrthgQ7kNvwE97PR8&_nc_oc=AdrFgf4aOW8r9Z57A159-KPK2KDFovMeT8pzUbInLyuMDw8Bf8C3urZmj5Gia-hKZYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS--zMWXCt8SKWhjtY5lFJemKFbWbRST0OxubOqzHjRwA&oe=6B032929"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftXktxJqcuIQ7kNvwHf8leg&_nc_oc=AdplC4yPmc8DAmEuKYh58Sz-JA0y3k3sHQq95JVaMahPAMkwD78f1pxQIsRID3yDvfY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOH8tEC6Qmpcuh3HKLQGktcbXOFVBJUi6339Hz8qBTFg&oe=6B030322"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEu5kpDksusQ7kNvwGvZeko&_nc_oc=Adrl9LDPDpOXtYttTHQCYBjsPmGDsHJUAYcE-rxN--LwPGUVgCl5w9280Tm_DvaX2u4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRazF0HVcoz6UgU5uCN3co_Oz84xSqIxUCtqruSj6mhvA&oe=6B0322B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrT0PAZadMYQ7kNvwGcnjwi&_nc_oc=AdptrwRe2QxbhtGITS5V4saW1GP7Bbih-4f-sYbethozQ_ocr14PNwXMFc957bkaB1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEMyJWl9GsSekaPn6B46t4Cal-KRUazYkQaVX3q73MBA&oe=6B032CEE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": nul
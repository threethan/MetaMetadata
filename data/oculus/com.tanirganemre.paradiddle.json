6656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CePmhhWSEeEQ7kNvwGPheUa&_nc_oc=Adn2aaTV1v22DPFwNftmvwrwjvb6s6z7M2kGQ4HtIVZczu-hxAvmB-60L48PI2utVd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftm7UPb7ET_4QNnUShXz6atrHKmGo4X9uidrnlUiUMQfw&oe=699C5936"}, {"file_name": "pd-screen-2.png", "id": "2332569856899945", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974820_2332569860233278_8835659424562109361_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3vBevt_RTcQ7kNvwGXjJk5&_nc_oc=Adn2xHW5qnbp4S5tEYHtmqqeqwQtRlnv_ONtXD4jJMEAFZhPuAjl0FpU159zktks4g8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuqaiQBqW7h2Ns1t2Gxju7ZVo6uGvYbbD2BI_MD_DmaJg&oe=699C30B6"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yl8Cv1x1ASIQ7kNvwEYeQA9&_nc_oc=Adn3O4swmanedvOL7hPQlpk9XnykAfVI-25Zb0m-Rz9E_zd9S3h5uyOqOmkL8Rx9JJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvHV-hPT_w4orFn2BUfUMD_TVZbNU6thiahd7mJWLJVNA&oe=699C32E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmnpU1YJZLsQ7kNvwHUNNX9&_nc_oc=Adlq9Alt-m1T_ebCsacLaSfXqulw_ISBFsrlZEBeJ_FwUG9s2R0udUbsuj95oGV3PEY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvTSTijaOjhPdRM-jMGTF5g1u13QbkDlhZvnOAaLNU81Q&oe=699C5CAE"}, "display_name": "Paradiddle", "keywords": ["drum", "beat", "music", "piano", "instrument"], "long_description": "So much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!\n\nKey Features:\n- Flex your skills in the built-in rhythm game mode: adjustable difficulty for 30 different songs, plus custom song support and cross-platform leaderboards.\n- Create your custom drum kit from a library of 60+ percussive instruments, from mallet instruments like the xylophone and steel drum, to auxiliary percussion such as bongos, tambourines and timpanis.\n- Pick up the basics with 10 beginner-friendly lessons, perfect for drumming newcomers.\n- Use the new multiplayer mode to perform for your friends in free play, or compete to get the high score playing the built-in songs.\n- MR passthrough support empowers you to play virtual drums in the real world. You can even connect and augment your physical kit with the rhythm game mode and lessons.\n- MIDI input/output support provides a powerful tool for composers, and also lets you augment your own electronic drum kit.\n- Set the mood with 4 different environments: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nSo much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context
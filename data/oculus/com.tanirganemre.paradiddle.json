ea5-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDwkNkqVcT4Q7kNvwF2pgeo&_nc_oc=Ado3-Gm3FaaZyD4cmLMFS5wnUgPH9fIuJFPVCWUUNhku6IEwzQ1LLtZeMvBFiGqjFYM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5rQXmTXObvvnOHHWAnpRnwPgKcVww3yloyXhIfYvphg&oe=6AFC91F6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuiQ2Rw-wsAQ7kNvwFLTZ-t&_nc_oc=AdoBXcaaKhK4wsZK-1d8z8xyN1nF8VBN13shkDTxvTom9Yty0bHonRtw6Hd74jFj9PI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrm-QzAyt93sQVaslar3luv_Zu0RPsNlSS53rGHcFszg&oe=6AFC91A9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7E8y8K8vIoQ7kNvwHf5KA5&_nc_oc=AdrWC9Dcj18Pd4HbRbeQxs8AW20yH9XLHclLNR7NkgAHlyZy7gsyUueZWMR9-GKrjUA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRcKGhrKwmgW0Nqtvp2Iw5bAhrIGnzCLvRHw0f9K1f7A&oe=6AFC6BA2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LspaHokUDUQ7kNvwHdwGGz&_nc_oc=AdrozFWJNGGiMM3v6X3ueQsWVLRRTywr1hZDHHPjaRS-GtOWsgPEl3BZFuMwdKbgT0M&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWl_3AVPiOvVz_lyzwafuqFGeXQMpl1gxzFswwV6_hzw&oe=6AFC8B32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9dkbxalyLlgQ7kNvwHsNQYr&_nc_oc=AdpwpzSogY6P7ESrXofFsy3ldH8xyyB46alI19_dpwpFVj0LCQt_CJ2A4abG-SAly5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyn6uRUqq2dPOiYJbmRjvE6TuuBWVzM6ron77VGHP2Qw&oe=6AFC5D2E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": nul
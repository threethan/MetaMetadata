ea5-1.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvRn3g8xtfIQ7kNvwFQ1V3K&_nc_oc=Adoe2MuD-A1z7rg1ofog2MznpyQRAN7qtt0KF98yfKy_HrUfnO0mfZKTBhDUgKOHdXc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeTkm2lmJkvoupG9mXBf3IuVj1sa-eFw1d2fKAztKefw&oe=6B09C0F6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwmRq8Re4LsQ7kNvwHAObdS&_nc_oc=AdpFUbdJnUSle_ifV-dmm01dQZdjzSv54VK58cMDqP4aICb2pnOaAF04-DzhWF3jm6M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXP7EaOZmlBzON7g9paN-KDuDMtrmSim2zPMyHDi6A2Q&oe=6B09C0A9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJvrrNyGlbcQ7kNvwEi4AYO&_nc_oc=AdpCX_FoS8xEowUE0JsF8y9GKDZbhibz4ARg6Gj8RS0smCPlJE56p7hIL2031l1K1lc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTuzNwZolUhpPcZodLrDokutf3rHW_tE3g8vzxI9Qg7A&oe=6B09D2E2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8naw59qnaf4Q7kNvwE1iGcj&_nc_oc=AdqgNh4mAUH_xuQO0s0lFFlKNKSqLzFe465hknD8DfoDGjO2U72FqOLndXRXqZeKOFo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrANpmt7BhSspMxzMI-giYwRl7UIOqYoWh5a9WxzZiuA&oe=6B09BA32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAKCFzy7zJkQ7kNvwG2lIfQ&_nc_oc=AdplRFaEVq5KY2WsCG0B9MLZaGwoyDSj1yXyHhgEFKDdRTI8CyMXNHGf4gX1riLqALE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbFF5sNaA_zYj1_2JKSXJrE7Bjk_HdsRgGA-LG6AsFiw&oe=6B09C46E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": nul
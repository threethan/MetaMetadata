89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjbttV0uFdAQ7kNvwEwS94s&_nc_oc=AdqPLWftQPPclvi9jliAinyeBTf0TbIz4UwKa-_Hv8YRlx8MxgrNQLFSDQkaCj3zeQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwg1gAS_cTMwmjgGKHR5BEQ7D9p3v5_zo8l93xbYhtbjw&oe=69CE7236"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGE7Z6l7qFYQ7kNvwE23Oyj&_nc_oc=AdoM32rSVH3PZdSZaUnk5ABGhc0o2lGfRNw97NgaOBmbv6XxdBJZ_itPw4ZPLpzmlWw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWPHrfbzpKqejML6_InBucGHhQovqWtqfYy-d2Pjxm3A&oe=69CE71E9"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf3j-oOfCfYQ7kNvwGlsryC&_nc_oc=AdoKmvxvR44qtl3L67xB0unZVVRn3F3nCsvbqcwKOeHwjdI5Wprh_6MAJGvG5wIQQhM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAGf-j9cMf2uvUJCEgugWaaKJqiKUpM2u71oOoj6yZ4w&oe=69CE4BE2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TUEz7-a8I2EQ7kNvwGM1JDf&_nc_oc=AdoV9jEa_6FfVD0BIW_z_nYEaStbolZEbS2ahuK19hnvlyt9Bt1XRRJQzpvSfaKpgrk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmcryvhNYpKIztkIrgNNP6ktf-z6U1djeHfEYjfUTVfQ&oe=69CE6B72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_JEb4I15lAQ7kNvwGN19Dn&_nc_oc=AdrX6yFWG6nhTiJy1aOlYXPlP1xjO67RE_AqMA6gvY_Zcb9pzOTGUdEKPl9cvplaJ2c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3-OyREm7nQFZmkehj44UVRLNsVdfJ9PiFQ7mVzSN2Bg&oe=69CE75AE"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
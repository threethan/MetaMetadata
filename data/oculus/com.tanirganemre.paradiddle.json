", "id": "1148192932456664", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974625_1148192935789997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7DjVMLgsfiMQ7kNvwGpM1Uw&_nc_oc=Adrw3RRuBpX7jdD9-gSKmb3Zhy5wP0MlJSasDBhrYY80qpfMzvunbSavrNvJqAktKPU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SWErINIcV1-ZyM_NayCGWxNfMMy4yye_Ks38sr8WkKQ&oe=6A130036"}, {"file_name": "pd-screen-2.png", "id": "2332569856899945", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974820_2332569860233278_8835659424562109361_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlmRnijPmskQ7kNvwFf955m&_nc_oc=AdoOCqb9oS-GCDECA5oRbMvFskZosnnazCoC4Zv6OL0lRQRFPlVLV4j3kbVf11Bv5Ck&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vK6YcuFTEMmoLPMKMelLhTGbgP5QxLhgFNjDhKObskQ&oe=6A130FF6"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJPQWEO7FVcQ7kNvwE3Trwi&_nc_oc=AdqN2qYmwItEpX7-_3DSpOPdy4I_-ZGPPA0jOdQISB1lueJgV6YFUKPDnjzeR8W1XZc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yqLUJWD4T7jRJr0rGLs7rYL8tdsIjzRm3RudhjOx-oQ&oe=6A131222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i8ijjQGbRUQ7kNvwFVmc1a&_nc_oc=AdpFsyRvkujrBSdqIAsortWjJUAYBI9etQXx6xvJDIKAaJd9Y1TAL0bRCHAqgQ1hKrA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qgmfrQPqPAS4QhEdvoou9zgebC9blkBH7j7tISuWvsg&oe=6A1303AE"}, "display_name": "Paradiddle", "keywords": ["drum", "beat", "music", "piano", "instrument"], "long_description": "So much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!\n\nKey Features:\n- Flex your skills in the built-in rhythm game mode: adjustable difficulty for 30 different songs, plus custom song support and cross-platform leaderboards.\n- Create your custom drum kit from a library of 60+ percussive instruments, from mallet instruments like the xylophone and steel drum, to auxiliary percussion such as bongos, tambourines and timpanis.\n- Pick up the basics with 10 beginner-friendly lessons, perfect for drumming newcomers.\n- Use the new multiplayer mode to perform for your friends in free play, or compete to get the high score playing the built-in songs.\n- MR passthrough support empowers you to play virtual drums in the real world. You can even connect and augment your physical kit with the rhythm game mode and lessons.\n- MIDI input/output support provides a powerful tool for composers, and also lets you augment your own electronic drum kit.\n- Set the mood with 4 different environments: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nSo much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MUSIC", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7056409527730786"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982551_221613090771607_8620078170120975747_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruPsILlQosEQ7kNvwHFmdVW&_nc_oc=Adota5N2ae5bM8W5h-nWolPi4icJi4NJq4w__Fcra07DicyuZlxe1OtFM1T0cknxc_k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Hb0qzMyRnNZykchuHomEYjwZ93U2Hac6tnNipnUB96w&oe=6A12F5A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Paradiddle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1700157600, "lastRevision": {"nodes": [{"id": "5719805458057873", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5719805344724551", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "798253584109839"}, "iarc_email": null, "msrp": null, "translations": {"nodes
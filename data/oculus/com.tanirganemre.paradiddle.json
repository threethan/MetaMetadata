oZH7Ca13gymmpw_f3qeJ6oOYn2Pi2YRA&oe=6AFDE376"}, {"file_name": "pd-screen-2.png", "id": "2332569856899945", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974820_2332569860233278_8835659424562109361_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0ijDu7TCHQQ7kNvwH_MJRE&_nc_oc=AdpDgh0QFmSJ_GCLi5j6KMWZZsXvYrkhs3NETVUxOq02QXy3f97sug8BDduOlV6XDNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFYZUtHIoBbVweDJ36VCKiYST3jCqAldQ4vXke4Uvm1A&oe=6AFDBAF6"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhFmyN5hIRMQ7kNvwGrqqxR&_nc_oc=AdqGGmr0SAfkx2lPJpv2sGV2-zS6tkMaRmKIK40c762KjhyA8Y-hvzBc-gzdgVAIwBg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6zbM4Lz6XiAXmQNsbfmOXVZQFrNoeMm8S6GMXwJvOdA&oe=6AFDBD22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZnYT5z1bBoQ7kNvwGD2rfB&_nc_oc=Adp9qyqm2RiwAm8vc_AP7XBh2kTVvnPOKcyHbwK1thjCfl8O-JuUtNG42t4SAKR3wBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0YJ91xSTE79BgG114NBGptigtoKA4egV1iKEbk6EnXQ&oe=6AFDAEAE"}, "display_name": "Paradiddle", "keywords": ["drum", "beat", "music", "piano", "instrument"], "long_description": "So much more than a VR drum kit. Learn to drum with **step by step lessons**, flex your skills with the **built-in rhythm game**, and build your own custom kit from a library of **60+ percussive instruments** without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!\n\n# Key Features:\n- Flex your skills in the built-in rhythm game mode: adjustable difficulty for **30 different songs, plus custom song support and cross-platform leaderboards**.\n- Create your custom drum kit from a library of **60+ percussive instruments**, from mallet instruments like the xylophone and steel drum, to auxiliary percussion such as bongos, tambourines and timpanis.\n- Pick up the basics with 10 beginner-friendly lessons, perfect for drumming newcomers.\n- Use the new multiplayer mode to perform for your friends in free play, or compete to get the high score playing the built-in songs.\n- MR passthrough support empowers you to play virtual drums in the real world. You can even connect and augment your physical kit with the rhythm game mode and lessons.\n- MIDI input/output support provides a powerful tool for composers, and also lets you augment your own electronic drum kit.\n- Set the mood with 4 different environments: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nSo much more than a VR drum kit. Learn to drum with step by step lessons, flex your skills with the built-in rhythm game, and build your own custom kit from a library of 60+ percussive instruments without the limitations of money or physical space. Fun, intuitive drumming for pros and newcomers alike!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "331529188132278"}, {"id": "1990104051447093"}
89997_1416656799652225989_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOq_M9B69_AQ7kNvwFtBgWf&_nc_oc=AdpEl3JQCiRf9PScWHsZXyzuBaEWmNe1xA8U8aJX_-T1tdo-Rkx_5OQYfMwnz0mnCiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3iamhpHk22o6g4GQmjV615Rt6WmrlOSRqJQC1mkemAWQ&oe=69D266B6"}, {"file_name": "pd-screen-4.png", "id": "452755380055036", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223479_452755383388369_7916189931699766309_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyAV4n2rMEoQ7kNvwFq4OwA&_nc_oc=Adqf80TG4CHfHAbgxg5GWvA3H9_elCkL7yVMP_guK65xSQ0sr1FiZJ2DUvscMOITb0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hVYZ2ExZs7gWZUgiS2sSVCK8oFSx5uIeet3xHOuLqzw&oe=69D26669"}, {"file_name": "pd-screen-5.png", "id": "430728135872291", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_430728139205624_5946641524650245644_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGrXqpJpwfgQ7kNvwEWjx3_&_nc_oc=AdouAYRPkuY3Xg2wYzasDWEfaHmy3BSo3m0olXzQGhjovSxqQx4pD25Ot-h9ZLaVXEM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36B4yKS6e_fn1dLEovowmjTDnlC4TX9ENid8TUi2jOcg&oe=69D278A2"}, {"file_name": "pd-screen-3.png", "id": "1062325254420235", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75593950_1062325261086901_104825397019691373_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79AHnyVb2e0Q7kNvwGTR5Tl&_nc_oc=AdoGAH7-_KY3BpKTkYFwWGbiK-IosvYIivhPuU_lg-trt5QQPTAMu_vlJdgMv5IebRA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JOeI3y-dXFKxnaJ38Srd7RdV42zQ3LHwzl_f9nCk-lw&oe=69D25FF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoscreen.png", "id": "986130542781323", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_986130546114656_4585000279316381076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lG72vomx6kgQ7kNvwEtNXLT&_nc_oc=AdobpkSW4Osy5Ml72kplzWZkWeR_5129T7XxiOBDRl7q3CZuGyy5oS3hlVmZJOjH5yY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Un93NeF2Qjb0U9p2zwKTV4NThnuAoGuqRDBS5Pr1yXA&oe=69D26A2E"}, "display_name": "Paradiddle", "keywords": [], "long_description": "Play drums without the limitations of the real world. Paradiddle lets you play 50+ realistic percussion instruments without worrying about making noise, buying expensive equipment or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum.\n\nKey Features:\n- Rhythm game mode with custom song support and cross-platform leaderboards.\n- 50+ realistic percussion instruments including 5 full drum kits, mallet instruments like the xylophone, marimba and glockenspiel, and auxiliary percussion such as bongos, tambourines and timpanis.\n- 10 beginner-friendly lessons that take you through drumming basics.\n- 4 different environments to play in: Dojo, Jazz Club, Galaxy, Void.\n- USB and Bluetooth pedal support for kick and hi-hat.\n- Passthrough AR support to play in the real world along other musicians.\n- Load your own songs, audio files and sheet music.\n- Easily save/load different kits and record your jam sessions.", "short_description": "Play drums without the limitations of the real world.\n\nParadiddle lets you play 50+ realistic and responsive percussion instruments without worrying about making noise, buying expensive equipment, or needing physical space. With our built-in rhythm game mode and lineup of lessons, it's easier and more fun than ever to learn how to drum. The app even supports a variety of pedals and peripherals for those looking to bring their VR drumming journey to the next level."}]}, "developer_name": null, "developer_privacy_policy_url": "http://paradiddleapp.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Emre Tanirgan", "support_website_url": "http://paradiddleapp.com/faq", "website_url": "http://paradiddleapp.com/", "category": "APPS", "comfort_rating": "NOT_RATE
dn.com&_nc_ss=7f20f&oh=00_Af9riXEcZ8QYdtY-4Gp5N5wHPMvr5MYIpVW4P1-eElYyaw&oe=6A2AD01E"}, {"file_name": "TMNT_EmpireCity_ChinaTown_003_2.png", "id": "693846646520198", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820428_693846649853531_3748226772960385019_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPNY1eqqf4kQ7kNvwFavg4C&_nc_oc=Adqfaz-m0RwaFNhywFvnRpZwCBARND4iq2YMJSs1e9v836gEebEYgWuIP-2DH3xXwxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SGJjjxhmktyUi-aGwWnCDEhBi5whumatjetBwJRY80Q&oe=6A2AAE6E"}, {"file_name": "TMNT_EmpireCity_Lair_003_2.png", "id": "23892151927048464", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499332525_23892151950381795_1762320846501349893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoQAOAi8Xg8Q7kNvwH7hW6j&_nc_oc=AdrQpE4f5Ty_G_XTL1x5UrtmlXOhykKtZmt2lVVgdaMFZh4dq1utvrZzifpWTSb6uAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87qRQaEb28LYoH0m9ikWY7Hee7oPqJx3Wzc4qFPn8jyQ&oe=6A2AD895"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMNT_EC_Landscape.png", "id": "1442615280498336", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499324069_1442615283831669_4624897208427698398_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boOAniq8oVMQ7kNvwEM9KpB&_nc_oc=AdoNFcUacYP4Vul0f76E_v9A7cKAJfYk0IAgMCcorLtS9t4BkDeRal37IIqbUM_uxr4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8McKEo4kZnYdHXzCo0VjsldNEkhwDS38o1wmR_dtDtWg&oe=6A2ADB9E"}, "display_name": "Teenage Mutant Ninja Turtles Empire City", "keywords": ["TMNT", "Ninja", "Parkour", "NY", "Tag"], "long_description": "A brotherhood in the shadows. A city on the brink.\n\nIn the vacuum left by Shredder's demise, the Foot Clan's grip tightens on the streets you once called home. It\u2019s time to reclaim what's yours. Don the mask of Leonardo, Raphael, Donatello, or Michelangelo in the first ever Teenage Mutant Ninja Turtles VR game.\n\n- \u2694\ufe0f Master each Turtle's signature weapon with precision strikes and blocks in this first-person action adventure.\n- \ud83c\udf07  Scale urban landscapes with fluid parkour \n- \ud83e\udd8f  Confront fan-favorite villains\n- \ud83d\udc22  Forge your own chapter in the TMNT legacy solo or together with friends in four player co-op\n\nFamily is forever. Find yours in 2026.", "short_description": "A brotherhood in the shadows. A city on the brink.\n\nIn the vacuum left by Shredder's demise, the Foot Clan's grip tightens on the streets you once called home. It\u2019s time to reclaim what's yours. Don the mask of Leonardo, Raphael, Donatello, or Michelangelo in the first-ever Teenage Mutant Ninja Turtles VR game."}]}, "developer_name": "Cortopia Studios", "developer_privacy_policy_url": "https://beyondframes.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Beyond Frames Entertainment", "support_website_url": null, "website_url": "http://www.cortopia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "6635073606583255"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1459480115659708"}, {"status": "PUBLISHED", "id": "1583698769781732"}, {"status": "PUBLISHED", "id": "1911295249514639"}, {"status": "PUBLISHED", "id": "1289429826480263"}, {"status": "PUBLISHED",
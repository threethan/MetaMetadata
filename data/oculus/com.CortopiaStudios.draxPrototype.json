dn.com&_nc_ss=7f20f&oh=00_Af8j9Plsu8dYWn8mKnI6A0W5OnVqsoOQll6t4vLwakFYBA&oe=6A2C219E"}, {"file_name": "TMNT_EmpireCity_ChinaTown_003_2.png", "id": "693846646520198", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820428_693846649853531_3748226772960385019_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPNY1eqqf4kQ7kNvwEWo8kr&_nc_oc=Adon4XIhaaWu_1WGL8XXWCljCfqzA7WdJTs5zueYtMD_ejodhhN8gvB5D729BipxsAw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zwHQbhKDfnTRiNrlLtkZqj5Vte6yQT6zqEaCDqggicw&oe=6A2BFFEE"}, {"file_name": "TMNT_EmpireCity_Lair_003_2.png", "id": "23892151927048464", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499332525_23892151950381795_1762320846501349893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoQAOAi8Xg8Q7kNvwEmRmvb&_nc_oc=Adq5GhezYUtgx3AeOYdlHFnTD5YSCFQd8Bu0RvjgWhVREsf36l-U2pqVr5XIXQJjwMY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xyL7V8pZ8ezU_G3XDfQdOnOaip3q8ywRttc9nM6r0wQ&oe=6A2C2A15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMNT_EC_Landscape.png", "id": "1442615280498336", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499324069_1442615283831669_4624897208427698398_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boOAniq8oVMQ7kNvwHMSiTF&_nc_oc=AdoHDM3T2uhROvcUyg3WaAO_JxBiQPpyPknSIPDZCA7bDvFY1_KTOPfP05M1Nb-3x3c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_G-NB-JGaHErk2YJHx4iCPhhDMV-EWiAIn2GqpnR6Icw&oe=6A2C2D1E"}, "display_name": "Teenage Mutant Ninja Turtles Empire City", "keywords": ["TMNT", "Ninja", "Parkour", "NY", "Tag"], "long_description": "A brotherhood in the shadows. A city on the brink.\n\nIn the vacuum left by Shredder's demise, the Foot Clan's grip tightens on the streets you once called home. It\u2019s time to reclaim what's yours. Don the mask of Leonardo, Raphael, Donatello, or Michelangelo in the first ever Teenage Mutant Ninja Turtles VR game.\n\n- \u2694\ufe0f Master each Turtle's signature weapon with precision strikes and blocks in this first-person action adventure.\n- \ud83c\udf07  Scale urban landscapes with fluid parkour \n- \ud83e\udd8f  Confront fan-favorite villains\n- \ud83d\udc22  Forge your own chapter in the TMNT legacy solo or together with friends in four player co-op\n\nFamily is forever. Find yours in 2026.", "short_description": "A brotherhood in the shadows. A city on the brink.\n\nIn the vacuum left by Shredder's demise, the Foot Clan's grip tightens on the streets you once called home. It\u2019s time to reclaim what's yours. Don the mask of Leonardo, Raphael, Donatello, or Michelangelo in the first-ever Teenage Mutant Ninja Turtles VR game."}]}, "developer_name": "Cortopia Studios", "developer_privacy_policy_url": "https://beyondframes.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Beyond Frames Entertainment", "support_website_url": null, "website_url": "http://www.cortopia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "6635073606583255"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1459480115659708"}, {"status": "PUBLISHED", "id": "1583698769781732"}, {"status": "PUBLISHED", "id": "1911295249514639"}, {"status": "PUBLISHED", "id": "1289429826480263"}, {"status": "PUBLISHED",
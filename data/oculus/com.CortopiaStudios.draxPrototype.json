dn.com&_nc_ss=7f20f&oh=00_Af8O3JVd-gh79Lmb0qROXsCjTGV-ujcVfDUxDwgswFlJnA&oe=6A2D731E"}, {"file_name": "TMNT_EmpireCity_ChinaTown_003_2.png", "id": "693846646520198", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820428_693846649853531_3748226772960385019_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6O1T8r0gpQQ7kNvwGwJuU_&_nc_oc=AdqVQT-UMBZe7JgdT6iooDufQwEv8Y5Pd3cn-JZPlrTHQ22e70dXDksWr6VGPlcH5wQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MfYZ2x6_GpcQmb3IhABRFE1aBPk5mlYGoZI75i--RGA&oe=6A2D516E"}, {"file_name": "TMNT_EmpireCity_Lair_003_2.png", "id": "23892151927048464", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499332525_23892151950381795_1762320846501349893_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoQAOAi8Xg8Q7kNvwG6Mj6w&_nc_oc=AdrZGTkmXQ04BUfL7UW94XdIPyxwFTvaqQBWJiK7AkAyLIHVQNTttna9xv6xKbhbWpU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tOGvCfLFzFZm_8KEFmoniBf3qq4iNCuDgLdBOPWmKcg&oe=6A2D7B95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TMNT_EC_Landscape.png", "id": "1442615280498336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499324069_1442615283831669_4624897208427698398_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ux99VGvnsTAQ7kNvwFbH7UW&_nc_oc=AdrtMIr7-ia-YSnsDjPti9fgA-qoxLoertPaeMOX9J64DTM9o5iZEbva6jR0dP_iNW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DVsD8dJmaFwliWyYnMiN4LNkuHyoGFMhSyv0Ku5bF0A&oe=6A2D465E"}, "display_name": "Teenage Mutant Ninja Turtles Empire City", "keywords": ["TMNT", "Ninja", "Parkour", "NY", "Tag"], "long_description": "A brotherhood in the shadows. A city on the brink.\n\nIn the vacuum left by Shredder's demise, the Foot Clan's grip tightens on the streets you once called home. It\u2019s time to reclaim what's yours. Don the mask of Leonardo, Raphael, Donatello, or Michelangelo in the first ever Teenage Mutant Ninja Turtles VR game.\n\n- \u2694\ufe0f Master each Turtle's signature weapon with precision strikes and blocks in this first-person action adventure.\n- \ud83c\udf07  Scale urban landscapes with fluid parkour \n- \ud83e\udd8f  Confront fan-favorite villains\n- \ud83d\udc22  Forge your own chapter in the TMNT legacy solo or together with friends in four player co-op\n\nFamily is forever. Find yours in 2026.", "short_description": "A brotherhood in the shadows. A city on the brink.\n\nIn the vacuum left by Shredder's demise, the Foot Clan's grip tightens on the streets you once called home. It\u2019s time to reclaim what's yours. Don the mask of Leonardo, Raphael, Donatello, or Michelangelo in the first-ever Teenage Mutant Ninja Turtles VR game."}]}, "developer_name": "Cortopia Studios", "developer_privacy_policy_url": "https://beyondframes.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Beyond Frames Entertainment", "support_website_url": null, "website_url": "http://www.cortopia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "6635073606583255"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1911295249514639"}, {"status": "PUBLISHED", "id": "1289429826480263"}, {"status": "PUBLISHED", "id": "2096875241161686"}, {"status": "PUBLISHED", "id": "916075947523845"}, {"status": "PUBLISHED", 
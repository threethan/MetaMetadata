game masters (GMs) guide these stories within the expansive VR environment.\n\nWe are in early access. Join our Discord community to find roleplayers and game masters to join you in Aexia: https://discord.gg/STsWt7BXFV\n\nHere's a quickstart guide on how to create and share a game with a friend: https://youtu.be/Ho0gELmwkRU?si=PZ6JvUA8oogao1-c", "short_description": "Aexia is a platform for creating, sharing and playing VR role-playing games. With Aexia, players can role-play as actual actors in a movie set.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.strawberryfields.ca/privacy-policy-1", "developer_terms_of_service_url": null, "publisher_name": "Strawberry Fields Interactive", "support_website_url": null, "website_url": "https://aexia.ca/", "category": "APPS", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["RPG", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7193653440735131"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031548_1288235358803715_1413832392222694160_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjwM07IkN00Q7kNvwFrX1It&_nc_oc=Adm0B1HIlGrD0YJyr5JnWsm1YGR0q6JYThvqiWtIEtuDe6uF_ivID5FMb6VJHNgh9GY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwbHoUSCjRjUSoe1UZ5wFVti88LhMC74MM1v8c9LpuWqA&oe=69B401CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fals
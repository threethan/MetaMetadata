-sin2-1.oculuscdn.com/v/t64.5771-25/38974767_1026921195059293_3246354183015041667_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duf63Bg_QTwQ7kNvwEzPctv&_nc_oc=Adqekx_EfoLHed5o8HZbNG2dqfV1vYKSMatWJMsnPkO3E6eeKzoYlOzlZwLRBPKih2A&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMq0E15L4a5bgQgnv797IsI1ixPLQpPatQ6BrkrOkX_A&oe=6A7DA0AD"}, {"file_name": "2023-7-11 15_09_20.png", "id": "747039833475878", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39036630_747039836809211_6263092530982373292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iik_8-zJGvoQ7kNvwH626Rc&_nc_oc=AdpQeIGP3ixB_NYSLrc4BV-5v5HCLJwy2mHtQQXsHCTfNhRkOmXaaDx8SjjLdhPj6lk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHUW1mnP82l_s-qhuhD2Kq3fx_VRTaaZKwZUYcplPv5w&oe=6A7DAD97"}, {"file_name": "2023-12-30 18_32_05.png", "id": "1769304386869593", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974691_1769304390202926_4857717662441570091_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb1gI8RU-s0Q7kNvwG-M933&_nc_oc=Adrbg1Ih3PQZjquKjQBR3AoPZtGdaC6NqSbUX8GK63ByNvXO2vlCvRnIVVpcU5BrsrM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHL6NQITS609DUmPbgyPXnFW9DEZUKpOgS1dg6GNt32w&oe=6A7DB90F"}, {"file_name": "2023-12-30 18_41_45.png", "id": "1078950889907975", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974688_1078950893241308_1374981864668893190_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DF2_ZYllvPgQ7kNvwHNJnzI&_nc_oc=AdoZ-im5624cfgakiSjJzcG-LP1Ri3w2kRgnnh-TL1iHwrSoq2hlWfklylqRDLUHpqk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN4BQoyp8oxYLxuwHT0RUEbQwwgUfbmE4pBpXQ9bq9WA&oe=6A7DADF0"}, {"file_name": "passthrough.png", "id": "910258337370743", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982510_910258340704076_8779057242099034012_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPRziQVesP4Q7kNvwGSnOzB&_nc_oc=Adr8NiLfKImJFPVxFmhrz9365GISrFdoYYfs4rsbnuzMNmFe8692uDuJkl5FzBkkvQg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeQbNceMoPREaPk8uwXihXaufaL43R3w2pZI7GvVEW5Q&oe=6A7D9A01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762.png", "id": "745951794088262", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/43997711_745951797421595_3871520485959633568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5zKQUa8MxIQ7kNvwECm9nT&_nc_oc=Adof3Idf5RcWB6Vlu9GEjNPCMqx6u5gPB9eLsKFEqntA-dSVV1mUJZFhCmabnWhCzjE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxx5thFVleEPio62bhmUfBnuEmAzamSe70TgqoMc6kDA&oe=6A7DAC03"}, "display_name": "Wooden Fish Zen", "keywords": [], "long_description": "The wooden fish, a venerable and mystical wood instrument originating in East Asia, is frequently employed by Buddhist clergy for recitation and ceremonies. \n\"Wooden Fish Zen\" is an application that allows you to experience knocking wooden fish in virtual reality, with real physical interaction effects. You can choose to use mixed reality mode to place the wooden fish on your own table, or choose different atmospheric scenes, such as temple, waterfall, space, rainy day, etc. This app hopes to allow you to have an immersive wooden fish zen experience, put aside distracting thoughts, and gain a feeling of decompression, healing, and concentration.\nVirtues++, troubles--.\nFind a simple and effective way to relax in your busy life, and feel a sense of peace and depth in the rhythm of tapping the wooden fish.", "short_description": "An immersive wooden fish zen experience for stress relief and healing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/wooden-fish-zen-privacy-policy/23e3581f-db88-4230-9aa1-0f39fc92880c/privacy", "developer_terms_of_service_url": null, "publisher_name": "MountainVR Studio", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100023151198467", "category": null, "comfort_ratin
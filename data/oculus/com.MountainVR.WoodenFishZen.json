-sin2-1.oculuscdn.com/v/t64.5771-25/38974767_1026921195059293_3246354183015041667_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ev7UklZLqfEQ7kNvwH3xDn7&_nc_oc=Adplieir-6d2FvddXjl-uxuurYuXtuXgsu9z04Axxx0DOtKOo_UhD7lopgNLqmEiUHQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DI-78ubuME5GDQg4U675sO_bwrzrsovk-YcnDqjrobg&oe=6A11BDED"}, {"file_name": "2023-7-11 15_09_20.png", "id": "747039833475878", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39036630_747039836809211_6263092530982373292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZ39YdKIfekQ7kNvwGLd_8Z&_nc_oc=Adq3ao0e1Sh6FgcQrE4_6jM5FbwcmYTTEUl9Rd5N6Z2BvY1gX1ztnHiTBi9-P8VBQng&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67iCuipnJDrzrLPbNureu0A5YMge4vUqVMb63CLKCgmw&oe=6A11CAD7"}, {"file_name": "2023-12-30 18_32_05.png", "id": "1769304386869593", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974691_1769304390202926_4857717662441570091_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F8bWL8Sfa0YQ7kNvwENUAD4&_nc_oc=AdoXddwgrigFrwNNTTMbcf3YETfQbHptkvLc9lSt5SsF8mDoYWdmJiO8TT5Dt_snnms&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77Mzk6SNDUXg_y18aHhlGxZMXiMdBC_JxVYF5NV4aWGw&oe=6A119E0F"}, {"file_name": "2023-12-30 18_41_45.png", "id": "1078950889907975", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974688_1078950893241308_1374981864668893190_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7tjnoPEOOwQ7kNvwGnjSD5&_nc_oc=AdoO7Fd2D4NJYdXbe3M8auvwuygj1gHR9zOPmHrz_OQ_OpRgHvRgVQoC61eE8UHauhI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kSaQ2peoPw9qVwMrDUwE78l1ST9gfMGM3CrHd90oR-g&oe=6A11CB30"}, {"file_name": "passthrough.png", "id": "910258337370743", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982510_910258340704076_8779057242099034012_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0G7AbnkW6EQ7kNvwEsRD6B&_nc_oc=AdrGP3d-z52yLks187gTrJOtzvrq7X-Pv6K9OmsM5nfNIxZJOoS-3dcCqnzo8mKVIKA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7trQiT20sIxWVFrWnpLZhaAVvezEzqRB7QD1CR1HLXXw&oe=6A11B741"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762.png", "id": "745951794088262", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/43997711_745951797421595_3871520485959633568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6e7HmBiMTMQ7kNvwFCAf3P&_nc_oc=AdoSbGu1GA5Sdueu4gqfoNl6-e7p5Ok36G7py4tJ8_0wx0YyAp1e_5F1DLDU1CYOKi0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JoPEazrC91LdSuprMEZ_k9lQoD6V2ETGilIEWmoEwrA&oe=6A11C943"}, "display_name": "Wooden Fish Zen", "keywords": [], "long_description": "The wooden fish, a venerable and mystical wood instrument originating in East Asia, is frequently employed by Buddhist clergy for recitation and ceremonies. \n\"Wooden Fish Zen\" is an application that allows you to experience knocking wooden fish in virtual reality, with real physical interaction effects. You can choose to use mixed reality mode to place the wooden fish on your own table, or choose different atmospheric scenes, such as temple, waterfall, space, rainy day, etc. This app hopes to allow you to have an immersive wooden fish zen experience, put aside distracting thoughts, and gain a feeling of decompression, healing, and concentration.\nVirtues++, troubles--.\nFind a simple and effective way to relax in your busy life, and feel a sense of peace and depth in the rhythm of tapping the wooden fish.", "short_description": "An immersive wooden fish zen experience for stress relief and healing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/wooden-fish-zen-privacy-policy/23e3581f-db88-4230-9aa1-0f39fc92880c/privacy", "developer_terms_of_service_url": null, "publisher_name": "MountainVR Studio", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100023151198467", "category": null, "comfort_ratin
-sin2-1.oculuscdn.com/v/t64.5771-25/38974767_1026921195059293_3246354183015041667_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=63WxUX4cc-QQ7kNvwFhz9NX&_nc_oc=AdrnrQg6Lns4H7Y7vlEjtFa0XfaZn4iN1Vibu14nfVXr4V0s6bReSzphFBa947ciCCE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vBD0a658BBs6mZ98aOei6I6d6sJ6IvofR9VsvnW7O0Q&oe=6A4679ED"}, {"file_name": "2023-7-11 15_09_20.png", "id": "747039833475878", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39036630_747039836809211_6263092530982373292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zbKv_sH4CoQ7kNvwGoZ7MU&_nc_oc=AdpN4Mx1wyfJflifGAbY0OZBE9AKeILL5b0g16FSBWbNCSQp4x3EGxlkqkl7bWlOZe4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r0I6p-BXCm4cxjGjKTMZrUoNmzo0YOAnqSexeEkLKgQ&oe=6A4686D7"}, {"file_name": "2023-12-30 18_32_05.png", "id": "1769304386869593", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974691_1769304390202926_4857717662441570091_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVq58wxO1qwQ7kNvwG-jKcO&_nc_oc=Adp97S_WrvjJ1yM8LZvgZ-LPWEAJ88KmuhWJQIQ-grQ5gbewLUbALJaLak0gbvDA_aM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HmzihfxrtPwRyJmzqetQrqgY9C_Uh5vLcAO_NcV0pOg&oe=6A465A0F"}, {"file_name": "2023-12-30 18_41_45.png", "id": "1078950889907975", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974688_1078950893241308_1374981864668893190_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9im5XMAkWasQ7kNvwGwwSjl&_nc_oc=AdqTLi5MOF3kt7ikoHFPzpVAMd6Y91Pbqp8AnauZmJcuHarYmiWSWRNflJ4Xp1Z6QeM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91iKMa4kD5nBdc6k0Bt1kBD7XqfUYs-sWAegxYnblWyQ&oe=6A468730"}, {"file_name": "passthrough.png", "id": "910258337370743", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982510_910258340704076_8779057242099034012_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qN6CHqtDCfMQ7kNvwHQC2UH&_nc_oc=AdrlctZQWwhg_cs1G3Qzs3a2nvoFwCyn3o1BP5Ef8qbyu-gB-JjylJZYdaRgcNlINdM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rc111wwl6YyHUb87Fw454VAUqqAyfxw2rUi7HepeV9w&oe=6A467341"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762.png", "id": "745951794088262", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/43997711_745951797421595_3871520485959633568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zq3nOyqY0bcQ7kNvwE7rGem&_nc_oc=AdoqYBljCgIygWVNJN5hiKNwobA6BCoHAqjWNIT3NPqnrIwda2EGzKR15re5mShOJG0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LRxao6DsQ2hpqYcXDe1unmGFcoRpwtC3OwBufmCUFEw&oe=6A468543"}, "display_name": "Wooden Fish Zen", "keywords": [], "long_description": "The wooden fish, a venerable and mystical wood instrument originating in East Asia, is frequently employed by Buddhist clergy for recitation and ceremonies. \n\"Wooden Fish Zen\" is an application that allows you to experience knocking wooden fish in virtual reality, with real physical interaction effects. You can choose to use mixed reality mode to place the wooden fish on your own table, or choose different atmospheric scenes, such as temple, waterfall, space, rainy day, etc. This app hopes to allow you to have an immersive wooden fish zen experience, put aside distracting thoughts, and gain a feeling of decompression, healing, and concentration.\nVirtues++, troubles--.\nFind a simple and effective way to relax in your busy life, and feel a sense of peace and depth in the rhythm of tapping the wooden fish.", "short_description": "An immersive wooden fish zen experience for stress relief and healing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/wooden-fish-zen-privacy-policy/23e3581f-db88-4230-9aa1-0f39fc92880c/privacy", "developer_terms_of_service_url": null, "publisher_name": "MountainVR Studio", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100023151198467", "category": null, "comfort_ratin
-sin2-1.oculuscdn.com/v/t64.5771-25/38974767_1026921195059293_3246354183015041667_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmLPgH8f2wkQ7kNvwEWdmiq&_nc_oc=AdpVQgncttNJTaM9iksgNIgTNyWxFTo0EH3MgZTXi9YrqUTGQZkxg74Cy5BWXzrHzTU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlHNVrtxeOaaBceJ-yaUTLTZE3Wn5t0dcEJW-0ovnJ3g&oe=6AAEA06D"}, {"file_name": "2023-7-11 15_09_20.png", "id": "747039833475878", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39036630_747039836809211_6263092530982373292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUnETaWWEJAQ7kNvwH3fT7b&_nc_oc=AdrF9BZLgr6eCU9aA9LYbXRdBUS_aTFRs0NI7idaMtoEfpqJhLSChhFebeiWSOa2rrw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlrvXNwRY6OPEAMKszz4VxAZt2grJtYiLxdVZycbjaKA&oe=6AAEAD57"}, {"file_name": "2023-12-30 18_32_05.png", "id": "1769304386869593", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974691_1769304390202926_4857717662441570091_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxLxwfEz290Q7kNvwGbborT&_nc_oc=AdpF97uHVWyBBBZzczfnVfLdSUaTN3BeVAa-cu7ZWtV5MQ5cVOkDenh74TDE0TwDY68&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIWdKPG6SKPFO7UFhc3X3cTEYAnl2VqpYhBtjsBC9JCA&oe=6AAE808F"}, {"file_name": "2023-12-30 18_41_45.png", "id": "1078950889907975", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974688_1078950893241308_1374981864668893190_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEpZ7UpYoMAQ7kNvwGKHHzR&_nc_oc=Adr9g0KHx_wKMQPNbpygwtXh0w8qO0bPc_K5i3aO7bi25Pm3HoDlHsYOBKj59EHZCgM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJLXoKZZPdQLMMIAmKhVrKpBYUyDXcbSGBxDvs5XSBLQ&oe=6AAEADB0"}, {"file_name": "passthrough.png", "id": "910258337370743", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982510_910258340704076_8779057242099034012_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBwW3c80gAUQ7kNvwGCkJKH&_nc_oc=AdpGS2KSW4hM4qVtzKODsI5rGh0AnrJ213Q6MQesd5Q-HEpC1oe484DfmNWqGNjnz8U&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcIqWziqNNy7Ml3Gc8k4TZuCam3GRgrbGuTJvhPwkFyQ&oe=6AAE99C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762.png", "id": "745951794088262", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/43997711_745951797421595_3871520485959633568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbjiUdcSxQwQ7kNvwGfWqpa&_nc_oc=AdpAXSvkP0LKAchUnwB0RCd_wdLzrTfYHYDPl8gXQaNAQefjZyhpAeB4a-kro2qnKLI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrfykjdRebE2uPi-IWdRxHqFw7oBvL0ZRzbxVzdJFI6g&oe=6AAEABC3"}, "display_name": "Wooden Fish Zen", "keywords": [], "long_description": "The wooden fish, a venerable and mystical wood instrument originating in East Asia, is frequently employed by Buddhist clergy for recitation and ceremonies. \n\"Wooden Fish Zen\" is an application that allows you to experience knocking wooden fish in virtual reality, with real physical interaction effects. You can choose to use mixed reality mode to place the wooden fish on your own table, or choose different atmospheric scenes, such as temple, waterfall, space, rainy day, etc. This app hopes to allow you to have an immersive wooden fish zen experience, put aside distracting thoughts, and gain a feeling of decompression, healing, and concentration.\nVirtues++, troubles--.\nFind a simple and effective way to relax in your busy life, and feel a sense of peace and depth in the rhythm of tapping the wooden fish.", "short_description": "An immersive wooden fish zen experience for stress relief and healing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/wooden-fish-zen-privacy-policy/23e3581f-db88-4230-9aa1-0f39fc92880c/privacy", "developer_terms_of_service_url": null, "publisher_name": "MountainVR Studio", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100023151198467", "category": null, "comfort_ratin
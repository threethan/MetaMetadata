-sin2-1.oculuscdn.com/v/t64.5771-25/38974767_1026921195059293_3246354183015041667_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcJQpAgrHLMQ7kNvwFLx04z&_nc_oc=AdpEaI0Y_gZNBCgsxffP5yEvsxaEEZWZ-ZwcPWbBmB-Kgq4eV2d8VyILP-leELZ9d_I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6KxXAtdR5a5cpW5muvXwKJ-y9Fn8htNNJjZGDs66lSA&oe=6AA95A6D"}, {"file_name": "2023-7-11 15_09_20.png", "id": "747039833475878", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39036630_747039836809211_6263092530982373292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxtGWUy6Ic8Q7kNvwGLJlc5&_nc_oc=AdqbTgmmwW_wDmRvPvjHq75dfetUiWlypycYvJk6ScChZnwksswkNzWS1EwvkZIGfPM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLElGALGzmY4GUx0D2pcn9ksFO7juWARjF0ca_VXj4nMQ&oe=6AA96757"}, {"file_name": "2023-12-30 18_32_05.png", "id": "1769304386869593", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974691_1769304390202926_4857717662441570091_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckRU7qn7FuAQ7kNvwGGipeP&_nc_oc=Adp4Vl3i2DLjN8cXmplWkTnbrkwh8e-WSR5QENkBzNYjzn8-cypqUQRF4JZLXPQ8O5s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwdrxCU_lEP0ZzHS4WQtubpd0raPKkVoyAr5UC0yzs1Q&oe=6AA93A8F"}, {"file_name": "2023-12-30 18_41_45.png", "id": "1078950889907975", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974688_1078950893241308_1374981864668893190_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVzQOAzCcTsQ7kNvwEgVQHd&_nc_oc=AdoZlM4tU3gBmjryVlOF308cy5HpUSa_rHk46RIjynToDs2I0O6fRIkOnxoxFUHNq0g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMfxrvRaPTZLWbiAzDrfEXlHJX5Bastq3Sdz9c1U2rFw&oe=6AA967B0"}, {"file_name": "passthrough.png", "id": "910258337370743", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982510_910258340704076_8779057242099034012_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vziFnanoUsQ7kNvwEAdvzx&_nc_oc=AdqnhbWY5pOWXqlbEy78HF9AeO4iPJmhd9BwOLexDhN0BXFecc8-MtVSKad_HpmAvWE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVWPEahtMy_zm8H3OlW62npDdg20nGqmFLrlC6zO6dEA&oe=6AA953C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762.png", "id": "745951794088262", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/43997711_745951797421595_3871520485959633568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wV043fkrcxMQ7kNvwGHIHxL&_nc_oc=AdpD7IW-9fQgR55gIbpXXjlmSc7Pa2G0eelq7A5y_IYspHn9tD_t0ViCGFyvSROPUrM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvrpQ3WHZdPxM8bAAjGxSQ-RWrKHVTI1zU6WppOV2CyQ&oe=6AA965C3"}, "display_name": "Wooden Fish Zen", "keywords": [], "long_description": "The wooden fish, a venerable and mystical wood instrument originating in East Asia, is frequently employed by Buddhist clergy for recitation and ceremonies. \n\"Wooden Fish Zen\" is an application that allows you to experience knocking wooden fish in virtual reality, with real physical interaction effects. You can choose to use mixed reality mode to place the wooden fish on your own table, or choose different atmospheric scenes, such as temple, waterfall, space, rainy day, etc. This app hopes to allow you to have an immersive wooden fish zen experience, put aside distracting thoughts, and gain a feeling of decompression, healing, and concentration.\nVirtues++, troubles--.\nFind a simple and effective way to relax in your busy life, and feel a sense of peace and depth in the rhythm of tapping the wooden fish.", "short_description": "An immersive wooden fish zen experience for stress relief and healing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/wooden-fish-zen-privacy-policy/23e3581f-db88-4230-9aa1-0f39fc92880c/privacy", "developer_terms_of_service_url": null, "publisher_name": "MountainVR Studio", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100023151198467", "category": null, "comfort_ratin
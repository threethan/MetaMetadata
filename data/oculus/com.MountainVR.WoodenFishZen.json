-sin2-1.oculuscdn.com/v/t64.5771-25/38974767_1026921195059293_3246354183015041667_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgYNfRjQ0sMQ7kNvwEwTDdT&_nc_oc=AdpVx7o5eJYq6Jk3teGLwuFgEagNx8qThDJzf8tk9-qNsCNnC9UYAi-MzG5rTELTHBU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQIlb6zPpnd2gcwFGxUyUz1LbIZGHJchQNTZgCBupWJw&oe=6AA4146D"}, {"file_name": "2023-7-11 15_09_20.png", "id": "747039833475878", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39036630_747039836809211_6263092530982373292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QpZoXJG_wgQ7kNvwH2fuhB&_nc_oc=AdpIztEaKRrA0xy_tFgNFKSXKHP5mgl2ZRZt7UfJoqqI2VDY7eQZ5uklRfNpdvj6FDM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCgQNDX6eTI8r7LHJVhkfo-GYxdcBt3dJwN2k0NJOb_Q&oe=6AA42157"}, {"file_name": "2023-12-30 18_32_05.png", "id": "1769304386869593", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974691_1769304390202926_4857717662441570091_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpoffBVTXqoQ7kNvwFJUiSe&_nc_oc=AdorrAKcZgfdMCnnmH6Hb4cK6RQW4hl2SFn6Hf2HnwsxlajcVzMUkyYuU6QN0NoMoOs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJV-vWMsm0KlmED5W0XGWaZst9slazNCYHTUUBTpO201Q&oe=6AA3F48F"}, {"file_name": "2023-12-30 18_41_45.png", "id": "1078950889907975", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974688_1078950893241308_1374981864668893190_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhUW9sgtvxIQ7kNvwEEsrUh&_nc_oc=AdqscZxCiOe2uxPemtQsvALYZYVKghZNv51AtfIY7fye8QUEiR6z8HSC42lJlaY1aOk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZplfWUK499k5d4_koSPbXpH6m9MDGwhoMsjipbIK12A&oe=6AA421B0"}, {"file_name": "passthrough.png", "id": "910258337370743", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982510_910258340704076_8779057242099034012_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZM2ZkcMLFAQ7kNvwGE5lns&_nc_oc=Adq4z3vEA_vQ1gQm004GVp6Jw_7JqcPQWIDtVBsSbWZKcg-JiRgaMbT0ZHs3hR5WhuE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_tzmdzQpKnpicRTV5C92ryMzJyJu5rfmeX-M0k2SJRw&oe=6AA40DC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762.png", "id": "745951794088262", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/43997711_745951797421595_3871520485959633568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76dfC5a4mgEQ7kNvwH5V1h3&_nc_oc=AdolfZJZD8gC1EPn82SHEPIyfmb7MTYXVGPhkP-c49mUVQeN1tcWxi9P6Mjn3jCGNes&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKijRtlchjlXoPtV7xJcqtiYaE7o0CIOquQmtJbjo5YWA&oe=6AA41FC3"}, "display_name": "Wooden Fish Zen", "keywords": [], "long_description": "The wooden fish, a venerable and mystical wood instrument originating in East Asia, is frequently employed by Buddhist clergy for recitation and ceremonies. \n\"Wooden Fish Zen\" is an application that allows you to experience knocking wooden fish in virtual reality, with real physical interaction effects. You can choose to use mixed reality mode to place the wooden fish on your own table, or choose different atmospheric scenes, such as temple, waterfall, space, rainy day, etc. This app hopes to allow you to have an immersive wooden fish zen experience, put aside distracting thoughts, and gain a feeling of decompression, healing, and concentration.\nVirtues++, troubles--.\nFind a simple and effective way to relax in your busy life, and feel a sense of peace and depth in the rhythm of tapping the wooden fish.", "short_description": "An immersive wooden fish zen experience for stress relief and healing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/wooden-fish-zen-privacy-policy/23e3581f-db88-4230-9aa1-0f39fc92880c/privacy", "developer_terms_of_service_url": null, "publisher_name": "MountainVR Studio", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100023151198467", "category": null, "comfort_ratin
-sin2-1.oculuscdn.com/v/t64.5771-25/38974767_1026921195059293_3246354183015041667_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3hfMaop0zIQ7kNvwEynWXm&_nc_oc=AdpgVUT9ISniugJvA62KeGK3V-FXe6s9g16smKkZCGSZ0xdSuq_NSn0HwmMQJ9rNHKg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uuNj7IayYe6Wzuwo2UcocnQAsnBpfhROoAFL_oXu6PA&oe=6A22E16D"}, {"file_name": "2023-7-11 15_09_20.png", "id": "747039833475878", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39036630_747039836809211_6263092530982373292_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSFSBNbdgjcQ7kNvwEIvSTs&_nc_oc=Ado4ofuT0DRd3cp02dV2cQXalSMLM0jbDUCSZANGzFVKa2HWSXqslf9mxaRZ5rNUvO8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wd6SiI-O5MKGoukcu65GUvZKSQZ0wKCC2kJTdKjyXiw&oe=6A22EE57"}, {"file_name": "2023-12-30 18_32_05.png", "id": "1769304386869593", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974691_1769304390202926_4857717662441570091_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ld9Wn73UgtwQ7kNvwFEDfS3&_nc_oc=Adq8C3pU_MkgK4x6DLproANgTWBfHLNYe2mKm94HN98UUeoFd2cqDRXTPCA7bqHnjKE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-YTN_bWl35lVVfRyWJ_ChHeudrOtroS84YGj1swO2Ug&oe=6A22F9CF"}, {"file_name": "2023-12-30 18_41_45.png", "id": "1078950889907975", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974688_1078950893241308_1374981864668893190_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMJfVwEoqeEQ7kNvwHg10e_&_nc_oc=AdrsJH0FQLdPPNDI-7zbbtPhFYRB21S3PopEY6msuqJ4CfeGq3PAtNflUu6WMutfF1Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80PZsAYwgBq5Ppe4uoDG5vF3mHx4xtbAieGRl-TFPqRQ&oe=6A22EEB0"}, {"file_name": "passthrough.png", "id": "910258337370743", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982510_910258340704076_8779057242099034012_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOUuM6TvDG0Q7kNvwGSuxSD&_nc_oc=Adqxr8qY9p9CPb9QIFpdFxn9zcyVsJD4vXTKSLLKy52iNgBsTIOIRqf9R_TMu5QKIy0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KMiZ590oTP7hgN-KPmpKtVwEjOlU312Jz--VqAf2PAg&oe=6A22DAC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5c01\u9762.png", "id": "745951794088262", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/43997711_745951797421595_3871520485959633568_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UIAGET8CTyMQ7kNvwHKQFH7&_nc_oc=AdpymwQhJeuqOEnvhz3qO-HjdK7GcIvttJx008saFF53YONWuz-nt5MAqGN6T697H5g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q2xlGOah7hRm1dBweWWmHHxVbFx-mZkc5wdhdmOmgHA&oe=6A22ECC3"}, "display_name": "Wooden Fish Zen", "keywords": [], "long_description": "The wooden fish, a venerable and mystical wood instrument originating in East Asia, is frequently employed by Buddhist clergy for recitation and ceremonies. \n\"Wooden Fish Zen\" is an application that allows you to experience knocking wooden fish in virtual reality, with real physical interaction effects. You can choose to use mixed reality mode to place the wooden fish on your own table, or choose different atmospheric scenes, such as temple, waterfall, space, rainy day, etc. This app hopes to allow you to have an immersive wooden fish zen experience, put aside distracting thoughts, and gain a feeling of decompression, healing, and concentration.\nVirtues++, troubles--.\nFind a simple and effective way to relax in your busy life, and feel a sense of peace and depth in the rhythm of tapping the wooden fish.", "short_description": "An immersive wooden fish zen experience for stress relief and healing"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/wooden-fish-zen-privacy-policy/23e3581f-db88-4230-9aa1-0f39fc92880c/privacy", "developer_terms_of_service_url": null, "publisher_name": "MountainVR Studio", "support_website_url": null, "website_url": "https://www.facebook.com/profile.php?id=100023151198467", "category": null, "comfort_ratin
"}, {"file_name": "7 2560x1440.png", "id": "1656533988393885", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619659_1656533991727218_653529141411198580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQZ5MkDlvEEQ7kNvwELuxDv&_nc_oc=Adl4eO9Lo7aP6LwrDemSNV2wcMHw_aZx3Vy4LP4066TpFD5T5r9IwyMv9tbQQVuvkLg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afuxw7grCy3W8e4vNdjVFHvKE-PEhCwegjM8riQ-ZvlABA&oe=699EECA1"}, {"file_name": "5 2560x1440.png", "id": "658200096729789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393511_658200100063122_1434102424434215294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ce_jWNf-U9oQ7kNvwEPO7vV&_nc_oc=AdmwRP8av5Jvd5Mnzd924LZG2RpmhqKHncraZQwF5FAVuGYe-RI8fSGggDFlHBu_phU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs12YJwAq39aDg5b0ZM_XNLY2evIG6B0rM6U5vjaZlUQg&oe=699F030D"}, {"file_name": "4 2560x1440.png", "id": "2853943778107750", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393432_2853943781441083_7516434067697327877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VYmCp4XGZCcQ7kNvwGwTy5j&_nc_oc=Admpo4KbWO4aUDwqfwryKJ0yNTsUDsM6eh8ygP7-wMb0ywy-ugt36c_qPpPZn1y6ClA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvkeq-X3id5dDwpzpXxxqOksoS5bhF2Tw3qME8eqUWtyw&oe=699F0774"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "537608808768600", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_537608812101933_347248220000878992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xfn_YojRS0Q7kNvwFc3WrB&_nc_oc=Adk5Xyhqj4xsSUYCxt6o4G1hHxdN1EZvackkHBXP1ub0itLB25u6NCwD-PoGnQag-Zs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsEVXegsJYh10EyLu1VoGOVxSvXGHRZhbyv0o2XPnCBbw&oe=699EDF1B"}, "display_name": "HIT", "keywords": ["physics", "sandbox", "comedy", "fun", "meme"], "long_description": "# \ud83d\udc4a The Ultimate Stress-Buster!\nPlay HIT and take out your stress by pummelling, slapping, and whacking squishy clay heads in a VR sandbox. Thanks to our wild soft body physics, every hit deforms and reshapes the heads in hilariously unpredictable ways!  \n  \n{581241924916221}\n  \n# \ud83e\ude93Choose Your Weapon  \nFists, frying pans, baseball bats\u2014even a flopping fish! Try 16 weapons each with their own unique impacts. Also try community suggested weapons like the anvil, assault rifle, knife, sledgehammer, or nunchaku!\n  \n{1328852431700754}\n  \n# \ud83d\udc6444+ Unique Heads to Wreck  \nEach one reacts to your hits with funny voices and expressions including 10 Content Creators you might recognise!)  \n  \n{980958897475587}\n  \n# \ud83d\ude97Take a break from hitting heads, smash a car instead!  \nUse your hands, weapons, or anything you can find to beat the car into tiny pieces. Take your time to smash it, or try to beat the clock in a timed challenge.  \n\n{1072912234790675}\n\n# \ud83c\udfdd\ufe0fChill Vibes or Dark Places  \nDestroy in peace, surrounded by a tranquil paradise OR pull the lever to enter scary Dystopia world!  \n  \n{1079261667549812}\n  \nJoin our Discord and tell us what to add next: https://discord.gg/ay3PfTKzw3\n\n{605877485686349}", "short_description": "Smash, slap, and whack squishy clay heads in VR! Choose wild weapons like crowbars and guns, watch heads deform with soft body physics and hear the heads react to each blow. Play HIT, the ultimate stress relief tool!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://superhypermega.studio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null, "website_url": "http://superhypermega.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres"
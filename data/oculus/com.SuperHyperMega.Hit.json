om&_nc_ss=8&oh=00_AfwBHJHaG1mohGZsfQimqve3qI0q295Y2wvevOsC0wPXHg&oe=69AAC116"}, {"file_name": "7 2560x1440.png", "id": "1656533988393885", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619659_1656533991727218_653529141411198580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei672DT5KXEQ7kNvwHxkwso&_nc_oc=Adle5wiU5pSEppQNhP5o4j34BkLvjbyu0Tjt9PejkPmwLDv-JtfBNxcwuSurHi2OFUQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHeqmd4k-T0g0RQQ29vHWSY7EWTvIluPXQc1A8DKLQ0Q&oe=69AACA21"}, {"file_name": "5 2560x1440.png", "id": "658200096729789", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/473393511_658200100063122_1434102424434215294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUQRyymwqu8Q7kNvwENpwm2&_nc_oc=AdkaX5RdefY7825qjfcudSpsUhdx1OTcFqpdd8g7utymV4MBIqP6L8TvoHGfN-_rqM4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afym-acqVmN2YGNydk777TRW4sq7LJ2JXcTbZgCSKSHkwA&oe=69AAE08D"}, {"file_name": "4 2560x1440.png", "id": "2853943778107750", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473393432_2853943781441083_7516434067697327877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4Ln7vWGCVkQ7kNvwH4ZViA&_nc_oc=Adn2N-Xpb9zq--O4BPs7ff-ml-u7rvFoBa-D0Bc2huQXc1IPC04JRcb2N04q2JRrC_w&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwimeHwbxsvGSKUTn-MqEe308eBZmw423TvVg2krXMDSQ&oe=69AAE4F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "537608808768600", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473392005_537608812101933_347248220000878992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us68Z4Am_J8Q7kNvwF4vPEc&_nc_oc=AdmZsGr_tXJHB49UfjXioJ2G-F5kElIdB2BO9uLmtvArRSRMg0YePabqnxtF87zPE6w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afwtw21_1vPI4nZVvaUXDQzmn5zN41F96m7B1OtZVdUmWw&oe=69AABC9B"}, "display_name": "HIT", "keywords": ["physics", "sandbox", "comedy", "fun", "meme"], "long_description": "# \ud83d\udc4a The Ultimate Stress-Buster!\nPlay HIT and take out your stress by pummelling, slapping, and whacking squishy clay heads in a VR sandbox. Thanks to our wild soft body physics, every hit deforms and reshapes the heads in hilariously unpredictable ways!  \n  \n{581241924916221}\n  \n# \ud83e\ude93Choose Your Weapon  \nFists, frying pans, baseball bats\u2014even a flopping fish! Try 16 weapons each with their own unique impacts. Also try community suggested weapons like the anvil, assault rifle, knife, sledgehammer, or nunchaku!\n  \n{1328852431700754}\n  \n# \ud83d\udc6444+ Unique Heads to Wreck  \nEach one reacts to your hits with funny voices and expressions including 10 Content Creators you might recognise!)  \n  \n{980958897475587}\n  \n# \ud83d\ude97Take a break from hitting heads, smash a car instead!  \nUse your hands, weapons, or anything you can find to beat the car into tiny pieces. Take your time to smash it, or try to beat the clock in a timed challenge.  \n\n{1072912234790675}\n\n# \ud83c\udfdd\ufe0fChill Vibes or Dark Places  \nDestroy in peace, surrounded by a tranquil paradise OR pull the lever to enter scary Dystopia world!  \n  \n{1079261667549812}\n  \nJoin our Discord and tell us what to add next: https://discord.gg/ay3PfTKzw3\n\n{605877485686349}", "short_description": "Smash, slap, and whack squishy clay heads in VR! Choose wild weapons like crowbars and guns, watch heads deform with soft body physics and hear the heads react to each blow. Play HIT, the ultimate stress relief tool!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://superhypermega.studio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null, "website_url": "http://superhypermega.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "199010405144709
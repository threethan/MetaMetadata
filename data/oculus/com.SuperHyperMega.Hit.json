ntent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dKjdJ4DeNfbqBFpVWX_0MXH2R4y68_dDNzj1FFj5T8Q&oe=69D64296"}, {"file_name": "7 2560x1440.png", "id": "1656533988393885", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619659_1656533991727218_653529141411198580_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtfddmVRbEkQ7kNvwF77irI&_nc_oc=AdqWxY2k6sDgeEXKZDhXxd2fPAI571_Ha-ujvELhD3m9idqPZQe_UvP3Wge1RD_TTMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pe1FHOK9r0aN2vUSK9rQ35OrGrPgGCDjXtcfO5WqGMg&oe=69D64BA1"}, {"file_name": "5 2560x1440.png", "id": "658200096729789", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393511_658200100063122_1434102424434215294_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUXwWfHoPYQQ7kNvwEycVX9&_nc_oc=AdrwftlPRNMzm2Ah52zXOMh9rcV3ZZ9C-TOug5K9nbU4wbOewrHy-Og5-0rSkCRPWvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13XiM7nRKrQenGtKBnG4bEOytTOxAnVSxBNLq8-dq27g&oe=69D6620D"}, {"file_name": "4 2560x1440.png", "id": "2853943778107750", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393432_2853943781441083_7516434067697327877_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gu70YZdaJWUQ7kNvwFPZVmI&_nc_oc=Adp8M7b2kCw687XEdxVMW9UOBf9nlZhZmlV7Zn1xR6nTLg7q3pys-tkDXNOTsnKBDcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2A9LVYc6FZ8eA6H0S5Y6qYEPqY6rlxuvYoldtZMdSdlQ&oe=69D66674"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "537608808768600", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392005_537608812101933_347248220000878992_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NHuRyM73O0Q7kNvwGMkVSU&_nc_oc=Adro066YB_JdeBeO3Slz4JSOGO-PIKXEItgMGy5gOtKW4lQrQK1x6V4OcBEf_nBQFFU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TZE-r1Au0bSHg0YPiJaJ1Sl5rlmLYNlhKAmcKstPCLw&oe=69D63E1B"}, "display_name": "HIT", "keywords": ["physics", "sandbox", "comedy", "fun", "meme"], "long_description": "# \ud83d\udc4a The Ultimate Stress-Buster!\nPlay HIT and take out your stress by pummelling, slapping, and whacking squishy clay heads in a VR sandbox. Thanks to our wild soft body physics, every hit deforms and reshapes the heads in hilariously unpredictable ways!  \n  \n{581241924916221}\n  \n# \ud83e\ude93Choose Your Weapon  \nFists, frying pans, baseball bats\u2014even a flopping fish! Try 16 weapons each with their own unique impacts. Also try community suggested weapons like the anvil, assault rifle, knife, sledgehammer, or nunchaku!\n  \n{1328852431700754}\n  \n# \ud83d\udc6444+ Unique Heads to Wreck  \nEach one reacts to your hits with funny voices and expressions including 10 Content Creators you might recognise!)  \n  \n{980958897475587}\n  \n# \ud83d\ude97Take a break from hitting heads, smash a car instead!  \nUse your hands, weapons, or anything you can find to beat the car into tiny pieces. Take your time to smash it, or try to beat the clock in a timed challenge.  \n\n{1072912234790675}\n\n# \ud83c\udfdd\ufe0fChill Vibes or Dark Places  \nDestroy in peace, surrounded by a tranquil paradise OR pull the lever to enter scary Dystopia world!  \n  \n{1079261667549812}\n  \nJoin our Discord and tell us what to add next: https://discord.gg/ay3PfTKzw3\n\n{605877485686349}", "short_description": "Smash, slap, and whack squishy clay heads in VR! Choose wild weapons like crowbars and guns, watch heads deform with soft body physics and hear the heads react to each blow. Play HIT, the ultimate stress relief tool!"}]}, "developer_name": "SUPER HYPER MEGA", "developer_privacy_policy_url": "https://superhypermega.studio/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "SUPER HYPER MEGA", "support_website_url": null, "website_url": "http://superhypermega.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, 
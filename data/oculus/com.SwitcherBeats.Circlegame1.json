-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrWbeEYtRI-YNZrJjStRNKzMzZN50DDkfosuVaKIrqtg&oe=6AFC83FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "circlegametrailer3night.png", "id": "1394788584477089", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75330717_1394788587810422_2762165887028287270_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBfOOt1hjswQ7kNvwHNpTmZ&_nc_oc=Adp9vCEpWK012H0vCuGpS-rrDzr90lqkcQDXxDjlD3txbuERm-No6zej9fI-kulptOA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrPA1CCK3qC_MWMCsCVgxkfhuHu7nbisdLcm8XdhGyYg&oe=6AFC7306"}, "display_name": "Circle Game 1", "keywords": [], "long_description": "Have you ever wanted to be a circle? Well, your dream has come true in Circle Game! In this cartoonish and fun game, there are very silly and non-serious places you can visit. Such as: a forest, a beach, a very cool credit room, a hamster cage, and a mysterious cave...\n\nAs circle game 1 comes to an end.. we've created a gallery to show all update art, funny moments, and trailers for previous updates!\n\nJoin the discord for development updates and stupid fun overall!: \nhttps://discord.gg/VNs8KsDS4W", "short_description": "This silly little game has you as a circle, you move around by using your weirdly shaped hands. Explore this weird universe inhabited with tons of easter eggs and other fun stuff!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/b68b6cbb-9b46-4d8c-97c4-3a6697403fb6", "developer_terms_of_service_url": null, "publisher_name": "SwitcherBeats", "support_website_url": null, "website_url": "https://sites.google.com/view/circle-game-site/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nul
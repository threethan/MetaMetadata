ile_name": "S1.png", "id": "1200733988486155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305050_1200733991819488_2209698232822295154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imF_2lqNRqQQ7kNvwE04_Cy&_nc_oc=Adp5Pzaypci8ysR9icxfEdEUKJ9mC0hadCmzWIsQgggmKkDN_vVLXh3zKdPljRIM_Uc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9i1eAQav0WKkPsEB8hpU8j3JIVd1O1QgMNPno0KWttg&oe=6AB7BDCD"}, {"file_name": "S5.png", "id": "1093324276265260", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307326_1093324282931926_8730817538137000333_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xM0jqOXsB8Q7kNvwGHJD1W&_nc_oc=AdpAGX2B-yahF_v0ijDnJRnJY8bll4tOM69o60qI0r2gbW_YZ9fqqmveqGt9buJkdzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC1V8dFW4CB7DpwlufV4OoAI868Zq-qg9Ywt7rzQWS6Q&oe=6AB7E3AB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme VR Car Drift Racing Simulator", "keywords": ["CarDriftSimulator", "ExtremeRacing", "DriftSimulator", "VRRacing", "VRCar"], "long_description": "Get ready for the ultimate VR drifting experience!\n Step into the driver\u2019s seat of high-powered cars and master the art of drifting in Extreme VR Car Drift Racing Simulator. Feel the adrenaline as you slide around tight corners, pull off perfect handbrake drifts, and race against the clock in stunning virtual environments.\nKey Features:\n\ud83d\ude97 Immersive VR Racing \u2013 Experience realistic car physics and fully interactive VR controls.\n\n\n\ud83d\udd25 Extreme Drift Action \u2013 Perfect your slides, control your speed, and dominate every track.\n\n\n\ud83c\udf06 Multiple Tracks & Environments \u2013 From city streets to mountain roads, each track offers unique challenges.\n\n\n\ud83c\udfc6 Challenging Missions & Time Trials \u2013 Push your skills to the limit and compete for high scores.\n\n\n\ud83c\udfae Customizable Cars \u2013 Upgrade your vehicles, tune your drift setup, and race your way.\n\n\n\ud83c\udf1f Stunning Graphics & Sound \u2013 Enjoy realistic visuals, engine sounds, and immersive VR effects.\n\n\nWhether you\u2019re a casual player or a hardcore drift racing fan, this simulator gives you the thrill of drifting in full VR. \n", "short_description": "Experience heart-pounding car drift racing in immersive VR like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25266868052991341"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1571015978097547"}, {"status": "PUBLISHED", "id": "1045949861639266"}, {"status": "PUBLISHED", "id": "1555961409506594"}, {"status": "PUBLISHED", "id": "2106888516705750"}, {"status": "PUBLISHED", "id": "1277884574527147"}, {"status": "PUBLISHED", "id": "948240027597995"}, {"status": "PUBLISHED", "id": "1941370256463689"}, {"status": "PUBLISHED", "id": "1430761541828112"}]}, "baseline_offer": {"id": "1430761541828112"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1571015978097547"}]}, "liveChannel"
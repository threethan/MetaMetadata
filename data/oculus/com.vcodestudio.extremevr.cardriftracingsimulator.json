25768868426775420_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUxBJxbfWwsQ7kNvwF1nI6m&_nc_oc=AdoDE7uWxqRDk_u0bqN2aJdx0dzoSzCAIUxh4eHVXKbocvouIM1--yFte_RyGTcpqfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4JLDcBlaG151TNptZe08nHez7YCfo0V5W9CIOu_Rf9Q&oe=6AB7EF7C"}, {"file_name": "Screenshot_1.png", "id": "3099048553629297", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819281_3099048556962630_4875710065707386315_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0JQGWT5G3sQ7kNvwGtQJbD&_nc_oc=AdqkbrmPHulCLB1Pye86APz5DK6Axqh9U9H3icsO2Mno0b2SH9exNc3Mk4QFovP2OiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWDTtrNx25ChneV8NHORc48kDuZPQNFKU9r9zO_rz6Uw&oe=6AB7EAC4"}, {"file_name": "Screenshot_5.png", "id": "4312530535655888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821081_4312530538989221_7269271289227510631_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kfr4rLdwtsQ7kNvwFNyJfW&_nc_oc=AdrEzMplBX7UCUk6BV5i90fPN5927rFbXuAAJhs-RA-RBaZHt4DWVlM9d_M-59r0nok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2ZI_3U11HS0Hb93omMUS4yfYbExf5rt79zqBnVF6E5Q&oe=6AB7E38E"}, {"file_name": "Screenshot_2.png", "id": "3139456066256812", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821702_3139456069590145_7787369168476475780_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q8BcGCWNsOAQ7kNvwHuQgUT&_nc_oc=AdoYFdZo3t4PE02yV5lsHYOmPZEL-DNH25aQzlMCeJs3bT-feDxBSND8h2V7se86R0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1E_TGTjfSzj-xe-AVXzH6qRnsu4zTg6NLj8_TddmrXQ&oe=6AB7CB28"}, {"file_name": "Screenshot_4.png", "id": "4319253561697705", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823812_4319253568364371_1228602696107333931_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZjykFSFX9a4Q7kNvwGf5maF&_nc_oc=AdplsPnqFIilEjiScQCLSJFrKj1JSxu_eLy1a6B-m2B8ZAWEa1Ui_7TNvHU1cEqtszI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbCaN4V-Nz3KgNsotcJTCpnzfUwicoznQhoiW6Zc5U1g&oe=6AB7DA3C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Extreme VR Car Drift Racing Simulator", "keywords": ["CarDriftSimulator", "ExtremeRacing", "DriftSimulator", "VRRacing", "VRCar"], "long_description": "Get ready for the ultimate VR drifting experience!\n Step into the driver\u2019s seat of high-powered cars and master the art of drifting in Extreme VR Car Drift Racing Simulator. Feel the adrenaline as you slide around tight corners, pull off perfect handbrake drifts, and race against the clock in stunning virtual environments.\nKey Features:\n\ud83d\ude97 Immersive VR Racing \u2013 Experience realistic car physics and fully interactive VR controls.\n\n\n\ud83d\udd25 Extreme Drift Action \u2013 Perfect your slides, control your speed, and dominate every track.\n\n\n\ud83c\udf06 Multiple Tracks & Environments \u2013 From city streets to mountain roads, each track offers unique challenges.\n\n\n\ud83c\udfc6 Challenging Missions & Time Trials \u2013 Push your skills to the limit and compete for high scores.\n\n\n\ud83c\udfae Customizable Cars \u2013 Upgrade your vehicles, tune your drift setup, and race your way.\n\n\n\ud83c\udf1f Stunning Graphics & Sound \u2013 Enjoy realistic visuals, engine sounds, and immersive VR effects.\n\n\nWhether you\u2019re a casual player or a hardcore drift racing fan, this simulator gives you the thrill of drifting in full VR. \n", "short_description": "Experience heart-pounding car drift racing in immersive VR like never before!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
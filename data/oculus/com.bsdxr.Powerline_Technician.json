.com&oh=00_Afu753LRUzS7Myga07qCojLBLLscK6AlDNPk4o92rIxYnA&oe=69A5785B"}, {"file_name": "PowerLine_Screenshot_3.png", "id": "1010689067352509", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75534973_1010689074019175_5558203956346383217_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O5mCPP1DTMQ7kNvwFpKTcA&_nc_oc=AdlGRn-wzOuwW4IB-4gAayx5XGUkGMhpxoZ2wXUlJpk-4aKRupfK50WL3vckSlmn99w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuGcl4K5z40cVV2rU1qwWByvJOb-02gjAu925s4nFMXGg&oe=69A57092"}, {"file_name": "PowerLine_Screenshot_4.png", "id": "1113159949799117", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75305881_1113159953132450_8650089221901603887_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7lpnhmbHxUQ7kNvwEISFvC&_nc_oc=AdnwnCWVWZgBTncdLszDDo7BA-CZrcHlYUu_EBv10v0jJFBuhFi7xdyXGe3YWi5GtlE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu38dmFjZAdvddrtZPwMd4H_qiqfBwwYzzKoHKPjZ7GSw&oe=69A59251"}, {"file_name": "PowerLine_Screenshot_5.png", "id": "1506657896556945", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974758_1506657899890278_1188683460308031426_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnKwUK4StGYQ7kNvwH-9zJG&_nc_oc=Adkv4yL_jJaPH_68HFGRr00rqL_azh0y8BoOYC8AFYuj42AMPOu0Dswfz_4Efs1c-yk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft4Seciq0qdlUBGaOZEmGyMJWfhYZq4pJyfdEmPpdOo_g&oe=69A59B6C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BSD XR Power Line Technician", "keywords": [], "long_description": "Power Line Tech VR is an innovative and immersive training simulator designed to enhance the safety and expertise of power line technicians in the utility industry. Leveraging cutting-edge virtual reality technology, this simulator provides a realistic and interactive environment for power line technicians to hone their skills, tackle diverse scenarios, and effectively respond to potential challenges.\n\n\ufeffAspiring and experienced technicians alike can gain inval
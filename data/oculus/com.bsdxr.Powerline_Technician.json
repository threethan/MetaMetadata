.com&oh=00_AfsmpY4l_WV7VtE5GntBUZzgs2hNFTPDokH4iq_Q-jV60g&oe=699C3DDB"}, {"file_name": "PowerLine_Screenshot_3.png", "id": "1010689067352509", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75534973_1010689074019175_5558203956346383217_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JKqzU4eIAUQ7kNvwHndKuJ&_nc_oc=AdkkMUOpA_Dm6KcAN4-89HbccOYNOzIBt6BAzlDqvlcTMUgfiOQhXilAJIyxLu7MMf8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvGyTd6XEtxy_EAd-zPmMiuTzClQVs-CyMcC2u2Jwc--w&oe=699C3612"}, {"file_name": "PowerLine_Screenshot_4.png", "id": "1113159949799117", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75305881_1113159953132450_8650089221901603887_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiPyah1zDm0Q7kNvwFNx0Ct&_nc_oc=AdnZ4KE6TpKbjk4rJRjRZpBwa4uIpIqkHgmbBIN4jSjQNHOd09reNzpDel0AFFffSNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftsPs6RsBgia10lYCcRduu-QKqKKuVsRxXgGxBUCGvDZg&oe=699C57D1"}, {"file_name": "PowerLine_Screenshot_5.png", "id": "1506657896556945", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974758_1506657899890278_1188683460308031426_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5U-u34T3itgQ7kNvwHnIeVc&_nc_oc=Adl18hp9uhm3JC4ZkxYRUKoFGodPxDLkw47o_-3Gua1FbLnYlnvm9LFdvq4AfdKlZ94&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsRDZx13RQwjfU4-v-INLjVYkC2PgSJV2a7lBrpqTldVw&oe=699C60EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BSD XR Power Line Technician", "keywords": [], "long_description": "Power Line Tech VR is an innovative and immersive training simulator designed to enhance the safety and expertise of power line technicians in the utility industry. Leveraging cutting-edge virtual reality technology, this simulator provides a realistic and interactive environment for power line technicians to hone their skills, tackle diverse scenarios, and effectively respond to potential challenges.\n\n\ufeffAspiring and experienced technicians alike can gain inval
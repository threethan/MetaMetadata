.com&oh=00_AfsJnVbgTX8qbNWdhZBdnS2_96kgvL0iZGud9ZAo3ma9zA&oe=69A426DB"}, {"file_name": "PowerLine_Screenshot_3.png", "id": "1010689067352509", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75534973_1010689074019175_5558203956346383217_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O5mCPP1DTMQ7kNvwHYf268&_nc_oc=Adm3O831zvxoCaYJZOk8DD_yGyOgSDItp0gDhKLb4HWTHRXmgDNFbnTZKC584xDpuI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuAPcewlbz0JrJ2-GGtabWDErTv7AHbUytiqfU715MdXw&oe=69A41F12"}, {"file_name": "PowerLine_Screenshot_4.png", "id": "1113159949799117", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75305881_1113159953132450_8650089221901603887_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7lpnhmbHxUQ7kNvwFRjGZE&_nc_oc=Adlb-F-nAAhAT9eywrnIawNAc2GyOZ0aJsL-zhOzY5D8k2bfLBZkWj89gDDt3MMKXfc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv1teVwVAAa7s_eEGdXmzgdZE-PbtAcS9vLZM2GBCWQgQ&oe=69A440D1"}, {"file_name": "PowerLine_Screenshot_5.png", "id": "1506657896556945", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974758_1506657899890278_1188683460308031426_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81LhITSstv0Q7kNvwHSk3EP&_nc_oc=AdktbSidGyeCUGEm29RqZXpKGUI9s3WTXoV7htGYj5VxkFhoYomIKiozYz3wTNaMBFQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aftq6fTRnpCrzPI-bikGoBpYVdmLYKCHOOq7o4vaALXRtw&oe=69A449EC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BSD XR Power Line Technician", "keywords": [], "long_description": "Power Line Tech VR is an innovative and immersive training simulator designed to enhance the safety and expertise of power line technicians in the utility industry. Leveraging cutting-edge virtual reality technology, this simulator provides a realistic and interactive environment for power line technicians to hone their skills, tackle diverse scenarios, and effectively respond to potential challenges.\n\n\ufeffAspiring and experienced technicians alike can gain invaluable experience without exposing themselves to real-world risks, ultimately leading to improved on-the-job performance and a heightened safety consciousness.", "short_description": "Power Line Tech VR is an innovative and immersive training simulator designed to enhance the safety and expertise of power line technicians in the utility industry. Leveraging cutting-edge virtual reality technology, this simulator provides a realistic and interactive environment for power line technicians to hone their skills, tackle diverse scenarios, and effectively respond to potential challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bitspacedevelopment.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BSD XR", "support_website_url": null, "website_url": "https://www.bitspacedevelopment.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7745206708901545"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "791356439819010"}, {"status": "PUBLISHED", "id": "1427455357892093"}]}, "baseline_offer": {"id": "791356439819010"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741710300, "status": "PUBLISHED", "id": "791356439819010"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7772499159505633", "version": "1"}, "id": "1
"keywords": [], "long_description": "Power Line Tech VR is an innovative and immersive training simulator designed to enhance the safety and expertise of power line technicians in the utility industry. Leveraging cutting-edge virtual reality technology, this simulator provides a realistic and interactive environment for power line technicians to hone their skills, tackle diverse scenarios, and effectively respond to potential challenges.\n\n\ufeffAspiring and experienced technicians alike can gain invaluable experience without exposing themselves to real-world risks, ultimately leading to improved on-the-job performance and a heightened safety consciousness.", "short_description": "Power Line Tech VR is an innovative and immersive training simulator designed to enhance the safety and expertise of power line technicians in the utility industry. Leveraging cutting-edge virtual reality technology, this simulator provides a realistic and interactive environment for power line technicians to hone their skills, tackle diverse scenarios, and effectively respond to potential challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bitspacedevelopment.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BSD XR", "support_website_url": null, "website_url": "https://www.bitspacedevelopment.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "77452
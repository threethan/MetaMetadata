oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP8ISufA3RAP0UyzqIeQB_viYE9eXSrHWUnnZwGuZV-w&oe=6B008775"}, {"file_name": "Screenshot_03_2560x1440.png", "id": "1461933431927701", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821682_1461933438594367_521143625571902271_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBn6_nmdKkMQ7kNvwHyaNlN&_nc_oc=AdpqRfurzGqt-fSMTAYanN29-R-p1X4pUDikP2va52DAvBjky0dBo4v9m3c4S8kBCxM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh8HtUCGlQE4hiti5uUjQLG-AnRB-rY9_91KjJ-Cjjzg&oe=6B006015"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2163591631158104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824700_2163591634491437_4463019787405537805_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zPqy8EbC24Q7kNvwGZj2IU&_nc_oc=Adqclpm1id41jbGCNLRoJPF4cxUUAYMrH3sKon7vONEY69UqYL16WxLnjtepl9o_T8M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT74LcbzM6AVXISi10ZMgWdzNpXt0shuCXBC1k4RxHr5A&oe=6B008029"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1496834611824482", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823910_1496834615157815_4672832654400064249_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iKa6QWKoMVYQ7kNvwFyqfIu&_nc_oc=AdqNk-DYyInEHPjGKEFkY0UdhfNLTj4ZL_So1_ao47mggLwpV74Nl6VQBxq6_CCud98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1AN7fVcJkB2rn5NZT6nswSb4QA5t75AiqN0iha3BymQ&oe=6B0086D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "1517979640029806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_1517979643363139_6989937710290780480_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2IR5Op2DcAQ7kNvwGdkigq&_nc_oc=AdpNh7aY9_cbK_3R2jCRRQbrk555jOf52rCq5RPw7b0F_b3qFfk3IOkp2fwaOjbRKfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWounoNa1xW7ib-6xak4JkDJ_Rdr_lADM_dx0xI9e1Gw&oe=6B008144"}, "display_name": "Shin Zero", "keywords": ["Katana", "Combat", "Saber", "Sword"], "long_description": "In this *single-player* arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{1714881803279321}\n\n# Fight How You Want\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1273176688135825}\n\n# Weapons & Customization\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n- Single blades\n- Dual blades\n- Reverse blades\n- Dual wielding\n\n{1897157950949720}\n\n# Skill-Based Defense\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{848252014999273}\n\n# Collectibles\nFind **Jump World** toys from our **1st game** and **Shin Zero** comics to unlock more weapons and items for your apartment. \n\n{1424686746010854}", "short_description": "In this **single player**, arcade combat and sword slicing experience, wield powerful energy weapons and abilities against an onslaught of corrupt cyber-machines in **30 missions** that have been sent to hunt down and destroy the last of your kind. Multiple bosses, bonus rounds and a firing range where you can practice defending yourself again various types of laser fire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ninja Playground", "support_website_url": null, "website_url": "https://www.ninjaplayground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28056955010579759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/646406254_1309141831183575_2365566245774824453_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YmV6ialtKUQ7kNvwFPKtpY&_nc_oc=AdrUq2uR0NomWSkFO9tiuJejwJr2yLCVNmvmHZKu495TykOV488OYdyoPCuBFXA1IDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2PUvz2S9pws8jJErwLN3vfayZPSekHP0Q8vIcaI9gAg&oe=6B00677D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shin Zero", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"to
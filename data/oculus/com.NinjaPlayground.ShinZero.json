oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_sevPs1w2PyWKzWQGV0HmDVXFdwNIpQOO0t1ygF6W3w&oe=6AFDAC35"}, {"file_name": "Screenshot_03_2560x1440.png", "id": "1461933431927701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821682_1461933438594367_521143625571902271_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAG_GPbdIXgQ7kNvwHf43og&_nc_oc=AdpnrgCF_3dZ-XfAY3qUKfFmBrLWf7FzIkKQCagfiBlz4rCgt8ZGSxYGe1NznN2aVO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEwSyewS5anVxJJxbPx5omQ56HDPeAMKOonNsN6McOfQ&oe=6AFDBD15"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2163591631158104", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824700_2163591634491437_4463019787405537805_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1CJeMkbMcm4Q7kNvwHU-iKN&_nc_oc=Adp7YivJytsXqwM6jMDj-buysZAaj2aAsa0ljILuq1kcEa0HUbBmxppkJm44AnDIn_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVq2cJew-T6QbEdtIOGXfT8zRxHhauGOunZK_KOfECAA&oe=6AFDDD29"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1496834611824482", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823910_1496834615157815_4672832654400064249_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fp_-6PgjKKcQ7kNvwEIQGNn&_nc_oc=AdpwVYQO4wJFYWM5aaSsifGDjILknYzl4O48M_5oAkqTruOTkTmMoJ7ufF9KklU2baI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPfCzT4vfofBF7g484qSGG6vFjjK7HooSl8yiJM9j3wQ&oe=6AFDE3D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "1517979640029806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_1517979643363139_6989937710290780480_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2IR5Op2DcAQ7kNvwGHoh1p&_nc_oc=AdoglYETvfL8UhUzCI-ZXLAfCMO8-1cRuYmCTpcrH7o822Sn3IwtS4fAinRCBffJRPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShsJEQBRB7o7U08dFyM3vNBIbzj-njOOLonr95VkYuuQ&oe=6AFDDE44"}, "display_name": "Shin Zero", "keywords": ["Katana", "Combat", "Saber", "Sword"], "long_description": "In this *single-player* arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{1714881803279321}\n\n# Fight How You Want\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1273176688135825}\n\n# Weapons & Customization\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n- Single blades\n- Dual blades\n- Reverse blades\n- Dual wielding\n\n{1897157950949720}\n\n# Skill-Based Defense\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{848252014999273}\n\n# Collectibles\nFind **Jump World** toys from our **1st game** and **Shin Zero** comics to unlock more weapons and items for your apartment. \n\n{1424686746010854}", "short_description": "In this **single player**, arcade combat and sword slicing experience, wield powerful energy weapons and abilities against an onslaught of corrupt cyber-machines in **30 missions** that have been sent to hunt down and destroy the last of your kind. Multiple bosses, bonus rounds and a firing range where you can practice defending yourself again various types of laser fire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ninja Playground", "support_website_url": null, "website_url": "https://www.ninjaplayground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28056955010579759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/646406254_1309141831183575_2365566245774824453_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWXSsD1hx1sQ7kNvwGdsQ6z&_nc_oc=Adpje4xYc9pVKSJ6b1x6Lrs309F2CH1ccqzlFVH6eiDoOAYt4DSAMo4l3dui6aUMkr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR05zo_4XR8CB-2nziW97IQAke8q0Z0C1GLB5_ljz6vYQ&oe=6AFDC47D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shin Zero", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"to
oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlPewHo820loc6rTdgZu79eDu0HglHIKZHtHYag4btMg&oe=6B09C1F5"}, {"file_name": "Screenshot_03_2560x1440.png", "id": "1461933431927701", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821682_1461933438594367_521143625571902271_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4RU-_DzoP4Q7kNvwEgHgAh&_nc_oc=AdqjmaLHwfv89nzcrZk_xZG39EpIadi2accgpxsGPglcYQj0mzrYw3et1GonulTBVME&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyO3sMA6xxWwXfVlIT-dnwMRzW4Kgpc0arXyQTtAwEwg&oe=6B099A95"}, {"file_name": "Screenshot_04_2560x1440.png", "id": "2163591631158104", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824700_2163591634491437_4463019787405537805_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDyDFEGyjC4Q7kNvwFKnJj4&_nc_oc=AdqhGkDB4iom_wuRcBnSqgyqit828EBJHKvcRPaYx5bM4OeSUMQpetXWLiDo9G62YZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD-XWQ47Afut39k2QEMvkhDLboxohhhiAUQdivv__pcg&oe=6B09BAA9"}, {"file_name": "Screenshot_05_2560x1440.png", "id": "1496834611824482", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823910_1496834615157815_4672832654400064249_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJrZLoRXlhUQ7kNvwGppH0M&_nc_oc=Adou2aDWSQpHhel79XGlCOZ_T7sR9evFh87OqJobGiW1P91shZdx2uTQpiyqCXWCJoo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5KowarBSjVaaNfTtoyUd04TXptGx9BAsX7vgTC2XcXA&oe=6B09C156"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_Landscape_2560x1440.png", "id": "1517979640029806", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307470_1517979643363139_6989937710290780480_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ui-QpQ1xIokQ7kNvwEsNu-t&_nc_oc=Adoo-fPBX2Qn77dB5Y4-Gi1p3zoLMpYkpafCJyFn_6y5m4BvTY7WG-5RMgGUXfBxYvw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrQj55njzmm3J6Lmab53wKp83DNyJ-rmFaDsLzmAW8Hg&oe=6B09BBC4"}, "display_name": "Shin Zero", "keywords": ["Katana", "Combat", "Saber", "Sword"], "long_description": "In this *single-player* arcade combat and sword-slicing VR experience, wield powerful energy weapons and abilities against an army of corrupt cyber-machines sent to hunt down and destroy the last of your kind.\n\nBattle through 30 missions filled with close-range duels, ranged laser fire, boss fights, bonus rounds, and a firing range where you can sharpen your reflexes against different projectile types.\n\n{1714881803279321}\n\n# Fight How You Want\nBlock and counter enemies up close, or throw your plasma weapon in a spinning attack to slice robots from a distance. Absorb energy from defeated enemies to charge powerful abilities, slow time, or unleash a kinetic blast when you are overwhelmed and surrounded.\n\n{1273176688135825}\n\n# Weapons & Customization\nUnlock new weapon types as you progress, each changing how you approach combat. Customize the color of each blade on the three main weapon styles, and choose between automatic or manual activation for more control. Dual-bladed weapons can even activate only the reverse blade for advanced combat options.\n\n- Single blades\n- Dual blades\n- Reverse blades\n- Dual wielding\n\n{1897157950949720}\n\n# Skill-Based Defense\nYour weapon movement matters. Deflect laser fire back at enemies, counter incoming sword attacks, and use spinning strikes to block attacks. Controlled swings keep your blade stable, while frantic swinging can overheat the power core and temporarily short-circuit your weapon.\n\n{848252014999273}\n\n# Collectibles\nFind **Jump World** toys from our **1st game** and **Shin Zero** comics to unlock more weapons and items for your apartment. \n\n{1424686746010854}", "short_description": "In this **single player**, arcade combat and sword slicing experience, wield powerful energy weapons and abilities against an onslaught of corrupt cyber-machines in **30 missions** that have been sent to hunt down and destroy the last of your kind. Multiple bosses, bonus rounds and a firing range where you can practice defending yourself again various types of laser fire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ninjaplayground.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ninja Playground", "support_website_url": null, "website_url": "https://www.ninjaplayground.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28056955010579759"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/646406254_1309141831183575_2365566245774824453_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ILbwhcGC7NkQ7kNvwEHyVsc&_nc_oc=AdowBhGNXAiH75dBHX6c6xMOLUcaPgaHvrXfQUom2iKuPMBdgxxWUKmxh9jkBYFIREQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgpKaFI558zLnUGZoYCEvsOcbe__2VePP_Zgsxq2kxHw&oe=6B09A1FD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shin Zero", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"to
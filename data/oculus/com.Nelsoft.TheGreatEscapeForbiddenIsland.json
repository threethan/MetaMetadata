Q7kNvwFMYCi0&_nc_oc=Adq0DasFIr-bwFfBSfW6TFwKGPPsQw3FTui8PhqJgr37-t0_26uqwJ6XVcs6bCBm28w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFHWxjNFjT6xxNgZKMA_731pHbVZd4hNChKmmPMN_cCg&oe=6A9C1626"}, "display_name": "The Great Escape: Forbidden Island", "keywords": [], "long_description": "Upon discovering an ancient ruin on another treasure hunt, your ship is attacked by gruesome monsters.  Stranded alone on an island, you must rebuild your ship, explore an open world of islands, fortresses, dungeons, sunken ships and more to exact your revenge, reclaim your treasure, and earn the title of the most fearsome pirate to sail the turbulent seas. Sail through an open world full of islands, fortresses, sunken pirate ships, dark dungeons, and much more.  Discover treasure, complete quests, interact with pirates, and clash with evil monsters. Battle through four unique dungeons and unlock Forbidden Island, home to the evil menace Lord Darketo.", "short_description": "Upon discovering an ancient ruin on another treasure hunt, your ship is attacked by gruesome monsters.  Stranded alone on an island, you must rebuild your ship, explore an open world of islands, fortresses, dungeons, sunken ships and more to exact your revenge, reclaim your treasure, and earn the title of the most fearsome pirate to sail the turbulent seas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nelsoft.net/privacy/privacy_policy_v2.txt", "developer_terms_of_service_url": null, "publisher_name": "Nelsoft Ltd Co", "support_website_url": null, "website_url": "http://www.nelsoft.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEME
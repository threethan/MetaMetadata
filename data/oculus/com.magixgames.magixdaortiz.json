ios, you will be able to live a magical experience. Enjoy the work of the prestigious magician Dani DaOrtiz, in unique environments created to generate a unique experience. Whether you are a magician or not, this application will give you hours and hours of fun.\n\nIn addition to watching magic videos, this app includes a minigame set in the figure of Dani DaOrtiz.", "short_description": "This application brings you closer, through a unique experience, to the artistic life of Illusionist Dani DaOrtiz."}]}, "developer_name": null, "developer_privacy_policy_url": "https://magixgames.com/pri2.php", "developer_terms_of_service_url": null, "publisher_name": "Magixgames", "support_website_url": "https://magixgames.com/soporte.php", "website_url": "https://magixgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24451779971130822"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300574_1082047204092804_3751063698714064924_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHVJfTjG1hUQ7kNvwHPAMeJ&_nc_oc=AdnNN677x8lQG7KKJjmJS0uC-jX3nghTpKMm_0NDyYFKVrlQNf4_v8rwphgJJu3Ixdc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTcfeCG5A50o7-zzcHy2pnvVYPgr_soW0Aj3PLOl_Vdw&oe=69B6B6F9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Magix  by
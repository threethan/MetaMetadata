ent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-7M3NhJhoFDYHW5y3P3h61U1w8eyl1vpXA504Rq9l-Q&oe=6B0F0602"}, {"file_name": "5.png", "id": "1083864624684629", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824671_1083864631351295_7505264191287183546_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njGqo6NnjTwQ7kNvwG5mg0M&_nc_oc=AdrCl3A_aw1U-BhgcKZnj7y0lxXP9lLuUKCY3Fvwa-rBc_uh9nFHq1p2Za9omK-9nL4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU5r5cGo9nObRVj9K38xbYJ8ZCYxxcCo7CP4GXI6SJQrA&oe=6B0F1F73"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Plundr", "keywords": ["monsters", "fight", "pirate", "multiplayer", "exploration"], "long_description": "# We\u2019re currently hosting open playtests! Join our Discord at [https://discord.gg/eU6zxp8agn] to participate, get free rewards and a unique role \u2694\ufe0f\n\nStart with nothing but a shovel. End as a legend. Dig up rare keys, plunder chests full of loot and slay giant monsters with your friends!\n\n\u26cf\ufe0f **Look for keys** - Explore mysterious islands, fight monsters guarding digging sites and dig up enchanted keys.\n\n{2388281535275899}\n\n\ud83d\udcb0**Plunder epic loot** - Crack open chests to collect powerful weapons, abilities, skins...\n\n{1660059482141904}\n\n\ud83d\udcaa **Grow stronger** - Upgrade your arsenal through a full tech tree.\n\n{1111479891587711}\n\n\ud83d\udc79 **Slay bosses** - Team up and take down massive monsters guarding the rarest treasure.\n\n{4693376944230416}\n\n\ud83c\udf7a **Flex in the tavern** - Show off your loot and your style to prove who's the greatest hunter.", "short_description": "Plundr is a free multiplayer PvE adventure with gorilla movement. Explore mysterious islands, fight the monsters guarding digging sites and dig up enchanted keys. Crack open chests for powerful weapons, abilities and skins, upgrade your arsenal through a full tech tree, and team up with friends to slay giant bosses. Start with nothing but a shovel. End as a legend!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.arianestudios.com/plundr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Atlas V", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "2710427532541308"}, {"id": "528142316460358"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "1214103938448347"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1669730381372796"}]}, "baseline_offer": {"id": "1669730381372796"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795708800, "status": "PUBLISHED", "id": "1669730381372796"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1490763637449041", "version": "0.3.209"}, "id": "1716046279434210", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1214103928448348", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1490763637449041"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": 
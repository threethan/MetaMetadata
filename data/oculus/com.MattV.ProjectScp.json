qnKDN0rfztdYhY8W1nQt4k-51D2HcfIA&oe=69A5762A"}, "display_name": "Scp Experience", "keywords": [], "long_description": "Welcome.You are a test subject in the SCP Foundation\n-Observe\n-Learn\n-Interact\n-Try to survive\n\nScp experience is as immersive vr games player suited with a full body and physics interaction\nbased on famous licensing scp.\n\nThe Foundation is responsible for capturing, containing, and studying various paranormal, supernatural, \nand other mysterious phenomena unexplained by science. \n\nScp experience tests take place on 9 scp:\n\n-Scp096 : The \"Shy Guy\"\n-Scp024 : Game Show of Death\n-scp087 : The Stairwell\n-Scp3199 : Humans, Refuted\n-Scp049 : The Plague Doctor\n-Scp106 : The Old Man\n-Scp173 : The Sculpture\n-Scp1499 : The Gas Mask\n-Scp1529 : King of the Mountain ", "short_description": "Welcome.You are a test subject in the SCP Foundation\n-Observe\n-Learn\n-Interact\n-Try to survive\n\nScp experience is as immersive vr games player suited with a full body and physics interaction\nbased on famous licensing scp.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://veneziamatthieu.wixsite.com/mattv/general-5", "developer_terms_of_service_url": null, "publisher_name": "https://twitter.com/MattVstudios", "support_website_url": null, "website_url": "https://veneziamatthieu.wixsite.com/mattv", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking
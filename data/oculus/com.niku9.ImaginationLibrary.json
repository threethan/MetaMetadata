111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tr55MuMyPUEQ7kNvwG3kJIm&_nc_oc=AdrCMi9Sf5-4AdX0dQjpd4MF-LlImOJW2ZgnsnICAnhQMgunCIAXu104cpDsZhXV_Ko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMTqUf28aoufQEYRQsgWfi8MF-ZvV-4PrP0O2PSwt9AA&oe=6AAAB907"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c84.png", "id": "900212777226860", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57568683_900212780560193_8653184988666906583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxDz6BN_QUoQ7kNvwG4PX81&_nc_oc=AdpirEjEVWXA4e30f-ya8rCfI94yUdmhQ2iAJAuhG00xT5r7qv-hWqzao0yIu1pLa2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm7zFs21G70Fk04Jvcz4CIsDLrQN3B1HkmBWfJHTC2IQ&oe=6AAA931B"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c85.png", "id": "183732613675700", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031593_183732617009033_5192731261301513668_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tjl4nkmGegQ7kNvwENvgra&_nc_oc=AdpsrFKcSF8i03Y7XO_d1Y_6Vy2jLO3lSrgENjvjL3RIL3KpIRs41zkoq9zf9_WfCbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLl2qyYP_RJ3a2Bexra9w0bzV1BRGTHsedpcmGa0nkAQ&oe=6AAAA475"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Imagination Library", "keywords": [], "long_description": "The Imagination Library is a library that exists in a virtual space.\nIt is a space that represents the \"accumulation of knowledge,\" like a combination of a modern library and a museum.\n\nWhen the physical constraints disappear.\nWhen physical constraints disappear, do we no longer need the real thing?\nWill information become \"knowledge\" as it is?\n\nIn order to obtain \"knowledge\" from the vast amount of information\nIn order to obtain knowledge from a vast amount of information, isn't it rather necessary to have entities in virtual space?\n\nWith this in mind, we have been exhibiting our work in various ways.\nThis application is a VR exhibition of the Imagination Library.", "short_description": "The Imagination Library is a library that exists in a virtual space.\n\nThere are moving yokai, skeletal specimens, and paintings on display.\nListen to the different cries of each and every yokai!"}, {"images": {"nodes": []}, "id": "1200491413730439", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5e7b\u60f3\u56f3\u66f8\u9928", "keywords": [], "long_description": "\u5e7b\u60f3\u56f3\u66f8\u9928\u306f\u4eee\u60f3\u7a7a\u9593\u306b\u5b58\u5728\u3059\u308b\u56f3\u66f8\u9928\u3067\u3059\u3002\n\u73fe\u4ee3\u306e\u56f3\u66f8\u9928\u3068\u535a\u7269\u9928\u3092\u5408\u308f\u305b\u305f\u3088\u3046\u306a\u3001\u300c\u77e5\u306e\u96c6\u7a4d\u300d\u3092\u3042\u3089\u308f\u3059\u7a7a\u9593\u3067\u3059\u3002\n\n\u7269\u7406\u7684\u306a\u5236\u7d04\u304c\u306a\u304f\u306a\u3063\u305f\u3068\u304d\u3001\n\u5b9f\u4f53\u306f\u4e0d\u8981\u306b\u306a\u308b\u306e\u304b\u3001\n\u60c5\u5831\u306f\u3001\u60c5\u5831\u306e\u307e\u307e\u300c\u77e5\u300d\u3068\u306a\u308b\u306e\u304b\u3002\n\n\u81a8\u5927\u306a\u60c5\u5831\u304b\u3089\u300c\u77e5\u300d\u3092\u5f97\u308b\u305f\u3081\u306b\u306f\u3001\n\u3080\u3057\u308d\u4eee\u60f3\u7a7a\u9593\u306b\u304a\u3044\u3066\u3053\u305d\u3001\u5b9f\u4f53\u304c\u5fc5\u8981\u3067\u306f\u306a\u3044\u304b\u3002\n\n\u305d\u3093\u306a\u601d\u3044\u304b\u3089\u69d8\u3005\u306a\u624b\u6bb5\u3067\u306e\u5c55\u793a\u3092\u884c\u3063\u3066\u304a\u308a\u3001\n\u3053\u306e\u30a2\u30d7\u30ea\u306f\u5e7b\u60f3\u56f3\u66f8\u9928VR\u5c55\u3068\u306a\u308a\u307e\u3059\u3002", "short_description": "\u5e7b\u60f3\u56f3\u66f8\u9928\u306f\u4eee\u60f3\u7a7a\u9593\u306b\u5b58\u5728\u3059\u308b\u56f3\u66f8\u9928\u3067\u3059\u3002\n\n\u52d5\u304f\u5996\u602a\u305f\u3061\u3084\u3001\u9aa8\u683c\u6a19\u672c\u3001\u7d75\u306a\u3069\u304c\u5c55\u793a\u3057\u3066\u3042\u308a\u307e\u3059\u3002\n\u4e00\u4f53\u4e00\u4f53\u7570\u306a\u308b\u3001\u59
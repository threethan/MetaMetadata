ddneeoynEp7JBEg3enGvCaVkqBC0WJJjLYFkQ&oe=6A7DB2DC"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c82.png", "id": "4093335500746069", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572943_4093335504079402_5477407564442959095_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fe9GD3hD5lIQ7kNvwHNhg_T&_nc_oc=AdoP3EGvSUDl_UvCz3Yzc7i-KvrFprqbpbt-dj7lPtIiq1Rv6oLuSeoqIqeiIjhZ4Lg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH17EU3WuQnA049PGB8CsIRmK6spZQZJrJnWteo3lZA4A&oe=6A7DB361"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c83.png", "id": "871238020404428", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982459_871238023737761_5320790823629876269_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6fTUGzrkREQ7kNvwGXJiGg&_nc_oc=AdpSaWlJUxEU7CuXF8bxaG7I6juK0rEWu2f7TIXHVAiWD1-uYRU7O3ZQ5VsMKLulmv8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkXoLDpsa9SoTKSDpzT87QDMgzVHPARje7drhOeJPVmQ&oe=6A7DADC7"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c84.png", "id": "900212777226860", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57568683_900212780560193_8653184988666906583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0kq2z2_JTG8Q7kNvwEz2V0g&_nc_oc=AdoQqF97c8wbmi5OBboOfLpwA_flegor1mIXEphhZ5W-R2iGozqPfB4A4hiiKjy_8WM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpHzMcYAErUGim49Ipa3SNuTgv34ZV9O2uU6oj8LJdoQ&oe=6A7DC01B"}, {"file_name": "\u30b9\u30af\u30ea\u30fc\u30f3\u30b7\u30e7\u30c3\u30c85.png", "id": "183732613675700", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031593_183732617009033_5192731261301513668_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvdDaqvyCDUQ7kNvwHFJZRA&_nc_oc=AdqR_g6EGEltuwBPA4ozIB4nqNH2P91yAyX_cbmrU1VT7R1JFPF9O9swec_Q1BnTuHM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPK0MHm8vlzQ6HVaz1kg3G2yDJKwsHOG5GejjU0h7L7Q&oe=6A7D9935"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Imagination Library", "keywords": [], "long_description": "The Imagination Library is a library that exists in a virtual space.\nIt is a space that represents the \"accumulation of knowledge,\" like a combination of a modern library and a museum.\n\nWhen the physical constraints disappear.\nWhen physical constraints disappear, do we no longer need the real thing?\nWill information become \"knowledge\" as it is?\n\nIn order to obtain \"knowledge\" from the vast amount of information\nIn order to obtain knowledge from a vast amount of information, isn't it rather necessary to have entities in virtual space?\n\nWith this in mind, we have been exhibiting our work in various ways.\nThis application is a VR exhibition of the Imagination Library.", "short_description": "The Imagination Library is a library that exists in a virtual space.\n\nThere are moving yokai, skeletal specimens, and paintings on display.\nListen to the different cries of each and every yokai!"}, {"images": {"nodes": []}, "id": "1200491413730439", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5e7b\u60f3\u56f3\u66f8\u9928", "keywords": [], "long_description": "\u5e7b\u60f3\u56f3\u66f8\u9928\u306f\u4eee\u60f3\u7a7a\u9593\u306b\u5b58\u5728\u3059\u308b\u56f3\u66f8\u9928\u3067\u3059\u3002\n\u73fe\u4ee3\u306e\u56f3\u66f8\u9928\u3068\u535a\u7269\u9928\u3092\u5408\u308f\u305b\u305f\u3088\u3046\u306a\u3001\u300c\u77e5\u306e\u96c6\u7a4d\u300d\u3092\u3042\u3089\u308f\u3059\u7a7a\u9593\u3067\u3059\u3002\n\n\u7269\u7406\u7684\u306a\u5236\u7d04\u304c\u306a\u304f\u306a\u3063\u305f\u3068\u304d\u3001\n\u5b9f\u4f53\u306f\u4e0d\u8981\u306b\u306a\u308b\u306e\u304b\u3001\n\u60c5\u5831\u306f\u3001\u60c5\u5831\u306e\u307e\u307e\u300c\u77e5\u300d\u3068\u306a\u308b\u306e\u304b\u3002\n\n\u81a8\u5927\u306a\u60c5\u5831\u304b\u3089\u300c\u77e5\u300d\u3092\u5f97\u308b\u305f\u3081\u306b\u306f\u3001\n\u3080\u305
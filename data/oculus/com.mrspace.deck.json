O7ugR6pYpBrgjNV3kNdbWwlxcY5pSjEGN8frKj6r6d0QKZtBmTQ7rwSAs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmYfiGG0pmb2MoEhbyS2A-Xf0qwOp3lG5TTVLTbn1Dnw&oe=6B09B8CE"}, {"file_name": "com.mrspace.deck-20261107-170657_edited_1794092846816.png", "id": "1143214004861549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499313069_1143214008194882_9149988282516391261_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ5VLZlOWkUQ7kNvwE4faiJ&_nc_oc=AdoePuRTY-RNrKYk7ryTq1ggQUKlsMKYdxkH3c29Am2tQZTJ9KCJqCYy9OGh4BEvFUQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9X8Ib0nt0q9v1B4wqy6sB7WEjzF4ceYHIORLwT9SWpQ&oe=6B099B6D"}, {"file_name": "com.mrspace.deck-20261107-171415_edited_1794093302843.png", "id": "1151931974039535", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312068_1151931977372868_3770955252299948329_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eefWR8LWVJ4Q7kNvwH_bJdy&_nc_oc=AdodCb1XT-Bqg9xTVDstjZVYCRKKWR-ixDWiRZ489pAkFyFGATSL3_XixSyTyoVd6jQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlFkjU14EGIDoWcN8n491vgPOjnHKG2qQ-RvbtRMoLoA&oe=6B09BBB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WraithDesk", "keywords": ["MultiMonitor", "Productivity", "PcStreaming"], "long_description": "Bring your Windows PC into your space with WraithDesk, a mixed-reality workspace for Meta Quest.\n\nArrange floating screens around you, place them where they\u2019re comfortable, and keep your real surroundings visible through passthrough. Work, browse, watch, and control your PC from a setup that feels like yours.\n\nMake your workspace your own:\n- Move, resize, rotate, and dock screens.\n- Use controllers or hand tracking to interact.\n- Type with the virtual keyboard and access shortcuts from the hotkey deck.\n- Customize your workspace with themes, colors, and sound-reactive lighting.\n- Optionally forward your headset microphone to your PC.\nWraithDesk connects to its Windows companion over your local network using a pairing process. A Windows PC with a supported hardware video encoder and the free WraithDesk PC companion are required. Additional independent Windows desktops require separately configured virtual-display software.", "short_description": "Bring your Windows PC into mixed reality with floating screens, hand tracking, and customizable controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://insnzmb.github.io/WraithDesk/privacy.html", "developer_terms_of_service_url": "https://insnzmb.github.io/WraithDesk/terms.html", "publisher_name": "Insane Zombie Studio", "support_website_url": "https://github.com/Insnzmb/WraithDesk/discussions", "website_url": "https://github.com/Insnzmb/WraithDesk", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1361456000392766"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1834259327695005"}]}, "baseline_offer": {"id": "1834259327695005"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794857880, "status": "PUBLISHED", "id": "1834259327695005"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1382410094964023", "version": "0.41.0"}, "id": "1099413702731796", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1350462318158801", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1382410094964023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1099413702731796"}]}, "change_log": "WraithDesk 0.41.0\r\nHighlights since 0.40.5\r\n\r\nUpdate the Windows PC companion to 0.31.32 to use the new deck features.\r\n\r\n- Redesigned the Stream Deck with a physical keypad appearance, raised keys and clearer icons.\r\n- Keep the keyboard and Stream Deck open together, with independent placement and movement.\r\n- Customize the deck's rows and columns from 1 to 30 visible keys. Additional actions remain on extra pages.\r\n- Choose per-key colours, a solid colour, rainbow colours or matching workspace lighting.\r\n- Added horizontal and vertical slider keys for PC volume, PC sound in the headset, WraithDesk screen brightness and compatible plugin actions.\r\n- Configure custom icons, folders, profiles and automatic profile switching for the active Windows app, with live key feedback.\r\n- Create shortcuts and key sequences, open apps, run script files and add community-created WraithDesk plugins from the PC companion.\r\n- Added a keyboard Show / hide keys tab. Green means shown; red means hidden. Toggle individual keys, the numpad, the six navigation keys and function-key groups.\r\n- Move wrist bands using grip. Hold grip and trigger together, then use the stick to rotate screens, Settings, the keyboard and the deck.\r\n- Double-tap or double-click a watch to return its screen to the default watch position. The connecting line is hidden while attached and visible when detached.\r\n- Fixed depth conflicts that allowed rear-screen effects or screen content to show through foreground screens, the keyboard and deck keys.\r\n- Improved virtual-display setup, display removal and recovery after interrupted connections or PC restarts.\r\n- Improved saved settings, keyboard input, audio recovery and cancellation of interrupted controls.\r\n- Moved Connect a headset to the top of the PC companion's main controls.", "created_date": 1795278610, "id": "1382410094964023", "version": "0.41.0", "version_code": 191, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1350462318158801", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1382410094964023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1099413702731796"}]}, "change_log": "# WraithDesk Quest \u2014 changelog\r\n\r\n## 0.40.5 \u2014 with PC 0.31.6 (current)\r\n- Late replies from a paused or sleeping PC are ignored, so they cannot wake it, replace the current screens or cancel a newer request.\r\n- Screens recover correctly after resume or disconnect, including secondary PCs; queued app moves no longer fire after focus is lost.\r\n- Malformed display data is rejected without clearing the screen list; high refresh rates and off-origin monitors are kept.\r\n- Replacing a disconnected gamepad now works.\r\n\r\n## 0.40.4\r\n- The discovered-PC list keeps its buttons during status and PIN updates.\r\n- Nested menu bubbles keep an 8 px gap across the 0.85\u20131.15 size range.\r\n- Scan or Load resumes after the room (Spatial Data) permission is granted, with clear denial messages.\r\n- Visible focus outlines on theme buttons, toggles, selectors and fields.\r\n\r\n## 0.40.2 \u2014 with PC 0.31.5\r\n- Grip a screen, push it into another screen from the same PC, release on the green hint: both monitors' app windows tile together.\r\n- Undo last combine from Workspace > Apps; combined windows can be pulled out again.\r\n- App catalog fixes: full per-PC app lists, queued commands, both grip/trigger orders, hidden-owner windows, minimum window sizes.\r\n\r\n## 0.40.1 \u2014 with PC 0.31.3\r\n- App pull-out: hold grip then trigger inside an app window and pull at least 12 cm.\r\n- Workspace > Apps picks running windows per PC; whole app windows move to virtual screens and can be returned.\r\n\r\n## 0.40.0 \u2014 with PC 0.31.2\r\n- New nested bubble interface: Workspace, Sound & light, and Controls.\r\n- Screen action wheel for move, resize, position and screen tools.\r\n- Matching Quick Bar islands, keycap lighting, and updated onboarding and tutorial.\r\n\r\n## 0.39.2 \u2014 with PC 0.31.1\r\n- Typing focus now changes only on click, wheel or real physical input; hover no longer switches keyboard destination.\r\n- Focus changes release drags and key repeat while each PC keeps its own connection; stationary rays recover after reconnection.\r\n\r\n## 0.39.0 \u2014 with PC 0.31.0\r\n- Multi-PC workspaces: up to four computers, each screen feeding input to the PC that owns it.\r\n- Keyboard and hotkeys follow the last clicked PC; the spacebar shows the typing destination.\r\n- Separate gamepad PC selector, independent of desktop clicks.\r\n\r\n## 0.38.2 \u2014 with PC 0.31.0\r\n- Fixed the decoder-layout rejection that could leave secondary and portrait monitors reconnecting.\r\n- Handles padded and truncated YUV buffers correctly; genuinely truncated frames are still rejected.\r\n\r\n## 0.38.1 \u2014 with PC 0.31.0\r\n- HEVC decoding, negotiated automatically when the headset and PC both pass hardware checks.\r\n- Automatic H.264 fallback for older PCs or failed HEVC streams; the active codec is shown in the Quick Bar.\r\n\r\n## 0.38.0 \u2014 with PC 0.30.10\r\n- Focus Mode: bring one screen forward, dim the rest, then restore its exact placement.\r\n- Quick Bar: screen picker, reconnect, volume, brightness, layouts, Screens and Keyboard.\r\n- Adjustable desk passthrough window (Settings > Controls > Hands & room), session-only and off by default.\r\n\r\n## 0.37.46 \u2014 with PC 0.30.10\r\n- Terms and privacy readable in Settings > Help > About.\r\n- Tutorial covers index-finger typing, Backspace repeat, keyboard/hotkey controls and hand toggling.\r\n- Failed PC network/TLS requests release pending display and rotation state and offer trusted reconnection.\r\n\r\nNot listed: development builds 0.37.47\u20130.37.57, 0.39.1 and 0.40.3 have no separate published notes. 0.39.1 is only referenced as advertising encoder capability to the PC companion.", "created_date": 1794859920, "id": "1373013909236975", "version": "0.40.5", "version_code": 157, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1350462318158801", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1382410094964023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1099413702731796"}]}, "change_log": null, "created_date": 1794424110, "id": "1363350680203298", "version": "0.37.46", "version_code": 134, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1350462318158801", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1382410094964023"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1099413702731796"}]}, "change_log": null, "created_date": 1794088371, "id": "1355665564305143", "version": "0.37.22", "version_code": 110, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
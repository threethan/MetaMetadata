fYBu_L6vo7TPzXJ05T1U72uJp55t-V4LVO9rnYuI7BcaYoKi-aT58si78&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzOGD882r0Q7RSuOGHlQKVUHyRKpkDoil3ztKt0S9Sqw&oe=6B03214E"}, {"file_name": "com.mrspace.deck-20261107-170657_edited_1794092846816.png", "id": "1143214004861549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313069_1143214008194882_9149988282516391261_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyOAegy7DrcQ7kNvwFxLVCb&_nc_oc=AdolJQwHDySwveuT4QQw7X3o19suhDrB6r1g9reLSduMRD-NCAJHMGsy7vu-H0GUEc4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG5D6OkrEm72r0tLMlrCGAgQQQE7yluwumEQxmqjdzXQ&oe=6B0303ED"}, {"file_name": "com.mrspace.deck-20261107-171415_edited_1794093302843.png", "id": "1151931974039535", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312068_1151931977372868_3770955252299948329_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dywx8pT41ZoQ7kNvwFitsnC&_nc_oc=Adq_6kmN1aG8rYWKkVOctEoBzMCXrwGp-DVVnuiuNUPs_JxwLRE-pD8FPCUKFmWenAM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhL3rTCpeloEOEkBAZO5dmHH4sO97g3T0eqmTupdRN2g&oe=6B032435"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "WraithDesk", "keywords": ["MultiMonitor", "Productivity", "PcStreaming"], "long_description": "Bring your Windows PC into your space with WraithDesk, a mixed-reality workspace for Meta Quest.\n\nArrange floating screens around you, place them where they\u2019re comfortable, and keep your real surroundings visible through passthrough. Work, browse, watch, and control your PC from a setup that feels like yours.\n\nMake your workspace your own:\n- Move, resize, rotate, and dock screens.\n- Use controllers or hand tracking to interact.\n- Type with the virtual keyboard and access shortcuts from the hotkey deck.\n- Customize your workspace with themes, colors, and sound-reactive lighting.\n- Optionally forward your headset microphone to your PC.\nWraithDesk connects to its Windows companion over your local network using a pairing process. A Windows PC with a supported hardware video encoder and the free WraithDesk PC companion are required. Additional independent Windows desktops require separately configured virtual-display software.", "short_description": "Bring your Windows PC into mixed reality with floating screens, hand tracking, and customizable controls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://insnzmb.github.io/WraithDesk/privacy.html", "developer_terms_of_service_url": "https://insnzmb.github.io/WraithDesk/terms.html", "publisher_name": "Insane Zombie Studio", "support_website_url": "https://github.com/Insnzmb/WraithDesk/discussions", "website_url": "https://github.com/Insnzmb/WraithDesk", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1361456000392766"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1834259327695005"}]}, "baseline_offer": {"id": "1834259327695005"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794857880, "status": "PUBLISHED", "id": "1834259327695005"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1373013909236975", "version": "0.40.5"}, "id": "1099413702731796", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1350462318158801", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1373013909236975"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1099413702731796"}]}, "change_log": "# WraithDesk Quest \u2014 changelog\r\n\r\n## 0.40.5 \u2014 with PC 0.31.6 (current)\r\n- Late replies from a paused or sleeping PC are ignored, so they cannot wake it, replace the current screens or cancel a newer request.\r\n- Screens recover correctly after resume or disconnect, including secondary PCs; queued app moves no longer fire after focus is lost.\r\n- Malformed display data is rejected without clearing the screen list; high refresh rates and off-origin monitors are kept.\r\n- Replacing a disconnected gamepad now works.\r\n\r\n## 0.40.4\r\n- The discovered-PC list keeps its buttons during status and PIN updates.\r\n- Nested menu bubbles keep an 8 px gap across the 0.85\u20131.15 size range.\r\n- Scan or Load resumes after the room (Spatial Data) permission is granted, with clear denial messages.\r\n- Visible focus outlines on theme buttons, toggles, selectors and fields.\r\n\r\n## 0.40.2 \u2014 with PC 0.31.5\r\n- Grip a screen, push it into another screen from the same PC, release on the green hint: both monitors' app windows tile together.\r\n- Undo last combine from Workspace > Apps; combined windows can be pulled out again.\r\n- App catalog fixes: full per-PC app lists, queued commands, both grip/trigger orders, hidden-owner windows, minimum window sizes.\r\n\r\n## 0.40.1 \u2014 with PC 0.31.3\r\n- App pull-out: hold grip then trigger inside an app window and pull at least 12 cm.\r\n- Workspace > Apps picks running windows per PC; whole app windows move to virtual screens and can be returned.\r\n\r\n## 0.40.0 \u2014 with PC 0.31.2\r\n- New nested bubble interface: Workspace, Sound & light, and Controls.\r\n- Screen action wheel for move, resize, position and screen tools.\r\n- Matching Quick Bar islands, keycap lighting, and updated onboarding and tutorial.\r\n\r\n## 0.39.2 \u2014 with PC 0.31.1\r\n- Typing focus now changes only on click, wheel or real physical input; hover no longer switches keyboard destination.\r\n- Focus changes release drags and key repeat while each PC keeps its own connection; stationary rays recover after reconnection.\r\n\r\n## 0.39.0 \u2014 with PC 0.31.0\r\n- Multi-PC workspaces: up to four computers, each screen feeding input to the PC that owns it.\r\n- Keyboard and hotkeys follow the last clicked PC; the spacebar shows the typing destination.\r\n- Separate gamepad PC selector, independent of desktop clicks.\r\n\r\n## 0.38.2 \u2014 with PC 0.31.0\r\n- Fixed the decoder-layout rejection that could leave secondary and portrait monitors reconnecting.\r\n- Handles padded and truncated YUV buffers correctly; genuinely truncated frames are still rejected.\r\n\r\n## 0.38.1 \u2014 with PC 0.31.0\r\n- HEVC decoding, negotiated automatically when the headset and PC both pass hardware checks.\r\n- Automatic H.264 fallback for older PCs or failed HEVC streams; the active codec is shown in the Quick Bar.\r\n\r\n## 0.38.0 \u2014 with PC 0.30.10\r\n- Focus Mode: bring one screen forward, dim the rest, then restore its exact placement.\r\n- Quick Bar: screen picker, reconnect, volume, brightness, layouts, Screens and Keyboard.\r\n- Adjustable desk passthrough window (Settings > Controls > Hands & room), session-only and off by default.\r\n\r\n## 0.37.46 \u2014 with PC 0.30.10\r\n- Terms and privacy readable in Settings > Help > About.\r\n- Tutorial covers index-finger typing, Backspace repeat, keyboard/hotkey controls and hand toggling.\r\n- Failed PC network/TLS requests release pending display and rotation state and offer trusted reconnection.\r\n\r\nNot listed: development builds 0.37.47\u20130.37.57, 0.39.1 and 0.40.3 have no separate published notes. 0.39.1 is only referenced as advertising encoder capability to the PC companion.", "created_date": 1794859920, "id": "1373013909236975", "version": "0.40.5", "version_code": 157, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1350462318158801", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1373013909236975"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1099413702731796"}]}, "change_log": null, "created_date": 1794424110, "id": "1363350680203298", "version": "0.37.46", "version_code": 134, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1350462318158801", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1373013909236975"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1099413702731796"}]}, "change_log": null, "created_date": 1794088371, "id": "1355665564305143", "version": "0.37.22", "version_code": 110, "release_status": "PENDING", "status": "CHANGES_REQUESTED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGQ5xHysQToQ7kNvwFucQcH&_nc_oc=AdrvTakaxFN4bRDEW_ZiFRaljk4hBTFcjQfo22T315wDhfrtb_TOAvvaC87sTCaXQ88&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2p1ol-6eElGvEouf8xuz1q_Ur7zcXEznDCdKI0ozGYw&oe=6AFB220A"}, {"file_name": "buying ticket.png", "id": "1728651388380369", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/507819001_1728651391713702_4144745853506312820_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr_X-m8CNIMQ7kNvwEUEZ5Z&_nc_oc=AdorStzxZnAuLM0xP4esLgMRAy0MQtwiHFx2koMtzhUkAjg_6fIgWxh5tt1HcqjTKiw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoRh1l1lSRyu3kLshREesnS6qsTjB-yTVGscPsQ3YAFg&oe=6AFB30E2"}, {"file_name": "clearing customs-1.png", "id": "894348669960117", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595112037_894348673293450_8792703047756438169_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N11MSvCTsOcQ7kNvwE-w61E&_nc_oc=Adq12p6e0da8GKdMhgBQuxaePan126ROyw8PuIMSbXlx-mln0UwrcGjbJC6SMzjTfYI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTweeXSVZjdus7t7bFCF24CTm3oglYnBBolUHLaaGEl8g&oe=6AFB3FEB"}, {"file_name": "main hall.png", "id": "1042581802030165", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619685_1042581805363498_4588803518134689243_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tsOjFAbwpsQ7kNvwH23LwD&_nc_oc=AdoP1eizEKY3bAftEPfYxXxlPquivzdyxsbH3zZl606rCdrJ8Nj4jvSun95ppAm6ruI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiRcDBrMfLnuXClchE5DIJ0-2hECSHbdHoaKkSN0_hSw&oe=6AFB3DF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "2443580722835845", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499314648_2443580726169178_1883123710747365323_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MUetWOpdeQQ7kNvwFq9h8s&_nc_oc=AdqDhb75tFPtN0zePTsmb8bxxS_JOfjZ49vWrk3t2GfAsRfO4OA3Jmoh-NVWs6lgMqY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpm_Z7cbva3NZOXaj8NWbXJf-vkHOgsckb8mMNLOnYCw&oe=6AFB1E7D"}, "display_name": "Journey 1969: Tanjong Pagar Station", "keywords": ["Railway", "Education", "History", "Singapore", "Travel"], "long_description": "**Relive a Lost Era of Rail Travel**\n\nTanjong Pagar Railway Station was more than a transit point. It was a place of arrivals and departures, reunions and farewells, connecting Singapore to the rest of the Malay Peninsula.\n\nThis VR experience transports you back to the 1960s, when the station was filled with travellers, vendors, station staff, and families sending off their loved ones.\n\nUsing archival materials and historical records, the station\u2019s Art Deco architecture, sights, sounds, and atmosphere have been carefully recreated to bring this iconic space back to life.\n\n\n**Choose from two ways to experience the station:**\n\n- **Story Mode**\n\nFollow the journey of a first-time traveller setting off on an adventure, guided by a narrative that brings the station\u2019s history to life.\n\n\n- **Free Exploration Mode**\n\nWander through the station at your own pace, discover its spaces, and take in the atmosphere without following a set path.\n\nBuilt in 1932 and conserved today as a national monument, Tanjong Pagar Railway Station remains an important part of Singapore\u2019s heritage and collective memory.\n\nThis experience pays tribute to the romance of cross-border rail travel and the generations of Singaporeans and Malaysians whose journeys began here.\n\nDownload the app for free on the Meta Quest Store and step back in time.", "short_description": "Step back in time and experience Tanjong Pagar Railway Station when it was a grand and bustling gateway between Singapore and Malaysia.\n\n \n\nThis immersive VR experience transports you to the station in its 1960s heyday. Marvel at its iconic Art Deco architecture, take in the energy of the diverse crowds, and relive the lost romance of cross-border rail travel. Follow an engaging story as a first-time traveller, or explore the terminal freely at your own pace."}]}, "developer_name": "Vthere", "developer_privacy_policy_url": "https://nhbplay.io/journey-1969/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "NHB Organisation Design and Innovation", "support_website_url": null, "website_url": "http://nhbplay.io/journey-1969", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1305896739272576"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622211_1361947356026563_7764459996512820820_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RB9e6WH64G8Q7kNvwGcHb1r&_nc_oc=AdoFjJ9zNnXztGA5vH21T8s3fyg2po8UMuBfkG5FU3CFutLMGjocrecB6pihkkxqTks&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHCPO-wd94myCKRXbuHvSHZxyLDTehDaWgAMK9kaHTdg&oe=6AFB49F3"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Journey 1969: Tanjong Pagar Station", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 17869
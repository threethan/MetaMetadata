MI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvW_HKqFJmYetS2WELtD2PCPvDR-F0lf7Y6vYJrvqV3w&oe=6AFF134A"}, {"file_name": "Screenshot_5_VibrantForest_2560x1440.png", "id": "2027510534586999", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491827585_2027510537920332_7666308391295298309_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkcJ8Sa7V6EQ7kNvwF_L8ri&_nc_oc=AdqvQDUAscslf6bzu9qdMSz2IRgmaQ52g-vkwFCdFoPPAtSSx3buoNDH5z7uZ6mjIDQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-T5shdYqW_Y6ZQMkmt22uqvpzWIvChzRST7VYGqPecg&oe=6AFF0194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Passthrough Color Studio & Night Vision", "keywords": ["passthrough", "nightvision", "color", "colorgrading", "mixedreality"], "long_description": "**Passthrough Color Studio** gives you direct, real-time control over your Meta Quest color passthrough image. Customize how you see your physical surroundings using color grading, low-light visual enhancement, and real-time edge outlines.\n\n### Key Modes & Features:\n* **Night Vision Mode:** Enhances visibility in dim environments using a custom phosphor-green 3D Color LUT.\n* **Live Color Grading Controls:** Fine-tune **Brightness**, **Contrast**, and **Saturation** in real time to brighten dark rooms, boost vibrancy, or create a clean monochrome look.\n* **Hardware Edge Detection & Custom Outline Colors:** Highlight physical objects, walls, and furniture in your room with real-time glowing edge outlines and customize the outline color (Neon Green, Cyan, Red, Gold, White.\n* **Clean Floating Studio HUD:** Adjust sliders effortlessly in mixed reality, reset to normal passthrough with a single click, or hide the control panel to enjoy an unobstructed view of your space.", "short_description": "Transform your real-world view in real time with Passthrough Color Studio. Switch between Night Vision and live Custom Color Grading\u2014fine-tuning brightness, contrast, saturation, and glowing edge outlines with customizable colors in mixed reality."}]}, "developer_name": "Passthrough Studio", "developer_privacy_policy_url": "https://github.com/justme228/passthrough-color-studio/blob/main/PRIVACY_POLICY.md", "developer_terms_of_service_url": null, "publisher_name": "Passthrough Studio", "support_website_url": null, "website_url": "https://github.com/justme228/passthrough-color-studio", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1509681478884728"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491828008_1824132352067231_1400463494743570153_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJQzB81TULAQ7kNvwH9m7Zl&_nc_oc=Adr4IdfgZGy7KxV4i8GJkLNOiQaucWwJcVcVCgGajXBwegxMe3tMZZfPFzAPh1VzyIk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrmn_QneHi-XGzroSEkFwhi4Yi_OwYOvO0VfK_VSXfQw&oe=6AFF0F9C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Passthrough Color Studio & Night Vision", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Creativity", "
7OWbGwkWeldicyDaxEasVFydIYqbB8gtnpg&oe=6A974DE2"}, {"file_name": "02_meta_no_empty_edges_v3_4DShapes_Meta_Screenshot_27_tesseract_88596_2560x1440.png", "id": "1549695146790875", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/507840145_1549695150124208_1747623219871768318_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7NYzdXYIyoQ7kNvwGzsXd1&_nc_oc=AdovaSwLwBp14yDcjRUx5KyyqGJptsK-0c8notMEJHd9QkAN-2OWRKmKuLfgPBk92Jc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbG-oUtmgYxdHokN3kaKAdBM0XMyfO9U1GxpfhpgF_iA&oe=6A97516E"}, {"file_name": "01_meta_no_empty_edges_v3_4DShapes_Meta_Screenshot_13_sixteencellhoneycombpreview_96211_2560x1440.png", "id": "27752918440993510", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499313072_27752918454326842_498623090091471143_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHcyKziVT3MQ7kNvwFKIufY&_nc_oc=AdoU_4khW7ns-ASvHdmSJir8NCxz98vP4ikYvNAi1UemM6reLY6iReSkWujRzTk5mcY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxOGu6XIQVIKLwtoKscGImOjik0FLGZdinS9UuHXnMVw&oe=6A972CE1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "4D Shapes", "keywords": [], "long_description": "4D Shapes is a VR geometry studio and sandbox for exploring higher-dimensional forms.\n\nCreate recognizable 4D families including tesseracts, polytopes, shells, honeycombs, smooth manifolds, and experimental shapes. Rotate through 4D planes, inspect structure from inside and outside, and use controller-first tools built for headset exploration.\n\nTune each object with face colors, opacity, ramps, edge thickness, vertex size, labels, effects, and presets. Build vivid abstract visuals or keep the geometry clean for study.\n\nUse wander motion, selectable rotation planes, loops, and automation tracks to make shapes move over time. Save favorite configurations, recall environments, and generate local support reports if you need help.\n\n4D Shapes is designed for curious players, artists, educators, math enthusiasts, and anyone who wants to see how 4D forms behave in motion.\n", "short_description": "Explore, style, and animate higher-dimensional shapes in VR. 4D Shapes lets you create tesseracts, polytopes, shells, honeycombs, and smooth manifolds, rotate through 4D planes, tune colors and effects, save presets, and build motion studies with controller-first editing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://4dshapes.com/privacy", "developer_terms_of_service_url": "https://4dshapes.com/terms", "publisher_name": "Dimensional Instruments LLC", "support_website_url": "https://4dshapes.com/support", "website_url": "https://4dshapes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1099981163208332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/507840144_2089190602017952_1875666869688785250_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLyWlnZaMnAQ7kNvwH1HTzq&_nc_oc=Adq5h7b8_7ow4-FjkqNBstbqpK7Q-WKX681nH_TqPFtm2s8-rONGc7lNDh8-GHQkba0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE66ddPSDCESJnXEzivMgCispC-xuv-tREtFBwgcNertQ&oe=6A973599"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name"
_3000x900.png", "id": "1559593282250921", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828050_1559593288917587_2451320405274795926_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wkEFNkxN4kQ7kNvwFa-oag&_nc_oc=AdqvlsPd-9k2w4ZdezVNybvZM7MHKGBjQsU_8NNOE1LxVVHMdCfDK18QtZ8hMvbYxZY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG76xC3HAJ2CzTn4W-Cj86WyDemmszK54n7Z7iDz3qOtQ&oe=6A85B007"}]}, "id": "6160248744591050", "locale": "en_US", "screenshots": [{"file_name": "05_meta_no_empty_edges_v3_4DShapes_Meta_Screenshot_77_sdfsphereslice_62916_2560x1440.png", "id": "2100983787119907", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/595143057_2100983793786573_853354210844527575_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBa4tFkBO9gQ7kNvwGFrYKB&_nc_oc=AdrItpqat_BbsySvMY8OefqhJmmVPcQ1F3HinwtaVA3H-ybkIaFxuyIHGFylV8r9moo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaorkUX1M9Pfy5TSZ09Ibwjv2gEHMG1zqHQaGkc1GQ7A&oe=6A859120"}, {"file_name": "04_meta_no_empty_edges_v3_4DShapes_Meta_Screenshot_63_duocylinder_53141_2560x1440.png", "id": "1639445993786426", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499314660_1639445997119759_1522876981842573045_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bghia_ledp4Q7kNvwGF-kd8&_nc_oc=AdrkDoV8MDxF715drSWbesG2nWkq-D3_ATQiFsCbvudKY7xR_yBWJ1yrJQ4KjWBqDik&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWlwN0Uh5jMRBqBvo-_Dm6M7MQCt4CcyQbfN_DyNGkfg&oe=6A859701"}, {"file_name": "03_meta_no_empty_edges_v3_4DShapes_Meta_Screenshot_28_sixhundredcell_66141_2560x1440.png", "id": "1016521404292309", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/604360590_1016521407625642_3847685833925505636_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8kJ4nitPUUQ7kNvwH37YXo&_nc_oc=AdqxwO1IxIylnSYmcLUooq182sTzAiI6AJo6MXKfWoaTTu9ADzRbw_1_7NrQoyUM3AE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGm1HCuY03eEMVdETEnL3I5eQH9m2VokrsyAm6Ys4CgrQ&oe=6A8581A2"}, {"file_name": "02_meta_no_empty_edges_v3_4DShapes_Meta_Screenshot_27_tesseract_88596_2560x1440.png", "id": "1549695146790875", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507840145_1549695150124208_1747623219871768318_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Dvqirw6pskQ7kNvwEbeMtn&_nc_oc=Ado06Gq7yexljwHz5S-fKCbr-UwHJfnI-CiGlh53DQBWMlsSjf2nmCl7NJ5RhbEb-g8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRD9MzWoKOqgreBW5BvQh0mslVdGRs-szpgvArO0cZlg&oe=6A85852E"}, {"file_name": "01_meta_no_empty_edges_v3_4DShapes_Meta_Screenshot_13_sixteencellhoneycombpreview_96211_2560x1440.png", "id": "27752918440993510", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499313072_27752918454326842_498623090091471143_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQqmCaKBo-8Q7kNvwEM68yY&_nc_oc=AdpamnNHISzOO91-K11XHjv9bXDhg8vz91RTdi6BwYav3CiExfJ0UmJinFk4plQE7Ac&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsyr_WHHzWgxDUBf10RNQ22gWwoQncOnYo6FUqQMuacA&oe=6A8598E1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "4D Shapes", "keywords": [], "long_description": "4D Shapes is a VR geometry studio and sandbox for exploring higher-dimensional forms.\n\nCreate recognizable 4D families including tesseracts, polytopes, shells, honeycombs, smooth manifolds, and experimental shapes. Rotate through 4D planes, inspect structure from inside and outside, and use controller-first tools built for headset exploration.\n\nTune each object with face colors, opacity, ramps, edge thickness, vertex size, labels, effects, and presets. Build vivid abstract visuals or keep the geometry clean for study.\n\nUse wander motion, selectable rotation planes, loops, and automation tracks to make shapes move over time. Save favorite configurations, recall environments, and generate local support reports if you need help.\n\n4D Shapes is designed for curious players, artists, educators, math enthusiasts, and anyone who wants to see how 4D forms behave in motion.\n", "short_description": "Explore, style, and animate higher-dimensional shapes in VR. 4D Shapes lets you create tesseracts, polytopes, shells, honeycombs, and smooth manifolds, rotate through 4D planes, tune colors and effects, save presets, and build motion studies with controller-first editing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://4dshapes.com/privacy", "developer_terms_of_service_url": "https://4dshapes.com/terms", "publisher_name": "Dimensional Instruments LLC", "support_website_url": "https://4dshapes.com/support", "website_url": "https://4dshapes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1099981163208332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507840144_2089190602017952_1875666869688785250_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r74pYSCRlhwQ7kNvwEn8NnE&_nc_oc=Adr8WC_GU_-1cft82A6bBUWLEIcrSYTwwIL2DntgVXV_IVCMeG1l4hMmtOIgWX0VXB0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECl9cJiKHb24KvGZDyg2pGrBQ7doYgy2tm965Gmh9JLA&oe=6A85A199"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
rds": [], "long_description": "4D Shapes is a VR geometry studio and sandbox for exploring higher-dimensional forms.\n\nCreate recognizable 4D families including tesseracts, polytopes, shells, honeycombs, smooth manifolds, and experimental shapes. Rotate through 4D planes, inspect structure from inside and outside, and use controller-first tools built for headset exploration.\n\nTune each object with face colors, opacity, ramps, edge thickness, vertex size, labels, effects, and presets. Build vivid abstract visuals or keep the geometry clean for study.\n\nUse wander motion, selectable rotation planes, loops, and automation tracks to make shapes move over time. Save favorite configurations, recall environments, and generate local support reports if you need help.\n\n4D Shapes is designed for curious players, artists, educators, math enthusiasts, and anyone who wants to see how 4D forms behave in motion.\n", "short_description": "Explore, style, and animate higher-dimensional shapes in VR. 4D Shapes lets you create tesseracts, polytopes, shells, honeycombs, and smooth manifolds, rotate through 4D planes, tune colors and effects, save presets, and build motion studies with controller-first editing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://4dshapes.com/privacy", "developer_terms_of_service_url": "https://4dshapes.com/terms", "publisher_name": "Dimensional Instruments LLC", "support_website_url": "https://4dshapes.com/support", "website_url": "https://4dshapes.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
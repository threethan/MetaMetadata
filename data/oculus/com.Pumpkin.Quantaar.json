ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnGr17aXjJ0Q7kNvwH8-fsy&_nc_oc=AdqCOKGA-Qup-3CdQr-Zp5CzcmW1sAVL6SxLMzM5sy1F0CmLc1QQNS3VNEMrgoFTzpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCbALrDuJhgqD9lEu3FqBF2C18YvAo3_SN9glS44rWkQ&oe=6AEB57A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhU-BIQp5dYQ7kNvwHp2bUR&_nc_oc=AdpPLj6XMn2Zi5JsnoH0SUKh54syHglkm02zmAfquEGcAVKxFtJUCW559TD39npAF_0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOwC407dJlUFSie_k4_5RiWL5VdmY3IFhf7tm_nrfTbQ&oe=6AEB53F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBjDiSbpNMYQ7kNvwEoYtYl&_nc_oc=AdqDeFhdkX6jLQKcKF1rPe7oEHSV-fjwNN5moxV8lxmyMXmGbcnvhHcO3HdafpGA9aE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKrIpJT3sCYMqa4Gez4a4ILrIdDgSu7d-T8wy7zzsZKg&oe=6AEB58A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l492_oUso-cQ7kNvwF9QcxD&_nc_oc=AdoqOj0dKJLD7y_4GH6eWdHe8GYLI11zG9W8snrn3ZRCkvpAXH2LE0RCQWN0RmsHPEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfkt09IpUppu6QLxtmkA0v_EUOiyvQkvVfAIKVc8TlUQ&oe=6AEB581B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JJzD3gIhsEQ7kNvwEmUv97&_nc_oc=AdpZN8MufCK2W0s0Vk_ZVTVBjJkYxHnS8ohj3P6i8t0o8GMy3OjzZKyYtSLmJGf_D3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT20-K1wUq-PduW1wWB8iuW0DQZDyjg1vouaFiivfRcKA&oe=6AEB4370"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8d5LWMv1nsQ7kNvwHjWDQ1&_nc_oc=AdrgQ-XJU7J1renPCTlJCEghhjFynwGJrwW7MzW3UI1dLCPaTUv2CXY1TZEUZFD3Yeg&_nc_zt=3&_nc_ht=scontent-ia
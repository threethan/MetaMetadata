ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaEozI6HayMQ7kNvwEC7EPf&_nc_oc=AdqUcXDfeCUl43pWWIU6CMDnYdCF34mo9RzruuTLrUfeDVUKbpVIwbIAxsJFvlXVzJg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6R60JqvNH5n6MxskHi8PA5IuChogxcM3J6uZ0zp3GG2A&oe=6A070BE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uSyPnvJzMoQ7kNvwGtGb2g&_nc_oc=AdqzQW3aCXj5bYNI9uPOEFtdRFNfAfz97jcBoZRGokxIEjNMeC_nEaaWWEoIOV1ZJvA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5txLIWkl3qPP7es_q21j6ebrLIktffXemQdt3Vk0-Qng&oe=6A074072"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbWcWJ4c7WIQ7kNvwE-gYWj&_nc_oc=AdpvWw8lm6OoPpq8jHKmLRUySWdlaFCEgx-l9CQ_3B3_z3_FyWeTKyEGU2fCN8z7Few&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6APigFUU27-bYsqrdbcBX6TrKix4ujOX8WP8OQ4MB7cw&oe=6A070CE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_URAHZzV-wgQ7kNvwGZXQQD&_nc_oc=AdqFqSQ6qczq2OfUH3YyJMm8X-sagpBUvU7rKf1-CY9RVc2mOe44dzuUJGss_GcnpPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R492NoyQravbes1sjJ0GqJ64TH-ASPhUjDH9-AU7BZg&oe=6A070C5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk-W0Vy7XnkQ7kNvwG3ZpOd&_nc_oc=AdqK4tTIoW1XpYUgFnykbgzyZ6mP8cA9Y_XpqVx1LN6Kq_Z3V-sS5In9xEd8Tjd3U0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af696yg2I3QxWMjgmwZlV9mLUIPU2X7WH_4iczBYPRXNmQ&oe=6A072FF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv8lYEpE7bUQ7kNvwEfJF3K&_nc_oc=AdobBmVklsxa_DdD_ulR144rTL2njGUzosNgKvf8WIlY79bU6ILVgWx2akFZaC2RWWM&_nc_zt=3&_nc_ht=scontent-or
ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1ic6xI5mg4Q7kNvwERSIbn&_nc_oc=AdoYmLAujQPm2lX3wc-lmm6SXIW0RxOPYrDZzx2fuAbgzHuBdV8SO3uaW70FKjdB8jo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfpWigQs1ei7-tWSC3MtINBlSB88aIhP6ZduDD4vsvJg&oe=6A5B6BE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xoCy9KgX2bcQ7kNvwE9szTx&_nc_oc=AdodxN9UD_Hur4ZnksDQ-eIFDXvLpPUb53T1DIbPEUasVCXE4XzgHS8gIV4qEJ0qI7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoLoSFxKAV2XvNatD4q5mnPQTIfqQcNU1w91TGOYFhSw&oe=6A5B6832"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gsaz7xPYRO0Q7kNvwFa-Ms6&_nc_oc=AdoaL8q7x9-EaHPx_hVSHqkLdbrY_qZkD_GCM-P-eByFHFMcVRB4eS-jCgK_OkpEYVI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9njwS-PUgMWVybL2NkHJm4Nzq2WOhtPWHLkKkqKGn5w&oe=6A5B6CE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re3x9pwuwhYQ7kNvwEWwZFT&_nc_oc=AdpYyMaQE6xsB6voZo0Xj18BkEs-zEYGycq5n138iTz293QpeUU04MwpQbPHNiHywMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdt0vc__Z5jxjagY2UyMRByLyo0hmgqmFCkgG7PIx-7g&oe=6A5B6C5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo2ztqnBdtEQ7kNvwHZNDSH&_nc_oc=AdoRYa0DF6v3kOY2R8efxBgX2X8Y3pUsyucxyHizHev3W_vzNCqrNY7GEaEIWJJXopI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnPKMAUxPy8b2OTNlr2J9K-Hnp1nI7fPS_YZsBeozUyw&oe=6A5B8FF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5V7TUmpyN7YQ7kNvwGl0iby&_nc_oc=AdpryPXrrgRVHzMunW2GznjfirdXhs-t5IpIKvitazinGlaTgQLjYMsjYLPOv6MHxpk&_nc_zt=3&_nc_ht=scontent-sj
ri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wunjqj4P4iYQ7kNvwFJlFki&_nc_oc=AdrvEZO2fcDXBWFCJEv02wwjDXvJkzPPbzwMZg1B8g66rDYI9siN29O_1xx__-Lqtog&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K3hlKZt5yC3MqV7kCSlyQhDXv1X-XNfPP1zh4bpXqgQ&oe=6A414627"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LYMmY2kyW0Q7kNvwEYxnNE&_nc_oc=AdpMHmsq2wRxGnQQLeg1Kf_Lvy_VUO2QO5lVqcvmxjURXlyoSaR3QQDWEKLW8uwsyDA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lgGfxUKWA2o5XAvsfY00tbZryuGEGtNSg0T-fAJWkiQ&oe=6A414272"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDxjmh_nbowQ7kNvwF59Wv7&_nc_oc=Ado4Ii-S5uB7R9RywL0jhFZudTIAGcncDObANeoDCr78jvxIwqdpmPBkU83zYZ0Oopk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Kf3Nff-Xk4D-Tj2quTzx5nRSj-HSvju4yzZuHuRGrQA&oe=6A410EE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI2meXmM6eIQ7kNvwFgAbYp&_nc_oc=AdpvpdhS9UdxYLcFbX25Dg9IsnG4OaugcuFgEWtpIAH6PKh379VaudLm8BxGezhye2s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9D8SclIeh1gjen-BsM4ios7J08iStm8mo3wgj_eqEqtg&oe=6A410E5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saJCFI8mBnYQ7kNvwEdTF_i&_nc_oc=AdrhZObSaQBRI-UEFEeWECE8PafqpjUTH47kT9t56B01FmLZ1KJDcmh0Bi6RTskMEE4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MAhiQPA8w3FpsAgtdy8XeE7zme_gt7x7x0enQVnONGg&oe=6A4131F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD05dTPwteEQ7kNvwGq_Tu7&_nc_oc=AdrTQ0rR29WYiCS5HaLpGmAYmvzI13n1J8O9XXj0l9nzWr_dFGUiam8tvVOxSbA09-k&_nc_zt=3&_nc_ht=scontent-at
9", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udB8Blqb4a8Q7kNvwHEz7B0&_nc_oc=AdoiVQIEVY12XGd-KDvmBWBf7zROqn8DomL_SOr3mU9Yq5VfhfZ9Bl96gWUdn8Mkb1g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPeyvLKG-a3S78JxE1Q_r8-z64FIuCMop7veGf5BLXAg&oe=6AA3EE67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO9XUlJr2UwQ7kNvwFa5rwA&_nc_oc=AdpRp4hrFt6Ie2U0kX4g3u-oLLcN2BHr3d-tp3VkUg3FyuokF3_wqUslx8IiXqJihKU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDHAIBsvPp86NpvvuGqPYzsbG1rDlqfDK3rnumAHgp4A&oe=6AA422F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQkvNjuZSrQQ7kNvwHrQOuG&_nc_oc=AdpQV6Ir-GybR5quqdRuRwThXnTJunDhc3oqJL9SiKA07Yo-LHi0QWZBy58atCenS8o&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiwSksIS0vRCx4yrghbjrOUdGCgH32vE5BA2AAV6f8Dw&oe=6AA3EF69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FudyKoYge9EQ7kNvwHNLg-C&_nc_oc=Adp3zEA8f7el_svvtOUHPh3BQEeVvdXcog0V0UysWkbkx_rMlvoN4-CByWafKqq_QjA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILUcLNK2glxwyTRd6C0PHj34pWvARyOsj0ZSx0wF1WiA&oe=6AA3EEDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjx0mPjzf_oQ7kNvwFiBC5U&_nc_oc=AdpDaUwc7LQRXqLZpBXMN9OlTX053LFSbScOcUzA_pNS9OXViotFQfeQQPpeP08Hey8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8Q2X99wTbFN5zG331YxBeb2HqKRaHmEqfgFbC2LOOqA&oe=6AA41270"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYtAA7uiktkQ7kNvwGAAtke&_nc_oc=AdqEVviuamtsIT604sL23I1qjAnNk3yrUPLlhIpW0yonUvfP-LZwOL0JAcb3oD_1ZWM&_nc_zt=3&_nc_ht=
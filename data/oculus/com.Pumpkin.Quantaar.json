ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxUMlnCzxU4Q7kNvwGNJpDv&_nc_oc=AdrcUhpAE8N66-q4GYULWtVDvsi-bQL9Y9yR7OuN0-l2L3JZBAixtAW2_Alz8DNuSL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVsPF-seDyDc27knuagv7E2PIYb7tY0Mr9xryEhYtLTA&oe=6A8C3367"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIGgJag6WEwQ7kNvwGk3n8z&_nc_oc=Adr8OGKzmOfykONtUEoyzAm9nAs9XYgESNuvBTZ2BHhrR2mBYKDIIyLsYjdoW2LWqWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGca54MSCssO-bpAk0xaWogcgB2r5AUwEXHtkrLnVI2Aw&oe=6A8C2FB2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xSkdQb2CpMQ7kNvwF2K6Zh&_nc_oc=Adpj1CmVmXisCwLWnTQXxyGcrCM8lQ6JAMdjUhmewL2uwuWOAnxUxZG9vLmzp1Asg8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzRRMfOzylJQn8P50MDlm5t8nqWElat-whD6HdJZoCqg&oe=6A8C3469"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=246n8-nH1lMQ7kNvwHBHH7p&_nc_oc=AdqklKVYHYSYfzQnRA9_vvij__cHmSuL_ybQzvUMrt0ph9WhnMZ1OenQ5TbamhQkUt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMij8ZyLe8cQu2DnoKHhFbYhF-AX6Xbl4UyxUJUlyMTw&oe=6A8C33DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlezv8TYcmIQ7kNvwHciacp&_nc_oc=AdpHlKSobmZnNJqnVouIj5uagOsZdx2q47rYYjP5dlIPPtCEeDpTWJOcoK-oYoluvEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn-M4rBrxLPO3odBzF9--fl1_-MVC5RWs4abvYdmA3SQ&oe=6A8C1F30"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMfWEA7VHbQQ7kNvwGgwzDh&_nc_oc=AdqrIq1QSNwhSAd8T6PAQZCcDvLX7ypl9Vcf4aM8L4eONmypk59bCumvzKEaqaTG9-E&_nc_zt=3&_nc_ht=scontent-ia
ri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD1miaZV-ioQ7kNvwE-gpIr&_nc_oc=Adp77P9k2R2N5XWiZCnnxGDQ2lRTQ8ClKeKIxaILe0t2IzTrRsE3Ak1JZLp6z1iv0mo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xLSgaRc_ZEDzeJFm932-O2HJ9BjjhNGduxOTa7f_5kg&oe=6A0EF4E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CP-9wOUKgYQ7kNvwFc9fYL&_nc_oc=Adq9K2bgEJJ2bQ-Exmhlbl__pJ3FkAnb2pJoPEjA08oRk3t9te7w_aT99b4hQJ0A0WY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nGO7HTIHixfJW-Rdv-ueq_XMDbvadM70hJxfIqHam4A&oe=6A0F2972"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmDiRrKDws8Q7kNvwF6Vr8v&_nc_oc=AdrWhNTgpFxIt9w3QBzkoBkDb2Bnu8k0WQfMiZ79d6rwjcWjplbZSJZjeUQHdjyVGOQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O4KWXTM8OD7W3FDTNA_ug4q1vuaLPIEgdtcvX-eR7Zg&oe=6A0EF5E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkHvtRvnf0MQ7kNvwFxpZMa&_nc_oc=Adoz1emJPIquiRSkvE2kpkaJAj_AG0-HQQ2_9SDXmWUAYPjSgaQG-Ys05b35gfo0nQ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uBhPUKz0iWBIz1_LJiNu7Cuys0jXd-ZrsnxsusilRrg&oe=6A0EF55B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yQXk7qCSp8Q7kNvwFhEiFQ&_nc_oc=AdptAoBgn7dmENevsC12baE21z-yUpG4BK9mujiCpItuJNpGikzV9F9XS26IFxCN3GM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KB2gw9n3Egoct-FuEAaqFCsVCep-QLy9CJUbMJjWbHQ&oe=6A0F18F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1FCFE5AmI8Q7kNvwGpWK9g&_nc_oc=Ado_m5G3N1rAac7xpScOXFz4Y1-kn0Qz6488LJVxLF0TfyxWwQvmdAkFStC-eO82yAM&_nc_zt=3&_nc_ht=scontent-df
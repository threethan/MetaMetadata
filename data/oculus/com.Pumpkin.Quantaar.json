ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2ENipcN--4Q7kNvwFZ8buG&_nc_oc=AdoTvlov7UgdSqWIyDgu1MTEfXAfQrHdS5WoH8jZ9IABqhTTSbLUzt78nYNfThzhZfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qwV6IJ746Hp-MDG4V_4--IMJ1AGGQt8tDsjddgbJSXg&oe=6A1DADA7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFhIlmdSMHoQ7kNvwGrODza&_nc_oc=Adr50C9epmUvMFrXyKtddPgc2Pnr7y8UBX3JXJhwZtsfuRBPqvR1m3tJ-IZ6lzqJQyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42du8RmW5rLPhbcRJuIA7nEkjSj8I_4TqkkXail8a-2g&oe=6A1DA9F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XJKXkTeiUcQ7kNvwGUQdqG&_nc_oc=Adrz-xETXFkbH0xgy3criV_cqVhms2Fs5K9JuMTKaJimgNd78Azb0Zy7soNdmf3ZnMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56kKPwQh2vyk8WFdWlBOvjZIjo5WeEuLXO2oGfBo5Q4Q&oe=6A1DAEA9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yR6IW3aerTkQ7kNvwGd9ivH&_nc_oc=Adpedu9d7Z1ZR2XHilUVx7qlGR1vWmkU334p5x7No5VWaEpPT4eY3RTi5obNz0iiwnI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Xf947bsKBe-Q68vS_I9Z-zI9OkSX-4EDSllZl3JOTjw&oe=6A1DAE1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8mVXW2wcyMQ7kNvwGNKpse&_nc_oc=AdoE3Sa49suFNWCOfPIaAt_7iLAbO8TDTlHXiapkbGtrb61Omgj8AhNYPyBnnbmzuac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dvVUYudS4CT-Btf6n1X2VTDbuWnmbla0lPPTg7A9czQ&oe=6A1D9970"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFKXwWD5xQkQ7kNvwHUp0L6&_nc_oc=AdpB4HwdaZ6yN0thlxTAJUNGuOy5h7_B68JEBqzAbqlFaB2pT1UFbJQQS343PqLX2Ts&_nc_zt=3&_nc_ht=scontent-or
uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0Q332s-eQ0Q7kNvwFEb7Mi&_nc_oc=AdnAJ5s9p7HDPfcYZdUlFWwqu9p7jBdRAekkI7p48t95_3uNok0aL2s7Qr6TsG7RkuA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyz5YT1vP9nCDIxbKo1zZZKrn8GsLyuO14OubzWGKVcUA&oe=69AD65E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td9I2laXMcUQ7kNvwElmU_I&_nc_oc=Adl6PhnreNTO74PQcAL7Rg_QUzPQuhoUD7SsDNg5XVF2DzhkDSVzoT1ZrmNm-UvnpwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPaiFZQ11qXlii7tvrZTMucPYzIm4O8H44OOTuAX6pUw&oe=69AD6232"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3Zk4gSRNVUQ7kNvwE5uusO&_nc_oc=AdnoILzBpsG3N8dntXWopMYvcDJfIia61hnEcQ3Ck8DdYg_JzrA81DlQW0U6zge1-wA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1UH3kkR5PUo_gJQdI_7g0iMCRtPaZj_iHo7VscYobPw&oe=69AD66E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fts8-E0Jd34Q7kNvwES5Rvr&_nc_oc=AdnpD745nYEm0SX10DOqUc1qBqwwcuxkz44exMN_NTmsUTbiKUE8t-XoeU8AfgKwHmI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxA0jzZgd8HIP0wO4OP_H6DzGMRBlWQH-5dg_QJftITRA&oe=69AD665B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5n-kyALAugQ7kNvwHWIRxy&_nc_oc=Adk3B7X4NUVuGVCt0wZu-cccKWp6k3OPooUolmue1hc6N1dJSHvWOdvXcWeUouky4YI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwj9P1QV8hkH5xKMu41LT8kEjrb2B9hjy9pPE8yQlk49w&oe=69AD51B0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j2yzGMmWcMQ7kNvwEbcTj5&_nc_oc=AdmUJ-eynaeWKOSlZWeaRjoeFuzZXZiUmvdggENj4Lyg9o5CozfDCNRaD9ZUgchOLHs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCrEVrHfM0G4pTVV
ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCiOyqPqUwIQ7kNvwHCivvp&_nc_oc=AdqZ0L5omt7JxBTanXgju5xK1C7_bXwbpoDkCzATdksyPzTGofLm-MOcpjHteFHm9LA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Mnw9cjfU8nHETuy4IhjPIcbPprp9vMCXkvEchnNKxEg&oe=6A3AAEA7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJoy7NcARj8Q7kNvwEVzAw7&_nc_oc=Adomg4kpQJ1KhWxARjVc9lteBU5vLVZor5g50PySPI4NlGUuXZZIBI2IG0YvOP3sT04&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6FskwJiSawDsn8d-aaz7ltT5e1KN0ZrefEpwVPRCg0A&oe=6A3AAAF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkd72YmIvF0Q7kNvwF-6al7&_nc_oc=AdrMCAMudzQMSHm3h90ThNkFaSo3ktEJfmkSOSEMidJH0s4kBsiEQHCrhf2emG5LcXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gYmZnKpsKKdtg98CWSq38rjph2RThRpCJHj2yhyDO4Q&oe=6A3AAFA9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyVoVVktlT0Q7kNvwFBC0RA&_nc_oc=AdpGJifjBjua-7XBpGFbDgcMgQZ3ixl2TqOx--WJpNg_LRec8NWjzJIB_8BgtkH3_cE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IwcA9itEs-sQcIP4WXf0hY1gJYbpyiig_HIVAKNBjkg&oe=6A3AAF1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ0u_7VQ2o8Q7kNvwFbY61B&_nc_oc=AdponTTXi0p7BbiUhaP1qndk2CKrdwKaQHiQ8qXgKHfl2IumkxK0LLEPQUEAHnD_858&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ovDB3NwksgBFOlNk8pDu6HQ1y21NoipSW1d5shHZY6g&oe=6A3A9A70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LEVYBaAjOwQ7kNvwHrxHfK&_nc_oc=AdoWd2aR_DZ4YlIoXlewpo4HMDNbda6HPiUR6XAZii-DMDYonY8ix9OcNOt7WPVLr_E&_nc_zt=3&_nc_ht=scontent-sj
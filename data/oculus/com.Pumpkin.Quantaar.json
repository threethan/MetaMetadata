uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9q-m5ixZE0Q7kNvwFbKqxe&_nc_oc=AdkONMy8netH76DuQ0k8djMfVDh9n_97ENmsjmarPAet1fFZbKE95CK3KQTInP4Pt8g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx7iUcwpNICQbAwME0CJQ4M3Ez2cvzHycd5CCDL8TV9Xw&oe=69BA94E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rh2OnH2SRUQ7kNvwGzPgYK&_nc_oc=AdnPyvxsI_QFXsT64QTab_IFkRWSZVNYYHw8g8L9DITr2B89yct_N3QfbVxlMyznhwA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZYCUnk_k7kG1id5_obQpKwj5R1IyWbE1CualLrtgn4A&oe=69BA9132"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAh3ySAsjC8Q7kNvwFG3BVL&_nc_oc=Adm9zo5a1F6CMogB_WUofgHLTzscrw2wPRNZbyDFsKS4nMc8G5DWU0QB-knyaAaQ-d8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyLHEpawDAi5XrurZIGf2J7cWIAtS3I9xQ0vguQ4HYp1w&oe=69BA95E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgM3mxGZ_VoQ7kNvwHX4pEP&_nc_oc=AdkDBotHMnVkZIN9fn5c4eoqJyfrWs2dlj0NcUEur23nzUcMPOenLWu0XQoU2-XL1Sc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afw2Q40FD-tQisQvJhwnoQLj87f2fu9ah3g5DhRcreUhJg&oe=69BA955B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIKsBlAIEXsQ7kNvwF7Iy_J&_nc_oc=AdnjcvjhRezHPfJZzn_wHYzWo0QjS69LAvmxsj4nRJHFgpEIZjAwyzrPeFaG-f6qPW0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAzQEPceWjjOlrJGxPLiqQRq5xk8hX97a6NkRInm7aDQ&oe=69BAB8F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peurtHqXRDoQ7kNvwEQoffK&_nc_oc=AdnfkqC6VGty1qiHgg50TGY3Ufczf4vbKniPCVc9TB9d73itA9EIxFtOVVozS8MnZTk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxhCeoqRlxPR8Lmgc
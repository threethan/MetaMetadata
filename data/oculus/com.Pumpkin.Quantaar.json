ri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbg1eNsq7Y0Q7kNvwGMTJ3b&_nc_oc=AdpnFRe4oevpf1ArcfWHJ1vg4yG6Zo1-Z-T5eFXtvCs5Di4odh6Z2cJ_NX-O25S27y0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0i0YJiNea2wRQSptHjSVr8ilr1WpS2TrpKIJFjOXrFzA&oe=69D795E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rgrf_5LOjrAQ7kNvwGlpueD&_nc_oc=AdoBrbEaBEBayO2UOCJqlTvhC_HpRt8-wxoOjFmIK7lHHSl1PVGpq0rcuT-kDGkiEuM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_TPBrbod4UznfGVmD2V-1hUPHaw3ZrFHs6dLz7yDRHg&oe=69D79232"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4OMwUnyImkQ7kNvwFqrTAA&_nc_oc=AdqjjD1i_Obe8SHhtnVklUKI0YARQuNE2Jxnzeqtc-g1yLqm55_NUVy2ZA4f3k1D6eA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lEOpv_BTbz-sCUmcjzshjATaKATWtiZTIKthI-EDN1Q&oe=69D796E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qamnDHRtYQsQ7kNvwHlFLz5&_nc_oc=AdrwZUi5eGhken3hoWuuz97YhO19pJeBciDG6ayohF--eh65MpbiF8gsZAi3NOzh5FQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mfoDfC_mCqUN1dETBHF7Ev7P0woabcaq35jkYsCz8yA&oe=69D7965B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYyWzO9eQxgQ7kNvwHwV_qd&_nc_oc=AdpsmC7Iup1LepSPU5_pd_rmRC3WCVEqvnsM8PwQKL3BXZ7-wAy8sjkqEoi4tZZTBmg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27r8AFwjVJFvlB1eS73aNC3xBkiY3b7Cm64lR6PtsTtw&oe=69D7B9F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evmVFtFlYlwQ7kNvwE9Q98z&_nc_oc=AdqfkYWd-lhTJDyyTfH19xcDgsriea9p-uD5p-0UnVTxHx1p9QXpGDH7R9KCgzgidPU&_nc_zt=3&_nc_ht=scontent-fr
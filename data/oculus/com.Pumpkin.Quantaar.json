ri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wa0uJKT84C4Q7kNvwGgsoVx&_nc_oc=AdpTJR9ska2ZGHGkzlfmIx2WrmCyuiob2w6tCfX4TMN-fTq-PH8bG4vu5uxmu3R80G0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwvtdHuBX-6vF3HrKbAB-CxQWbqdNGsjZbySClCS4Vbw&oe=6AD39CA7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rV_J0bTVKIQ7kNvwHK-9du&_nc_oc=Adqw-ewvUUKXsFIZ5j-ShNy8QpHCrIdwBwGoNnehaYy9ZCYP_Ujen5eLPXU9Y0byG2w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4vQtdw2K1ZP8yOUq8vb_ysjxQwZBF_ont9fJyn4CwxA&oe=6AD398F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M7v0kEIOTkQ7kNvwEQBTbL&_nc_oc=AdoJJj5L8Yxr4pFFjczN9VlG_LQuC0P5svCk_ecDVn7TbOa-mTAPQry5LvyV2_BzASo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwzhg64m5JAmv-tr0al06ECD4knp7c12slAW7DWS8tSg&oe=6AD39DA9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thglf-j9nQQQ7kNvwGYcq4q&_nc_oc=Adq1K2hJ1NclgO_DG4iJDJ-pQEeNf1EeueMa6HoDEs5VxyBpwFjIHcgoRr-re12tBBQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsORsZNcOUYM4ftRFBWKZQbaVjZXGl6FWvKd7WHVXaJQ&oe=6AD39D1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Btw6yW0U1goQ7kNvwHyfW8L&_nc_oc=AdptE4X2vAYshjyD9B_hTi0kU-McGsNYemYD54To6B8FR4NaNpcIyrxsVmbr2Fg2lqU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcP4AymfSLKO14Njj0WVhnulZRm5HQ8qFqVyurFNvm7g&oe=6AD38870"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQf_IiRvVMYQ7kNvwFSgn-8&_nc_oc=AdrtPeYnek8LsnC47NgaD_VP3DvBZ0ugEar0MawmhEsn9QnD_FnapIceUGn2u0czr9U&_nc_zt=3&_nc_ht=scontent-df
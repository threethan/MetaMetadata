ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0fg-AHgRdQQ7kNvwGUYTAb&_nc_oc=Adqoahm3vH3Y9SReksgzaAbf9kwq6pfUOdws5YcSL6FykhofjiFUSax1V7i-d6pc8Nk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kvBkTN0SbwvYruR7xLZELZz_7MQy4V3b5_WEB2WsnHQ&oe=6A1867A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gffy2Gbihw0Q7kNvwGZK1ZE&_nc_oc=AdoxbzDto6Gcor2B20g1jOr1-NPwZOjSs0TFZ0kgwrkFZrxko62_g71SGaI9SBoOFjE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5smLC-TarzG5qA0g-9xiqcF7JivAcJ7pfTYIKXxCr9PA&oe=6A1863F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJlGQWP98uAQ7kNvwFjS65K&_nc_oc=AdpsgFffvq7WIKeEErOvy_Lrljbj0vaketguMwL4YYyOGxAe_Cbr9aTMnO-WMoxLSXI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d1ToMqAa3asq7D0_rAp3tx8Njk7LiuYBiWcmlwP68nA&oe=6A1868A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfb4F9Jv5RAQ7kNvwHjE9iJ&_nc_oc=AdoeJ5yK48Jk7p_YKjxH5H9if3yRnoTeEk9uytcuI847YP9wi517dhgVM2kPohgAdaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5btsABmedaxCUCoVrMsQBFyDz2xIRojTEHMEDhmqJXbg&oe=6A18681B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuezavET95gQ7kNvwHyF05i&_nc_oc=AdrFWG6K1ZTQaBq2h6IymgvcoB0gVUe0JwEzqW6Woc_dKM1hQgLCDHUlOXbQDUjlmr8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FNw8meSAxwb4eapnWlurNKOwrkvS-DMPx4UaOXyHE2Q&oe=6A185370"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tbVXY-vdQgQ7kNvwEedo1W&_nc_oc=Ado5OHD0lNHnpNotiOF5zjFKENCff2W0RRtzZ91ZHTP810LCJmeFhtFVnGf5_egGiw0&_nc_zt=3&_nc_ht=scontent-sj
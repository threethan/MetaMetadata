ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vabibBEpemQQ7kNvwHCMI1f&_nc_oc=AdplIf96kPrVOdub7gxAn6A3Fx9Eji99xsFdOmeA_W_5aHv9n40J7s22cyFHjB2iGS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdAVLaS7udIe6N5dA4b1dEAKR0QyMKjmzhU1WUe08cJQ&oe=6AEF4C27"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62GaJuQ8FXEQ7kNvwFjTwUi&_nc_oc=AdqVBQJ0IacBT2C57MFwlSXkbcIxAl4i-tV0QqBAz7RdKd2PO_eeH_3iV3G50-3xgmM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMtKE55CWJPLVHACo8DhoCZ0lYBfdDJR8TAND4r_39sg&oe=6AEF4872"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCdzYcKC5TUQ7kNvwGGrXsj&_nc_oc=AdoOle2p79RHIIhCBD5dJ-wLHuEU9K4nKBdxdFMgzfc_tYknedvV4p2jX-4Z_cts-X8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlKl3pnxBND_vTLNcoMZWy1oLRXU-L19myaSGqEQxhYw&oe=6AEF4D29"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fUiL2-ZtQsQ7kNvwEuCkd3&_nc_oc=Adp8P7meOo4Z5ZxLRMZU4hwM1AWOVZH_48WSJ8E9BrNFHvRIfZ1tcSwMnWbEJerP174&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4zLQnS1nXklXoICt8Uro4zFPLr6eb7dKAKTeTbSptaA&oe=6AEF4C9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo77fcoJl5sQ7kNvwHxU4Kr&_nc_oc=AdrQFAmEt2yYY2e_eI-zNmu2PRTnSd-23bjWVh5SZuc3fcKCe6DmPk_OfGTJQVbI5Sg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrGg8_2m-3bF5ldBZ27Ak-TbMxwGgO9FW-eSEdnclw-g&oe=6AEF37F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQFpiH-9bT8Q7kNvwGmn0wu&_nc_oc=AdrEaWaK28zINvLrptU4yn2xLL4LGN0POOuvzBJCYUwzC6jj97L16IsWHYsBgxrRCl8&_nc_zt=3&_nc_ht=scontent-or
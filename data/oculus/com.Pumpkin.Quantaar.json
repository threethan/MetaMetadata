ri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD1miaZV-ioQ7kNvwFosmGX&_nc_oc=AdoJ-B1N47Uz3YpyqUrhOeeOy-PqkBg2t2aQ0c7jXzUEUnCu_q6UrXe9TBhoSMQ0oe0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47Y2kHvXlvebIqXJaPGjMGvLx-CnM5INkClegnou6_Rg&oe=6A107EA7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSW0k134nnUQ7kNvwHaTqR7&_nc_oc=AdoCiieRSG14dlq9t-Z97Jlc6qu2pSlTG_FxzP1nPLqbIkGh_Oi3KRlzlkH6DCRc0PE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pU2ZpnDXCZB2nmpGKPlOTDNclMSv2d-nnj1Jr2ocX6g&oe=6A107AF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmDiRrKDws8Q7kNvwFTtx5K&_nc_oc=AdojHBlS0lCPdCBcGX1MtNts7jTSA0ydlEH1TNSemTvWdu3u9UKI8BEmw60F5LQJ8W8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61sIYYzZuZMJ0ruZP_C4N7VnLbrho87cLaQj4hjiChIQ&oe=6A107FA9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkHvtRvnf0MQ7kNvwEtcNoN&_nc_oc=Adp7sYP53WccOb0YXUNEujWpGlTzOvJkV4r48MsiQGER_4rAH1RusEpXnmqt14ZHhus&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xUpz3byxk95T2vFOhwZ99bADqR5jUoOpn780Or59WHg&oe=6A107F1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yQXk7qCSp8Q7kNvwGbtvg1&_nc_oc=AdpL2KbuMSBfgEjibVyCiLvsx0gQB2kQmJ7tCq55qxJsd5aidOZliYIzTyNUzr8tu8M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65jymzRqc41WgGn7zsMXDDY-GEOD4zP4Mjh4nvgHqiXw&oe=6A106A70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1FCFE5AmI8Q7kNvwEMwveN&_nc_oc=Ado7dmt4yY7KIJzT5M1WhBR_QEX-3dhnQn17OmBOEFNMPfhEhNMYgN_RPVsakF7_zzc&_nc_zt=3&_nc_ht=scontent-lh
.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im2cY4G-cCoQ7kNvwGGtLpO&_nc_oc=AdnOYHm_VQos6ngkNSRUG9pfrzZp5GjXxFFJV3oNNh98-cACm_PNSuxarGgrz7AVoS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsAgasHNbv9pCZ7WSfuRb_q7CqWgbqhAqktJTzcGsdGNQ&oe=69A036E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP9X-XXKj-sQ7kNvwFRYrc-&_nc_oc=Adkzy9Z2bzFmeb3z_ZzHQsWE2fcwEqhvtGaAyS8TWC8iWMBaB22KVO7TjeHBeqKkbeo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsowWbYESN3HTLw3ewFeG4tlFPucsAr62sFXNMWTPd8jA&oe=69A03332"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqkgVM2OuhgQ7kNvwGw713O&_nc_oc=AdnyvupcYv15Cf8VXyd16iNIgF4-vCSZpxetCBmunQ8jpEW3fmxkmIdHu6yq8hoye_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv8GIGYltCgaDdV5vI-TaNkMQCPwmsGshHZqgTuR4zcZg&oe=69A037E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDxxKRUVZd4Q7kNvwFY4SgQ&_nc_oc=Adk7g9W67JS2s91EZrLnPIJ274T99o3dio-OIAZE_MMdmixBpDfIH3LyOiMyMjPWPz4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuqqf6iFyGbbYYwjLUxG6AK8qzxK7PUODOvKrSgHUjSng&oe=69A0375B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trtRg8QEtxIQ7kNvwG8ijsb&_nc_oc=AdmFFpNtydJu4sTkskuYyNu1K4Zrqx3jvsbLubnQk0gflNrfiP8b6DVnJ-lVlRZGj2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRX_dTXK-tgPpAwtKGb2XxR6VIOlfg7izeXFdIVjvTqg&oe=69A05AF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCPgrOucDOMQ7kNvwF1YfRH&_nc_oc=AdmU0A85MoE_TO_15ZeHmKCG3gMXTFGK86AAqIqF_Gice3n4q2qvMDDag3bWtjR03YI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuti4JNE0AtGRduYUSc6PCB1OlfMDG3MsRoseVs4_vt2g&oe=69A02E04"}, {"file_name": "Frame 84.png", "id": "1747234655674817", "image_type": "APP_IMG_COV
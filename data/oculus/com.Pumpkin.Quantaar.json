uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrbKKZ2LAj0Q7kNvwEwwnwn&_nc_oc=Adnx_ypVLdcYTiC5P9oUq6bjyc0M7HBnqd1-iiNO3LlqwHTPz_kb9biUFiEA07AOm6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwAUtnaNvijtkKOz4IXWotsAxMm4ydGlyHehBRVllsM2g&oe=69AEB767"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAMf1gVithIQ7kNvwGl1PuM&_nc_oc=Adnl4VVTLXO_L75HPY9lKc1ram4K3vDjJoqtoXmRkMR1rgpwIt2p6iwPQ7nSB2GQiZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdpCfrIdVW2sS8El20pEXeESL4rOSg0KyE5HuWBPpiWQ&oe=69AEB3B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3Zk4gSRNVUQ7kNvwFNAxz6&_nc_oc=AdndM-Hv7MJsrveeCECiY5HukyGFtu9kXzBAiDIO40weH58yF2WWNsNO858eEuPYL6Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzAIqOsvollHQ_mdKJQs-FLKve0VCQxjt0CVfbLqWiqA&oe=69AEB869"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fts8-E0Jd34Q7kNvwHw9vpx&_nc_oc=AdlKba3MkjfSjFAt-gPiZkv4_jR1OCabKTzlWw-AOyCmhLY6aYtZhCMFQWKrLCnLzaU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzG7WQsfZUWUEVikSkgo_6d37bUix_OaMXt_YylIRLDCg&oe=69AEB7DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOXxYKeSLdYQ7kNvwFEg5Sw&_nc_oc=AdmfblWjO9LqetlrKt0vkJcS7G4jzLLbBV5m52ugkatMsBaKpwmCix94ZenBkNSxgrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMuO4Gvagbd8-Kb6pW9ircffQWDHkRbV5HUXaAgTpyPg&oe=69AEA330"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3j2yzGMmWcMQ7kNvwGMil5N&_nc_oc=Adk1JUuWs2d-ITuFbToQZUQJZjMNFes0OmRE2FNtIX794K7kJ321mm28CWfBzI96CuY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJ1BrZ9Ks86IM1kz
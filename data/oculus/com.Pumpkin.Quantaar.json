ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2ENipcN--4Q7kNvwG67uVX&_nc_oc=Adp7q8PGDKIFavq7H4atdGPqlV24sqKt6Tne-P9bkri2zyTVRSRzxI2nitVYc1szpFM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XLmVrALv5POUiSLEWo4TfKOOOUP5rJNSCBW1gB0Asaw&oe=6A1EFF27"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFhIlmdSMHoQ7kNvwH6_snw&_nc_oc=AdpRCYBnsceA1aQbokVgnr7mVLgvY1z2Omj5fLd8S48_YHZTQNZL7JJfZmmWCQWQzyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wTZJPR65yX3AWf76Pu8dz0KWd13BMzGt2wZuvgjviHg&oe=6A1EFB72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNmt-2mEqRIQ7kNvwFhUp-x&_nc_oc=Ado8OYz8DHLBSQjhQer0mEkioMhZRFYvHF6slPLbiRm15Wuq1-Rykh0jLNBa38i-C6g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zLXqQ0U_bx6h3TECL8CKtbTm97lNSoKj33lqsnWvvRA&oe=6A1F0029"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRX2z_j_I6kQ7kNvwGqqTog&_nc_oc=Adq3G5W4khfxupg6f5F9Vw4OCLv07NgvYpWCteTv9OlJKVVN2K_k43IsW9GKQltoGSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YV_FJZF3GHnfbREldsqSirv2g9OveZaR312SgaBjNpg&oe=6A1EFF9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8mVXW2wcyMQ7kNvwFuVnNT&_nc_oc=AdrK8Sm6jNJw3Ouvn-jU8arFHwqsNuYrPLMl9by1HV7dAJPjjP0ajLggmPv8snL3wi0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ThuvrxdUJoKPzVZF5Xuw_Iz3SeonZhZtFC3a-j0Xd1Q&oe=6A1EEAF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt2VnUz5xf0Q7kNvwE4LTNY&_nc_oc=Adqi7NC98VQFVzopAUMidlEn07uKeg9Tq4eLCT0JmsnP7KRZ7tZAxc73S17uaMxJAEc&_nc_zt=3&_nc_ht=scontent-ia
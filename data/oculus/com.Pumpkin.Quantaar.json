.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im2cY4G-cCoQ7kNvwHCKtPv&_nc_oc=AdkkHFN-BBYz5adOwMgTtXOjx7HzimnjC_63zcpNTgWNN5dBEV97CYSwGJ4P8huqpww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftKRbhdqooALBMH7l5IKcs0b19kd_gfChppND5aw0zNXg&oe=699EE567"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP9X-XXKj-sQ7kNvwFCMVrO&_nc_oc=AdkbnBLK_doFO59JJcgGJkF7hW7vVLAW0_vzshEZgXK0fVIrKobxYc0HwPoIUfujkBg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvNnhFwu_Bkb8wx0fbEjvIUH_tlJSs2LEjvrOVTbheUQg&oe=699EE1B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3OeNFQmCd4Q7kNvwH37QJs&_nc_oc=Adk4vNzSo3cm7Y-2tn4rtXNeUnRicWYmPPd0exzF8mF_Z4W9_fXoboiDCDI2WvzcSrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvwbP1-IY_R4nN8TEzs4ejM_lxdU9B76Muvu4eCmh5-Gw&oe=699EE669"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okTX8CiNrh4Q7kNvwEiFGA8&_nc_oc=AdnlsMQ_5J9JK_nGThHq-DeIcw6nG0XWvX6Wq_zVfRbkyk6aSmRpVJ-q2RRSQ1aVaJc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvibo-eUISNkOcYY5jqcj07xCX4NdVdBq-ghM9xV1SwNg&oe=699EE5DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trtRg8QEtxIQ7kNvwHmidPs&_nc_oc=AdnKPnFwUO2AgB3_BJ2ZRWhmX1b9eBam0pXZgbKYDO_Hj2sJ1ISDVcXnUSHex6W6bY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuB9jSOpX_SHybkf7PsFZu2CDNUW9u9W2mA1qV1l-K4yA&oe=699ED130"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqQFZwbougIQ7kNvwFP8Ar3&_nc_oc=AdnU4xzNsgvC_JhzwuHhwA-hNQER4kq6zn5AOhI7Zyku8dbK-oh6xJzKPk7RM4tKV0c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfutqxhW7Cl85ayIIaWm4Txg7oN0Em8T45dmpLvlQoJGvA&oe=699EDC84"}, {"file_name": "Frame 84.png", "id": "1747234655674817", "image_type": "APP_IMG_COV
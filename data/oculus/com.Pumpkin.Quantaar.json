ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5jA0jQSg68Q7kNvwEjDA7N&_nc_oc=AdodxydiIVC04w6VL_ol6VEq54d9yw287zDzFpovL7sJ81pa7ofvd9hcgMb6o6hmzEI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6odL437KWrVX2kgNs_zNsgX1Cc1XxcGcePsxp8Aitx8A&oe=6A01C5E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32WKom75Lk4Q7kNvwGV9vpz&_nc_oc=Adq0ctIh_dbNHa7C2VLKQjNJJzWrPC9D2sC2KGXO5UmrfmqOfWXm_I3fv0TkY7WQ5U4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tbEcSUzz7GBMpB4AcTzBiDKJMOhQOzTHim8Mg7dqXXA&oe=6A01C232"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58CSA7AvsAsQ7kNvwEzFQ1B&_nc_oc=AdqmqnfzAl66jhPxlJDTLWr5PiWSeZPZSaZjhkcajM12HM1TSFFtxCgETall6CzZNMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vwxhQa95OyQX0vigHFyHIJg_CIMmDfEd7PQidODWVew&oe=6A01C6E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD2jj7nG5DEQ7kNvwFlcIC9&_nc_oc=Adp4evB9gm6LYsVh2_jdIKZxEr6jLOxaD-yLnG-X9gHaJw6K0MLQfRBT7ahpTh2VT_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YLUqeqcftQRnBfIvygdc6sas714IHYynLqGR_JdBfRw&oe=6A01C65B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y1g2cgX9nYwQ7kNvwHq6UJT&_nc_oc=AdpW0DiY-_Pg4o50hUmybLAtFv14W2lwVFHprER_uz4CdezDZzIYwzaBtNiQ03S5hfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NNBGbTE-Z30Ulo6OrFSekbrwLs8KGNTUMfO8aV7bxrA&oe=6A01E9F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85LsC1DLlOUQ7kNvwGZEz0u&_nc_oc=Ado002Qvr0nXpjPmyBUwf-WiuoYH5iVEfnFmLpnY8K6t6gy0pm4L5W9mkQsXWYvPsJI&_nc_zt=3&_nc_ht=scontent-or
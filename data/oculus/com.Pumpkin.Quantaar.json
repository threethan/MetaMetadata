ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8M_ueanXHMsQ7kNvwGz_7XQ&_nc_oc=Adowrd1SMOFj01VbzNVqAIANPHthBRpzeJ-V9P3mYRyVhBdSCcQSTit3K9Cgw7TiUwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4zUzwBbD878-IhIrzsV0VJXx9fWYjuu35gK8MdiUb0g&oe=6A95DE67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiYMsZYZwKAQ7kNvwF6wEJy&_nc_oc=AdoKryT6V5lupynyIbn4YfPKNdX4a_VaOszI0weypQAzsCpH6DM843eZDIwY_aHlex4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOSygORW2mtukbsEKAvsBdy8SUWyAJKh5w7AMttz42aA&oe=6A95DAB2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0sPIklj7oIQ7kNvwFup9Cr&_nc_oc=Adr9CW7lLagdmMu_ErvpNmL3ZJyOfVSVi6dad4bAE_-5GzEc4JdC9H6PXYyNhPOZKPM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElV3poZMbpeB58WgQCgvj9fae4bgoz5H-ISQtUDQE2ow&oe=6A95DF69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjHXsgtfwLUQ7kNvwH-4OVe&_nc_oc=Adr2ouzHvErUzUlQxJ2e7UypGzTG41zAvPsWc5DiJOd7Gkb9wl3ya_3_g5tmVtmRM6M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrhBpufLhnSf4te6J63Mws4uzn20lkC5J1nDKecEf0Wg&oe=6A95DEDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_rwh3vyoJEQ7kNvwH6ZKWu&_nc_oc=AdpAvX3WQroFR7eTsVQuu_dB2cGeAVmuU_utp0jtbuFlyu33X2fhRzogzLdLLNZIEas&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE83EBLO1VZmsol91Q3RCFP-d7Rp4tjwZzmytJh97DzVw&oe=6A95CA30"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drveSTeDR7IQ7kNvwGI7MnZ&_nc_oc=AdoGPVNtilg8MiVKXtcU35htVzKp_vEX6UbY_1zAiFKemfjeM3btq7miXdIOZHmpClU&_nc_zt=3&_nc_ht=scontent-or
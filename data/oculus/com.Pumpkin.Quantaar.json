ri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAUB3eAnJkcQ7kNvwGTkNkZ&_nc_oc=AdoCPY365vsjbG59joYEfzBLyRctaT2KE3-zgmfNNIv8Hysbqc5R6gJk1MwZXia10k4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nB5NsuXNmnEPofh7FX7T07z5Jw40Kyi-VavrjW7uVZg&oe=6A2C2E27"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa13eN5F5h8Q7kNvwFeRimr&_nc_oc=Adp1nE1XfMj_M75E3O_zOStAwjL39S45ufrmKVD1B54m1I390lBKbjkFJGxXxIuLrIk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NkRHa7_OiOALEVV7QTEM-mnowBn-U3ujrnIC2GKkedA&oe=6A2C2A72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd4XtNgmrpYQ7kNvwHL68x7&_nc_oc=AdqQL8Vsn2weX_NHqgHwKekrXW1r4lY5R7m2gH9gmAVj_MoReWj6OeDKIKm8F8VvRNI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HLPlLLrqzEMD_oSGAg0vbYjm76Q9RhEoaWjKQf00l5A&oe=6A2C2F29"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dE3NIceBOdgQ7kNvwGINRp8&_nc_oc=Adrqadox8vY90-SgIY8r-Se7oi5k8MpthdOMhGVvX6HlKbgdXY1UWoVL5yyN_7Yrhtk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PGPtX7DTr9kjspUtl5qFzWoeHwtsd7NNBEoTroP80Mg&oe=6A2C2E9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAgIBJHP_2kQ7kNvwFCHZeY&_nc_oc=AdrVXA6s092HaTmLp0Eb3fsustqDkyaAEsEaFAvD2P24bYVGnsTX5IYhGYuvY45DOaM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JSBKPPpOh7RQYEkrz8yXdJR9zL8cvAoGuVIvyx8nbSQ&oe=6A2C19F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6W3FE40LRwQ7kNvwHxy798&_nc_oc=AdpkjomkS7f8lIxIV-i5ACMlUpvLEP-mEN48TRzwkAqj53NKJ50c_MqMA2kyKXRPJVE&_nc_zt=3&_nc_ht=scontent-fr
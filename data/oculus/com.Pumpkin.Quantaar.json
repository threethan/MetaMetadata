uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrbKKZ2LAj0Q7kNvwFvwFx6&_nc_oc=AdnillQ5DaWSR726zNzkNfAugkjAHy3rP74VfWR5EQaB40kEv1XL48eyLPL8zP-wqxU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOM-CENlZWyY5s6OKmOpv2UF6Le_sWXAlzZbgfB3FO2g&oe=69B008E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAMf1gVithIQ7kNvwEsj2aN&_nc_oc=AdmykXEcytlWu6cgc-hYrbi_RpPAQi1rcfMnXMwp2g34erzCUnf8auvSnRI6qr2FWBs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCLRyoYOJHLHeldpnBT3Knhbgsm2UFffG6XdAy8XOgAQ&oe=69B00532"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwrOtf3tN4UQ7kNvwHEJwPa&_nc_oc=AdnrH2OW4Elp3i70bkzptzDag9HHI0deK14mW3td12PZd2o5cBU0Seq4VKo2kw5ggTE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9PORLCuoDwITygQc4_UEYHw-WOjt1zyI41rJlLuVOgg&oe=69B009E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2Z1pfi9kl0Q7kNvwEBi0x8&_nc_oc=Adkw3hAEQ-pf4IfgbhscS6xG0mROThRCu3jUu4TwhqZYNzgDpAs6ElClHDQWf_PhfpE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVTWIM6n7wJdSdMGSvriNKGOtVbcS_FHfniRLapb06aA&oe=69B0095B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOXxYKeSLdYQ7kNvwG_erHH&_nc_oc=Adl_qAVeqTSXft8ujSXBjn2gTwehNk7B1byW_7SUhHa7xQQ-PSO8Mv8CuSjOqVyMHGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyc98TtPtXkcDlJURilVBW21AlLTrckc7bLrPiFYPb4LA&oe=69B02CF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ropylOmaGdoQ7kNvwEFXQ3w&_nc_oc=Admeq43RgRpEd0Qpx6qtYbcWc_5IDqj2NUehC2iz0C-M4YetfjUaG2F1s4HfnKjy0bI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuyOaF8pm4GjjpN6
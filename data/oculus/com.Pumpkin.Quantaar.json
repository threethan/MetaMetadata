ri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8M_ueanXHMsQ7kNvwF8Wy4R&_nc_oc=AdrWqooWvmojtGvwbA3uzpZFyV2LgMtAimeG-xtsdHHUKaphdAzdfoywfu7riIbd2xU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO_cfzq-XMBZzd5hDAFjewQj6mv-R8kbIB0wGMMQto-A&oe=6A972FE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kzvf_6IX3HQQ7kNvwG1QLcX&_nc_oc=AdrZI_NPzSjRRwD2ANoa54d6EtAcK_Ksnx4yVrzRs5WTg3soHLyAbc_vcGQ7NvpeJ0E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVvFFSheFEitvnVJ04DvdodyZzHLQos4jJDDRsGyUJNQ&oe=6A972C32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0sPIklj7oIQ7kNvwEB41ci&_nc_oc=AdoUQlQui52BkLj50eEq98ZEJI_5hKnrF94kB1b3NOcaVEipEhaoiV6cUCKyrHYBxkk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWDer7jOIS9DXCF928ARpSpidNyb8PAEMakJdXfqjc7g&oe=6A9730E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wjHXsgtfwLUQ7kNvwGV74dB&_nc_oc=AdoCE8tKp7LA3ols4KdcCxeqgBh90HHMhjfrgMliX56h6rVrhPLGFA7xXP8V-LKshYg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-MlknNO1--0G2P9WYKwQuOhqyFgh1lN1gnvdlifWO4A&oe=6A97305B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_rwh3vyoJEQ7kNvwF8AjhJ&_nc_oc=Adq_03Yslo7vLB712BHF31MscOT-6vtxWOegaefXfpZmXXUse5p93n3kHA_HaDuCOzs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw3QpCZujuiXFTbvaKVtbQhqt8_Vo9e2kp3VWfTl9oEQ&oe=6A971BB0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drveSTeDR7IQ7kNvwGDwTaf&_nc_oc=AdoWFMTkOrGKwlhxyuwebXrwxnngWxHwo4e4zJUfwh45UDJShXd-NSX0JWOVs91JpBA&_nc_zt=3&_nc_ht=scontent-qr
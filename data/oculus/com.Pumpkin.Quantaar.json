ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eUAt_Nm_CoQ7kNvwFAQaNF&_nc_oc=Adq0mA7XS-XTts5beLXl_TQEPWcW7CYNB1WssDRq5JEKeOnq_mqtfQTeVM2DynHj39U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76fvJ4x2Tsk83xYj1yJArxyYkSHlOv35hqALKTEyDcUw&oe=69F9DCE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbaoX28kG1MQ7kNvwFBQVcZ&_nc_oc=AdqtB2FwwduwP39yIXY5kM4ZNLSuFYge9zXN5fQkctANP_VXZrOFpd5M-1KnLnlnMG8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47a5rJlMkjtUStnMPGnKKLxEomKF8BKSgSfgULBfGtdw&oe=69FA1172"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or-DxEELHw4Q7kNvwFQ-3Bv&_nc_oc=Adq9Fzzgk6fn5g3rxrGhNRVOMLBWAixZL0NKAyjnOmNM8gFzvrp-fafGgmmYtXJjAhE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IUCQizWNs1KDP2vIpHPNoFkGTqZb4yl8Kup6nJOCTYw&oe=69F9DDE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_oTCN3ZHAoQ7kNvwHRahgn&_nc_oc=AdrRmTQrob7--dwzeH-URFJZ1F6_CoJ7JLpSUv8urp7EtuLmZtfiqSQ1ffem9lwNLco&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UFbOCWWFibQDRVjL3RElLuC3rKKnFi4xJVyD9mTZA-Q&oe=69F9DD5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzOS-PsuYJYQ7kNvwGDS3hf&_nc_oc=AdrgrZX06ZuL1XNwtw9GnghaIAo_CZegWpkhi2uWh01KOiQUbYP7EYf_RU4K0CNqwOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CE-bC0GTqVCFTPo4Qq9kA3qEBBZ7iH2Y6yCUJoJAnnw&oe=69FA00F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIFT5gj-jJIQ7kNvwFlAXiT&_nc_oc=Adqx1-g8dmT1lOjesut45ccaWXr7DPMYhJT5njr2Kkas15I3nGmmYL3UTqaHbOxX9j8&_nc_zt=3&_nc_ht=scontent-or
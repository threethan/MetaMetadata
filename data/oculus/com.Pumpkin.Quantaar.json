.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSS97GbLrUAQ7kNvwEiSfb-&_nc_oc=AdkOkB9RoqSC8JJ-Xj8ESYs8UJ4ZHWSaBQz74rsNruu2sXyGSysnQriUYqRQj7towz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftqtxXaKwyPR-oH0MheAiU38k6e0MSGOZIHVBrl60NiDQ&oe=699AF0E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9maOsrbZV7kQ7kNvwE_M8yl&_nc_oc=AdkSVLoagXYaDafqwGCOxO01oW5JpEFiDRYgOgvRtCk3PYDvUI2WYYx8boq-v3funXI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuBEeZ6UVat7BObeo90G4F4xCLoOc-kurWSNtJxkh5rAA&oe=699AED32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGS-27E9ekgQ7kNvwG2QWLh&_nc_oc=AdkeBVM2FAsg4Vu46h-P2511Bf3tfsp2j5be5q7jl_gxInFTXtUbLUSu_yGxuU-SAYk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv67r95w8XoqjQtHYSA16BnS8VDFTI4orbCPrgghYTXZw&oe=699AF1E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvYIRJtTueUQ7kNvwGNiMcH&_nc_oc=AdnTWq5r1ldjBUm1IYaHa6mWSlpakg8Uc_kT8JhKNSux1EMP9DFHHiQ3QpB3HlamA98&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsdz1ISee1ZpaLLsuiDfKu8PlAvt8voL7w9gu7D3GR6fA&oe=699AF15B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTtxF33ddO0Q7kNvwFDIlut&_nc_oc=AdkC5GhE2He4iqKaC113bjJzvpnzawJHMZM6hfDY4w5TmOgJWekVFCRJ3vl34APrPZg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsvyS8ycPEB5udieliVAuSYP7BWyIl3b9Y2EMvHAYlSgw&oe=699B14F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLfuH8H7emEQ7kNvwGY6pms&_nc_oc=AdkNp3xawzz9q2thq8oGaPiVeiGFQUHI6g9dW1kU2B3Ae-I2anwG05zlH63fXUt0Ykc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft6JvWvLVw7HXG-CUaFGbtsbi36X-367zKTSLqbeNPjKw&oe=699AE804"}, {"file_name": "Frame 84.png", "id": "1747234655674817", "image_type": "APP_IMG_COV
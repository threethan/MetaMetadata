ri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cDTd9xPLzkQ7kNvwFrnHrt&_nc_oc=Adpj3ehwsphoTELTtI38S6OozzfL0tW1_ntcAUtmgw3ECOv1lref1wgVJtK3IH99HGc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOaFGeb2CfCX2GFjjCBnROOvWXtJ_rlwuETYIcB03yLA&oe=6A4E3CE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjdS6K_1pY4Q7kNvwFo3NPk&_nc_oc=AdrTxAX3dgwt9kwyQamp0_9agwm-DfP0hmE_Hi5JQLLX5Us2RYKiC44jzf5-2pvJ5N8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxwemH5kexw_Wb0p5VRmVFS9mfK5fzO-Qpx9jl-KI3Sw&oe=6A4E3932"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y04KSS9qjoQ7kNvwEkpx09&_nc_oc=Adofe0mY03sn_UpiQ0qrpOUnFXizk5xIznCb-zrWxt9XfZo9iiUjkiBAiUseLN7BkR4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJOCbHKn7hGOsvvhVLJC0UiAVHxNR1saCYuG1YcAadkg&oe=6A4E3DE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dlae79cuMckQ7kNvwEuVJmq&_nc_oc=AdrA7y4RZ9A_Uipt8lSEYiDxufOUKabfAJerlqQGRbZ4OQpqS4PuT6VPtbCLMIst0Jo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCycI3aXERl41yv5ny0Nm0cygUrP4bKk01-58jDXsPQow&oe=6A4E3D5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oY1tk_6pPAQ7kNvwE24ytg&_nc_oc=AdphiNzdKEm4Lc7hAR6YNEELFtiHSG0BQkw67j3KqB4mpNf9IlXsZmG-qc_cKX9LiOc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2ecASsPVPk4t8WK9HnxFfwYSq_DVPfa0yoAuL010myQ&oe=6A4E60F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLcG59LFrnIQ7kNvwEUoule&_nc_oc=AdpLPfgwK2yMyJEW0O4TiublMRKTQn051TrF21cP__6ZFSr6Qyj1MNPvOxUbGyaG8-g&_nc_zt=3&_nc_ht=scontent-lg
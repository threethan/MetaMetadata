ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjDfZ-bTylsQ7kNvwHVUNOk&_nc_oc=Adq1AxgqfHKSY6q6KBI1ckkTfRlHKmVzvnvKJZi1S4T4aLWNJKnV17NRjtbGFJRQjzs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34MEFEROnxIykx-cmKxvY8cBxoHUpJ01mNwDk5YmJxXQ&oe=69F88B67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbaoX28kG1MQ7kNvwGIMUXv&_nc_oc=AdqwyTV0IkWL7dJIY9m1V4vaZapE-_vYpi2k63yYJa4_sEIziDVSBQOf3jUwUqq5oDU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Qoodjd1AthFxAGBI1ARkPozatULQCe69hfumeIak7dA&oe=69F8BFF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or-DxEELHw4Q7kNvwGEi-pr&_nc_oc=AdqfP89u8VauzCoFulEh7MYZBtLnlx8IdHgu04d0v23Kiz6OHWV2R0Mmh4ohMFJponw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HuY96RG0CV9IiBSON79MRB3v4Y8shFS-IAQBkPwepaQ&oe=69F88C69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_oTCN3ZHAoQ7kNvwF-KRnQ&_nc_oc=Adr26P7D17rdnRU_aayShZusG2GoUSbnq_Y-DMHfcj0L-rReCfCZdZFcBcGC4y55xrg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05Z3jONlpDpQjKwe9GT13xqed0G0lorPwsnNbyho690g&oe=69F88BDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj8qzlwSVnMQ7kNvwEtDGWa&_nc_oc=AdqDSEYBerp8q4WbE7BqhLVq8Ty8o0wcr_K8B0MWcMAPqMKiWjkh2ci_DRMlbwIwx1A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Jipug_s8gwdaOYOIw2_3B26DFXrHHWxQnLIfCdxmqYw&oe=69F8AF70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIFT5gj-jJIQ7kNvwGpB2F5&_nc_oc=AdoJ7A2vxrURIm_QmHs_3Z2yBVsanZSN1C8AKwk7XdDayRpdHQplJIGhzsgQ5kSm_yg&_nc_zt=3&_nc_ht=scontent-sj
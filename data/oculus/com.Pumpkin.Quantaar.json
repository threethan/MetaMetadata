ri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1ic6xI5mg4Q7kNvwGI0yLw&_nc_oc=AdrCwVvvphbq_iccnX8VsmZl5JqQoT7Fu958PTHl8kWDPod1Cb9zo_SkgHo9Fzpqh6g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvabK1D5BXNLGtcZNiFEr1oxAXx7hxrGYqvHR04p7idA&oe=6A58C8E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7W5CyI6cY4Q7kNvwFiMEW8&_nc_oc=AdpMpczPBWGQBMRCp-XjXM-t5wxmF82r_rJTyZuNtQhdQYDWsoIRuvB6KUMRyAnnhRU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC4-ecaNUhBNR-TLc3y_Lxmc2E6azUl1nYx5zPgFxmpw&oe=6A58C532"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT_4NttlFV0Q7kNvwGKBso-&_nc_oc=AdoUPS5gJ8KH2oGSjS-MFHB2r_VBktCTGyiCj6WHH4MFr5NQqO3sxNKhVmVWxfmH24U&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYIQiXz4OyzikyAbr3cMG-n-6-XUMyNdwKedBKZ1cPNg&oe=6A58C9E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmisXy5odNkQ7kNvwGJsc49&_nc_oc=AdrVzboNVg5CQoqNKkU45m08M4t6N6xaX4n6YkfYFMS3FD6GJLVFNyz-tndP-atLE_E&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASrNwLnxbbrgoxJGrc0dY06iLl5xaxkuslpIK8JxYvEA&oe=6A58C95B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uo2ztqnBdtEQ7kNvwHy0QQt&_nc_oc=AdpQJEL2l14_00cimrmq-x8Gwc_rMWvy2MN8Pxkej91NAjEmzHHqgbhSnAnEoHbDdSo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4_ojYE9-t9n6zVYcn7rRJf8i8aJfU8DSvdW3c_Y-X7w&oe=6A58ECF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbSv4byAwbsQ7kNvwEol_5F&_nc_oc=AdpXN4xEjU1IhaxQTzOCpF5fBoEg4OxJMPEfUBLUy6NtwX5wVeyqawCIqJws6mSFuFg&_nc_zt=3&_nc_ht=scontent-fr
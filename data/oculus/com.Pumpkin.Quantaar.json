ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCiOyqPqUwIQ7kNvwGlSAzZ&_nc_oc=AdpxGahCJh8L7QMHKA695KF9hG5mCZqRI9ZLRJaPpN-Qj9yNWnNXjriAOKxMH0HzEDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EvkOro3oIpndqNYgl11xZ00_hs6tgGaeBY00lp4aj4w&oe=6A3C0027"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HckDqeaPwqoQ7kNvwFpOvnR&_nc_oc=Adp3e1dK6yxbvBhGhS_6xX7_sFMupg_eRGyesTO1D1U_0kLqnfLy7V6QKq7ZMl7PcnA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bc0SC0jG-keoRLSD3PUTPT3jE3jIR5UHOvfSk2Zqe_Q&oe=6A3BFC72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkd72YmIvF0Q7kNvwFhZBJF&_nc_oc=Ado_GhcYjJhf7_e6hEh_repl_hpwtndVxxnaUs1cf3Ja-7q1nuzaZ_J_wp_I5UWVTfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VPARsCZfecq6tkaVHNPvGp0ls7PVrLPSbVL9awe7FKA&oe=6A3C0129"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyVoVVktlT0Q7kNvwGWhWcq&_nc_oc=Ado18nuULSpU5EK21KXO6817WKgVaiRi7Xe5MZcGXQlIOrdzrrGUDSnrtmL6Pm_FVc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_952uVuKZ0Pv4spFPKwHMdV-WMZZS2iV_W0yYb2LF2qw&oe=6A3C009B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ0u_7VQ2o8Q7kNvwFb3DtI&_nc_oc=AdrDG_PYHbGzOIOVzzny6TKcLWjiFFFuaJzJbRS3mADQ4rHu0dN1TkGQ9NAamHE29jI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9glF3ldDk70k_ieHwcBNvUTC7U2c7kSX6vChiPmK7W4g&oe=6A3BEBF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LEVYBaAjOwQ7kNvwGDw-5K&_nc_oc=AdolhcjkBPedcFlCh8Y2HgoP1nduC86LFNeKE0upYk_WT4ZDVM7E9BMwbWZm30iKdsA&_nc_zt=3&_nc_ht=scontent-ia
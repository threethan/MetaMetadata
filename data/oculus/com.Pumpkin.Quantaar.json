ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyJHRRjm7TgQ7kNvwHHzTaS&_nc_oc=Adoyv94AFW-_uI_0t0jgyT5uINnBXlGAerIHM6KWuVliAmHlpyf_fGj6qki-dvvRImg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_N1UO9aR02a58_JXGmp3t_0qHQIn4S6ntHplg5D6eag&oe=6A577767"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7W5CyI6cY4Q7kNvwEjkELX&_nc_oc=AdoqOxkvUWAoPxbzTFuxsF_LHvIHJWbCbxuRgDQ4nR501hjfXA8X-tYwSb4oZ40ZxjA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLIaCqFanmlPRQtDHYNwHKo0GLtMtEN7BraNwChAPa2g&oe=6A5773B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qT_4NttlFV0Q7kNvwHTQoiV&_nc_oc=Adrv-z6iacsKEudlw9SRbi2-uepQQ3mwpyaXu3bXBAIxJ2k8P7-naX5J-DxVuG1QuIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG2RrslD_H2rkQQpvljIKqOLiaFO-dcHlDh00HqZoQaA&oe=6A577869"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmisXy5odNkQ7kNvwHRGUWk&_nc_oc=AdrpJI4GTQ9nfvu-SEfbPSHuJTrW9Grhpvw8rsDsxJLLFgU8I_6mf0coHiLUV6n9XeI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1HkrkwBW0NTIpxAmT7Sl0TGuVkX31gkgCKqS1Zm0IeQ&oe=6A5777DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPEq6c44LpkQ7kNvwE4TaL0&_nc_oc=AdrXKWBZtCbs86Rve2dz9FLl6UI5zMocaLnx_dd4_3uv91rhdjBduXYfNBCOqIU4kr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLnxAvFL6HA9SdBY-YcYmULxVYEbgWlH76t-BaMqYuRQ&oe=6A579B70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbSv4byAwbsQ7kNvwFhnj8Y&_nc_oc=AdomeJmkqZfgttSsjfbYyV8eypH0sH9IxcnmxGKHubNp65AOLYv6JumfKnkFPZ3iaQ4&_nc_zt=3&_nc_ht=scontent-ia
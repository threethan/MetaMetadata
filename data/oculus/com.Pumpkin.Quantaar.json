ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnEK8WJeFxoQ7kNvwEha1YP&_nc_oc=AdpzwtTLUm5fz8EK-x0sjRHSnUBNt7oeEQszicz62qsbY9QvmhVg8vOfJ3AjXrfNuNk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYU_HaF1uGQBk77O7W28jixrQX98PdVfCkHFlGHqHklQ&oe=6A492F27"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGooz5gKI5IQ7kNvwGqQrVs&_nc_oc=AdrjGifHZscXBACzk2O9RBXMnTUbDDen1mC0rTyzFXFdjVPn2UaTyFEKxRFsgSeNb2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-DhdMpgozhCQLmAlsNsGKPiDTKBpoQjk2GI76LZVNow&oe=6A492B72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zW-Hn4hrHR0Q7kNvwFcKVXo&_nc_oc=Adpapj36VqtdzdMzSJFE9qIFxuep6Fi5GL7oxI_3PYC6Z89HTBIKv3zv6NYGTaNFsMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKPGXVuwbjNDcCQPATnm0RvfHhJN91a4Vc_bR_FlgoTg&oe=6A493029"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3YS_j6gC6sQ7kNvwHou4Ho&_nc_oc=Adq_g_FtaLLLYKmHZ0Y6EuSfZstCxU5-SAyCmd9VtsRVC0zb1yo-xwOfDy97-K59H-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDONewqBKLgVofZctYAbEQoCOS9LypsYgrDYBMZWmGRMw&oe=6A492F9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdoVwTfApn8Q7kNvwHb527d&_nc_oc=AdrQF_ZqbT-NEK5fmWnW0-GcY0S03uelMgDUQDntZ1p29egasP5GQtParXH8l0p-Td4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDd-UMSCk-0muzcWyvp9o8H0j0ox1TtiKmY9i1mfnGyw&oe=6A491AF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hG3wC52BaJYQ7kNvwHvgRfl&_nc_oc=AdqKtwaUBETEWBVrv01sstCg34WuPJg6o-o_O_Nm8d7LLUfO9RywPZGMYg7JzC7Kifo&_nc_zt=3&_nc_ht=scontent-ia
ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXP7Zv25YTkQ7kNvwHrFtvx&_nc_oc=AdrE08MQKb2c5s_q1E4M04Nwf7BhOLdrj5C2AMAA-5iXsH-qhZB_p0GBTpV9jHDd5Es&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfrumuiAtuL5PggpM3Qf5cntqyMzyptMlDJ9JPproBSA&oe=6AEA0627"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhU-BIQp5dYQ7kNvwHXGM_s&_nc_oc=AdomX7uJi8KXxx63WJzlvHbGqREM-gtcXKKB9KpquLvwyut9L735_soL8UxCRa8VaNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYFtaPG5AXQ8adI3eiFNY3Yy2_xFxeyIN8Wu1cLN3QpA&oe=6AEA0272"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBjDiSbpNMYQ7kNvwFGHx31&_nc_oc=AdrpJqn2DZNUUfvuLRSVrH7DorHYVqbo6ekJqLfoYlc2znyeQDO-dDygWfpr1vFOcss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYVh3vgo2Qu5TN6Mzf95zJZOqiKREqdO7z61BkaFksjg&oe=6AEA0729"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l492_oUso-cQ7kNvwGiJcjX&_nc_oc=AdpbZtSSQh5gRRfn2X8U844jtUbUrTAgQ1BI0X9Pz8Cgj6Vz3ZsivqBgpYx18IQmA_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOLKcI7B53BLu5HebyRZYn7SuGx5Utw-qwx8uBOrY3LQ&oe=6AEA069B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXo1Bc6I-4MQ7kNvwFMf1s8&_nc_oc=AdqSL1E8jNEkLhcS3OWwzOfNDsie18RqroF-TacrulhmOOYHlO9xyhb_gaFl5B-T2Wk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ8rxD57b8K3g8h47yjeM6YJ7cOwB2vn4uWx3MMRnWDA&oe=6AE9F1F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8d5LWMv1nsQ7kNvwHtFu0I&_nc_oc=AdrV28PMCuoKOI-m7XtUx0gh-wIIiWKIcCmx00Gp0r_CQ9yJz0Z7T6vQR-sleDVNuhE&_nc_zt=3&_nc_ht=scontent-or
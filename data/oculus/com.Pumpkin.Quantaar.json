ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzibdU2WTCkQ7kNvwGNfET5&_nc_oc=Adrua8qSF0DEpsg1d_ybrD8Y9s0J6_ljyjqgtVaC4FEnISx0x3SuIZgLiz_32Q-Waok&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IxAYTkE-NmUXYTSmRp3xBzdHYww8R85XwftgCGvDd2A&oe=6A3568A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWK0eNOrYlMQ7kNvwFoMwOn&_nc_oc=AdoPImCArpj-PQs7J7vHuJh2zKtWHsnBawF70M4EWQImC7pIGqjxBvz7vMnTF_d24as&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kCX4NJv-S8arpLLD8LLEOk3FZ2QBjrjcun5WErLvuBg&oe=6A3564F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0ZbdQ_a1woQ7kNvwGRpka-&_nc_oc=AdqJu-yQx_kd870CF343jqB1slyFBdD_Z6yKA_kELIBEDMKTur7EysfG6EacBWc873o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dyKakwFXL2ki6y2XbRWHvKXldTADwTWAI7fVhH90XEg&oe=6A3569A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHfVp6TMr2gQ7kNvwEWrY-4&_nc_oc=Adq7lLi7uOIbr50AHkKZVNoxXDGgKTqGuMuefW1vI_8DlqckrqHXHkViCDJDu4n0P-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DkAgooRD_YEBtMzH0wwvZoZ4pZ0bAX6m8M2Tbpo5zWQ&oe=6A35691B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOM_oVbsNFAQ7kNvwHQl47_&_nc_oc=Adr1vWlRTgoXqKbkwKmNtgoBps0i25r-OeLcJgWXxgXg-l-LFPJ7cx55cmgaz3SCikI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UzIUCFJBhLKRcGcq5piVb66uVXDTm48XkPneJk-erxg&oe=6A355470"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpK8hUioyXsQ7kNvwEgvTY5&_nc_oc=AdpykqdL7NQnNSgeAMJpb3GuBYjn_TFmN00aePJwLop0vst_L_QEWtdbJB3DS2RwiZc&_nc_zt=3&_nc_ht=scontent-sj
ri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eBAeHUCCe4Q7kNvwG-xIJq&_nc_oc=AdqXKXhsJNVm1ERK2-dcdhSQf-tqtDq9OSjzCAnn5wxZkd9aqEIIP7dB-I2kng7mz0g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWw5inzqgbbpzWSZvs0Gb3g9RsiY4RSctSno4xowlaBg&oe=69CFACE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZ95c0bWq8IQ7kNvwGNh6g6&_nc_oc=Adqn6loKr91qoQvLXUNmDqNeBFW0W60qW34oyO-n-KpU_pI1A4NS5GudHmio1a1XXSM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwne45AgnPra5h_AisGbqYFYcWhsMoLiGpXOPEufVGiBw&oe=69CFA932"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS7UlKUX-TQQ7kNvwERqIhe&_nc_oc=AdqL-nDP6q_ZjbNhYpxYBqUeabbrbtagFCfwCt_0iXxA6WUjmfaa3FZ1cpzd-lJX89M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwVv6dybzvFwre7PN1UTxR75L6QiA9PdLq2kqeRrp9daQ&oe=69CFADE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=430hYP5t5kMQ7kNvwHfH3PW&_nc_oc=AdqIWtJ62iP_jLzQOKzxWlKw-TNEVDu3kH7kftWzv0GBmXuTrZuQ2jidYWNu1dM5NsA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEIEesf2MFuQS3utx0t1RjKQVrAgmtukK4ALsprV7dPg&oe=69CFAD5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ko0CrtXz0DIQ7kNvwHVST4f&_nc_oc=AdoDziIz26pRTIs1FMH2nixJqw169CJplF4hhQQtTw2oRVmV3xt1yu7e0mnnrTDPyhI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCiJODjH0xypBUCWl2i2Slzm-SzKw8_AwLgpMl5ei6Qg&oe=69CFD0F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHqZCkDMQFoQ7kNvwHTSpCF&_nc_oc=AdpT-oPk1DQD55IIVlLBzBQ-GUaumazqJY18Ox73SeF8ic8bKIFKqXJbd4dFuIPj3yU&_nc_zt=3&_nc_ht=scontent-at
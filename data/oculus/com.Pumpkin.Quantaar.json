ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAUB3eAnJkcQ7kNvwFHDqK_&_nc_oc=AdpcShlio455xfvA-CksZmEz8quZH8PVRo-mFHFuvrYpyCZCnWb87Fp_qWi-_ANgB6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PF1aawoeRUOoAvkYALD6yD_QOLULNZdJEHUZ3gQl4Fg&oe=6A2ADCA7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-tCSghUDmoQ7kNvwEt7QiR&_nc_oc=AdrbSz-dTC2zYevHd1gNxxqt7DdGU_TyzwqtdX6aql0qPevtYojkyyLJ3PftAyqJsYs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B2qSjio9d2G9wM3iiYVZx31Sr6_fg1S0jo1wEHaXVsw&oe=6A2AD8F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd4XtNgmrpYQ7kNvwEoJuHd&_nc_oc=AdpqG_X5GuTGn16zan8MDd4fuHNtwSVPVhXX1fewyoR8JIU3mr-9Wkm3cB3Z35erAXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jdrKrpycBCP-CIQ7jFQ9g5MQGeLKiwTgLjWRzuAq-NA&oe=6A2ADDA9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dE3NIceBOdgQ7kNvwF67ssY&_nc_oc=Adpu8KjvrtrY4ZG6Pni6sCQ2-6b6HHoIMk5nSAF_UfGWw7BT41RMkcVzGI8gAv19sCw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9Y8PiXkn4ukL_ktRXOKJPq8Xu1fOAEAMG5uVD37wl5Q&oe=6A2ADD1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAgIBJHP_2kQ7kNvwHL4ivg&_nc_oc=AdqU5UaoFvLJO8FVPM7EpwiXiilLzHdrV7zPiaMjb7TN-du9x9FAuEDn9U6Nlkjv4-o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ltEXssO5sdNKNDQnt3ySI65sRRG22KOEyx7uqOhhDFA&oe=6A2AC870"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6W3FE40LRwQ7kNvwEqaooG&_nc_oc=AdqMJrbEzc__ux0TT2Oxds_a7-xzTslLIYMruXqVJdeMs_lf3xnaIFB3tpk2KUiBsE4&_nc_zt=3&_nc_ht=scontent-sj
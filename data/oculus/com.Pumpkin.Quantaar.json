.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JSS97GbLrUAQ7kNvwFigLyM&_nc_oc=AdlnZjwRqlr6rTpCWFnrr0Ct2VgacrULFR6ULXuM-HFHjZNv6DfNSgGaOVr5UQBcDTU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsq5C9KxUEWiiQtTnC6DIjOkhPoOzSU_sCJV20--OpCzQ&oe=699D93E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9maOsrbZV7kQ7kNvwFW43k7&_nc_oc=Adn29RTwfem4QLxgEVfC2qZ8T6mfBiAHDFcV3DXs5QkgRduB9xpgcx4kwYOFwaoPfcU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftbATdToVnSE8Q54htQpQxFZHBEU2jJ9B-wAzZUn_SzVw&oe=699D9032"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3OeNFQmCd4Q7kNvwFjfuWI&_nc_oc=AdnCsyYtUZbOPfwjnxhAjlAo25EIVmQZ4Z1HUH-wJTrTmRDKJVNo13amJ9mlzWtb8n0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuBAdYXi0AnrRKrDxyhg--JIPFB0L_1J9qLPxioNRtmQQ&oe=699D94E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okTX8CiNrh4Q7kNvwHrm-af&_nc_oc=AdmKwE77UdNw-LViQOruSYEwKuQ3MFvjye2pEUZjJzRghU3SumAKxsTpbT7TB8KUP-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuvPFPUXsurnQzS0Ul45hEKU4Wiw1CJ6lQfSSt0nepzxA&oe=699D945B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTtxF33ddO0Q7kNvwGsstbC&_nc_oc=Adlip_WYjFGFVIQ2g-bZvXCP4FrpFIDIoyzAQaRgB3Jz8x8icUUnvEnVT-PtngM6SDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJnx0KAhFeY3aY5YArfd2yK0qWH_J2zUxRs4HOwEOMkw&oe=699D7FB0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqQFZwbougIQ7kNvwG4pkT-&_nc_oc=Adn31MysxJhklpX9z4fwS9Sky4Y5z-YSMFY7y0qygIreblPlbxaWV4IJ8BmDdzLKTDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvwk6BGTYeK4p__nmYcJX3fBfa-DzhscMfNOUSmaoKMFQ&oe=699D8B04"}, {"file_name": "Frame 84.png", "id": "1747234655674817", "image_type": "APP_IMG_COV
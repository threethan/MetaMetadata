ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yAh5gs5ivoQ7kNvwER84fF&_nc_oc=Adr_sgYx4p2nEmwyby_Mxn7c8jd-NI2m6VvQ6CSsGk6p01TbS8icd3BULAQTLhPhzXU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR2ahSiD1dKo87B0xlHRen2X5nfsSpJ7Dr7DLM9_GNsw&oe=6ABA9027"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7ADD8DXxEoQ7kNvwHDHGUa&_nc_oc=AdqAY1_SGVJpe6OUtO_wry83UV6jPRgkTi8BR8oi5mGKmdaq5zL8d2rnpC1tr-n_AQg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFzcResm79lU8xmZE3SJ_xeq6Ytl3i0VC0zvHoeH9Sbg&oe=6ABA8C72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjGA9NqH9GEQ7kNvwFxnDmH&_nc_oc=Adq7C5F1nL0s2-W1s05hL937C7PEJmPeq9jLONNCJeW36OJkWn9MII3CSIhuYJLlcD0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmONvpOdnBUF4OEhySjMsA2eb7wrNWT4-xTPL3cmtAOw&oe=6ABA9129"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz6rhJtzAAgQ7kNvwE44tub&_nc_oc=AdpwGZOs_FY_gL0UnXzuYVM16z7phTbxamGW7Cq6DEjdc0hdvuE_FmqzarPuZbFo8M8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMfWeFHM-13__pHpUywpAgXWaUTZPjHUWYivw4payYGg&oe=6ABA909B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R884DQdwKfcQ7kNvwFrjaEq&_nc_oc=AdqxCtI79zyYcKpqhzXY39ihDY_s6waFLwe94ZfN9sFfdcLCAETv6GS-v81_OBiKPy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrCUFAZ9TrniaE-yyfOHhRAlFFJNPkjRQC3K-AuI9F6Q&oe=6ABA7BF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hICI5rc6-cQ7kNvwFiZxIT&_nc_oc=AdqQvKBOyG3IDyb9GSZfoC0LYWEO8RYPIh8t-OGDvXmFACkIhF-apuDAt6u9M8uI79A&_nc_zt=3&_nc_ht=scontent-sj
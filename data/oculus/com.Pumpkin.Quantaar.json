ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGE4fcYBcfMQ7kNvwHUjlSm&_nc_oc=Adre0RgQAc0rWIEiO_OS4jVEwR4eCjP9ifX66NfSA_JAA7izmPA33OpgJi0xbSvwEjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wnjF1my8h27Y02LYM0v5TDyRDr5LQVBOYZ5HxmfbU5g&oe=69EB5C67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-w0kjb8E8sQ7kNvwFNQKpM&_nc_oc=Adom8ybMKxJN2VSiaJKfbdRgQHIgmsE-xsMCKca_XNTUWaHQ-WbQipRN0FehQzrD2fo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZZ9nxR5BkcslInjDf_i6k1dP_BOjgDgr_DxAUIvOxGA&oe=69EB58B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6yVbXepAysQ7kNvwHXEaEv&_nc_oc=AdqcUx05dbkeyds7ph077UWJhfm-FQdAQBIT_lBpfDArUTHvnNfO5xVpzPxM-XGAqFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TQjSpE_fmKCncXBybAF0OzJpjeqVqP2NJ0T75I5yf5g&oe=69EB5D69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbf8sgqbGIYQ7kNvwG63XVs&_nc_oc=Adr1UiO90oJnn7rrFYXxPmdgeW3cBxDr5L84G7-v8ut7TqrrYRGBlfWQGM4T6H29nW4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1L0rkNGUlnOFerYXNgigHN4mc3FnAvyzgXEHDc_ujHPg&oe=69EB5CDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQNKPdtVCucQ7kNvwGJoqt2&_nc_oc=Adr3hKHfPYmk0laNYgOhwtHuRhyKn0eBKliI-6MlQoKIHxd2aFjiEnIEpQsiyrCtZzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36HJnisiUdnKAiYp96XYlXDGfK9PBLpgySDQiiYAlQQg&oe=69EB8070"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng8atFCaKvoQ7kNvwE8agUt&_nc_oc=AdoGbEeXSmRP3s3Fw6yi0RCBPlt--0i9zRAzFQ4NEDmtX_CKsJWtzi8qhzki4xR7lKg&_nc_zt=3&_nc_ht=scontent-or
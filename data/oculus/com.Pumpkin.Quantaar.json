ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHjqE3PwYmIQ7kNvwHwtHyH&_nc_oc=Adqh1io-RZwCW2_e16O-sC494yRQLlOOxqO4xjV1STrF1vVzJ-4jYwiLSi_HROHNOGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjek6kUfdKofW3-eYfyuSXnCliVu5KBi2GbO_1eH87HA&oe=6A69EC67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNPkb0sZHuwQ7kNvwGea-rZ&_nc_oc=AdpGe2fFeiBl5k3Mf2pIOmvzeCV0LC6PZ2IPOpQQCxRZB40X-4Voq1MXU3y_dJemQkI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPCwujhg6tRUYV_M-TH7gL0kDo2yV9OLSJjhXGEdyieg&oe=6A69E8B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=382cEhIiNT0Q7kNvwEZUZR5&_nc_oc=AdoS8Ppf-DzWbKg1PYIyKRCx8CNy6Vq1WNalDXmCTQtUzsDSHTj20K9G587lzjyGIlo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEtutgxe7Ic0A4wmQ28Xa-lXtvYZA1rCU3Q27UzjBN5Q&oe=6A69ED69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ie34Xuf-QoEQ7kNvwE6wQGT&_nc_oc=AdojIgNWPkNcnzWYxvONYk_ph0aSUMV2CQq9ldQbBNkyQKYp4rM02rdz68A8BGN7pPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBj9Sv5LWBQHTq0WxagaME8NIP3JKzHRIjEZ8MfQpEUqw&oe=6A69ECDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-0QhwQlJbUQ7kNvwElXg7q&_nc_oc=AdqzZro1xq7AuKjGtq6m4ntD2wFm7J4EBVJLITkV9tG_I9w2WzuhqF5G68uuUlOV-Vw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA34q1j_nfMWd4pUhSSC9skQhym2iAY_PBU6Vb_1poojw&oe=6A6A1070"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZaXXF8riG0Q7kNvwGvfi9Y&_nc_oc=AdoH-_I9Pl2nDJ-I6ZCdk-eaTbWQxhWjqOTWT1IW-eAiZdn256ln_qIFEL7RYvmdbjM&_nc_zt=3&_nc_ht=scontent-ia
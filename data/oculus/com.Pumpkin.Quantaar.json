ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oda6m4Y0wKQQ7kNvwGaCQsF&_nc_oc=AdpocSSDeaDCaQoGjr80Sy_LmCeyTUXQYvo_UJWJOmVxdd5-sv7qA4pgksbk1EYAPjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaB8X3aU737Ndt6xHzUsd6Ef2bel0SiSnxKI4_9VVJTw&oe=6AAABE27"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3MQRvqUyJIQ7kNvwF-dlVF&_nc_oc=AdqMVLZKchc2cbhmR6nrmfpCKHBWEH72GPrB7KQ2ZkpYc7rcVxScbayUGKs8kw9eHao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg7EgQpYJWuDGbVgpnlbM2KIfOMbZR6RVOmXuZ1A_6Tg&oe=6AAABA72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4DswTwQ1vYQ7kNvwEXEs35&_nc_oc=AdpTMv4n9Zt3TZd_Jg1xJXKJZSEolzQ3n2cUL17ehG7BQVRWc5kpgT-DejeHTiaFuKg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJheNRXr1hXMlCPW6DNPx-bZE1E86sq1g1xXkF3kH9Tag&oe=6AAA86E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHgxWZOzD8UQ7kNvwGWlyJh&_nc_oc=AdqLUs3v4fE7UIdnnSY6Ff9hw_47_Wamd9wKIRv_sTIuurJaF8XdmESLlq4n5kq1HM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSynoPVkcB0nkqGarcDVAio56Br-yJwuBNgHKzucF6eQ&oe=6AAABE9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xTBSOMfJAkQ7kNvwF6MhCa&_nc_oc=AdqF-FcMhZiJcGH7IlMD-ZPsxicfvqJiTHEV1knvgZckqd4BUVTR5j7o71FKy3CA5Ao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBfoaDjWqENAPbQVmh96sw3FQonKu-rLbB4SZAXYnxRg&oe=6AAAA9F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqdtIIZblaMQ7kNvwFauOWX&_nc_oc=AdoT5OyJwLTKSdfCOyJ-dD5fJ1vhwDzv8WQuO2ojbVmzVJtFKKGR_AMXbZGjalIV6bQ&_nc_zt=3&_nc_ht=scontent-or
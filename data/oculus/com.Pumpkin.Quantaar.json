ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z99P4nDHz7cQ7kNvwEEL1WN&_nc_oc=AdpNWX4veEqCD82rXb28nRow-mQkuFGH4Vi2CM8-vd90tckwWLia5ALcXnwyNSs2aMw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI73zJgI2EIJGTDXZ6vOeV3pd3JNSLQKgsMVOeAopXHQ&oe=6A9EE0A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4U4O-jcyWkQ7kNvwHlIdX4&_nc_oc=AdrqCGJiaxREpdSw8l-9EjrcN34PFgQuoxb7pst1q--Jt7KdwDW-PxXM6xw-1ZWi27M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6miO2gfw3sSGx1bE4ZofofslSroZw8d3Q-POf-r4eDQ&oe=6A9EDCF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuvNq7WLkJYQ7kNvwGPzm2W&_nc_oc=AdoiKMFTntj8-68ASQWfNgFtaSNNw4gSHv4KDOb2vCiuBE2JxPgnDwq9QYrRagtqMUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNxPhJ8KfwqFNsQJKaF23exEEp44zpRLBI-i3VdWQIgw&oe=6A9EE1A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJeIuBccnfAQ7kNvwGiv_mS&_nc_oc=AdrCi21YHPAQNM1SCS3OEJs64ab53kWfnE7ULD9Iym4Rm39EgRFLoemJN0Jqd-g0_MQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq9i2lwsmRPQGIlO9g5r5BgsktOk2i2mDerySOYCx35g&oe=6A9EE11B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKrL7p7lF48Q7kNvwHX1-EQ&_nc_oc=AdqMJSPqaiF7HUelNyWqAav_bxuo3RrJrueYZFWKY6ys0gmMri2r8w8mgPD6wtGBjbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdZM3EPCKlPccUfdVj6x57UnbModnQC8Z_H9oHsNqBGA&oe=6A9ECC70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwpZJsF-nGIQ7kNvwEjTk83&_nc_oc=AdpCYtn-45WW0WOb4nwWOdLTd0vvR7IiqGbEhppyx1RQN8d3cUiWnztYtqdBiiKV4yo&_nc_zt=3&_nc_ht=scontent-ia
ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbQZS_7irdMQ7kNvwGdJBKx&_nc_oc=AdquRCMEKczKsQmyngWWDD8bY5tyyfGAleis4RI4TlKEo8YlAygRHu76H0e6WnC4GV0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqwA30a62QHGkx6pLvGtU7zP6tZOd6Ms83rChXvf1ZiA&oe=6AF49227"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmyaiCmqdVUQ7kNvwFHptj0&_nc_oc=Adobc0BhEm7lI0SQ9fX_OMUWpZbIu2kS8EAvMFHbIcoHjtOEY1UEuztQmjd7MZ54W-A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbx2OoskWcTzyMx-YXhtgKrUHF18n8v-ZK4BcVetIMCw&oe=6AF48E72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGyxkEyKC6QQ7kNvwGUFisV&_nc_oc=Adqh_1mcFn2NIfAABvFipxP7I6PihX0euBtzgiPZH08lZzZ1yBT2ODYZLneacjcdtuE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRj0eHB9WwtvS947CVq7Y6gkJTr0CL2ermGOCEijRX4CA&oe=6AF49329"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD9C_GXG_n4Q7kNvwFfDUBk&_nc_oc=AdoP6UlQGc6Z2er-bCZ_p_SoV7DClJ3Gjn-hEtUvbVRoH73jfZZzDKV_tIdxPe3QB4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKH-D8mOXmPdkqqbI5xmS4squT6Y9HMvl8qXuNSHHLMg&oe=6AF4929B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTSLjovTq5YQ7kNvwGzeXDe&_nc_oc=Adp95tFceT2X2cl6raIeaVNje5mjW3wRg7LZWt-HFZGuoFC0cVRIqXiQ95Grsg7aqJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWO-zaBR5Efry3vtgBTebtPInQROZIglQw1N84mSoYcA&oe=6AF47DF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Jo8VXYA2zsQ7kNvwFWYvqn&_nc_oc=AdpcR3cXztmDDLDcEscKRw3m45GoFDMtXdPbytlYreMe8Cct7OWEnv7hsPUggNGblV0&_nc_zt=3&_nc_ht=scontent-or
ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_M8NqXoUjcQ7kNvwG7jGWz&_nc_oc=AdqfWeer4j__3VVuljgkJlJfy3XIqseFueMsL-gx5mH0CdbR-d804-_9--QooNp2EzY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpGbwnbazOupZJY4k3unGVi9StXdpd0fyfFVXppSkdeA&oe=6ACD0527"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOwaAGst2tcQ7kNvwGmCtDV&_nc_oc=AdqdABgdLm6a1bV_lQUUs4AYNp241srLeQKXHpj-RXToA5aUv4Yyb_Pevdzi4aR9rLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOVGRvfUzVvFjjXgULpvLnKu4-mDl_uVoYP8EVd610Arg&oe=6ACD0172"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh_2zHgAoCsQ7kNvwFq9hTH&_nc_oc=AdqkfMrEvZiOqBXUEeXsPi8g5rV9onozFIbrYneHemOg8VUvzM_wzXRg7fnfnEQjz5E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYyO72P79vPfUBNKDvHKLROgoWaKeIFDKjH2ABwjmvVA&oe=6ACD0629"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_V1a1wWDZSUQ7kNvwGZqDDl&_nc_oc=AdrsIt4aRr1Bkak-6STTu9wILKDtz9vxzfqwn-oK-pjRM4mAC_heGmqvbvUyTQgIrmg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMceLgkRWnUusXUwoT9Wnp0zMZbt0jWuWzoqbjsSs1X-Q&oe=6ACD059B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dVgLqyNLe8Q7kNvwEmfeeX&_nc_oc=AdomvcKQgcPdvLpVxjGAKaf-9CV1iS9AIT-iVLHWfNjpNOGl0eX2TWVyqb6tn3oa924&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpjpR6h2DoDlWAKzy5k1tRM7H1-xsMgZSIp055cPvCwg&oe=6ACCF0F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5Zn5UaYM7oQ7kNvwF5fZuZ&_nc_oc=AdpzI8CFrnABRK9cpLeEBbWyt_0aBsQoCBwcsgtw1HwyaPKTv1HPY03Zbf-87lxVNKU&_nc_zt=3&_nc_ht=scontent-sj
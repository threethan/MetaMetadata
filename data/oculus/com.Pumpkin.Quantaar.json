ri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVO3RKSbMXUQ7kNvwHWN-Q2&_nc_oc=Adowg615UNqQHBssITYgPxlVFzj8ZTxdQR-DPGPzQDxqD1ohK9aJcdEGfueCx-kP-24&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI25gL3WxAHcpzyequYalQNLaLUrwOH00b3Cumo2d-oQ&oe=6A65F7E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuhbKT_MALEQ7kNvwHwO_3c&_nc_oc=AdpjUpS2BlSFh4_OrRga23seKBeps3q5j-AI3_1gQJU-AkIqsn2yLlaIfhO0BV8Q6ZM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSJtlJjjBpXKjeEj5-jgV0x0GmCJ9Nu8VgXDqzap-bzw&oe=6A65F432"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_flHWO2Rp0Q7kNvwHXRc2C&_nc_oc=Adppbv7VgNguIKdNTGQYwlj8aChJiVR4kvU-k6JutTegtG_EbJ5E3ZasUvCcTYkr1RY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6MHzkwf9i_hVgBB-9eB-WRJBj8YN3L_Q6TwLE_42YnQ&oe=6A65F8E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoVfCh8Hn0YQ7kNvwGAtOdD&_nc_oc=Adr9OmzyCU8k_u5ws4wOwBc4GCrYLbaKKKT2TO86fLbiz-VF6q-QU8f3V4kZQkqjTew&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi76c8mqKcG-9prcRSRAvbAG_Re3yQBTqGStCAYHKbWw&oe=6A65F85B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlA9P6iLxsYQ7kNvwFfBZu3&_nc_oc=AdowFVU1T8zej2nkJ4F2_gquY7J4lm33Ps1-Jb1TvlqVMEPoqrq6wjemhUDY0csQxOg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFwy7TzBUwBvkcn8e4RbgGJofXUHvNpMQSD42urDjIrA&oe=6A661BF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MCsc9ijsoUQ7kNvwGTIrWC&_nc_oc=AdrYUaLy-AOejE-qwsdby-3HYK5c4C1pcRYcw9lhAkoMpGzh1-PRGFtngtO49icFhZw&_nc_zt=3&_nc_ht=scontent-df
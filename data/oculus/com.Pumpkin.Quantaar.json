ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yAh5gs5ivoQ7kNvwHL6isJ&_nc_oc=Adqz7-fzv3r_C0bfgXOzMPx9Re_dsoTKBAiVUJuObL19oht271RCoB1RfVVMH9_rsbk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmdwsEf-yRGDvB5n1Tr2J_8-LCpAYDadRwvpgc8EaYng&oe=6AB7ED27"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMNSx64X9PwQ7kNvwGTc2tF&_nc_oc=Adq3yW48jZov0xnR6hRxfzxTYbTU5C9TJfwaEv3p8Sf1yRM4GL6nesZf1_piuSGFKaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHimJUR7fxau4QEPvTDFSijZBI6k45nsd9jH0gA3OXag&oe=6AB7E972"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gs0HmlUMm2MQ7kNvwGTyVGW&_nc_oc=AdqG2mEiTLMqhLahJHFex6wCv9CI8qlCatyMp0TcCExHTZiPJLhS9PcQy5t1AmHpN20&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmvD8p_v3pSpQ3aZhIQ7IwozAzP_Gwp2HEoNZEmS_i7Q&oe=6AB7EE29"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSo4Et0lfIUQ7kNvwHKn7xe&_nc_oc=AdptvR9FJy6KeWJUy8WzUMig_3dt-fWwvz_cPyCf8ALKCCTbfOWA6w0e_5Txl2t3xD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnF9Bg-nk-Pl59nP-tX7RwEGJVn9tQuaVxfTmNwi0Z-Q&oe=6AB7ED9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R884DQdwKfcQ7kNvwFpVPNF&_nc_oc=Adq-U56AzKei-5Gmi4si43CNdtGxPEu0LyLhP79RD9vaqDojgWZYHmpLXy6O2Op3kPo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhCUfUal3Pc1I2ZLYuyJlhxFLj_B703LwivluwF-99SQ&oe=6AB7D8F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLDA7L556Z4Q7kNvwHiGAJU&_nc_oc=AdpZ3bKm3VnyI6pccUNANbuFqXDx9k-aQV2bt5LhDKosU4-7G7vi9-WSreCo3erlQBY&_nc_zt=3&_nc_ht=scontent-ia
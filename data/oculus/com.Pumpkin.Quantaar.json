ri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHjqE3PwYmIQ7kNvwEa7OHi&_nc_oc=Adrvz0gPKxyr6pTsOZRT7JEM_9XWBW29kWoN-N6n1w5XFqR_kKSjHYG6sLc4vkvKuyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBN1iVxMdx-Z4K7Qr6vwjSQ67NdRmQR6jGgekkFHa0gfw&oe=6A689AE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNPkb0sZHuwQ7kNvwFkuNog&_nc_oc=Adq1Oxlfok2ndpfmeYcKWHtprCwrf5kA4fgc6xOFnbYX-WwbNB7A3D6-u8Bf9pv519E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGCm8HtODAT8zjcKnnA8hhGbSE8_0D_mw43ev8JsoB0A&oe=6A689732"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_flHWO2Rp0Q7kNvwGFO4PF&_nc_oc=AdpJUCj8yzvHJ-WXGrph4elgA3wBLk1i6m8bKAtLSQoEeGk3urCmlVn0kSi8KWDpUew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCvRhD-wiWwq0YaUX8UXOMNF9IROS5VsP75oOzQpiqJw&oe=6A689BE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoVfCh8Hn0YQ7kNvwFeAYYp&_nc_oc=AdpzyuEbpWxV8iO-pcgGe_JiDffaY-Nt19kAzuyEp_1OB11lLCQqkWJ6kqXiSpMoAt8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBihEDh2RmrOms9wsrdryPvoS4qrFBsVPfEZxbHAT8JuQ&oe=6A689B5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-0QhwQlJbUQ7kNvwHyfdWA&_nc_oc=Adr5keT08EWOlsBkJafvn66s5V9CHZqnMHVgmBYwstMd4T61bn93nP-ZX4plAGW4eaI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNMSWO6NKpVLFgVY_3KQHtpy6qkNgiOCmYf_4lUZO-ng&oe=6A68BEF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MCsc9ijsoUQ7kNvwEMUR1a&_nc_oc=AdrLVh9UkN14mPzNxVIgFTgeiDvhVEF7fiO_M2jrbLAKym3AGSbzwuHHAoE7tojPlao&_nc_zt=3&_nc_ht=scontent-se
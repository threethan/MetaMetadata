ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbCSa9QDYlkQ7kNvwHPx2Dd&_nc_oc=AdpWKt9T0q48PN-qJCeNUSWhj_DFwYsOA2eS6QIfpxcJgSxD2V9WBMa0dFdbo0x54fU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vkYCzX_S40HO_q2FDK7vs1Nqbfp2V5GHeIMRozB7LJg&oe=6A2D7FA7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fa13eN5F5h8Q7kNvwFzpjZn&_nc_oc=Ado9vBIDNVu1L0REO8QYJ3cURxw6GB0I2qx9S1IGpXewu9sieVZPAbq5-BS9hLGLwQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yRq0i_kd1IibW3DVHTHYThYEfnr_Xzn1OXiBk0cQ0MA&oe=6A2D7BF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd4XtNgmrpYQ7kNvwHLX-PA&_nc_oc=AdrV_SNEotR_oc0D_iG4rW1IIaUcZRk8JTVfWsSL4wiopDvySB5_8AN2K0bteeJLNb0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_3NjoiqD4lWJ8CRj3JfB0-y4XhQG_TxBxVcT3PslZEQ&oe=6A2D80A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dE3NIceBOdgQ7kNvwG5gQ-6&_nc_oc=Ado2LH3ptVDtAFHD6WRCW3JdwzDuYuZRW3f81XsNxsZObNiyzYqLRpivQO8VVpZjWp8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LcJp3vqvU-1V-CUbOwugNneOppZS6dgpCmwPv0WYIxw&oe=6A2D801B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jfony6HQsasQ7kNvwHm4H1i&_nc_oc=AdqI9AFHimAuKD6P0VFMrzYxHByPSC-j2DvLVdLQtVN5q6wbHFeNvxAy_u2B_goHkJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fbsSE4vsx5WdjBydXetRvyjGfEreyU1IGiUElycEiQA&oe=6A2D6B70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6W3FE40LRwQ7kNvwEUxT7d&_nc_oc=AdoMzlY7c7G1QumNxRekLyJdkcAUfvlOQhwL2FLLJRKRGQRWf0PDyjUcYCWrpe9S9oc&_nc_zt=3&_nc_ht=scontent-ia
ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl5UdMwvgTUQ7kNvwEyDGq3&_nc_oc=AdoNF8jUMl9gatV75hPSTpRUB9YG_BsIKbTKjxKpW71WdZuT88scKZybGYrRRWT4STw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJytGBY6hYPMe7IBRhw4d3iiTGYh_5hK4VHAzF0kHdiFg&oe=6AAC0FA7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3MQRvqUyJIQ7kNvwGD5qaQ&_nc_oc=Adr7TEQkjjw-imwUYRvfUwQTmvhGriBkP3jij4xKP2DgVBHWpdRO-KFdesMrYYZg_mY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjNe6Gq7bP0fTbzCNdUjWjlTzHlHm7KC4jo_qAnhtk8w&oe=6AAC0BF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4DswTwQ1vYQ7kNvwHWv3rF&_nc_oc=Ado2vtS2a2zbfmQ7-XTSzIyDeMzSCPiHwp81Bmw-HomgajiDbcDsDQ7p-uRzDFnltsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV9FXkSncH1B5VwlJBgiMObkGKv8rSuwuJ96fvRTKrmA&oe=6AAC10A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHgxWZOzD8UQ7kNvwGnTQJi&_nc_oc=AdpHGWO8wfxfQVgy1wojPtD7azgp6FXr6aPxQ1q5srycpkq-hE8A8YUVoHTsYf0Boto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKwsXEisXdiiZNUCCHSCSAMS5a7-xqZDU80emThbRQj4A&oe=6AAC101B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1FgaMYoLfEQ7kNvwEVnaaj&_nc_oc=Ado2_FcgTRFxgjfX9lf-hOunJiJMV5hE1g9eVTSCeZyFAW-0--3gxqHkqL6HdIulJ8U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhOpHkFZC3eCuTXooT0SYDF_pkIftbhSrM8iBlFytQsw&oe=6AABFB70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqdtIIZblaMQ7kNvwElgjD-&_nc_oc=AdoV29rLYFEIKS8jZWv7C6oWQET7s7d2EmHbFIq-gx0IlANdc58hNh5T0uhQ9n4xQ2w&_nc_zt=3&_nc_ht=scontent-ia
ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yAh5gs5ivoQ7kNvwHvCjK0&_nc_oc=Ado8hqM4jFORIiJtW4K7RGdg__Nj0ZfJGcWD528y_CNVztLXImBDIUK6IJACvsDBGXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp-E4FZ5Kcw1p6f2bO7DHcTd6cJWNSjJY3redJcL8Szg&oe=6AB93EA7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMNSx64X9PwQ7kNvwEpXaPU&_nc_oc=Adru2nlSFEReK0cRmcQo12ZGOtRYtkkw8U4CsD3HBueLyrZMla4dyzPNpypluzc7XNs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPDJhj02lb5nj_3a3omE8zA_AmWlRbjuw1_WkJ4eq7jg&oe=6AB93AF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjGA9NqH9GEQ7kNvwGeMBFj&_nc_oc=Adrd62UEwj9dgHJAHKnaCMPSmZfDOYlpfW8s3HsodLcLpCmEeJc4vauI3pu21m6ne1s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPdXv9teykUcmeY-i2A0Lkl1sOVrr3mUkudHlcj5HHog&oe=6AB93FA9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz6rhJtzAAgQ7kNvwFG87ha&_nc_oc=AdpSc2BYS83Rg19a27n82vIaBG-d8QX0g1HrayiIfGnFwCRxCSoQJJEpbi4nj6iDFBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJazupeA9H30MVWS6n6ugrdTXLZGCcUOOtnqIK-QOsGHA&oe=6AB93F1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R884DQdwKfcQ7kNvwGrJtvP&_nc_oc=AdqgTjIJFVwumBEABogWzjVMKmPk_Wj2JLdndxgsW0s1UvX-fMbjsd2P3OldTSYDINE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyNa757TIgcIx6HJxqHyf37dqgXnnSJqbyBWzw32enGQ&oe=6AB92A70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hICI5rc6-cQ7kNvwF3zibT&_nc_oc=AdpGp170oV3nwM-X0L3lbY9f47i5EGJKqIrV8DDU-81AGlUHjV1DlL5RLtIn_6HETs0&_nc_zt=3&_nc_ht=scontent-or
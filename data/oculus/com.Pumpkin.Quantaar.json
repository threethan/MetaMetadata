ri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPdHiskpb-cQ7kNvwFhu42F&_nc_oc=Adrusm0y4S7oK9p1m4t8FwbI7If4Hg-p36ACUP84WCCVEJW63VUFhZDyc2jzo1HiExg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2eDjKGvNCbpImcRd1hK0GyrB1vx9fBHU8AmGR9j_GzQ&oe=6A3D51A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HckDqeaPwqoQ7kNvwFpVtzq&_nc_oc=AdrWjhM0cHP3pKQtYGNIYzLh2pKVAuPmN2HQiDn8wXtL0z-fw3HbhuVCbIcgVr00NA4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EgQe-tRxgz8H7QE-l2pnxifrHKb8nXKLPt0tD4hKsMQ&oe=6A3D4DF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkd72YmIvF0Q7kNvwG2My7n&_nc_oc=AdrIl1d9AQPcjxfUgMqA8ZNOFsH7x4jDEicO-QFGIPUlI_GkYf3eBhM1oYSu4VbSDvo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_IEUa9Z9fedSthxaaZv95HhX-TzgFdz1NiY5suDXD4g&oe=6A3D52A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyVoVVktlT0Q7kNvwGX_FQc&_nc_oc=AdolwK-_fCpJIvbDmwbAfUbYJG4U_9rMirMm2CihrjDOb0Gsncvc-SiEsvtlGRZGnDE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VrIbNEj_aTyGpGuh4TVsatzLc6cEJKhQ4s0E5Mf045Q&oe=6A3D521B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J3wwpPRUpMQ7kNvwEfbihd&_nc_oc=AdpP-yvWPmLI00EcxFcxMW_P7R198Dq2mWTZ1n4PcB0K5vk0h9MnDlCtt3iKf7hrps4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89j0P1aouDQPMhaYCqTRD7UuiKa-TFGNpJp4q5gbC0Fw&oe=6A3D3D70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LEVYBaAjOwQ7kNvwFjurs_&_nc_oc=Adq-TnR6e_8KpRJl7_L6XAwAphnzn0MT4Gyg_oFKSzhQER3Pg2_CchLWeZ1S8qzXJcc&_nc_zt=3&_nc_ht=scontent-at
ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePvwiWhfqlEQ7kNvwEZ0TFM&_nc_oc=Adol0IfsO7X4oAUxWmwIjiNB4gIL0yQPcxWYk2wcz7vV3SNxJIhLk4uuiOxFgdU0p2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt_6gjSyQimmiKh103UYt-A7aW-oWZOpE98WpqI6k38A&oe=6AB00427"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfXEejmp6VoQ7kNvwEOZKvj&_nc_oc=AdocehCPwQGQ-uzABbZMM6H1Y6OHSw5i5Sf_CSIedI1IhDDMFoAUuXDkpn2gwND2RAk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvjtdQnueSc-4OW8KrJONeymADBMbA9PlgxSKHN-36iw&oe=6AB00072"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yea6wkm-K4YQ7kNvwFbs4AW&_nc_oc=AdqpD59ipy_LPNb_ZxjwqVI-74xczv6YigDequnsMaVnbaeLWgGZbXrq5MjvOFHBaiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjNEDlkKzHFsYkNwg0kMUxCksqahHP-1rt68Ws_jcgXQ&oe=6AB00529"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsXH3P3s7w0Q7kNvwHUQpZM&_nc_oc=Adrgdw8Vw0W7t6j6Irh5p9ck-lg8sJ3CjGLQE6k-kM2IJRIBwPM3YkRNhTcdu7KOXGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuKYc46rGggHnWtE8HXPzg3vtIj2xuD5nFka-THWIUUQ&oe=6AB0049B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTLSefrR4q8Q7kNvwFI41ak&_nc_oc=AdqJjzVODJ_ZHgpkrl6FqRqgIowVUk2obEqJPLF8KxJu9ggF6BWNglA5yQyAt378F6U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz3CfASwbS3cYPoVezhsKtqoCawEv-fvGWDhyNlOaW4A&oe=6AAFEFF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OZjNWLH4GoQ7kNvwFmKEN2&_nc_oc=AdqDyJ1xiI8M1Eh2Tw9s-tscEDZodjnlxLm3c84zGmIXf3YB4ORtZUL9AZFk9hYlkDc&_nc_zt=3&_nc_ht=scontent-or
ri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knHPdDOe3pUQ7kNvwEvjWOT&_nc_oc=Adoma9Dp1kx7vKrtXckO6ezikjdEy0zYSIZVOUpzKnUn16UZaepgOCwWzPPQAeRZ824&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fzRvrYkUSZEBMqXRbAYkvfuwB0Zm65wDXtMD6av3k9g&oe=6A1C5C27"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFhIlmdSMHoQ7kNvwHn_m7R&_nc_oc=AdqW-BYlMy2RXs_9zdh2E0Wcuc6spU3oHZ4zMVxlRc-qm7z7qS4SaIQ2ESBxms_mkAw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mu5pYuJ57F9dLAYD5fyM2PfTadw3-yPjuo_IIkrdI2g&oe=6A1C5872"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XJKXkTeiUcQ7kNvwFAncvu&_nc_oc=AdpbBLnf1kKfuWs4HIuddIPyyI3w0CfxpuvJ6_1djIEiLwV0oKycDfSJzsmtlpXgQqQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40GxbtjkIC7P7s8Rit5ZL0ltwTLCzvfNd-O99Qrx7u3Q&oe=6A1C5D29"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yR6IW3aerTkQ7kNvwFDsUMB&_nc_oc=AdqQt5y255LTBGnxXLTAOq3rAc6wZpaWgOSyt7ljTaECEPBAhF3JQ6qnsc8P6120VQc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6muIZDo5VSe6CEO3Furcbdaek5ExQJ_KuJcg9S8HPEdg&oe=6A1C5C9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RJzdAE4-FwQ7kNvwGtW8zQ&_nc_oc=AdqV0fFUewBoyNS96mHwtMMgatSaJ2Z0hfgMzrhQxSFv9xLAvBaDECY5UVB2r70R49A&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7luUxv1g-HV7IQT9YM33H3wHB6HWxmFNrdgzo2DwXDVQ&oe=6A1C47F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFKXwWD5xQkQ7kNvwFhh9Ta&_nc_oc=AdoqFbl5c1W0cEFtoGVpThMc-4XIVpr5lquZYTTCxxbgi6efEZhkP5jzYXnbfBMRhu8&_nc_zt=3&_nc_ht=scontent-fr
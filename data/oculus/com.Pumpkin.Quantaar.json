ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BMZCwsJ7XAQ7kNvwHinNDI&_nc_oc=Adqx3PBgsN2NaL6o1qNClGf7hZR1d4zi7kC7eZUN2amUop6tWZ8A3CxL86IBJU58hsw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S5IXNmZgDhimmo8GQybBfRt25S56q4I53cTuKcnd45w&oe=6A007467"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32WKom75Lk4Q7kNvwFLejaG&_nc_oc=Adp-ThvA4v7Gu2-qVwp6nE1SrbG9-XHvzrIYkC2p479QL-dHuGTNlWo0nNgL1qLzOAM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ljs4n_IGcUNjFn28uO8ZctBC9k4WuzO_lJyqO9oJhAA&oe=6A0070B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58CSA7AvsAsQ7kNvwGxtgkL&_nc_oc=AdoC9Hkw_SFxZwZKYfESSJH1T5ZF7dxUa6j-JwtZyus69GnlO5UxV_iC9Ey2fkPA2PY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6v-Go9ROqqfKOXSVV1FycX5rBH3sVH7wH4BT-rVdclQw&oe=6A007569"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OD2jj7nG5DEQ7kNvwEAqSe-&_nc_oc=Adofn4yxFtedR9j6PaJWPWX5EACk0gV1wgJVOvBfgl6pgD4AjbBsAQPApeynX23iXwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N9IipCdHelQGCMho86WsKpPvMK18asc34zu-acszdeA&oe=6A0074DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nb7yvBUrS1YQ7kNvwG0KnUw&_nc_oc=AdpVir-6Xf6Df8gjNW9ajgoNQcf5CpDV7iIrZYX1IUOGV6pIyR1BV2fnPG2LDjz4i5A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6diZ2nueVADVulqLnhW8--QwB6DyREmWKCQEV2W3MP5g&oe=6A009870"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85LsC1DLlOUQ7kNvwERe1bw&_nc_oc=AdrME9my7XcWed_0s3PLvdmYHVy-bzIo1IVUvFx5w3r9FHxa5AvHqv9U5eS5XBhTa7U&_nc_zt=3&_nc_ht=scontent-ia
.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im2cY4G-cCoQ7kNvwGLL5g0&_nc_oc=AdlogUvO2PcECzY6zg7R46lBAIZKY46YfbnGn56WJx7sjmV0mUkrdOIKwcFjrZntHBE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuuF69PUSOA30xIsQPSq0vjzdPq0eOts9dbmNWv0apKrQ&oe=69A18867"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP9X-XXKj-sQ7kNvwFguOiO&_nc_oc=Adnhg5OkPHKv9ifYl1IoeoG-djytocG0NGMvusppeQweAO9jXLghPXOwF3bINQpHDqU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afvpb59vX9HXq1_FdmIAWCLhODZkXolqfZk-zhX3LmBpMg&oe=69A184B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqkgVM2OuhgQ7kNvwH7-eME&_nc_oc=Adm7R-P-tjI3b3OfgCIA-Bea6yGg1it0crpPSLA6AurCoZdUGct-A7s0W3sVv89B1Jo&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afu0-komw8SGdQUD6seI9Jok4_28eNqxsYFx2a4bK6wcTg&oe=69A18969"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDxxKRUVZd4Q7kNvwFDFSl_&_nc_oc=AdnD9-ooPNqBSpqrDFIqPNulfY6555UMYGrPt1hUbLHiUihSETm1djdU_QtnIfrQb3I&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvRoDlwB1q_aTdu2I9a2kICcztGNoa574kqltDc6d6RjA&oe=69A188DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trtRg8QEtxIQ7kNvwFDgAGy&_nc_oc=AdnA3soXistReJoosZi18tizbOy3i6ySpyVafrc-J6Xyb__ClSbWs_rTkSbGiI8Vh18&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftK3oR3t4QscAHowk--ze_f5p4ijQKfyDo-pW-xtB32Hg&oe=69A1AC70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCPgrOucDOMQ7kNvwHGOrAL&_nc_oc=Adk5KboY5gS7XRtPVDevIZzWHb0oDncqRh5twqOTcDbrvSK3taxyTQlb0UKiA2V90NU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftTJB22vytqxUqhGAy2b3ce5wj9uAjtigljsiZocN8rmg&oe=69A17F84"}, {"file_name": "Frame 84.png", "id": "1747234655674817", "image_type": "APP_IMG_COV
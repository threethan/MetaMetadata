.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQ2JstoTy7cQ7kNvwFTXr6y&_nc_oc=Adk58mPpHR9xopGgUNKInpqQbfXq0CdNEeHNZafcrW_eTvY9HiZA189v43iZmY3qT84&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfshA91QZtA5pKU8BquXM4Me94EH9MElEY4gWwdq15vkeQ&oe=69A2D9E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugLOU94K5tEQ7kNvwGyxU7G&_nc_oc=AdlaNGZzTAuU3DgSKWuvTLSCN3_wdqfAv_nOP0CYOKHDfpoF3KstgIqWXlkMA4vD9kY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupJIaLsmtyFuXzqt66JcFMPHI4hOObXCygMIQ6AZdGUw&oe=69A2D632"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqkgVM2OuhgQ7kNvwHZjHfY&_nc_oc=AdlKqbyY01TpuMFroyCJHbu5VWxnYpLNT8uWZreu0gmmuCL-9RPzQESEF4mT_YlaEj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu1DxEBmIYR2oUmQAlrBYWZz_AWj0hI1cVnGl71Ef3ocA&oe=69A2DAE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDxxKRUVZd4Q7kNvwGgMpJv&_nc_oc=AdkcNR5PIPVs-PIk8paOPA3381QBjBgMmf6UlfBVn3EMXVDin6DLNsSqsz3Fg9fZu7M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft6oh5goZ-rZD0T7cPP7FaSAqFPtF4rsm9KNpX_xsuvXQ&oe=69A2DA5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FH83Xo4y3v0Q7kNvwHgnkEr&_nc_oc=AdlBcFyYjKUsyjwurymzTegZjAsKONfmlPsk7BLw6D5F-TKM6hHTmvt8t8HXA3O6WSg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afusy8B2VdsSOwGDecE9wetQK27Ezaxk2eIyOaQN3C30hw&oe=69A2C5B0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YCPgrOucDOMQ7kNvwF5f4mF&_nc_oc=Adm-4qUnMPSWwUES0XC3xpJPf_6MbcvPqrsAw9RiFno2XgO7v_zZFPC44pJDWmOo0F0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvD3YZmKzto29Q_oxYAyBj_h1awVV1m3j066RMDEgUVBA&oe=69A2D104"}, {"file_name": "Frame 84.png", "id": "1747234655674817", "image_type": "APP_IMG_COV
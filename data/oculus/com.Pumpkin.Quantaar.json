11-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0Q332s-eQ0Q7kNvwFGrlwu&_nc_oc=AdnxERMed-s0rX90_GacFkDQCpKMEZzZeRs9nXC5UUP8CyQ14M09duXeasUMkttGWa0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-7HAkRWSEDoBqv3Ixen4e0gSd2MhPUd9APeGH7YbFqg&oe=69AAC2E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td9I2laXMcUQ7kNvwGSbqfQ&_nc_oc=AdkyseNJ64Tu10rR_XvnS5tCxKRzk-R2aZFrJgZniG9G7CRl4AiEq0mkmFPCMmMek64&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3Wens1CAuRWFq6MxV20Yh-l7gBGaHGcI5skkIyxyDkA&oe=69AABF32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4d9thtA3V0Q7kNvwG8DWsy&_nc_oc=AdkaCrKLIAZ4xYq7uqop6aZltJKvIeoAHHF73lOF_OkWeGkD4b7NbibOyTQmF-n78hs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwv0ztm0BMhCmsWYoZ-tsVqQTgbTXLOv_oC6PYDoCQRzw&oe=69AAC3E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plHOMwcPJJ0Q7kNvwFZSTjn&_nc_oc=AdlBTcu7P_DNn9-Q8KGHZk8OEPGQLysCG8HOY9cCfueaMD7xTGIUViho75uIqbB0tcM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afxzn1D09XXb8VKD8NOk49VYEjSUvtbI2dfazTNuX1n_lA&oe=69AAC35B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5n-kyALAugQ7kNvwFubtUT&_nc_oc=AdldZc9IaulDF5FmDN24RD61Fs2BklY7TRpTLQ87oaD8iLk5PD4cK5Gd22BkW9VO71c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXi5txbKDftwOyJsW2_w0_7p8UUyYr6D9AY_qmvlVwuw&oe=69AAAEB0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5N6_yhp-9UQ7kNvwHltXhe&_nc_oc=AdkrrPJGz0E-nDFiN2V2du3xpKa5BnZ1Ltn8B21Qs6i9_FNlcpsU9BhQIp3B9aeuR7M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9Vf
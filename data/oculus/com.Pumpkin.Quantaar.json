uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVT-00n5U9cQ7kNvwF49PRs&_nc_oc=AdlPF96mrEoZq2LAJjYmxD5Mv09xXc_O-LdXc73MKB92Cvd7Ag9cm8uZzz9hPS0zv-Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxNjDUGrVoQjUFBgXSTfoAy2oncA9BzFiWHqLooSSXfNA&oe=69B94367"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0N-bbKzwBgQ7kNvwEPx-Xn&_nc_oc=AdkkqjyoW0otYPc_H6fJnZNxnApQ18SxKx0BsYKzQgmDo85Z3QEQxGk_DfHpL2Luu7E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzybYPCiuQwMwlIH5Wf27n6hPm7ltrXo2t16oHy6qL9ug&oe=69B93FB2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAh3ySAsjC8Q7kNvwHTEWH_&_nc_oc=Admf1MTqJBmI-6A5AdvsaeiwL9NFwBCY5l7ruzpFA0eo2_sPS0dj9E1Qe0vm-06oq3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgCyMJ6w7ctvzqc94NyhUxqnK2Ij43DB0RR5DY00MkoQ&oe=69B94469"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgM3mxGZ_VoQ7kNvwHjYeDu&_nc_oc=Admo6jyxLg9PSrHntOLSh65jGnxUS7iJ5IcqnKM0HWNq5a1ZmYF0hW4EfyCWHbufdgY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfymeXHwCfV0YsSdh5_7WCSP2Jt7VBNo-4_rsV4f8xGcJQ&oe=69B943DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRQVosUbAl8Q7kNvwE8kp_N&_nc_oc=Adn3sZxlPfqb17s67K2PqDBYXFOjE7_MHFvMGME-Hae_IABOnxgU5p_NNOWj1n15S9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy4xxnUXPSHSY_RNGIIcqx6CaK0nCM_FODHNaYdMm5IOA&oe=69B92F30"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peurtHqXRDoQ7kNvwGyTfNL&_nc_oc=AdlMOqmEhBF-a7wa2l1cuKoxHxDEX5pCzc2RnTb6uKXPu7Q53XmqWveq1hEZZ3CTXtI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afysu-RXOY_ZkZNsh0
ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eUAt_Nm_CoQ7kNvwG26Afq&_nc_oc=AdpePzVXg8pkGP1vobe3xdBjH-iMvu3r-_QQlQreVOm3jjZsR9_KaWyAcRYMQCySksk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mvaJ2pzowMdrAV5P31vogJjuMA_JR17xbml9U-m1KTQ&oe=69FC7FE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DL2j8ehicwQ7kNvwGTOPpn&_nc_oc=AdoTWd5IDfi4E4b1ba3TqKIkUAFwvGexrSIg3b6M-NJpsDP0idZDOfEW40ItSMo5TJw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af506qkLt3HLpA1_hFKc39F56TaPxA_C6a8fmQ_4iMValQ&oe=69FCB472"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVbl9QcJisAQ7kNvwGBaSFw&_nc_oc=AdouF8smLT0WOpMxqTxdYrO0CXRjnO83xJ2tDjPud52tia0ANhAMoa2gHUdPfjjvEm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6L3pukpHjCcGIvsG1OPT2gDqpcBbLk-t36gzhG5Txfnw&oe=69FC80E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkA_o_2r3VYQ7kNvwEwRMMn&_nc_oc=AdpkJlr0m7x8ZFiotoCW07FSY7EtxCkyddF3dH3oCdlN8QgGopKlmDFV_gGKGrmJIPE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bjCuivLY4_DIAh4Gggi1vyY7SUGnaG1RdfsY5lOkWbQ&oe=69FC805B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzOS-PsuYJYQ7kNvwErzGfi&_nc_oc=Adqo4FoG6-H8foLDOZ7KwqaCLs2eQTnpEFazobRvlzB0DHIsHmrkPbbv920V0taekm8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4j-3pNmGLw0QnNBnvdCCfl5nHC_UuBQQwH68gffY2GFg&oe=69FCA3F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5fK_CntLk4Q7kNvwG2IrGq&_nc_oc=AdrOWxPa-mknDNsaHDeVv3El5oMfxNGUF4PGko5tnkiW8FdeoxVSeAS_qhq7zBlyiTg&_nc_zt=3&_nc_ht=scontent-ia
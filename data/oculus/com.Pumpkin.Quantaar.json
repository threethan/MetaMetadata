ri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcztVXhZu8sQ7kNvwFmABx-&_nc_oc=Adpi-rS8F3dtcWoa8qkhDcD-z9gG1GVAUpWqNtBpkA1f3oeRScXEYikWh9YOAQu6blE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR8bSzH0t3OWVsNIMKpVPjP-wtB-s5l2RNZLL_rG1SOg&oe=6AA14B67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4U4O-jcyWkQ7kNvwGQP1hi&_nc_oc=AdpKz-UhGCcKY4YaZpUq_rz-ladIdo8bj0g9FFclSiZoALlVJQaVcU5ssN8Ydx4heQQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNmtGSECjVpvvZE569msQ2CxuJr3m95UYvmf9gncwFzw&oe=6AA17FF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQkvNjuZSrQQ7kNvwGJH3kl&_nc_oc=Adq6KabFugFy_h-ImLECPX-kBmjAeBFYQaC6ZS2JhHLCY4oa_Pv_U6PCE-ceEmbQo_4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuIuAC5BAuf5we0VMMjsU0otoPNHORGy9qrbdIPqnN0A&oe=6AA14C69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FudyKoYge9EQ7kNvwGE6mZC&_nc_oc=AdpEx9eE2k55Q34whSeMoNuZ59p0xE_B7jcZJehtNTmhPf_UQsfYpeMxWNsU34ka10A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJryCAAG6WYE3Qc16gMSPjQPNU0SlvutYKQCBtN3eVXtQ&oe=6AA14BDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eW3G5NQ8bEQ7kNvwEk_oWI&_nc_oc=AdovZ6N2HYraaVhySwMAGw4QPDdkwP5OkmMrPSIN373HWzZAmlpuM33tKgxdlNJC0Gk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLye20RO9QbrruRx3uN9gT7CXAfCQkrHHzJeRMySlvNoA&oe=6AA16F70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYtAA7uiktkQ7kNvwHTXWOP&_nc_oc=Adqw3Eoymx6JSgJTLGYwXS5xF9ZY-_N6iWB96RxYRwt_IeBoTC6WEfYuR75QX3n9MGY&_nc_zt=3&_nc_ht=scontent-lg
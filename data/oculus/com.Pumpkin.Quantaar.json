.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQ2JstoTy7cQ7kNvwFhfzry&_nc_oc=Adk7gUSrJhG8vhx8p6-r_Z7LvbAZDLGO-uhzFL6-FP7fJuxGRiMyIDmjlE_GiYEqhWk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvQ-9KzH0MmLpCvvNnutzseOsV1MnJ6OdG4OEvNg5HpVA&oe=69A57CE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugLOU94K5tEQ7kNvwGPtLXD&_nc_oc=AdnUxJlgxZ_eBxVQEZ8QItY-_QA3sgkBXqHjFkYS14btrI1KFotnBxZJGFTYIOVSg6s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Aft-OD8BxAw8RLacxsQfKRaG0gMTvzfeWMvM9-pTlb12cw&oe=69A57932"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4Ns9UAZ3u4Q7kNvwERuLXB&_nc_oc=AdknxpbfXk0HK_OfCi5rk4s3FnurBS9CsKq9PDHUQIfn3iyMe2yzC3SF2T3q10QLrXs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft7Yfdqk5ntZ_YhM0hQehNYm7K9F0_kYAo3pjlouDpnqQ&oe=69A57DE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYXDGmG4EcQQ7kNvwF6XJBJ&_nc_oc=AdmEkIFv3_u08JJ39F369-qgK1LwQ2qsUs7iwpLck20HnPZPl7Yfrt2ML5AsPkegWZo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afszzv0gq1BoBWukkCBXZduj2MNuvsQ3tHO60gVjqsPzQQ&oe=69A57D5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FH83Xo4y3v0Q7kNvwFr45ux&_nc_oc=AdnRl4nTTgO8bD-RhkVTHktU_fhcrzJG3s9Y3s-N5HU08JomFc3IieuSzhd5Rt62J64&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsiSTc7adxHtBAFEDQH58XK4AEa1Ey-TzXju7pmOxXSUg&oe=69A5A0F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VdS9NCJVVcQ7kNvwELY7go&_nc_oc=AdnTIxpFDqGDzUwrd53y1UqdxC7aD6z3OcWaJI7qB9Gi12qEZ5pitBYYuHatATiL7H4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftmhgHU-OpElS7Ih4xle2Sn20G-LXu2xHlyFKed14zlMg&oe=69A57404"}, {"file_name": "Frame 84.png", "id": "1747234655674817", "image_type": "APP_IMG_COV
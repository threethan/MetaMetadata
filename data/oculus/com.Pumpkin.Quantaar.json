ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wunjqj4P4iYQ7kNvwFtJLAK&_nc_oc=AdpSdzyKFJEJJ3TjH3WAR0orzvZ5qeyQlLZe9W2OkMpcdRr1hx-lPHAFFQimVXG5kMU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PnDegzPNhO9rXTTosoRvMxEEAXvNj1rGt3ocpt9RJ8g&oe=6A43E927"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hvjGiePSX5QQ7kNvwFGk9b1&_nc_oc=AdqyZ8V-EluKOdkKRp5z-4AfSVTvrxkNFCyI2nzqEBrOH3T812Y88-QHN_5xOIHERjc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-p5lkO4KfFQyRB2Bhs6NfvlFJqYyUd-CzhcJ19l4nTg&oe=6A43E572"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YundPeDnnM8Q7kNvwEaNY45&_nc_oc=AdqI72vbN-O821blgbjxjjBzpC535GhPH5gTgW_BGdNQyS0IzHBuG4T8g4c03wmOZys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EkNqtG6rOZjPGRb3GD157mdEU2giWlKdYbiQd4FNZ2Q&oe=6A43EA29"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LdhsrwaeuAQ7kNvwGD2vl4&_nc_oc=AdoaUjtjGgBv-oVJnwd2xzoHAoXzSBAwu6DwZVJF-SGTmHo0vkVOsr3npNFUGP7__MY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JzNCrPiebLkI8pxuFziWho4drfvGlyJKTPLRMV5lV5w&oe=6A43E99B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saJCFI8mBnYQ7kNvwHaKuVH&_nc_oc=AdoUdG_XVY-5fLAlSivmqcSheblH29GO3YdEW3EFQUUt6Pxd1ugW8l0Q3Bt1XHTeWks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82ZyVv1v6UrXRjflrZTztLUtqIXPs-7dhEGRHGqmJptQ&oe=6A43D4F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9qbpluEbeQYQ7kNvwHM69lr&_nc_oc=Ador2ANwhMgwN82qqcvYnsOUVGtg7dpDYZ2kjvHWK8jonl6NLRjydVVpES_4wcRiQv4&_nc_zt=3&_nc_ht=scontent-or
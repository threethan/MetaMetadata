ri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6ejPh4D5kcQ7kNvwGqSXo3&_nc_oc=AdpU3M3mXVzs6xQS_OB66Y2euTCCUZrUSb-rHbBDcsNnfwi6s7D_BOJ1VL1olov-2Q8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M6TtOuBzNjyM4G-DJG0RaGePBbMq87EIHJtzK1EjT-w&oe=69E221E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_RSPqJzv-0Q7kNvwFeF60a&_nc_oc=Adr-4DF27yjXxW92UhfoZrCNMX7C1UwkWSWXk_V43BRExbv8QJdK2KKgwuLPakXaIhw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af092mYUg_AYld2qHmkjDGpr_xkQuMU3g3IpQmgR6TUJXQ&oe=69E21E32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMF8YkVnjswQ7kNvwH3zgIo&_nc_oc=AdpzT37dI1aY0HBdUEl-kKCzBkn4FJVjV42DS8HFcUMSQefUImp2_304jurZWGnFexI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ji4n8PvcPuLFLrPfGHA2IXaseFyc2eqKdSYoXbHiDjA&oe=69E222E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jy0UzhlH3-4Q7kNvwGcN3Vz&_nc_oc=AdrXX5wccsPFbPxpFsCykuPRSLV9Zqbtww4_VzjkEZTIs1ePnuU6rCNIHSHg3Phhyu4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JTxaTa_ASBB0u_1xr50ou6-uFE7GWYXcal7_Zw-m7NQ&oe=69E2225B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqyTlLoaLOIQ7kNvwHec0j7&_nc_oc=AdpTy1VVMAMTCjsekj9IRUjLhs0-oW3JawZXu-n2dM0uozXPVl1SM_5nqOo5ObExNAI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ELeyq3v5SWw6lkBHjcTC72RsH0LAwi4IQXun--u7Jxg&oe=69E245F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RbjSfv-rksQ7kNvwFgjG01&_nc_oc=Ado_abMTF9Bhs_7w5GT0USxlALZbjy0of3c885PObQJ0w4nGBwqX5ZezMbvez81DPHI&_nc_zt=3&_nc_ht=scontent-lh
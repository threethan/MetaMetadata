uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrbKKZ2LAj0Q7kNvwEVE4hm&_nc_oc=Adlcx9-jx6z-gVpH4p_sEVrR-Dj_LSY0sG494f3yy_huTPlcmwTfH75iwbUSb87Xjys&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfySBxWFvrgYXNK4jXuidVKI1YEILEQrDh_xP8JN-P94Bg&oe=69B15A67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAMf1gVithIQ7kNvwHgZFZe&_nc_oc=AdmWAHazI2Nz5aiOG96aCsUKFv4Iex3DapytBVl9F-KYkvMWYzEqkiWHbg8X0oS5H-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhiHWkDnIHvWR0SOiwErRYs3EoGHwqO9O-dQ5nDirQcw&oe=69B156B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwrOtf3tN4UQ7kNvwETghay&_nc_oc=AdnFcveblt6xtpUG4zNhyYJKCknTSWdqAT5BFdaNNhAs4Z5PEB86mOxVJ_aEd1_L46U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwIksI-llTM6YTG3Nr6RWVkiD52iOji3LdjS-RD2lLAcw&oe=69B15B69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2Z1pfi9kl0Q7kNvwFsIolD&_nc_oc=AdkyYONu0X-hNsVZHHrcP0vcA7jyKpRJpZzAu3ldVkbQ5ABG7KKXDMepUrFv58dAdNw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsOq4Zg3WkVGmqKjmgV7M_2lw5-lsU-dzVx2u6a4YGkA&oe=69B15ADB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xOXxYKeSLdYQ7kNvwEFZq3k&_nc_oc=Adl4B7Qc0wSuTTd8YgXER2gW61PpaHqzH8YplKnl84dMe9DuIEl7OyFFx19NnG3b7p8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSXNrc2b5AkX_7OMll6VdXXnO-FsflXTYZ7T3Ba-PDAw&oe=69B14630"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ropylOmaGdoQ7kNvwHJLnNv&_nc_oc=AdmRRs0j1CIdu5ESDHFcI2psGDZLvIMCbcVQExQAfU5kKQawv2lD6iKs0PANiSlzVQo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5r92bA5JnRBOyqg
ri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vabibBEpemQQ7kNvwFd7lIq&_nc_oc=AdrNmNA_BsCnym-Pi2c4dc7cAaEdjraX1c5vUOzt68SE0aeRsVlB-mjZh9kMm_6LRJE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk1oZGJ0EjGqb_KrOSFRKoCqcGxOpdPBOj36bbjFyf8Q&oe=6AF09DA7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62GaJuQ8FXEQ7kNvwHR6wLq&_nc_oc=AdrFaDIY8ghDs79SrMyqKkHOJQlNsMRFyOMamNNH4UAfw6Yz12--6oC4q2N0h_QeSfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFl0mln50azqaISzzrUxWfVReZ3fmXN9PbcEV7z11THQ&oe=6AF099F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmDo4bTsTjMQ7kNvwHwJCl0&_nc_oc=AdrqQ-rXgbsYYLtHKdAr7-St8AlP8o_e96GQ6_t0YemB8nYlgbPnEKK8TeA811FtjJQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXb6bKyTBSxefVaTNZW-HqgfEaXZylhQPskSj4oD4uGA&oe=6AF09EA9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mcHYHbTedAQ7kNvwHBwjlc&_nc_oc=AdoEoWDs7S0_WkFwdqC1MgujQEv4mhaC3YL0QnpbbwWUlwoqzSQyXAF7ZHeTB21Y3H0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9nAnR5wF0XdsArxNinVvPG7R1oQZU_6Bw-kZIcd1jEA&oe=6AF09E1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo77fcoJl5sQ7kNvwFhzcx-&_nc_oc=AdqtoHEriOXAgVFWJDwRdDXS850-zj2PbhAxBj8NdzjvNnFzmUiyWu4HWL9nHdbNNVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4xqGh5Pa9ACcmLut2rQHvQkoHAUNQl48UQJrTXogBYw&oe=6AF08970"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQFpiH-9bT8Q7kNvwEbvo0i&_nc_oc=Adq-gfTX8opEwvh0dnjEUda3UatpDF-f-_JFslKMXYjGazksZegZF6SSShneI7oqRDM&_nc_zt=3&_nc_ht=scontent-se
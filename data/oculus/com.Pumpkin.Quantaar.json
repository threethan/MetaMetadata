ri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxC6H22CGeoQ7kNvwHSf8Ds&_nc_oc=AdppJtYaavSQ_fQUQB9ddILr1HtNH-v4IToSjb3W2jBq3CyDyqUzEUS_cwANmdS6TZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_lr1xd2pgOl_mZ2VW2l45vPxMrh_DSHT0jXGP2WHmyw&oe=6A511827"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dsa5dzZs7qYQ7kNvwGRCZJP&_nc_oc=Adpek4mm3owz5hukgNN-fzt6tU0x74GqLsdY5jrzpH58KFoX_gnrVvNNIvZxG3qD6vI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXXzW1jvTs8ozSADNkmApS2BGdvIbcPLfKj6AkqAVUAA&oe=6A511472"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y04KSS9qjoQ7kNvwF1fOEz&_nc_oc=Adq1c3Pbrr4oFnfDXYTFU_4wfp-0sFDXccA8P_EojhJfbjoT1kJ94JjAy8Gk6oqIYQI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmaSvC_gOPbCzN0BfK9uz52XZnEw4_EIxYH3Rye-CGrA&oe=6A50E0E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dlae79cuMckQ7kNvwGta9Dn&_nc_oc=AdoKe65HloAY2UD140B85bnJ9sP_LalF98eTXYNRjs94H47Vtb5a-EIXUdeUYvdUBvc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6wkL_UkNSKHofFhM5gLlBN9AiUhVUgMFGRkLZZR9elg&oe=6A51189B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmoKim9XQ3sQ7kNvwEfif88&_nc_oc=AdoVWmyLXYQpsU2Z2DUTYZRtRN_cNR5h-UA7EnZfYTZRD9TV97Dqj0sGpdb5r3lcni0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsg7OJZEpLtH5-0u14e-q-UpU62-uJY0InRlLdCxVBBA&oe=6A5103F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLcG59LFrnIQ7kNvwElyPVT&_nc_oc=AdpjMYpA30TvPB8xAKS3yVYQFOnjGiYY4lSfQXQQ6nhLdcEZpdCP73alG146j1FavxU&_nc_zt=3&_nc_ht=scontent-am
ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AursKWUlSz8Q7kNvwGOQKde&_nc_oc=AdqN4uTR77UreMr-z8_DRWmYhp0EULM1373f3_3RhQXpLcngzk0xuOljdgNMNqfDUrg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfL9-rQm8OqRgeri-027lENOSZsEnEqbaXmdt70m-zcg&oe=6A899067"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTmHrF4TuUcQ7kNvwG3hnad&_nc_oc=AdpFeqv-P90fRD1uIwneErneMyDTwBsXFp3xHu69rtj6bDpCDsJQK9QKscdnyxKF-eU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdCgcmXhALiiFiywdJmYQDGxWuh2MxFhJu7mtBEBFkvg&oe=6A898CB2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xSkdQb2CpMQ7kNvwFBJ58R&_nc_oc=Adqn-lsbpEJpOjl2UtXQAF5dgGIqcmLIK_We_xMVHzdpEdiIDAwjFtlBWS5dazb5RBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUz4uMWMxeBZ7cXrVfrRAYultKPuGLSLfUkOyQDUPzBQ&oe=6A899169"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=246n8-nH1lMQ7kNvwEvRsff&_nc_oc=Adr6jSITSEML50XsRtH5tok2ntnS2pnSNG5l8sKQWLEFBfEOmG6uSC0xXvJi5ESEwH4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhXGu7vMaELoFNggPExKojMMK_Vg-RBM_5HItziAKxDg&oe=6A8990DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1zj7DqhaxoQ7kNvwEu24fb&_nc_oc=Ado8ytuOoJOhZQ-QRMM6Ho9SgLGwPqnrp0BGHJxFcIrVi5YCVgwRbMojk09aENeeujc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH3KVrmLhdhy7x2tSRNiwm1Vl3J4scKfwiVg-MjgUuYg&oe=6A897C30"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMfWEA7VHbQQ7kNvwFsaCir&_nc_oc=Adqbp9AxMeExpLa9LoUP21p8jwDtn4GPUF1I9TO2XwsSX9Zgu62MbK8eYGh8jgnu8vg&_nc_zt=3&_nc_ht=scontent-sj
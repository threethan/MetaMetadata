ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6ejPh4D5kcQ7kNvwHE81wI&_nc_oc=AdqYsAx4rswYydpTWV9msiXtgRDDFTaCC3uSNcFvim-TLUYAmZ52PCd6vP5XKy-5Elc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09yXbVnDslmn2_NDhff5B_EokUA4OHp8-yKL5c-mh9aQ&oe=69E4C4E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LcMJflsRskQ7kNvwF0866u&_nc_oc=AdoGpdv01q5550em9lmQLNQNlL45IS8MrAMkEdTYpFq_BqD-ycbNAgoOo0j3-7busJY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sxnO8-EMl5vw2SodLC80zJXvVUZCdWl5nu5tSF2Dpbw&oe=69E4C132"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXBCTcC9lZwQ7kNvwGcrGnC&_nc_oc=AdpsJMEHwfLViiCiHgt7ungpGweo4irPepYj6zU2QHlzsmSPDZVWW-MkfkALR_v2V8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GoYwiQUHLNLqiMSuXvKS_HvMgmHMqePDUog-MrZNtMQ&oe=69E4C5E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx1DhFJO_oYQ7kNvwGAsCEB&_nc_oc=AdosE6RyLqbW0CaF6zwi7_0oArM8pmOFkWj0sLYnmOu1IampQHWrMMX7KtdhgBYcJls&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sX6qsN_w3vphS-cbOQHNcO8collzuL0y__lIGZTPCVg&oe=69E4C55B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqyTlLoaLOIQ7kNvwHMUSz-&_nc_oc=AdrKAhencHKkpA926T1izz76Hs60PtbEE8a-Qq5fNJnFJEM7gj8GwSHmOppJKcSEx8s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1W56KSjHpcmhjggHOcvTzF1Jh2YmzBIG6gpDSBNSmiBg&oe=69E4E8F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SBgBj8T3ZYQ7kNvwFGRIQh&_nc_oc=Adpw6dZNcKldFQLxg4Z8HvDzco8VZlYxo-EehZ7n29DvfeNpRGhfPFgduI6IEKyRUsA&_nc_zt=3&_nc_ht=scontent-ia
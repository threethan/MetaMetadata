uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edbpQl5TnDoQ7kNvwFBlu-g&_nc_oc=AdplmdfInp0HmgawrIixuXVAKWxopr06Ry5WSE6IXJIwX-ch8-wHsWV1oFfoLuOUMBg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzV1qQWs-qbxzIhvAjfYbYlrAWEgyJ8cV2El8-c9tTyVw&oe=69C12C67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cet_mmpjHoQ7kNvwHhxuHB&_nc_oc=AdqkQ0i3XONjcEsuDCHGz77x6m4aMtAl-cMchsT7dWyLgg_gumxBOWdUOFxZosmyLuY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7g6GeiBzE8wzfTe3lyxsyHfNSJihZD7IKOod0149nGA&oe=69C128B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQO9ZbRzMugQ7kNvwEdeZi9&_nc_oc=Adr4TEevQYgtFLS9Lh4dtWM7ypgm_YLrN_E1eUxcP95NLyOvF9tqK48amoc7bHU3tGQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyqmgK2rcFnlTfn9r3IkqnjTkSd7dKRZZ9rDGMcWDl6yA&oe=69C12D69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGudKyRlDX0Q7kNvwFnRlp6&_nc_oc=Adphv0NgOTLqI95grBGfWy5rfTiv_PMRfm5GfhyEorFzzcJmu8rXdTb0hqh9hR-zVdM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx21g1I0sgwxcdGbo6uRu3yfCbnB1XVlRjthbRet1BWlg&oe=69C12CDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muZFbmc9O8EQ7kNvwHGZe47&_nc_oc=Adqsg8Zi3R4q9cffABXuBGTnF6918du0yocwqpfMi-w5s0FP-VM-LpVYVuJsdKKZi_g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyqT7AumydszgVyt1iLP5nP6ZRCPySwxD1KJrReuOJ3IQ&oe=69C15070"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdWrvDBtrNwQ7kNvwF4Baw4&_nc_oc=AdqyFYQfC0S8JEcMAnN2pk5dxwAI56OeXPiSsEoN4N4hjsnfzkz_nXjnzB_QN-2rb7A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2u1QRPAMZ_bROT0
ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kB2rpgQGMoEQ7kNvwGbBUZE&_nc_oc=AdpEMXtSYwK4Q8wMim-QnySSaUfB2K8NLlttyQCwbNiHh_z5uSob7rGoDo3dziD5Akg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNwwfLU2kGfpCI_UjwaemL-6V48ARViOR5EcZe-3lGvA&oe=6AE0CBA7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQo010TCIoMQ7kNvwHghFY3&_nc_oc=Adr_J242jCon8xprIPXw8WVysI1bWi1_RuSsj9ug9uN15MlVJUr8WuycP-Rgw9An0DY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMch37L5gbHz5yW4UTNnbl4uY8nIMh_xMvLrVh7EPpVcA&oe=6AE0C7F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhmR4wOrFskQ7kNvwHX833F&_nc_oc=Adr7_CZAKdSKyw7YtEkav_LLIkT6AVlLFnh-U4z-Nd9tjujQrfhlfsA6QoJUqz9mjYU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdBfXoFSBzjNduDHXtYHFUEI9CTYgVfiUbg0FNOfGgGQ&oe=6AE09469"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqoyE7ZiEzkQ7kNvwGVawoF&_nc_oc=AdoSfKdNEi0QHkLQz5FY6X4knqZB_4ahRo9xZ6cXj5Drdik6oFHZ5j7MUH3Nznd7CAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKVul87xtjcrDnJRzn3f-P7eJJ4-Zw5fD-wVCDVmSD7g&oe=6AE0CC1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8FEyS8IBTBEQ7kNvwFlc4ZR&_nc_oc=AdoCjROVbu8V4KRTxRTtOC7bGALjIsrC7o6IdEkSOYaVChS0OL58mBvpl1_uDUTLu_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNTzrluqQYS721rtqAZN2pKNmwb354IBo7ODSy9gH27g&oe=6AE0B770"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EF1YDPLByfkQ7kNvwFFYhZu&_nc_oc=Ado9qMQC1wSNjWCVaB1FcRBx3YmbDTMVq9VJre3Xyrly6I-4Ac9BJDvcNOBiOSnc0i0&_nc_zt=3&_nc_ht=scontent-sj
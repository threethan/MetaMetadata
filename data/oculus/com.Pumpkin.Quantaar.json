ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWz-YhpWRXYQ7kNvwGHnkrM&_nc_oc=AdofXoHPH4HOXcSf_02pj3XYYn3ah03heibEBN-NkBJSN_llVKHX2PDjY9kSwB0h0eM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7wsbIMSrkng__bo1Jpd5vrNZJZZFy__0DvV9ZM_s40g&oe=6ABD3327"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7ADD8DXxEoQ7kNvwFDc3KX&_nc_oc=Adr02oooIfB3ay7NBxZJMWw5L-763uLqWY1XCPKWzBiyxSTet4ror_TcVc_9aARJsDo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGhSVhf8GgYIhYUF1vEKkRSd_yQSR7OXApxRllCjl5GA&oe=6ABD2F72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWjkiEIAsVsQ7kNvwFphQaR&_nc_oc=AdqVc6spnIsJ9ebtlNEOIobDFiyijgyEMFGnvEQsplkusRbH02IrHDJnfo5cjA9Mog4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdiN8r_yUKFZvrkFSbHMTo7PlgSxgSlI9tPOzo8qeQIQ&oe=6ABD3429"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC-a427SBgQQ7kNvwHuJ8h8&_nc_oc=AdrZDD3klF0RfvMJHlgxM8NtF3-kmLlJjFi7VHRVq5OBB4ynFhuRw2t5DZDG2jaYQws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnoSxVNWYTYggCqfPPu8OeAozgsKJ3r7NVEhXjTyb40g&oe=6ABD339B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceO4HzCClFYQ7kNvwGv_kyR&_nc_oc=AdrneOlykcGfR5KQ--FGV0s8AuV_X9Ac8YVpTzmGBHVXFC-Erp9X4DtOy-bZyb0lCeQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1sB9LrDRI9NyXJgNX4K4Mi1KGxmR3uwa0DncCGz7nrQ&oe=6ABD1EF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq3MWRkvNr4Q7kNvwG8JlYf&_nc_oc=Adp5-RX7ZIHtpLzBjByaE5xPIUHU9cWI_-V1GD4Y5LRtR4ZKnWo0CsGV7WzBFuw7MC4&_nc_zt=3&_nc_ht=scontent-sj
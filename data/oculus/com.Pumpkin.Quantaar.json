ri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avg52F08ex0Q7kNvwFNYOd1&_nc_oc=AdrZsc9v_BlLycLIPu7RQmZe3HWw5knX13lk053IBF4KUbKnn0Em4rY4lnuyJscCMrM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54N68jv7gkVvepP7bIKoG5IREH2iQfN7wt_yZ42IklFA&oe=6A09AEE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDR0Fk8wRHAQ7kNvwHeE9I8&_nc_oc=AdolOTRs99SEgxe2ge685uVxjvhJJ3nIxEE30FFuKHtXSp6PkKMlwqdRlPT_XBydesI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_wFInfxtYaenYGpK0qRWenhxlOADPiD9k8n_REWZC-A&oe=6A09E372"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbWcWJ4c7WIQ7kNvwHjqbl-&_nc_oc=AdoejmDLopbveDjOeiqAwyRIhzo5HtyT_h5Gxqsl127zVTs3mht6nKgFB3OJhPrqDig&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y5zT94gaIF3h5nBicyKc4lZWF1R8HTEwGZDDpRV4LZw&oe=6A09AFE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_URAHZzV-wgQ7kNvwGDXVtT&_nc_oc=AdrnzeBSmdZDjQi5R75clwi63StyOTKpcyR5JdreSs6jx-3JTpWEUoX12OeEmJ7SmWc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MIjrTMd0ej7qarQfIUYxe2k-WpKd0E8B4XV2R8kC56Q&oe=6A09AF5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjkSV7p0G1sQ7kNvwHRkCLQ&_nc_oc=Ado97wFWui9cA2aI-gZxHkti8Io2CXvhNY1KSwE2-qnHsi9eZ4rBHHY-UfG631KgRM4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DMltRkK2pKBEvxvZQvfOzaDm6r9MOa_u6FrTqJF3lmw&oe=6A09D2F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rv8lYEpE7bUQ7kNvwGBsOxA&_nc_oc=AdrdRmm74uLKGKWO2ZSJh7WCp5yYRhL2VU6ocR8LLIl6LwOQKk7KyBjPy08BYsRcQcY&_nc_zt=3&_nc_ht=scontent-qr
ri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0fg-AHgRdQQ7kNvwFijjFZ&_nc_oc=Adqr2a8Y__MMdukIIfauGkteX2Tzix_k3jBWlV4Ia4G2sWdq8xT1xqEoZ6cOGxvfpcg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OaEgz__N7q4sdbFitRrfapR70kU7yvQ3a7gtp74v6SA&oe=6A15C4A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCSuAlfoV7AQ7kNvwEuMHhe&_nc_oc=AdqCn2VL_BwZOs_nmko2nPuDWqhWlzlTarqHlAscKrL9aJrwJf3mcsh_zd1ZjDa8MOw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fuPh7KgbYCCems6V0a1wsBX51bDs-Tcg0q8_wEaSUwA&oe=6A15C0F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZa0mbeE6rgQ7kNvwEwAuja&_nc_oc=AdopSPaAun7nGodI_CT3uxruMPRO_t-3X56hSKnN6qdd1U1z_d4u9d-qXum3q1UTHC4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rJ4qbvr3x9eKiVLHio_vzyiF-SE3-LgPDSpr6RLnGaQ&oe=6A15C5A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ME1Z0kDZUI4Q7kNvwEnrqBN&_nc_oc=AdoBAWil2UiJ2vMAI52u4vUSlfIITjmreGg-CI49RIAZvN8PbeW_0JyW_m5FXXv1YZQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71SPLjkHA1VII7SL2NGJ0_UWGvGHXE-eTAAMxyr9S6EQ&oe=6A15C51B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuezavET95gQ7kNvwG0X5Ev&_nc_oc=Adpw3bH-0uc1gGLMuu7OcYkyjP6bSxqVKp50ayfT5FtdvpMbJc4gtdCdT9HrEorEEmY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6f5My0tWkgRchasoSPTIU3BHK12QSR1J7mQocFnMXYtg&oe=6A15B070"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOnIjoCLGIsQ7kNvwEJXIN1&_nc_oc=AdpcflhdYFbPKOLakn2x-eE2MU6cTVutXOPQ_92tqJqkslHA5MFupbdtl6ypPzbseqc&_nc_zt=3&_nc_ht=scontent-se
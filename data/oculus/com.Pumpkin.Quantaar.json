ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_M8NqXoUjcQ7kNvwHSNfrZ&_nc_oc=AdqXXp_mso4EOo9pJXHAezhec1IgV7iQXL36aKlth-JbAb3wq3Ihjz8aRm-Nd5uECG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbtGikrn5JLXR7QMC_R7530fB2hWZD8QabFI41n0ZJOA&oe=6ACE56A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sc30U-MnkT0Q7kNvwEB1AZx&_nc_oc=Adoffc_4FM7MAer75ZOHtiaMD79wP0Esq6u--ZgX9ZpytqsmBqDXY4zr2JryEOmrJO8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnUi3m-m5maAPnIptoVF0j0zPRDI7bs9dyOzI3PAyifg&oe=6ACE52F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh_2zHgAoCsQ7kNvwFyFivk&_nc_oc=AdqoEvAgrN1xpxjpywYPv3RWgeJRa344mT2cuCdqOXJu_Rm17FBJgIErbOkP4sauy8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHXxANkDrxwkkmXuz4kj8TrupBDFpoPaUoUWmYEHMHXw&oe=6ACE57A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_V1a1wWDZSUQ7kNvwF3R-ca&_nc_oc=AdpThAePEq3mx0167hjYuPFAEoKQwdRN9Tkf7DDiM0isf2M5ghRP6bCN84DO6n_0Nwg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPl3_tIG3tAWTSRhvv7QhOmViHZ-XENTzlrBm54P3gxw&oe=6ACE571B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dVgLqyNLe8Q7kNvwGdTkqO&_nc_oc=AdqLQBTlFoU766mejKkSyKNYT8JQbVH7rKstCeG6ar0lcC-EEx9f2AssEVdF2d2xW48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWDn1_jyMJ_HUqnvVAAe5jEQZNtAF-c_V6HIRfIJm4lQ&oe=6ACE4270"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5Zn5UaYM7oQ7kNvwENWbMX&_nc_oc=AdpBIh0NnjVGgrmKOX9s4ZWo-QoE6rfy-VXQE5Po9q76p2N6TDs8qGGJArSk3CCwUxA&_nc_zt=3&_nc_ht=scontent-or
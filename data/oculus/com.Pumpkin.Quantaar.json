ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eBAeHUCCe4Q7kNvwEIdQna&_nc_oc=AdqtVHtBzXX6b2EJrAT399dY-LZCu3cIqXfo9V3tlI2tY13Wh8kOsxgy_Oaz6duLcZ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwwI4GxTOSCpj-YwAehAYrJ8R7YqT8UpQ2MvJy4k71q1A&oe=69CE5B67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZ95c0bWq8IQ7kNvwGNpC4K&_nc_oc=AdqUVzaOxFaTHZeeroZe-Ud0X_GdrUHxUuAAdMQYndyGUdk8SnENCLtaxOQXTtnlFI0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRLfEu6Tku4_pjcYN5YCpzhiFx5jXP5-Dmxb29jAlQrA&oe=69CE57B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sbr5qVHiCYkQ7kNvwHu-9-M&_nc_oc=AdrElGd_BGAsZza1U-uugdQM2jiCJlHT6L4TbRWhdQ-W-LXR1GojIXYS21-BTSLyBYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC9hMmbB3YcAD9Cw4eEHtODAXYdYjuiiRNN8Bb5OQm-w&oe=69CE5C69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsoW9dUhypAQ7kNvwHen9rm&_nc_oc=Adq2AgRIwuRlN6zU6FkIx_7wcij_dqrUUHdc3F7smidg-XyrxRad1smdyBRIssJgJs8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbIGBWnWpsUrQXc62Oqn9iTNRXRgrWdMzwdovlTsmziw&oe=69CE5BDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ko0CrtXz0DIQ7kNvwEW2U_m&_nc_oc=Adq9V1I1IrbAIVsgk80-rycmdAJsQ9PwcDzZXc9d00QLC5o7QVIUi84ucYfiKzGtDvc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyq_gIsI-WkprQGbw88a3FweqKknUWrfWamRtDPx5OHGQ&oe=69CE7F70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEmImPuKRZIQ7kNvwFW7f6n&_nc_oc=AdpQj7fi0oKD-MGq4vEVQ4bmgo9siVMqJ4ZFN2vQlC5cukaZMJksvIZ4WhXpCT7bNgQ&_nc_zt=3&_nc_ht=scontent-or
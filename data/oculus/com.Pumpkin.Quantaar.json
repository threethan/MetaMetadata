ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y53Lamat-qMQ7kNvwEVh8f0&_nc_oc=Adr5evKCvBGscw-QGb2xepOUQCZDp3cib8KGfBNNv2h3dGtiyNNEU7BgwMST5BW0GSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCXQ9myTmDg_4o2aKN5YgSZz3J31twALPsTXxcaEpKUQ&oe=69C91567"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sifTwm6Rb-oQ7kNvwHiH6e6&_nc_oc=AdqG208OzHhGOIhj1jWgg5QjtargzjbLPEOXivgT6dkVnVHXTXMiIboSA0mFObsvISM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy61GXTEIAvmA-Pzsu3u-L58fTi4QAaue5XgA0j4SGYyw&oe=69C911B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et9sdseKEM8Q7kNvwGYm13_&_nc_oc=AdqR-OhZh3wxfNMAvJaZjx17bR04n5Ee9-iyX9etWIgxNpbuqis6tA_w8BtXSAo5ocw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYfYGzfkPbrrhmcC8Mz4hyWPnjwO4RPxwnZmfvekleWw&oe=69C91669"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QapYzSrFwHYQ7kNvwEqbA5l&_nc_oc=AdpzvXw4WYPLn5PU2jCvFmS-Qc35U7ke568mtTRpIKxUvw76NH_baTHS1Qiz0cowCKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-eQRSukl-3HWJD_MneECUsKcMBNpbO3Z3vZK4rKLdpQ&oe=69C915DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysUGE8cylA8Q7kNvwFmsiSD&_nc_oc=AdoTRl0GBXl5E-Q2qa3b94YWWpfVpOa8aVh4cN3HT2FzqjQUW1dudwtycQB1r9m1sGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySvygDpiePqOsYhEPyKiGuSv6bxN7LvKl7vtYtLfnpHg&oe=69C93970"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBtImZ0e3nwQ7kNvwGzwjGK&_nc_oc=Adrpoc1h7oPpm0Wy7kG-DPYCCqd7jsMy8NZoVtV1YbXswkLFNjnU2KGnbyMHarmVrLs&_nc_zt=3&_nc_ht=scontent-ia
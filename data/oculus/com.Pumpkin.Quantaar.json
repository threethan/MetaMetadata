ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWz-YhpWRXYQ7kNvwE03sdP&_nc_oc=AdpBcNgaqWWGDbwftpH_UkQZloQF4_GWoaJB7mJ7aCmOMOsPiDMyJIegHPOiO89ig0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-t5GKH5zpgWiWFLkG0OomoTaqNR6jeFE3Ar4NLBeJCg&oe=6ABBE1A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7ADD8DXxEoQ7kNvwFXvSVu&_nc_oc=Adqr1sGFaiZyJjkiHRdXPkJCY3drJr_IhpYooIds6cNcZDYed0t9QklEM_BZbFUequM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0VcOzmYhTyRWjlYt00Y2laAbjV4Bi1OAXg0bYO_9qvg&oe=6ABBDDF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjGA9NqH9GEQ7kNvwFrtnaZ&_nc_oc=AdqS7oPeNnpituo2B2OOZpGAT3-G8IEhDjses29JQO56UyxtjazK6L8nncyOEudo2BM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI10FOgv12nU3FqlZ-ZUbeXYeJcPzKnG6PyPJ0uIL8e5w&oe=6ABBE2A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz6rhJtzAAgQ7kNvwEiy_jG&_nc_oc=AdrqYtzSKcvW7GbU1vdLTkb5rzbVONyCk6G2wRv3lV-tgTmhUL3UsKfuSSusksvxFDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMNWrGfH0y1HCe40Kg3qsvF94YKVoPqhmLTh9lebgOjQ&oe=6ABBE21B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceO4HzCClFYQ7kNvwGEnQD5&_nc_oc=AdqSTCCO2tPFzDSMZkLnILStqd8GqafLTDiWxvZNdrz93ZwNaSb-bwh8or5kL9aPUAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSrcErUbMGftjvqdQbkg0T3nvyuuNtrzQvMSERpZJxvQ&oe=6ABBCD70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hICI5rc6-cQ7kNvwELYMzF&_nc_oc=Adoc3hvh1nEuXLboQM7Uy9nXTCnno_8kM97jQcScRxobXdxuNo_K8Xy7jNGaQ77Z47U&_nc_zt=3&_nc_ht=scontent-or
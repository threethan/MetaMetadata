ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjDfZ-bTylsQ7kNvwFiFFVw&_nc_oc=AdpEdqrSQO5lLempUyYF2X06d33BCa8h8krSr0dygzaU8mJLlQxz3awaR_cbziSfhI0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OBn9962tej9WfQuxRp3P4cZO434BL6TthIMfq4Ee9Tg&oe=69F739E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkSa9rUM2awQ7kNvwG6wNRn&_nc_oc=Adp3Q9Llmz2llNx--_uMoUrvcnOd94MA21VrvBIJE37G1K1_SI6xoXck6BXtIgToJew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_L1nMynmxs7R1UeNuTbuCKJTSGZsweDaNCZBwCxDfUA&oe=69F76E72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or-DxEELHw4Q7kNvwFd2YuX&_nc_oc=AdrrzFL7bC2XaFGzJD7RGnk2cGd5fMClAU8quj9ORzLmEtPxERRAZ7I8G_fIRSUoxIQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sIWGiMBv7HzIfNZAZW0Ih3uUH93Jc_JIFtkm_fop3Gg&oe=69F73AE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_oTCN3ZHAoQ7kNvwH3HXGE&_nc_oc=AdrR4HdfPzCs4A-sXgPba8OSzEnFUmBkexBgiyxxi2Vst3f9iD94krmi2vlLnfsZrAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GJ0tXThr3Jw_1ymK_M319V6i57TXZMQ5Pjkomio8RLg&oe=69F73A5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gj8qzlwSVnMQ7kNvwF-6m1b&_nc_oc=AdoqKzd2ulbIFZkJESo06r_X39t0Fk1QGiLu4eAQXjmQZ7aAKTnnbi1QDJxnWJoB5Og&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XC2CU6tWrnZPFkl923jNcPe-54u0UBcRwbSaekDwsqg&oe=69F75DF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIFT5gj-jJIQ7kNvwH6zBlX&_nc_oc=AdrTloMPcrcZPKuwW2R4J6KzSgvFxJg0xnqdf7ZAVCdlQ0pVgofB3IkRm7UmYAr-QBM&_nc_zt=3&_nc_ht=scontent-ia
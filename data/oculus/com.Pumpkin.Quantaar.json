ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q9CskBNgK3IQ7kNvwHBDCpf&_nc_oc=AdoheCxper_ObJLLDwciWf5e7FiCjSuOHmSfGaAlUVlVfrknHKFx_yX4rqEhfE-N3iM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMa7HCNm8k8G8cO-g6GgFCjNRhcyfGgAxX9Hot1Agf4zA&oe=6AD24B27"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rV_J0bTVKIQ7kNvwGmdzSW&_nc_oc=AdoOZEmNwANWhzKDUUlzxYV4dbkmC8HJ630UYyFALcCtCZcbcxea2dq5eHbVbOsNuFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTIh-J66OzsKvvQTm9yXZw-3yZ8FQ5vuyTsoFY3aoDNw&oe=6AD24772"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M7v0kEIOTkQ7kNvwG6_Rmt&_nc_oc=Adp5M8KL6EtwFfP21teIR1Gbd4j-ETwgqOSUVhBFT_JlFStFRm92AjZMihdbGMIGgls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvnXFl_XDOACN96kH43_OIHlfhSJxpVvVcOhlNvnVCHQ&oe=6AD24C29"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Thglf-j9nQQQ7kNvwE6NBTY&_nc_oc=AdobS2thPwMalqph5uL1gAyZvPrltUBPajWMfatb2c-pwhFYcZViXjtcgAAsYt6V5Gg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj1AmmpvsoztR8pv3Aozdv6uaXcwVYu9QsNrSQm4vHxg&oe=6AD24B9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgIX9bhGFg0Q7kNvwHhezkB&_nc_oc=Adohug40SSWotEhGfnsMQvc5nOoFu8y6Nom4Mr8-6qWtwiRjWYiVs0VGHGgbHtZfm9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPugKzcUqYAdWDFizDLI1PhtvqjdkEKu_oX-nBL0LD7A&oe=6AD236F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P66btgfSkGUQ7kNvwGRaXcf&_nc_oc=AdoU6639D-IZ7CxirGi6KI4engTlH8Q4UVhoeVGIckpYXA8ktIUErCq1EJDF3q26KMU&_nc_zt=3&_nc_ht=scontent-ia
ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z99P4nDHz7cQ7kNvwH_jm8w&_nc_oc=Adp6aNIuQQJ89tWnVxsn9YQFTmMoLhXtSmlM8SDEqkLmr7FpCLCW_wvLWjIILKYK3Ak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3NXmD3N3qPcbGMEVqTm1GyY4uyOyyDo2nPuVquF8GVg&oe=6A9D56E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jl_8YC1OMp4Q7kNvwHzMw06&_nc_oc=AdpXS4f0Hb2PXOvw6dycckBt1zdxc9udhKvWLD2pj0TXitMu8aR4piuUVtJ5-EZCglg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRCOkuHbYKCNk3Xf3s3vwRQnzPA94HINs-QjmTyevHCQ&oe=6A9D8B72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuvNq7WLkJYQ7kNvwHkbOTB&_nc_oc=AdoB-k2dLHgO7T_hzEOBJlBttD_HZRPr-sL-ZOcVYBKrBzw_hoGaR59ZoFPC3VF4b6s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpFt7cUK0qWq3HSeX_Anh3y6trvMHshqSoPn0ejCbCKw&oe=6A9D57E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJeIuBccnfAQ7kNvwFHcHqh&_nc_oc=AdoEG3GAMNu86jtwenSFnoEcvlwA17CL-5bsaCs4HeT9FP9rlF73GTL99SOqpkniWyE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfdbnM2bpU79pHgSw2s6zmcYapL4IUnyQpE0HI8eZv6Q&oe=6A9D575B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKrL7p7lF48Q7kNvwGNn9oA&_nc_oc=Adp066I4fgcgp1v3gyNTZBi58eJmf17kbH-R1nXP5f1yT-VRDlJmNmBl9LBU7sMtLAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJG70DqjGWVJOF5Ku-kurfnbu3u3r0xSPqZhC1ExrwhvA&oe=6A9D7AF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DwpZJsF-nGIQ7kNvwFiLZK-&_nc_oc=Adpw21gyuehID1fVlt4R57ogHCOk6mcXrZEpw5-5ciOV_O_x6SyYuX77MogvCaV8cxU&_nc_zt=3&_nc_ht=scontent-sj
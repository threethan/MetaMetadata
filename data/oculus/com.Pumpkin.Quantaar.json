ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5l0Q_fNUUDUQ7kNvwHgxM4K&_nc_oc=AdrEVjGaUVXgCN-_62858xakLV0HYuzzdkBwVGAIIw-2H2UuBqz3H7wDGRgnnVOjKRA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQiZSJBMYcGEspdNEKYCGbBPTl_9lQts0N6VWT4gWZpw&oe=6A82F8E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XUwZ64iaN0Q7kNvwGyni5P&_nc_oc=AdpPj7mYlPj-xi79gf_7FzMBg_wm7cRx7VQJ_qQLI3iU-B6IkDCM8h5krzsjVz64RdM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIh4BNv_MEZ7dkXJh84hjb-BG2jlzsPcr3nuM-DqgrpA&oe=6A82F532"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rb0oUYNaFJwQ7kNvwHAUDdJ&_nc_oc=AdoAHynf-CvFz1vcLccteniPloOlpfdtDlWCA20dNQ6vUkt-kLPdCacLYiMYQhyxCu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf986_NNUTTNSRumREBmD13nE3RctS5ludnMGJrWQ5hQ&oe=6A82F9E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFkmB4AI-3QQ7kNvwFgbKnz&_nc_oc=AdqGRGh_MVzYpASaVTSotyzHojrc3cbN1nO75rwEZ1mi_CnwgfIooqqZa123AWTZvs8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKjD-VaVcQRNXmqjatn9tPRhpsAHcV37taMC7Pn-LfAg&oe=6A82F95B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvH6QxQZgCwQ7kNvwHKwesW&_nc_oc=AdqT2oW-CBmp0IM-ruosa4MO0I2WFR3d7XdMnpdgHcDpklekzT9H1IT88dBADcPRgkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2R-mTD0lT3h78SgQb-vYgVdM9RkoX_P7EZ6H_n1G9yQ&oe=6A831CF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8auftlDyuBwQ7kNvwFBUWja&_nc_oc=AdrNh6hzWcSd46ta0KIbdBMEeR64bQm22aZYD4nnIp8F8iHd9iLTPkTYKcCWsCaBX1Q&_nc_zt=3&_nc_ht=scontent-sj
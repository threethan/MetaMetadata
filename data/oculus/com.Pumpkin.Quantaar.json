ri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LuP_fxvZ0rEQ7kNvwFEhYph&_nc_oc=AdpIoeOd3Tv6AKoB5FKj6n8FNOYrqSV6Z1GgeMvU-8DQQsijc1Iv_VcbfZncQp3ZjXg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y_HILGoyygDt_zkmhobiyk-C4B5L1FaCo1IaLj5ZN0A&oe=6A26E827"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fne_YL7X_OkQ7kNvwESnlgT&_nc_oc=Adoi5kin2CMfZoxsGlIZV4_R6uCJ64BPlz2nZOBgBKyyGuyLGhxN4Ac3DEcmW9sExXE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ufMpEuUW-ldPASvnwAqKX_K1wA1SSN7GdY9DwB9HdKw&oe=6A26E472"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIERbQUwEggQ7kNvwE-RmP1&_nc_oc=Adri_gFTZhfBDLcTVdQscjgF9NviNQeBjavJh8GbeHrxq-I6svGtUAXGcDnPz2Nx4Sk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mnejUyYnaVNPR-M9t5N5_SKHX_O4Xogtp2dSCrH6_8A&oe=6A26E929"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKEKyuDsG_0Q7kNvwFLv0CW&_nc_oc=Adr-cQhnBHIIu-7Q9L7IhI6s3SXQb_6jYLR2KINpEVGwLDTNz1oDyyuZ0NiOP4ECj4g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uUB7HzNfelcVKq6w2WCQSVblI7Ens0gIrxryaDnFxcA&oe=6A26E89B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAo_hagWVXIQ7kNvwESN73-&_nc_oc=Adr2fFUQFHuFyEnlK844ziM-sWo9xANOU1grCfx5il4pvn2Y5H9jdlJ_ySIlobO9kJg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nDrPzemFcGGdQEPtH3_vOZsb5e6TKnuJdDYmc1c04xw&oe=6A26D3F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzZho0JLOWQQ7kNvwGnbXhJ&_nc_oc=AdrRhDUTLIV79zTHjQAELa1uWehLO3pIiHCLQlQIP_2RAtXo1wT9zViCLVXXsRSesdE&_nc_zt=3&_nc_ht=scontent-df
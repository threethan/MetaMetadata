ri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQQHdQbfWAEQ7kNvwETbKkJ&_nc_oc=AdowSvpWo3FftcZJqT_vFjII2eStVRAFT0M_9Ia6Fd_i1iWlKhfqzutbvE3CSKI7uKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP12hq-7l1Djgk2hvnmxbLPhBjb-LNprTqVqhWeZgazQ&oe=6A7B0FE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CdG2R5GgW2kQ7kNvwGW4DIV&_nc_oc=AdqJV6EQg0d9Ap8rGcue1jEUHSxk4n9Ol-4zI8L6Ty9dG52BIqjGn5aKCKmscPODlZQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES9XKAE18sZRhefHsE0mIBaHVGurIJWMKE8JP3vg_4mg&oe=6A7B0C32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln3hpJEfjGkQ7kNvwHy9H5a&_nc_oc=AdpndK3Oo0LFeahnmfbX97MOkw75lOajsnwdaPikQfQMgBBD_5HIKY8SiLKvG8OW2J4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGn5u_2P2apftALp76PLpaVTGiKqPS3z3-xVF1nAFsUbA&oe=6A7B10E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpZu42aW0pEQ7kNvwFTKCM2&_nc_oc=Adrog9WUS6TxBMk1VXi0t1tAOtvaId7jpVzY6_9aVVhgfhPuRXZjqqV7WCs8H4EFLgA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4Mvh3hdVtPasqQG5LW_hu7lasQqZLFfIa6ZeN4XNb9w&oe=6A7B105B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXR0BJGjGJMQ7kNvwGa10NX&_nc_oc=Ado-RXm1pHcrAVxyijcKLPgFI0D-LUHLR7WUUjEDo3vAyfj_HHZTCUUyEtyKwQjvuDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH94OW9FYpb2w0G4hSZyGaLAWIpevHzWPyrP4QsF_vzbA&oe=6A7B33F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5pnPZCsw3EQ7kNvwFrNHzV&_nc_oc=AdozppHtDJLMuqpIzQekkHT0-UQHenf1d1vnj5TzqX2JCXhFd9NNH_JChFpRGZQtJ34&_nc_zt=3&_nc_ht=scontent-or
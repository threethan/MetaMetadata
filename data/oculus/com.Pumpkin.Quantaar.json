ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwYbHM9-VnsQ7kNvwFG3RW5&_nc_oc=AdqlkO5Lrsoq7WcIP55fd_l_QK3lCn3u_mZfZkAAE-bIedxoB9yfE2rNW-vD_iD6RTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4TUZpIniNXY1p9PRBWJX2sDT2mw_Xb1S4AZleXEsiYQ&oe=6A7083E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbIETzrFwJIQ7kNvwHgGkXL&_nc_oc=AdpjFOzna5cYLFXpGH6_5U47kO0hZb9ukWmrwPB7WSZgG3I05_tpLMfGkOfDes7055k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESg7Gn6bIP8s1RHbSG5Lm_2aGod93Xq22QQwM_IMvKLQ&oe=6A708032"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3sugJSCPdgQ7kNvwHwwFVv&_nc_oc=AdpOec6BNNGDCEXbhX-f2cfFvue1VmR0SZu8111LBGEcpCwxKZsTLOHirKKiAFioyi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWIrIIl4ys09RyMgTIkgC3h30jJthbUKlcrl_uVOyXqQ&oe=6A7084E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ft3uybmNhIQ7kNvwHNr2Ba&_nc_oc=Adowtaw7TvQpheplxLm1R3-jtLrtQtA5MlrHJKjHyZRSIv7d3Wl3LU5aHQpw-PZzJTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-8riFgE4D_xG51skVvSztf1EITKbW2ntPz3nPjTGxHg&oe=6A70845B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA5XPKg37kEQ7kNvwHQldz3&_nc_oc=Adp9UMj8sDS5xh07697jQmhe9VAXdB2YzTsH2CUXFgSf2wiM7rvpRbOeug594MlUpl8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2FqDHjHs-J8VxAA_VT3ZVETHvy_-fYaGqKhm8ZrEn4g&oe=6A70A7F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qld0Qg-OYekQ7kNvwEVXueM&_nc_oc=Adpz0OMF2gC1QBskOA1EzW0wrjz1mINT8Tb-Byn-ErUwG8uYUaEpONMQnMJctSnJEF8&_nc_zt=3&_nc_ht=scontent-ia
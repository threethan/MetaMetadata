ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNapJKB2-sYQ7kNvwGdgoMV&_nc_oc=AdpCuAdKtPBXmZ9hb1EJ4m12wlPlBcKcWt08UDDOETWLgkOsz9sD8J8JLScHUDiRe5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKd8Res-cMyPuyP4PZnoDigrcvnZnfXqAjhiTFcCnk3cQ&oe=6AB3F8A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAKuzve42SoQ7kNvwG4RdDz&_nc_oc=AdriLfRQrcbZEBWsMVMba1wRqwSD0RUgFPXya9EWyKPaxl2Dqdv7umkIIqt8Yf6IkOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4DXsM1W_yKsl3Dc0vnFHbMOYwmUiJwGD_xRS2UwatHA&oe=6AB3F4F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCXlxGTQYloQ7kNvwF536s-&_nc_oc=AdoZl2gz41xXx8q0c95HPxH_CebtWszDBVEfQiYoAm-BjNiL9D9dWeY6XS-WnwCkdcI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_x_8K6jH7V7u06yWnAFd929I705CXBkTXaQpyxinZ2g&oe=6AB3C169"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J951yVus3h0Q7kNvwHY_B1Y&_nc_oc=AdqTNkf1gWNjw5Qhyj3qh-PLQWsN-nj9rskqdEPue72DLDWrIZPrGbDZoBp6ppmNAU0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6CxfzPf-peS546NOcrO9rhXxti0QJtapOrzonzPtYqA&oe=6AB3C0DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhHbg6GfoP4Q7kNvwFxEFuz&_nc_oc=Adq4tSfgl28RU5PIiFl4wnkuUme2RrJ5QRbnOSRuxA-LRsZF-zkIassBPykkIuKNO5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNiy3Cwrxh4SxF7oiHAhu1ZbyuiVLjF80apqx7rvNC4A&oe=6AB3E470"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTp2PTrCiUQQ7kNvwG7TOvt&_nc_oc=AdrTUZHQP0U_zzex6HiVa1RG_FyMGHeID8Tbm51AGrtPQJjMfI3Ph1ptyIAi18Jqt8k&_nc_zt=3&_nc_ht=scontent-or
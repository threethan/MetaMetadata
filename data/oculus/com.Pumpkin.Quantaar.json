ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CsXezLb-e0Q7kNvwEx5egC&_nc_oc=AdpGddBjtTiRs_em7BeBd9bIvqLwhmdu4QBenVCfvuFoH5M8Pmz0Apls92Xc4GFYjRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2mtotqDNlNXxA9IohJ0jrKQxw7Kn-ERf8SQR_-1h6IQ&oe=6A60B1E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fke1Yri1o3wQ7kNvwHkOeC5&_nc_oc=Adp7aFWngA8bD5sKREX6LqW8geK8jipYR9-G0a9t5dwyNlwhYuL4Nl9DW5QNODkcEtw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_TlyKU85LPW3hSMHtmiu4gVPJbMAejiipLlQ3wMg_Xg&oe=6A60AE32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWjRf3HcP2AQ7kNvwH5Qwyu&_nc_oc=AdrLwiWKkubfJdG2eL1HzHzrFfNjaRnz4Q65NLGegXXC_pF1whH9aW7zEop0We3vaE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtrr-748ci0wE44QFpWf6Lwo9YCnaQlzcXO4Fp-xYdLw&oe=6A60B2E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjFrkNu_MaoQ7kNvwHwGX_h&_nc_oc=AdpVadzwrOA_XD19ypcpZvPR_3bgM9M7BjXzhCc4t8iDDEAdDtl6ve-7NH5HmHaylYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVoD1WAg5-AvoSMrVWyzgA2B6YnMCFd1J4ZmfIYZlC_Q&oe=6A60B25B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULbLdX0NHa4Q7kNvwGGzWmB&_nc_oc=Adp4xAye042xvx6TCTm5nMLr_aM6y6ocoscpHLtls-fzLIemne_O54Bx3ClgISAo21I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB19PogLFSh-3Glksy2zhlPy_1WsgFsd9M71KB63akOBw&oe=6A60D5F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUraQaYLP4MQ7kNvwGMBbzI&_nc_oc=AdroGw7C79rX-1Bi3uu78MOjWLofSleQjPnH8r0197HbvzIChxm3V-K1Poa0TzOjIDw&_nc_zt=3&_nc_ht=scontent-or
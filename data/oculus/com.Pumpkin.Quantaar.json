uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-9en4y1R2IQ7kNvwGmsF2y&_nc_oc=Adm9Gg41m-6DZjilLuapaM-_2A9KitFvBw6d9LEkbUuBLG6jAFi8QmM2ECz1BIuehQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfytXOFeHi9uqTHUbehH5lfpHQH5hyCSz6BHQca0w28cKw&oe=69B2ABE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP1WviJgungQ7kNvwFGKOIN&_nc_oc=AdlF-B-YkQOJrgzPHAjuse1Sl8FB4AkSwWsS-clfRRnF8IPNb_n6syzjy90kbynJXrw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6O1RgMzUJgOXa65CTDJkXvKTwV6B4TBhvGOLvpOgZxw&oe=69B2A832"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwrOtf3tN4UQ7kNvwGF_cCT&_nc_oc=AdklvpKJNVXdkiA0B6QaRgyiEthk2q0Ww8jqnNsqHlmkRw--JkevQCpuXRGWywz3OVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwE-V7W6a3eibz1xcoKnhjhRQbrUCpgE7BK790yt3nLVQ&oe=69B2ACE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2Z1pfi9kl0Q7kNvwFpFq5d&_nc_oc=AdmDmu9llghX2yJv2Vz9loe63d7kMCH-K_pFi43U9ch_Ple3UEUDBOKRT4-gO2i2qys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzO8Qie2y-cjYUFDwv_j6Xt1G2-ePM0Tkwf5N1AP_T7eQ&oe=69B2AC5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk0rDN55OLYQ7kNvwEQ_aVY&_nc_oc=AdkAuOgTBXyydkEEiOnmp7EdaJk7cJpVMv2hraXi_6bEwasEQ-pHa_CSRwNAEvnq1GM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzw-yyr4856JcLiYZfsZreLpGMRRpDxVMqh2YcwiXOylQ&oe=69B2CFF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ropylOmaGdoQ7kNvwGTMcx3&_nc_oc=AdlGf-2CrPIZgmMZxdSqcikryzz_s8ZbheoX3DxT3zcylwgm7UHGy1KC85fP8awkIZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtaV4ZvI1spKoAEa
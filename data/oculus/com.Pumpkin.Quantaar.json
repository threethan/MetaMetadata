ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePvwiWhfqlEQ7kNvwHAi33K&_nc_oc=Adr1GpJp3QIvsED4JbqbHAC33BTeZZwojcuWbpg4ti8xMBYLIfUa8RjljklJC-LY0xU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKWubIjqD39kO1YNAE0qOEohBeS24hgFqJnb7QAoZsCg&oe=6AB2A727"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAKuzve42SoQ7kNvwE3NK_x&_nc_oc=Ado15gG02I3Z5wWzodrInycH_anLbhKW7b39p-ebTkgbH52r_XkIIHCZfjZpuctzS5U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwvpLXna0dS-OxG5vIvH2tOOGEl1FcuYpgl-wFHRp-7Q&oe=6AB2A372"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCXlxGTQYloQ7kNvwGXVk8w&_nc_oc=Adp_b0JeHqlbGkmPOSN7ZDEHj-VxVC27v8Dlx7EK5SJ5DBkWqD2QECzvlZ-SAqqJzl0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNXqCv3Z9sZJko1DIQWhkPWD8aut2BEupeGB0T7AR5XQ&oe=6AB2A829"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J951yVus3h0Q7kNvwHdBHUL&_nc_oc=AdqS0ZIkJYWo7xvjXoW811kRez0itvbRXs5Ow1Wg2IbC-tf5gnq_ZbGmSy1zdI6Zuko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJee53TmymzuMGnvVO2N9V-m3CQenNokRfySvstDiycew&oe=6AB2A79B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTLSefrR4q8Q7kNvwEvcj86&_nc_oc=AdrdDKpd5MfgovnEac3qZl6OUhdigMsq3xiSMsQA0XW-Fee9r00TTWKnv_38IFRA43U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHI-5ddGmxB9CBuT8o54tb896zLdbUHI75In1CFupKMA&oe=6AB292F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTp2PTrCiUQQ7kNvwHIQWBD&_nc_oc=AdrIARKpDZ9Eo3Go0K0SSVhQ_J4FlLOmpjEA22t68k4H_OAz0TYIETrPfEbEhu0N2t0&_nc_zt=3&_nc_ht=scontent-sj
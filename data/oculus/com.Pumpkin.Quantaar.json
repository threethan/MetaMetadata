ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcztVXhZu8sQ7kNvwFJphbr&_nc_oc=AdqI6LRIlbvakzavGIUV322l0DZWP9j3flfx53n4GKdKio6kQ6Gph23nTAfgqKNGiaQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbRkcG7mmunl2ImGr0ssPDeg0Z0_tgfDLkRTr7bx8orA&oe=6AA2D527"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XO9XUlJr2UwQ7kNvwFN8Y8m&_nc_oc=AdqCfECro66KXbqiWLqrF8Si6BQw4EcGLQ1ThDnUygRrm8OFxhsZhHg9gRh-KhRy35c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9ZsI4fO6wtR-pFzbiNxLBtRaNv64DcXNbP10wYkwqXQ&oe=6AA2D172"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQkvNjuZSrQQ7kNvwGfthUQ&_nc_oc=Adq70WPrLWiKJbkXSAzmaMmKsYn-7NZdtTiNp6KmcBKeWoG3gXaWhOqxrhOBVsyi0q4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTzKQr1HivCTbNxk0y8Kw4PFxHEG73SmRU4szkumDO7w&oe=6AA29DE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FudyKoYge9EQ7kNvwHagqzT&_nc_oc=AdqCFjDHjkvAZMKPGku7fIpfbv_LcE7pyg-9JTdYoSK3fnw7XomYkDqmklEK4WboPuQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIydIMF7B1i4z5igR4aJw-z4sqVDa_znNsduIdR5uwmA&oe=6AA29D5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eW3G5NQ8bEQ7kNvwGL4pdC&_nc_oc=AdowKVZu0UGwiLhc5cYoqGmertxT6IIO4cNVLE8AyQOQLGFly1qjWXURlR6YpAVCsPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLUKaXV4YnyFdZi1BLkjlQhrevP5ewXqCJLGQpeuTCdg&oe=6AA2C0F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYtAA7uiktkQ7kNvwECgwcu&_nc_oc=AdrEdDoeMumJhzTWuab--OPvtL-5DIR19bVtarLHuq64v7jom1luBN8a8W8ebyV54KE&_nc_zt=3&_nc_ht=scontent-ia
ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Tq-SpXzOIUQ7kNvwGGoI13&_nc_oc=AdpyGtxgrZ5Tpkwac716TTuz-v4nF0yIqWL-OxHW9mu4Hl4vViwbuBglI0sAyztNUFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAf3U_lyDBVT1Oz7v-uETMmcXCaN7zTgnoElKiSM38gg&oe=6AC127A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTJg9IVgJYMQ7kNvwGQcwOK&_nc_oc=AdqqlFLs7K0twdF-B25ct_alaCKh1VsN18jZe82HoMjxp6zwGk5JFgH8WnZacs0ylgA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGdMjdNe0JtvbqCzkUMMawA7I8dj5KwxKdJ1U2Nhejfg&oe=6AC123F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLa03_yPX1gQ7kNvwFNJsBm&_nc_oc=Ados0YXqvAI5QWuLeo4tWrmq2XPhwNq3H8l4qTYgrxk3_EPJCqTpN8swoVQi7Wfkppc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3UaUjwMtjMpXd3Xbe-4Skza3NR3QWkQ6JdapiLBa-Pw&oe=6AC128A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmaOmJBub0kQ7kNvwEDVUNZ&_nc_oc=Adr9Xs08RdIsr2FpRALOPUU7ovfqBMxdyW50KmwRYPHU1zO6-itO1cmqaePOA_2fqHk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPSoFU7CutuDjmW8fjCk9dj1t1U2iz7qg6LY9JvSRONA&oe=6AC1281B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7nT9eUFEGcQ7kNvwG03s5W&_nc_oc=AdoHJxHoLa3-rDL_bcjI53UJw2QiSjX3z2-c-lFYzGOktyIpV3o2-hVTP76Qq4KXlz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPsjzShRMbBE44m-t4LKTGHlZPtUPTDrLJP_0R2E3jwg&oe=6AC11370"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD71DSxicyQQ7kNvwGwAbwW&_nc_oc=AdoXDmQrOTiGNyvIrx-c90q1IRxv8NnxLCQGfHqLXntEWzYphZvbCkokq-ciFPAACaY&_nc_zt=3&_nc_ht=scontent-or
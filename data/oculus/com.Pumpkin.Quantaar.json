ri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9XmYEIxqNwQ7kNvwFuUmvr&_nc_oc=AdquYe_yAc1bc3mobut9V35ZMsOL7Juap8bPQ8cJHM-IDiCLBSegFhKuIPU_ZC8wiGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07JGwzhVooMeiGdJJH7xK5seq1J9rDLA5g4NgT6-VTdg&oe=69D24FE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG9qZkyGuJ8Q7kNvwH6iHKb&_nc_oc=AdrtNvE97semM6wtjtuON7k3sQ3EaX8d8pCg5nA8TVyejAQSUXJMYRtuIxwGgUbBv9c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vfAdU2G8LFruJDGXL0jys-nt4AoC4ewcjRxF0Nv8BLA&oe=69D24C32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cS7UlKUX-TQQ7kNvwFhgKgm&_nc_oc=AdrWDgAl9iW-PDxmU66jB-E5qBFcx60PKrh-RQMHu7r40D9y5Mne-VwFEUlKWJW8Dew&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IE9gecLiWvSVEyFSoVdyV_1d72kI10UYkXHsUxxiQrA&oe=69D250E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=430hYP5t5kMQ7kNvwH7gkNu&_nc_oc=AdrZ9wqh6hFBH6ZChtc_OHx6WqVGrlTbnsCmjhCpLmH_bi2KAJCcsIM3IFgsfUPytzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tGOKSUS2msLiKhFxOx2OVG48T8bptlIOTPFj7j1vEsw&oe=69D2505B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mn7bGYDIB7QQ7kNvwFeatvU&_nc_oc=AdoUoH1J91J13-AJWUmo73izWz7yU1FJeIGWW2PvekBfV3irwl71yZSAGsIQc_SyOvk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bAiJo00IVxtr33sT398SzM56kgD1ahJaOsaefj70XFg&oe=69D273F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHqZCkDMQFoQ7kNvwHfQvtP&_nc_oc=AdrUOnQGl5epJEFTA51H1mIDYa0705FuMuZUtKntbfI6M69CInXLo7Gexm68lxJrc2s&_nc_zt=3&_nc_ht=scontent-am
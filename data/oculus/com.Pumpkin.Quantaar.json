ri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uloNO2-_GEQ7kNvwG4xhSr&_nc_oc=AdoDS-hp22Mf84AeJZkccUSjVRzVGmRg-RehE3_P57TUoqsjD71D710WBfeOewaGAnE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af05p61WISTajact56NyAfpuj-6voNLffuh--brDv54F2A&oe=69F34567"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxMqVR9_33MQ7kNvwGTFpwX&_nc_oc=AdrZe4oWAz1hGzs6EF8eIMccQCDVjAi1aIfo3kSPAsENBC8lbLPLPSbFEDFViqNl1WM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0_ve_UvSqnc3aJTmNaceDgYagze6f3Ydxhfad_dAGodA&oe=69F341B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4grnX_iatQQ7kNvwFi62Oa&_nc_oc=AdrgBCKZaqJMdnAKBbjLjTnLfjiUpO6cbsjUnaCJDoMT_Y33XIoUT42CbbfXm1MxhPQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0egrHZexUNUQzittS4l4EqG2g1pYMSoLo6fKXRzrcXQw&oe=69F34669"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7CHnLAnjI4Q7kNvwEZa20T&_nc_oc=AdqP-eHnV8rV1Pum3cyIEpXwp-E8nhf79e7vrlA-XOR_nj31vVfIGALLKCLn16z5rHk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af30zOcpXyptoy6-Enk_E9fzXyLgYYCQMc7iN3CILjsDmA&oe=69F345DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDLTi0EdKQMQ7kNvwEV86sf&_nc_oc=AdrT4PTzjH4hv6fUjEUEV7x7Df3BUdtC6ZAiwuCYLYo5DsrKzkknWfM3UucgbrsRbX0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0u8gibCMw0i2WEqrasHNQzzslMV0RIZh-3TnZ4MO83LQ&oe=69F36970"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fn7p2NqclgQ7kNvwELFUwM&_nc_oc=AdohRxmwxqiUmZbDQgN3cHF8CgZ03HYc1JHh7FTvnWopgmYDEY33ED-cZdIa7X6pc_o&_nc_zt=3&_nc_ht=scontent-df
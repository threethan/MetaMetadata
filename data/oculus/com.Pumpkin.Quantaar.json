ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkqKireLU8AQ7kNvwE5bYvH&_nc_oc=AdprSneSzkUsNpDE45vFdbZA2-JjE8rofangXIr6IayEiz1HVT0rYQhCVqPucPIsKI0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwrhWenB0spmGW7klysLS-NB8nWTx3fdPJSrCXSOmY0Q&oe=6A6C8F67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R85h_NCAbEoQ7kNvwFjWSIT&_nc_oc=AdoOjkqLTqxm5xylQ1yQF0b6pKBeLUnqhrSYkpr0gU0T2gouZzVami0-CttOndeCLFc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASCiZReEchWfO0ZIqyVzt-8H2SKZFvMEIo836EVdDALg&oe=6A6C8BB2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=382cEhIiNT0Q7kNvwGRsxKg&_nc_oc=AdoGmAeivPPvEB0ndPl37z1O34lnb_2CC_CQpkhO9PVAmlosCAAMfyH5psCRMk0OYY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0Ya0YOrgkOsztt0Wtxam2Slfi4vTifc_e2euAcIBafA&oe=6A6C9069"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ie34Xuf-QoEQ7kNvwFfhPPU&_nc_oc=Ado5AjSoJit4xAbjJO72opA1roYTvpJ-Zveryhl4BAuc-2nmNYyTwyJJibpixvbJc94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_pTEE1_j8DszHTth902gG8Unh5QgDdi7cjHWD9ks2mQ&oe=6A6C8FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wI4SAM8Mmd4Q7kNvwGK_Efi&_nc_oc=Adq_d8j5DrS4WoPsxHVJjptvqL3imAcIwqbXa_26PkjxHa6FQjXiZJgChBxT7Lh8aPY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU2CBoBpewc_5z4ZsiR5LgUWI8KNM-GRBmZIVAf6RCnA&oe=6A6CB370"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZaXXF8riG0Q7kNvwFRRtHw&_nc_oc=Adp4XzcWFGm0EFNbQLfkxVm5YI-D-nFMYvcoIKyKyYORW4twmafbQqzbtoNa-vvbxRQ&_nc_zt=3&_nc_ht=scontent-sj
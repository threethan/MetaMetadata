ri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0fg-AHgRdQQ7kNvwE6bgq2&_nc_oc=AdoCEt8UYRjKiaQC_T6mQBCcFu0NYjBGvWdGZUgilLckNpNGfL-taxe6CsNQRvTUAaA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CkCfJHx-tkaYQe8QnRRwGkBXC-_RspjTTrGhAUKDMig&oe=6A16DDE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCSuAlfoV7AQ7kNvwGbd5w6&_nc_oc=AdqQZVHc8YCkae33uMYpEvhPfOXy9zG51jYrYXnghBdMcqJktIO5Gl9psfyUMhpi2Tc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LvvnNECnyMww0aiXD0AQLqF4FexJGaOolgMjXPXssPg&oe=6A171272"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJlGQWP98uAQ7kNvwHGaPJw&_nc_oc=Adp3xPxmbGsMngOjqBwYZVUNx6Piwu5BM_RU0nH_PsSXoRVudBY93x0kkq4VExc1dZc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MUvxp085c3EQQP4RlcGWa6nF9nRrGT2ufLe2mRfFuZg&oe=6A16DEE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfb4F9Jv5RAQ7kNvwEst_eb&_nc_oc=AdoU2_l0GBCSp2_Y6f_zHCd23yIomam7VAgZeLY9EmH_mkSgrpaoNmGCXfVz8KaaSKU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PGjYVHiyF1d2fdjNpxd7zJWYVCGo4eLXNrI_LSgpbBA&oe=6A16DE5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kuezavET95gQ7kNvwHUS60X&_nc_oc=AdqMc9FRaIUNUIv8MSdCUlP2OD8vXEi5vj478HzKQNUi41M6zVV9hYErfHSY4tJdaqE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qEWPCWDKBSJBk8XdMmNIyU5iyuNynV8DlvcIp5ZLWGw&oe=6A1701F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tbVXY-vdQgQ7kNvwFdZIzi&_nc_oc=AdpTWWRjHcUWKAKwT0h03P2NUB6qJD0a9STQvv6XSJ19ts4TNDtMR7dIE3SZm6WXkA0&_nc_zt=3&_nc_ht=scontent-at
ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQQHdQbfWAEQ7kNvwE2dnVc&_nc_oc=AdqUSb0nZP7h5O5Br_yM6eu7_oEzw0PT7q-Ivg8cHVx1MrZzEoqTxsyNcrB_yk-ASrc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjrShQ4iczV5uD77Dr4PMklCvQTIe8ZfJw7GiOe9H60A&oe=6A79BE67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=33CUO4ZoHpMQ7kNvwFqPr9_&_nc_oc=AdpHlP0aTyCh4y4Qd-YR66Uo6UTib7gmwc2OPT_fn2O0gTYvgQ3Z5jtJPlhljvU8m2E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbu_1pJtP6_ge7tAqCj8pPaayiwCtDPOryMxt-D_F4JQ&oe=6A79BAB2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln3hpJEfjGkQ7kNvwEUMQq2&_nc_oc=AdqY0vcMKkfmRlzqcRf6cHXItIZ4BWbvYmyITjjdk5sr2pEjjkrieSQ0xAk6lM2WaDE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyfQsV6bGAuTYQXYBbynYraXtvcEIVvBb_RjDVKXeQuA&oe=6A79BF69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpZu42aW0pEQ7kNvwGPkZt7&_nc_oc=Adr7RHPo_7dXl301FDy4D-Pg0MIv-wxxwRr9E8Z34KU8RvNlxC8uVy3qEtB8U58E35I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaW7TECubYkfMkHvO_WNr1NA-PibtAMhQ1PDwJqiXNyA&oe=6A79BEDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXR0BJGjGJMQ7kNvwEMng56&_nc_oc=AdrXa1_G27m9xdJp1-trO7JoaxNYEWglnGyYJcAE96ZFZASqpAQPtbV2e5zX6jaopUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJRSsR1z7rkR2k09rAVcjMS7cFsNgDMRvidj9KKNgtgQ&oe=6A79E270"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5pnPZCsw3EQ7kNvwFkonbk&_nc_oc=Adr2YStUOzGKDefe38iijo6vMA92QYcTyxO7sFQSBsY_AHY2gGPGWveyOpMM6OukZ0o&_nc_zt=3&_nc_ht=scontent-ia
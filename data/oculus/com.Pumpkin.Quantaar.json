ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vabibBEpemQQ7kNvwHxFOsz&_nc_oc=Adr_x6ptAkhttH_bgiAtr9DUo33OHFeWJtqvJw7bu2Cnx40YBf-ZmCL79_97EqnctZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1Ww-zBAe0P3fXYrK1qAiUi7qQJ4nc3SnzBmen6B1LJw&oe=6AF1EF27"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmyaiCmqdVUQ7kNvwG62kLW&_nc_oc=AdrdW1UKCG_vgxrBcvlX7xCyLVbwWDKMIASvJSkZk-iq_ynE7fuDSZenDWZM9-j0ICA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtCjwKceQtg5kAZr3DXWnM0_j_7QeRFPKiQ7fOtQ1jsA&oe=6AF1EB72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmDo4bTsTjMQ7kNvwH8Wnuk&_nc_oc=Adr35L_Mm7OqrH-tPBy-Tx9TwgTph0XiIzOHN_OX7TMmZgwTXg-NOlwNIuIyKjjKRO8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkI8XQ8LJGYsMhZrHHsSYIFP8FPkJA12dBWepAtcyFCw&oe=6AF1F029"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mcHYHbTedAQ7kNvwH9EFV_&_nc_oc=AdrzsLN1hyuAvjIIhTdo0U4w2YikrCIrYhB13eIHDME0chW4hbuC2th8bcpv4ScJ1yw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVWgjtP-0bdtUtQzJPXFrzSP27-Zj1z6JAdLe7BuwR1w&oe=6AF1EF9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo77fcoJl5sQ7kNvwEIrhlA&_nc_oc=Adp-UtEKXSHoCR3n0aR92WZB0JERo_IpXVZYvGUWeI6EuPxNdDl6v2wOA4uaIt1IapY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSehmFtbgYHs84YgBV6gTWx1dKfISe1x5gfdBjJ3DFdcA&oe=6AF1DAF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQFpiH-9bT8Q7kNvwGvtVn7&_nc_oc=Adoh4rj5_S37apoVEMsc8psO8bqyAlDiXcJe8ias3nZkLOUAGljx-UO1I30n7_05Z18&_nc_zt=3&_nc_ht=scontent-ia
ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJLgeKNXMRMQ7kNvwGdOroq&_nc_oc=Ado9F3LkWawC26pX_EweKxL5GUrK9L-QBkPRmcLDrTCe8ifj4AsDPD8y6lSnmyOH7Xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_eTKiv3ApXpbudd7Cu1BeFCRvoGCBQDsNe4RbGnJM8A&oe=6A147327"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCSuAlfoV7AQ7kNvwG54IUG&_nc_oc=Ado7yFVINCHa_GdqHgt2vIQXagxCmy6Z2UmD51YClfnpE0b7Dt3eS6romv5WpPvQyu4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7usYvKBYo69BC4pg6Nj8c9fnx-8SVggaoXp1UV0pIWFQ&oe=6A146F72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZa0mbeE6rgQ7kNvwHsH1MD&_nc_oc=AdpXAQdIEpSPbnf8xhiyAkizkjvNo8xBbToTQqW7cgS6WgeT4vb5hRopmrWOMNFdCA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PQnlbqleI8iSCmcWxUupzyvJUAq-gpfy-2otsXEokxQ&oe=6A147429"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ME1Z0kDZUI4Q7kNvwH3jlfC&_nc_oc=AdpiQ-kkTy2Ki_NmxJnmYiiwFQBJ-pVpI_3TEa34XU42hoAEvR7aKYH5yMjcDe34Vg8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_DFBqU9EQY_OB6L-3fWlElgGoQQ1JURZlvQzCMRir1w&oe=6A14739B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glmoCjwHEGMQ7kNvwGlVpS9&_nc_oc=AdoYJj2BfZWbl3iFfz99Nsgidx1i8054IeETGKjHNtYUp-eFRSfjIksH63dv-9sH7-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62iVRyzjSE6Szj_EBy896Fhyz7R2qww5MFw3LLftWu-g&oe=6A145EF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOnIjoCLGIsQ7kNvwF1D5Hr&_nc_oc=AdpxELx5_gMin9aeHm1sT-RBY3I01R7P2Fzd6RpxvoI0vnZV0JzdgcbCYE8Zu94SCCk&_nc_zt=3&_nc_ht=scontent-or
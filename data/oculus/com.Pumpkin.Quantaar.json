ri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4bXkZhjgH4Q7kNvwGPH6Y_&_nc_oc=AdrVP0VVq_Q-z4z96owqjGNoqNIRQgw5znOfDp9OePm6egHzyua0NfmVLZfbqZwKV-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23Alznyr-J14dZ0mahcCJfHnD-Q5eFB9EFLRSMpRoNMA&oe=69E0D067"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_RSPqJzv-0Q7kNvwFIzBl9&_nc_oc=AdrYz3kjR_GBLoTtmaggNgU1RG8XVieXud5HD7wvBB9u8W5OOPScMFsItPlqYVKIDRI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BinL8Q4DoH9UMLe15usHkC_YlIHR7inkAfHCFULWf3A&oe=69E0CCB2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMF8YkVnjswQ7kNvwGx7pKB&_nc_oc=AdpTuWFhWnTt8lJyhGeB2-UE75KaDV1mjSA6FVJYxPiRBRPVMO7eR4ajsIGPwH6BoPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JKQWKUC1dQId7cQv7w_RPzjI4zYRWvsC6cHPBV8MXYg&oe=69E0D169"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jy0UzhlH3-4Q7kNvwGiL9XO&_nc_oc=AdpOWSYaAxf7wLeTRX6NCfymR8exfZwLZmOf5MWnLqp_vfvGWorTu4hMvo1xRvK4WLQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cdj8evmcWdgIa0t3m29khWjETniRuDiFsSlrAkZwOKQ&oe=69E0D0DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdx8WFCNX9UQ7kNvwFphS6B&_nc_oc=Adq4EpPBki6O2Bdgk7dTmJOwhclUiDI37269AJlZWNepdoK1rSZ1OI9cR-cABzJFDq0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ezGPP32fSMx6t8xYLXOBPPI8FuiCAbWGh6QpyGtiJUA&oe=69E0F470"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RbjSfv-rksQ7kNvwH_239A&_nc_oc=AdqpNMjORpxQlHFUskqjj_AS36qlP0fCjfx-JdYs85X-WpyOkfI19Fv6J_rS1qLBjaQ&_nc_zt=3&_nc_ht=scontent-am
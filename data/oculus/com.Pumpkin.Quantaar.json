.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFzeSzOaqewQ7kNvwE-IM-1&_nc_oc=AdneGL4kwmwtm1CGPRienbCcgF65YV_pit-63ubLTHQzjymkTA7E9kOqOJYYWX8ORoQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv9IoAbTjcnNirCxM_SFUoHTFyz_e9xt_tK1eeNahk9TA&oe=69984DE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nkvTo8rf7wQ7kNvwFd75kZ&_nc_oc=Adkc-qJSu7JmRZc0958RNt3M43KPnqssAiRu_xXl-vapod7fnuTTp9UIuSUF0yEvhA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuAXtYaEsxY-J9EXn2FB-Whhwkh-tEL3KOfjvYQanx2CA&oe=69984A32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGS-27E9ekgQ7kNvwF1mLq6&_nc_oc=AdmFHU6dtiCZ5RCfmMdwG3xSxPCFn2P68O5CfglmmlEb0XTaHhqFmg7zOrcTIaFYTuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsCviY6J3KiUsXYTdJ4wcynpR3OojcIk3XsqqmmP79JEQ&oe=69984EE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvYIRJtTueUQ7kNvwFNwEFc&_nc_oc=AdlC3SynmuQ4nKfU34IJDlzAPA4kMl_am9qsTTnmOZTNiaLiXdl8Drvtnn9wzUNIunY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuO9GpYA7T_guUXlOb1AZW0AuyIr9-3bHElmrPe_hktzA&oe=69984E5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42aQa5TCIJcQ7kNvwE2aQpX&_nc_oc=AdlhrVtuD3430hyci5-PmAVjm6nmJfgKCuGbAFWUT-Vb8yezhysOyOZ5KUYpw9uA_b8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvgYDzDUIWEJLPCNoxK2zz-ZMsja8PD654pHaFo5ooXgQ&oe=699871F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLfuH8H7emEQ7kNvwEdbzIU&_nc_oc=AdlfNl1zjcMZ0_MBS3d1tjT22ynAw387z_m_fB5GpyvUXCeOzoNb6HopxWdg7vzddYM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuwOsM2rK2kj1uAaHb-qExWtfenfCGyy5IacrM3ObCOkw&oe=69984504"}, {"file_name": "Frame 84.png", "id": "1747234655674817", "image_type": "APP_IMG_COV
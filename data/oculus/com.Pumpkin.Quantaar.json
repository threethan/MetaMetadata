ri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avg52F08ex0Q7kNvwFaFuSk&_nc_oc=Ado8Nk7J4bJHNjZXmt7Wyafl5UEt1vSooxDqraJwsQbHIHOiIGvlFNDtGi1nkUI5Q44&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZusnEdcIEtcSYHG5Px-iR0_aZSLtRDekRzl2kBo18Wg&oe=6A0C8A27"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CP-9wOUKgYQ7kNvwE5UeBA&_nc_oc=AdrfsLKDL65sCoKYKDvx5FHfZkFszT9COPrtfS36IVPHFJjD9XIqSkL-dTUqt_8TcqM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mS356oYVwNZKmTyfpsNb0xkusbyLYrdjy-js-uMWqKA&oe=6A0C8672"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TZSMMh8rxcQ7kNvwHqiIj-&_nc_oc=AdrvyYC3Yy0zLkoaMZ8dtiWuWtCFQj_fkFx1cWnjsaWCG_6Vjp1IS8jv3-5GBO_xSW8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53wbmsDwnpHme0rIIfHZra92Ngve4RKcPXWe0RxqCE9A&oe=6A0C8B29"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pHeHQu-0nBkQ7kNvwGxAv69&_nc_oc=Adqa-huIZ39uedchWqIcd5xGnA_zp9dHJlJGqtkmhGgwJ1Su_sSP6bUIxhj_8gTvIrk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cY39q3oFV3qs3eB0G0-6tZtcvwbC1P8Y7b_xcXM0vDQ&oe=6A0C8A9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjkSV7p0G1sQ7kNvwEH6lve&_nc_oc=AdqqpT419Wtq4thDXH5aMSfGPppqA4yS6Ggx9mx6sAVZ2TKG_H7ab1KY7p0mvLl87tE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hP5HN93YczeEFFuh1RbuvWHjBr1nFlnQ4l3nYc4NaGw&oe=6A0C75F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ttqi5RuF4cQ7kNvwFOK7v4&_nc_oc=Adpul962rVaSDXhq1O_moq7IGkXf57mOxNbOku1UIQUCYcsO9-1yL_k8QqY-KVwq6X4&_nc_zt=3&_nc_ht=scontent-lg
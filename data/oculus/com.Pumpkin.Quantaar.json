ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cDTd9xPLzkQ7kNvwHS906l&_nc_oc=AdoZgyMgKGEaX0rvXOTOS-eiOk05Tn4daqlh0lUnCJtMw7BuJGQfeaonaM43GokH2ag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB73MfYydEfw0zFgBCFydmOtFgIsShkPflZvcdR8K5vJQ&oe=6A4F8E67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dsa5dzZs7qYQ7kNvwF2VdI2&_nc_oc=AdombL_8fChEjOoFrMK4meMlGs93eq8c6_smkLbLTjVM6yUrmLAIFa_iuYECoALi0K8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBprlrOBpVgIa40ok9jhm_jiokWRF1TVZFUat5fqPkDCQ&oe=6A4FC2F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9y04KSS9qjoQ7kNvwGTS8Q3&_nc_oc=Ado-PhnfmnmS16bia-aRi52zBOfJsx7QG1WiHhU0d4CYohSfgc01LPyHZ1WQRHCh9Tw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx14CpezAsucnzwq566asYNFdy56D2JDdF-P8FjHcv0A&oe=6A4F8F69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dlae79cuMckQ7kNvwHTD3rK&_nc_oc=AdoRow_HwWEwv79a0G1uKCISZyWSE6qxEywwNq-KAe6B3jiVcn-LVCS0ZZ_QQ85iIEA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuaDzktQxIk_oquHvUO29mVjQXOhg9bWmqGnYDAbP8Fw&oe=6A4F8EDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4oY1tk_6pPAQ7kNvwGlmWpF&_nc_oc=AdqXuxnmSrCVYXvIXgaHomPYyK9kbwAWuuYXHn8D9eIRUMVzuEciXKIkYA9iKoJkfos&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCbWNRarLg6X_u5WlKiKVi7F9NOCBd7C6YfCd7C5wuanA&oe=6A4FB270"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLcG59LFrnIQ7kNvwHoXW7S&_nc_oc=AdpgxF_gZiSKDWdBzGXKLOgBe-F2i3RE_EECwV53Ppe4-ckn8lN-X4EbeNF3ioTOl9k&_nc_zt=3&_nc_ht=scontent-ia
uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6uaHSyebMcQ7kNvwEayRed&_nc_oc=AdkPDHZXBsmsrl9_osrM42g6hX5CWnvr50NcMO_eqiWPtk2NbtKh_caKTBmqCEfe6nE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftm67pNYYW8J2HGNWta8j_LSWsnGsousXAToKH9j3C2ZA&oe=69A81FE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PllRJku1i5gQ7kNvwEfYssw&_nc_oc=Adm7lhl7jSta3DrYgkP-kGjkvyTmoxfhyzU35CKHfhqymQGaiaekMQQjCGvGzrzcnus&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsSLNtDsojllgj1MciQ4QntP5OITGIuiPLZpkRK0M1lag&oe=69A81C32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4d9thtA3V0Q7kNvwENB9S8&_nc_oc=Adl9N-P1UL6Lr6B8biszVLbhiDIgYhT9FxfaNbtG2umZewk3j5KTx0cXZ4-bMmBDEeQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsLrW9AhTFmoujw6BvitUdD4uQB-HFGfjnVDsWZeZEtiA&oe=69A820E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plHOMwcPJJ0Q7kNvwGJ1MBc&_nc_oc=AdmHJD9sbo1CZvzhyTSQjovrVqoiDOYqnNoQrkw7n8tk-78LjaKt0MEFSGPynsVcoVg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuIJWQRvh7-xLk8vvEb8ANtKpM4Xf4jpCQoVnlbBsF4ZQ&oe=69A8205B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paKzpJsI_50Q7kNvwGFSFgs&_nc_oc=AdlXktQJbro3bTyj_tlyf4d7YBrgiWuf1hAok9Gp0l6MXwEmoFGevalefGGbGIdt9lk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftVGiMyN7PxsTEwZUbquMXBohkbazARR9f_DUe8X_68cg&oe=69A80BB0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5N6_yhp-9UQ7kNvwGKzhn2&_nc_oc=AdkjYa-O9YFfQLA-CdXSJs4j29Os3IJu_rK-Owc35efKQOxWZV34sdgzDyyQR8Eb62k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvipwE_IxmgMxXenW
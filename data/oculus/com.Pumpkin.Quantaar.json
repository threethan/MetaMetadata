ri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KW-m8HNFEqYQ7kNvwE_W6ue&_nc_oc=Ado6q7l11LD0-ClHIOYfD-xzO_NVcFZ1IovHseEWN7T0FvDet_ttnC3IccJ_Uy40GcE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxt-TsgM-gWBJGLqOAihAtk-ZrhNRgOP8G9upFj4j5wtA&oe=69C520E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZD8mzLUEWCMQ7kNvwEMVwpx&_nc_oc=AdrBEiJcRH3f6YTo73ye0oiFyKTpDLF_eK0yGm_2J2yEp1i8BDsEcXRdl54hVepbJro&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnuWj9zPxxUVxuTjnkT3jwo1Bjew1paROTnOeglS3ewA&oe=69C51D32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=waZq2BuG1bwQ7kNvwFs4h6I&_nc_oc=AdrJJ_6r01vEXXDx46f3DJ4AeWvigr559WBhSTCU3D6C7r_QROjTJ6sEPcW8J37ek5Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGkeUZ_DO5XhSYhyPTQrNv8XKN7Q1kFjNjcdCsFtEHMA&oe=69C521E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BvBQGfbUMcQ7kNvwGRXHcC&_nc_oc=AdpPo2KR0csuhKqGZy09_N1zvayi_bc5YBseeXNHArwf_e-uU1nisJIfosA1p53Kyi4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqDkeQooLwgfqmDQiQ88VkQulcUbWkpFftthGGj8Y5nA&oe=69C5215B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2YRonosxjAQ7kNvwE52WrE&_nc_oc=Adp_8WSkw19HOJ8BM5laxgbAh9ofA1R16QVUXfRp4yuV_tFL_MtRAO6YiwQZwAy04Pg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4jbcLGZ3g3fPoKb4j096Rxt10XU2GaCu6CNQgwallhA&oe=69C544F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7BlhoPozkoQ7kNvwHiOQ-U&_nc_oc=AdrwkvrV5bF74-xNcgnovY9DpOYUKOLgg7G9rbZN39kGQfAZdWt8tqeMbjX6O2PZfaE&_nc_zt=3&_nc_ht=scontent-df
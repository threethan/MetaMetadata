uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVT-00n5U9cQ7kNvwHKnLXn&_nc_oc=Adk2lxOZRBvnufMnJxDAxqN70rlo8cUwpnvzUDsdYE95ELm3AF8Guq6WXt_csB9vEZY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_7vKGykT6ixHtt53F7FY0pOVJXLLsU0O8zz9u0YNqBg&oe=69B7F1E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0N-bbKzwBgQ7kNvwHKfjUy&_nc_oc=AdnjeT7zan4V55EbMdCk1v856vNnnUOZnATmNwLnkwMeVDgHtuanuc6GoXcAop7xIWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzCAx74UXwShhSroRdKtHWZ8fPTwxXvVsyJiPGFd9EtIA&oe=69B7EE32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZAh3ySAsjC8Q7kNvwG1iRWN&_nc_oc=AdnRqcMPVZq0Eq8IKzWh_KLmstmArqlewsB6N2xeD85DqBYoPapIihnuDqsUb1OkPUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqpAS_DIZlmq8jmYV3Z6cLMEUEHG_yAe37zJC1yzgfbA&oe=69B7F2E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgM3mxGZ_VoQ7kNvwE2B0dg&_nc_oc=AdmKIZKNRx1XOs65pvlqAk9cE_n8_r6ZlhiY-RjQ9O5fPtbTFWqSjafQf7ZpLuszn1k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzcqquFZ53NaqMnQAdn5j_KgbuM_amv9RuNJp7-CIEKFg&oe=69B7F25B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRQVosUbAl8Q7kNvwGKRbMP&_nc_oc=Adk6w2sMZ308q4wsaIwAdYMljgNLZDUgkzPAxhvVJmUPYRq9c7p0VXmpu0VaAVVw7g0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxXFMmsPTx-DkOIrBvzGzExlftKS2Q2dJgP9xKfw0J9kQ&oe=69B815F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peurtHqXRDoQ7kNvwHS987J&_nc_oc=Adn_83xPNO-jiz_7P77xd5T5wnBfifYjHcSuVRVrMv8oQSx0Ql3Sujpvz29vo81JiXg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz60QUt02xr4EFXqk
ri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJLgeKNXMRMQ7kNvwGvRkUa&_nc_oc=AdqBXPy3_FL_w_6KVRgzN4mVKUB8t_2pkICYgzWHkspIBJ3BVfMzW_ariBZQ4188Fag&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DANlrK-qPuaewMjLy3cLBrhgEyTkLACEYoqnRIK47CQ&oe=6A12E967"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DSW0k134nnUQ7kNvwHdfauq&_nc_oc=AdolkEXPeoNrulMRpYPKfCFD0fVUPL5dxyavgtsdy7THfCRFDrIqvzopR_bBv7CdV7Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uHy0qUtU-LmKLfZs_ZZczmo2nXMKOTcf8PfTJBr4yYQ&oe=6A131DF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZa0mbeE6rgQ7kNvwGJGF1n&_nc_oc=Adrls0U7pRz5kC7pjLNzgjBNUHNFgvyzz4goTEq4Lr2QIZVpKzoLpvd8rt76hzuqgxo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_A4I9mxHC2EsTDPfgr98bxjqiftpH5zqreHgG0z4j3w&oe=6A12EA69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ME1Z0kDZUI4Q7kNvwFe0M24&_nc_oc=AdoD_-BMVdbxS3Td52QKIbrjn0UHBw154uqkChyECnFEzxSO47uiEAMyiPhpXlsO-po&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70vuIMclqjYsx1fLtrSr97mYy2WZQncE3kT8s8pwKY2w&oe=6A12E9DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glmoCjwHEGMQ7kNvwEmRlZi&_nc_oc=AdobmMrMHkFXGFwNYb-2Lfc2Uv0lx3ZFJPfGn3Q6HHTfvKr9YIgRIf2xixiOayxTyDY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xQrWpFwCs5aug2JuIcmlvXgljblVIP8qd_xdbUlEymg&oe=6A130D70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOnIjoCLGIsQ7kNvwGtDnBy&_nc_oc=AdqzxNiZyu_wAj0LnJEewEFTHjd2-1qyUZamSxFP-SWdrx2aSUc9uOtfsBtgpPV5nKc&_nc_zt=3&_nc_ht=scontent-lg
ri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnfoAx3aeN0Q7kNvwFVg623&_nc_oc=Adqz5VfuhOAC2UQ1n7ml4VQkzgk4JucJnV7vJgHWFvLEK36Ta39zlwlogMgYbzLsQsY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HdWC1WLZO9egtQdXKiV_7iDknNywZYH7wypCJmYH_oA&oe=69DA38E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEDyhw-U9EoQ7kNvwH4qNnN&_nc_oc=AdqYiJvEeWuoVjDYHBEBJbX_5X2HQElZ7RiP4BN4TpJnKeNNfQumR044fqTmbgZ9oDo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lnp3PXPD-08lxSXfbUExSJEbCUOG6EZ1tdcDqPTVuhQ&oe=69DA3532"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4OMwUnyImkQ7kNvwEIjbke&_nc_oc=AdoRQa56zwz2EZKi0dGQG85oDN1EzmGx-CXZYHIOyTasMfIcF3kL5jYOvJxHw4MQ9ek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dHV21iy6jSC0rrF_--dW4x5bkE2t2uKXuyKTFtZc2aw&oe=69DA39E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qamnDHRtYQsQ7kNvwGN_rPE&_nc_oc=AdrvLcZl5xTZH-o5XnmBpf9_8UfjNp-YYjk-ezBXZQwz6iozkdapB6IHhIo6mjWCcj4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QPwXvZ7Ti19ndqO7auOXCPlAIC9zKbyeuvdC8yEd7SA&oe=69DA395B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=va6sX83I7-MQ7kNvwHukNtV&_nc_oc=Adrl9Mof8VmVws4itDED9X64LhIHAAHtJA0d5iik_hAOBPJto1aIid0rgS84iUkuDEk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hh5xE17HD31Eat6aKWnfEg8PNoM4CMNdQMKRcAVWUQA&oe=69DA5CF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evmVFtFlYlwQ7kNvwGcbZgk&_nc_oc=Adp27KdVQCH1VOto_boefhH5VEDrJitun-PLkbRUQYB1lY3PS-Tt1ge_tp68H5l8Vf8&_nc_zt=3&_nc_ht=scontent-am
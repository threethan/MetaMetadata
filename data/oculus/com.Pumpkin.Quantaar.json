ri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwYbHM9-VnsQ7kNvwEt3u9a&_nc_oc=Adr6abjrixr_v47Dn3SF-19KPdxLuWCvk5uZuu2ilN1XUoqlC2Ryl9FEIq7MmpjwGXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH06mk9cZwL_1JildUJjkalgoENKXfXqfAlYQZoN150gA&oe=6A7326E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tSBX6Lpt7cQ7kNvwEt0--i&_nc_oc=AdoyzTM2SbtdzO3YZRfeceBpyS331q3Qas6_Ne0CMM9PgEuRioF71V-9qhxNEwVnV5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA3p1iIOCwHPe8le4Bf6cxrAn9YkQFn1060vPPD7E56w&oe=6A732332"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfIrl09zAhcQ7kNvwHtZRV8&_nc_oc=AdoY1pRxsOkZKVReM283QxDq2fKC6BWv9vuaO0qAig08ViWpWbqcI_-7MsliTeHG4JY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0uzODW3NuPMlca4-UtA0gtD5s6LapkSeFTFZHH8Blww&oe=6A7327E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEDWVVEXpo0Q7kNvwHrfpJM&_nc_oc=Adoutd-ENHpRItCX7on3ooX4Dh7ypsPeAyMVmPxMtxTbkIQU3e6jp5LFQKG9AZxXzLI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSVh4aI0OWmbiMjqbSVU7L5lY50mc4RrIk3GJjsuYl4g&oe=6A73275B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bA5XPKg37kEQ7kNvwEbrHdd&_nc_oc=AdrfakF88TUjbeUA-XQIFLlCvB_I_Hl74jqJ-_IV0rqngm7LcDQufOstq0QFmMKEjlA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPcRNXxZhTjp0apLa1JDPXxjmHHlz8N4m25S3v30DiaQ&oe=6A734AF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0rf3hBDpHMQ7kNvwE6AK63&_nc_oc=Adryj_2nIaj2XHc-GQut0wfY4Ciix5FZxQ-BJZmUXnpUcaoeXz8yZigc2MDLYyfKAA8&_nc_zt=3&_nc_ht=scontent-or
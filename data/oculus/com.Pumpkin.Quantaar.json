uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9q-m5ixZE0Q7kNvwGzBxn4&_nc_oc=AdlcDXaP74us9pbe6X1RApHpH0PiBkYVsIBbQ9E2Jrt3rJEtTh-UTFQ8ccKoH1IhOfg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTbE6aTjpqLpiedj9wjtpsWOoySFBtjmbBmWgfzUOs4A&oe=69BD37E7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cet_mmpjHoQ7kNvwECmS7B&_nc_oc=Adnk3_gHN5Cmcbuq2DXyFE6NN2Rjd_R6AnhznRwkebUCEILXhc4eX5lZB9a-6fw1MYQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxh1LejybZ11rOQNIh31GeGwN2mAApBIIYih3LOFeHJYA&oe=69BD3432"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pD-UTVxee0Q7kNvwHoxhd2&_nc_oc=AdnC0qbcRf5FLDwGxirSU3tAbvDrjLJsbbAGmEaSMrox6BqA2yLSg6sxnIGAZb6mh6Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9B1yDGguz2eYvSKkSPoUbN8Osl9oir2y6YunXHty5QA&oe=69BD38E9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVDpjUa9ONMQ7kNvwEJyP0y&_nc_oc=Adkvz8KJvZb8LaVLwAma__fzqe44Gan3MwVIvsw6siOI-Q7Gmrf7_hlCUCCh7CKlRUw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNo4knHMFeBaW1faNPaBMuZHFUGsDLKhVISG1voPGkPw&oe=69BD385B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIKsBlAIEXsQ7kNvwFTmUlG&_nc_oc=AdkFKqOAWm2zGH5eSAbX877YoZ22Uwp4FI156AonliH51Yhz6ZmC9SFb3Fy-uVV68Z0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyPSG8xa-giTSw9GTXFETayJWyZ3dCt2WY43fIIiTeVdg&oe=69BD5BF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zHV7HutWmQQ7kNvwE0MipH&_nc_oc=AdkYG3_vuQCZ1FYVjOVFQLaCUmzHXhlHotAzvCk7_AWUogWgb5hm3bzKEUe03NaqGkY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJOA1TNMBClyeJwt
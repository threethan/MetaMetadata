ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGE4fcYBcfMQ7kNvwH3ZcdC&_nc_oc=AdoT7_OG051fSTEEBBeVQROcey9LLSL5wAgVIrADtdRAGkso8KB-Sr_d6OP7Cql5bjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KcXbFT-0jQwHLPeTPU3oGKUu08A2J31DmnyWGd9z44A&oe=69ECADE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcpzoyaM2ZgQ7kNvwG_ZVvf&_nc_oc=AdpGa0nb28_ZwDe3wn6k1jGKvU2H2SMTJJdE88Hnr38q8MHIVnWeJi6DAzGH55zJwYM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sVSkX_fjuzfqlb28GlGtdst0RBF0cQ7mtXCUk37aAeA&oe=69ECAA32"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6yVbXepAysQ7kNvwHf9V-z&_nc_oc=AdoD2bEWJTj2SfTI1QRbI2VpACT5qPhnTJnqsAXVhOO2hMXrv29er97GRLvIbBQSlEY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zuUjah5vmGDqr4xtyo-K-rhuOiDnwsvUTSs2-2aKPtw&oe=69ECAEE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbf8sgqbGIYQ7kNvwFFOkjL&_nc_oc=AdptYCbtRFCBmT6PLPp11c3gSdx9jtiizlg5enqirvfGldjmYmSplwQy0K0ya3MPCbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h-pZM6OcHHuWJr14jMLNfn-SpZiWXR8BKpUQg_Y8jfw&oe=69ECAE5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQNKPdtVCucQ7kNvwHxgg4u&_nc_oc=Adpcclc0wuylwkRJW-D5ByLeSf8rrPIZpzzWwuc28hjpigpGvxRkR9iiQsYPFuXFmKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TGuMNcHC93Q-WgdmNbKmxgC7BN41bq8pQ1ubvWbo_jg&oe=69ECD1F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ng8atFCaKvoQ7kNvwGcJdaW&_nc_oc=AdrJEX2WTvVzCu5pYS2xDH5ZstZ9U4SEQwjgsF9-7EUbRBu_HfjEgX0FxJevY62JJqo&_nc_zt=3&_nc_ht=scontent-ia
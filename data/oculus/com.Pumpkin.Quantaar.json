ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Tq-SpXzOIUQ7kNvwE7nuZd&_nc_oc=AdpttMzi65otVeiwNF_as0OTbwp8PjVVwqCuetY3a8S3At6tnUYOzNOsUpfWPwhcHhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPty09tPErOSTYxOADc5u1SYZqOzAy1Fuuv8z2LWzSwTQ&oe=6ABFD627"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTJg9IVgJYMQ7kNvwFUhGjR&_nc_oc=AdpQ-u95zaapmMQ9zPFPFkosjgvhN0mIygTsCXLuJOz7KkBIJuWRaKdKqh3G6qUHBzY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy30Ud3mUDGBobjABtTKAa7DygJwCK45JGckfBUmy3bg&oe=6ABFD272"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWjkiEIAsVsQ7kNvwFdQOtS&_nc_oc=AdoIwDV3Pbs8l5-g0-k5UtkI7ksebrQ_pRPprmKsvMidJbzovsP2HR8Aaj4pRKwMQEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJfQ4yFVqI5gcnP6twmVS_RQY7O8gyb-6joH2dvCba9g&oe=6ABFD729"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC-a427SBgQQ7kNvwGSX4yP&_nc_oc=AdqmrQYGT9UKSKW93pmjUbzrJ_TfSXEvS3NeWYvvSltBGGr4IkEqnKPE1BMQFw_3ns4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzZNjUGvsCTGf38BtaQeWU90F333c0S_qwDu4mezOKsw&oe=6ABFD69B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7nT9eUFEGcQ7kNvwGciR8M&_nc_oc=Ado3LZqNK2ci4wRdDP8K7xBEzQKwKZIc4SJWf54dfwg96BexyfM1oeA7NT-rv8k2Kl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNz60kr_EkTn6WreYU8G8VdXUnNrDeOQXUY36eCmdC8dQ&oe=6ABFC1F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq3MWRkvNr4Q7kNvwHiagjl&_nc_oc=AdoejggaBFGgo0rhRnehHlJeni6-Z5SrQYK9zBaDEiB7C-MmSCiNDt8XwIawgY1tuGM&_nc_zt=3&_nc_ht=scontent-or
uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-9en4y1R2IQ7kNvwEoOsbn&_nc_oc=AdmARM5D-hsBEVjQWBVN-JQLVDgpeQJ8GhCYDIuqh76RR3mTMfmkcQtcZBbK9CUWsS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLFccU04RWmkqfzA9K1NfDQ21sI2r7Ug1a3dknJarqKQ&oe=69B3FD67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RP1WviJgungQ7kNvwGUTlNn&_nc_oc=Adn8MRmKCt3bt9xUDbWyMYGjV1yIE9n0OWfy371gZT0X497_3IzM9bJwaD2P_O7Qyzo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzmUvN3Rd2eR4LQmJ4NCBHuj4mcp7OlcAHxnCQ9h-aYbA&oe=69B3F9B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDBgOXnYRaQQ7kNvwFpCgjM&_nc_oc=AdmcjBR2GkkXV_E1LuRXa9h7WpTloC91RQLvUoDdiZTneNwyfy3nDQlCuck4Fh3jbCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYjXVVE1s1Mq3tnWas5bFc2Tv9DFvzjr0GKJxw0a6Ydg&oe=69B3FE69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6T7RR-sBwoQ7kNvwFQIL34&_nc_oc=AdmuqfV-YNOl7HQ3hZDnNNy8NKZl-XjnxiqtMK92ebzLxXxwe205OI2xh2_nMtiuSq8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwzClDGzGIbEg0sFSpyBQ7gdq6mvm-uwCtZCSqhnHXKNw&oe=69B3FDDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xk0rDN55OLYQ7kNvwFeblDI&_nc_oc=AdnbmkT2XrUnpodCeiUFIgL_81rk4UqCxfKRzFw_ma9npaf0sthkJU0jsE5y9u5VrZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyIyNr3HqcRcOKtx5xy9aYy68AIl70giryjMTt68bld-A&oe=69B42170"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ9udUsSGv8Q7kNvwEG4UTm&_nc_oc=AdkaHZFh6sDF2cWG6RcTyGi52BO21kDdaGqSKyoAXM-gi9I6t1UuxSd_cdIjud1KDjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzosfWdTTd5lcYsFV
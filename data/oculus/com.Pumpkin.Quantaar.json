ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04-O55U7CB4Q7kNvwHmt5qJ&_nc_oc=AdoNk-O6fpeUYYuspFQ4WXooEj_CWqZpspHXRxSkTOgz5LRE4cWcpnASkxMrkKp-jYM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg2Ib4gEsE_WN3LrkCf60xmJ71810lq30dTbT3DmaBPg&oe=6AF73527"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaWquCmemrgQ7kNvwF9Yjh4&_nc_oc=Adpoa9M3Tqi1TJOteRMQqbXqa5KIV5ghGZ94MvjZ7L_HqxlTybCzqqle2ewHwdxwKXc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyU4Gy28QbYsQS9WTQ9xnUf4FFWvUmATIqzkg54Zi4bA&oe=6AF73172"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGyxkEyKC6QQ7kNvwHJ1Ql7&_nc_oc=AdoXVyNDlU24W32T9V-Lw6CitJJ6n7zOAZzSRd0MPZVelcgfDTdX1BUnokDaoR6bog4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVHnWsGyT5eHkHCd34L3wl0jmyIUBiib5eDAXXNTmchw&oe=6AF73629"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD9C_GXG_n4Q7kNvwFPQihh&_nc_oc=Adq3tntaD3ugR06BV0XJk5rnG1pPA1nMT4I6abl6JrbaBQrbQSdTDjIMIZpmirxfZ3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoTp4fdRYzwfqVCydYrqygImDhlIG1Z6i2ROMGQTDu9g&oe=6AF7359B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i52nshZM5RkQ7kNvwEgV3rG&_nc_oc=Ado4rr8uQsandB3eIJfgXJxLiKjRCWMXCbgzm1VyYbwMMxG9jzi50kgvPvrK8mhYQ8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLVrh3fyqdGiofP6aWSw4em3nob5XWJBqI6kD3dubPog&oe=6AF720F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Jo8VXYA2zsQ7kNvwHla7Hk&_nc_oc=AdrmRXolyOEmEeCegoK6jEKptUIwhOacos6QWHHHGJGj3PspsCxaO0S7mliBhJFaPQw&_nc_zt=3&_nc_ht=scontent-or
uluscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edbpQl5TnDoQ7kNvwFdlBKn&_nc_oc=AdnYCNHyV85HCFZSeSRxs4M7AEtoRKCmvX9prG8-PMuTxZ3ILJxFyoamY1Wkyabjcpg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdJQ485vGY9bYrWyEo6YT4hLvK2vp1DMIrAmIFxWdZzw&oe=69BE8967"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cet_mmpjHoQ7kNvwEp13_c&_nc_oc=AdmWxyQPCsDkyiRMtHdYq3Zx1eBHMM43AjcC_5gV3Li6EbB-hKaN2nHQompq6Tcl0FM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhtuwQFFqAWDzyvZT4DsdyzzvOWtAG3-ZjcCch043VTg&oe=69BE85B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pD-UTVxee0Q7kNvwH3_gvZ&_nc_oc=AdnDcsysTcTLMUpSLQj5NfMVhwtTfQKitoIDw-oK7UPfCqk_syScrADLmNYaFcOteZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyucHdm_0bCJsfsaT1UZvzhU2Jr7x5IxRF0uxADTVe79w&oe=69BE8A69"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVDpjUa9ONMQ7kNvwGkP_9C&_nc_oc=AdmmvxGxvQ3PkVogQOIQ9wsa725S8GYLxCrqvBgCjp6HwYYWOj-hj6_lpbT_fPbDWQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1Gcw79f_ZK6x6rU0YC9O9P8LAAHJgvf7X8kiX-d8Ezw&oe=69BE89DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muZFbmc9O8EQ7kNvwGjylZV&_nc_oc=AdnYJRAlOVkot0FCAWjptHPn4uioQKh8-84jueHNCXN9YN3GqJu5cTtCsX2KhhR44iU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afww6eYrwcq8lL2qY90caEnNoyk5vIp7jGLdZjyenMp_eQ&oe=69BE7530"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zHV7HutWmQQ7kNvwE4_BMI&_nc_oc=Adnk9mdSGvUmTXLD3KF3yeJmZ__8TfQZhc0nNQlgiPip-IH5U-SlQItaExIxhsa7aqg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwk-ofzjt091OZBri
ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPdHiskpb-cQ7kNvwEBDtfT&_nc_oc=Adodfx_nDYqrzUtEHBssxRLElLNY6DtwA-oB5KqSd0aC33lFW02Bf2UL_ITnmrQDKFg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j-vKluU1mD9Ujbbwbgjunl_SSDfP6bwimdXqGWVa2XA&oe=6A3FF4A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LYMmY2kyW0Q7kNvwHKXyD9&_nc_oc=AdryUhJ_89i-FSxii4dcMgPlt0D1sAK7Rr9g0yyZ4M1C0bJczTu5hx93qOX7N2lB0DU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s6-zpl-MsakJjC78KwxnkAxSbLtkiLW4ChXuBZmdBIw&oe=6A3FF0F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDxjmh_nbowQ7kNvwEChatN&_nc_oc=Adohm8Bw5xUR68fmsqrzQ5JpXDe3nnHexKvHRH_5Z1YsWGLw556xeWqkpw4PTZV2RJU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VlY7a63K3NlMr-9w7LcnOTEucs_HNOuZchL2un8RBoA&oe=6A3FF5A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI2meXmM6eIQ7kNvwFVxwQk&_nc_oc=AdoCDSUjP3V24hpJt6p3uFFatI0MDg-1nRDojrvO6-FH8NGyU0-iH8JojNrUcGzphB8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pRiL_C9mtKDScexYGAZcLUddNV-PpeOBr4mrbYNudbQ&oe=6A3FF51B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J3wwpPRUpMQ7kNvwHuUHVG&_nc_oc=Adou6CGbFtb0ltaP5ytjrvOOkoYDaKWbjeHkOTH6lUJUVY2CKpvgkXhOJPJR1QFHO2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PYGxYW2oag68nqaUU69jLPjQ2ehC1QHpuq8g1A6aE3g&oe=6A3FE070"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD05dTPwteEQ7kNvwE6QO9X&_nc_oc=Ado8CjOMSeJH_dSnbqAoGOQxqBDG0-amhyVPWHyKp7KZFHtuyf8D_2QeHzwYfQLdmc4&_nc_zt=3&_nc_ht=scontent-or
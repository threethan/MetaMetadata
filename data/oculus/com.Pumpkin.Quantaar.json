9", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl5UdMwvgTUQ7kNvwF9S_bs&_nc_oc=Adq7t86v0TC6QJSdQ2TUhZdO4LGhrP_NRfO6Kuv7ZQEpivW3a7dm6Q9MG18IBS0pwps&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxmX_1rbNb3MDWoxCCCnqOk8nSJOQTjGIg7Q1tLej-ng&oe=6AAEB2A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfXEejmp6VoQ7kNvwFutrEv&_nc_oc=AdoTL2v8wMbtsdYvcI6_ptTuG-ChFeFYUZRpj9r8G5QPaLbM0j6_ZSFWE3oFEHayQMQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO5RP1hYYhhMUgY5AaYTrsvs_7c2UWtXSjYCNwzRhgYQ&oe=6AAEAEF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yea6wkm-K4YQ7kNvwGIxERK&_nc_oc=AdpOpSU1PqTeShJILDvdDFMgXuiaLtLe8HFSBNDwcv2luwphrNpwWFQOegN4dIXKS2I&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCHXLxmjH4kqhxV6hO55_xEzSc141ArAY94iPDMFaQRw&oe=6AAEB3A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsXH3P3s7w0Q7kNvwEXEKjd&_nc_oc=AdrdngKaX5wIovljdXIUXwcxJxO4_egHi6fDtmmzcqQO46sHlohEVGLAx0o25cbU3EI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqpqKfD4wa40ZWpaar7XIJ6NDAhrk4EWnUs_aICdxWNA&oe=6AAEB31B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1FgaMYoLfEQ7kNvwFC2Q28&_nc_oc=AdqO3Dvctg2pdLbAp4pCfPyNDfRcbLOfdAxpIseWYP3mWvGRLSkdpJ8IoHkk8UHqHj4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbqSYSten1iTeWBbE02fMfopM6EuTlGPwsTNuZFo9-3w&oe=6AAE9E70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OZjNWLH4GoQ7kNvwHlB4v3&_nc_oc=AdrWRVXU4NgcJ11ORTEzXzestX4jV1fH9EdOPP_IOv--cz4la7SvjUOvsnvTj6xBeV8&_nc_zt=3&_nc_ht=
ri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICzwopIM5t4Q7kNvwGuaMZh&_nc_oc=AdppClUWus7fbXuPBsfwFsEyYvIlkPzanXrDkRA72V759haf4zz9avp-Sp71yRxF1xM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCGtUesXjHGeyEDuPFQwKK6kxdfc577hpdbqEUc7wUiw&oe=6AC910A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtvliEhe5PUQ7kNvwFYJ4Hv&_nc_oc=Ado9G4c__TpO7zY2nJlg0MFPLOE6EHiNGE7Vj-CkgbFKx0KDnCYtHMqK7HD5qJ-7lP4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOieT-jSwNeYSh05bisMLMTUeRZD_ZvvlMFoMPeVi8BVQ&oe=6AC90CF2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVcCE1pH0k0Q7kNvwFsqbN5&_nc_oc=AdrAhQHhMjkgwhUdGDZfzjc2N57Xz8MaxUX0VCLfZ1uZl5Rhk4rY4_W1NMUHr4zP5_I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpX1PwghiwfGjyyaFxwB3XHf1K8FjMvf2ZQBERb97Uag&oe=6AC911A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0JJvq3v6FcQ7kNvwERQyfz&_nc_oc=Adp4E-LFRJiM7CzlQUqdhFZ7vfxpZfgwPBjk3u_g2Jd9akpYOvxUXej6mR8EW4ZRlCQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv3lSKKA9w_DCYahh1iP1poA_CG0_R_G834IgzFFUY1A&oe=6AC9111B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEsf4VwwF4IQ7kNvwEACB54&_nc_oc=AdpwM3rFHiUBaGcVvPxEF0IEMs7ZWV3nbNWaKOXKoPJ8RyyGF5rJiWPsFm_GzL_EgCg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGeetgqnbJI4fZhKzjq85KeS6hyWVX3Gf5SDgWJCTiIg&oe=6AC8FC70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kaIyQWrjHJwQ7kNvwEHKxM2&_nc_oc=AdoZoXXUZB0nkoBL7JCr0Tg9Q3V4Z7IV_F0fnkdow4iyP9Jgk0OxTP4BYWqylx8bHa0&_nc_zt=3&_nc_ht=scontent-lg
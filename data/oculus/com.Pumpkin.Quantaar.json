.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFzeSzOaqewQ7kNvwE0QIJU&_nc_oc=AdmXj76KS1jacqAFIsuMwSE1G6iYk1q-DyIYMIBmR5XrYhxT-aNH1yCMTr4Wns9LsU0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftnggW_ljzyIWaPDjRXHsi0ouJTLDekHcIRHq5SChy2Hw&oe=69999F67"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nkvTo8rf7wQ7kNvwFj8KUh&_nc_oc=AdnuYyZ5SMYli8nuscJpq6PheiybPnOBiWmzkjZQGXou_UR0t0a1guPqbQVCMUaPkvM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftbCEsWM2DTM9prQQgQZzo09msGOGr4fKV5E4Q9OMjf9Q&oe=69999BB2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGS-27E9ekgQ7kNvwGqYw6i&_nc_oc=Adm_vhup20p56vPIWIqh0kew1GzlrZtvJxZfXPosA_k8YpMLgEzTDtta0rJGUIrTrJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvYf51dtaV3Nb1pkqmyZINiTxkWzWtv0q67yHcBOmIR-A&oe=6999A069"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvYIRJtTueUQ7kNvwGixjuK&_nc_oc=AdlHqUC3Hag9PtFymH7re1M7fdgo0RCeFYVrN_gNQrlj0h_2ilnD5HA-uisa-pOQvk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsL5wia4ZqY4XP1OWKMguCCzVSQa-HSyOEyhFaONGYgbw&oe=69999FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42aQa5TCIJcQ7kNvwEodPui&_nc_oc=AdmHIjH5HsU8rjbb8Hza8VqX2LuNeTSmEnGiuFMA5jAh1V9tLLJ351Oq9lxowhHkAqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvL0kwEXEclqS2O8WqYcOtxg7arot5fpTeukiMF7TvqeA&oe=6999C370"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLfuH8H7emEQ7kNvwGW779t&_nc_oc=Adn6BKvf_NcCBbdYlIZKJqHI_DB6wgd_XDudB2RBYpWeZABkaz1iNJOrktkruy6zmvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsJ_M-6FJ6PI89smY9jSD6ukSs_WwsOFlaTH1f9Rn4MTg&oe=69999684"}, {"file_name": "Frame 84.png", "id": "1747234655674817", "image_type": "APP_IMG_COV
ri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPdHiskpb-cQ7kNvwGkwTKf&_nc_oc=AdrGq5fyjNxRiqqXZ7c-WTnH-UIj7k_qIawgmq3tYnh35obvPxq5tx8thW7ehkECy7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Z0Ugvu0MJ1IQyWoQfmOlKDUKtoINmkXcW8cHXHRXHlQ&oe=6A3EA327"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HckDqeaPwqoQ7kNvwFz58qu&_nc_oc=AdqcY608MXeE_nv6VC0kn0k9rmzU18wB18mEeGa9lXzYhdxdc56e66GYByPN0laA1zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ll0wgGPmrScCaxurh3LWcBrrN2jGV-vnESbl_rHg7UA&oe=6A3E9F72"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDxjmh_nbowQ7kNvwGA2Ew4&_nc_oc=AdpdglWbwMRe0FbtgdCvTB0QdOQ5Z-Req-v_TXrftnKrrKadE5Yl-4l32E7Gl7Qc454&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E3YtQCB-XLe0Hqo5ObyBrWx1H-_fMpRxP7M_-qCOMvg&oe=6A3EA429"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nI2meXmM6eIQ7kNvwFNboSD&_nc_oc=Adqg7Fop6PWp_xXAengtPVU6CY3-cVneA5BHw33nKEwsReNA6wDXa9zf5Tj7Oj33Wyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_db-7_J7l47RWAC02ii1PU2ae-grsRAchF7Y67T_ehSg&oe=6A3EA39B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0J3wwpPRUpMQ7kNvwGB1LpD&_nc_oc=Adp70ZKn3I--AiOV0DdDSfuElXF7Kog2KEs4KY8KekgSRfa8gJl4fb-JVR_NpfVTv-E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BQnqRlwTbONf8LWPAO6t4kynAzP2DZU06sXAwhsOFPA&oe=6A3E8EF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD05dTPwteEQ7kNvwFPaSjC&_nc_oc=AdpVbYFsJSecfuQ5s7Qgs2zwqrrf52-uDEBrbN2qJoNuTrhMqIAb8yE0PFeJT7U3zJw&_nc_zt=3&_nc_ht=scontent-am
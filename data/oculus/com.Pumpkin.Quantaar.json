ri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWz-YhpWRXYQ7kNvwE4ncHO&_nc_oc=AdqRgpy64Va5W0vcZfbtSTEVM6DpJ5xCvqIUtro-Hc83KzJRgLBa49g0BDYzwNp7Xq8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK80fvHKr0IJiCJvn98348pRPpt34rho7PHo-X7joyHnA&oe=6ABE84A7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTJg9IVgJYMQ7kNvwGxJ7zl&_nc_oc=AdrbdnadHB0UdyhxsVUSYjI8fIEyF6mOoX-v5xE8kkySNoTQuMdiIAnS8nTI8_szppg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKi2sJdy3zKaD8WBpCxoj9doOMwr9300pCW7DmjOSM7A&oe=6ABE80F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWjkiEIAsVsQ7kNvwHsf8XO&_nc_oc=AdpAVgk7bbCxuN898QDzGP2NicZe0Nt2YyvzKAkX5lxrtNI7nhn5dwyJJlHSE6ENKcc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFVV1F9xex8BoDmIo6uDeXwyZdnC8UugWCQYrtuCOoNA&oe=6ABE85A9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC-a427SBgQQ7kNvwE9x8H_&_nc_oc=Adp8Zy3_MOXCtTRl2cX5euAkf9_lF51JfKVarGU00wRCd8aBk-RTSG7Ja_V6jMtiKFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvmFEVokeCAu3d92-L50UaoInKs6ITeeip7N3pwatdUw&oe=6ABE851B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceO4HzCClFYQ7kNvwH4YTaU&_nc_oc=AdqIRiQRWAW2q3PoUHF3UyLavs6h2xLhU19EfS15ZTb9H-oesC8RL2pkG0_UnY2J6B0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmOLJ0KsBVq5pvHq4k2zH8Niu5M55tFm2kT1kfemc7lA&oe=6ABE7070"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rq3MWRkvNr4Q7kNvwGt7NIc&_nc_oc=AdoD4U-2v70wjm88jBZ7AyLvXFBwIn37cPp6YS8Vkv0wroeV5bADVIgjNBf5MsJyEko&_nc_zt=3&_nc_ht=scontent-sj
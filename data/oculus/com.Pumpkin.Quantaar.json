ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7wOBfxifZsQ7kNvwH9Zgdp&_nc_oc=Adq3wo3H4wik5D09UEFwEuQnX1NffOnRrSAF2BCYzLoZNpJs-lagxTcyyYg-WQEIAEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiX_iraB1ToUw9H-0MAAd4q7XwEeSbzSPCWznntpqBgw&oe=6AC3CAA7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kup2Ql1KTB4Q7kNvwEiFskE&_nc_oc=AdqkVChUqxWYSeDsV9fOVEs4MYX5yOBk76O_l4iPHe_cQI7MVh0IW3pJOiolAQmwO4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3IJuUdyABlWkLCq0k9Fw_8c7NNBaxkzbX1DU4IDPK_A&oe=6AC3C6F2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLa03_yPX1gQ7kNvwHk3Ll3&_nc_oc=AdrNNaODV56yqRuEglAzpNwgK0aCwLnqVkz4idO0mdbH_ADxEDRAzVXZuNJ2_2VIYmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnGcnJu1PkP5-CgW4o9RU3Jef5OnyuEC8dPKlNb_NyjQ&oe=6AC3CBA9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmaOmJBub0kQ7kNvwFMiLBi&_nc_oc=AdrWnAa4VPfa5zO72Ls080KMUf8-MDgKrpXdpEDcyHxncRswET25aMXePVWP5bl8Wkw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORxQAP8TQHR8SfJ9Jqma-Iw2XAWYElsz2HOpd_hG-FTA&oe=6AC3CB1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0AqF4D6bJwQ7kNvwGcrg_F&_nc_oc=AdqvKuilSiP3dfHxg-WzbraVY15D1VxK80QAP_2kABKu5U-YuxNeHYTJzacX7K-tbVM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0xwrmibxRpaVJFrYLdbKYJ-z3GATeXcyn5WNtffScYg&oe=6AC3B670"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MD71DSxicyQQ7kNvwHYZNRt&_nc_oc=Adpdk15BVVWDSdX9fykxCLb8vcFr1dehptnBtYttN13NvAYBzpOiCCgANNiadiPocmU&_nc_zt=3&_nc_ht=scontent-ia
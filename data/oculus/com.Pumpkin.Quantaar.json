ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knHPdDOe3pUQ7kNvwEw3cbJ&_nc_oc=AdrojT138IQgdxFuadv8tAhuPkByFDHMNy8v4SEiELBhryWgtRqyCMwOR8I3kA8F4Dc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kvtS6ZM8jkha559nYA5kd_X6mw8FNQokDt0F7XbiY1A&oe=6A19B927"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gffy2Gbihw0Q7kNvwEMoRif&_nc_oc=AdrTfepe8T0D5WkYCP_bAEfIcsTOLmpBbQ0C9sTBMpW1FWoGYlSEwnGDkbngzRCHNjM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Upr5KihF56X1b9MwGNk0dBN2dciqCQ277fKeD9jjwzg&oe=6A19B572"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJlGQWP98uAQ7kNvwFR-uVH&_nc_oc=AdojhpH0FYT7bDSO4jGRQCtAr7SI00x4vINbwxayH-EEBMuCIzUlum0lj5hTsmObv9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kFgI7IcKtv19My-7EG4UZb8xQVAven2d0qzAfy7BhZA&oe=6A19BA29"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfb4F9Jv5RAQ7kNvwFwoIzV&_nc_oc=AdoelAYoabIJOQqxs37U3Pkq6nWOP1L_QidsMshualvAualWxmg1EWQjVLgDE4cswww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nW8iVAI8tNviT9eGj4qqC_YwQW_OVERfTpttQQtF17g&oe=6A19B99B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RJzdAE4-FwQ7kNvwH5I_JO&_nc_oc=AdoAd-bc-2X_uJb4T7PuqpokmzyajgNhcjyr7P15JWr1Z7vdj9pElOwy9PdJ58kqVW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O4i74FdvfyzyfEwp5m6wZgxEFtziFwQrSdK2HcAFt2Q&oe=6A19A4F0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tbVXY-vdQgQ7kNvwHZPgxu&_nc_oc=AdrTuCn_Cj801FiPtJWYZGodhpXdpLVfj77MnKDGgBDbRYXQ_SqT3u3TVs8yAxKvzK8&_nc_zt=3&_nc_ht=scontent-or
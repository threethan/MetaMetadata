ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVO3RKSbMXUQ7kNvwFAKjnv&_nc_oc=AdrEVCGq9V_xYiB8bQITB46v4OCaR4DU_3bGQkOXPGkrBNNGNTHrTXiwmGycZYVr7RU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB59M4LAK3gTlP7UYgxW5i14qW9PVrbXtXwlAH5GzPzag&oe=6A64A667"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuhbKT_MALEQ7kNvwF1u1ZD&_nc_oc=Adr8UILUBr1x3Mr017tXxfApHrwcn8zpuXptw0EQrOwvfKeb7-T5yhnL1ATTiN9bqWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYxoha3zRgK1YdAyOJffeP67Cc5R-jI-6DTsDX_p16Cg&oe=6A64A2B2"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhvBSBDxyXsQ7kNvwFDgnYC&_nc_oc=Adojqcb2rd6GZ4NtKCOqcuTLXjBsZi2dLT9Wy52OCkBVTjsgioXGUAMyCSPoKDacOAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8i5kbfzpZwxn7EhnOnXd0uTGU-2TGRPXahSZATB1kVA&oe=6A64A769"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bM3OmiKudEQ7kNvwFYTOV9&_nc_oc=AdrBGyGu-AplcgbTA2O5Sf1-bv40SgHX4eSj8EMl71tG1LMpt6mLXOrOcZUMurxgEC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkLjn-T1pI4NQASfdacQjJkqJ-KycXIPGAZPh_9ipZyg&oe=6A64A6DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlA9P6iLxsYQ7kNvwF72i9M&_nc_oc=AdpHSShU2isk7-polEDhNDzP4z6BcBXMsGPyIVm-_eF_MDp8o0n0uQ57sHLzCAsToBU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7w-hF1r0S90J6WZ3bH1HjObwKYVt9ut0zk3Tgx-XIeQ&oe=6A64CA70"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvIqLnlmnPUQ7kNvwEHOEwf&_nc_oc=AdossyZ6nw_jE1nUnKtQ3k9PMl7Sl8D2a9V3gmwQswGKZ1UGPjlqmP0hJlAcXAnXhL4&_nc_zt=3&_nc_ht=scontent-ia
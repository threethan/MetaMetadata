ri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210897_260747459690412_7340820757544769845_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnfoAx3aeN0Q7kNvwHXBtqf&_nc_oc=Adrpp37EvgAfg7Cj6K5oHfMdXNOPdTItWtPWcdYSplXbVbkjSCLhnaXrw0WKIM_Ms2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZfIiPGlpRJysSIamJDd2fyUMriHcatRpiHKfvLmhutw&oe=69DCDBE7"}, {"file_name": "Frame 128.png", "id": "1267801190520175", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227815878_1267801193853508_7313697489573186661_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DvZGwb6KXcYQ7kNvwG9OM0_&_nc_oc=AdqUdw86wTOZFvc7pPNIGjneRXkdKC5u3OF-1xwZAtKy62s4MB_kr5EtBmh1IVkkvSQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gh7W78KuWUl-woryQN885DpMqTkouWX0nJHBk9mDB-g&oe=69DCD832"}, {"file_name": "Frame 126.png", "id": "2160059630862059", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031381_2160059634195392_1641663564727436653_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me7TSpPPkV0Q7kNvwEwDwxR&_nc_oc=AdpcPbpWek8BvENxseUA5QUMXHNVytmTHb_gSGkq5uj2_QiwDF6TKyLNbSiOQqSzcg8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2tvG0Nk-pPFGUg_XJf9eQwh-TSuqSo_dNaK9H66uT_9Q&oe=69DCDCE9"}, {"file_name": "Frame 125.png", "id": "934464597894672", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974699_934464601228005_990972979401639941_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYWE7TqZ5IsQ7kNvwG8FcyF&_nc_oc=AdpKjK_uY4rLG8M7oEX8JK_B_4xAj5VRm6W2JAZ82h-Qtc5N1x3RN2X24bhiIfDRN1A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0eYcnjIyuz6e8pb6al-Um95R9b8I5ZAuivNgpr1eQ9vg&oe=69DCDC5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "888888888.png", "id": "1447765276038454", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210887_1447765279371787_3979393617025490254_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=va6sX83I7-MQ7kNvwEuW2be&_nc_oc=AdoVbzVZ-uaipRVN-j-R9rQDoSjFnGK8ZUzomeB5VYTqCrp2skJD5_7gPsQaoi9cP_g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MKPYw5ZUYIRa2ua4LIL6iRmMhpBmt0IVlWHWmxAukPQ&oe=69DCFFF0"}, "display_name": "QUANTAAR", "keywords": [], "long_description": "QUANTAAR is a free-to-play VR Party Brawler! Command Heroes with distinct roles and enhance their abilities with Cores to compete in multiple game modes. Party with friends in themed social rooms and customize yourself with limited-edition cosmetic skins!\n\n// CHOOSE YOUR HERO //\nChoose from four Hero classes: Fighter, Assassin, Shooter, and Generalist, each with unique skills to help you dominate across a variety of adrenaline-pumping game modes. \n\n// POWER UP WITH CORES //\nBuild up your Hero's agility, firepower, and range with Cores to create unlimited combinations. \n\n// MULTIPLE ARENAS //\nExplore exciting new universes, from the icy mountains of Eternal Winter to the desolate lands of Desert Tombs. \n\n// ACTION-PACKED GAME MODES //\nJump into thrilling matches by teaming up with a friend in 2v2 and Soccer modes, or just smash around in Brawler!\n\n// SOCIAL THEMED ROOMS //\nMeet other players in the huge Social Halls like Playground and Space Transport Hub, where you can play air golf, bowling, and more.\n\n\nThere's never a dull moment in QUANTAAR!", "short_description": "QUANTAAR is a free-to-play VR Party Brawler! \nCommand Heroes with distinct roles and enhance Hero abilities with Cores to compete in multiple game modes. Party with friends in social-themed rooms and customize yourself with limited-edition cosmetic skins.\n"}, {"images": {"nodes": [{"file_name": "Hero Cover.png", "id": "1853811518325711", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031380_1853811521659044_6756751171156429795_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqsHKVpWXtYQ7kNvwHV2kfY&_nc_oc=AdoQ7eMP024oT5J5uCdFZGYjmGrOfIt5to_kIouyEmzFYbWeVt0AJpjdvYI4zH5Xozw&_nc_zt=3&_nc_ht=scontent-or
c_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRErMVK9fKkk_7XGOgxSH7gALvXT9j9qZTimj8vPTemQg&oe=6AF32A30"}, {"file_name": "Screenshot 2026-08-26 205925.png", "id": "1035738835946756", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499314659_1035738839280089_3580577483004981875_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SWWKx2_ZVkQ7kNvwETIh9V&_nc_oc=AdotzhqEwx8h1Jkx04NmWfyDBIkJ4Zh6j2zely1WBtGlSXwkB9oFFRweoeLvlfYz2OY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCE9q0hMRXrOHrylIPG2uxhDmFtz4Jgjd6AiFBlK97cw&oe=6AF34EBE"}, {"file_name": "image_2026-08-30_084024676.png", "id": "2168522867073034", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307920_2168522870406367_2843985721182492034_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmC0EChwAiQQ7kNvwGLyxOA&_nc_oc=AdqCHGtd5JFChSC_ZuzdLWa-yZdEFahOfUS9OEocCODv3kVNTRyG2umGIhsuFgw79SE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4LTzcM7IQMSF9Yx0REeOG3hUPDdwQ3jjFI2PDA1GBFA&oe=6AF3471A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Classic Clouds Gorilla Horror", "keywords": ["cloudsgorillahorror", "cgh"], "long_description": "Classic Clouds Gorilla Horror is a locomotion-based horror experience built around Locomotion\u2013style climbing movement \u2014 pull yourself through the world hand over hand instead of using a joystick. You'll explore the tiled halls, empty pool basin, and dim, flickering corridors of an abandoned indoor pool facility, lit only by rows of ceiling panel lights that don't quite reach every corner. Scattered through the environment are simple physics objects that react to your body \u2014 bump or push them as you climb past. The atmosphere is minimal and unsettling: quiet, echoing spaces, long sightlines down empty hallways, and sparse furnishings that hint at a building nobody's used in a long time. Built for players who enjoy Locomotion-style traversal and prefer atmosphere and exploration over jump scares.", "short_description": "A Locomotion\u2013style climbing horror game. Explore a dark, abandoned indoor pool facility and knock physics props around with your body as you climb."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/classiccghprivacypolicy/", "developer_terms_of_service_url": "https://sites.google.com/view/classiccghprivacypolicy/terms-of-service", "publisher_name": "Treeloop Studios", "support_website_url": "https://sites.google.com/view/classiccghprivacypolicy/home", "website_url": "https://sites.google.com/view/classiccghprivacypolicy/terms-of-service", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1337939179399234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303606_28151647267800715_4547711067824408566_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XydbBCHiKo8Q7kNvwHIsOvX&_nc_oc=Adr9TDkC10TYiGD-72_XNScB8-cRFZnXPBgXOpD6IVd2pr51cLP65Az__CmntVLnUvs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoOWWJ-0ghaGTlCbsiyADCANyjDbu5VlLP-O7BE9fvdw&oe=6AF34EBD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Classic Clouds Gorilla Horror", "platform": "ANDROID_6DOF", "context_categ
1J3Lk2Sa5Qfg&oe=6AFB301A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Classic Clouds Gorilla Horror", "keywords": ["cloudsgorillahorror", "cgh"], "long_description": "Classic Clouds Gorilla Horror is a locomotion-based horror experience built around Locomotion\u2013style climbing movement \u2014 pull yourself through the world hand over hand instead of using a joystick. You'll explore the tiled halls, empty pool basin, and dim, flickering corridors of an abandoned indoor pool facility, lit only by rows of ceiling panel lights that don't quite reach every corner. Scattered through the environment are simple physics objects that react to your body \u2014 bump or push them as you climb past. The atmosphere is minimal and unsettling: quiet, echoing spaces, long sightlines down empty hallways, and sparse furnishings that hint at a building nobody's used in a long time. Built for players who enjoy Locomotion-style traversal and prefer atmosphere and exploration over jump scares.", "short_description": "A Locomotion\u2013style climbing horror game. Explore a dark, abandoned indoor pool facility and knock physics props around with your body as you climb."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/classiccghprivacypolicy/", "developer_terms_of_service_url": "https://sites.google.com/view/classiccghprivacypolicy/terms-of-service", "publisher_name": "Treeloop Studios", "support_website_url": "https://sites.google.com/view/classiccghprivacypolicy/home", "website_url": "https://sites.google.com/view/classiccghprivacypolicy/terms-of-service", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": n
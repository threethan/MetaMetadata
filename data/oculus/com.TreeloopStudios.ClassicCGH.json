6 205908.png", "id": "1413654800702992", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499293658_1413654804036325_5163090044011272560_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsl2G48VJFkQ7kNvwGdKGtQ&_nc_oc=AdqboMa7BKJNlfE9DWRJkcFbXxj2wBjAY0v4XX14k9BjGNrsMr9NCf0Ku_ZQ9CXtlnE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWnhkJde6In4agi1E8C_3tycO8aPGOubw6xpi5AgvIM4w&oe=6B106370"}, {"file_name": "Screenshot 2026-08-26 205925.png", "id": "1035738835946756", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314659_1035738839280089_3580577483004981875_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REEmwZwgWhIQ7kNvwFCCbNb&_nc_oc=Adq1KjRq9ic0JPA9PupvPMrs_9RmM6jb7mEQ9FAD9jD0zpQOCKLEBh93m7_x9lvFREI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8xKrk1Mr8Xc13Zw-0kobb5OjJCYIdqp6NXavpbqwbpw&oe=6B104FBE"}, {"file_name": "image_2026-08-30_084024676.png", "id": "2168522867073034", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307920_2168522870406367_2843985721182492034_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7P7E_FJWRQQ7kNvwHTrq7m&_nc_oc=Adrki6rMf6zUWgD3ypGSiyxGsQTHENfPrDq4ueqavasKp4Ou0kXXmAnbhj-emV7ciXw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUn3UNkpJHI5iHBLX9NvIjk0hGOWbg91ItEvDksJ1RufA&oe=6B10481A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Classic Clouds Gorilla Horror", "keywords": ["cloudsgorillahorror", "cgh"], "long_description": "Classic Clouds Gorilla Horror is a locomotion-based horror experience built around Locomotion\u2013style climbing movement \u2014 pull yourself through the world hand over hand instead of using a joystick. You'll explore the tiled halls, empty pool basin, and dim, flickering corridors of an abandoned indoor pool facility, lit only by rows of ceiling panel lights that don't quite reach every corner. Scattered through the environment are simple physics objects that react to your body \u2014 bump or push them as you climb past. The atmosphere is minimal and unsettling: quiet, echoing spaces, long sightlines down empty hallways, and sparse furnishings that hint at a building nobody's used in a long time. Built for players who enjoy Locomotion-style traversal and prefer atmosphere and exploration over jump scares.", "short_description": "A Locomotion\u2013style climbing horror game. Explore a dark, abandoned indoor pool facility and knock physics props around with your body as you climb."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/classiccghprivacypolicy/", "developer_terms_of_service_url": "https://sites.google.com/view/classiccghprivacypolicy/terms-of-service", "publisher_name": "Treeloop Studios", "support_website_url": "https://sites.google.com/view/classiccghprivacypolicy/home", "website_url": "https://sites.google.com/view/classiccghprivacypolicy/terms-of-service", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1337939179399234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499303606_28151647267800715_4547711067824408566_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7
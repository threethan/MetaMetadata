ion over jump scares.", "short_description": "A Locomotion\u2013style climbing horror game. Explore a dark, abandoned indoor pool facility and knock physics props around with your body as you climb."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/classiccghprivacypolicy/", "developer_terms_of_service_url": "https://sites.google.com/view/classiccghprivacypolicy/terms-of-service", "publisher_name": "Treeloop Studios", "support_website_url": "https://sites.google.com/view/classiccghprivacypolicy/home", "website_url": "https://sites.google.com/view/classiccghprivacypolicy/terms-of-service", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1337939179399234"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303606_28151647267800715_4547711067824408566_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJdsU20SrFQQ7kNvwH1J7RY&_nc_oc=Adr37pMBJ1NobcL2S6FzWj4bEbsZOFitLw6p9zjxUTy6Zn6fXb2WTMDa1KW2C4m5okw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIk-aNsyMJlPvJAuQe3phKld8yAZEj_XYdddyG4o7O_Q&oe=6AF9E63D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Classic Clouds Gorilla Horror", "platform": "ANDROID_6DOF", "context_categ
afc9e80R5-KlXWWRlLQ&oe=69B95539"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974633_652832882098203_2498301747041863975_n.png", "id": "1310007942707147", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974738_1310007946040480_7518918736727768732_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kI2PldQUfMsQ7kNvwHvmOBM&_nc_oc=AdlE_-gh9QxqBAR7TBwDvbvwMzU3iH6QqE4q_2CujFz6q3bcz7sj_lZ5srIVXVLX2IU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxgq1Tj_iujn2KxJHIFBw56rmbrntHNgJV0tLsIVY_iLA&oe=69B960F0"}, "display_name": "Rhythm 'n Bullets", "keywords": [], "long_description": "An arcade SHMUP where the music is part of the action.\n\nTravel across the virtual zone and defend the core by guiding a pair of starfighters through the shoot 'em up action of Rhythm 'n Bullets. Enemies fly in from all sides, diving towards the core in time with the soundtrack. Time your shots to the beat for maximum effect, and grab awesome power-ups to clear the stage.\n\nKeep the core safe from danger in the multi-level campaign, and then try to top the leaderboards in endless mode, where the enemies never stop! Take a break with our relax mode where you can practice your shooting and experience remixes of the games score!\n\nFeatures four themes: Tech City, Japanese Garden, Galaxy Zone, and Holiday Forest! Fifth theme coming soon!", "short_description": "An arcade SHMUP where the music is part of the action.\n\nTravel across the virtual zone and defend the core by guiding a pair of starfighters through the shoot 'em up action of Rhythm 'n Bullets. Enemies fly in from all sides, diving towards the core in time with the soundtrack. Time your shots to the beat for maximum effect, and grab awesome power-ups to clear the stage.\n"}]}, "developer_name": "DB Creations", "developer_privacy_policy_url": "https://www.dbcreations.studio/rhythm-n-bullets/privacy_policy.html", "developer_terms_of_service_url": "https://www.dbcreations.studio/rhythm-n-bullets/terms_and_conditions.html", "publisher_name": "DB Creations", "support_website_url": "https://dbcreations.studio/", "website_url": "https://dbcreations.studio/static/rhythm-n-bullets/index.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1672577396871977"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9512250168896820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_3637217329729017_1684752136176544847_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFO_qr8bQaEQ7kNvwHVmE5z&_nc_oc=AdlEwaVVyxr6MYElvMsTPtVdsEnjeEvFer0y9oDeVDoK26NSNn0pO9-oQsk2k_ieqJg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzkfl91kfwL8DO9AVUjZ_teU7mi2GNVnnTIzOJKi7yEsA&oe=69B93283"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm 'n Bullets", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1612829158, "lastRevision": {"nodes": [{"id": "3939885816068551", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_me
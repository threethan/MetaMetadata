ps://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984445_219849413341771_4358863265560486480_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVnpX9hkL8oQ7kNvwE1OxOd&_nc_oc=Adq-_SluHa4iSGByQjw2PghurjFQIR40YQ-HdXDTe22rtoOeqJR203P1O-86PtG7yZE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRs_j30Bd-m35i0gjqAamKVlSDf6EtiwwtFE4lolxzCA&oe=6B01D2F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974633_652832882098203_2498301747041863975_n.png", "id": "1310007942707147", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974738_1310007946040480_7518918736727768732_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiyLCL87wWcQ7kNvwHxKdsF&_nc_oc=AdqFTVBx34itBe69DGYpOqdGm2iLXfEem_RrCmyM4SxUnREDoThHvqzljbPFOP1I3MI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLoXMMILSOYpCnddQ6nvNGp9KNL9RRu_Vv5rc6DM4WEw&oe=6B01DEB0"}, "display_name": "Rhythm 'n Bullets", "keywords": [], "long_description": "An arcade SHMUP where the music is part of the action.\n\nTravel across the virtual zone and defend the core by guiding a pair of starfighters through the shoot 'em up action of Rhythm 'n Bullets. Enemies fly in from all sides, diving towards the core in time with the soundtrack. Time your shots to the beat for maximum effect, and grab awesome power-ups to clear the stage.\n\nKeep the core safe from danger in the multi-level campaign, and then try to top the leaderboards in endless mode, where the enemies never stop! Take a break with our relax mode where you can practice your shooting and experience remixes of the games score!\n\nFeatures four themes: Tech City, Japanese Garden, Galaxy Zone, and Holiday Forest! Fifth theme coming soon!", "short_description": "An arcade SHMUP where the music is part of the action.\n\nTravel across the virtual zone and defend the core by guiding a pair of starfighters through the shoot 'em up action of Rhythm 'n Bullets. Enemies fly in from all sides, diving towards the core in time with the soundtrack. Time your shots to the beat for maximum effect, and grab awesome power-ups to clear the stage.\n"}]}, "developer_name": "DB Creations", "developer_privacy_policy_url": "https://www.dbcreations.studio/rhythm-n-bullets/privacy_policy.html", "developer_terms_of_service_url": "https://www.dbcreations.studio/rhythm-n-bullets/terms_and_conditions.html", "publisher_name": "DB Creations", "support_website_url": "https://dbcreations.studio/", "website_url": "https://dbcreations.studio/static/rhythm-n-bullets/index.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "1672577396871977"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK", "zh_TW", "ja", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9512250168896820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982699_3637217329729017_1684752136176544847_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZT5n9WozqGEQ7kNvwHZRA8O&_nc_oc=AdoBAnk09u22CCFP9Ixv6phKyc2xaQfNDzpVznFx9xLIiBdMUZOIXIcn3CVO7lv4ngU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM32wmiq2JcuFLnfmnoddOemddlbeWD-2h1AGm7pHA1Q&oe=6B01E883"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rhythm 'n Bullets", "platform": "ANDR
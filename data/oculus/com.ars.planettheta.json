dn.com/v/t64.5771-25/39031355_733746341282097_6228695059571342505_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Qy7J9IR3p4Q7kNvwE6wApd&_nc_oc=AdlypioOOUexQiA2OgbqltOQ1zMz5GlvFQP9qCx66RABwR4jv14q3DrbMMzG2WVaV60&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afsr-Og6zMwoZOw-B7QbkfQbuovoEul1cBziwgkRB6OuoQ&oe=69986B5E"}, {"file_name": "barbalcony.png", "id": "724989178591043", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982699_724989181924376_714086653518796347_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl6UGjgL2A4Q7kNvwHnQubb&_nc_oc=AdlCqfXxah8_1mGGBQix6Pc6Bit2_P_Bu06Vyr91X-bmGhUdPyBy9EuLYaPuwp68CAw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfswT9mYunL9oLnzm3ZIVRJLVebOFqmMD4HuCZxuOA4rYA&oe=69984B6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real True Love", "keywords": [], "long_description": "RTL is a place to meet new people in the Metaverse and create lasting relationships. Meet and match with people you choose. If you like them, you can choose to go on an virtual date with them. Take a walk through an enchanted forest, go grab a table at a bar, or take in a movie at our theater. These VR dating experiences are an opportunity for you to explore each other\u2019s personalities and passions. We are putting human connection at the forefront of dating again. ", "short_description": "RTL is a place to meet new people in the Metaverse and create lasting relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://anotherreality.studio/privacy_notice/", "developer_terms_of_service_url": null, "publisher_name": "Another Reality Studio", "support_website_url": null, "website_url": "https://anotherreality.studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
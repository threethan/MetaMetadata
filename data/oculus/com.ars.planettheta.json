dn.com/v/t64.5771-25/39031355_733746341282097_6228695059571342505_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoE7zKEh7koQ7kNvwF3ogTl&_nc_oc=AdpL3XCUT53ArPoUOzN5WSUPEdmJ41MEkuVojxKj0MYqAH5DdJPdqibUmoe1d5jgROc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1hWoy1rGeYkqMp-Gs__t5H8cbPmTF5Szm5kZx6lt1J6w&oe=69F0BFDE"}, {"file_name": "barbalcony.png", "id": "724989178591043", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982699_724989181924376_714086653518796347_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU4Z38sidWQQ7kNvwF3dt6a&_nc_oc=AdrwFlkpq99Ell5TaC2OHIPJntTKoPYc2U-UBx9P8Xvpl-LcmhIuQ_RiKt3ddyqbImw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2zAc8ME-Ubg_fp-hWb4vIl6_oZETJR_1uoKsYTSo19nQ&oe=69F09FEA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real True Love", "keywords": [], "long_description": "RTL is a place to meet new people in the Metaverse and create lasting relationships. Meet and match with people you choose. If you like them, you can choose to go on an virtual date with them. Take a walk through an enchanted forest, go grab a table at a bar, or take in a movie at our theater. These VR dating experiences are an opportunity for you to explore each other\u2019s personalities and passions. We are putting human connection at the forefront of dating again. ", "short_description": "RTL is a place to meet new people in the Metaverse and create lasting relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://anotherreality.studio/privacy_notice/", "developer_terms_of_service_url": null, "publisher_name": "Another Reality Studio", "support_website_url": null, "website_url": "https://anotherreality.studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
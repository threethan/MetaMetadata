dn.com/v/t64.5771-25/39031355_733746341282097_6228695059571342505_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Qy7J9IR3p4Q7kNvwEovLMn&_nc_oc=AdmgN1gvtUh0BUTtqIW_SKUuCME0UJK0HG1V-MvwF8cI5WmaZqodwyAT78lPo-gz8s0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftJ3PWaCuk49a342ms4Lgoux68Wp5k8lolo5dIqKuA1qg&oe=699B0E5E"}, {"file_name": "barbalcony.png", "id": "724989178591043", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_724989181924376_714086653518796347_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gl6UGjgL2A4Q7kNvwGJPhTy&_nc_oc=AdmgLtlkWZnE7UcERq77KSGg_iF8FGFOm4xh2xqfRFVuxT8R3qblu4Zd59aU8ii8b7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuQrYkcTiya8iZEi1HXXyCCAu3gsCqt5DB80ueN8J87YQ&oe=699AEE6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Real True Love", "keywords": [], "long_description": "RTL is a place to meet new people in the Metaverse and create lasting relationships. Meet and match with people you choose. If you like them, you can choose to go on an virtual date with them. Take a walk through an enchanted forest, go grab a table at a bar, or take in a movie at our theater. These VR dating experiences are an opportunity for you to explore each other\u2019s personalities and passions. We are putting human connection at the forefront of dating again. ", "short_description": "RTL is a place to meet new people in the Metaverse and create lasting relationships."}]}, "developer_name": null, "developer_privacy_policy_url": "https://anotherreality.studio/privacy_notice/", "developer_terms_of_service_url": null, "publisher_name": "Another Reality Studio", "support_website_url": null, "website_url": "https://anotherreality.studio/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
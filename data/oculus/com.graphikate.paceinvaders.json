bDKsQ2GmenK64eak-g8X4aNoOWA_HjvSFD_mEK8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSgJ0JNv_R4q3mdnHvGe2jP5APHvbg2oEneCVniBHGKw&oe=6B030642"}, {"file_name": "store-shot-5-dusk.png", "id": "3785032864968026", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499621314_3785032868301359_7324918430711884753_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfMlvFlrEyYQ7kNvwGA1dLS&_nc_oc=AdolJSiISkG7j0Xzk1C4PXbE5R9T9Zi_h7NCO20qD4q-hzMvY71TWFV2E9o4J9lCF8E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnmEs7_FU8ON8tktSEocS3dVmABiDzFORhst7NCyayTQ&oe=6B0336C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560.png", "id": "3216814598516347", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620403_3216814601849680_2735980787465429212_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBRPnwSLxCsQ7kNvwGiUsO9&_nc_oc=AdrrtlP4LdzQ6m5Of9nzTVs8UBBLcUpzzzfZCV6G1YSsxu-hW2dqM1aoWqBWW_A0Lo8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAv0913jAExH-Z55BCpf--1oWcn0JztKXOwJEOXgYgfw&oe=6B032829"}, "display_name": "Pace Invaders", "keywords": ["treadmill", "walking", "fitness", "shooter", "arcade"], "long_description": "Put your treadmill in front of you, put the headset on, and walk into a cardboard diorama that shoots back. Pace Invaders turns a treadmill walk into an arcade run: skeletons, beetles, droids and tin soldiers come down the lane, and every step you take is counted, scored and turned into gold.\n\nFour worlds, one belt. OLD TOWN's high-noon desert. The BUG YARD, three inches above a flowerbed. DEEP SPACE in model-kit grey. A TOY ROOM the size of a carpet. Each world arms you with its own iron, six-shooter to ray gun. Walk ten minutes and the Grand Tour carries you through all four without breaking stride.\n\nBuilt for real treadmills: a passthrough window keeps your actual belt in view, a pace beat matches the game to your real cadence, and the speed you set in the game is the speed you set on your machine. A warm-up lap lets you find your stride before anything comes down the lane.\n\nRequires a treadmill and a clear play area. Attach your treadmill's safety clip, match speeds, adults only on the belt.", "short_description": "Walk your treadmill. Shoot your way through four worlds. Every step counts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://old-town-shootout.vercel.app/privacy.html", "developer_terms_of_service_url": "https://old-town-shootout.vercel.app/terms.html", "publisher_name": "Graphikate", "support_website_url": null, "website_url": "https://old-town-shootout.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1446465157369885"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593990472_1779902443364645_5383982303097538207_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RtILt3RLusQ7kNvwEWlOK3&_nc_oc=AdpFb556L5-vf0fDSMOp5McqH_LVE2d1fW_e-UCX8OhVEjofB6ZuGY2niH-5bSOgK6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgJWMrjFpLqrtY3pnrwtZCbCrqPLB4G9ittC7M754XMg&oe=6B0305F2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displ
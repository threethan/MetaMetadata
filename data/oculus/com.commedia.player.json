/t64.5771-25/39031388_1522816155325335_8580606245560653682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3aRdM-rLskQ7kNvwFRheMk&_nc_oc=Adlwem6JiwKfhdUlnuegpdWv8AJBOzSoXayUOMgB2ONIYKYFke_pc8KKWPUetMpfBWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwnAdIhHxxlp0ZSyvzVD5YTCuxHtsZVzUNLnm9xsrk8gg&oe=69BFCC9E"}, {"file_name": "CommediaScreenshot04.png", "id": "411004595230063", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974896_411004598563396_3850989218816816836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsWFBd9NOIsQ7kNvwG5iEYK&_nc_oc=AdnlGdQu55SKzQ9Y6Gkh53tbQx-TwcCA_f_wIQjTLziMR5J0m-B0M1Sxnge4eq2HZC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxKvcHgy7WqKeqxnVScqKuoUNwLKzADh5rGjzgdmzNjWg&oe=69BFCC05"}, {"file_name": "CommediaScreenshot03.png", "id": "1905159056591211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974518_1905159063257877_6067601919827270373_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GWTw7nyc-QQ7kNvwFSQ0n2&_nc_oc=AdkgAtApQMBKroEoE_rxJNSj0jQo_Aqgm8bEVeQiu4u3Ye1NJTMXc7Zab3NhD_-6klU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwTdDDARKIUPCJzva5-wYzC73JFn77Iy_aKMtBGHFiMpQ&oe=69BFF0CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Commedia VR Video Player", "keywords": ["media", "watch", "movie", "youtube", "passthrough"], "long_description": "# Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\udb40\udc6a\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap", "short_description": "Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.commedia.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Commedia Studio", "support_website_url": "https://docs.commedia.app/support", "website_url": "https://docs.commedia.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "ja", "de", "zh_CN", "ko", "pt", "it", "ru", "tr", "el", "nn", "hi", "nl", "pl", "uk", "cs", "hu", "sv", "th"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32457352790546414"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982511_1083637783143927_8777079222655405211_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExzjeiigaCEQ7kNvwFS1nT9&_nc_oc=Admkbb2TtqHUsN7sq9lv5EGxBFAJbd
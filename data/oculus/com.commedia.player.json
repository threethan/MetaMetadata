/t64.5771-25/39031388_1522816155325335_8580606245560653682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfy3Xd64pD8Q7kNvwGsxMvP&_nc_oc=AdkBVIjf_vMErJN43K4NoLh_mFPenZTmhWvFHhPB_S-7CKpXsv964wwgw9ZW_5plQFk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMCsDVpHTpUIByRPdTcaQd4Io8Wr5fJiYgg-CSNAnPoA&oe=69B6921E"}, {"file_name": "CommediaScreenshot04.png", "id": "411004595230063", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974896_411004598563396_3850989218816816836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcloswQEdFUQ7kNvwHFE2DD&_nc_oc=AdnKJjv5g6mu7wsajzJ4BI5KTvibGCmBAOy3rXIEd6RgzvopY_ueYkbQlas9eyHX16o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyDaw62gGRSlhwL26DCrWOTl8BAilVfZbzZ-RSZBBg3uA&oe=69B69185"}, {"file_name": "CommediaScreenshot03.png", "id": "1905159056591211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974518_1905159063257877_6067601919827270373_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYQ0DSKHqFsQ7kNvwF-mspJ&_nc_oc=AdkYrtvDIC4kmfaCKwfQOcMJgK2wGpcl7Ba-1REAM3p4ZiiA3CIbLWNt9Hvj6Jp9IkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxna9vd_1N3WdVm34sj9Mp5cf6zc-AORmkuRZjFzI99KQ&oe=69B6B64B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Commedia VR Video Player", "keywords": ["media", "watch", "movie", "youtube", "passthrough"], "long_description": "# Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\udb40\udc6a\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap", "short_d
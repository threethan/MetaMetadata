/t64.5771-25/39031388_1522816155325335_8580606245560653682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94oMR4CCx2oQ7kNvwF5-et6&_nc_oc=AdnyroPd3-Gm8wYd0hgFrUbLxzHYbqceWQtMyDpoDnfyUVz5Kbf9AEXnxAcFzZe8kuc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx7_2cNvBXP_u1vcVBg8DSkkCbi4_PigT5V53bLiXm77Q&oe=69B29D9E"}, {"file_name": "CommediaScreenshot04.png", "id": "411004595230063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974896_411004598563396_3850989218816816836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK9R0FpeX3gQ7kNvwFcBwTs&_nc_oc=Adk4k0hUOaPw6RLobPURDwXJscpNZgMjPc20cHJVQQIEzxQN5xKRhRYDEzfrO9LYv-w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwcnvnsvTpnSH6W-HnPrU-cxnxPBnAiNP4iEWdg41DeJA&oe=69B29D05"}, {"file_name": "CommediaScreenshot03.png", "id": "1905159056591211", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974518_1905159063257877_6067601919827270373_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVEDEsCVnLcQ7kNvwE5fWmp&_nc_oc=AdlISh9ZL9EsjXfdMgo0nVVYQ2_ka2y2cUd2iF1X3SRGFDGSyzmjluIj1VSHeGdxOqY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwO5sVtHHtG0K26lR779Iuyhc-0PjtkPlFDwAy9184wxw&oe=69B2C1CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Commedia VR Video Player", "keywords": ["media", "watch", "movie", "youtube", "passthrough"], "long_description": "# Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\udb40\udc6a\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap", "short_d
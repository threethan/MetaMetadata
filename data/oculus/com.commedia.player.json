/t64.5771-25/39031388_1522816155325335_8580606245560653682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94oMR4CCx2oQ7kNvwFFcBNn&_nc_oc=AdlIRe7l2O13iqMh3JNI9LE5iB7EuNk4EaFlgr5hyhSLr--HHCMrpNYVZ759RNI8nro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZNrokCi4lCy7W04YLKOg_xuBL3FJr1dLKCCA3IxgZhA&oe=69B14C1E"}, {"file_name": "CommediaScreenshot04.png", "id": "411004595230063", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974896_411004598563396_3850989218816816836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eK9R0FpeX3gQ7kNvwGTbdBs&_nc_oc=AdksUZp5z-7k0BtaqZgyuyvYOzjSv_gAgCPzHxZB-mn7RbsYOH5rTarjGgaXnvXnzSU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzfUfDC4Qup8c8rC8GtRlNDRcPuf8YKRVbWSQzzmlaZNg&oe=69B14B85"}, {"file_name": "CommediaScreenshot03.png", "id": "1905159056591211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974518_1905159063257877_6067601919827270373_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhQRn7X5dA0Q7kNvwFZYMEE&_nc_oc=Adkg6nButmGCI0cEiVmgLyzXcLEgfXFT-vetD0UpHcjkn53BxAeXkohZsG0pNqDG__U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRoJEGsbQDLTf5Op0hEBx70qv4UIq6F6dGR5zJgybFhA&oe=69B1704B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Commedia VR Video Player", "keywords": ["media", "watch", "movie", "youtube", "passthrough"], "long_description": "# Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\udb40\udc6a\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap", "short_description": "Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.commedia.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Commedia Studio", "support_website_url": "https://docs.commedia.app/support", "website_url": "https://docs.commedia.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "ja", "de", "zh_CN", "ko", "pt", "it", "ru", "tr", "el", "nn", "hi", "nl", "pl", "uk", "cs", "hu", "sv", "th"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32457352790546414"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982511_1083637783143927_8777079222655405211_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20GyTrsXmRAQ7kNvwGKuZpH&_nc_oc=AdkO02nc_aFbPfxktUfwGGkZTqPaKy
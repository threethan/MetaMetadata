/t64.5771-25/39031388_1522816155325335_8580606245560653682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6PGEa8m91UQ7kNvwEoqZuf&_nc_oc=Adk7pF532FHg8IlkZTXAgJPaC9yNGJl7dsAWdhXWYjnUcI4Oe0nD-Yu4W7glRboizz0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftwuwAExb_K1TH1s9H_HYdZO_5HozDSE2pZayAbAAA3ew&oe=69A8119E"}, {"file_name": "CommediaScreenshot04.png", "id": "411004595230063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974896_411004598563396_3850989218816816836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gcy2rLVTYKcQ7kNvwGljRyt&_nc_oc=AdlLERJodmqCvVzRLCD9Rs2RhTAGoiUa-YH7IHXFdFN5o9gIzIX4cvONBUysoENOY4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuNihlXdruTGAhUIwEMm7IjQ2711mYDf-5LrSW6J9-niA&oe=69A81105"}, {"file_name": "CommediaScreenshot03.png", "id": "1905159056591211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974518_1905159063257877_6067601919827270373_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glV80KzY2tAQ7kNvwFBljTa&_nc_oc=AdkPCqadMQIO2lCe93-uE1QhmQpcxC4JCUTvIMsWdEVsA494gzpei-hVCXAJxTcQd3k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuETtMERBsVilQ13hG7wWVmsYMLP-Qk3idMV7JzBIFc3A&oe=69A835CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Commedia VR Video Player", "keywords": ["media", "watch", "movie", "youtube", "passthrough"], "long_description": "# Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\udb40\udc6a\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap", "short_d
/t64.5771-25/39031388_1522816155325335_8580606245560653682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3aRdM-rLskQ7kNvwFFYfwT&_nc_oc=Adnn9QMFNdzLgtPWyIiIdaHz7fe3NtgqX7D_miMHHkWPImdh_ah2A2jlNlrUwacwBLk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwn4t9SomngTeL7cXamaUw5RlZ-kGz7PTgo7w7jRXFd9w&oe=69BD299E"}, {"file_name": "CommediaScreenshot04.png", "id": "411004595230063", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974896_411004598563396_3850989218816816836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D1wL0ytdOUQ7kNvwGicnlZ&_nc_oc=AdkbFdxoPDYSEtUBb7fysc8T52KZ3DMHqfNWPBWyF1SrXKyJyWj1OsdzCQc5Yg6PVcM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-UIY5hqNk6C3Swe7Cal5n8MzpPqVl0pgS-5eKq_W-3A&oe=69BD2905"}, {"file_name": "CommediaScreenshot03.png", "id": "1905159056591211", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974518_1905159063257877_6067601919827270373_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2n0PlnscW8Q7kNvwGdxa2I&_nc_oc=AdlrNoPZPwc6Fy3k-xN3OPFd0RByevFBRR2xt65smMUUvqE0IIu5x4S-vxZ8CE1ag9M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyMsQk3_wkRsLXeL6sOaqlAZjBZ1sMefrHJUkYDa9Vy1g&oe=69BD4DCB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Commedia VR Video Player", "keywords": ["media", "watch", "movie", "youtube", "passthrough"], "long_description": "# Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\udb40\udc6a\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap", "short_d
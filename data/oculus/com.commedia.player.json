/t64.5771-25/39031388_1522816155325335_8580606245560653682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SM7VC3cRy4MQ7kNvwFu3XS4&_nc_oc=AdrOxqzAzmFlky7v4QdS9Te6Zyy59MsGXbI9fPZLoxAKBdkP_wMD5ZPYIY2bHyoruws&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7K1izUhEHZJRJA15ThJk3pyUA0Jg_L26CpztXRqZ0AA&oe=69C11E1E"}, {"file_name": "CommediaScreenshot04.png", "id": "411004595230063", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974896_411004598563396_3850989218816816836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsWFBd9NOIsQ7kNvwFndGIX&_nc_oc=AdqcxyQTmSyqAt2Rg9Zwp9cxM9dHrWrjOVfGkaTlpcuBqRHZ1GKivn9fFVJ7pJPm-dE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzi-HWlYZ1favAel_HDLOQj9-WxzYEu3GbMCEnTNj8OHQ&oe=69C11D85"}, {"file_name": "CommediaScreenshot03.png", "id": "1905159056591211", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974518_1905159063257877_6067601919827270373_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9GWTw7nyc-QQ7kNvwEBgbyo&_nc_oc=AdooHNzmqi5P9tbSWqQs4D4DFPixpyKMiNeBNDT_JZdDOLBeP26MUcE8nRQKwt__mVE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzvjWluq09h2CUpHmxcx9nBhTy6k6I3zJotW0WynuRsnw&oe=69C1424B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Commedia VR Video Player", "keywords": ["media", "watch", "movie", "youtube", "passthrough"], "long_description": "# Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\udb40\udc6a\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap", "short_d
/t64.5771-25/39031388_1522816155325335_8580606245560653682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfy3Xd64pD8Q7kNvwEE85N8&_nc_oc=AdkLQYMeBlz_0lkbENmyVm17LUeRRPXHOduEC0nVOfkZpX2YluY8lBtPK1AZ25jKKvE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzr_bwrW8htrGGbtycrdkYUWUPWQkTd8HUIZ1yI5siIKA&oe=69B7E39E"}, {"file_name": "CommediaScreenshot04.png", "id": "411004595230063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974896_411004598563396_3850989218816816836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZX6V6WJYvrEQ7kNvwHi8Ol0&_nc_oc=AdmswnW71VPAvgmzTFzMaVva-WcZxwbdMeATdbFuhUp5hYiVlfZlAEPmdBuMVoFZL8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzHuZOxhN8r8kpUjk2cpWplrIC9BWlabmG02KJGdO1toQ&oe=69B7E305"}, {"file_name": "CommediaScreenshot03.png", "id": "1905159056591211", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974518_1905159063257877_6067601919827270373_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYQ0DSKHqFsQ7kNvwFO1TXT&_nc_oc=AdnZZPCkQ5qkwGjHIdLBB_ojkA7y2H5tjilogIcE-Aie6IP-dMbshkj2RHVfDarrhLY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzdzNGDLUx2nWUJmWZWolbwWJ1EdVymmPQaEUViGwepmA&oe=69B807CB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Commedia VR Video Player", "keywords": ["media", "watch", "movie", "youtube", "passthrough"], "long_description": "# Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\udb40\udc6a\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap", "short_description": "Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.commedia.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Commedia Studio", "support_website_url": "https://docs.commedia.app/support", "website_url": "https://docs.commedia.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es", "fr", "ja", "de", "zh_CN", "ko", "pt", "it", "ru", "tr", "el", "nn", "hi", "nl", "pl", "uk", "cs", "hu", "sv", "th"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32457352790546414"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982511_1083637783143927_8777079222655405211_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOhGo5oRYJ0Q7kNvwGufAaQ&_nc_oc=AdnlSCqg4PKSppyt0Nuo7zdDl-Ndg1
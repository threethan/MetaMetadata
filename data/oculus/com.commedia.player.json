/t64.5771-25/39031388_1522816155325335_8580606245560653682_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhkL276GicMQ7kNvwFirUD0&_nc_oc=AdmigaIapU7TzMhlm-wfuuWErLFeyiVstUoAgHffIfdcE5YPC70cIChrZGh_kvBezxg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzvs2ktjld3gHzb_9bLIs_zNBIjDVBkyLMyo7yLPDBqYA&oe=69BA869E"}, {"file_name": "CommediaScreenshot04.png", "id": "411004595230063", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974896_411004598563396_3850989218816816836_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZX6V6WJYvrEQ7kNvwEz65ZX&_nc_oc=Adk74HmO3Jhisth3YgpS9KwHb5bugia2PfXfTGaz5wteG23Sx4Emjt4GLnebbMz0fN4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQNMtAYC82-UeMRudRJn1uY7cGoF_1uV0NRGDdMzkp9w&oe=69BA8605"}, {"file_name": "CommediaScreenshot03.png", "id": "1905159056591211", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974518_1905159063257877_6067601919827270373_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2n0PlnscW8Q7kNvwGpMN6R&_nc_oc=AdkYKe1C-rP9Ze_WzqAymwC4cG1ZCn5wAuKIFOlYYviyzEu1DvsrukOdf4O2n3KGrjY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyxUTIWXt02FowNvn53hr5nH1ExKurPJGxRuhppoJL2-Q&oe=69BAAACB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Commedia VR Video Player", "keywords": ["media", "watch", "movie", "youtube", "passthrough"], "long_description": "# Commedia VR Video Player - your Media Home.\udb40\udc5f\udb40\udc5f\udb40\udc5f\udb40\udc7c\udb40\udc7c\n\n\udb40\udc6a\n\n\nThis Video Player stands out with its exceptional User Experience and Performance, while playing all common video formats in Stereo 3D, Flat, VR180, VR360, Cube and various Fisheye projections. \n\nIt also supports:\n- Passthrough,\n- Subtitles,\n- Audio tracks,\n- Browser (Youtube).\n\n\nAccess files on your local network via SMB, DLNA or from your headset.\n\n\nDiscord: https://www.commedia.app/discord\n\n\nRoadmap: https://docs.commedia.app/roadmap", "short_d
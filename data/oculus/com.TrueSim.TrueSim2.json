c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPds1BQooD0Q7kNvwEW1Z4D&_nc_oc=AdpyaRE2VvfYksVBR84xjDsuXD5_NhNPe6GibC_ycyKncp5q7m9XU8Ioi8DucdnnJ7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSG213NVCDFIsD0Ne8HXhagLyd__85XklkQy0bMDpQqRw&oe=6AFDCA2E"}, {"file_name": "screenshot-003.png", "id": "1166865802301117", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1166865805634450_2357201996220937109_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9TjytbAfwYQ7kNvwEnK1II&_nc_oc=AdpjxxAlhqnO76etcSo-6EFwNR8ACzu_GW7B_xv1_QnFne5PP2rZJru1gMWearFgZu8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyKsE-CZf7bB8QqFqZfVKvOKxiY3ggfOtAQp7jwfQGEw&oe=6AFDC45D"}, {"file_name": "screenshot-004.png", "id": "1316568323519281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_1316568326852614_8413934166065482142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SHmIpRaHO4Q7kNvwGtUJ_L&_nc_oc=AdpLrV8-O_3joghBVYyVigc1S8CQbpHwKgfUQ5-P8JQYC9NVFI4rC8BqMfQimLCGWrM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ-KuJ9q3mICMHdCce2TqPfu6P91SaSpqR5WqmofuzaA&oe=6AFDBFDA"}, {"file_name": "screenshot-005.png", "id": "2179473939560307", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_2179473946226973_2535212187393767438_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2a354xbE-gQ7kNvwEQwHrA&_nc_oc=AdpYNIHq_TqLmHxeYoj4PEoyUpACkzzYieQ_v1QJ2nRUl9H83JNxdbCeazrgnXSFEG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUyQrn509SxYEEpAapkaoEByUmTNgmAM27coT07886qg&oe=6AFDD510"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrueSim", "keywords": ["Healthcare", "Nursing", "ABCDE"], "long_description": "Training, Confidence, Care\n\n# TrueSim simulation training\n\nHealthcare is changing fast. Complexity is increasing, while the space to train is under pressure.\n\n# The future of clinical competence\nWhat if healthcare professionals could train exactly the way they work? With TrueSim, healthcare professionals (in training) master:\n\n- The ABCDE structure - Rapid recognition and treatment of acutely ill patients.\n-  SBAR(R) communication - Clear, structured and error-free handovers.\n- High-performance teamwork - Clear roles and disciplined workflows.\n\n# Bridging the gap between theory and practice\nWe prepare healthcare professionals in training for clinical practice through a safe learning environment.\n\n- Lifelike clinical exposure - XR scenarios bridge the gap between theory and the reality of acutely ill patients.\n- ABCDE mastery - Repetition in lifelike environments shifts performance from memorization to intuitive action.\n- Preparedness - Students are better equipped for urgent situations from day one.\n\n# We don't just train, we prepare\n24 validated ABCDE and SBAR scenarios in three categories:\n\n- Respiration - Pneumonia, pulmonary embolism, anaphylaxis, pneumothorax, cardiac asthma.\n- Circulation - Sepsis, myocardial infarction, hypovolemic shock.\n- Central nervous system - CVA, hypoglycaemia, intoxication.", "short_description": "TrueSim offers Mixed Reality simulation training that allows healthcare students and professionals to practice the ABCDE method in realistic scenarios, at their own workplace, whenever it suits them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://truesim.com/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "TrueSim BV", "support_website_url": "https://truesim.com/support", "website_url": "https://truesim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_782476898225988_1059310295038154387_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Gbq57JyuQgQ7kNvwFO4LSI&_nc_oc=AdrcZ5YlLMnsJm1hS-BQbVPYhNUHZo5QKtHm5lkHb12MqNIWd42xWyAsQZ0ylscUJak&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdhNHNkBrvtIljrIz8rJ5e4zGnX-KbB_LmWZUjZa-FjA&oe=6AA2D09D"}]}, "id": "1540600874081557", "locale": "en_US", "screenshots": [{"file_name": "screenshot-001.png", "id": "994690586517115", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_994690589850448_9146779381009400284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0k8-f4WdA0Q7kNvwFghQi6&_nc_oc=AdpSpq0mL3gvY12toeaG1hmfcAVW0YsJAD9FouAb-yBPAiUv6KGqyqsiBGum2w6dPME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_99y3vSAPf7l0rnbb4X368s5C8n22wdcH9_W6BQaEXg&oe=6AA2BEA8"}, {"file_name": "screenshot-002.png", "id": "1325636272503399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823279_1325636275836732_910597689988588100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JyLu0QfH_4Q7kNvwFDqL3r&_nc_oc=AdqiK2Adfdn-MWbt3wlABtpbsNfkOsSiyEVcoi-Q20gsA-yXsGwKm6nZKOFjkBHPIRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU1DWXGzI4asdQgLJDZzIKcRI0cHB-3oZUTkybecHYRA&oe=6AA2D2AE"}, {"file_name": "screenshot-003.png", "id": "1166865802301117", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1166865805634450_2357201996220937109_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdGTqRicYAUQ7kNvwFIm3Yy&_nc_oc=AdpptN6_uKCqst03Jso2FhPVFKKGBBPz97Lg2uR5ncRNPOWimaNjWMG5tHv7p7YYoP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-tBmg6u0B8cNZVq-h-8KjjtlLlSNGltcOefVca0jbew&oe=6AA2CCDD"}, {"file_name": "screenshot-004.png", "id": "1316568323519281", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825563_1316568326852614_8413934166065482142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dENQCg17V94Q7kNvwFhZj_4&_nc_oc=Adrsn0RJLav1DGr_rTvZC12WWkpDTnqmIKdtOKBhOY9WeoBjqbcAVD6DioOvkmpmlq8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSPRbI7P750xDKlAAsFH8vx1ObJuXTt8NBcXyXxZCIAg&oe=6AA2C85A"}, {"file_name": "screenshot-005.png", "id": "2179473939560307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_2179473946226973_2535212187393767438_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKgGbwDFAOcQ7kNvwF25C5b&_nc_oc=Adqyc5WCbTy-cQJ23AoTg1TVZh2T9XGdvPDxtlPP2OW0E5lUXAySrkxUkG60FCHK48c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ25u2690Acg3yzEXn7WAYSvp7Xup5B2y9oVkBX0vs5Uw&oe=6AA2A550"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrueSim", "keywords": ["Healthcare", "Nursing", "ABCDE"], "long_description": "Training, Confidence, Care\n\n# TrueSim simulation training\n\nHealthcare is changing fast. Complexity is increasing, while the space to train is under pressure.\n\n# The future of clinical competence\nWhat if healthcare professionals could train exactly the way they work? With TrueSim, healthcare professionals (in training) master:\n\n- The ABCDE structure - Rapid recognition and treatment of acutely ill patients.\n-  SBAR(R) communication - Clear, structured and error-free handovers.\n- High-performance teamwork - Clear roles and disciplined workflows.\n\n# Bridging the gap between theory and practice\nWe prepare healthcare professionals in training for clinical practice through a safe learning environment.\n\n- Lifelike clinical exposure - XR scenarios bridge the gap between theory and the reality of acutely ill patients.\n- ABCDE mastery - Repetition in lifelike environments shifts performance from memorization to intuitive action.\n- Preparedness - Students are better equipped for urgent situations from day one.\n\n# We don't just train, we prepare\n24 validated ABCDE and SBAR scenarios in three categories:\n\n- Respiration - Pneumonia, pulmonary embolism, anaphylaxis, pneumothorax, cardiac asthma.\n- Circulation - Sepsis, myocardial infarction, hypovolemic shock.\n- Central nervous system - CVA, hypoglycaemia, intoxication.", "short_description": "TrueSim offers Mixed Reality simulation training that allows healthcare students and professionals to practice the ABCDE method in realistic scenarios, at their own workplace, whenever it suits them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://truesim.com/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "TrueSim BV", "support_website_url": "https://truesim.com/support", "website_url": "https://truesim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "fr", "nl_BE", "fr_BE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1672444623946767"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_4354887788155587_1453079054611680418_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3vuCIjkYHAQ7kNvwG4KApM&_nc_oc=Ado1yo52WybbFdRenKKzYr_k_cBUkK0b_PNSWYEQb3YkONoHPYpv_MJTKE2GucZ_KfE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9z_3UK6m6_9G_3Tr8BBZgKG-4h0S9ufOuuPihMmBM1w&oe=6AA2BA97"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TrueSim", "platform": "ANDROID_6DOF"
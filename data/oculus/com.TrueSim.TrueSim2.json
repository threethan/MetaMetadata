c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qDrtXkzQbAQ7kNvwHfWxC1&_nc_oc=Adpm0SO9RsC3SFPlHJr6Rsav1rXe1aN4yWC6GUpLXwB7uUElCHKOXfZb2qWFckPntDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrjfx9XEEirzXEfPquwfbWi9bSQ-pPVeaLHvGHvOt_3A&oe=6B0D9C2E"}, {"file_name": "screenshot-003.png", "id": "1166865802301117", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1166865805634450_2357201996220937109_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CR90pVHgnYQ7kNvwEHwMEc&_nc_oc=AdoZhMMpUaZFeO0ayGTrEvHySDXmmS-qVh55SXiNflTwzgwUj0BPRMXCBQRjJAaTGKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzIxEeUCqhJLc5Y6AfK7ngd_0K6CsHaAkMGdIlNoHBug&oe=6B0DCE9D"}, {"file_name": "screenshot-004.png", "id": "1316568323519281", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825563_1316568326852614_8413934166065482142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjAvEHxUklMQ7kNvwFE0fB4&_nc_oc=AdpunbdeDQPpQIkY6uLgcj0VvsIqRZJ0v114ZLeFIqnsapUGYPGCMUPYzY_hH57AIjo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQx4DfNYJeAOZXw_s7jNHy0ra8AUzqwKKfEhr4SeJP1OA&oe=6B0DCA1A"}, {"file_name": "screenshot-005.png", "id": "2179473939560307", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_2179473946226973_2535212187393767438_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82GXAUUb0e8Q7kNvwG35xIM&_nc_oc=AdrRT5MswTlT7ZNu8H4vdh6xfIyyLm08z35sxnLcd9ERAfI9CxE113tQmWgUIrvDGoc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDuyzgJhoeOiu-ImPUvDgLyPyBX0K4TOWXLzUgVDFpZQ&oe=6B0DA710"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrueSim", "keywords": ["Healthcare", "Nursing", "ABCDE"], "long_description": "Training, Confidence, Care\n\n# TrueSim simulation training\n\nHealthcare is changing fast. Complexity is increasing, while the space to train is under pressure.\n\n# The future of clinical competence\nWhat if healthcare professionals could train exactly the way they work? With TrueSim, healthcare professionals (in training) master:\n\n- The ABCDE structure - Rapid recognition and treatment of acutely ill patients.\n-  SBAR(R) communication - Clear, structured and error-free handovers.\n- High-performance teamwork - Clear roles and disciplined workflows.\n\n# Bridging the gap between theory and practice\nWe prepare healthcare professionals in training for clinical practice through a safe learning environment.\n\n- Lifelike clinical exposure - XR scenarios bridge the gap between theory and the reality of acutely ill patients.\n- ABCDE mastery - Repetition in lifelike environments shifts performance from memorization to intuitive action.\n- Preparedness - Students are better equipped for urgent situations from day one.\n\n# We don't just train, we prepare\n24 validated ABCDE and SBAR scenarios in three categories:\n\n- Respiration - Pneumonia, pulmonary embolism, anaphylaxis, pneumothorax, cardiac asthma.\n- Circulation - Sepsis, myocardial infarction, hypovolemic shock.\n- Central nervous system - CVA, hypoglycaemia, intoxication.", "short_description": "TrueSim offers Mixed Reality simulation training that allows healthcare students and professionals to practice the ABCDE method in realistic scenarios, at their own workplace, whenever it suits them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://truesim.com/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "TrueSim BV", "support_website_url": "https://truesim.com/support", "website_url": "https://truesim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
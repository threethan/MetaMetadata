ng", "id": "1166865802301117", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_1166865805634450_2357201996220937109_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2nqagse7G8Q7kNvwHD_e_R&_nc_oc=Ado9e-C-Da0ruGZqORFNQ-BSgTwLFUwCu7w8dfa5G5KDDw8P4P4mhZdn3psuG9sldto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5lT2wzQA-VclaiGoYnawTpcFlUGDQBw72HfQvk-f6LA&oe=6ACBAB5D"}, {"file_name": "screenshot-004.png", "id": "1316568323519281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1316568326852614_8413934166065482142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h3_FL530N4Q7kNvwHJSHJN&_nc_oc=AdoAUyijqbOhEsG8XrQSfDMJiE9GmQoh4E5V3UKqcBTdyikCkjYgO7fHVEiGkH4rcow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeLY9_nZX3neHBcJiY-DvLlHfcRs27NL5OpUz1zvdRqg&oe=6ACBA6DA"}, {"file_name": "screenshot-005.png", "id": "2179473939560307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_2179473946226973_2535212187393767438_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw2QZyhMNa8Q7kNvwHyJDem&_nc_oc=Adp8Wzkgdl11bAe5OW6m6abMkGz9dszZPM5n5QZ43xBkCRfNnsD5nd0YUfX-NLv7Jeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0EUms-reOKzpLrji7dq9ww9JMsmBn6XGK0Jf7ok6rpg&oe=6ACBBC10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrueSim", "keywords": ["Healthcare", "Nursing", "ABCDE"], "long_description": "Training, Confidence, Care\n\n# TrueSim simulation training\n\nHealthcare is changing fast. Complexity is increasing, while the space to train is under pressure.\n\n# The future of clinical competence\nWhat if healthcare professionals could train exactly the way they work? With TrueSim, healthcare professionals (in training) master:\n\n- The ABCDE structure - Rapid recognition and treatment of acutely ill patients.\n-  SBAR(R) communication - Clear, structured and error-free handovers.\n- High-performance teamwork - Clear roles and disciplined workflows.\n\n# Bridging the gap between theory and practice\nWe prepare healthcare professionals in training for clinical practice through a safe learning environment.\n\n- Lifelike clinical exposure - XR scenarios bridge the gap between theory and the reality of acutely ill patients.\n- ABCDE mastery - Repetition in lifelike environments shifts performance from memorization to intuitive action.\n- Preparedness - Students are better equipped for urgent situations from day one.\n\n# We don't just train, we prepare\n24 validated ABCDE and SBAR scenarios in three categories:\n\n- Respiration - Pneumonia, pulmonary embolism, anaphylaxis, pneumothorax, cardiac asthma.\n- Circulation - Sepsis, myocardial infarction, hypovolemic shock.\n- Central nervous system - CVA, hypoglycaemia, intoxication.", "short_description": "TrueSim offers Mixed Reality simulation training that allows healthcare students and professionals to practice the ABCDE method in realistic scenarios, at their own workplace, whenever it suits them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://truesim.com/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "TrueSim BV", "support_website_url": "https://truesim.com/support", "website_url": "https://truesim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "fr", "nl_BE", "fr_BE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825470_782476898225988_1059310295038154387_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Gbq57JyuQgQ7kNvwEN9zpf&_nc_oc=AdpSjU1_WdeOMd3jrvCE2jhJ-JLzOCNBrTRk1H_sGUopKLslOqtqFzv-dOpyITug5s8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBdVEegzjkWheTNM7dPPW5mjuNAkCvC80mVX_v9IdiZQ&oe=6AA5739D"}]}, "id": "1540600874081557", "locale": "en_US", "screenshots": [{"file_name": "screenshot-001.png", "id": "994690586517115", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825470_994690589850448_9146779381009400284_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7y2ZatRvHEQ7kNvwG0IdFO&_nc_oc=AdrqFg3Wrb1em23B5JiSapdd1ksC5ZMpCx8Uak4hCJ6pTkdxlUE3Hupz4u8oIP05_zM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5713fejXHbvIUCFhpthDL5eImDf1heVw4CFfEv4a7Zg&oe=6AA561A8"}, {"file_name": "screenshot-002.png", "id": "1325636272503399", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823279_1325636275836732_910597689988588100_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KqCb1JAZeIgQ7kNvwGUcCNN&_nc_oc=AdqUVUDl8fK9VJbiJMeBiUQFDRP6ecEnQa8PG2if7-qF9d2fGNUH_IOBubvZwCebFfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4tiBdWOYT3tPP84HTAPYpCR-x6je5L5IBIxD_COpSDw&oe=6AA575AE"}, {"file_name": "screenshot-003.png", "id": "1166865802301117", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823901_1166865805634450_2357201996220937109_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJUQI6ZmhWcQ7kNvwFnNvOE&_nc_oc=AdpFONGUqc91QQQFZOPT6Zj2SYLnxEMgakEkZU9wXtbFCyGtsHFCfHr1SnHmuz9Xm5g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz1_-t7hUuLLrTm46gOhyiB_wVJFm_vpSqU4BuXbkAPg&oe=6AA56FDD"}, {"file_name": "screenshot-004.png", "id": "1316568323519281", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825563_1316568326852614_8413934166065482142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-a_wicBCSsQ7kNvwEeOKVM&_nc_oc=AdrQATBDlEPZvpFTJOQaNpv7SnNOAlnXqxV-UrjO6WuyQRb202n1JswTk-OpO81LMTQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg7AwTXOW-4umXJquZgU7Vkh4vOsekJAbCIWlZX5PZtg&oe=6AA56B5A"}, {"file_name": "screenshot-005.png", "id": "2179473939560307", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_2179473946226973_2535212187393767438_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vPLSOTE21iYQ7kNvwHlNlmZ&_nc_oc=AdrUNvzLjccG1fN1WIZYjlV4vzAL1d5C1j4mz-KGZsCl0bVED9D4YVWGcmOsMWyBLxk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfykiL0r91nDRjr3kSGhSkldmTCjU7nYpAdrdRkbvZaQ&oe=6AA54850"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrueSim", "keywords": ["Healthcare", "Nursing", "ABCDE"], "long_description": "Training, Confidence, Care\n\n# TrueSim simulation training\n\nHealthcare is changing fast. Complexity is increasing, while the space to train is under pressure.\n\n# The future of clinical competence\nWhat if healthcare professionals could train exactly the way they work? With TrueSim, healthcare professionals (in training) master:\n\n- The ABCDE structure - Rapid recognition and treatment of acutely ill patients.\n-  SBAR(R) communication - Clear, structured and error-free handovers.\n- High-performance teamwork - Clear roles and disciplined workflows.\n\n# Bridging the gap between theory and practice\nWe prepare healthcare professionals in training for clinical practice through a safe learning environment.\n\n- Lifelike clinical exposure - XR scenarios bridge the gap between theory and the reality of acutely ill patients.\n- ABCDE mastery - Repetition in lifelike environments shifts performance from memorization to intuitive action.\n- Preparedness - Students are better equipped for urgent situations from day one.\n\n# We don't just train, we prepare\n24 validated ABCDE and SBAR scenarios in three categories:\n\n- Respiration - Pneumonia, pulmonary embolism, anaphylaxis, pneumothorax, cardiac asthma.\n- Circulation - Sepsis, myocardial infarction, hypovolemic shock.\n- Central nervous system - CVA, hypoglycaemia, intoxication.", "short_description": "TrueSim offers Mixed Reality simulation training that allows healthcare students and professionals to practice the ABCDE method in realistic scenarios, at their own workplace, whenever it suits them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://truesim.com/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "TrueSim BV", "support_website_url": "https://truesim.com/support", "website_url": "https://truesim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "fr", "nl_BE", "fr_BE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1672444623946767"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825575_4354887788155587_1453079054611680418_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6iB3pklPksQ7kNvwHgcZlS&_nc_oc=Ado9cixH_njjiNiFerAJOcjVXPbh7DBuTCkFlZ15EeVLxizWR8owycgOGVFUcoKtfTY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBFvFPZEARwEKpT6ceLkSg5Ugk8j7EYgP8mc7S5U2kDQ&oe=6AA55D97"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TrueSim", "platform": "ANDROID_6DOF"
ng", "id": "1166865802301117", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_1166865805634450_2357201996220937109_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1wk6EU1ki1IQ7kNvwHzVAqk&_nc_oc=AdrQ5E1UjET5uqQhRfjf-CRhVIRmflUSD33_tiMfehRQYsGohkJzn3TtmI1GROYseEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEHNt6G5NzIaLyABDd-1z-YaspbYlEfziGOKyLR54W-A&oe=6AF87E5D"}, {"file_name": "screenshot-004.png", "id": "1316568323519281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1316568326852614_8413934166065482142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cX3PG-YugEQ7kNvwFm_Rs9&_nc_oc=AdrdaS_yHkxrPOnOFlwtQho9my3WWtyV9Ca7gyh9PiHcCbG0D8y6wDf0vcCe_JV5Ymg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4ShOWu-R7ZRzlp1UW-pAvMoPDBhG99CALudvEG-JRIA&oe=6AF879DA"}, {"file_name": "screenshot-005.png", "id": "2179473939560307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824292_2179473946226973_2535212187393767438_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qv02cy88CTQQ7kNvwGB0cY4&_nc_oc=AdqEAgb-Ox4sc3TBkF-V0EZ5jK0__wCL5A1X9gSKYUBNZwK-nO-82LDziz6zg6w_rBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRp-GDcC4QVQEfHtdpTXM1znsMXXIpsB9EOms1lnYJbtQ&oe=6AF88F10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrueSim", "keywords": ["Healthcare", "Nursing", "ABCDE"], "long_description": "Training, Confidence, Care\n\n# TrueSim simulation training\n\nHealthcare is changing fast. Complexity is increasing, while the space to train is under pressure.\n\n# The future of clinical competence\nWhat if healthcare professionals could train exactly the way they work? With TrueSim, healthcare professionals (in training) master:\n\n- The ABCDE structure - Rapid recognition and treatment of acutely ill patients.\n-  SBAR(R) communication - Clear, structured and error-free handovers.\n- High-performance teamwork - Clear roles and disciplined workflows.\n\n# Bridging the gap between theory and practice\nWe prepare healthcare professionals in training for clinical practice through a safe learning environment.\n\n- Lifelike clinical exposure - XR scenarios bridge the gap between theory and the reality of acutely ill patients.\n- ABCDE mastery - Repetition in lifelike environments shifts performance from memorization to intuitive action.\n- Preparedness - Students are better equipped for urgent situations from day one.\n\n# We don't just train, we prepare\n24 validated ABCDE and SBAR scenarios in three categories:\n\n- Respiration - Pneumonia, pulmonary embolism, anaphylaxis, pneumothorax, cardiac asthma.\n- Circulation - Sepsis, myocardial infarction, hypovolemic shock.\n- Central nervous system - CVA, hypoglycaemia, intoxication.", "short_description": "TrueSim offers Mixed Reality simulation training that allows healthcare students and professionals to practice the ABCDE method in realistic scenarios, at their own workplace, whenever it suits them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://truesim.com/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "TrueSim BV", "support_website_url": "https://truesim.com/support", "website_url": "https://truesim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "fr", "nl_BE", "fr_BE"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["
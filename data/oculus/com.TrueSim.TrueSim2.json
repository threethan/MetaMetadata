c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPds1BQooD0Q7kNvwGC6BdZ&_nc_oc=Adr_SnZ3wchOC92J7hKK9hOosoIbHZXYaUh0Iv6kcwO6-62c2fhK5IonBUwt0V03Z8U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzN_pnEB_vniBu2kdRfTAU8i9bUUok8lGnMjOdCOqzAg&oe=6AFB272E"}, {"file_name": "screenshot-003.png", "id": "1166865802301117", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823901_1166865805634450_2357201996220937109_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9TjytbAfwYQ7kNvwGJB_14&_nc_oc=Adr9vd9CBDNTwFgJWwfPa6xXgNMmwvAzhc9uuVVzsPBo6u_DH1jhLsys00QBs0L0pp0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG_O3SFNVfC_2BqmpshKydvwGb7YPp_W5x1aL2j5KPaA&oe=6AFB215D"}, {"file_name": "screenshot-004.png", "id": "1316568323519281", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825563_1316568326852614_8413934166065482142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cX3PG-YugEQ7kNvwFYAyDe&_nc_oc=Ado0AKj_MfKpYaFww81zKZJTj_P1_t47f4428WRsX7UOHHQ4Vdk4GliLcZWEvzP1YSo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmbTqbs-OPqYQmvf9RZ9FaW68Vi9zGEaZ0GyPK3eFtnw&oe=6AFB1CDA"}, {"file_name": "screenshot-005.png", "id": "2179473939560307", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824292_2179473946226973_2535212187393767438_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2a354xbE-gQ7kNvwF7QknK&_nc_oc=Adptuf5iylHUKVcDVceHrLPEW-u7jZi_j_DJR8tabQ-A62BLEiq5qqALBuk_52i0Ffo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrvR5m98M5fRQzRcaq4R17wFp23aK3d-WtksiSX2M_KA&oe=6AFB3210"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrueSim", "keywords": ["Healthcare", "Nursing", "ABCDE"], "long_description": "Training, Confidence, Care\n\n# TrueSim simulation training\n\nHealthcare is changing fast. Complexity is increasing, while the space to train is under pressure.\n\n# The future of clinical competence\nWhat if healthcare professionals could train exactly the way they work? With TrueSim, healthcare professionals (in training) master:\n\n- The ABCDE structure - Rapid recognition and treatment of acutely ill patients.\n-  SBAR(R) communication - Clear, structured and error-free handovers.\n- High-performance teamwork - Clear roles and disciplined workflows.\n\n# Bridging the gap between theory and practice\nWe prepare healthcare professionals in training for clinical practice through a safe learning environment.\n\n- Lifelike clinical exposure - XR scenarios bridge the gap between theory and the reality of acutely ill patients.\n- ABCDE mastery - Repetition in lifelike environments shifts performance from memorization to intuitive action.\n- Preparedness - Students are better equipped for urgent situations from day one.\n\n# We don't just train, we prepare\n24 validated ABCDE and SBAR scenarios in three categories:\n\n- Respiration - Pneumonia, pulmonary embolism, anaphylaxis, pneumothorax, cardiac asthma.\n- Circulation - Sepsis, myocardial infarction, hypovolemic shock.\n- Central nervous system - CVA, hypoglycaemia, intoxication.", "short_description": "TrueSim offers Mixed Reality simulation training that allows healthcare students and professionals to practice the ABCDE method in realistic scenarios, at their own workplace, whenever it suits them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://truesim.com/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "TrueSim BV", "support_website_url": "https://truesim.com/support", "website_url": "https://truesim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
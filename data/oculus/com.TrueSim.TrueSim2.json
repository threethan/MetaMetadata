c_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPds1BQooD0Q7kNvwHrEcCf&_nc_oc=AdoJ-TLVaqpkPt9v_3vrERELUb6DxNWEo-CE9aOCTb1b_mUz9SIP6I5Zz5-mYvjPfu4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUTZ2yxwCqODmAR2OmOHwMIdVV5R_ulSXhTZ6JX1zJYA&oe=6AFC78AE"}, {"file_name": "screenshot-003.png", "id": "1166865802301117", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823901_1166865805634450_2357201996220937109_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9TjytbAfwYQ7kNvwFldN61&_nc_oc=AdpwRPu3UaxTRh63dUpPiSMbK-wQ9VgkywqiI5__hLKDlVmMOsFRl5NQqMwQNrMekbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqfcqixehCKvpFUkkZ8zUdhJCbIWtJQNRfwkNFd8eXig&oe=6AFC72DD"}, {"file_name": "screenshot-004.png", "id": "1316568323519281", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825563_1316568326852614_8413934166065482142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-SHmIpRaHO4Q7kNvwEkqKgq&_nc_oc=AdqeUhTImgmxK7wM1zle53w0eRaG9yIIbqHfCEMMJBBhylmqtyna7BZEh4qD5le_8bA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYbY4nvsSo92n1M0iYLH4FD-UjRbbBBnVXRd7TqNa7xQ&oe=6AFC6E5A"}, {"file_name": "screenshot-005.png", "id": "2179473939560307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824292_2179473946226973_2535212187393767438_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2a354xbE-gQ7kNvwEthWQq&_nc_oc=Adp0A_vIoAm3qBaKEKtPlJ3wZ81h_1WHFIhTZPSK-Ui8UpRKvDh5WYuNA3cg0tNjAI0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4kVfA1KoJkBD0KD2DL5WXsEQn26S2K0FvbD2ypSy72g&oe=6AFC8390"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrueSim", "keywords": ["Healthcare", "Nursing", "ABCDE"], "long_description": "Training, Confidence, Care\n\n# TrueSim simulation training\n\nHealthcare is changing fast. Complexity is increasing, while the space to train is under pressure.\n\n# The future of clinical competence\nWhat if healthcare professionals could train exactly the way they work? With TrueSim, healthcare professionals (in training) master:\n\n- The ABCDE structure - Rapid recognition and treatment of acutely ill patients.\n-  SBAR(R) communication - Clear, structured and error-free handovers.\n- High-performance teamwork - Clear roles and disciplined workflows.\n\n# Bridging the gap between theory and practice\nWe prepare healthcare professionals in training for clinical practice through a safe learning environment.\n\n- Lifelike clinical exposure - XR scenarios bridge the gap between theory and the reality of acutely ill patients.\n- ABCDE mastery - Repetition in lifelike environments shifts performance from memorization to intuitive action.\n- Preparedness - Students are better equipped for urgent situations from day one.\n\n# We don't just train, we prepare\n24 validated ABCDE and SBAR scenarios in three categories:\n\n- Respiration - Pneumonia, pulmonary embolism, anaphylaxis, pneumothorax, cardiac asthma.\n- Circulation - Sepsis, myocardial infarction, hypovolemic shock.\n- Central nervous system - CVA, hypoglycaemia, intoxication.", "short_description": "TrueSim offers Mixed Reality simulation training that allows healthcare students and professionals to practice the ABCDE method in realistic scenarios, at their own workplace, whenever it suits them."}]}, "developer_name": null, "developer_privacy_policy_url": "https://truesim.com/en/privacy/", "developer_terms_of_service_url": null, "publisher_name": "TrueSim BV", "support_website_url": "https://truesim.com/support", "website_url": "https://truesim.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "h
B-Xu0BiwUkvbylzLkZSV-YB2BaMHGadGCpZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4NySy6dW6UFvybd858qvPjXZE_CRXNLTRYONL-UP7mA&oe=6A31462D"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iA3GdGpuewQ7kNvwHXwuNH&_nc_oc=Adqm8eX4jNNaP5mgEU4wlUyLs5R9r5gmAlwSrzww7mFP_IN2B0-hGnBI1RIsjyxXGs8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LSRDaeRalxeSpr7XCSPwnRyYt6V1QlhoQmQmyVumC6A&oe=6A314B74"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=newhat4Zp2YQ7kNvwH5Ll9b&_nc_oc=Adqrp7eN-5VEFFWcDds_9zj3dpAodKPa1ZCl8O-wuKe_qAP5rr7VyH59yDtYw9bEquc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O8cXlPrshpsMT6h8L6br3Bg0a_WfBuUzWqKF8tcIQdw&oe=6A315ACA"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VHMj6lt97wQ7kNvwEd1X2K&_nc_oc=AdoZb_HDlJtrZq8Fp-xr7avWW4r7ZhgUN6rPQ8HBA5TyP17Iqo9VsnaFd2T36GJ-IVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gkjyS8MEQLAgCrMqS0usUZ0wFe94Zt4ZV8GWvfN_CyA&oe=6A3154F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EUAHbzkaa_0Q7kNvwEvwR19&_nc_oc=Adpjz39nADB8BqKCy8zKnpR8cebzNrt08ORWnroEXpOkCd08HuuDJWIePoWGuPnhctc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GWHgAvkF33_itqNLFa7lBrNqXNXAY-6ROSvcay-kSiA&oe=6A3160D3"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
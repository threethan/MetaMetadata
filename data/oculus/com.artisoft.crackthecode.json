y-pOXTOGc4-DL9YuEYHeMi5kHNNe-heDbibI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56JRsMVdLIwCsdK_KNLOvLOjOPbFTZHygxT8j7R7zr_w&oe=69FDDBAD"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bkomjtW09BsQ7kNvwGNnPXg&_nc_oc=AdrOazqYTv_4WDRL8m1hcPkuJPEDhcQmy0CvNu8f4u6e05Po03ny-HyJ9BsQJApGYms&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TSZ8gsMZxgtfhn8AO8S7lVeSoOxPP50iOSuCcfWym_w&oe=69FDE0F4"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQlhHyReKtAQ7kNvwFvTNfR&_nc_oc=AdoS3g3-zwjzrZzyTZW5hHv5vV-eEOG7y2FRlvp-hFnwCxjpYfMCTWdeD-Uy9utLbtY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wlp8OQxpQqmHkEPYW8KHn6kpBMR6KhPT_KuGXXrLKkw&oe=69FDF04A"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1YtB31Lt9kQ7kNvwErTx88&_nc_oc=Adr0b_hgfoGRJGC8vz38hYrSh2v4fZ0D7-Vrlo6tAV8WiRbq9gIzBdgGp_Zo-Yk5eS4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d8ThgDrXmKkM2ujHVluUwfT_uAyh5PNaFw4bs3njzPA&oe=69FDEA78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV7QteNvDXUQ7kNvwGclPku&_nc_oc=Adoe9bEzrclGHHqkppkhawd-nk-1GdM2Q0libYVJU4wGLU9HdEk08f9f7e-RpAWMy3U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78rUUYjooJ8iXD607pobry2LOs175vHt1l8KiPfuSnLg&oe=69FDF653"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
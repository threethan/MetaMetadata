yjt04qorjy6XfjCtc-K1FkX3KQl2A6WxMI-I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaRaBEOaLJudpE1jeIJCUjUQldFEkQ09KBNdn_flNW3g&oe=6A538D2D"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r35a6NPnVN4Q7kNvwGr8X_z&_nc_oc=Ado0GRHeCtF9DTY9xcjnEL53Jl_l94xiYEKb1gU43msKXRsdciDgCqIHSStbW1q1ujE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxsl5sQrQr1xzBFGJ20U9Fiki4PFvPewNkjwTA0Ukrsg&oe=6A539274"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cHk39HUWT8Q7kNvwHu_TlI&_nc_oc=AdoocZ3LslaBTduBXD5KCG6o7xceIuTO4vjiZ2vR8b3NypT-XkyXRXkYtrQuhv3kQEo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKR3m-qO7LDBYTPhHTqqYWYF3HGaiLqWVS3vryBvGdAw&oe=6A53A1CA"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8jIAioAyTcQ7kNvwHV0BJQ&_nc_oc=AdqKd32__SIGhNtUHr3hd0ciuD9LGkyl2H2IKzZr-Hfk6SXwMGj9x3V7eJoCJ6c4tP0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxfMv81bpGI-PW7DHBKXp2EE87p_rNCLu-MSLk6pMTGw&oe=6A539BF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RhjUTMHsWcQ7kNvwHF0u_3&_nc_oc=Adovz-KLT8OhgL6GEfxi3BqZgYu3TzkFktTtuWDheExt7cNAglrbSjaHhgx54QVbjd4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCJk74glThU4eJYZdZXDfOuZJEuMUwkKX_0qRnZsr1_w&oe=6A53A7D3"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
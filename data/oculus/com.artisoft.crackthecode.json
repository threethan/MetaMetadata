9EVRN0O5L60s43l9VUb4Ks9sgGfLAkRCS3XU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLWT_dfIbEJ_plSypqencrP5JiCUZazyuJ906usOY5DA&oe=6A708E2D"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVKUsVrDAGQQ7kNvwFxKDHe&_nc_oc=AdpI7WrjigO3CVGraBMiskXcQy9rVPS5ZPLC0hFqPRYY0zIW6LyZiIhlDL96U5h8iYU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4dnKH599pXPHzZu2tpbBWnKP5cNK116Wje3AaLRFshg&oe=6A709374"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mT-rdtUxHuUQ7kNvwH4SqLk&_nc_oc=AdoM7_dFYBOKUqNgu7CqwIIS4TMP0LdPAp_hzZTdyTGbwWQU-wC88-UbV2XbhcbzsKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8LjyBudpU_31nRWuRxZGTZ_8nrR0b3ewmTXV3dzWf0Q&oe=6A70A2CA"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNHd3ziTwHIQ7kNvwG4s2XA&_nc_oc=Adq0iTmTESXAytSVKa3vbpaW8qwS3K2AXHLQH5hRgEbsYv3OlYb1rxeRSzfLA-A-TXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHishM6bV8aamabS7YutTH0SN4PIEA0pFS8i1BzPnXKPw&oe=6A709CF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGaCC-9Aag4Q7kNvwF29por&_nc_oc=AdoDiKPbCMgqOQ9ZpCVqMMni2N-8Ozzi-WycQPpXWGCgHJZXeFdaatF_AcF2bb_3kCs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5HeZ22kTaWrlx1IlqPjLLYIqwiZk-Q-q7pK9C-Xv5zg&oe=6A70A8D3"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
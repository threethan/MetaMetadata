Re12mKz01TDK22ZIH-zsaCAC5Wwij69oox8g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mGnGvZFd-Dqg7Xs4Dem6yLkFG_pT3gXig652FQkVNoA&oe=6A1596AD"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O-7_nliqWYQ7kNvwGppJUM&_nc_oc=AdpHCpm91PQMf3AtYE-_zfdRs9YDh062zoOB9o5nJlmvc2Z1iupWQnN5B4CoXJVsN7k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_EMB6x0b5eEnK-b8W2mZtJ8LvlJWWt9wBxW_kS34c_g&oe=6A159BF4"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4JSBhgzDRsQ7kNvwEzn1If&_nc_oc=Adqfo5cCASXz0kDswQ9oF5Yasg7rgRBuRvR6HtZj58UKQir5vQTUv6uTYhxBJFudnBo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jHO7LVV92c_XAsiKXLKOxt9eSaRYZoC7wn4v0h0pCsA&oe=6A15AB4A"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ptqe-e7KcAIQ7kNvwFKaHPT&_nc_oc=AdqcuyoqYPukKp1kcQEfy6Fo6sXRlohjrQotkC-DfAo-f-wS6ppXpgkxn9Dsxe72slY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TlxorbTCZTCcEplVzdHE4ioFTUL6o12kFRsKoCMrSBA&oe=6A15A578"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9crE2Ce31_8Q7kNvwGLWzGe&_nc_oc=Adr1XqLDSIr4Qtmke2NLqtetN-NLRDGLEnLzN_D2Dj9X504O6qv0EEsAMf3P3j6ULYQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K8xqvBmNeUSttbhbmPGcG2pJifx5TonjpaT11_aYV_Q&oe=6A15B153"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
iWu4ctNXLuuUg7sbry_ZUiKZ1blCeI6WhDT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59or0lkH6uKy6fT53Y63yd82gLb9hiJak720qbYt_dRg&oe=6A14452D"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O-7_nliqWYQ7kNvwEtMP5H&_nc_oc=AdqUpxCS5A7cTKieOUeerHSCu0NXHvzXzQ27f8OhuBYmk8RKMA9VMLdpuwJEOPPlj_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-iljXnRT0-XlJkFyoVyPsrlaHhGBGnpiw8Fy6UTTRVQ&oe=6A144A74"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4JSBhgzDRsQ7kNvwE6ZEwK&_nc_oc=AdqtAA1G26nGJ2Qyl93KUgg5R-SS8ySqrAimSLtd9YS3_hPk_b0PbAhZW_qB8hu4oQo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xhOU-9fUP-Wjk54WZK5PkQdbXUFiru9gG7tK9Q1evTg&oe=6A1459CA"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ptqe-e7KcAIQ7kNvwH-lnyx&_nc_oc=AdotTYwOEejWU7FKv1GwD1pHu_9p5rziQCU5EbzEifQQ7Et08fQizAYAvdLbalBsvdA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t45Q4YZslSAy5UucTKakgAiPFCBoQfk-YpT8SkvJa-A&oe=6A1453F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtGiZhYkUB4Q7kNvwFihdaM&_nc_oc=Ado6FzIV0bJttLpvBBuEJ8035m53wGByeTr763GyZgqs0gA7CtURLP02RsX9uaWn0tY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ttLZHsdgkpQmYSf4h4gSnKm7A8Ee0-2e41ZWprUP5kA&oe=6A145FD3"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
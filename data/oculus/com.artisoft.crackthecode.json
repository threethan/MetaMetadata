WpITH2DuzNJlwLE5buXSI4wLkGWRST4XZtJRPWddeYc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sbm1ECLoO9Xgk9MO_EZg0RTn7PXLPi-2EXaNERtHtjA&oe=6A36C46D"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d--sU1o9MLsQ7kNvwFXFLJj&_nc_oc=Adpj79YU2bwPuASVh_WBmoLSWNEkVpbtAFP2YPX9uY6uSSC4c5YE48CDoOrrsfBegGQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qFoWpeRXhFG2dv1idZrHMEYLK-mflal-Ma_ocWXBF6Q&oe=6A369174"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEVJX12ghzIQ7kNvwEMu2Eq&_nc_oc=Ado1MgvsjqbjpHNC0xyBjJV3fsuOYL1LcTEFi7VyxkmUyG3drkVOmYcS8REs2BAhV7E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sbhC40cc-zDwOvaME3BGVPBT6d1IxgFlBTcOJJ8LLKQ&oe=6A36A0CA"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ABkgGJgHAcwQ7kNvwExKhfL&_nc_oc=Adq8ZNkm-6gniWWtGer89dXYtt1j3Rx6kduCfSUd5P0fZc6UPU3vLANYyvCSLWzCuwk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sEn_o__bfEeXk47tqKVQeeR9mx8OtnRwLZMmbBGjnWg&oe=6A369AF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UG1eRPt8LJQQ7kNvwH81yxy&_nc_oc=AdrxrpV3VJ2c74gmzOaAKDG1h3CZMqssel4c1K5fhJfbYGVSIIWzRMdNwWnX2YWsz7s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_g8phR2L-WrDzkYBzhs-E7tqq3DgDXXTQfElp1WH9Q_g&oe=6A36A6D3"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
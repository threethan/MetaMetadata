bwA5N4Ple9LLdYVV6OtKeRjN97vTK_uwU9YA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZlwkFxdVkiPwksv55UsLxH8qEl5bCSbTajVFOFKYOBQ&oe=6A60BC2D"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tllR3aopEfwQ7kNvwHrKFu1&_nc_oc=Ado8pU-CIHfasBpsNkdVnQh4MnS_whJ-NZAcIumEjXikY3P6WtvoOqtOjdFfSQx0xkA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATqKEl8rxnwqWwWgahBoTnbYgwZp7QPkgsSecTu4HLIA&oe=6A60C174"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6_nHmTsw2UQ7kNvwEFdp5i&_nc_oc=AdrJo5GOwgDP9gOwRbOSYDOUDrd3JuFj1YVUa0VmbVkJWB_UAw31BKpY_QlJ8Rj6Oro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvDcTObw2O2h0rg2_43AVzVN7PUPvCkFTjyDH5Q1IpYw&oe=6A60D0CA"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9ejhEqMHSAQ7kNvwHgn7Vy&_nc_oc=Adq5AQMFBe4YeIfv8hyauvToHY693b9GrRLsxFb3UbghTCxxGC_7snCdd7Cs4aTgfgk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI0QP5nEgXJDc4BLN4Zhcg1GIu7xBFBSN2MAiz-l-vSQ&oe=6A60CAF8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZwTc9waHXIQ7kNvwGnArKR&_nc_oc=AdpF8mz8iHebvIofSKdjsP43JT2RRHUR6T3NJ7P-08DUB3J29dQXtZqs8ShD8N7wyM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEbdwP7hbDVoqO6Vg_gHKMWWVR6rvYE28zHwA0rOpW1w&oe=6A60D6D3"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
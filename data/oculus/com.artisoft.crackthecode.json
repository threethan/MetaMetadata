ZIl6sMCMoSylvsUq9eCrt9bEJiarbHz21IcQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXzQnuC6K-VME7qKib5_GshgxcjduHpvAcUE23xjH_0Q&oe=6A68A52D"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m52Jrd05H_0Q7kNvwEuK6rP&_nc_oc=Adoy_SzAzQsXOg8j-O4Bbj4a1w7t_73qwJ47XbUPkhNG3V-d0G_tNn1XGlLZZcjrxpQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqbMZKbA0F_pKPBSWEv2gaYQroJbyt9_iAZFfH5w5Jdw&oe=6A68AA74"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkQmVhreHGMQ7kNvwETuw7e&_nc_oc=AdpfAic97V1Ux8OUjlgmSexMU7WlL7YTpiFYZSXdhGH4fZgBzMtE3wtPozisfDxJkXs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGaQMgYUdzDn9L39TApRcfbGHWyDEsKQMWcppxYyqL0w&oe=6A68B9CA"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqzWex1kr5kQ7kNvwEhXBLQ&_nc_oc=AdpwgZzbGjdtqq8O0Dt2K1ek8mhOQaF7J30UIaKbV1iu8kOyhyLUzK1jlcHAXtQoMPk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-8mzTFl9hWAavX3WvYVwA-UUQL5BOmeOw6ljz_DxOPA&oe=6A68B3F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbjyIJbnCjAQ7kNvwFWkENH&_nc_oc=AdpWTmgvMFFB46yjAleOU-Qz1djNHO9BOvk8f8C87sjixvy5IR_m_roMhatXh2UWlms&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMtYN2tbau2NSPYYiBWoheZatD5fXvYSZ2l5DaMtlnDQ&oe=6A68BFD3"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
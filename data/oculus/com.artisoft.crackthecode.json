EoCy79El-rlbQ8mZTU7Ohv5g16W-L74i3owM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJJ23amUuwlVAZHey9yYxxaDsLKoLu_dM7pxK7zcWIlA&oe=6A5F6AAD"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tllR3aopEfwQ7kNvwGjI8BO&_nc_oc=AdrZfQW_SnWuiWSOHo6KD3KPzMsE1vsYaZJDReuGt6zjGDoV67v4_Dqk6CkgEQtTEDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVxBKD1_rA_ih7inalSBNa2IfV9Lf4hKyDhQQbHfV0Bg&oe=6A5F6FF4"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6_nHmTsw2UQ7kNvwEUN4Si&_nc_oc=AdqMAG9eIBHIKRx3sjrVK5t4rq4n8QWOCKJU9fMr57yZluDt_ymQp5080bR6OcOyooc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB97xKx988T37zaq1OfcO-mz0_F9a5_sJkJjUmGBlV_nw&oe=6A5F7F4A"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9ejhEqMHSAQ7kNvwEDNTEZ&_nc_oc=AdpiM8px6A7kHow6ZelmoOa0wzUCDPt5lggXGyawhw3ZJifqAxkxYdOScHV355Gd27Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsRDSeWo3IukLLje_jwRqZnz475kPkonyCUovb-gyQEQ&oe=6A5F7978"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GkQEPxqFKwQ7kNvwFkw_0z&_nc_oc=AdrHxTXBOEnU0aYYLDmNLgA4lEyEzRd7M7HjB_OsbxN0urL1xr_RIRETw4wWEeUStAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYIsbsXId0hUEGqddFJYJk1rzBkMdNmwMPwB575Ws9hA&oe=6A5F8553"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
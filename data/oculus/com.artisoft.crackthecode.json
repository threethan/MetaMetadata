2_ZPZOHleZ7zjcgqaVs3o07nhYeztZ9LI3zo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xje_09pHEVrUxnC7dZpDtRNKR3jDuMy9rbb-uT7B_wQ&oe=6A1ADCAD"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvTNBb1HL_QQ7kNvwEbKm8N&_nc_oc=AdoHxdaqog7ZUcnb-FwTHnHXRIS_-WJaaFZ1a60j42IacsyxVjxZRtwlPURUSIrRjVc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69roA1HXAM_QMXJNQxexPhf3ryCOeYaA4rt0yM7moMIg&oe=6A1AE1F4"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IprKHx7xu6EQ7kNvwGGPmyi&_nc_oc=Adqh34a2K1k5zqgTLl4-QF4udQEosCKypn_dczmGiTx0flVT7oeRBPlctAuy9PqUfmA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66WQxtLMHWUBGoDpNOi0VjFafAo9uzyNPDHkUQwGde1w&oe=6A1AF14A"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGJqSgiPoxgQ7kNvwGynAWg&_nc_oc=AdrwwRkvBbZMqHahI9VEogJenMjXZTbZ-O4JkRvbKueQRk_ZEs7B0NIxXskwnM0iYvU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gO436oUulRFRb1coH-0LvSh0cGYon0xKlQeiOdtnQmw&oe=6A1AEB78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1ChUhaR8AwQ7kNvwEgiLnQ&_nc_oc=AdrQkR140-ypdH19DZzimQQFpNdYNlvZ4c8jpkdIRRQompvNqNEN2_mrbPMeON_HZ44&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SBPXkaDsFaWggZ1ZkBqpt3vR2i-QksMOHZdYPiWTHGA&oe=6A1AF753"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
I_P5GfJ6AMXjR_HA9KqSb5FsJgB8MQOvADWQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gLHyDXwImt-XVKY_VlmjXzq4Xl9NnpYn4B3kPGj5p4A&oe=6A16E82D"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6O-7_nliqWYQ7kNvwGhJi6b&_nc_oc=AdrR-W2iglL-xsAATUYK4pvlBrcD8OoThXow8x3IkLHvS-V9R8cnV6Z6dcP-lpWe8T0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BeRHcfuLTFl5zYvUFPLZbhuT-gi04queOl6poNgjUEQ&oe=6A16ED74"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4JSBhgzDRsQ7kNvwEEXE7d&_nc_oc=Adq0KkHQwdGHMvSVoEQ0S-p7a93RqsXJkWtqnvLLX5TyAN4g-_QdqACWIxZSAQ-216k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hJ2_IVpGsJ9ELeCNbM9oW-P-Z0YNd1tpnQ70X9bapBw&oe=6A16FCCA"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ptqe-e7KcAIQ7kNvwG0OZvq&_nc_oc=Ado2c0jCoteViwZnaGzWJJ6eINPYU5UUsAcH-4IymrCqBquexzSz4rN12p73ZygXxjg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WXQKGpI1dljQ86xFbC6YsBuRpx63_-CYXC420_42RjQ&oe=6A16F6F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9crE2Ce31_8Q7kNvwEhExAj&_nc_oc=AdoN4gqYU3hPCFfZG5KgFHuBIru-9qB1RPV73T7VuaBqYQl95SSqkAquUgIXWZP6cVc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yAmzwtATtP99HYxBNDAxjFH33SbPZMP7MhlCrnai6Lg&oe=6A1702D3"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
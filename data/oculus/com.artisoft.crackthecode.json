rzd522jWK8aAnwuDeBMgOop2unnJHHv-PZ9pbDuNbuc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96YiKtdwsfmJWeK_CoL6xfrDdf0NGQ371X_P8lq05aXQ&oe=6A22FDED"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuQHJbUyXjYQ7kNvwEgPd3K&_nc_oc=Adrx1-Cc04rijin9u_NF28o4A5zk2gX0LCVEzF2xLFX91ZhyuZY9UgYfgcChWgCbS0U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3Na5xpUXrctYo0tCrNlFuDltvZAvI2p5ZgY1gWxjbgg&oe=6A230334"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2srXvJCsNFMQ7kNvwEk8dsK&_nc_oc=AdpC-kNbnx_DuG1kQDgQfeLisqxyjaG25jYi9hQeAdzXoaIiIEaBxYhEPEy1GBVCuCc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YQEU8OJBA1WU0G5uhQb2JZtC_fMSLWOg13j4yOKfYUg&oe=6A22DA4A"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7QJVlYllI0Q7kNvwG-CrQ5&_nc_oc=AdoLX6xUEWphUWaTgarfGIYOq_BVlAVX7ejzl_wzJGpsrFTfCnpu_Y2ZXAErLatTS74&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0zXDlCS25LXKcYtwA4xZjalWVndyCxbzRPmFeQCSVog&oe=6A22D478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ey0kFo7UiSYQ7kNvwHHtxMr&_nc_oc=AdoRSFqAhS2t01beZFAKG608c2M57Re-Nisc13HRX_LkeobYKHJFjzp7ghd1XPozF64&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kqdKfRxfUIcqkKs_x5p6q1vmvktARkP0R8R1k7eAvKQ&oe=6A22E053"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_de
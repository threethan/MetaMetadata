tjyiKtrO9nfvb_ATe8LoGIdseoj9oVBKzGuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fffDZ3nKhcDCkOya1XXqXTQJ6Mhga-MlZ8GudN-ZxOA&oe=6A1D7FAD"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qpdzjmvl14AQ7kNvwFP61Yv&_nc_oc=AdpTxL6oEn1e1wttfSsQ5lllNSKyTpgGMa1RWOBAzLYUvDKX26_iRd4lso0liEAOBjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dlII-ZLgcxbIaJsMk6PH3w74etAXuvazYNUa7GqtVBg&oe=6A1D84F4"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEMNDeIpckoQ7kNvwFy5-a9&_nc_oc=Adpiuv2EuP3-Adu-9Jx8gdHRdM7Kzml82djcA-jEoI0MTGLCk2YeAXiTSVpKBMc6Nfg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MpeWtg1FsDKmiWYJwrqpuNo7ZLeEpDV3KS8jaCGG5aw&oe=6A1D944A"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PNX3rzXJnxgQ7kNvwGNJ-3Z&_nc_oc=AdpvQ1W8Yp7T1g4PIbgNo6sgIwmU43SfIf_M1CuoAwNB8oWM72Yx5s4FDJhR-PKvIs4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73lorH9jX4g7pCjELBVr225ZAyK2D1BI9u3Ax6W3zFDQ&oe=6A1D8E78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8un0c7KVRiQQ7kNvwGe7OOL&_nc_oc=AdozXCAkCsFB5mNjUcAbKMhTpd9k4TxFP2Uj1LqkvdlY5Yj0wio-fjV5wG0birkEPP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q1Z6xNeb648GgL_qoqu0G5bX3t5Q7NFdUbu1r2vT0GA&oe=6A1D9A53"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
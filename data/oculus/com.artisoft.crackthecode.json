S-aRu31uAZy1Y1hstj_qjD049ljv7gDLIoJ0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5ruHtes0NFAy6AVkLlnYOZDvpzYQ7PeTJhhoidZ911g&oe=6A4E472D"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pEvtMLyzD8Q7kNvwHuBJ3v&_nc_oc=AdrX_9QXk4YoR1w9PNJ2MTUezh4E1tHr-7Kfcl9Mx0zyra3TIR6xPkuw1LlvCh6-aHg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByRwlVDjj-7KKaJmjI110_1Ts9dTXN4kZMkXoAMQH0XA&oe=6A4E4C74"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQ5uwbq_anIQ7kNvwHUZydZ&_nc_oc=AdrGzn0Y7s8ZXceemHvARslHzFEwldyiZSe9gL2JZBllddDC5GtaYt1qgGPmcliLeow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVhgeLHKcFx73POCeFHHblK0odbMDSF2X6YzKdzxwNwQ&oe=6A4E5BCA"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cq4Y-q_MZrUQ7kNvwEIgype&_nc_oc=Adom1upNiWuqev5AVtgS4-x2NftOQg_e4GaJh3mweuVGHOxGuqiKe-uHbdAQUpG7Kmo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkwcsZabOSM_ytI-gcQH2AHWAPUUxf9C-Nd_AwVzN4tg&oe=6A4E55F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdQCOtvG7D8Q7kNvwF5epYm&_nc_oc=AdphX-KB16gggGS4BxBHKHD63kqxFnxRXiyr0qROxTzhLgqMaAy25BL-I3o22OWVANw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOgjbb4tzin_StHiM_nZ1isW42YCxXPZ3DUUF9fOIPaQ&oe=6A4E61D3"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
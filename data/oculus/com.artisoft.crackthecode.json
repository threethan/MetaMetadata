0PIK3yn4Q5Hdw8TAj2i1Eiqsfmy-tGk0ZBdE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RVQ_jkgq1paEzOgijZQj5809FlL2WjiSzs4A3t89s0A&oe=6A4269AD"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRUz10YGzn4Q7kNvwF3wqv6&_nc_oc=AdpSnThWvG0-U-am7tQ1I1pK-3WbbchTybtAZM0uO3YIrcuISTf1P-dFpu9hqIsCpkQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1dHXvkvRN4v9ER-sqQFC78XTCQgbjes2g_FdWk199lg&oe=6A426EF4"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V2_lFytttqYQ7kNvwET6A2l&_nc_oc=Adpoo1iLeg4ZGncjGq7TMOPuzvxj2bhK2q58L0Gn_gFB80Z1oKQdFOWDRsXHQdv45dg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nI3rg8hKtU4z8mF6Vd7syFV1mXSaAJP0LTStxa368AA&oe=6A427E4A"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIsUDYAG5d0Q7kNvwHILlqz&_nc_oc=Adq5-emkkcdiQxK-ijohb63Y7WuqmfE0DYMr_U9mlEI2kYWKCBQIYFJOjkx97GxFO2w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rVVVevvpyQQ4mJehy5KUsS2S1uXAfBvIK-_XHOtLznA&oe=6A427878"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZD2XePvV0nEQ7kNvwHlnAuQ&_nc_oc=Adpk7Guk5kksFJa6rxrsWTwdpQ5HSXzAkY5pUiOW7OKfkqovlFFueYbKUdr881s7F_o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e70Zkg2EdbLdIKg1dfBeykggPMA4irwI8cue1CrsUkA&oe=6A428453"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
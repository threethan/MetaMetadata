RtIziiYXaWugy9DtXg5S-yVhbvCfI6S3IpRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w0MGiatrc3iOcL73-NG7DKEgsQFVTE3dcdkmDHZUGMA&oe=6A04732D"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnrvYF9bUjwQ7kNvwEyzCP-&_nc_oc=AdqNeDszF-C9vXLoJhDtBBjkJQz6YmheDbCny9VJKn9opVKQGqmwiV5cdO35dOctgqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GhGwgj6M6Rjn0j2UzrpuxSu-TwUNa7FsqBwW_G2jG7A&oe=6A047874"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b27OXCkQ9oMQ7kNvwFkY6Qg&_nc_oc=Adp9pjfInjxfwmxpe5a7Jr6kQQJ5twV0ihWPL2UgQflDxuHSjZkYBNbZ2GEkRL5_SI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Q9qBrYb7nGbm1kl3C6e6yq5UipMUGRfbxRJ5XYiRPnw&oe=6A0487CA"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oc2ZnyGcXyIQ7kNvwFL6VsH&_nc_oc=AdrSQYdhtcOOZWE6PBPtmTDYOcn84H4AK_GAzs2UENuOemDgZD8Tl6xEqsMMmRi1mCg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C9Xsuj2PpEDiATmMPkKs46f-KPD61QOasg0IiK3fQ4g&oe=6A0481F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGTvhR69v84Q7kNvwEmfoD5&_nc_oc=AdpFvdQem3r6WjlfNKhRtuuZmRNLDvZErQY1xVWKqgOdZIsitj18C5mnBbRvfCsWiI8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aqUpVvTYnR_jn2TtdJOD968rZsgJK2HB9_sWszvjRmg&oe=6A048DD3"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
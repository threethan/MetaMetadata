BIu_p79YZjS66FKC1zzUb8v9Pep7434I6tMI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zX3f2CCYLlh2rkOxPECuF6RomciPUh14dPsOtVRxQAA&oe=6A09B92D"}, {"file_name": "sc3.png", "id": "6270730466313440", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031612_6270730472980106_8190040581208549115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wisaOv0KiAsQ7kNvwFwbseJ&_nc_oc=AdozHcK1TM4q4IFm1LOdwzDuogGRlu6-AxbKDJT2yGWbeN64ZVHqZdC1e8bNACY3DvY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44kmeWYDszPtgr0oMECjjf1Yi_Qy8wj-mrBn-YHjVL8w&oe=6A09BE74"}, {"file_name": "sc4.png", "id": "801009518208489", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974503_801009521541822_5221848288115427578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UB1VKnvs-XcQ7kNvwG_bErR&_nc_oc=Ado8HcNTwMFiN35H_fBNmcX2hNzGjq1MelyS2NfH_ak6Y09B5mlhlyYqwLrc-XG8FS4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7frutWGRicBkIbxO8FQMEgpJIj2Te5PHNKPQQNeyD3yw&oe=6A09CDCA"}, {"file_name": "sc5.png", "id": "1899108710489742", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982617_1899108713823075_2453402927026108180_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=563CqnB8dIsQ7kNvwHGaimo&_nc_oc=AdpaS5RFibbYL1lgPHojv2HaCLijH2Pu9e2hy8QYYaMipVKfzU74g2dz95eCucq5d9U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QS0rb2ObAnazQ4Hdhp2MzZdmZJdLQnY1xO3q-8U_B3w&oe=6A09C7F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape.png", "id": "1208463843149612", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974909_1208463846482945_6765298824796059065_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b06b_nLDYm0Q7kNvwGhzR-w&_nc_oc=Ado-0Dxr9SzGIHw3vEaag9BXHCWMQTDRj6b0BZfAv2BovuZT-hSjOLZvh8V_x-uUMaM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ejP_hF0kAYn_Z4uZhm-AbfFUOnmdtF_ByFi277vl85w&oe=6A09D3D3"}, "display_name": "Crack the code", "keywords": [], "long_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says, there might be some hints.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? \n\nThere are possible blocks:\n- Move\n- Turn left\n- Turn right\n- Grab\n- Procedure\n- Loop\n\nGame has support for hero voice and you can enable subtitles.", "short_description": "50+ levels with increasing difficulty. Everything starts with the easy ones, so you can get familiar with the mechanics.\nIt's a game for the whole family or for solo play. \nGiven the available blocks and available space on the tablet, you need to move the fox on the map so it can grab all the coins.\n\nListen what hero says.\nYou can also unlock some other small games, that will help you relax a bit.\nAnd most important - look around and find hidden options - can you make Foxy happy? "}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/ctc_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://ctc.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
at showcases a scene from the full version of That Dragon, Cancer.  \"Sorry Guys, It's Not Good\" retells a pivotal moment in the Green's journey where they are given the news that Joel is terminal."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thatdragoncancer.com/privacy-policy", "developer_terms_of_service_url": "http://www.thatdragoncancer.com/terms-conditions", "publisher_name": "Numinous Games", "support_website_url": null, "website_url": "http://www.thatdragoncancer.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "5051431344877491"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/12138991_576317275884716_3341264649667477504_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IP9CHvQI1wQ7kNvwFlxjdA&_nc_oc=Adm6PksWgxhbxqafJnaWxdttqIf41p3CVKApGqbv-p5IXd-c6re8A_b6_wDFx5ZMiBM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfwH61TLq65BKydffLN70d3pdZ58-yxsKh_TrS-bAt8qdg&oe=69AAB49F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "That Dragon, Cancer: I\u2019m Sorry Guys, It\u2019s Not Good", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1478678400, "lastRevision": {"nodes": [{"id": "353465021667267", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1086522398130218"
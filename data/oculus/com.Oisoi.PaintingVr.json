vOdhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9xtzlNreu3J78scXYam6gYD9K-k7-62oZKTbeM8Mscg&oe=6A62160F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zvtl8S0jkEQ7kNvwGL_XNH&_nc_oc=AdrE9Pmt_k_ccdKftx7434mdjCZ_d753dvqx01udpoud3cHk6mktEIIiiaXk4wZiOtM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAi8yul6HFFM7onEwL4Skta4_mIXcOIoBxUcbvEWwoqaA&oe=6A6223BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjvlPifkntcQ7kNvwHlxuw3&_nc_oc=AdriKPQvpTx0jsiKlKK2eyVTBLL9xRlMEmHiSWgATeO4U1D-pIyTevqYOl9nrzNUDLU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2iogye31bbij_N105tXXy6JkqlGoL_Iq227-dx3IAyg&oe=6A621E15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_terms_
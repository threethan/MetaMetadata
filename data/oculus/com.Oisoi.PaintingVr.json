MP0tiWrNV1CZaVYckeCYLssV_sP0Cbuhu9v5PhEm8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lp9hu0ugjXZHlTi3PrLQOSZvpsmTRIvJdxaaioAbznA&oe=6A01D88F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEZ3gcYChUMQ7kNvwErK9tF&_nc_oc=AdoQuHvJ1FLnuGx_avstS2cOpMsC6b_id03hoT2QIISLtBc4_YMphkhnjL5qXhmiw4k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jywWD0VSKLTZXqZceV90pzLQ8V5SoBalCkRGUc6yVuA&oe=6A01E63D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hgAJ9CpJZQQ7kNvwHHAyY3&_nc_oc=AdpFA7aa4XmTlj0q1VvfkTV5FVXd9HUvlBDpFbiNl3tkCneJr5YeIOGYOcUKfABVuAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aPXaHVNwUKAtX8We01-NwxKn6BgVJSnJivjz5_EeUQw&oe=6A01E095"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/priv
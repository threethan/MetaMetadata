2IF4_Uv3Qn7licU2LewAUYIOfDpephiOvnXi4ZcZs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VQwl39B0TrZvxoUVtJohbME0Xz0MRJhrJxq9Ee7oqjw&oe=6A1AE50F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKyGKbEYh4IQ7kNvwECb87j&_nc_oc=AdoJHDwgDPrnJs43u0RoOwmwkR9qvu5wVnw7znDYdWdwhKIDSUd-sHUQkzVhKHx6o78&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZO6uoBHeSZWzQvbGN9QR8llXB9sG5i6HnmJuvJHmCsw&oe=6A1AF2BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLZg9xbY7JQQ7kNvwHTttFz&_nc_oc=AdqNaKE19RtsNoOtJNG52OcYm_2jMzVYBsXL9pKBzByKoBdxEerg_zteYRfDCzMvucE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75Zf0WA9Zv8sYxFQE8xOYqQU2vzoCUbRwwOwUZrs2xjA&oe=6A1AED15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/priv
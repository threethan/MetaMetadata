kR4OzaCbmLtArqB5iwPDfRQmBhulOI-umXddwrBRo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y916ha-N-i_9Riqam0LMAUkTGsstz2DetjuHVsHSzaA&oe=6A16F08F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vat7NWhUizcQ7kNvwGVXyGb&_nc_oc=Adr81QzYZvolsuaMcOQJDlYw97k7q3QYFRS7C_3Qqba806-sS1VX2Z-hlXEsz_7k1O8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_uMKKME8yqs6GqQouYiOj8cwQy47FNbtd6-haKgMbbg&oe=6A16FE3D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgJc93B0WEsQ7kNvwHz9z_I&_nc_oc=AdouksalXEXEVrnHdIO1XXt9QNnYBZs7CoxhehUPDEu6OhpTSJJzTFA90w4aTwxqVWs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68aXJVf0sk3HdM3ZA5sN1vYXKUXMuVwAJ8zfTxHz3xBA&oe=6A16F895"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/priv
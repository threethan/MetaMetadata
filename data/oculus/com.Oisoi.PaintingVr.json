RgWH8NQfsExixWAgj2lVeHrG3kWBvHY2Z1VaYKIlM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MhQppQsN-jT-zDVmnsVmebpIsPyDnXzsASvgy-wf-eA&oe=69FDE40F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I7KwiBkMZuwQ7kNvwGykQqm&_nc_oc=AdqGClhzWpO8ZEyzGDQGD5cMp3wcQeaH6hE4ur34NOt8qLiD-76fwtyN--VAWduUYx0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RJhEQsfDLbReiqhdxEjGfnYl0pcSS3_VYIik7dncIqQ&oe=69FDF1BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAW58pJoAn4Q7kNvwFR-rly&_nc_oc=Adp0cLvEBUdoJAPHndLQGXwra2vegbjPgyR7TlEtHIM2Y-M0FJk7ztjTCVt_D6s4oJ0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50cnyGF8MTi8MrjrwQ8uaW7g2osa9Q6RciwinHgr0hGA&oe=69FDEC15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/priv
wFpcTTG&_nc_oc=AdlQJGLGqCNa5mgqQgKW_nm8snXq0fN7LSkm3vhbAuJyhnzNlJQzbb1VFrnzAqEE0mA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftQAIB2ANSSJ_cTEXlx-CScEa4kXnY8fRYsWlYkJ5u8GQ&oe=6998608F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCsLVXIDDCQQ7kNvwGuzDuT&_nc_oc=AdkrzgGIrI230mW0jg2fcpyjUOsGdvJ1SzexeyEREn-JhM85ZSPhCs5VN9ArkqwHsqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsNdHSely9Z459z6ffYql5ewSoZIBYag21Inl72RnhuQw&oe=69986E3D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPTY3LCSZnkQ7kNvwFZ-VK1&_nc_oc=AdkysS5hhdFI3VH5stWe1WLXWfQDWOP-wwnR4422ZDfMyF_dVcDyrJ1m1Udcq_KiJAs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftlE3OMQz3mNfTdVbe1iw0ApKxKXYejE_RyHqN5YupmWQ&oe=69986895"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/pr
ilz2s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnIkinxhmxyfMFxYYWtTVB0kED18DZ9ncU1zlLFGUlYA&oe=6A80688F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqRHVGtE2EkQ7kNvwFBWPcp&_nc_oc=AdoiljWuMS8GUOGX1els2Dq-eojR6xxfztRBm8McoDs7PSuT5Ax-Su2yQcal4_tXeJ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ7T8MInG8vphhUzghHfufp2Ul9nnYG6bHQM8iWhGvyA&oe=6A803DFD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8jK_Flkk9BsQ7kNvwG63M6h&_nc_oc=Adq86N_9MmMjfs1FilB2sP_XY0E0KV8xvDuRjVMEMHftZ3ectJH2NB1iqrD9C5ZoJ7M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG9yHCf5yuH78l7vUoQ9_gC18paN7qerP5u6LzuP2LYg&oe=6A807095"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_terms_
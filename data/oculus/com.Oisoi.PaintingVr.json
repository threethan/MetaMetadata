FnOO8ybI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qXkUdxVW8Sr_NKrycpMDh7xyaUWRpMi5scUakScj3oA&oe=6A241F8F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9F5Gp7MGB8kQ7kNvwFbr6Yn&_nc_oc=AdrfBv9sCojTTVmHw4BXA8buqkPWg-AZbIE_nAy5gqA-ozIglCspWlwBIlxvscI9Dck&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xsp3w4oXRi5cFSZggMJRPLcNN5plHzfr3JZ4o0I65qA&oe=6A242D3D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Exi4BnkCHhUQ7kNvwFZR3-n&_nc_oc=AdoSxG8E2sVCZ-iv0wliO7pOiLnMa0dSwSCGTCYzKnahA3hjdDXcQo5RGqoUbpAzKLo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pno2Jl5GsqLATBMnLdcqosxyU7_a6SLRFKDafnoI2MQ&oe=6A242795"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_ter
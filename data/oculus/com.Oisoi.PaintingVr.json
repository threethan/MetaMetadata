_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy3QMMMQRJEm3fkBrqJ8HPBDJ5ih08onbp4UJeS_OshNA&oe=69B3ECEC"}, {"file_name": "Stills_May'23_HappyHues.png", "id": "823131322562239", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75240098_823131335895571_7345743809290845782_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtoGgjeSQwsQ7kNvwHUEK_P&_nc_oc=Adm7XcS2qZBF0aXkAJ94uep1-xxbse1nU_YSflLEJP8-rzj0mapvDKcqezTSIA-z4F4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyvm-tE7abzhlDiYHapbh_CYkls147pX8iNrK0CfhVEJQ&oe=69B41B19"}, {"file_name": "Stills_May'23_Painting+Envir.png", "id": "788455049219078", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615891_788455052552411_3926343213990677300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N8uWmr-O0AQ7kNvwFieTyD&_nc_oc=AdlC_-1iROwlboR2E1arCmxoNohcTcpcsBIIN-zWsxejcnin_ZQlusHCwCJeuQoOQ5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx2oeFZSWUJaOFecEk6nxQDXODbvKzxVAImtCsFtoSJuQ&oe=69B3F662"}, {"file_name": "Stills_May'23_UI.png", "id": "560254039552163", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422369_560254042885496_462054519402168863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKVxPUrrNGIQ7kNvwEzmdEn&_nc_oc=Adks8t7MX0wds_tGzxqO9boGrndUOxMsHKZPuD7EM0FywX1sLcyDweAc-ctQIEMpUX0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzm-th8LSQeWdzDcXVyy7JYpCLYlmu2nL5VovGPZ03QDw&oe=69B3FF04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 Render Final.png", "id": "963357088178104", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75505859_963357091511437_666998212360027310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUiFNeSSyHkQ7kNvwGU2knD&_nc_oc=AdkWGLM10Av98PG94dXLX1GLWN15abQUpGLKHd704U2WFgNqQAqpafRA0pArRkBkLwk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzSFrFy99yCqzTsKsdEmkagQwS6OqSEkTXojZncjR3kkQ&oe=69B415B3"}, "display_name": "Painting VR", "keywords": ["art", "creativity", "studio", "social", "relax"], "long_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. Play around and feel the satisfaction of putting that first paint stroke on a blank canvas. Learn the basics of colors, the painting process, and composition. Sharpen your skills by experimenting with the tools and techniques at hand. Then display your paintings on the walls and invite your friends to enjoy your exhibition.\n\nFEATURES:\n\n- Realistic Brushes\n- Paint Mixing\n- Undo/Redo\n- In-game Browser\n- Sitting Mode\n- Zero Gravity Mode\n- Colour Picker\n- Customizable Studio\n- In-game Tutorials\n- Import Reference Images\n- Passthrough Mode \n- Meta Avatars 2.0\n- Painting-by-Numbers & Coloring Pages\n\n", "short_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. \n"}]}, "developer_name": "Oisoi Studio", "developer_privacy_policy_url": "https://www.paintingvr.xyz/pages/oisoi-privacy-policy", "developer_terms_of_service_url": "https://www.termsfeed.com/live/b9b579fc-4ffe-4c6d-a7ad-5de1c704c331", "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://paintingvr.xyz/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "SOCIAL"], "has
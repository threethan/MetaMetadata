n5Nho&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD42jYdSmCZaylpyBuOIYOXs7WFrDLc0suaxfu5TxQHxg&oe=6A5A2D0F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHKTqklZArkQ7kNvwHEL6NI&_nc_oc=AdputLQzPz-SjbWNT0aOL_KVUF8NregqqSl6MIeuWBg6fE6im0c7tOeSTRyiQFZV8k0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRqBP6uvVBXW7eGDo0RWxPZCmpdfQkALQPTUKZwH0j7w&oe=6A5A3ABD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD0yKSAUw-MQ7kNvwFbT8si&_nc_oc=AdqOHCwf91u8XEDby2dgBudQiR_havFnO7ujt8kNMb5V5RInU8IDzrg3vuA66HMyn8g&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_J85lCCMBkVsBjcVuNwvKAn0UZMXJuZYLjU4njmYPhQ&oe=6A5A3515"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_terms_
Mp0f866cN85X5Lg3OJ2_GpX43MrGhBdKSKUkuRMgs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UO7C5A_SYUOMwjof6daXgMj4-uOLq6DDYfDHMB-izBA&oe=6A09C18F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8wRLJV_ZaUoQ7kNvwFat78h&_nc_oc=Adodfe-NQZzyV_FescxSKRKwJRY_E_ePkmjezIKk4rAU_yurNMjMlI8eMYkG-dHZz58&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40nXfBCXrWONIKv3wD4OWX3l9-4k3PaA-71Td-uMD8-w&oe=6A09CF3D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZwBaVhchCsQ7kNvwHVBYGh&_nc_oc=Adq5LJ2QCjPVokbD_zHv26cCRcbNBV8_TlY16785h5eunn6PiuPHONtnMW8wRz-Q73c&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LOHPCMZq9lqb1VBZ__I7Qa-bZtL1uS3Selj6_dmwKHA&oe=6A09C995"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/priv
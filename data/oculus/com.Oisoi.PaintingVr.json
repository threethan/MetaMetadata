wHtqwFr&_nc_oc=AdljRGCyIPGr3gqjsKMXI1l1v1PkXVVXpRJYx2stDS-9-Y9edglunjGxBmTVgMoxMDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOHgXbiwGUYa_s0gslldOxX08LqLePoxmarhk3agD1SA&oe=69A2EC8F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d85fy8wPtcQ7kNvwEHEtzn&_nc_oc=AdmUAvgiIc3HYxdYeUZT9RyeT8YLSIchxJkhEo1oBe_32AY__R9fT_I0MtLwoIUh-9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftT9cyn50U_NsGv7jKYOEgh8RX6cs7kzSH7GrYz06BOZA&oe=69A2FA3D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xcBnJphtUUQ7kNvwHaQyrN&_nc_oc=AdkfbRcBvuRHxCSRXDEM6bcsE6V9eu54lHdPnJNex5fleF15IghjQAxz8OxaBkne4S0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuEX4QBMLXAv6_W4gAxNs2__2fvF78WDcCty2C5G1n9Mg&oe=69A2F495"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/pr
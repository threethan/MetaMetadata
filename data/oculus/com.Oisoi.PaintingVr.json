9UGi4rzc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Mc5-cf-h0vPSe0KSuJTimLYiE-XlQSbeWHPwPKmJ79w&oe=6A3D2C0F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiU0zjpUQewQ7kNvwFcZxWA&_nc_oc=Adp9Gr9AVKS_RcaxXCGRcIBLgDntR3hAmuZ1zcgdxPyprBylbNY0xebYXIltqDdBIwo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oaQj9UtWkwUaVW_m92kytHATgUa8jjobKJ2kenXBvJA&oe=6A3D39BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UENefo2xRZQQ7kNvwGWXH4G&_nc_oc=Adp4X0PBAZ-4sqI6GNq2RBLNddX6WMwX_pavZabQD37fB3uwiLvBiQDYHaLZKjmnRRo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fjFo3ssrahQ3DOffEdBRgdGj9Sta-ZZyzYq28UAqT0A&oe=6A3D3415"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_ter
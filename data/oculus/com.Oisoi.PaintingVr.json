c48Yt1lIWJYE4bwXriJOvn5Hxi7W3EI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRVgMUwA_CrgeJQ6duQ1H423rXgUPIJPmAjYxu5OGtpA&oe=6AB3D30F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpdbfJfsVggQ7kNvwGTrI3L&_nc_oc=AdrpYEVcOlZH8GwT0U5H4rc_jGyWyPdhPHxmqoK2PUdSjkFHHCbuhuUuTh7eyLzMIcU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-biQecdY1igOadctk9XcCJ7K47HRdN7Uy-3flXZewvw&oe=6AB3E0BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0K_pYhn-OYQ7kNvwFSUkZ2&_nc_oc=Ado0rhZuX4J78IbKOegibkCd9VG-7T5ViqvVqbw7Uw_yGWOLtAvMeIOpw_gPscRR0Z8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_TdLcUUSr_ATT1s7QjoP7_r-Jr1-zFvwPNds-tCZeRQ&oe=6AB3DB15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy
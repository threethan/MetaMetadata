wH_Sybj&_nc_oc=Admx-xybBuJzlZj-_R6VhQaLq36nEhfspsdIpvFRh4s3TcbLGHR8jkdPZg6sXaY30jA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuOgqf0a8ddkCUKOIKGiZdNsjE0iOEM28vDD5rFaKB5Yg&oe=69A43E0F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XihCdYXzjkQ7kNvwF5yv1x&_nc_oc=AdnS8RhNtX3g6emc8fH8u7qXgaI8_MaL8OJ51CYUILT7L2LJIocB1_VQy9XdnN-CEZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftNWVreBHNMp5uUSK7XS3ozP4IhVEKhowE3vZQN8YbaTg&oe=69A44BBD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kw1TBPac6kQ7kNvwF6WHpT&_nc_oc=AdliAoJdP_uC-Fo5sIx8LCjjV2xf8XKGURzUQyLVaZS6ZyHFbieXwz_GvSILPDDy8zw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuBvLG6i3ZHvgNIevfb-9P85uVGKGtWYhMHOck8pm_hNA&oe=69A44615"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/pr
1cFo93C1z5eJncRY5sC4G0QfGzU16nGiLqHu73UsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41MwQbFzI4kQG2gsvjhegF_jXZBt2UjUnmidMPzrnQbA&oe=6A19938F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vat7NWhUizcQ7kNvwEgkYx4&_nc_oc=Adp0EAaw0f5qBepiSMrhUa4n4tO6p3VLp1KsWo1T9l1J8CSQFVgyQcgFY1M1vXz6tI8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mgl7d5dlOQ9SW7SHzsKvax1eZ3lRW9v1MSfRQ0d0qYA&oe=6A19A13D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XgJc93B0WEsQ7kNvwG6TgT8&_nc_oc=AdpmUQCsv1uxtCqfNHTSQzk-RWyVO11JtdqQranWzBmeCZKGMm5Mryjj9U1vFXibrL8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af739WyMMCOMBy9UVMkNOV2jmoyrT4hN0S7danzKl9wN6w&oe=6A199B95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/priv
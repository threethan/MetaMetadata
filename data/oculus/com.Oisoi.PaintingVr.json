AdH32Lss&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91_OoIkrukP0TvQ-N8NuJjNdfXgltmwbFfHd1D0Pf87g&oe=6A2C088F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us7uqNs0sPwQ7kNvwELVNa_&_nc_oc=Adow9t2Q6rY5sm3luugyQZFMhm5q5R2ZeObjpoZnibpx-g0dN4PFkvyAjte0ryoeQR8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zvMTYAVxZMKiPEdSrQoZW5mRvrz8MKXwMnOJlsTA8tA&oe=6A2C163D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0-dFPfFnisQ7kNvwH8UVSH&_nc_oc=Adqjik9pfqsL4yUk4G6RTQLFnAUIYJPLKyXrgkV8CnWfTJNEUityEKsIW-biTChClKo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gNrrmLuEU016TIhWICgFM9K9v5yj7QoDyVQlk8BjbDw&oe=6A2C1095"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_ter
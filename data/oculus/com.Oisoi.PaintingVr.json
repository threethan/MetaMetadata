vWGWhgVMs233ZH5ryrawXAtsP-njRKQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuTfiFYl5mZysGazCdbDCqwbkvDtqu7mkGyo_ZFylQnw&oe=6A97428F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFnMqKxdyaQQ7kNvwFHfAzF&_nc_oc=Adr3Esyxc5elszEZcbo-0gw8rAmVPjBxs6NL7g99AJxdKPgDvlUHInVgpRENoMk_qIc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4UgsbAyJeFzLlKPPSthqDOmm6wLKWi56h34OuQqV0gA&oe=6A97503D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qh8szpYTXiwQ7kNvwH6uaVl&_nc_oc=AdrgJH6KIEyUAuc_MN6ehV5n4Y8Y4sIIom6neknXMWKmC0r9RsaXmMukpCYJPQFJ-nI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4HbvkH1q4ztp-25MwHHBaiypvbua058BbJbnBF4iLpw&oe=6A974A95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy
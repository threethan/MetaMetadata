wEKx8pg&_nc_oc=AdlxNHdunk2hrrKE24xFmvelJNWr6oVukWcCQhJmn8HeFJ_MrHwjLZhpZ6gxpqhf-xs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvM01I5EV4BLkpoXcY8USgwvZYTUtmn6nA0vCIhHzRacA&oe=699C550F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1To42nF5vyUQ7kNvwFzpDLu&_nc_oc=AdlPAdxI17TT5FS-DBhJOQ2_yKVyr7dCq37e92ENeDuH2QakL1QwMmVjadte79AJQcI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv6qUIBy8zEWlb7T3RWgsZdD7wBR54h5VhxASr1PpIYOA&oe=699C62BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4-QHheYOn8Q7kNvwGuOImX&_nc_oc=Adlj43bag3R52h9aTzW2V60QH2_XbMsH9TzL78_jgfaNeuF1G5ErpCc9PLn5shtf3jw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuuD-7iILt4KaKcXRMwU4qPYlxaBjAVQeuj6-2CDGV7rg&oe=699C5D15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/pr
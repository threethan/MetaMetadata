cfzLSXtU_WQyjk5bVut_rC3069QvWrU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTff1ckNfMwjXWdii-e86QG2Iw62f2_XCtdyk7Mzir2SA&oe=6AF5F64F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfzfowrJLugQ7kNvwFzcyW_&_nc_oc=AdqYHcM7xuH1fu_lhq6QmYa8FBsbTD7VVTcPQSpDpDu76SOsmm8-xQ0tLufC28t7RYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNHxeLlVHHnp2X-iHqKUeqhhZ2GwZnOEX_CJZMWgYIfg&oe=6AF5CBBD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvMPmLCV-TUQ7kNvwHvQLR3&_nc_oc=Adq_ZX0Pyzp40zoiMtnXMlgrwy3oq62T9Q2nZ8F-NxfCO8YAi49hMRnBvH4h7poOAb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnpNcWxOXbgI9Rj41U7JJ0q6fUMOPxH8pASeZGnIomiQ&oe=6AF5C615"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy
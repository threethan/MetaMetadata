r4kpqA&oe=6B005F2C"}, {"file_name": "Stills_May'23_HappyHues.png", "id": "823131322562239", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240098_823131335895571_7345743809290845782_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88JgVcvul-cQ7kNvwEPLP4x&_nc_oc=AdqENVMsY6sa6ffuoTHFeJTgFVHmCn5_E7_bLIoG1W9-XtaY-GrZHOJkGUtdMjG6m2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXu7FOxN9z9scQoOzEsLos-mwo65VhakvddCqST4JF6Q&oe=6B005519"}, {"file_name": "Stills_May'23_Painting+Envir.png", "id": "788455049219078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86615891_788455052552411_3926343213990677300_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5_MZu05Zh4Q7kNvwE8M0rg&_nc_oc=AdqohwZubuBcatfgxCXrAqx8dlqy6Uf7UW_VkrgsYJ5iwUSP_2oa5Bxf9hTIuseIoCQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqHCT4zD4FYF41rRhGsgAO6LxIMuzpBbz7kTx2sDF6Kw&oe=6B0068A2"}, {"file_name": "Stills_May'23_UI.png", "id": "560254039552163", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422369_560254042885496_462054519402168863_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoSeVmWtH4cQ7kNvwG5xtKA&_nc_oc=Adq1Qv-kPARIpeBe1naju5nFx7XskBi1WxPwvkx8PAeVLWQvITIdjmZv5TNqlIrsxx0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRmKqJhZFejv5-KZVYxIU6hj_kR_D12XnF497iT0IqjQ&oe=6B007144"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 Render Final.png", "id": "963357088178104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75505859_963357091511437_666998212360027310_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJ0UleRv3XgQ7kNvwHGkrNv&_nc_oc=Adrzy4EMiHozCX5VJ6_r0JwbnjCDD2ZHTSiEbcFPIxj0TFRXNYh_ZWSiETT90VYB0qQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj2pjlEUE2Mfjk_q41FfSeHP7XzpCVmjPM90HT7To5jQ&oe=6B0087F3"}, "display_name": "Painting VR", "keywords": ["art", "creativity", "studio", "social", "relax"], "long_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. Play around and feel the satisfaction of putting that first paint stroke on a blank canvas. Learn the basics of colors, the painting process, and composition. Sharpen your skills by experimenting with the tools and techniques at hand. Then display your paintings on the walls and invite your friends to enjoy your exhibition.\n\nFEATURES:\n\n- Realistic Brushes\n- Paint Mixing\n- Undo/Redo\n- In-game Browser\n- Sitting Mode\n- Zero Gravity Mode\n- Colour Picker\n- Customizable Studio\n- In-game Tutorials\n- Import Reference Images\n- Passthrough Mode \n- Meta Avatars 2.0\n- Painting-by-Numbers & Coloring Pages\n\n", "short_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. \n"}]}, "developer_name": "Oisoi Studio", "developer_privacy_policy_url": "https://www.paintingvr.xyz/pages/oisoi-privacy-policy", "developer_terms_of_service_url": "https://www.termsfeed.com/live/b9b579fc-4ffe-4c6d-a7ad-5de1c704c331", "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://paintingvr.xyz/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATI
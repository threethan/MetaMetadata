3fSh-EGY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87tQrmcOBYPS1auSKvAM5XiLZereWVRh6u9ibVHe5LuQ&oe=6A2AB70F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Us7uqNs0sPwQ7kNvwGO7tTr&_nc_oc=Adq49Bcb9NEeK95wqfv64xTvswpsBbzlKQ3CLxzEBhbcMVOAZP6c5AE8a3dtY1NmIIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96Q48_e_jMP13oNzhTrtNm6HZestROIaPR0XlQYWcuUw&oe=6A2AC4BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0-dFPfFnisQ7kNvwH_Ol21&_nc_oc=AdopTIoBw2oYxVZQFErExRzdgqJj6z3AerkoFGBF6PVX1fMB2y3Vqt7vUkhXEOWAc4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_B_2SvYXJ5LdapFaY4DQWs_K79q7b4B0qlgElIM-HOkg&oe=6A2ABF15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_ter
VXkogidOhHFVB3Oyejl6BmRH0IzZQ1gBF9in5pLVfsB89mwTU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1VfY3eiy5P4-ZYf_kRnsZt0Q3Ax6Pk89zE_uf3PdvxQ&oe=6AA4010F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08DWUonXo_EQ7kNvwFUN3Jo&_nc_oc=AdqVx7MsiWcjRHNFQ4QL5vyyLdumCUQC_bwl-oHse9HLixqzrfYcHYrjb48X7FBM1Ck&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5OuUwcN0ntAMJoRpr8k-0uwQG-l7M4ZgtG4RscN_C8w&oe=6AA40EBD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juGBC7oG_j0Q7kNvwG6IsNy&_nc_oc=AdrviVcuTpd1vhtDdxzjx1_jwTTOskJkfIUVzAzmKWFWe_kp_vtouesKjEUTBOVY21k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzCbReANxHC7HRUAoSgZ4fRpwFQDDS946Q7fMBeGA9pw&oe=6AA40915"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingv
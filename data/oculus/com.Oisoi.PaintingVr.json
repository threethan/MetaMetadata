0PNYR650ehOD3Vprs5o2OP7XMLxNtj_A&oe=699C31EC"}, {"file_name": "Stills_May'23_HappyHues.png", "id": "823131322562239", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75240098_823131335895571_7345743809290845782_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhqJgLMiY5wQ7kNvwEAPxwe&_nc_oc=AdmASlqulhSnuQBu5G6921ofJJqppYpNZchn6pJ2krb92nAxSCalP_TwmuTofWBMZx4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsEon6obBahracNw9sgT6i-23U3hpTxYNi7WIJjHEG0Rg&oe=699C6019"}, {"file_name": "Stills_May'23_Painting+Envir.png", "id": "788455049219078", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86615891_788455052552411_3926343213990677300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oifUa_nWk_0Q7kNvwH4P6Vd&_nc_oc=AdnM7sk_vxGfFzmbF7Kck8iYg_OtScI0fW7G5v_rF2UMPAVhsbzMjU_MKhhlcrpCEkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvgRGy0YPr6S0EqMwH6c7U79duo48-QFX3tFMfWlYSr1g&oe=699C3B62"}, {"file_name": "Stills_May'23_UI.png", "id": "560254039552163", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422369_560254042885496_462054519402168863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=micX2JlIEPwQ7kNvwGyXI9S&_nc_oc=AdngA-TfNiAk27VE6r5kb_-gCfMU5hr-eD-PU-y7nqoxg2KN_xzx_E98gXu5p3Oz1zA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvSOhJpkPjOQ2rY5jHnBbMu4EfSDuWo5Dmohz9lecaX3g&oe=699C4404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 Render Final.png", "id": "963357088178104", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75505859_963357091511437_666998212360027310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkGyEvQPURMQ7kNvwGmmteP&_nc_oc=Adl7YSbH0FTlSMIc-HtKtXyfaNwzRQz6n-vSnPr9hBB6swqe97nEfSvHHS6CjsGLvP8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvY0orUBiDyUj2IB34keKfPNCCMbyQZUjRwa_K7vKZ9Hw&oe=699C5AB3"}, "display_name": "Painting VR", "keywords": ["art", "creativity", "studio", "social", "relax"], "long_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. Play around and feel the satisfaction of putting that first paint stroke on a blank canvas. Learn the basics of colors, the painting process, and composition. Sharpen your skills by experimenting with the tools and techniques at hand. Then display your paintings on the walls and invite your friends to enjoy your exhibition.\n\nFEATURES:\n\n- Realistic Brushes\n- Paint Mixing\n- Undo/Redo\n- In-game Browser\n- Sitting Mode\n- Zero Gravity Mode\n- Colour Picker\n- Customizable Studio\n- In-game Tutorials\n- Import Reference Images\n- Passthrough Mode \n- Meta Avatars 2.0\n- Painting-by-Numbers & Coloring Pages\n\n", "short_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. \n"}]}, "developer_name": "Oisoi Studio", "developer_privacy_policy_url": "https://www.paintingvr.xyz/pages/oisoi-privacy-policy", "developer_terms_of_service_url": "https://www.termsfeed.com/live/b9b579fc-4ffe-4c6d-a7ad-5de1c704c331", "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://paintingvr.xyz/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": 
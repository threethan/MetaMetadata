CHW1fffr-y_8K0tYr7wD_udHAsd250-okMrh6dYDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6izrem5eNj39tKr1EGCONEtSX5yntAeVqgXp5ttSw01w&oe=6A032A0F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqKDDgeRJVIQ7kNvwEZK-60&_nc_oc=AdpQ_gllp3dVhgxPevrXFqApkW4E9kQ9G-XcZ5Jhf2zGu7pmYY7NVUxnBiSUiddhMVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Wb_qfKvlB6msCMmBxgJ0wgiTWflm62zbVhwtVgZrYbg&oe=6A0337BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G20P_197Im0Q7kNvwEvpJJ1&_nc_oc=Adrs0YA2DZfarz4Bvvge_W_Kmmx8g8_GwE3lgv4LkidWIshEP-6YuY2saHaXFpWmFh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RqliolYPftRmd6ikncVWWMyjnzNk_jGUeq5bre8Cbgg&oe=6A033215"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/priv
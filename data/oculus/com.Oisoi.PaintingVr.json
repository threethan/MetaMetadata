uT8LWu0wwdNzSm8rtXrXBwi936sOPuk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyFvIK-KBjmlsJVyM2llH5Wq9AN-3J26fRvvOqRwlHdQ&oe=6AC8EB0F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGgdqtUZ358Q7kNvwGin4jH&_nc_oc=AdonzL20ELt4rSV1IPNAdBC0EjEl57No-W5FzWJ4i652-VcpYWqyVWahKY1W3gPJ1eo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO682X3HTowAzRNiBuutMee2olG01TvOhCZTq2BZg8xZQ&oe=6AC8F8BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIdMwI1J9PUQ7kNvwG-8EtS&_nc_oc=Adq66OV6YZI282uDb-yZqLbazBTwwYBVrCKBlUCRILJ7ununqVkPB6mIKGR5SZ6T2e4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6NmF41lqXBpy3oNFCi6ZDre6OwzXD1X_YZ1ZVxla1GA&oe=6AC8F315"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy
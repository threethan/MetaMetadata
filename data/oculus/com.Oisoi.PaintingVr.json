LMAN6xuexgjV_tH9nDD43w76jxQ413Cmdt4HQufy0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TVmleVcuFMuPstMZUihIbwX_73VIq5ESn6dXljWd02w&oe=6A05CD0F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqKDDgeRJVIQ7kNvwEf9Bse&_nc_oc=AdpOE_IKYSxcCYA3iJ7-2r-1OsTaRjCvWijruu-DjF8kR87CJp9kwNXBFMy28_Vcbj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76gUwb8AJCcmFPyRVrrdp9WEMr7qkiIIdjb0uM2rR9bg&oe=6A05DABD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G20P_197Im0Q7kNvwGunVhc&_nc_oc=Adqvu2XDhWnVkJj0i6Le-v4b5Kg5gYebKvsoC7D8wYn_mh09nyiVkaZYSM1Q2J8yKlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_p41aP6Khlzcdg19N3FyaOPHOMTmSEYvYXP6czk5yqQ&oe=6A05D515"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/priv
24S42JaYu-brRKkuZBVapon75JchJvffcjBJBjh7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Mz_HFjXxicGimvc9Sew_dftYw-b2vtjSperA1R89MVw&oe=6A047B8F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqKDDgeRJVIQ7kNvwEPua5u&_nc_oc=AdrtKxtCCbMXl5C5AoileupPSZJ-hhdnNkYx0RVeb6VznLiRvlydM7RqT7YaLWchqno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7939ug_I1rjEc4TNANr3aRKvxGH1-K9eSE1mppYXaiOw&oe=6A04893D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G20P_197Im0Q7kNvwFM42AU&_nc_oc=AdqY4PdRZi-pyUtthmx-eTUEGATFJDvwxxYnt6iKnYZTDd6Wc39a9U1cAKfwZl8SbW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5umKtaQNoaFyoIC1kvPZAgs3vDlDXlumc5n2bqGu1ChQ&oe=6A048395"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/priv
fXvyg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbLTZ5FzJGUWwHFW_4YZ1bBb-4wrYtUaPrOL6wTJxsrQ&oe=6A68AD8F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNEyT9nRBFMQ7kNvwFC6oon&_nc_oc=AdrP3ZbioH8x9LB8d3LQsl9wTsOQsUYRNu9kUnA_iDIPoAzHKe6Cf-9pMW4-Dx9sCvE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_6mn2OJQA6rh-VJQMxAlaCF7gGys61o65KYBKCw2lPw&oe=6A68BB3D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ctTzhDBZcUQ7kNvwEeMRtI&_nc_oc=Adob89FiU87qv66vOMI_RMILVTMRMDEQIc13P5-5Wz8DET25kt_Y4sSy-y7UEOQG2a0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDECwG0wvDCN-2NqOEPImeos2pUJ75f5_HFbrx3SwLBXw&oe=6A68B595"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_terms_
qPGgeopA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SYqM5Efii2ScWh0Sga9CfuvzlNM-r_QRGJj4rk1tJFw&oe=6A41208F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZHn-z8LlWYQ7kNvwE6a-Vx&_nc_oc=Adq7RzZP_sAxMGRgWWkXujkTMIVrhDsGZOzO1bpTD6lhou6JGOSsvdgjC1IPfk1bRX4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZxS84TZTCOJH5-Q39Lnovb0AYIWXl9epbGn4NF46FZQ&oe=6A412E3D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KO36-a_MWKEQ7kNvwFIwWcu&_nc_oc=AdpCOW9rB4ZWYXla2MS2c_yCc13zI_rGD_25JMGoT16lNZZMR05UE3pv1MJYS7293GA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IQnigV7dIzlqeYUJAIpvML4Osp8QC8FuwYr82xcd4Ww&oe=6A412895"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_ter
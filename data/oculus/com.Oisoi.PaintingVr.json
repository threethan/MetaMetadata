hcHzC4fi8ka9y3PjeEKltffaSQSd6Y&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Uf6uW8T6K_JD5ScCCLx5yVIpDIQ61VrdF38un9funVw&oe=6A39378F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojr_VbKAFZ4Q7kNvwFKPid_&_nc_oc=AdqBWQkbpZrX-n8_Pug7labSk6Fl3FK-2vjv6Hb2hjYgp8Zcz2At6MbxXLpq5710q88&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94hnPEga7uSj40bxSkmnfWkS1Ljsz90uCyjp-qEn1LQA&oe=6A39453D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itnXROukzwUQ7kNvwEokOwF&_nc_oc=AdpGJAvnNOlSfgf_z7cup1lRZaIy5OBubD3gyDkJB_XyzPIHfirg9lcSg2wyioPHFvE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WY_Uo8bRW8m3MW1vAQwWZ6gNGD-Tq2EZuf-aDeW6spQ&oe=6A393F95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-polic
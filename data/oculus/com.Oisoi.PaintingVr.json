s_hZ6zb_J_ktDe8Fl_C2WU5w4DoXVjqw&oe=69A2C96C"}, {"file_name": "Stills_May'23_HappyHues.png", "id": "823131322562239", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75240098_823131335895571_7345743809290845782_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uj5teo7Dg94Q7kNvwHNxoEG&_nc_oc=Adn--HrBk5EuJ-SZ5_Rn4ENaBREEkesoyBh3nqP2W3_9WyPQHPvfg8g9knI3pnHCvQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftsFBSK9iqAZ32CgWApRTOEMiQ7HbuwEVInOae46KLZKQ&oe=69A2F799"}, {"file_name": "Stills_May'23_Painting+Envir.png", "id": "788455049219078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86615891_788455052552411_3926343213990677300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZMOF2a6aKkQ7kNvwGMNzPb&_nc_oc=Adkl6RTwdzj7LQYbJb0pTg3cURa1Kf8V-FFVyL57O3PnWwcy2rjxPdcdW4QETLGT7W8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKUq_BQpoN6MiGEeWYJ7wsAVO79060t8p7MZc-zOLU1A&oe=69A2D2E2"}, {"file_name": "Stills_May'23_UI.png", "id": "560254039552163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422369_560254042885496_462054519402168863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXqDhhRO_fAQ7kNvwFAE88i&_nc_oc=AdlRsCPCIDQO-3cRm7DWV_E8uuIr_8EUaitjVEICEGQueLivWk2ZpmLR1bZSBIXkGd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afudt5I0HBBzUJqqUahF19ZRhU6u4wBMSGwdpebGtpOrbA&oe=69A2DB84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 Render Final.png", "id": "963357088178104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75505859_963357091511437_666998212360027310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prjzKIxi0gYQ7kNvwE3TWfY&_nc_oc=AdnMtvUIf5lrDjOOO7XARBcxTHskATmc_0F0-2Uxd84q66kGozd_rVVsfLcU2ZznAdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfviUyj3lg4NPYf1b3q11H7TtqWVml0kXoX0ep2S_Bqs_Q&oe=69A2F233"}, "display_name": "Painting VR", "keywords": ["art", "creativity", "studio", "social", "relax"], "long_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. Play around and feel the satisfaction of putting that first paint stroke on a blank canvas. Learn the basics of colors, the painting process, and composition. Sharpen your skills by experimenting with the tools and techniques at hand. Then display your paintings on the walls and invite your friends to enjoy your exhibition.\n\nFEATURES:\n\n- Realistic Brushes\n- Paint Mixing\n- Undo/Redo\n- In-game Browser\n- Sitting Mode\n- Zero Gravity Mode\n- Colour Picker\n- Customizable Studio\n- In-game Tutorials\n- Import Reference Images\n- Passthrough Mode \n- Meta Avatars 2.0\n- Painting-by-Numbers & Coloring Pages\n\n", "short_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. \n"}]}, "developer_name": "Oisoi Studio", "developer_privacy_policy_url": "https://www.paintingvr.xyz/pages/oisoi-privacy-policy", "developer_terms_of_service_url": "https://www.termsfeed.com/live/b9b579fc-4ffe-4c6d-a7ad-5de1c704c331", "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://paintingvr.xyz/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": 
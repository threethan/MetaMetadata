iM2Z_MOCEC4IVkJAV9KdQBV0elwxxhU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMPUL34IINDgj3sPHFkEleks9kq5jWJG_UvCgMSuVTZg&oe=6AD2258F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTzQ100AcjUQ7kNvwF-YYl-&_nc_oc=Adp1o3yNWHpQbKFDh7mhAu5r33FDBUDxVb2C74mdsJmk9R9Vq0lKTBK4PQWLcwfqEcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuGeHQ4_dmUN6GPWG8AHfSGY6tlEEyYYTbuG1wEnoVqQ&oe=6AD2333D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mrp-_HzHD2QQ7kNvwE4pOZa&_nc_oc=AdoH6Pv2JTWjyW5HicNaG_x8d36Ik3bNkKsg1XhgGjvSfVx3xjtQ88pL10bWL22ogX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZJ2LxxsORxf2WKONUOkkSqybOCb1m9gwrlIwjLD5r-w&oe=6AD22D95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy
.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_r-Ba-MPOYQ7kNvwGOw7X9&_nc_oc=AdpmaDDTgVPmU7z6b1Iu2cpsa-4SAUgio89x5iPG9kZBn4ywZd4rWG-S3qx_1QcpWkQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61W76CczZA3bwPFSg9MSv-h9aFcpaM2v--AuUR-nqMuQ&oe=69FDEF19"}, {"file_name": "Stills_May'23_Painting+Envir.png", "id": "788455049219078", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/86615891_788455052552411_3926343213990677300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ys3mtzUiwpsQ7kNvwF9JmIg&_nc_oc=Adpm_JBNsnqpL09fKi9wcByX8prUI8IMHP5dHF_ceHCmLT5HbCBvS3jA8cJ2QhVRfRE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V-fiyySCK47wZdh1gTNmx4O9FjqtxJeVdxRplXgYmpQ&oe=69FE02A2"}, {"file_name": "Stills_May'23_UI.png", "id": "560254039552163", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75422369_560254042885496_462054519402168863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JWaH7zA6hXAQ7kNvwG559ty&_nc_oc=AdoEk3aFlXNI1IaCkSwQ5NHnMwYcNMc9acJamRc7GGcQ0k8B4YnWaCvU3bpKFhAkb5Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hE6vjp-zjTogMKuP1PegPM0H8O8ha6T9scv1gYYoEhA&oe=69FDD304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 Render Final.png", "id": "963357088178104", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75505859_963357091511437_666998212360027310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zldU7rapt7cQ7kNvwHBXE9r&_nc_oc=Adp5g2zHhjufjixEmVpFnr4CNzA9kIFUYphbn8WwcB6QKrAm_rE8j2F25sMSESxTY8Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HLH4x6zuaN9oLKNPqxohgoCuei5qNbglsd709F3vMTA&oe=69FDE9B3"}, "display_name": "Painting VR", "keywords": ["art", "creativity", "studio", "social", "relax"], "long_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. Play around and feel the satisfaction of putting that first paint stroke on a blank canvas. Learn the basics of colors, the painting process, and composition. Sharpen your skills by experimenting with the tools and techniques at hand. Then display your paintings on the walls and invite your friends to enjoy your exhibition.\n\nFEATURES:\n\n- Realistic Brushes\n- Paint Mixing\n- Undo/Redo\n- In-game Browser\n- Sitting Mode\n- Zero Gravity Mode\n- Colour Picker\n- Customizable Studio\n- In-game Tutorials\n- Import Reference Images\n- Passthrough Mode \n- Meta Avatars 2.0\n- Painting-by-Numbers & Coloring Pages\n\n", "short_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. \n"}]}, "developer_name": "Oisoi Studio", "developer_privacy_policy_url": "https://www.paintingvr.xyz/pages/oisoi-privacy-policy", "developer_terms_of_service_url": "https://www.termsfeed.com/live/b9b579fc-4ffe-4c6d-a7ad-5de1c704c331", "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://paintingvr.xyz/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "es", "it", "ja", "ko", "de", "fr", "fr_CA", "fr_BE"], "su
wGI3xQt&_nc_oc=Adn3jQyz7-FxIIQGqsgscHoySJ3KMHvlxJainrfRKFH-B7W8NzsTXn_-M5ZcK0DGE30&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftPyVMG9SsERAj9h7iRbY0yr1kjIfXtKnXbOKMQgcz0RA&oe=69A19B0F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d85fy8wPtcQ7kNvwEkIPMh&_nc_oc=Admisy0ze6ZjMvDDWyY9IiI7yU3LrdAD3cqJPQRkj7cJgEhUIqcM5oZvrJ7lRp56XCI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsfJV3URhLYL7i7kNAhA_hdQAw54cAC6j5F7atL9nVYqA&oe=69A1A8BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xcBnJphtUUQ7kNvwF557EA&_nc_oc=AdlpE6QJCZHsTU6nWPNqVen2mII0KwfujVaeZMGH9E0jZvNutzfCFRVVvHa5qsSt3B4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu7-wmhwi3g8CZdghOoX2kU3d-mGpncSUIY_6mgJQS3FQ&oe=69A1A315"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/pr
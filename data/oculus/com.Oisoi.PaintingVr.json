zJDWj1yA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-69kpRXdWZ0ygvHo0xWZxonR5nmwbzaLYus0j3DuDg_w&oe=6A314E8F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Aza6tmSAP0Q7kNvwHz-hJl&_nc_oc=AdrJDL0TlXCxYOHCSzHgJOc6Wcnu5CKC-x4lyq6eE_NnvZSf3gUdgxzybx6BngyVZUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j5NuH55irSNgrfoRGXhS6ZTfIhz2JhOPXnye_nskEyw&oe=6A315C3D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G0lRp3SVvMQ7kNvwFuyGEW&_nc_oc=AdqZVeRwTNN1ZG-zxrROzD3UTFIf6OSYkrd8KEJu4rH0FZ_VDaG0Tzmk2y_2_445AMQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hKLGm2ifrqwZSX7UGxt2qq0YwXToaCd3d5UlWI2SjCA&oe=6A315695"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_ter
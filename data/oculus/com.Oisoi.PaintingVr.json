Rl_EwjWM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zmuuxnq2ejQPVhT15q0UsLjtbCBjWxcFWw6QdDWYHJg&oe=6A2FFD0F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Aza6tmSAP0Q7kNvwHq9HcV&_nc_oc=AdrhnFy7e9SNGt7G-SBtU3c91wF7TKyfuJ22DTJ7h6tA6Z-PFaU-IrkzUtNFPU-gB4o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89dGaFlUBglENZ06cDOGGLYmdpd5AyVkeYEvRPYp972A&oe=6A300ABD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5G0lRp3SVvMQ7kNvwFJuyAM&_nc_oc=Adob5DHbwXHy05wUqsEDJuKPt_s8NarLiH-utXI-1PBmM89MPieKZLBjox4xcv-WrOU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KtXaxU9-XiUjL4b1zImgfx79cs4D-bnYjakk6qliMOw&oe=6A300515"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_ter
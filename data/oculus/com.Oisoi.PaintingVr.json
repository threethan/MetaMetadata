7a0a&_nc_ohc=l_3M9ziP4aYQ7kNvwESheUS&_nc_oc=Adrg9ydi1--EMLjRq6qKdD-EJCERmB95UfLI9fEWSW0e-QMe1cnw2lgqNiHDBCp00y0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeKdCgqRnaCvqoR3DgtFlWFfKsC9NiImhEI9Q1l6rEvA&oe=6A831699"}, {"file_name": "Stills_May'23_Painting+Envir.png", "id": "788455049219078", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86615891_788455052552411_3926343213990677300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDmeK_Qr1S8Q7kNvwHQVTnA&_nc_oc=Adr-Gz1mwh1O4TGOS_UlMzhxhNK5VOFa2Ixb1ars3rowEJ0GBam7U8xxJsmSrsQulro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-HKiap6FrRTV0aNxUSHRc87mOR0BwyNQL8S6qenmwow&oe=6A82F1E2"}, {"file_name": "Stills_May'23_UI.png", "id": "560254039552163", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75422369_560254042885496_462054519402168863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82s1b7_1hewQ7kNvwEGsXSA&_nc_oc=AdoynUnfiITwK7jBON3SX3iCrdRfs8B7I-pn4jYjB6KPpbQxHvrtEANbEpYogPMd_PA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGRqM175sol_XXWY87zIVTAzgvmYnF8iB8OKQYKPa5Ew&oe=6A82FA84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 Render Final.png", "id": "963357088178104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75505859_963357091511437_666998212360027310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWJd54jLJwIQ7kNvwHYgk0a&_nc_oc=AdrGafF4v21Cf_7x8YfIQHPbyaan7crFirPEyJWOh4MwE420N92wrMypBeRUlngn0fM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHM23-9kE12vMuA6adhrYgY_4-Vq9yVkJ2Q7gc-iqqk4A&oe=6A831133"}, "display_name": "Painting VR", "keywords": ["art", "creativity", "studio", "social", "relax"], "long_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. Play around and feel the satisfaction of putting that first paint stroke on a blank canvas. Learn the basics of colors, the painting process, and composition. Sharpen your skills by experimenting with the tools and techniques at hand. Then display your paintings on the walls and invite your friends to enjoy your exhibition.\n\nFEATURES:\n\n- Realistic Brushes\n- Paint Mixing\n- Undo/Redo\n- In-game Browser\n- Sitting Mode\n- Zero Gravity Mode\n- Colour Picker\n- Customizable Studio\n- In-game Tutorials\n- Import Reference Images\n- Passthrough Mode \n- Meta Avatars 2.0\n- Painting-by-Numbers & Coloring Pages\n\n", "short_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. \n"}]}, "developer_name": "Oisoi Studio", "developer_privacy_policy_url": "https://www.paintingvr.xyz/pages/oisoi-privacy-policy", "developer_terms_of_service_url": "https://www.termsfeed.com/live/b9b579fc-4ffe-4c6d-a7ad-5de1c704c331", "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://paintingvr.xyz/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "es", "it", "ja", "ko", "de", "fr", "fr_CA", "fr_BE"], "supported_input_devices": ["OCULUS_TO
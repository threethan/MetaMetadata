wFOVzLG&_nc_oc=AdmDuWXLHgd3pz8yyefVk37Xs37-RfYEhMk1DJE1Ys-9gHtcmnlAYg_VV_T47jB-Ioo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft8QkdVUZAOaLZzL1YjN4mRoUMzz-e_e9xKACK4WsboWQ&oe=69A58F8F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XihCdYXzjkQ7kNvwH5lgyQ&_nc_oc=AdlZGh6SMUSwZm6-xEKMNimyRltqGyaO_lxlbrfvNBcdmOQ2631imfQ_QbtNoIE95wU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft0enn6VJt_b1uthS6z0QSyt9o7DPo_qMtrOiof401SRw&oe=69A59D3D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kw1TBPac6kQ7kNvwFi1MtK&_nc_oc=AdnyvrceuBKCpQVlWBN2zaR03sIU_lE-qNBCwEtHqcLRWnpe3czZbtnkwgkBeIFRIO8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu96ugcSS_VxsGQUsdZ1Awwt22whSTylpJNV_xkFRkbjQ&oe=69A59795"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/pr
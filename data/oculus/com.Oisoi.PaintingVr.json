7a0a&_nc_ohc=z2tksg-9gbQQ7kNvwE9xkrM&_nc_oc=Adq5dpE4NxTj5OmZTBBNY-Yy5UKDGI4aVD1g6_kNFbkircUzdd0Wd2Kpn7WrIdkdxWE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDYrAEOLA36Ho1CD8KaBquhqwTcHyoVGixSZc0uI9Gcw&oe=6A7F2219"}, {"file_name": "Stills_May'23_Painting+Envir.png", "id": "788455049219078", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86615891_788455052552411_3926343213990677300_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJLFHEQvGc8Q7kNvwHbNp41&_nc_oc=AdqRrj-RA3Td4wKOeBjqLqGML5geDI3WQ7HcoCKzt2U9M8NWUEIlvJejQvvX0cty8Lw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmlTMhzmjvzNL-0IJrKJgf7O-3lqrbG4_b8Ke4TivI4w&oe=6A7EFD62"}, {"file_name": "Stills_May'23_UI.png", "id": "560254039552163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422369_560254042885496_462054519402168863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yunRhbusjT4Q7kNvwHvu3v6&_nc_oc=Adq3S2uM2x-4t3weQH0QU1IkOALiw_79pXD3gEwi8kvhLDDDKqmY2PdusL_93KPjhvg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm9-CaESpN8DIU-34b1QmuZTuz2oCO-DJVV_RgSF4K7Q&oe=6A7F0604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 Render Final.png", "id": "963357088178104", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75505859_963357091511437_666998212360027310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tWOCo0SgB8Q7kNvwHZER4E&_nc_oc=AdqXOv7_P1WRupfn0kBQf82Ph0bQyyQumnAQ9G5JScfYxa10GBmddFUBbeQymW3zQU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWKCnbiieJG4zwFWWbs8fRFIZgVofY_6TVkE984Pjyyw&oe=6A7F1CB3"}, "display_name": "Painting VR", "keywords": ["art", "creativity", "studio", "social", "relax"], "long_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. Play around and feel the satisfaction of putting that first paint stroke on a blank canvas. Learn the basics of colors, the painting process, and composition. Sharpen your skills by experimenting with the tools and techniques at hand. Then display your paintings on the walls and invite your friends to enjoy your exhibition.\n\nFEATURES:\n\n- Realistic Brushes\n- Paint Mixing\n- Undo/Redo\n- In-game Browser\n- Sitting Mode\n- Zero Gravity Mode\n- Colour Picker\n- Customizable Studio\n- In-game Tutorials\n- Import Reference Images\n- Passthrough Mode \n- Meta Avatars 2.0\n- Painting-by-Numbers & Coloring Pages\n\n", "short_description": "Take a break from the stress of daily life with this must-have virtual painter\u2019s studio. Even if you think you\u2019re not a creative person, Painting VR might prove you wrong. \n\nBe amazed by what you can create in this hands-on experience with unlimited supplies of paint, canvases, and all the tools you need. \n"}]}, "developer_name": "Oisoi Studio", "developer_privacy_policy_url": "https://www.paintingvr.xyz/pages/oisoi-privacy-policy", "developer_terms_of_service_url": "https://www.termsfeed.com/live/b9b579fc-4ffe-4c6d-a7ad-5de1c704c331", "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://paintingvr.xyz/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "es", "it", "ja", "ko", "de", "fr", "fr_CA", "fr_BE"], "supported_input_devices": ["OCULUS_TO
iNh2phfwydIOW_Pj_MW5WvRAhs8U2cg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy-MSQ2h9pEi1ICRCZ3pYRUhg6gtxDDLXNFsdxXiogAw&oe=6ABA6A8F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C4Q2fj_eDvQQ7kNvwFO2K59&_nc_oc=Adq-WV5oC7zZ_5ASLST-fA-rmWNW7EF5vVb_4BlUE7tGWtauR95w39qcAHf1bfsQSPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMfDS2GKHt0ysPUENLMBxFgkXTY1lW5_tP0b2EEiAavA&oe=6ABA783D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOPKqzZp5jQQ7kNvwFwI9dD&_nc_oc=AdqrYPo3gsugyi_F41XpF0b6hwhR49t6SGV34bwlTz7KACKPCIdyrpTsZ75HzPS4zag&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZz1d4UpxHs_Xgked3w8WVcq5e3nswBYjGc6FUev5kBg&oe=6ABA7295"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy
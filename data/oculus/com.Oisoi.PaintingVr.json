m4u7R5LWWEhd9bLLPkb6InVDX-_MaGUE0xrJYSJRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H0TIePW_GLEoJrrmckCWUEPnA-SbsTyBEcZDwk0fDiQ&oe=6A144D8F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN6rJGDe768Q7kNvwEpaPEt&_nc_oc=AdqEQQ70j0mGMt6JdQwMfPk-f4-1nxLUSVi2Rkivcop8TBVzzoFG3F3rNJp23N20jR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fexUH2_WIrpueRRiF2LMOY3Goo3QwttxQXBvn6YAHCw&oe=6A145B3D"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3SBsWYztHwQ7kNvwG0edsT&_nc_oc=AdqpuVCifEuu_xYNIyF_9st5nKVdpFHy2WLDX7u_0GQJji7R4uobQpsoMXJmVJUfKMs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KPqBn4op283k42gp8OgAMxJxcrsMLaqfbR6H0XwCqaQ&oe=6A145595"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/priv
kqKTcRNTsy5ylORBjFsvEMyvAT6QKmM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRguiwPESaQdN-5s3sOKoXf1xTy9nktyIhb6zCryyP17Q&oe=6AF3534F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zv7JPVyna2wQ7kNvwGsIj6X&_nc_oc=AdrjNcbjJ7UaCi6oHQntEJQ1wWZEPy4Q83MABAXhjE9TMpj9ht91PVi1vfetrvsN7VA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5kIvIg_1vOxwPg8bO3e4iE1u2C3UQALHPDZhyL2IhUQ&oe=6AF328BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ-YMQlZBEwQ7kNvwHsLjJV&_nc_oc=AdrYBFFsDUeo8zXl5TaoRNgJTitT4LD88MCJoD55Fe6to6F7fKZGTi8tmGjt4o2gHP8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdAdgRQWYqQvCldg7BPlE8S6wnA6XXz7rc9dpesYw6TA&oe=6AF35B55"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy
png", "id": "140060414733186", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75254874_140060418066519_404510634789214415_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MI4Fg35yRfsQ7kNvwG-PiAj&_nc_oc=Adk0lVfNNcakuTuCAXzi9Q0RgWsAqlmYLHIVhdXhzVSFuAd-TP7YcOyVH9Rekl9bP80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQELVOCkKPb7myYd_uyDW_Pfh-bxbc4Z7mTV9G41tMGA&oe=69B6B30F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSOevIuHMSIQ7kNvwFKwtDT&_nc_oc=AdkHgWR2Fo1UgrNf_mwrdg46z4JkCCFlm2dG0FWuIxXGuNNgKLRgG5aaqPBSnNGIaWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaTEHnU6AjT50XQnfKqv-O0hg-ndOre-fuvtEohf1Adg&oe=69B6C0BD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14zw15Ah41AQ7kNvwHYifaS&_nc_oc=AdmarIySokjnaGQvHx7PeU9IlgAtjm5smRE8YMlE4XsBzPvHonpjLrsBusPYdjnX-8M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwkUMfVSjdu8nZn3fXsbdRQSsZkBgy4FRCDRbrmvcrdbQ&oe=69B6BB15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/privacy-policy-web-1", "developer_terms_of_service_url": null, "publisher_name": "Oisoi.studio", "support_website_url": null, "website_url": "https://paintingvr.xyz/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1062957640944640"}}]}, "scheduled_offers": {"count": 43, "nodes": [{"status": "PUBLISHED", "id": "1791947784804049"}, {"status": "CANCELLED", "id": "1840066543311605"}, {"status": "PUBLISHED", "id": "1614844056317508"}, {"status": "PUBLISHED", "id": "1958573241652405"}, {"status": "PUBLISHED", "id": "3146795088835124"}, {"status": "PUBLISHED", "id": "637786749396574"}, {"status": "PUBLISHED", "id": "1804174397143440"}, {"status": "PUBLISHED", "id": "593990343419617"}, {"status": "PUBLISHED", "id": "884438766913325"}, {"status": "PUBLISHED", "id": "7754797444641584"}, {"status": "PUBLISHED", "id": "1619309388904867"}, {"status": "PUBLISHED", "id": "420983540846196"}, {"status": "PUBLISHED", "id": "772694838191706"}, {"status": "PUBLISHED", "id": "1704224099771856"}, {"status": "PENDING", "id": "818840469654476"}, {"status": "PUBLISHED", "id": "1671061373417438"}, {"status": "PUBLISHED", "id": "333965992302
rGkH9Jn_k1Yzi959X4uh5BBhU1ln_BJSqRfwQGHZ3lSQ-5aRk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUtFA55RbvQBqyB6Z5HEgkzGWdNl8avXGM6GNpayPLCQ&oe=6AAE8D0F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEWJRsAYREYQ7kNvwFPRkmV&_nc_oc=Ado496ywoyunuM5-7KDB-nQi5ZJ0yFN2gT4EQnIMnx-VTiA_J1VOpPu3ut5Nce447Go&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSyFlUqhEmZeIZZA4UDhnQgP_vU4PbbgW5z5DfI8CKvQ&oe=6AAE9ABD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toCuInixxUEQ7kNvwHEKBzM&_nc_oc=AdpcsAEX3ijbU68AnkM5FXqWo3pxqKUb-88waHK9gyUmgL1pgUWPDGhAp3eckQ4nB7w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK78B2jbxWmicG2SaSmElXExRZxL1yrCNA5wwy1-eVg5w&oe=6AAE9515"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingv
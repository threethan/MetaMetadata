wEIyfKQ&_nc_oc=AdlD_jo7duSVIL2sSDvhB-k_88S8lQPB3GgLXqkV8myB5DE8Sg9L6F8dC0dUD3TVfAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqpYZVeaih6ihRNxuruxv2n1gA2fB35GYUctgF68x2cg&oe=69A6E10F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XihCdYXzjkQ7kNvwH8Yx18&_nc_oc=AdkW4PBeKV491_SIbkdVAH5RuIX5Ag18Mq39BbQWT4X2sJO2l_OAEqguFFHqQoJ5oWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBp79SpIRCW1clAHCexMHgeV2z6aDDLX16oaLOf83bWg&oe=69A6EEBD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kw1TBPac6kQ7kNvwHEyLiD&_nc_oc=AdnPg5XnXLhUs0lGUuGAgbkVxPtfKFuiI4DBvB2DlU4sNP6S1p2ErC2ec8D-NpTc6ew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-yaOlxinjA0LRMS1jBD0KUhp3pcGQhLQdnj9JwQBGtA&oe=69A6E915"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/pr
qxwHDfwFBN8btedeJdCre9PGuE1OODh8TOqJLbKoE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GOnNfsoXn1KJNKZIpe_coJLT1QE-0GOjqHUSmaXnk6g&oe=6A159F0F"}, {"file_name": "Gamestill_2_1.png", "id": "730993767596206", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75292490_730993774262872_7203892228344656958_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EN6rJGDe768Q7kNvwHBoI81&_nc_oc=Adr_XodKxww1hCFAL7rAqWY06-jIPgaEgMNZgwv-hf-u_cuN6PgvIeCAdQHxnoAyPyU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IWzjz_5LGHJ-liZGJh2eojup0t-fhyhqrHOHrvqunqA&oe=6A15ACBD"}, {"file_name": "Gamestill_2_3.png", "id": "2939976282883307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036632_2939976286216640_5800461904326178318_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3SBsWYztHwQ7kNvwH1L8bd&_nc_oc=AdqNlpdw_B9T2pNJ6ndAZWIS0Ly7ywQaSIsN87KHuBeMSaVew9dveFygSJI-AdxJd2A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nojvXtKagNy4DfByb82c_62UC9rlQqjdddvu9zr7IWg&oe=6A15A715"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Painting VR", "keywords": [], "long_description": "Painting in virtual reality is easy as one two three: mix your colors, dip your brush in and start painting. \n\nThe experience is very hands-on, easy to understand, and aimed at all ages. Play around and feel the relaxing satisfaction of putting unlimited amounts of fresh paint on a huge canvas. Teach yourself the basics of colors, the painting process and composition. Sharpen your skills by experimenting with the tools and techniques at hand, and become part of a new wave of digital artists. All without having to bother about cleaning up afterward. \n", "short_description": "Painting VR is a virtual reality art painting simulation game with gigantic canvases, satisfying brushes, and an unlimited supply of paint. "}]}, "developer_name": "Oisoi.studio", "developer_privacy_policy_url": "https://paintingvr.xyz/priv
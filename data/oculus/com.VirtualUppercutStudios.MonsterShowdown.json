EQIQ7kNvwGYhexm&_nc_oc=AdpzbVXmrstkJHzmYjJWagSckn6L58mXexi61tk12TdUbZn_tf0DpKyBRrens9xGWfA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VIdn_j4XwBagFwuoaPqJV1wXT1ziIg3iJ5JA10hniiQ&oe=6A0DABC6"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQQKwUSAJxsQ7kNvwEL4GAZ&_nc_oc=AdqfJLJjpx90dAIzNc2wj1uuW-cKuUycZ7yGgmjIKUPvvf1cxVaeYZvrvtK4ZCzOSNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wBdhuGFPapqv2MgIcdOtQsvZx7MHOmRuuEOgRSFQPMA&oe=6A0DC728"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93TAyGoQzagQ7kNvwEb7r8V&_nc_oc=AdrGruliaO-6GErR_QwBbsz3dW6VzJbxEpE-sNnTDghUPL0m1qfDnu3-j5p5_e4c-H4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6owdViDz5GPQszqsm2qkgTbOy6nMG9QVAbYzcuJW_jXw&oe=6A0DA7D8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZR6WQLaU0MQ7kNvwEMb8uZ&_nc_oc=AdpEIzXYw1bXAU5ZFDZQsaBUBmcA6NqoV6S8KFMAyUJXN1Nw4EQlMCMkKSrTfQUPRRQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AfQrXDLbzV_k_LxW6LeYl_0lW5Z6IYnoV8-2E1k9frQ&oe=6A0D9FE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5up5prMeQ9IQ7kNvwFDoJWa&_nc_oc=AdrtrJzyuoemjVSEqZOntyinaEw3uTSyTPoNK9GVbPsL-RVrXwv2Fkq_X2_K0_U9ZYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fs8rF79icnJTgSBhDp45XRrPUG26G-TqqPxN4R2Jv2A&oe=6A0DA7C4"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "
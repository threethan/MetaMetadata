/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_453544100291362_3040096994201235483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNfc-M3Mj9kQ7kNvwEofWbo&_nc_oc=AdorpHnbz3Pk0BtpXzdHLAuKghndFUFeK_ln4UDRy6FaGKS6D2m6JKI5ZU9biT5R6hg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nPRKPpwiHqGndphFRI1IdD4lQlb3Pfj7CORZhw_DnkQ&oe=6A01CE46"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uzcn55lGQk0Q7kNvwHYCva6&_nc_oc=Adq_AcXAMEBkcRWIedqFu8ljFTl00fXFBYyB9tgSXyZ-JeuJQpG695C2q-UT7u4qxsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63nEMTSj2qnirUuD11APJ7CBoaxDrZVnpeaGvCb3R8sg&oe=6A01E9A8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDOsNJYFNB0Q7kNvwFQdF-k&_nc_oc=AdohNtT8X0TafcIP7Mnl1k--BURpFt1cwy9EXctNNjctroW5KrUev6FrA9QI6CdhmFY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_iCXrHqTMiudJFff8RPmWV3KPwSys-PBi4923jmc1bw&oe=6A01CA58"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJyox85z-GAQ7kNvwG7GPLQ&_nc_oc=Adquw8wsCac28lnAW84glZO6-SspVcogYLx1bXYpeXRTQB3VogIEm9pObDpMC_irrV8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I6-QbWTYeOSHGIqNMtIlVpH8Gxjlg15e0NiDcWL71qw&oe=6A01C260"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZjuIIULVWgQ7kNvwGHbclN&_nc_oc=AdpmZQzfu-6SEqh5pK9z0pSmOvgb5RiU6Z9u8oasNJJAEytSfxVzKFAjCNHEupPWns0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QDcxnvqP9nfKLpoW5zifhiJFZhqa6LagU_-_62AYNGg&oe=6A01CA44"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
w_0Q7kNvwGpEcSF&_nc_oc=Adrai_yDNKeQ-fopiVkyrAw-IKQHVnIuEWVSk45WWjymk0Av1aAHGd-CX9wdTsR2ZNg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgUWYQyUV298ywCKMbChot7GMsLN472iju4RKsMwTiBA&oe=6AE76B86"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0CR4R3gwhQQ7kNvwFBKxr-&_nc_oc=AdqH3PhbyK-AEHgcq-O4C7D5ojk0Uv9AgjMx5JWyXLRyUV5kIVVwo-6z6OxTMID4egQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMlzAkMjvEG1e9fiYsFrjQZFtaQkayN2EyQ-ys1KiZqA&oe=6AE74EA8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgL5AFm5ONEQ7kNvwEYVsCC&_nc_oc=AdojfvzsWmEUVZ08Anw8xTmBAeZcoA-Fj8At6A2l9mldU5nkyR6nzHaqiOxlMoBSns4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCdj6MdCFB7fY67FhSlXubuRfrZhVE-5Bof6AV-q8G8w&oe=6AE76798"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsoPvxWtzIEQ7kNvwGy6XNM&_nc_oc=AdpjCeh3hjlurY07G88n09O5b6_NPzwwjdapnNf2Hw2bMenILTZRt4uVOjpofhJcNVk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR55tEbgRi7urWE6CHce8iJCMp05Xi-B6h7r_9LQHnIRA&oe=6AE75FA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXvU8VRXp6IQ7kNvwEASkk7&_nc_oc=Adp6bTz5ouZ_Th50qpUgRbC4ayoyxOXRudhtLTP57kkDbYmLr6vbqRGe9R3LMu4KiCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFltoK0678iaWvwV0biIsoKoFdgPa3CJLDaF_vEIpZkQ&oe=6AE76784"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "
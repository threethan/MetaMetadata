/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_453544100291362_3040096994201235483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XwZUC5FM-B4Q7kNvwGl0mq8&_nc_oc=AdoVEuzYGXAnUJIOcLT3Wsyjr4R-Cc6MZVgMxS-gJjeGXwKShcOJWMBAdPuDse9eckY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmWdvWGqW1Bx3AAnEC0jBGEU-ZMfidPRRraa7ACZSVWw&oe=6A732F46"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSS28q9-7-IQ7kNvwGppWFi&_nc_oc=AdoScMgdcZipVAKb6nRPSURZvbeK2TYEFnVxBRPyoJkd6jvvTwDfX48mVMhxHuVZXIE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEniqoVOt8DZUoTCYD6zODUVg4htXq0sQLIrkCMCtZo5g&oe=6A734AA8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvD23ETmL5UQ7kNvwH-FxvN&_nc_oc=Adpmc3ahlckDyPoDHPncjRob0c7FD_NJmi0C2FO6qhAbRupT_OVGNqQ56mGKOd26mhM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSYYF-7G-c0goxXvHgSQiJgQrWXzJWKLZpr_iRY6pVfg&oe=6A732B58"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlWIIeeiKDsQ7kNvwGlmcn3&_nc_oc=Adq0dpHGvRT3LZxTygIziT1LQJHJYcDvS9ZWgeYPiIh6JPirXX0O24CJAr6JHBzC_dg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWaNJ58yqlkDKqBEa-FSsdpA9XWGI4sDioiENgpHkU1Q&oe=6A732360"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zHmAXRRHpwwQ7kNvwF5EJsZ&_nc_oc=AdohNkfY91viQb57qqlAj3IDGLooGrClqZXdWVj9FMASoAA4k-Q-LEshW58HpbeaepQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdLMPxV8--OQbfbP1liQEJytqp7yPI8b9cNCeWaaEiMQ&oe=6A732B44"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
/t64.5771-25/38974594_453544100291362_3040096994201235483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlfAqcw5u_kQ7kNvwG9T4U_&_nc_oc=Adnx9hVVZLx8qMY1gADElweUDz6UheGGELXRa8yN36iADDqhGk2YwLeurjrenGSmNOI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOyemr_fAEreABKeENbZLxysoeYzXFnfxfC_xI62vV6g&oe=69B162C6"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2FANHyvgtUQ7kNvwE5u4mj&_nc_oc=AdkhsnOOSUqU5oHk035R3CSTyWilHm6TcoM_8m1XccMMeqs26X7Eo9gIBQa0FoJFTB0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzIQK-tsKYQ52i7z1QY4SbkyZOPrwEcYiOsqmB5xLHzA&oe=69B145E8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMAOyTGkkgcQ7kNvwF0BWlb&_nc_oc=Adn8ghdis_0SR8jEiilLeM5s6tJDKoZpJnHFRHt0TN_5qZATC53BnlpfRfec_yoMhFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhIpLPE5ecNr2XsGAxVXxzyjRyBuCnNd5jAXyZpVfBuQ&oe=69B15ED8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taAdb0j33Z8Q7kNvwH019so&_nc_oc=Adnw3_b-7PsZg4w-0YLUaPz_lVBfEshAuyhVAshlr21ADGJea4oBPZhukLldx2ctilc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvaLIzYKPX6Yku_76Sv1az1jPM_ojp_nkz2dvuFbgIIg&oe=69B156E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77HmnHZWk1sQ7kNvwFYIIAb&_nc_oc=AdnlRat1ryr-WfOR6kKVNA3PcMVQfv0nYFJp19G2sBwDKJGtc1bTPEB0mT0rhAz2TGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbsivVL89OxDEbrmWoCIDAfflskoEfkJWPmzO8MNVqkg&oe=69B15EC4"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440
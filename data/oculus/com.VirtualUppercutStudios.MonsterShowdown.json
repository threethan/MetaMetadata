111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p53vNQ9dw4oQ7kNvwEruSuY&_nc_oc=AdkL3c_zpM4ZdUoSHUZSs1HpN1QeIA_u-XAJ2MuX8M6592ZzmkqPGrRI77RYDLKNowg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCrfzyzPY0Vm2Ek8AYX0yV1Gt5RvUhlwMdq4WnlviO0Q&oe=6999A7C6"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwUxD5SsKA0Q7kNvwG0kvnf&_nc_oc=AdlS7Dgh3Hu0AHyO3xUx3jg2uw8vRBSe_GmH3Hpx27jL_69p4m79auGV4kF4RySchQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsEKoJmxzIR3wMvS6d_au6CzcV-k5TDd_jdR_9rqOq0JA&oe=6999C328"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SmXOZ4OjW8Q7kNvwGrUkAl&_nc_oc=AdmZcbZLb1lkWa9MB_VXMSTmLL5Cr8E1r8HHPsGEi2UiWFs0Q079QB-i9KQC1kRbS4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvGhYgM-Dsfyt8u_EmC5CB9cIPJ9VfJT3U7_HmrcQ0oMg&oe=6999A3D8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUAmpRFJ_SUQ7kNvwGzYlS4&_nc_oc=AdnhCpT7skgdShSout6XRTLEzhe4BnW2KKEi_uHEC6usYOJS9rh4hE-8zBvYXfy1STU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftRwviZQKQo256qiNatwX78H5zzESsuHoqCQJgQLPa3ew&oe=69999BE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5zZe_xee0YQ7kNvwFb63C0&_nc_oc=Adn1Lwxyb0K9OlJPfUKv48M5Sd-NP0TVEepGMWp0ro4VhzbrdHxkqtR54Nxj40laYig&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuNXtZRK6OfUtZBQ-y5DVv491kVRH0YtbKNTg8s4oIsLw&oe=6999A3C4"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_
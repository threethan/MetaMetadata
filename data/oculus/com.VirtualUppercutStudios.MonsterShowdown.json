4A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsGtOBY4gkRaTtVWgQy_O6PrRq2sxO3TA50JbMD3jowAg&oe=69A82846"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNaM8HnpsA0Q7kNvwGI9X_D&_nc_oc=AdkTWWhQU-Kri63RNvuBs6qk_UypVHfWPREy55N7dnb5wndRntzUWO0rTyavdN_mHKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuCFYpZAdYg0KA4smndIKhBX5efrJ4aFEDXozHu-SEpiA&oe=69A80B68"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs8RVgxaYp0Q7kNvwGYYJ1R&_nc_oc=Adn2bMcvKmdrBcIWg-nOHo7O4cRPYPNXj3O0UYNQTkG4YBQvzJVM6uuQtyrKxF3-oX8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftNoFT3mvMz1idxBRQVYg-iE7qhSXZ-_Da79wkPx4K_Wg&oe=69A82458"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyNwmUmHGgAQ7kNvwEQ1ayS&_nc_oc=AdnYkASCeAPMO2MvVWJbrGO6dOGigbwJata59xYTzuoda9XoO1MEScA6D6qZKMKheiQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvF5F2wh_xMW6zdKZe1m54vlMsZgWtoEA_e7tZroV-ITw&oe=69A81C60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcDQw4NMmfEQ7kNvwFx3e_b&_nc_oc=AdkewntM6VKrZTKVxgPJi95YAMneHBFZRhwlUMROxThndy5LJn1hIQLURm1h3o9aNsQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afus24mvmURUatzw1X9m3wZs44x107I0kp-M3hYZwpBasw&oe=69A82444"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
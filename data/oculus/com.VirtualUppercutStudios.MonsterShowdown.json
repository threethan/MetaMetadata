/t64.5771-25/38974594_453544100291362_3040096994201235483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8Ts1O7zx2YQ7kNvwHxZ56g&_nc_oc=AdkForNOtT9a8Zvd6VBpgC0SQP13gTmUZ_Upobsn09TFqPQ1qsrn7L7fbE48FqsOa7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4mpdMU6eQbpYanx5Q5U-KhQbAicc5aaIDdt82h67ZKA&oe=69B405C6"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2FANHyvgtUQ7kNvwFHjxbX&_nc_oc=AdmHlXxcRn3TziZAn7bfX9CmIy3bX0R_AmZG8vWXY4oRKeHqtCgcYQZEKrmtQX4h5Rw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdDS2SDFY5682ni-MfXhV4moj243zekpFUsyAQc7X21Q&oe=69B42128"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMAOyTGkkgcQ7kNvwF4vAXG&_nc_oc=AdmpVrilcawk2VWj1QCSfch2fmHl2BUqRqp6eODOmKoeQMgtNeR3PlbrBQy8QWp7dEs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2wFwvgqBrtZPCWcXDceeM_wrPrjPDiJm2TxZPamm7aw&oe=69B401D8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlSCt8uuAxsQ7kNvwEM4LAY&_nc_oc=AdnejVEzgiVBLKF16C8wuu14NBzBalOFptLNs34jg4TN4F1LXYbCF5cUIR5YTa2jwTs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzW3Wl1EJIYrc6wI_03aDch7i0EO1bKgN59C2yY1lpE6w&oe=69B3F9E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yp7rdMkvU9MQ7kNvwHYMFNE&_nc_oc=AdlzY8ANILsEoIq1NA-4mqDD1iTJmU6jKaj0m-V79hkgNt6SeRSi0H588lB8d-4wI0k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz6J1iV4iGhJ11lVf-t7OVJAEt8WLRz_b4fXQjv-8ahoA&oe=69B401C4"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440
mnIQ7kNvwFfP5zX&_nc_oc=AdoU7sVk_ixmvPh1CwSjKwF_rtQsWivHw614UD3HRD3eoonmZNpee3jUm8b-WLUhRq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB366O-_z362yD7PJiGGgJd45HkVX8rpjMT0wb_kSl2Q&oe=6A5B7446"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx9jI_kxZOwQ7kNvwEI9hev&_nc_oc=Adpm9Oylv6xtV3VvSrHewu9w2VK9vhNd8uWpslY_ZuCVQIe4pNOLnA2iqUDxM08XstE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD6k9vpAq2riQSfzMKK1Nk74w5mk_WdwjpM0jWXJK_aoA&oe=6A5B8FA8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTccYuHBht8Q7kNvwHk_Zav&_nc_oc=Adr6gIuD1Xpe9WS0R4-2ZwUP-nT-rFzI3kUVVLH7j2TeYjCZtOt9lf6MRyGRtZ8zYR8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0zb6XhE0GYt1jVNtuVkEhG1mlKH4VvI-g07zpkZFRGg&oe=6A5B7058"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQsAi6tQ_wsQ7kNvwElEwLO&_nc_oc=Ado1WFIMydd6LyNt2IyLx7VQBp4OtRzsosPnhWibzTjUZf82q1altnf6CyJzchSoibo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9KEFahwS7g-r_V8qThQE1LSkKq7dsTRSPzrAaiWSnag&oe=6A5B6860"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUE5tKVEKxwQ7kNvwFc3hDd&_nc_oc=AdrER9VMhv1_gSxlZXpVXa1g6jbDY8zFxIYjOLlZSP0VXIJu6wATvWdEUUFUUKfo7iY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVliZp78i96ga91C3FaP7Ck4Cdfei6WfdSqCWa_ztqBg&oe=6A5B7044"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "
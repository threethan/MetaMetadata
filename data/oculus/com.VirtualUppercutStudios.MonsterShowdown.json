111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p53vNQ9dw4oQ7kNvwG7kuYt&_nc_oc=AdnM5T5gLMsalA_kodzJPHyLbu2tYYia3b3fGO5niO4AbHwa60DUoXKeCcSGJSzgsHo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsKUyhVLFYmjJCN6G3Pnwz4YciJGNQfABsVK-ZC_wzknw&oe=69985646"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iGz58tGkowQ7kNvwEZxLec&_nc_oc=AdkZ0rQj0xcjOBMSai7yZzACIttJuUM0Bt-JNDqIFLRXlHv4z81vtUYIhHA1tmk0WLQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvCwA78ss_kIMj0_96qAFNL-KTScxsJBuwOMWNFiJO2fQ&oe=699871A8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVNRVcennqEQ7kNvwH3AiFc&_nc_oc=AdmzzbRzn3iOnnMXO_ECKJ_xBajxY9zsMW4W0WV-xgEmTbhZ_522QCma5I5DUnaZ7XY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv5h5VNfskDpyiUfTBFcZaKeRd6u0VQzfPhaEZKUkRhGg&oe=69985258"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUAmpRFJ_SUQ7kNvwE-6gcW&_nc_oc=AdkVCTZ8ozfjLPJIIZwtIGiq_pP3_QOZxZC5qWdD1xDb97-Q6qPEu6bUIWlX3knCh-M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu1BFBlPVQmBFJYgTF_kus43JRc0hLKWonIW5WpFmN2sA&oe=69984A60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5zZe_xee0YQ7kNvwHFl-Bf&_nc_oc=Adl4HShJcsPA2J_ZmYTZfGtvCGyN250ESBgEdZRMlJIwO9PV6vkg8KMzq5v25S79xqs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsUzv22AR2TaoiHq3PXlK6i5ybBWs-p8n-vEvfzpaR9nA&oe=69985244"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_
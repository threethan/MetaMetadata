/t64.5771-25/38974594_453544100291362_3040096994201235483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M8Ts1O7zx2YQ7kNvwGl9Qhs&_nc_oc=AdnOHPoYx-y4rwJmalygyJJiSaNOxkbV0oIBOXAQgv82PtUGqILb-jRn0uTNvmEvMek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwZDqdSeorGA1_GIE6EIKju29ui1XAMunb9DB4RJnVIA&oe=69B6A8C6"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtJELrKDC48Q7kNvwFNAYYA&_nc_oc=AdlAHX3qbETGP0XlFDGbAYalBvFwMpvRly6HIBWfyYZeKFstnshkzQKGPm8E-hfCqAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzglPTt0S4F1yzMNUjhW8gmzQ25urzlSEp3BVE0Zd8IeA&oe=69B6C428"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI7VZM8mc4MQ7kNvwEcVBOF&_nc_oc=AdmwhSapcBxHWXj5MOSe5tGl7GjPzxBH5kYmFDXZsTFOw3E5kxCxUoTGj7p0-dEoJQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz98mqu5r3qXmri6nYbisUYv4A_1yqdLgWYTbBE62PgVQ&oe=69B6A4D8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlSCt8uuAxsQ7kNvwHRRgRD&_nc_oc=AdnMKvLVsdOwyIus7kdPQZu5qJopfoGYhvpKWcWsq1drs4TNgsU7Ad7VhGLIs_uZe7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyr0DJkCPyLRjxwqYHzEcRAXiRh2cdIjcPiEn173eVo1g&oe=69B69CE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yp7rdMkvU9MQ7kNvwGxawP_&_nc_oc=Adl5Gh0bN1oKH-GZOHQvXxPFUp0A5vzxxu7EhFuTDSQuP5xCFHuWPWe9Y9tjt4k33Ow&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjDmLinnAjT8crXYAQ2FQSXgE-JrMmwH_AQ0WKSq7IjA&oe=69B6A4C4"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440
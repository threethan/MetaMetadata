CwsQ7kNvwFfng88&_nc_oc=AdpHw4E4QIfAPa-wH4_w014wY6IHEmfgRtWDLb0A2H9z38q9g5ENAkCCeuw5n-aftAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhvtSk9FQd_aZhIA0GeU3Fl-sO2R7UY-r4rD1ROgXgpg&oe=6A4BA246"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu98M5jXf74Q7kNvwG8yjkf&_nc_oc=AdphW1xbe6efqjzDN8J7IsPFiF5QTyRTPOzU0gbAYu5U2XDonPgiOJ7301hw9lmLpLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw-SRWnv86jjfaRPPD9P2UA1Anbv5x-OlgP1aEYAblTA&oe=6A4BBDA8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5bmDsSOoVgQ7kNvwEh4Ez1&_nc_oc=AdoF7RtjrUsZLg3ToDVn6nrQvTpITOhfQZpXGcsJ7RgF1iXcElj1IaGYTCHmWOM3j7Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4D0pcY5nSYuM-gQQ9aDOS_HTpgZ0Opu7EzTxQCDW-eQ&oe=6A4B9E58"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rXA-VKxwEIQ7kNvwEIGWJ-&_nc_oc=Adpvcbvyp-ZKN-8eBSiU9xNdzVDel_6sEywEP3H65DQWwih2Z_1kTkVQEEqJpDbWS_4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCf2dU-wVgxlyheKcekZsC6j54MFjmhPFtKuj_sIqKSBw&oe=6A4BCEA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sGrxN7TV1y8Q7kNvwFybiHW&_nc_oc=AdrzFagh7mfw70l8jKauziCsDE7NojM_nuKaS7OcHFORlFpN5wy7ZLyYr74ZwhsnN34&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3yYr-yT3RmtYRleDCjvs2x7iSBDrSWTJ-WaFzQLiYvQ&oe=6A4B9E44"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "
/t64.5771-25/38974594_453544100291362_3040096994201235483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wD2NNjSumFMQ7kNvwHl0jrj&_nc_oc=Adky2RsM-DlLQmE9aAj15bB0Jm9X8SwiDEVl0FddQ9I2ZFfrVg_SBUqPaq29shi4WFo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgCA-8PPg5xuokFQh-Tumh1LeTfHKYtpRjAiCxyY6N1g&oe=69AC1CC6"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ieWIzmLYmcMQ7kNvwE1QgBo&_nc_oc=Adny0vooEZNc4eM_eLySjnAE8vhsxG_eFkoqxamQeAxoLavGpgFZtkjFhBD51PKujA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwl7j4WJlIdBnSkEiP1gy8wU4G35AUbvS25HBISC7a18g&oe=69AC3828"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi1ow9YUKcQQ7kNvwFtN4Xf&_nc_oc=AdmpRmKJq9rYfpZ5_z8Fzd0qsJ68XqyIEHbyUbAWFgK0ToVlseRixWAbCVK-tBMXKOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxidVispORMFr0Ghn-wBPexSr7LoXqORLsypbmUjs8e1Q&oe=69AC18D8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOqToJsJjwYQ7kNvwE_j6Dj&_nc_oc=AdmGEWVN3FzsYb3W9mTVCaY6y_Ll_61zcwng6SsOC9w4UTMNiRgENuFRR_XgHJ25euc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfycSWFN_KCA-DyoZpn9EfuRu38dF4Owcga1wlEriNK-Bw&oe=69AC10E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6DVLrsF_QXUQ7kNvwG6TqIx&_nc_oc=AdnucYDGNaeL0qC96IUoucXsxZqZQvAfEE368tBj64cVpFJvkrzZNGPDWeK5D0U2ZBM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwOYMDWaXn2f3GWntx8aMA8jo65R8Hl6JxlbmIUYcW3IQ&oe=69AC18C4"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "37440
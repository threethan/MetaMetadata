111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UiIvdIhVAoQ7kNvwFPjXQ9&_nc_oc=AdlmuEwiJrobieI7N3sPNlkZhDDpRxPSrBc4rdEZnf9K9v8cNv9GtkofraG3uwFcJAM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afv2hvqUIZyzTaLkXi4sAJyYLpHya4M4ePOEPet5g0ygaw&oe=69A58546"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNaM8HnpsA0Q7kNvwFh1Cdu&_nc_oc=AdkXH8mRwCHkCFuqaeKCIHQS6m048EcYZ1JBwP0M3_sOrTkE1RbExEcs0TcpM3pxLY0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfsZdN5tRzK2EXFrpfijdC4ecFgDGvtojR7jabv7sVgEfg&oe=69A5A0A8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hs8RVgxaYp0Q7kNvwFfop4H&_nc_oc=Admszt63QwJomZWFcTA9ZqLI9-QDmReeuvkz8eWUmi8dUgCTm9rt_9XZ2yE4TDgLRFY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afu6N2oMmndYiwTdg7ioXJOe1mwB8bIWOWY0MZJws9p5CA&oe=69A58158"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAErG-PaKokQ7kNvwFJu1yA&_nc_oc=AdlL3V3huhqOiPG3ul23lgSkuIoAEmVAhKmZU-9TvdPrPhP6ess3bEDoyxebvUJmm7Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsib0O7BxTsm1Ufwtnexj0xhiA0rxdO8ZpAqE6JeasDZw&oe=69A57960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQcDYc9I4ugQ7kNvwF_DpMq&_nc_oc=AdlgfJlhBAjD1o2hyEE5Nh2hx-tRykhRY1Lejv1tuSMnsKzxxEjoEOl2AGoA2QJgeiw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsbF0Z5fHtmuRDBFPW1jl4scOTymFlgV-HmBI4ZWLK5ag&oe=69A58144"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_
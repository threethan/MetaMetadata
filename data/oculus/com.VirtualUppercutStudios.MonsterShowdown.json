WEsQ7kNvwG5PNq5&_nc_oc=Adoma6hpV3BQM0Xw_K8Ju1p2Go1MVlsyKtT77MD0sQG6uuAuWYwmoKeDbZlJIB7Tk1M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FI-rlJ2hWkQ8OWlBaKoPm7e_xnQLvuiL5I2KhVG4p5g&oe=6A241546"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GycytVBoDcQ7kNvwEGbqFE&_nc_oc=Adr815IKHGYJqNBZPuXt1KJnshiLOES4z6Fykpwg8UK6gZXQ4Q25GMlLb2IPPjU5ZbM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AB9Dtfl2hLfUmZguvigEAlnUNXai9yaRt_wXCbUN_4g&oe=6A2430A8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3Y1FhAcBnEQ7kNvwH_LAUs&_nc_oc=AdplBuvR_OVS8HWhjovA0WIP2XG4JJg3eS-Ac0fPDh4mru386bCAGYgBq1XKRGqmddg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FgrXVm0rbMBPn-f0wzE6tECYZAYnVZOVY_TZeDZ9TdQ&oe=6A244998"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgrTmCi5iXIQ7kNvwEWFgu-&_nc_oc=AdrzKA6KuDqcJC-Li3VrttvVuen7Sv5LZ_SmzkiecX8IgQdbe0SRlpov3pjyj9rGQmE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u_lxVsclKATl4pUVKn1dN8w7aT1DgZa5Iw9wAlIYCIQ&oe=6A2441A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CNL2PESwQoQ7kNvwG6FHg7&_nc_oc=AdpvFS7_4CGWSHI8YuhHkcIrTWnNgoBrCTgSaRdzlniKWbEF-BzlL7TEh19_1Yjb-Y8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_edU7x6O--bVi7a9NI_6bKdaEUPNPPFl33dhXMf5G-RA&oe=6A244984"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "
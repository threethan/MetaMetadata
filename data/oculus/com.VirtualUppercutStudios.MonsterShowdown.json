aG0Q7kNvwFdW19c&_nc_oc=AdpMFp0jtzSNTRf_lPYv45ZZO6JcBl8_Whl94EkNvsU0Gel9qWzpgYWx6xiMF5N9ENA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLivm-a62w21PIrnAFI61KU5VNVnCA7D2Jw4SjOzUtNmA&oe=6AABDFC6"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IO9BYBtiDt8Q7kNvwGkrCu7&_nc_oc=AdqonM7VsBj6Q9Y-JL804cFm1Atucz1O6GbE-v86g_ZjFYktYamxmgfbZ77JiAkYTBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiAIgruVE4b073cSvKzI4YgzVRtnsQdqa8tmJdW1h-8Q&oe=6AABFB28"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcDxYEBpKKEQ7kNvwHpQPVX&_nc_oc=AdrR7qgzx7yuQ5X2HPgaQz1OsN-QdqIcFjvaUZVqem2nURvSZQEbI7JSZlDL52PGXGA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBHS6pERXc_GtLh-K-J7e4DDfEZQq7nX8D2M_4VEQEwg&oe=6AABDBD8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D7JYtlWqq7IQ7kNvwH49vBe&_nc_oc=AdoewRlcwnqtsAe2QItf-uvfbaCp8aD5fipyxU0BfOq0nGmIJmwXa47gdk8ZnLgtUlk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpmT4YQxgpIHOjs_4V9fU8F-ohhLzIAayQYGCBehkkTw&oe=6AAC0C20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CU1HPMCBJzUQ7kNvwE-SdSi&_nc_oc=AdqjBeSbvynhN5Jm7MJ4_Musd57GujvqvVyPhGqh7SBK1BLLIY8pxyVnD_3JjW-7Nn4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3ccuQCQOtgrR39jyqKzLBTtaKvpvXYNx8RBNZlbiWQg&oe=6AABDBC4"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "
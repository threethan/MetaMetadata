/scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974594_453544100291362_3040096994201235483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_x4St1atoIAQ7kNvwEDHaCN&_nc_oc=Adq5L05m7GYXiAw1A9p0WoI5IyGek1XbRK3jRwFOnB7TRsvJY8j2Bx7_6zHJjj2ISfs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50CUCihOnTR-YHEyZuyw0f__v6udFBWs3vxkb7qNn5Tg&oe=69FB36C6"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-6rwTXYOJkQ7kNvwFXOsY-&_nc_oc=AdrdCrIqYrX-9aLnaSG0gBoaX0AFvLxtq9iDOevuz8MMDFcu-b1q-UgPccCjuUtvkLk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c4IgdmySYUEkteFXCO2pRSUyasw3in6X-GwtEh9efnw&oe=69FB5228"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vATIuInvWwcQ7kNvwH3e12D&_nc_oc=AdqY-DeFQpZHnfzoaiN4Yda42R4S9W9cy_isUWWKVtnZulsfmbgcxQ5DUx5F7mr97Rc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LmCbrUK_NI3bHJp0gr94v8lMrgBNA_QNUcJmBI38-9Q&oe=69FB32D8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em2ZizwyfuUQ7kNvwHLVUI6&_nc_oc=AdpuyC-NnA231o2bpu9ksu6DN7paTi3YmPCeJbFQ2iBgH9M7TBRsMyuZ9u3bn9nPTkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f75ieIhbULlMP8CSGepc-VGihCtJE8K5GJqmcRUoLDQ&oe=69FB2AE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlmTviitYDQQ7kNvwGmRh9N&_nc_oc=AdpcTLHopAqbbpp0xd7Rnu8W4ZmHUjbmCOdhPZQPi-jQ27ueA6GYnUMZbbDHm0OodLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48Hnc8zdFdjpZTRAdfMCYEYTt_Vm856VqnVPa_XrOxeg&oe=69FB32C4"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
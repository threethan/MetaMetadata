709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwUxD5SsKA0Q7kNvwEnGpQ8&_nc_oc=Adk-_9xlr3nLLfa5C7sQ2xXWNUu8Op02G3XnmaQCeHq6WJCi2LIlLi5Aj6Fgzzw7uPA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu34a0wvZ2BqcIFxVdaDPV2NJsV77TSTNYfw9J1cfU0SA&oe=699B14A8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7SmXOZ4OjW8Q7kNvwHFdew2&_nc_oc=Adk11nphfhpTvhjpu4p2T-2vRAy7Z926mLPTbtpXihA55GJATslThk8BP2MtOBIoays&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu9gyeg3uMrJJRoMf30ptD2tP8iogkzCb65YhYFvJ397w&oe=699AF558"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUAmpRFJ_SUQ7kNvwGVsIOm&_nc_oc=AdmuxsRtVtmFBu0d2ecr3FFz9wAMnG78G6enm_UVg3tc7NsxaZL0Nsf0GcyqA9nJ4Ww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsveU9dtAoTK7gV4eEGEOpUoajJnC0UEbxvvDRjoGIw6g&oe=699AED60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5zZe_xee0YQ7kNvwGAC7Yk&_nc_oc=AdkD1BAqEN3fgUptWwdK0rKJwG3OXkbpQDEY_bffuFD56wMOJxVHinUxJ1fvtHevjZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvbGdFO8j2FKLShur25FtkqTbz97HlrbdBCzIfMh-cztA&oe=699AF544"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported
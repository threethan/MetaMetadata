d=6e7a0a&_nc_ohc=MGv0xMUz0icQ7kNvwHZfW9V&_nc_oc=AdqP6Gkv1rNDl3zYQ-BOtEY2OTEnlJzAi--hlEdrae5VSTrUj8Vot1BXosSzkZS4O30&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7tCrE-weTjKPdqyDBSMlMFuh2xARDZBXulAq1ORxO5w&oe=6A8D8D46"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W2vg1u4MngoQ7kNvwFFhUbo&_nc_oc=AdpdvSzjkgruf78V9pfHGN3kPNi9yQbscKsEDSU9G0eJJdXapvqAwcma3M6UGTwOjAc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo7thuONoAd4ln3PEuMg5XR1ro4uiyXbDaP2GAgPQ9cQ&oe=6A8D7068"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBKHame_g6gQ7kNvwG2EP2T&_nc_oc=AdoJ_EjlFGOqTZ9wIXiSohlf_CHW50KAYBVZhHl7Cg0WOynLJvvQzfQbSvZce1Z_epw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSaiQJ0BZM5hvlC_uquYn2hUZ6AgV-m7yKh1Z7tgEl7g&oe=6A8D8958"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfMhQKw1AjAQ7kNvwHZ_5lE&_nc_oc=Adq54wMYv7TJ7nbo4Pti8RhkQA87zq05_ZWa43yks8zgDtXAQCNCvTOwjrpClIogdSs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0svNUjpGz6lEHZvUaSMUdQSv20NTg3F9ZqphX563U6g&oe=6A8D8160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35z8kPETGCUQ7kNvwEPn4yR&_nc_oc=AdqWrmG75CK1aoSCj5O7bi9tW9XuXzVp4iHtBX5AoiJVdYm56qtk79T2PoxvfkhzgAI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHUmUweA5SUj93gtepCDFmUlnnyk8Eq_KD27hLN6OhnA&oe=6A8D8944"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "ge
: [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomm
d=6e7a0a&_nc_ohc=MGv0xMUz0icQ7kNvwH0aR3n&_nc_oc=Adr5ti5PHyVHFM5YQK7lHWlcH1Lk_GVg62kC7KykfCtYoS7jcwRFSrOlUt6C_wsO5EU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu0pfQo34akHCutm1JsalwrojI3iYM8R1qJ4nvSDPuRA&oe=6A8EDEC6"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zjhsOOw2ZewQ7kNvwG8Hd-J&_nc_oc=AdpVlwufCURbSFl8ZyO7_TFCJxyyirQS3ezDIpvdCpsZpF9eHr2WG2lXySRuRCjPPr0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGopWi4AZ993pWdtPOhNIv7GCffK0Gm-VB7BcnyWFhY-Q&oe=6A8EFA28"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mMW5w7JR74Q7kNvwEAwTeX&_nc_oc=AdqlDmUZ1-a5zjoe03mT0b7lEtCKIpKx7lRFH2ABzRFInC4_y86LrO-sSOvfBJcFsC4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_3rcmbDNLn0YEAInQmnzlp5yZOZaCC5c2mjqYz8czvg&oe=6A8EDAD8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfMhQKw1AjAQ7kNvwEB11ze&_nc_oc=Adq_XioV1QQgUuh-mjdcq0p7CL_V-nh_8aUjDMmiFL3HC8U3_F9TOs0MYI5WHE8HfDQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHQABjmDAz0uBb176_buvHBIYSPdIClx9zONnbzTIEsw&oe=6A8ED2E0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35z8kPETGCUQ7kNvwHY3F5o&_nc_oc=AdqSwl9Qo3WHApbC-FRa4bDeVO8yPUi5V9HybuFR9yfSJrnmTvfVzNvq_N9JRnyZ1Z8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpLky3izMnQrozDkCwj77mwYGJmkzkdF6F-grKeiyEbg&oe=6A8EDAC4"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "ge
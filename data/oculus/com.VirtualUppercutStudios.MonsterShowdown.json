94201235483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AET766qFgboQ7kNvwFwFpQn&_nc_oc=AdrKig9u-eTjStQGCOIP3o0ym83uwi605XQAOTw1ZsGECtuCO5xV6WBEs_oT7_vdZpM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1DT8uWENfkYO96_Tgx58RvRZXWwMDrHYmynkkn7QSnyw&oe=69F1FC46"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_n6P5fIf9wQQ7kNvwGU01C1&_nc_oc=AdqcswgT9kF3SZje8BXGYYoRrMjrWDBxIntlZKI6zWm1XRQpb9wqN4siimMdkjpbAGA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3PMJYowmghaIk4fHTbowvqEH0JkwAFVshmMrSxKl_Vkw&oe=69F217A8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13lQG4k_xYgQ7kNvwHAifA2&_nc_oc=AdqvNzTWoDO2QZaFfkX_02_xQ2st_YulEoI6eg7azCnsgT79tmJ7-I3nm6J2RyjAWxA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KUaUK0DUR0JQtvJrmORSkSDJiaRVF_gJIs5vIGFrsig&oe=69F1F858"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mBNg7hQ9voQ7kNvwGdpEfg&_nc_oc=AdpKr1Ujqde8IX_NvlC6o0x-ssistKR6okB1_qIDIeZ7LeACCF-w5QMIMoQ4mctITjk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1QEoAVbM3A3XkTnU2UrsZFNFMrYZf1ZTAGnLXv5lDCTQ&oe=69F1F060"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaqjmRVeodsQ7kNvwEe5RNB&_nc_oc=AdohkYHe3fzRf9eoJyWdWAh3mZJ8x-CysdD6dr5nDnfkizIuki1vlJchuDDv6efQv9g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QU2AAFxRY4vDDH91AH5jS_aERtrAGY4fhTpVCRKWSSQ&oe=69F1F844"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_
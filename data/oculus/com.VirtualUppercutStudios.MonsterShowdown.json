94&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAOgvH1eIruIoAoBKT-lxMb_XD051dlq6tknn2-MZLUA&oe=69B55746"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtJELrKDC48Q7kNvwG2p4l6&_nc_oc=Adkhvi1YY1p9U2G83sX2Rou5f4bVoscw8MetrWJMD4HJC69Dd6FjTc8Ig-DRKbeaCGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKZOyaeZSEoQ8wxtBADUkR1cPNfxzTMLd1FutjlQz0tg&oe=69B572A8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI7VZM8mc4MQ7kNvwGihFGC&_nc_oc=Adm9zf6asne2z-hd48UCXxJv7ebVkmqcjMazPOo_XMeHRccwbTFQBx0JkvWE9zYkHOk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUuQnfXYC1zc6YQy9sj2gCwRFWlzH1xFw3hGFPQEVmWA&oe=69B55358"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlSCt8uuAxsQ7kNvwF6Mjbt&_nc_oc=AdmX_leu09KIeCpa6IAgzAnGuMkFGk9xNBExxsRcQcU6iKEk_yzTkj5qrZ0K-ps44j4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWSddXV6UgWsAnNrRqHi94lhjGE6WZLRQ3jh0dboyLhQ&oe=69B54B60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yp7rdMkvU9MQ7kNvwG17B8z&_nc_oc=AdkqWJG1KilCx-duF43P-E2fVSqn6NQHOojxNUeWSV2ch6dRTL6qEyNHyswXqdN62x0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyrLO5Os0Ck1O-AGxakiNktPOWnG_Al3aIVe4eUxhNeGw&oe=69B55344"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recomm
c_ss=7f20f&oh=00_AQT6IsJoNLpn51oTlUQr0ORhubb6O75wWRrMOPh9Fryf6Q&oe=6B01BDA0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnQcnjJyy3EQ7kNvwHHwsOo&_nc_oc=AdpS3uPhmd2h6HqTPw4sKnz6vt-thxZic9-03XcIv2OzmxWD6wSFAhtFVHwsqW-BrbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIeJQuuP3MyuVJTSKZIVm5OnEKWUohSSMSwfnIw6yPtQ&oe=6B01C584"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7754465961336688"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982439_528762148443094_6255948107183779390_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tio7etbrysoQ7kNvwF5C8Xh&_nc_oc=Adpmuyv3RC5HaThLwLbNU7CZXYyspULLpI26K19NMEtJVrGfmPmm-QjdPsJNCwXad-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6sePxWpdxlGRb0M6r4wRU3vmz85fUtCeDHKqaofFMGQ&oe=6B01C686"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monster Showdown", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1720576501, "lastRevision": {"nodes": [{"id": "920284385290762", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4402198039896847", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "pla
/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974594_453544100291362_3040096994201235483_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT7t4stBwWEQ7kNvwGMT87R&_nc_oc=AdqHTgMX82I0LPrUThWIXbXnz2hW1t0_p9ypZrTjtbAfapzEjdzvVQM8qfsIziSbOlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtokCZ1yj1nHnDQw_MUvnNYPQG7ZAqexodVIXhHSYP3A&oe=6ADF4A46"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_03.png", "id": "2301954699981709", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974520_2301954703315042_1847319707555032737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ID8r3AWnNpkQ7kNvwHua9lu&_nc_oc=AdoY7Ix5jdQOw1g45zhIDpGMgn-uX6LMmfee1lTi4xtmHWiVDB3F_4uhViwcXU7Vv48&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7ukS7Y989v-9vAA9XsoCd0efJCG2MYgjK-qSW9knOAA&oe=6ADF65A8"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_04.png", "id": "859415002172477", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974624_859415005505810_2655162829923881549_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SmW7R7U9y8Q7kNvwE-VZka&_nc_oc=Adrk7Ka2eMKG6M3-u2Co6-ZfLXo1KPcoEx63I6tW7Uw_m7n9ejSmnZ-XFMZPjB-Ro8Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPysSQrcuvMU89M4q7PYli76Y5yIl-ucMzgkxCwQC4onA&oe=6ADF4658"}, {"file_name": "MonsterShowdown_MetaQuest_Screenshot_05.png", "id": "2033695030354819", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974783_2033695033688152_4871367161749715491_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HThJtqZgJAYQ7kNvwGhxDrv&_nc_oc=AdqZfqbEH1TRJyJlKEe2cOH8ucQ17rQuTL2WxueB_rcYiXtaw5oAs4peZTounxk4NSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnJCinJofTiZT7ME7ImHt6SshXmzuGCVQ0lKzr1JRbBg&oe=6ADF76A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "GameLogo_Oculus_Landscape.png", "id": "319282960248982", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974733_319282963582315_7998975996488655246_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm28w5BCzeEQ7kNvwFWk-DW&_nc_oc=AdrIRQgvIL-3YYNN8eesrdW-StjIakjmW-5SrZblNQfFBPdHgEjrJTLzuL-feHUIQw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg7GBxt1hFcMbniYNoD80yRwWfQCSLfyqXOMJct2pr7g&oe=6ADF4644"}, "display_name": "Monster Showdown", "keywords": [], "long_description": "Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!\n\nWEAPONS:\nBuy your favorite weapons from a choice of over 60 from a dispenser at the wall or try your luck at the enigmatic box for a chance to get a really powerful gun.\nYou can also attack enemies with melee weapons by swinging your VR controller. The more skillful your swings are the more damage your attacks will deal.\n\nUPGRADES:\nCollect currency by taking down monsters or fixing barriers and spend these on upgrading your weapons or acquiring Perk Donuts from a vending machine.\n\nMONSTER AND STAGE VARIETY:\nExplore environments from different points in space and time for a varied experience. Many stages come with unique monsters and boss monster for you to take down. There is a mix between quick challenge oriented stages and wider stages that invite exploration.", "short_description": "Monster Showdown is an action packed VR shooter. Survive an onslaught of increasingly strong Monsters. Explore your environment to find new weapons and upgrades to strengthen yourself. Take down the horde and escape the nightmare!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.yahyadanboos.com/monster-showdown-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Uppercut Studios", "support_website_url": null, "website_url": "https://virtualuppercutstu.wixsite.com/monster-showdown", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_c
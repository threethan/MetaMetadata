luscdn.com&_nc_ss=7f20f&oh=00_AQF4Iv47-QCftwZ2wSLnGU1XQD5XhritUR7VZoYLw8t4BQ&oe=6A9723E8"}, {"file_name": "VideoCapture_20250301-111301.png", "id": "1160779295598567", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473392054_1160779298931900_6432958871433057053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGuRWCAsLE4Q7kNvwFWho0P&_nc_oc=AdrWELx9I-ogYxppksPDCLbv_pKZnxSVEKG8wAajQBWYuuox4ntusioLmwLg2t5v01k&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHwBTE5Z-8o9dvsO8VFpyxydEKk2EN2oFdWKmINq0mHg&oe=6A971D87"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AquaPoloX", "keywords": [], "long_description": "Dive into the exhilarating world of water polo from the comfort of your own living room with AquaPolo X, powered by XREAL Augmented Reality Glasses. Feel the splash, hear the crowd's cheers, and immerse yourself in the game like never before. With cutting-edge AR technology, you can experience realistic matches, train with virtual coaches, and compete with friends in stunning virtual arenas. Whether you're a seasoned pro or new to the sport, AquaPolo X offers a fun and challenging way to enhance your skills and enjoy the excitement of water polo.\n\nKey Features:\n\nImmersive AR Gameplay: Experience the thrill of real-life matches with advanced augmented reality.\n\nTraining Mode: Hone your skills with guidance from top-notch virtual coaches.\n\nMultiplayer Mode: Challenge friends or players worldwide in thrilling matches.\n\nCustom Arenas: Play in a variety of breathtaking virtual arenas that bring the game to life.\n\nStatistics & Leaderboards: Track your progress, improve your performance, and climb the leaderboards.", "short_description": "Dive into an immersive water polo experience with AquaPolo X."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c687c0ef-a024-44f0-9b07-56327ad71f14", "developer_terms_of_service_url": null, "publisher_name": "Xzec Gaming", 
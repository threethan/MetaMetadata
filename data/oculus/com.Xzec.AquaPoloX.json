n2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KxiCiE-66D5udKrTlvjE-_XM1cZOpf2lwRDo44aBH-A&oe=6A36AE28"}, {"file_name": "VideoCapture_20250301-111301.png", "id": "1160779295598567", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/473392054_1160779298931900_6432958871433057053_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooPvTmV5vQIQ7kNvwEa48k2&_nc_oc=Adqsn5hREXwrkjKtWeDya71-PEM-1y6PhZLtWcUgdFbMOrpwK4JpseSerWA7gESGdw8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dpRqWRpkhvBwRo_fQSlb8Eo_SJ6r1XQq3O_Aj5_zPOQ&oe=6A36A7C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AquaPoloX", "keywords": [], "long_description": "Dive into the exhilarating world of water polo from the comfort of your own living room with AquaPolo X, powered by XREAL Augmented Reality Glasses. Feel the splash, hear the crowd's cheers, and immerse yourself in the game like never before. With cutting-edge AR technology, you can experience realistic matches, train with virtual coaches, and compete with friends in stunning virtual arenas. Whether you're a seasoned pro or new to the sport, AquaPolo X offers a fun and challenging way to enhance your skills and enjoy the excitement of water polo.\n\nKey Features:\n\nImmersive AR Gameplay: Experience the thrill of real-life matches with advanced augmented reality.\n\nTraining Mode: Hone your skills with guidance from top-notch virtual coaches.\n\nMultiplayer Mode: Challenge friends or players worldwide in thrilling matches.\n\nCustom Arenas: Play in a variety of breathtaking virtual arenas that bring the game to life.\n\nStatistics & Leaderboards: Track your progress, improve your performance, and climb the leaderboards.", "short_description": "Dive into an immersive water polo experience with AquaPolo X."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/c687c0ef-a024-44f0-9b07-56327ad71f14", "developer_terms_of_service_url": null, "publisher_name": "Xzec G
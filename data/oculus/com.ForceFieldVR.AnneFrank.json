84_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM_0RoARfRkQ7kNvwFpgRxi&_nc_oc=AdkP6XTECzbLrS1Nq-nYbHuend0pxy8VuEYTHKH_pIKqvRQw-mOZlqnBfQqAQGH6vWw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuixGmi8zHLsuNUmmqtlzMZ-qLqiQeXn2EQUUfQrNoUvQ&oe=69999FFD"}, {"file_name": "migrated_image.png", "id": "881607195623323", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602063_754441544760959_8512174522638532608_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_1DbdKx4EoQ7kNvwE4qABI&_nc_oc=AdmIlqLtj-6SenmptCi2W24-94EeRLWi2Eio-CVluuUkqc4-vxDx5Iw-yiIW7NbkfWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvetT-cSv2OJGwQK3ayvAgJIsHC8mPWyw9ipSXL5g_9SQ&oe=69999ECB"}, {"file_name": "migrated_image.png", "id": "206888507051377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_198206460772838_4136269998169522176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3Sll0tw_yoQ7kNvwFydaoi&_nc_oc=AdkBnOLKNgy73dM9CoZgsO9pRPkTc5GPET_UW2cJ4_7pWQNb6pr5cJOzzy4Hely4uC4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftRKBFh5YjRScyFvvAvtCTHl8QUwmoMcTV-t8YVmI8xVw&oe=69999E9C"}, {"file_name": "migrated_image.png", "id": "205988603952032", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_167911754018858_8847240791303651328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cImF7maK0qUQ7kNvwF1J2Fk&_nc_oc=AdnePjFeJES2Y0m92zcsgO1AOpjn9dG863P_mr7EsStdo67-sS4doRcKMDTrrFFCMOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft5cNub5kP4Le-05rxkKijUOeuN51D5ySMkfgQCGg-xkg&oe=6999AA61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/d0eOqD", "id": "475100903238286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974464_475100906571619_3730690438202392576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTX5F7QfgI0Q7kNvwEpU2CB&_nc_oc=Adkc_TWPmcCpuSdX_lp7GSRXendLgSSQ1oV8YiPyMg2gkkF86aRdA1sFRL_Q89_Rg5Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfutWoupMJZ2J9x1hQuYhmfa1QR-PL-vdULi6_4-3J_NIA&oe=6999ADF5"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery.\n\nThe award winning Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. In this award winning experience you travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Force Field", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/privacy-en-us/", "developer_terms_of_service_url": null, "publisher_name": "Force Field", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
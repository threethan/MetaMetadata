.oculuscdn.com/v/t64.5771-25/12386220_1654816064634235_4573280979212304384_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uFHYVYpL7UQ7kNvwEbadEU&_nc_oc=AdlV8v4m2Qo1VTQgC3Zn9UffxUfVtVHguUx0j00bVVZtTVATuKW69mwuNub1zyOKdXA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afze1PnOm22WvsbTA3DX8io7E5V2426ABCR06idR04yZhQ&oe=69B0097D"}, {"file_name": "migrated_image.png", "id": "881607195623323", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602063_754441544760959_8512174522638532608_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1HeIt6MHWAQ7kNvwHrDifw&_nc_oc=AdkERRkDdYG81_PhHvNeAomQPcDEnds105Jmg5l70wFtpfhjtm04Z4FvHk4SJMZr5UE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyljfoj1CkVt6RstxPqTsPicd6WMLfhBBl8nUx_cjQ4BA&oe=69B0084B"}, {"file_name": "migrated_image.png", "id": "206888507051377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410200_198206460772838_4136269998169522176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzEmDpQPL70Q7kNvwGiHzu1&_nc_oc=AdlCnRuuPX-WtkNO1OK0g_zOKDwobBPpNhWQVIyTAgEAnOe3lMNQcPxmJXkM1-KnnwA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfznTQHE34G_lp7blsgvuzJqijTi3x1Spfv8zqM-WKrAbw&oe=69B0081C"}, {"file_name": "migrated_image.png", "id": "205988603952032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410280_167911754018858_8847240791303651328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egc1k_lV6GwQ7kNvwHrhMT7&_nc_oc=AdlBi1ZOF9uZDFGerpl7rZpNbNXMU57q1YGuJV4dVFqATV5LSXZ3wP07cfFnB73qAes&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzC9dFlyzSXlSSLUkAbW1dtOCAdP8oxtSSG0mRe_deNjQ&oe=69B013E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/d0eOqD", "id": "475100903238286", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974464_475100906571619_3730690438202392576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BQPn39Bp-UQ7kNvwFiyfk-&_nc_oc=Adngn0-aAcdjNvxk6PDP3b1_yWetLbfefQd14aW7EHbjlrk7MOpMQFwgTQC1BqyL2e4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3VezEN8uwbdfQF0MuiCCV9o-O5-q0wj79AH_1mi4P1g&oe=69B01775"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery.\n\nThe award winning Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. In this award winning experience you travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Force Field", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/privacy-en-us/", "developer_terms_of_service_url": null, "publisher_name": "Force Field", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "co
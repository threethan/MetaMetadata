.oculuscdn.com/v/t64.5771-25/12386220_1654816064634235_4573280979212304384_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdHgumarFB0Q7kNvwHuWQZ3&_nc_oc=AdpDCnfrbf8UjXw73ejBPkBaTMhVjPVWPRwhaZ7CjhZA0y9pu6ckChht1S1oIipqI9c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9ye2scs4Yg5thKG9D80VdlO6-h2g-wt3LLttHPSGs2g&oe=69C12CFD"}, {"file_name": "migrated_image.png", "id": "881607195623323", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602063_754441544760959_8512174522638532608_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94DFPRJBW-YQ7kNvwG023eS&_nc_oc=AdpWSprcTnPXkimnmesEjuv_luoRkAhursBijwVqh3dwsptHSLe7yA0YfkZX5N7chSc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwU9QVCZ8Lvqc6BBlDCg8equhEybRSceOiHIpaK-m-p1A&oe=69C12BCB"}, {"file_name": "migrated_image.png", "id": "206888507051377", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410200_198206460772838_4136269998169522176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CAQXbOIvScQ7kNvwEacL-v&_nc_oc=AdqoDSKK8K5Kg5gPY4bFGx8XLj6Ee_5BAC_ufHt-Q_hT9EqDcep01JyMQFbxc97oGyo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzTBmdxiKSzt-Cp0BRTPBRb42wd1qq0wWKXYZuzxxlyxw&oe=69C12B9C"}, {"file_name": "migrated_image.png", "id": "205988603952032", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410280_167911754018858_8847240791303651328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQlOdg6CXdoQ7kNvwFiwJIA&_nc_oc=Ado4laRvlgfRLu0rLRsgV8tygPkxtUvh1qnjJKSOKdbR7MJO8nAGQ-135FSwe-n6-mc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzROyhYkbH7uBYt9EtrPnfdcz0-DlqCqjL4-ROtQFA-Ag&oe=69C13761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/d0eOqD", "id": "475100903238286", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974464_475100906571619_3730690438202392576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOW19cyMgMwQ7kNvwH-XeRT&_nc_oc=Adq2819281I31fUV0QRc6a3sLJDo3-lMyZtonUaAs1usQo5wLFsQEkV71YB7p8xqpMM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwho9IJVVFWBDMfVWZ4tDEXgAUhtJPbytvrDfne2t34Sg&oe=69C13AF5"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery.\n\nThe award winning Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. In this award winning experience you travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Force Field", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/privacy-en-us/", "developer_terms_of_service_url": null, "publisher_name": "Force Field", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "co
64634235_4573280979212304384_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sadcC-Jb_lkQ7kNvwH7UgkJ&_nc_oc=AdrANJ0QdDCcljjjLZvtsiwbpKnYpUS8l2ld9SlYmwMP3CLMxUKMPDGDnCH8N-gBQW8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2nXokt4al-KoJ6QxCmKKEjvepYz2DvDE1YfNdWtlOBPA&oe=69F1F47D"}, {"file_name": "migrated_image.png", "id": "881607195623323", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12602063_754441544760959_8512174522638532608_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIQ0cT1jpI0Q7kNvwG4Diza&_nc_oc=Adrxz5e4iAINNBwNT1PVUYlLRUVpEh57JVZJpMm3MY2VYs2am4LiOrCoVVAO8rlvoLM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af37CAwI55BsbqIoQt8Ysm74dAe9fFnabRZDzDlN2M9rQA&oe=69F1F34B"}, {"file_name": "migrated_image.png", "id": "206888507051377", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410200_198206460772838_4136269998169522176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BF6ghyyWo4QQ7kNvwG1H2Xo&_nc_oc=AdprsTP_SLUzkyulhUAaEQErzpOmt2byiSQP-E5e8xoTVtlPAveYfKvRZyaxagL7aNE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NaXulIeZB86nUyQGWzkh8xycDciS1_-nT5kyo1UTSYA&oe=69F1F31C"}, {"file_name": "migrated_image.png", "id": "205988603952032", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410280_167911754018858_8847240791303651328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9MzrgdICW4Q7kNvwHYnxjL&_nc_oc=AdpOf3An1PXf0v0IcA-SM4fULfV5POK1PfuClFVo6_-eYQwnmKqXkcLW1qKLW3ZKuz8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2mXaC2D1cdGGrjlnUuZgb5OSb3XwrgpfYWqWyYRAcrGg&oe=69F1FEE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/d0eOqD", "id": "475100903238286", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974464_475100906571619_3730690438202392576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zky3gjzA06wQ7kNvwFKq3-j&_nc_oc=Adq2T5P6jK0AmuLcb-u7O6CzOO7fAYzFsdfzbLSpSPSXk7zfNPbyAy8r__eZpEgpJC8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DBT-9BpjEZVd7IoLgQo4JToOtJtxh2Bzty4eZ54_zoA&oe=69F20275"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery.\n\nThe award winning Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. In this award winning experience you travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Force Field", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/privacy-en-us/", "developer_terms_of_service_url": null, "publisher_name": "Force Field", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags
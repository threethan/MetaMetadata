.oculuscdn.com/v/t64.5771-25/12386220_1654816064634235_4573280979212304384_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKGULeGK-nIQ7kNvwGEHRQ7&_nc_oc=AdlnV8shHebVdU4d55Zo1MZv5stdJddnmscVwRJ8aGIx5ksjoAb1lh1AtDcHFHh7xVk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzFlizkQweRBRFsja0PQ59tY6wjXwO36ek-8u9xZVWOQ&oe=69BE89FD"}, {"file_name": "migrated_image.png", "id": "881607195623323", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602063_754441544760959_8512174522638532608_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94DFPRJBW-YQ7kNvwEKOxf3&_nc_oc=AdnloSe4mhap_Bl6b-ZaI6h-5AevJGXTRtO_5ZF0g6QKr2GXyWgszXqhaYdCdjPZV_o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZ5bCU2eXTi-mHlQ4RqN2vNChdSQH5w-6-ffUcG-pFJw&oe=69BE88CB"}, {"file_name": "migrated_image.png", "id": "206888507051377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410200_198206460772838_4136269998169522176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CAQXbOIvScQ7kNvwHl8AHd&_nc_oc=Adk-cZdKtmCKNvYC3XikH1U7jGyQzCrDdLtevt-uBx1P4dKB6R13SPUc0TwsZDaHiRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5rMdcukXKgrxK1Cfoyv95LSVqa2FgupU575HY4xTH8g&oe=69BE889C"}, {"file_name": "migrated_image.png", "id": "205988603952032", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410280_167911754018858_8847240791303651328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0g_Uu4HXH8Q7kNvwGL5-BA&_nc_oc=AdmiZVSb61q4D_4GG9aqbWUf-IZU7UYIncNoLZhGiEtcCzc_F-3GSYUoGAzGY4iKRV4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrVnHHSDnY01DF1GM8IsFy5F74cDjYgt5DqImFJ6snOQ&oe=69BE9461"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/d0eOqD", "id": "475100903238286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974464_475100906571619_3730690438202392576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiVHmWlaRwMQ7kNvwGsP3N1&_nc_oc=AdkpAxIpR6-t1igFcVETsj1a_tTcqUS8pI7j0YRyOQRsSuT0iCQrZCA93wsVehVTxps&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxP4_cSe8GpL0nMx26LwZTzBw6iESB8maSAbhw0AYaq5Q&oe=69BE97F5"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery.\n\nThe award winning Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. In this award winning experience you travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Force Field", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/privacy-en-us/", "developer_terms_of_service_url": null, "publisher_name": "Force Field", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "co
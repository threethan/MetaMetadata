.oculuscdn.com/v/t64.5771-25/12386220_1654816064634235_4573280979212304384_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uFHYVYpL7UQ7kNvwEobbuM&_nc_oc=AdlBfkUx72mrvAqG6Pru4tOKhO70Vks1Ui4s5NGBj4XC9ljQCyy1ElsicZX_L-TGhpw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeOVBGL911A1ZI3TD64hndx9U9r8r6u_iQpJvDnyAbsA&oe=69AEB7FD"}, {"file_name": "migrated_image.png", "id": "881607195623323", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602063_754441544760959_8512174522638532608_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1HeIt6MHWAQ7kNvwEESier&_nc_oc=Adl9hpEAklKeTMcmyxWA4rlgh41LivE_cPpMvBwyycaPOV3_BIjyEtcKi8pojMj1l68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLOXpfZq0OVHrPzZhA1KDSIMXdDaPH1qUOQxkc98uq6A&oe=69AEB6CB"}, {"file_name": "migrated_image.png", "id": "206888507051377", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410200_198206460772838_4136269998169522176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzEmDpQPL70Q7kNvwHEF451&_nc_oc=Adn7gg_zsi72-hDZl-ZVRcM7nd5kSKDoQugkLICA-BPZV8JbkkQRQKZCdYbCwDQmOU8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCNIpiguN00mQTTW7MEEWgDeZUCzR-2yCPLAxOQ4WXBg&oe=69AEB69C"}, {"file_name": "migrated_image.png", "id": "205988603952032", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410280_167911754018858_8847240791303651328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bw0Qv5RwJ0AQ7kNvwHuZO__&_nc_oc=Adlzsb9csp_xpJX2DrpQjbk_nMZqifbjOArF5JgWCm6T39fayWA5yPUGmWqPPaN5ybM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDMWfNQO6poEk1-R7PFaZCpFiW5bGdhplnPmNgq-wGog&oe=69AEC261"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/d0eOqD", "id": "475100903238286", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974464_475100906571619_3730690438202392576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxAkPv7PX1gQ7kNvwHfRiNv&_nc_oc=Admz8hD2rq_vNmAtvVn1Aks2u_sahiBB4KXAu9-6gmpuxCoOT5bDb_WuqI6r47ns2kw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqmH516bLoLeyN57RN9WBQ_eIBjERHXWJoVbZi54TbJQ&oe=69AEC5F5"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery.\n\nThe award winning Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. In this award winning experience you travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Force Field", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/privacy-en-us/", "developer_terms_of_service_url": null, "publisher_name": "Force Field", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "co
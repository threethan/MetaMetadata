84_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76X5-Fnb4aIQ7kNvwHdXevi&_nc_oc=AdlwU9GAEOTU9vGavS6Yo5D-s-tTC7R_4gNAefInWDdc7B9KXiKWuIYO8Zv2FEJFE0E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfunBKJ6taxxc8P48N8rvnb9FEhpT-oElPZHBNfP3Dh7qA&oe=69984E7D"}, {"file_name": "migrated_image.png", "id": "881607195623323", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12602063_754441544760959_8512174522638532608_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_1DbdKx4EoQ7kNvwH0zNMr&_nc_oc=AdmYMMOMSrdLfR2uZhQ4c5W7l_7Txe-ByPKukKCB9MSr8bnoHiBg9ae-Op6I7_rsHSI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuNVJ8TNUt5GwI8aK2jUXKYAp3vRDXfwTcgKbQNsPgP0A&oe=69984D4B"}, {"file_name": "migrated_image.png", "id": "206888507051377", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410200_198206460772838_4136269998169522176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3Sll0tw_yoQ7kNvwEkAqzV&_nc_oc=AdnV_3GhKzen_vA3n1C29SegeRQ1fnjlrLnDPNP8JDuE_LrtYN-giROfwFsVTeut_Wg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsPH2ojX399TVmlyQE9lM7xKevWDILaJ53S38LdOIvkTg&oe=69984D1C"}, {"file_name": "migrated_image.png", "id": "205988603952032", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410280_167911754018858_8847240791303651328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cImF7maK0qUQ7kNvwGRUPBA&_nc_oc=AdkOC64U0II2Qra5w4OolgcA3QldJTOKsDQQC1UmigAnI5fTj8ZR0DxXu3cOijkPK1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftvepzUaJYAocaow2BsTglRwAUcsqduV0WjBiDPEczY5Q&oe=699858E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/d0eOqD", "id": "475100903238286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974464_475100906571619_3730690438202392576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTX5F7QfgI0Q7kNvwFP096x&_nc_oc=AdkjSXT_dPNBNU9vifBs-OeCB6LZbOz2zcS5wm0_FZeq5dQ7mDceA4SpH8VtKtAiM44&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afuqg1_MpIvWytMw6ATGBb7_HPv3BUVgsrJFrovTGfP9IQ&oe=69985C75"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery.\n\nThe award winning Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. In this award winning experience you travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Force Field", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/privacy-en-us/", "developer_terms_of_service_url": null, "publisher_name": "Force Field", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
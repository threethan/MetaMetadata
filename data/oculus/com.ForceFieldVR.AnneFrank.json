84_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sadcC-Jb_lkQ7kNvwEBdCQF&_nc_oc=Adp2sgY-6RL2VBxgwBHtVeSYzMESFidvSCWSj1eGiDEtQtcTd0H3jx7QhQM1OH4vvEo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2Zc9cBavA_dhmX3S5Z_5C9EmnM1NnpTH6a2ToTuvObXQ&oe=69F0A2FD"}, {"file_name": "migrated_image.png", "id": "881607195623323", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12602063_754441544760959_8512174522638532608_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4wiwEiYKMsQ7kNvwGJM8MM&_nc_oc=AdrA9mul66Kvnbd7rQb_hpS0epZUVrLUMMQxelSiKRStbMLNCT_m9rSN4L5QZx56BQ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3Hq9SxQ31oYmcrvhvGKMdte4F0Ns3zDtC-w00yypBw6g&oe=69F0A1CB"}, {"file_name": "migrated_image.png", "id": "206888507051377", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410200_198206460772838_4136269998169522176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJIDAE-eiN0Q7kNvwG-xDiD&_nc_oc=AdrNlTEhvK-zhfhITbTRls4mHujVCRfICn9kwa2B3fbZUXMzk8Fi-IZ4uisfq97acyg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0_4K9RAoIzSN6QyhjzD8fDnM1NzMM6yBKQQOn48kRzJg&oe=69F0A19C"}, {"file_name": "migrated_image.png", "id": "205988603952032", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410280_167911754018858_8847240791303651328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9MzrgdICW4Q7kNvwEvGu-5&_nc_oc=AdpQ1QpQEN-HIglKyoh4s5Y_J0FC1LkBZKa1RpZieGXg_worF_Dh98a9N_WXnaXI064&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3QYdCHvfHRJ59uJGdSOrspmo0hyyazplmVV45D3wbebg&oe=69F0AD61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/d0eOqD", "id": "475100903238286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974464_475100906571619_3730690438202392576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zky3gjzA06wQ7kNvwHinpyb&_nc_oc=Adp6aGbakV_3cJKXFkq32wjvzf2CjBlbioAJia2wewL_VPzlu6ZSRkfiive1ODMpfG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1JUwj134wkn3uf9qrdcO_nuoDMk5X43lf_9eXqWG272w&oe=69F0B0F5"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery.\n\nThe award winning Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. In this award winning experience you travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Force Field", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/privacy-en-us/", "developer_terms_of_service_url": null, "publisher_name": "Force Field", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
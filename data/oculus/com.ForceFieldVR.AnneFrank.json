84_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JZBhfxFl6sgQ7kNvwEbe-GM&_nc_oc=AdkIn0mk8Z4k6m-tjzsFuXA_5w3M_MuYfjVeWCeisKN9Q34CFkT2AezQrSQ_N6jR2dY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuTwjMGPE8YSoaxBSOUM7yGQoYWCFzfePTWcCh0w_5hzQ&oe=69A2DA7D"}, {"file_name": "migrated_image.png", "id": "881607195623323", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602063_754441544760959_8512174522638532608_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlB9GYQ9XYgQ7kNvwHGtCUQ&_nc_oc=AdnFQZMtdjtGs64oyKgLe-cZFOeUNcYzUjmWgbdd-1feVrNtqYhHAvapkt1PTuG91EE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvJmOlNCYuuqNOrAMN7PXHUwsOd6l5lqJJoL8UUhvoBEg&oe=69A2D94B"}, {"file_name": "migrated_image.png", "id": "206888507051377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_198206460772838_4136269998169522176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtq4G1wbX8MQ7kNvwEMyDn8&_nc_oc=AdmpaR9zNSE8avtZpCanA0FC0Jl-C6vJDbOZYH6gjyxT5xoAEAJjMFHoPIcwm0jCLtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvMphG7A4KjXVoOm9Wie8k9hlYGFcS-W3Efiq9yzHyjew&oe=69A2D91C"}, {"file_name": "migrated_image.png", "id": "205988603952032", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_167911754018858_8847240791303651328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhkLImby1NwQ7kNvwFk28_Z&_nc_oc=AdkPl8txzVzZXeodtCVMQswUfu2nV56z6qzxmMSFAhQx0SrHQpJCDrhdMj1-zQ8DwiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCaXDiWu-mhA2DYCgTsFMaGq86H-vUQpeMZHxsGoZTkg&oe=69A2E4E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/d0eOqD", "id": "475100903238286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974464_475100906571619_3730690438202392576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHZ-G4CRFxoQ7kNvwFdw8FP&_nc_oc=Adn3wGYq49cZ-6YT3m06BNc_RnEVRGEonz02SN_7PFqPUf2x4gkwXKz38ZWPGC1A3Ck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftHz7Av6TLwmzAjaLV4KUIaQZqpq7mr7gU-VeN5F2gUDg&oe=69A2E875"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery.\n\nThe award winning Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. In this award winning experience you travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Force Field", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/privacy-en-us/", "developer_terms_of_service_url": null, "publisher_name": "Force Field", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
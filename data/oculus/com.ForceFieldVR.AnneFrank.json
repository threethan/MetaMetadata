84_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTuTpiXt3zIQ7kNvwHoKod3&_nc_oc=AdlHN8okvVdUhuqhgcxk8WsQc3oRLsO4F1U7mgPDRboDvlUrhIw9TOQRC3hivDA0EXE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuGtmaseQjTifdR5EHHBRTuPs2hrv45ID1adXHAQTdCwA&oe=69A0377D"}, {"file_name": "migrated_image.png", "id": "881607195623323", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12602063_754441544760959_8512174522638532608_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80psWkPGhP4Q7kNvwFdVRwY&_nc_oc=AdmXR-RPSKMe2mf56gf1gJrUh881fGlMDXUdzh4yZlKPw5CW0toQexkHbFR0L42gmY8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvoFfiGAivOfi79Vpwunwuevsyggc1QphxGO1T1mft_0g&oe=69A0364B"}, {"file_name": "migrated_image.png", "id": "206888507051377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410200_198206460772838_4136269998169522176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uODHa9yu4YQ7kNvwE3Xen2&_nc_oc=AdlqC0CW_nD5LVZvqCy4LHTPmbHWvobwl2SfAbyFztHH5ALMKDL2nTFxha8Zq05dRxQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu23ZEfcGh2Ztdp38QDigX0lLrGLasBZMNOuErNyOWGUg&oe=69A0361C"}, {"file_name": "migrated_image.png", "id": "205988603952032", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410280_167911754018858_8847240791303651328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhkLImby1NwQ7kNvwFNp79A&_nc_oc=AdmaZe2aMKLfQxctly8CQ518IANhwyMjhjB3SFBg6VxCAtwvkDcKbShwDZN6RDahRis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftDuwPgZJD_NG-_OVjMR60DTvfTboI1MnTPKdYUlOwJDg&oe=69A041E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/d0eOqD", "id": "475100903238286", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974464_475100906571619_3730690438202392576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHZ-G4CRFxoQ7kNvwEF3QUk&_nc_oc=AdmXnLwyCWhJo7xb5i9ywOOq3dXrIoPpOvLcJx8xx0yqknaflSZED6wTbUEqKMQMDds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftD0ogQ9BH2etLqU_51EeaRHbzKKNdOi3U3szPprJsXbQ&oe=69A04575"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery.\n\nThe award winning Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. In this award winning experience you travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Force Field", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/privacy-en-us/", "developer_terms_of_service_url": null, "publisher_name": "Force Field", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
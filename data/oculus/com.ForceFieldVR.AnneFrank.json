84_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CM_0RoARfRkQ7kNvwGbJR4T&_nc_oc=AdmTLV0qpwYGIbWaXxU5ebClUjd5op18GSIVPJr1ZTXcXvxJaSXuLqIuhcCLKppxLHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvmkbW57j_9kHKhah12B0nVAjpoR6m3uosjBa113sl9rw&oe=699AF17D"}, {"file_name": "migrated_image.png", "id": "881607195623323", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602063_754441544760959_8512174522638532608_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9Q95yfKlXEQ7kNvwEcpquW&_nc_oc=AdlreUbPMa8irdaATMrgFAKIX-fbYPeweGnM19q6EU6Q5U8QIq-s516vNrMUhR-lr6w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuaE1PYXoegaUbAUog_j2fa1jWcqaFDpWripLKAT1PDqg&oe=699AF04B"}, {"file_name": "migrated_image.png", "id": "206888507051377", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410200_198206460772838_4136269998169522176_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttJzMpX5jjkQ7kNvwGLYnTj&_nc_oc=Adkrbo-vOFmKVQgFPyB1-reTP08n3ANt8RM_4jN3WRu5Klg92KtbLBRs7B40K0-Swjo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftcG8iYkettENYtBShTEysAd17pp7ef8y1wmdfv6sajxw&oe=699AF01C"}, {"file_name": "migrated_image.png", "id": "205988603952032", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410280_167911754018858_8847240791303651328_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cImF7maK0qUQ7kNvwEO_FDK&_nc_oc=AdkaLuRE9dKFO6cuC3Q-fhz8YLOB60XyrUV8P4w2JJTDkJnuJp_n35aIJlhe-8YV1Ck&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftJEXt_ZBdOaVx4QfY2AqvTFI4nOGBklGEvi1ywwKL70Q&oe=699AFBE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/d0eOqD", "id": "475100903238286", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974464_475100906571619_3730690438202392576_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTX5F7QfgI0Q7kNvwF_BUhl&_nc_oc=AdlVjdjL8HCqEpR6uL3_Gez-zh1vuxR2PHAwU7EWo2B2mq9lBeP8bpWsRVXSJ7zp5gA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu25trIo9m6yekE8m6nyAYuszTOI8-naSjCcZYHMODr2g&oe=699AFF75"}, "display_name": "Anne Frank House VR", "keywords": ["Anne", "Frank", "War", "Diary", "Experience"], "long_description": "In 1942, during the Second World War, Anne Frank, a thirteen-year-old Jewish girl and her family were forced to go into hiding to escape persecution from the Nazis. For more than two years, the Franks and 4 others would live in the \u201cSecret Annex\u201d of an old office building in Amsterdam, sharing the burden of living in hiding in confined quarters with the constant threat of discovery.\n\nThe award winning Anne Frank House VR offers a unique and emotional insight into these two years. Experience the world-famous Secret Annex in a never before seen way. Travel back to the years of the Second World War and wander through the rooms of the Annex that housed the group of 8 Jewish people as they hid from the Nazis. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants.", "short_description": "Experience the world-famous \u201cSecret Annex\u201d of the Anne Frank House in a never before seen way. In this award winning experience you travel back to the years of the Second World War and wander through the rooms of the Secret Annex, where Anne Frank, her family and four other Jews hid from Nazi persecution during WW2. Immerse yourself in Anne\u2019s thoughts as you traverse each faithfully recreated room, thanks to the power of VR, and find out what happened to the Annex\u2019 brave inhabitants."}]}, "developer_name": "Force Field", "developer_privacy_policy_url": "https://vertigo-games.com/privacy-policy/privacy-en-us/", "developer_terms_of_service_url": null, "publisher_name": "Force Field", "support_website_url": null, "website_url": "http://annefrankhousevr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_cat
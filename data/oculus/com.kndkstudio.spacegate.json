tent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgDQvI1YVZbSnCPHOBZNy_27upfIpvThAlbUNbhT4Eig&oe=69CD0210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1392490815881584", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1392490822548250_3520970709446553354_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbJr9vbK4B4Q7kNvwHm4iLJ&_nc_oc=AdqBhUf8scGty1t4uSZ4eWk4qMq4sf-Hqh2_0nziQ3sekPXXFfp5XKM9DQ5HmeA-Zfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwq_1ARNckLvnB6ckKCuCFUi4cSisWv6p7wXVcQ5J5cWA&oe=69CD24C4"}, "display_name": "Space Gate", "keywords": ["airport", "space", "border", "inspect", "security"], "long_description": "# Space Gate\n**Protect the last refuge of humanity**\n\nStep into the role of a **Security Officer aboard a massive spaceship refuge.** Humans and mutants arrive seeking safety but some hide dangerous intentions. Inspect carefully. Decide fast.\n\n**Scan and inspect**\n\nUse futuristic tools to detect hidden items, check temperatures, and compare identities with wanted lists. One mistake can put everyone at risk.\n\n{854817183807598}\n**Handle suspects your way**\n\nGrab, push, or strike NPCs using full VR physics and ragdoll interactions. Cooperation is optional.\n\n{2054790168696458}\n\n**Defend the ship**\n\nWhen invaders attack, activate turrets and weapons to protect the refuge from destruction.\n\n\n{867447135699232}", "short_description": "Step into the role of the Security Officer aboard a massive spaceship refuge. Humans and mutants will arrive seeking shelter, but not all are safe. Inspect each individual carefully, some may conceal dangerous items or hide sinister intentions. Use futuristic scanners, sensors, and other high-tech tools to detect threats and make crucial decisions. Every choice you make affects the safety of the last survivors of humanity."}]}, "developer_name": "K&K Studio", "developer_privacy_policy_url": "https://knk-studio.com/privacy
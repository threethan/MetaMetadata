file_name": "4.png", "id": "3846065945696858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499302770_3846065949030191_2918678879083391724_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJx8Dmx5u2sQ7kNvwEFfisT&_nc_oc=AdpHe9-GQyf-CWsnUucXS6Op8YEwhn1AUn6lgpxhZiFBXg0Yvquvh562cxw36pgGPMI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIlOMUgzhe9-DssA4KxbWyn_b5ImyZHFCgmIVd_C7vbQ&oe=69CD2441"}, {"file_name": "5.png", "id": "1177936717654336", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1177936720987669_7793059444055979186_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BiudRLyeEGEQ7kNvwHtJr05&_nc_oc=AdpckTaCwvczaSjC2LF5ODrwINpzGrDxNPD8nCrluQpbIIsksAkYmIyy7UScteYNCmw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2jxau6cWSowCBTuJye1EYsaaq0iGE9SHP3wuIcsGCqA&oe=69CD2753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1635407334561873", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_1635407337895206_5775557879877576445_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDmYO-KhIQgQ7kNvwGUpLbo&_nc_oc=AdqYXmEPPrgvxuWgMsO6rTAxKb6JAoEr5TFRiAtSDBJga9oAK9SIC3mjeny6GlIrhB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqOszcsWPmPMvWcMWOi4YnikqCWdEQcJfwq2wbnXzoyQ&oe=69CD017F"}, "display_name": "Space Gate", "keywords": ["Security", "Simulator", "Inspect", "Job", "Airport"], "long_description": "# Space Gate\n**Inspect. Decide. Defend.**\n\nYou are a **Security Officer aboard humanity\u2019s last refugee spaceship**.\nHumans and mutants arrive desperate for shelter, but not all of them are harmless. Some conceal weapons. Others hide hostile intentions. Your job is to uncover the truth before it\u2019s too late.\n\nEvery decision matters. One mistake can doom the entire ship.\n\n**Scan and inspect**\n\nUse futuristic tools to scan bodies, luggage, and identities. Detect contraband, abnormal readings, and wanted individuals. Decide quickly, every error has consequences.\n\n{854817183807598}\n**Handle suspects your way**\n\nGrab, push, or strike NPCs using full VR physics and ragdoll interactions. Cooperation is optional.\n\n{2054790168696458}\n\n**Defend the ship**\n\nWhen invaders attack, activate turrets and weapons to protect the refuge from destruction.\n\n\n{867447135699232}", "short_description": "You are the last line of defense aboard a refugee spaceship.\nInspect humans and mutants using futuristic scanners, uncover hidden threats, and decide who can pass. One mistake can trigger chaos, from smuggled weapons to full-scale ship attacks. Inspect. Decide. Defend."}]}, "developer_name": "K&K Studio", "developer_privacy_policy_url": "https://knk-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "K&K Studio", "support_website_url": null, "website_url": "https://spacegatevr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25798606866431289"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1574679613566510_8136690227880626154_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Jk5JPNfIVUQ7kNvwFLa4Sp&_nc_oc=AdrgfqKxR46eglXn2QeYYJ2S22RSPG5oiCiqTx1m_csE2ruGlCWjbXHTAgXK5q-80PE&_nc_zt=3&_nc_ht=scontent-iad3-
d6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2U8IhzIArp7fpvjnctgmgVbdyA6kNH_BDFky1xMP1mg&oe=6AEB4FD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1392490815881584", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819356_1392490822548250_3520970709446553354_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj1E2m9A35UQ7kNvwGCL-ae&_nc_oc=Adpml3zSyYqt4o-TwJ-67N1rukQPXd7gfYr0kQPe-GxoiFuAbMtZxcSEGVJzNAYwjd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQo4KGNblAtyuMbDZAHDXJNXy868Pn1TOELvCmT8mG8cQ&oe=6AEB3A44"}, "display_name": "Space Gate", "keywords": ["airport", "space", "border", "inspect", "security"], "long_description": "# Space Gate\n**Protect the last refuge of humanity**\n\nStep into the role of a **Security Officer aboard a massive spaceship refuge.** Humans and mutants arrive seeking safety but some hide dangerous intentions. Inspect carefully. Decide fast.\n\n**Scan and inspect**\n\nUse futuristic tools to detect hidden items, check temperatures, and compare identities with wanted lists. One mistake can put everyone at risk.\n\n{854817183807598}\n**Handle suspects your way**\n\nGrab, push, or strike NPCs using full VR physics and ragdoll interactions. Cooperation is optional.\n\n{2054790168696458}\n\n**Defend the ship**\n\nWhen invaders attack, activate turrets and weapons to protect the refuge from destruction.\n\n\n{867447135699232}", "short_description": "Step into the role of the Security Officer aboard a massive spaceship refuge. Humans and mutants will arrive seeking shelter, but not all are safe. Inspect each individual carefully, some may conceal dangerous items or hide sinister intentions. Use futuristic scanners, sensors, and other high-tech tools to detect threats and make crucial decisions. Every choice you make affects the safety of the last survivors of humanity."}]}, "developer_name": "K&K Studio", "developer_privacy_policy_url": "https://knk-studio.com/privacy-policy
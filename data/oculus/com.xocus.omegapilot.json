43L-85u9QQiTQpjfcqJaE8qAGOj1FMg&oe=6AB3F324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1127578171115224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035365_1127578174448557_300400251191567525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tTo7hjkrNMQ7kNvwFHKwn6&_nc_oc=AdqIwM6LxDkJ2Z47CHmq8TdbKDzPfynFQkMjAA1GSFf_3Ahi1hDLI5nd887DNjf5qFE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUwKPj6zYxRNqz7Xn7SbyozfHp9zMhBBBBf_xvn0Kf3w&oe=6AB3E101"}, "display_name": "Omega Pilot", "keywords": [], "long_description": "Know thyself, & live on the edge!\n\nBecome the best - become an Omega Pilot! Do you like first-person racing? If so, then this virtual world is for you.\n\n- Compete for in-ring races with other pilots in asynchronous multiplayer, which will identify the best among equals.\nHone your skills and reach maximum speed. Don't miss the chance to surpass yourself and improve your time on the track. Become the fastest.\n\n- Stand out not only by the results but also by the unique customization of your \"Air Bollid\".\n\n- Enjoy the view from the cockpit and its interior, as you immerse yourself in advanced polygonal graphics.\n\n- Participate in regular events with prizes, and get ready for constant content updates.\n\nJoin the league. Become an Omega pilot!", "short_description": "Omega Pilot is an exciting first-person VR racing game with realistic physics and control mechanics. Compete for in-ring races with other pilots in asynchronous multiplayer and enjoy the view from the cockpit at high speed!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "c
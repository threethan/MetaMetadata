uscdn.com/v/t64.5771-25/38974504_401309368333607_3140522348943701099_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDkVYf5l8ycQ7kNvwG0_bHb&_nc_oc=AdmBe5zuhSt5pO0AgzLEHG0vR2okFTYPzig1ZXmeSNOI1TyQ2JE4YA9e5NyFlOrJVYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsFvqSJt_6cQa-CxccsPss0dgdJK_juWa9GcBdtNfs09A&oe=69A2DCE7"}, {"file_name": "S4.png", "id": "3219237551732021", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982553_3219237555065354_2848504715724959393_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEPjyZ6J-8oQ7kNvwFQ8j6s&_nc_oc=AdmG4E59zo7_km-UpH5J0Edji-QtqL0byCS1op5dQTvNTAT5SKwts-WoZ8h4ZoeIth0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvAUTIA96kG9BYByUAOT4PKiwi4tX4bsdFuB3KyNJ_45w&oe=69A2CF01"}, {"file_name": "S3.png", "id": "335910751866869", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75210389_335910755200202_8416459498474949487_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcGu4775aZgQ7kNvwEDLZcE&_nc_oc=Adnp0g7arKyHHIZlVHUKdShkeeIYw8JM-_TMGDp3UtwKGzMpKm-hhCqSMtbxrRN3Hbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfugOsd4CMYF12Iw3np-u9CRSgsHnEyvS4dCKw4rmYcKaw&oe=69A2E9D3"}, {"file_name": "S5.png", "id": "3130597270595060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031372_3130597280595059_3037881579099271786_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VeSfbP_0S8Q7kNvwEbjIky&_nc_oc=Adl7UhvH-oCXbzliVsqLgV1OqwSO9MdQMgXMn4N_8gXgqk4E1PkA00M7AYRhCJM3Pew&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu8e0B6I1kg4dXRmD6KzrVey4cBdAHijIMOUrtE7Fytgw&oe=69A2D464"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1127578171115224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035365_1127578174448557_300400251191567525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeTXnyz8PFwQ7kNvwHSH-lO&_nc_oc=AdniXGHExFpXr_v35pb3J75DlwuUqEl-qw9UkzCJrwkEQj0RXP8qvVZ3lI_ZFGpeJVo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvGGm8Io8toslyuC2zRAmBERYAg9U0C9iWmTbnTiIUpw&oe=69A2FA81"}, "display_name": "Omega Pilot", "keywords": [], "long_description": "Know thyself, & live on the edge!\n\nBecome the best - become an Omega Pilot! Do you like first-person racing? If so, then this virtual world is for you.\n\n- Compete for in-ring races with other pilots in asynchronous multiplayer, which will identify the best among equals.\nHone your skills and reach maximum speed. Don't miss the chance to surpass yourself and improve your time on the track. Become the fastest.\n\n- Stand out not only by the results but also by the unique customization of your \"Air Bollid\".\n\n- Enjoy the view from the cockpit and its interior, as you immerse yourself in advanced polygonal graphics.\n\n- Participate in regular events with prizes, and get ready for constant content updates.\n\nJoin the league. Become an Omega pilot!", "short_description": "Omega Pilot is an exciting first-person VR racing game with realistic physics and control mechanics. Compete for in-ring races with other pilots in asynchronous multiplayer and enjoy the view from the cockpit at high speed!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_
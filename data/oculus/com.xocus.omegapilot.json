cketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vJAs1rSaF6EQ7kNvwG61PCY&_nc_oc=AdobCI6_hjc7_Mw-ggy6A932cJqjtNPMeXFmN1eEgI1Bbi8B1Vb0GlyFr3pRZZ-Rpy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2VPokTn8ptEkN_LoYwHVoPArwBDVxvd-s1IYWyKg7hQ&oe=6B007F93"}, {"file_name": "S5.png", "id": "3130597270595060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031372_3130597280595059_3037881579099271786_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGKv-vleoaAQ7kNvwGJv_vp&_nc_oc=Adq7QehYS3JD7AvqboT5tflTwDYwAaHqUIm_Jz0_r2twI46Snc_NJ8de8-n6IsfWUJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa9wuqdOCNLFg2SXoMMhFTrtctAK2HG_QCPPkL1r_r_Q&oe=6B006A24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1127578171115224", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035365_1127578174448557_300400251191567525_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eONFGnBJoEgQ7kNvwHtWsSO&_nc_oc=Adr6ZKZMx0rZg5YS3mGLAsAyFHqyBuYxrzRubJPnAHYVFv1Mvaj74N_L0bs2WL1KSKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4Ivgp-6-Jls3TGmbRTbfzkClS8LNAMYtToMN2pi-KUA&oe=6B005801"}, "display_name": "Omega Pilot", "keywords": [], "long_description": "Know thyself, & live on the edge!\n\nBecome the best - become an Omega Pilot! Do you like first-person racing? If so, then this virtual world is for you.\n\n- Compete for in-ring races with other pilots in asynchronous multiplayer, which will identify the best among equals.\nHone your skills and reach maximum speed. Don't miss the chance to surpass yourself and improve your time on the track. Become the fastest.\n\n- Stand out not only by the results but also by the unique customization of your \"Air Bollid\".\n\n- Enjoy the view from the cockpit and its interior, as you immerse yourself in advanced polygonal graphics.\n\n- Participate in regular events with prizes, and get ready for constant content updates.\n\nJoin the league. Become an Omega pilot!", "short_description": "Omega Pilot is an exciting first-person VR racing game with realistic physics and control mechanics. Compete for in-ring races with other pilots in asynchronous multiplayer and enjoy the view from the cockpit at high speed!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "992137828349307"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "772974542345869"}, {"status": "PUBLISHED", "id": "944036424323915"}, {"status": "PUBLISHED", "id": "1352672739094989"}, {"status": "PUBLISHED", "id": "880895273370708"}, {"status": "PUBLISHED", "id": "443165170908881"}]}, "baseline_offer": {"id": "443165170908881"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "772974542345869"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7045929842097257", "version": "1.2.2"}, "id": "366732118620008", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "prima
uscdn.com/v/t64.5771-25/38974504_401309368333607_3140522348943701099_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OYT2HjQJmcQ7kNvwGvZhKM&_nc_oc=Adlc4LIEP1Qchryc52ooulQWgqs67HgiV3j4q8Iuj0yMhCA256WOChMIuXX5lWZdhcA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvNTT9ItgBclHWu7oE9q58uulg-pMxr3UybJfp-NEM4QQ&oe=699AF3E7"}, {"file_name": "S4.png", "id": "3219237551732021", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982553_3219237555065354_2848504715724959393_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1YHVlxg2QgQ7kNvwHPd4kK&_nc_oc=AdlpVtsmNXsAP6XGYC0_shAMPxVlUtwmwWCRpixqxL2Vx3trnuA1g0SX-2xDXep38i0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvxYLGhLfpWVGxPVAnONmMGsm-QM9spJ1nqfa1Lyk2oOw&oe=699AE601"}, {"file_name": "S3.png", "id": "335910751866869", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75210389_335910755200202_8416459498474949487_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeWCnHPrJeEQ7kNvwFSmY1O&_nc_oc=AdkY0UcXswoJ0CcWjOnMnAq6WeNA3HYpGDyRItcV-uz_-RCFjbls5SJ9IWCvtYvEC4w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsUN6IYHwe5fUtxO3rue4QH-35vYs3S7JgwwyBzb2ooGA&oe=699B00D3"}, {"file_name": "S5.png", "id": "3130597270595060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031372_3130597280595059_3037881579099271786_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWLb_1TliuwQ7kNvwGRJt_S&_nc_oc=Admfg8y9QkVVCJpZeVUyEeomWPfwLUfttkxCGp_QA1aDXfmJOWGpxTAWfU_T7Ca25N8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuSUTCg703ru8xr7uZCc36VvR2GOJwOUw96oBgOuU2uiw&oe=699AEB64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1127578171115224", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035365_1127578174448557_300400251191567525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCOlodSOGeoQ7kNvwGA_Gpv&_nc_oc=AdkKgusNhsMSVNMJeOxYzWwqYtssEyjmczUbVnEYaQPd3yZXkvUK4Z79XwxpQdYtUE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsOVEbTyZ7Z40RXFDm9kIhOc5cd7jaVpxTs0V24Xft44g&oe=699B1181"}, "display_name": "Omega Pilot", "keywords": [], "long_description": "Know thyself, & live on the edge!\n\nBecome the best - become an Omega Pilot! Do you like first-person racing? If so, then this virtual world is for you.\n\n- Compete for in-ring races with other pilots in asynchronous multiplayer, which will identify the best among equals.\nHone your skills and reach maximum speed. Don't miss the chance to surpass yourself and improve your time on the track. Become the fastest.\n\n- Stand out not only by the results but also by the unique customization of your \"Air Bollid\".\n\n- Enjoy the view from the cockpit and its interior, as you immerse yourself in advanced polygonal graphics.\n\n- Participate in regular events with prizes, and get ready for constant content updates.\n\nJoin the league. Become an Omega pilot!", "short_description": "Omega Pilot is an exciting first-person VR racing game with realistic physics and control mechanics. Compete for in-ring races with other pilots in asynchronous multiplayer and enjoy the view from the cockpit at high speed!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_
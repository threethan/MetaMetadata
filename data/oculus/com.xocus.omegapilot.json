uscdn.com/v/t64.5771-25/38974504_401309368333607_3140522348943701099_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDkVYf5l8ycQ7kNvwFfMP-y&_nc_oc=AdlPY_spt1lQlqooUOWOHeOx0dBpqSJS6X2jpqZ0P8aToWamV6osPgwmH02Np9mFE9Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfunGzN27ne2orm30J_52ila0M-9AuH-YUwI0amRP1O-pw&oe=69A57FE7"}, {"file_name": "S4.png", "id": "3219237551732021", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982553_3219237555065354_2848504715724959393_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IJAvI5QzaP4Q7kNvwE7secr&_nc_oc=Admj8f7QBGm4WhI3rJURo9vCP4qcW6YV49NIErbx66gz1fg6PGuCon58gyyghX9VPW4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsy9hoykWvLXIowzPWJyqj4oEreGFhFMuCH8-zWFqpfRw&oe=69A57201"}, {"file_name": "S3.png", "id": "335910751866869", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75210389_335910755200202_8416459498474949487_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pm5UxJHZ4NUQ7kNvwFPqEyP&_nc_oc=AdkOl9CzNP1iPPGndDBXEF5pTzeEhKY8yiEAxvNJYSuXkfxAW6xMWKPynSTIXqajHQg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftDngmhYL9c9jNCr-z0xC3HvIO8TCzihzabd5BwRB4yoA&oe=69A58CD3"}, {"file_name": "S5.png", "id": "3130597270595060", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031372_3130597280595059_3037881579099271786_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUSIA-YT0yMQ7kNvwH2ixAv&_nc_oc=Adl8ATZpUQUeKpu6gqtr94dlFUZr333p6s9x_sZA2Iqmg9xcRsTT9qRgk_6R6PNiAPA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afta-4nheQFb0X4Bj5T8iykSkNf-Sb2fcgd4Rskv-xv_bQ&oe=69A57764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1127578171115224", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035365_1127578174448557_300400251191567525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dftFSQe-J-4Q7kNvwH8MwIL&_nc_oc=AdkpEJPUQr94jiZa6cOBKbzNmxdi5I2kdvwMcIyh18D82DFNYfuV0i4wScct85ta0JM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuRORjgdkt29Bx1y39zKyjaVMJoOFD9uNuTyf4uTwAAxg&oe=69A59D81"}, "display_name": "Omega Pilot", "keywords": [], "long_description": "Know thyself, & live on the edge!\n\nBecome the best - become an Omega Pilot! Do you like first-person racing? If so, then this virtual world is for you.\n\n- Compete for in-ring races with other pilots in asynchronous multiplayer, which will identify the best among equals.\nHone your skills and reach maximum speed. Don't miss the chance to surpass yourself and improve your time on the track. Become the fastest.\n\n- Stand out not only by the results but also by the unique customization of your \"Air Bollid\".\n\n- Enjoy the view from the cockpit and its interior, as you immerse yourself in advanced polygonal graphics.\n\n- Participate in regular events with prizes, and get ready for constant content updates.\n\nJoin the league. Become an Omega pilot!", "short_description": "Omega Pilot is an exciting first-person VR racing game with realistic physics and control mechanics. Compete for in-ring races with other pilots in asynchronous multiplayer and enjoy the view from the cockpit at high speed!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_
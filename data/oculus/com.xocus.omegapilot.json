t64.5771-25/38974821_812892007250307_626290753045302142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChXJ7Z6biEMQ7kNvwEJRFsX&_nc_oc=AdpJ1mFgd_ISf5_pzXzqQ5VF0jQuEjLyuwG6u1eikuVwl4YN4J22Uz88lbx-KlksR6o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u00a3WRhOrviAEMj4W_swPFQp20K06ymLnycrw2CthQ&oe=6A0F1830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1127578171115224", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035365_1127578174448557_300400251191567525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Rk4UYuq26oQ7kNvwH_kY0l&_nc_oc=AdoUKXdxnXDolFupOAo_AUNxgtwplV6v37NDpRVskZ9zGsx0uFlEF5TlVB8uNyHiQN0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QL3QqLxRuDex3akGDyuVRYcExmuKTn-vLOOIIOLmQZQ&oe=6A0F1581"}, "display_name": "Omega Pilot", "keywords": ["racing", "flying", "sport", "action"], "long_description": "UNIQUE RACING EXPERIENCE & IMMERSIVE GAMEPLAY\nDo you like racing? If so, then this first-person hit in the virtual world is for you!\n\nExplore the enhanced content within Omega Pilot!\n\n \u25aa Enjoy the cockpit view and interior as you immerse yourself in advanced high-quality graphics\n\n \u25aa Compete on 33 different tracks with other pilots in Asynchronous Multiplayer, which will identify the best among equals\n\n \u25aa Stand out not only by the results but also by the unique ships designs of which there are 26\n\n \u25aa Unlock an array of gloves through the utilization of your unique abilities\n\n \u25aa Realtime Multiplayer is also available! Relish the camaraderie that transcends geographical boundaries\n\n \u25aa Participate in regular tournaments with prizes and get ready for constant content updates\n\nHone your skills and reach maximum speed. Don't miss the chance to surpass yourself and improve your time on the track. \nBecome the fastest - become the Omega Pilot!\n", "short_description": "Omega Pilot is an exciting first-person VR racing game with realistic physics and control mechanics. Compete for in-ring races with other pilots in asynchronous multiplayer and enjoy the view from the cockpit at high speed!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9390677150955836"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982658_750506419178110_1301240440477678772_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dr_Jm-WhOw0Q7kNvwGz9WQy&_nc_oc=AdrmvQfIgQHerptmCamBVnXhrCusdhB5Tk7IK34A07Y2IY-tqfqdX8kRkILejBCsgyA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QEvNTQElw5g8YeUYXk8SbgOnJJBXDBkKZJOlBJl97Dg&oe=6A0F1B5B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Omega Pilot", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1653325200, "lastRevision": {"nodes": [{"id": "1611012595920
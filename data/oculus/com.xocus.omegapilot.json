t64.5771-25/38974821_812892007250307_626290753045302142_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5I_Ycf2ykEUQ7kNvwGaAZm9&_nc_oc=AdpxyK5oQWgsAIKusJeoq0stn-O2IanZM7ZFP7aDPDj_5Pg9bl6HuzVxkVt7q6euIl8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3TtvIQU4hAU1DZHtvogl-dmfet4YAwGW9RVRhSFhJb9g&oe=69F368B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover.png", "id": "1127578171115224", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035365_1127578174448557_300400251191567525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3PWpQrSr3EQ7kNvwF2PFwV&_nc_oc=AdriG7iWK_VBlrEjGzhbD7lNuEbQnKN8PHjdXJ1HIrVRf76B9SNaBGiUyP61Hb16Noo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2x4Yv9N1-3oKkhDu-goWQL2E95u4QCkEmBFEaOEKuuuA&oe=69F36601"}, "display_name": "Omega Pilot", "keywords": ["racing", "flying", "sport", "action"], "long_description": "UNIQUE RACING EXPERIENCE & IMMERSIVE GAMEPLAY\nDo you like racing? If so, then this first-person hit in the virtual world is for you!\n\nExplore the enhanced content within Omega Pilot!\n\n \u25aa Enjoy the cockpit view and interior as you immerse yourself in advanced high-quality graphics\n\n \u25aa Compete on 33 different tracks with other pilots in Asynchronous Multiplayer, which will identify the best among equals\n\n \u25aa Stand out not only by the results but also by the unique ships designs of which there are 26\n\n \u25aa Unlock an array of gloves through the utilization of your unique abilities\n\n \u25aa Realtime Multiplayer is also available! Relish the camaraderie that transcends geographical boundaries\n\n \u25aa Participate in regular tournaments with prizes and get ready for constant content updates\n\nHone your skills and reach maximum speed. Don't miss the chance to surpass yourself and improve your time on the track. \nBecome the fastest - become the Omega Pilot!\n", "short_description": "Omega Pilot is an exciting first-person VR racing game with realistic physics and control mechanics. Compete for in-ring races with other pilots in asynchronous multiplayer and enjoy the view from the cockpit at high speed!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9390677150955836"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982658_750506419178110_1301240440477678772_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuOdnoDoo-cQ7kNvwF0YlaV&_nc_oc=AdoHA-9LT_atpllHBJORAAh4Pl5q7-5HBwrmmPqAhJ7PBS_0WMmEhrLTfCrAckYtgvU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3srjEs2ty8-LTJ4t0RzvQcS52_xCcX0TCj46EYvfbUCw&oe=69F36BDB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Omega Pilot", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1653325200, "lastRevision": {"nodes": [{"id": "1611012595920
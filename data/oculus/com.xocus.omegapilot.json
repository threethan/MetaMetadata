27578174448557_300400251191567525_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dftFSQe-J-4Q7kNvwHaCfGo&_nc_oc=AdlRuK_jAxD-vTJjPG4LOYPsd9u7BqdhhAPLtL5SOtB9ky-UezD5GWAtF-mDrjv_-rc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsaacvaU4HSDw2hKUEzm2biX-wugd-DFE4V9bQT_sLjrQ&oe=69A80841"}, "display_name": "Omega Pilot", "keywords": [], "long_description": "Know thyself, & live on the edge!\n\nBecome the best - become an Omega Pilot! Do you like first-person racing? If so, then this virtual world is for you.\n\n- Compete for in-ring races with other pilots in asynchronous multiplayer, which will identify the best among equals.\nHone your skills and reach maximum speed. Don't miss the chance to surpass yourself and improve your time on the track. Become the fastest.\n\n- Stand out not only by the results but also by the unique customization of your \"Air Bollid\".\n\n- Enjoy the view from the cockpit and its interior, as you immerse yourself in advanced polygonal graphics.\n\n- Participate in regular events with prizes, and get ready for constant content updates.\n\nJoin the league. Become an Omega pilot!", "short_description": "Omega Pilot is an exciting first-person VR racing game with realistic physics and control mechanics. Compete for in-ring races with other pilots in asynchronous multiplayer and enjoy the view from the cockpit at high speed!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xocus.co/privacy-policy-eng", "developer_terms_of_service_url": null, "publisher_name": "XOCUS", "support_website_url": null, "website_url": "https://xocus.co/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area
t64.5771-25/499618293_1404338971196663_670350875566768604_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZBCDgollWegQ7kNvwGUZaNr&_nc_oc=AdkCKCoZov_OFXQAvC_DCU8XCsBxerXZxnPRX1PY0pUtC6by2bxk-UDTTRDZ-xmoOog&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzS2aW3a2nD4L7RKuH1k35HqsR-UC164cFC3_b7-5vIeQ&oe=69AC038B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Candle State Change_Landscape.png", "id": "1034750587587125", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031544_1034750590920458_6058207258553491149_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqVJ88M-hCIQ7kNvwHrKhJE&_nc_oc=AdnuNZa-6GlUb3NDSHxXWuXmi7JezE_8AmUWYHaKsVpaqG_-iLBPh_cadP7k5lrg4wU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYk4DfRyoZYgG9V-2iuMCKsR6FxKKm8MxHhkdm5UKsNw&oe=69AC2689"}, "display_name": "Candle State Change Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "candle", "science", "contentsda"], "long_description": "1. place the empty beaker on the trivet\n2. place a candle in it\n3. light the alcohol lamp\n4. melt the candle\n5. the candle has melted and become liquid\n6. weigh the candle in its liquid state\n7. the candle can be hardened quickly\n8. the candle has solidified and is now a solid. Weigh it.\n\n<Results\n- You can see that the mass of the candle when it was melted and when it cooled again, the mass did not change, but the volume did.\n- When a substance changes state! Mass remains unchanged, volume changes", "short_description": "Witness the fascinating transformation of states in a candle. Observe how the heat changes the candle from solid to liquid to gas, demonstrating the concept of state change in physical chemistry."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_
hot_2.png", "id": "1098491498779027", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622277_1098491502112360_3574053530630876264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1VwLXU4hVYkQ7kNvwGM7F2V&_nc_oc=Adk10VkLSuWOzGWlcjA_G2HG6pfKFqa7J0mWvbmbsJinNiQcQrmxhYzoEc0jyOmpwlE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuofdaaVmbVHWNwNPnSaXKUXF937BgMYUAZbl5en3Z87Q&oe=699C3B27"}, {"file_name": "Screenshot_5.png", "id": "1376898826924307", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618299_1376898830257640_7372401514272567864_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bg_Z5jiR9AYQ7kNvwG0oKEZ&_nc_oc=AdldzyfPJ22fizb02W6pQFT1SjGINjHLyxMX0k9XYALXBCOKq_CFU4BspRCweI6qmys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvWDCuuHZ1mox3TI1FBSSmM5KQER6czMOn5MTRb2xrI7A&oe=699C40AA"}, {"file_name": "Screenshot_4.png", "id": "1786209141929737", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618251_1786209145263070_428686207320816017_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCDVmDHgPvAQ7kNvwGf9Odi&_nc_oc=AdnXipfpDkYHz8LZq7z2glawsnjdNlWWY2ZS6GQpS6L4X4oNTjHsH8fb3-kqUI1qh8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuyTy-BEnipsVskvq5kDtWy7SRH68MF19QOj6RKtS5bkg&oe=699C3905"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLUX TAG", "keywords": [], "long_description": "Flux Tag is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other.\n\nWhether you're the hunter or the hunted, movement is everything. Master momentum, wall-run across futuristic platforms, leap across massive gaps, and make split-second decisions to outplay your opponents. With fast, fluid locomotion and parkour-inspired level design, every match feels fresh, challenging, and fun.", "short_description": "Flux Tag is a fast-paced VR multiplayer game that builds on the popular Gorilla Tag locomotion system. Swing, climb, and leap through dynamic environments as you chase or evade in thrilling games of tag. Master momentum-based movement, outmaneuver opponents, and experience an intense workout\u2014all in the world of Flux Tag.\n\n"}]}, "developer_name": "BIGBOI STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/fluxtagbigboi/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.com/view/fluxtagwebsitefr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23985307474398250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617767_1228846215295387_2442412888841358079_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxmkA4KLcJMQ7kNvwGWd7YJ&_nc_oc=AdmRBgh2NzHoUU8dlPNU2zVPJNq4VDbAvVXRPtEXQwoOHxpL35U1iJsmInX-dMnrBtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsmt5KpTk9lidOAx0sddIdGDiqDEk_bH4SrCdVAkjcWFQ&oe=699C6302"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FLUX TAG", "platform": "ANDROID_6DOF", "context_category": {"cont
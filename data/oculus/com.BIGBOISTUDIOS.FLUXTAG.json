OpXO80h84z_-FKFb-Weh9_vGKZQ02-GiH0sreHRQlXA&oe=69BA8FD2"}, {"file_name": "Screenshot_2.png", "id": "1098491498779027", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622277_1098491502112360_3574053530630876264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=npebCoLffaoQ7kNvwF_cSPa&_nc_oc=Adl7YVHkhvE7Zj5x7jUPtEL_Nv5eo8BjJ_FjOEg68ys8V4-YKoxIJM5yK3JmARHsl7E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy60yOKQtlje9M92O-znaLkz3SRAVCjoGHXUZUuMSAzEw&oe=69BA8DA7"}, {"file_name": "Screenshot_5.png", "id": "1376898826924307", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618299_1376898830257640_7372401514272567864_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_Ks0YTXp4wQ7kNvwHHEoPj&_nc_oc=AdmLScIKmoi1669vxvmIkeJrmxrfh9e97e46Y3xvYWS3byZlwVAhwwoBbyokiOpQXfo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxaF5Of-McrXyDua3DxX2YlvYfCvFJL6vt8dJ31X3lzQ&oe=69BA932A"}, {"file_name": "Screenshot_4.png", "id": "1786209141929737", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618251_1786209145263070_428686207320816017_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62nf0EfH5cQQ7kNvwHZ7GXN&_nc_oc=Adk0MF8oqsA8I2Glu-fVwqrMhnUIxAPhinRWgkCfTmu_MVgPj8SutDLjpGe1pLsG1IU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxJjpLLp0UrMMAz72E-l3JGKM05gdnRSSkR94GstycWFA&oe=69BA8B85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLUX TAG", "keywords": [], "long_description": "Flux Tag is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other.\n\nWhether you're the hunter or the hunted, movement is everything. Master momentum, wall-run across futuristic platforms, leap across massive gaps, and make split-second decisions to outplay your opponents. With fast, fluid locomotion and parkour-inspired level design, every match feels fresh, challenging, and fun.", "short_description": "Flux Tag is a fast-paced VR multiplayer game that builds on the popular Gorilla Tag locomotion system. Swing, climb, and leap through dynamic environments as you chase or evade in thrilling games of tag. Master momentum-based movement, outmaneuver opponents, and experience an intense workout\u2014all in the world of Flux Tag.\n\n"}]}, "developer_name": "BIGBOI STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/fluxtagbigboi/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.com/view/fluxtagwebsitefr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23985307474398250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617767_1228846215295387_2442412888841358079_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV5qG_-yiJIQ7kNvwFu2T2A&_nc_oc=Adnlv6avrGksKzmhN76Hua7_ehYfH34bU3eE-nFWS54gLPit2kib15x2SQcFp1CZma8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjIU_uRDkupS7kp6jRGWCHAt_FiRKS-MU9Voxf1-BG-Q&oe=69BAB582"}, "is_concept": false, "is_test": fal
Yrl12ihwdthLaY4bBekI29VmZP-3BbyN8WHPbn5FKag&oe=69BD32D2"}, {"file_name": "Screenshot_2.png", "id": "1098491498779027", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622277_1098491502112360_3574053530630876264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5rdO6_wv1IQ7kNvwGFCUdH&_nc_oc=AdlRXVIQg5i5K2ZS4ZUcbl9L3rykbCBssOTGe3DranAEFMSURwwwLGTXT_dtuq23EqA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwh97NvWDWeJ_kgye3imgNNtXktkRnlPThZ00VGj6YsUw&oe=69BD30A7"}, {"file_name": "Screenshot_5.png", "id": "1376898826924307", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618299_1376898830257640_7372401514272567864_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_Ks0YTXp4wQ7kNvwEX1Wr_&_nc_oc=AdmW7Lzixyu8e7lxeQYAFOiW29hQVg3xjRQ0C8hGxwfrYWsUxffsNsEUrQwp02fAzOI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyqQhLFTjKcYih3j7lWea7NETo_fP07YIpjsVOHc38W2w&oe=69BD362A"}, {"file_name": "Screenshot_4.png", "id": "1786209141929737", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618251_1786209145263070_428686207320816017_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62nf0EfH5cQQ7kNvwHXmau0&_nc_oc=AdmGfrRYQuRwM3AbuxWiN9J1CDe9ordAZBAmMLVa-amMaRVEhVOBpYCCh_Zf9ydC-DQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyX4ms2aVjkW6WQueTCEwnblMTckI1H2fRjp7HVJj9OVA&oe=69BD2E85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLUX TAG", "keywords": [], "long_description": "Flux Tag is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other.\n\nWhether you're the hunter or the hunted, movement is everything. Master momentum, wall-run across futuristic platforms, leap across massive gaps, and make split-second decisions to outplay your opponents. With fast, fluid locomotion and parkour-inspired level design, every match feels fresh, challenging, and fun.", "short_description": "Flux Tag is a fast-paced VR multiplayer game that builds on the popular Gorilla Tag locomotion system. Swing, climb, and leap through dynamic environments as you chase or evade in thrilling games of tag. Master momentum-based movement, outmaneuver opponents, and experience an intense workout\u2014all in the world of Flux Tag.\n\n"}]}, "developer_name": "BIGBOI STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/fluxtagbigboi/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.com/view/fluxtagwebsitefr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23985307474398250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617767_1228846215295387_2442412888841358079_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV5qG_-yiJIQ7kNvwGgTHs6&_nc_oc=AdkN_P8sevK23X21cMMdqFQhCerXzvuwoDp_HUyCiSC-IKaUgybfVWXqGJc86FSFcgs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQe9nlg3ehhxT57pRUYbwSxjZBF-HzaZL-ou4pQ3v9Xw&oe=69BD5882"}, "is_concept": false, "is_test": fal
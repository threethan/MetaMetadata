oculuscdn.com&_nc_ss=7a30f&oh=00_Af08ATPHKhbt71ee6jDiqQAxJjJDsWToabDk3JwklTN4HA&oe=69E762D2"}, {"file_name": "Screenshot_2.png", "id": "1098491498779027", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622277_1098491502112360_3574053530630876264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g73bSR5RefkQ7kNvwH-GhMO&_nc_oc=AdrODlYPxS2FzDbSudOxIgTufSTLC-xIJoqcJ-ENLKRMrV4KrW-8QenNSc6cK1wQtlg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AK3j46tzSCUdA8cO8MkE6yOQI0WIjOLncMbqXKxoNMQ&oe=69E760A7"}, {"file_name": "Screenshot_5.png", "id": "1376898826924307", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618299_1376898830257640_7372401514272567864_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtByjcowBQkQ7kNvwExuxMy&_nc_oc=AdrUILVJ1AP2W_YvPXZa0BbornC0uRsFeY9QGi6bxI8Q9BGyLSTAdURbEribBPo-zOo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2iJGOmG5OOq7ixVOrOV3buZFIe58t0Gb5TcJJqQsmsww&oe=69E7662A"}, {"file_name": "Screenshot_4.png", "id": "1786209141929737", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618251_1786209145263070_428686207320816017_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GF2lSTiKhGYQ7kNvwESFmWt&_nc_oc=AdriPlDvty_6h5wyYz0oeobYMyIkVC_5dHtDhqm0NSnMRDfuLVUW4A2HkGX5Jqwl4D0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15oXWErWadbt3ZW7MELTrJsANkxsNmC3Y1pKu7NV4ABw&oe=69E75E85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLUX TAG", "keywords": [], "long_description": "Flux Tag is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other.\n\nWhether you're the hunter or the hunted, movement is everything. Master momentum, wall-run across futuristic platforms, leap across massive gaps, and make split-second decisions to outplay your opponents. With fast, fluid locomotion and parkour-inspired level design, every match feels fresh, challenging, and fun.", "short_description": "Flux Tag is a fast-paced VR multiplayer game that builds on the popular Gorilla Tag locomotion system. Swing, climb, and leap through dynamic environments as you chase or evade in thrilling games of tag. Master momentum-based movement, outmaneuver opponents, and experience an intense workout\u2014all in the world of Flux Tag.\n\n"}]}, "developer_name": "BIGBOI STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/fluxtagbigboi/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.com/view/fluxtagwebsitefr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23985307474398250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499617767_1228846215295387_2442412888841358079_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUJLt_QPBGIQ7kNvwGevZox&_nc_oc=Adq1I14pp9abe8ooSQQ95VVFBqQq6s-0RzlckgJtY_57xbgB6v0xgage8gU3J3nFofI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AIoppaXEH52Pi2sWYFucXymIpKIcmxgu9d0h7DOeTi
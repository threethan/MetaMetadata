oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTn0s_hIFpS75ES8QEFSrYcAXEt0Z2SfOpaOtiYNhg7A&oe=69D0F952"}, {"file_name": "Screenshot_2.png", "id": "1098491498779027", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622277_1098491502112360_3574053530630876264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVy8w1KuZpUQ7kNvwGJi0oD&_nc_oc=Adr_LSOY9Q-KGt-iWqxn_VkiS6y_SuDHTzckqq3O4_gL6kP14hex38qraD9AUHKG2Rs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyX9LiR0ELPCxFwpl56c_wn_UK2GrJcQ2JQjhK_3f9VmA&oe=69D0F727"}, {"file_name": "Screenshot_5.png", "id": "1376898826924307", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618299_1376898830257640_7372401514272567864_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qb9xIqDnTLYQ7kNvwEC-qwg&_nc_oc=AdoT663VWLq27olPYxYSWkibMGEiZxFL0kDZQJrFk_H8v87Kd8H2T1dLdhbriiSM1PU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwhH_dEsPlw5GxDfKED7b45EbRqrp1goEmfaRsqw1fJ7A&oe=69D0FCAA"}, {"file_name": "Screenshot_4.png", "id": "1786209141929737", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618251_1786209145263070_428686207320816017_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5myxuHGgFfEQ7kNvwHO4xXn&_nc_oc=AdpI2rmwyIIDt7hQls6ym_lb1APgWVk6kDpdiGjMgIEhDw3JwO8O2IoukCMeVEC_5zA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0rd8HSDt6QHwMXuaR4Zk8EVBZ6WRK2VwWZo_ZPZlbqg&oe=69D0F505"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLUX TAG", "keywords": [], "long_description": "Flux Tag is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other.\n\nWhether you're the hunter or the hunted, movement is everything. Master momentum, wall-run across futuristic platforms, leap across massive gaps, and make split-second decisions to outplay your opponents. With fast, fluid locomotion and parkour-inspired level design, every match feels fresh, challenging, and fun.", "short_description": "Flux Tag is a fast-paced VR multiplayer game that builds on the popular Gorilla Tag locomotion system. Swing, climb, and leap through dynamic environments as you chase or evade in thrilling games of tag. Master momentum-based movement, outmaneuver opponents, and experience an intense workout\u2014all in the world of Flux Tag.\n\n"}]}, "developer_name": "BIGBOI STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/fluxtagbigboi/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.com/view/fluxtagwebsitefr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23985307474398250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617767_1228846215295387_2442412888841358079_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDxsBRGdnY0Q7kNvwH7hIBU&_nc_oc=AdoG-nn-DfoA_WNayDbFUcrkX7ZFl1NnsrZywIUjjo9nZvDDUQnLy1_bXxqdvsedXd4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLaKWRk4bmkKo1puFshBAgD_LhYXIr9SJSq87-Nwut0
oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7c0WeQZ5uHiGBGu6ofRgcOBOP_RWnwdl3kHLzbVroNw&oe=6A8ADCD2"}, {"file_name": "Screenshot_2.png", "id": "1098491498779027", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622277_1098491502112360_3574053530630876264_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vplrjg8ypIUQ7kNvwG0TS_u&_nc_oc=Adoe3eXFdi1LBdS2HcojTKgA1lc1dsXpv7E73pRMS60Jx5ck9Gfd3VyGZbmDw1ocRmQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYWj1r08LkZSrURy5u8hJfR7bHuZp69AQAFEB1B-UKJA&oe=6A8ADAA7"}, {"file_name": "Screenshot_5.png", "id": "1376898826924307", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618299_1376898830257640_7372401514272567864_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShY7W-Lv3aIQ7kNvwHaFS0x&_nc_oc=AdpXRb79iZcr1OhOQqMVeRO-lXmFRh0CudSY-kzNp5YK5L8ISDoZzic0wlWSyHv4Zrs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBGADQ5kwsVbSRDKugmChK8md3FWHCH37lmIFv9xvTjg&oe=6A8AE02A"}, {"file_name": "Screenshot_4.png", "id": "1786209141929737", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618251_1786209145263070_428686207320816017_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn9YlzWuB0IQ7kNvwHw0xGk&_nc_oc=AdqjCmglD4_CM3bYMn_FBmXtVE7SQi4ymjUSAIVwIyQFThwd0yG70grP0BbcHGSNdu8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfltLAy19mO5w2yAZti6l9NaZgfeRNmiz_VjH2sMnbJQ&oe=6A8AD885"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLUX TAG", "keywords": [], "long_description": "Flux Tag is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other.\n\nWhether you're the hunter or the hunted, movement is everything. Master momentum, wall-run across futuristic platforms, leap across massive gaps, and make split-second decisions to outplay your opponents. With fast, fluid locomotion and parkour-inspired level design, every match feels fresh, challenging, and fun.", "short_description": "Flux Tag is a fast-paced VR multiplayer game that builds on the popular Gorilla Tag locomotion system. Swing, climb, and leap through dynamic environments as you chase or evade in thrilling games of tag. Master momentum-based movement, outmaneuver opponents, and experience an intense workout\u2014all in the world of Flux Tag.\n\n"}]}, "developer_name": "BIGBOI STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/fluxtagbigboi/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.com/view/fluxtagwebsitefr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23985307474398250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617767_1228846215295387_2442412888841358079_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qyy4MSJGHTAQ7kNvwEKbn4k&_nc_oc=AdqFkkF9m2sWdQAffQ9ScU_Lwq5GEKGAx6NUZOFfh2RnwDF77ougdVbPs6VbKrFWqUQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVq3zie7snaSB0JpIfxzwCtC4pi-8l6F0vxXNaEigA2
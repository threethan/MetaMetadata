3512428_6135385629047883269_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5pjmCjHAI8Q7kNvwHzhI0x&_nc_oc=AdrcHFLiu2jGwhLBWPQqaZQ3NAnJHn89DvjY7jGO0TqwMOdq1QlZa4OYHuQt9gyD5KI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHu0QIUooYYRC_6vJQazy3DCl7kGOyftvHskLkYM8f_w&oe=6B09A512"}, {"file_name": "Screenshot_2.png", "id": "1098491498779027", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622277_1098491502112360_3574053530630876264_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dv2Qv3DvPEwQ7kNvwGEmGwe&_nc_oc=AdqqcofJ9Ye_ZD3mlEgS5ccMkHGLeQ8ZH8QtIUYMf4IxbGn3vsTAlhkN1i9zGxrGs4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPVz5cpBr6QoErdFhn0pSCPxciK4Jndx6h6aFGRSXdQw&oe=6B09A2E7"}, {"file_name": "Screenshot_5.png", "id": "1376898826924307", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618299_1376898830257640_7372401514272567864_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mt20i09qvCcQ7kNvwENd3zA&_nc_oc=Adqf6DlUqvqq8vDW-4ccWUE_v2S8YYAJ2LV592ooSKcBodsB0uxXzXtWyD5X85EJK6E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBjad1WoX9sBpNoSu4EznZf34d2X3Tzksc_1xV887Z4g&oe=6B09A86A"}, {"file_name": "Screenshot_4.png", "id": "1786209141929737", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618251_1786209145263070_428686207320816017_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQPFGjEIC34Q7kNvwF4mt--&_nc_oc=Adq03g0I18d99JAt5AyZYoWRhDFUBtlaRso8kNZozjp_AQMWNjlEfAucXpmpGCTSEbY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAZfHsNpXu2oAeAPG8fWY7UEMtcSKyeqpkE78rcTX0xQ&oe=6B09A0C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLUX TAG", "keywords": [], "long_description": "Flux Tag is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other.\n\nWhether you're the hunter or the hunted, movement is everything. Master momentum, wall-run across futuristic platforms, leap across massive gaps, and make split-second decisions to outplay your opponents. With fast, fluid locomotion and parkour-inspired level design, every match feels fresh, challenging, and fun.", "short_description": "Flux Tag is a fast-paced VR multiplayer game that builds on the popular Gorilla Tag locomotion system. Swing, climb, and leap through dynamic environments as you chase or evade in thrilling games of tag. Master momentum-based movement, outmaneuver opponents, and experience an intense workout\u2014all in the world of Flux Tag.\n\n"}]}, "developer_name": "BIGBOI STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/fluxtagbigboi/home", "developer_terms_of_service_url": null, "publisher_name": "Bigboithebiggest", "support_website_url": null, "website_url": "https://sites.google.com/view/fluxtagwebsitefr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23985307474398250"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499617767_1228
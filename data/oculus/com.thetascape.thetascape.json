IaQydkRjrdfmJYVd-yr3wjvInv6jj6Wo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rH31HfKDbTlwD20AJbmiL9UaBQPJfAYl5Jnq9R3UFFQ&oe=69E8B1B9"}, {"file_name": "2026-03-28 16-36-15 (0-00-58-04).png", "id": "2787392811609665", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618293_2787392814942998_4264179174955452654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k4z7M87MB2QQ7kNvwH8kmCh&_nc_oc=AdpkX054EhLnjqpqHDqISMiaIM2UkWf7bB5KKszS204RWihyr7tWGMnsiMhvRFe_Z_U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BzogSkvgshRGsN_NS5O_33heraoVMnC1vZ0AvYx5Nug&oe=69E8DDD8"}, {"file_name": "2026-03-28 10-22-12 (0-03-09-08).png", "id": "1701063017443678", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819854_1701063020777011_1382181768301339539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqkfHEyPnjgQ7kNvwEjSxiK&_nc_oc=AdqeIJGW47yEvdiGX-V1L7dGqWepAWwaIkYe9F0Nh2NczwqMlpQ9uvQOXgZU40vww10&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CnxzDiHgpk2zdou4IwBFGQ9dsMdU6CBf9IeonXsy66A&oe=69E8C813"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2026-03-28 16-36-15 (0-00-58-27).png", "id": "973146948522677", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818860_973146951856010_5928293037753495193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2UgjdgHBzYQ7kNvwHURk7H&_nc_oc=Adot0jrf608ZipStVwsQu85iqH5cSQgIRWFiv_xwlVX3sMz7m-m_uJJtb5ub1XY2u8Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ugtofnx1Qm_7f9-NIFVkZb70zX016JZB80Q7aXj--uA&oe=69E8B282"}, "display_name": "Thetascape: Neon Rhythm", "keywords": ["handtracking", "scifi", "fitness", "rhythm", "workout"], "long_description": "READ THIS BEFORE PLAY\n\nThis is a hands-only game. Mechanics are completely different from what you\u2019ve seen before. Have you ever driven a car in your life? You will most certainly feel discomfort at first. Be ready for this.\n\nGAMEPLAY\nYou can\u2019t just smash everything like in regular Quest games. Rare and legendary collectibles are almost always difficult to get.\nIf you see spikes, you will most likely get paralyzed by contact with them. You can still collect the object if you perform a precise strike while avoiding the spikes, or learn its pattern and grab it when it appears without spikes.\n\nLegendary collectibles become obtainable with rhythm spikes - when the beat rises, that\u2019s your moment to strike.\n\nIf you get paralyzed in different scapes, you can recover almost immediately by performing circular motions with both hands.\n\nInside your palm menu, under the scape switch buttons, you will see your name and status (\u201conline\u201d). This is where your result at the end of the scape is compared with other players.\n\nTo unlock more scapes check the daily goals inside the statistics interface, which can be opened by clicking the button on the right in your palm menu.\n\nDon\u2019t move chaotically. You will build up fatigue, which slows down laser growth, increases paralysis duration (5\u201315 sec), and reduces the amount of Llirium (your final score).\n\nSorry if you feel annoyed by the mechanics - the goal of Thetascape is to challenge ordinary patterns,  show something new, non-commercial, unique.", "short_description": "Thetascape is a controller-free multiverse of scapes, where each scape features its own visual identity and gameplay system - fully standalone experiences connected through a shared progression system and unified statistical framework.\n\nIn one scape, you rotate a sphere and aim a laser to split incoming geometric entities rushing through a tunnel. In another, lasers extend from your fingertips, allowing you to slice beat-synced forms as they emerge in rhythm\u2026"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thetascape.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Thetascape", "support_website_url": null, "website_url": "https://www.thetascape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26331438606484387"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828583_1511922320540086_737559329040254940_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apM2nvnQe1QQ7kNvwEQ2IF5&_nc_oc=AdqDzPcBOEriPnWDSEtYzyW0SB_QGeEn6rgjZyAdj-NR_57o6OJ08Cn2Wg0WF8hmyw0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1m4WggPlXGmuDASBCaVCh0FLq1oAXBERZ3f4TuAf3zsw&oe=69E8B4BF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Thetascape: Neon Rhythm", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Rhythm", "id": "1672577396871977"}], "release_date": 1774978320, "lastRevision": {"nodes": [{"id": "24445252108436389", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24445252041769729", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1756070538393
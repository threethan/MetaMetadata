q9FzE-w08wani55ex-_w-T8nwOakae5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2OyM7ugwt1OiEi70DXoEpNx92dRE8ZfsEpNotUS8JpZA&oe=69E36BB9"}, {"file_name": "2026-03-28 16-36-15 (0-00-58-04).png", "id": "2787392811609665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618293_2787392814942998_4264179174955452654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR2MEMXfCbIQ7kNvwFYcjxi&_nc_oc=AdpT6ikrfmkKu94_LxKVgDIAe3pvN78FfrSm2UNHefPtHtBi_2kPxR88--S8fILubmM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1q1DmPI97sKU4vgPH2dwlPwKtRivKXebj_wRaXZoOaYQ&oe=69E397D8"}, {"file_name": "2026-03-28 10-22-12 (0-03-09-08).png", "id": "1701063017443678", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1701063020777011_1382181768301339539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZNYA1RC_2cQ7kNvwEOsrZn&_nc_oc=AdrarVx-ZTtZJ_FGf-Qf_Y-HgoT0dJZ5HlxIjVKu801gpimYCDqb4woo7J-4a68d2LA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39GK_r6VH098RE4DODIK3qXtmvFfAIzk7NwHewnDwwBQ&oe=69E38213"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2026-03-28 16-36-15 (0-00-58-27).png", "id": "973146948522677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818860_973146951856010_5928293037753495193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piUGaX64h30Q7kNvwExpDZD&_nc_oc=AdpvWRqm6UE1WRIma1au89ZFKK1Lb3rjKvMnTVObSb8iJZWo55tk5_TSwoVkGyUs9Ds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u-8BQnzTXFiEy43c0F-NFgCxBkAKSiTJP2riUpEO-lg&oe=69E36C82"}, "display_name": "Thetascape: Neon Rhythm", "keywords": ["handtracking", "scifi", "fitness", "rhythm", "workout"], "long_description": "Thetascape is a controller-free VR experience made of multiple \u201cScapes\u201d, each with its own visual style and gameplay mechanics.\n\nIn one scape, you rotate a sphere and aim a laser to split incoming geometric entities rushing through a tunnel. In another, lasers extend from your fingertips, allowing you to slice beat-synced forms as they emerge in rhythm\u2026\nEvery scape introduces a distinct mechanic, a new flow, a different way to interact.\n\nYou now have the opportunity to be among the first to step into Thetascape.\nFree for a limited time. \nOngoing support, updates, and direct communication are available through official channels.\n\nWelcome to Thetascape.", "short_description": "Thetascape is a controller-free multiverse of scapes, where each scape features its own visual identity and gameplay system - fully standalone experiences connected through a shared progression system and unified statistical framework.\n\nIn one scape, you rotate a sphere and aim a laser to split incoming geometric entities rushing through a tunnel. In another, lasers extend from your fingertips, allowing you to slice beat-synced forms as they emerge in rhythm\u2026"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thetascape.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Thetascape", "support_website_url": null, "website_url": "https://www.thetascape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26289034734058108"}, "review_messages": []}]}, "cover_square_image": {"uri": "https:
_nc_ss=7a30f&oh=00_Af1q1DmPI97sKU4vgPH2dwlPwKtRivKXebj_wRaXZoOaYQ&oe=69E397D8"}, {"file_name": "2026-03-28 10-22-12 (0-03-09-08).png", "id": "1701063017443678", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1701063020777011_1382181768301339539_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZNYA1RC_2cQ7kNvwEOsrZn&_nc_oc=AdrarVx-ZTtZJ_FGf-Qf_Y-HgoT0dJZ5HlxIjVKu801gpimYCDqb4woo7J-4a68d2LA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39GK_r6VH098RE4DODIK3qXtmvFfAIzk7NwHewnDwwBQ&oe=69E38213"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2026-03-28 16-36-15 (0-00-58-27).png", "id": "973146948522677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818860_973146951856010_5928293037753495193_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piUGaX64h30Q7kNvwExpDZD&_nc_oc=AdpvWRqm6UE1WRIma1au89ZFKK1Lb3rjKvMnTVObSb8iJZWo55tk5_TSwoVkGyUs9Ds&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0u-8BQnzTXFiEy43c0F-NFgCxBkAKSiTJP2riUpEO-lg&oe=69E36C82"}, "display_name": "Thetascape", "keywords": ["handtracking", "scifi", "fitness", "rhythm", "workout"], "long_description": "Thetascape is a controller-free, futuristic, audio-reactive wireframe reality powered by the soundtrack of Synth Alien - a fusion of movement, rhythm, and energy that brings balance and harmony through daily physical engagement.\n\nThetascape is a multiverse of scapes, where each scape features its own visual identity and gameplay system, offering a fun and engaging experience. 5 scapes are available at start, with more unlocked through consistent daily strike challenges. You perform unique physical movements as part of the gameplay, naturally strengthening both body and mind through consistent motion and focus.\n\nThe game analyzes the player\u2019s physical effort. The more accurately the user performs strikes and actions, the greater the positive impact on progression within Thetascape. Chaotic or imprecise movements increase fatigue and slow recovery effects, encouraging focus and control.\n\nKilocalories Tracking - every distinct motion is recorded, updating personal stats in real time. Fitness is fully embedded into gameplay, turning movement into continuous progress.\n\nCollectibles System - gather Regular, Rare, and Legendary geometries across scapes, tracking overall progression. Shoot, fly, fight, and dance to achieve daily objectives.\n\nVisual Exploration - each reality is generated in real time through music and player interaction, making every journey through Thetascape unique.\n\nTHIS APP IS ACTIVELY BEING DEVELOPED. PLEASE CHECK FOR UPDATES REGULARLY.", "short_description": "Controller-free, rhythm-driven VR game with fitness training elements, powered by the soundtrack from Synth Alien.\nThetascape,a multiverse of scapes where each scape features its own identity and mechanics, is designed to guide users toward precision over chaos, where controlled, deliberate movement drives progression and unfocused actions carry consequences.\nPerform unique physical movements as part of the gameplay, naturally strengthening both body and mind through consistent motion and focus."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thetascape.com/pp.html", "developer_terms_of_service_url": null, "publisher_name": "Thetascape", "support_website_url": null, "website_url": "https://www.thetascape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages":
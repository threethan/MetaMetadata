ut only one may leave.\n\nWho among you will claim the title of champion?\n\nFeatures:\n- Single Player Battle Royale (vs AI)\n- Boss Battles\n- Intense 1v1 Melee Combat\n- Combo and Magic System\n- Build Customization", "short_description": "Fight to the death in a series of duels and battle royales to claim the title of champion. Explore vast battlefields and collect powerful artifacts to increase your strength. Many will enter, but only one may leave."}]}, "developer_name": "Daniel Moore", "developer_privacy_policy_url": "https://dreamcatcherstudios.netlify.com/privacypolicy", "developer_terms_of_service_url": "https://dreamcatcherstudios.netlify.com/tos", "publisher_name": "Dreamcatcher Studios LLC", "support_website_url": null, "website_url": "https://dreamcatcherstudios.netlify.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "492606178894143"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974779_2311444062218176_2135970111989743616_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xW8UfUvJTTIQ7kNvwE-QdDA&_nc_oc=AdmDAD44DFvY4c0Hw0f2hGC-ghXKdspcGJczwNet-DDoRpD4MDrqtJW7DwNnli5VMKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQRqh5m9G0UcoV9PE-VwDv7chc9-cKZtUQL10cOpHdLA&oe=69BBE26B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tourney of Eradorn", "platform": "ANDROID", "context_catego
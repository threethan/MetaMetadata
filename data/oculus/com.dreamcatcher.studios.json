z_10Q7kNvwFzDWrH&_nc_oc=Adrgh9jxLNiqNIWJZeArKJMWzkLMyypSwRuAweKFjjA48aU-52GeNLBPzZmDdu4nTDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7oE1idTq_cyrFQ0iF1jCDeM1qBUf8hRGFW_7RRHlrDQ&oe=6A6B3BF6"}, {"file_name": "migrated_image.png", "id": "1305719372950529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974488_2130027320364367_5836281743996354560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RxsLSlHJU00Q7kNvwGEG46r&_nc_oc=AdoM-hHBltbUQt7ZZ4mTSMcbl5wYuszo9aCn_LC_9C7jw7WPcD18mDyu6qlTTvDmQmM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaO-Df-NUeXaswUt5CUiTEtzqYmNUUwIfxZ6NmB1rlEQ&oe=6A6B6738"}, {"file_name": "migrated_image.png", "id": "545736319398866", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982619_2002111109879267_7735049500946857984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-5CqeiXjIQQ7kNvwH7hXSK&_nc_oc=AdqtFWCEKJY1JZYbIePxh1UBQLkCUhD6guq6M6Liqd7SxCEYpBH0RPdi420HwHvEmiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdWCpmyBH541zVlO-fg6apmQNJUi3y8YucbmziMQUWig&oe=6A6B378E"}, {"file_name": "migrated_image.png", "id": "219506359258242", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982603_285000892132703_6629079921689886720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUXzMQjHpDMQ7kNvwE_jNr1&_nc_oc=Adp76xd0VgCT6yEzKNuLjHb6htNGnn8-7DoKYduS-vT4L0D3hVVKEV5miSftCuEew0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB85eTIpbFo2gHT2ZNifI6PmAYJJNXmPposVd9ZpIBzXQ&oe=6A6B4928"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tourney of Eradorn", "keywords": ["battle", "royale", "fighting", "action", "fantasy"], "long_description": "Attention citizens of Eradorn, the great tourney is upon us. The price of admission is cheap: a wager of your life. All competitors must fight to the death in a series of duels and battle royales. Throughout the tournament you may collect powerful weapons, armor, and totems to increase your strength. Many will enter, but only one may leave.\n\nWho among you will claim the title of champion?\n\nFeatures:\n- Single Player Battle Royale (vs AI)\n- Boss Battles\n- Intense 1v1 Melee Combat\n- Combo and Magic System\n- Build Customization", "short_description": "Fight to the death in a series of duels and battle royales to claim the title of champion. Explore vast battlefields and collect powerful artifacts to increase your strength. Many will enter, but only one may leave."}]}, "developer_name": "Daniel Moore", "developer_privacy_policy_url": "https://dreamcatcherstudios.netlify.com/privacypolicy", "developer_terms_of_service_url": "https://dreamcatcherstudios.netlify.com/tos", "publisher_name": "Dreamcatcher Studios LLC", "support_website_url": null, "website_url": "https://dreamcatcherstudios.netlify.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "492606178894143"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974779_2311444062218176_2135970111989743616_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qsBuC4o8YrwQ7kNvwGqh-In&_nc_oc=AdrmXtv0lc8Rtybs-D2_sL6-bHvvTHCk5uywoDZjVn-MdCjpMyxHY4QLipVp7PGOvgk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBC-Vzl4fRxr7CQ2tcsHMzBFaDkcTv_Foh7-UNYojQZlA&oe=6A6B39EB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tourney
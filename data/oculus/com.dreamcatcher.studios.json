hZXgQ7kNvwFrHgE6&_nc_oc=AdrwuXQjJfpU_pNF9kb1ttdimWNMdbMw0vuUXkk-XXRgsxipjkeAgM2FiqbsBSz9eFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWGtRm0CwtmgqiasG1MawBocrnCEE_jzCg1Cz7v0BGBw&oe=6A9EDEB6"}, {"file_name": "migrated_image.png", "id": "1305719372950529", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974488_2130027320364367_5836281743996354560_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLzMrIMubo4Q7kNvwGNvomB&_nc_oc=AdoViWY3fXCoG9-AwjT5rAnOdBiwX8IiPN0LBNUQy0LmBKCfRrmE4lFqBZi5nVWS3s8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm773XMlHrNcHCA0HJSdZn_dUAXINmM1_GsUn6ELGuow&oe=6A9ED1B8"}, {"file_name": "migrated_image.png", "id": "545736319398866", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982619_2002111109879267_7735049500946857984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUeVkn46VMoQ7kNvwHFENiZ&_nc_oc=AdreP_debmqKHiSDQ8rsTdkrz7g71W7N8U4tWYbrsUTb_edrn4shjEcHZP5M4Q20mbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT4gRuq8DkWEV5Hk7mOa8WmkY0Uj_QMK6bMHaeOXX_8A&oe=6A9EDA4E"}, {"file_name": "migrated_image.png", "id": "219506359258242", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982603_285000892132703_6629079921689886720_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUZi26461j4Q7kNvwHpNbqH&_nc_oc=AdpgAuaiNQFeIUuSmoZWRGkXKIgy7L_8gVhNcSefKYoqJNzX8xwgbcVsh3xTtroo8-Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdf9H_kpNizXuETvalFqSP-i9gU8ywrsAZB_jdfn8UgQ&oe=6A9EB3A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tourney of Eradorn", "keywords": ["battle", "royale", "fighting", "action", "fantasy"], "long_description": "Attention citizens of Eradorn, the great tourney is upon us. The price of admission is cheap: a wager of your life. All competitors must fight to the death in a series of duels and battle royales. Throughout the tournament you may collect powerful weapons, armor, and totems to increase your strength. Many will enter, but only one may leave.\n\nWho among you will claim the title of champion?\n\nFeatures:\n- Single Player Battle Royale (vs AI)\n- Boss Battles\n- Intense 1v1 Melee Combat\n- Combo and Magic System\n- Build Customization", "short_description": "Fight to the death in a series of duels and battle royales to claim the title of champion. Explore vast battlefields and collect powerful artifacts to increase your strength. Many will enter, but only one may leave."}]}, "developer_name": "Daniel Moore", "developer_privacy_policy_url": "https://dreamcatcherstudios.netlify.com/privacypolicy", "developer_terms_of_service_url": "https://dreamcatcherstudios.netlify.com/tos", "publisher_name": "Dreamcatcher Studios LLC", "support_website_url": null, "website_url": "https://dreamcatcherstudios.netlify.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "492606178894143"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974779_2311444062218176_2135970111989743616_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JIJjRtYjKQQ7kNvwHOLzFu&_nc_oc=AdqFR519mTedDD0uHWuqrcuQGStasFi6Jy4uw7R3c1M2b2X-92B770ybfcRgw-zbSo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiTZvWqyau211H2qPVp-QN-oUWSATVTnl8LJp2zRxUGw&oe=6A9EDCAB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tourney
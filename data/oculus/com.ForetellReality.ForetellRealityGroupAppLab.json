s as they speak.  Users may also use hand gestures such as waving, pointing, giving a thumbs up, and making a fist.", "short_description": "Foretell Reality allows participants and moderators to communicate and collaborate in a shared reality environment, regardless of actual physical location."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.foretellreality.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Foretell Reality", "support_website_url": null, "website_url": "http://www.foretellreality.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "539527055410505"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PRODUCTIVITY", "SOCIAL", "UTILITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "692149305118255"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1013512127456962"}, {"status": "PUBLISHED", "id": "520346089072843"}]}, "baseline_offer": {"id": "1013512127456962"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733675640, "status": "PUBLISHED", "id": "1013512127456962"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27904306292573918", "version": "7.11.8"}, "id": "4361055307258454", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "369879383355
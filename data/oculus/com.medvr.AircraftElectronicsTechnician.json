ent-iad6-1.oculuscdn.com/v/t64.5771-25/499622315_3291886114327559_6849108004678318305_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jf3bmR_MioQ7kNvwHY1AtR&_nc_oc=AdqbAAXFrebTLWVw2GXqe652DLgOju1lo5SoS2ccnXB78uLiOboChZQweBkqtMapEeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzlKK4f5EvHxcONW_Nsf5tHpcoHYH7fPyxrbW6aR70Gg&oe=6A8C3B37"}, {"file_name": "ScreenShot00010.png", "id": "1319139753753159", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296027_1319139757086492_2986081609334041151_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEYion-i_l8Q7kNvwHEWzuX&_nc_oc=AdqYfmOQwykcU8zAkgepo_2PRBXfPc9b64kyE44R-WfULU5mlJXPXomR0cKbmmSAlY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC3A8CECOaqhlKYo_W9QqRSX9gPZ-u7hLEng5tgOuKBw&oe=6A8C2F1D"}, {"file_name": "ScreenShot00009.png", "id": "861560763234987", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499292779_861560766568320_6230948304913456272_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKnUhtd_CewQ7kNvwGBgaKV&_nc_oc=Adpa2sUbDzwYy1pVQ-I812W7SukNKNpo2Zzr4wfJM-2tXzmqwrOZS_5M336BPQKuqdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOaJu5biYISihnSW0w3d4NJyzZOymdtLveGg6VnCc58Q&oe=6A8C34C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aircraft Electronics Technician", "keywords": [], "long_description": "Aircraft Electronics Technician is a specialized virtual reality training application designed exclusively for students enrolled in the Immerse Learn Aircraft Electronics Technician Certification Program.\n\nThrough immersive, interactive VR simulations, learners can practice and develop essential aircraft electronics technician skills in a realistic training environment. The application is intended to complement the certification curriculum by providing hands-on training opportunities that reinforce theoretical knowledge and procedural understanding.\n\nThis application is not intended for general public use. Access is available only to students who are actively enrolled in the Immerse Learn Aircraft Electronics Technician Certification Program and have received the necessary credentials and authorization.\n\nBy combining guided learning with practical VR-based exercises, the Aircraft Electronics Technician application helps students build confidence and competency in a safe, engaging, and controlled training environment.", "short_description": "Aircraft Electronics Technician is a VR training application developed as part of the Immerse Learn Aircraft Electronics Technician Certification Program. This application provides hands-on, immersive training experiences for enrolled students. Access is restricted to learners who are officially enrolled in the certification program and have been granted authorization by Immerse Learn."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1615767467216725"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "27426504577003206"}]}, "baseline_offer": {"id": "27426504577003206"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782458040, "s
8043597_5690586020832976793_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaVn1Xdcrb0Q7kNvwFSaGno&_nc_oc=Adn-pMBjfttpH24Y8bWwahQoFxs0ERGwXPU3wRERc0Ay2G8QaSjeDggX1wtE-5H238g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu4JSg9dQdi4Wmpfj7qyzsEshKOX0pBLVop8Xu6tZjcxQ&oe=69A8116E"}, {"file_name": "MinimayhemStoreScreenShots.psd_0001_MiniMayhemScreenShot_002.png", "id": "1787788281955290", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393589_1787788285288623_2238443924170197165_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D1vP-OWn5awQ7kNvwEhH5k_&_nc_oc=AdkSD_JrU7lyHDsrIQRTIx3IFSn2c0RniblqdwiKkso2VipMgYFnG-zy9oaZhcR18Ok&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu5nIhbIBM6eVn3il5EIzLQPuXy-qfnnOP9IwzCsrbrMA&oe=69A80C35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sofa Coaster", "keywords": ["Coaster", "Adventure", "360", "Thrill", "Ride"], "long_description": "When is your sofa not a sofa? When it\u2019s a Sofa Coaster of course!\n\nThis 360 VR experience will transform your living room and take you on a crazy, exciting rollercoaster thrill ride into immersive worlds of fun and adventure.\n\nSit back, hold on tight and enjoy the view as Sofa Coaster blasts you through weird and wonderful, bite-sized adventures, turning your world upside down and rocketing you towards the finish line. \n\nPerfect for anyone who wants to sit back and enjoy some pure short-form, VR fun, with no gaming skills required.\n\nSo, are you ready for the sofa ride of your life? Then hop aboard and unleash your sofa with Sofa Coaster. Let the adrenaline take over. Let the adventures begin!", "short_description": "When is your sofa not a sofa? When it\u2019s a Sofa Coaster of course!\n\nThis 360 VR experience will transform your living room and take you on a crazy, exciting rollercoaster thrill ride into immersive worlds of fun and adventure.\n\nSit back, hold on tight and enjoy the view as Sofa Coaster blasts you through weird and wonderful, bite-sized adventures, turning your world upside down and rocketing you towards the finish line. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://figmentproductions.box.com/s/vvdefd1b685sr0u01atzdtepo98r168d", "developer_terms_of_service_url": null, "publisher_name": "Figment Productions Ltd", "support_website_url": null, "website_url": "https://figmentproductions.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9612851228734860"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "592421326561496"}]}, "baseline_offer": {"id": "592421326561496"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739957640, "status": "PUBLISHED", "id": "592421326561496"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9966958076657505", "version": "1.16"}, "id": "1098819958261193", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9208997645786889", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9966958076657505"}, "release_status": "R
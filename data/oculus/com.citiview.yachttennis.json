2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQILUPWFGcokjzzK2Sy1oBkoNCg2tVEO4wQRagN6zXDyg&oe=6AF74ADF"}, {"file_name": "screenshot_4.png", "id": "1633733548347854", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830904_1633733551681187_2955727101477094397_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbA6h6o7bQMQ7kNvwE7WeE5&_nc_oc=Adr_TShiNuKUiUjqk0DgM0ab1MFVV1oJDrXbBPDja9NNI98PsGBdSH4GYHPimzp8rEE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1FMB8_DjY-PdklZM_wq6d5UgsfZJj3REQhqkQQwvrxA&oe=6AF740B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1823732542157655", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596168449_1823732545490988_6353143790713111245_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5II1Y4oPkcQ7kNvwHB0q-Q&_nc_oc=Ado7UaWjaaRZ7KJsDTOHrzrE1qvzfCJQF2u9HyIEKIIxznLhv29FOAijlvoFux81dhQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfdYgqWW5Fvhu--Digx8XzjYfpSf8eLME2PvwUUeWUFg&oe=6AF71F94"}, "display_name": "Tennis Yacht Edition", "keywords": ["tennis", "yacht", "sports", "jetski", "ocean"], "long_description": "Your court. Your yacht. Your ocean.\n\nCENTRE COURT AT SEA\nA full-size tennis court runs the length of the aft deck, glass-fenced, with the open sea on both sides and a tropical island on the horizon. The ball machine feeds groundstrokes, volleys, lobs and serves with real bounce and topspin, and your racket is in your hand the moment you step behind the baseline. Swing across the ball and aim with the strings.\n\nDRILLS AND LEVELS\nRally, Set, Targets and Climb drills across four levels from Social to Tour. The scoreboard tracks returns, shot speed, streak and your best. Hit one over 80 mph and the WINNER banner lights up, confetti flies and the guests on the upper deck cheer.\n\nWALK THE WHOLE YACHT\nStep through the glass gate and explore: the pool deck, the salon and dining room, the master suite, the sky lounge, the bridge where the captain is at the helm, and the sun deck with its lounge and hot tub. The sliding glass doors open for you as you walk up.\n\nJET SKI AND BUOY RACE\nWalk down to the swim platform, press A and you are riding the jet ski. Right trigger for throttle, left stick to steer, and a real dash in the instrument screen shows your speed and lap. Follow the glowing beacon round eight race buoys and chase your best lap.\n\nLIFE ON THE WATER\nDolphins leap alongside, gulls wheel overhead, the sea sparkles in the afternoon sun and a big tropical island sits on the horizon.", "short_description": "Play tennis on your own 77 m superyacht. A full-size court on the aft deck, a ball machine that feeds you real topspin, guests who cheer your winners, and a turquoise tropical sea all around. Then walk the whole yacht, grab the jet ski off the swim platform and race the buoy course at full throttle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/tennisyachtedition/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/tennisyachtedition/", "website_url": "https://citiview-games.pages.dev/tennisyachtedition/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1262520616953911"}}]}, "scheduled_offers": {"count": 1, "nod
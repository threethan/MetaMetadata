7&_nc_sid=6e7a0a&_nc_ohc=aEmQ6UCnGaUQ7kNvwFu4NK7&_nc_oc=AdrVlnMvr_wsXxczgCGnNPP-z4EuWfc_HF-eZKBgRnQrA7xy6ncfio13q7fsAgeD2yY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTu1BEwEysI0Umf2J5fqgvCT4EsJC5Ck5ByeXGG_htGQ&oe=6AF8A005"}]}, "id": "2570778800104040", "locale": "en_US", "screenshots": [{"file_name": "screenshot_2.png", "id": "1409378403967877", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823259_1409378407301210_5839158911634319257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Me7fJhhlMv4Q7kNvwH4uga8&_nc_oc=AdqfluFqLNsZguP22yALJS7HiKvDJpgBVdIykIq21tYXd8AMAPri5x6OToSKbdoNwT8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFI-vqKuZZQ7wbT3E5EVz4vt7C-lJpdEiycQZnEzLGqg&oe=6AF89D69"}, {"file_name": "screenshot_5.png", "id": "2156564281611128", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827960_2156564288277794_8857208970261301852_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wD1027MGv0cQ7kNvwE7P7vR&_nc_oc=AdoH1AYW8Nmrxo1WYHrDO1oX8Z25zw8YddyZwfoFESDgyD48qzCE7UoOwaT6KHVXxBE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2FneTPtuLeE6j7eWy50wuwuwVowQoo5o5wrUaU57t3w&oe=6AF8A840"}, {"file_name": "screenshot_3.png", "id": "1528491165984532", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823910_1528491169317865_2063825879565665031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH73jGIaNtwQ7kNvwHSdVgy&_nc_oc=AdqBEG6IVSGMzqbUIpcCkOChB-pHy3BKbuUxczjII7jme5WrsQUqNj3tJe-ylZUerbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSujvLakWQYG0qyWT0UlGybsTugsGyaGGx8qxlC81ylzg&oe=6AF8885D"}, {"file_name": "screenshot_4.png", "id": "3210074755869184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_3210074759202517_519572877583160302_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLvk5CsarRYQ7kNvwEFAnWP&_nc_oc=AdpEF_s7VW3J8zBTwEZMx0WSgxJC3xP_NBTKpPPlKr_2QjoRgUcxjeyp46g9U6oz9NE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0OYcQAkd_fdabybg0H_vqW49HEuZ2W1-NZ6_kWFOjeg&oe=6AF8A197"}, {"file_name": "screenshot_1.png", "id": "1114391151039740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1114391154373073_1204353873865999436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BpZTxK74XYQ7kNvwFOrkZz&_nc_oc=AdpI2Q2iJFKA9-tWeqniJtcX8Ojkjn3FNY3Nt7EIwIOITwFu3Q10HKQdUzWcYF6J9CA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB7WtFEC6p1VJitWJiWx9QA3j6YSCsQdwaD0-sxidsNw&oe=6AF885F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1107207795605186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_1107207812271851_4102069106872710207_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVSqGzIRKnoQ7kNvwG1iBff&_nc_oc=Adp6N7TvtDi1UBCn4Vnh5Qw9usEkUBC-ytCFaAvQ8rBlG69QMRDWAfXymeHfSnmG-uQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH9iqi1f1zfyMhwaMsEdQERvklAX1frdomKXUFyI_uLA&oe=6AF8AA65"}, "display_name": "Hockey", "keywords": ["hockey", "sports", "multiplayer", "goalie", "puck"], "long_description": "The puck drops. The crowd is on its feet. It is your ice.\n\nREAL STICK, REAL HANDS\nYour hands are hockey gloves and the stick is always in them. Hold it the way you play: right hand on top for a left shot, left hand on top for a right shot, or let the game pick for you. The gloves wrap the shaft naturally, and the blade handles, passes and fires the puck with real physics.\n\nFIVE WAYS TO PLAY\nMATCH: a 3-minute game, Storm against Blaze, with faceoffs, a live scoreboard and a final card. Your AI linemates pass to you and the other side carries, passes, shoots and checks the puck off you.\nSHOOTOUT: five shots against the goalie. He drops into the butterfly, so pick your spot.\nTARGETS: 60 seconds to hit the four corner targets as many times as you can.\nHARDEST SHOT: wind up and let it fly. The radar reads your speed in km/h.\nPRACTICE: free skate with as many pucks as you like.\n\nTHREE LEVELS\nEasy, Pro and All-Star goalies and opponents. Your personal bests are saved.\n\nPLAY ONLINE\nQuick Match finds a game in seconds, or open a private room and share its 4-digit code. Up to 4 players on the ice with a goalie in each net, and optional voice chat. Mute, block and report are always one click away.\n\nTHE ARENA\nA packed bowl of fans, a centre-hung scoreboard, glass, boards and banners, with arena music you can switch or turn off.", "short_description": "Lace up and take the ice in a full-size arena. Real left and right shot sticks, your own gloves as your hands, and a goalie in every net. Play a 3-minute match with AI linemates, a shootout, target practice or the hardest-shot radar, then take it online with friends."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/hockey/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/hockey/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER"], "id": "1262571066948866"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1104813455245808"}]}, "baseline_offer": {"id": "1104813455245808"}, "is_approved": true, "firstOffer": {"no
=6AF8A840"}, {"file_name": "screenshot_3.png", "id": "1528491165984532", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823910_1528491169317865_2063825879565665031_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH73jGIaNtwQ7kNvwHSdVgy&_nc_oc=AdqBEG6IVSGMzqbUIpcCkOChB-pHy3BKbuUxczjII7jme5WrsQUqNj3tJe-ylZUerbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSujvLakWQYG0qyWT0UlGybsTugsGyaGGx8qxlC81ylzg&oe=6AF8885D"}, {"file_name": "screenshot_4.png", "id": "3210074755869184", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_3210074759202517_519572877583160302_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLvk5CsarRYQ7kNvwEFAnWP&_nc_oc=AdpEF_s7VW3J8zBTwEZMx0WSgxJC3xP_NBTKpPPlKr_2QjoRgUcxjeyp46g9U6oz9NE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0OYcQAkd_fdabybg0H_vqW49HEuZ2W1-NZ6_kWFOjeg&oe=6AF8A197"}, {"file_name": "screenshot_1.png", "id": "1114391151039740", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825563_1114391154373073_1204353873865999436_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BpZTxK74XYQ7kNvwFOrkZz&_nc_oc=AdpI2Q2iJFKA9-tWeqniJtcX8Ojkjn3FNY3Nt7EIwIOITwFu3Q10HKQdUzWcYF6J9CA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB7WtFEC6p1VJitWJiWx9QA3j6YSCsQdwaD0-sxidsNw&oe=6AF885F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1107207795605186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824671_1107207812271851_4102069106872710207_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVSqGzIRKnoQ7kNvwG1iBff&_nc_oc=Adp6N7TvtDi1UBCn4Vnh5Qw9usEkUBC-ytCFaAvQ8rBlG69QMRDWAfXymeHfSnmG-uQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH9iqi1f1zfyMhwaMsEdQERvklAX1frdomKXUFyI_uLA&oe=6AF8AA65"}, "display_name": "Hockey", "keywords": ["hockey", "sports", "multiplayer", "goalie", "puck"], "long_description": "The puck drops. The crowd is on its feet. It is your ice.\n\nREAL STICK, REAL HANDS\nYour hands are hockey gloves and the stick is always in them. Hold it the way you play: right hand on top for a left shot, left hand on top for a right shot, or let the game pick for you. The gloves wrap the shaft naturally, and the blade handles, passes and fires the puck with real physics.\n\nFIVE WAYS TO PLAY\nMATCH: a 3-minute game, Storm against Blaze, with faceoffs, a live scoreboard and a final card. Your AI linemates pass to you and the other side carries, passes, shoots and checks the puck off you.\nSHOOTOUT: five shots against the goalie. He drops into the butterfly, so pick your spot.\nTARGETS: 60 seconds to hit the four corner targets as many times as you can.\nHARDEST SHOT: wind up and let it fly. The radar reads your speed in km/h.\nPRACTICE: free skate with as many pucks as you like.\n\nTHREE LEVELS\nEasy, Pro and All-Star goalies and opponents. Your personal bests are saved.\n\nPLAY ONLINE\nQuick Match finds a game in seconds, or open a private room and share its 4-digit code. Up to 4 players on the ice with a goalie in each net, and optional voice chat. Mute, block and report are always one click away.\n\nTHE ARENA\nA packed bowl of fans, a centre-hung scoreboard, glass, boards and banners, with arena music you can switch or turn off.", "short_description": "Lace up and take the ice in a full-size arena. Real left and right shot sticks, your own gloves as your hands, and a goalie in every net. Play a 3-minute match with AI linemates, a shootout, target practice or the hardest-shot radar, then take it online with friends."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/hockey/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/hockey/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433
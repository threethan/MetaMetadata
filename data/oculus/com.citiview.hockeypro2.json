0&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud2yEo0EKX8Q7kNvwH7aqtA&_nc_oc=AdoF8bacetPnQVyy9YnYlQEZphxP1aJbKtPrhKvDKrYlI6wfTB1H_xXkxUek0Z3qCNo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTinJQ3BSoKkNlhkXMyjY_St--juiNmjfDPYarZs7VC9A&oe=6AFC7CDD"}, {"file_name": "screenshot_4.png", "id": "3210074755869184", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825470_3210074759202517_519572877583160302_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Segm3dkqkWUQ7kNvwEZ4qf8&_nc_oc=AdreQKKgPzkMNrQz9EnDSb-I5MH--Pef7eaedEgX8WflUaR-51SPRBjDe52aLNGcJlI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPRRilSDswubh7HEOyjEHSDjSbRyVD3IJpCWY2iCZ3Xw&oe=6AFC5DD7"}, {"file_name": "screenshot_1.png", "id": "1114391151039740", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825563_1114391154373073_1204353873865999436_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgayzM0d3-MQ7kNvwF-TQvW&_nc_oc=AdrYv4ya_Q_dTTi9dgNZY7g7WFgraipIDSPkXu4kAb8g8CFJMon6jRztZBQFlFg39zc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE3NAFwFsQYw_Zu2-o8AZqsaB6PfYZ7t_7V-mRl9XGNA&oe=6AFC7A73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1107207795605186", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824671_1107207812271851_4102069106872710207_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiR5Nf1nySYQ7kNvwGVRCYU&_nc_oc=Adr6ztOIu4xG5hhJrM86EHBsAXQAB0BY0hubnzHt2yGhaGv0AcP0b9Ea5wK0QyBMvs8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-pZPD9ta0kNRgwB66zx5d0CQmGiAyrrFCC3NgeyduNA&oe=6AFC66A5"}, "display_name": "Hockey", "keywords": ["hockey", "sports", "multiplayer", "goalie", "puck"], "long_description": "The puck drops. The crowd is on its feet. It is your ice.\n\nREAL STICK, REAL HANDS\nYour hands are hockey gloves and the stick is always in them. Hold it the way you play: right hand on top for a left shot, left hand on top for a right shot, or let the game pick for you. The gloves wrap the shaft naturally, and the blade handles, passes and fires the puck with real physics.\n\nFIVE WAYS TO PLAY\nMATCH: a 3-minute game, Storm against Blaze, with faceoffs, a live scoreboard and a final card. Your AI linemates pass to you and the other side carries, passes, shoots and checks the puck off you.\nSHOOTOUT: five shots against the goalie. He drops into the butterfly, so pick your spot.\nTARGETS: 60 seconds to hit the four corner targets as many times as you can.\nHARDEST SHOT: wind up and let it fly. The radar reads your speed in km/h.\nPRACTICE: free skate with as many pucks as you like.\n\nTHREE LEVELS\nEasy, Pro and All-Star goalies and opponents. Your personal bests are saved.\n\nPLAY ONLINE\nQuick Match finds a game in seconds, or open a private room and share its 4-digit code. Up to 4 players on the ice with a goalie in each net, and optional voice chat. Mute, block and report are always one click away.\n\nTHE ARENA\nA packed bowl of fans, a centre-hung scoreboard, glass, boards and banners, with arena music you can switch or turn off.", "short_description": "Lace up and take the ice in a full-size arena. Real left and right shot sticks, your own gloves as your hands, and a goalie in every net. Play a 3-minute match with AI linemates, a shootout, target practice or the hardest-shot radar, then take it online with friends."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/hockey/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/hockey/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {
achability within your factory or workspace, the app helps you visualize and simulate robotic operations without needing to recreate a digital model of your environment. Discover the power of AR-enhanced robotics visualization and streamline your workflow with ease!", "short_description": "Experience robotics like never before! Use augmented reality to place and control a Universal Robots arm in your own space. Transform any environment into an interactive digital twin, no additional setup required!"}]}, "developer_name": "Ruck Robotics", "developer_privacy_policy_url": "https://ruck.bot/privacy", "developer_terms_of_service_url": "https://ruck.bot/terms", "publisher_name": "Ruck Robotics", "support_website_url": null, "website_url": "https://ruck.bot/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27342429335404218"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75280177_1213958039894048_9002471037011274314_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_O0ud9AKaEQ7kNvwGXXZSD&_nc_oc=AdkTk9Quu33yHm3a09YDD3el2qLXuOWgjlQWWO94VCPrM9t1qq3eGIB4f_8J5i9GMg4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfsTdFco9wVSUg_cWNPZjwjdqF307P86pqEvu8XEG1naTA&oe=69A1A987"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "UR+ AR", "platfo
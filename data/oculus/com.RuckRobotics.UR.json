GTOw&oe=69B2A72D"}, {"file_name": "Screenshot 2024-10-31 at 1.49.37\u202fPM.png", "id": "581881604502955", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974735_581881607836288_7551551924279998606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jsup9rsZsYgQ7kNvwFpTGxx&_nc_oc=AdkR2dhMb6Bx1YUCpJ4EdjzN8fo3rsFaCDg4PTbol6U9xaXkAL_1gJUjBrRdrx4kxlQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwisswBFV--Mxps8qPSzCGhJ2CPHUB2BbR7qal0hJipGg&oe=69B2ACAB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UR+ AR", "keywords": ["robot", "simulator", "automation", "robotics", "ruck"], "long_description": "Bring robotics into your world with our augmented reality app. This innovative tool allows you to digitally position a Universal Robots arm in your real space, seamlessly turning your surroundings into a digital twin. Ideal for testing robot movements and reachability within your factory or workspace, the app helps you visualize and simulate robotic operations without needing to recreate a digital model of your environment. Discover the power of AR-enhanced robotics visualization and streamline your workflow with ease!", "short_description": "Experience robotics like never before! Use augmented reality to place and control a Universal Robots arm in your own space. Transform any environment into an interactive digital twin, no additional setup required!"}]}, "developer_name": "Ruck Robotics", "developer_privacy_policy_url": "https://ruck.bot/privacy", "developer_terms_of_service_url": "https://ruck.bot/terms", "publisher_name": "Ruck Robotics", "support_website_url": null, "website_url": "https://ruck.bot/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_F
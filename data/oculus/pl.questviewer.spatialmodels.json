ed design (1).png", "id": "1792998341948912", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1792998345282245_7788565672407903254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqmWLOtGQJwQ7kNvwG_Xafa&_nc_oc=AdrXHP6lce6kRPSZu_pcKBjitZiXlR0JxTqHCik_TFqTpLkKRo_9yFJUux83Qi2lBfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTpcbn3rYoBsDILfNRzYDQHjde9HCUy5R1F0qZyRvkMA&oe=6AE9F1E1"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFbhjxVPWjAQ7kNvwFZBmmU&_nc_oc=Adp9KfeEQiYsruvkBAbd74ZNYuzf3voAKFhT1op2O7VhbDqI58UWQT8iUtQ2-3EioAM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYwZ9o4-VCIRtfC-oIoZ_qUq-IDnhuBESKSWHCGJXEiQ&oe=6AEA11F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9JPxEq56gcQ7kNvwGXzsLF&_nc_oc=AdrbLdh2MKACPTIpz4P5c_4LLb8Y5LXSck0ld1dSwZ5hEdJWvGfWo4JuaOjlYzlMTyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAruuQIapEREss7m23qtlY4r3cY9y9Q4hv8KsQPsLp7w&oe=6AEA01B2"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://model-xr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Robert \u017buk", "support_website_url": null, "website_url": "https://model-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "de", "fr", "hi", "zh_CN", "es", "tr", "ru", "uk"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134747482821247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823940_1408177341020387_4053521075879204971_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vd2X7ORuSbkQ7kNvwE42ldB&_nc_oc=AdpOkVac4IQYpCZL0Nz5VG_4BhMdV-nxPigQls1QK2xmgIHQvEPRcM9uMt_wz7ht8Kw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ1KATpVBk0YZxS0NIjRpxl6wR0a5Dw3ndD1wqzpI7OQ&oe=6AE9F2D1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Model-XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1790710380, "lastRevision": {"nodes
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPgtSLZ9ps8Q7kNvwFBp1iY&_nc_oc=AdpkAsjyyYtouPXBlNsbTcIxsMOHvLuCoFEW_uXKRhb-5syY516InR9AmaWeN-gDBqY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjXVGctl0MQxKHT5xasxfj4_htEjAlJ_qK3lwcZuAOLQ&oe=6AC3B661"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVoaWr0ClT8Q7kNvwEEH5Hp&_nc_oc=Ado5ee6yRBtI3Eg718iJWv0wZoXl_3Nlc3SQEaBjbkdG2URa8iknki5etWxsE6ymenA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFSSwMGPSMvwMb_nNd6fpQSWyKeMpNkizduWlARfw_bA&oe=6AC3D679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdwVWNcdjnkQ7kNvwHYlocp&_nc_oc=Ado7zyQ5aeGQ9iBFtCcSRBiGjZoffxbWOEBBwLbU6hE2MUbBQ-V3ZpiFxi6NR8xVbGU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxZBOOAwTndMf58eNox8-0eVdAK8Jr9LL5z2qY-DFAdA&oe=6AC3C632"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_pr
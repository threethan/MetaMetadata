&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_gtkldAJAkQ7kNvwFATpgO&_nc_oc=AdpoefYdfMBw1uvoWhUAr962nBhVRWiToYagtsf63Y42DAGR7s3yfo3EtQy5bcRNHuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYNdQbfPScgh99XCYujDiFgu6LdTC1OSr7lTSzNaTBMQ&oe=6ACA4DE1"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxR-b2YjhDEQ7kNvwHtyEou&_nc_oc=Adq0TX10X5-hejdx-2-oLWYNLIcnH0f69TktSInf-O1PacDHSiB_HVToNHcjVjfhOSA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0x6gHtQklToQQgIc95uKAPInd_4VRycNJjjyQZ2Sv4w&oe=6ACA6DF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xf8ScLAf9xQQ7kNvwHPEjPy&_nc_oc=Adp8eFt0Gpmq24hJznag8TniEhLhhfDYLNbFFs12x71jwYkijCKLb-QTxGmm9Bu7_Ds&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN49cqp4uC9DnnuevlNue62181l0lcB3ijegHEpU9yVZw&oe=6ACA5DB2"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_pr
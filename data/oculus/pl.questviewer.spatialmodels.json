&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Cdgf4DVJTAQ7kNvwF9Lw8b&_nc_oc=Adq04DcSTIOo7-J7PGG9zfM4i27WqVu0ZgwOk-bZ5Y7NdwX06I5MTIluB9AYK4-Fjr8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtdde7d_-5ICywqlJw4bZAo3aIuyIjLsmOXdR2cPUXAw&oe=6AC7AAE1"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxR-b2YjhDEQ7kNvwH5TOGP&_nc_oc=AdqrVkENWChjxO8I0EKSTdLOosE8B6I0p_QZ1qZbUQg2UXldPFA_hHFkQ35PKLb9IvI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOt2i7I7cY7mxoW-vcT-SeIzxx-D-hd483mmorkSm0PKA&oe=6AC7CAF9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xf8ScLAf9xQQ7kNvwHp6yRP&_nc_oc=Adq7HI3vgSTZw0qG6gy_3tu2Q3TlhaKsMIkwVauTn6yTmsBoImD3k8bcga-0TphAGWw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoSZq728xdaoYae3K5sSzoMoGYz6BGYBm--CuDvkagNA&oe=6AC7BAB2"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_pr
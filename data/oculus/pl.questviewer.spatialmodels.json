ed design (1).png", "id": "1792998341948912", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821796_1792998345282245_7788565672407903254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y8FHZYRNTSYQ7kNvwFcnxjc&_nc_oc=Adr4frE1tsZicdyAgkC0JI8haAFcPom6u8HKWz--dErF2RGNrwIeajk1NpICldNl7MI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNipBWN3h4ECU1x_uMAmg-u1cE00Ux8KUuhhCQviyqJ8Q&oe=6AE35A61"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kQ3ozn9mpEQ7kNvwF87Fwe&_nc_oc=Adr9ceuKsJOVNIOBOD8SjBMvUBIQeTbOnsXndRRhHHW8ifMaPEx0ar8hXse6KAwdsp4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMT0SxYLVGrtYey--sMBHQymCT51BWohHTxsIbVn2qpnQ&oe=6AE34239"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CV9Gl-LnDdkQ7kNvwEy3Ezl&_nc_oc=AdqaUDXDR5M7-5TVE38mpo5KRFPvCgAkjiTcvRnyJkAGCGmREx3sCF-l9_uLUUwFzac&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNWaVntqeXlFvRKgX3D4k8NB0ZYdpQlLi1yBGzK9AnU0A&oe=6AE36A32"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://model-xr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Robert \u017buk", "support_website_url": null, "website_url": "https://model-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "de", "fr", "hi", "zh_CN", "es", "tr", "ru", "uk"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134747482821247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823940_1408177341020387_4053521075879204971_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTDE5zVvioEQ7kNvwGuP-wP&_nc_oc=Adp0on52tqlThsMkLcIIYfSwfpjaisO5naY2BZ43pB4sndd1CfGrjEZyJE6v-ysULPk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1mSxEfvNqaaNRRHHvKJq8xFqqy_zoAtVUQDnYnXt9Rg&oe=6AE35B51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Model-XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1790710380, "lastRevision": {"nodes
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPgtSLZ9ps8Q7kNvwF5fod6&_nc_oc=AdrbW7bhUIM1CM97030gcQxH1PcdmVfM6gbSftbXK9KmZMS0kO2E0HZ6DKVR0UNFFv0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0_NM25zk301PfWOf1D_FITdmd64AIzYXFiISvA_4IIw&oe=6AC264E1"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gPL3w-TTJrAQ7kNvwERbWQg&_nc_oc=AdrwfpgWJII1s5yd8dpYxfWg09wdXHEa_OKrBx20EJxwUFru1u_w71_GLRFDydVO2jw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9bozXUKSZd9xrx-zeP8NxQ2fBHCUAuxgXirR5pGAkwQ&oe=6AC284F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoG1Nva0nqYQ7kNvwGkToVZ&_nc_oc=AdrFVHrs73UdpaHlxfZEsYCOFVsFOnorwSbScvZUpeEPWvObwga584MBaJey8x5O1OI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNy4xrKq6oJu2aw1fZF0Fpn-s5R-5fmuCQDLcpZkaeKKA&oe=6AC274B2"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_pr
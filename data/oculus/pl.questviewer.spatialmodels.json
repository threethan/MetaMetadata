&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_gtkldAJAkQ7kNvwG-f1DA&_nc_oc=Adq50Y0DnIiqZv8yVBFA5mO1RSrtYvPRVJmyXGI9eCsAlhnfSDU_d4Z81vlfisKpcv8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOR6JVMfr4mMBFK8Hi6wHMB4v5Ot9kz5GXvhvkzq6_7hg&oe=6ACCF0E1"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSZnzIslKRkQ7kNvwFPCub4&_nc_oc=AdqYlVMIhF3Zhjf5fNmGLhIyoLLadbQVLkyrNxymWmXv9lgFA8aHHnTbCO4pSSUQYb4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSccCWwFDqwA5EQOy5e7R8mRMLG3NZ1nc96JJiRIyc6w&oe=6ACD10F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2NuzAdJC88Q7kNvwHqnHkN&_nc_oc=Adqk8R1Vv_14P9_ARNiiNQsYIczSHnOq3MvSeLPJMze2UX49XyHhE2VAuyK6-IygZ40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOec7QGtk-8l8-u9eJgXfVyaOeafaqWD5xBHFdKyeEf8Q&oe=6ACD00B2"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_pr
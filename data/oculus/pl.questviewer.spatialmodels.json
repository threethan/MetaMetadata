&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Cdgf4DVJTAQ7kNvwERebE6&_nc_oc=AdoVAEac3jw7YOX_lPuQWu6I-lit2NDUwHOKHwqFh3RRHPOw5jyicg2Dy6DrjWH4q9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMgkVUyJ3eQ0HohslcmoU608isqWhWDyPJI-tNbw8XHg&oe=6AC65961"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVoaWr0ClT8Q7kNvwGHgck0&_nc_oc=AdqWOGEi3NQ-Zdz0qysW2Ahz-3EZUa4wt8r_XVTHNML-9uzcUO_9qMMfMJVbeGTYpkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsViHZiIUdmPe6iJRi4fzMTgs-k6W96Z4wREKBIx6aTQ&oe=6AC64139"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdwVWNcdjnkQ7kNvwGXzw-p&_nc_oc=Adq5zdQAmrtTwPU-zOV5LC9ZtuKS9lXi_lMOUfNbLLoSE5IJuUNQ5QYBO2MK4PKv5bI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA6iiRZjp0zQMKfV8lb70HI5jAbrxa8iGpxTjgyw1-Bw&oe=6AC66932"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_pr
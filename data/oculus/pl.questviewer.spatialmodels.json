 model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://model-xr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Robert \u017buk", "support_website_url": null, "website_url": "https://model-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "de", "fr", "hi", "zh_CN", "es", "tr", "ru", "uk"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1108299008799428"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1292107539592048"}]}, "baseline_offer": {"id": "1292107539592048"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790710380, "status": "PUBLISHED", "id": "1292107539592048"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1108302292132433", "version": "0.1.46"}, "id": "1111032544934882", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1095280893434573", "
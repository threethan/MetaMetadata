&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fE3zedHEa3cQ7kNvwEEL2om&_nc_oc=Adoj95XtnQCY_7TbIVsA6Jvz_QEzBmF3AfEG6qrIf0OF0v5fO0CJGSJLIXd69K0U-n0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVjB6_MMFGhz8bdtZA0B7FfcB03CUM2PCuCXEDd0E97w&oe=6AD0E561"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd4b-2weRCEQ7kNvwGo98lK&_nc_oc=Adqk1Q7kpR_tO8TcdUgEuMYhNrvgeuomGO3J_z9aQZ-BkuJArXX0ixp_Dzbzi4Hb1GI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQON_7mL0VHGF9fYVLzEuOmZEdisXRS9CFY7c6OBmvL2HQ&oe=6AD10579"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0AIA3Fwt6G8Q7kNvwHVK_92&_nc_oc=AdrzwHBr-F21VO0QtdbfKXiyJRM-BFCtbM2b2OB6NmzcJCqfGY8pNQCAEkNCB8Bpbi0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM18PBLpqG_B8daOQha8X6FiN4Q1jJIsLwwHzHq3huUIw&oe=6AD0F532"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_pr
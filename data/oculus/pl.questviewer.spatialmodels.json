985889_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd3HCnKS07oQ7kNvwGNHCnu&_nc_oc=Adqq4annYYSjMjqZ6pshN2CpXi-V7gqbGelIKxIj9jzmqCk441Ciz2RC6gwtK5uGaD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiplQHsjo30KZOCbDtsnV9g2dVS0Ult8emQs5X2p6YuA&oe=6AEDDED6"}, {"file_name": "Untitled design (1).png", "id": "1792998341948912", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1792998345282245_7788565672407903254_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jqu_F6Il-30Q7kNvwFklgKx&_nc_oc=Adqg57SSKbIrsYZ1D79_NhW0G2vYy4OyumLQM3YCbh-XsC8KbNMV_7uI6HG55ywcT6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmTwIYMJTsefEZznPCnfQoSP1RrlanQZryCuFThxYh2Q&oe=6AEDE661"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwMf2zjPSKwQ7kNvwGBB5cD&_nc_oc=AdpsP2KIVuq8PejCdqqPvr8mEmYxWYFz2oL0Ep96Btpu-L1GiMGzEVU4UkkN40DPjZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg8rcZYO3vUdcCW0cJxuYXPfyq3FPiSpXEGJRAXDxlMw&oe=6AEE0679"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVfHXVHqmBQQ7kNvwGTQSZ0&_nc_oc=AdoZ8n0pyitF245s5nbtmMBcaBsBfuS1deJTySol7NnFipayZhExT2HeL1Ffn4Te3dY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3ToZnjqlzrSO34oZAp-oeavnyxMAOq8xRaTa5UpQHHg&oe=6AEDF632"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://model-xr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Robert \u017buk", "support_website_url": null, "website_url": "https://model-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "de", "fr", "hi", "zh_CN", "es", "tr", "ru", "uk"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1108299008799428"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1292107539592048"}]}, "baseline_offer": {"id": "1292107539592048"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790710380, "status": "PUBLISHED", "id": "1292107539592048"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1134677216161607", "version": "0.2.1"}, "id": "1111032544934882", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1095280893434573", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1134677216161607"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1111032544934882"}]}, "change_log": "Open 3D files from compatible file managers using Model-XR. Supported formats: STL, OBJ, ZIP, USDZ, GLB, FBX, STEP, STP, BLEND and MXRP. Each external file opens in a separate temporary preview, with Return to scene restoring your previous workspace. This release also improves external-file imports and model interaction, updates application branding, and shows the app version in Settings. File associations require one-time configuration in a compatible file manager. Opening behavior in the built-in Meta Files app depends on the headset software.", "created_date": 1792857848, "id": "1134677216161607", "version": "0.2.1", "version_code": 79, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1095280893434573", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1134677216161607"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1111032544934882"}]}, "change_log": "- Redesigned Tools panel with independently movable tool windows.\r\n- Optional model simplification to reduce rendering load while retaining supported colours, textures and parts. Original files stay unchanged.\r\n- Lighter STEP/STP import for large CAD models.\r\n- Expanded support for saved material colours, vertex colours and base-colour textures across supported formats.\r\n- Improved rendering performance and transparency, including complex models with many parts.\r\n- Remove individual scene models with the trash icon beside each item.\r\n- Fixed the placement of newly imported and simplified models.\r\n- Added a Settings gear icon and the current app version in Settings.", "created_date": 1792589375, "id": "1131708823125113", "version": "0.2.0", "version_code": 73, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1095280893434573", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1134677216161607"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1111032544934882"}]}, "change_log": "- View up to 8 models together with multi-file import.\r\n- Import larger files, up to 256 MiB each.\r\n- Position a movable protractor with a grid and 10-degree guide lines.\r\n- Export scenes as GLB and save PNG images without menus.\r\n- Added PNG/JPEG colour texture support for GLB and OBJ ZIP packages.\r\n- Keep textures when adjusting visibility, reopening scenes and exporting GLB.\r\n- Improved texture memory management and resource cleanup after import errors.", "created_date": 1792248123, "id": "1127912936838035", "version": "0.1.48", "version_code": 49, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1095280893434573", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1134677216161607"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1111032544934882"}]}, "change_log": "New in Model-XR:\\n- Import and arrange up to 8 models in one scene.\\n- Add a movable protractor with angle guides and an optional grid.\\n- Export your arranged scene as a GLB file.\\n- Save PNG images without menus.\\n- Import larger files, up to 256 MB each.\\n- Improved model importing, scene controls and interface.", "created_date": 1792240343, "id": "1127808200181842", "version": "0.1.47", "version_code": 48, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1095280893434573", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1134677216161607"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1111032544934882"}]}, "change_log": null, "created_date": 1790509872, "id": "1108302292132433", "version": "0.1.46", "version_code": 47, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
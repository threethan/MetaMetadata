&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_gtkldAJAkQ7kNvwFAQDpa&_nc_oc=AdpVezNxDAMIcJtikxgIIgmYHFqU71Vm6RZLgRtYs-qHY0OVLBoqPJpsulDLxIxhg-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMm7YCfVa_A0BeFzUwfAua9nQPKJyX1NOdFRtwkeOsuRQ&oe=6ACB9F61"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSZnzIslKRkQ7kNvwFIzQWa&_nc_oc=Adp4XqNamz_pFpWy1KnLmiQB_PhZKq_3rXZmWPS1kQiXVOFS8VaakjRiswmL2Ed_kJ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_dtlPPEkopfi9VL1TZZvCCm4hmoOXi5Zz4UrhG6ELdA&oe=6ACBBF79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2NuzAdJC88Q7kNvwHk0g9J&_nc_oc=Adq1eC95lsQ9OHiyRc7rOC7bf4av3CjxPNUFLQ4akGrJzcZ6BvTh9-GMcIgtreNItik&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0EsGF9bvD4QctzX2DiN3oHaV76qsxqDPwhLvpRMwmPA&oe=6ACBAF32"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_pr
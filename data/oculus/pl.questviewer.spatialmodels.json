&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMmh309DWbcQ7kNvwHceZ8B&_nc_oc=AdoVk9JHBCja_qDPzTTKBXhEK0NbLy_4xFs1tRlpAYjJLYllVYR-1K5f2K6XGW_gYf4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_f3rUmAZRcrVDEUl7PqQwyCUNBhsE70ntTisTsP8rbA&oe=6AD38861"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G5GPyFidIawQ7kNvwGwAa-I&_nc_oc=AdrTrDB5ouJvVUSBmb_qcGxER38SxvMNp-aYP0H0LUjoDY-8OLa5Jr0MBlBYqJUyU7o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5dAM7l1qFLuNQxdZJi1JRxtyOOC62uSZ3suGD4Wg94Q&oe=6AD3A879"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZCYFxF6Q-EQ7kNvwHPXZwj&_nc_oc=Ado7Y1Fkc2SB0Ux8OhDhhgcRnjfU57Z4vzEnCA168nWqvH3KgdA1YjHjmQy3k3MkjtU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoS_SfuQ85nKo7Jv5LqKtQj-ViKfn7b7yTtv7jron1aA&oe=6AD39832"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_pr
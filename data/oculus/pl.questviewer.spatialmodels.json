&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Cdgf4DVJTAQ7kNvwEBIkfs&_nc_oc=AdpFsxl8w6EqnulPCxEODZpSdSZRhXHwA0A6cUJPfKJGiwpDGVu6CC6Knx3iNoxhXnk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVb8qQ53Z8tRx3T6tEYcLsqjxva6hKsWtU3NscuK-o-g&oe=6AC8FC61"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CxR-b2YjhDEQ7kNvwHbJzrE&_nc_oc=Adq5QLH8XmTnwQhtkJG4vCkWdjNzE_F43k7uxcmOBfeMKJQ0hJM2hWw4oLkggRKhMYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6XKev49EtsHj0ohW-DumZusIhNIrJRWge6PLP_QASWA&oe=6AC91C79"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xf8ScLAf9xQQ7kNvwEEBK0A&_nc_oc=AdrGkwgy01Dy2p5Vtc24-k84yGHKu8vskzRc0MDYrLY__isssTLlj-no7hsBZM4oPtQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqm3AIVCXIjoUSOs6155LlrRaJDsUCvhP5wvrfL9ET0A&oe=6AC90C32"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_pr
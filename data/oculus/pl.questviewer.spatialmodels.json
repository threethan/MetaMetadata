nconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_privacy_policy_url": "https://model-xr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Robert \u017buk", "support_website_url": null, "website_url": "https://model-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pl", "de", "fr", "hi", "zh_CN", "es", "tr", "ru", "uk"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134747482821247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823940_1408177341020387_4053521075879204971_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yy5XA8cXzr8Q7kNvwEdl_BG&_nc_oc=AdqUCz9XfO81JMU0FdsWUfNZK4Za-Z3ZEEUyQwvBgDbPi-Wi3jG-Rl7C6Gx3ryWTNjI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVV0oHtsbL_jgsOrhOKTnaFHAsDd5A_2qoghzKy9MYKw&oe=6AF08A51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Model-XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1790710380, "lastRevision": {"nodes
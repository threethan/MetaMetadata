&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPgtSLZ9ps8Q7kNvwF6strk&_nc_oc=AdoAKXyr7oiF8tePcEVnLWUpWw72ufbSD8JTJdj9N66XT-uMNvaA6zMF2bBatXZWGyw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAUZ443oFWwtBdqLDjR3ixewWyR1GKQxDyWTwho_XILQ&oe=6AC507E1"}, {"file_name": "Untitled design (2).png", "id": "1627727228741703", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823757_1627727235408369_6773464555518237612_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVoaWr0ClT8Q7kNvwFkNphi&_nc_oc=Adprh1Gb8-2ISg1lXcOIl4w3Y_ARhQptNQpxZp8hjSzK5-K1ewBOoT3Rql8_UuqOcdQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6V6mMojfRpu8JdffF9Mh_4C9ZPe257a7aFooGjxHG7g&oe=6AC527F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Projekt bez nazwy (6).png", "id": "844928528641586", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823905_844928531974919_5720944482484312447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdwVWNcdjnkQ7kNvwF6k5fc&_nc_oc=AdolHZXHPuGNIEgg6fcdFjJrsVMj_PRDTjujZPiXAHYkIwUQjvTFwa3BHv0M7NIihPg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5MpjXgrx9eQxOW3PKkGyvDA8OxTwCHPBrkI1YbP81Dg&oe=6AC517B2"}, "display_name": "Model-XR", "keywords": ["VR", "MR", "XR", "3Dfiles", "viewer"], "long_description": "A simple, free 3D file viewer that lets you open files directly from your device\u2019s storage.\n\nSupported formats: STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND.\n\nAvailable model controls:\n- Move the model in 3D space\n- Rotate the model\n- Scale the model\n- Separate the model into individual components, if the file contains multiple objects\n- Adjust the transparency of the entire model or individual components\n\nThe app is still under development, so you may occasionally encounter bugs. We apologize for any inconvenience.", "short_description": "Simple, free 3D file viewer supporting STL, OBJ, USDZ, GLB, FBX, STEP, and BLEND formats."}]}, "developer_name": null, "developer_pr
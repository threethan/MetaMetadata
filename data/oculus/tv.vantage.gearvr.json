content-ord5-1.oculuscdn.com&oh=00_AfuoJDtYPs9qKQ48SmIiavRDupz6QrU9QQJFNf-r4EPDFg&oe=699C63BA"}, {"file_name": "migrated_image.png", "id": "200313047868487", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386392_187042695045902_2100765383_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToNIcwm8LDIQ7kNvwFmKKvw&_nc_oc=AdnCn8DPtkPHD1SzvGaahgja6mcuE1nnbMU2oppich1Ag4rVK9s3667b95kfR_dj03E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvtB-EXtQl3c7V-1O1rnohSJkbN3GzECYhVdHwmoNgm8A&oe=699C4F0B"}, {"file_name": "migrated_image.png", "id": "206026903952195", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138831_1236804676353862_1061102770_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmpqnpxGhEoQ7kNvwGWJCT9&_nc_oc=Adl2T92o_yjge_G-ScUPJtSxcblSxB2dYzpvPwWaR5gZpTOKvE1KdXM7ApA_bZ0h7AQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftlL5qbWiEsObGf8upSn8j6k5z3bZCY3v_5I3BG4uqSsQ&oe=699C5883"}, {"file_name": "migrated_image.png", "id": "3590217517718783", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386183_1737734396482113_1602703431_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJVegMoKaTwQ7kNvwHdjlq7&_nc_oc=AdkNqWAsiLpGOlBPt52ZUnXi9LMcXAVtb78xqDsnBG-wyaUlxqNxzQye78O2MxeTkzM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftfDtc2-Nztvf5YB515BujGDRURXpb-KvM2k6b_3-MioA&oe=699C441D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "vantage.tv", "keywords": ["virtual", "music", "vr", "church", "stagecoach"], "long_description": "Discover the magic of virtual reality! Enjoy an experience unlike any other as you become immersed in live events all from the comfort of your own home. Don't watch, be there with vantage.tv!\n\nOur first concert release comes from Eric Church's incredible set as he headlined country music's premiere festival, Stagecoach, in April 2016. Closing down day one of the festival he performed hit after hit, keeping the crowd rocking all night long. \n\nAdditional content will roll out in the near future so follow us on social media or sign up for our newsletter at vantage.tv to stay updated!\n\nQuestions? Email us at support@vantage.tv", "short_description": "Let vantage.tv teleport you to your favorite concerts and live events in virtual reality anywhere in the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vantage.tv/privacy.html", "developer_terms_of_service_url": "https://vantage.tv/terms.html", "publisher_name": "vantage.tv, Inc", "support_website_url": null, "website_url": "http://vantage.tv/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC_VIDEO", "SOCIAL", "MUSIC", "MOVIE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "513160980133220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331199_1807000942894364_4661591511182344192_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E333zJDBfUIQ7kNvwFUdKHU&_nc_oc=Adm6xlLWZ8EiHDQ_bPJVcaizSgyNhVmZl9qrvmgC4a-vmkLhZo_Nvs8h38AKHGFiVeI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuZsvXrvhvoRU0PlpG2I6Sz2JX7-GAovpv4r5zd7K66SQ&oe=699C5941"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "vantage.tv", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1485967633, "lastRevision": {"nodes": [{"id": "1200844769947464", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_
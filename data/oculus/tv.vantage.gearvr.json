. Don't watch, be there with vantage.tv!\n\nOur first concert release comes from Eric Church's incredible set as he headlined country music's premiere festival, Stagecoach, in April 2016. Closing down day one of the festival he performed hit after hit, keeping the crowd rocking all night long. \n\nAdditional content will roll out in the near future so follow us on social media or sign up for our newsletter at vantage.tv to stay updated!\n\nQuestions? Email us at support@vantage.tv", "short_description": "Let vantage.tv teleport you to your favorite concerts and live events in virtual reality anywhere in the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vantage.tv/privacy.html", "developer_terms_of_service_url": "https://vantage.tv/terms.html", "publisher_name": "vantage.tv, Inc", "support_website_url": null, "website_url": "http://vantage.tv/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC_VIDEO", "SOCIAL", "MUSIC", "MOVIE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "513160980133220"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "215529252233805"}]}, "baseline_offer": {"id": "215529252233805"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1485972000, "status": "PUBLISHED", "id": "215529252233805"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1247768011937629", "version": "1.2.17"}, "id": "206296709770089", "channel_name": "LIVE"}]}, "
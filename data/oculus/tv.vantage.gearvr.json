gecoach, in April 2016. Closing down day one of the festival he performed hit after hit, keeping the crowd rocking all night long. \n\nAdditional content will roll out in the near future so follow us on social media or sign up for our newsletter at vantage.tv to stay updated!\n\nQuestions? Email us at support@vantage.tv", "short_description": "Let vantage.tv teleport you to your favorite concerts and live events in virtual reality anywhere in the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vantage.tv/privacy.html", "developer_terms_of_service_url": "https://vantage.tv/terms.html", "publisher_name": "vantage.tv, Inc", "support_website_url": null, "website_url": "http://vantage.tv/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC_VIDEO", "SOCIAL", "MUSIC", "MOVIE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "513160980133220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12331199_1807000942894364_4661591511182344192_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5Va-i_-wjIQ7kNvwGa2dLY&_nc_oc=AdoyTNh8ztJySTYoEvCD9paoCKi19W4YrwSsCheIUVtFtzU4m9aTMwBrxzx0F_0SpEQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kL_jyZD4IZiqQ1ppyihG4TQb_E0NMgyPlRMbdvFfHvQ&oe=69E77EC1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "vantage.tv", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1485967633, "lastR
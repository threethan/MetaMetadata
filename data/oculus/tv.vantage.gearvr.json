re festival, Stagecoach, in April 2016. Closing down day one of the festival he performed hit after hit, keeping the crowd rocking all night long. \n\nAdditional content will roll out in the near future so follow us on social media or sign up for our newsletter at vantage.tv to stay updated!\n\nQuestions? Email us at support@vantage.tv", "short_description": "Let vantage.tv teleport you to your favorite concerts and live events in virtual reality anywhere in the world!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vantage.tv/privacy.html", "developer_terms_of_service_url": "https://vantage.tv/terms.html", "publisher_name": "vantage.tv, Inc", "support_website_url": null, "website_url": "http://vantage.tv/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC_VIDEO", "SOCIAL", "MUSIC", "MOVIE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "513160980133220"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12331199_1807000942894364_4661591511182344192_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_la2KdrxU4Q7kNvwF-zvj4&_nc_oc=Adp-jJ3y4Tq_8S6kyfb2nzjwvLHDFgRKHLv8oY16dr3ipwFhPSHuW4VRwu4m8eb7DOo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMBUZK1TV0ET8fcXAaCwKLM7KU9AP9mVypYVTNqRoDOw&oe=6A8EED41"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "vantage.tv", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 14
J_gCmykby6Y4hQRewgdOIWiQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTOEhiHXbCJ5pa_b8PC6pJ1cdWnySTi77Zsto5SuDeeg&oe=6AFF04E0"}, {"file_name": "D&I_Screenshot5.png", "id": "193828955818443", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982563_193828959151776_1654441374563020490_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWgKcfaB37AQ7kNvwHgg_It&_nc_oc=AdqtxI5DBQeEYilJOAifcdJkx40vWhlgDBAQX4wH73fit9kqME4guKm4Crm_39T6siU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzslaDpj1Qz3EyBUM5s3BeEWE4gJh6-n52ZWoXPRRvaA&oe=6AFF143A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "D&I_Screenshot4.png", "id": "327494312016170", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982584_327494315349503_8135360788380721258_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZ1mccbTOaAQ7kNvwFX0Lac&_nc_oc=AdpNI99WUKvY-hOQZio3yGMHici_qQv5VyhXmb-8azNQUo450DRipAO1WYA6_A9LL_A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThq-2BKuEYH2xw7Nekv-Yl3lePO9FQa_R8J2xk9Y_z9A&oe=6AFF0F21"}, "display_name": "D&I Perspectives", "keywords": [], "long_description": "In this experience you\u2019ll see the world through another person\u2019s eyes. But who are you?\n\nYou\u2019ll move across the office to get to your next meeting on time. As you go people\u2019s reactions to you, will give you clues as to who you are.\n\nExperience four authentic stories of everyday people who face challenges we\u2019re often unaware of. Come away with a better understanding of the daily challenges the people around us face and how the little things we do can make a big difference.\n\nDiversity brings strength, not just by creating a better work environment for employees but benefitting businesses as a whole.\n\nWith D&I Perspectives you will:\n\u2022\tExperience valuable and effecting personal stories\n\u2022\tReveal and explore microaggressions within the workplace\n\u2022\tBuild awareness is a truly memorable way", "short_description": "Experience four authentic stories of everyday people. Come away with a better understanding of the daily challenges the people around us face.\n\nDiversity brings strength, not just by creating a better work environment for employees but benefitting businesses as a whole.\n\nWith D&I Perspectives you will:\n\u2022\tExperience valuable and effecting personal stories\n\u2022\tReveal and explore microaggressions within the workplace\n\u2022\tBuild awareness is a truly memorable way"}]}, "developer_name": null, "developer_privacy_policy_url": "https://makereal.co.uk/privacy-policy-di-perspectives/", "developer_terms_of_service_url": "https://makereal.co.uk/terms-conditions-di-perspectives/", "publisher_name": "Make Real Ltd", "support_website_url": "https://makereal.co.uk/", "website_url": "https://makereal.co.uk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "363190821918353"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "236980868497768"}, {"status": "PUBLISHED", "id": "201096991541647"}]}, "baseline_offer": {"id": "236980868497768"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1635876840, "status": "PUBLISHED", "id": "236980868497768"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
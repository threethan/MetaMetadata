zArU3eHu2-TnJ440m9rx8s2lZgVT_xNnc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7-5ukA7J9jmuncssKxBtu5bFxvLgcjXncGb7m6_lGEQ&oe=6A8D7AFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "D&I_Screenshot4.png", "id": "327494312016170", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982584_327494315349503_8135360788380721258_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i2mjH1k9wogQ7kNvwHuJ5lp&_nc_oc=AdpGHSROurjtiolHWLjQmR1bJp4nO6XuuYohi7hsvsnmmubkUM9-fF-JZPmpLMXeGBY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-3WbmD-2-For33EAHJv-0QiVUKtRJaWRQRWf7pmivDQ&oe=6A8D75E1"}, "display_name": "D&I Perspectives", "keywords": [], "long_description": "In this experience you\u2019ll see the world through another person\u2019s eyes. But who are you?\n\nYou\u2019ll move across the office to get to your next meeting on time. As you go people\u2019s reactions to you, will give you clues as to who you are.\n\nExperience four authentic stories of everyday people who face challenges we\u2019re often unaware of. Come away with a better understanding of the daily challenges the people around us face and how the little things we do can make a big difference.\n\nDiversity brings strength, not just by creating a better work environment for employees but benefitting businesses as a whole.\n\nWith D&I Perspectives you will:\n\u2022\tExperience valuable and effecting personal stories\n\u2022\tReveal and explore microaggressions within the workplace\n\u2022\tBuild awareness is a truly memorable way", "short_description": "Experience four authentic stories of everyday people. Come away with a better understanding of the daily challenges the people around us face.\n\nDiversity brings strength, not just by creating a better work environment for employees but benefitting businesses as a whole.\n\nWith D&I Perspectives you will:\n\u2022\tExperience valuable and effecting personal stories\n\u2022\tReveal and explore microaggressions within the workplace\n\u2022\tBuild awareness is a truly memorable way"}]}, "developer_name": null, "developer_privacy_policy_url": "https://makereal.co.uk/privacy-policy-di-perspectives/", "developer_terms_of_service_url": "https://makereal.co.uk/terms-conditions-di-perspectives/", "publisher_name": "Make Real Ltd", "support_website_url": "https://makereal.co.uk/d-and-i-support/", "website_url": "https://makereal.co.uk/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1315557385523947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982526_192948232581715_2273745999946267764_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYScOk4lzVMQ7kNvwEdQR11&_nc_oc=AdpZ4WBY-6D2SiIutNlxsd-j0yfs3e2CHyYSNKUpYEM9sOnGjhwATHulYOdRqCkdliY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5yueHEej6RfHAby-f0ztubnEedHnfKy_ndN4aJNw8VQ&oe=6A8D8A93"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "D&I Perspectives", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1618460261, "lastRevision": {"nodes": [{"id": "3701317859944411", "release_type": "S
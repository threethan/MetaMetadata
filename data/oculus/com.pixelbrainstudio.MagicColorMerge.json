00_Afw3hmOMMVdIqsLwtsQ87UyU8rbvLuNInZ1uCFNWK_Ea8A&oe=69B80651"}, {"file_name": "2.png", "id": "1193217265911732", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828899_1193217269245065_6881849521715644125_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_fcHsHRPvwQ7kNvwGr8kRk&_nc_oc=Adk70PwC-fIPkv6royxMyIzfX5KQQOaIZziPXx5LTUizZQpSFXnpw298ZYZ16ocggQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwLRAWPi2XXshXIVCP9TekIZc90j4Htoct3RFMzFyf0EA&oe=69B7DE65"}, {"file_name": "5.png", "id": "635809706292149", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312257_635809709625482_8859423125390814773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWVG-2R-9CIQ7kNvwEAbCgP&_nc_oc=AdlHDgl_z6XS-lbfyZHPgitI9xv81X9j7zlyadLyHl39V_C9vn4np9rtC2OKldxP3GI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzo53Yov-nN57DkAThG8iCK-c6Q9lsDOg204vZLskeJuw&oe=69B81408"}, {"file_name": "6.png", "id": "1009361684509173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617769_1009361687842506_905219570959848276_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ICg4-sx7cYQ7kNvwEVphhI&_nc_oc=AdkINUIqgRBCt1nw6kvju-JjGDEOJ_ZTMG10xVZhUDmIpglgecQflJ8fD4JiBfxkuOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx_hwnZmOeB2Mg9_CF0L6pOFtG-X9Ly7I3Wj8lye7qJOQ&oe=69B81529"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCover2560x1440.png", "id": "1158389738944880", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391888_1158389745611546_7143061330447314823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTyjwLD6KrEQ7kNvwHQoL6n&_nc_oc=Adki1PkgePIEhVhhAHYZb7sy4GFvBfutId22x03bh7nhcwMUKaVO1iU7XPSIKxg7g8E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyiVIGchubqLtQXFXZ0d9tToiUngUwcrDuKVuBduBm_vg&oe=69B7F5DB"}, "display_name": "Magic Color Merge Puzzle", "keywords": ["color", "sort", "sorting", "logical", "merge"], "long_description": "Magic Color Merge Puzzle reimagines the classic color sort genre with a stunning, immersive twist. Whether you prefer the ease of traditional clicks or the tactile thrill of pouring vibrant liquids by hand, this game lets you play your way - just like handling the real thing! But be careful\u2026 drop a bottle, and you might be in for a cleanup!\n\nJourney through increasingly challenging levels that test your logic and creativity. Earn crystals as rewards, then use them to research and craft a magical potion series\u2014your ultimate goal! Completing potion sets unlocks powerful boosters like double XP, extra tubes, and more.\n\nEnjoy three new daily challenges every day for extra rewards and a fresh gameplay twist.\n\nWant to experiment freely? Create your own custom games by choosing the number of tubes, colors, and game modes\u2014perfect for strategizing or just relaxing fun.\n\nCustomize your experience with different liquid styles (normal, minimal bubbles, or color-only) and tube designs (reflective or classic). All set to a selection of varied music tracks that evolve with your journey.\n\nReady to pour, sort, and craft your way to magical mastery?", "short_description": "Magic Color Merge Puzzle blends classic color sorting with a magical twist. Pour vibrant liquids your way - click or drag by hand! Complete levels to earn crystals and craft powerful magic potions. Two games in one: solve puzzles and become a master alchemist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pixelbrainstudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelbrain Studio", "support_website_url": "http://www.pixelbrainstudio.com/support", "website_url": "http://www.pixelbrainstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "extern
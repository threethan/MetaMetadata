ntent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgvKJjrToSWimukbUEqxDvI048Ig5rI-OYqSSoZ38Q5A&oe=69C929F2"}, {"file_name": "1 - Copy.png", "id": "2095103704619805", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820923_2095103711286471_467057055026642363_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ldN0pFbwZgQ7kNvwF32zNt&_nc_oc=AdpH6wXdlEQ4ERgszh34fUGYHNttWIFd3hwnWIPNP9X3k30w3INrSkF-mJvwQDrO_Ck&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwN61QLNxiUUXMcOYjLnELn-R9jpvYa2Gxf0v24-2paZg&oe=69C928A5"}, {"file_name": "5 - Copy.png", "id": "1608465590392110", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828050_1608465593725443_1133905706281928396_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5eI-k1Ql0IQ7kNvwHdbyqz&_nc_oc=AdrmAF_ZAmxV9xOG7Qg27kZvK-qfbM8wgba0Kii8Wc6eGjkKXwKGGNq-me3a9-9rjhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDOFOmhncdg0xeO7ax1C9Nkf1Btyk4vOsTJQOYWMorUA&oe=69C91666"}, {"file_name": "6.png", "id": "1009361684509173", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617769_1009361687842506_905219570959848276_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRknNhlHafkQ7kNvwF74RSn&_nc_oc=AdrtjhAwPfnzrVHW8QVBphKjUMChO1gIVgClqyUy5dIrdhuYwljU97cNqMARNAIaVrA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvMuJY6Bdi0G86UpxK8s-P8cpEICTPNqO3nD-dWs66Vg&oe=69C938A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCover2560x1440.png", "id": "1158389738944880", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_1158389745611546_7143061330447314823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUKum5aE7w4Q7kNvwGRCHJj&_nc_oc=Adqp6JFzE2IvZ_6MI15a7cLLmexPyoObJ_RWiAy7uySOXvzdVDz1xMO3K9gS015KhF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwu9zlqyGR2Sq-QFXuSq_5WIcfYl-dkuZZaNkVCE3yrHA&oe=69C9195B"}, "display_name": "Magic Color Merge Puzzle", "keywords": ["color", "sort", "sorting", "logical", "merge"], "long_description": "Magic Color Merge Puzzle reimagines the classic color sort genre with a stunning, immersive twist. Whether you prefer the ease of traditional clicks or the tactile thrill of pouring vibrant liquids by hand, this game lets you play your way - just like handling the real thing! But be careful\u2026 drop a bottle, and you might be in for a cleanup!\n\nJourney through increasingly challenging levels that test your logic and creativity. Earn crystals as rewards, then use them to research and craft a magical potion series - your ultimate goal! Completing potion sets unlocks powerful boosters like double XP, extra tubes, and more.\n\nEnjoy three new daily challenges every day for extra rewards and a fresh gameplay twist.\n\nWant to experiment freely? Create your own custom games by choosing the number of tubes, colors, and game modes - perfect for strategizing or just relaxing fun.\n\nCustomize your experience with different liquid styles (normal, minimal bubbles, or color-only) and tube designs (reflective or classic). All set to a selection of varied music tracks that evolve with your journey.\n\nReady to pour, sort, and craft your way to magical mastery?\n{937708515466659}", "short_description": "Magic Color Merge Puzzle blends classic color sorting with a magical twist. Pour vibrant liquids your way - click or drag by hand! Complete levels to earn crystals and craft powerful magic potions. Two games in one: solve puzzles and become a master alchemist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pixelbrainstudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelbrain Studio", "support_website_url": "http://www.pixelbrainstudio.com/support", "website_url": "http://www.pixelbrainstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
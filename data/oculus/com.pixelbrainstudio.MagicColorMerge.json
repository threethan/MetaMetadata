ntent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3i6oGaIKqGA-z8OG76vO2fYHKshA4gm8tVyIphNdKiow&oe=69DA4D72"}, {"file_name": "1 - Copy.png", "id": "2095103704619805", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_2095103711286471_467057055026642363_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCxAH-am4GEQ7kNvwGTEnI9&_nc_oc=AdrGr8L3pMiltU44fpO-24aqek3NHwNkpZ7BdOU6zQ1_M0m4cZLi2YZb5o4GifzNx7I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-p62prMMD0hnkSr1yunTZGVmsIOm428kAEvL30LIa1A&oe=69DA4C25"}, {"file_name": "5 - Copy.png", "id": "1608465590392110", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828050_1608465593725443_1133905706281928396_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkChWnWT7ogQ7kNvwEl4zkb&_nc_oc=AdqYsZdQrNBSwZYpOdBBJ_JYTKYlmY-HdrDxws7WAGX-ynq2MbYSfk5OdvTX9aizpHI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2oj-T-WvNOQE9d0MJMfqWhr3h1lDVCI8rmIoGRdVawbQ&oe=69DA39E6"}, {"file_name": "6.png", "id": "1009361684509173", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617769_1009361687842506_905219570959848276_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqpAc9e-eBkQ7kNvwFHHC-h&_nc_oc=Adrwz4Iyjoz_XPpEP-WHMZ8eQu2pQGu94w2B6JokCKfcg_XELO7_vSltAtHY2b4cGdg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07-yGpGwwReWs5jIDit62RGC6l-VMCvhPeWlzEfZOfBA&oe=69DA5C29"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCover2560x1440.png", "id": "1158389738944880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391888_1158389745611546_7143061330447314823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8amYCIQTpsEQ7kNvwF9izXh&_nc_oc=AdqI_QpimagFJOS-9MFEtpAp33-r59XVV97nMpU2T_7ffmlpy7nQ7pPP1-DF47Fou7I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1b2NIjjf71RkRnaeU9XCDFhMfUgVymVgTS8fgcSEVuRg&oe=69DA3CDB"}, "display_name": "Magic Color Merge Puzzle", "keywords": ["color", "sort", "sorting", "logical", "merge"], "long_description": "Magic Color Merge Puzzle reimagines the classic color sort genre with a stunning, immersive twist. Whether you prefer the ease of traditional clicks or the tactile thrill of pouring vibrant liquids by hand, this game lets you play your way - just like handling the real thing! But be careful\u2026 drop a bottle, and you might be in for a cleanup!\n\nJourney through increasingly challenging levels that test your logic and creativity. Earn crystals as rewards, then use them to research and craft a magical potion series - your ultimate goal! Completing potion sets unlocks powerful boosters like double XP, extra tubes, and more.\n\nEnjoy three new daily challenges every day for extra rewards and a fresh gameplay twist.\n\nWant to experiment freely? Create your own custom games by choosing the number of tubes, colors, and game modes - perfect for strategizing or just relaxing fun.\n\nCustomize your experience with different liquid styles (normal, minimal bubbles, or color-only) and tube designs (reflective or classic). All set to a selection of varied music tracks that evolve with your journey.\n\nReady to pour, sort, and craft your way to magical mastery?\n{937708515466659}", "short_description": "Magic Color Merge Puzzle blends classic color sorting with a magical twist. Pour vibrant liquids your way - click or drag by hand! Complete levels to earn crystals and craft powerful magic potions. Two games in one: solve puzzles and become a master alchemist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pixelbrainstudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelbrain Studio", "support_website_url": "http://www.pixelbrainstudio.com/support", "website_url": "http://www.pixelbrainstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
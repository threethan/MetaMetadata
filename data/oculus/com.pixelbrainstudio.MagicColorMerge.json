00_Afxu3o1OAsoC--nVN2bc72xhPbReJV3j1eUU4wrO5y0QMg&oe=69B16ED1"}, {"file_name": "2.png", "id": "1193217265911732", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828899_1193217269245065_6881849521715644125_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbmx2sx_srUQ7kNvwGVmk00&_nc_oc=AdlWr-G39-7JTMQGynz3ph9K_DemMA9d_-xJYOeO9w-VuAm509XPYgoHywH3nNzIhFo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMDmbtwMq3-kV3yY_Kaz4lIB0RT7vxhp-3YF75fmbevw&oe=69B146E5"}, {"file_name": "5.png", "id": "635809706292149", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312257_635809709625482_8859423125390814773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axH60VaTkTAQ7kNvwFGGJM1&_nc_oc=AdncM8JTT6roHok3GWObzXOGUSSTyJh57LabuqzIZtYIdNI3AKmb5uZ069nFdj_pwPA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxz_kVgCqodzkcbWhuDDMHiHEJTI00Du13BCWxGY72Ltg&oe=69B17C88"}, {"file_name": "6.png", "id": "1009361684509173", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617769_1009361687842506_905219570959848276_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlA5VY3Ka9UQ7kNvwHr4dpF&_nc_oc=AdmyfPINYhWwEgnETycCjbO307lG8umlDCH2ztVJjCz3jK5gZLn4eMuy-4QLyVaJjfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMKsmuOVtDDQ98YJt6TI3Dqa0f1y9a05AvREfB-VjCew&oe=69B14569"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCover2560x1440.png", "id": "1158389738944880", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391888_1158389745611546_7143061330447314823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHVGHUaG8ckQ7kNvwGKOINT&_nc_oc=AdlO0R2eylpqi6aIQzA26Nm_Bi9rhq05-1GkEhhkp5EdeCFQrIRcN7owq3T9tPHyZ50&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyaR7wtrboz--6v1PKMSESisgQGTl-z02qbosLYRxghvA&oe=69B15E5B"}, "display_name": "Magic Color Merge Puzzle", "keywords": ["color", "sort", "sorting", "logical", "merge"], "long_description": "Magic Color Merge Puzzle reimagines the classic color sort genre with a stunning, immersive twist. Whether you prefer the ease of traditional clicks or the tactile thrill of pouring vibrant liquids by hand, this game lets you play your way - just like handling the real thing! But be careful\u2026 drop a bottle, and you might be in for a cleanup!\n\nJourney through increasingly challenging levels that test your logic and creativity. Earn crystals as rewards, then use them to research and craft a magical potion series\u2014your ultimate goal! Completing potion sets unlocks powerful boosters like double XP, extra tubes, and more.\n\nEnjoy three new daily challenges every day for extra rewards and a fresh gameplay twist.\n\nWant to experiment freely? Create your own custom games by choosing the number of tubes, colors, and game modes\u2014perfect for strategizing or just relaxing fun.\n\nCustomize your experience with different liquid styles (normal, minimal bubbles, or color-only) and tube designs (reflective or classic). All set to a selection of varied music tracks that evolve with your journey.\n\nReady to pour, sort, and craft your way to magical mastery?", "short_description": "Magic Color Merge Puzzle blends classic color sorting with a magical twist. Pour vibrant liquids your way - click or drag by hand! Complete levels to earn crystals and craft powerful magic potions. Two games in one: solve puzzles and become a master alchemist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pixelbrainstudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelbrain Studio", "support_website_url": "http://www.pixelbrainstudio.com/support", "website_url": "http://www.pixelbrainstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "extern
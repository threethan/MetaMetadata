ntent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0c-wW716vJ96P0K5HKYC6L-2pUXnThZKFkOB1JvVZNTg&oe=69D3B5F2"}, {"file_name": "1 - Copy.png", "id": "2095103704619805", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820923_2095103711286471_467057055026642363_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8w3hG3pOT4kQ7kNvwE0QQut&_nc_oc=AdpbwDdNi2YJ8WREPlnvungHimG54i-MSLl9vYZB8vj2thVzSatsJ_ozQwEMeiHyvCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UGpd4Fu_XeC1Cgi-cTvW_DuIiESlOLxDf6h1P4-zY3Q&oe=69D3B4A5"}, {"file_name": "5 - Copy.png", "id": "1608465590392110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828050_1608465593725443_1133905706281928396_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0KzsRph3-X4Q7kNvwGw0kzN&_nc_oc=AdrCa8hO2DvyjuyZ5pOvKxIHBO834gXuYxAbk-T_Ma7LyUVWt82_o4TREci66AkgKDI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Bp8d1OyGiZC3mRlMqVvO45qjUKgVlcwkNzWOi79dIXA&oe=69D3A266"}, {"file_name": "6.png", "id": "1009361684509173", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617769_1009361687842506_905219570959848276_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MYbw7qAtJYQ7kNvwFOuIwW&_nc_oc=AdozmFS32mWj5f8FJgqbmkCEgZr5O2IGu6BCmxDyQv8QqymzmQJDbNYNeUiM4XswTgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17IAg8baFfAOoN2MgdQJa3-Ut90Wp-AtguJXcprtiZgQ&oe=69D3C4A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCover2560x1440.png", "id": "1158389738944880", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391888_1158389745611546_7143061330447314823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKpBy1x2x4IQ7kNvwF6M1KE&_nc_oc=Adq_guGKqScE7IbK4obYtrmPKgBrcrRrEbi6OSZk5FIdkdvntHteejGIW5v0adrzASE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2c0_-gyXmbvmVeFnNDwr2FqkpbwQoT-MRY5flWDFO1mA&oe=69D3A55B"}, "display_name": "Magic Color Merge Puzzle", "keywords": ["color", "sort", "sorting", "logical", "merge"], "long_description": "Magic Color Merge Puzzle reimagines the classic color sort genre with a stunning, immersive twist. Whether you prefer the ease of traditional clicks or the tactile thrill of pouring vibrant liquids by hand, this game lets you play your way - just like handling the real thing! But be careful\u2026 drop a bottle, and you might be in for a cleanup!\n\nJourney through increasingly challenging levels that test your logic and creativity. Earn crystals as rewards, then use them to research and craft a magical potion series - your ultimate goal! Completing potion sets unlocks powerful boosters like double XP, extra tubes, and more.\n\nEnjoy three new daily challenges every day for extra rewards and a fresh gameplay twist.\n\nWant to experiment freely? Create your own custom games by choosing the number of tubes, colors, and game modes - perfect for strategizing or just relaxing fun.\n\nCustomize your experience with different liquid styles (normal, minimal bubbles, or color-only) and tube designs (reflective or classic). All set to a selection of varied music tracks that evolve with your journey.\n\nReady to pour, sort, and craft your way to magical mastery?\n{937708515466659}", "short_description": "Magic Color Merge Puzzle blends classic color sorting with a magical twist. Pour vibrant liquids your way - click or drag by hand! Complete levels to earn crystals and craft powerful magic potions. Two games in one: solve puzzles and become a master alchemist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pixelbrainstudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelbrain Studio", "support_website_url": "http://www.pixelbrainstudio.com/support", "website_url": "http://www.pixelbrainstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
&oh=00_Afw6dAzdojNeMkZ-2xMtjWgcJQ7bOg3SvuX76q5zVarMNw&oe=69AAD751"}, {"file_name": "2.png", "id": "1193217265911732", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491828899_1193217269245065_6881849521715644125_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-RmB1FA6NMQ7kNvwFBEFj2&_nc_oc=AdmTsXB9WYZ-b7pUPymJ9tWPLbArDwPw-o9T4jdtNvBHJBpV5EMIixmEPK_TlPsDiig&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfyfYLRFJjW3ksn_uXKKMgF6_VNgKR9DcWd0rTJSA2JrgA&oe=69AAAF65"}, {"file_name": "5.png", "id": "635809706292149", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499312257_635809709625482_8859423125390814773_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U49Xru6Th6QQ7kNvwFiBgqw&_nc_oc=AdmXYpUZ24spfFzulkFyz2Y2xQFCZyklRxbYIZ4Uhs4oIrYqDBt1D8eKrrVsgwsCWpI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzynWo90T0de7miHho12lmlfmLuKsjcjyNHz4Qt6qOXAQ&oe=69AAE508"}, {"file_name": "6.png", "id": "1009361684509173", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499617769_1009361687842506_905219570959848276_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qyil7QxZVDkQ7kNvwEKuIii&_nc_oc=Adl-eE819fxhajSA2MdgAXtbdBGIrWmW_p-TE3vdclxi3sBGIe2B051rVA34pv_iSPM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqoIMdVCgGEadgAVNcYbDnMnyhRFPoRjf7bh55SfN1lA&oe=69AAE629"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCover2560x1440.png", "id": "1158389738944880", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391888_1158389745611546_7143061330447314823_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXkCxlQY8NsQ7kNvwGFdrJO&_nc_oc=AdlAnjGs9m_jITRX0M7HXX3aqglgtfzs0eg94flSdgbLnUoxpIc9L28fnkhMEZOKey4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfySRosBnad-Lw3dn_TIaeqTPWckbXBCbGgkG0IhoOaZRQ&oe=69AAC6DB"}, "display_name": "Magic Color Merge Puzzle", "keywords": ["color", "sort", "sorting", "logical", "merge"], "long_description": "Magic Color Merge Puzzle reimagines the classic color sort genre with a stunning, immersive twist. Whether you prefer the ease of traditional clicks or the tactile thrill of pouring vibrant liquids by hand, this game lets you play your way - just like handling the real thing! But be careful\u2026 drop a bottle, and you might be in for a cleanup!\n\nJourney through increasingly challenging levels that test your logic and creativity. Earn crystals as rewards, then use them to research and craft a magical potion series\u2014your ultimate goal! Completing potion sets unlocks powerful boosters like double XP, extra tubes, and more.\n\nEnjoy three new daily challenges every day for extra rewards and a fresh gameplay twist.\n\nWant to experiment freely? Create your own custom games by choosing the number of tubes, colors, and game modes\u2014perfect for strategizing or just relaxing fun.\n\nCustomize your experience with different liquid styles (normal, minimal bubbles, or color-only) and tube designs (reflective or classic). All set to a selection of varied music tracks that evolve with your journey.\n\nReady to pour, sort, and craft your way to magical mastery?", "short_description": "Magic Color Merge Puzzle blends classic color sorting with a magical twist. Pour vibrant liquids your way - click or drag by hand! Complete levels to earn crystals and craft powerful magic potions. Two games in one: solve puzzles and become a master alchemist!\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pixelbrainstudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelbrain Studio", "support_website_url": "http://www.pixelbrainstudio.com/support", "website_url": "http://www.pixelbrainstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "ex
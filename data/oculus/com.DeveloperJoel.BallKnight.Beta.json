 crack of thunder. Will you continue to hold the title of hero in this once peaceful town?\n\nCompete to get your score on top of the leader boards!", "short_description": "Using your magic weapons, defend your town against hordes of horseback riding bouncing balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://developerjoel.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Developer Joel", "support_website_url": null, "website_url": "https://developerjoel.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1086546292139507"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974713_268028409547975_6505584675295302245_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BU8Wcom7Fq8Q7kNvwGmFYkv&_nc_oc=AdqXA4RvoiVKZ-a3FeyhB-erPH7QIxuz6dwk96DdblAblz56SpLBMy2EHAuQDQaXYho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1s7scWkvHlp-NP28w5vDowotbPFPtfYGd-x--Axy8pLg&oe=69D25415"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ball Knight", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1619802138, "lastRevision": {"nodes": [{"id": "18
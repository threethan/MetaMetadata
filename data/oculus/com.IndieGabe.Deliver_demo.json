0a&_nc_ohc=379A8ESAvVIQ7kNvwGyDN8B&_nc_oc=AdlzP3mhhOaaSrUdMFiAbvnrcFsWH87tFksK-iwLh_a4TXZvqodEusdjTLMXdG5ept4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afux67FbLq3icHByOuPKGGhuF18YetXADZD22OKddCAvgQ&oe=69A03AAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1600439497484683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982594_1600439500818016_957516808003693458_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHVZvSmVQlEQ7kNvwF_gwVY&_nc_oc=AdnnQMAqd7T_bkXOWmy0Jg1KCBFeu69Qbh_wwEEZGkogyfjWhOhgw9fE3rpZEoaJ07Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsLGSFy_tZeW9-LsTA9y9IVh685WpN3ETni0oK4CF9AxQ&oe=69A05036"}, "display_name": "Deliver That Pizza - Puzzle Game - Demo", "keywords": ["Puzzle", "Demo", "Escape", "Pizza", "Game"], "long_description": "Deliver That Pizza is an escape room style puzzle game with a comforting, but slightly liminal atmosphere.\nYou are playing as an unfortunate pizza delivery worker, whose only task left for the day is to deliver one last pizza. The overly cautious customer has set up some puzzles for you, which makes the task a bit difficult, but you take on the challenge (for the money).\nSolve the puzzles and travel through the rooms to complete your mission!\n\nThis is the demo level, the full game is out now!\nhttps://www.meta.com/en-gb/experiences/deliver-that-pizza-puzzle-game/9029005443873602/", "short_description": "Deliver That Pizza is an escape room style puzzle game (demo version). Your task is to deliver a pizza to the last location of the day, which proves to be a bit difficult with all the puzzles the customer has set up for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihol.hu/Unity_deliver_that_pizza/", "developer_terms_of_service_url": null, "publisher_name": "IndieGabe", "support_website_url": null, "website_url": "https://ihol.hu/IndieGabe/deliverthatpizza.html", "category": null, "comfort_rating": "COMFORTABLE_F
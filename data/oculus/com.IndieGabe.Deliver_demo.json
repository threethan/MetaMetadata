v/t64.5771-25/473391959_3420455088091160_8253591478148413859_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dIHFUlZNVsQ7kNvwGqL9Rg&_nc_oc=Adl5aOf_bKVvvufJLGHU7fvUsHnXjdvtkUyi3MtpYCQpbuT8oCOGqzNCbFg8zLqFaJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWd0w97up25F_pSzI8a_vAE_-b_ZhGexV5sHWw4dj06Q&oe=69AEBB2E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1600439497484683", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982594_1600439500818016_957516808003693458_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtpR1WknPM4Q7kNvwHsABpV&_nc_oc=Adn3k6Sxdxa957ZGDFaDPc_v_Xq9Yl6iLMob_1KAz98QUVLth-jQJ-muTOAwHuBtSYI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEdO5rWvKnqaX28wE-0AEbWJdbDBAGsmyJZD74eEw-lA&oe=69AED0B6"}, "display_name": "Deliver That Pizza - Puzzle Game - Demo", "keywords": ["Puzzle", "Demo", "Escape", "Pizza", "Game"], "long_description": "Deliver That Pizza is an escape room style puzzle game with a comforting, but slightly liminal atmosphere.\nYou are playing as an unfortunate pizza delivery worker, whose only task left for the day is to deliver one last pizza. The overly cautious customer has set up some puzzles for you, which makes the task a bit difficult, but you take on the challenge (for the money).\nSolve the puzzles and travel through the rooms to complete your mission!\n\nThis is the demo level, the full game is out now!\nhttps://www.meta.com/en-gb/experiences/deliver-that-pizza-puzzle-game/9029005443873602/", "short_description": "Deliver That Pizza is an escape room style puzzle game (demo version). Your task is to deliver a pizza to the last location of the day, which proves to be a bit difficult with all the puzzles the customer has set up for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihol.hu/Unity_deliver_that_pizza/", "developer_terms_of_service_url": null, "publisher_name": "IndieGabe", "support_website_url": null,
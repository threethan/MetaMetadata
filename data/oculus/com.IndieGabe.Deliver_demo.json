0a&_nc_ohc=379A8ESAvVIQ7kNvwE81Pip&_nc_oc=Adl2oFt3VvGmP2jkalvdIW3plOAEpPk1kxKvrepvlhgcE5nFpd70eOkyaV5JRCQSOH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu1GMsAaw2us04HaFiJ35FLz_y7XyoGj1H5MLWjDYOLJA&oe=699D97AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1600439497484683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982594_1600439500818016_957516808003693458_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bn7F13ovB_8Q7kNvwGe1hfT&_nc_oc=AdnJSz_aAF4CUBBICtqFvb0laY3MfwwgMzcbmgRBBVbhYAxBbmEi34GuUmtWccEXAvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuM3ua3SnUb-0Hs9WpXRebQ2JRqQJOHIQLP9CWk-uDXYw&oe=699DAD36"}, "display_name": "Deliver That Pizza - Puzzle Game - Demo", "keywords": ["Puzzle", "Demo", "Escape", "Pizza", "Game"], "long_description": "Deliver That Pizza is an escape room style puzzle game with a comforting, but slightly liminal atmosphere.\nYou are playing as an unfortunate pizza delivery worker, whose only task left for the day is to deliver one last pizza. The overly cautious customer has set up some puzzles for you, which makes the task a bit difficult, but you take on the challenge (for the money).\nSolve the puzzles and travel through the rooms to complete your mission!\n\nThis is the demo level, the full game is out now!\nhttps://www.meta.com/en-gb/experiences/deliver-that-pizza-puzzle-game/9029005443873602/", "short_description": "Deliver That Pizza is an escape room style puzzle game (demo version). Your task is to deliver a pizza to the last location of the day, which proves to be a bit difficult with all the puzzles the customer has set up for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihol.hu/Unity_deliver_that_pizza/", "developer_terms_of_service_url": null, "publisher_name": "IndieGabe", "support_website_url": null, "website_url": "https://ihol.hu/IndieGabe/deliverthatpizza.html", "category": null, "comfort_rating": "COMFORTABLE_F
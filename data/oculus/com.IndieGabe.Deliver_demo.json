091160_8253591478148413859_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQxcUH-JozgQ7kNvwGLsXK2&_nc_oc=Adpl_hlBIXX2M4mqfEj1dCEXyySYvAEaBl0i3-9zBjRZGTcJx-gP0LYsCjyQVuI7-t8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0nD1ruKywJla_XheovlN4C5ECik8L4kPgVE_6hWoHT7Q&oe=69F1F7AE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1600439497484683", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982594_1600439500818016_957516808003693458_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSIt_s8jGHAQ7kNvwHKe1EP&_nc_oc=AdrYNbUoZsTKtNMjdpXxGPkUOWrlsp8V1dhfdlhaAdLEkkW81r8YPWN3csGs_3naXZY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2IvUhLEElSggLHWwBn7cawd7MFX6Q_JiYfvCM6jEs5eQ&oe=69F20D36"}, "display_name": "Deliver That Pizza - Puzzle Game - Demo", "keywords": ["Puzzle", "Demo", "Escape", "Pizza", "Game"], "long_description": "Deliver That Pizza is an escape room style puzzle game with a comforting, but slightly liminal atmosphere.\nYou are playing as an unfortunate pizza delivery worker, whose only task left for the day is to deliver one last pizza. The overly cautious customer has set up some puzzles for you, which makes the task a bit difficult, but you take on the challenge (for the money).\nSolve the puzzles and travel through the rooms to complete your mission!\n\nThis is the demo level, the full game is out now!\nhttps://www.meta.com/en-gb/experiences/deliver-that-pizza-puzzle-game/9029005443873602/", "short_description": "Deliver That Pizza is an escape room style puzzle game (demo version). Your task is to deliver a pizza to the last location of the day, which proves to be a bit difficult with all the puzzles the customer has set up for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihol.hu/Unity_deliver_that_pizza/", "developer_terms_of_service_url": null, "publisher_name": "IndieGabe", "support_website_url": null, "website_url": "https://ihol.hu/IndieGabe/deliverthatpizza.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10005695619457629"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031639_2720681558106349_8348091299655026798_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5xxWmLGRkAQ7kNvwGUMhM3&_nc_oc=Adp-ie4RaHQ7YEJKBfBLRsZ-R4BgVYc24iWzc1oH0wVyI_Zl4KfijKmXAZZro33k8XM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3GvIxs_oXVg7UyjWEPZVtN98F3fQPoRdqkB5z_UrCapQ&oe=69F20696"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Deliver That Pizza - Puzzle Game - Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1728327060, "lastRevision": {"nodes": [{"id": "9152096608150872", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9152096594817540", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "569469667775431"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "3000x900.png", "id": "8355098071270478", "image_type": "APP_IMG_HERO", "uri": "https://scontent-
ri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391959_3420455088091160_8253591478148413859_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGc2FoDi8EsQ7kNvwGawyjI&_nc_oc=AdpHh4kFtQmB5Ta-EY7LqRw7Enx2Xh43P1MA2fl5F2xtRa-CLDlj1nfvxspm7BjinfA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHDYk3pKrVXwbjmyZeK-wqO4bphLB5e6yFwv2UsASX1tw&oe=6A79C22E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1600439497484683", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982594_1600439500818016_957516808003693458_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=va9yYkNIg4UQ7kNvwG3VrG7&_nc_oc=AdrmIwyFX0lYAcn9fMIiUvbvEfaTwGkDTpSh-2gSzM-EnsijhJoBjp3i6qfewric6BA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHScbFRcYhp1D8ZB1UnKlKm1l3v-prf_wkEEG3s_16VmA&oe=6A79D7B6"}, "display_name": "Deliver That Pizza - Puzzle Game - Demo", "keywords": ["Puzzle", "Demo", "Escape", "Pizza", "Game"], "long_description": "Deliver That Pizza is an escape room style puzzle game with a comforting, but slightly liminal atmosphere.\nYou are playing as an unfortunate pizza delivery worker, whose only task left for the day is to deliver one last pizza. The overly cautious customer has set up some puzzles for you, which makes the task a bit difficult, but you take on the challenge (for the money).\nSolve the puzzles and travel through the rooms to complete your mission!\n\nThis is the demo level, the full game is out now!\nhttps://www.meta.com/en-gb/experiences/deliver-that-pizza-puzzle-game/9029005443873602/", "short_description": "Deliver That Pizza is an escape room style puzzle game (demo version). Your task is to deliver a pizza to the last location of the day, which proves to be a bit difficult with all the puzzles the customer has set up for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihol.hu/Unity_deliver_that_pizza/", "developer_terms_of_service_url": null, "publis
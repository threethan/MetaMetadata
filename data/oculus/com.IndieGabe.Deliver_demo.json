ucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnmYcFIU_-cQ7kNvwE58OD-&_nc_oc=AdqXHTaB-wId3wPFe-o8r7CD6AX7UBj3pc5Rl-PVx8w0WBK4rS2LPsRaNmBI1UcrhIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQV4Vt-Uly8K1JTZ76GEukwrKY_AlVIoKxI9tznov5IQ&oe=6B03277D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1600439497484683", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982594_1600439500818016_957516808003693458_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tc5pi0hKiMQ7kNvwGi2oLh&_nc_oc=Adopdq1vKFqgVqHs0nh_NQDblrFmiBPPJdQMulSSoBQvfhE7mMtEPL7LwVIxm03ETQI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFhy_y870ys120U60shc1DoTG4gzCKApm5o8Sou3LIZg&oe=6B032BF6"}, "display_name": "Deliver That Pizza - Puzzle Game - Demo", "keywords": ["Puzzle", "Demo", "Escape", "Pizza", "Game"], "long_description": "Deliver That Pizza is an escape room style puzzle game with a comforting, but slightly liminal atmosphere.\nYou are playing as an unfortunate pizza delivery worker, whose only task left for the day is to deliver one last pizza. The overly cautious customer has set up some puzzles for you, which makes the task a bit difficult, but you take on the challenge (for the money).\nSolve the puzzles and travel through the rooms to complete your mission!\nThis is the demo level, the full game is coming soon!", "short_description": "Deliver That Pizza is an escape room style puzzle game (demo version). Your task is to deliver a pizza to the last location of the day, which proves to be a bit difficult with all the puzzles the customer has set up for you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihol.hu/Unity_deliver_that_pizza/", "developer_terms_of_service_url": null, "publisher_name": "IndieGabe", "support_website_url": null, "website_url": "https://ihol.hu/IndieGabe/deliverthatpizza.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MO
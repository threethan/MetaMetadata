content-ord5-3.oculuscdn.com&oh=00_AfuZZTA9xyzO2u1LF2QcS0eNHd_2ExMey8AdiLHlUGtB6w&oe=699B129E"}, {"file_name": "DrawTornado.png", "id": "835779994822110", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395588_835779998155443_6654869001591360292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBlxX654OroQ7kNvwFYXUWN&_nc_oc=Admz5QLINdALKCAVeMS_HumjjxlWhMtxWaIc5-6HdNenlpZl8RwFS16Lo7Akg6NHw44&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afsy17nkwoWZRo5xUHJrIP7ix8gN_ROT4RHAKc41t77NmQ&oe=699AF2DD"}, {"file_name": "Tornado.png", "id": "243998891868725", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974506_243998895202058_7962023134784561312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qb-DFpiAXm8Q7kNvwHqeZEB&_nc_oc=Admb90IqpOnsIDlXt3cuhYT-i3bZLHWy2HJ60kelL1loLJ0_e0kzhcGGHHJBAwra6fc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft-C-olh_FSY0V20zyjdhFkIvj1Oshd2Eef4GO2eurHWQ&oe=699B119D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WhatsApp Image 2023-08-13 at 23.30.44.png", "id": "827290902278220", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982665_827290905611553_6326284588123561706_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrNbK4VFWAoQ7kNvwEt3rVz&_nc_oc=AdlTq6W2ZMjRu9DLAsmMNv7qtWuzQ0TxCisaS9PSlauPVLiFJDBrhhBmxD8ioLqYs6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftrOxrdXbCmOmStbAQhpkwyWiSMLJ8O1jb-QIAAIsdSwg&oe=699ADD47"}, "display_name": "Goblin Invasion", "keywords": [], "long_description": "Goblin Invasion is a fantasy-based game about being a sorcerer. With the innovative mechanics of drawing and casting spells, the player defends their village against the forces of evil. \nBe the most powerful magician and protect your loved ones from evil goblins. From your tower, you must prevent the waves of enemies from taking down the gate and breaking into the village. Only you can prevent the destruction of your town. Are you ready to be a true magician? Play Goblin Invasion and become the most powerful wizard.", "short_description": "You are the last defender of the city, a powerful wizard who draws to cast mighty spells and stop the goblin invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/250f3da2-f744-4bea-9a8d-9be39b5bf127", "developer_terms_of_service_url": null, "publisher_name": "Mate Hardcore", "support_website_url": null, "website_url": "https://www.instagram.com/matehardcorelml/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "980721566509272"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031450_982683352951222_4770918114183451854_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FeFiemEKNoQ7kNvwF9VNFe&_nc_oc=AdnqF3Zmwe7upJV3R5N3V5kAUEdPyvTwBAa-eGgDnBli8LvpS9i9mRAZir8MJo9_PZo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afun8Q1JXDsCVDxTjBpXnUItcVxZbOTCEINGVKSMl24HIg&oe=699B12F7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Goblin Invasion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1691520534, "lastRevision":
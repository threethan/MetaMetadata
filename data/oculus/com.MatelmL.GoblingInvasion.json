content-iad3-1.oculuscdn.com&oh=00_AftmArXDLantWXVc5guKS4Hr1-0xggwTDtYYqvKoEkcdKg&oe=69A6F01E"}, {"file_name": "DrawTornado.png", "id": "835779994822110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395588_835779998155443_6654869001591360292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpEjW5W1DOMQ7kNvwH7DOMY&_nc_oc=AdmfQGha3kOcpQWeF4lcLtH3dZeGChX8yRootoutRnpTnJHeSXe2pXNDW9WEfRo6d7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft-uywdm66tr06mtJMnINgOHQYTXzsqi_NN4yjnDwIXpQ&oe=69A6D05D"}, {"file_name": "Tornado.png", "id": "243998891868725", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_243998895202058_7962023134784561312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkTlFr3jyXUQ7kNvwHMaPQq&_nc_oc=AdnTTwHHEkhvRTQUlW7BqHU30HWtLh70SPC6ZlKbF3ono8nYdWLyrbYikQwLCo0fzRQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftiTFRRG_5qzey0vVKfVTLV4T-rfvUVu8RU9X5D8n6Bmg&oe=69A6EF1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WhatsApp Image 2023-08-13 at 23.30.44.png", "id": "827290902278220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982665_827290905611553_6326284588123561706_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zTHTmHiG_IQ7kNvwHCCIcB&_nc_oc=AdlFImu3JQnzXPEGMubk3zHZivmKgxKOCp3hSC5s5EAAcAquwF_epmXHt3JIyV3SLCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDq2DlIwAndvYDxvaZU-SxhfqbAoGKIqIUJRjIBdexvw&oe=69A6BAC7"}, "display_name": "Goblin Invasion", "keywords": [], "long_description": "Goblin Invasion is a fantasy-based game about being a sorcerer. With the innovative mechanics of drawing and casting spells, the player defends their village against the forces of evil. \nBe the most powerful magician and protect your loved ones from evil goblins. From your tower, you must prevent the waves of enemies from taking down the gate and breaking into the village. Only you can prevent the destruction of your town. Are you ready to be a true magician? Play Goblin Invasion and become the most powerful wizard.", "short_description": "You are the last defender of the city, a powerful wizard who draws to cast mighty spells and stop the goblin invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/250f3da2-f744-4bea-9a8d-9be39b5bf127", "developer_terms_of_service_url": null, "publisher_name": "Mate Hardcore", "support_website_url": null, "website_url": "https://www.instagram.com/matehardcorelml/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "980721566509272"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031450_982683352951222_4770918114183451854_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTfHLbHyWLoQ7kNvwEi8e_U&_nc_oc=AdlzEGcJqFbpVyGR-wTZg31UJMkssu8i8oEdv3a89qVFq34crl3eaphXX3-MvdOcE4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs_dvXWgpsC4XA6uto-GRSLQvqbe4ftsDhRSDHu4erP4A&oe=69A6F077"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Goblin Invasion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1691520534, "lastRevision":
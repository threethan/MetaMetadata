content-iad6-1.oculuscdn.com&oh=00_Af12SZn38HQGuji0rDuabc5K0L28XH_0Qhcf5eMFxpsNzw&oe=69F0C41E"}, {"file_name": "DrawTornado.png", "id": "835779994822110", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395588_835779998155443_6654869001591360292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Bo_8Sv2QpUQ7kNvwFP9ekQ&_nc_oc=AdpiDO7F2ksotQz_QW1C3wAb9zYAaChp6GpkVtciVjSCl20mMTLgaDxUjWsa7sTgPpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2aD1PjEt7TgRhRYQgZdrDb5_mTVbbinlBX1dJqQMYpMg&oe=69F0A45D"}, {"file_name": "Tornado.png", "id": "243998891868725", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974506_243998895202058_7962023134784561312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK_Q1v2JspkQ7kNvwFynehn&_nc_oc=AdqL5XBjJt6QcJ3h0lUYGDnzXXeh-FkUAklqlGPiEo5z6I_u84ODAoQeKYb17Yjt9rY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2vEML2hA45e-MT_ke2opjzWbB-Shf1APC45MFkdn-Xkg&oe=69F0C31D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WhatsApp Image 2023-08-13 at 23.30.44.png", "id": "827290902278220", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982665_827290905611553_6326284588123561706_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZP1hXo1c-7cQ7kNvwH05qMC&_nc_oc=AdrQKB_LSIfpT7LX93CtWlH1SnE3OpQiXqRC7_S1XStDoLQ-SQJbqLGG4OL2PysFHJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2lzW836QzSGyAuk7eQyKA8YnlwqdapBDe53rJNCQTk2g&oe=69F0C707"}, "display_name": "Goblin Invasion", "keywords": [], "long_description": "Goblin Invasion is a fantasy-based game about being a sorcerer. With the innovative mechanics of drawing and casting spells, the player defends their village against the forces of evil. \nBe the most powerful magician and protect your loved ones from evil goblins. From your tower, you must prevent the waves of enemies from taking down the gate and breaking into the village. Only you can prevent the destruction of your town. Are you ready to be a true magician? Play Goblin Invasion and become the most powerful wizard.", "short_description": "You are the last defender of the city, a powerful wizard who draws to cast mighty spells and stop the goblin invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/250f3da2-f744-4bea-9a8d-9be39b5bf127", "developer_terms_of_service_url": null, "publisher_name": "Mate Hardcore", "support_website_url": null, "website_url": "https://www.instagram.com/matehardcorelml/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "980721566509272"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031450_982683352951222_4770918114183451854_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdhLyDCajx0Q7kNvwEZXq0-&_nc_oc=AdqzoWLFB1v-JnT3OXBKEsLvaKTMCCHinchLQE4_4rvjSUHB2T56yKUj6kbvuMtjliQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2atmQsCfvwSEOXun3TnQG5CHrz48_KeVe1BtrVNqzwjA&oe=69F0C477"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Goblin Invasion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1691520534, "lastRevision":
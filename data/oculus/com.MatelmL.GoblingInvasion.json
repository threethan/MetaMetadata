content-sjc6-1.oculuscdn.com&oh=00_AftQb6G7shOprsxpfeeKo9m_J9Lg89dayOKOKtFfgozfhQ&oe=69986F9E"}, {"file_name": "DrawTornado.png", "id": "835779994822110", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395588_835779998155443_6654869001591360292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUKZvDDY9boQ7kNvwHHF4gF&_nc_oc=AdmoYPMfoNYMW4c-9QVkloSp9nXXlxrGlKB1EHdIRRFf_1q_SfLgBoqbI4NOfVMfMlk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvUs0UsEbAOMSs6dShk4Tfge-xIHNZaYn28BiN4OXjyXg&oe=69984FDD"}, {"file_name": "Tornado.png", "id": "243998891868725", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974506_243998895202058_7962023134784561312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LYJpqrZFYsQ7kNvwECO2yn&_nc_oc=AdlDQjbg_MpUy7Ozh9IVzHRDaYMzGqDbp978Nb-0Uj_n_H6lxJ_OOmHuogVO-lh0cig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftDszTDOPwDtEgbI0dG7QEpzqiDiqzjTkBReFpmjhbYXQ&oe=69986E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WhatsApp Image 2023-08-13 at 23.30.44.png", "id": "827290902278220", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982665_827290905611553_6326284588123561706_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xphCCxxdDH0Q7kNvwEo1auj&_nc_oc=AdmQhKgSYfoKozNCsxgEQ2tLpCqjkCjquIFviymEubL4Wpp6ifEdh5UFvtjvYvgF8CY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afv6vJetpI984vLPZMCfrCEWxamWh8ztBoAyUuNZlpzKng&oe=69987287"}, "display_name": "Goblin Invasion", "keywords": [], "long_description": "Goblin Invasion is a fantasy-based game about being a sorcerer. With the innovative mechanics of drawing and casting spells, the player defends their village against the forces of evil. \nBe the most powerful magician and protect your loved ones from evil goblins. From your tower, you must prevent the waves of enemies from taking down the gate and breaking into the village. Only you can prevent the destruction of your town. Are you ready to be a true magician? Play Goblin Invasion and become the most powerful wizard.", "short_description": "You are the last defender of the city, a powerful wizard who draws to cast mighty spells and stop the goblin invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/250f3da2-f744-4bea-9a8d-9be39b5bf127", "developer_terms_of_service_url": null, "publisher_name": "Mate Hardcore", "support_website_url": null, "website_url": "https://www.instagram.com/matehardcorelml/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "980721566509272"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031450_982683352951222_4770918114183451854_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nw7K9netgVIQ7kNvwGhfN-8&_nc_oc=Adn2Z4J1WHYHsJcHyML2JuWT107Ie6D2TZdQUyu5AEVEN23ZTSNUbXVBQpuPySUibfQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsqDwhPR2I-XySA2d1Z5i27ViQJcGqJG5cQpSyzQiDCpg&oe=69986FF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Goblin Invasion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1691520534, "lastRevision":
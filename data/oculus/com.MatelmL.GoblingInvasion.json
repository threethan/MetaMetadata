on and become the most powerful wizard.", "short_description": "You are the last defender of the city, a powerful wizard who draws to cast mighty spells and stop the goblin invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/250f3da2-f744-4bea-9a8d-9be39b5bf127", "developer_terms_of_service_url": null, "publisher_name": "Mate Hardcore", "support_website_url": null, "website_url": "https://www.instagram.com/matehardcorelml/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "980721566509272"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031450_982683352951222_4770918114183451854_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2FeFiemEKNoQ7kNvwH_RkmY&_nc_oc=AdldCyBDX5zkEi97i_lNCaNkxn2pIxmXssQYJ3xblfOFkMjWmFmdcofTs9XlfGuJ36Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvbCffy0tpPv5ryyYNJyLjqUkWUR393GlPkSbpYsY9kJA&oe=6999C177"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Goblin Invasion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1691520534, "lastRevision":
content-atl3-3.oculuscdn.com&oh=00_AfvejhSJDUIHv1ZElWhmqqFr7hMJt6-KHLZ1nqqGHUg0gQ&oe=69A59E9E"}, {"file_name": "DrawTornado.png", "id": "835779994822110", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395588_835779998155443_6654869001591360292_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hULvUPlOrEcQ7kNvwEdBfBn&_nc_oc=AdkuCTtWWQxSxssOVzaRsKC9KVC2gbzSBffk1X8Uq1HVbpVte6bbkHFk9AkutZubCIQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfspZJIOvS0hnDqgCzlBe3r4XeUWDKJHNf2kQE7ha7wWAA&oe=69A57EDD"}, {"file_name": "Tornado.png", "id": "243998891868725", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974506_243998895202058_7962023134784561312_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkTlFr3jyXUQ7kNvwHH7WhV&_nc_oc=AdmyUFCgHA4BWRbJbIeTKAQKbhcG6Wp2xgtatbdpR3NweA6wFgNf8YTSRcNPcSHnm8U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftCLd6FU-HlK0aHpWbWLBYwZfBnCTwZmKlvZZGRL4uIZA&oe=69A59D9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "WhatsApp Image 2023-08-13 at 23.30.44.png", "id": "827290902278220", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982665_827290905611553_6326284588123561706_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zTHTmHiG_IQ7kNvwHSG8uZ&_nc_oc=AdlgV3HT1riVxZsB5dG48GEIIpu6HV1zgwPiiUYKij6QwujVpqjUQtFrbrz7LUz_sws&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Aft_p2b_J3xcQ6iQmKnZasIVK32cGwPNn5ZtySbep0hOnA&oe=69A5A187"}, "display_name": "Goblin Invasion", "keywords": [], "long_description": "Goblin Invasion is a fantasy-based game about being a sorcerer. With the innovative mechanics of drawing and casting spells, the player defends their village against the forces of evil. \nBe the most powerful magician and protect your loved ones from evil goblins. From your tower, you must prevent the waves of enemies from taking down the gate and breaking into the village. Only you can prevent the destruction of your town. Are you ready to be a true magician? Play Goblin Invasion and become the most powerful wizard.", "short_description": "You are the last defender of the city, a powerful wizard who draws to cast mighty spells and stop the goblin invasion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/250f3da2-f744-4bea-9a8d-9be39b5bf127", "developer_terms_of_service_url": null, "publisher_name": "Mate Hardcore", "support_website_url": null, "website_url": "https://www.instagram.com/matehardcorelml/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "980721566509272"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031450_982683352951222_4770918114183451854_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTfHLbHyWLoQ7kNvwHL1-yL&_nc_oc=Adn3_alo3Uw9coQ6Gj2ATPdRPYn1hPI61uPAnh4ZWuvsvfEDY5TiTXkFnolwJjpjBC0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftqXDLhfkBVOEG5ugQrR8NF5kZxZEbm80tWSesLaDqDRA&oe=69A59EF7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Goblin Invasion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1691520534, "lastRevision":
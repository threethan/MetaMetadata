tics. SO much more is planned for the game. I hope you enjoy playing this game with your friends.", "short_description": "Don't Fall! is a VR game about going up different courses with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dontfallprivacypolicy.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Reddjamm2", "support_website_url": null, "website_url": "https://reddjamm2.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8759018580813780"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392097_540249849031002_3589927868599676194_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrI59hKsEZ8Q7kNvwEN7JBB&_nc_oc=AdnWRN2Z8XFrGkgFUZkXpEM61hMbP9WxTzrvWjCV777YwkOg3zrunfIOwEohugHT5FI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuaoTQV0liMlqfQKC4ONnHBzCJCNXVf9-QO602YvpMmGg&oe=69A039C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Don't Fall!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1729800840, "lastRevision": {"nodes": [{"id": "8254732617909048", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_m
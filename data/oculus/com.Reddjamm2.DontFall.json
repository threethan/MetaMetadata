cluding: a few different courses, a randomly generating course, minigames, creepy vents, and a zero-gravity area. Press the different buttons to change the current course. Join public servers or play in private ones with your friends. Change your name and color with the computer. Go to the shop to use Fall Coins (currency) to purchase cosmetics. SO much more is planned for the game. I hope you enjoy playing this game with your friends.", "short_description": "Don't Fall! is a VR game about going up different courses with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dontfallprivacypolicy.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Reddjamm2", "support_website_url": null, "website_url": "https://reddjamm2.itch.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8266493120066331"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1592315614999863"}]}, "baseline_offer": {"id": "1592315614999863"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1729800840, "status": "PUBLISHED", "id": "1592315614999863"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8758991170816521", "version": "0.26"}, "id": "921851686575202", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pr
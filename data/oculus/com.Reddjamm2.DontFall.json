rvers or play in private ones with your friends. Change your name and color with the computer. Go to the shop to use Fall Coins (currency) to purchase cosmetics. SO much more is planned for the game. I hope you enjoy playing this game with your friends.", "short_description": "Don't Fall! is a VR game about going up different courses with your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dontfallprivacypolicy.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Reddjamm2", "support_website_url": null, "website_url": "https://reddjamm2.tiiny.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "8759018580813780"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392097_540249849031002_3589927868599676194_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dpl1qxkhzzUQ7kNvwFrVhS1&_nc_oc=Adqx8dQ2-XcDohoyp6qRY31D82cTwOOW88KnBikBNp34-L0zux9nMPPlj97yqk4YXSQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Eemg4udU5FS2IM5Z1osX5N7-nQCIQ5S0ModrtUF8f_g&oe=6A3FBF40"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Don't Fall!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "45978
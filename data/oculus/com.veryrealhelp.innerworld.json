nc_ss=7f20f&oh=00_AQKAzqnOYJewnkP5elDAEmGp_qVEQ4rKLtIOGMlLSR3uqw&oe=6AA2AAE5"}, {"file_name": "Screenshots-for-MetaArtboard-5.png", "id": "626593508920122", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75572753_626593512253455_5213214269128729807_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IesnUd68AsUQ7kNvwGNpfKs&_nc_oc=Adp5CyOkJVpMcAdwEpUur3PuTEPOu8PsaQOuwo7aJdfjYYq4Ut5aI67Roz1fRlwQLDk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9kIoclFD0z9mYUWU7wQtZDOWHs4m-Jy9WGovZ5h3YrQ&oe=6AA2BDA6"}, {"file_name": "Screenshots-for-MetaArtboard-3.png", "id": "1045235136912320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035416_1045235140245653_7902886928611989989_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQWnj-sH-2oQ7kNvwHpFxa-&_nc_oc=AdqdzqZ0vb3QiX8aG5LkCjEh43wkks3ARAbkdWcwiZ5BFeL6N2ibzRmplwtV5bxiJ70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKptlz7BvCEQTh2DvQdMRGohDr6DKazmyhfqg7oPAzmPA&oe=6AA29B8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest cover landscape.png", "id": "2092481091570506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303788_2092481094903839_5844377271877161642_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58P2ZZqMjCgQ7kNvwHooREp&_nc_oc=AdrZpu4BYgnLdGsCw_kaHfuA89QHEejzm5iN7qfkokv8OeuLhzGIkqaGFDkRO-4U-BA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlCm0NOqwnHgV_YKWVZkrlwMqYPYBVZ9aGjEs-RN-yjA&oe=6AA2AB2C"}, "display_name": "Innerworld by XRHealth", "keywords": ["mental", "health", "meditation", "anxiety", "social"], "long_description": "Welcome to Innerworld: a virtual world where you can learn evidence-based mental health tools and receive support in a place where you can feel safe being yourself. Start your mental health journey today.\n \nCERTIFIED GUIDES\n \nWork through life\u2019s biggest challenges with guides certified in Cognitive Behavioral Immersion: a transformative approach to mental health support. \n \nSAFE, WELCOMING AND ANONYMOUS COMMUNITY\n \nJoin a tight-knit community exploring the thoughts, emotions and behaviors that shape us through courses, events and support groups.\n \nLIFE-CHANGING MENTAL HEALTH TOOLS\n \nEnter a virtual world that equips you with life-changing tools, so you can go back to the physical world more empowered than you left it. \n \nMEANING AND PURPOSE\n\nDiscover a sense of purpose by learning how to help others navigate life\u2019s biggest challenges.\n \nLet\u2019s find our way together.\n\nInnerworld is currently for people who are able to speak English.\n", "short_description": "Welcome to Innerworld: a virtual world where you can learn evidence-based mental health tools and receive support in a place where you can feel safe being yourself. Start your mental health journey today.\n \nWork through life\u2019s biggest challenges with guides certified in Cognitive Behavioral Immersion: a transformative approach to mental health support. \n\nLet\u2019s find our way together.\n\nInnerworld is currently for people who are able to speak English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inner.world/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Innerworld", "support_website_url": null, "website_url": "https://inner.world/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["MEDICINE", "RELAXATION_MEDITATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING
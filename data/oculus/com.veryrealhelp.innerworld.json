nt-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwfxaeCW-cIyKZ2KItlW5KfiDXRuwGD95aDMML4cmIJg&oe=6B0B1C66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_Store-Assets_Hero+CoverCover-Landscape.png", "id": "824499288594022", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035398_824499291927355_5247325726742229764_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sohXtemsnwMQ7kNvwEviIm5&_nc_oc=AdqLkm96HovQt7u2rikegWXXzdNgLlYaLaJxtLaOmh82mnwd8OaePjKgc2xhxOp_lhI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkMAnfj2vLTrHdcYd8CzN3uBl-NzUh5IHs5rnvcrozUw&oe=6B0B360D"}, "display_name": "Innerworld", "keywords": [], "long_description": "Welcome to Innerworld: a virtual world where you can learn evidence-based mental health tools and receive support in a place where you can feel safe being yourself. Start your mental health journey today.\n \nCERTIFIED GUIDES\n \nWork through life\u2019s biggest challenges with guides certified in Cognitive Behavioral Immersion: a transformative approach to mental health support. \n \nSAFE, WELCOMING AND ANONYMOUS COMMUNITY\n \nJoin a tight-knit community exploring the thoughts, emotions and behaviors that shape us through courses, events and support groups.\n \nLIFE-CHANGING MENTAL HEALTH TOOLS\n \nEnter a virtual world that equips you with life-changing tools, so you can go back to the physical world more empowered than you left it. \n \nMEANING AND PURPOSE\n\nDiscover a sense of purpose (and make some money on the side!) by learning how to help others navigate life\u2019s biggest challenges.\n \nLet\u2019s find our way together.\n\nInnerworld is currently for people who are 18 or older.\n", "short_description": "Welcome to Innerworld: a virtual world where you can learn evidence-based mental health tools and receive support in a place where you can feel safe being yourself. Start your mental health journey today.\n \nWork through life\u2019s biggest challenges with guides certified in Cognitive Behavioral Immersion: a transformative approach to mental health support. \n\nLet\u2019s find our way together.\n\nInnerworld is currently for people who are 18 or older and are able to speak English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inner.world/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Innerworld", "support_website_url": null, "website_url": "https://inner.world/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["MEDICINE", "RELAXATION_MEDITATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "626917779219795"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3404767926514396"}]}, "baseline_offer": {"id": "3404767926514396"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1668103200, "status": "PUBLISHED", "id": "3404767926514396"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26728693513414268", "version": "2.0.253"}, "id": "463348908942669", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5406767536033508", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": 
nc_ss=7f20f&oh=00_AQRGCRV6wQaaH82_hdcFhXp1zO5huC2YCOYNwtuGSahSpQ&oe=6AF0ABA5"}, {"file_name": "Screenshots-for-MetaArtboard-5.png", "id": "626593508920122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75572753_626593512253455_5213214269128729807_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3QIH72ZnkikQ7kNvwHYu_af&_nc_oc=Adp_r6m2rINtuT-giAS3DLae3GtHYOx5tOIn9QRn6rHylM96YN2vYXlW_c8EReFbtq4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1M7d3BRQIo1nwK4XdN8JE5sFdSYGLaSLe3fALyaT19g&oe=6AF08626"}, {"file_name": "Screenshots-for-MetaArtboard-3.png", "id": "1045235136912320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035416_1045235140245653_7902886928611989989_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYxrTkQjGHYQ7kNvwHRPLpg&_nc_oc=AdpoT9kVpOS_sf3lPxgA9NdaLqy_mKhLfYYici556-KYCj0_hKNLSNXdVXTobwofRow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXochJMjhAh0T9YMWA-RnSOG3Nc9nMMxpgl_W40NXGxQ&oe=6AF09C4A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest cover landscape.png", "id": "2092481091570506", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303788_2092481094903839_5844377271877161642_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6iNbnl1VjoQ7kNvwEiy6eT&_nc_oc=Adpob-PqSIYME8UJYyB1rDLe062qZahzJJgRoYl74zKU295IYQT9YFBp7hqk9jD3wx4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDoWorPAK7acroQ_Lagt92EHoBzjtTBdjqJNmG-U9miQ&oe=6AF0ABEC"}, "display_name": "Innerworld by XRHealth", "keywords": ["mental", "health", "meditation", "anxiety", "social"], "long_description": "Welcome to Innerworld: a virtual world where you can learn evidence-based mental health tools and receive support in a place where you can feel safe being yourself. Start your mental health journey today.\n \nCERTIFIED GUIDES\n \nWork through life\u2019s biggest challenges with guides certified in Cognitive Behavioral Immersion: a transformative approach to mental health support. \n \nSAFE, WELCOMING AND ANONYMOUS COMMUNITY\n \nJoin a tight-knit community exploring the thoughts, emotions and behaviors that shape us through courses, events and support groups.\n \nLIFE-CHANGING MENTAL HEALTH TOOLS\n \nEnter a virtual world that equips you with life-changing tools, so you can go back to the physical world more empowered than you left it. \n \nMEANING AND PURPOSE\n\nDiscover a sense of purpose by learning how to help others navigate life\u2019s biggest challenges.\n \nLet\u2019s find our way together.\n\nInnerworld is currently for people who are able to speak English.\n", "short_description": "Welcome to Innerworld: a virtual world where you can learn evidence-based mental health tools and receive support in a place where you can feel safe being yourself. Start your mental health journey today.\n \nWork through life\u2019s biggest challenges with guides certified in Cognitive Behavioral Immersion: a transformative approach to mental health support. \n\nLet\u2019s find our way together.\n\nInnerworld is currently for people who are able to speak English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inner.world/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Innerworld", "support_website_url": null, "website_url": "https://inner.world/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["MEDICINE", "RELAXATION_MEDITATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING
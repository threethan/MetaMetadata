nt-sin2-1.oculuscdn.com/v/t64.5771-25/39031625_887584912213658_405238416130543637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qiA1y5lSt9kQ7kNvwE08mLw&_nc_oc=Adrgk8CLguFwAcRoNCDxXqKWgbooVsXNcCjuPkzPvbAdL-55TqPLFIbHq8hObWZQVSA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoGmiLlme2EiIUZ_iyXYmocIZMQGeX9uaitQPZgoc40Q&oe=6AA952A3"}, {"file_name": "Screenshots-for-MetaArtboard-4.png", "id": "643827177381376", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031339_643827180714709_2810665641310761180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDPoTk5KWD0Q7kNvwG_xdie&_nc_oc=AdpM7GAJdNgPBrw9GZ1U5D9Y__K6zeBrbUaLbopP3-PG-I1xVSUDMtGeo9EdOBX0gfU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0F7ODKfuRcFh4uvqsoGwleszrmFfi9KB9emoWtXVkSQ&oe=6AA94265"}, {"file_name": "Screenshots-for-MetaArtboard-5.png", "id": "626593508920122", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75572753_626593512253455_5213214269128729807_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuttVc3uZWAQ7kNvwFtvT__&_nc_oc=Adqa8YfiDjT5gcqZpu92X54n_byz6JQuAEqJTKfmlxQk2dSc1hGbcG2_pspFz407I-I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW96cxaJ_5nftfa5rOlfnuzZ2-ShaztPIjEruTpvdzHw&oe=6AA95526"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_Store-Assets_Hero+CoverCover-Landscape.png", "id": "824499288594022", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035398_824499291927355_5247325726742229764_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmrhpO_PwiMQ7kNvwEMHtmQ&_nc_oc=AdqhIZpJkG3tx4W8Cb9G2VPpO5sFfIGkttdZ_b93ebE7Mfnx7eyueG4X5BShYhPbHKs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYSyC4QQo-mYXYm4_AWSK0j6kAa17N-5EeKJTPMaf5Cg&oe=6AA9368D"}, "display_name": "Innerworld", "keywords": [], "long_description": "Welcome to Innerworld: a virtual world where you can learn evidence-based mental health tools and receive support in a place where you can feel safe being yourself. Start your mental health journey today.\n \nCERTIFIED GUIDES\n \nWork through life\u2019s biggest challenges with guides certified in Cognitive Behavioral Immersion: a transformative approach to mental health support. \n \nSAFE, WELCOMING AND ANONYMOUS COMMUNITY\n \nJoin a tight-knit community exploring the thoughts, emotions and behaviors that shape us through courses, events and support groups.\n \nLIFE-CHANGING MENTAL HEALTH TOOLS\n \nEnter a virtual world that equips you with life-changing tools, so you can go back to the physical world more empowered than you left it. \n \nMEANING AND PURPOSE\n\nDiscover a sense of purpose (and make some money on the side!) by learning how to help others navigate life\u2019s biggest challenges.\n \nLet\u2019s find our way together.\n\nInnerworld is currently for people who are 18 or older.\n", "short_description": "Welcome to Innerworld: a virtual world where you can learn evidence-based mental health tools and receive support in a place where you can feel safe being yourself. Start your mental health journey today.\n \nWork through life\u2019s biggest challenges with guides certified in Cognitive Behavioral Immersion: a transformative approach to mental health support. \n\nLet\u2019s find our way together.\n\nInnerworld is currently for people who are 18 or older and are able to speak English."}]}, "developer_name": null, "developer_privacy_policy_url": "https://inner.world/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Innerworld", "support_website_url": null, "website_url": "https://inner.world/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED", "genres": ["MEDICINE", "RELAXATION_MEDITATION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO
Af9DPFep6RBJVEgTWLN04l1LasUajSKpxZ0SW8H8LFNKJw&oe=6A301E3D"}, {"file_name": "Game_Custom..._17.02.2026_16-09-52.png", "id": "2031525934911539", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819845_2031525938244872_7862210974733973082_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESdq-KgPk_4Q7kNvwGsotnA&_nc_oc=AdrCR7L6LSBxomKigVtiSOaqMYbnwhzcv9yTYHTdlaCu-GlPVL4btphLhGQcF1ylmBY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S_jXMx-aUPs-5zC-MhQacVCxv_EcEPhlIsQ5iBlSyYw&oe=6A3000B5"}, {"file_name": "Game_Custom..._17.02.2026_16-10-30.png", "id": "2145384612912618", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822327_2145384622912617_8931814345362125094_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o82Uvxe5G4gQ7kNvwHf7-wV&_nc_oc=Adr3cMT6KU5aF0jTxQ_r7C4ZaWtRRwQHrX3XS6YcYnqsMZ0WYpB_tRSH0pCIxXH-WzE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FZB2-R4Mzn76EJscC1I4Ifz9y-eUnzZOSpba0aLkUzw&oe=6A2FF48E"}, {"file_name": "Game_Custom..._17.02.2026_16-10-46.png", "id": "1219585039827092", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820441_1219585043160425_114242598349970217_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GePluvKlyfoQ7kNvwFOQoi7&_nc_oc=AdqU41p6-AzhcqYqawixhyWXIyDkRK6x1bqjcC9nX8fX-usixxFfeLjKOVDXtKjm1yI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82nNrbAFGcIv6jPbGflBtMBz0uD7h7zJpiTxH4COGkGQ&oe=6A2FF171"}, {"file_name": "Game_Custom..._17.02.2026_16-11-16.png", "id": "2744538685905733", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825497_2744538689239066_9146411503140412653_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMF7HtvpMNUQ7kNvwGo4pp6&_nc_oc=AdoAH-8lwptqpmLsfYjjdDpTLYE18L9TF46ife3hqdUS8U_RClTy6TtZpuofRvH7C30&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OBoBKY-nN_9-6-7CfwPpBimcMpHyu68YM3gOlwEhzgA&oe=6A301162"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp", "keywords": ["tag", "horror", "chimp", "fun"], "long_description": "Chimp is an intense VR horror experience that combines fast, physical gorilla-style locomotion with relentless survival terror. Using your own arms to swing, climb, and launch yourself through dark and claustrophobic environments, every movement feels real\u2014and every mistake can be fatal.\n\nYou are trapped in a twisted world where something is always watching. As you navigate abandoned facilities, forests, and underground spaces, terrifying monsters roam freely, reacting to sound, movement, and fear. There are no weapons to rely on\u2014only your instincts, your speed, and your ability to move.\n\nThe unique locomotion system forces you to stay constantly engaged. Your arms are your legs. Panic makes you sloppy. Fatigue makes you slow. And when the monsters are close, even a single missed grab can mean the end. Whether you\u2019re climbing walls to escape, swinging across gaps, or desperately scrambling through the darkness, Chimp keeps you physically and mentally on edge.\n\nBuilt from the ground up for VR, Chimp focuses on immersion, tension, and unpredictability. Dynamic audio, limited visibility, and aggressive AI ensure no two encounters feel the same. The game rewards quick thinking, smooth movement, and calm under pressure\u2014but fear will always try to take control.\n\nThis is not a game you play sitting still.\nThis is not a game you play relaxed.\n\nChimp is a VR horror game where movement is survival\u2014and the monsters are never far behind.", "short_description": "Chimp is a VR horror game that uses fast-paced gorilla-style locomotion to move through dark, terrifying environments. Swing, climb, and escape as deadly monsters hunt you down."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimp-privacy-policy/home?authuser=1", "developer_terms_of_service_url": null, "publisher_name": "IceyGT", "support_website_url": null, "website_url": "h
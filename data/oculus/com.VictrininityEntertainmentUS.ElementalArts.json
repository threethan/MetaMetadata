03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVdvFRZxqYgQ7kNvwEK2XUb&_nc_oc=AdqRnrD8Vwmchw9RcBjgzJAq0arHlyp7Gl7O_tso__ZXEQXNMPKQf1yfNe0J0NVcLag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbQGEWHtP6b0LdXEFypOyU4Lw4EIhnKsyHPZQy9Rh0SA&oe=69CA69D6"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuDykJESUTUQ7kNvwHAhIj9&_nc_oc=AdrJM3xx5bE0BM0Xc0v9-hyqTcEwM9Z85dREOXJkZEMfVhfaj0GECdrW6Uq0Q5YRCLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyuh6-BLiky6xL9TbE-EZywZkTFowXpdOGRXqeXo1rD7Q&oe=69CA89DA"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuwFoyPgrLoQ7kNvwEbqqIl&_nc_oc=Adp3bgoUZV60SoCRcuXTsbYUSAmVZjJwOHaDFW71FnA6J0t_YsucaMXgNY1Fdf9tgMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZJw7hA4iaCxWR8J9OWsVIy1iqF_W-4Zja1tQcAJgAKw&oe=69CA6F39"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBx9_ujduyYQ7kNvwGUq_sA&_nc_oc=AdpJiHEbipLqMn8e-x3pXQKZBXDNGd8dt6PcyT2SFfOjW7CQ0wXqL2mwC6JRas72k1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2gM51sZKC9DOU5xU4PVfOvYYsNFdRju9ozJqIfVhDxA&oe=69CA6810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpArfQDuYjUQ7kNvwGO4DEe&_nc_oc=AdoMf0KxsPlWEGcZdO1IgWd0ByGHg24gvFvAmyWylGvqu1IZ11P0dooZg055ctKdcXA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwqpUFvNdUjdvgEebos1A0JBEyIHa4QX1K3ejIcI_Cvyw&oe=69CA8385"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.ocu
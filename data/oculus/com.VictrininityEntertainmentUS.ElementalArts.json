03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0QnEdnYruEQ7kNvwG0FVvV&_nc_oc=AdoarLktCFiwqz_2OXwimprPfjOHDoDtPxyBVFose0FnNT_xB35b8NdfdsIJ8wKklB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1G-2HQmoL-goD_b2_3gyIxwuQNKw6s12LHuYvc94_NA&oe=6ADF44D6"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Niuv2zlsthEQ7kNvwHCxh1P&_nc_oc=AdoWBeBdH6J2EOsKxy4vZXKtqeTUv5kkkgebDtc953OoGP-eE8tOxhDK0obEoYfFUOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGqF8Mxtn0MvmqdVDO4LJLvLjK8nxaiFkl8NG0_FeMgg&oe=6ADF64DA"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BO7_GHlWO7cQ7kNvwHc0kVB&_nc_oc=AdrCJTyASEZcXiGcXMyoACB4Ds_GnhQaQOdHk2kmkGIewNfskIxU8qZJ94Hy7eYooXA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHpDg-oehhP_mUYiVpI456JaRjebQCU1wBIxXFaenBQQ&oe=6ADF4A39"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSLrlokWPPIQ7kNvwH-c73u&_nc_oc=Adoadv4XASBYVRcg4pwJ6iqptBa-KY0-ulkf2ZtOhkP1_s7hJXd52fbxFzUSJvNzuE0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdPW2xKMUnqdmjPXF3Tx8Huag615pk3OLWFvQLu28ZFw&oe=6ADF4310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozFeyfZd5TkQ7kNvwF6ODWH&_nc_oc=AdocnFmvc_Jr2rGdhTHgydecxbc_mir4Iq3LUqN8h274q00LELOtizpOlEfPLwyEo7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6lmXjEcK3-5U-HC_eh8eMB3CjEYbrhmu5V4uWgrtRNw&oe=6ADF5E85"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.ocu
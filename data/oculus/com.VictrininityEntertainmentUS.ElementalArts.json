03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UV33_qfKDe0Q7kNvwF_sRdK&_nc_oc=AdrjdIZC086QnE8h31yWL0lhTFyVTkErYrJIgF5zArhVKm6DSgzdGtIwTpsEaBD0sGY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9Sip3ExH72o_4H6NBKn8f7AVRzR1iIfc96fh52mGb_w&oe=6A9732D6"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2SJ1HAW7Hg8Q7kNvwFRg1c2&_nc_oc=AdoV79QWi3Iy6rNFizzaXwImfxqUG9CPyPFBFlxgqj5rYa8lFrbXrXXXlC3bcELkS8U&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXp0r66XJPNiI_d8qqvX8Q3I0l4uyHPXKXzy_4idq3Lg&oe=6A971A9A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSpJ6gTsK3oQ7kNvwFI4M0S&_nc_oc=Adqd9NeWQrzaVPxXhDUHpPf8lST4jF56J0gEs342AWjRcVYfWoqGRQE6vjK8K1XiP2s&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEX-7xNEXdTCq4vCDxLr3RUp-9PKeOz_2j-qFDURbGujQ&oe=6A973839"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yg3V92DnpUQQ7kNvwHwScX3&_nc_oc=AdpIalpiomH88bmMAwLV8bOlYnSDLTK7wqmL9pb7GI3V8xol4YmJCqVeyT3r4898FgQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSX9iIh1P4ZsePC_XHnlBjfZBlU_hE_oSlvAUPLes5jQ&oe=6A973110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cg32t-wxSa0Q7kNvwGIr5gi&_nc_oc=AdqsC0oWjJAj2l_8xFxALnhqFUxfvHKlWTejGaUxIZra8U_maUZta0XECBW9PFzXs4I&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzmlxFGmVZ6tqgkWjKQd-_1w6W6ungejuQ1KOOFAiIYw&oe=6A974C85"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.ocu
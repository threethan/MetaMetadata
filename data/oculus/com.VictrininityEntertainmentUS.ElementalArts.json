03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFw28k8tZQkQ7kNvwEKW3CV&_nc_oc=AdpqL8DS-_Vt57z5yNM2zL72r3eIxmeLrcI2p6lTkCiO_SupVoaMFwGGsi3s-R081fs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJN8_qru-W0nsZ0T9KAwZJ8KQuO6rF7Ybhd0JjDLjyzw&oe=6ABBE496"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut1GkdSE5VYQ7kNvwHn4ddd&_nc_oc=AdrN3atZOKibdK_J7Y8L_hOdw4XgZnjxUF4S6ZBdNgYp4dI4wKJMoB8FMnCN2ocoJEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAtXxzDHySNY76qLxrwovIV84EjRD_vVCvxacVXaa2jQ&oe=6ABBCC5A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyV2rImqBpwQ7kNvwEypeU4&_nc_oc=AdqgaePPxaZ6CQclyL2HXtXlToO55PnYOLrkLYtAZrcXUyJ3rg51SwFpZxphwhLV210&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1XkdvtD7e00Wwe_bNQC6aAobaGKpE2d2vgI_OXmhcvA&oe=6ABBB1B9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pO654UUoakYQ7kNvwE57W4q&_nc_oc=AdoxeU1MKp2c6hOHfwAqMkqV-y6xEIi47LJweTwHyF43op2FOlzhSQ51HcbwBdKEsvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKOl-nPPFhHVnR7INCJKzRs3YKsDHwPHA8pd1qYJf6zA&oe=6ABBE2D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpYeybpaud8Q7kNvwEM-fGS&_nc_oc=AdpHBU5aN8azD7b8V5Vpi_PSf0U1eWqXb3RS-BgiIlYMxw7cuAcBIk7Fc9m8S4KGSSs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4QhLcK_CN7xqVcJG265ZHh9_9oIYrkcWxy6elmYOfEw&oe=6ABBC605"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.ocu
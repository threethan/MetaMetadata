03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeMMyO3d830Q7kNvwFJ5zKq&_nc_oc=AdqtEYz4VGohe1xrKs-R5mwnkECj20esKoDSiCaah9a_UDrtpajCCB0xp2IFKuS824Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzoO_JM4eE2z71qbhpA_ytB8YwVLxmgwKAHEWwcLhP_Dw&oe=69D10156"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTys80I4c10Q7kNvwEdlC4c&_nc_oc=AdoTl59e8BaoUbpHGXqUiYMpheWydbuWkVtBADTAAGEZUS0MsKPkfS8f7pggF-nkx1g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyAS4YyrezFO46grMNJigyIB2ylcHrImHyauwS29IzwMw&oe=69D1215A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgpX6gir70kQ7kNvwFk6D3w&_nc_oc=Adqe1_D8Myht3NceocLHFmIITkCBSAAv7Qi61kKlruUuRoF0FdwBUON2-CIHxaUfPnE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhbD7SZpf6WhxB2K5gvaQYs_7Gmz6NbirCc252una9VQ&oe=69D106B9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IRHGcbmkkQwQ7kNvwGfoSs0&_nc_oc=AdqaUuVvLk-rc43Xg67M6gAVkB6C-3y3vGy-RGbnPwBuPGO5qQdRTv8DfN3hbHs5tJY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxg5oFoPyg8-fF7oibw5t6_51YKmpO-xUjNG9ql5tmhXA&oe=69D0FF90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4knVIIgoZnkQ7kNvwEzLzku&_nc_oc=AdqzApJWNFpcFp7ZRebANtoXBxTkeSyJhnoii1IUnjDUHeRGCWQMVkt1xeOQKEtvnBw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYcTTqQma8N1ZfVqmpMO4zQqfyowWGVKuEQSGJ33mZ4w&oe=69D11B05"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.ocu
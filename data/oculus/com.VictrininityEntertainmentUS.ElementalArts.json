fqQtEQ7kNvwFPiUL6&_nc_oc=AdmKVdGXdBsq_uBfbOM1fQpGRjmjflGwEmIMKxNP1nHTeemjOe9FXpITgUnsAsvDvIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzqfSoR1r6deSo60gcValP75z1rV7FeZtF4oexyV1oM1Q&oe=69B7FA39"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qV9p06cgMzAQ7kNvwGyA7-P&_nc_oc=Adkluk45UR5ZqV2RNwCDqo7uywW4ezalglAj60iurZHl9CJCOFzRv_sJ2pw93WjJ9Ls&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkSUKjvKcJedzFK2pnNSUjKZlOs7lpi8NFND_8ccS23w&oe=69B7F310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWwXRVrkk8MQ7kNvwFc84q9&_nc_oc=AdncKh69doMsJR8QMJHQEuwD5dY8qNGKdxAqQ2xdoI_L5iA_Jat7pocCUPGRFSD6Y60&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwvPZgax-qKimU7O3Q4UE_o1zbJeoGkij4VWI-jGFNLMw&oe=69B80E85"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_n
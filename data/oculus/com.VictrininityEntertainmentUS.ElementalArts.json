03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5OGcoZG138Q7kNvwEc7pWp&_nc_oc=AdqTE1XvBzbrkocVWNSXQLK1EjMQQdPw0s-gBgwEhxi_I5sebFo2g0OQitei2QItsZE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvVkpi7DutwxkL93_hHVJAU_L6DDQKOvats8kbBzf6GQ&oe=6A4CEE56"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ex2kOZ_5REQ7kNvwE9tzwv&_nc_oc=Adpg8nZoiyO_VXWli2UBQgHB-gXpXDD3KN3bAunGF9meM5BU_f-mMRj2SG9wql2ulLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiSNgLfdw3hbiRPVBDkBhmJnvctnJl9WXp0YtAn9hgIw&oe=6A4D0E5A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6P0NDLsG40Q7kNvwGUl_a6&_nc_oc=AdqeQLJzFhW3vFtuk0PabjQQi-lljIUS0y-H5qKj2iVHMP3qR2CYSbOEkOstEgYqexM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2VjaXEwGL0jZT3adf-vhXYgzW8VFyd0zzjA2cBX5QvA&oe=6A4CF3B9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmmkICQzfmsQ7kNvwGW-_rf&_nc_oc=Adp8aYf2Ym0WW-7gKS3m8Vhwe-bEa73HdOcJQsINpL4R29dQ00L8fQX35YjWBYgssd0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOqlKKQiW_dp0VjcMN-xGdf9gME5-WHtqFw9XYAbtb5Q&oe=6A4CEC90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnX3-v8wYKIQ7kNvwFybWxr&_nc_oc=Adrs9Epn1KzdmS4EhIfwW4b7Ob-4Y9Xq9Jv-cE5b7J58ONkrnNZe1A-ZabFtKmw4F74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDX3q5xunaTzR0y_dpsk-DQfNV0BhCIPW6S9TCI3Q-t9A&oe=6A4D0805"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.ocu
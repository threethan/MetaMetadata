03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVshrBrE7BYQ7kNvwF9lL70&_nc_oc=Adp3abtRUZ4X_f96V3qF_n2uf_2Lyw_xpQwtfB1IKaT8-btoknZP5zq6mKHV93LW6X0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTDCcfpokNc_LIys6Bi0KTaNy8b-04voBFgoySxGbrTg&oe=6AD0FC96"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0-xWbWmsjMAQ7kNvwGXt96B&_nc_oc=AdrvGQKfVV5c5hpp7tVBueofT6L_-qHhW-h2udguKOLKCzkhm_QZ_tugV29tYiaQRuI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-IKJDcw-cTNbgJ-u4Y3WMGsgJ8zcu5CVAdJgxOd2NDw&oe=6AD0E45A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJyjWQaDBSEQ7kNvwEHvZo6&_nc_oc=AdpyCf5wG1ZvxrRGgqgg2GiedHm-1gV1-tJRwzDBtc0MDhGru_Zh_jGUV9KMKDqyR8s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrqpfnmcFnMXLF9NRFlu5kALHukVZccmt0Yf7-m8HP7A&oe=6AD101F9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk03a2Ky3s4Q7kNvwG1NeMr&_nc_oc=AdpDr0ibB9ug2Vh4S_SzdlRb5j11xC11fZo0IsJ89WZN5EBjE5qZN_2fMdnXm_FIKX4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEVpmlOtotyw4KZS75PBeAe4CNi6xX8qwnP3Quu5fm-w&oe=6AD0FAD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0cRrDUBCU4Q7kNvwE2lVaL&_nc_oc=AdqEkh5_q0ITKEgSxhtlPgf42t-tKaERiuAkqguJJxxn5UBn61O9hXVtgDj0LGbeKOQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNldaXdyo_y9jw_OdO4YE68BfPWzf7ovH1rLOPmUAxm1Q&oe=6AD0DE05"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.ocu
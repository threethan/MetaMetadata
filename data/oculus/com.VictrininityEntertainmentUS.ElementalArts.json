03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pposSGvMY5gQ7kNvwHotcD-&_nc_oc=AdqlJPBeoBmfpkq3JXolNaynDZLeuDB3BLWJR9tlr3nELsT218Q92hNZ_JkQNuyyahw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXjv1CXMPBHz2KqNlmV-bwQo5X3RdpO4TmmbTUYvrYnQ&oe=6AF49516"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mroZsw6PuQQ7kNvwER-9_g&_nc_oc=Adp2SRpdsH1uoI1Mz3ITHUjexRTjfYzIAy4pAPdI34YnUw0XxiNQ_hQLRHV0ZX0SU2I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGpH4JLPKPFk_P0PAoxttFM4v6be2UxWzFgo3WEscOuA&oe=6AF47CDA"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiRAUN1bPwEQ7kNvwGStA_4&_nc_oc=AdpvWG5XRL9MkopZ9SOEFrBwharKZEA7h34H88-Pk-5k55FaaI1rtDjhF7YG4glARiA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI4FbXRYuiEMQWN1VQmysJKaHekcfdDl8b7Rb7OZbhZA&oe=6AF49A79"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ejH2oNJxz4AQ7kNvwEHLFDk&_nc_oc=AdpyvcCzYLIYbLmvUs3_89yWNxOoI8t7fXCXMA2-8EVVlookEIrUsTnzdQJbVApqqvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8y6xhp7bIBMZIAYUBBy1PqYxQHSUQm9svtWDsgxxqnQ&oe=6AF49350"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EmmL2iuHvqwQ7kNvwFJz9k0&_nc_oc=AdoDVOgRLrkGy0hlnOOqUSc8KSIW_LjVwHqeEfXQL00lTTlSM-i5Z18BPA3PpY6PrPc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLr6tvxHAh98IMe00B7QrRquCEWrOLGKSIuqhVr4SM8w&oe=6AF47685"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.ocu
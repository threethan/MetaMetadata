03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdpUl99z9yEQ7kNvwHbMAkH&_nc_oc=AdpLt7B6lON8pqyzeXGsWgwsQFAzsYp_HRbSIn1qS34OsfjBrpJAQghKlbqfGMzoCYQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lqZMcnCBgMd7gyrYCbtSB4h91MSHreW7PHFNlF25Meg&oe=69FDD456"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zisAkh2i8pUQ7kNvwG7cu1c&_nc_oc=AdrJCRJwfB1z1H6XKiDybgL9wFQZBMGYN2T2Mq1yV2Zbh2jRWRmKvUVm8Vo0fbhRIxg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jTeyt_Ri1p1OldPcHTI_EvtMLpYr7sRaYH6a7FQW-Qg&oe=69FDF45A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ki100Zr47W4Q7kNvwGn_g5w&_nc_oc=AdoX1k1s1W-N4JkusQk9vKYuj-6QdiduTfrmFKCw-4Koj-GhyyMD3Yjf2rL13IdG01M&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N5ULInccK5bHE_-niC9FhNQ7v-ZqKOk2EqtOnZhk_gw&oe=69FDD9B9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtQmXPLqGI8Q7kNvwFPEttu&_nc_oc=AdrS31Ak6FnxGlEI9Sg7RJ4IlBLOSzGVm2OMPmmwcZxTXl0jUTJZfcaTtpXSlqMYn_8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yxOnb7tJ7bcIhE_zCdEfO5FEZo0Ceq_w2Xk3GmNF6_A&oe=69FDD290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NREzE1RQL6sQ7kNvwGmHds7&_nc_oc=Adp6n3ORkyfrunRPtKm_ob8SMWR21-oCeNFGxfzBOQSAkOpr0PCZX_Xzh8HovG-2pBI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af622MSvMAHitMUTGpsb1-rANODePTD9HnPT7f3FX-_Ycw&oe=69FDEE05"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.ocu
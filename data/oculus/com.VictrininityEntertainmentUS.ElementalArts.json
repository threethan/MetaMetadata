pymEQQ7kNvwE8spDR&_nc_oc=AdlUi0rl8FrTyP6X1guy5tpCHENTBpsbTt3RbK4DA-CTinc7cpBNGaUPUsOR-kzB544&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw2m492QqF6nsWdjrFcWTFJENkS5C7wRMf3JhTeCxk5Aw&oe=69B405B9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hWfKpXjh5oQ7kNvwHqNU6z&_nc_oc=Admzon2PTIAlAaAiGzU6prJODIKZf1GpLc7Iz-qypzd2SSiMggBEyqI8vrWJgVqG5Oc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxqdqUCWP6DhUHIDUvrNu0oUq--ofIy5oH47TUnJq69CQ&oe=69B3FE90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oeeZs_BQmkMQ7kNvwG1UdlH&_nc_oc=Adlr0par0AuGHUwfwon_Iub2N-MkF7K3N4OQnl-HhBiO0kEB0TuC79QPqt1u-BjUVSA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzQC7qMNOe4Mq1RhJrHKJkQD4ybaNX4i9LrKz4nZOudjA&oe=69B41A05"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_n
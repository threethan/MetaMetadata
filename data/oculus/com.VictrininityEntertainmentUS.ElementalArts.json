03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aikzdfM48vMQ7kNvwGPvqMn&_nc_oc=AdpqhpB_YWNJlmbIkEubV_2ta5YLKvtV6_Jmn8091SwjEXrUbN8-BNpiR7J0Jx0K8Vs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55W_FTV1r-pOJkMMPKl8T8fwHkYjtbrAHN3WLhiq6D5A&oe=6A046BD6"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4unipogzDhAQ7kNvwEbEYa2&_nc_oc=AdqvmkUyXslja9Y0Ba18G9lqnfAbBG32aOfcH097UlHepCDT-qfLv1oSFwwhTyG2AhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AYgzgIJ8_BXoKm43iupgmghNWlqZAD7BCqOysJCaMTw&oe=6A048BDA"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_38L94u9HUQ7kNvwHgscEK&_nc_oc=AdoNUl1xFvqo_Qta4uuP5XYPYaE3BqucbFq1LjKmmLoTyWzGWFwFtjh3a8ZQ4AbcBDk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QLaLBSeMJ8cld_4M50toC-7bQp1b-b7d4n0C5gBRJwA&oe=6A047139"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUXsjRIuAJUQ7kNvwEDNbwP&_nc_oc=AdpjS3oNvzFGWi2tNA7ezRHay6l4aDzWaF_rWeEm1wsGd7nx7VJPhCFjoxIXdZs-CuA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uXDoU6h1hFBkCj6vBoG201TneLam1dNzXQQSmRjoSCg&oe=6A046A10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyOs-MvXw_AQ7kNvwH8RmL_&_nc_oc=Adp6mmxj-OCFAapxNzlSHBm5UivRKBOsP9FBj5eaIlOKhveKtIjTRliqNd30scwXa5Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WnaLgKdjd0jzbTUF19PGj6B8dMtpPVAe3MgeLOtwy-Q&oe=6A048585"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.ocu
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p821nHz1XVcQ7kNvwGZ6GA6&_nc_oc=Ado8TF4ksH5juQateVW5C5j22toIW23SPjeoJdKndzz3V-2Hz1tLVMkofG5gvJRoOno&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvzTKyQgruB1v6Cv2zKzBM3hcNXmdffEbElfSSu7jpAA&oe=6AEF4F16"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1MGgrU8zCsQ7kNvwHbsAH-&_nc_oc=Adr6BW3CFXAdCMl-4ZFlX3K66OHUQXbZblE3m9jkYRCDg-NYv5aVBqUlmRculAs5mZ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_cecnN-V99xcI4CjlDIck9gXLEOCgBsKIWMOK7toe4w&oe=6AEF36DA"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_qQ_Wtn6uAQ7kNvwE9BxCS&_nc_oc=AdpX3oXsMYK6_7fjKf8NwpQf4MPTKcLrayCnYe2H3CZJU1KQf90hfpa92JHorKFHnEw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShRj6r672HyUNafnaukIajdXk5Kvs6eEmeQqjZHeillg&oe=6AEF5479"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmsqlFvmOWMQ7kNvwHWTx8F&_nc_oc=Adpx1NG1cflCv9-g87ikYh-2jfpde7Z2jvmDlyJeMPL_1g66AxupfIooE0ZhUnVHr3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqgKWLq6MN78tWA98Ce-e2WXk6AvYu6MD9S9w9iVCn9Q&oe=6AEF4D50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3rjAIgHIB0Q7kNvwEg19dg&_nc_oc=AdocUac_ZIw4HTTS1kBr4CnI3zj-bOzl0v1-JptluFRhfBIAJzYj72zkD0bsyWTPxfE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_koWZ4nxVPakZ3ReKOvu-7L5qFmK2uuERFjP7ulmPcg&oe=6AEF68C5"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.ocu
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P-wyQZeGry4Q7kNvwHs253x&_nc_oc=AdojcU0CzUWtqPyaJP4r-BF9WhKhLbB5xZV1k5u5t5p-zksqjSTk58xA7Gs5rNJBXYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg1Z1b7pCknr1nW9kXcaBcTT-uRxEKR-ODvLruTHjcWg&oe=6AAA88D6"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LllQbHmqc-8Q7kNvwFWEZOv&_nc_oc=AdrCipmNZfc4XKkWlylapr6vvq4YomfZZj88gv3bnJrSIrvjZY5a62f70GB18mX1WUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLxhaAOwYFYQjZokSXaqqnFTV854fOI2NVzR85LqocKw&oe=6AAAA8DA"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiL_0FHINxsQ7kNvwEjdE47&_nc_oc=AdocJwxYzw_3J_2uSjI6k2YEQ2xn7-JWFa5HI1GmywARg9NTBx5Ann7cquKWBLokPqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNG9Sc8biG2SbU1dcERCu7zkpBkLKuDnMpIib09AN4qw&oe=6AAA8E39"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toaBn7kCh8YQ7kNvwGBeAsc&_nc_oc=AdpImVKB0gvW9SsC44O3nwft9IPbgoyTB1m8Q5cvzKtZkKsyJaVdOP1zf7XjM6FWlbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvUkoHIR--uHomD7MZFEimeb8DhzJvGWzYW8I_4iDYxw&oe=6AAA8710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LG8NZBRVyPEQ7kNvwHngdGG&_nc_oc=AdqMXcOGN46-JU4akCP_xFEuDNaTeMRkQoieae9iukTuy_3q0iZSEaxFqkRW4W_dtF4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq-Ou9n_lT6XDhGThlvEv0gfuGy0bQgMtXCQyapvEo1g&oe=6AAAA285"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.ocu
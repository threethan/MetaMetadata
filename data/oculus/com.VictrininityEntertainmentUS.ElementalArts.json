03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAlko1TrUeUQ7kNvwHjGm0S&_nc_oc=AdqITgFepOJxyJFkbmqEDCjtMAIbsSa4K7wf6jKwrnqV9_4NGy9B8QmPJcBuBpjWuy4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKYonCyy55kTT1K73a6FTEzovNxb_OUDQiPOMegprUdA&oe=6A8AE4D6"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h7xhTG_nRUQ7kNvwEANsG8&_nc_oc=AdotSo8RHrkELugxp3e7Jd8PUPjgJvduP3FsPT59aPTY6JuapbmcjMTU_x2hnElE8RQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3KBVKIgdiOyJGU18VZ-ReJNjg2C_ErNvyT2c7Zi_TEA&oe=6A8ACC9A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGzAWe6OhqgQ7kNvwG5R4SO&_nc_oc=AdqWbs_QAx4wgUGx_bpwUiocnWUO0aLboiZArlR1uE-BVBt3alGf9-ZJQDRIqBUVluU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMjmgtVX3tAgiV6SVcnbPnEdbY4eJOWKT1c7nSG_wr4g&oe=6A8AEA39"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLRT0cB8dz8Q7kNvwGdXH8Q&_nc_oc=AdpKZEXk3kJ_0Ilgi6iE3aGJTWyN2ROWFIKWKrW0BFdm9YaLNKeyxIwYZbthxi1-HKQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgdY3MIVKGHOADgyYTIY5DUX2ig5Vvs7malx_YKe5T0Q&oe=6A8AE310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55mkq2baDi0Q7kNvwFMP5xB&_nc_oc=Adoa5dIBLXgfH2YKpKliVydUp4550AKkKl8VPY0-z-lJQEYO4t_wZ_ld1nnlOX9_6kw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAN3uD4LqsCj8W99yFzRQrlf056C7xUFF32A4l5MiT6g&oe=6A8AC645"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.ocu
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1Bz8OkiLTgQ7kNvwENJYX7&_nc_oc=AdqSqqsEBCxXEwx2YDGAC2zimW5cqGY5W8rBhr7z_yPHxWrAk5m6CM5eI4rVL0W7rsY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_TjflQjwd-6Sy54RxWt8Sq5TqzgXTLKj8qd0oKW_Gvg&oe=6A8058D6"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1X3kkVyvrgQ7kNvwFtmAnD&_nc_oc=Adrs6PuY4TqEQG32s70ORruhBbFXdpe495fjDPySNK22M8A7l9aN2ljozYsHzJLpoko&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSLCljEYmeM6YJSDIt-33zd_2iTSFFZRBNwIhTAAqIFg&oe=6A80409A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpOPpRJmALoQ7kNvwGNbkCb&_nc_oc=AdouJA5yg_UxHA7J3OOk-8ADnUPrkEgVOSwkP6yIcW_RErEYgOc51sNDtM9pnwrRnNQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ5GmsbJVmIU1UbJxHIcwdIvKL6SQ_v8zziB4CI9dsXg&oe=6A805E39"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPJQCnb0RrcQ7kNvwHOahAk&_nc_oc=AdqplFacN0VZwxG8Vwd5nCU2QFAw-h9KgZjcyuR7caLOqrb4s2Q-8JLSBEDbtJ0oqEI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGUb_gnNm5XC7NaZP3iTSKhIIHl0bVWuEpYn5tisZuMw&oe=6A805710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsVK_x4Opy4Q7kNvwF-RgZ4&_nc_oc=Adp1L0b_H8Fy_DkfvpVGy6JbthxXSHLHQ_LO_R8IbxRDRaCll7CYtQMuyGrsm-MXfRE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwVsejALNLE4Y1vwDe6yBdR7bcVaz_IucPh--L-76oIw&oe=6A803A45"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.ocu
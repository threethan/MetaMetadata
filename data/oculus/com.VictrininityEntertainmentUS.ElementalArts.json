03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEx55zIfcfEQ7kNvwHgNQWV&_nc_oc=Adqm3pXVf-et7wuiNWhmaelMs3-4G7KvAWEZ3Sf44Udnp-Lwox05PlsaStYq83C3dTM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af801wjxgrqYb5l3HtAK2m0kmWwcCJERr7zymMiYVBCMQg&oe=6A4110D6"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P2ZfqwQ0GoQ7kNvwEG4WTT&_nc_oc=AdrEdMy-s0O0XhrO0gyitZ2AZkVVU6oi97QNLzcKDdxAW96OOre5-jun6UIE9I_q8MA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JgiRWuKawlr2qgQLno3xBif3oUttoUCfHFYWtetYRMg&oe=6A4130DA"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NgLvuu0zAEQ7kNvwF3LZo6&_nc_oc=AdphzB-si6iyTlA8vEI2lSB_0EBiv7r9-RyW5R9lkoX0JaeXfEY44rnoL_OAJdloNLY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IwuRFg1svbPwe42Io9z7kxwnFCEGDG3RmCSZ7VYds9Q&oe=6A411639"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShL3TD1BZZMQ7kNvwGyuroU&_nc_oc=AdotxuxHlJWsIaQ-kzH5uKUGeJgixg-J_MX-gG7y40Dv1rop-4akN6VzWvCR8zaVAxo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G75Pivxhcnj2vHC-9jEsYS1ZiwAP8bSEe5zPpb-NYaA&oe=6A410F10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=proc2_IIzJQQ7kNvwH1alV-&_nc_oc=AdqgeTDc3hvRCrAQg67RynQbDTUjx7Cemge5F5f0wkk-JhwzK4zN3Oz9MjkUO0Vb3lU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_rp5BeRMwVzKrPmUHHFv4b82jCEOSQH_-bv4-k56LrQ&oe=6A412A85"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.ocu
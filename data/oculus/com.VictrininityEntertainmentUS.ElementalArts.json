03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvTeQfYCf1EQ7kNvwG6Vw_C&_nc_oc=AdoiqFUrxgly-kdQImUEAsPZiD_-OHmN9U912oGTcOp3TP7W9ti_HF6e-9wyKrQoXXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDcPXYTxLmMwaMk0wipI4yqXjORBlsz0MJGg9H8vwijg&oe=6A674C56"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n8b8_OGyMcQ7kNvwHci89e&_nc_oc=AdrFcwDNE1WPQi6_80DgFc7lqv6kF39VowZYYDSuhjx3YhndZoJNz9y1lBEVkPpxpeQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBydoJP-u6IvkQ2NVDHaQ6yUcyJyQzSiTHGLahBHVD8mQ&oe=6A676C5A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZQC2WbX6mYQ7kNvwE5cGzU&_nc_oc=AdqbJmj3G3tod_i6Rw9NiczpV1HoGg6Q6KMphwwEpT_tCbk15zGbCV3QLUZ5ECrUzWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-bQ5-pes7uNBRYzs_TG-UyYUmFCwNQSpKuBgqVpvKYQ&oe=6A6751B9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDOLUtAgxC8Q7kNvwET52JF&_nc_oc=AdqL1KRMBw9m5dLmnNnDdTeF50zzdt1bFfg_B9PV_m5YYxSvAoaC7iO0sAkCS8VVtio&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD67LT6kFCGyxDQS7wa7yYmJR-oIyGgtL58PCcopqrP0g&oe=6A674A90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuU0LtExiS0Q7kNvwE6DDiL&_nc_oc=AdoIT4uuDbHmQfQEoESoabkQtMkuc-mAtAkUH9CFZi0mF-PZjV5-341pE0etQUo1vAw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkXpC4ZZwIEEBo6iLXknlhQhKB5icWuUBf0rN-0gPdJQ&oe=6A676605"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.ocu
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBWW3esdjZIQ7kNvwF7KEyj&_nc_oc=Adr1MttArQUgFXFXhBwMpMr64uPBMNgmj39FqcV3eAjZFM2KHxvF-FoB4sbyZGo1Zlw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JkndT1ByT99hrATSs81bMQdeJyFKMJGj6TG3DyTh1BQ&oe=6A32C896"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HW2DwonbC0QQ7kNvwFlprU4&_nc_oc=AdpWTYcETnFh745Ve2ICGHR4DzTGYQEiuROAs93tfzMwuAk6jDfGmAl_fW7iBFkcrrg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86RvT1CAA9JlI0QU6zJNxWhWmEDUN2wa6udhwwG99_oQ&oe=6A32B05A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5A1WV1yme8Q7kNvwHJA2Ho&_nc_oc=Adq-1c1GKoHF7AMjb6_yJsj7ivhKU9IYbrLn_95mjTfmzi-FR9z9OExosWD4n4xrZTY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-34CT-nFaawaTyqCNT0_k39f0uOqe9QAA3ttVCZhwBZw&oe=6A3295B9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLAL2a7JuPcQ7kNvwEVstss&_nc_oc=AdoYYz-I2O2cNt5A8bSTS00012BswKjp3ZMONLbrraqHxMARoI9jRbt-sTyC_t88GRU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-dDsQmKDHYptoCkIPMlkCdc1Fr19Nb0RkxK_wI_syew&oe=6A32C6D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xuMOHe9aCiQQ7kNvwEpLlbi&_nc_oc=Adpn1UXzMrpm4S4tcaQ78VOfvK9-m0ZUnDZJ_sk06brD_MTRuxOQ4BtFFjuqV43FgYg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZFQR5ICtkZdOOki8f_kWXYRsqJ81OzGhtli0A1tUe2g&oe=6A32AA05"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.ocu
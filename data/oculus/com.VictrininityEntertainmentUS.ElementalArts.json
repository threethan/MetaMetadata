03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cegLGVTljAQ7kNvwHT3Hm0&_nc_oc=AdpWXNlVezoLC5K_1qgwOYkrWUvAG4-qmCPRg_TX6N5k_d5pIabGUsny_9r5p8iTvss&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tFeCFb5mzEeGuYE0NQYWQpsOEwlPinG5niBT1waK6Iw&oe=6A3D5496"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uq1XOqbjIFwQ7kNvwG2g04u&_nc_oc=Adre0mD94d2CqHpj5szqTIRU5PfTuVyvI0uPUJdvQGPyurZb6v_gP9cgu8-MRYI46iw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RBMOE2HeQLk91P1OxgP4J9FxfLzLJtBNwE0M3kpXwJQ&oe=6A3D3C5A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b0aZ2XKnmS0Q7kNvwF6nF-d&_nc_oc=AdrPQH9mwNjPGLzeUNvcNyKOnwhdJYb00z_z1i8gpdXD2-Uy9jTlCvIW3E8TyBamQbU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1s4uMvwKWjpcme7qohC5Ey6JYr4t0sb3Cb4a7VxXnBA&oe=6A3D59F9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gNh9PirQM0Q7kNvwHIVVAm&_nc_oc=AdoqwpoRimWwWIhy8fbOTU5yb0EBloHne_o1SY5lVD1BbpZdPlqbbf6Agdub2JuDo-w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hvdZ1L4MbjY6mV4awBKbUomvXHET_CaEmDDbn0k2dBg&oe=6A3D52D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVbGlilC944Q7kNvwHap0Mq&_nc_oc=Adop4dWt8OvLJGJ5duRzasbBKeYwHwL6RqqRE1HYAsz3JN7nNkVBNQnUmqgdgTHxipU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SYV-hznm9f29XJLA1Vcay-M8nJOVjAjDpcGT9TomaMQ&oe=6A3D3605"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.ocu
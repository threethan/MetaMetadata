YyHPIQ7kNvwE4CuLK&_nc_oc=Adkgy4ChxS6G55nB1FvjqhHaFgTPwkU26V5B1pHMSc7VCpkIV9WsBF7yh6AmqrSJCLI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4IplDjt3OK1AZJ8veLg-GfJbizehRcj0Z7-N7jxzrtA&oe=69BA9D39"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0QJSPXk73wQ7kNvwE11nay&_nc_oc=AdmBKA-4Gve8I8rpZioRRKVJDyteenpMQx_DTE0YKTrAAiI6GgdRq3TAowuhmUY84GQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzylTXYCvvSPVsmEsaOAscGAzcp0rG8dyBEqmX6OWTXXg&oe=69BA9610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWwXRVrkk8MQ7kNvwGCV9JY&_nc_oc=Admjnq45yfNQKkALAqi7WSiz-AoCy7kAwsd_lvvPIhAYENKQT6b0cR3fF6eNu9suNyY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxIvU8LPQBk9_3A4mujv1I8qjzOSGV93JFYIKgDmx5TWA&oe=69BAB185"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_n
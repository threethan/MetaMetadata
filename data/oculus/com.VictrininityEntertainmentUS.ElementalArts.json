S77csQ7kNvwEs5yzj&_nc_oc=Adk6gqLfKB8NyNFImX22rXr8PcLNNPC1QWKKuPEqcdQC6EnnakeCKzE_zJ3k6HGrSRw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4mFydcPkPfHAc5oXkXyEk49dU7dsmHE4-c5m_Q-YbDQ&oe=69BE91B9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFS65V8Nq2QQ7kNvwG4lEka&_nc_oc=Adn3-JUseevcTIeZ_JJegryHSRLdClcBygHInL5a2eojBPWZNQetlz6zKQxiGkvnN1c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfweifonkOxd5xzFKCknJXkNC9klwzhnRgvc5M7uN09FTg&oe=69BE8A90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppSgXm6kVcYQ7kNvwGb6HrG&_nc_oc=Adnq8eaKhXI97J7GwrnI1pPGJ3Eg9IIjI8AB7GU6DvQ5tBNae6LL0m5q2INphao9ydg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afywc8Acp_D851-R5RBdTzksZ_fCqMfi3Zv-Vyf1dtUtEQ&oe=69BEA605"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_n
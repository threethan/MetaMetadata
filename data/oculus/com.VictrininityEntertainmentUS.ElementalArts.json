03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdSzIPa0bp0Q7kNvwGMo3Ql&_nc_oc=Adqy37qP7Dds-Jsa49WGmvd_vZ1ewANPilIve7gNav_bn_YX1N8ggm4pNPrRrMObkeM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEZ91UK_MZMaUQYwtR_i_fnsoH0c9pgE29OpU8rZbAnQ&oe=6ACBB696"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EdOr1yHzOsQ7kNvwFvN3cv&_nc_oc=Ado-UYGUfc8_ayidpNAoTqU8kABQBZZsCt00p2Ks94E6-9YDzg9Tv-D_2K_3vHr504E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaKIov3fqehJGwA5ADAh47CSOGViXD-vqW2cl33mCL9Q&oe=6ACB9E5A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq3pFbu-BXwQ7kNvwFVs45W&_nc_oc=AdonkmHDIixGgyKoVM_GW9T2wrr1QgUt9sfOzZQDRhs207UDdGNZ_UDHdjf2ZCR7VY4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8V1kk7-JFLSu_M48aeXM0b2NQ7z3O_3zzdMaugCDJJQ&oe=6ACBBBF9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dpMblUu3LsQ7kNvwHIuEHA&_nc_oc=AdqSSAhAaWA2BACxbfdfx0kX0PMJ64WFdTAFgKeHFfbWqdOqUuFuwwfwe7T4EQcF8tU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSg6FNWx49C8Y0R2UhLHnMjp2fphNSiaXBWziFzcP98A&oe=6ACBB4D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nsOpkCLsjgQ7kNvwHayy8e&_nc_oc=AdqcqjUTcye340eDv7CH7GOIbVhaCWiC26tE-u5T5CS1dNK3JHZwEf9tugFkLn8vwWA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNp_DTcWXSncUK2VjjjNjtlOzLjPE_jqMKMBndmC92AQg&oe=6ACB9805"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.ocu
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMR1fkLtGjEQ7kNvwEIi8K8&_nc_oc=Ado17s2bMID9GbZcVwF9ClZfiVb0YQ9ssy1Gy7kOdpJ1STlw77vMnchsClyz4jVQOH4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApcUCWliQNuhUnelD0heKab7wggAt_48UvkR1mtAkcnA&oe=6A64A956"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3n8b8_OGyMcQ7kNvwFO_6dd&_nc_oc=Adqmcr8ax4SVZr5V4mcKNTLDA3h-3YgU6sX3VDzRDrqD-xCnJnRLOCZEuCQBoSCLrQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU_iJ-HOy8E2-d7egKml4OSQ4_Tmoth8R3F4YNYEyyeA&oe=6A64C95A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG72UHSHTOAQ7kNvwEjHJok&_nc_oc=AdpB9rWhlp0rkUgQI98qoq8WelT1d_jacUykIxxpFqZL6Ma_HMWDdypbJyYck1HxT38&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2L0M4VPz4E7D6LFccdrEv7UAtIH7oWll3NDmB27ur8Q&oe=6A64AEB9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pi7MCmV2SlUQ7kNvwFPLj4P&_nc_oc=AdoaWHU-oJEmNlHPE_DDs8U9N6KBkUdJT62e3sCQn6nMdVWe0yMiJ1CD_zV0uFZUWEg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBARDyFppYTAEPohIi_EBMwB8hVpRyYjzx3cIB0PZZz2Q&oe=6A64A790"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXb3bzF6uogQ7kNvwGvd7ue&_nc_oc=AdqbVchijJDDGBLDqdi1xVCo51rcfbKLPiTI-q3TnYE923pxSL-Tl0fkrpmmL6nm7DM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrqdzpxNrnXFFOrUJ7nZyOivQmTmGKWnQJoIi9PMObDg&oe=6A64C305"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.ocu
AW_RYQ7kNvwGoYAUw&_nc_oc=AdnHO-4uxiBTLBv_4o1JUEQW3Gkru6MFkWWhgh1GDQXoEdLOF7Cmg4ReMtcult5NXBM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwaQcOX38tdM9tSUU1Rje3t5CbyBdXg59gmltD0BDm0xQ&oe=69AD6E39"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgSOPtLRi_4Q7kNvwEXoVTp&_nc_oc=AdlpGu1nlP9r8nJOvaI8wXdWjuDS_IgMNgCsJYOt1wm72YVUZrmopq2bnqa14Ri0aIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyW3QAjxMv6vvsIY9faGkWlq6CyRUaXUBIvTGflhwB1Hg&oe=69AD6710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D2vWnBjLVmUQ7kNvwEZQWzM&_nc_oc=AdnMwxRZVyrJYOBzgAkatRS5DDExvlTLZopwr-in0uv-g5Z8OwCHtH5sgbqUCbMbZWU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHp4bqPCtr7pxpQMTIabENtv2sphf_OvaRgPu6OgI6vQ&oe=69AD8285"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_n
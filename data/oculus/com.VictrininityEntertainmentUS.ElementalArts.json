03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIxoq1jWkOoQ7kNvwHeoQwu&_nc_oc=AdqxSWHpESNfTDubX2kZxXq4O2GQKd0LzmFTTYjXZ5Jv0iEmgJdrEY7s9vXyiOJdiM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgkK7OUqrCa4q0haoUt8vHfLkxHg_ZoDjYbqPu6iRzNg&oe=6A4A8396"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clL8BJm0kJUQ7kNvwEKGSix&_nc_oc=AdrOkMYw9Jx-km38a3Nv2YjGHBVtmK_gj8yPL6xToLdejsmtqJIrzEQncE853KKCW6A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFXkYyBBl72yX88hOuZCCIAB7dva_5kzGSzmIC_KZjag&oe=6A4A6B5A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ft1s-rJ_7ogQ7kNvwH6H2rR&_nc_oc=AdrHl_o5ssuWTd585oZoWbIh_yHzmIFpBemotNoY4cCxSe1ERfc6lMv1_Y4G36Jk5FY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi4UYl-nX4gWN0xcKaNkqpZHvZnqmvVRN44Baqivcz4w&oe=6A4A50B9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FboGzObS0WQQ7kNvwEF2OcP&_nc_oc=AdrvFUBpwcpEPPHPJUbYFXBDtYqO2R3Mj4RQGBEdbglVLWkY5Slz4xKX2Ks1TRElTOc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUuKEnlse23QOywRbE0r-ActoCjDff6Jcen39444ZVsQ&oe=6A4A81D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnX3-v8wYKIQ7kNvwHo4GyZ&_nc_oc=AdrfYxejE3VioY26ZRcfJtYVTYSIWO50MhSPmUsGMSHyYia8ZSnCZZQFznXVU5shzhw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmnGgwJoT6h8ljfyZnNnx5-_OqV3UCH7_1v9RSs4hkOA&oe=6A4A6505"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.ocu
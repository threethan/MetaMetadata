6uVng&_nc_oc=AdrZ5UKBAbr8_X5fWCMXVegqIyMDvs-2vXObXiTehMIEHbKcltwD7Rsld7ZmwHxN7SE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2CZjUZPtjVVdS-4btMhfgOHjjW_5-DX172J3zOSEWeGw&oe=69F1F6D6"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXHlM8VO7RYQ7kNvwFis7P9&_nc_oc=AdqzXMbHD9X0lnoZoGp8Kl1A3WVQKPeeXYupsm8DxWb-vlhnhm89_t_grRKnYS3TFEU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3nvhkXu76eERS80PjoHHPwegXtjHO5BANUPyhDsNv6lg&oe=69F216DA"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72l0K8_zk3kQ7kNvwH-ugad&_nc_oc=AdrKvob6flqOa3ApkGrZIhqEzoLow1h-CfyHmbD0FR9q7JjrsRUAsQDA9UPXLW3oVo8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1b0prz_9NlCWtLOU4BmmmJi1Wm6r34IhLJL75IL5WQqw&oe=69F1FC39"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZAhVgsb-nQQ7kNvwF2_P_a&_nc_oc=AdrtRDVpA2BvCsUPM3ZbeLQ-G-19GDCJBAeg5jJi3DqUgEIOAzy-nAek4X0psx1bVQg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0aevQu7K2om4Vm68kZ0LLzqbjt8W2mWWTSHnwPynaCkg&oe=69F1F510"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihF7Q9W5WOgQ7kNvwGjr3le&_nc_oc=AdpJQgYL7-l0gfX8NcaPFv2L_Emsfgi6w-O0Y83E519Gct70-3fwOr6GMIs-MC7RG4Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1pJ7zqZu2npA_1eZpYYl0yUeJ5QdT4xWp2igwDVVIEFQ&oe=69F21085"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39036683_911787560737616_7761820554628924283_n.png?st
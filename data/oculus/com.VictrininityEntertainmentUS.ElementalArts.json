03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNa7AEcg5n4Q7kNvwEsAMEW&_nc_oc=AdqqqeKnObzBna3h4_9BCE37Vn9gZPUVioYpu26aBwK6L00OD0xnRpsoK8CMukVwhG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0LBS8OltMknnh5Hh94ejCyOwKQzQYim6QUzeUAsDZHg&oe=6AB3C356"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2o1yFdgVBkYQ7kNvwEIOs86&_nc_oc=AdrcW0cwqy5ZbL6qFTSQluJF8p1yVoFfRbitAfOY1XBxzOs_Nj-G1wvkjiq_uaEPru0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZzMAgKS9-Q37cW1Rajx1GETMpO_bewtiNig5Is39SCg&oe=6AB3E35A"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8cm2Oi8gYwQ7kNvwH_Spk5&_nc_oc=AdrlDkpu5IkAmvuUhLwXZmrz4BWTnDfiT2b5KVNC5_X1120qQoGWbpjID_IniDeq0LI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILNAgYOklmgq7PdJ9XBOskAqdvt-NTovi5W4SOaONY2g&oe=6AB3C8B9"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6X7z5xfXXMQ7kNvwE8bhwG&_nc_oc=AdoT1Daryk6J9KokVNmENlKD82T99x7wZ0veYh4yNC-YRgGTdbLpwmISODkXiZChgSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvWF6mT5kqsEA5T8u_BLQ_3igT48H4Be9635IBfwdTOQ&oe=6AB3C190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wxeqe9mMS9YQ7kNvwG-k5GI&_nc_oc=AdqTngCvw67NLwbfOqvvg6lTXdZrchsP4JegshyXXfIYlhOYlrF88fEY03b5TMB9u8A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCanfDtJVq7Rm216yxpNaKGu41LNs_32VbO69vGwwlkg&oe=6AB3DD05"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.ocu
03&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PojLpKzunaUQ7kNvwFPVoTY&_nc_oc=Adq7219-XfXZeYNGxQQOix4H5c_THA1ycr2kp3gZ4XECslAo8uxXyHnrnbhO28ZZ3y4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3cMksWPzn6PSI0prGAcuugDpzWQVIkGHp3cG31NPe7dA&oe=69F499D6"}, {"file_name": "Screenshot 3 (1).png", "id": "874834967749985", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974695_874834971083318_3768099552734138118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXHlM8VO7RYQ7kNvwEGnf8q&_nc_oc=Adr9ynoKDiSNuRsa41ebaaus2I0207nktjcBxBaSLRJUx-3yHVAVreE2d647Qiljki4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0tBzX1qWw9K5BNmKmq1kDSkmz291rEXU4p_XQuxV1APw&oe=69F4B9DA"}, {"file_name": "Screenshot 4 (1).png", "id": "315028111579277", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75617327_315028114912610_761719259808051028_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSl05cHXM9UQ7kNvwHOlWK2&_nc_oc=Adq-ZNIpp0RJHECq-0mGKSbGAWySkHh8ZfTCpahHK_rluQ1wxDHU_mVTSv1XAIfOxiw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af18fnzpnQUsmjGXttp_f9bNJ_f4LKtu0Qvxu7oWv1w5tw&oe=69F49F39"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Krozpkmkg6IQ7kNvwEmlL9w&_nc_oc=AdraAULGHwkLj0kljbJhQKsS6zzaiYT5dmPdSo2xhGBXq96e8WC6Mq50fRPKQGE0gnA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af10Ovw0g7_iH6wDhoXfU73xLXS2WRbDtIWwYcXMoc5m4A&oe=69F49810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CHNPqch3j-MQ7kNvwH08LZY&_nc_oc=AdoSHPkZhYI_SSFEGEkbCs_DpizMxpGsO78na3et1nH0KhflDa2Lc0RGC2PqZk0KjTg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3VgX40CyfpEfjufkV83uNFXNlLOL42g2W0E8cloEiWlA&oe=69F4B385"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/elemental-arts-vr/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Victrinity Entertainment", "support_website_url": null, "website_url": "https://sites.google.com/view/elemental-arts-vr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7360375710706584"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.ocu
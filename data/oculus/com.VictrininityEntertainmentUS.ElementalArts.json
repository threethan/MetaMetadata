S77csQ7kNvwGSCKGa&_nc_oc=AdnXbYAV2DSKASllNQJ133SHFwVAqXELO4-40WJnBuGMeE09KGo5au-yJziQXKXBHAQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDtuqPuXp92-NwdhcqWUVTbCzp6hdOpse2g9ejVX_tjQ&oe=69BD4039"}, {"file_name": "Screenshot 5 (1).png", "id": "1324761171533812", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001728_1324761174867145_2503484720635118176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFS65V8Nq2QQ7kNvwHO4-xG&_nc_oc=Adkddga_fhI4CIv8D_NlgZb99n5vJ22Y0bvfuYp_6yAz4KMPicXSZP3FZ7REb90-DiY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfymFFIDIMAJINy4BtFmObCw8yTJWJrRlN0hDM4wijl3pg&oe=69BD3910"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Elemental Arts Cover.png", "id": "431835932838440", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982623_431835936171773_6405462821509476233_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppSgXm6kVcYQ7kNvwHXZtTM&_nc_oc=AdnnSrLRw9Kx5F8tRwRl_CsnasbReGO2A-uoHLx1s-dfYjP4WIkRAxa4AGo_KgDHBHI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTO9yNxlU_raDvJD22Vrnw9uKTt_0QoKUJTjk_wIuOtg&oe=69BD5485"}, "display_name": "Elemental Arts", "keywords": [], "long_description": "Elemental Arts is everything you have wished for since you were young. A game where you can take the Elements of the world and just let loose on some unexpecting Elementals. As of now, the game is a Demo, but in the future, we plan for much more.\n\nThe controls are simple. the (A) button will display a menu that will allow you to pick and choose from all the abilities in the game thus far. When you hit Trigger on either controller a line will appear. This line represents the line of which you \"cast\" abilities. You will find the exact directions to cast each ability on stone walls in the designated area. (Ex. Fire in the red rocks area)", "short_description": "A game were you can harness Water, Fire, Earth, and Air by actually moving of your hands."}]}, "developer_n
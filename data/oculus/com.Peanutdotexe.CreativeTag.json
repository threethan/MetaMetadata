"}, {"file_name": "anothertopdown-2560x1440.png", "id": "1352253789224355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619453_1352253795891021_8359117420355534662_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pA2rjw3xp7AQ7kNvwE3uUtQ&_nc_oc=AdpbPns4qJNdagzFMaatHJudXLEKTYId7nGoH85W62BCAuP0MijP16Z6A9lrRLmAULY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRnfgv8rbmWCFYlYhiIGTEf0IxvUhJoTwLx2Ta5fOO6kQ&oe=6B0C71EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creative Tag", "keywords": [], "long_description": "Creative Tag is a thrilling VR multiplayer experience that blends the chaotic fun of classic tag with the freedom of gorilla-style locomotion. Swing, climb, vault, and launch yourself through dynamic, player-driven environments \u2014 all without using joysticks or buttons. Your movement is powered entirely by your arms, giving you an immersive and physically engaging way to run, jump, and interact with the world.\n\nInspired by the viral success of gorilla locomotion, Creative Tag takes it a step further by putting creativity and community at the heart of the gameplay. Whether you're tagging others, avoiding capture, or inventing your own game modes, this is a space where anything goes.\n\nWith open-ended maps, player-created challenges, and physics-based traversal, each match plays out differently. Want to play freeze tag in the forest? Parkour chase in a sci-fi lab? Hide-and-seek across floating islands? It's all up to you and the friends you play with.", "short_description": "Creative Tag is a fast-paced VR multiplayer game where players swing, climb, and leap through imaginative environments using gorilla-style locomotion. Chase, escape, and invent your own game modes in a vibrant sandbox of movement and mayhem \u2014 no buttons, just pure motion-powered fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/creative-tag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Reality Stars Inc", "support_website_url": null, "website_url": "https://sites.google.com/view/creative-tag/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24435939889342692"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24422333730703308", "version": "0.1"}, "id": "1087241469895639", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24421257907477557", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24422333730703308"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1087241469895639"}]}, "change_log": null, "created_date": 1749158161, "id": "24515092188094128", "version": "1.1.46", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"_
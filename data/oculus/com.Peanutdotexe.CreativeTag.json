611_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPb6PamOPtUQ7kNvwGK5x89&_nc_oc=AdodItoH31Xsb54gQAmuH8rlFBVWfR2N7DYy_Bj_iaVsO_YVjDsIitQ27--UjI4bQoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS90mIuNh8DvOSrxyoRPZh0X0K71vwEupbSSNdVlhiAg&oe=6B007F17"}, {"file_name": "anothertopdown-2560x1440.png", "id": "1352253789224355", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619453_1352253795891021_8359117420355534662_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jsm4g0dLjuwQ7kNvwFQMhFn&_nc_oc=AdqZr_okvL4pbB_GX_FpXPF1KIDfQ92I303Kt9U0N2yRh1H7yWU97ti6ludRNasB7_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3fkCqik40O1N7J0iheUjhYeksTpWVn5qk8SkpiHLijw&oe=6B005C2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Creative Tag", "keywords": [], "long_description": "Creative Tag is a thrilling VR multiplayer experience that blends the chaotic fun of classic tag with the freedom of gorilla-style locomotion. Swing, climb, vault, and launch yourself through dynamic, player-driven environments \u2014 all without using joysticks or buttons. Your movement is powered entirely by your arms, giving you an immersive and physically engaging way to run, jump, and interact with the world.\n\nInspired by the viral success of gorilla locomotion, Creative Tag takes it a step further by putting creativity and community at the heart of the gameplay. Whether you're tagging others, avoiding capture, or inventing your own game modes, this is a space where anything goes.\n\nWith open-ended maps, player-created challenges, and physics-based traversal, each match plays out differently. Want to play freeze tag in the forest? Parkour chase in a sci-fi lab? Hide-and-seek across floating islands? It's all up to you and the friends you play with.", "short_description": "Creative Tag is a fast-paced VR multiplayer game where players swing, climb, and leap through imaginative environments using gorilla-style locomotion. Chase, escape, and invent your own game modes in a vibrant sandbox of movement and mayhem \u2014 no buttons, just pure motion-powered fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/creative-tag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Virtual Reality Stars Inc", "support_website_url": null, "website_url": "https://sites.google.com/view/creative-tag/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24435939889342692"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499330333_3653075938330701_8596803640081884453_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZtctRYpO0UQ7kNvwGRAR62&_nc_oc=Adp3LdJh2FL1MjSDGRNvhA7kZ8qCA1jc6CFrv9rWOnbdjwDCk8rMjYOBQkawTIhTmN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzwHYeWXLtYLlBCn5lJ9E2byK0YimkDt9cFt9pQ2xzjg&oe=6B007E2C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Creative Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1748286060, "lastRevision": {"nodes": [{"id": "244
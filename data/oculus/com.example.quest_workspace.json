ree \u2014 no subscriptions, no hidden costs\n- No account or login required\n- All data stays on your device \u2014 100% private\n- Lightweight overlay that works alongside any app or game\n- Drag, resize, and pin widgets anywhere in your room\n\nWorks on Meta Quest 3, Quest 3S, and Quest 2.", "short_description": "Horizon Dock is a free productivity overlay for Meta Quest. Float your notes, tasks, calendar, clock, weather, and alarms anywhere in your physical space. No setup, no account, no subscriptions. Just put on your headset and get organized."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.theoath.studio/horizon-dock/privacy", "developer_terms_of_service_url": null, "publisher_name": "OATH Studio", "support_website_url": null, "website_url": "https://www.theoath.studio/horizon-dock", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34317592037884942"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2141392063368858"}]}, "baseline_offer": {"id": "2141392063368858"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774807320, "status": "PUBLISHED", "id": "2141392063368858"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "345048812
scdn.com/v/t64.5771-25/499623384_1266209552149736_251088425196270375_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huKxIHVsUAAQ7kNvwEmGc6L&_nc_oc=AdqiNotdR6rlj8dorzR_fX-Dt4L9SoHA9xYq3S9wmEzaylZKqBCsgG3gATClwweeiQw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af38XjOZmi7yOUPVY5vZr_Bz_ygmbzEz21wCJJbnIPgi5w&oe=69F0B2B2"}, {"file_name": "screen2.png", "id": "937586061986409", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618442_937586065319742_5006460506862949851_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZeG_f1UiIswQ7kNvwGJ5gR2&_nc_oc=AdpASI4zI7Ga-krJ-yBWwxIqb3nOuIuYnmyL5k1NybA86gYKNaViA2nSZ3_-fpOwEq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3Xq36HnH5Xbi33eylxCIimYzPbByXG4SOqCKhf9SE_yQ&oe=69F0B42F"}, {"file_name": "screen4.png", "id": "1369967821816203", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619680_1369967825149536_8608910411524475002_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEmC3ff-uY8Q7kNvwEiwTBn&_nc_oc=AdqUlcL4DVBE6Ow3Y7TXuQ7X0R9EsfB6FhPknqyJWL6NEcaR0arIT-hQsHOyWKGblKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0F0BdJNt8N7y5_MnKaEGjUv9dWYkLl0Ks4CXmQ5xPHUA&oe=69F0CD29"}, {"file_name": "screen3.png", "id": "1622563742321613", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619450_1622563745654946_546212414952462770_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBGIQUPU468Q7kNvwF75MG0&_nc_oc=AdqPnaz9Oq_eziTkC6QFp5FtQgNj1h1KVuQTRNIid0zyAz_xitpueDYfk5LhFIMh0ok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Vd2bP6q22-wQp4lCGbMqurfdOFOQiUZUwtiUF5cr8Ag&oe=69F0BE18"}, {"file_name": "screen5.png", "id": "2743146136040636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620497_2743146139373969_1345246773644171991_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1uvvES6fSmkQ7kNvwHTOL8-&_nc_oc=AdpaiNHlvX0tM0_kx0FGgfoq6pS3mffv2UR_diZW5I21MCe4IGJkMjtEfCTIItWtY9A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0dUhOBfzTQDuJqXz1U5osJ_l4xE1lM-psaYCF1Ms8CVQ&oe=69F0AD1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horizon Dock", "keywords": ["Productivity", "Notes", "Tasks", "Calendar", "Planner"], "long_description": "# Horizon Dock\nYour Productivity Layer for VR\n\nhttps://www.theoath.studio/horizon-dock\n\nStop taking off your headset to check your calendar or jot down a note. Horizon Dock puts your essential productivity tools right inside your Quest, floating in your Navigator, always within reach.\n\n## What's Included\n\n- \ud83d\udcdd **Notes**  Create and pin notes anywhere in your space\n- \u2705 **Tasks** Manage your to-do list with Low, Med, and High priority tags\n- \ud83d\udcc5 **Calendar**  See your full month at a glance\n- \ud83d\udd50 **Clock & Alarm**  Always know the time, set reminders without leaving VR\n- \u26a1 **More utilities**  Every update brings a growing set of features built for how you actually use your headset\n\n## Why Horizon Dock\n\n- Completely free  no subscriptions, no hidden costs\n- No account or login required\n- All data stays on your device  100% private\n- Lightweight overlay that works alongside any app or game\n- Drag, resize, and pin widgets anywhere in your room\n\nWorks on Meta Quest 3, Quest 3S, and Quest 2.", "short_description": "Horizon Dock is a free productivity overlay for Meta Quest. Float your notes, tasks, calendar, clock, weather, and alarms anywhere in your physical space. No setup, no account, no subscriptions. Just put on your headset and get organized."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.theoath.studio/horizon-dock/privacy", "developer_terms_of_service_url": null, "publisher_name": "OATH Studio", "support_website_url": null, "website_url": "https://www.theoath.studio/horizon-dock", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}
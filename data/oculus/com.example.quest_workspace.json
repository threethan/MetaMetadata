636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620497_2743146139373969_1345246773644171991_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrrShxNTCqwQ7kNvwGA_YJ6&_nc_oc=Adoqf1zZDYYEVPsQztujt0cGdvfjOUJeLzbPCdt7hVEGGL8y7w7c3l5qAb6DhsyrFs8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkgroV7GT_DTlX2W09SWuParFJOEDYy3fzESZLAE1Gtw&oe=6B09B4DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horizon Dock", "keywords": ["Productivity", "Notes", "Tasks", "Calendar", "Planner"], "long_description": "# Horizon Dock\nYour Productivity Layer for VR\n\nhttps://www.theoath.studio/horizon-dock\n\nStop taking off your headset to check your calendar or jot down a note. Horizon Dock puts your essential productivity tools right inside your Quest, floating in your Navigator, always within reach.\n\n## What's Included\n\n- \ud83d\udcdd **Notes**  Create and pin notes anywhere in your space\n- \u2705 **Tasks** Manage your to-do list with Low, Med, and High priority tags\n- \ud83d\udcc5 **Calendar**  See your full month at a glance\n- \ud83d\udd50 **Clock & Alarm**  Always know the time, set reminders without leaving VR\n- \u26a1 **More utilities**  Every update brings a growing set of features built for how you actually use your headset\n\n## Why Horizon Dock\n\n- Completely free  no subscriptions, no hidden costs\n- No account or login required\n- All data stays on your device  100% private\n- Lightweight overlay that works alongside any app or game\n- Drag, resize, and pin widgets anywhere in your room\n\nWorks on Meta Quest 3, Quest 3S, and Quest 2.", "short_description": "Horizon Dock is a free productivity overlay for Meta Quest. Float your notes, tasks, calendar, clock, weather, and alarms anywhere in your physical space. No setup, no account, no subscriptions. Just put on your headset and get organized."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.theoath.studio/horizon-dock/privacy", "developer_terms_of_service_url": null, "publisher_name": "OATH Studio", "support_website_url": null, "website_url": "https://www.theoath.studio/horizon-dock", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34523248500652627"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618102_789134473788328_4587264723677899868_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFLd-0vayS8Q7kNvwFQVmvJ&_nc_oc=Adp_3qOHnSdL9_bdnvnMz5cvV-zwo0KNimFgHSMZ8bHr9EoXC_P7pWR96l2l6hHRmM8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTEJ5A1HfW32odL-79sNpsI8p7e88y47fsx_6ZuEGFcQ&oe=6B09B3DA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Horizon Dock", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1774807320, "lastRevision": {"nodes": [{"id": "34219051644405649", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "34219051524405661"
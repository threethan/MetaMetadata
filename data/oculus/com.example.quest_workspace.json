Y7uIHIaG1eK59a5dMGvKKY5Dntib6bfytc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwRLIhpPgCqV_1_K_m6qfvEZvENVQtx7Pe2jdKP5vSjQ&oe=6AFC6DA9"}, {"file_name": "screen3.png", "id": "1622563742321613", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619450_1622563745654946_546212414952462770_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUoe51PSUbQQ7kNvwGbRro-&_nc_oc=Adqg5YW5Pjg4u1S_QQy6Ry1dnKgbX0MKyjqFm5KrS9b9UEtnMljouLkRk2wcVjjkaOw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTylgSBKAaPZ-2IBO1zy1UztKc_3eNfLCxVxWrOYk0OoQ&oe=6AFC96D8"}, {"file_name": "screen5.png", "id": "2743146136040636", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620497_2743146139373969_1345246773644171991_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9zy0_UpS0IQ7kNvwEKlcTV&_nc_oc=AdrB4J-g3XNvpUyoeUMTzYJMPXZddB_gRB-hq7VwsAeSr7RsT0-UjzVtUrQ6CjBuCO0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZUWvCX6ImnPDPUdwHkjBzGKEZWe_okNm-oKrD7AXjMw&oe=6AFC85DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horizon Dock", "keywords": ["Productivity", "Notes", "Tasks", "Calendar", "Planner"], "long_description": "# Horizon Dock\nYour Productivity Layer for VR\n\nStop taking off your headset to check your calendar or jot down a note. Horizon Dock puts your essential productivity tools right inside your Quest, floating in your room, always within reach.\n\n## What's Included\n\n- \ud83d\udcdd **Notes** \u2014 Create and pin notes anywhere in your space\n- \u2705 **Tasks** \u2014 Manage your to-do list with Low, Med, and High priority tags\n- \ud83d\udcc5 **Calendar** \u2014 See your full month at a glance\n- \ud83d\udd50 **Clock & Alarm** \u2014 Always know the time, set reminders without leaving VR\n- \ud83c\udf24 **Weather** \u2014 Check conditions outside without breaking immersion\n- \u26a1 **More utilities** \u2014 A growing set of tools built for how you actually use your headset\n\n## Why Horizon Dock\n\n- Completely free \u2014 no subscriptions, no hidden costs\n- No account or login required\n- All data stays on your device \u2014 100% private\n- Lightweight overlay that works alongside any app or game\n- Drag, resize, and pin widgets anywhere in your room\n\nWorks on Meta Quest 3, Quest 3S, and Quest 2.", "short_description": "Horizon Dock is a free productivity overlay for Meta Quest. Float your notes, tasks, calendar, clock, weather, and alarms anywhere in your physical space. No setup, no account, no subscriptions. Just put on your headset and get organized."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.theoath.studio/horizon-dock/privacy", "developer_terms_of_service_url": null, "publisher_name": "OATH Studio", "support_website_url": null, "website_url": "https://www.theoath.studio/horizon-dock", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34317592037884942"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2141392063368858"}]}, "baseline_offer": {"id": "2141392063368858"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774807320, "status": "PUBLISHED", "id": "2141392063368858"}]}, "liveChannel": {"nodes": [{"latest_supported_b
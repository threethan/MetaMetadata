t-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ds2oyZHPu6zHqCGzcGxjM8XFRhT1FQz4ugEYShJDCgA&oe=6A106218"}, {"file_name": "screen5.png", "id": "2743146136040636", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499620497_2743146139373969_1345246773644171991_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3drOXWjPmiAQ7kNvwEAvWR6&_nc_oc=AdrnXVjI38TcYzY2O9aWhX6fQiMjTtkW99zBp603b45DQhdEkmDdNYHUIp_nTTj4KsE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42kafSBbNl4aTFx96APT04orog3Jiy51_9W9Q8eAK-Og&oe=6A10511E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Horizon Dock", "keywords": ["Productivity", "Notes", "Tasks", "Calendar", "Planner"], "long_description": "# Horizon Dock\nYour Productivity Layer for VR\n\nStop taking off your headset to check your calendar or jot down a note. Horizon Dock puts your essential productivity tools right inside your Quest, floating in your room, always within reach.\n\n## What's Included\n\n- \ud83d\udcdd **Notes** \u2014 Create and pin notes anywhere in your space\n- \u2705 **Tasks** \u2014 Manage your to-do list with Low, Med, and High priority tags\n- \ud83d\udcc5 **Calendar** \u2014 See your full month at a glance\n- \ud83d\udd50 **Clock & Alarm** \u2014 Always know the time, set reminders without leaving VR\n- \ud83c\udf24 **Weather** \u2014 Check conditions outside without breaking immersion\n- \u26a1 **More utilities** \u2014 A growing set of tools built for how you actually use your headset\n\n## Why Horizon Dock\n\n- Completely free \u2014 no subscriptions, no hidden costs\n- No account or login required\n- All data stays on your device \u2014 100% private\n- Lightweight overlay that works alongside any app or game\n- Drag, resize, and pin widgets anywhere in your room\n\nWorks on Meta Quest 3, Quest 3S, and Quest 2.", "short_description": "Horizon Dock is a free productivity overlay for Meta Quest. Float your notes, tasks, calendar, clock, weather, and alarms anywhere in 
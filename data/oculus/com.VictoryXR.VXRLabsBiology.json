61376575487695_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNulXieahRAQ7kNvwE2g15f&_nc_oc=AdlyZExpARHUwA7V4TIvRSNbXsFPfwVZyxKiIu5ENKBaPkcZ7UdD1ETFnn80PAXsvtU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzh5CHDAovyLHQkGf7J5X7neKJy_WxnVahwg26RpfBCCA&oe=69B29FD0"}, "display_name": "VXRLabs Biology", "keywords": [], "long_description": "Immerse yourself in our futuristic synchronous learning lab on VictoryXR\u2019s multiplayer platform as you test your knowledge of human anatomy and physiology. Grab and place human organs appropriately in the human cavity, alone or with other students. Need help? Place an organ in the Analysis Cube to learn more. Content is leveled (basic, advanced, college) and students can self-select.", "short_description": "Immerse yourself in our futuristic synchronous learning lab on VictoryXR\u2019s multiplayer platform as you test your knowledge of human anatomy and physiology. Grab and place human organs appropriately in the human cavity, alone or with other students. Need help? Place an organ in the Analysis Cube to learn more. Content is leveled (basic, advanced, college) and students can self-select.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.victoryxr.com/policies/", "developer_terms_of_service_url": null, "publisher_name": "VictoryXR", "support_website_url": null, "website_url": "https://www.victoryxr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "14
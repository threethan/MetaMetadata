NS---K3m0r6Hkp2iZwcd3m8N59NMtZ3b0f4EgPS_XpaW9oLjkCDm81NxdQ7OU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsl9HY7iRQUQaT4cG8oZcQgcSMifr8AcovlTADajdkWhQ&oe=699EFD6B"}, {"file_name": "Screenshot4.png", "id": "1912725752573319", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974794_1912725755906652_356529078635386275_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tLYjn1IRkIQ7kNvwG6nm2u&_nc_oc=AdlbyUQIl4jQltiQZR68PY_hrcNZqJMXX47mkYSrgcMylSfWyNcgiLTYJjN6tiuMmlQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftenuvasgkt27zS9x0KGpgXkQWF1s_rFESQ8c6OAX-_5w&oe=699EDE81"}, {"file_name": "Screenshot5.png", "id": "1023797202465128", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031314_1023797205798461_6097934466934139325_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VF92aZqw7JEQ7kNvwF-sxdv&_nc_oc=AdnxQoCmImqIlvPT9EqYFkrsurXMmvTLpbZWI2LfJpE_v2QqgePJalHW6SV4ZwUOj3w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsT2M38GfcPD26bXoLspQdqI9qq0WzVPkzhmCgRFTk7CQ&oe=699ED326"}, {"file_name": "Screenshot2.png", "id": "2174437169601806", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035461_2174437172935139_1902765828656607617_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7o10tTmRcfYQ7kNvwFMpqLM&_nc_oc=AdlSlSuzlb2kb2m7wjVBKKccKQ-z2pHLEEAKDxm7ysYGWAC9Al--lMv_TxnOnraSsEw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuCtmWPVYL3Nwp533FDPjAL-pNIbJ_w-RbRyecekXCzRw&oe=699EFE09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "991099852280025", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974552_991099855613358_2102416442689796815_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7qvAZWKKWEQ7kNvwHnGtoh&_nc_oc=Adkd-OpLbmUzmFW9yz8Igc7j9tGYnjL4b_uS-E8wzjtWh8tFJaJHhQsnp_n5oWgQDEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvQfKd-Hmil9EjOJVqYE0dHy_S7kwe71qkk6XC5jFkHHw&oe=699EF381"}, "display_name": "Pencil", "keywords": [], "long_description": "# Learn how to draw with Pencil!\nPencil! is a fun new way to learn how to draw! Overlay drawing guides on your physical paper to help you trace and follow along. By combining mixed-reality with a sheet of paper & a pencil, grow your art skills from complete beginner to master artist! \n\n{796057042654180}\nBe sure to join our **Discord** to share your art with the community and give us feedback: https://discord.gg/GpabPFTzDy\n{464353963003063}\n{926346675848213}\nPencil! teaches you how to draw by overlaying step-by-step guides on your piece of paper.\nLearn fundamental concepts such as:\n- Shape & Form\n- Perspective\n- Texture\n- Anatomy\n- & More!\n\n{870538865095490}\nCreate your own still-life composition with Free-draw mode. Drag and drop 3d and 2d models onto a stage that get projected onto your paper.\n", "short_description": "Pencil! - Learn how to draw with real paper and pencil! \n\nUsing mixed-reality, overlay step-by-step guides to trace and learn the fundamentals of drawing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://pencil-xr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": "https://www.pencilxr.com/discord", "website_url": "https://www.pencilxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
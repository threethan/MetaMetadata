aved so you can quit and resume your drawing, but once you take a new photo, the old one is gone.  So if you want to remove the current one, just take another. ", "created_date": 1771513472, "id": "26169937922614658", "version": "1.6.0", "version_code": 160, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26169934845948299"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7699993220035742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26169937922614658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1770833179, "id": "26097289766546141", "version": "1.4.x2", "version_code": 152, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26097286909879760"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7699993220035742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26169937922614658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1768514415, "id": "25849235471351573", "version": "1.5.1", "version_code": 137, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25849232968018490"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7699993220035742", "
nc_ss=7a30f&oh=00_Af28vdlo2qSP0Fc3eq186eadqacjSL1Ta_gt7mCH5tZ16A&oe=69E78C94"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape-Pencil.png", "id": "1483837159313682", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820559_1483837162647015_6324569687203794540_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elF-HdPi2swQ7kNvwFzg2TS&_nc_oc=AdqXlP42VqbV5hFVdzdMJTOwvUxRZxTFGNLHQ21Cs_MlXOnrF4BfT_vwVgYDamBveSk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZtGm0SwZOIt5Jg81158m7Pb-bwDGkt8PRy02TPmpRzg&oe=69E78BD4"}, "display_name": "Pencil - Learn to Draw", "keywords": ["Draw", "Trace", "Sketch", "Art", "Stencil"], "long_description": "# Drawing made fun!  Use real paper & pencil!                                      \nBecome a master artist in no time! Award winning app, **Pencil**, lets you combine mixed reality w/ real paper and pencil to grow your art skills. \n\n{1276595180783767}\n\u270f\ufe0f - \u201cI have no artistic bone in my body, but this app just taught me how to draw!\u201d - **Tom's Guide**  \n\n\u270f\ufe0f - \"The future of mixed reality for hobbies and education!\" - **UploadVR** \n\n{1329144542109242}\n\n# \ud83c\udf93Academy Mode!  80+ lessons & counting...\nUnlock new lessons & challenges in our **20+ hr Campaign**! Learn drawing concepts of all levels,  for **beginner and advanced artists** alike!\n{24122044060811410}\n\n#  \u270f\ufe0fFree Draw Mode! Create your own still-life scene\nUse our library of high-quality 3D models to create your own still life scene! \n{2554779058206898}\n\n# \ud83d\udce5 Import your own images! Create murals & more!\nAdd your own images to trace along! You can scale and position your stencil to create **street art, murals, paintings** & more!\n{628943586596024}\n\n{2557980844558294}\nJoin our **Discord** to share your art with the community and give us feedback: https://discord.gg/GpabPFTzDy\n\n", "short_description": "Learn how to draw with real paper and pencil! \n\nBecome a master artist in no time! Award winning app, Pencil, lets you combine mixed reality w/ real paper and pencil to grow your art skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pencilxr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": "https://discord.gg/GpabPFTzDy", "website_url": "https://www.pencilxr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25772515932356861"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821194_2051473625644351_5045159155830228238_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb64g-pauQwQ7kNvwFOS3wg&_nc_oc=AdquvjTFikqwSgeSrJ6CW1xxZ_xClVIYlxIrhkc8Eo6FNEpXGVbpq53j5YDW0SCyQ9E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dHJuXf4r9fhwQBzYGOPvd1DqUe_7DSJsvEgtImO-nNw&oe=69E77556"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pencil - Learn to Draw", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Creativity", "id": "18190216
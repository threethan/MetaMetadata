om&_nc_ss=7f20f&oh=00_AQSlNCngLIXXo2DSe9AyKZJ4GNme_yr2rth-fRFRnd35Mg&oe=6AFF1741"}, {"file_name": "Screenshot5.png", "id": "1023797202465128", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031314_1023797205798461_6097934466934139325_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvfo2XVuhUkQ7kNvwHPxBlI&_nc_oc=AdosDxdf3YhmZxu-MJzOzRSn3jE4ahxtTfHr1ccTezZ-cLJlBlewNoxDHdjWRHM4sL8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1_BeJhXLUKbEoiOZ6YXX6MX4sblq588qVQG4Ich6v6A&oe=6AFF0BE6"}, {"file_name": "Screenshot2.png", "id": "2174437169601806", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035461_2174437172935139_1902765828656607617_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH64rkwoh6IQ7kNvwEdbkvZ&_nc_oc=AdrikRKwZ-IBDK3XMAfmnnI6LOZWHUV-QDJAwGSuC8uVWnkB_nHtS6PWCQjbx1ZeO58&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp4BNKHDIW33NCJ6pGhuivxv-0l3wv0-XW7RiaTl8CpA&oe=6AFF36C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "991099852280025", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974552_991099855613358_2102416442689796815_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qpoh3cVQNcQ7kNvwF6eRUq&_nc_oc=AdoB6NtIu_-Hxz68kOdJ-VW5FoAgCc0QUHbWc-OwSVV6nCyrl1innOnScZ7h0fjahnA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCESSAuRij9ZAtCiNe_5NeciGNNNhQEO033Gy-bXM9JA&oe=6AFF2C41"}, "display_name": "Pencil", "keywords": [], "long_description": "# Learn how to draw with Pencil!\nPencil! is a fun new way to learn how to draw! Overlay drawing guides on your physical paper to help you trace and follow along. By combining mixed-reality with a sheet of paper & a pencil, grow your art skills from complete beginner to master artist! \n\n{796057042654180}\nBe sure to join our **Discord** to share your art with the community and give us feedback: https://discord.gg/GpabPFTzDy\n{464353963003063}\n{926346675848213}\nPencil! teaches you how to draw by overlaying step-by-step guides on your piece of paper.\nLearn fundamental concepts such as:\n- Shape & Form\n- Perspective\n- Texture\n- Anatomy\n- & More!\n\n{870538865095490}\nCreate your own still-life composition with Free-draw mode. Drag and drop 3d and 2d models onto a stage that get projected onto your paper.\n", "short_description": "Pencil! - Learn how to draw with real paper and pencil! \n\nUsing mixed-reality, overlay step-by-step guides to trace and learn the fundamentals of drawing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://pencil-xr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": "https://www.pencilxr.com/discord", "website_url": "https://www.pencilxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8358998234135234"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "1114365078261016"}, {"status": "PUBLISHED", "id": "4308130506165460"}, {"status": "PUBLISHED", "id": "1039360022214950"}, {"status": "PUBLISHED", "id": "1010572441712563"}, {"status": "PUBLISHED", "id": "1651919452704532"}, {"status": "PUBLISHED", "id": "3836757849798564"}, {"status": "PUBLISHED"
=00_AfsPsNS-_Xrj6C44G3u7PhtoKb0VfakwZhC_nMIVT_UQrw&oe=6999AB5C"}, {"file_name": "screenshot-3dfd2.png", "id": "1919047388946789", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820619_1919047392280122_3325441268434695614_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXFBhlnRoH8Q7kNvwESvHdO&_nc_oc=AdnmxQWbZYsnmmbbX2lMsXUqhdkcNoIAEcEoF9ZtU8sApyTxEGaHTuZojRXJlagv5kQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft3AxGPqPOJLYGSLlApEgB0g3aL8EKj2ClR2KCOIfT9-w&oe=6999C276"}, {"file_name": "screenshot-Library.png", "id": "779197681692274", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822779_779197685025607_3321157353193741130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BR5E21ac8_AQ7kNvwGFo1nA&_nc_oc=AdkZ2OLk2bTzRumuWlzsJH8NsGedU-V6mhMfC53YLeMVcPYnn6sIcdc8_MUfRDjbng0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft-B5oeWmU6e0L0KUUKxinSiMKSA-4K2voy_UMrFbfkIA&oe=6999AB0A"}, {"file_name": "screenshot-2dfd.png", "id": "4002703499995231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821919_4002703503328564_8901605111145954128_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wQVrLT05KMQ7kNvwEvPktJ&_nc_oc=Adkd2dyGAamEKnPHTs5F0_9_tW_rPtwGDtHoXKD2M1iRd88KqVaTajdaLGNT9leVkbg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuziSVaSsRS8pZmUyQQTtA0nVPS2tH3KDfkrdOeFwAu1Q&oe=69999EC9"}, {"file_name": "screenshot-Apple.png", "id": "792978229850652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820594_792978233183985_722906324224266950_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aP8NFjg2AoIQ7kNvwF6by59&_nc_oc=AdlAGQH73i2Mrk7WQ5uUH78xIK2zcfIyJhKAtAEAq_8VuWPnruP1tWgmQQrJTe_qxKg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2ZRyjZyTetb2HDYKkEI6meBSM55KwuAN-Un9DiDTzGA&oe=6999C414"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape-Pencil.png", "id": "1483837159313682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820559_1483837162647015_6324569687203794540_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-DHXJ7yBlUQ7kNvwEyl-H0&_nc_oc=AdmVwHQwl7ioJIf5ZpNGv5McYj7Uly4WlH3_zeP9yz-AccTrMZevZMEAvjYLVswOUj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfteF_S8sLyJoD6_ZgblHG99a2zlNUzCu4nmtxf1Qv3gNQ&oe=6999C354"}, "display_name": "Pencil - Learn to Draw", "keywords": ["Draw", "Trace", "Sketch", "Art", "Stencil"], "long_description": "# Drawing made fun!  Use real paper & pencil!                                      \nBecome a master artist in no time! Award winning app, **Pencil**, lets you combine mixed reality w/ real paper and pencil to grow your art skills. \n\n{1276595180783767}\n\u270f\ufe0f - \u201cI have no artistic bone in my body, but this app just taught me how to draw!\u201d - **Tom's Guide**  \n\n\u270f\ufe0f - \"The future of mixed reality for hobbies and education!\" - **UploadVR** \n\n{1329144542109242}\n\n# \ud83c\udf93Academy Mode!  80+ lessons & counting...\nUnlock new lessons & challenges in our **20+ hr Campaign**! Learn drawing concepts of all levels,  for **beginner and advanced artists** alike!\n{24122044060811410}\n\n#  \u270f\ufe0fFree Draw Mode! Create your own still-life scene\nUse our library of high-quality 3D models to create your own still life scene! \n{2554779058206898}\n\n# \ud83d\udce5 Import your own images! Create murals & more!\nAdd your own images to trace along! You can scale and position your stencil to create **street art, murals, paintings** & more!\n{628943586596024}\n\n{2557980844558294}\nJoin our **Discord** to share your art with the community and give us feedback: https://discord.gg/GpabPFTzDy\n\n", "short_description": "Learn how to draw with real paper and pencil! \n\nBecome a master artist in no time! Award winning app, Pencil, lets you combine mixed reality w/ real paper and pencil to grow your art skills. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://pencilxr.com/privacy/", "developer_terms_of_servic
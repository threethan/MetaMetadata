 "# Learn how to draw with Pencil!\nPencil! is a fun new way to learn how to draw! Overlay drawing guides on your physical paper to help you trace and follow along. By combining mixed-reality with a sheet of paper & a pencil, grow your art skills from complete beginner to master artist! \n\n{796057042654180}\nBe sure to join our **Discord** to share your art with the community and give us feedback: https://discord.gg/GpabPFTzDy\n{464353963003063}\n{926346675848213}\nPencil! teaches you how to draw by overlaying step-by-step guides on your piece of paper.\nLearn fundamental concepts such as:\n- Shape & Form\n- Perspective\n- Texture\n- Anatomy\n- & More!\n\n{870538865095490}\nCreate your own still-life composition with Free-draw mode. Drag and drop 3d and 2d models onto a stage that get projected onto your paper.\n", "short_description": "Pencil! - Learn how to draw with real paper and pencil! \n\nUsing mixed-reality, overlay step-by-step guides to trace and learn the fundamentals of drawing. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://pencil-xr.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "4th Wall Breakers", "support_website_url": "https://www.pencilxr.com/discord", "website_url": "https://www.pencilxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1043107547362485"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8358998234135234"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1664120418067729"}, {"status": "PUBLISHED", "id": "862866149865872"}, {"status": "PUBLISHED", "id": "1133772691801401"}, {"status": "PUBLISHED", "id": "1725725608087284"}, {"status": "PUBLISHED", "id": "1998230584252317"}, {"status": "PUBLISHED", "id": "1245906587160275"}, {"status": "PUBLISHED", "id": "1283093079631755"}, {"status": "PUBLISHED", "id": "2081726195599385"}, {"status": "PUBLISHED", "id": "1219691205976999"}, {"status": "PUBLISHED", "id": "1117205959385750"}]}, "baseline_offer": {"id": "1998230584252317"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1664120418067729"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26169937922614658", "version": "1.6.0"}, "id": "332643316187551", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7699993220035742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26169937922614658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "332643316187551"}]}, "change_log": "Cats & Cameras!\n\nWe've released a new content pack with 6 new lessons on drawing cats!  \n6 new lessons and a bunch of new assets for 2D Free Draw\n\nWe're also adding a new feature in 2D Free Draw allowing you to capture the world around you and trace it. \n\nWhile in 2d Free Draw, go to \"My Files\", grant the appropriate permissions, then you can take a picture of the world around you.  Be sure to check \"Headset Cameras\" in the permission options. \n\nAfter capturing the image, it'll show up on our easel for you to trace in the normal way.  The image is saved so you can quit and resume your drawing, but once you take a new photo, the old one is gone.  So if you want to remove the current one, just take another. ", "created_date": 1771513472, "id": "26169937922614658", "version": "1.6.0", "version_code": 160, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26169934845948299"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7699993220035742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26169937922614658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1770833179, "id": "26097289766546141", "version": "1.4.x2", "version_code": 152, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "26097286909879760"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7699993220035742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26169937922614658"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1768514415, "id": "25849235471351573", "version": "1.5.1", "version_code": 137, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "25849232968018490"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "76999932200
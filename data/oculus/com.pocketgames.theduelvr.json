qMquc_B7Nn3jO_tM_uu8hrvKwyKhEYK_60lhRWZSbwigQZnxsmYiLYa-13fPViEIM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzH_MlJivLpVCQEwva0P1ueA3t2JCJMqeyqe-ENTP-Bw&oe=6AFC6D60"}, {"file_name": "migrated_image.png", "id": "639135083320352", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410461_108511712971336_1631463745660125184_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5EbcmDVN0YQ7kNvwF_tq9I&_nc_oc=AdoHPcXYOcJ0IsybSB4Wlc1_SqcyENxWMMfQ5aNRcsciQD1tlOkp3EmC5kqnV68z_NA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2vEqAZ2O_X0QOQN-itTV42GwSfe1HIKnqlnpdKTplMQ&oe=6AFC642B"}, {"file_name": "migrated_image.png", "id": "226282961856620", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12482342_1424979491134865_4565429181994762240_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUcuVsH13twQ7kNvwFTW-78&_nc_oc=AdpuKhRw0xwoAnrEWX_rO2evU31lxS0UQfQuLNbZZEznNEPfTpqU_qLQxn7MC4BeMdE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFXJAXmJ5XrzVVEdV6E36mO_QIQ0wltGB-B3ocmwMTOw&oe=6AFC7231"}, {"file_name": "migrated_image.png", "id": "206224423806882", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12386302_101911450301399_4330276355284402176_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvYKNZtslpUQ7kNvwE8kPbV&_nc_oc=AdqAr9QGVdzZv114ELR8OyEeFwYkt6ICmFMCuUodfV8-fe1i6YpUET28KIR95xbwh-o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEyka4dGiQbxGn9HEOO4h8rYC_H1xdOr3hX7nY1pTFkA&oe=6AFC6928"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Duel VR", "keywords": ["multiplayer", "fps", "arena", "shooter", "duel"], "long_description": "Enter the virtual reality and become the best duelist!\nThe Duel is a multiplayer FPS (first person shooter) for the Samsung GearVR. You can play against the AI, or even better, challange someone else! You fight for your life in the 80's inspired neon sci-fi world. Jump around the cliffs by swipeing and shoot down your opponent. Charge your shot by holding on the touchpad on your GearVR.\nDo you have what it takes to become the champion?\nThe game was created for the 2017 Budapest PlayIT show as a tech demo, but after the overwhelming success it's available in the Occulus store!", "short_description": "In the year 2544 technology overtook the human race. The remaining people roam the barren neon wasteland. You are alone. You meet a hostile stranger on the cliffs in a gravitational anomaly, he attacks you but you dodge it. It's you or him. Fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pocketgames.eu/privacy", "developer_terms_of_service_url": "http://www.pocketgames.eu/terms", "publisher_name": "Pocket Games Ltd.", "support_website_url": null, "website_url": "http://www.pocketgames.eu/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7039412746131729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410460_212388925873823_8691680739449634816_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wU2u5kVuWm0Q7kNvwFXlBr-&_nc_oc=AdobaAT76K2nyLnl4GZGScjdayH5cjuwOtIPDt3MGdD7ps0e3VZISWwGtZjEhL5dnJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGSM_WHynP9rTWlarzSf9ik1Wd_C6lyfGUmGrZXQAC0g&oe=6AFC899C"}, "is_concept": false, "is_test": fa
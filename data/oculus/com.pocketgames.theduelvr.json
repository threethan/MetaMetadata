 "639135083320352", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410461_108511712971336_1631463745660125184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHmclXstZOAQ7kNvwFb4UOq&_nc_oc=AdplPR-ZwuYpTt1cE6EUWpjYejWV6NatSOqEYsJ-I2aJxDC1FK1gD1tHadSmlFkE0SM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT3_33R83TuDlf945kpN21jGaHAWxwnsHQ6VWT3EWY8Q&oe=6A5F81AB"}, {"file_name": "migrated_image.png", "id": "226282961856620", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12482342_1424979491134865_4565429181994762240_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WemclCK0PUoQ7kNvwF1E1iW&_nc_oc=Adpk_nNP0dSD-L4Z2dEH8blwNr8S3KKphf_hjdIcx9AXLc32rgZk3Y58usByCVmSbuU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0edtAkpxHa8tlCBo440Jxwb31QvzmBcA7kn6pTgHDnA&oe=6A5F5771"}, {"file_name": "migrated_image.png", "id": "206224423806882", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386302_101911450301399_4330276355284402176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qaicWnr5GwQ7kNvwFfSJNy&_nc_oc=Adqj9B7r0jotCdRa3L-LSU1VK0I6KISZ4SaXuQ8Lnf-J81NcwdmTm-3J5aAplQ-cD-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqOZXbNxShP_HDvmOrRrRTe9GGA8J1uJRKEqLDb_efgg&oe=6A5F86A8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Duel VR", "keywords": ["multiplayer", "fps", "arena", "shooter", "duel"], "long_description": "Enter the virtual reality and become the best duelist!\nThe Duel is a multiplayer FPS (first person shooter) for the Samsung GearVR. You can play against the AI, or even better, challange someone else! You fight for your life in the 80's inspired neon sci-fi world. Jump around the cliffs by swipeing and shoot down your opponent. Charge your shot by holding on the touchpad on your GearVR.\nDo you have what it takes to become the champion?\nThe game was created for the 2017 Budapest PlayIT show as a tech demo, but after the overwhelming success it's available in the Occulus store!", "short_description": "In the year 2544 technology overtook the human race. The remaining people roam the barren neon wasteland. You are alone. You meet a hostile stranger on the cliffs in a gravitational anomaly, he attacks you but you dodge it. It's you or him. Fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pocketgames.eu/privacy", "developer_terms_of_service_url": "http://www.pocketgames.eu/terms", "publisher_name": "Pocket Games Ltd.", "support_website_url": null, "website_url": "http://www.pocketgames.eu/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7039412746131729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410460_212388925873823_8691680739449634816_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8w5LNu5jheUQ7kNvwG7ZkEB&_nc_oc=AdrW87o0AKfJVtzvM9VusD6QNIAurSGezzDcC30_6iU4PYpNtXD6cY1BO7f0AMDktdM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiqGykJFeDGpAkzMTLzsH-tHCfr_npQUYixB83yTOerA&oe=6A5F6EDC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Duel VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1481702400, "lastRevision": {"nodes": [{"id": "199927813789138", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "e
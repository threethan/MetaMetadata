oQGux_spvwJCuCgfq7hzIb6Bb-yiyGSfdNubX1GXc_i3NhsXwicmRnFb1XeYPzIQc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRP1BR3nJuyRhqaNFV-2r2wTOTBjCP8KSirXqCCs4hJXw&oe=6B0B2620"}, {"file_name": "migrated_image.png", "id": "639135083320352", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410461_108511712971336_1631463745660125184_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atZgSkqO5PcQ7kNvwE5lENs&_nc_oc=AdrIYKATpcMKGW0GjXh6IDVLVu7PGNBQ7qRrQCd8YuSf-dZ5YvkroNk_lwC5hF9gB6I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQIt68OdwS7V-41SWPc9yvlKeNFr8ViJkbA0YUyckxoeQ&oe=6B0B1CEB"}, {"file_name": "migrated_image.png", "id": "226282961856620", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12482342_1424979491134865_4565429181994762240_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-thjfxc3SYQ7kNvwFIAKm8&_nc_oc=AdrPsmGReX1PfyfadaWhwrk7wzApcu1gYbtJRpAZS2o_0s_MNyoKJjWr5HEMud1DvFc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRghy5_7s2_14GPDxt2uROE2ir_nhI9Txq5ydgxwfDXxA&oe=6B0B2AF1"}, {"file_name": "migrated_image.png", "id": "206224423806882", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386302_101911450301399_4330276355284402176_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lv1ThaWe5xoQ7kNvwGE4yy8&_nc_oc=Ado_Yxh3KOtD_Gl2pwriLKkWlcGHaqfL-0g1zwa5E8xr0F-5N92V0CwpqbkA9ej8hfU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTejLrMP8RoKw5crxh4xSx7GtE6CXMvRvoV9TbcIhTVDw&oe=6B0B21E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Duel VR", "keywords": ["multiplayer", "fps", "arena", "shooter", "duel"], "long_description": "Enter the virtual reality and become the best duelist!\nThe Duel is a multiplayer FPS (first person shooter) for the Samsung GearVR. You can play against the AI, or even better, challange someone else! You fight for your life in the 80's inspired neon sci-fi world. Jump around the cliffs by swipeing and shoot down your opponent. Charge your shot by holding on the touchpad on your GearVR.\nDo you have what it takes to become the champion?\nThe game was created for the 2017 Budapest PlayIT show as a tech demo, but after the overwhelming success it's available in the Occulus store!", "short_description": "In the year 2544 technology overtook the human race. The remaining people roam the barren neon wasteland. You are alone. You meet a hostile stranger on the cliffs in a gravitational anomaly, he attacks you but you dodge it. It's you or him. Fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pocketgames.eu/privacy", "developer_terms_of_service_url": "http://www.pocketgames.eu/terms", "publisher_name": "Pocket Games Ltd.", "support_website_url": null, "website_url": "http://www.pocketgames.eu/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7039412746131729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410460_212388925873823_8691680739449634816_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBZVp-Sy7b8Q7kNvwEYzAHc&_nc_oc=AdqU_YNYoWblR9iTsx-kNz0nKuaKIq1JbJGSJ7M_yGcN6Zpxr31HpzqE5ky6ZqS2heQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6D-VUfn1-p4PMn9q1GlPnzUbXKeSvCu9HJ_QXx2fB5Q&oe=6B0B425C"}, "is_concept": false, "is_test": fa
xG4hlmO6BgyaHgbYw1jA5BGAA&oe=6B0B0E0E"}, {"file_name": "migrated_image.png", "id": "144467856892528", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386302_101911450301399_4330276355284402176_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lv1ThaWe5xoQ7kNvwGE4yy8&_nc_oc=Ado_Yxh3KOtD_Gl2pwriLKkWlcGHaqfL-0g1zwa5E8xr0F-5N92V0CwpqbkA9ej8hfU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTejLrMP8RoKw5crxh4xSx7GtE6CXMvRvoV9TbcIhTVDw&oe=6B0B21E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled-2.png", "id": "1900166266872259", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12138843_1900166270205592_5843689914041892864_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iRHFYrPcP8Q7kNvwGT7GK2&_nc_oc=Adq6yyGEFZT750ocGtEU8AQ1Lao9fL-3lcxdia4BuKP_5-Gg7Vx65_us_6PiGKVDVGQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRw2pHqNTHZsNSk3BI3KfMYf4e9MUhv2OYD0myn1VQaMw&oe=6B0B22A6"}, "display_name": "The Duel VR", "keywords": ["multiplayer", "fps", "arena", "shooter", "duel"], "long_description": "Enter the virtual reality and become the best duelist!\nThe Duel is a multiplayer FPS (first person shooter) for the Samsung GearVR. You can play against the AI, or even better, challange someone else! You fight for your life in the 80's inspired neon sci-fi world. Jump around the cliffs by swipeing and shoot down your opponent. Charge your shot by holding on the touchpad on your GearVR.\nDo you have what it takes to become the champion?\nThe game was created for the 2017 Budapest PlayIT show as a tech demo, but after the overwhelming success it's available in the Occulus store!", "short_description": "In the year 2544 technology overtook the human race. The remaining people roam the barren neon wasteland. You are alone. You meet a hostile stranger on the cliffs in a gravitational anomaly, he attacks you but you dodge it. It's you or him. Fight!"}]
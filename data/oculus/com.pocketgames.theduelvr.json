 "639135083320352", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410461_108511712971336_1631463745660125184_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoPdFkPSnBMQ7kNvwG5E3Hw&_nc_oc=AdqGzOlGWCYejv7DC38kQajQXgMxwD97O2A3-OhBkdGgfwQSHyiDfz0ooQrWSPiNlgw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIJmYrSs-9VtOH4bsE6q2lBaylQdkf3EJLJ4q8MClNpg&oe=6ADCC02B"}, {"file_name": "migrated_image.png", "id": "226282961856620", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12482342_1424979491134865_4565429181994762240_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvqjHym_C5MQ7kNvwEgPMOq&_nc_oc=AdriGI7QH1j9Cy-IyLEcjBXo-0EHcwgaCH9A1lB-mEAW866T541tHQ0VszRx6loOI5U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAPm4sBQ3H_ef1enDVpHUZ8Hm2OdwbvXkIuLEVGSSsAQ&oe=6ADCCE31"}, {"file_name": "migrated_image.png", "id": "206224423806882", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12386302_101911450301399_4330276355284402176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg_PfvCumRYQ7kNvwFaMKLK&_nc_oc=Adr2b9XlGe-n3oehrtm-Z7BkLHkz8Ay6xDaHgQdbEFt9iZ0o9NatG_ey8KSKejvonRY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNd0TI5XEn55pTxPM40zRny6TRA3TTRGsl2u05eTO16A&oe=6ADCC528"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Duel VR", "keywords": ["multiplayer", "fps", "arena", "shooter", "duel"], "long_description": "Enter the virtual reality and become the best duelist!\nThe Duel is a multiplayer FPS (first person shooter) for the Samsung GearVR. You can play against the AI, or even better, challange someone else! You fight for your life in the 80's inspired neon sci-fi world. Jump around the cliffs by swipeing and shoot down your opponent. Charge your shot by holding on the touchpad on your GearVR.\nDo you have what it takes to become the champion?\nThe game was created for the 2017 Budapest PlayIT show as a tech demo, but after the overwhelming success it's available in the Occulus store!", "short_description": "In the year 2544 technology overtook the human race. The remaining people roam the barren neon wasteland. You are alone. You meet a hostile stranger on the cliffs in a gravitational anomaly, he attacks you but you dodge it. It's you or him. Fight!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.pocketgames.eu/privacy", "developer_terms_of_service_url": "http://www.pocketgames.eu/terms", "publisher_name": "Pocket Games Ltd.", "support_website_url": null, "website_url": "http://www.pocketgames.eu/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7039412746131729"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12410460_212388925873823_8691680739449634816_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjOn_QU5zmkQ7kNvwHjamz7&_nc_oc=AdrgkyINsOo4Nx-uhqlcvwuWH9AdQhDbAb4T0Gl0FQG4ogW3FhLDo1kQjt5GzrGIlug&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdGHkLfobX2bfMLD-PKRcJST-0BrrKO-qtEnREzuoCYA&oe=6ADCAD5C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Duel VR", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1481702400, "lastRevision": {"nodes": [{"id": "199927813789138", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "e
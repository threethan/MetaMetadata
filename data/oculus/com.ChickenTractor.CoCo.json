.com/v/t64.5771-25/38982529_894689072816659_376898522132222859_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjKOuMfAPB4Q7kNvwHQpGd1&_nc_oc=Ado6vKFOezrQyQj55HTBt_yk1i6WaNKIC26Vwxq4C-GQZSV69j9wZo4kfSmi6UxDnVg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzJ-alox2XVGYYZD74tCqN3FaoDC0xegINKBAyvSYMcQ&oe=6B0319BB"}, {"file_name": "Groups.png", "id": "1284228022846367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/468871746_1284228026179700_4119579970905643264_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-l3D89JOYYQ7kNvwFSxSNr&_nc_oc=AdoxrUL4YmvYtCNgYMkoUeUxQ-GOJmVWzaj3n3FIYAJxDfW649xm8KbXxn3ZGZU4li4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRldI_2GU-v73M5ml3Q494jNILoITXbV8ED7sjnT3Wa2w&oe=6B030F5D"}, {"file_name": "doog_door_exterior_resized.png", "id": "616260237757305", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75655852_616260241090638_1623023656473877803_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utyr-OS5fPQQ7kNvwEVVGYo&_nc_oc=AdqIfV9V5j1M5YukYB5uuaVafPXfZ-pudNd6Bq1TQWSHPMsSK0skFAS2aZpySEBdm7w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz5PxiAbB3mbmTuJPeFzK3YYK-nQkQc507h78gQcDVgg&oe=6B0304B1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "1259525098617506", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974666_1259525101950839_2173565379750228463_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRrljVMR8CYQ7kNvwHjgoLg&_nc_oc=AdqW66JhVfy-ttPorXRMaVd9LPxYkn1YypRfeHUsuNHjqJ9wFjMp7s_pd-ZWmOMPJZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhh5YbMpqCN_jAKf764zXL6SbtoiJHKPXrm4nQIkBaMQ&oe=6B0314BF"}, "display_name": "CoCo", "keywords": ["Design", "Teaching", "Drawing", "Collaboration", "Planning"], "long_description": "CoCo is the ultimate VR tool for spatial thinking, planning, and communication. Sketch, measure, and design concepts directly in 3D space. Whether you\u2019re planning a remodel, mapping a project, or brainstorming ideas, CoCo helps you turn abstract thoughts into clear, tangible forms.\n\nKey Features\n\n- 3D Sketching & Design: Draw lines, shapes, and forms in 3D, visualizing ideas from every angle.\n\n- Spatial Reasoning & Planning: Plan remodels, layouts, and pathways before making physical changes.\n  \n- Live Collaboration: Work with others to brainstorm and refine concepts in real time.\n\n- User-Created Sketches: Your sketches are stored locally on your device, giving you full control and privacy.\n\n- Intuitive VR Controls: Simple, hands-on controls make it easy for anyone to start creating.\n", "short_description": "Transform your space with CoCo, the ultimate VR tool for spatial thinking, planning, and communication. Sketch, design, and explore ideas in 3D with intuitive, hands-on tools. Collaborate with others in real time to refine concepts and bring projects to life. Whether you're mapping out a remodel, planning a build, or brainstorming bold new ideas, CoCo makes it easy to turn abstract thoughts into clear, tangible forms you can see and share.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coco.chickentractor.io/privacy-policy", "developer_terms_of_service_url": "https://www.coco.chickentractor.io/terms-of-service", "publisher_name": "Chicken Tractor LLC", "support_website_url": "https://www.coco.chickentractor.io/contact", "website_url": "http://coco.chickentractor.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "re
YwEIJVl_wXAhEvBQb06peMKutbWQ0MAGxMNG4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuBPoUZxoxeroJVLR3o1KEAnHfUzcmJS4xhXi_j6yj5A&oe=6A85989D"}, {"file_name": "doog_door_exterior_resized.png", "id": "616260237757305", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75655852_616260241090638_1623023656473877803_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIoR-kfUgU4Q7kNvwH9OUg6&_nc_oc=AdoDvwz_vhXMsRjmVwTP8W_CdDMh0cu0H6djAI92B_qu0DIAc03hRFz817WNKmwo5bk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGICcttPe2p4cWyyOgwg45hQVlW_pcu0KnEjiBCg5WW7w&oe=6A858DF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "1259525098617506", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974666_1259525101950839_2173565379750228463_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7YA3914czcQ7kNvwEZTE8w&_nc_oc=AdpKlDtr11PieR2kEb4vGYd8QhCJBX2si38RzR77MwHUjhD-LdfOJLTvqmDt_Uhpvik&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8d7atHzRxdvM3IFcsxt1nyuegYEVwSqWPGEu6NT-VPg&oe=6A859DFF"}, "display_name": "CoCo", "keywords": ["Design", "Teaching", "Drawing", "Collaboration", "Planning"], "long_description": "CoCo is the ultimate VR tool for spatial thinking, planning, and communication. Sketch, measure, and design concepts directly in 3D space. Whether you\u2019re planning a remodel, mapping a project, or brainstorming ideas, CoCo helps you turn abstract thoughts into clear, tangible forms.\n\nKey Features\n\n- 3D Sketching & Design: Draw lines, shapes, and forms in 3D, visualizing ideas from every angle.\n\n- Spatial Reasoning & Planning: Plan remodels, layouts, and pathways before making physical changes.\n  \n- Live Collaboration: Work with others to brainstorm and refine concepts in real time.\n\n- User-Created Sketches: Your sketches are stored locally on your device, giving you full control and privacy.\n\n- Intuitive VR Controls: Simple, hands-on controls make it easy for anyone to start creating.\n", "short_description": "Transform your space with CoCo, the ultimate VR tool for spatial thinking, planning, and communication. Sketch, design, and explore ideas in 3D with intuitive, hands-on tools. Collaborate with others in real time to refine concepts and bring projects to life. Whether you're mapping out a remodel, planning a build, or brainstorming bold new ideas, CoCo makes it easy to turn abstract thoughts into clear, tangible forms you can see and share.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coco.chickentractor.io/privacy-policy", "developer_terms_of_service_url": "https://www.coco.chickentractor.io/terms-of-service", "publisher_name": "Chicken Tractor LLC", "support_website_url": "https://www.coco.chickentractor.io/contact", "website_url": "http://coco.chickentractor.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26078295788481280"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "714754894754755"}, {"status": "PUBLISHED", "id": "1348535406150860"}, {"status": "PUBLISHED", "id": "465986973224927"}, {"status": "PUBLISHED", "id": "8936907953031913"}]}, "baseline_offer": {"id": "8936907953031913"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755277200, "status": "PUBLISHED", "id": "7147548
.com/v/t64.5771-25/38982529_894689072816659_376898522132222859_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_jzwVa_A_oQ7kNvwH4E2XD&_nc_oc=Adp29cn_BP5c0ap9tS_6KT2ofIwk5GPUvwfGIXf1EPLVWzI7uc3e7Qh12aNEPtEtvAA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5gQMcn-lW9OW5DYlbrIK1QDGG99kpMQDiD-9SU3b0qw&oe=6AFF253B"}, {"file_name": "Groups.png", "id": "1284228022846367", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/468871746_1284228026179700_4119579970905643264_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmIkJafIFVcQ7kNvwFyhL-k&_nc_oc=AdqUTbfP0CeHL6s4IJhTIELGCxqHtSWka5Gs_B4D5svLryrXWWX3ytaI7SFBTefHLQg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6EX28c5BjQolTw0ctUXKgL3iv3olIBrJex9WymGT2Tw&oe=6AFF1ADD"}, {"file_name": "doog_door_exterior_resized.png", "id": "616260237757305", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75655852_616260241090638_1623023656473877803_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3373y7ZUYoQ7kNvwE3l9yG&_nc_oc=AdoBK46NmD-5RdPGO4_CYB59qmhXhH0fIbLAceU21aICFJtpES7MqJ7zUSKO6-ghpSg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEtx6d8Mji0E43EK9kmdcIBjqlKakQoHzSjDSUT9wOtw&oe=6AFF1031"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "1259525098617506", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974666_1259525101950839_2173565379750228463_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKUQqWuIVJMQ7kNvwGYU_nW&_nc_oc=AdpNxrum1gAUUoRNzbh1nqijcvsuiG8GKHNrFT22AP21UvJjSZ7bavzrYKQy84g6m5A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFrz8Psze6Ll9UihRjOspBbThJIy1yVB3Q0mxWmEnvXA&oe=6AFF203F"}, "display_name": "CoCo", "keywords": ["Design", "Teaching", "Drawing", "Collaboration", "Planning"], "long_description": "CoCo is the ultimate VR tool for spatial thinking, planning, and communication. Sketch, measure, and design concepts directly in 3D space. Whether you\u2019re planning a remodel, mapping a project, or brainstorming ideas, CoCo helps you turn abstract thoughts into clear, tangible forms.\n\nKey Features\n\n- 3D Sketching & Design: Draw lines, shapes, and forms in 3D, visualizing ideas from every angle.\n\n- Spatial Reasoning & Planning: Plan remodels, layouts, and pathways before making physical changes.\n  \n- Live Collaboration: Work with others to brainstorm and refine concepts in real time.\n\n- User-Created Sketches: Your sketches are stored locally on your device, giving you full control and privacy.\n\n- Intuitive VR Controls: Simple, hands-on controls make it easy for anyone to start creating.\n", "short_description": "Transform your space with CoCo, the ultimate VR tool for spatial thinking, planning, and communication. Sketch, design, and explore ideas in 3D with intuitive, hands-on tools. Collaborate with others in real time to refine concepts and bring projects to life. Whether you're mapping out a remodel, planning a build, or brainstorming bold new ideas, CoCo makes it easy to turn abstract thoughts into clear, tangible forms you can see and share.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.coco.chickentractor.io/privacy-policy", "developer_terms_of_service_url": "https://www.coco.chickentractor.io/terms-of-service", "publisher_name": "Chicken Tractor LLC", "support_website_url": "https://www.coco.chickentractor.io/contact", "website_url": "http://coco.chickentractor.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "re
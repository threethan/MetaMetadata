01_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdLJv3ztqnEQ7kNvwGn3QzJ&_nc_oc=AdktoIifMH7V0W9JQUK9Y9matmke8Sy1Pma5YCM5-r97amZURLHy-oSVi5PYXwqCXK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz3nSMtzuekUkru1Z943rYcbdche5QGxl8EaK11QXIKfg&oe=69BBF206"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "622232867635132", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391949_622232870968465_3205372193996420289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXariGv8YjAQ7kNvwHh8pbp&_nc_oc=Adna5lDdCl0AYWswiqmZuwEaqGhRMH-SpRPnkmyen0f0OrMQbX6zO0Mn4Tj8ygNbLVk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx5pN-4nouxJ0z4iXMQIatxmCkyV6unybuWU8MGoHAD6A&oe=69BBFB15"}, "display_name": "SECRET TAG V2", "keywords": ["parkour", "hard", "team", "fun", "brain"], "long_description": "SECRET TAG V2 is an action-packed movement game that takes speed and agility to the next level! With fluid parkour mechanics, wall-running, sliding, and precise air control, players can navigate dynamic environments with style. The game features a thrilling tag-based gameplay where quick reflexes and strategic movement are the keys to victory.\n\nHone your skills in a specially designed practice area, filled with obstacles, ramps, and interactive elements that let you perfect every trick and technique. Whether you're chasing down opponents or making a daring escape, every match is a test of speed, skill, and creativity. Are you fast enough to stay ahead?", "short_description": "SECRET TAG V2 is an adrenaline-packed movement-based game where speed and skill are everything! Master advanced parkour mechanics, smooth slides, and high-speed dashes as you compete in intense tag matches. Train in a dynamic practice area designed to sharpen your reflexes and perfect your movement. Whether you're chasing or escaping, every second counts in this fast-paced experience!"}]}, "developer_name": null, "developer_privacy_policy
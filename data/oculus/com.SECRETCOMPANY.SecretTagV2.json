quodxZeDtz1YM1HmRVtwQvbWvGLyzMPculp6rgfQQbM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ2vgElcRFqXen5Rrj1lojncF8tZs3B71PP8dOPXwGKQ&oe=6B09A919"}, {"file_name": "landscape.png", "id": "632247999537397", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393325_632248002870730_3006640312548239801_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxQfuwOXYaQQ7kNvwF6u1gx&_nc_oc=AdqsnIc_UphK_ktLBz68nsLGTT2LP3_as6vXuyMxYsQz0GWmFoUrsTK3ySEy8h16lD0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFw_nbPPYPmYzxKWj2roQXmkvK_nc_MVizp_NfJRgSVA&oe=6B09B5C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "622232867635132", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391949_622232870968465_3205372193996420289_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxWQsSI_vcwQ7kNvwEuwEjg&_nc_oc=AdpCyoXV7mjMlBsU30Qr7oaHiZpBDXUh5xKbDHcgXmyp09gl9OCvmxUFBRRbLxrjS6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVJc97ztgqLVNJhkvtaO9n2FvJ5e70LFeyGA2ghBJ6RA&oe=6B09BED5"}, "display_name": "SECRET TAG V2", "keywords": ["parkour", "hard", "team", "fun", "brain"], "long_description": "SECRET TAG V2 is an action-packed movement game that takes speed and agility to the next level! With fluid parkour mechanics, wall-running, sliding, and precise air control, players can navigate dynamic environments with style. The game features a thrilling tag-based gameplay where quick reflexes and strategic movement are the keys to victory.\n\nHone your skills in a specially designed practice area, filled with obstacles, ramps, and interactive elements that let you perfect every trick and technique. Whether you're chasing down opponents or making a daring escape, every match is a test of speed, skill, and creativity. Are you fast enough to stay ahead?", "short_description": "SECRET TAG V2 is an adrenaline-packed movement-based game where speed and skill are everything! Master advanced parkour mechanics, smooth slides, and high-speed dashes as you compete in intense tag matches. Train in a dynamic practice area designed to sharpen your reflexes and perfect your movement. Whether you're chasing or escaping, every second counts in this fast-paced experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/secret-tag-privacy-policy/e5cabff8-516a-485c-81e7-06d8b696d3fd/privacy", "developer_terms_of_service_url": null, "publisher_name": "Secret Guy", "support_website_url": null, "website_url": "https://sites.google.com/view/secrettagv2?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9706666192710969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393325_573619772356515_2066824508221020141_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSrGKdNB2dcQ7kNvwF4JTLp&_nc_oc=Adqvf4caOOnaIWvW_AptmtrFeEvwYvvUfRsxySXii9KRmFoCkBjbeAsqwwi35ExC4uo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFdikaJxSgAdDrDjs4krP4yjIGTd6HXrAGApKZdjPbzw&oe=6B09A3B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SECRET TAG V2", "platfor
01_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hn0lppRPIygQ7kNvwGhbnzO&_nc_oc=AdmSzncvfG9Up913krrizoxb0xHdGyzfBBxzVjNZ_4H47RTX3cyGk-o9qMT942e-_CE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyu6XyGHcymSaC3b_F5Ru42JwKRaR8XlueJNzE7A1A8bA&oe=69B40906"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "622232867635132", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391949_622232870968465_3205372193996420289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNjnF0KbHsoQ7kNvwHRP_xK&_nc_oc=AdlckRbm9-8QkqQWGbUL1Cz0cCC49_kOYv2W58u0Ege2KPzfrAkiGNZhhkU9xyhwP1A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwjTz5XrF7GXLtaHnHOHupownHNrFNyub6s4cBDxd3_HQ&oe=69B41215"}, "display_name": "SECRET TAG V2", "keywords": ["parkour", "hard", "team", "fun", "brain"], "long_description": "SECRET TAG V2 is an action-packed movement game that takes speed and agility to the next level! With fluid parkour mechanics, wall-running, sliding, and precise air control, players can navigate dynamic environments with style. The game features a thrilling tag-based gameplay where quick reflexes and strategic movement are the keys to victory.\n\nHone your skills in a specially designed practice area, filled with obstacles, ramps, and interactive elements that let you perfect every trick and technique. Whether you're chasing down opponents or making a daring escape, every match is a test of speed, skill, and creativity. Are you fast enough to stay ahead?", "short_description": "SECRET TAG V2 is an adrenaline-packed movement-based game where speed and skill are everything! Master advanced parkour mechanics, smooth slides, and high-speed dashes as you compete in intense tag matches. Train in a dynamic practice area designed to sharpen your reflexes and perfect your movement. Whether you're chasing or escaping, every second counts in this fast-paced experience!"}]}, "developer_name": null, "developer_privacy_policy
4.5771-25/473393325_632248002870730_3006640312548239801_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKCcxWOkOE8Q7kNvwHqNma8&_nc_oc=AdpXTyx93woQvjvi3ivbbZ7VfBFXnCgyV1Zw9Ez4qrkH6HUfmOvgSkILDf_R-_aqtqw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-U1XBQFjxmgGjFWXuruvwdA8Qr5N0XnG6-8pRftK2gA&oe=6A11A386"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_image.png", "id": "622232867635132", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391949_622232870968465_3205372193996420289_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Gw-OD7HX6oQ7kNvwHOOEc-&_nc_oc=AdqmZobuZGJmdFMjJ8MzLhRKuD_s4aa-YxJ4WhNRkZFfN7BDd26O6vGe3UAynT2MhtU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rtpme1_WwnK-aIgbqX3yGDX6vxJLlAqfwRw5eTnJyEA&oe=6A11AC95"}, "display_name": "SECRET TAG V2", "keywords": ["parkour", "hard", "team", "fun", "brain"], "long_description": "SECRET TAG V2 is an action-packed movement game that takes speed and agility to the next level! With fluid parkour mechanics, wall-running, sliding, and precise air control, players can navigate dynamic environments with style. The game features a thrilling tag-based gameplay where quick reflexes and strategic movement are the keys to victory.\n\nHone your skills in a specially designed practice area, filled with obstacles, ramps, and interactive elements that let you perfect every trick and technique. Whether you're chasing down opponents or making a daring escape, every match is a test of speed, skill, and creativity. Are you fast enough to stay ahead?", "short_description": "SECRET TAG V2 is an adrenaline-packed movement-based game where speed and skill are everything! Master advanced parkour mechanics, smooth slides, and high-speed dashes as you compete in intense tag matches. Train in a dynamic practice area designed to sharpen your reflexes and perfect your movement. Whether you're chasing or escaping, every second counts in this fast-paced experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/secret-tag-privacy-policy/e5cabff8-516a-485c-81e7-06d8b696d3fd/privacy", "developer_terms_of_service_url": null, "publisher_name": "Secret Guy", "support_website_url": null, "website_url": "https://sites.google.com/view/secrettagv2?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "9706666192710969"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393325_573619772356515_2066824508221020141_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcREbmTAVY0Q7kNvwFRaV1W&_nc_oc=Adoi0Z4wHJmloZFCKet7B4-UtvApt2XEUahmhXl8Fw-ePP5SVy-PHx9MurIKl_doicw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dWUrwShWuiRD8oC6l0pf0EeXMVdKnaPBtWfgYDB2UYg&oe=6A11C9B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SECRET TAG V2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Racing", "id": "673385183287495"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1742226420, "lastRevision": {"nodes": [{"id": "9706666216044300", "
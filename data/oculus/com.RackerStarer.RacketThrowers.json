wGAqU1J&_nc_oc=AdotzK9WvHniHYafl-itbNvqf1JhoAc1CFH0vIfrOxChzqTiYVVNc4h9l6l0eVMu0to&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Wk9TuiYLJxQQq6Exm5M16Z_wElDUOQIrAydzM9dZqTw&oe=6A09D514"}, {"file_name": "pictu3.png", "id": "1857062918326431", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823310_1857062921659764_1621813864220404714_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOlMsJadm4MQ7kNvwFiNBBd&_nc_oc=AdqTWEPrslyN3baUo9kvdkVDEKjbN5h1ITjpFfO_-AZG9h3hJzWyJlmxbqxhg7zj89Q&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MHRqgho7vSnL5iLLaE9o1ye5CBl5cGCKMqaCdUiKbfg&oe=6A09BDC3"}, {"file_name": "pictu4.png", "id": "789595063762890", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491823271_789595070429556_7764697176195493298_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gM45NB2SS0wQ7kNvwEtB2Uk&_nc_oc=Adrm7SvZPjZ3Tj8q6dLyoHf8Dl3vUZ7G9qSbbnyB3R6yfAKC4BLxi3lD3M8jGIfx3y4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4txjE2ZsySTxlkaugDRvcPEGWDOLOhxjC5eCJxv-gZ_w&oe=6A09B26E"}, {"file_name": "eqewqe.png", "id": "904236509040327", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491824328_904236545706990_2443296171105324307_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5SGIryu7wQQ7kNvwHezKXr&_nc_oc=Adr74cQiIOgQKv7bkubBkaL2oc4AqE-M3gQZLNya-qkozqKpbCo4flCAOAk_E1HXIhE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vZfhyAgoYSkeaB4mJdcPFczMVQ2Sq1UHVAzgaQdQVfA&oe=6A09C5E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkeys Monsters Mayhem", "keywords": ["Monkey", "Scary", "Monsters", "3D", "VR"], "long_description": "Monkey Monster Mayhem is a multiplayer social VR experience built for Meta Quest. Swing, climb, and scramble through wild environments using gorilla-tag-style hand-based locomotion \u2014 no joystick, just your body. Move by pushing off surfaces with your hands and launch yourself across the map with pure momentum.\n\nBut watch out \u2014 monsters are hunting you. Evade AI-driven creatures that wander the world and chase you down the moment you get too close. Survive with friends or go solo across unique environments including caves and open arenas.\n\nHand-physics-based locomotion inspired by Gorilla Tag\nMultiplayer powered by Photon \u2014 race and survive with friends\nAI monsters that detect and chase players in real time\nUnique maps to explore and escape through", "short_description": "Climb, swing, and survive. Monsters are hunting you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/113YaXSbOr3EB71fbxhmSB7wiSC1_Y1qVOElL_SZMJ-s/edit?tab=t.0", "developer_terms_of_service_url": "https://docs.google.com/document/d/1--8eSejaqgU8MbgwiqgZjkG6Vmj5XKJVJGLfS3mS6PE/edit?usp=drivesdk", "publisher_name": "Leyth", "support_website_url": "https://docs.google.com/document/d/1-3xJbcRAYIN0ts_bgkUFF37Hvn_3ylcDJU-TZf7qqxc/edit?usp=drivesdk", "website_url": "https://discord.gg/rKY2Vu2gXz", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26840442588892653"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "796512930189564"}]}, "baseline_offer": {"id": "796512930189564"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775404800, "status": "PUBLISHED", "id": "79651293
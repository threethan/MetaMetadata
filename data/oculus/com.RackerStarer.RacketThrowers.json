=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4Q1bY5mLr5fAG9AGGdbDmXze4YlGv6maDxaUUUKawuw&oe=6B047303"}, {"file_name": "pictu4.png", "id": "789595063762890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823271_789595070429556_7764697176195493298_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNVH0Ph1T6QQ7kNvwEpT0Rx&_nc_oc=AdqyEfVB74a8qaNK_l-9grIhnN-3jIm-bpP7WVD4O8iPz4CuEsBDJ30nULyK8A7D_8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHdjdL7afuFaGm54uzt4TnFat9aVjruauso5HcTjtKIg&oe=6B0467AE"}, {"file_name": "eqewqe.png", "id": "904236509040327", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824328_904236545706990_2443296171105324307_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFKJ54944NkQ7kNvwE3licZ&_nc_oc=Adre0iZn9iisyox9PghkNvScN_VNeaVwZ7f_hYZF3HTVW7hF2KaAAKgJ9IoVSJt_Ohw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQEBnCn5hNIQsq9J5rRIoNw4gPCgP2o1Gcvxbfz46__A&oe=6B047B24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkeys Monsters Mayhem", "keywords": ["Monkey", "Scary", "Monsters", "3D", "VR"], "long_description": "Monkey Monster Mayhem is a multiplayer social VR experience built for Meta Quest. Swing, climb, and scramble through wild environments using gorilla-tag-style hand-based locomotion \u2014 no joystick, just your body. Move by pushing off surfaces with your hands and launch yourself across the map with pure momentum.\n\nBut watch out \u2014 monsters are hunting you. Evade AI-driven creatures that wander the world and chase you down the moment you get too close. Survive with friends or go solo across unique environments including caves and open arenas.\n\nHand-physics-based locomotion inspired by Gorilla Tag\nMultiplayer powered by Photon \u2014 race and survive with friends\nAI monsters that detect and chase players in real time\nUnique maps to explore and escape through", "short_d
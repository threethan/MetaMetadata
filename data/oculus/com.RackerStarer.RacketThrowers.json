=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTL6_20v3FbdCu6zXKw_f32h2rG4lYW1zu6Uo6F6EcUpA&oe=6B0DAD83"}, {"file_name": "pictu4.png", "id": "789595063762890", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_789595070429556_7764697176195493298_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1obv2kfJ8tQQ7kNvwE8vF2B&_nc_oc=Adp2NdyXp-nQLdcuzUQCb822HcdhmH0aMbC_n6HAba61bq-pfP5IMvkSPJC1CPBWkdw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQGBc4fGJb653yHqRBmSPfaUINoHW-AGDJb1Z--5km7_A&oe=6B0DA22E"}, {"file_name": "eqewqe.png", "id": "904236509040327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824328_904236545706990_2443296171105324307_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOoB1_0e5jIQ7kNvwF3Wzom&_nc_oc=Adpm8aUcsOSqOgtzzEspomxErx8s67DzrGV-A9CEmNMtZ7pihvBoAbwQ9krjVPYRCLQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRFQxKMLB3619E-C0lJs6OcTv5DJXJt7ERGwehDoIqzuA&oe=6B0DB5A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkeys Monsters Mayhem", "keywords": ["Monkey", "Scary", "Monsters", "3D", "VR"], "long_description": "Monkey Monster Mayhem is a multiplayer social VR experience built for Meta Quest. Swing, climb, and scramble through wild environments using gorilla-tag-style hand-based locomotion \u2014 no joystick, just your body. Move by pushing off surfaces with your hands and launch yourself across the map with pure momentum.\n\nBut watch out \u2014 monsters are hunting you. Evade AI-driven creatures that wander the world and chase you down the moment you get too close. Survive with friends or go solo across unique environments including caves and open arenas.\n\nHand-physics-based locomotion inspired by Gorilla Tag\nMultiplayer powered by Photon \u2014 race and survive with friends\nAI monsters that detect and chase players in real time\nUnique maps to explore and escape through", "short_d
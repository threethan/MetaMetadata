ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYEw_ZYA3g95s9Zd0mG9_h0Ub8pq54rZ8CCdD9LJ-RWw&oe=6A64A9EE"}, {"file_name": "eqewqe.png", "id": "904236509040327", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824328_904236545706990_2443296171105324307_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej8DYlwCaVsQ7kNvwFHgBb2&_nc_oc=AdpoV3d1NWDIWNJGHzVt9fIRI7rghCEsLrSJ_wEFAGG_TDIihTH20OELv4QubZvL-kM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChmlOKK-u5LB0WGqaJIALcZ8wzQKNDSZsj9eKN5nQRUw&oe=6A64BD64"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkeys Monsters Mayhem", "keywords": ["Monkey", "Scary", "Monsters", "3D", "VR"], "long_description": "Monkeys Monsters Mayhem is a multiplayer social VR experience built for Meta Quest. Swing, climb, and scramble through wild environments using gorilla-tag-style hand-based locomotion \u2014 no joystick, just your body. Move by pushing off surfaces with your hands and launch yourself across the map with pure momentum.\n\nBut watch out \u2014 monsters are hunting you. Evade AI-driven creatures that wander the world and chase you down the moment you get too close. Survive with friends or go solo across unique environments including caves and open arenas.\n\nHand-physics-based locomotion inspired by Gorilla Tag\nMultiplayer powered by Photon \u2014 race and survive with friends\nAI monsters that detect and chase players in real time\nUnique maps to explore and escape through", "short_description": "Climb, swing, and survive. Monsters are hunting you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/113YaXSbOr3EB71fbxhmSB7wiSC1_Y1qVOElL_SZMJ-s/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1--8eSejaqgU8MbgwiqgZjkG6Vmj5XKJVJGLfS3mS6PE/edit?usp=drivesdk", "publisher_name": "Leyth", "support_website_url": "https://docs.google.com/document/d/1-3xJbcRAYIN0ts_bgkUFF37Hvn_3ylcD
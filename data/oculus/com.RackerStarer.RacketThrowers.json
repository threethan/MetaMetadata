=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK8x4eN_MAublPqoglBTMQZdwslpb3nqIQFjdIRiszgw&oe=6B05C483"}, {"file_name": "pictu4.png", "id": "789595063762890", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823271_789595070429556_7764697176195493298_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNVH0Ph1T6QQ7kNvwHYY5qW&_nc_oc=AdoJAjOaasEIaPg83MCWd7yPkSVO21b4OUegR9l_ODA0hwSusjqeo7lW6_SyC3Ed6LY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxxejmgeh3IEGbOtrdin7eLOaEeR_QhvF4UiHju1mK4w&oe=6B05B92E"}, {"file_name": "eqewqe.png", "id": "904236509040327", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824328_904236545706990_2443296171105324307_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2Cvd61X9TkQ7kNvwH_eato&_nc_oc=AdoRC9HEMbp2at0oxTxVYJBlVr2KkN1cwc-5NHDjVKrLE42j4It-7LHZIQucdVjVNFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEp1u6iN4bGIVSKD8eb_hDoQVyzLmIDvxnuw5dqrDsBQ&oe=6B05CCA4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkeys Monsters Mayhem", "keywords": ["Monkey", "Scary", "Monsters", "3D", "VR"], "long_description": "Monkey Monster Mayhem is a multiplayer social VR experience built for Meta Quest. Swing, climb, and scramble through wild environments using gorilla-tag-style hand-based locomotion \u2014 no joystick, just your body. Move by pushing off surfaces with your hands and launch yourself across the map with pure momentum.\n\nBut watch out \u2014 monsters are hunting you. Evade AI-driven creatures that wander the world and chase you down the moment you get too close. Survive with friends or go solo across unique environments including caves and open arenas.\n\nHand-physics-based locomotion inspired by Gorilla Tag\nMultiplayer powered by Photon \u2014 race and survive with friends\nAI monsters that detect and chase players in real time\nUnique maps to explore and escape through", "short_d
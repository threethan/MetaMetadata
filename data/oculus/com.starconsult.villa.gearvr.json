9D26BFA"}, {"file_name": "migrated_image.png", "id": "206900253920345", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162684_127623467967516_5280737387935170560_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b_dSsK0tSicQ7kNvwEc1ZW8&_nc_oc=Adr8tW-mJc-VW-hjWc6FaD90QnXmAjEcuXeUFuZKCGiFJnTOyNSpO1MhXpMtCv957Jk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uyq5H6pUfjJisjoZww2NnbyHs-1WKvylUrQgBHUMdpA&oe=69D25F72"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-assets-store-cover-art-landscape.png", "id": "127037528021481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162690_127037568021477_5181471678588256256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUEPhp-6IZEQ7kNvwHra7jT&_nc_oc=AdrvVvSJtc_UuIQAQK5piLh5UAi6q6HYa0WOyPbCOlcOIJU9fCb9B_IrGzNha9Y5Oi0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ov-VD8iB4pFNKaFMj6-ne0wcwePD05yYpzH1OKbZObw&oe=69D2530A"}, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "hospital", "cathedral", "house"], "long_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nAfter \"The Hospital\" and \"The Cathedral\", \"The Villa\" is the last chapter\nof the Allison's Diary horror trilogy, where you will relive, through flashbacks and immersive cinematic effects, the frightening night in which Allison killed her parents in 1956.\n\nTerrifying jump scares and a super realistic environment \nmake \"The Villa\" one of the best horror experiences for Gear VR.", "short_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nRelive through flashbacks, immersive cinematic effects and terrifying jump scares, the night Allison killed her parents in 1956."}, {"images": {"nodes": []}, "id": "2569117756742617", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "T
m/v/t64.5771-25/11162684_127623467967516_5280737387935170560_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSjB-hYwGwgQ7kNvwH7xZ5T&_nc_oc=Adrjm3aJODzd8Jt_JKi8K92BoFCt0pt_KW2FzoPtdMvWhg3N2HeOWYY5lHA13TeJ4KA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcTWLhlVc_sF1vSGiIiZwa7D-eGTMlKoTfBn26G1R8rA&oe=6AC8E7F2"}, {"file_name": "migrated_image.png", "id": "218688195910844", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162730_131698994136885_6249069027885318144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p724ir5ZF3UQ7kNvwH7-wX8&_nc_oc=AdoooeSgDXM6fHjS6r_3PNl1VvkVcBQb2IdFuRNk0Pi6_2FpqlZU2mqWr0tMXbtHX28&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIxNrLsYK-7hTTLxGoGAi7H3n_SpbXPtEa_vbY8WLYrA&oe=6AC91B7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "hospital", "cathedral", "house"], "long_description": "A villa, a daily routine and an apparently happy family. Here is where everything began.\n\nAfter \"The Hospital\" and \"The Cathedral\", \"The Villa\" is the last chapter of the Allison's Diary horror trilogy, where you will relive, through flashbacks and immersive cinematic effects, the frightening night in which Allison killed her parents in 1956.\n\nTerrifying jump scares and a super realistic environment make \"The Villa\" one of the best horror experiences for VR.", "short_description": "A villa, a daily routine and an apparently happy family. Here is where everything began.\n\nRelive through flashbacks, immersive cinematic effects and terrifying jump scares, the night Allison killed her parents in 1956."}, {"images": {"nodes": []}, "id": "491108371797978", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Villa: Allison's Diary", "keywords": ["orrore", "villa", "ospedale", "cattedrale", "house"], "long_description": "Una villa, una routine quotidiana ed una famiglia apparentemente felice. Ecco dove tutto cominci\u00f2.\n\nDopo \"The Hospital\" e \"The Cathedral\", \"The Villa\" \u00e8 l'ultimo capitolo della trilogia horror Allison's Diary, dove rivivrai, attraverso flashback ed effetti cinematografici immersivi, la spaventosa notte in cui Allison uccise i suoi genitori nel 1956.\n\nJump scares terrificanti ed un ambiente super realistico rendono \"The Villa\" una delle migliori esperienze horror per VR.", "short_description": "Una villa, una routine quotidiana ed una famiglia apparentemente felice. Ecco dove tutto cominci\u00f2.\n\nRivivi attraverso flashback, effetti cinematografici immersivi e terrificanti \njump scares, la notte in cui Allison uccise i suoi genitori nel 1956."}]}, "developer_name": "KR Games", "developer_privacy_policy_url": "http://www.krgames.it/privacy-policy", "developer_terms_of_service_url": "http://www.krgames.it/en/terms-and-conditions", "publisher_name": "Star Consult S.r.L.", "support_website_url": null, "website_url": "http://www.krgames.it/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "HORROR", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "658679578664433"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162769_1895485714102495_6392985651033145344_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9O7714vYDAYQ7kNvwFnI31l&_nc_oc=AdrOvW-
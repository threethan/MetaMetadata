ABA73FA"}, {"file_name": "migrated_image.png", "id": "206900253920345", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162684_127623467967516_5280737387935170560_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cn8ZMnWwjecQ7kNvwH9SlzX&_nc_oc=AdpvGz7G5It9xxg5EHMrdJEl11o2z9y8IiGs9gjU12bcG4Mh3Twk1KmNz7krs8tR9Yc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAHsqXTiBhsLebm8xSZYJzHKrfS8EBABTbFzlKsbze5w&oe=6ABA6772"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-assets-store-cover-art-landscape.png", "id": "127037528021481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162690_127037568021477_5181471678588256256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GHEMjfBpXQ8Q7kNvwEYZKHy&_nc_oc=AdpdKF4Kocdvs4GWwnu2z8pQTH1o6Ah-olori-iQOsdgjSlhHM-7UvEPsRJnITDSWRQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQC4uFb4q_FA1TGxatvcBo8qXg2LeO0qAWPtnvrX94xA&oe=6ABA5B0A"}, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "hospital", "cathedral", "house"], "long_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nAfter \"The Hospital\" and \"The Cathedral\", \"The Villa\" is the last chapter\nof the Allison's Diary horror trilogy, where you will relive, through flashbacks and immersive cinematic effects, the frightening night in which Allison killed her parents in 1956.\n\nTerrifying jump scares and a super realistic environment \nmake \"The Villa\" one of the best horror experiences for Gear VR.", "short_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nRelive through flashbacks, immersive cinematic effects and terrifying jump scares, the night Allison killed her parents in 1956."}, {"images": {"nodes": []}, "id": "2569117756742617", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "T
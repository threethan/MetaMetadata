9FF3EFA"}, {"file_name": "migrated_image.png", "id": "206900253920345", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162684_127623467967516_5280737387935170560_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyEhLWD2G8cQ7kNvwE9oaWf&_nc_oc=AdpvWQ1U3Q4P748bRTiiIf4T5gPoM0uCTZMgMKBSVlladdfoJVBpqDktX_V92LOcmo0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fVYCkezxTZ0tgl7UUhQZnA48uf9R1pEHl3KEnAEnDlA&oe=69FF3272"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-assets-store-cover-art-landscape.png", "id": "127037528021481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162690_127037568021477_5181471678588256256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0z1QrxhtFQQ7kNvwHgl3nV&_nc_oc=Adp_C4b9AuGVt6Kgik5KbwmmBoa2ovDUsDmc8q9ELhi3d0JHtvrTEKPGQ19QKFCiNPQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TqZEJ3wRh4B8taDVPNqWZE2g1oKOta0xRS2Or-7VIvg&oe=69FF260A"}, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "hospital", "cathedral", "house"], "long_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nAfter \"The Hospital\" and \"The Cathedral\", \"The Villa\" is the last chapter\nof the Allison's Diary horror trilogy, where you will relive, through flashbacks and immersive cinematic effects, the frightening night in which Allison killed her parents in 1956.\n\nTerrifying jump scares and a super realistic environment \nmake \"The Villa\" one of the best horror experiences for Gear VR.", "short_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nRelive through flashbacks, immersive cinematic effects and terrifying jump scares, the night Allison killed her parents in 1956."}, {"images": {"nodes": []}, "id": "2569117756742617", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "T
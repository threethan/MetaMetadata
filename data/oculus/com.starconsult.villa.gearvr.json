AF8A2BA"}, {"file_name": "migrated_image.png", "id": "206900253920345", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162684_127623467967516_5280737387935170560_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1e5U8AvoO4Q7kNvwHjbfYM&_nc_oc=Ado-dV4-24nNG46JaJL5Op1-YsS71ix9_0i_xnGIZb6Q2iNxROLO-xYiawgdCnq4cdo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr65ffGCjxNJYA5-l3mg579nPrpkJQ18uoUSqHa0jwyg&oe=6AF89632"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-assets-store-cover-art-landscape.png", "id": "127037528021481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162690_127037568021477_5181471678588256256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zv0mho4Ui8YQ7kNvwHXJLmA&_nc_oc=Adppm9_K2H0mVPa-g791Wg_YruTe0Qx3gKRW--Lug5Gsa9Iy4--fyqZ6ICJUjERXQ-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVCVd_7bidnKuwBN_XHd0Puqrfm9hg0a6Yo8LGA0giOA&oe=6AF889CA"}, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "hospital", "cathedral", "house"], "long_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nAfter \"The Hospital\" and \"The Cathedral\", \"The Villa\" is the last chapter\nof the Allison's Diary horror trilogy, where you will relive, through flashbacks and immersive cinematic effects, the frightening night in which Allison killed her parents in 1956.\n\nTerrifying jump scares and a super realistic environment \nmake \"The Villa\" one of the best horror experiences for Gear VR.", "short_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nRelive through flashbacks, immersive cinematic effects and terrifying jump scares, the night Allison killed her parents in 1956."}, {"images": {"nodes": []}, "id": "2569117756742617", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "T
9E783FA"}, {"file_name": "migrated_image.png", "id": "206900253920345", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162684_127623467967516_5280737387935170560_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7MO8rFjk0wQ7kNvwE42LNj&_nc_oc=AdqjNwUuCdPwVXJtv1pDWXY5S_ctfwVfe-V4XqrtAR2pmMPIGMOmM43Pu-K3UnQz5vc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WHyzLeRqPe0i0dVap8zIg2e4jZ6CyVxEpp2Gt_LFmQQ&oe=69E77772"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-assets-store-cover-art-landscape.png", "id": "127037528021481", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162690_127037568021477_5181471678588256256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGEQqnFER4QQ7kNvwFPsTlz&_nc_oc=AdpZQpo75jqcrUa8Ih2fQ-WABwH1lgsX_x93d0-PINV1sNOgy3YO9YbqIne6P-AkE9E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YGghaC8ZkRwBEqk0-VfC3y9sbfrVUXhdwQA2TG2XMDg&oe=69E76B0A"}, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "hospital", "cathedral", "house"], "long_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nAfter \"The Hospital\" and \"The Cathedral\", \"The Villa\" is the last chapter\nof the Allison's Diary horror trilogy, where you will relive, through flashbacks and immersive cinematic effects, the frightening night in which Allison killed her parents in 1956.\n\nTerrifying jump scares and a super realistic environment \nmake \"The Villa\" one of the best horror experiences for Gear VR.", "short_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nRelive through flashbacks, immersive cinematic effects and terrifying jump scares, the night Allison killed her parents in 1956."}, {"images": {"nodes": []}, "id": "2569117756742617", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "T
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhBLWAsmxwoQ7kNvwHhSkao&_nc_oc=AdpUxMwZy4AwLYcZVW2zs-1IwU21YIcSaE7GMjXRuR4Ps2E7WTyJg8Yyh1gR6qnDRlM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af00Vk0ZfULlLvPkct3EjVh7DzhhI6Btv9j0_u7TktKoJA&oe=69F20372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-assets-store-cover-art-landscape.png", "id": "127037528021481", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162690_127037568021477_5181471678588256256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEnaix6vCXYQ7kNvwGCbsG8&_nc_oc=AdpfYqTQbFEVkogcMZhlTkxMoX8wWnbW-8zq3QQ4R2whRUB_GawpzaB6QUt7FEfitFU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DMK1OZk3nR9dtI8hoDtJ5U50HaafTlPCwnulntqDNXw&oe=69F1F70A"}, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "hospital", "cathedral", "house"], "long_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nAfter \"The Hospital\" and \"The Cathedral\", \"The Villa\" is the last chapter\nof the Allison's Diary horror trilogy, where you will relive, through flashbacks and immersive cinematic effects, the frightening night in which Allison killed her parents in 1956.\n\nTerrifying jump scares and a super realistic environment \nmake \"The Villa\" one of the best horror experiences for Gear VR.", "short_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nRelive through flashbacks, immersive cinematic effects and terrifying jump scares, the night Allison killed her parents in 1956."}, {"images": {"nodes": []}, "id": "2569117756742617", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "ospedale", "cattedrale", "house"], "long_description": "Una villa, una routine quotidiana ed una famiglia apparentemente felice.\nEcco dove tutto cominci\u00f2.\n\nDopo \"The Hospital\" e \"The Cathedral\", \"The Villa\" \u00e8 l'ultimo capitolo della trilogia horror Allison's Diary, dove rivivrai, attraverso flashback ed effetti cinematografici immersivi, la spaventosa notte in cui Allison uccise i suoi genitori nel 1956.\n\nJump scares terrificanti ed un ambiente super realistico\nrendono \"The Villa\" una delle migliori esperienze horror per Gear VR.", "short_description": "Una villa, una routine quotidiana ed una famiglia apparentemente felice.\nEcco dove tutto cominci\u00f2.\n\nRivivi attraverso flashback, effetti cinematografici immersivi e terrificanti \njump scares, la notte in cui Allison uccise i suoi genitori nel 1956."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.krgames.it/privacy-policy", "developer_terms_of_service_url": "http://www.krgames.it/en/terms-and-conditions", "publisher_name": "Star Consult S.r.L.", "support_website_url": null, "website_url": "http://www.krgames.it/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION", "HORROR", "SIMULATION", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1118818728874540"}}]}, "scheduled_offers": {"count": 48, "nodes": [{"status": "PUBLISHED", "id": "275573809752534"}, {"status": "PUBLISHED", "id": "722331274841637"}, {"status": "PUBLISHED", "id": "417683045652005"}, {"status": "PUBLISHED", "id": "1280088675662581"}, {"status": "PUBLISHED", "id": "193646235379840"}, {"sta
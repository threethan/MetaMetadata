A8AC5BA"}, {"file_name": "migrated_image.png", "id": "206900253920345", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162684_127623467967516_5280737387935170560_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0X1yicg7f6kQ7kNvwFALqhb&_nc_oc=AdrW9lwM2-B_--17YgBNJloaDDn6bqTH8VzB7O9p5B1leXHwN0tPgM_Ap5F5x6kjHAc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjgGwNmurO-n1Bs3w8dOHNp4OXv2WIIxh_6qPhi09yow&oe=6A8AF172"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-assets-store-cover-art-landscape.png", "id": "127037528021481", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162690_127037568021477_5181471678588256256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haShv_XNQlsQ7kNvwGN0-vL&_nc_oc=AdqWl4f0g6dfD4UPzjpT4BchGcScQn_RwSX2AkCy6M4Q3XMYZFua9y83Y3E5P_mXVOk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcdG-lFqxXAItXlBlFp-wCO1-jFr02pzmOURN4HUxcwQ&oe=6A8AE50A"}, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "hospital", "cathedral", "house"], "long_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nAfter \"The Hospital\" and \"The Cathedral\", \"The Villa\" is the last chapter\nof the Allison's Diary horror trilogy, where you will relive, through flashbacks and immersive cinematic effects, the frightening night in which Allison killed her parents in 1956.\n\nTerrifying jump scares and a super realistic environment \nmake \"The Villa\" one of the best horror experiences for Gear VR.", "short_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nRelive through flashbacks, immersive cinematic effects and terrifying jump scares, the night Allison killed her parents in 1956."}, {"images": {"nodes": []}, "id": "2569117756742617", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "T
9F8A77A"}, {"file_name": "migrated_image.png", "id": "206900253920345", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162684_127623467967516_5280737387935170560_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=924cgIDcqxcQ7kNvwHfI_Jj&_nc_oc=Adp_6D_YNPKWJkXCCMcGPgfOyzdIYqeNXVE2BLManwAQ1JcbLJ4XZq7O9I5fm6yXt1Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XXDE6gN9N2oj1_fjrI5JlTtpIvn1GzDDa4mfu9XhHLw&oe=69F89AF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-assets-store-cover-art-landscape.png", "id": "127037528021481", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162690_127037568021477_5181471678588256256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tXyrXF9THAQ7kNvwFfK-Bv&_nc_oc=AdoPl2LYU86MWX7mU0SB9CWctbcF7GzLPqZ7GTM0Jr3yV3zaX4LL-Eg_gFFYeJyevIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2fXGdptWzRP99jlT0f13C6AbAc2am0Bi0oGgLIzJM0Kw&oe=69F88E8A"}, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "hospital", "cathedral", "house"], "long_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nAfter \"The Hospital\" and \"The Cathedral\", \"The Villa\" is the last chapter\nof the Allison's Diary horror trilogy, where you will relive, through flashbacks and immersive cinematic effects, the frightening night in which Allison killed her parents in 1956.\n\nTerrifying jump scares and a super realistic environment \nmake \"The Villa\" one of the best horror experiences for Gear VR.", "short_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nRelive through flashbacks, immersive cinematic effects and terrifying jump scares, the night Allison killed her parents in 1956."}, {"images": {"nodes": []}, "id": "2569117756742617", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "T
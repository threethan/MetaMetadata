A1C3FFA"}, {"file_name": "migrated_image.png", "id": "206900253920345", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/11162684_127623467967516_5280737387935170560_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxaWh3KL8CoQ7kNvwFvjmLh&_nc_oc=Ado4uaa5mZFSSDKFwjRFUvTgxhrzOFRehWJSy1MpmETjsPZ6Fx8OJ0t7U3BGtjFv5FE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WXAJVxChiTZSaux2zLDQ2TMWRwJFKZ30Nu2cqjRGg3A&oe=6A1C3372"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-assets-store-cover-art-landscape.png", "id": "127037528021481", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/11162690_127037568021477_5181471678588256256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-S_1xsTDgAYQ7kNvwHFMfEj&_nc_oc=AdqnZfZY5T411EMEgqPi-1z4mcg37G01dgmbvNwjuKgVE0aq5pmR5r7ge9DXqL2133E&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aNDLaSde2VcG_puvBmelJjKAc3VdmKZscYxqwO64CGg&oe=6A1C5F4A"}, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "hospital", "cathedral", "house"], "long_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nAfter \"The Hospital\" and \"The Cathedral\", \"The Villa\" is the last chapter\nof the Allison's Diary horror trilogy, where you will relive, through flashbacks and immersive cinematic effects, the frightening night in which Allison killed her parents in 1956.\n\nTerrifying jump scares and a super realistic environment \nmake \"The Villa\" one of the best horror experiences for Gear VR.", "short_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nRelive through flashbacks, immersive cinematic effects and terrifying jump scares, the night Allison killed her parents in 1956."}, {"images": {"nodes": []}, "id": "2569117756742617", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "T
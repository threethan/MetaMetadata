9CA82FA"}, {"file_name": "migrated_image.png", "id": "206900253920345", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162684_127623467967516_5280737387935170560_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAFfg5cjIUsQ7kNvwG8SbQC&_nc_oc=Adpwd7cSE2dza3KSWRGqeby9_fF7kYlW-OaekijuZkN7hgEPHpHYIKPy5dP_rzX4A1E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyzAhS4-k4dYNmWAM7DgkZplsFetnU90KjrRJJ4jQboA&oe=69CA7672"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "oculus-assets-store-cover-art-landscape.png", "id": "127037528021481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162690_127037568021477_5181471678588256256_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTqv0YRrmYoQ7kNvwGwKe2O&_nc_oc=Adqdej15KX5wiwmNllgtMju5mcCs5SpLVtTkcNM5qyxLw_kDxENqB1Itw5xxwwnmbVI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycvaoLncPVBE-2WAilqxZANGHwVV54yyfOyuZwuKYssw&oe=69CA6A0A"}, "display_name": "The Villa: Allison's Diary", "keywords": ["horror", "villa", "hospital", "cathedral", "house"], "long_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nAfter \"The Hospital\" and \"The Cathedral\", \"The Villa\" is the last chapter\nof the Allison's Diary horror trilogy, where you will relive, through flashbacks and immersive cinematic effects, the frightening night in which Allison killed her parents in 1956.\n\nTerrifying jump scares and a super realistic environment \nmake \"The Villa\" one of the best horror experiences for Gear VR.", "short_description": "A villa, a daily routine and an apparently happy family.\nHere is where everything began.\n\nRelive through flashbacks, immersive cinematic effects and terrifying jump scares, the night Allison killed her parents in 1956."}, {"images": {"nodes": []}, "id": "2569117756742617", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "T
_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0Ubn0D81xY8L4XUajPUIQBj2tfljQR7kLjQe1VBxFURg&oe=69F200C8"}, {"file_name": "SShot1.png", "id": "1052656396683583", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392192_1052656400016916_6772429292368311895_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTm8TkZ41b0Q7kNvwEgR0Fb&_nc_oc=AdoHY4qSMgGRRzw7gYxVGAmZ7_rE_n8-2VQYw-cIvoydMEP-B_W_bU6VdOKAb0ny-yw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2WAeK4hUoC19kHuJYr9uHaTwuVlBdksYTI_toUYzMsjw&oe=69F1EEFC"}, {"file_name": "SShot5.png", "id": "2142433286242167", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391921_2142433292908833_5033607693573051958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gr0Hc9huCrEQ7kNvwEwjjt4&_nc_oc=AdqH0KnOmzi9a9eF84OAkXZb-ykgKw8PD51Aq2H_pp_UCbIi2x1flRssIJR_pu539eg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1GCxGp-E80IsfCFtCrGHF8x1FAwfs2Fux3wOHRz4GcQg&oe=69F20F81"}, {"file_name": "SShot2.png", "id": "902595615165562", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391955_902595618498895_3846210877205317113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zALRSRtHo-EQ7kNvwHy1BKh&_nc_oc=Ado99dbjZKqa8ul90wX9ru444TOJIbQXMD7jC2d5jHdqG-Za9Jj2VIHihXFnRsLe3CY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lE2MTqqknGEFxUqQKygw-255qHfEw7cZ45jEpy7iWzA&oe=69F1E519"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Human Anatomy Male", "keywords": [], "long_description": "Explore Human Anatomy Like Never Before! \ud83e\udde0\u2728\n\nStep into a fully immersive Virtual Reality experience designed for students, educators, and medical enthusiasts. Human Anatomy VR offers an interactive way to learn about the human body with lifelike 3D models, animations, and engaging activities.\n\nKey Features:\n Classroom Mode \u2013 Learn about organs, systems, and functions with detailed descriptions.\n Interactive Mode \u2013 Test your knowledge with quizzes and hands-on activities.\n Practical Mode \u2013 Assemble organs to form complete body systems.\n High-Quality 3D Models \u2013 Explore every detail of the human body in stunning realism.\n Engaging & Educational \u2013 Perfect for students, medical professionals, and VR enthusiasts.\n\n Whether you\u2019re a beginner or an expert, Human Anatomy VR makes learning fun, interactive, and unforgettable!\n\nDownload now and experience anatomy in a whole new way! ", "short_description": " Explore the Human Body in VR! Dive into an interactive 3D experience to learn anatomy like never before. Study organs, systems, and functions in an immersive virtual classroom. Perfect for students, educators, and medical enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mycart3d.com/three-one/PrivasyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "thiruchitrambalam", "support_website_url": null, "website_url": "https://mycart3d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9440015106082426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392127_1326051002055676_2563725649814756389_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-MY6mexXKUQ7kNvwHc8F35&_nc_oc=AdpqDb4PYRsJYYqRCnfeKLkaG5NlOJVZ
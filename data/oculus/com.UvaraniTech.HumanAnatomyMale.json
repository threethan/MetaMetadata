683583", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473392192_1052656400016916_6772429292368311895_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rfcr6CpdME8Q7kNvwH724XY&_nc_oc=Ado-8_zSbnCuBv-Nd8DGv4ZH1XFKbRkDzT25Sv2vvcc_fYtNh_JjeiGoZdd35O03YEQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYYIBqhOxAB2Nt5PzmHRavqfoF5VznXWfDYf9rDpJ2ZQ&oe=6B09A53C"}, {"file_name": "SShot5.png", "id": "2142433286242167", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391921_2142433292908833_5033607693573051958_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nIam2RFkmQQ7kNvwE66_qf&_nc_oc=AdrXAsbOXFbF9BltaPiv9rWr2SRBuUkmJakh8JHKplSIC6gceLq2NbKX8tCX1Q9_l6A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDJpuUxgbbnWzWk-l4khjRCbDoD7sWnr6cPyrdoH9owQ&oe=6B09C5C1"}, {"file_name": "SShot2.png", "id": "902595615165562", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391955_902595618498895_3846210877205317113_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lykLnSvyPFsQ7kNvwEIW_9J&_nc_oc=AdoT7fLbiltjdFO9HD2uq9rN_0mkXLhd4ay_Ig3vFoDjBtkrTZslqW7RmdlBHeTOH-o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3U5kkuRdjTQKGGBMgx4pkCkIE9TGE2RTTaTCXYl3ujQ&oe=6B099B59"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Human Anatomy Male", "keywords": [], "long_description": "Explore Human Anatomy Like Never Before! \ud83e\udde0\u2728\n\nStep into a fully immersive Virtual Reality experience designed for students, educators, and medical enthusiasts. Human Anatomy VR offers an interactive way to learn about the human body with lifelike 3D models, animations, and engaging activities.\n\nKey Features:\n Classroom Mode \u2013 Learn about organs, systems, and functions with detailed descriptions.\n Interactive Mode \u2013 Test your knowledge with quizzes and hands-on activities.\n Practical Mode \u2013 Assemble organs to form complete body systems.\n High-Quality 3D Models \u2013 Explore every detail of the human body in stunning realism.\n Engaging & Educational \u2013 Perfect for students, medical professionals, and VR enthusiasts.\n\n Whether you\u2019re a beginner or an expert, Human Anatomy VR makes learning fun, interactive, and unforgettable!\n\nDownload now and experience anatomy in a whole new way! ", "short_description": " Explore the Human Body in VR! Dive into an interactive 3D experience to learn anatomy like never before. Study organs, systems, and functions in an immersive virtual classroom. Perfect for students, educators, and medical enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mycart3d.com/three-one/PrivasyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "thiruchitrambalam", "support_website_url": null, "website_url": "https://mycart3d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9440015106082426"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1145668956845419"}]}, "baseline_offer": {"id": "1145668956845419"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743704700, "status": "PUBLISHED", "id": "1145668956845419"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "A
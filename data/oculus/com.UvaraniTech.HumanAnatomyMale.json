5143547518883", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391946_715143550852216_1030588642845316793_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wiWcdb9t7oQ7kNvwGYu80I&_nc_oc=AdqlQTTalrS13ONNL3Cr74i_b949-3JBd9fk4VkM7v2L5fsA0SewjqXj9C7Rpn6YnIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUHV1rqpKE7wVBCVtp0pO2ICB7qFK85ULDfcSQSvZeZyg&oe=6B104E88"}, {"file_name": "SShot1.png", "id": "1052656396683583", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392192_1052656400016916_6772429292368311895_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQ8PlbgIbb0Q7kNvwH-Rbjt&_nc_oc=AdrYgVXFi_KvuCFvaj-EHRsPgt6i5lizC0TQbkq0l-4DcL1UMqlAmvkgqcGwZpPHaUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKaxPS42P6_7_pZGfnLzL_3h0HaYDzZYTpG9dfNKQP8w&oe=6B103CBC"}, {"file_name": "SShot5.png", "id": "2142433286242167", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391921_2142433292908833_5033607693573051958_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x93DZwlrQ2EQ7kNvwFA_Q_i&_nc_oc=AdqqDCEZQE5d9Ep3-eyGew06IPiHYGKrWHdYzPZ0mRmcaTobhSek2rP-RL2A6anZC8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8zw1J39x0aBRudsl_jooLBu1Jw8X2Ps8N9ClDf8xLEA&oe=6B105D41"}, {"file_name": "SShot2.png", "id": "902595615165562", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391955_902595618498895_3846210877205317113_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RgGfBK05MAQ7kNvwGwnzrS&_nc_oc=Adr2nC0KtxvsGbbtypCinJvHMUGWBMuZcgeJUAAYfuKDpg9TsEeCE3xI2zMtV1Kws-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjM2HJwSws8_BokjOH8zIW1CyWFmwfCvqAW2023uyUsw&oe=6B106B19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Human Anatomy Male", "keywords": [], "long_description": "Explore Human Anatomy Like Never Before! \ud83e\udde0\u2728\n\nStep into a fully immersive Virtual Reality experience designed for students, educators, and medical enthusiasts. Human Anatomy VR offers an interactive way to learn about the human body with lifelike 3D models, animations, and engaging activities.\n\nKey Features:\n Classroom Mode \u2013 Learn about organs, systems, and functions with detailed descriptions.\n Interactive Mode \u2013 Test your knowledge with quizzes and hands-on activities.\n Practical Mode \u2013 Assemble organs to form complete body systems.\n High-Quality 3D Models \u2013 Explore every detail of the human body in stunning realism.\n Engaging & Educational \u2013 Perfect for students, medical professionals, and VR enthusiasts.\n\n Whether you\u2019re a beginner or an expert, Human Anatomy VR makes learning fun, interactive, and unforgettable!\n\nDownload now and experience anatomy in a whole new way! ", "short_description": " Explore the Human Body in VR! Dive into an interactive 3D experience to learn anatomy like never before. Study organs, systems, and functions in an immersive virtual classroom. Perfect for students, educators, and medical enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mycart3d.com/three-one/PrivasyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "thiruchitrambalam", "support_website_url": null, "website_url": "https://mycart3d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player
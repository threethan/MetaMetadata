b=1-7&_nc_sid=6e7a0a&_nc_ohc=6N0Rr2HFCuQQ7kNvwGKFs6d&_nc_oc=Adpojt6ihU95V3Ng-x-F9AVxb8PcgYPdg61XjwMW4hau07_5xNNGVCc31r5GUHej0zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgKAcd8MSSJ54A5fRip7D3UdVQDpB2Hj0j5scgGf8EZA&oe=6AB3DC01"}, {"file_name": "SShot2.png", "id": "902595615165562", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391955_902595618498895_3846210877205317113_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yaz0JpvlGywQ7kNvwGGU2Da&_nc_oc=Adpr0bGMR9rCxnhjHxjXXyk1v6NQy-rEF7HElKI5kDlDWbLJiYYA_ketR29BrqtqubU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx0efG_2K5hdLDLZtqL9buEkn0spDBG5jz0LoqCMrAUA&oe=6AB3E9D9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Human Anatomy Male", "keywords": [], "long_description": "Explore Human Anatomy Like Never Before! \ud83e\udde0\u2728\n\nStep into a fully immersive Virtual Reality experience designed for students, educators, and medical enthusiasts. Human Anatomy VR offers an interactive way to learn about the human body with lifelike 3D models, animations, and engaging activities.\n\nKey Features:\n Classroom Mode \u2013 Learn about organs, systems, and functions with detailed descriptions.\n Interactive Mode \u2013 Test your knowledge with quizzes and hands-on activities.\n Practical Mode \u2013 Assemble organs to form complete body systems.\n High-Quality 3D Models \u2013 Explore every detail of the human body in stunning realism.\n Engaging & Educational \u2013 Perfect for students, medical professionals, and VR enthusiasts.\n\n Whether you\u2019re a beginner or an expert, Human Anatomy VR makes learning fun, interactive, and unforgettable!\n\nDownload now and experience anatomy in a whole new way! ", "short_description": " Explore the Human Body in VR! Dive into an interactive 3D experience to learn anatomy like never before. Study organs, systems, and functions in an immersive virtual classroom. Perfect for students, educators, and medical enthusiasts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mycart3d.com/three-one/PrivasyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "thiruchitrambalam", "support_website_url": null, "website_url": "https://mycart3d.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9440015106082426"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1145668956845419"}]}, "baseline_offer": {"id": "1145668956845419"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743704700, "status": "PUBLISHED", "id": "1145668956845419"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9383172178433386", "version": ".2"}, "id": "1224562672608822", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9277894195627852", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9383172178433386"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1224562672608822"}]}, "change_log": null, "created_date": 1742919315, "id": "9383172
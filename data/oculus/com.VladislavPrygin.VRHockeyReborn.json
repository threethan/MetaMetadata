_908327660778757_3035287408522524435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUntsyh9cZsQ7kNvwFzktLL&_nc_oc=AdmgGdPcEgAGErfZMX4jKv6XBahLaX1lZg9gzVZ_6aCcotPyPkoBt_nrzMgHictBZ_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzR-ClB_UEy6adFkJ3wZRMJl8QczodlQzZ51Z9nc0op0w&oe=69B006E8"}, {"file_name": "screen_2560x1440_2024-02-17_17-50-48.png", "id": "717665680347647", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75278190_717665683680980_8625078549284746248_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhsHm8aDp4sQ7kNvwEApFvc&_nc_oc=Adlc5XLMmpGn6Vs-3-oifO3NQgkqA_GxhUs6GJUNuEIKDwG1nzARRzY9lqtN6jLXS18&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLgxvLaunzmdvNosBijXH9NpWfQC5kPyl6IEvgdeCo1A&oe=69AFF990"}, {"file_name": "screen_2560x1440_2024-02-17_18-01-33.png", "id": "412734524466035", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_412734527799368_107471335851124969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5JSIkTEdlwQ7kNvwESWexc&_nc_oc=AdkVhrPiH-kX7E92vz5Use6v1fuwPzet-fxI-RTwCw6OjWSGk58_io5AwbihFfuxAYE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWuqvAzeiEVaFbzJoN_lez3etGV71hIK3BNrEttCBkVQ&oe=69AFFAA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer.png", "id": "1234117440458633", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75210889_1234117443791966_1316267769628043711_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h18GsCOpiAQ7kNvwHGrrEU&_nc_oc=AdlRSUE1hRRrbADZT2QVOJddK8IntDwoy7cIpAw3u1X92TpL65d5LK2KbaDqphwrCtU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwh6jAwsYQZVcYf2CzSKMsOrA6nFKMJ1nzsGQQG8EYaog&oe=69B02AC1"}, "display_name": "VR Hockey Reborn", "keywords": [], "long_description": "VR Hockey Reborn was carefully created by a former hockey player. Our main goal is to create best experience for players who never tried play hockey, and to fit the requirements of all hockey players across the globe.\n\nExperiment with physics, feel the pleasure of the realism of puck possession, score goals in different ways.\n\nThe game is also suitable for beginners in hockey. You can even play with one hand.\n\n- Full control Multiplayer with ability to play for goalie \n- The feeling of being on the hockey rink\n- Attention to detail\n- Realistic puck possession physics\n- Animated pads going to butterfly and RVH depends on your movement\n- Tested by real hockey players", "short_description": "VR Hockey is here. Meet one of the most realistic VR hockey experiences."}]}, "developer_name": "Vladislav Prygin", "developer_privacy_policy_url": "https://pryginvl.wixsite.com/vr-hockey-reborn/privacypolicy", "developer_terms_of_service_url": "https://pryginvl.wixsite.com/vr-hockey-reborn/termsofuse", "publisher_name": "Vladislav Prygin", "support_website_url": null, "website_url": "http://npc-games.com/en", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7374917342547262"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031575_1077837660178146_7372377562988624626_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXHUcM9a1zkQ7kNvwE1-8W2&_nc_oc=AdkwXbYuW--pXGgQP-1pRcDQ97oelC4qFg5mVUC2FH1SqqWSIv68qzcNCQNNz7XIsU4&_nc_zt=3&_nc_ht=scont
_908327660778757_3035287408522524435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZuUfb-j_eQQ7kNvwHhx5x4&_nc_oc=AdmJRuEuvcZb3kgICKAZDNk-J0GQZV-IyLnLjzlT6nzgDz8BqjL94mCh2au2pAMHiOQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyNPHTct4MNkrwvZ4DmJQjEMUqEq8sISxGBeKc9ENUhAg&oe=69BD35E8"}, {"file_name": "screen_2560x1440_2024-02-17_17-50-48.png", "id": "717665680347647", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75278190_717665683680980_8625078549284746248_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLaJG0J2RKYQ7kNvwFCU5su&_nc_oc=AdnT_Xi-0niyQHRVlOaF_XzLtlB5z_IFpWu2KOIpKc7mX09gsw2b8O3KgwIgL2OxpU8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwO-2Hc4uOfs7MSNtwsDI6nbcZpi2_C-ATENt_VhGd2mw&oe=69BD2890"}, {"file_name": "screen_2560x1440_2024-02-17_18-01-33.png", "id": "412734524466035", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001670_412734527799368_107471335851124969_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_6RbizW8aoQ7kNvwFLB5C0&_nc_oc=AdmI0gNrsR5RdjAGs-147T-1rGKaXlIJjTlOlR-G1GIaDDY5k6_t6l7eY0C8jqdm2EE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzaOQ56Xbe-8JbMURfZvLLozauXbT9oiBZjjDxi3fJB0A&oe=69BD29A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Trailer.png", "id": "1234117440458633", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75210889_1234117443791966_1316267769628043711_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PkEWceu4SmAQ7kNvwEnZL4F&_nc_oc=AdkP_r88BTv1pj7MqKb1jNEqX76cNj0Wcv1HV7dVgYkQCETOVGyhgW4y7ZTfqE_p6Wc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzLC9OOCN0Bw87muTMV-Ap522LRyImaxJsHKjYwEOiXaA&oe=69BD59C1"}, "display_name": "VR Hockey Reborn", "keywords": [], "long_description": "VR Hockey Reborn was carefully created by a former hockey player. Our main goal is to create best experience for players who never tried play hockey, and to fit the requirements of all hockey players across the globe.\n\nExperiment with physics, feel the pleasure of the realism of puck possession, score goals in different ways.\n\nThe game is also suitable for beginners in hockey. You can even play with one hand.\n\n- Full control Multiplayer with ability to play for goalie \n- The feeling of being on the hockey rink\n- Attention to detail\n- Realistic puck possession physics\n- Animated pads going to butterfly and RVH depends on your movement\n- Tested by real hockey players", "short_description": "VR Hockey is here. Meet one of the most realistic VR hockey experiences."}]}, "developer_name": "Vladislav Prygin", "developer_privacy_policy_url": "https://pryginvl.wixsite.com/vr-hockey-reborn/privacypolicy", "developer_terms_of_service_url": "https://pryginvl.wixsite.com/vr-hockey-reborn/termsofuse", "publisher_name": "Vladislav Prygin", "support_website_url": null, "website_url": "http://npc-games.com/en", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7374917342547262"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031575_1077837660178146_7372377562988624626_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2w-fDYTV70Q7kNvwEU_MQw&_nc_oc=Adlnn89ZFNSDI2NbUwXisqMRaS5D5acfxQdYt_LUZbHnEFTODQuq9qBxf45Izpz9SkU&_nc_zt=3&_nc_ht=scont
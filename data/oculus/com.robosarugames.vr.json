uluscdn.com/v/t64.5771-25/12410280_902074463307786_6458417734030983168_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgPN6YMYv5wQ7kNvwGlvDcC&_nc_oc=Adn3kIVDx-HOMcS2JOl60WxA9-_DNW5_K6ZgexHWh0LJbjAeQZ6vVdgldaG9kjCuWkQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsY48UXmEtSCITlT3aaDW71mJPvliIicNAg04YJZw5DXw&oe=69A1917B"}, "display_name": "REFLEX UNIT", "keywords": [], "long_description": "The year is 2035 and Tokyo has been overrun by an unknown force. Communications with the rest of Japan and the world are down. With the Tokyo Police and Japan Self Defense Force (JSDF) destroyed in the first few hours of the invasion, it is up to you as the rookie pilot of an experimental variable mech to fight back the invading forces...\n\n- Single Player Campaign\n- 2 to 4 Player Death Match\n- Avatar and voice chat Support", "short_description": "REFLEX UNIT puts you in control of an advanced mechanized walking tank as you face wave after wave of challenging enemies.\n\n- Single Player Campaign\n- 2 to 4 Player Death Match\n- Avatar and voice chat Support"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.robosarugames.com/privacy", "developer_terms_of_service_url": "http://www.robosarugames.com/reflex-unit-vr", "publisher_name": "ROBOSARU Games", "support_website_url": null, "website_url": "http://www.robosarugames.com/reflex-unit-vr", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "SHOOTER", "ARCADE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "89281811138
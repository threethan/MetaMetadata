6345290_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvyUqjS6JxoQ7kNvwGGzAWa&_nc_oc=Ado0U-6WmfsDY9EyAML9xQo8NmFaJpD7ine4Iib7rKFBIzETrs524L9b-13mmgGkkxM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPDYhaI81TG9aMihPndc846LKndha2jvF0mBN2ICi2HA&oe=6B08455E"}, {"file_name": "Final1.png", "id": "934483367267393", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38984460_934483370600726_2342269543366152476_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3prQDYiwbd0Q7kNvwE4KGkx&_nc_oc=AdpQfSANrjmM7i50dwsxepNTMhN4qb63JR1lTCDM_Xip6Cqa5FFEnPbPl3kjTvztC-Y&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtQtRpxZ7De4_O_CKaJPLfgInbt0sQvjgpPFPC6boFTA&oe=6B087173"}, {"file_name": "Final5.png", "id": "1109469673205956", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031326_1109469676539289_4268533616333460252_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osNNq7SRbD4Q7kNvwFIoDrC&_nc_oc=Adq5rudhO8oEGkytYVGnYtadGLDc0NW7cPnjByzS0gGgp1_VDSqWJsa3evQTmoEsMbQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTL2sX23FWygeTzD8w8u6vAHjVFjrtlanzcpfNpbN4_w&oe=6B086FF7"}, {"file_name": "Final2.png", "id": "916532898880837", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003274_916532902214170_6367672695544734699_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8GcqNxITRDAQ7kNvwFcB3RP&_nc_oc=AdqG4ocD2jKPnKrctM7sXBC5Tcy32Lq1CHYV5dH0GR-m66-lxRuqZKN9pVsAvwbhe0o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj7K2w0qgxUf28iPVB0SoCKvyNzfOrVie-MKeoSbGbdg&oe=6B085FFA"}, {"file_name": "Final3.png", "id": "1165340330878993", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974677_1165340334212326_9147485654240656059_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L24GqqYjPUIQ7kNvwH_tPfl&_nc_oc=AdoPbGbDNMQVstvLMafK4o_yHycHoORrD-OfflSdFfcvXhAlyTGrIn6LGnoYpcU0HWw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMefGT3tSDFAGuV61tI8ygLw9Hq1Jw2PvCwQjUgncKxA&oe=6B087307"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Light Up The Dark", "keywords": [], "long_description": "*  Finger Controls.  \"Play\" the fireworks with your right-hand fingers using individual fingers and \"chords\" of fingers to fire different types of fire works.\n*  The Color Ball.  Your left hand is the color ball, moving side-to-side changes the color of the firework, and up/down adjusts the size of the fireworks blasts.\n*  Seamlessly switch between hands and controllers (with a hardware delay).\n*  Play reclined or laying down!  Or upside down.  Any position, any space.\n*  Environmental features such as snow, falling leaves, fireflies, and bubbles.  Seriously, try the bubbles.\n*  Listen to various audio tracks including a gentle Mozart piece, a Sousa March, and Wagner's Ride of the Valkyries, adjustable volumes for music and fireworks.\n*  Set the weather and the Speed of Time.  Note, the weather has a mind of its own.  \n*  Show and hide individual UI components or enter the VOID, with no user interface other than the finger streaks.\n\nShow and hide individual UI components or enter the ", "short_description": "Light Up The Dark is an exciting firework experience featuring a highly customizable atmosphere and snowman modes for casual or gaming fun.  Advanced controls using fingers and hands provide a unique experience.\n\nEnjoy a zen world with a light snow and the sounds of the forest at night, with fireworks.  \n\n\u200bOr bend time so a day lasts a few seconds, with a Sousa march fillings your ears while snowmen crash any sense of tranquility, with fireworks.\n\nYour fireworks.  Your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lightupthedarkgame.com/credits-legal", "developer_terms_of_service_url": null, "publisher_name": "Destroy Technology", 
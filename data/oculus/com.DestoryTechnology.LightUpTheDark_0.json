tent-ord5-1.oculuscdn.com/v/t64.5771-25/38974686_5363798033663065_4663252338829439864_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOZ0tVv8-1YQ7kNvwEE0m_Z&_nc_oc=AdpGvdDnK0tqaqoG3BzmO33jFqTF28R_D0lw-lrg9MexDcPudFcKUA06EFxqG2KgfxQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvPSZnYZIMQoQJOBWvulIscAhylc4VPCUAZGk5-gy56w&oe=6AF87AE7"}, {"file_name": "com.oculus.shellenv-20220623-002405.mp4.Still003.png", "id": "5319208218169963", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974530_5319208231503295_3232326796993336551_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8WMQu1KSvgQ7kNvwFgPCJz&_nc_oc=Adon4lyldI2Hd4dJisflz96jo4iaEpfMC2hS228_K-ag1lBWoy4CudE6loyuq8bdy3w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMvrXvaobTOq7nYPSULvGYFKzlxvXzO76phbfpLERAfQ&oe=6AF87CF0"}, {"file_name": "com.oculus.shellenv-20220623-002405.mp4.Still006.png", "id": "1430097507417067", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974454_1430097514083733_5445658030471255393_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGieRC9ZNMwQ7kNvwEUWQNR&_nc_oc=AdpqoBKmKqz5KZv1Rj1v5V7BM7Lqtf3EnO65qEehKFAQ6iHOW3atJall9gnnnizOPsY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ441GWrvY8NOpwYZlVLet2fbEce2e1s5pjCMSgcyMomg&oe=6AF885AB"}, {"file_name": "com.oculus.shellenv-20220624-042522.mp4.Still001.png", "id": "3113937215589309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974530_3113937218922642_5085609095707691860_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4yS8q5KRM8Q7kNvwHeOjYe&_nc_oc=AdraFJ1PBROWSS_dRMgR8M2xGu41iwNY6W8lBgUiOJYwVZiGb4QwoKkeM4I6_C7ZZEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUbeOXC_mLGDM4QREjjgkU1ts8fKJBqecQGD-Xo7uS2A&oe=6AF8878D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape2560x1440.png", "id": "508996884020276", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974844_508996887353609_5509969863082992813_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xygCF37HmWQQ7kNvwH8Fm7x&_nc_oc=AdpxCR3TeEwUGT1ytl6e_MWJ_uHYn5huCxvyBVcuWz3T6UZClY5AhmJDEfJJLKBPo-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrMBl1A81E9wqEpI-sJ8_eZP6Q5C8sDqk501p6uvhuug&oe=6AF87D09"}, "display_name": "Light Up The Dark", "keywords": [], "long_description": "*  Dual Controller or Dual Hand/Finger control operation.\n*  Seamlessly switch between hands and controllers (with a hardware delay).\n*  Play reclined or laying down!  Or upside down.  Any position, any space.\n*  Environmental features such as snow, falling leaves, fireflies, and bubbles.  Seriously, try the bubbles.\n*  Listen to various audio tracks including a gentle Mozart piece, a Sousa March, and Wagner's Ride of the Valkyries, adjustable volumes for music and fireworks.\n*  Set the weather and the Speed of Time.  Note, the weather has a mind of its own.  \n*  Show and hide individual UI components or enter the VOID, with all aim assistance turned off.", "short_description": "Light Up The Dark is an exciting firework experience featuring a highly customizable atmosphere and fun casual modes and a snowman shooting game.  Advanced controls using fingers and hands provide a unique experience.\n\nEnjoy a zen world with a light snow and the sounds of the forest at night, with fireworks.  \n\n\u200bOr bend time so a day lasts a few seconds, with a Sousa march fillings your ears while snowmen crash any sense of tranquility, with fireworks.\n\nYour fireworks.  Your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lightupthedarkgame.com/credits-legal", "developer_terms_of_service_url": null, "publisher_name": "Destroy Technology", "support_website_url": null, "website_url": "https://www.LightUpTheDarkGame.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "contex
_4663252338829439864_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvH3LqFwdfEQ7kNvwHbz9X-&_nc_oc=AdpIXCC-TAfSUcgP4EKMdglvtRlUz4axvKjpn9_RtpmmTGTqRWKRlAtNbULopDNasGY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3PiRGZncVYX9baeWT3U0hc4Ctr9ssS1gP3SuaYo8efVw&oe=69F1E827"}, {"file_name": "com.oculus.shellenv-20220623-002405.mp4.Still003.png", "id": "5319208218169963", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974530_5319208231503295_3232326796993336551_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=va_AQCfAqbIQ7kNvwHMh81Q&_nc_oc=AdqluxV8wW9Yjc5kDdKNS9aNJL6QlIs73lpMiVtLe-1x6euRJ1jnlOLEgGnc8Dl6_Wo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af11mprw_RC_NtgPgd1JsXyoL0IKlHZUbw5fN08RRvQNsg&oe=69F1EA30"}, {"file_name": "com.oculus.shellenv-20220623-002405.mp4.Still006.png", "id": "1430097507417067", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974454_1430097514083733_5445658030471255393_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykJVWAHTrZMQ7kNvwEnYpkJ&_nc_oc=AdqPU8NN0l9lF7rXP-FhgKx-GzuvrSY2gCEQ60Ft4aQ7CCYKX9mdZ89IGEaauggvuio&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0SHCYKz9eI2lBiLcqNdR9FlDMjF0JUbTDuhd2xQ2qRPw&oe=69F1F2EB"}, {"file_name": "com.oculus.shellenv-20220624-042522.mp4.Still001.png", "id": "3113937215589309", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974530_3113937218922642_5085609095707691860_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=546fMOyyIoIQ7kNvwFWRFpf&_nc_oc=AdpjCHM9xwPdkxZpK4RrVJqwcLurItvMxwcAIpWje_A3n_PliAwqpjhqJ8BU-xen8fQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vACqH45lIf1uQJIIKgdUkVKh9rfued34aRxbtUwDwuQ&oe=69F1F4CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandScape2560x1440.png", "id": "508996884020276", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974844_508996887353609_5509969863082992813_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8On0xcve1KEQ7kNvwFbWqmO&_nc_oc=Adov40IPPhKnRgU-8Lib95ksEcDOA6sz_3QJRcUqUVaUYW5x4csfmAtolEsCsOxw61w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3F_iaBRnKeeavjy6rv2Ym3k5ti8Mzy4uVuUXlcUQqeHg&oe=69F1EA49"}, "display_name": "Light Up The Dark", "keywords": [], "long_description": "*  Dual Controller or Dual Hand/Finger control operation.\n*  Seamlessly switch between hands and controllers (with a hardware delay).\n*  Play reclined or laying down!  Or upside down.  Any position, any space.\n*  Environmental features such as snow, falling leaves, fireflies, and bubbles.  Seriously, try the bubbles.\n*  Listen to various audio tracks including a gentle Mozart piece, a Sousa March, and Wagner's Ride of the Valkyries, adjustable volumes for music and fireworks.\n*  Set the weather and the Speed of Time.  Note, the weather has a mind of its own.  \n*  Show and hide individual UI components or enter the VOID, with all aim assistance turned off.", "short_description": "Light Up The Dark is an exciting firework experience featuring a highly customizable atmosphere and fun casual modes and a snowman shooting game.  Advanced controls using fingers and hands provide a unique experience.\n\nEnjoy a zen world with a light snow and the sounds of the forest at night, with fireworks.  \n\n\u200bOr bend time so a day lasts a few seconds, with a Sousa march fillings your ears while snowmen crash any sense of tranquility, with fireworks.\n\nYour fireworks.  Your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lightupthedarkgame.com/credits-legal", "developer_terms_of_service_url": null, "publisher_name": "Destroy Technology", "support_website_url": null, "website_url": "https://www.LightUpTheDarkGame.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_
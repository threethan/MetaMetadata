&_nc_ohc=Zvazb3FyA90Q7kNvwEFPTVf&_nc_oc=AdpYv-If8kBQfRd6EcidEMqMoBWLxdxVeaZ7wOIx6sOkRcuNqssOO6M1kgyAfsOGWrA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSt_pGogsUdD_j6zTPyYuFiFCWhAwFmGtpnB2026XQ4xQ&oe=6AF8A7B0"}, {"file_name": "Screen 1.png", "id": "28449813451289919", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313107_28449813454623252_4159136607430763858_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1Ld7iu2u0YQ7kNvwHnpYLT&_nc_oc=AdoS2inBHqhvWO5LT8_FvJkqLY-c1fqcakaqPUKaxIGCdXTGGoXwSF3cDOYsGyFDJpQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYBDrnS_Q0OzghiiAmGU7-NwhUdJsQQ0is0RO5SzKTPQ&oe=6AF8869A"}, {"file_name": "Screen 5.png", "id": "2164978954048659", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312236_2164978957381992_1593121475730399334_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ei464EDOzj8Q7kNvwF20NJp&_nc_oc=AdoliXzRRKswd41k-qhQNxhs2VbbhEbUPX77_nPDKZwUtMGho-LEClXQ1NHTZJHnnAo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJt0CSH2bUd-R6HxQspwSt5cJybHB0O99gO69ObPR0XQ&oe=6AF87620"}, {"file_name": "Screen 2.png", "id": "1415823213784144", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310734_1415823217117477_4023376887586688196_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAvW3rP-rU4Q7kNvwHwTk4U&_nc_oc=Adqb-bTavzMjHqFK5IGUE6iBUIBMEXZ89ysJoDSk-k2sZoHl6-Nk053ko49AWQpjjM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsa_VbRW843GFAAJSSjpz-KbJB69LrYjZrb9EHIgvkiA&oe=6AF89F92"}, {"file_name": "Screen 4.png", "id": "1537025697658888", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314660_1537025700992221_3019844676839764484_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mB3hAdvFkdcQ7kNvwGw-8yC&_nc_oc=AdpMMWCC1bY09grZD-4fuUzgYX-fvcN5yARDz_Do8d8aJwwQahAez215API8d2hwhj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_K0f62HUKbuGoXInsLz0a8hVLgMKLAseNKjN7KOG8DQ&oe=6AF8ADCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Final Tile.png", "id": "1373347874141692", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312422_1373347877475025_4094425929029961636_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M398RNKwi4YQ7kNvwFXBAmm&_nc_oc=Adq0LGfi5sx-0dtiTn9IB9aOe3CdXMOmzCSsRtbcxBQgvlxBSeoNX2y3DBGmf6gXWGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBgjR935HFOE58nJnDGdthBjazYRIUz1Eduu1WQb7z7Q&oe=6AF87659"}, "display_name": "Super Chameleon VR", "keywords": ["prophunt", "hideandseek", "multiplayer", "camouflage", "chameleon"], "long_description": "**SUPER CHAMELEON VR WITH GORILLA MOVEMENT**\n\nYou know the game: paint yourself, become the wall, don't get found. Here you build the pose with your own arms, and there's no thumbstick, you pull yourself through the world by hand.\n\n{1554749586151290}\n\n**HIDE LIKE NOTHING ELSE**\n\nFreeze anywhere: mid-air, upside down, wedged in a corner. Step out of your body, pose its arms by hand, then paint. The eyedropper samples any surface in the level, its exact colour, its metal, its roughness. No save button: what you see is already real, and the Hunter can already shoot it.\n\n{1633155878380195}\n\n**THE HUNT**\n\nOne Hunter each round: bigger, heavier, armed with a paint gun. A hit leaves a hole shaped like your silhouette in the splat on the wall, and you keep your paint job, you just wake up on the other team. Everyone found joins the Hunters, until the whole room is a pack chasing the last chameleon standing. Move too much and you give yourself away. Hold still and hope.\n\n{1297709055591858}\n\n**PLAY WITH ANYONE**\n\nPublic rooms in seconds, or a private room with a code for your friends. Spatial voice chat means you hear people where they actually are \u2014 including the one breathing right behind you.\n\n**ALSO INSIDE**\n\n- Free Roam Mode: a map to yourself, just you and the paint\n- In-game LIV camera to record your best hides\n- Multiple maps, with more added over time\n- OG-Founder Edition: all maps, private rooms, kick power, map voting and badges\n\nFree to play. Bring friends.", "short_description": "Paint yourself, become the wall, don't get found! \nExcept here you climb with your two real hands, freeze in any pose you can physically hold, and sample the exact color, metal and roughness of the surface you're pressed against. One Hunter starts each round; everyone found joins the hunt. \nPublic rooms in seconds, private rooms with friends, spatial voice chat and new maps over time. \nFree to play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSKTLb5bh6o0PVAVWziCTkVRoT92ZU69gciI_p1gRmFGJofKWE2ou9vwDFqD7p4Yw/pub", "developer_terms_of_service_url": null, "publisher_name": "STR Interactive", "support_website_url": null, "website_url": "https://sites.google.com/view/super-chameleon-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1270223889507239"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312338_1355152642912546_7442306397396822368_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iLlxLpPVtZQQ7kNvwGQDtgb&_nc_oc=Adolq0x06rI
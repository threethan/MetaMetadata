TMu8Vncr1ZAqo7sybprf3RLsMw&oe=6A8847DE"}, {"file_name": "Screenshot_10_upscale1440.png", "id": "1292486425868543", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/507819001_1292486429201876_7129948352723810954_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySeQDBMLFxsQ7kNvwE19MWn&_nc_oc=AdpdrL_9b5K7jkaJ-Lt1qtD57Rv7NuiRCp6699JnLZYmDydFFnmmFW9CNijb9hCx0fU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMp-HyjQLwIAfO49PphrCSAbRPPc0BWDbcH6Vd_ELlQA&oe=6A882318"}, {"file_name": "Screenshot_13_upscale1440.png", "id": "2518951901841335", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820441_2518951905174668_8449669113253004681_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=378k6j1upGIQ7kNvwE0ysFb&_nc_oc=Adq04Wu0IwDQmQGfaUtXafCIp_DnOzpZLy7dSRtKG9CDIRTTKIi0l-qqfeKaAFe92ZU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv35_TYeoA8w2jnuvgIX7_5VjJHHl9pQftnlbbK9rHJg&oe=6A882094"}, {"file_name": "Screenshot_27_upscale1440.png", "id": "964357273154141", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827987_964357279820807_2858993074287601625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW1GlAAvqIEQ7kNvwF6J7rG&_nc_oc=AdoYQFs27RDzc6wLMANOrO-aK4Hcd54QGjd1yKv2OLk43HFy5fUJBOgQ4gT7HZAfZQs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbswKRQNJXQdmZ3MIeQOsZJ1uVWvIF1zOHWE1vH5uhZA&oe=6A8846F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20260326-114851.png", "id": "1272174275040748", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818885_1272174278374081_220637946168232519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHLFLm9lh8AQ7kNvwFdsAIr&_nc_oc=Ado9fFNh9P9SWKcileYb-N7vn6_HCDO92fIre-BpZa06llCFy0Ro95En97snjr305IQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOhSPqrJyVzZDYbNvpVV-AQIrL24eFtUAxmEuEc1qIYA&oe=6A884D31"}, "display_name": "Bullet Hell IRL", "keywords": ["Shooter", "ShootEmUp", "BulletHell", "IRL", "Bullet"], "long_description": "# Mind Your Footwork, And Let\u2019s Tango!\n\nStep into a storm of bullets, right in the middle of your own living room. It\u2019s mixed reality with no boundaries.\n\nUse your legs as your joystick, and your bullets as your cover. Dodge, run, slip, and weave through incoming fire. Shoot high, low, left, and right to blast through walls of bullets and swarms of enemies.\n\nKeep firing, keep moving, and break out of the bullet hell in real life!\n\n\n{2238419236898530}\n\n# Move to Survive\n  \nStep, lean, and reposition in your real space to dodge incoming fire. Your body is the controller. Standing still won't help you dodge.\n\n{1258016596407345}\n\n# Shoot the Bullets\n  \nEnemy bullets aren't just hazards. They're targets. If you can't dodge a bullet, shoot it. Use your bullets as cover because shots can cancel each other out upon collision.\n\n{1789544525744407}\n\n# Solo Arena\n  \nFace relentless waves of bullet-spewing monsters and see how long you can last. Blast through walls of bullets with your Gatling gun, then slip through narrow gaps in the storm.\n\n{891582643973014}\n\n# Duel Match\n  \nDuel with other players in your own living room, online or locally. The ultimate test of movement skills, strategic foresight, and bulletproof confidence!\n\n{3113073182224560}\n\n# Early Access, Heroic Future\n\nLaunching in Early Access means you can jump in now and help shape the game with your feedback. We're building this together with our players, so suit up and join us on day one!", "short_description": "Mind your footwork, and let\u2019s tango!\n\nStep into a storm of bullets, right in the middle of your own living room. It\u2019s mixed reality with no boundaries.\n\nUse your legs as your joystick, and your bullets as your cover. Dodge, run, slip, and weave through incoming fire. Shoot high, low, left, and right to blast through walls of bullets and swarms of enemies.\n\nKeep firing, keep moving, and break out of the bullet hell in real life!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fantapassmr.com/privacy-policy", "developer_terms_of_service_url": "https://www.fantapassmr.com/terms-of-service", "publisher_name": "FantaPass MR Studio Inc.", "support_website_url": null, "website_url": "https://www.fantapassmr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "26944859178511604"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499313110_4329197170634005_7967700641733226273_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7vxhh2ibXgQ7kNvwEcOGU8&_nc_oc=AdqO2xYuVs-uvZL4v-VgZ4bqnL75T_XiwooNB_6RB8nuhczlB5PmjlEE4iPCjcTZNhk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOYwn27GHJZzRtC6kSS3ZLx1gLaPdhFjl8DfTKvg4ORA&oe=6A88475D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bullet Hell IRL", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1779814800, "lastRevision": {"nodes": [{"id": "25795163570147843"
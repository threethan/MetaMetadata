&_nc_sid=6e7a0a&_nc_ohc=MQBYLhMEYtcQ7kNvwH30j9c&_nc_oc=AdqR0Kl9P70LjGjG4zIagA_NO8qN4Jtw5opjPMWnFu3PMh1GvQfqkugSdwXOquiWY_c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQaa396KVVnPUNcpoUTMu8Vncr1ZAqo7sybprf3RLsMw&oe=6A8847DE"}, {"file_name": "Screenshot_10_upscale1440.png", "id": "1292486425868543", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/507819001_1292486429201876_7129948352723810954_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySeQDBMLFxsQ7kNvwE19MWn&_nc_oc=AdpdrL_9b5K7jkaJ-Lt1qtD57Rv7NuiRCp6699JnLZYmDydFFnmmFW9CNijb9hCx0fU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMp-HyjQLwIAfO49PphrCSAbRPPc0BWDbcH6Vd_ELlQA&oe=6A882318"}, {"file_name": "Screenshot_13_upscale1440.png", "id": "2518951901841335", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820441_2518951905174668_8449669113253004681_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=378k6j1upGIQ7kNvwE0ysFb&_nc_oc=Adq04Wu0IwDQmQGfaUtXafCIp_DnOzpZLy7dSRtKG9CDIRTTKIi0l-qqfeKaAFe92ZU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv35_TYeoA8w2jnuvgIX7_5VjJHHl9pQftnlbbK9rHJg&oe=6A882094"}, {"file_name": "Screenshot_27_upscale1440.png", "id": "964357273154141", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827987_964357279820807_2858993074287601625_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vW1GlAAvqIEQ7kNvwF6J7rG&_nc_oc=AdoYQFs27RDzc6wLMANOrO-aK4Hcd54QGjd1yKv2OLk43HFy5fUJBOgQ4gT7HZAfZQs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbswKRQNJXQdmZ3MIeQOsZJ1uVWvIF1zOHWE1vH5uhZA&oe=6A8846F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "20260326-114851.png", "id": "1272174275040748", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818885_1272174278374081_220637946168232519_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHLFLm9lh8AQ7kNvwFdsAIr&_nc_oc=Ado9fFNh9P9SWKcileYb-N7vn6_HCDO92fIre-BpZa06llCFy0Ro95En97snjr305IQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOhSPqrJyVzZDYbNvpVV-AQIrL24eFtUAxmEuEc1qIYA&oe=6A884D31"}, "display_name": "Bullet Hell IRL", "keywords": ["Shooter", "ShootEmUp", "BulletHell", "IRL", "Bullet"], "long_description": "**Bullet Hell IRL** brings bullet hell out of the screen and into your living room.\nYou don't dodge with a joystick. You dodge with your legs. Grab a Gatling gun, hold the trigger, and never stop spraying firepower. Enemies flood your space with bullets while you run, sidestep, dance, and weave through the chaos in mixed reality. \n\nFollow Master Sun Tzu's teaching: \"Attack him where he is unprepared, appear where you are not expected.\"\n\n- **Move to Survive**: Step, lean, and reposition in your real space to dodge incoming fire. Your body is the controller. Standing still won't help you dodge.\n\n- **Shoot the Bullets**: Enemy bullets aren't just hazards. They're targets. If you can't dodge a bullet, shoot it. Use your bullets as cover because shots can cancel each other out upon collision.\n\n- **Solo Arena**: Face relentless waves of bullet-spewing monsters and see how long you can last. Blast through walls of bullets with your Gatling gun, then slip through narrow gaps in the storm.\n\n- **Duel Match**: Duel with other players in your own living room, online or locally. The ultimate test of movement skills, strategic foresight, and bulletproof confidence!\n\n**Early Access, Heroic Future**: Launching in Early Access means you can jump in now and help shape the game with your feedback. We're building this together with our players, so suit up and join us on day one!", "short_description": "Use your legs as your joystick. Use your bullets as your cover. Keep firing, keep moving, and break out of the bullet hell in your own living room!\n\nBullet Hell IRL brings mixed reality mayhem to heroes with bulletproof confidence. Now it\u2019s your turn to step in: defeat waves of bullet-spewing monsters, carve paths through impossible walls of bullets, and challenge other players online or locally.\n\nMind your footwork, and let\u2019s tango!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fantapassmr.com/privacy-policy", "developer_terms_of_service_url": "https://www.fantapassmr.com/terms-of-service", "publisher_name": "FantaPass MR Studio Inc.", "support_website_url": null, "website_url": "https://www.fantapassmr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "26017534437910754"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1978263593094518"}]}, "baseline_offer": {"id": "1978263593094518"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779814800, "status": "PUBLISHED", "id": "1978263593094518"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27667121792952002", "version": "1.0.0"}, "id": "2037476506820614", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25795163460147854", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27667121792952002"}, "release_status
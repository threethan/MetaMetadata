k9tv9bi-n8Ip5gA30_BLgj-FEGpdNqFSiAt5dY8p6IQ&oe=6A9ED4DE"}, {"file_name": "Screenshots_3.png", "id": "1538496510295659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391913_1538496513628992_8949494390817220665_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tR9OWFEjIKMQ7kNvwEx1zVV&_nc_oc=AdoTDMsZF3EycHW_Idq708IDJRzXH306G_F_E12cx9oQ3NHLTWzg4uEn_LR_oMgu3CY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIe8VARha2bincgAhbpZdCxX80zIkvVQl19p9kiokOcMw&oe=6A9ECF79"}, {"file_name": "Screenshots_4.png", "id": "647028714325580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391973_647028717658913_7258193827218214647_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAeLNQIrcVsQ7kNvwH-j82i&_nc_oc=Adq_zy7UDrWSl_IRmPbFfQFaQE2iXTUyGvREERKnTN9cxtlrOek7r_vkC6XK9xWLUQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK43M9YfUrPcfUmKHURqIAnDuk61yAjG3g7AXM2JY31uA&oe=6A9ED84E"}, {"file_name": "Screenshots_5.png", "id": "501936999582419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391976_501937002915752_1584155807895365051_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1pj466d9-IQ7kNvwGFelpF&_nc_oc=AdpeFhecEhZcZiyK0RP72hogrgbHIbgTmo9C2-Fn0tz1zTQJAVIan9QC955c3cV7PfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITEwENQIi3sAl0tc1IMpTR2vHkE1QyfJUrlzXpEl1MEg&oe=6A9ED781"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "600899669224315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391984_600899672557648_2159761621123019211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYoUrq7RzcoQ7kNvwF5IVON&_nc_oc=Adr4wl8FDfCILFRkNmlvEVcKuHIhG6qVZrjWoeDefOzJ_5EcMZrxHoTyRcza-3aVxWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0OhtTlg2RzRMj6sGWjcGAj1-v4b-riTFYhIwaCx5jJg&oe=6A9EBDEF"}, "display_name": "Frog Leap VR", "keywords": ["simulator", "frog", "jump", "onlyup", "Climber"], "long_description": "Embark on a thrilling virtual reality journey in Frog Leap VR a captivating simulation game that puts you in the webbed feet of a courageous frog. Your objective is clear: escape the confines of a massive well and soar towards the celestial sky gate that beckons in the distance.\n\nYou'll find yourself in a visually stunning world, surrounded by the towering walls of the well that loom above you. With each leap, you feel the rush of the air and the anticipation of what lies beyond. The controls are intuitive, allowing you to jump with precision and finesse as you navigate the challenges that stand between you and freedom.\n\nIn Frog Leap VR, strategic thinking and quick reflexes are key. You'll encounter various obstacles and puzzles that will test your agility and problem-solving skills. From lily pads that serve as stepping stones to moving platforms that require perfect timing, every jump brings you closer to your ultimate goal.\n\nThe immersive nature of VR enhances the experience, making you feel like you're truly a frog on a daring quest for liberation. The sense of accomplishment when you successfully navigate a difficult section and propel yourself higher is unmatched.\n\nSo, are you ready to take the leap? Experience the thrill of the jump, the rush of the ascent, and the satisfaction of reaching new heights in Frog Leap VR. Let the adventure begin, and may your determination guide you to the sky gate and beyond.", "short_description": "Frog Leap VR is an immersive virtual reality game where players embody a determined frog on a mission to leap out of a colossal well and ascend to the sky gate. Test your jumping skills and navigate obstacles to reach new heights in this exhilarating adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "cate
KC0BXR6-94lQmGKSvQiKqDTwChBWBCsdl-_UshF4Eg&oe=6A70781E"}, {"file_name": "Screenshots_3.png", "id": "1538496510295659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391913_1538496513628992_8949494390817220665_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8H1BIFiLnUEQ7kNvwFC3FzT&_nc_oc=AdogonmtSUp5BhBB0vvTve2C9YrPYC0evT3MmpKhfae48HRaynhWx43GeROC01LTBxY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRBci1GGt5aygH6M-T2upeCuosW81ijw1UhdMyxjRUHw&oe=6A7072B9"}, {"file_name": "Screenshots_4.png", "id": "647028714325580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391973_647028717658913_7258193827218214647_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfG6xitb3hkQ7kNvwFKBoro&_nc_oc=AdpgNiv-_TmkVrBcaFi0XLe8Ps88whHvd83DzCzrTT0jO-83e3q6J5w2H7tovi5-sAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkx0_YveA-gLBk47KtxAAKlUmyIwXy5yg27C1J98jozA&oe=6A707B8E"}, {"file_name": "Screenshots_5.png", "id": "501936999582419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391976_501937002915752_1584155807895365051_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7FsuuukrpIQ7kNvwHQTpej&_nc_oc=AdqhPrPyQg6MUsd7HA-5BOzgNUXq6WTQdtFcftKlZV5-rvZl3x4IEMo9LilGLdPbb_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh0Jaw0NUGMQUWHDNDd5Mk1TKh1cqjqUPh_OiAGbbDAw&oe=6A707AC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "600899669224315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391984_600899672557648_2159761621123019211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At2r83HzZFcQ7kNvwEL1VPG&_nc_oc=AdoB9SaGFvnRSDbiCcAjC8i777II-dLXVURKncGk5nnx0lQ3mw0R8IqBuHOxfaI8FVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF01CqkHYVuSPQ5u-ne7Rfx-cFwJEQSQrBKTjlu8HSHUA&oe=6A70996F"}, "display_name": "Frog Leap VR", "keywords": ["simulator", "frog", "jump", "onlyup", "Climber"], "long_description": "Embark on a thrilling virtual reality journey in Frog Leap VR a captivating simulation game that puts you in the webbed feet of a courageous frog. Your objective is clear: escape the confines of a massive well and soar towards the celestial sky gate that beckons in the distance.\n\nYou'll find yourself in a visually stunning world, surrounded by the towering walls of the well that loom above you. With each leap, you feel the rush of the air and the anticipation of what lies beyond. The controls are intuitive, allowing you to jump with precision and finesse as you navigate the challenges that stand between you and freedom.\n\nIn Frog Leap VR, strategic thinking and quick reflexes are key. You'll encounter various obstacles and puzzles that will test your agility and problem-solving skills. From lily pads that serve as stepping stones to moving platforms that require perfect timing, every jump brings you closer to your ultimate goal.\n\nThe immersive nature of VR enhances the experience, making you feel like you're truly a frog on a daring quest for liberation. The sense of accomplishment when you successfully navigate a difficult section and propel yourself higher is unmatched.\n\nSo, are you ready to take the leap? Experience the thrill of the jump, the rush of the ascent, and the satisfaction of reaching new heights in Frog Leap VR. Let the adventure begin, and may your determination guide you to the sky gate and beyond.", "short_description": "Frog Leap VR is an immersive virtual reality game where players embody a determined frog on a mission to leap out of a colossal well and ascend to the sky gate. Test your jumping skills and navigate obstacles to reach new heights in this exhilarating adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28619034777681832"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "1763393814794104"}, {"status": "PUBLISHED", "id": "1327358546020506"}, {"status": "PUBLISHED", "id": "1712494403086020"}, {"status": "PUBLISHED", "id": "1443444333890407"}, {"status": "PUBLISHED", "id": "849782617868066"}, {"status": "PUBLISHED", "id": "3499183983570629"}, {"status": "PUBLISHED", "id": "769482758807142"}, {"status": "PUBLISHED", "id": "992986246044215"}]}, "baseline_offer": {"id": "992986246044215"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "1763393814794104"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28746148421637133", "version": "0.3"}, "id": "1141083790927528", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28598528736399103", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28746148421637133"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1141083790927528"}]
MDWlRU1C55hloPfN6cX-3_CZMczQkqHaXD20609nxdMFa-DCF3pbV-o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJpPTT1fQkWFPQ5IZ_OAu1Unf1E5FlgkpMW3upZdN-nQ&oe=6AC3BEDE"}, {"file_name": "Screenshots_3.png", "id": "1538496510295659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391913_1538496513628992_8949494390817220665_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-I9gE_iQ_0Q7kNvwE7ijzu&_nc_oc=AdrWpeBAF7U6AW3vosakpGmR0qOz8sU1EuEjQfID155JUeoOW4ilwYXPsSQDBlhYJp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxbjph-5dYAu9TJGljCrK2jLinRv5lBsMGf82pCT4PeQ&oe=6AC3B979"}, {"file_name": "Screenshots_4.png", "id": "647028714325580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391973_647028717658913_7258193827218214647_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQ5sdDl7gsMQ7kNvwF0lcV8&_nc_oc=AdobvgqrNxLlvENTuCgUMb8ZixxTc-zqoOEfIeWVh7CD2P36hFP6cwZrbxtX7srDoBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9cJRi9gRYO0O4C4Zot3HKyxFNkYjONMNvdQAKWWdLsA&oe=6AC3C24E"}, {"file_name": "Screenshots_5.png", "id": "501936999582419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391976_501937002915752_1584155807895365051_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_eEbOFb4aAQ7kNvwFg4QVc&_nc_oc=AdpaUcr3v-bHCozcMfVv7MazR8fSJpITIxhzm7NjAvgIRMJGbQkBxLevDRnma5zh7-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJX5Lm5_qImCJFIE6jRjveJEmLUrPO90uqmC44FJQOcA&oe=6AC3C181"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "600899669224315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391984_600899672557648_2159761621123019211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI01wn8NVWAQ7kNvwGbv1nD&_nc_oc=Ado2_M5BEnXiXBldZACfa-rTWSDfcjjKorC544Z68ba7viNHkekp2j2aI88SpzTSQuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND48412cGcsNaAw0nmcPIfuohX1LiciGAPet4j8TPChQ&oe=6AC3A7EF"}, "display_name": "Frog Leap VR", "keywords": ["simulator", "frog", "jump", "onlyup", "Climber"], "long_description": "Embark on a thrilling virtual reality journey in Frog Leap VR a captivating simulation game that puts you in the webbed feet of a courageous frog. Your objective is clear: escape the confines of a massive well and soar towards the celestial sky gate that beckons in the distance.\n\nYou'll find yourself in a visually stunning world, surrounded by the towering walls of the well that loom above you. With each leap, you feel the rush of the air and the anticipation of what lies beyond. The controls are intuitive, allowing you to jump with precision and finesse as you navigate the challenges that stand between you and freedom.\n\nIn Frog Leap VR, strategic thinking and quick reflexes are key. You'll encounter various obstacles and puzzles that will test your agility and problem-solving skills. From lily pads that serve as stepping stones to moving platforms that require perfect timing, every jump brings you closer to your ultimate goal.\n\nThe immersive nature of VR enhances the experience, making you feel like you're truly a frog on a daring quest for liberation. The sense of accomplishment when you successfully navigate a difficult section and propel yourself higher is unmatched.\n\nSo, are you ready to take the leap? Experience the thrill of the jump, the rush of the ascent, and the satisfaction of reaching new heights in Frog Leap VR. Let the adventure begin, and may your determination guide you to the sky gate and beyond.", "short_description": "Frog Leap VR is an immersive virtual reality game where players embody a determined frog on a mission to leap out of a colossal well and ascend to the sky gate. Test your jumping skills and navigate obstacles to reach new heights in this exhilarating adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_servic
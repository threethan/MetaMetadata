0_AQGM3oxAkKuAS2cMStzHsQ7OyUvlPwfJuxVl8FhLzKOxrQ&oe=6A7DA71E"}, {"file_name": "Screenshots_3.png", "id": "1538496510295659", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391913_1538496513628992_8949494390817220665_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ith5kddKr60Q7kNvwE_J42w&_nc_oc=AdosNV1-XbcFjYD64mbrutmx5kHXFiSKhlmgCrfxbBzBt0EcFa_ebbsJ1pcmarvjA8A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV4kPFLtWvzNiMmkmGnFFgeAuT70otAQyW1up0vVm3yg&oe=6A7DA1B9"}, {"file_name": "Screenshots_4.png", "id": "647028714325580", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391973_647028717658913_7258193827218214647_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXYgUTnSMY4Q7kNvwFfpaQF&_nc_oc=AdrBePUiKoQ36Je9P8AlyPatEfsVWA0jWoD6A1pTTRI5oNGrQcEf6FTdBE5RtCNbbwc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOFVjQwfCSepRB1cx0TzVYcB2eWvfPIIP8nmHTOooIzQ&oe=6A7DAA8E"}, {"file_name": "Screenshots_5.png", "id": "501936999582419", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/473391976_501937002915752_1584155807895365051_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5O2JNrqmFcQ7kNvwEfiiRI&_nc_oc=Adog3OsC9i75UMNwV7FjHz2yxcWfWPrjGFQXo14XGdB582vghd_3ZNoctFIJuaH0DjI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOwdk_UGjmnsDDDtBVR2kqwvd4Cn77cUH8_YbGjPe2Rw&oe=6A7DA9C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "600899669224315", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/473391984_600899672557648_2159761621123019211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1j0nXeQYsIQ7kNvwHkAnya&_nc_oc=AdpHih-f3ziydsk-1iD9sQgZebt9foBtdrSsdyKk4SRVdWNNfrRZX8B_fsza_ry6o-s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMIiQ_yVuKJYcG6L0VPqPcOZYq19Kz6dYLJKSlPicanw&oe=6A7DC86F"}, "display_name": "Frog Leap VR", "keywords": ["simulator", "frog", "jump", "onlyup", "Climber"], "long_description": "Embark on a thrilling virtual reality journey in Frog Leap VR a captivating simulation game that puts you in the webbed feet of a courageous frog. Your objective is clear: escape the confines of a massive well and soar towards the celestial sky gate that beckons in the distance.\n\nYou'll find yourself in a visually stunning world, surrounded by the towering walls of the well that loom above you. With each leap, you feel the rush of the air and the anticipation of what lies beyond. The controls are intuitive, allowing you to jump with precision and finesse as you navigate the challenges that stand between you and freedom.\n\nIn Frog Leap VR, strategic thinking and quick reflexes are key. You'll encounter various obstacles and puzzles that will test your agility and problem-solving skills. From lily pads that serve as stepping stones to moving platforms that require perfect timing, every jump brings you closer to your ultimate goal.\n\nThe immersive nature of VR enhances the experience, making you feel like you're truly a frog on a daring quest for liberation. The sense of accomplishment when you successfully navigate a difficult section and propel yourself higher is unmatched.\n\nSo, are you ready to take the leap? Experience the thrill of the jump, the rush of the ascent, and the satisfaction of reaching new heights in Frog Leap VR. Let the adventure begin, and may your determination guide you to the sky gate and beyond.", "short_description": "Frog Leap VR is an immersive virtual reality game where players embody a determined frog on a mission to leap out of a colossal well and ascend to the sky gate. Test your jumping skills and navigate obstacles to reach new heights in this exhilarating adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_service_url": null, "publisher_name": "VRTech Studio", "support_website_url": null, "website_url": "https://vrtech.com.vn
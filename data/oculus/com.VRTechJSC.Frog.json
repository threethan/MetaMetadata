7VUra0PjWfff3n7q9RoctEo_eyqXmSJNyPvinukNYxNkaqS1HQ0okEU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPuYS7kOI8PE2TlQBDmUkn58C8Ku_Yg_YH4O3jy7AHpg&oe=6ABA845E"}, {"file_name": "Screenshots_3.png", "id": "1538496510295659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391913_1538496513628992_8949494390817220665_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NfxTrzvS0y8Q7kNvwH5BHLW&_nc_oc=AdqDYICOjQ6ilZKO5AbgaXRUoDGJY0dKgZVPHaZ_cg9az6V5VIXE208fTHh1BNvUTpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHH7xBEUg2QeNxLUzDPDgMHgcphJsAnpqwM2cRDHKtGA&oe=6ABA7EF9"}, {"file_name": "Screenshots_4.png", "id": "647028714325580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391973_647028717658913_7258193827218214647_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHjKzE838-AQ7kNvwF9fC47&_nc_oc=AdrVk8hR6Gk3M3LIBGQ5vbUq4C-GTkRD09mt0gqW4W7OElIsjNaWdX2UOHyPsKt0plY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJULhY1MRjCo-8XeZUFVwglPMMc5LKw9SbfFj6u5nkbGw&oe=6ABA87CE"}, {"file_name": "Screenshots_5.png", "id": "501936999582419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391976_501937002915752_1584155807895365051_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJYocWtfaKwQ7kNvwHrSsuQ&_nc_oc=AdrDvu8LD-7IwQej7UPPGnVA9Qj9lZdyRHa24m1rtnKKl_WD87TVSH3jR0U0RqbFs-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAV1DQR8lEQCSdipPdFgsmpOTX6z1XrHtT9ljQKeViEQ&oe=6ABA8701"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "600899669224315", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391984_600899672557648_2159761621123019211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoN-qj-0fDEQ7kNvwG7Yia4&_nc_oc=AdpRiWXcIORTUJwdduBpC7t5riLUZJ6G4uXJkJaxI7OUXN-TonLlDpNnJBl03pwC3BI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkPZ6bid3eUsfOI_NGuAd_EP-UwaDSHWJtywhdM4dZYA&oe=6ABA6D6F"}, "display_name": "Frog Leap VR", "keywords": ["simulator", "frog", "jump", "onlyup", "Climber"], "long_description": "Embark on a thrilling virtual reality journey in Frog Leap VR a captivating simulation game that puts you in the webbed feet of a courageous frog. Your objective is clear: escape the confines of a massive well and soar towards the celestial sky gate that beckons in the distance.\n\nYou'll find yourself in a visually stunning world, surrounded by the towering walls of the well that loom above you. With each leap, you feel the rush of the air and the anticipation of what lies beyond. The controls are intuitive, allowing you to jump with precision and finesse as you navigate the challenges that stand between you and freedom.\n\nIn Frog Leap VR, strategic thinking and quick reflexes are key. You'll encounter various obstacles and puzzles that will test your agility and problem-solving skills. From lily pads that serve as stepping stones to moving platforms that require perfect timing, every jump brings you closer to your ultimate goal.\n\nThe immersive nature of VR enhances the experience, making you feel like you're truly a frog on a daring quest for liberation. The sense of accomplishment when you successfully navigate a difficult section and propel yourself higher is unmatched.\n\nSo, are you ready to take the leap? Experience the thrill of the jump, the rush of the ascent, and the satisfaction of reaching new heights in Frog Leap VR. Let the adventure begin, and may your determination guide you to the sky gate and beyond.", "short_description": "Frog Leap VR is an immersive virtual reality game where players embody a determined frog on a mission to leap out of a colossal well and ascend to the sky gate. Test your jumping skills and navigate obstacles to reach new heights in this exhilarating adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_servic
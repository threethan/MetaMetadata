kPWPcwPIyp2-1TeamJRcBoc_E_hvn_UPWFhgRvU7HdciS-59RskGE5E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ3KsreTWoBR4SrPX7UO5EcN5S50L1dFbhgtGy5qLwkQ&oe=6AA80F5E"}, {"file_name": "Screenshots_3.png", "id": "1538496510295659", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391913_1538496513628992_8949494390817220665_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hletiy1e3IAQ7kNvwHb0efU&_nc_oc=Adp2Fe00difraQY-Qd4ORVtVWKFsrBaOFWA_XWmFhLs2A-zXsl8c79mnzygveE2cqZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj4UeQsWvqelHZaeV26rs3suij2uvp6_mZywxTBaRLUg&oe=6AA809F9"}, {"file_name": "Screenshots_4.png", "id": "647028714325580", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391973_647028717658913_7258193827218214647_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnqIcXF3Wa4Q7kNvwGvLKU5&_nc_oc=Ado1V-lDzFw09P6ELReEExDo6R06XFG6fvhhZb_zrAJvHR144LijwQHCtE4J13mT2dc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBoq08iyJ7aEg0KTYPEXG5rlMC2bLbwebWLcUTuzdofw&oe=6AA812CE"}, {"file_name": "Screenshots_5.png", "id": "501936999582419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391976_501937002915752_1584155807895365051_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osAEQ94IH0sQ7kNvwH8ndEF&_nc_oc=AdoC4ZQkEnTNrHwvLh9iYPNHXsj5c1M3M8Bmv55FPaJhvFDavK1m15_az8IDIFN5W0c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeyMR1vUNo1fhS7qatlTWR9rFUL3wOwEML-EDstFvkVw&oe=6AA81201"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "600899669224315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391984_600899672557648_2159761621123019211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vt2kDkgnfz8Q7kNvwHw6HfP&_nc_oc=AdrBV5O2vXnF0vmnNA1u_n7g24cIiPtmIM_CdadBLdK5ijvZDldYuE-bKd-QAo5Sqrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlBUHJT4_AcmxyXriX0zRuH5ruMIlnGrqNkHGvRGTwxQ&oe=6AA7F86F"}, "display_name": "Frog Leap VR", "keywords": ["simulator", "frog", "jump", "onlyup", "Climber"], "long_description": "Embark on a thrilling virtual reality journey in Frog Leap VR a captivating simulation game that puts you in the webbed feet of a courageous frog. Your objective is clear: escape the confines of a massive well and soar towards the celestial sky gate that beckons in the distance.\n\nYou'll find yourself in a visually stunning world, surrounded by the towering walls of the well that loom above you. With each leap, you feel the rush of the air and the anticipation of what lies beyond. The controls are intuitive, allowing you to jump with precision and finesse as you navigate the challenges that stand between you and freedom.\n\nIn Frog Leap VR, strategic thinking and quick reflexes are key. You'll encounter various obstacles and puzzles that will test your agility and problem-solving skills. From lily pads that serve as stepping stones to moving platforms that require perfect timing, every jump brings you closer to your ultimate goal.\n\nThe immersive nature of VR enhances the experience, making you feel like you're truly a frog on a daring quest for liberation. The sense of accomplishment when you successfully navigate a difficult section and propel yourself higher is unmatched.\n\nSo, are you ready to take the leap? Experience the thrill of the jump, the rush of the ascent, and the satisfaction of reaching new heights in Frog Leap VR. Let the adventure begin, and may your determination guide you to the sky gate and beyond.", "short_description": "Frog Leap VR is an immersive virtual reality game where players embody a determined frog on a mission to leap out of a colossal well and ascend to the sky gate. Test your jumping skills and navigate obstacles to reach new heights in this exhilarating adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_servic
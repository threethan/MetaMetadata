crPK8RF1pTFIkiiHso3lbncJx2g5hOOiqH0Hka7ouRjynLvNrsGts3E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0EUMb2ikPnGTtt8R-6Oq4_5TiSw7iXLDTv_yGfKIZzA&oe=6AA56C5E"}, {"file_name": "Screenshots_3.png", "id": "1538496510295659", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391913_1538496513628992_8949494390817220665_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hletiy1e3IAQ7kNvwEde2RA&_nc_oc=Adp-n1dJa4-dpH2I1cwMiVxASn-xBsOaSyXYajI7cg3iHUGuoZQoVTRlvwWoPcVCJqk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfKID5lrz1pRe1sDXqL220IgkN7uYfePDVQXjJjDWeAA&oe=6AA566F9"}, {"file_name": "Screenshots_4.png", "id": "647028714325580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391973_647028717658913_7258193827218214647_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnqIcXF3Wa4Q7kNvwG46yZf&_nc_oc=AdpzrfVMso886-0Nv8uIvZ1AkyZNC1b3YIN-h_ixecd3ru-_5ZJZcDPwjLrnyzuS9FQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcAVh79wG7Y7Y9VjyDzUi4vup_wqoRMJY5grO5PrhMcw&oe=6AA56FCE"}, {"file_name": "Screenshots_5.png", "id": "501936999582419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391976_501937002915752_1584155807895365051_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-Jua1pO1F4Q7kNvwHRTvsn&_nc_oc=AdruANam0AXV853Rbmi1vNsXgDpIKXyxoU78H8YxKLitUtcojjhOcWrpW77zqJpt4W4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-aCyluBkO-ZVdrHATNAiZ7hHnSKz5flXW_eCccoooEw&oe=6AA56F01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image - Video.png", "id": "600899669224315", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391984_600899672557648_2159761621123019211_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDa7AE3dBcQQ7kNvwEua4us&_nc_oc=AdrSP6IxkyIfbGO2UfWztVP4TlyahfDHlXJJtb58il2tbGFGQQSg6pfQ7h2PNw4zyHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFKAMOANUQuuDdd_eIq2yeD3xQeEnLBgZaJ2D41OuNcA&oe=6AA5556F"}, "display_name": "Frog Leap VR", "keywords": ["simulator", "frog", "jump", "onlyup", "Climber"], "long_description": "Embark on a thrilling virtual reality journey in Frog Leap VR a captivating simulation game that puts you in the webbed feet of a courageous frog. Your objective is clear: escape the confines of a massive well and soar towards the celestial sky gate that beckons in the distance.\n\nYou'll find yourself in a visually stunning world, surrounded by the towering walls of the well that loom above you. With each leap, you feel the rush of the air and the anticipation of what lies beyond. The controls are intuitive, allowing you to jump with precision and finesse as you navigate the challenges that stand between you and freedom.\n\nIn Frog Leap VR, strategic thinking and quick reflexes are key. You'll encounter various obstacles and puzzles that will test your agility and problem-solving skills. From lily pads that serve as stepping stones to moving platforms that require perfect timing, every jump brings you closer to your ultimate goal.\n\nThe immersive nature of VR enhances the experience, making you feel like you're truly a frog on a daring quest for liberation. The sense of accomplishment when you successfully navigate a difficult section and propel yourself higher is unmatched.\n\nSo, are you ready to take the leap? Experience the thrill of the jump, the rush of the ascent, and the satisfaction of reaching new heights in Frog Leap VR. Let the adventure begin, and may your determination guide you to the sky gate and beyond.", "short_description": "Frog Leap VR is an immersive virtual reality game where players embody a determined frog on a mission to leap out of a colossal well and ascend to the sky gate. Test your jumping skills and navigate obstacles to reach new heights in this exhilarating adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrtech.com.vn/PrimacyGameVR/PRIVACY_POLICY.htm", "developer_terms_of_servic
xYB39k15mLL5PQ&oe=6B0EF487"}, {"file_name": "04_SCREENSHOT_SPACE_2560x1440.png", "id": "1294546663752383", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_1294546667085716_697519038903254198_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCvW54mw964Q7kNvwF5FRWl&_nc_oc=AdpSzM3UNYtt64fW4mi2ZHBKAzbtrdjxVJy_tT95XsJFba42g1vnld6CT0EDp9axVVo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUIjRPdLf8hFWlmdRZ5KFSiMW3HUv0Z6IJmC3BI38UZMw&oe=6B0F044C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HOPROUTE_VR_Trailer_V2_Thumbnail.png", "id": "1689617622678785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824318_1689617629345451_2184212789271158524_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Rl4YgXJac0Q7kNvwG155zR&_nc_oc=AdoDMsaTXnLKXA2rjzmqYYFL_ZeNvkUdbXsKg9Wqj0r2jxoe-mzMx-oqzbaTmcnwmmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXryYtBM-PKbWQ4SeMC8ii898kyCe_r11aqKL9vbhGVow&oe=6B0F247F"}, "display_name": "HOPROUTE VR", "keywords": ["Arcade", "Endlessrunner", "Obstacledodging", "Traffic", "VR"], "long_description": "# HOPROUTE VR \u2013 One more step. One more try.\n\nDodge traffic, speeding trains and wildlife in a retro-inspired VR arcade adventure. Play up close in **first-person VR** or switch to **top-down view** to plan your next move.\n\n- **31 campaign levels across 6 worlds** \u2013 Cross city streets, railways, icy landscapes, the savanna, space and airport traffic, leading to a surprising finale.\n- **Endless Mode** \u2013 Beat your best distance and unlock achievement badges.\n- **Unlockable gloves and abilities** \u2013 Collect orbs, unlock gloves and slow down time to escape tricky situations.\n- **Simple, precise movement** \u2013 Tap the joystick to hop one square or hold it to keep moving.\n\nEasy to learn, challenging to master. **How far can you hop?**", "short_description": "Dodge traffic, trains an
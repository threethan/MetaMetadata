Vks&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVmiKDh73-cjMU8HRw7Bv5qZG7EgJePo-CiXYj7QiQ7nA&oe=6B10541C"}, {"file_name": "01_SCREENSHOT_CITY_2560x1440.png", "id": "1146442161231133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1146442171231132_781767899144606991_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0u4M-WQLqYQ7kNvwGQgi-g&_nc_oc=AdoCsTkwGjF3_5KneO1dbKWKTLhNWxJc45iJbYXY3x91oiGBecmPrVkOHrYJsP2OGOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV-2slD9uu0SUTkf7E0MrJotqdl_TxHS-v8uhdsFhE6DQ&oe=6B104607"}, {"file_name": "04_SCREENSHOT_SPACE_2560x1440.png", "id": "1294546663752383", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825305_1294546667085716_697519038903254198_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCvW54mw964Q7kNvwHvphkH&_nc_oc=AdoYWPe4aMvYPFqMTZz9f3PwMWZI66HbJd_BLicY_eYlOr5SCEpCC4_pRMH-HMK3x9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVadrc6DbvHiJD3xPsCwfulVpY097IbbOXJdxZwLr7XQw&oe=6B1055CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "HOPROUTE_VR_Trailer_Thumbnail.png", "id": "1140719625018100", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_1140719635018099_9155507728793360205_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmZV9YhGwIEQ7kNvwE_ho2H&_nc_oc=Adqz7whKPiXdFklBvmmjKyF3kv9PEKPZ8_oEUVC6Ppz3NIu2fZnRVPXaMmMJ6j9J3Jg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW1VBslvIHShkCoM4-SxPlOP0sjKQ6z3zkLcFDusTYIKA&oe=6B105D28"}, "display_name": "HOPROUTE VR", "keywords": ["Arcade", "Endlessrunner", "Obstacledodging", "Traffic", "VR"], "long_description": "**HOPROUTE VR \u2013 One step can change everything!**\n\nJump into a colorful arcade adventure where every move counts!\n\nNavigate busy city streets, dodge speeding trains, escape wild animals, avoid flying hazards in space, and survive chaotic airport traffic. Six distinct worlds, each with its own challenges, obstacles, and personality.\n\n**What awaits you:**\n\n- **31 campaign levels** \u2013 Travel through six unique worlds and reach a surprising grand finale.\n- **Endless Mode** \u2013 Keep moving, beat your best distance, and unlock achievement badges.\n- **Precision grid movement** \u2013 Tap the joystick to move one square, or hold it to keep hopping.\n- **Unlockable gloves** \u2013 Collect orbs to gain special abilities that help you survive.\n- **Colorful low-poly environments** \u2013 Enjoy a playful arcade experience built for Meta Quest.\n- **Easy to learn, challenging to master** \u2013 Time your moves, dodge danger, and find your way forward.\n\n**How far can you hop?**\n\nYour next adventure is just one step away!", "short_description": "Hop through six crazy worlds, dodge traffic and obstacles, unlock powerful gloves, and see how far you can go in this colorful VR arcade adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://seventhhead.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "J\u00f3zsef Vasas", "support_website_url": "https://seventhhead.com/support/", "website_url": "https://seventhhead.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1401336939729534"}}]}, "scheduled_offers": {"co
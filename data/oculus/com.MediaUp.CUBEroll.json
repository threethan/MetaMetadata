885502515508", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982553_813885509182174_3620060962003592240_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfTpBd3as5EQ7kNvwHdjRh0&_nc_oc=Adp9lHMhgfd_x6IOjNVJjl6ash31qzBcy2U-KxoWkeGEcSK4uuX1cEpnnDdQ3XpkP6o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRb4_0iuII0tF9wjW_G99vc-bFzmpoyYN4t2at6VMZXqw&oe=6AFB480D"}, {"file_name": "CUBEroll_Screenshot 22.png", "id": "380355533216886", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031315_380355539883552_6052881514690852200_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=to_Rkk-p3fUQ7kNvwEpYoVl&_nc_oc=AdqLug3KTI0Qr_1MJTSBWoDSPvGJmENUtkRo-0ZPNovr6u1A1goml50Tw5A_w4HpOH0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2FzKCY7wZ04SBBgb8BVqkJVF3J5GB1Qc3AjtJVnoCZg&oe=6AFB1962"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CUBEroll", "keywords": ["space", "scifi", "action", "endless", "arcade"], "long_description": "MAIN GAME\nCUBEroll is a casual endless runner game with narrative-survival elements. Become the Cube, choose your form, and compete with your rivals in an endless high-score competition called CUBEroll. Share and play with your friends and try to take first place on the scoreboard with Strider or Raja. \n\nSTORY LEVEL\nExperience the Doom of Cubothrone as Pius and learn more about the true nature of the CUBREroll.\n\n\nFROM US\nThe first VR game from MediaUp gives only a short introduction to the unveiling story only on OculusGO.\nWith support from the Oculus community and users, we want to tell the complete story and bring it broader and more interactive on the Oculus Quest platform. \n\nGAME FEATURES\n\u2022    Futuristic look\n\u2022    Original high-quality music by Velocity Zero\n\u2022    Narrative elements\n\u2022    Main game and extra survival level\n\u2022    Endless scoreboard fun for you and friends", "short_description": "CUBEroll is a casual endless runner game with narrative-survival elements. Become the Cube, choose your form, and compete with your rivals in an endless high-score competition called CUBEroll. Share and play with your friends and try to take first place on the scoreboard with Strider or Raja. Experience the Doom of Cubothrone as Pius and learn more about the true nature of the CUBEroll.\nThe first VR game from MediaUp gives only a short introduction to the unveiling story only on OculusGO.\n"}]}, "developer_name": "Frane Bilich", "developer_privacy_policy_url": "https://mediaupprodukcija.wixsite.com/mediaup/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MediaUp", "support_website_url": null, "website_url": "https://mediaupprodukcija.wixsite.com/mediaup/cuberoll", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "NARRATIVE", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1380784872340151"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "279608175237001"}, {"status": "PUBLISHED", "id": "257269179198445"}, {"status": "PUBLISHED", "id": "464600204957607"}, {"status": "PUBLISHED", "id": "697728404272540"}, {"status": "PUBLISHED", "id": "885364552318375"}, {"status": "PUBLISHED", "id": "540085647346290"}, {"status": "CANCELLED", "id": "377240516950901"}, {"status": "PUBLISHED", "id": "254221299378686"}, {"status": "PUBLISHED", "id": "851019288832256"}]}, "baseline_offer": {"id": "279608175237001"}, "i
Q7kNvwFLFzvr&_nc_oc=Adp1gAJ6EoVy19BEe4G6whgyGdLDfZj2qEQfi6Bx8OhQ1favyAVaghLk_LMy-DpslPU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5HJLoVDjtzX72EJYXIlitK87jYNniLIs6GyQ0KW1GqQ&oe=6B03248B"}, {"file_name": "4-screenshot.png", "id": "1387847026741546", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/673645340_1387847030074879_8748070880083461335_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80PWVzJKkWQQ7kNvwHsktl8&_nc_oc=AdoEkvyihobNgu6w1pc99P-9YhtX7-vB08hUervCIh8PDa6m6JNsGVCUXPmc8Hm1BYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ65emve_k2_xSN1F4mhiP9HeMZ6SrHMM21CHS3IitkSQ&oe=6B030ABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5-screenshot.png", "id": "1702154571621637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604370996_1702154574954970_7944671139622752321_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl4JqxlRnVwQ7kNvwHCUJ8z&_nc_oc=AdpGBmD2F9-P6CGeo4Luu-NRFc1hsvA6TtXTH46H5tVQQTWMvYxXx0vW4Ndnr9m7BHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkkJisbM-fLYameM3DCLNb6XVerPL2Wb37De2-r_6Dhw&oe=6B03338E"}, "display_name": "I'm Rich! Infinity Coin Rain", "keywords": ["Passthrough", "Handtracking", "Sandbox", "Meditation", "Relaxation"], "long_description": "Turn your room into the ultimate cash flow! With Passthrough mode enabled automatically, an endless shower of coins fills your real-world space.\n\nPlay with your controllers or use your bare hands! Hand-tracking support allows you to catch coins in the air, gather them from the floor, and enjoy their realistic shine and clink. Want more? You can even stretch coins with two hands to make them giant!\n\nIt\u2019s a unique VR experience built for relaxation, meditation, and manifesting wealth. Sit back, unwind, and feel what it's like when money literally falls from your ceiling!", "short_description": "You don\u2019t have to do a thing! Feel rich and enjoy an endless stream of money falling all around you. It\u2019s the perfect way to meditate or send your intention to the Universe and attract abundance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.narova.ee/it/ImRichInfinityCoinRain/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Narova Digital", "support_website_url": null, "website_url": "https://www.narova.ee/it/ImRichInfinityCoinRain/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1246873711851766"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/585741071_1347675850211325_6704000054454571042_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ynhj_peBgrAQ7kNvwFp59VG&_nc_oc=Adqg7olILbBsXny86cuwRJyLrbYA0TeplVhm0gud6VmL-ab3Y0OzceIGHtooYfONeHg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUuOJgMYcbEbgpd6CAGRSB7aGaTzGz7dCufClSe1Ensg&oe=6B03168F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "I'm Rich! Infinity Coin Rain", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1784200920, "lastRevision": {"nodes
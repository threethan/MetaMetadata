vwELtgmQ&_nc_oc=AdrCw11hBqqSTmnh04_orlda9kfDJmwxk3VyChOnPpcEJ-m9Lhtk2YUVeyAmvPfNK_k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaDPRGmLzlmlEIuFQQ2alp_KMckGtlp0O1S1PBHFVwJQ&oe=6AA025DE"}, {"file_name": "Screenshots-IMG_2026_07_13_131757535.png", "id": "1013230811429553", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/585819904_1013230821429552_8329240629772339127_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lcj8sRYN5zEQ7kNvwGl2eHH&_nc_oc=AdqvwGDXzs7toNC2ayBSFXBfTVBD7QJEHlh40pVkrOSfVOTgK0KY6toopz5k7FWNMk0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIEYpVepH8dOBRX8hRm1NfufaSQwXsGAvEeqUv-a6z0w&oe=6AA0029A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I'm Rich! Infinity Coin Rain", "keywords": ["Passthrough", "Handtracking", "Sandbox", "Meditation", "Relaxation"], "long_description": "Turn your room into the ultimate cash flow! With Passthrough mode enabled automatically, an endless shower of coins fills your real-world space.\n\nPlay with your controllers or use your bare hands! Hand-tracking support allows you to catch coins in the air, gather them from the floor, and enjoy their realistic shine and clink. Want more? You can even stretch coins with two hands to make them giant!\n\nIt\u2019s a unique VR experience built for relaxation, meditation, and manifesting wealth. Sit back, unwind, and feel what it's like when money literally falls from your ceiling!", "short_description": "You don\u2019t have to do a thing! Feel rich and enjoy an endless stream of money falling all around you. It\u2019s the perfect way to meditate or send your intention to the Universe and attract abundance.\n\u20ac1 from every game purchase will be donated to support Ukraine."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.narova.ee/it/ImRichInfinityCoinRain/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Narova Digital", "support_website_url": null
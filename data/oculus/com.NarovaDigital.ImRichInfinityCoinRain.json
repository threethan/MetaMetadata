79_8748070880083461335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8up0w0EGskQ7kNvwFdMOmr&_nc_oc=AdqxDfTaMkbHY16A_z19eNw_1e_8XfmJayEfBleHuD9xDzJCtZb5YrobWUZXqjE4V78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBLgMMoyuZJptsTnrLqSkBk8ua68JRjpTGq-yXbl61-g&oe=6AD2433B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5-screenshot.png", "id": "1702154571621637", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604370996_1702154574954970_7944671139622752321_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRhxdiQZKwYQ7kNvwFjzG_G&_nc_oc=AdqP-D-d-Ij03OsLU3yoUntSfE-aekRzRkvi1T_6FUYk4gGeZJ42Thoz8Q0Tuaie1ww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB4LFAcTpKCqQmaeK16uHrwwYVrt5RuK5KdRKbJq9Nzw&oe=6AD233CE"}, "display_name": "I'm Rich! Infinity Coin Rain", "keywords": ["Passthrough", "Handtracking", "Sandbox", "Meditation", "Relaxation"], "long_description": "Turn your room into the ultimate cash flow! With Passthrough mode enabled automatically, an endless shower of coins fills your real-world space.\n\nPlay with your controllers or use your bare hands! Hand-tracking support allows you to catch coins in the air, gather them from the floor, and enjoy their realistic shine and clink. Want more? You can even stretch coins with two hands to make them giant!\n\nIt\u2019s a unique VR experience built for relaxation, meditation, and manifesting wealth. Sit back, unwind, and feel what it's like when money literally falls from your ceiling!", "short_description": "You don\u2019t have to do a thing! Feel rich and enjoy an endless stream of money falling all around you. It\u2019s the perfect way to meditate or send your intention to the Universe and attract abundance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.narova.ee/it/ImRichInfinityCoinRain/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Narova Digital", "support_website_url": null, "website_ur
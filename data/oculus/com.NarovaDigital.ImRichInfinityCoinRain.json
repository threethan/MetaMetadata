79_8748070880083461335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjF15AadZY4Q7kNvwEVlF5r&_nc_oc=Ado6W8DPTR5rCyNekP3543k_oCk0X1H_gaE6JuwQtcE_pol0POFlR4We8UGy1tQg5Gg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5-ZP3oVhqmnKAeYsth7C0AAt1G25qLTunwkTywyaBlQ&oe=6AC908BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5-screenshot.png", "id": "1702154571621637", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604370996_1702154574954970_7944671139622752321_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=117oRiywkB0Q7kNvwHIm4E3&_nc_oc=Adr8ZTnzInVKObts0Qtnj8mQD9HJ-20F7M5NMi3MANaQxThCm9qHB4jUs8ZUXM3XGfA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUQFBEKvZb-0BYhMNUIw4WDO5hr-2i-MnxIuzX29_EVA&oe=6AC8F94E"}, "display_name": "I'm Rich! Infinity Coin Rain", "keywords": ["Passthrough", "Handtracking", "Sandbox", "Meditation", "Relaxation"], "long_description": "Turn your room into the ultimate cash flow! With Passthrough mode enabled automatically, an endless shower of coins fills your real-world space.\n\nPlay with your controllers or use your bare hands! Hand-tracking support allows you to catch coins in the air, gather them from the floor, and enjoy their realistic shine and clink. Want more? You can even stretch coins with two hands to make them giant!\n\nIt\u2019s a unique VR experience built for relaxation, meditation, and manifesting wealth. Sit back, unwind, and feel what it's like when money literally falls from your ceiling!", "short_description": "You don\u2019t have to do a thing! Feel rich and enjoy an endless stream of money falling all around you. It\u2019s the perfect way to meditate or send your intention to the Universe and attract abundance."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.narova.ee/it/ImRichInfinityCoinRain/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Narova Digital", "support_website_url": null, "website_ur
r5l-c1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VFdYh2jF_QpwqsTRvzEAWjie37CNaBMGJXq4q8L43sg&oe=69ECC5FA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pebbel Tag 2", "keywords": [], "long_description": "Step into a fully reworked cave system with the 2023 Caves Revamp, bringing a fresh and upgraded feel to the classic Gorilla Tag experience. With improved lighting, enhanced textures, and redesigned routes, the caves feel smoother, more immersive, and way more fun to move through.\n\nAlongside the revamp, this build includes a custom mod menu, giving you extra control and new ways to play. Whether you're exploring, messing around, or pushing movement to the limit, the added features open up a whole new layer of gameplay.\n\nClimb through tight tunnels, launch across open crystal areas, and take advantage of new vertical paths designed for both casual players and sweats. Everything feels faster, cleaner, and more dynamic.\n\nClassic caves vibe\u2014now upgraded with better visuals, better flow, and extra power at your fingertips.", "short_description": "This Is pebbel tag 2 Better Than Old Version And New Mods"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1fd8b80f-90e8-4ba6-a3f5-7930443c3383", "developer_terms_of_service_url": null, "publisher_name": "Pebbel Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/pebstudcom/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
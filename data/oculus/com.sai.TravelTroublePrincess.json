2753434939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQpHsv0o77QQ7kNvwEBKFYg&_nc_oc=AdrUMa9-0Gl9ynTg44NM6NFQmkpgjWfL7Eqg7Lp8mBM3B9DMikaa6JJgdbYpqvqdFHY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af541gp8xTdtEbvBk-2ySfvbNF5inLM1h8OkgzQZlj0DSA&oe=6A0DAECA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8zOBwgS7MkQ7kNvwEeTz3s&_nc_oc=Ado4cyM6eDdFOglISylp36ShH0mxGskeDzhooo-yqM0WjrXOwL09XIafQjEdAvPP_IA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af647zrZLW1_cIK4vYqwVXezaA1tWwotwyCYh5wDzL-9Vw&oe=6A0DBB89"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gDelSR3H74Q7kNvwFRXTHm&_nc_oc=AdqiEAEqexi16tllsJcDrQxJMwdlD0g4rCeysa5hZVWOhGi2YNBiqL_WotRP8_MCo2k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dfQED7XGMAq9jIlXK8XqduhFTgApt6wmCACYHUOZFTA&oe=6A0DD427"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bd7IYjj8EgQ7kNvwF1qYUn&_nc_oc=AdqbC-SbWj-oZokbVbCqwCIWapCDMHY9zLJ3A2QryyUn7nJdd23A-GsYTTqh6OR5SGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vRqQm0gn7mfkjuBDSpWFoNSLbGOqeLJEuvPTIMK1cZg&oe=6A0DC753"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8p_dDryHlQQ7kNvwFrN1fs&_nc_oc=AdplATGK81viqeZqaBjqIj6-BHB0LCbt4pJJUGNoBO_WE9W4uqkaVtjacwZH64CMkRc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RBMM1GZyjZaxsNUs7--pXk9FrF_3tfOchr66VDXZSmw&oe=6A0DC477"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
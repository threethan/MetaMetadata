2753434939", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnGoz3UBADEQ7kNvwET-_yU&_nc_oc=AdoDPCgiUPHUynY2cTUbSdTgTGrzAAgDvz4uYc-MJJw5WxwjYY7kXgk11q4h8slo2Ec&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKnuL8xFFIhzE4zvhzYxH5Np5KfRS2zeloSTn0DEGr5w&oe=6AAD344A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vzupf_czrisQ7kNvwFgmJpK&_nc_oc=AdorQAxZtgzfaeVDBehAGJwL6jpGvL3aPLZcp8rmVsClpqoCChbV4XclAe94AlQq3gQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1MDZzskBrSiGTH91IcH20bREvRssk3vroiQs6hE5fRA&oe=6AAD4109"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shyNGe1sIOoQ7kNvwFe7UnD&_nc_oc=Ado0K-Yz7nf2n3r4HBzpEqJpHzikfTAq-bHpmi3GLbS0hH8WPsVxnlbrp2IEULegPDU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW8W_fGPxCEiNe0fXKf51Wg_pWygeewVtxhe96G0SvGw&oe=6AAD59A7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLoyTOqERlkQ7kNvwFf5WDN&_nc_oc=AdrosjEmQLa3U7NYTdUPmMOdh3kuBUknMfo9bsFZ7BSl8O26LCDtbcxbUwvuCr5I0I8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKr7Teo6YJuPxw_LEJS4wG26YLlKtjI_tzLAFWgoKKMDQ&oe=6AAD4CD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_JcsIlSYe8Q7kNvwE52o3a&_nc_oc=AdouoYe9D6oHM751L6iFt9ZYXn3BZBX7snI4p6bEuONWATrbn4xOdKU5yB3NxtiJOYA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGIbte4lbARsd9q3HdbJkXHI4eNh83opEsFydXv9WlxA&oe=6AAD49F7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
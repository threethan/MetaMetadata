2753434939", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxVtT52mbtEQ7kNvwFm74F4&_nc_oc=AdqiKDImxaWSbhmJ2JmaTxHWgfKDrc4We7JJ7hQHTmG4FhgpOUnW-O77eEVnxwohfBU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q_msO-GKQAgGdRc99Sj3QoWACJvBAMxxq_UzG9hMLOQ&oe=69D4FE4A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOa8BLWMY3kQ7kNvwE6dqoI&_nc_oc=AdqAi1MhmbcuMjHGB2UpFOykTLVEpfOupXRIK5a8eTdkmlRMKHi-7YEreq6nymZYE3g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1E4Z44nadgZyI4FrBe8prrL9kvMkkLu2ouu3mpHGsWRg&oe=69D50B09"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jo53FY0LB7cQ7kNvwEjSqdf&_nc_oc=AdrLuHzNuGMWLI0JRDpGy_nYS-yPEvNjT54llrdWe3aiOcFOMfKt1RxkKwysCC-dTJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xOZH2k6g7_zTcg4_yLNpgPcTCvW8UOKDY9hC7P34HoQ&oe=69D4EB67"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XwXItxWOGkQ7kNvwFF7CqE&_nc_oc=AdpM85a9KtEh5p2uaMjWWGKDekWNGVuD8ANL9o5FcjjXITVRZVcdkPGgSbXwLs4Xrk0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31NGP6jXfLQBL8ttoqzKUY2M79mjfohNsaoPeVS4qQog&oe=69D516D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFx14BaNF0YQ7kNvwFv37Yn&_nc_oc=Adocllg0AwfGHnwlKCEK-6XGziI7kP627uHXNt31t6EqBKJ8nqBiDe0gzSkjqTCvA6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xt0rLZSSLUVd0rwx9Cg5M-hCIhrLyKyepFnioBQ5urQ&oe=69D513F7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
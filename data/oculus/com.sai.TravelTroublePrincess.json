2753434939", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4XoWD89bM8Q7kNvwF2GNnI&_nc_oc=AdrtsDJmq9PlggMJ9p1qTHVxaTlMWBM6idRd9wfY38y9Rwb1Kc2pMVD8yAzwLcn5LPE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQfknECKU88iG87XVpzml8J-5Gn2mmzdqZU-4--VvxqA&oe=69C7CF4A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0Xg94rfsrYQ7kNvwHGO9BG&_nc_oc=AdrfOZXUrecrbMYEBiwbUHZK4hWbxZbTZ9_Wjun_bsAd2QsbOxLg9CNWQvCqFdfKEwU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIu6TL4tRDBX0_OB8omjwNbQXQFCFBcwlkgnMqkE0Omg&oe=69C7DC09"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3Ygk5PZOOUQ7kNvwFx6gkJ&_nc_oc=AdoOWxr7WhpqQTztFbZSqr8P_UvDntr8kyR0YdCsJZEoqmuu1u103AjlKDUIpZOCAGk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzkjS7JELvQpZbsiculAFkllqOqSc9v2N6MmWPVxg9Ung&oe=69C7BC67"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJCnmFX7mtUQ7kNvwEJNYhp&_nc_oc=AdrtgdJYDwh2iZ3G2cSaGyM87fKUYrtuW_pMAvYxGKuSUhrQ0BktpBENMFRbwnVS-yk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrQMqpDgKjFrRLyfbY1vdc4y8_MYJ7M0Pw0riDNoNa6A&oe=69C7AF93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfNwjRobzswQ7kNvwGqxhNO&_nc_oc=AdrK2Z78Pea0ipgMvSmUno3HW_bu7jRImQzmfoMSDDEQrJdur4ui_swVNQSNOoufOt8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxy-BzLiYNAmm0idFWP-hmhwmO70ScTCP03emnWOE2ekw&oe=69C7E4F7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
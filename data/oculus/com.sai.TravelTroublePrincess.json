2753434939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLlzplfAVz4Q7kNvwGBr1An&_nc_oc=AdqohP4kRedvtGpn3uwOH_YOdaC_C2ATpRqUNDpPGiDk8Ng_xWDwsqokqlxO42eIMOA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABk1W2eiRfAKN58lsEZpi3jzlhj5v-_VuoTZjTagQ0JA&oe=6A5782CA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wr6UGxnv8iIQ7kNvwFn4bcP&_nc_oc=Ado0zXuThCDgpPhXNFD96GAzi4ISaxRE6Ijm3wmdGFBneipDRGBbznXH1ji6s3CAYJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyE5FdMWuGiwdFL4kslGgsxIcbrAPOzb9mjoc40pL0DA&oe=6A578F89"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s4eIjSaxtUQ7kNvwEkacek&_nc_oc=Ado8xRnRMVVE5MV-LKhtinbdikQ_GQXDm0nN25a_akEb_zyL-AL7j5CkBzod8rb4Tfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYaNKvSbbaNiYddWWYp0Ijg0udwI_8q7T38CclMI7v5w&oe=6A576FE7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AV_p-wgQS4Q7kNvwFcrn_0&_nc_oc=AdrtY_2s--RPETG8PX6suUQJKRZxhLVbYenHveiqc48cAiCUV78-Z_3c7XUG82XZiuI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpk9pOCQ0muGwoF7n76IIGrtyiXotCPZVVh_KcU2nGFA&oe=6A579B53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK8lOTk_hdQQ7kNvwEahuR0&_nc_oc=AdrEfMNHm4atJkhcwtEAtl2ew5ryJtbh7ENQ8rm0pCkyn2uSZZRY-J2GsjdlouDBjVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLiOnM4UClENejJQLAFlERB-Kxjc8lV563v-S5pD_etQ&oe=6A579877"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
2753434939", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Gsoh3Y76a0Q7kNvwG_gjiG&_nc_oc=Adph4uNoDi5D57jid4VWgwG1oJgwaU-P8FNhidtn311yeqRZa-9lBkivpjfKTQVdmjA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XQNx27zN0Kx_6bltdTfO-2dQkKbkRmNtADDmYnuPojg&oe=6A2C014A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lz0TNM-GVTkQ7kNvwGI7Bii&_nc_oc=AdrvrlnJKNG8Xi-P-n3B2zSPXSng5HH08Bm_TjWp_-bJ2EmFdax2BX4wqi_OMdZpvK8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GY3wpHTltNRMZdutyXMzeAD5_GSE0OTsFGIeSnE89ww&oe=6A2C0E09"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffb2G-L-E14Q7kNvwHnoaAh&_nc_oc=Adrb0ttLgpTdKPAwHjiPahysh0opyA-Ja5zaLsXyEBxRFPkX_qkI3iMX4yyTHNRlu2s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_Vho7mF4LH79fhRswxXWrnnMQ91Z6gQmgdnAbxR-gqg&oe=6A2C26A7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTXMfmU8s5QQ7kNvwErJA6H&_nc_oc=AdrsiZd219CLy27vWpah4czRTU0qpIzWkRfDilIE08W7fyH0p-kZkpKF-sCEBjjdoyI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AVBhPNW3YTlo5XgZKfoWJHNVqEHHphrFZfPi9KG8wQg&oe=6A2C19D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EX8g8m5QTGkQ7kNvwHo_co2&_nc_oc=Adom9snViAw7O1moI0HdaQZkklk4V6serQP1QTh6j2LuQxPzSNv89178EBrftJ4Zsyg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-9aWF24l7ZxdOZ2hWtXC1od2vIA5atCGcfwy5EG6K7Q&oe=6A2C16F7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
2753434939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErxN1oBaTmEQ7kNvwGmr1QK&_nc_oc=Adr2Ki_FGCx3my2SF1uNnUwFCgfWdZMKwtdJERJ6g5Ggi5xdPy7NyxWrdh3qRdQcy1k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPsQ6yflHGm_p_Gz7fW63YKkx2mwPKxTIQX5Sywn--tpw&oe=6AC1330A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iah1N3JfDwUQ7kNvwGQEIIV&_nc_oc=Adpe3E9HEUDcz_cKV-1Z0b53rZv2aAd4Kw7i-zBAQjJie9gjD8Zrceowv7asiB2IYi0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxy3EWgvA1mVnFQGwMnXtiIVuRic11StIuwgbn8C44eg&oe=6AC10789"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7UejK71ACMQ7kNvwF2QjRX&_nc_oc=Ado95c-Sc3krxgTJ-RRSanhTDPcnfMcFJ_FQNhKrlr4U4tIcByS7Tjubipb__o8FpVA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi7fAUmRDPjQ3bQ3ZUCPNt77Oa2L8nrN8Pk7LQF8NtZA&oe=6AC12027"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykSNqx7j8ksQ7kNvwHnbJeU&_nc_oc=AdpEifnk1HrOAGiGdwo8F6fkxr6AjxGoJlImh_wASN6uxWGisrYCwjdZP5Pu13921SQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNubUlgmQWkieO_PzIyQ7HeSSpwf5vGfpNgl6CgsCi3tQ&oe=6AC11353"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hUMHNNulUmIQ7kNvwGr9KCk&_nc_oc=Adrx8-6pcG0P5ZehsTMRc8lHRs0aQEeZAIz1RQupOS53m9wpyFmhKh4UJJo7aPSMWbs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNt8fci8pGoRg1owplOMgJ2kESp1Y3EZP4D5l91cYNdQg&oe=6AC11077"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
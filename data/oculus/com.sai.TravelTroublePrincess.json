e_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NtGDoIoQULkQ7kNvwGbu0MB&_nc_oc=AdqEwG3SlmE98CSTynC6VY421j7BlrYv4Ht6nmXcbOse1HkE1y02oECDIN43V-lTA00&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRad5gSXXHV2CBTFi3saOCQvfjmgOU9y7PjFmOsFlOM_g&oe=6AFF06F7"}, "display_name": "Travel Trouble Princess", "keywords": ["Princess", "Journey", "RUN", "Cute", "Adventure"], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9107721879248393"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031460_2298687457163892_8312256046766335394_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltD2NLtMjP8Q7kNvwE16ox9&_nc_oc=Adq7s2tXP1hxzmCyszXABX5RRtpBx0FggfQf8p0jaS_LOdZOOt69Nl5bRlef654y9vk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROf_TtQFDiZn_QhRhulnBQO8fexLYR4WgBmX7E-7G1Pg&oe=6AFF2BE0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Travel Trouble Princess", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1658854800, "lastRevision": {"nodes": [{"id": "4201427366640369", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4545932035427423", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "750905036060229"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1099132890810485", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\u64cd\u4f5c\u8aac\u660e\n\nA\u30dc\u30bf\u30f3:\n\u304a\u59eb\u3055\u307e\u306b\u30b8\u30e3\u30f3\u30d7\u3092\u3057\u3066\u3082\u3089\u3046\n\n\u53f3\u624b\u306e\u5263:\n\u30e2\u30f3\u30b9\u30bf\u30fc\u306b\u5bfe\u3057\u3066\u5263\u3092\u632f\u308b\u3046\u3053\u3068\u3067\n\u30e2\u30f3\u30b9\u30bf\u30fc\u306eHP\u3092\u6e1b\u3089\u3059\u3053\u3068\u304c\u3067\u304d\u308b\n\n\u5de6\u624b\u306e\u5098:\n\u304a\u59eb\u3055\u307e\u3092\u5098\u306e\u5f71\u3067\u8986\u3046\u3053\u3068\u3067\n\u304a\u59eb\u69d8\u306e\u4f53\u529b\u304c\u6e1b\u3089\u306a\u3044\u3088\u3046\u306b\u3067\u304d\u308b\n\n------------------------------------------------------\nStory\n\n\u3080\u304b\u3057\u3080\u304b\u3057\u3001\n\u3042\u308b\u3068\u3053\u308d\u306b\u5fc3\u512a\u3057\u3044\u304a\u59eb\u3055\u307e\u304c\u3044\u307e\u3057\u305f\u3002\n\n\u5f7c\u5973\u306f\u9b54\u7269\u3068\u306e\u4e89\u3044\u304c\u7d9a\u304f\u3053\u306e\u4e16\u754c\u306b\u3001\n\u3068\u3066\u3082\u5fc3\u3092\u75db\u3081\u3066\u3044\u307e\u3057\u305f\u3002\n\n\n\n\u3042\u308b\u65e5\u3001\n\u5f7c\u5973\u306f\u6c7a\u610f\u3057\u307e\u3059\u3002\n\n\u4e16\u754c\u306e\u679c\u3066\u306b\u3042\u308b\u5275\u6210\u795e\u306e\u795e\u6bbf\u306b\u304a\u3082\u3080\u304d\u3001\n\u4e16\u754c\u306e\u5e73\u548c\u3092\u7948\u308b\u3053\u3068\u3092\n\n\n\u3000\u3000\u3042\u306a\u305f\u306f\u304a\u59eb\u3055\u307e\u3092\u5b88\u308b\u9a0e\u58eb\u3067\u3059\u3002\n\n\u5263\u3067\u30e2\u30f3\u30b9\u30bf\u30fc\u3092\u8ffd\u3044\u6255\u3044\u3001\n\u5098\u3067\u65e5\u9670\u3092\u4f5c\u3063\u3066\u3042\u3052\u306a\u304c\u3089\u3001\n\u5f7c\u5973\u306e\u9053\u4e2d\u3092\u5b88\u3063\u3066\u4e0a\u3052\u3066\u304f\u3060\u3055\u3044", "short_description": "\u3042\u306a\u305f\u306e\u5263\u3092\u632f\u308a\n\u304a\u59eb\u3055\
2753434939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjvIiSSNr-wQ7kNvwGrGMGO&_nc_oc=Adru3NAri0tNB90ryQfor5JkJtZR8YD0zKY5I-MCDnrsfwdYfL2F8TkZiMLWwiLkAu4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i74-MchKgZVfoZkiLOMUHVfigcX4a8bcHPt9wmu0qUQ&oe=69FB39CA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qqd9RidnM2sQ7kNvwFdOllC&_nc_oc=AdoHnzK9ijAvGcdKa_XihKofVCZ-I2LzvIRQGUjJWInHnj-k5HI4LLZOuKYjAKp-MN4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S3U8kY450dCpG8ouZ5DuGi7HLV99uTHRugKd43lWAFg&oe=69FB4689"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGavIx4dU2MQ7kNvwFcwt3k&_nc_oc=AdooUaGyP5em2B9L02IoZ3nQ1FdrHHBNkbqKqf2s4GadO2Sd5BgBlhlMexGb6FiwG8k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RcIy7oqpPIRolsd-YiufzTrUzXtnLgfPRh50Y6XMEyg&oe=69FB26E7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vZY8ZGFccAQ7kNvwFbKGSD&_nc_oc=AdoKHqdTJKi6aQScgHJI2ll9vv2smkdOW7CJqQJNL2spH__L1KRKk3H17VOuhGSm4OA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dggCViZoj1agzXG4mHbdetFvdi8UwUEqAuQBLGRRxUw&oe=69FB5253"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgT_9sP9cYQQ7kNvwG1vM1F&_nc_oc=Adq5LX61xtw-RHJDPMEq5lsJqYtgNQCwodWlYK2nv5A8b3lW-io_2e1oSAkZVBOuNLw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nVw3IrFZeCE-j-M7fIW53Rh-v-AYjgo_fkpTfScv2Qg&oe=69FB4F77"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
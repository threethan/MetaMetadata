2753434939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQrL6Mjt4b0Q7kNvwELmFr5&_nc_oc=Adq1UQcwy3lOYN2XfU3VsCBwJbtYk4GE7PSEqUvVW_rgMOWVaOFeF_KlSY49xkmNBug&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OPT8V37sBKIHJjauu1hMq3V8zs7B9iFe7FfbSOjomKA&oe=6A04744A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmaZuzSlgi0Q7kNvwFWv8aV&_nc_oc=Adp8bn3g10WCIgE5fNcVE93G6N4TvxdJK9147H6u13kpda43Y6xEG9tgXH-nn7F-lFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5t8vt-EuDTYK05FUeQzqsL0STZdTDDvF9SnuFyEzijuA&oe=6A048109"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSHW-P6BA9cQ7kNvwG5H1u9&_nc_oc=AdpIM9svy_iuGupfG6izvusCY70yKzjgpYyBaNOpal5zaxy1OQG20SkXOv-6TawzxLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5x3rgQ549X-11QPryo1gNctyGmShaq8t1p1dZsBy8m9A&oe=6A0499A7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5GZxRymP5YQ7kNvwHjBMaS&_nc_oc=AdrNea_rMiPjAaEcU9sObzvOwUvWA-1erO9dL034GeA3iQgT5bsW97hFkthRm3z4s-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5v1oc7S8iV-YcedpVAAtEzJFEtQ2LnAVXeHgdSCfEjSA&oe=6A048CD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fac8yAhw0kAQ7kNvwGsyrEb&_nc_oc=Adrb6SQxDWsMJ5dbfN0db2BkbOCH9Rluax0nIfVG7b3Snlx_VlK4oECu1YHwRgZzmKc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZZyDGmpXzdDjDuOWZ4cakt64KA8X2btiCR3AMX0Wbfg&oe=6A0489F7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
2753434939", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYdXBkbqgicQ7kNvwEg9Epj&_nc_oc=Ado-MDlbvU_xi_oZ4zqqWBpfgre1yRtiw5aLjHo3nLejhIgX1QB11x99v-FhLmaaAFk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6BlY9Ncm0iR710jnGJ7hJwMJA_gXn9DqQ3H2g_nfY0g&oe=6A66034A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0iCpvMqxdJkQ7kNvwG9YD2h&_nc_oc=AdqVuwV3Q90zbyrTn16iKgu9wOkD2OcgEa103LDi5b1DBOzvjtLL6ZskWtOH6Ykrh8k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk8_jHtgnqaZFWFNNYH8aVzAHcqEE36FApECkSSExBNg&oe=6A661009"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHTiqmWC59kQ7kNvwGX4YiW&_nc_oc=AdpqaXy1rBkcSx8P91VrfItFIAvqcsubdjVVwTQJ4fyssQXvgKcEdcmdesHuAtyV5kE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKcmTNSvtIdWl7H4EUOEhAtVVTD2vWttJIQJTIsu5hcw&oe=6A65F067"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m6T23AFgBoQ7kNvwGD8GCX&_nc_oc=Adr1ThTTOedQeQtbjP30k35GYBi6Sorrm0T8eRuuY8tp46eb8LMv0ra5WCYbN2duJZ4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfvbJm5-wkvbryiPTTWHWydYclphIYwOBJ2xv0noVGpw&oe=6A661BD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sJ_-ybBn7IQ7kNvwHKBuuf&_nc_oc=Adq1SCGweJMIkoTbWOd-2bjx8GbuvS6MiXYq5U5I-sYkL9DIGkaNAFqPcGd8vVb_OKQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0niJyf_qjeNWRgBakWme_CPmTR20-42HQSbOUrJwTew&oe=6A6618F7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
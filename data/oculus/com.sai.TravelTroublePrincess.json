2753434939", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-SJrliewWIQ7kNvwERlpm8&_nc_oc=AdrjEV0rGsz0jnNQTz1QsfUCst5BTWGr1SUlG2yVPoc0NeeI7SeLmzc74cSO1TXjaso&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sPJdUWphfpgGDyi7ECWwWBW4nvSvgjOJ2yOhgdtO8Rg&oe=69EF5C4A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1gCT_eut10Q7kNvwElbvGd&_nc_oc=Adp2LJrHMAGXGtF6AD8KO-s2Nl-uOOxab0unzXx71uwCx2e94ftyJeulyfVENlmEBOM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Dl5O5B98d0EgLHRMbNJIRv0dde8uJ_w4H3q-XgI1khQ&oe=69EF6909"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbiLeRLi9A4Q7kNvwF40tN3&_nc_oc=AdqfK_lYoC2O_MZLlYNQC599-guTI2wXtFiqb9TPsl0OB6Q_wlWmjLxBl2CsnN3aqE4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0TpZaiyEv5x0UyCi-VeB1SKm03Eny1uiOu3L4izkddzQ&oe=69EF81A7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9ae58jT5lAQ7kNvwFs4Vrl&_nc_oc=Adr8hW8uRmCJU0sGFc4wJv6W05Us6cIhtVNK5Rn6Tajkso2TmrDY7s9wHbJI4YS210A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3eK4qD7fiBVzv8O2VMrQexk5aciLTW0-s3vrrbjvBMhA&oe=69EF74D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3h6Ot46xFkQ7kNvwGgBhcj&_nc_oc=Ados0lgltjIPl-3QEG_JxE3PicPJBdwhXBIWS25z_dbQF2pF4lpRnCrxKfY8DKDyuec&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vGTuKx3beCkvu_hxiw35gG6ceo5Q_11cy2iDVCO9E_Q&oe=69EF71F7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
2753434939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTDL8m4tGXEQ7kNvwEfKSpx&_nc_oc=AdpxkyaqsrexQMKL0ANoMtjNgrrDg3qTfMO6jfmjmN1OS--zNh3JrMxdyqQW_vabROs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-owLpRF79WqSEbuKo9QyGjPRa5f-w8FkIYLaBmLQn0-A&oe=6A47B0CA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30X4MYq1tI0Q7kNvwGvfIPs&_nc_oc=Adq9Ya6BK3_XCeaagz3ER8Xnx0oB2bEa4lcGqfvWFQixF4d5hcIslK3yTAEs-T4xqaM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pdANvYgPls8eKhyxMQwjraLF3aam1hkHMcz5yhJuCPg&oe=6A47BD89"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yg0-OaML8IcQ7kNvwGTU_Ox&_nc_oc=Ado8psMn8sklkw5MOJwcaXuow7otF7xAv5EQetk0aKB8Kt8S2shtsgW_9vpodODabDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-17mtF_KWaYU7oi_89zaY7FSKnyrlvEt07u_o_BvUT2w&oe=6A47D627"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7ViUnVX6n0Q7kNvwE70Ct5&_nc_oc=Adqqd80ycTDiVFS_s3YAFGpq1gwuZhRWSwNIXGyn39N21en0eIriieZ2jCD5NQhkl4w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r8cF6fTAuCGVBkHWDiRt3oXzF6zGDF6rCxFuzvWuTAA&oe=6A47C953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XMinvRfVKp8Q7kNvwH4-gLr&_nc_oc=AdpuVmC32TlG5FlIH1PQl6r9jzD-I5jhiFgU7i42NLxRnp0P1fimEPNdZMHmjYLsdLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mrBeBsOtoHViQO9uXJsxCsN9JOKmKOLzLs7SMf09ulg&oe=6A47C677"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
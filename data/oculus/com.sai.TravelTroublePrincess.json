2753434939", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TkPI4BkJuLwQ7kNvwFE2TZN&_nc_oc=Adp9tjlmLVskx3AyuVhWBcUVx9qVCNneszoII7coVJPLtMT1gmFq9Ni6u0JCpHeiH5c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qxp72Rw8b7kOK8Paq68e-xRN6RfhbNN3lr3HXVhLyvw&oe=6A3298CA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lW7gVdMW5bwQ7kNvwHasZ8j&_nc_oc=AdqbzPVsHp0-MIj-d0lk_q-p7iYHqpJuDTQ1dvRv7enxI8-pArWHkVJ3HxmmkGcJRh8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9s8r5s3b4cqJi3YCdBWddRPewljrBvr-ze6tfMskeWEw&oe=6A32A589"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hpk1G4dAw5wQ7kNvwHpReX3&_nc_oc=AdpPBto1ehUyJywHRsSZayjkxiHN-1phsQ-FB8433xTHSjYoQM_4Q96j-Y9WxJiWe4g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UAWzB5ZLjIlUCJuiFx7Z5sipbZz2DmHixeSyttqb8Ng&oe=6A32BE27"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hijobZXWpTMQ7kNvwG8dhZ3&_nc_oc=AdpWJY0gYh--Df-uY87-JcmefO6oZWnRZjnwO5c-1nJCh0D5ILCgwtQaXgqYCcLbvJo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_wy64OyPihRpwmZ0Q5MiFEO1StJd2-OEPNHDSQn_2-pA&oe=6A32B153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wW_4HA2D3gMQ7kNvwGWA-Ny&_nc_oc=Adqnjv6vFo6OsX8JE5t9bgAjLXPhn0tkCmv2lHbQAcCsShcWjhGRbU9ugNDdeMVjqAM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-78sju0fkvX0mWjOJuEjq08rmtPBG66YiUxkPpWPJ3pA&oe=6A32AE77"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
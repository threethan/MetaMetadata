2753434939", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iucg6DpkfVoQ7kNvwGQjWOD&_nc_oc=Adqr6z0ZhQFhiITGM9Rdci3peFatViqUWKMYT0R0MJ1rp4a2ejimxOPcqsrOfkO0lQs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cFLI7eNY3rwZ6jDuO6A8LGxnjyeSvclP6r-d5SPAH6g&oe=6A16E94A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCON62QczWcQ7kNvwEFFtCy&_nc_oc=AdqCmphO3LqWQhffzrKL0RlAPYfn-pLa6clDUyQi0XiQASuUnBwJBRZSNJze1L4fg50&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5td9hXaC0bJCq1bS2TYD414q82XYOzHgB1-H-2YXs6sA&oe=6A16F609"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoXjo0GILTkQ7kNvwG__Mta&_nc_oc=Adon2fiDwaPrkE6CEClsM8aqoI3VuXQvKOb7V4LJ61OlPmPZOMJdyNEed31hwF7D524&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FoMhKF1vKrPPahghemQqnmhb5f1EgydUGD7PUZhihlg&oe=6A170EA7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrFSxDvMrM0Q7kNvwHICxuo&_nc_oc=Adr64zwcY2Q4TTmSCAUV0lt351J0dh3YRKuB7t2Qnmdyvli3tS3sodjKh-bVunw2jyI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hqAu3C-WszkJ_pHoMkKZUoPuf0PRw9suySe3goQArZQ&oe=6A1701D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evkbFaD04_sQ7kNvwGcUg38&_nc_oc=Adp4fg3JF8NWJiVKx7un0n0KPFoHbEdSiVzg3LUQldowSb2yRmKqk-7j7uJxy3ppa-A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uEWKiONXa_beX5qJxR5W9t0A5dparIsYpfa6nxyKr_Q&oe=6A16FEF7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
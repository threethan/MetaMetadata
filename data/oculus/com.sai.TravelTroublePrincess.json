2753434939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2G_khqn7FsQ7kNvwFNRwc_&_nc_oc=Adow_6Y9u__xxR0m5TyXKpysTrHUBoEdjtqrUGQpi6TKnyYaKQzV3uJ_diCiC1bP8Bk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIB6ALedJT4jWGjZm4BWu-AngvbWfKs2tGldLar-9WaA&oe=6AC640CA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-rewt1n1E6IQ7kNvwEIsoUz&_nc_oc=AdpsRmtT-_1DzKkEx0JLF66i4rG4lss14y0Rq4y88IM9tol1aReBap2Kz6DWGgmsQdc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQmiinRWrP5_971MAf8Q95YOzhjVT7AIGkVMBCEP9_jg&oe=6AC64D89"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0WZst4EV0cQ7kNvwEobxLG&_nc_oc=AdoL1XH8HjycJKggH7OyYRPgynbd3bZpqW5F93seHUtLAf09cnr2WJWO0iKqDa3OhGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpJL7JvVG_rJhyh4xJlB1-ONHiap5XQH6WEoewX4v3dQ&oe=6AC66627"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8tr-0Hc3tgQ7kNvwHf6RgX&_nc_oc=AdqOJuLxQshV7V09ytlIbG6GwdAPJ-6YmGU3urVVF9ShteMuzCadlaR0jnTaCqmUYQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObaRWYHRKFSdOKRUBpOMnEtI1GQ1rMHF6CwBRtAeKy8w&oe=6AC65953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjyoCMBRE4UQ7kNvwEML3Ju&_nc_oc=AdquiGZkzH_L08Y8G5E5_UY8AOYVMltiVVvmhGq2WwzCzNfwi3GFE8feXb115yeiJV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdXV5cBc-AaVWBSC1BdmmBjhwB7sf9BvFIg3hJ22HXjw&oe=6AC65677"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
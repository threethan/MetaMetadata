2753434939", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bs81qfD6X00Q7kNvwHtUp8R&_nc_oc=Adr_0VLUtm6ZSQrdlAxw-_-V7znWerknihiCJjEMPk5qOdNqeUUI5o4Kujso-0rGsoA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BEt_r1taOzLWF1l2tFONPFPhZYikQkaYRqHWnBoMfGg&oe=69DE38CA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pe4v7zO9bnEQ7kNvwG04U0B&_nc_oc=Adp865v-sQzYD8snt0LvwPW-nYQY-TlEvAgsRoe5am-aMR2wBI-AbZ-16rJ1yNYlGdI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PsULXob8My9G9xWxL_jfoOZkIqWyte5nyAJti-EnSjQ&oe=69DE4589"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzcwMr3mpe8Q7kNvwGazL7G&_nc_oc=Adotn6JyrTMPS0S2i73xeZhf5CvdTUj1R-9FErN5V55eS8lTFclWCl2hYgv-5xSeD2M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WDtDhE6HfRGmWpD9PCCgUQGibX8wLfakwn4gpJE5mng&oe=69DE25E7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4dYBrsic4gQ7kNvwGtflZ_&_nc_oc=Ado4sngohKZrzgBOEIlLWW2JAi_EmnwKLU41PqkjATbOQPsmJAVplTPVoYFHwTIlAI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SEG0a7j_4jqtt-LqU3pFnYPYC84hJ7loCAOfoTW9CXg&oe=69DE5153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-iBFdbF5gUQ7kNvwGZMJO6&_nc_oc=AdoCcwVyIVEE2uSUrKBRTIGE3B0lFU66WwsSzZ5ccRAP2rU1Jl5q3NQbcA_U8neFuxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZIiVHHEvDvp-XPJrkyv2jfQ8CS6x75G6Ln3rOQn7ozg&oe=69DE4E77"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
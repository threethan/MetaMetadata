2753434939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjvIiSSNr-wQ7kNvwGJQBTl&_nc_oc=AdoiB2B1wOmWgUJ-ivVvuyBzi0ZTIgiS3vTgl61YaWE6iB_joHRl3eRx-7vAy1qgSjc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vgI31GEIJGxGcMH3hFX38Ue-lSspbeZ6rOseFEx1CXg&oe=69FC8B4A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qqd9RidnM2sQ7kNvwF-UOR-&_nc_oc=AdrnbwXczbF81ug2OWrMmuHOwQCAkCTgoh3Qn-M86h82me-ivOTwlKzqg459-PADmTM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FCfl4zzR601KzDgJ4UCntJ5ADJFgWHlayF8Obq1LlsQ&oe=69FC9809"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09BoqzUauswQ7kNvwGE-44e&_nc_oc=Adqa-mpPZwA-a9J1Broh-4eJYlsn6STEgJNlUHbxFRlM-eoABAgsx0VR3dk5SnYgoYo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZE9HszQF28bmav4iBPFiJuFMPWjOqma3HWGXXTC9gmQ&oe=69FCB0A7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWHNd7VcpFEQ7kNvwHhGrsQ&_nc_oc=AdoPLb9CjQ_127bHsDdHQk3v4F3CdzSr9zSyroTHKp0qDXpoucc1_xWNoXJ0d_HtiI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aJ_qw2IiTVaYwBV6dugWFrfVNb6ZG_yHwPM-OOs02_Q&oe=69FCA3D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRDrYjy4n-8Q7kNvwEdzQqU&_nc_oc=AdrqzJEHuXwToU9D-n_ENYir2k7zQIdYyQOa99DGaHUhugqoSehNDi-hN9wiQcfpGNs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hjguw1Sus_zB-vsOBz27rTMODLsUTc3geg6kV4gIi-Q&oe=69FCA0F7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
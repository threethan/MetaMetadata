2753434939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC1ASAy81UQQ7kNvwEedNC3&_nc_oc=AdoLuok-ihjCzQwZUqW3cmsqXxCx13i70guNBOBHZod1hf6LA0W4FGbyA97dGyqwN80&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8oBLyOVXNwNTrWlHZ264UP7esG7Psl1ywcB2w5g6Bsw&oe=6A996DCA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTl3KTSFnIEQ7kNvwHw9zVZ&_nc_oc=AdrfC3FFuKIeIM-6GKbIdmGp6WUkg01RN8dNTxwQbP_dKiq71trxLXQwDfmzRrvfT7w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIx3CM6bgt4FjNvQ-6a8lgB77KUXaqssU_aUiq0MhzFxw&oe=6A997A89"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoBKQCT4-5UQ7kNvwFykB-V&_nc_oc=Adpu1SS34-q80Bfee1KJRxrc7usH1_rd6QfYYAcQhHNQI-lAvTjwuAVv36wAe3rsMGA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi8pjWrPhbQqDvvE4Sf3iXG8mKlZMuCSMhc0Aq2lM9lw&oe=6A999327"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dtC197hC6V4Q7kNvwEbyAuH&_nc_oc=Adq23tW3TG66PgnxKqBuQv0noDlVBeYMjbx0Tze7uixpO7EbCrAHx6Pi66iLPWkslDU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwqi0LqPZlzHlm-W0veuOsmg49uA_tHc7Tgl5HZZCdVg&oe=6A998653"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBifBgGltJkQ7kNvwGdzJ5P&_nc_oc=AdpIfe-xvgJq5rH6ntdvhPwlaGP_JCe1snMD577qH0qXAO-0sU7QiwLKrS9JNUVOv_0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBUhPE3yy2uXIcpHCRK33MumyyYJkYBd58p2xr9Rdg7w&oe=6A998377"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
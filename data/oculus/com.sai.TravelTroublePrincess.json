2753434939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFl5PrT_NHsQ7kNvwEPVA99&_nc_oc=AdqCNyXtVsLkotpGPAWcpf8ceLcw4I_1VtilB9y3KHSSYMVf4reag4flsXtyng_Clok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwn8l4VV4MzxnJi9soK8xp8lrWMxaWeW7DIx_dVJXEevQ&oe=69CD154A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxqmQlxNogMQ7kNvwGV2hht&_nc_oc=Adov1DsXjkIfanIp8OGcFsxmSPy5HMqqZ3VuRVeJ5TgXvAmXISUuUazcoTbrTot385I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8HuHxIzUWbmAKfsZMxXLnKvjjPhVMrfR8N5tBFJgALw&oe=69CD2209"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAl3QGPxQ9UQ7kNvwEI_K2E&_nc_oc=AdqYp79aOR1vzD9nf6n-bZL9Kk67WWSVE3JvmdJrnbeeLCgIh2V2MjeuUxGUS0N0TrQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwV1IX1uG4SG_xTWomO1n3NDkWS5R8kKIEku72bfSeTOg&oe=69CD0267"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My0IxWy8c9oQ7kNvwF0ttUp&_nc_oc=AdpZCw5JIbhCr77UmeYGMM_VWhdtAxUTVj9q-0gyjCmYP5WJqkDn8T4jaVsf4VXmMy0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtSvtS7ryU1qIhtb7vwsRdW3A3o-CoUyvs6cgXtqjdgw&oe=69CD2DD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoWP6sjjiRkQ7kNvwFnP2Yl&_nc_oc=AdqsSRJPSoD4cinXkVfr1JmI1JyhrOPOwzS35ZXCswwUo3UGveNSXaYPDdZ1Vd4qVAg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8wZEwus2XMKYV3wR9dl_9ATn01T1_GUuMBBuXqlI86Q&oe=69CD2AF7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
2753434939", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQrL6Mjt4b0Q7kNvwH9U9pd&_nc_oc=AdrMK8YsKcGLwdkQarels0o8kXy7zCsl_nCjtCcudwwpKCrnhcLAkemoJZP01ZzMHUM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uyCXTH4J4uu04GKBm5gz8mc3yas67XNEUPArZ3N03Mg&oe=6A05C5CA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmaZuzSlgi0Q7kNvwHlAqj7&_nc_oc=AdpMF3K0JUcSTbVmICFH2W8DobcIfKJWcudzttI55x9AhgACvrjrbLtA9qtEcor0qT8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dg2sH_5phnVGAIS0ldNt73cwHadhKqHVK_0hGrathMA&oe=6A05D289"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sSHW-P6BA9cQ7kNvwHg8Z7T&_nc_oc=AdqqBWR75lgtg01IfJOLjaVrcjs_8VZCm_p0aHqb7cKNSBZ0fd7Kh3xGZeNTFcpaQWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FMdEPN9MNHif2zX8_44oBgn1ifDfSgD5qqlQa4IerhQ&oe=6A05EB27"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m5GZxRymP5YQ7kNvwEIvQSF&_nc_oc=Adr56Xunc15RBEgTzyxpD1eTUjklxxhSU20nbm3uumgwnxVL_A-SWQv5Y4zH8T5Q8Lo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_Aw-SkwAjKdIp459M5ZYF_osUndP4bdoQyqdFli2pjA&oe=6A05DE53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fac8yAhw0kAQ7kNvwG-w2Lc&_nc_oc=Adrsoo_Oo7VWzA0HLtGoeFdENiSPyYyrTVF-1k-hYMUQoAg8z7NkLjf4A_yDeBAF78E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BDjz2ga0buLdbOaOGDw6O5IRBQRHjkRLhPkGZ4Ofu_Q&oe=6A05DB77"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
2753434939", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK0EVYcaMwUQ7kNvwFbLLSj&_nc_oc=AdrZfQXHfGEjrANyFiasEU0VW37WXJqA9L32l87OHY5rLwrK_blqyejNfSrnsElz--Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JLzpeRgXuATenNIkUCfQztmzwqeY2gc48v-CsXIcr8w&oe=6A2FF5CA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO8OoCamCfcQ7kNvwHBGJJ3&_nc_oc=AdrbvpQdsPq76X7kmkSvTvZc3bQaj143s177PKRR8xHHO7c3D--ofZJiLSg2COWz3Dg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-whu-RUaiwZEtPvWeWHgpIuAo51hdYEwrUT6QtuyGcEw&oe=6A300289"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hpk1G4dAw5wQ7kNvwHC3UPa&_nc_oc=AdpFICIZB4RZ6VhpXNwppI_LOoWKEtG_u8_rUKcQR3bcGmLH3e66o5UbTq3VgDuqClI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5wMYEVY50EwpBbIiDo5-IgLKiSMht_mMqrZWVforbSQ&oe=6A301B27"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hijobZXWpTMQ7kNvwFM1vy4&_nc_oc=AdrbUPthVqhA5KniL3Jl86fQ6NW1hrCOCOGyFKiznOLchmDuZa1HNnOD3ENzocSPWJA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5AU3QPryAB4kNHy5-ddXvyAl33IF-1V1mItEQsva2WQ&oe=6A300E53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wW_4HA2D3gMQ7kNvwHZLTe9&_nc_oc=Adqa8lpADD-6Y45KgU_VLfAvG2rguU8cTH7TicvFVEdYqMqjWhSkSoaw0TIJHrCPNVU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ku0PGJKYwBY0eGQdPSDomGOpmRRqqhohDHCgPhyFNbA&oe=6A300B77"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
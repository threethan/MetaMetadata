2753434939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iucg6DpkfVoQ7kNvwGE9jaP&_nc_oc=Adp3ZPBdlfgPy6-6L8Q55DnfYqkmN94js3rSDzqyZ4cgJvM_64qtBG95nuYKPb3BVzQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LpY_xSYfdv7JHE8E4era73MJ9eR6C44bJQHNHg9bcNA&oe=6A198C4A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCON62QczWcQ7kNvwEtlEPN&_nc_oc=AdryVzYVoE5ynJQmUOZHBj9qDsVe1AgSCP4UXgEqCTerlBFrzwX-kRhPXa4GonccI5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5l8BknjXr6pPJc2_SINVBHBBzc3pA4kz39--6PdgAXdA&oe=6A199909"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KVXXuXFHFuQQ7kNvwH0l7JW&_nc_oc=Adp87BlZq5kRT_uo4nkL33FMEP1DGKZesTwfgBPk9osi8birxqNvEqkHai3_bdlhVKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4V8Xp5tsq1m1kkFcgLzk7lU3KzdIotX7jGTTzhc_F1yg&oe=6A19B1A7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R73GCxr7aIwQ7kNvwE0Zes_&_nc_oc=AdodeyxqPYmVbjgCzSEueF9kEiGsGbR3fp8VDKuYl7h-Qu1IXH5q07XEcW1EXocObbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w8rPt9EJN9MH16Tjz5Cx4ravIQFRWkPKWQzoPE8MAvQ&oe=6A19A4D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0rAmbg-rBZoQ7kNvwHTFT2Y&_nc_oc=AdqMoTA5JBO2yBs3MbBNbrGy69Sbr0KhR_njrjnWXgxr0XuptdqDjLhvIISnYDSwacY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5J8tYHjxJUZMRj92upIDe3kAi9fsCoadIWoI1aHCvGwA&oe=6A19A1F7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
2753434939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2poIjnz2jeUQ7kNvwHFI1jD&_nc_oc=AdqV6nfjt11C125oJhq8S8CiRRpj0HIIhv-iZ1dkg9P-GSTJleJV5_IfNJkzMun7wO0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af692hC2fhoYZ-jFtdwdN5nUiuCr9gYAge8PvbsZ9dISYg&oe=6A14464A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trRbq-kGSjwQ7kNvwHchC2p&_nc_oc=AdpQKcs8tc3tYxuaVH_F0zpXfsN8RLx9hbmwYilttIaIAQqSxARGNDaPAiecsuZVMkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48zCfMDm7YgCULW5CMk0KNdsMxTuyP6ZYwQmnTUuaXcw&oe=6A145309"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoXjo0GILTkQ7kNvwGua1zh&_nc_oc=AdrLUf8m-eMijc7KoKbM0WsOUAgh9fjizYJNJOqLCpDDkyQ1RarNX02bXVPP6GOkuW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vzkuMYfSbTpENYmMDfCVSCG1ZDyY9fReNLZOw8CBpzA&oe=6A146BA7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrFSxDvMrM0Q7kNvwHCiy-c&_nc_oc=AdrUhn8jI_dDEUmzNySZ_KN6b0f59tzCLF4cFSVzjyWfvSPM3keTji7ENYnhzyklmEM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eJ8MSYAxfT5xp9EM6KqozYxDs041ENFu3bDUp13nX6Q&oe=6A145ED3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evkbFaD04_sQ7kNvwHO_UEx&_nc_oc=AdrnD8ztpDquwdpjbmk10hdBcqKFsvKZprFKQHP8HdHYJaLXue083sRz3Nzcaj63PtY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eMEUff5vqJspWDgnNARrPew3nimiS54EQvqXA4N0DBA&oe=6A145BF7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
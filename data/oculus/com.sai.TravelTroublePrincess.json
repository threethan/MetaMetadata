2753434939", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eD3rjeByZG8Q7kNvwFlDRNJ&_nc_oc=AdpP18dp2m_aZYH36J2XSnjoAG5z-skfRRtZ27jibB60mfOB_6g64DnzLDwAU3ZDBNQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykDnQqmnBG_XJltjugQjyK-wYxREY2YcaHGKUMELnm0Q&oe=69C2894A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgZzttv33_AQ7kNvwGTLZod&_nc_oc=AdricXlyvOSVNcjCYma1LGaL9cw91NL83FRvBr712ScsYyFKT7dhB0QBAZju60nWqN0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUI6AjFwejElLECFXFgafTmC80aApSqodV6-8JKJ5A9w&oe=69C29609"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqRYOshTJOIQ7kNvwEysm--&_nc_oc=Adrf2s8AKuawr2oggX68jgZOK6ilVhq0_jrFunXTPDyi-5di-yY9gSbABjKkhyllvYM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzU6ENc1FHN-7STEXk9hNXbDQYLKY-PVG8fi0z369JB2g&oe=69C27667"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLFHHVm6r8sQ7kNvwFes5Tq&_nc_oc=Ado41i2_JWHyYNunDoDIGrM-3waMjmvWD13cPrNOIcaWcuR1wZKKHgaWpmEt_hgHaNk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRxhVvf7l4b6BvQR4V8EqoLcgVNg1Q88c9rWSQ8fTauQ&oe=69C2A1D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q967fAt45qgQ7kNvwFgPOKh&_nc_oc=AdoT5yg4f1TZg6Zn8oD9mF-r1FvwzBpVk4SiP73rTWuSGFFdUnif1_xcxujo9yV2-ng&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw01dlWeEiGp1a039JsXNA5kR-Rm7PRR0fqPYnClRUlog&oe=69C29EF7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
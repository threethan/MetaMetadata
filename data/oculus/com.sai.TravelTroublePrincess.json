2753434939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjdlB1nYZwkQ7kNvwHuf2rJ&_nc_oc=Ado5AwhTSbM_TtIJ6HlAYqydlF_dwwqX9mIJbGxWf0NWDI_Ng10ZDh-9dEUGiGr6yOI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uxG5_BKdlZdMd_6RWqsGREP_mtBaYbr4vNkVN2dGWkg&oe=6A1D80CA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akqWZ-5hbHMQ7kNvwH3Rbyv&_nc_oc=Adrd_J0IsJSsmQR5d0vxEe-WG91z8mBpDZRS4ty697NdF35MaKrIWTu2lkCWgMvWzes&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71RR8XuCX5tSY5UqZO0uL_3KoiU8hntFPCUpqzM52_4w&oe=6A1D8D89"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOfE2zj59lsQ7kNvwHXw0KM&_nc_oc=Ado7BAxHQmjwGTY_fwO5kZ6PJNEGF5UUOSsGCzdeQqgjegswIKsY9rn3Y-X6s291JLw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ytaD91SrEaDbIc6iSX4vVbQ1ZGorSle_5E7mgP0-3jg&oe=6A1DA627"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mkoqNL4UckQ7kNvwEvSaoX&_nc_oc=Adq196kpqPAcIaCS94_PIZvLmFTQYA0aE8af3cA6OR7HvcAcPaWNeF8kLVo2Vuy4k-g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BTnjHnCEkOKItnjCD64DbAA1Q052FaCzjgkRGATj_-Q&oe=6A1D9953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7w7nnvrt3wQ7kNvwFlIVgv&_nc_oc=AdpZ9cixYL2RJeWPj8Q40xQ-c6coZTUnDJWpMdqm9KPUcYiMLa9hrirg38ZoK4b8xhY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tJ6d_yMMGq1lKi-Sb-vrROLRvMTUh2BZoqocHIeDjIQ&oe=6A1D9677"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
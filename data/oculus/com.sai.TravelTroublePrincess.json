2753434939", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RTampjzlvfkQ7kNvwGwYrKT&_nc_oc=Adq_Ud0rWM7ViqCPK8AAn23uXND_c9sA0vUC6p1n5qYJ-BlMydTQr0Np6StaM87X7VU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzFiHNQPlG_K8L0Ph_Qw0KdmcRrj3MzcLd_QCXSdnWEA&oe=6AE341CA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md2-wIJxgEkQ7kNvwFIqOQA&_nc_oc=Adrme8XPLrdcB-sy93Z8DzXXFtuIbOhGUwagsJrmcLgLQzFz_qwN2gNuhCx15HNMvDU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgg9v4MQWO3vVBJoJF7eun-FCGLBYLigaFqvpI0tlB_g&oe=6AE34E89"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uu4mwlkfnkwQ7kNvwEsuVf8&_nc_oc=AdpTNCI9OlKDe8TPeBP9JuHD4Om5W_ZUORiTehVXXb0l9e8r--JXms1cJ0StUJKRoCA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMb7r360ZhVDxQIY31I8wPNoPfY8bI9ermRTr-fTVGrzw&oe=6AE36727"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxS08b6ZFL8Q7kNvwFUL9ee&_nc_oc=AdppyMHmWRLlOe5EsREZizUpcWbvrg3LvplSqAr8_3lQ1VFa8VxHV--539vRZ6N00Cc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAJPYOB_R0iE4ASh0uQ79jzHFTIZgxyUGBHyPhsDLcuA&oe=6AE35A53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7cqrtdCFxcQ7kNvwGwoyyU&_nc_oc=AdrZoQiLRuyqEgmZrVsttqfI6RgcTyLvFDE2qGaiSmDdgT0E5TirFveSC-KLB6vue2k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaw7t7QzokZM1wKJaglbgHOSfgCOdRIzCIWyTL7Ych6w&oe=6AE35777"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
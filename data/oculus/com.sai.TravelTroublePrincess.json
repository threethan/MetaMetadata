2753434939", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skQYeUWtP9oQ7kNvwFPgaoO&_nc_oc=AdqO8wgdFO7R8Gft7poccVQObpG97dfJCHZW9_CVQ1Naaw7izY6iKGCbDpz5KT2J0kc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oi1ohBWS-OeFhoMkpRWpqXb3EAJ8Na6SjpeDPxogVhA&oe=6A01D14A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAU-3YRZadEQ7kNvwGA_LMJ&_nc_oc=AdqHL2kGM8HCcY0waobZAGt_9ivCDTWeasIyQ59WvnDoYJIvdn9SDa4J8_BHcXpjW8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60jQzOGWKwMmJCh6nSeR0-I-6Q3sONSm_X6UThfoWPIA&oe=6A01DE09"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfuuZ7sCl1kQ7kNvwGk94fc&_nc_oc=AdrY3AdALP8bggMPToBAk0LSwMeMg7ZK0Vd6E6SvomdXqLDOZC78PQhgw1GXIqQ3v58&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sYArKufUi-DLLGc3L9cNdboWDFhpOB0TKDU3Q4Ej5Ww&oe=6A01F6A7"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRa7BcXURt4Q7kNvwHkT70y&_nc_oc=AdryZslRFMclCIP0dNuM7gbgm6XVN6jF_0NrJRi5pfoqVh_Cj4nOFkBX7VRCS8pdW4Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ijk9xhB0DsWnWxZIuiwPb5Qs7OqE7GNA3CdNWAFeCDg&oe=6A01E9D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VwDlqKK8WQQ7kNvwGv-WYY&_nc_oc=Adp2_4OgVuB9HIVcDjXMF8z-sp8g7d-mAIjfo79pBwNI56BingWCL2txoK8t2kN_jCU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r-SP54jOXYqff8Ey7FkaFiBa-072vWy42wHofPxDaxQ&oe=6A01E6F7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
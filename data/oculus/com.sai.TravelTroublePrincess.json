2753434939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nae610MHUqAQ7kNvwG1Evmc&_nc_oc=AdqtanbvoVR8jQBBHDCnqxNFV1TKncBWnyMbX3iOvQV4CqyaA_XUTf5S6_qp6RTkZMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK0gJYNTJVEXcPmWJdaJrApFEQyFqRr0oOHvK1v2U8vQ&oe=6AF8920A"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7wmAatF43UQ7kNvwE5xctc&_nc_oc=AdrC5pqYFo7znAzJC9-IM0YVd7uHrxu41CsDDisaK9RBaq0N-vsdoRUz1cAHq77-DWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIwzEhhn6FOvMGXjYi1zBmgvmSYRKTJZOJOjwnro3Wmg&oe=6AF89EC9"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJDXzOJ2KTkQ7kNvwH7CA6D&_nc_oc=AdosM4rNPuwbRb05hUhXRQ5yG2v1_PDAZGEvOKK89Z7MdXnZG1_GvILcGKQC1fpnkp8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAge-_uiLjHKy0zt1LZhbx6uDzGYve_oB4KgRvZRQfBg&oe=6AF87F27"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LDgOIRMZm-0Q7kNvwEB5b_d&_nc_oc=AdoxIvqfexA26E0jx8_wzaKjRtbAROUD9xdx0m0bKlcUAMdmZsuodvvXuecacHyZBRQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReVCmfSZClbiC8vFFQek6LBu37OpreVYPxd2UfrZDjQA&oe=6AF8AA93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUp2kHhHNngQ7kNvwGISfT3&_nc_oc=Ado11Slxa4qwCNCcpNCUIXAgPk9jBaGbz-lmOZGgFI5UYgkh6sco9n1xvyvUI64NtiM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrd0-jmjdpeta6H-LbpeR-6lgUfpHht60OA-zFjDCEgw&oe=6AF8A7B7"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
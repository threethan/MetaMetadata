2753434939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlzUA8v84SUQ7kNvwGr_lyo&_nc_oc=AdpBMJP-hFglAV3l2-tLXT_l8oRYEkQJCVHQ-Hq_QtVtjAGTBDU-S6Z9gkVdn0LRFKQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8H0Tf85lnN2oSgXqXBwB-2KAJVAd7dR_ilZ2TiLmdUw&oe=6A523CCA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpLPXtN9LSEQ7kNvwFEZcz2&_nc_oc=AdqAUXW_Z6mIHJAtcb1WCz2K7YBtF-YwoDI4H9gCBeKTerJpJFDOV-IpsbTK5dMu-_8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALoguanAlIrXK6mjFbX6zkpX_a4TGFY3-RUwSIpb-Lzw&oe=6A524989"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZzueLbvyjMQ7kNvwFhLdvW&_nc_oc=AdqHT4J2YvchHaIw00MF4a-jIyrvNzuCC974_putijrYPCTr47wQAik7ZUK0TznuYxs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcs3maL16rQJKS97Z49knCVZrUm5dWh0PrlCOMnDVqCA&oe=6A526227"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbicwoDxzGIQ7kNvwH1JPDG&_nc_oc=Adq1vl51hriEa7fq0W4c6Lep6NoB4TwkXZg9FelPnPySaRQyCxwEPPmOrdcVxDMpC6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHH7-2lSqX14ZxLekA26exohqY3T7VRaLwH3BkmF37dQ&oe=6A525553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ic5wP0U5VWsQ7kNvwEwbCa_&_nc_oc=AdpQsfGRWStzIwl6O13D2i-60fnwq5JE_aye26V7ee2zxDEwOFwlQyRrivXQ6Z6FQWI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRr2q4LcL-ALkyAYHYOv4EXtFEilfe7nszSeS7eYOhcw&oe=6A525277"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
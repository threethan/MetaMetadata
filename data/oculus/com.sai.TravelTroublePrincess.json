2753434939", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXtxF0uwFgIQ7kNvwEK177Z&_nc_oc=AdqGH78TG4YgpDZDrpaZ0vW38H4rFvoNIOpvRsVPK06YYIySyRnOb47TOou8rigC62E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0mZeXnJCjpbvkuieJnE4kHgalTmOJPZ_ced1B2rom8Q&oe=6AA69CCA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWqbs4Pi-ZwQ7kNvwHONPpB&_nc_oc=AdqOts8_W93Cpst8RHDP-sNCaTw8j3tRQZawHG-9ISGULe-AJfdJkKbQVXzdmNbyG08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpEotUAXGlGLf9X4u10vL9Evq1jZvgdtO3_kD9VLFFSg&oe=6AA6A989"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5jHoiBFTGQQ7kNvwFld_Ek&_nc_oc=AdoDm3Fkmm-PZawEVRC2M7kk_udFG_rap2QWKhJIfWFB1PRQgDWPuZXt9_iJv_lES38&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS-8xmjGCMDhcJcJ7OuTP5PUR91ScUHOC-czJ58-7DVA&oe=6AA6C227"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKZkYIGFYmoQ7kNvwH5cP18&_nc_oc=AdqNL1Yn_UYslCDEe7e82harSVpsPK-fz_Uq2AcW0G8W8107-UsFd9cdiWYfXSD3yvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLHT-RJ0CQJsmcumqlZoFmG6Bij-3FetFuQpWVdafiLQ&oe=6AA6B553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kk0OMxn5mQMQ7kNvwEDV2CD&_nc_oc=AdpiuR11vUBbHcH8QW6Jbh7NA2mJYo6p21xqjaBd4_voVdYeXzcP9zGqpvIxlsYhdWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmcQXH8DrFyJI4PbM-S7O7WB3RBt-_oYv2IzGqSGE0Mg&oe=6AA6B277"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
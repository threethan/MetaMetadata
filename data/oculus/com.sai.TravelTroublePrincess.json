2753434939", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982699_744752760101605_8183637241378254538_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ra2Z0DvMxzQQ7kNvwGFj9M_&_nc_oc=AdrWrtWfx7aKJ8OVnmsqShxGf2pmztYcYU7Pb-s2LvWnlqkTYJuusDCj-l8LPg1VeqQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3w8ZEKaHhcnvgRE0sgw1A-fHNZ9xZZgB6DPkSqfZ0OVQ&oe=69F350CA"}, {"file_name": "SC3.png", "id": "745857529997529", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974580_745857533330862_7444325023929698899_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qs1a2S55g_4Q7kNvwG_CZa8&_nc_oc=AdpkEocU1cJGLdX-PGAgiI0xWVk4I6QVXqzU02uW6HZ7mEtPPjbtVbQM6TjORym6Ips&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nmU-XNrt8g5lyfluQ9AzL2TbGy3SH8KO3z3v-Hgv3eQ&oe=69F35D89"}, {"file_name": "SC4.png", "id": "3324288601139765", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974714_3324288604473098_3091196282987557911_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QioCf9lzvwgQ7kNvwGU-NQd&_nc_oc=AdpVrg4NsxVVvObuATi2e0UqC4C89Zfxy7axxJT4ipQ11wdJMTl50vYpEr36fl7y9QI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3OcwyQVZAOQi65LzhK5NcHUPuLpd1XphohDMDtr5CEig&oe=69F37627"}, {"file_name": "SC5.png", "id": "1784506765249116", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974694_1784506768582449_6895755964083707435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPhPhDZI2XwQ7kNvwHhoj-W&_nc_oc=AdoT-d2BWRqMiK6QflSTQFiUkbziZWuEBZKP82765Z3zSukp0KwlotKRI8TTzJ_vlso&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1pneG2exhG2CwSPs85hVDNW26ggXQ2hxUGIQdm6noEuQ&oe=69F36953"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "samune.png", "id": "5379994402061102", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974694_5379994405394435_5538481077284453792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hjy8cRLURT4Q7kNvwEOfJGE&_nc_oc=AdqamACS0zslp9XVVnOF-CAflUE2qDvhIyLR59d-OXTtT-intYiByEKgyBv0lheflBI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0410wYvr4YkJtEVG5m_zjebPy89AlyvS90mR2pDKdNiQ&oe=69F36677"}, "display_name": "Travel Trouble Princess", "keywords": [], "long_description": "\n-------------------------------------------------\nOperation Description\n\nA Button :\nAsk your princess to jump.\n\nSword in the right hand :\nSwinging a sword against a monster to reduce the monster's HP.\n\n\nLeft-hand umbrella :\n\nBy covering the princess with the shadow of the umbrella\nthe princess's health will not be depleted.\n\n-----------------------------------------------------------------------\nStory\n\nOnce upon a time,\nthere was a kind-hearted princess.\nShe was heartbroken by the world's ongoing war with monsters.\n\nOne day, she decides to go to the temple of the God of Creation\nat the end of the world to pray for peace.\n\nYou are the knight who protects her.\nUse your sword to drive away monsters along the way, and\nUse your umbrella to provide her with shade.", "short_description": "Wield your sword.\nand guide the princess on her journey!\n\nWith the sword in her right hand, she drives away her enemies, and\nThe left-hand umbrella provides shade and keeps the princess from losing energy.\nA new type of VR run game is now available!\n\nWhether or not the princess can make it safely through her journey is\ndepends on your two hands!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://saivrgames.blogspot.com/2022/07/travel-trouble-princess.html", "developer_terms_of_service_url": null, "publisher_name": "MaSaitoh", "support_website_url": null, "website_url": "https://saivrgames.blogspot.com/2022/07/about-travel-trouble-princess.html", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "
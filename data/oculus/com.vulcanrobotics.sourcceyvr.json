CON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/748811223_1062116859858287_8796604904491799933_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AUBtv_dAOYQ7kNvwHScsBl&_nc_oc=Adoz4TDhWvRjIkHwtUTD-fUXoX9zWMmtDg7qsDt4Qm0z841rJfbXbrE98pl2B4x78fw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJ6RStn_EHImcsN9BI1hKMU7pLJkCbXRb67rgZer8ZPw&oe=6ABE620A"}]}, "id": "1818042816305383", "locale": "en_US", "screenshots": [{"file_name": "Sourccey_VR_Screenshot_5_2560x1440.png", "id": "1278939471970234", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312068_1278939475303567_450991542415941690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAl1chOIF-UQ7kNvwE3ncON&_nc_oc=Adp5ArAEvXKAw3wVwNXrSQUgSTTtpJz20SzlCjdPp7WhWEr9U2K2n4CkRODVLpvtGn4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYeLt_cvLeDvdJkYYnbz0dtFgVf3edo0gO-G_ScRjwYA&oe=6ABE83EE"}, {"file_name": "Sourccey_VR_Screenshot_3_2560x1440.png", "id": "1417733390235335", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604310912_1417733393568668_5613299126483926209_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BZAsEsBBOsQ7kNvwHN6FtU&_nc_oc=AdpYyBpzc3AGHAJhWNvXQ8rkCZhzhS4V8TBsL8vSAEUaDBFN9wgAxfScxsG3u_Qp9lA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_eLgaZa6yly70t6nRGVF1OnK6SNUGtMSub3ddcoikMA&oe=6ABE876E"}, {"file_name": "Sourccey_VR_Screenshot_2_2560x1440.png", "id": "1333425495530620", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830441_1333425498863953_7400023880548995726_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kdr9_87uwmYQ7kNvwEBMb2i&_nc_oc=AdoiqaxsW5Nu1H3ZTxiTxr3v-nUkPTiIDHzSOHtLJ6E-VZ9A7nFPoWcsPXUUh2sRnO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPHhg8rPyA7IyrMA0H8au-6lIXOxQMb86NUjW6ZOkTgw&oe=6ABE6E5D"}, {"file_name": "Sourccey_VR_Screenshot_1_2560x1440.png", "id": "1589129672880806", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604293968_1589129676214139_6055383436996885181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1RqqK4sBRkQ7kNvwGRB9aj&_nc_oc=Adr98Z5gQh4fuMn5IPRDZRn1aFCJBlVXvaHdAFnbe2rWKsNwK2eO8-HJG_bXR1ttuGY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6jwiIpMKpaFPoL89prv44D0dPN81aoMReUzDw5XB1eQ&oe=6ABE6A3B"}, {"file_name": "Sourccey_VR_Screenshot_4_2560x1440.png", "id": "1587125576186422", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595119480_1587125582853088_407861568217301854_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkLH3nWC-f8Q7kNvwFU9v6v&_nc_oc=Adr0JXxVcf9Wx27luL5pySwPVkqGVJkHM53wQ4ecfp2AoBC3WAv_T3zInJJHDVWfbTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvqWxwTjzTYVsimvmXVvPvjeZitAK20EvjiudI3eYAwA&oe=6ABE8AB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sourccey VR", "keywords": [], "long_description": "Sourccey VR puts a pair of robot arms in your hands.\n\nSIMULATE - NO HARDWARE NEEDED\nThe app launches straight into simulation mode: two virtual robot arms driven by\nreal inverse kinematics. Move your hands and the arms follow - reach, pose, and\nwork the grippers with full six-degree-of-freedom tracking. Practice\nteleoperation technique with nothing but the headset.\n\nGO LIVE ON REAL HARDWARE\nOwn a Sourccey robot? Enter its address, press Connect, and the same controls\ndrive the physical arms in real time over your local network. Live hardware\ncontrol requires a Sourccey robot system; everything else works without one.\n\nBUILT FOR OPERATORS\n- Passthrough keeps your real surroundings - and your robot - in view\n- Per-arm calibration aligns the virtual arms with measured hardware\n- Both arms are independent, so either can be operated one-handed\n- Arms freeze automatically on connection changes, on losing focus, and when\n  the headset comes off; you resume deliberately\n\nAll communication stays on your own local network.\n\nSourccey VR is developed by Vulcan Robotics.", "short_description": "Robot arm simulator and live teleoperation for the Vulcan Robotics Sourccey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vulcanrobotics.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "VulcanRobotics", "support_website_url": null, "website_url": "https://vulcanrobotics.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1382855714900703"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595119480_29029416149979504_992573281616296402_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs2la1nYRKIQ7kNvwEwyqhr&_nc_oc=AdpZsdrHr0-jzP02LAAjo-g8ZmPupxi4ACcXyq5hWAVWtY2IjRYBMxiUNB-hgl1ys0A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1gXnsX1h96KqgLOBr_43tpDBu-DU9tLOBxsHMV4fZFA&oe=6ABE88BB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sourccey VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1790093940, "lastRevision": {"nodes": [{"id": "1371627766023498", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "13
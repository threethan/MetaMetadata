CON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/748811223_1062116859858287_8796604904491799933_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwfQ_aNAsu4Q7kNvwF8y8H1&_nc_oc=AdqieLa8bx3h_lkQvEke_xVks8Z0oU3clhmJjA74lL65fG7BvQ28QJCmr-j4P8GvwYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2XVFxLhlx_ManeeQxm9nN-l3JfiMgkdQ5PeR3Bmo_5g&oe=6ACE340A"}]}, "id": "1818042816305383", "locale": "en_US", "screenshots": [{"file_name": "Sourccey_VR_Screenshot_5_2560x1440.png", "id": "1278939471970234", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312068_1278939475303567_450991542415941690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHhdJdk1Bs4Q7kNvwHLPiAL&_nc_oc=AdoZIiFUopjta1DkWGOuTMYBRRWAmldBvCj_fcVGqzDfr1Wesj1a5xgLWczBgqVkcds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJj8GftuPfBa438lPTy0GiiBpbbjBqs8GQKoh1Y8iSaA&oe=6ACE55EE"}, {"file_name": "Sourccey_VR_Screenshot_3_2560x1440.png", "id": "1417733390235335", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604310912_1417733393568668_5613299126483926209_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZWe0OqOmnwQ7kNvwHjFx0s&_nc_oc=AdqrKH2Lal_tWNBaudDz_c3lHl51yPr-GgZG_mNbSeVZSB78Tw1G9_0_dikThOEeRM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIVAPhgxC7wixcIKiLQYFW3R-_MkQeJKZmUD-uYTinQQ&oe=6ACE596E"}, {"file_name": "Sourccey_VR_Screenshot_2_2560x1440.png", "id": "1333425495530620", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1333425498863953_7400023880548995726_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_5-fqlDfgYQ7kNvwFfbxiA&_nc_oc=AdrhtB5wx7Y9lSfscueVgTg09fTfsneflpn2aeKixmJ59d5S8dsITnuIlMRWh1tGPcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYn4qRJ_xnanb0nlgAyx5B4W3t_LYpPc-s8tPIxRcZZw&oe=6ACE405D"}, {"file_name": "Sourccey_VR_Screenshot_1_2560x1440.png", "id": "1589129672880806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604293968_1589129676214139_6055383436996885181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmvVNm_oRt4Q7kNvwEcCqqg&_nc_oc=Adp8LNUHoGm9OAbDTOY5tVBidY8jOw6iwne7DuyRIdAAgzkj46_xVAkwkbWBUFq9XkM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxuhz8FmkEvNfQu78x4lwAW00rUgUoli-iXi7cjc9lug&oe=6ACE3C3B"}, {"file_name": "Sourccey_VR_Screenshot_4_2560x1440.png", "id": "1587125576186422", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_1587125582853088_407861568217301854_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3D-LSI8EoYQ7kNvwHLjv7O&_nc_oc=Ado94KOGxEQGIIkYjpx_qDfGTUEhAy1eTFkl0AzyW0aNOC_gRsI0AmkiYNNkBBsLZ_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ6LwtzhPKRxwgbYTKTpD1tIPPkwUFi5gBC1_T5aPChw&oe=6ACE5CB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sourccey VR", "keywords": [], "long_description": "Sourccey VR puts a pair of robot arms in your hands.\n\nSIMULATE - NO HARDWARE NEEDED\nThe app launches straight into simulation mode: two virtual robot arms driven by\nreal inverse kinematics. Move your hands and the arms follow - reach, pose, and\nwork the grippers with full six-degree-of-freedom tracking. Practice\nteleoperation technique with nothing but the headset.\n\nGO LIVE ON REAL HARDWARE\nOwn a Sourccey robot? Enter its address, press Connect, and the same controls\ndrive the physical arms in real time over your local network. Live hardware\ncontrol requires a Sourccey robot system; everything else works without one.\n\nBUILT FOR OPERATORS\n- Passthrough keeps your real surroundings - and your robot - in view\n- Per-arm calibration aligns the virtual arms with measured hardware\n- Both arms are independent, so either can be operated one-handed\n- Arms freeze automatically on connection changes, on losing focus, and when\n  the headset comes off; you resume deliberately\n\nAll communication stays on your own local network.\n\nSourccey VR is developed by Vulcan Robotics.", "short_description": "Robot arm simulator and live teleoperation for the Vulcan Robotics Sourccey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vulcanrobotics.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "VulcanRobotics", "support_website_url": null, "website_url": "https://vulcanrobotics.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1382855714900703"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_29029416149979504_992573281616296402_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIUoHxXPBq0Q7kNvwHGaHIt&_nc_oc=Ado25fFOZ-v2LXh3Q6BCd5XfCGATUqGoTz49UNB-e4sCGx8SUhA9b8m6OAFb9jwnJuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwIkYIvagwY8ZKo3RbSNmRYs_CGmMETS0mHktQoqIuYg&oe=6ACE5ABB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sourccey VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1790093940, "lastRevision": {"nodes": [{"id": "1371627766023498", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "13
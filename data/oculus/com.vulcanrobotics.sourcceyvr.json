CON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/748811223_1062116859858287_8796604904491799933_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tw97k1Ic5xEQ7kNvwF6ZcFq&_nc_oc=AdpVsZI0E8VjXYOJEuKDhal-y_vs5A53GX3YpCwxPvQkhk3mVZqIu5TXLK2P3LAQBbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPizXlYViHWsjgQWyA9Ba67ktLy875nZvZc50vYZu5cSA&oe=6AE5EF0A"}]}, "id": "1818042816305383", "locale": "en_US", "screenshots": [{"file_name": "Sourccey_VR_Screenshot_5_2560x1440.png", "id": "1278939471970234", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312068_1278939475303567_450991542415941690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUQL869jfPAQ7kNvwF1yNlJ&_nc_oc=AdryCCZ-gTVgvvE4tUPF42l_FBcIWbY78JRxpGYLvYLGhPiF4YCWmWpeb2eSF4BDGIc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzICroc9nWC9CQX7rpaylbM050y6J7j90LjOSWtuTs2Q&oe=6AE610EE"}, {"file_name": "Sourccey_VR_Screenshot_3_2560x1440.png", "id": "1417733390235335", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604310912_1417733393568668_5613299126483926209_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIX_RSkcZgoQ7kNvwFxFCrC&_nc_oc=Ado8it8cRL3lDROpMaQJz89W3rDCJ9tgcWzg7A7ycr17FDrNPHVg97FZ1gEIr9q6Ilk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZGpfsrZbbAic8V2_gAc1u63ZIm7bLXmmTJmkJLp4OEg&oe=6AE6146E"}, {"file_name": "Sourccey_VR_Screenshot_2_2560x1440.png", "id": "1333425495530620", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830441_1333425498863953_7400023880548995726_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjpbdbydrBMQ7kNvwF7a_8n&_nc_oc=Adp_3fne45p1m458oNwOYy_AJVgq9zdTW2rFoulL7lisfvUROt2x0vK3HHWGVfCowfY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPHlBrlehSM_XhUiCMMN6Oo35W3Im4lqugB4UYjXCKpA&oe=6AE5FB5D"}, {"file_name": "Sourccey_VR_Screenshot_1_2560x1440.png", "id": "1589129672880806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604293968_1589129676214139_6055383436996885181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Al8F7uFK5sEQ7kNvwFOv9tG&_nc_oc=AdqsxtP-oVGyX96MCCgA6t53SADtZekLAMOMYzDSlVcbln1sU81hHkwURwKkp3WL6uY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf2xmLGQ39mmwyS5b5g481dy7AA06606fiv3mSAq5jHg&oe=6AE5F73B"}, {"file_name": "Sourccey_VR_Screenshot_4_2560x1440.png", "id": "1587125576186422", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/595119480_1587125582853088_407861568217301854_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cruQbtziaA8Q7kNvwFN4M0g&_nc_oc=Ado9YdaLafKvd7XRs1HU7cknjoJdRrpP2iXFZ8jDhvjn0RUyw6V-T4hYxDiJ2vbZfSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv8ubOJ5sbsYtaVHjxD0g0n8VixG9gaeNHo1Py07j9pw&oe=6AE617B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sourccey VR", "keywords": [], "long_description": "Sourccey VR puts a pair of robot arms in your hands.\n\nSIMULATE - NO HARDWARE NEEDED\nThe app launches straight into simulation mode: two virtual robot arms driven by\nreal inverse kinematics. Move your hands and the arms follow - reach, pose, and\nwork the grippers with full six-degree-of-freedom tracking. Practice\nteleoperation technique with nothing but the headset.\n\nGO LIVE ON REAL HARDWARE\nOwn a Sourccey robot? Enter its address, press Connect, and the same controls\ndrive the physical arms in real time over your local network. Live hardware\ncontrol requires a Sourccey robot system; everything else works without one.\n\nBUILT FOR OPERATORS\n- Passthrough keeps your real surroundings - and your robot - in view\n- Per-arm calibration aligns the virtual arms with measured hardware\n- Both arms are independent, so either can be operated one-handed\n- Arms freeze automatically on connection changes, on losing focus, and when\n  the headset comes off; you resume deliberately\n\nAll communication stays on your own local network.\n\nSourccey VR is developed by Vulcan Robotics.", "short_description": "Robot arm simulator and live teleoperation for the Vulcan Robotics Sourccey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vulcanrobotics.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "VulcanRobotics", "support_website_url": null, "website_url": "https://vulcanrobotics.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1382855714900703"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_29029416149979504_992573281616296402_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StKyZlQyXhYQ7kNvwHK0ctJ&_nc_oc=AdqBgzUt9Rv28SKIrs7TM9uyuD3MsvB1zqGsjwBKF85v1YCcssOq49PGRh2W-B7cCgw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMoRq3eaTZ0RQdohjGkM7M19vkqbS1fqvfF0qEDVku1Q&oe=6AE615BB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sourccey VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1790093940, "lastRevision": {"nodes": [{"id": "1371627766023498", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "13
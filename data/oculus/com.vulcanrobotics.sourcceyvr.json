CON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/748811223_1062116859858287_8796604904491799933_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQnur38ckR0Q7kNvwHtA9XL&_nc_oc=AdptXlnon3gWhWLBp9BJyGWL1ZSef_JWm9AxWRvyug0qOUey0AIycbxZOyfVDhrjY3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOta_2Y_JYzxFugeT7SPPR713qFwBo5rdQZAw86eBrtJA&oe=6AC1050A"}]}, "id": "1818042816305383", "locale": "en_US", "screenshots": [{"file_name": "Sourccey_VR_Screenshot_5_2560x1440.png", "id": "1278939471970234", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312068_1278939475303567_450991542415941690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySr_vkyJXq8Q7kNvwGEinRy&_nc_oc=Ado1DVG4rQjTcdzw-IjlcoMCPYor4HHR37imk5kToB-IPSFXwPVkZn60kF6OhulB1Uw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKGZUTzZLDIpJayCH2Ppb-SvINY353CEJ1lNPq6yF5vA&oe=6AC126EE"}, {"file_name": "Sourccey_VR_Screenshot_3_2560x1440.png", "id": "1417733390235335", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604310912_1417733393568668_5613299126483926209_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5HkweJS8WkQ7kNvwH6WGYu&_nc_oc=Adqtfb8PvcYoA5Z4BSpucyw1BgBC1GJiN1tnppr_v7tCHH_4c-1rlrDcGNdYvd2Wte4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMlo_Llj-N9NRw610QnraIhzTFxQD0wkrza6DuRm62klA&oe=6AC12A6E"}, {"file_name": "Sourccey_VR_Screenshot_2_2560x1440.png", "id": "1333425495530620", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830441_1333425498863953_7400023880548995726_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQwUEYGYXBUQ7kNvwGAIVow&_nc_oc=AdrcVOViUNGKuvQeNGMNjqBxwv9C91WFgVY55lKSA_tnuqvOc5SRgsKPNBLq-st-aD4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNl3uhXLdcNy1Qkzl9c_0a12MHJai8dQn8VqgQHiV7cQ&oe=6AC1115D"}, {"file_name": "Sourccey_VR_Screenshot_1_2560x1440.png", "id": "1589129672880806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604293968_1589129676214139_6055383436996885181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uM3JSSobCjsQ7kNvwFsMuil&_nc_oc=AdoDTAcX9jnpjkYow31l0oPt3Wk2AcUpsxSUGZtHOtrBPOTfe2HSffEQUWQJKk6ZTs4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaEveGWXq6U3VO0e8CTQn18irr2kyrWXJF0hdN1xKwvw&oe=6AC10D3B"}, {"file_name": "Sourccey_VR_Screenshot_4_2560x1440.png", "id": "1587125576186422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1587125582853088_407861568217301854_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmJ4qnb3JRYQ7kNvwFWz-Lh&_nc_oc=Adqf9laZ9CGrGDnvqyH72xBH-sMWgbB0jm5SJ6SYSgGNiI_X2PrKOWCKL4_qA9f2QII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLreBJGoqRalOieYL9BfxVfu_SEN0KolENZvdOhykw0w&oe=6AC12DB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sourccey VR", "keywords": [], "long_description": "Sourccey VR puts a pair of robot arms in your hands.\n\nSIMULATE - NO HARDWARE NEEDED\nThe app launches straight into simulation mode: two virtual robot arms driven by\nreal inverse kinematics. Move your hands and the arms follow - reach, pose, and\nwork the grippers with full six-degree-of-freedom tracking. Practice\nteleoperation technique with nothing but the headset.\n\nGO LIVE ON REAL HARDWARE\nOwn a Sourccey robot? Enter its address, press Connect, and the same controls\ndrive the physical arms in real time over your local network. Live hardware\ncontrol requires a Sourccey robot system; everything else works without one.\n\nBUILT FOR OPERATORS\n- Passthrough keeps your real surroundings - and your robot - in view\n- Per-arm calibration aligns the virtual arms with measured hardware\n- Both arms are independent, so either can be operated one-handed\n- Arms freeze automatically on connection changes, on losing focus, and when\n  the headset comes off; you resume deliberately\n\nAll communication stays on your own local network.\n\nSourccey VR is developed by Vulcan Robotics.", "short_description": "Robot arm simulator and live teleoperation for the Vulcan Robotics Sourccey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vulcanrobotics.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "VulcanRobotics", "support_website_url": null, "website_url": "https://vulcanrobotics.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1382855714900703"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_29029416149979504_992573281616296402_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cs2la1nYRKIQ7kNvwGCwLjb&_nc_oc=Adqih_QTXuBYaRiQHcVONsDHQBLpVzd8fFuRNNadLV9vt614loNfbOBVSMEnNiOy4-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0Eb4JXux2lv-xEQrTgdE0XWoSnj7-uoGcstjiADDraQ&oe=6AC12BBB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sourccey VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1790093940, "lastRevision": {"nodes": [{"id": "1371627766023498", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "13
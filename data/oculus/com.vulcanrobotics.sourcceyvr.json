CON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/748811223_1062116859858287_8796604904491799933_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQnur38ckR0Q7kNvwH9BL3E&_nc_oc=AdqdsHjZAGVjcBaAebXxAFoDy3n1CfpHTRDw_6k0Vn7jQ2NkCb_fDQ9MkpzT2qhA1oY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMF8uV1nLnL5g1Pu9FBcDUV7GYSKj8jM3OBm__IH-dpzw&oe=6AC3A80A"}]}, "id": "1818042816305383", "locale": "en_US", "screenshots": [{"file_name": "Sourccey_VR_Screenshot_5_2560x1440.png", "id": "1278939471970234", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312068_1278939475303567_450991542415941690_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6-wTQHKexEQ7kNvwEtLkDE&_nc_oc=AdpjD_Bcowur5IL9Y_2zP94giR90p99qlqytTD2pS--8G91DOTMKG0MhjypmRroxqg0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDiJCLyJa5yDYq3mBJvPyEUEgzipABF9zyQ7HD5DXtrQ&oe=6AC3C9EE"}, {"file_name": "Sourccey_VR_Screenshot_3_2560x1440.png", "id": "1417733390235335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604310912_1417733393568668_5613299126483926209_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5HkweJS8WkQ7kNvwH40wn7&_nc_oc=AdqLlxxyNKtS6iN7xMtCqlKnBBSRJ7aGk9QmP2tT2ep5ZXnAQSs5PqLpMtVWnFukkso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQsuF6MDffjhYBTeOs5vDpbPNWLZ_GgM2ebNAhkQvvQg&oe=6AC3CD6E"}, {"file_name": "Sourccey_VR_Screenshot_2_2560x1440.png", "id": "1333425495530620", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830441_1333425498863953_7400023880548995726_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX_2120OyecQ7kNvwEon1yS&_nc_oc=Adqg4AlARtdaSRSeOqiSK71dzHMwZB3R502a5dP0meNbN9tK1w0DqAIIBCTWeQZAWgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCh8aGBZ-Fiy3hAzQNw_zGd6t6pi9t7J0Akgod253hKQ&oe=6AC3B45D"}, {"file_name": "Sourccey_VR_Screenshot_1_2560x1440.png", "id": "1589129672880806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/604293968_1589129676214139_6055383436996885181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRXzwyhvef4Q7kNvwE66nF2&_nc_oc=AdrwtKvYLkxwZjvTWHCnj94GLrIP1TiaiHgaNBnfoyuFNJRc8zQwPhotOfoMmxGJJgE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgKOZ6m-rzmvNja4CKKjhMTHfdU7OTeMmnwRwSOKaVmA&oe=6AC3B03B"}, {"file_name": "Sourccey_VR_Screenshot_4_2560x1440.png", "id": "1587125576186422", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595119480_1587125582853088_407861568217301854_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmJ4qnb3JRYQ7kNvwGX4f81&_nc_oc=AdrhVv7CUfKhACE46XRNtDKT2mzgXxE45g1HlV-iem7BSYX8luMXGzBkOnkziysfYd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwALw-ci9UhisBFOvpwlqTBGs1zAylTB9QAz8O7gjdBw&oe=6AC3D0B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sourccey VR", "keywords": [], "long_description": "Sourccey VR puts a pair of robot arms in your hands.\n\nSIMULATE - NO HARDWARE NEEDED\nThe app launches straight into simulation mode: two virtual robot arms driven by\nreal inverse kinematics. Move your hands and the arms follow - reach, pose, and\nwork the grippers with full six-degree-of-freedom tracking. Practice\nteleoperation technique with nothing but the headset.\n\nGO LIVE ON REAL HARDWARE\nOwn a Sourccey robot? Enter its address, press Connect, and the same controls\ndrive the physical arms in real time over your local network. Live hardware\ncontrol requires a Sourccey robot system; everything else works without one.\n\nBUILT FOR OPERATORS\n- Passthrough keeps your real surroundings - and your robot - in view\n- Per-arm calibration aligns the virtual arms with measured hardware\n- Both arms are independent, so either can be operated one-handed\n- Arms freeze automatically on connection changes, on losing focus, and when\n  the headset comes off; you resume deliberately\n\nAll communication stays on your own local network.\n\nSourccey VR is developed by Vulcan Robotics.", "short_description": "Robot arm simulator and live teleoperation for the Vulcan Robotics Sourccey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vulcanrobotics.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "VulcanRobotics", "support_website_url": null, "website_url": "https://vulcanrobotics.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1382855714900703"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595119480_29029416149979504_992573281616296402_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFxl2DRrIQ0Q7kNvwEHAz3X&_nc_oc=AdorEdnWxVaH72qausEW8zvUUDwmwxcN4G0jl-MUfA-oVAP1-uuWNNGS5Yy5D3pKds0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-yd0kWliXggDCY7urKx5PwOgOj2e_KSvZ5xG5kLAlVA&oe=6AC3CEBB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sourccey VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1790093940, "lastRevision": {"nodes": [{"id": "1371627766023498", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "13
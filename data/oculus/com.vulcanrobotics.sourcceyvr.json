6y_tfdFgEnbig9vRUhfU0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdPZw_FmZ9e_dKmPXG8b4bXksaj9WCRy7pjTXNMQsfoA&oe=6AD3865D"}, {"file_name": "Sourccey_VR_Screenshot_1_2560x1440.png", "id": "1589129672880806", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/604293968_1589129676214139_6055383436996885181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LgGoPntsYE8Q7kNvwGVfbtE&_nc_oc=AdoAbCI0nVn66ua2uloS6oJm3Soy0JVLwGyGnX4pTe6o3s3T_3ffGArEDkgW-XgoJNs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKSHPMB0qerqQnErhmoisW1LHT1xaVNIu2Sc7HN_1I0Q&oe=6AD3BA7B"}, {"file_name": "Sourccey_VR_Screenshot_4_2560x1440.png", "id": "1587125576186422", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/595119480_1587125582853088_407861568217301854_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8Ao3HatBDwQ7kNvwERwwWL&_nc_oc=AdrGQnPo0mkjadRutYJTH-uSQBaY-l0BaunOp_2Gw42WkDa6JH4tl6dJkF8elEtKOq8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNH1pcDixuJC5xd2YOSH4lsFE7uJW0utQ-lge23fI0vog&oe=6AD3A2B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sourccey VR", "keywords": [], "long_description": "Sourccey VR puts a pair of robot arms in your hands.\n\nSIMULATE - NO HARDWARE NEEDED\nThe app launches straight into simulation mode: two virtual robot arms driven by\nreal inverse kinematics. Move your hands and the arms follow - reach, pose, and\nwork the grippers with full six-degree-of-freedom tracking. Practice\nteleoperation technique with nothing but the headset.\n\nGO LIVE ON REAL HARDWARE\nOwn a Sourccey robot? Enter its address, press Connect, and the same controls\ndrive the physical arms in real time over your local network. Live hardware\ncontrol requires a Sourccey robot system; everything else works without one.\n\nBUILT FOR OPERATORS\n- Passthrough keeps your real surroundings - and your robot - in view\n- Per-arm calibration aligns the virtual arms with measured hardware\n- Both arms are independent, so either can be operated one-handed\n- Arms freeze automatically on connection changes, on losing focus, and when\n  the headset comes off; you resume deliberately\n\nAll communication stays on your own local network.\n\nSourccey VR is developed by Vulcan Robotics.", "short_description": "Robot arm simulator and live teleoperation for the Vulcan Robotics Sourccey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vulcanrobotics.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "VulcanRobotics", "support_website_url": null, "website_url": "https://vulcanrobotics.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1382855714900703"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1601361544945968"}]}, "baseline_offer": {"id": "1601361544945968"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790093940, "status": "PUBLISHED", "id": "1601361544945968"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1440402095812731", "version": "0.2.0"}, "id": "1395437839387950", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {
Wp-xhYVdTaX-TDr3cBq3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPI6qTtiD-Ja_gm3_fvUKbcbfq7RRWQVnKPCMpuy2YHA&oe=6AC6575D"}, {"file_name": "Sourccey_VR_Screenshot_1_2560x1440.png", "id": "1589129672880806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604293968_1589129676214139_6055383436996885181_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRXzwyhvef4Q7kNvwFzTpdu&_nc_oc=Adq-jt1V0FD31958XQ-ixzZLxfM60-ivC4rd7t232IOia-7M7pv1B3OvQYj2-flvSws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP1Sur1oc6TdOOwONQ2XC4PwKChRbMR-59cPO-ihJXHQ&oe=6AC6533B"}, {"file_name": "Sourccey_VR_Screenshot_4_2560x1440.png", "id": "1587125576186422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1587125582853088_407861568217301854_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJe1m8-vT4YQ7kNvwEiwMzo&_nc_oc=Adq6Fk18bTw0LhGCvbT-wtbfPugS9TvkCRfmw83CXvI3RZty8_FVnDCk9_pZny20CZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO41wClrnPqAbreAAPC-AFkhTx6ud_Xza0LrUB5YT1kLw&oe=6AC673B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sourccey VR", "keywords": [], "long_description": "Sourccey VR puts a pair of robot arms in your hands.\n\nSIMULATE - NO HARDWARE NEEDED\nThe app launches straight into simulation mode: two virtual robot arms driven by\nreal inverse kinematics. Move your hands and the arms follow - reach, pose, and\nwork the grippers with full six-degree-of-freedom tracking. Practice\nteleoperation technique with nothing but the headset.\n\nGO LIVE ON REAL HARDWARE\nOwn a Sourccey robot? Enter its address, press Connect, and the same controls\ndrive the physical arms in real time over your local network. Live hardware\ncontrol requires a Sourccey robot system; everything else works without one.\n\nBUILT FOR OPERATORS\n- Passthrough keeps your real surroundings - and your robot - in view\n- Per-arm calibration aligns the virtual arms with measured hardware\n- Both arms are independent, so either can be operated one-handed\n- Arms freeze automatically on connection changes, on losing focus, and when\n  the headset comes off; you resume deliberately\n\nAll communication stays on your own local network.\n\nSourccey VR is developed by Vulcan Robotics.", "short_description": "Robot arm simulator and live teleoperation for the Vulcan Robotics Sourccey."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vulcanrobotics.ai/privacy", "developer_terms_of_service_url": null, "publisher_name": "VulcanRobotics", "support_website_url": null, "website_url": "https://vulcanrobotics.ai/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1382855714900703"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1601361544945968"}]}, "baseline_offer": {"id": "1601361544945968"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790093940, "status": "PUBLISHED", "id": "1601361544945968"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1440402095812731", "version": "0.2.0"}, "id": "1395437839387950", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {
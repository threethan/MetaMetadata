", "party", "pictonary"], "long_description": "You get a word. You draw. Others guess. Sounds familiar? But here\u2019s the twist\u2026\n\nGet ready for a fast-paced, surprising challenge where you\u2019ll test your creativity and quick thinking! One moment you\u2019re drawing on a regular canvas with a pencil, the next you\u2019re spraying graffiti on a brick wall or painting with a rubber chicken on a pixelated TV screen. Before you know it, everyone\u2019s shouting: \u201cWait, what\u2019s that?!\u201d\n\nJump in and see if you\u2019ve got what it takes to outdraw and outguess your friends!\n", "short_description": "You get a word. You draw. Others guess. Sounds familiar? But here\u2019s the twist\u2026\n\nGet ready for a fast-paced, surprising challenge where you\u2019ll test your creativity and quick thinking! One moment you\u2019re drawing on a regular canvas with a pencil, the next you\u2019re spraying graffiti on a brick wall or painting with a rubber chicken on a pixelated TV screen. Before you know it, everyone\u2019s shouting: \u201cWait, what\u2019s that?!\u201d\n\nJump in and see if you\u2019ve got what it takes to outdraw and outguess your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.oisoi.studio/privacy-policy", "developer_terms_of_service_url": "https://www.termsfeed.com/live/b9b579fc-4ffe-4c6d-a7ad-5de1c704c331", "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.oisoi.studio/apps#wait-whats-that", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
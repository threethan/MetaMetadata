Y9AhvwQQ7kNvwGeRtyr&_nc_oc=Adpy4pNjLmE6Um4cpEj9dhKDzUwxMueRadJ_PuE00n5AfEoL1X2jhRWk4g5y6mVf2Ec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQkRj9tuOwGY94gr5JLbPk-2wcFhW6MlDPltIudQ6Z6w&oe=6ABBE12C"}, {"file_name": "New Project (7).png", "id": "884656057461254", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823341_884656060794587_949508116163400614_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVa13yLeWzAQ7kNvwGAaeom&_nc_oc=Adqv3dwaEVAetULvdpOq2jn5r79AF-qqOOCuNp6uFjxuigOpvvPWceAiXFJBvQL_iO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhVXIgT9uJN6Pzkp7rIVrZFGnPmaxiFaYHYZotEDaOyw&oe=6ABBDB21"}, {"file_name": "New Project (9).png", "id": "1315146003248458", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1315146006581791_7260451837624492318_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4mx6SMNpH8Q7kNvwFny2CR&_nc_oc=AdozvPVqVZHBpGDLZqzH-i0PjaAxyWyMBJEKh4r0otL2mfddepy412q07j8jK8cnj4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbUne-xPfgBYNyGeNv_gdpuKdSPPNZFc7qmqtvzz-pFg&oe=6ABBB37C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE copy_no_power.png", "id": "1543355402962187", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982484_1543355406295520_8384708878043713732_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hmu5qOfpuC4Q7kNvwEWRP7Q&_nc_oc=AdpGFb2d9Gg8TfVmah1CK_qMSIZs93T554HB4mjoPOgIrctJAs8ILfBb1ZrkqDQK1lA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKw4eFkmfLSMKqDCRv099yc02y7N5DPsCGUUPsP3aYEw&oe=6ABBCEFA"}, "display_name": "Wait What's That", "keywords": ["drawing", "Guessing", "art", "party", "pictonary"], "long_description": "You get a word. You draw. Others guess. Sounds familiar? But here\u2019s the twist\u2026\n\nGet ready for a fast-paced, surprising challenge where you\u2019ll test your creativity and quick thinking! One moment you\u2019re drawing on a regular canvas with a pencil, the next you\u2019re spraying graffiti on a brick wall or painting with a rubber chicken on a pixelated TV screen. Before you know it, everyone\u2019s shouting: \u201cWait, what\u2019s that?!\u201d\n\nJump in and see if you\u2019ve got what it takes to outdraw and outguess your friends!\n", "short_description": "You get a word. You draw. Others guess. Sounds familiar? But here\u2019s the twist\u2026\n\nGet ready for a fast-paced, surprising challenge where you\u2019ll test your creativity and quick thinking! One moment you\u2019re drawing on a regular canvas with a pencil, the next you\u2019re spraying graffiti on a brick wall or painting with a rubber chicken on a pixelated TV screen. Before you know it, everyone\u2019s shouting: \u201cWait, what\u2019s that?!\u201d\n\nJump in and see if you\u2019ve got what it takes to outdraw and outguess your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.oisoi.studio/privacy-policy", "developer_terms_of_service_url": "https://www.termsfeed.com/live/b9b579fc-4ffe-4c6d-a7ad-5de1c704c331", "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.oisoi.studio/apps#wait-whats-that", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25058714720470364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.57
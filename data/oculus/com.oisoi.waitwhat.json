f4c7qqcQ7kNvwF-0Yrk&_nc_oc=AdrE1VW9VdNGDhTtcoyVvP_g6hj_RYhY6cXIIcsgsPGotWxPB7JCyIxllnK5QdhcZVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5JHZfHl-KhS9SH3fjo_DeBhGXepECw4s_MiD489Dj9w&oe=6AD24AAC"}, {"file_name": "New Project (7).png", "id": "884656057461254", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823341_884656060794587_949508116163400614_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hn8NJOp5kjUQ7kNvwG2vWap&_nc_oc=AdpgEwZlEQKIPBBe2AfQKSNH1D8qZT6n-3zbqfN7IjiXTYV3li2uYvJls6yNiHIQG3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiEnbENkrywf3QNu7PePLRsTTQCOtIMwunmiQWj17tJA&oe=6AD244A1"}, {"file_name": "New Project (9).png", "id": "1315146003248458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_1315146006581791_7260451837624492318_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XX6fi67pjgUQ7kNvwGXyL7q&_nc_oc=Adpb43OsN5SC8riDeu2km5ZunNBSm7EhEPFYLHLVr_TFBtdHaVXbhfE2_aECNAoFqu8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmryNR59b_0uIVV-VpGOhscuM4p558xtAhY6DED3Xlfg&oe=6AD2553C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "LANDSCAPE copy_no_power.png", "id": "1543355402962187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982484_1543355406295520_8384708878043713732_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfEgh0Em3RUQ7kNvwHy_ZU-&_nc_oc=Adp-KGiv9e-vxztfzMzYFTxAZvhHFU_uOQZfiTory1Vu1qs79cL4PZ9nEKMdi20nmdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_kWJBJXLlJ45a_tdljD9gOsGcZ71zkaaKW71tnLXkIg&oe=6AD2387A"}, "display_name": "Wait What's That", "keywords": ["drawing", "Guessing", "art", "party", "pictonary"], "long_description": "You get a word. You draw. Others guess. Sounds familiar? But here\u2019s the twist\u2026\n\nGet ready for a fast-paced, surprising challenge where you\u2019ll test your creativity and quick thinking! One moment you\u2019re drawing on a regular canvas with a pencil, the next you\u2019re spraying graffiti on a brick wall or painting with a rubber chicken on a pixelated TV screen. Before you know it, everyone\u2019s shouting: \u201cWait, what\u2019s that?!\u201d\n\nJump in and see if you\u2019ve got what it takes to outdraw and outguess your friends!\n", "short_description": "You get a word. You draw. Others guess. Sounds familiar? But here\u2019s the twist\u2026\n\nGet ready for a fast-paced, surprising challenge where you\u2019ll test your creativity and quick thinking! One moment you\u2019re drawing on a regular canvas with a pencil, the next you\u2019re spraying graffiti on a brick wall or painting with a rubber chicken on a pixelated TV screen. Before you know it, everyone\u2019s shouting: \u201cWait, what\u2019s that?!\u201d\n\nJump in and see if you\u2019ve got what it takes to outdraw and outguess your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.oisoi.studio/privacy-policy", "developer_terms_of_service_url": "https://www.termsfeed.com/live/b9b579fc-4ffe-4c6d-a7ad-5de1c704c331", "publisher_name": "Oisoi Studio", "support_website_url": null, "website_url": "https://www.oisoi.studio/apps#wait-whats-that", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25058714720470364"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.57
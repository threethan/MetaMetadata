771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVrcCnDk7wIQ7kNvwGjgRTb&_nc_oc=Adr9k06eJyUgDBrXZqS3sSKvhxWmhzLV107CzLIQVSVomKm1wBwn7Fj85Bexy8xFW7E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv14g19fumTqJRMdfkFwVOaiumUaZMmQ_JmFUQTMaWPQ&oe=6A86ED06"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRMi7FFtvSIQ7kNvwGQAtRD&_nc_oc=AdpoJrkKePNyr4VLYzm9dxzG0XNtRHQf39A1oWpnTHEvzrMtTV0TKlDz0zqqZIyNVpA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQNSW0at2XeY94MtIw-QHoXXT4AQ8NcK0niKFGlqFujw&oe=6A86CF90"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLdKsy6nIiAQ7kNvwFc-P6o&_nc_oc=AdryJFIkTxK4pW5pb6WZg1AFguUPI_4FC3af-6OJVDvUCK38PhY-nAUeu8NtatgCSpQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUz9HDzFl53QdubswvGhfAXXKCgY8oMGjkhNFKWt_w7Q&oe=6A86DC6C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2xtWn_m8igQ7kNvwFCJSbi&_nc_oc=AdrNT44WjVIoVTliWPWyEv9gWk9x_G0aHg9WrHcQcJ8DTIw2yWFRt_NG9moFx53Nq9Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELq2FQAzJyMUN5_ke9LorUiWVrPDicUjYgnjghZjzNhg&oe=6A86DF5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzTfYEKb8SUQ7kNvwH9Nq--&_nc_oc=Adpz8SSAPITJwy4o4NUkD7rhdZbWT8X9rhZVwmAQKBrRPgIySVgYYq7k-rUG-9DQFM4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQZvxJX1LfC-5fjNP4c0BlCTZUWGHfKuhLRvWZvpeYxQ&oe=6A86F0C1"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
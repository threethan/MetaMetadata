771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AgQ-P3bQ5gQ7kNvwF3ztMN&_nc_oc=AdrKgYQ2sM07FcjK2lkV7Qfce5H-sFk76fmvUfS995_hd38t8hhWlxiRlZUBep5NylI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmC-Y9E021-1ffaRDcFyOrghNw1fGtBcDrVbG1HRMOqg&oe=6AEA05C6"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLk_PiEFrdoQ7kNvwEraB3x&_nc_oc=AdrRWNsY2WM10ByqgbthU5N4j1WWYiatghqWKtFFhpVeyrDTSCbI-DnBRnHhSM1OAy4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSURrsPlpDiKW0NcyEa8aoQ-1P51obebT5R0rz7sqW5wA&oe=6AE9E850"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ivyc2k4iwQQ7kNvwECmpEK&_nc_oc=AdoC25Xb_To0ngDeVwv_dsL1Fc6Mbpm1mCpBckXGGcjj-h10yKc_m2eW_Y-2YCvcUnc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS35BADwzAL8yMqJ_cT5ViHTd2O2zf25A5Qt1BD3v_qGw&oe=6AE9F52C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5W6zrPKL1DAQ7kNvwHbE5_w&_nc_oc=AdoFqtsxKv5DInUSjnV2za0Lb12m2pAW1XH8oayPwh9EcfLJxvMQnlKAMQ1Gc8O0Ch0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPx99-R0e7h4wG1djG2UDqxMnWbg9OurxFTs-WWzsYYw&oe=6AE9F81D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-HTufKxrYsQ7kNvwEt4R9c&_nc_oc=AdpJ5D6hOILs0RL4le9zUlJNVxY7Jn6_y4Bf7ChlbDzlcvys6SWKM2ecIQiFcpm1StU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgPd0B51JjSFxCfRUjKzx3m4jAU6F4AXcrxNAC17nXWw&oe=6AEA0981"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
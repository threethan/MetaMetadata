_ss=7f20f&oh=00_Af8mpRh3rfQ7L-LtEJzIItR0oLErPC8pzzRF-Pdx9kNV1g&oe=6A2ED0C6"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hbMoVtq9vQQ7kNvwF2nuW9&_nc_oc=AdqK6N_e4L8YlsJcew883fENh8k-594QfZfnwqf5PDCk94Z483faAer6TxXABP-OJco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X6qP3mslnD55MN6JgYhrLtYp6_iJorYX1ZalNAV2fug&oe=6A2EB350"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlYjh8uzUP0Q7kNvwFPNTxf&_nc_oc=AdoeGYPvBjr0JEb0dUuaUelS7_d05anC75gEcp_KSpyHj69-tftpt80h4g2LjCIRgK0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TmSZ3mB1HdpHfMG68tYhDAywU-ND2BQ9MKG84t33LDA&oe=6A2EC02C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q-PtRaL1pMcQ7kNvwENudOc&_nc_oc=Ado5wojXgwy_Kux4VEb6zo8C_q5Eo4krZcyukdGH0SnSmwxaX6G9lLDZiI8eP3EtSQc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hJzNLdtpY1gFfNDv7nkGqXUHRCt_boDoyxAPq1IwUEg&oe=6A2EC31D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4t187oTRhkQ7kNvwFegzt5&_nc_oc=Adrs0EvhwHRqgS-7vUAI0GVw92gsf-MPPfHqWKkfs3-E5lCdtGYJtAnKG_q8XTpaU8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fZSPKy00bvUK59Dl18wgSXA3GiENO1WlyXNpMI-I8Ug&oe=6A2E9C41"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing is a fast, arcade-style VR racer built for Meta Quest, blending neon drift action, high-speed arcade controls, and addictive progression.\n\nRace through 10 explosive tracks across neon highways, lava cliffs, cyber cities, and anti-gravity zones. Master drift lines, nitro bursts, turbo launches, and clean cornering in smooth VR comfort designed for short bursts and long racing sessions.\n\nUnlock and upgrade 6 unique cars, each with distinct speed and handling. Customize your ride with skins, nitro kits, horns, and performance upgrades. Compete on global leaderboards, earn coins, and chase faster laps every run.\n\nYour AI companion racers react to perfect drifts, near misses, and win streaks, making every race feel alive, personal, and cinematic.\n\nBuilt for Meta Quest 2, Quest 3, and Quest Pro.\nComfort: Moderate\nDownload now and jump into the ultimate VR drift racing challenge.", "short_description": "High-speed VR arcade racing for Meta Quest\u2014drift neon cities, volcanic cliffs, and anti-gravity tracks. Unlock 6 cars, nitro boosts, skins, upgrades, AI companion racers, and global leaderboards. Smooth VR comfort, quick sessions, endless replay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT
771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e4HWJFRukhIQ7kNvwGSWolc&_nc_oc=AdoluL64TjzdAQ66iV1zauVmisAvHEEyToNI4QlWVmb80yqZ9RC6TCWkY5TK2VRfW6Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7Dzwqj2a7XOeOC_MHOb9-xv_dxtcOhrd_mT_BoaZu-Q&oe=6ADCD6C6"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCfASydF4qwQ7kNvwFT5jT1&_nc_oc=AdqM0tn5p45W3VKzVzv_Jb7SRoQvvIJ2OaxH1DZsWc741PtHC1s00nLuSX5SrHVGmIU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAjYIlIUqC3RnsQPSa6hnSLgZnf7SR8qlxU3ObvgJecw&oe=6ADCB950"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Q_5QlBPtuoQ7kNvwEXO6C6&_nc_oc=Adq--3BTJkFfo3qrW12XkBHjVmBXV2MAyVdOw2VRtBWxien49yPNCwUbA364oaZ2ILY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5GReKj7RJnBNdk1BFzGiBr-6gSsTGOEE887r6wk3jEA&oe=6ADCC62C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1liIqc0BBYQ7kNvwGlTAgo&_nc_oc=AdoX_VaiS905w4oidkM0QjnGXM3RtErPwFut6Ywlikbu4D127NOpUNAOEZOCFpTFp6Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9rUlAL2Rp9jFPQ92lk05C841_iU5zYleePqFJGCHSMQ&oe=6ADCC91D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gi1rr2AeIosQ7kNvwGy7c4b&_nc_oc=AdrTLLJSoaT5iS09QVBF2R89tR28hQE3KJ6gwDF_Nf5t9OB9yq4lBwHqYTbtzdZXTCI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjzhP_ZXvZD9hDJ9ebbXGHPN7Q2sVes1CgwKaQl3xIwA&oe=6ADCA241"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
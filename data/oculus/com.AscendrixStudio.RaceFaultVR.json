=1-7&_nc_sid=6e7a0a&_nc_ohc=rtNvOYn2820Q7kNvwE2Db_9&_nc_oc=AdrvEXuWj_5_0r5OXP3gy5UC7RSh5v8PVWQjzyhW9A6o4TKV1iCZsuxpi3YbWH_yUpc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zaVve3pufZzd_nTK8syobZYcNUQjAm2TpnIjdYtwwgQ&oe=69FB26E1"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["Racing", "Car", "Speed", "Drift", "Drifting"], "long_description": "RaceFault VR Car Racing delivers a fast, arcade-style, high-adrenaline racing experience built for Meta Quest. Drift through neon cities, race across volcanic cliffs, and blast through futuristic anti-gravity tracks with responsive VR controls and cinematic speed.\n\n\ud83d\udd25 Why Players Love RaceFault VR Car Racing\n\n\u2022 6 unique cars with different speeds, handling, and upgrade paths\n\u2022 10 action-packed levels including neon highways, lava cliffs, and cyber anti-gravity zones\n\u2022 AI Companion Girls (Luna, Nova, Aurora & more) who cheer, react, and celebrate your driving\n\u2022 Drift, Nitro & Turbo Boosts tuned for smooth VR comfort and arcade fun\n\u2022 Customizations \u2014 unlock skins, nitro kits, horns & performance upgrades\n\u2022 Easy to learn, addictive to master \u2014 perfect for short sessions and long racing marathons\n\n\ud83d\ude97 Gameplay Experience\n\nFeel every drift, crash, and turbo push with immersive VR physics designed for Meta Horizon. Each track brings new challenges: dense traffic, steep cliffs, tight corners, and high-speed jumps.\n\nYour companion reacts to your skills \u2014 from perfect drifts to near crashes \u2014 making every race feel alive and personal.\n\n\ud83c\udfc6 Compete, Upgrade & Dominate\n\nEarn coins, unlock cars, master tracks. More updates, events, and cars are coming.\n\nCompatible with Quest 2 / Quest 3 / Quest Pro\nComfort: Moderate\n\nDownload now and start your VR racing journey in RaceFault VR Car Racing!", "short_description": "High-speed VR racing with 6 cars, 10 explosive tracks, reactive AI companion girls, nitro boosts, skins, and global leaderboards. Drift neon streets, climb volcanic cliffs, and master anti-gravity tracks in pure adrenaline VR racing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26775407282071778"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821568_1396534468516910_148155432913999992_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVjrGogm31oQ7kNvwFF75eF&_nc_oc=AdpwBuEbc5vNFGlXcAIrLQP-esUXHmiEn0Fzq1WrnvqMbaSkvpnaov-HW8oiI-Ccn20&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69pwN9p9WaU05jeW89Hqseiqwlg7xqjXFDlAMlK8kIbQ&oe=69FB553E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RaceFault VR  Car Racing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "6733851832874
771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVrcCnDk7wIQ7kNvwFa9F_8&_nc_oc=Adp5aXgervfsFaLPlj_TjbKLtGAzpijg8br4MCPujanibpcOXg2L9hL0uZ4lY8qZL4Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGIVJvlVfct7QYmk60aejnA8NJkIUiQahrxBQ6k_3Q5w&oe=6A883E86"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhAjLAj6i6IQ7kNvwGIMVVx&_nc_oc=Adq2nD4_ZUJdRWhUZWh0Y6V9Z_lZ3U9K6UfCJDVTPFKq8nU6WuxzdM1SyJ3lo20QKws&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6x456sac3bW0h6D1dGol8tJcfmPqTKP7uMxKpg8Gy3Q&oe=6A882110"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLdKsy6nIiAQ7kNvwGcvLzf&_nc_oc=Ado_SJg8RKwqsJxJ_I6ukLz_-ZDfyFqTgZBmx1Ewp3aXWVAZ11EUqBQQVnxR1oWriIQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFA8f7DGODfrScw-arpfA-KY5OMLySisxoJMfxetFdQTA&oe=6A882DEC"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2xtWn_m8igQ7kNvwFN3pUe&_nc_oc=AdqgqIUnkbzYNY0Gn7w3d4JjANQLDbRTacnXBhnyYig35Nc9E3wugHDU4pEbAb36Nxc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0IIIoigXM5c_6Y9R_Z5osQGiuV585rFioak59ockPtA&oe=6A8830DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzTfYEKb8SUQ7kNvwGV49Cg&_nc_oc=AdoXyngJc3uiAlfP86G3dB-hez-IilH_ykoQp4ZH8v2hL0MFgRW5TBQK9BmsF0-d8Iw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpSVYpdIfPQ7MojCkl-k1teEx404k4aeGviQm29fxAPQ&oe=6A884241"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
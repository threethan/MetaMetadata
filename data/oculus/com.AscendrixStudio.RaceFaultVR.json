771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoPdWVAAuHIQ7kNvwEcLlII&_nc_oc=AdqvUbqvc9GfE4dxMbCrPcKYyvERSS4waHasBTr5UtWH6SMqdJLQMuHuxPxwa1iE0GQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmQ5TADSEE3ZGnVDUzpBQrgAUeVOkemlDAjSQDTaHoTQ&oe=6A917906"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNTCdYekuKkQ7kNvwGLuCis&_nc_oc=Ado5GsR9_DWyyBrCxoIuWwsc3bRgl0p7X0yrhvy_KUJccMW6CKq1e7Dy1fsO-elSFK8&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_paBkZS1wINwF1nZrSZjW9qHSQ6JvBCSTjKeva1Edlg&oe=6A915B90"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yn2LB91M-VAQ7kNvwHh3iIF&_nc_oc=AdrQuPo9aDcAJ-BK1xAktN2p2XcNwgw-unix02udi94j5VVbWNb_KkLxOrCmEecstmE&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwzb_3lvuILVKREUYk8P87riZjk2aS9NXRDURUdXi_JQ&oe=6A91686C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnVsCUZBKPwQ7kNvwFuTA4V&_nc_oc=AdqJUMSVUlcWa9gqk2YFTLMtw-prsk8AWPhh6HWurRYLQLqe0IMh59sgNRhdyyHnE_U&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5Gqueoku91jCSwFmwdqNHZSwpaxdIM-jop2_ued5fxA&oe=6A916B5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghCWIeMiJ5YQ7kNvwF2PiZc&_nc_oc=AdrQYApvl32IvRTGtlLIqmugfUddYuOCCd7bAScsN_3KQGiRptT3oZRyb4kukOWXDDw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHakyM7Ovl_pEh-qyhwJe9QXXoIviVenDl48QC4maToIA&oe=6A917CC1"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
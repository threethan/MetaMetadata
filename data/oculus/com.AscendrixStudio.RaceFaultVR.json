771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ta0JC_7pk1UQ7kNvwFLKTOT&_nc_oc=AdqdLaM-QGhAOwLQV5s9wkfClBClFull0kxkyZCUqAMZhUNvwbzEDjKtdDQbdvpfZcU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXldTD_9Eq7FhQU7Hhfo_oOXpTZkQfLxwL50QD-150_A&oe=6AA29C86"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo27PqvDVdYQ7kNvwEoaL7z&_nc_oc=Adq10oZWndzqf1byAvE_YHsvEARpJ8HlQAlbS7d3hBOmf67qhe8LANH3r94TgTrfZnc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkpT7B_wnP_yCwCG72B2uNlXIZh4I8iyCFzc09ICC6ow&oe=6AA2B750"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7DY7AK79pkQ7kNvwHgrxvp&_nc_oc=AdqPsMbLz9wcrkgRzcf8S7Kc-lbtSBRD6Kj1eqyN3g380YWiGov6n6Ol4TAhVdPLbBY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG9yjiDb0I569_9rCgNeE5NRRFhtkfzlDM5GzuKBxkaQ&oe=6AA2C42C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5n4z87HpMEQ7kNvwFdaN95&_nc_oc=AdrYxbRRpeW-gePW5YEgUKSP8LXnZJmbMiXU7OeTKF1kK916DPZ5zNAFK6JsJy-OqbQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPZqKdGm0-9dWKA2Xu-0XYk3PFD3bKUjWVBQthi8Gb6A&oe=6AA2C71D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2O_6K_PRVxsQ7kNvwG5ILG1&_nc_oc=AdozJwZ-h5bpfTj8ZoBS_GdF1D-V0t0ccdEBwOS1SdpNMEHnEXIn27afMMgiSSiHOyo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3yZjjAViLrAZ0lTIUtbI8Fo9qdxsvhFNlmLYz_ON_gA&oe=6AA2A041"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
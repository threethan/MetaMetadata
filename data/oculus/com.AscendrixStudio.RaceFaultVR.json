771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ta0JC_7pk1UQ7kNvwHkRGWG&_nc_oc=AdoL451Gko3HIq7g0qLzUxKq2tMl9e6x3Z9ovU4UJ2oTrZscUD-mQ7RGOqHRO6J_mvc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVQX91CwM8p3-U_Omaj5sGtAwcvoTP8BVaRqaMDsELUA&oe=6AA14B06"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eo27PqvDVdYQ7kNvwFU86AO&_nc_oc=AdpSHpGaiJzJ1_hSbHzvR8pgPvbP3dqrfJdkXR4kjUYxpCn5AZ5rERfm4a_NhSvFTVg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdMvgbM7aPr9uxSzd8mZd-Jxisw8SbOARr6FDWA31XpQ&oe=6AA165D0"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l7DY7AK79pkQ7kNvwG3svC6&_nc_oc=AdouO9DxicdTAAWtO0-odEKi3enYXaC8jlm3v2GOwcQxX_l3bd7NvzlrcSmS9hOAdTw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1Je2ftCYxbnAwztwjzacroICSza-w2UM6LFueCzTwow&oe=6AA172AC"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Up_EHl-adykQ7kNvwGdGdSt&_nc_oc=AdosXR9i92i-CLYsCH47K8mTBfKR-XKrzq7pc4x5pKeNBaZtNeRUVEYbUvHlAel32CA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpIeeADBtQG0OTrsTYKSCtfiOAzhNbW3IVjN18IInn8w&oe=6AA1759D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2O_6K_PRVxsQ7kNvwH2idsw&_nc_oc=AdpkZLSHFIG2atd1PHRTiYbnkE_ImaJcZWA6dTZDTojloBmAHUEFIcyvbb8QWXRQNjM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx9hiE_Vhp-iKyVr98J90RFepWkyBRxAhaiO0VvmriHw&oe=6AA14EC1"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
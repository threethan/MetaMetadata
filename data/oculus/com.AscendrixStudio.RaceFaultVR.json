.5771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNoMh-3cpgYQ7kNvwGs2Mg1&_nc_oc=AdrJWdcQhuArVXCfPHMFPoggKCoEaZZZQzsXDGShibCBgLEwBzBRpfC0EASM0zhoQGE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUtQoUEwaeFv5nv0tEHGmEevVdSybCH2wsFiBj03Kvvw&oe=6AA93406"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgaNi6FQalcQ7kNvwEgBV9p&_nc_oc=AdoL6EEhbk0akW5_U4vkOEwWGFf-kzxX70Nfc1Dyfjs4sNKKjxrPFeR51qUgKwxpt1A&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVJHkF9Vv7NlVLrNvQiOMZ6p_dRS63mbXv9EoA-69-lg&oe=6AA94ED0"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCm1Z5JEmokQ7kNvwG9L1nq&_nc_oc=AdrjpPULvsJhVqFBMy7osP-CvkmOlhYQz1agUuIaK2RtvFvRlkuRJdbsZKR275jwDnQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5G8bcQa5RaznURJG4UuWe17tXVdTLUe7TbxuxQ25tZw&oe=6AA95BAC"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tp17f6_owTAQ7kNvwFngzVB&_nc_oc=AdqPT-cBUGE6GWyXFCKdd30quN0xD2yzwoAFpP0gZg9ysaVvS8SuOFX3a3N9ynNkvQ0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvh4VTLhPZX_Cy7XSZZTLjEVSBeU9oHG9wilte6qpfKQ&oe=6AA95E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYPoMQHfs4IQ7kNvwGRRPPI&_nc_oc=Adr4x2HGVW3OPBG1uURUu3Yc4HBWjilJcMW_Tm3vNnjGulo_9CjVNNK6peGoDGcW78Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlD_d4kvHXoVj7IwonKeKomRKGUYW_L9ccCXg-ObEbcg&oe=6AA937C1"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publis
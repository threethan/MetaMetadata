771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUJ6LD_yORIQ7kNvwFr3uNU&_nc_oc=AdoNova9B8YVv2nzvSpwzAdzs4MPsZ2rpTTZ0nplCzMEpFjX2B88nCxgSP2LRZdzOr4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToilwuU7Ndoehcrx3aCt2ov7wTCVg9Yv-uL3kzdL67Fw&oe=6AF9D7C6"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tblsc4JUQKIQ7kNvwG67yfl&_nc_oc=AdoxIHqchsTHVbdaV8_BjO1ulL3YKtJOJP__ojnTtzBIJbL5fpwaV1GnaysuRtHBi2Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpD0QcJfGI9FgJWJ6aJkR0n_Gb6HetBe7oWvds3lBSdw&oe=6AF9BA50"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ9qQb3RCxoQ7kNvwHXUlTn&_nc_oc=AdpF3ooqXxRi_oCRAKCQkkA1Lquxw9Kgc9xpnqfTFYokcdbQ7g42qJKJMbwbPZ0WSIM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2CAsiHpte7iSlgscSjOWhibqPTgzy6aVOAWtt9dXpuQ&oe=6AF9C72C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0XWLceCUukQ7kNvwEZZnlz&_nc_oc=Adou1iC0OtcJEHz6o9d3JdXkkqkt2Eu_N_Sv7aAoJ6QQ9AKbHUHOgAuYAIay0yPFsyY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAy6mpKxkFtEF8CMtQitYlR_tpFzaRKFHO5S9L3mEbnQ&oe=6AF9CA1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVcXXiGF1a8Q7kNvwHVn6Xj&_nc_oc=AdrsH_qrL3eblnQEUyozLEAMXbYEnnp7Qgqr74QUiH1HRouu3VyCLb7mgn9CFf8AeL8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpIQson4gERxCx3aQcU8q-V4dFw9MaiOISSXUfXIi9-Q&oe=6AF9DB81"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
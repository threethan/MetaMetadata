771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQDyw7Qh3CQQ7kNvwHUC1u2&_nc_oc=AdowBUfVv6IbV5DzIl-l-_4xZdvvKSL8t3IaIgynCPixmQigxcTUJfCKKnfWurjES8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAMD-IJJBZdKp95FestU7mDi23UOYdcBzAPrlW9N5iVQ&oe=6A5F6006"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfuRW3l7TvwQ7kNvwFaeOUH&_nc_oc=AdpEbBaid78nE9rrperDiGsaGOCELOaY5iTAKDvi7_kgGiIW-PNcaIcqfKvnTD-J768&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4dTEzBWC6XcXKMRN6k-ndII7OwfTmL476svbeGnkoyw&oe=6A5F7AD0"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XfklGXFhV4AQ7kNvwELmQen&_nc_oc=AdoiimTuqrTnUFrRj0R1_cxT-MhQFA0kInNNUg5xFpl9COLheeqc3v1i6gPBb03DCfI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpBUub7H5auHHs4iGpBkGBKxasFhQmNoPZ6OPjvi7kaw&oe=6A5F87AC"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnXbXd2LqtkQ7kNvwGA__rZ&_nc_oc=Adq084GaQLEytKwExQBstOE3nj7tbYtTf5AdVjn2U__6_sVMvZT7QzqZKTZ2ck-iKYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvP-ooBfqCVb2U0CqEBVsbn2a7e1Gfh1xdab_yPbgoWw&oe=6A5F8A9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqAZvgTGssgQ7kNvwHUO9tZ&_nc_oc=Adr-Ehj6UmCB5uemEqtNElw1Q53xcoOuv7U7ZI_B-eWJ4wF16ERGd0CMr5Y4WpuYkFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD88r7UkXpKO2hZ5lKM59KbR4XBAuVgC5IxLAZmhmExYw&oe=6A5F63C1"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing is a fast, arcade-style VR racer built for Meta Quest, blending neon drift action, high-speed arcade controls, and addictive progression.\n\nRace through 10 explosive tracks across neon highways, lava cliffs, cyber cities, and anti-gravity zones. Master drift lines, nitro bursts, turbo launches, and clean cornering in smooth VR comfort designed for short bursts and long racing sessions.\n\nUnlock and upgrade 6 unique cars, each with distinct speed and handling. Customize your ride with skins, nitro kits, horns, and performance upgrades. Compete on global leaderboards, earn coins, and chase faster laps every run.\n\nYour AI companion racers react to perfect drifts, near misses, and win streaks, making every race feel alive, personal, and cinematic.\n\nBuilt for Meta Quest 2, Quest 3, and Quest Pro.\nComfort: Moderate\nDownload now and jump into the ultimate VR drift racing challenge.", "short_description": "High-speed VR arcade racing for Meta Quest\u2014drift neon cities, volcanic cliffs, and anti-gravity tracks. Unlock 6 cars, nitro boosts, skins, upgrades, AI companion racers, and global leaderboards. Smooth VR comfort, quick sessions, endless replay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2
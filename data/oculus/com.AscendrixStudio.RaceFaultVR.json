771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWxFQw7O4WAQ7kNvwHnk_15&_nc_oc=Adpovec8efNIJKsRdNVBvz3qe-_DLpKuSER6yzBgmq1ihVTAE4hiBC9kM6a7LzLClAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgV1YFFw9VDM4OSQav3qqwm_1x5ZtvADnfl3E84abSmA&oe=6AB15546"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3pm2d6ngyUQ7kNvwFGRIxG&_nc_oc=AdoNaeVfQvuW2fJdVK_9itp9l6HEStL_u-s0f8ARv2LL8CAfP2cAVynCOWWfNcnFJ2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6UR9PnyubrJXlcpa79D8V7rytUWj4201XPQSbbKpBPg&oe=6AB137D0"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJOV-67QQOAQ7kNvwFyp-eA&_nc_oc=Adripwti7tRYPWZiLttVw13F0U6nH2gJ9MSdFVJLWGMlI4E3e6SRDK9Zjwe6vUAlD20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEfy1etqRrJG82fncwpaKjpSuRdde9Yqro4C9wb7bpfA&oe=6AB144AC"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jy49Yl6j5PsQ7kNvwGaWeRM&_nc_oc=AdqMZ6G7q94alo7khPW05Cy5EfGoki0Xgz5f6lFY2eitEoBachIM7oeSEG-u8_nmyDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6T-xHDM-eS-geYGs3IqTnbcHaDK61HHpve8FivBA-9A&oe=6AB1479D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRxT_BwIxqMQ7kNvwHvItlg&_nc_oc=AdodraUEQK-oxm0-VPgHPvIrOm2Z4U5k8fcYOTyUeNtyvr0DJI4_C1KIh_CKlkvzt7I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLNTiNR8LBPMruY5DLUEY0JKSobK4hDwsGoXrog-OGMg&oe=6AB15901"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
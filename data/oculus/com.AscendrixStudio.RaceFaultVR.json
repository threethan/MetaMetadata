771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FK6-igkX5a8Q7kNvwG-ktnP&_nc_oc=Adr5LN4xeH4pIOiNCZfnTiewSG5-AndeAQksVpUjJUPXlVMEEcdO4xaQXEG0gACnO3c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0wc7aPLY7YQXWksCMs6XGQIfbf5_xwPdfZp0QDZkg6g&oe=6AD39C46"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4BJkBxCTasQ7kNvwHKaPE0&_nc_oc=AdrNqwb0IpHd95U-Q618TOmdUhelZXM2o7lhVRlI9c9NPT5Xj4M7nQZ2Jv1RE3_fCN8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmukhcZkr48givELZ3v2tlSnU6aT_hSbj5tSD48nudVA&oe=6AD3B710"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVo13IUmnnwQ7kNvwGQjR2E&_nc_oc=AdqQxm75BvOkNBszekM5J-7YMIPHcAdvsd5pgZQDgkSm8myYvybF7Jxu0Orr4h_AH1Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3r6zrkqsJJC3fGbdCJpoYq8oAv3IfHnMayPdN9ZNWzA&oe=6AD38BAC"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMAylPG9awAQ7kNvwGfZN7i&_nc_oc=AdpU2bP2pe9Hm5VBa4dFH5-xL8odocK20RwyzyJjWESNQxI0PTfwmWh_uIXY7FXD76k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuLvHKtDuEpfbIYkYxoQz_t3rjPHUjcCBu9rFjVW3Lrw&oe=6AD38E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CATzioC3Y2QQ7kNvwGnueXu&_nc_oc=AdqC95uYSqDX_YfdmaPlaSe_46pxwgX6txA8KJYPcmQNE8QentPPq0aVbOrezk3TjOA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX4u1ZcNUzfr_s3-Rl1Ty4y3gxmUyb3V2iSGZJCHLVsw&oe=6AD3A001"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
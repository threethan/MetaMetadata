771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5LVwNDF0twQ7kNvwHsHrFu&_nc_oc=AdqQgOzM4pjOo2cFzwY1qbP4u_tf5b12EbYmEG3y55X3mYi_r9iIVegi1BbndgSjRkY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ6-E5gdPXtjs2hXwEbH9RES3TOppa2rGlRLP5RkFt9Q&oe=6AB69B46"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GE7MXOh60YQ7kNvwHrGAAf&_nc_oc=AdoLArAFsmvJc3uv8kao1_Elv42ly1tPX-aEFiXgsNECk5_R9cg10xDzf5ShS54IwVw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_UkWUsV8ufqo5Ph6WBq_54yS48USffm8aeJXCltppVw&oe=6AB67DD0"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pq6iw9SNPQMQ7kNvwFPO5l-&_nc_oc=Adq_6YN_pE5-lF_TfNlzN64n-q5HVg2FvFYzP2TaqqA9ogOxk7IBSMq4M74h_EoAosU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvZaXydJt_WoIR1c0O20J_3SIhzkIpOdorXE7Sh0tw2g&oe=6AB68AAC"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dSx5sb9cYwQ7kNvwHvQk87&_nc_oc=AdpUT9rrNjfbk56Xb38f7jQEePcxxI42O57__8ihvqA__7Dh5XzXtUOLsNMEjpcz_NA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJb9J1nNAqtad7Z7FdvyP54Zdtn6Z4bguY3BCNCazuecA&oe=6AB68D9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea3c4m-0inwQ7kNvwH4Wj2q&_nc_oc=AdpRRObLT13lS0ea8YDY-hbSB6qz4B8wj0ar1FB68jjOMn-SevbEafC76jO9UfMlUik&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJu6-eebGtw-xasfcBz6ja3DVIUcNkUkTrfG4EwzEVMdQ&oe=6AB69F01"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
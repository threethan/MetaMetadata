_ss=7f20f&oh=00_Af-c2JDX35nVvVHFZ9tmMl6YmVdPzcLMiIlyd2alHxAHsA&oe=6A3173C6"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBWK0IGofL0Q7kNvwGjM2r9&_nc_oc=AdruIgWGtFkPNc_ibVrj0SGPdoJHueUnv6gvNsGuNOniRT5iiUN9KU5UKQVJC8SwpvY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_jKo45xMGXHcVW9gPz2Yu-qFirrJWr9rTRIv1iuoVhw&oe=6A315650"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlYjh8uzUP0Q7kNvwG3CEVH&_nc_oc=Adp24W_rJm8OjKLqQgTUk41_LHkbTuh6SXa3zabBLFgy_suPjbsEYCc3YywQ_fZQaro&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CXpPCO06OlzMhmGwGEcRuhJ4T4nOkzxL9ZDx4XJRuVQ&oe=6A31632C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X99xo4J60wQ7kNvwFSMVTE&_nc_oc=Ado9_4Bl0XAZ8lFzFPgmvu7MXDv8bu5CGvb4JQLbsLS4-gq-F-ULQcM-5-NJTdXH6Kc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7vKbz-Ev69mOu-6w3TY7vP8HZF7mrzJXST8ixw2k3uA&oe=6A31661D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4t187oTRhkQ7kNvwHURwC1&_nc_oc=AdqomNuJfkWgPDgoOBXRnufhUvh5uzhxhSzRjC_B1rXRLefEenWVqjqP3FEBb5YAUW8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9oeWlMcCgsikaqGzB1Aj9OU2aX79INBuS1o0TTw4Xu8Q&oe=6A317781"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing is a fast, arcade-style VR racer built for Meta Quest, blending neon drift action, high-speed arcade controls, and addictive progression.\n\nRace through 10 explosive tracks across neon highways, lava cliffs, cyber cities, and anti-gravity zones. Master drift lines, nitro bursts, turbo launches, and clean cornering in smooth VR comfort designed for short bursts and long racing sessions.\n\nUnlock and upgrade 6 unique cars, each with distinct speed and handling. Customize your ride with skins, nitro kits, horns, and performance upgrades. Compete on global leaderboards, earn coins, and chase faster laps every run.\n\nYour AI companion racers react to perfect drifts, near misses, and win streaks, making every race feel alive, personal, and cinematic.\n\nBuilt for Meta Quest 2, Quest 3, and Quest Pro.\nComfort: Moderate\nDownload now and jump into the ultimate VR drift racing challenge.", "short_description": "High-speed VR arcade racing for Meta Quest\u2014drift neon cities, volcanic cliffs, and anti-gravity tracks. Unlock 6 cars, nitro boosts, skins, upgrades, AI companion racers, and global leaderboards. Smooth VR comfort, quick sessions, endless replay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT
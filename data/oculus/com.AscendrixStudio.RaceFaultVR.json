771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KX6K3ZA7HN0Q7kNvwEEoSDe&_nc_oc=Ado1NFDO2NAEshRq3HD2hmAPBnJWZeyH8rJs9ZZPBADFdQhoBQOThU1VyEFMk79fqk4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjU_yEPvIjVB8SH367eNKIsJ6XUQfCZzJNC1gfBVKjmw&oe=6AB003C6"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3pm2d6ngyUQ7kNvwHTkiDD&_nc_oc=Adqr43Yj0EFkYqXlwe9QYuLGfsgZg9Epy1wvNlw_X1Wu6pVfQHDSQ9UMzHPShqhMlL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2-O9mATLF5TZ6dunIx4wRnkCADjuNunKJFa5pYl0L7Q&oe=6AAFE650"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6PhS7wSR2oQ7kNvwEt7GTK&_nc_oc=AdorleiREe31VBpTK36GN5iPbqwOJX4v4hdaZMJhxBOk1zEFbzSMIvlfYRuLH2dqOKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIN78q_k0FO8efn6NJR34VUnmyqXs7mH1TtYG1Z1t7Sw&oe=6AAFF32C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jy49Yl6j5PsQ7kNvwHxs6GE&_nc_oc=AdrTAbINkJi_rWcYgFxtAJ_1FLorr_2pNOsvpDAyR_jW5BF8hONfOTvdwyEfoAtcmqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgKLdcb56Zp_2wt8gNi_OSfC8QkhAdR015isQIGU7-Yw&oe=6AAFF61D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5ACVzFfxVMQ7kNvwH7ODc0&_nc_oc=Ado4j0CA5VyrD6lKLkBmUJCTfkV9WjsIPpAAQ8ew0W9WjtDq0YMPMpteAHOePBJIDQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_NntRtHFOXI5BLMGuCVyF1gfOVdqhotkMGvZfA4zHog&oe=6AB00781"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
com/v/t64.5771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-4dVMpCrvAQ7kNvwFL9c_F&_nc_oc=AdqST_uVl3oYxKlcZaAsWhyvPQOKCnIB6rBg8r0Ked1blCybmga1h_WklHk-ufjyrG8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuU6MT3din4O1YP-XdouDJ2k-agxs_Dm8oLHYibRYonw&oe=6A8ED606"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hndB0-VmYBEQ7kNvwHSFQcp&_nc_oc=AdrpepT4g8ICv9a5OkWpOHy-Wa3XQ0LAUfIWOclzihAqERFsHb5PPTzodd0eqKbWM-k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvtU7Sk9IPGPg74xeVvTmXMP7Ely6M3wQteebtbkLiZQ&oe=6A8EF0D0"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f-b0ASifHcQ7kNvwF7MVL2&_nc_oc=AdqQxB43AkkhleAjrFhhA4B3OUFxyzI6tu-KhXMAkG-8LRFB-jTbZad_z7l988LYJtM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaPGB0LNCHUnlkSsKW8TgnfgPXGyFsy-8jf25kTKzUFg&oe=6A8EC56C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UnVsCUZBKPwQ7kNvwHqSxiN&_nc_oc=AdrlLStFzFG758iQAEMRk7wEh9brZMKfICb1Etpt8Y8Xi3SHAt2foD2hCJ6aGVODbic&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmTmnDKuVKnn4daIP09qkWcswDHesyDxh91YV62_wIaw&oe=6A8EC85D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VIZFFiINr2kQ7kNvwEMbFMG&_nc_oc=AdqKDIkE4mOBQP-1ysyqON-gIVnO_68l8exWfP4A4RjZbqbW6-j_WdQMR6vMHH2MxSY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy1BNkO-n7ZcggE8yv_7E5IrORIxI4y_p8-ivYP-bUcg&oe=6A8ED9C1"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": n
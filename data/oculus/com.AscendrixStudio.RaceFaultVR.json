771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H3hIBUHRmvMQ7kNvwFx0lg6&_nc_oc=AdqltYBWdaCy6jIShYrqcGb3q5IqHHaamPkzuABeD5ON1JEQIB0UcA1hm5dWRtta7A0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNGgwsd0mGuvsTasaNbUNHKvGsBk2sJ8pxiWl2VUga6g&oe=6A899006"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhAjLAj6i6IQ7kNvwH8edAt&_nc_oc=AdoZfNO0GQXJS1g4tUPQDXiGf1JgZjZEiffrr8BHKoKHQoG85pVtIs8EVA1ikSJJvKo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgv768QprU8XGBtNhR8GG18JhLYAVhe90nT7fWKPd2ew&oe=6A897290"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yNlqSRfSXUQ7kNvwEBAVCX&_nc_oc=Adr7RA70JSmahU2nKiNvNJuXzkWQoZIyQ2LblujSc1XupxDw8bbLSRbJ-Dt9Ub6gBx0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1c3mbgOUWfY2eC1mz7DlRkycyn7hXA99X3Qiwf_EPDA&oe=6A897F6C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2xtWn_m8igQ7kNvwHOJfzx&_nc_oc=Adqv3hBkmApwX29iZLDZWl8u1tFcgyO2yOIW02C9ujyBHTcG6xYbLsj7KoUwMCK-O34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHf4YX8Tfv6FcBR-QF6xWROPEsk4T2ZeDoAd-FGRG9xbA&oe=6A89825D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feSUVhHVd_oQ7kNvwHkROuv&_nc_oc=Adoe7vJsitwG36HNoQFVVtYBoqZQk3cn--26bBydeKl_65UPF2EeRBxoMqRITmvPYkU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmHc2XG5OwVwfWUwn9Acbs2BIT6lJq6cgm8otJ0MkNIg&oe=6A8993C1"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
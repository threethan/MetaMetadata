&_nc_oc=Adrm_cd_4bUcli8C0o_2rCT-LwQDmTJgtOzKxh2mWzcKhsW5V78fsqH4CY4JR_tkZdw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDubxphOObl9zzKyWCaqSZxGa4CO7F5RAMzYISAhqGjmA&oe=6A492EC6"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5O8Dc56giR8Q7kNvwFD58En&_nc_oc=AdrFMIOZpwkSD4AWg5H678WNSAc-C7IzuQIr7h57HE8axj8TTo60DFVb7BBdY-s-8BY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYObLCBKqDqGyOYeWnp87cdk7qXL5rztO9J4NH_c38fQ&oe=6A491150"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1uSWt51OTYQ7kNvwHlxB9Z&_nc_oc=AdpAqnwIm66QoKD8pvW7mMAFpAF51LyXXHOAqkwVvIW-pN-zn514mEPKBxYDUnhSQqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDZ7HcR1HccNXDdM1W3uZxHlvB0SCTkze1UrytF10O5w&oe=6A491E2C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEGppEjLRjMQ7kNvwFEybVl&_nc_oc=Ado-1OGTk9d1alaSk6qAgQbtwn_EdrCIMbxiVG2UY0wQHFKtCeqLl9JDt3g401poYhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYiDZ4l_4GgSmfW5Iox4tbQgMyaqcrmNIeWe-dFTFJ9Q&oe=6A49211D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_9UBtnGb2IQ7kNvwGSRt5X&_nc_oc=AdrLfMf3oC74yAHEFIxg8p5ZDT-rlPw18I67wd8tA_xM4FIPJf0VsReyW29DkA6We6E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlyQPShFeAEcmbhw9wUdWh2ThxUFn7QE1TV7AduRBpPA&oe=6A48FA41"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing is a fast, arcade-style VR racer built for Meta Quest, blending neon drift action, high-speed arcade controls, and addictive progression.\n\nRace through 10 explosive tracks across neon highways, lava cliffs, cyber cities, and anti-gravity zones. Master drift lines, nitro bursts, turbo launches, and clean cornering in smooth VR comfort designed for short bursts and long racing sessions.\n\nUnlock and upgrade 6 unique cars, each with distinct speed and handling. Customize your ride with skins, nitro kits, horns, and performance upgrades. Compete on global leaderboards, earn coins, and chase faster laps every run.\n\nYour AI companion racers react to perfect drifts, near misses, and win streaks, making every race feel alive, personal, and cinematic.\n\nBuilt for Meta Quest 2, Quest 3, and Quest Pro.\nComfort: Moderate\nDownload now and jump into the ultimate VR drift racing challenge.", "short_description": "High-speed VR arcade racing for Meta Quest\u2014drift neon cities, volcanic cliffs, and anti-gravity tracks. Unlock 6 cars, nitro boosts, skins, upgrades, AI companion racers, and global leaderboards. Smooth VR comfort, quick sessions, endless replay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_
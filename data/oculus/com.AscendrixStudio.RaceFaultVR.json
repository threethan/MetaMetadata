771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=041YEC7Zij4Q7kNvwEOB0lv&_nc_oc=AdrokK7NIubLwJqpDwB8l37jKcXksa7qTGUhKP35OvMnCIx2UhK10Ckce03HFS5aN-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4d8oqCRnNd_grne0Qdaqte0B0YK8qgYPPbr06AxUyvA&oe=6AF09D46"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RPOwaozIypEQ7kNvwGTZVnJ&_nc_oc=AdpFBfpuFO6r7pQExxnlVzHMfd9_wP9nqWrZy-Jkjq7hacHxfe_NtZi3ajrpZUR2cX0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4CeQV7RM4htYlbFkMtLxua7jKN_7ye12mCorez1yo5w&oe=6AF07FD0"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZddfY-hs-8Q7kNvwGGWs_Q&_nc_oc=AdoO1jn4rqJXUrNPYErlH1w_0B882_8GaIZRGu2aEZi7kSUy-PrLQj1U_wsJG5-mLAI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSu7pfDg0pDfIl8voPrXtI2Psm496r_qdlf5lNy0VDR-w&oe=6AF08CAC"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UzFVo7484rUQ7kNvwGFJyS4&_nc_oc=AdrGDvU1CnYWFJThkuqzD0mg7udl7-yUoQwwa2X4b6gcv3HCak_PMnm6sU6AghbGtQU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjpGG8nlSoAUEwkyYKcQ4cCeXuYtl_frSV40756seqeQ&oe=6AF08F9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oomgPm1ovRcQ7kNvwGJZZ9b&_nc_oc=AdqUvibsR4cFVUNmwwhS9tpev_VtYE4mQsEua-2Mtg_fZPWCjUWTWSYWUOi842wQPLs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-MKl-HGK4j6hVeL-Z5vkllwveMJ1IxGIZdcDD6dw9PQ&oe=6AF0A101"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psgapkUvK3AQ7kNvwEPqw6f&_nc_oc=AdrBJ5ti7zJ_mOVtNEnEvSoWO1XwQ9ttkmjHpXHVN7gPg2EEXbnmIlhmPH_9tzNDH8w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0lqzJ33D9abMn3wS-atQHRvllscmTKNWUGtUreigNsA&oe=6A9D5686"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2kjC-ymBr4Q7kNvwE8ufCP&_nc_oc=Adrgrks3XHC6A8TtNp9TlBDc8YqNbwPkJeRG6g9FCf7sMTjMA5ikVsGI7X3epgS33Ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxbhx9c2wME0C_3eEEicieFC71bW-e62Cgg-qnuKKY3w&oe=6A9D7150"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puiOj2jVXO0Q7kNvwEIy-L-&_nc_oc=Adp-y66Wv3Qf3XNH31WI-0RQqHkMR3rRuhu-Ojv4-GeBr1_eOK1XPHAsf4QmpihkI7k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCu3zkfRUJNTFft4LTjdpCZydLG2lSfC69_l9C7PGnLg&oe=6A9D7E2C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rifmg0biAS8Q7kNvwHlwp8O&_nc_oc=Adom9sEV1a4ZPpZQLwqIEMCCIvGGnIZqoMrxRyuaH8jNdiBTr8ZCm7ayH-1Yb_x3724&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsA3kCA25WOUSNK6gCTfGb0_JGTjvEvtSlOnMmHYDs6A&oe=6A9D811D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yWn0kPnkHVcQ7kNvwEI2zEZ&_nc_oc=Adr2FGIKrgztIrupMwXmdETLz3iXdHySCAP_0ySKJEf_5oOXiiZEZr6pwj4uE9VbMHY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfihsTYqwFB9smlQYgnTwImGolBgGy1II-bxFWHcnLRQ&oe=6A9D5A41"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
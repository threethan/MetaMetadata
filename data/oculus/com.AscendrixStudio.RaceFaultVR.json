771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEmODnSrgIIQ7kNvwFygBnr&_nc_oc=Ado_kLnzxn7eSNZ2AcyjZ_5q0q5EpX6VCkRynGBNUUObHW3l7ukiX1cMlb7AKV-zm5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH9N6b_a20ivpUZ7Di0TDWOGPQM5JeF7LKY_43RYTw2w&oe=6ABA8FC6"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lf6MMWEm9kQ7kNvwFEUv1X&_nc_oc=Adp9skoGrRnipythQ-q7xtDZYMENanp7Ayb1O7GWCY2S9W_dueoAdu97hNV1813ctrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFjYGTK3w7kAHKRuHdj5TZhc4f8ScilAC5RGGtIrXlBA&oe=6ABA7250"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3xU_1taRA4Q7kNvwEphb8L&_nc_oc=Ado4jSsRsIMe4CV8pWtRyfD2XzvqQA0oTs6q6FimG7ynG5bbxEMoSIfFKDCbGbk0p7A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1cz-ykSTei28jwFLQDcDmtofgLw9DpNx4HtcV0zn2WA&oe=6ABA7F2C"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FJMSe2eVaIMQ7kNvwFzmEfY&_nc_oc=AdoOOCUv1Tv6wlvu9lOV6z7djd2qFi27ko4aADzI8fjalN9LFgXfW2sKqWEgFR4T2wQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILuCB9uoQgze1QH7lVW_9r4uqPFQzeBTc9tEGIMYnN5Q&oe=6ABA821D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCr20NveqygQ7kNvwElmyo-&_nc_oc=AdpH6j4qmF960uQkp8VXxUBkh5B3QG_g_LH2Apn2CCvOLYFDP5yxLyrw4AOlOVxXPOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ1Kx7oom5sF-4s4X10EYSobO5azJJsXDb0IGdshjcAA&oe=6ABA5B41"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
771-25/491819854_714814881698959_4268238628018595870_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoPdWVAAuHIQ7kNvwF83FSF&_nc_oc=AdpDrnpf_IrCgFbnDc5dgy5IXY-2vVZUB0j4gCRWn8Zu28aqTx1sLP8D4hDXBXt3CJo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-8T0CDmPhaPFCOOJVDfsJEpWAezHkk9KrUOjAlT0rfQ&oe=6A92CA86"}, {"file_name": "3.1.png", "id": "658899647188997", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820441_658899650522330_6083310252468858129_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNTCdYekuKkQ7kNvwGffOhb&_nc_oc=AdrAMMXcXkKxh4FtJrAz5FNpoY035P58PRowlLp5TaX4KXWnRt2AGdrE19J4sSOCFFM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGClPtiPERr9TZ566ztP1Cq536_LigWgpu3-LF1x-tyeA&oe=6A92E550"}, {"file_name": "4.1.png", "id": "4290448157944020", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824322_4290448161277353_2149823647130253547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yn2LB91M-VAQ7kNvwEGLhIK&_nc_oc=AdrkwpuUdvFvCoRI1FBGt3BNq667uYQSWBKYYDzmSvWzasSf8G9CHC-KjfwVXLMBbto&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXY5cFVIpJIi74wA2Y-HWoX7i6_2BKGvAhiMRGYKw0ww&oe=6A92B9EC"}, {"file_name": "5.png", "id": "3617929708515131", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_3617929715181797_2777453475395998603_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNhOpOPpL1gQ7kNvwFmmQxI&_nc_oc=AdqgeusQwcCkj7pNxLdFTgfazGL-UMPqovOAWVtMLgLB0q8rPNGnSgUDgfzhrVJzqvk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEdIw_Kii3pRllKsi4ArH0FcIWI5on6ZLvTHllJpuhMZQ&oe=6A92BCDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1312249583777620", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623295_1312249587110953_9004715186755225988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghCWIeMiJ5YQ7kNvwEm-JZ2&_nc_oc=AdqCcW4F01YLF4GvCmIXNEhlGPVXJJP4KwkNPlUILQYcJQvbaCA7VzTJ2MuCIAtkjTg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbqKluo0TqFd0xCRE45vtG_gabHj3huMDahfbFCKlExA&oe=6A92CE41"}, "display_name": "RaceFault VR  Car Racing", "keywords": ["vrracing", "arcaderacing", "driftracing", "futuristicracing", "carcustomization"], "long_description": "RaceFault VR Car Racing \u2014 arcade drift racing built for Meta Quest\n\nGrip the wheel, hit the nitro, and slide through 10 high-speed tracks in a VR racing game made for pure arcade fun. No simulator learning curve \u2014 just fast cars, tight drift lines, and lap times worth chasing.\n\nRACE 10 HIGH-SPEED TRACKS\nTear through neon city highways, volcanic lava cliffs, cyberpunk skylines, and anti-gravity loops. Every circuit has its own racing line, shortcuts, and cornering rhythm to learn.\n\nDRIFT, BOOST, REPEAT\nChain drifts through hairpins to build nitro. Launch out of corners with turbo bursts. Clean cornering means faster laps \u2014 and faster laps mean bigger rewards.\n\nUNLOCK AND UPGRADE 6 CARS\nSix cars, each with its own speed, grip, and handling feel. Spend earned coins on performance upgrades, then make it yours with skins, nitro kits, and horns.\n\nAI COMPANION RACERS\nYour AI rivals react to perfect drifts, near misses, and win streaks \u2014 so every race feels alive instead of scripted.\n\nCLIMB THE GLOBAL LEADERBOARDS\nPost your lap times, compare against racers worldwide, and come back to shave off another tenth of a second.\n\nBUILT FOR COMFORTABLE VR\nDesigned for smooth VR racing in short sessions or long runs. Comfort rating: Moderate.\n\nCompatible with Meta Quest 2, Quest 3, Quest 3S, and Quest Pro.\n\nStart your engine and take the first corner.", "short_description": "Arcade VR racing game: drift, boost and chase lap records across 10 high-speed tracks. Unlock 6 cars, upgrades and skins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/racefault/", "developer_terms_of_service_url": null, "publisher_
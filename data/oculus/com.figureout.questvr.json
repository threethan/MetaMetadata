ame": "screenshot2.png", "id": "834702447387437", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031354_834702450720770_9103368305713790983_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1p840IJ7n8Q7kNvwE1rcEA&_nc_oc=AdrA3LuHlpcnLqUt93NfKAVm0GGbIvQck1EBRcRjSR88fBxkl1etNUdF_UUj1d9Sbqw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u554-wkRwVZY9_yyQbkI8seZIvLN6PqjOd11Iy71mwA&oe=6A453911"}, {"file_name": "screenshot4.png", "id": "133351025301321", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75294236_133351028634654_7866780456214987147_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad5ajsGYdswQ7kNvwG3lchk&_nc_oc=AdphBx_CAMR9mQF6qHfQLQ4oVwqCI3n4guCxeD3j_8RUEH3vX-D3zvyb-Jn9OjwwPWg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QsTz-2C5XK2QRZjKQywbNVH9IhqwlJvFlc7sF3nvnCQ&oe=6A452DE9"}, {"file_name": "screenshot3.png", "id": "424898228825571", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75303838_424898232158904_8057494205377644656_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soVFEjpTNykQ7kNvwGjBVoq&_nc_oc=AdoILvVbj7P0th6qxI4BuFmGFB9BLV-41l6NmDIhocnoL-ki8rF8wUw2TBDd605a_VQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8Kx1cV78FLDzKyid0z2fUorDaOZGDkEkq6hwSKRLY8w&oe=6A453153"}, {"file_name": "screenshot5.png", "id": "257663129204712", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75422370_257663132538045_3715272386866238300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpfYjSw2gsAQ7kNvwHXmxDo&_nc_oc=Ado3QXDiyi_wy0ByKuhOGM8Uz_ASSVO8qB-sJoc_tFJwLOhlwloZtHyrlv5qKV0XhYc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HX2IbDtxauwrpUM4Fx3DVd-7hz9lZ2nrtmoN2Z27OOg&oe=6A450F4A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FigureOut VR", "keywords": [], "long_description": "Use the given Figures to fill the empty Fields . Use the Touch Controllers or the Game Menu to control the music. \nFull Room-Scale with different zoom stages.\nJust fill all the empty wood blocks with the given figures to advance to the next level.\n\nPlease copy your music files by making a new folder called figureout inside the music folder.\n\nFeatures: \n- 100 Levels\n- Easy to pickup\n- Use your own Music\n- Full Oculus Touch controller support\n- Dark and light background to choose from (B/Y Button)\n- Different scale sizes\n- Two different difficulties\n\nController Mapping:\nA/X Button: Open menu\nB/Y Button: Dark/Light Background\nUse both Grab Buttons to control the camera\nBoth Joysticks:\nUp/Down: Scale scene\nPress: Play/Stop Song\nRight/Left: Next/Previous Song\nPress both Trigger Buttons when a level is solved to quickly advance to the next level", "short_description": "Relaxing little Puzzle Game. Use the given Figures to fill the empty Fields and listen to your Music."}]}, "developer_name": "Daniel Ali", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/04e10ea4-a388-4539-a810-86f7c0a95368", "developer_terms_of_service_url": null, "publisher_name": "Daniel Ali", "support_website_url": null, "website_url": "https://discord.gg/gJ84k4t4", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "679024369942838"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221330_327057968648180_880688
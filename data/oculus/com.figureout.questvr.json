c_oc=AdrzO7AP7DOuDscVWzSO4IfShPMRn5KH2yusndoWX1B1CWUHRW3XBTJHTaHyRxL8adE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZIdHffu7d8VEhF8Da03d7SGEMfEkNfL7-uYtCq4PEhg&oe=6B0DB553"}, {"file_name": "screenshot2.png", "id": "834702447387437", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031354_834702450720770_9103368305713790983_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6CHdrG1owEQ7kNvwH_Wdfi&_nc_oc=Adq-YXENv8aZqjUH_MCEaGcFG81VDl7WxJLHkRv2sVP2iqd0D01Cltzh7OXJzM7dCC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSHXEYSD4xeV-TobkFH1JKPuJS7aUjDmIrxqU6GRNBrjA&oe=6B0D9D11"}, {"file_name": "screenshot4.png", "id": "133351025301321", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75294236_133351028634654_7866780456214987147_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LV77boAoUpMQ7kNvwGvSDDy&_nc_oc=AdopPV3P1lLyUlqFmLCqtNK5qabvPThlCRB2VRK-nx-DIXYBAaBTZLqDm6ikjetXKtA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSeBYj1njFil_bwLmDTgjFg-cMto9Vv-NtM44XtKZrdAA&oe=6B0DCA29"}, {"file_name": "screenshot3.png", "id": "424898228825571", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303838_424898232158904_8057494205377644656_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxTkhir37bAQ7kNvwGqgN9i&_nc_oc=AdrgvnSTiK-lQHpmbKku9QVsz00OwB4PBotwBZQI7mXmEWfCur98F8JLmypdON3QjjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3EePKxUTwBhMILUIhb7wklx1Ad7C7K_Lh0WeeuzSDuA&oe=6B0DCD93"}, {"file_name": "screenshot5.png", "id": "257663129204712", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75422370_257663132538045_3715272386866238300_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTIZhBLAhbYQ7kNvwF8UVjJ&_nc_oc=AdqOgUIyEkqw1r6VGfzC5uoY7JWcO-pAn2FoJqq9sHthvdLeIF4oov02qU1sw38d7mE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhijAIePxoVTT2VOMgkU1-iLVlHb-IIg7aqodolPgsnA&oe=6B0DAB8A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FigureOut VR", "keywords": [], "long_description": "Use the given Figures to fill the empty Fields . Use the Touch Controllers or the Game Menu to control the music. \nFull Room-Scale with different zoom stages.\nJust fill all the empty wood blocks with the given figures to advance to the next level.\n\nPlease copy your music files by making a new folder called figureout inside the music folder.\n\nFeatures: \n- 100 Levels\n- Easy to pickup\n- Use your own Music\n- Full Oculus Touch controller support\n- Dark and light background to choose from (B/Y Button)\n- Different scale sizes\n- Two different difficulties\n\nController Mapping:\nA/X Button: Open menu\nB/Y Button: Dark/Light Background\nUse both Grab Buttons to control the camera\nBoth Joysticks:\nUp/Down: Scale scene\nPress: Play/Stop Song\nRight/Left: Next/Previous Song\nPress both Trigger Buttons when a level is solved to quickly advance to the next level", "short_description": "Relaxing little Puzzle Game. Use the given Figures to fill the empty Fields and listen to your Music."}]}, "developer_name": "Daniel Ali", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/04e10ea4-a388-4539-a810-86f7c0a95368", "developer_terms_of_service_url": null, "publisher_name": "Daniel Ali", "support_website_url": null, "website_url": "https://discord.gg/gJ84k4t4", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
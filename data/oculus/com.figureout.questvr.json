834702447387437", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031354_834702450720770_9103368305713790983_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9kZXlw5O6sQ7kNvwG8kXa0&_nc_oc=Adk7FuMM-6DppVqb9LBjXrbH_v6p8_q6ziE2BZ3WKrz9EAAkEgk27TgrGC8kBRRDPeU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyjjX9OlpVDgBLhdU3KNen7eUlgE8lTUA__osZbml_4RQ&oe=69B2AA51"}, {"file_name": "screenshot4.png", "id": "133351025301321", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75294236_133351028634654_7866780456214987147_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfUAO2m29GwQ7kNvwEJi7Ql&_nc_oc=Adl5M9iKc5lrFUGtl7-m-MBTZylJOTQJN1k6EArqAyVf2zVb5edHUIfW8_G_rWolYpc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqMEb6EEEqmeRv3pt7SWUPmyje4qwGwLzb91rDkYOORA&oe=69B29F29"}, {"file_name": "screenshot3.png", "id": "424898228825571", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75303838_424898232158904_8057494205377644656_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udu27o_No4oQ7kNvwFUZ8tg&_nc_oc=AdmaZOMVA8o6n54Ae7Ntf0CO1wjUT8YF3qnlOVwvq5oAvldDFhyxnbg4F50jpps1TWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_jkSwxbiIVx--5D36bxIaGM-n2aV4dEvR1obQLKV3EA&oe=69B2A293"}, {"file_name": "screenshot5.png", "id": "257663129204712", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75422370_257663132538045_3715272386866238300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gD0nnmkfWrIQ7kNvwGrooK7&_nc_oc=AdkDIg_9HvruWu1maj0ID8PLRWCWI319En8Vn5_4Pdq3Fdw0xu8LYcwA4AFnhFaIMZ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw6v2iUcfS_G8roZ7JkFFkFk4LVfdJtxRbb60_ZUYkIYw&oe=69B2B8CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FigureOut VR", "keywords": [], "long_description": "Use the given Figures to fill the empty Fields . Use the Touch Controllers or the Game Menu to control the music. \nFull Room-Scale with different zoom stages.\nJust fill all the empty wood blocks with the given figures to advance to the next level.\n\nPlease copy your music files by making a new folder called figureout inside the music folder.\n\nFeatures: \n- 100 Levels\n- Easy to pickup\n- Use your own Music\n- Full Oculus Touch controller support\n- Dark and light background to choose from (B/Y Button)\n- Different scale sizes\n- Two different difficulties\n\nController Mapping:\nA/X Button: Open menu\nB/Y Button: Dark/Light Background\nUse both Grab Buttons to control the camera\nBoth Joysticks:\nUp/Down: Scale scene\nPress: Play/Stop Song\nRight/Left: Next/Previous Song\nPress both Trigger Buttons when a level is solved to quickly advance to the next level", "short_description": "Relaxing little Puzzle Game. Use the given Figures to fill the empty Fields and listen to your Music."}]}, "developer_name": "Daniel Ali", "developer_privacy_policy_url": "https://www.privacypolicies.com/live/04e10ea4-a388-4539-a810-86f7c0a95368", "developer_terms_of_service_url": null, "publisher_name": "Daniel Ali", "support_website_url": null, "website_url": "https://discord.gg/gJ84k4t4", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "679024369942838"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75221330_327057968648180_8806883476560227422_n.png?stp=dst-png_s360x360&_nc_cat
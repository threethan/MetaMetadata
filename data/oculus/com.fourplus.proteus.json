com&_nc_ss=8&oh=00_Afy0l-LEP7LdQ779bKa_EhdoOnKStGhtwf8xNFxL5aRegQ&oe=69B6ABC6"}, {"file_name": "screenshot4.png", "id": "657728022184836", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974878_657728025518169_8063317913280581323_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wv_MZRmlibgQ7kNvwH6MKdB&_nc_oc=AdlcAG57dtInADeP3MpJTqcc7U5Xbd4-3M57eZt-PelKakmLkz5OqZaBMSRvk9-fL_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5rl3EwqN37XY2xOchPHltLaQfTLxLtfSBJ_Fqq58F-g&oe=69B6BACF"}, {"file_name": "screenshot5.png", "id": "1208276223454681", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75250455_1208276233454680_6602265455870345001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_OJqN8Soi4Q7kNvwHhhEnX&_nc_oc=AdnVmUxBSIX9Vt7Oee8OPriqG0yihEOKaq8rFmC_mGQBFBL66KQE01dhUIoiRNXzNvA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmleNW3Unj-WAKp17GvNRHW5r4NHFhjKUd4CD5nlN89w&oe=69B6A469"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusCoverLandscape.png", "id": "5189054964536921", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75298473_5189054967870254_2682894235054571592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42_xi7LuIY8Q7kNvwGM7FxK&_nc_oc=AdmAAALR3TZoHWPN3E-DHge6D0AQwJ6sCmxxRZduTWE3boMsxV_IcR7oWYs-s-ObqDg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTcCSuq7DjxvIiWsOV4raHL5Y-019qSHQ_3jFMxRbsnw&oe=69B69434"}, "display_name": "Proteus", "keywords": ["Science", "Biology", "Laboratory", "Medicine", "Vaccine"], "long_description": "Proteus is a learning & engagement app that introduces students to the world of advanced cell & gene therapies.\n\nDraw the link between life-saving medicines and careers in advanced therapies development & manufacturing.\nLook inside a production room from a real manufacturing facility.\nBring classroom learning to life by exploring a cell suspension and the inside of a human cell, contextualising information from biology class.\n\nUse Proteus to generate excitement around cell & gene therapy jobs at careers and recruitment events. Use in classrooms as an immersive and engaging learning experience.\n \nFourPlus Immersive create VR for the life science sector, combining expertise in advanced therapies & immersive technology to create impactful tools for training, marketing & recruitment.", "short_description": "Introducing the world of advanced cell and gene therapies and what it means to work in medicines manufacturing. For engagement, outreach, recruitment and education. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/proteus-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26396989106604269"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75251817_1550123908768756_7331441547979334711_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqjGYmtaGwgQ7kNvwG4keC5&_nc_oc=AdnHsGjM9m-XUlQHj71Swn3w5KWv-vElSu5yc5rzWJrVLggMAS8fn4FJnksznPKIF80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxE2esxUflX0j9jpe3TdxobkquW2A2y8zUtGXH8WVxOxg&oe=69B6A453"}, "is_concept": false
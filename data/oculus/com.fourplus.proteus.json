nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOO759dJgjcBvWfBv4hqlwn9qhTP4iXoe-qEAizS4YUkg&oe=6AE5E4C6"}, {"file_name": "screenshot4.png", "id": "657728022184836", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974878_657728025518169_8063317913280581323_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_ls8E6aeEcQ7kNvwHPorFg&_nc_oc=Ado3ebONCY20ETxhmt7ehRhYqGR49MUKQZuVSv-Wt63SKhtASyqGFnIKRf_4Ygg7lFw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnIwtO9N43DsPK3jPtVMn2BwloiwXR_IjPCNF9lvDnJA&oe=6AE5F3CF"}, {"file_name": "screenshot5.png", "id": "1208276223454681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250455_1208276233454680_6602265455870345001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSvFve7qBhUQ7kNvwF7baiE&_nc_oc=AdrbYR8mmNs_Zkko23BE7mqKRd2-WZCHBVkoBsmROCrsUm1a8Uyit-Y-Skt2NYw3h1w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7jlw5cs3-nNOHqzXaBTFjLyTzbW8iUpKxvbeQEyAeLg&oe=6AE615A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusCoverLandscape.png", "id": "5189054964536921", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75298473_5189054967870254_2682894235054571592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uku9xiUj55YQ7kNvwHCmBz7&_nc_oc=AdpFO11tMR0n6X075fyZ1FHbatChjYqyn_hEwUE0u8hA8dvqS691cHEnG8gdsS0rrjw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzgbDwnd-VRP0vM8nRJgbMxEATwd61R5_wxXxRY_DpyA&oe=6AE60574"}, "display_name": "Proteus", "keywords": ["Science", "Biology", "Laboratory", "Medicine", "Vaccine"], "long_description": "Proteus is a learning & engagement app that introduces students to the world of advanced cell & gene therapies.\n\nDraw the link between life-saving medicines and careers in advanced therapies development & manufacturing.\nLook inside a production room from a real manufacturing facility.\nBring classroom learning to life by exploring a cell suspension and the inside of a human cell, contextualising information from biology class.\n\nUse Proteus to generate excitement around cell & gene therapy jobs at careers and recruitment events. Use in classrooms as an immersive and engaging learning experience.\n \nFourPlus Immersive create VR for the life science sector, combining expertise in advanced therapies & immersive technology to create impactful tools for training, marketing & recruitment.", "short_description": "Introducing the world of advanced cell and gene therapies and what it means to work in medicines manufacturing. For engagement, outreach, recruitment and education. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29024443133858840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75251817_1550123908768756_7331441547979334711_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMb3xkKvaL4Q7kNvwEB1cip&_nc_oc=AdoqhAa8wzFbuqqi7_WWIAt7oDbfgR5DVOml-Ql4OCAZo9aC11Uq17ejTAQyLwMPFDM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUa9XETkDx8aUExhKq5lzLMxNpyfHW-kVpsS
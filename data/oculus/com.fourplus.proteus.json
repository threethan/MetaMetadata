nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1vKD-BfKD448HQKZJyWSsRq6CBz1_udrePBSeGzGbqg&oe=6AF34C06"}, {"file_name": "screenshot4.png", "id": "657728022184836", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974878_657728025518169_8063317913280581323_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfv6KrCrUPUQ7kNvwGQoc_i&_nc_oc=AdoBbxRP73CrudpjJVqc_AKJt5vRXh-vdrxP-pagSmy-Hv58SqmKWyHuZJNlsbtA2i8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcK64yW1HN60VUHX2UoDTND0tpPrf8WS02lYoHEKr7Vw&oe=6AF35B0F"}, {"file_name": "screenshot5.png", "id": "1208276223454681", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75250455_1208276233454680_6602265455870345001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjCTyZuaDWwQ7kNvwEp-MwS&_nc_oc=AdqV3LrFX_WWO-nOCIXr2a5z5h41iWkYNdDI7XRoyT17DSDR-47Z83rqOVeRMI_2jpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREApZwoRnXS99ubLNIRCaaCK_Sgla-gnLt1GJ8XtVcdA&oe=6AF344A9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusCoverLandscape.png", "id": "5189054964536921", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75298473_5189054967870254_2682894235054571592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTWYbbUD5N0Q7kNvwEhHBLz&_nc_oc=AdpwwtthU1Qfj_SSL0_47v0ITZ5ZLCrrtFlM69HwFghMPFwyOFMAqVlE0mwvWmE4Vcs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpiea7RRY2DFcU3xtHzt6q-OZk0C8aYbOCJ056FkLS6Q&oe=6AF33474"}, "display_name": "Proteus", "keywords": ["Science", "Biology", "Laboratory", "Medicine", "Vaccine"], "long_description": "Proteus is a learning & engagement app that introduces students to the world of advanced cell & gene therapies.\n\nDraw the link between life-saving medicines and careers in advanced therapies development & manufacturing.\nLook inside a production room from a real manufacturing facility.\nBring classroom learning to life by exploring a cell suspension and the inside of a human cell, contextualising information from biology class.\n\nUse Proteus to generate excitement around cell & gene therapy jobs at careers and recruitment events. Use in classrooms as an immersive and engaging learning experience.\n \nFourPlus Immersive create VR for the life science sector, combining expertise in advanced therapies & immersive technology to create impactful tools for training, marketing & recruitment.", "short_description": "Introducing the world of advanced cell and gene therapies and what it means to work in medicines manufacturing. For engagement, outreach, recruitment and education. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29024443133858840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75251817_1550123908768756_7331441547979334711_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YuP4B2ldaRsQ7kNvwF3sfzf&_nc_oc=AdrOsaP5xCjqpnZa03LQVoX3sQm_MbFWS3huv-yLlRtTIkaf423SDo4q-34mN7I6myQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmLmAvUvQZ7eqgjXJzKfUa_Iy24orTaWSdFI
20f&oh=00_AQRsyQfgSFwL0aYg3V4ec06wAVJPAlPs4lUBeonIqpGDcA&oe=6AE7454F"}, {"file_name": "screenshot5.png", "id": "1208276223454681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250455_1208276233454680_6602265455870345001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSvFve7qBhUQ7kNvwFf5VCS&_nc_oc=Adqf119EThZqJ2iX54EILh-QAa6Prt7p9t2Hyzp4LloLInT_6mnHPpY5HtOuxZGGwcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwew2Z5dp_Pj46N8lwwdjnQTPmOuALjdiZx2sR0UPjXw&oe=6AE76729"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusCoverLandscape.png", "id": "5189054964536921", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75298473_5189054967870254_2682894235054571592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uku9xiUj55YQ7kNvwGKz7TM&_nc_oc=AdqumtP0bI0sKaAwUM9-FiF75v7KCKuDYqSf0PQ05zvefhyvh_ICoWByMQz8sgU9-Q4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7Yp03uXhIXVZ9Pzx6PxOfMuqc9q5TBn-vcK8uZa0_aA&oe=6AE756F4"}, "display_name": "Proteus \u2013 Cell & Gene Therapy Experience", "keywords": [], "long_description": "Proteus is a learning & engagement app that introduces students to the world of advanced cell & gene therapies.\n\nDraw the link between life-saving medicines and careers in advanced therapies development & manufacturing.\nLook inside a production room from a real manufacturing facility.\nBring classroom learning to life by exploring a cell suspension and the inside of a human cell, contextualising information from biology class.\n\nUse Proteus to generate excitement around cell & gene therapy jobs at careers and recruitment events. Use in classrooms as an immersive and engaging learning experience.\n \nFourPlus Immersive create VR for the life science sector, combining expertise in advanced therapies & immersive technology to create impactful tools for training, marketing & recruitment.", "short_description": "Introduce students to the world of advanced cell and gene therapies and what it means to work in medicines manufacturing. For engagement, outreach, recruitment and education. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/proteus/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/proteus", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "853658545834044"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1108613121034122"}, {"status": "PUBLISHED", "id": "915630422760914"}]}, "baseline_offer": {"id": "1108613121034122"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742487300, "status": "PUBLISHED", "id": "1108613121034122"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24237635492539652", "version": "1.0.2"}, "id": "1558614247891961", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5757341224329026", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24237635492539652"}, "release_status": "RELEASED"}, "binary_release_channels":
nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiWsFZluCGUaS2M1WXjtwLDRf9AZUpCqaYOrXzYDSv1g&oe=6AC13306"}, {"file_name": "screenshot4.png", "id": "657728022184836", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974878_657728025518169_8063317913280581323_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIy0fCf8_lgQ7kNvwEyIhFp&_nc_oc=AdoTFhVIiweRa3SYHRq5CekT_V9GjOhAAHFcmhQKVKJ1gY-0W0VHoxYzScWR3LzupQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMy0N9LwYTYAgCGZAS0w5HT6umHOJehpI68hCD5RkiPUw&oe=6AC109CF"}, {"file_name": "screenshot5.png", "id": "1208276223454681", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250455_1208276233454680_6602265455870345001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwEc_uiWuWMQ7kNvwGmH8gh&_nc_oc=AdoNlG0thF6L40bsUS-qIIqbszPFBPnykwPoDBduZZN2e8F70lTfWfguHCc_HHUvsks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyJuQquHZJ47iwW8tYHvFdZ02jhCk3wf34pKbw0zgOKw&oe=6AC12BA9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusCoverLandscape.png", "id": "5189054964536921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298473_5189054967870254_2682894235054571592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erFukJAfqE8Q7kNvwF4OGKG&_nc_oc=AdrZdbDyKXbxA9wSdvts64_dn24iqx_OSYkfPI9tsBYRa8UUBEWmKEZI267p6YpcyLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5moPD5Ya1HYM6CBNy-YYXsFFdNaibwbzHF59g-3h56Q&oe=6AC11B74"}, "display_name": "Proteus", "keywords": ["Science", "Biology", "Laboratory", "Medicine", "Vaccine"], "long_description": "Proteus is a learning & engagement app that introduces students to the world of advanced cell & gene therapies.\n\nDraw the link between life-saving medicines and careers in advanced therapies development & manufacturing.\nLook inside a production room from a real manufacturing facility.\nBring classroom learning to life by exploring a cell suspension and the inside of a human cell, contextualising information from biology class.\n\nUse Proteus to generate excitement around cell & gene therapy jobs at careers and recruitment events. Use in classrooms as an immersive and engaging learning experience.\n \nFourPlus Immersive create VR for the life science sector, combining expertise in advanced therapies & immersive technology to create impactful tools for training, marketing & recruitment.", "short_description": "Introducing the world of advanced cell and gene therapies and what it means to work in medicines manufacturing. For engagement, outreach, recruitment and education. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/proteus-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26396989106604269"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75251817_1550123908768756_7331441547979334711_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRa8rcXx4mcQ7kNvwE3cVm1&_nc_oc=AdrLadbPiYlAYsc91AvPM0h89oggxqT8Z_mBve0GFKfvaSptg3Okc-Ef662vrO9FmUA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOa8burkFAEHHRBiiDkph7vo_Gdg
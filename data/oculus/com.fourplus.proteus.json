_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsp9qA4JsH4Q7kNvwHD5Q4S&_nc_oc=Adksb-YUjZvJWfSWIK_5JpJPO0Uvho9j5RHWpUeYkSRpZkGW3iCDpkZsQTv1vBBkSJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftBCwUXyl66_mD8JT0u4xiZLX4lpboKp31I9thFQs0Juw&oe=69A03AE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusCoverLandscape.png", "id": "5189054964536921", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75298473_5189054967870254_2682894235054571592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12PJ2pwVqcMQ7kNvwGPumii&_nc_oc=Adl7vRSzRRoegN7c9EOSN9gJBfJD6nPRqBqa_JNN-ZloFO7-0L8ybK_AH9sZ7pi4fEE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsHNKIuNM1XRxQGCn7LRpu5-ILJ16ICRmtBRuZsmXGXYA&oe=69A02AB4"}, "display_name": "Proteus \u2013 Cell & Gene Therapy Experience", "keywords": [], "long_description": "Proteus is a learning & engagement app that introduces students to the world of advanced cell & gene therapies.\n\nDraw the link between life-saving medicines and careers in advanced therapies development & manufacturing.\nLook inside a production room from a real manufacturing facility.\nBring classroom learning to life by exploring a cell suspension and the inside of a human cell, contextualising information from biology class.\n\nUse Proteus to generate excitement around cell & gene therapy jobs at careers and recruitment events. Use in classrooms as an immersive and engaging learning experience.\n \nFourPlus Immersive create VR for the life science sector, combining expertise in advanced therapies & immersive technology to create impactful tools for training, marketing & recruitment.", "short_description": "Introduce students to the world of advanced cell and gene therapies and what it means to work in medicines manufacturing. For engagement, outreach, recruitment and education. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/proteus/privacypolicy", "developer_terms_of_service_url": null,
screenshot5.png", "id": "1208276223454681", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75250455_1208276233454680_6602265455870345001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cXt9dKlF0swQ7kNvwFD-rP4&_nc_oc=AdnlFpDqiyEob5---iqRXc-037KPLVBehTjgOYOa0-SHrTYRAb11K43P8TltDzjB-Dk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy8usAEWFbygU15_PVWqbGNVk2RSLi6XAJrsApmE9kZhA&oe=69B2AFE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusCoverLandscape.png", "id": "5189054964536921", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75298473_5189054967870254_2682894235054571592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3RJxKqINTcQ7kNvwF3a_Ql&_nc_oc=AdkJrBiU82mSErYMV0hS67API5dTyr4seISkgnlFzbWx75mJq6AHBsBBIJkTCZiL2CE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxryFom2Fznn02t2bh-eCVQ_m9xzliNcXi_DgbxyA3pUw&oe=69B29FB4"}, "display_name": "Proteus \u2013 Cell & Gene Therapy Experience", "keywords": [], "long_description": "Proteus is a learning & engagement app that introduces students to the world of advanced cell & gene therapies.\n\nDraw the link between life-saving medicines and careers in advanced therapies development & manufacturing.\nLook inside a production room from a real manufacturing facility.\nBring classroom learning to life by exploring a cell suspension and the inside of a human cell, contextualising information from biology class.\n\nUse Proteus to generate excitement around cell & gene therapy jobs at careers and recruitment events. Use in classrooms as an immersive and engaging learning experience.\n \nFourPlus Immersive create VR for the life science sector, combining expertise in advanced therapies & immersive technology to create impactful tools for training, marketing & recruitment.", "short_description": "Introduce students to the world of advanced cell and gene therapies and what it means to work in medicines manufacturing. For engagement, outreach, recruitme
nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNodDnhZAKXfd5eJb5qCe0xeqkZxLXDYt5WB6F4XlMnpQ&oe=6AE49346"}, {"file_name": "screenshot4.png", "id": "657728022184836", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974878_657728025518169_8063317913280581323_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_ls8E6aeEcQ7kNvwEgwRj5&_nc_oc=AdrTTyDd_klRC-0ZvqNSTxQDGfmMLM8zSU63wzxjG4p-bI2R3yaZH1OqfxGwjXYNF1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNoWzt2aKepWQh8NOXreTdn-GSj6RP-LINAScxavG4pA&oe=6AE4A24F"}, {"file_name": "screenshot5.png", "id": "1208276223454681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250455_1208276233454680_6602265455870345001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK-WT9cd520Q7kNvwHquEix&_nc_oc=AdrojKP0HkO0aYe2RSwqFwHK1-uOWIyxt2H0xStqZxNlxwPAYcBfcLo49JJ-BGAiyOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOm7k0HuytcfaAR3vCtENhnnEw6dSoaUnZNsaDPMQDnDQ&oe=6AE48BE9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusCoverLandscape.png", "id": "5189054964536921", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75298473_5189054967870254_2682894235054571592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uku9xiUj55YQ7kNvwGArMsJ&_nc_oc=AdqyTmI-JDl76qtw_Gc7mEsFB50cLgoXhSqeIXlsKyaekbbS7CpY5C_kdlCIB9hMHcg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXzXRzxdf_wgLN95dtxycnr-9IeVSoPq9sR2P8yoZssg&oe=6AE4B3F4"}, "display_name": "Proteus", "keywords": ["Science", "Biology", "Laboratory", "Medicine", "Vaccine"], "long_description": "Proteus is a learning & engagement app that introduces students to the world of advanced cell & gene therapies.\n\nDraw the link between life-saving medicines and careers in advanced therapies development & manufacturing.\nLook inside a production room from a real manufacturing facility.\nBring classroom learning to life by exploring a cell suspension and the inside of a human cell, contextualising information from biology class.\n\nUse Proteus to generate excitement around cell & gene therapy jobs at careers and recruitment events. Use in classrooms as an immersive and engaging learning experience.\n \nFourPlus Immersive create VR for the life science sector, combining expertise in advanced therapies & immersive technology to create impactful tools for training, marketing & recruitment.", "short_description": "Introducing the world of advanced cell and gene therapies and what it means to work in medicines manufacturing. For engagement, outreach, recruitment and education. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29024443133858840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75251817_1550123908768756_7331441547979334711_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMb3xkKvaL4Q7kNvwFaEBT0&_nc_oc=AdobgQD3ncrt5Y9HOSBiRN1OOzbQe5N9oD4Z1P3snafdbAFB09gXcvQg-O7KIekTxR8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9p8tWngNJsNuZCPgce_mJw2L4C2vh-8gbcY
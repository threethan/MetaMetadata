nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfyO12j2SzwVJTlUHwblOdev9qCJyAl3PvXMr6t5MlDg&oe=6AE341C6"}, {"file_name": "screenshot4.png", "id": "657728022184836", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974878_657728025518169_8063317913280581323_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdqJLnZz3skQ7kNvwHQlftQ&_nc_oc=AdoZn1v_g0SKIt0d_o_PMI5aHXGlRxZtT8kCJm2JAkbi9MVh-tIBWD2NCHWKYJdl_lI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqb9qBGOcBwCYBUIjC6eBA_N-xdT6FSGjb28CMw0qQWg&oe=6AE350CF"}, {"file_name": "screenshot5.png", "id": "1208276223454681", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75250455_1208276233454680_6602265455870345001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK-WT9cd520Q7kNvwH7v9Ij&_nc_oc=Adq3QZgGh3LQCw0SjNfq2X_81tGRBLu1KkhEqIg8vaMp-Mbb1ILd2WSMh06YRGbgMtE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNs5lGeZpm31OS7WfhGdKfkma8bYT5la8Uy3MwVjBKXQg&oe=6AE33A69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusCoverLandscape.png", "id": "5189054964536921", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75298473_5189054967870254_2682894235054571592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRRQ4NfYaeoQ7kNvwHoZJID&_nc_oc=AdrRgNaW57yP2kAJF0EUZresRcYOYlZtF_O2uW8saUE1qIZF6AOdDKcdTBl1frhbUwg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN20mfvWsS_zW3iOz8QuU1DuL9WbhOJTu8DrteFLDhSCQ&oe=6AE36274"}, "display_name": "Proteus", "keywords": ["Science", "Biology", "Laboratory", "Medicine", "Vaccine"], "long_description": "Proteus is a learning & engagement app that introduces students to the world of advanced cell & gene therapies.\n\nDraw the link between life-saving medicines and careers in advanced therapies development & manufacturing.\nLook inside a production room from a real manufacturing facility.\nBring classroom learning to life by exploring a cell suspension and the inside of a human cell, contextualising information from biology class.\n\nUse Proteus to generate excitement around cell & gene therapy jobs at careers and recruitment events. Use in classrooms as an immersive and engaging learning experience.\n \nFourPlus Immersive create VR for the life science sector, combining expertise in advanced therapies & immersive technology to create impactful tools for training, marketing & recruitment.", "short_description": "Introducing the world of advanced cell and gene therapies and what it means to work in medicines manufacturing. For engagement, outreach, recruitment and education. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29024443133858840"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75251817_1550123908768756_7331441547979334711_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpu_h9tE0l0Q7kNvwFWvvTG&_nc_oc=AdoljBsaGIHigBVu6r5Z_MLb35zfrNUxZ6KuIcecQZZx7K3FuxxwT-inwrEmjpf47Io&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNan-lRAKOOGVh2ZZoKXFPVFGlyoGZd1jfoxz
nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KAxkZtSz4BCtVDCa_ZLR8VZFbnbbS2qv20p9S0bvPMQ&oe=6A16E946"}, {"file_name": "screenshot4.png", "id": "657728022184836", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974878_657728025518169_8063317913280581323_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UKc288s5vAQ7kNvwF-fOVW&_nc_oc=Adrej0EMzd9lXrQb0xaHhSBQQC1mwY4-XP4TARB0SYz6hBAVPYt3RHnzdeOjt07Btk0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56nSWGe8-S_plUxb7DRm_3toQPHwNGmvW-QnwkFtJMxQ&oe=6A16F84F"}, {"file_name": "screenshot5.png", "id": "1208276223454681", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75250455_1208276233454680_6602265455870345001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hts4A2S4yr0Q7kNvwFEym5Y&_nc_oc=Adq3_9cK6Y_MbhKGFw0yejz6Cq7tgN2yrHljgEPtPE4Q1ZLLpBrxmiZFbqDPF36Zc08&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mJJpAKN55aNzL83h8fgJsHnGpixllvAu3sG19x6L7uQ&oe=6A16E1E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusCoverLandscape.png", "id": "5189054964536921", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75298473_5189054967870254_2682894235054571592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QLpmoWd6dkQ7kNvwFZ3UXV&_nc_oc=Adpp7XuUmgn7uJwMEcmHcQZlQfCtDvNMjPZKNB6oIeAmaqPdjnoHIkgiD3FZRra6nQg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dXSIfu05ctUyOVJmPZZLC4tpYFI7V950MvqQYsmV1Nw&oe=6A1709F4"}, "display_name": "Proteus", "keywords": ["Science", "Biology", "Laboratory", "Medicine", "Vaccine"], "long_description": "Proteus is a learning & engagement app that introduces students to the world of advanced cell & gene therapies.\n\nDraw the link between life-saving medicines and careers in advanced therapies development & manufacturing.\nLook inside a production room from a real manufacturing facility.\nBring classroom learning to life by exploring a cell suspension and the inside of a human cell, contextualising information from biology class.\n\nUse Proteus to generate excitement around cell & gene therapy jobs at careers and recruitment events. Use in classrooms as an immersive and engaging learning experience.\n \nFourPlus Immersive create VR for the life science sector, combining expertise in advanced therapies & immersive technology to create impactful tools for training, marketing & recruitment.", "short_description": "Introducing the world of advanced cell and gene therapies and what it means to work in medicines manufacturing. For engagement, outreach, recruitment and education. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/proteus-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26396989106604269"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75251817_1550123908768756_7331441547979334711_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4JR7f09ksIQ7kNvwGdaqDW&_nc_oc=Adq1vHG21MqzIcl0VfTIsD0Ut8ss7r8yAlJoVJK-1GDNJgm1jhjaO-ZS-p-3vV0og1o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DByFaiC4bQIcs3OA3kblexZhSg
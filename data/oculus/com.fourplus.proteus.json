=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIt10W2PuruSZ3Pvyef7kpqd69pCWfczdtwaBbyjz-AhA&oe=6AAE85C6"}, {"file_name": "screenshot4.png", "id": "657728022184836", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974878_657728025518169_8063317913280581323_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5nmHyhrzuwQ7kNvwGs5JoQ&_nc_oc=Adq4ZNcYyiH3lgblr0QHTHdeakWk-3FJ4n0i2pSZCTdhmcpT5iHD9OVpfHcujNraVO0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmegK07H1pr_pBoBx4xtOQ94934mFsQPXHel6bYJbb0Q&oe=6AAE94CF"}, {"file_name": "screenshot5.png", "id": "1208276223454681", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75250455_1208276233454680_6602265455870345001_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEg2GfDzqPsQ7kNvwFiJOHW&_nc_oc=AdrmlrixNbCNKyHji2ffkkDqhWwDmI9oGg8GFbwxdAtss3Yk77D8JiXNKS2cAnTtfb0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOwPpGV7fHg5gWQLWLo7GWhMghStJMfV8gkNKo7aa-BA&oe=6AAE7E69"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ProteusCoverLandscape.png", "id": "5189054964536921", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75298473_5189054967870254_2682894235054571592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4U8_69BBl1oQ7kNvwHmoWfr&_nc_oc=AdpxlyMU0TEoRnAMlPBcxrn6w0mNUY_5aR4sUnc1zGvu_LDiH-zwOGXQntB9MUvCup4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNLfV6mTvGCuVxyhSOoEnUPQqCHpMBVDMPFOTOYj545Q&oe=6AAEA674"}, "display_name": "Proteus", "keywords": ["Science", "Biology", "Laboratory", "Medicine", "Vaccine"], "long_description": "Proteus is a learning & engagement app that introduces students to the world of advanced cell & gene therapies.\n\nDraw the link between life-saving medicines and careers in advanced therapies development & manufacturing.\nLook inside a production room from a real manufacturing facility.\nBring classroom learning to life by exploring a cell suspension and the inside of a human cell, contextualising information from biology class.\n\nUse Proteus to generate excitement around cell & gene therapy jobs at careers and recruitment events. Use in classrooms as an immersive and engaging learning experience.\n \nFourPlus Immersive create VR for the life science sector, combining expertise in advanced therapies & immersive technology to create impactful tools for training, marketing & recruitment.", "short_description": "Introducing the world of advanced cell and gene therapies and what it means to work in medicines manufacturing. For engagement, outreach, recruitment and education. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/proteus-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26396989106604269"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75251817_1550123908768756_7331441547979334711_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewm3qkw3Ez0Q7kNvwEFGSsC&_nc_oc=AdoIbY2Vvpr9VZ36PkC1dIB-djq9sTCIrCSfu21TafeJiRnDFJg3Q0kz45T7iffHIXw&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqpmnu8LFhJNGKPO0
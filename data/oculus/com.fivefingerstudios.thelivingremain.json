t-sin2-2.oculuscdn.com/v/t64.5771-25/499626728_3704079076406087_6918283372458233421_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUy6EOhNqN8Q7kNvwEi4ROK&_nc_oc=AdqaGTVuh8tqkJY81zUobXxag0O_r3WQa63W4lDM6wujuFJJRq2XLsJOpCv4hFyfSmY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOF0gyEykfdKxjCvic9NgTxznUhZe6UDGB0KdeRRZ3FA&oe=6AAEABAE"}, {"file_name": "tlr_quest_001.png", "id": "682073034553394", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499332242_682073041220060_5832865909271363159_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wu5lXKHHo60Q7kNvwEfaiPl&_nc_oc=Adrx9uiCDlQxXkV7ZO_31JP1rPBY7icL3t8vis7sLy4Twq9sFhACu-GZKiJjxIqxGtU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3prbW-I6Iklg9kRNiY5QS5hEH4-8OOehixZA9gHJPUg&oe=6AAE7FCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TLR-Capsule-2560x1440-2.png", "id": "486482041152122", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499323999_486482044485455_2102511114208402293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWuCHDavx34Q7kNvwHXCHT5&_nc_oc=AdocUl8KZ0i4XpLCDGpOB4HtCdyZqFQY7HWS9F8rK-7NIdt461L6kpf_GFQGYrHZen8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAKyo0N8Lh-V44xZ-ryakitcRtENdqoKJZtqdg22BsSQ&oe=6AAE866C"}, "display_name": "The Living Remain", "keywords": ["campaign", "zombies", "action", "adventure", "singerplayer"], "long_description": "Search for your missing family in a world overrun by the undead. The Living Remain is a single-player, story-driven adventure shooter blending intense combat, exploration, and environmental puzzles.\n\nPlay as Grant Montgomery, a former soldier, with your ally Alex guiding you over the radio. Scavenge supplies, craft ammo, and upgrade your arsenal as you push through dangerous territory.\n\n# Explore Beyond the Fight\nSearch your surroundings, navigate hazardous environments, and solve puzzles as you progress through a campaign that blends tense exploration with intense firefights.\n{9626959480697384}\n\n# Hands-On Gunplay\nAim, reload, and swap magazines yourself. Keep your weapons ready as the undead close in and encounters escalate.\n{1333546871405157}\n\n# Upgrade Your Arsenal\nModify your weapons with upgrades including extended magazines and hollow-point ammunition to prepare for the threats ahead.\n{561478273587450}\n\n# Face the Horde\nFight through close encounters and larger groups of the undead across abandoned streets and industrial interiors.\n{29103019966009933}\n\n# Includes cross-buy with the Rift version.", "short_description": "Search for your missing family in a world overrun by the undead. The Living Remain is a single-player, story-driven adventure shooter blending intense combat, exploration, and environmental puzzles. Scavenge supplies, collect filament to craft ammo, and upgrade your arsenal as you fight through abandoned neighborhoods and industrial compounds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fivefingerstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Five Finger Studios", "support_website_url": "https://www.fivefingerstudios.com/contact-us-five", "website_url": "https://www.fivefingerstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "es", "ko", "pt", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "sup
ile_name": "Suburb.png", "id": "554135820764772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75572660_554135824098105_3822174651158175297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CO1PxFwm_D0Q7kNvwFPtaHg&_nc_oc=AdqEQRQpal37EY_nkwC5PzM2h7zIgitpKSKsWAmje7UkgwaCWTLwvs9BXIS-Z9lb2SU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eMg0V_wcKRALFIjBODQFyZ4_Ajg38QZdBhHMn7HIOtw&oe=6A144719"}, {"file_name": "Toxic.png", "id": "1097355588361052", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75361353_1097355591694385_5360427518493747154_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew41j3aGQHwQ7kNvwFuP3GG&_nc_oc=AdoTLi-_CpKc-iePPiXtDr4M5_BVXIiqhACY-PtUqKW3Sod-nDbDKO7AgoaOk-VexRE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af576DWF7q3QvLcLTJ9fsmzkuQyvzvhKDDOSEhnj0CmaHg&oe=6A145D0C"}, {"file_name": "MedicalTent-Andoid.png", "id": "1100455171574163", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75300187_1100455174907496_2897916397898292046_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u4KaIt_13UQ7kNvwFZQoSi&_nc_oc=Adp4Ty149jidP5ZARKNgbiG6tN8xvFcpQk77WVH7Uc78Nm14oVoRcs8dma9xbh_blmU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B4QZJkMxjxDpzV67IgoGyfK7OLUcrePgrUfFXmYCRtA&oe=6A147077"}, {"file_name": "CraftingTable1-Android.png", "id": "1260411401955568", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569446_1260411405288901_3791275916956136177_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aau0AFzqcGcQ7kNvwFYSRwA&_nc_oc=AdqeUe1l4Tpsxy6Rt81ejnIhkhYoC8RNMKpnt4dr6bcYrZaOyLFIrBPOSFDjk33srOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RFqCF3oo-o4Bf21IukBdWAuwjSJEn6z0WFs74olFDfg&oe=6A146ACC"}, {"file_name": "DirtLot.png", "id": "1528028708588226", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57569445_1528028711921559_1609675039832361367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jgWv9YmTu8Q7kNvwHWw6NY&_nc_oc=Adppjvh8s9TO7gQzqYb9O-wBxyea89a6IlcNoo9I0ExYAql9DuktaoeKlL-6eLFOdaU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pFk-2gS7kEpQKimvGxGySz8HxdQWpAkFWFrVvRPpyXg&oe=6A1471A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2053106761791663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473397243_2053106765124996_5702158616480751863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUhAzQRlIR0Q7kNvwFRv1oJ&_nc_oc=AdpvObZQxdK8QV_fE3lVeHGO9NhQ4X9xKRucpQ8rCT2jeXV-4FfzxCciAH8Ko6AhZKA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VI7nHGgkq4n9pXkC8GLPGIaP91Unn7kjTVKk4hCHj1A&oe=6A144BB2"}, "display_name": "The Living Remain", "keywords": ["campaign", "zombies", "action", "adventure", "singerplayer"], "long_description": "# Step into the fight for survival in this gripping action-packed adventure where the undead roam, every bullet counts, and only the strongest will endure.\nThe Living Remain includes cross-buy on Rift\n{9626959480697384}\n\nGrant Montgomery, a former soldier, is on a relentless quest to find his family in a post-apocalyptic world overrun by the undead. While scattered human survivors cling to life within fortified compounds, the outside world is a dangerous wasteland.\n\n\nAlong the way, Grant encounters a group of survivors, including Alex, who quickly becomes his trusted ally. Communicating via radio, she guides him through the chaos, offering crucial support as he fights to survive and uncover the fate of his loved ones.\n\n**Hordes of Undead**\n \nNo safe place to hide. The deeper you go, the larger and deadlier the hordes become. \n{29103019966009933}\n\n\n**Realistic Gun Handling**\n \nTrue-to-life firearm mechanics built for realism. Making every shot, reload, and magazine swap feel immersive. \n{1333546871405157}\n\n**Upgrade Your Arsenal**\n \nUpgrade and modify weapons to increase your firepower to fight your way through hordes of the undead. \n{561478273587450}", "short_description": "Built from the ground up for VR, The Living Remain is a virtual reality first person adventure shooter where players immerse themselves in a new world where the undead have taken over. You must survive the horde of undead using an arsenal of weapons in a story driven campaign loaded with a variety of interactive environments. Explore, scavenge, and collect filament to craft ammo and upgrade a variety of weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fivefingerstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Five Finger Studios", "support_website_url": "https://www.fivefingerstudios.com/contact-us-five", "website_url": "https://www.fivefingerstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "es", "ko", "pt", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9798227600221557"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "35217513537863173"}, {"status": "PUBLISHED", "id": "771342045853340"}, {"status": "PUBLISHED", "id": "731974716513137"}, {"status": "PUBLISHED", "id": "856766010517763"}, {"status": "PUBLISHED", "id": "872724125191572"}, {"status": "PUBLISHED", "id": "1418444370005209"}, {"status": "PUBLISHED", "id": "1747923582781
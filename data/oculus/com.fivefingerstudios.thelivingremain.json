7f30f&oh=00_AQVmn6AJlP4x2T1AdBw_75swbYejGY_fqgHfOacFIVe3PQ&oe=6B10394C"}, {"file_name": "DirtLot.png", "id": "1528028708588226", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569445_1528028711921559_1609675039832361367_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4BtxoAqfb8Q7kNvwFjUk18&_nc_oc=AdpfX98DXLMv4E6CflUbfkCL92nBxdhqSCdCiAfOcB5dbK1Nn_X5Wy5LgomT8Q-9umM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUo8R20_auVhj6n5HYqaXsFi2Kl-z-xQwFTo9vC2PcJJA&oe=6B104022"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2053106761791663", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473397243_2053106765124996_5702158616480751863_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PP8a1xmTuAQ7kNvwF9UWSd&_nc_oc=AdosSW_5An6CDKu1reobf0-NMDaVTLAHe07EbJXp9ZBOle_PrmpqjmGO__P26mJRdUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWumrP9Mhn-hL-A7FOcG4KkH8TKoG4EWXT8MXkKyK5nVw&oe=6B105272"}, "display_name": "The Living Remain", "keywords": ["campaign", "zombies", "action", "adventure", "singerplayer"], "long_description": "# Step into the fight for survival in this gripping action-packed adventure where the undead roam, every bullet counts, and only the strongest will endure.\nThe Living Remain includes cross-buy on Rift\n{9626959480697384}\n\nGrant Montgomery, a former soldier, is on a relentless quest to find his family in a post-apocalyptic world overrun by the undead. While scattered human survivors cling to life within fortified compounds, the outside world is a dangerous wasteland.\n\n\nAlong the way, Grant encounters a group of survivors, including Alex, who quickly becomes his trusted ally. Communicating via radio, she guides him through the chaos, offering crucial support as he fights to survive and uncover the fate of his loved ones.\n\n**Hordes of Undead**\n \nNo safe place to hide. The deeper you go, the larger and deadlier the hordes become. \n{29103019966009933}\n\n\n**Realistic Gun Handling**\n \nTrue-to-life firearm mechanics built for realism. Making every shot, reload, and magazine swap feel immersive. \n{1333546871405157}\n\n**Upgrade Your Arsenal**\n \nUpgrade and modify weapons to increase your firepower to fight your way through hordes of the undead. \n{561478273587450}", "short_description": "Built from the ground up for VR, The Living Remain is a virtual reality first person adventure shooter where players immerse themselves in a new world where the undead have taken over. You must survive the horde of undead using an arsenal of weapons in a story driven campaign loaded with a variety of interactive environments. Explore, scavenge, and collect filament to craft ammo and upgrade a variety of weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fivefingerstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Five Finger Studios", "support_website_url": "https://www.fivefingerstudios.com/contact-us-five", "website_url": "https://www.fivefingerstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "es", "ko", "pt", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9798227600221557"}}]}, "scheduled_offers": {"count
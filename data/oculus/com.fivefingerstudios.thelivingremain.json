_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaDsek05mUjrXQYzk6mzf7dpjHXFY9B43UkmCkdBVukQ&oe=6AAEAFF7"}, {"file_name": "CraftingTable1-Android.png", "id": "1260411401955568", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569446_1260411405288901_3791275916956136177_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkKKXN4jcpYQ7kNvwGReU7O&_nc_oc=AdqNbg9OACOckumLYDeKrU9eoxJtFH-neCYi21BezMsP0wkLFhs59janFvDyU3oF924&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoZzre_n5yenbX5WoHFDWCU6g-ISf7OPAEEUXwPwZ8YA&oe=6AAEAA4C"}, {"file_name": "DirtLot.png", "id": "1528028708588226", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57569445_1528028711921559_1609675039832361367_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SovUUq7o2B4Q7kNvwHxgk70&_nc_oc=Adq-yGOa0F8OWgks8AZpTg-0i0Dm6kdNUk6gPs6oc1k2NxytYMvwrAj8ENRATKFmHkE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJg5-wo6ycbfr3UpwByrZay8_K8wQQjwdpeVBULJm-1eg&oe=6AAEB122"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2053106761791663", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/473397243_2053106765124996_5702158616480751863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRXnZwCjxXEQ7kNvwEljyQO&_nc_oc=Adq9ndMhm--PxLE8tT5I6BWiRCAkqEz9QX2_hIwZkltK4WnUoID5mLUxAhzNhcIS-EI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-jaCswytbt4DE5zpDwY6pqDNQuZBb-eYF4LDCKoz__g&oe=6AAE8B32"}, "display_name": "The Living Remain", "keywords": ["campaign", "zombies", "action", "adventure", "singerplayer"], "long_description": "# Step into the fight for survival in this gripping action-packed adventure where the undead roam, every bullet counts, and only the strongest will endure.\nThe Living Remain includes cross-buy on Rift\n{9626959480697384}\n\nGrant Montgomery, a former soldier, is on a relentless quest to find his family in a post-apocalyptic world overrun by the undead. While scattered human survivors cling to life within fortified compounds, the outside world is a dangerous wasteland.\n\n\nAlong the way, Grant encounters a group of survivors, including Alex, who quickly becomes his trusted ally. Communicating via radio, she guides him through the chaos, offering crucial support as he fights to survive and uncover the fate of his loved ones.\n\n**Hordes of Undead**\n \nNo safe place to hide. The deeper you go, the larger and deadlier the hordes become. \n{29103019966009933}\n\n\n**Realistic Gun Handling**\n \nTrue-to-life firearm mechanics built for realism. Making every shot, reload, and magazine swap feel immersive. \n{1333546871405157}\n\n**Upgrade Your Arsenal**\n \nUpgrade and modify weapons to increase your firepower to fight your way through hordes of the undead. \n{561478273587450}", "short_description": "Built from the ground up for VR, The Living Remain is a virtual reality first person adventure shooter where players immerse themselves in a new world where the undead have taken over. You must survive the horde of undead using an arsenal of weapons in a story driven campaign loaded with a variety of interactive environments. Explore, scavenge, and collect filament to craft ammo and upgrade a variety of weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fivefingerstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Five Finger Studios", "support_website_url": "https://www.fivefingerstudios.com/contact-us-five", "website_url": "https://www.fivefingerstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_R
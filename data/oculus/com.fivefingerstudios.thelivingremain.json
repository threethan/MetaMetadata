oc=AdqLkZpwCh1KnDJGtKBLHq6m8IyCgQOFW-N0ZAJ9-zuXM6qzlKVyEtCgXiFbRFSbugE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BiothVVvc3DZ1Rg6s2ARZ21mw9hIvEpqhROdoFYrO3A&oe=6A01C462"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2053106761791663", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473397243_2053106765124996_5702158616480751863_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I85yaxzOV1kQ7kNvwG_ICq4&_nc_oc=Adp10cCM1KS0h_v8LW6zZ8Lv3tXathJ3y7wk7mklEG8pJT1hyROnKgaEehJsrVE7UH4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ECGY7pN4FVj7nlmeN-5E5TG0HM9IGVO8mqUMzcQq9Ag&oe=6A01D6B2"}, "display_name": "The Living Remain", "keywords": ["campaign", "zombies", "action", "adventure", "singerplayer"], "long_description": "# Step into the fight for survival in this gripping action-packed adventure where the undead roam, every bullet counts, and only the strongest will endure.\nThe Living Remain includes cross-buy on Rift\n{9626959480697384}\n\nGrant Montgomery, a former soldier, is on a relentless quest to find his family in a post-apocalyptic world overrun by the undead. While scattered human survivors cling to life within fortified compounds, the outside world is a dangerous wasteland.\n\n\nAlong the way, Grant encounters a group of survivors, including Alex, who quickly becomes his trusted ally. Communicating via radio, she guides him through the chaos, offering crucial support as he fights to survive and uncover the fate of his loved ones.\n\n**Hordes of Undead**\n \nNo safe place to hide. The deeper you go, the larger and deadlier the hordes become. \n{29103019966009933}\n\n\n**Realistic Gun Handling**\n \nTrue-to-life firearm mechanics built for realism. Making every shot, reload, and magazine swap feel immersive. \n{1333546871405157}\n\n**Upgrade Your Arsenal**\n \nUpgrade and modify weapons to increase your firepower to fight your way through hordes of the undead. \n{561478273587450}", "short_description": "Built from the ground up for VR, The Living Remain is a virtual reality first person adventure shooter where players immerse themselves in a new world where the undead have taken over. You must survive the horde of undead using an arsenal of weapons in a story driven campaign loaded with a variety of interactive environments. Explore, scavenge, and collect filament to craft ammo and upgrade a variety of weapons."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fivefingerstudios.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Five Finger Studios", "support_website_url": "https://www.fivefingerstudios.com/contact-us-five", "website_url": "https://www.fivefingerstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "fr", "de", "ja", "es", "ko", "pt", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9798227600221557"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "35217513537863173"}, {"status": "PUBLISHED", "id": "771342045853340"}, {"status": "PUBLISHED", "id": "731974716513137"}, {"status": "PUBLISHED", "id": "856766010517763"}, {"status": "PUBLISHED", "id": "872724125191572"}, {"status": "PUBLISHED", "id": "1418444370005209"}, {"status": "PUBLISHED", "id": "1747923582781
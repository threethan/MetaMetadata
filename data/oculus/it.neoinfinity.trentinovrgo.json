g21YbmZdgQ7kNvwFLm2vF&_nc_oc=Adr7kbPbhGhtYTsiHNCYTjEK2EBa5YrHjKi1sfrqB8DeEUEc-8i-f78dNvy9mz5oeeU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8k2MHjQIINAek77tymlVQZtShJfMkQx5FbhAqQby0pwg&oe=6A395C41"}, {"file_name": "TVR_Screen2.png", "id": "667891367446048", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031421_667891370779381_2087486060593303043_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIt3xKG8boEQ7kNvwGulQUc&_nc_oc=AdrG6fVTHd_WLJuPV6gaLBXE7stb95nm5bo-Az3yuTNjLSDPJsSD7WFJ_Dm2MgvDMfU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84ngLf5eLIMRJJU_D-H_xU0O_5FMtnHOBMei2Axhfa3g&oe=6A3938DC"}, {"file_name": "TVR_Screen1.png", "id": "635346490497460", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39001723_635346493830793_3746610530302084235_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCCsvTLMbqQQ7kNvwGK4KaA&_nc_oc=AdqCJq0pxGaTM-73Uen_AxirqkRUppPSfTQqjBQCI6zwJFaOHrk3sh97HSJee8n4eh8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BVoYIPhZo7Pmq74DTT9qtCIJWXE0XDEqzeTAOxU3zfA&oe=6A395152"}, {"file_name": "TVR_Screen3.png", "id": "264123968239634", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031354_264123971572967_3815623544612869145_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chNx1z3jyMEQ7kNvwHXoOkL&_nc_oc=Adr5wtrj2xMEAw3myt3dMNcGpB_-c3Gn0DEeehNhU3pug5sApApgSrUoI2-nQEhGyl0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2bQ7diBLdecQjgMiIQzStNM7UzQ8_22fOmrMN0flkTA&oe=6A393CB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrentinoVR", "keywords": ["travel", "Italy", "video", "experience", "Trentino"], "long_description": "Trentino VR takes you to amazing locations, making you the protagonist of stories that develop around you, in a 360 degrees view. Go hiking in the Dolomites, enjoy gorgeous meals in unique locations in the mountains, relax in a Spa or at the Swimming Pool, ride a scooter among the vineyards, admire the sunrise from a mountain hut and try out sports like paragliding, snowboarding, climbing, trekking, paddleboarding, canoeing and more. Live highly immersive experiences!\n\n \n\nScopri il Trentino da un punto di vista unico. Trentino VR \u2013 Virtual Reality ti trasporta in luoghi unici, rendendoti protagonista di storie che si sviluppano tutt\u2019intorno a te, a 360 gradi. Fai trekking sulle Dolomiti, goditi squisiti pasti ad alta quota, rilassati alle Terme e in piscina, prendi parte ad un giro in vespa tra i vigneti, ammira l\u2019alba da un rifugio e prova sport come parapendio, snowboard, climbing, trekking, sup, canoa e molto altro. Vivi esperienze altamente immersive a 360 gradi!", "short_description": "A place to experience.\n\nLive highly immersive experiences with this Tour of the Trentino and his beautiful places."}]}, "developer_name": "Digital Mosaik", "developer_privacy_policy_url": "https://www.digitalmosaik.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Digital Mosaik", "support_website_url": null, "website_url": "https://www.digitalmosaik.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2121087468052247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974621_406955954028280_8123446899400904950_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9QgYr_O
f4UkoQ7kNvwHx5rpO&_nc_oc=AdoVkmYsVEJMPyf6DoZPy9-rMogU3okzb7Tihin9Uao6wbWdZHnmD7WI93FdWrRqVMA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhehEQ-SvMiWtWx24p6ty-xF3iZZySWNOpMkG6tPg9jQ&oe=6AA14A81"}, {"file_name": "TVR_Screen2.png", "id": "667891367446048", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031421_667891370779381_2087486060593303043_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8D4SExblXUQ7kNvwHIpk1e&_nc_oc=AdrCsWxRP0jHF39GtzoJkVgpBPzJzIDDtpT1nXEeq_Hp21uYI10Jtp-asko5zQcCldU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHnWnOEqsYzIRT6d3mn7Oz2Sp9jYbNGzkZWqNJgU4aiA&oe=6AA15F5C"}, {"file_name": "TVR_Screen1.png", "id": "635346490497460", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39001723_635346493830793_3746610530302084235_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7K-ymksKfu0Q7kNvwEwMEze&_nc_oc=AdocP0hzuxKIieK7t5e2fXwlj_a6XYTJAJS5jQFJHQeoUbg2sJxxEBYp0Ci0FywOf7Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-DUo1PhbRS87hqf2S4FNmSHfZgMv8tGfx1qs5UVR-1Q&oe=6AA177D2"}, {"file_name": "TVR_Screen3.png", "id": "264123968239634", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031354_264123971572967_3815623544612869145_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT0aoy4z3cUQ7kNvwH50RZg&_nc_oc=Ado__CzUZwTMdJUdlG6PrdpQbfNuqNSzwckvTVvrgEs70aTzs7YcybKF4Ncg2d1uHUU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUIosGRK5cwfwm8elJ8D3Jf7tOQIppPyv6s2QbLXO5mg&oe=6AA16333"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrentinoVR", "keywords": ["travel", "Italy", "video", "experience", "Trentino"], "long_description": "Trentino VR takes you to amazing locations, making you the protagonist of stories that develop around you, in a 360 degrees view. Go hiking in the Dolomites, enjoy gorgeous meals in unique locations in the mountains, relax in a Spa or at the Swimming Pool, ride a scooter among the vineyards, admire the sunrise from a mountain hut and try out sports like paragliding, snowboarding, climbing, trekking, paddleboarding, canoeing and more. Live highly immersive experiences!\n\n \n\nScopri il Trentino da un punto di vista unico. Trentino VR \u2013 Virtual Reality ti trasporta in luoghi unici, rendendoti protagonista di storie che si sviluppano tutt\u2019intorno a te, a 360 gradi. Fai trekking sulle Dolomiti, goditi squisiti pasti ad alta quota, rilassati alle Terme e in piscina, prendi parte ad un giro in vespa tra i vigneti, ammira l\u2019alba da un rifugio e prova sport come parapendio, snowboard, climbing, trekking, sup, canoa e molto altro. Vivi esperienze altamente immersive a 360 gradi!", "short_description": "A place to experience.\n\nLive highly immersive experiences with this Tour of the Trentino and his beautiful places."}]}, "developer_name": "Digital Mosaik", "developer_privacy_policy_url": "https://www.digitalmosaik.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Digital Mosaik", "support_website_url": null, "website_url": "https://www.digitalmosaik.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2121087468052247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974621_406955954028280_8123446899400904950_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEv1xCO7Wl8Q
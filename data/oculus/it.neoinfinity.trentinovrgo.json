yrLIEQ7kNvwGVegGc&_nc_oc=AdpTW-659aTSADpLNSD_334M-229nQNRdQlxjd_cXNwjyL9GEMfulue4mZI7qInOPzg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5lOIhXoqZDa38kIgaeE_5Lt62uvJo1eiByWOCv2-EVg&oe=6A9AEB41"}, {"file_name": "TVR_Screen2.png", "id": "667891367446048", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031421_667891370779381_2087486060593303043_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QZ6RGjnFgkwQ7kNvwHWqUF1&_nc_oc=AdoErswbuJrTxkRDtqbdPbihObTVtpZbimWe_iEmEmhz0uv26-ulOsvJuB15yqzxTm0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ74FoPXk2x9BJp4WhcoPVi9a64E3oOYh2YPndtQDtMDQ&oe=6A9AC7DC"}, {"file_name": "TVR_Screen1.png", "id": "635346490497460", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001723_635346493830793_3746610530302084235_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sr_P8957M0Q7kNvwH4jY5h&_nc_oc=Adqv5zA6c_AWXom6JTns9uNf0oowHN7dxErisXJwILEmWkStukzK7-vZFXj2C3Ad6lU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAuCwBZ95fpDvC2Gb1V-v7IrsiseYai1iecqiPWE39oA&oe=6A9AE052"}, {"file_name": "TVR_Screen3.png", "id": "264123968239634", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031354_264123971572967_3815623544612869145_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaTHp7hk188Q7kNvwEYNI_q&_nc_oc=Adqk1wmULYMN9Ooq7sCc03ywqwDaB1A3hLbB_B64VZmcM0LRW33mw4Qstew_MLiax88&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI9nxPSEtEdvduhFneF-EihcfnDfF7J1qQOi7FQaoWpg&oe=6A9ACBB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrentinoVR", "keywords": ["travel", "Italy", "video", "experience", "Trentino"], "long_description": "Trentino VR takes you to amazing locations, making you the protagonist of stories that develop around you, in a 360 degrees view. Go hiking in the Dolomites, enjoy gorgeous meals in unique locations in the mountains, relax in a Spa or at the Swimming Pool, ride a scooter among the vineyards, admire the sunrise from a mountain hut and try out sports like paragliding, snowboarding, climbing, trekking, paddleboarding, canoeing and more. Live highly immersive experiences!\n\n \n\nScopri il Trentino da un punto di vista unico. Trentino VR \u2013 Virtual Reality ti trasporta in luoghi unici, rendendoti protagonista di storie che si sviluppano tutt\u2019intorno a te, a 360 gradi. Fai trekking sulle Dolomiti, goditi squisiti pasti ad alta quota, rilassati alle Terme e in piscina, prendi parte ad un giro in vespa tra i vigneti, ammira l\u2019alba da un rifugio e prova sport come parapendio, snowboard, climbing, trekking, sup, canoa e molto altro. Vivi esperienze altamente immersive a 360 gradi!", "short_description": "A place to experience.\n\nLive highly immersive experiences with this Tour of the Trentino and his beautiful places."}]}, "developer_name": "Digital Mosaik", "developer_privacy_policy_url": "https://www.digitalmosaik.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Digital Mosaik", "support_website_url": null, "website_url": "https://www.digitalmosaik.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2121087468052247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974621_406955954028280_8123446899400904950_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GI5J5dLwcDIQ
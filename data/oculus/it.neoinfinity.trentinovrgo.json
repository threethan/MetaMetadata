c_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1p0OPvUbU-E2kJDNCMWclrg9eXuzGvSAnKGkOfb_Yg1g&oe=69F0A181"}, {"file_name": "TVR_Screen2.png", "id": "667891367446048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031421_667891370779381_2087486060593303043_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlfNb65ypdwQ7kNvwE1sZN_&_nc_oc=AdpENnBhARCn8BPQ6Yh7MEnKQ-GbW6EUN_3LAdKj3oIptXyFPbUxYtZSXyoDDTrwLcI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1IGpn3TDx-9f1-ageKaKN8kvQqI3J0ZvYo9Xcoxe4bSQ&oe=69F0B65C"}, {"file_name": "TVR_Screen1.png", "id": "635346490497460", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001723_635346493830793_3746610530302084235_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vxmJpy4_cYQ7kNvwGlwYB6&_nc_oc=Adon_dF4t3w-Y445kP7U4mlR8sQDke0OEuBudVOaxfVABcaCW6hcND4n7Mgq5gZ9UOA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2r2bqGSVqQDwhLhujnubI9Ph6IsgXQjT6DZSv_GRBhHA&oe=69F0CED2"}, {"file_name": "TVR_Screen3.png", "id": "264123968239634", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_264123971572967_3815623544612869145_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APXmdFJNM5AQ7kNvwFH_i1l&_nc_oc=Adp8Wia5IaC-qSRu7N4w4so-c3AfsdYLM2kaxb7y-Tlh0798MD8wGSQq3TKtTmaYIvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0Xbw0FvoUioi3hU2ZK4H1nQ6QeCKTEtjxKvkvj6n4vgA&oe=69F0BA33"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TrentinoVR", "keywords": ["travel", "Italy", "video", "experience", "Trentino"], "long_description": "Trentino VR takes you to amazing locations, making you the protagonist of stories that develop around you, in a 360 degrees view. Go hiking in the Dolomites, enjoy gorgeous meals in unique locations in the mountains, relax in a Spa or at the Swimming Pool, ride a scooter among the vineyards, admire the sunrise from a mountain hut and try out sports like paragliding, snowboarding, climbing, trekking, paddleboarding, canoeing and more. Live highly immersive experiences!\n\n \n\nScopri il Trentino da un punto di vista unico. Trentino VR \u2013 Virtual Reality ti trasporta in luoghi unici, rendendoti protagonista di storie che si sviluppano tutt\u2019intorno a te, a 360 gradi. Fai trekking sulle Dolomiti, goditi squisiti pasti ad alta quota, rilassati alle Terme e in piscina, prendi parte ad un giro in vespa tra i vigneti, ammira l\u2019alba da un rifugio e prova sport come parapendio, snowboard, climbing, trekking, sup, canoa e molto altro. Vivi esperienze altamente immersive a 360 gradi!", "short_description": "A place to experience.\n\nLive highly immersive experiences with this Tour of the Trentino and his beautiful places."}]}, "developer_name": "Digital Mosaik", "developer_privacy_policy_url": "https://www.digitalmosaik.com/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Digital Mosaik", "support_website_url": null, "website_url": "https://www.digitalmosaik.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "TRAVEL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2121087468052247"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974621_406955954028280_8123446899400904950_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mlYA4-KGe1cQ7kNvwG2S8RM&_nc_oc=Adru-VuEY2-f1K89vt1iq28jhgmFf7k4bl609-99vfU3FfAoWspZXFpudXKQKxSo90Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0pYD0GvQcvN3zcg
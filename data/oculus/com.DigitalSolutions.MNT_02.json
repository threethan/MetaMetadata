g&oe=69C548CB"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3myWFhHkbWAQ7kNvwEjyp6q&_nc_oc=AdqkeCBpYk511LdkxE25nG83iPyKWxr-91K96teI5-Ub_ZrfpLp9Yseyy435O0_q3kc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxg-hhvlNPgYN7oilJkK1lRY2i20rGtpU9BpYDrLPqPkg&oe=69C534F1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YB8TS-lycGcQ7kNvwHKFnh8&_nc_oc=Adpm-a-Kmymw9fFrMj2Js2QKg0Uhuj3CdabbJ-egl7gCvwnnZjRk_r3uZAaftqelAWY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUUIcMppnBGHQooelpNft7odPHNx7alD-PXmTJUkHfPQ&oe=69C52DBD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS6D41vO8yAQ7kNvwGuK6yg&_nc_oc=AdrjJOKXSlFdtrz1snZHdxyS1xWVEdnguwqr1B3E8b9BVUwA1hMH9YoRcZqAekiEFD8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxoxU2KSV3tQKF-utomkMCr1VYmhfz27fsGuScPPwsPgw&oe=69C51B82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
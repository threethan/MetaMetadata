Q&oe=69D0EE0B"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmKmX2z9frIQ7kNvwGMTHvu&_nc_oc=Adrs8FSkyW7A4SVT8m-XX7SIufs2P7T7pfuxr74bVi-TF7K8iLyJMUEuXf_eBpOEjzU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPaw16Bdig0bPhxV5iHYykRvIXIyxjJn8IE4o-LGfJqQ&oe=69D11271"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRo4FQKyrFEQ7kNvwHf1D2Y&_nc_oc=Adp4Vlpd8FVRwRdR7e8Nj8pOB3SqVRkHy83_bHAifsbkHL_4AVYfQtuvpwwj8lRi_ks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxyy2jkHudRDzVrkq_3hP1trEarCW_d22XkKbPxpfM9qg&oe=69D10B3D"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRNQCG_MoLsQ7kNvwE1kmb0&_nc_oc=AdpX3VRr6eOHVZVFUff_QcE7V9Phkl3xpkypCf3-_XaYsEmtpdMZ9yx7o6fF2DOJKAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhmUKGawIrVugBdyrAgerN0kZyj4b4efZjGbPfEdjuHw&oe=69D0F902"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
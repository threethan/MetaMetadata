Q&oe=69E39B4B"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqzf3fDdQooQ7kNvwHFJdhU&_nc_oc=AdqH1la0XKmuVaoBPtaDv9pbJRhTIePO9q0-MbrtkqdXnf72Aqmd0IzRTcRwuB47Q8g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PZl5KnUCoJZT8OkuethlZ6CflLok_cdYx1c6z_zajUw&oe=69E38771"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C13jrSrAPHkQ7kNvwH89AZv&_nc_oc=AdpnMFG_g3ZUJXhyseNAsuMtvmeLh_VHHNVgW9I1eLgiMt1l5OtIbWcCU-vNj1KBkCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OpbHwf67ANtMswbDbUY0EZWnwKS8YGBWgjyJEWR1gBg&oe=69E3803D"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Et3jwtoK48gQ7kNvwGfoiJn&_nc_oc=Adoe3dlSZ2sHochKkY4MaSQg1PppWre_nYaKr5QMP2PPL65RsZJqt0wjU7lcssO2aeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aB2t9LoA8jXSgYc4cQyKb7eBkkQ-slP-lpzMrLx0IWA&oe=69E36E02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
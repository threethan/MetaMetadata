&_nc_sid=6e7a0a&_nc_ohc=bbcnNb2lZEIQ7kNvwGWx6-z&_nc_oc=AdoGikXy4I-WSWDtzgdnyC7RbnXTw6uOQyahQU8rGG9ROvJ9gJI7Yr9H2vClHfsg5sg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQViaCbjzP7PsiV8Lc8wZuA-nCxr-hf9bOfOD7sI-WhEHw&oe=6B0EF628"}, {"file_name": "shot.png", "id": "700530431900707", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/228885152_700530435234040_6812901558081139575_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hx5XCY6O9tEQ7kNvwFQbQpS&_nc_oc=AdpIsTqi3ZeJM8-SYzmGf1hUmdnY5Q5h_EFctAtYvtpUKPfSynB5D2XRiUymc3veSl0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpoDWvGSu2n2K1bmRHiY12rcPPYJuhtpsiaxhyVRraqg&oe=6B0F1956"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veq0sW9R36MQ7kNvwF432Rn&_nc_oc=AdrOvC9ZAYrpPuysbRCX-1cbup8KzQtxsVkOuwAO5xvxtnu2F4V0s_X6ooIi0Q8kxLg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW2_z0UJOYF2MjKLeXI1HL0UsT1VyIL5TYGqfcdeLCjkg&oe=6B0EFBE8"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7651838978179196"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "943036434731543"}, {"status": "PUBLISHED", "id": "1320282125725362"}, {"status": "PUBLISHED", "id": "2081486955564516"}]}, "baseline_offer": {"id": "943036434731543"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776157980, "status": "PUBLISHED", "id": "943036434731543"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7652536898109404", "version": "1.0"}, "id": "232219556633736", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7651838971512530", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7652536
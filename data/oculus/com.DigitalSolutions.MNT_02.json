g&oe=69DE554B"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX_kxL-IpBcQ7kNvwFiVoIP&_nc_oc=AdppHFTwfJAkSk92rCeqoe_WQq5MVzA46_r7eB_5aA5WYOvCg1AP24PwkxhVLM8XN7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Eg9tJgCWqRlw8NszF9b-Ad5KumY8S_IUMn3P9xaeU6g&oe=69DE4171"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZXWV9d-gEgQ7kNvwGlbdd7&_nc_oc=AdqujixvCQFaIv00ESgy5ymWFPGqgi0OaNLUyio6nTkYblzNSYH_PNde0wwGxwE797U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00aNL8ro4mHkn9CAS6a4jboCfP8e3KNhHCgUaV9VEuvQ&oe=69DE3A3D"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y10ONDaYT18Q7kNvwE3bvGh&_nc_oc=AdrUd7_DEemXR3z1svigH8nAEQDS_3F2YLAz4dSNEquIwZfxAqPChTsDM4bIYRXNjG0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LDOOcNtkC3Mb6V1bnvnZkxk92qHtm06lypWxH6jFuxg&oe=69DE2802"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
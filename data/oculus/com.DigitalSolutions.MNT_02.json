g&oe=69D90F4B"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwfJEMSEyF8Q7kNvwH6eWoa&_nc_oc=AdqLRkEoytchkXK1yNibSF3R0Sgl4CX5tiNdcBOjozf0xyJ-gf-nZwZHzAIs11fIhqA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wnjlOtW3YwKIEPt9PfOrwgxgFeGCiK7nwOTjuJKc6QQ&oe=69D8FB71"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8QQadB818oQ7kNvwFrGz6R&_nc_oc=AdpB02q110669r4qkBA8DmMGNAFPUCFGdHbGtg5QMJs8mcMwq1lNGvDrIqx70legoMg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FpaoF-XG8C73jxlJQTi4DAvo01V_3q-ukD1wdqHtbdw&oe=69D8F43D"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6LyjYfa--EQ7kNvwE2Iu-z&_nc_oc=AdoG6q6S9r4dSyObZNymPAJ6jfIJ6hFMLbetBIgSupR1yLMWx6noRbjQzOrQzf4av7I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-dfNY7N0EVo5OXOGEakTHdz9JP6pdZ9vEFuB7q-IFDg&oe=69D8E202"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
sid=6e7a0a&_nc_ohc=oKto2HV0HogQ7kNvwFFNnxT&_nc_oc=AdoSQH7JJwGEjNeJn9arsKC2KtMaxx1H2HojCzxV26rRR8CORxnzqz5sFWP7OXIoAN8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBX1IZ7Da4_pMxssdNXAy1X35OghUVeJj2N5wO3irDeBw&oe=6A525A96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ktl38RPbMrQQ7kNvwGwKZrp&_nc_oc=AdoViFf4ZY-JXIaiGRjA9JJZKj1ETRImoAJf9M02JZF8HTOHHt_lFwK_iFduN4JHGKk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv7GCPHu8hykdDl8l37BPkWQdYBnOMcGn_Gd_7d6GWPw&oe=6A523D28"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
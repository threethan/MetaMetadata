w&oe=69DD03CB"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AX_kxL-IpBcQ7kNvwE86gBD&_nc_oc=AdqtYZaIXhUiZHnakffcqJtpx5AvgWbf6EaFANWflxTOovUDNat7VIJpuufKR4IzEjg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vozrAlQ3OkOEL3cG4cZoA8fdw5deQWifUJQsIU13KdA&oe=69DCEFF1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFqF7leX1FUQ7kNvwGGjkTg&_nc_oc=Adr-rlLvZtWmd0IT8UWYKCylWGQ40_89msdVjum7LDNL77Voeybr7UAH8xbFb75UUWY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N5REhu9aXBgJG1fQ5AU5Ko-ck1pGOqjXJu3I3tjPwLA&oe=69DCE8BD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y10ONDaYT18Q7kNvwG85Wnd&_nc_oc=AdopuGVMPwVShg1H8t8mVs2ZbERCQnElhDxUT75SpFlGzj4jdGEB7Fxi5St_Jm8U4uk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FJFqCOoXmcXTqnqWgolSiIsr4EELl7iPATQfSY6wzKQ&oe=69DCD682"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
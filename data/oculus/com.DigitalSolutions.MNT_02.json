.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnlUxQQ4Ad0Q7kNvwHw6LM0&_nc_oc=Adn3bYQN1d_F7QIl-n1FhfjcdVHBTmQocADXhhhx6550SntTtARUeO5DGaCry79iUD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5Yl6jCc8r0hirO-BG9fCDs38cXd_oMosKVA8bkd6a9Q&oe=69A6E271"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC7e8RVsxEUQ7kNvwGANZPz&_nc_oc=Adk7Cco-j24_jVOdoAPwkCXFfqnnP4oSgnjvCUUHhm7m0Oa4ePY5womr9gOayzTNOJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft1fHzQV4zhNtgoGKYQLM6__3ExdqsFogYJ9Kifn_QGFw&oe=69A6DB3D"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAgsRxpbp9YQ7kNvwE36Y03&_nc_oc=AdkiCQx5NhuGM58vma8A8Gr4G9TSSvgRXHdygp9q8VYvY-YbLDJ2kADAIHxIVQpXoQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvVXzRCAKfmUiBE3w-X_17Vyn5oMiaFFV84_lh-JWrlcA&oe=69A6C902"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experien
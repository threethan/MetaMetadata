g&oe=69DA60CB"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwfJEMSEyF8Q7kNvwGN9XQE&_nc_oc=AdrH25xygpOy5A_Ka2t0gA4Ek54SyC-05gOJUUCJIzbidhAGf8SCZ0zf55oSOO1hGhg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06No_Gr0W5sDP9Ywg8kRJDZQF689LCW2GS90zGaDzHfg&oe=69DA4CF1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFqF7leX1FUQ7kNvwFIxbtL&_nc_oc=Adpxr5rrUrj-7T7q49nr8lM1VztuYctDXiSY56_myl0m_si8oKQlGNGDlx1HaBTASYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sDemOr_55tT_zkxUfh3Bw2MK3UI9T_bHS3H_PnJ-1PQ&oe=69DA45BD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6LyjYfa--EQ7kNvwGFldCg&_nc_oc=AdrSFiAdWCmVUNZZgvU39ykvvvnrlGjRzY25qNmLJ5x2VzU-cbgjFWCY3WbSeFPOEiA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0e3d9mIsm4cGa1tzA6P-h6e19mXSm_Zc2xfMNSgj5NOQ&oe=69DA3382"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
g", "id": "1411922123312556", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50sxkZctwAkQ7kNvwH3c8Fr&_nc_oc=AdkmVVVYwm9uD5hi2WAJSEbbrVqq7vSBefJdjRz_mEtSmfhkMMiaAIvdKSpXanHvoqo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyph-YkVuURtDQbq06P5-a43TIG1Cok5_08EpARzdu4cQ&oe=69BAA8F1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIxxQOe0cucQ7kNvwFNGJvH&_nc_oc=AdkZtyN8jbl3KXA-8I031ttXdEfk2uRhr8NsAJhe0GPJYXf0BjIK6iMRUNDelOGueck&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzpgIYjEMuRliEgD93uEmONKd3zCguJ3-Nq6Pyw_6veGw&oe=69BAA1BD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1feLyeUD_4Q7kNvwHJetyF&_nc_oc=AdnTNe9TGHvSmR6R_97A-PDRqXhyPaX_kPNMHwyMxAePZSSxKxolL4UlLd_c3gpIc1E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyANjq0qdV_jKTGhR2nzne9r8Tjew_GzgLh0BbUdq7M1A&oe=69BA8F82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR ap
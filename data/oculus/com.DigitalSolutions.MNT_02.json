sid=6e7a0a&_nc_ohc=TaDB9dQs45gQ7kNvwFFJIuX&_nc_oc=AdouWMRXX10o4zO_upfqhHNh6UZ3OGHu7-EGKOkf0NoxwABdQl6KkmfR7iLnIMocOmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41n3lpKsqJUGcCEdtqmRKjcGM9axaJFuYjop5UnKNamg&oe=6A185896"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFWklhuchbkQ7kNvwFxXUDq&_nc_oc=AdpTmSh-aVXyelE-GIvG59dY6c7mIsgUcwkrVvvBeXqsucQ-a-otAw2AWQ4TCl_nMd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zM1JnXjbjAHHVT7FpbbvwXNMc9WDni7zXAO4vBmLQKA&oe=6A183B28"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNVXWfopFY8Q7kNvwGFQgXl&_nc_oc=AdkbG2ZCHib_0058h92oIh1AcDWxkxJ9NIpe-O6LZybquDyRFgVXa54DiplpLSh8ouE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuTZGfxLCUbMqg74mOIPOGRnGTzDLo9PJOO_1bVGBCfmg&oe=69A04AF1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6lV-Bdb1zYQ7kNvwFjp02_&_nc_oc=Adnh1_XbEheJUh3Z59Qw3A9r4ur9qyuqEoWSoqMVdCUjm4ewyMSe6FIMlfKstFmZmFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afudwr3YlRLgGNx6fMlFcT3BMhTzf5LfGIh-70wXpuLp2A&oe=69A043BD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whz93xj7VBoQ7kNvwHsiBkD&_nc_oc=AdltPwekt3otOue3KzodsJYRpELjuG7NaU0F_6NczAZ9qWyNZXUPztKYvBiBpwdXEtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsbUtHxtGs-sGpkrF1_8iq5BU39XnNk98sSVD5Mu4a0yQ&oe=69A03182"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experien
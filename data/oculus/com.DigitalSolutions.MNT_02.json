sid=6e7a0a&_nc_ohc=wwCQifPXCb0Q7kNvwGYmsT-&_nc_oc=AdrA4cHGFh5HG5VjL5tJJYrsIwSzKjNAe3KQ0g5q7fWkRatEDI48xo_KlCUn5FWCGmw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkBFdVAsTHKgdJPC1tZpefxckkaoZ_Q-NkSQ73BLhLOA&oe=6A5E3816"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lyveVc0RpoQ7kNvwEWB6zJ&_nc_oc=AdqhSuFkKbpPQB4-wqPVmjwR4AMuD2alpHIF4zutdvCGmEo-0Fy7RZbxFus0g3Ghjsk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnhIkR41E7avrLcZPOlO8MjaqhO-6src5nMELzayOYYA&oe=6A5E1AA8"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
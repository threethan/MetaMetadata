sid=6e7a0a&_nc_ohc=9zMPoVjyquMQ7kNvwHptXGw&_nc_oc=AdoI1RMvAFDXTM1KLo8SHXCkdM7ToGzQlZSye11d8ws5NDUgogYzHdXgXX9noXOJ_yY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjkg4Rl-pLuhdVtXmlxkJdPN-AI4D9_dtf0s5prrAdMA&oe=6A6B6716"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWopP9KCk2EQ7kNvwGNrO-_&_nc_oc=Ado5mxodV4FBdWEIWnsVkjm9NuQIDr5mVY6POlOWi0QbL-KmRaVFsUn8VsIHwsJJA6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJwnFu_5-fpj4j11hZU8VYTUiFFB8Gat5XTe1owKq1AQ&oe=6A6B49A8"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
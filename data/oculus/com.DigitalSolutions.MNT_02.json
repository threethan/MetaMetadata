.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvswMoX8SygQ7kNvwFRaz05&_nc_oc=AdniyrotRk93bLE6LiiqO7bO5IE-MpPfbFoWV806T_-SrikEGjJt1raHo4mMU0P8m0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvm_oPLzQZYXiNwz1VAPAUikUNeVZqxUaOsJKI35SMtzw&oe=69A2EDF1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucpX9oF8NVEQ7kNvwGKN2pN&_nc_oc=Adk5U7vNzwHDINgDcI7y61p0AJMMsfDUjueMMSsITPSnPHD7rbo9eV8upCcy354ImIw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsCueyjZxtWvOG_gLKIkUNf0aKav-aknwaKHS64AGfO_Q&oe=69A2E6BD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whz93xj7VBoQ7kNvwGlA9W6&_nc_oc=AdlMV_eIBy9JLY-EwjyGYeQ3ujXAYx2XgM4ShuM02utPYBu5uZOLNNd7j2xClziZ2k8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftlYaiiFC6qDVExJ3DzDzhm5ospFHeREykusnxYKcd4QA&oe=69A2D482"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experien
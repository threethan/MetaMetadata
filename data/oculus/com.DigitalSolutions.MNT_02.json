sid=6e7a0a&_nc_ohc=rhNbiRfpOywQ7kNvwH6pNM2&_nc_oc=AdpKDbQK5jPUJJ7fo3qdVQDM5TqbB7jjAuvT0sneKVj3L9tkw0NBsAKFQ6jxRxb98Q4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3dcPyK9LFI4AmkJatH7Bd6yJE5146Zw5QW841jRJM_Q&oe=6A58F216"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bN-6cmjSH60Q7kNvwHkWrLr&_nc_oc=Adomsn2gYgX29Z7oXjebWWWMcr4HBpY2uo3sJKhsP5aGmvyQ6_ThuVyhaZ2tgHP4msc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARv0018Zgqrl1FXcw5cn0KuZxKPcamcAk4O45c3K1Qag&oe=6A58D4A8"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
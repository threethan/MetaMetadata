sid=6e7a0a&_nc_ohc=eXAssfj8ZcoQ7kNvwH444n9&_nc_oc=AdpiOkqvr-v2iosrk0DY8xzzHHRQ7X1SEPwJ-fAxB6XxtaUqlKT4BTSU5wSxdkKG2Ck&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0X0vWY6JADlYQDyjGaGg58xrAxyfMosjBVMEliS2LXLw&oe=69E79116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzYHHpDA8zsQ7kNvwEN1Dg2&_nc_oc=AdoRYMxbhKE8S-fBMBMGGX12Uipkhqe9EhqSECENerOUF6EV26MlJbSedLOeOQY_bjw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ciqhk9X7f5ERHxoDR0C__OuxRMp9a65xJe7P2XW6cNQ&oe=69E773A8"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
g&oe=69D4E28B"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ET1gg1TRYBUQ7kNvwEAkEpQ&_nc_oc=AdqcjF8G0r3S3ocytLSjjceac6kf-dQ5JkTGJB03cSVow5mm4BqrWNWOpYC4v3kJGsU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dfhdbKw8WbjGWgGH1AEezSD2t3FMiqPZcq49STC-aPQ&oe=69D506F1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDot3niwyM0Q7kNvwG5jgR6&_nc_oc=AdoadFxLbufM3bucDcnP2_xqioOfIdU_WBusdRelOy8i47UygjIIG0Fqoi6mWYAdjqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RPosDFgj0vser_wmJ_8OIRTqveR_54PTnNdwyAPKnSw&oe=69D4FFBD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsAUBXbnGpoQ7kNvwGXRdWn&_nc_oc=AdqjOXb0zagNv2uvnHVmj4cHLVcw1k-K8VFiHy4dCGExs6zmWWKkr1AfR-WeAMTN5o8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qW5N9v3K_bjhR5fx5a5pCad0Rrc4Kwak6whO9Mg59hA&oe=69D4ED82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
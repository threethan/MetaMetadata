sid=6e7a0a&_nc_ohc=t9lhZ_RenwYQ7kNvwFiYrcZ&_nc_oc=AdrxD9fl5KCqi7sjebTXoYLysTXYzTJbhsvAbCGWiG-gFwvFkfem7HsVCC5UTO56uXg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd6J1tqcHBxG9xXUj4wq3Chk7Iucv3ok4Z8F5TqFnPbQ&oe=6A662116"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQwofz7syEYQ7kNvwHdsq7x&_nc_oc=AdoMHClQ-9z96lFfUu9AjQX4S3Q0TyL25TTmRDYMxPkj5ZqiQdUeFxuZZARFUX9MHMU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkyyD9PdPvvguqlOa3sJFeRP7R688jXZolBtsgr4-Zgw&oe=6A6603A8"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
sid=6e7a0a&_nc_ohc=A3MRN8Rdl3AQ7kNvwFkhSpB&_nc_oc=AdrcdUqvhX37qj1I-F6raWEFX3W3jawPJ24hS9VqEblmchK9BXHPXhxtQ87_GNH1ug8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mPT0cjzLl3-YtR6qKFh8Fh276rnbf9z26515stVGWag&oe=6A009D96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R9w8alVIBTsQ7kNvwHHgZs0&_nc_oc=AdowTXr7IrwWIC6zMmNzPY_GEFySRHF5XT-3XCD3WfL0BYBXJaM2rz-n9R0J1eNjid4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jVTHRYoDEbWAa9iD6_2S29i44mN861Zw6ZmJKwZRDWg&oe=6A008028"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
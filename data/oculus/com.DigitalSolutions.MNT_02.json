ps://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/228885152_700530435234040_6812901558081139575_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3vDZrG_qcsQ7kNvwF3lHBj&_nc_oc=Adrv8O1Hvk6wIR3ToYphTSIgrpNri4pSAxxhIMDd9NGqyjU6sUhlYkrktOTAwGXBTIc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK92v3COAU583D1vHVAZKeoSnSdVv80QijosNWVsMgBXQ&oe=6A9ADD16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Nh7AqFu9uQQ7kNvwGP7eDy&_nc_oc=AdrSbmYsay0I5BU8TPvsD8gLUvcQ-Or3cbCVTchFRgwBlFATjNGlmEvhBAsrMZ4nguc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8AWrJ6IXeuKceWJGcVn-yXnucp8ybPkHsRAfpyw31BA&oe=6A9ABFA8"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_
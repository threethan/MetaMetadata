.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_PcFEcEi-8Q7kNvwE-o_tv&_nc_oc=Adlr4T-HHtSipvHt7UwnMb5c29njPB21CHPHPrN8Grtl8iPlVYo_vCAbsfVHmN8iPDQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsTMCrpJChfnLNwcrUddU88qC70k9hCBNI3MkKpxBZPAQ&oe=699861F1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD__bcOzb6gQ7kNvwGIre8V&_nc_oc=AdmVhbvHQsbmizofYpMPtJvBeQPsdbtVB44jR9AFbCYk9KG2vLT6IJYG19qK_wQhqeE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvljDpYwCUM5z-LmjO-Mp6jzTUZoH0eWIlevRm193BGew&oe=69985ABD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv5wDznrN1UQ7kNvwHfcGKC&_nc_oc=AdkxjeYeLpqsbgr2LWv8efTnqf_SeuXag5ZkA6GVTuIqFOFZpljLblS6M2729vxrrgA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuAHy-FigNhOKd93nT4UFLsZ5jU8J5D0yF2dKAdO5qgYw&oe=69984882"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experien
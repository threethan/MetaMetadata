.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNVXWfopFY8Q7kNvwEuLM4V&_nc_oc=AdksK537eCHRaqHd2-QxKWohFvGa81pZBShukoXJ3UxeY1BtQemeMlFN_8JqZZikFtE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuBjrWoQ23-GjS035sHQCHqtmT1TTXroND1QbO2X831dQ&oe=699EF971"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6lV-Bdb1zYQ7kNvwEwm91S&_nc_oc=Admvah8feBNwyRRYsFQMZqeOPINuAq1P8EImI9tq6_9tN9v2NvhMGncJsOAMNscUHpo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsH14xWIbRIEZ4f_CW7kRfS0vOeZUHqpnzHR2aDFA-HIA&oe=699EF23D"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_H0q7Tfx_-MQ7kNvwHZi2L9&_nc_oc=AdmJKMVPFxICf8t9IpxFsNdSzwwGfLUIuQoPymoWwZqE6FAe6I-R9Cr2jspLtISuFgQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsAifgjfaFZ7dlA-YqDxw0zv3a0Wi8cX7MI3Sesl37r0w&oe=699EE002"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experien
g", "id": "1411922123312556", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V7GEwYF5M5kQ7kNvwE2p6VH&_nc_oc=Adnc7SbLBaOANKUbWQPVPHoYIyooxyYGmS_NkihAYgFFrBpncSkpl-Y-LvuIWjdcj_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkzC89k25tnusxxOMMSLMD3KsG_igScnIbwtaK9Hn-iQ&oe=69AC2871"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CnqjCSKbz0Q7kNvwFGnJ5L&_nc_oc=AdnlNJ2cHTQHaKWXo3QfWNxCUaQ-S6-0oON1sGDhEP36gNiLZvkqqQcbfL9O2IZ3z9k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwPnydiTwNdzqo6mlScVnhqzwsiAMepUP9CxTQqXqOkBQ&oe=69AC213D"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1iTpKR3KO4Q7kNvwFkPAkJ&_nc_oc=AdkaNbgcpouTfTkT_TO2hXVFbo2Aho_jiX5xkp3TRtpUX2uWC2p1zvsO69BdVygmFeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyhJUntHs7cn_QwGRcD7DceLaABtx53EBdeD11cX8pZ4A&oe=69AC0F02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR ap
.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvswMoX8SygQ7kNvwGDj_jt&_nc_oc=AdlzHU6VzHnbjbCL_6qDOnjYgOr8WGU2k4m4Y3vlYHXjrG-_4ceNKIdCaCSmFdRbta4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsOvZmOqmriIPuxsjjv_4_4Ftyh4fcVW4L31rjE9qbpsg&oe=69A43F71"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucpX9oF8NVEQ7kNvwEohc3H&_nc_oc=AdlU-IKzqhHsh08Ew0zW9J4q5UtITCa_vvlBecVXSX45hre8PZ1Q-m_4DfEkLSh5r7U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv87vs0Ga2ADy1iVxCNu9EpbPIkaNKqOnkQGUI7HZK_dg&oe=69A4383D"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SAgsRxpbp9YQ7kNvwF7dtvF&_nc_oc=AdnHzBVQq8kkE_hTjlOkfpKMpTi7YttIwZnY2n0OvRhcmKhlGi_nUwxfglq9i7VVtzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvQVUsU5o-BbcQOXG1iZO8LgCMC587VJeKpwgMBPNiNog&oe=69A42602"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experien
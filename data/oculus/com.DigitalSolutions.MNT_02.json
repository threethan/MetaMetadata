sid=6e7a0a&_nc_ohc=yTKreBjjVnQQ7kNvwE0IX_3&_nc_oc=Adq1tW9oRjQnaCK70PJseW3ROqcrLX00nxP8VoY1Blcplvs2O9Op4TmupNJqxnN-WSg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3WLWsN4NgETgRLA872X5a6LMqEAFRZXv70JCmNrUG_OQ&oe=69EA3416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzYHHpDA8zsQ7kNvwFEOgKs&_nc_oc=AdqR4l4kH7QE1Cnjbaqc5YGdz2AEh17P0zojMUHXFv8w0xVamfqAsr70BBP785Gi9Dw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LtEbC7zDjoJLX4D-k8poDvx1qwKJXyjzfI8XSGF6H6w&oe=69EA16A8"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
g", "id": "1411922123312556", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnlUxQQ4Ad0Q7kNvwGKh8D4&_nc_oc=AdnzDbf74946pHiF000hN3MD32mQ_wC_-dPfroMyKv-T22TGkddlhS1YuRhq7oiVE3s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuTxV7hcK6HBVNh2R_rFGvilLXexiBVJM3pJ9Puc8QJ1Q&oe=69A833F1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zC7e8RVsxEUQ7kNvwEwdHuq&_nc_oc=Adkfwtec8l9eueS38IiIMAsCYNXhacxp6jmqiAsGQlvZNmvLddpwqWUk6ZkRDE2gkFo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsjNnSNhBmnq6WD73pMe_xClqgkbNgTX9M508OjpudRvg&oe=69A82CBD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHgLAUJFuoEQ7kNvwEHXXIM&_nc_oc=AdkgyFCsOMedNQgbrOK0px6Ey-hmYlajtloRdab2EKjkbDxZqIjT4RY3VgW0ZmC93S4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs674u68mfroTKnneF2_-Ho2DTP8UNR5qCd4Og73hL1ug&oe=69A81A82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR ap
.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fe4aE6c4W2QQ7kNvwHwgCRU&_nc_oc=AdkfQ7kIE9dbx0q7ukk0rOL9gAM2c3vhdlaulWkYVVgEJT5byJYGBXx7kfIXn3czfXI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftTcGNr2KeGjnuB78wpuE4UQyA1zJXcr5JOHut3gD3H6A&oe=699B04F1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXRHyjsH2KEQ7kNvwFcRD-E&_nc_oc=Adkjxaozo2vz3J1Trux0W_M3xW_nhVVIpfU-9Q0cUNXMTml9PeK-tC-FzNJ6V76i8Lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuz9J0q4L7ntuEGYACyDkG_zdPM9BQ7_S-zkPpng1GItQ&oe=699AFDBD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv5wDznrN1UQ7kNvwElB_kZ&_nc_oc=AdnqmyJzAJOwgLM2nwIWPUNlby0wzQcczed6I4gfKOZgOGaUtCmd7EZrym6oezVLa1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs-OsZkpKeUdNZsBGnrxVW8Q11IZsXcmd4o5CzRtUVYeQ&oe=699AEB82"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experien
.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvswMoX8SygQ7kNvwFyGfag&_nc_oc=AdlYwfm7BkJSrAFanE1Us6UTzSM2JVs30BsQPf7nH2i8hydRadqpg_Nwn29jiu2imhw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsSDDJyvgyHh4jiBCZCLNh5KwdIHK8yQuEfL3a-xzWh4Q&oe=69A19C71"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6lV-Bdb1zYQ7kNvwH4brbs&_nc_oc=AdmkJlC1G8EB8lGF9-4Oi0ugELfc_aruvVSkdd_bx993H0wvXFjdBxGZZDEKIQQf4-s&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftjR5QOoDJ1XP0_D_IVaWwJ1En0ZDUtKUmw5hrtLfOiAg&oe=69A1953D"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whz93xj7VBoQ7kNvwEpRMjm&_nc_oc=Admpvi8IWFaAJF3Rq2bUnPyvH89ng8gSYHkdYlgYu2UAZ7adbrgYhL7JSgH9UmraRTg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afuz0a1O41MYFtf33wuEKtMehwBLQqDF7GjqQF3fmUph-g&oe=69A18302"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experien
Q&oe=69D7BDCB"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ET1gg1TRYBUQ7kNvwEayU5Y&_nc_oc=AdpqPGa6AUkdcYRi916ULlA5SB2u8GRbXbJ6qU0VoVSyXUTTSJ5snJUJE_0BN9aS5yY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HwZQZwUsrYcvTnd6-fpdGeIx682GGRK-tUmwBKlxXIA&oe=69D7A9F1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8QQadB818oQ7kNvwF7m83b&_nc_oc=AdoRMmL9Iy9rS-OHV2-yXL3SJc6Mhe7MWwFhhPNIW5aSbXpob3foI0HIexd0p_MffRA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PDfDSBLpVvfkMOD7Z8vRNvvbqoDG3yghVl7u1WAspNA&oe=69D7A2BD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6LyjYfa--EQ7kNvwHuUjlS&_nc_oc=AdrPdahP8UupThPOU-uXgLw9vsBkdJ5VeUl5eXYKsujUN_zyxVmq6aj6FVtWK5kCl3E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GyZ6WXmuojeyqmJdacjLV-BWx1Ni6K2SGutLYqmXm9A&oe=69D79082"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
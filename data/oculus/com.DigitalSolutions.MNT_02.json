1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2S1i1TyHFPsQ7kNvwH6vI69&_nc_oc=AdqrtoNfHrn6SknWZw1a0n15KO7ogEmMUZ-vV2ACm-YbJZn-lkm6cXIWtV8Qip020Yc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xiCF1I7YwX4npD-qCd9LzeVOEIsTS3maCcc6OfN-LXQ&oe=6A36AB16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kySuYEqpXdUQ7kNvwFta5FI&_nc_oc=Ado77HW8FKlhStt3bHvRK8rb3-ZWGvKpJQW5nA6ztD9yIZPLnt9xozZM5uH2CGutqN8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1Z1DNbYfP7AWmaP6USUYMFekjUUZ3e33rsHTj5GVUgw&oe=6A36C5E8"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "co
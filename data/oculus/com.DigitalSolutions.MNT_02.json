sid=6e7a0a&_nc_ohc=vfhDf-ApZ3QQ7kNvwH2gE5a&_nc_oc=Adp_GhWgEl7nlm4Y0JrCdhoxBjxpJK-qR38CQp3IvWmjx5_QokBWkf58Hbe3yOvrDZk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHto6Ph82YNV0dqE3ch32HFUWQOF4K_-u2DbL1T7qckKA&oe=6A882FD6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prj1BQTHJqkQ7kNvwEt_ytv&_nc_oc=AdoVPHrPLi1SIhO-4b7QqEm-L75jkBxb4Lk0PAahr4raO1Gz3cTEPGfPQvUO_LlJvLI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7A4IYSvnvOxSzhRd5-mevFzHpHwYdctJqX8HPR1Em8A&oe=6A884AA8"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
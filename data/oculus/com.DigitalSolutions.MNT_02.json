sid=6e7a0a&_nc_ohc=UPSmIFXytKoQ7kNvwFNIHbF&_nc_oc=AdohuRJraFk8keM5K1PGIU2eJHRpBtx9rCfftBndMYp6A5UV7JcKbPRpvO_p4cdtBNg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUln1G7vqYksSZQjdi7_meT5NgzKf8_4FqKqQ_5za29Q&oe=6A74A196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RAezDncDa6sQ7kNvwEA3pUC&_nc_oc=AdrqZaPJCHvkT5q_PcNEQE0P8kbWRR3Dk0zuXRuotWLxKAevsScwN7R9C3gjgf9Fy3A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU6y_4BUVgZKS8jP3igYachYHkJSQp4jg8M6W9TUFqpQ&oe=6A748428"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
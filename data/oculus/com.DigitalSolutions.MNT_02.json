ps://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/228885152_700530435234040_6812901558081139575_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-mn70lms28Q7kNvwHXh9dB&_nc_oc=AdqEaRBBK2d7Cn30Vg65QTX9dikqNHBJslIYYsDg6mjANVdQ9p4RRgvWCtVi1UAR9SA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5gkj_ygcVKTgLREnIW1pB9jQ19RZRG7kXXdRMLOwkqQ&oe=6AC50D16"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOcANHmN-rEQ7kNvwFS8Zgx&_nc_oc=Adol4bY0iBmiWfAlAnfd6f_UM64sKG9TO43Nlq0kfPqST7oOmntT8QcYWELAiIY8Jck&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMO1UIoc83CFeq5XvqyKJkoOFxtgSVjMgr3eVeJQdkZNg&oe=6AC527E8"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_
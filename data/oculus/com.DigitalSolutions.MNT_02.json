ps://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/228885152_700530435234040_6812901558081139575_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIvXOHjbIa0Q7kNvwFfWDpV&_nc_oc=AdpbpIt-bZ9fsyoHJaEYs8iRHoHx7fE3_9b7MBtgTUgqYlBecoMZ7yVgvXQj5a2WACQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqHDr3Dvk1PYWWjAJ2BoE3v0C0b2sTtaSXMqs3tMoA8Q&oe=6A940D56"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdfr4e30QcgQ7kNvwF3HUVb&_nc_oc=Adq9N7KuhSBciixYl1pYZMEaGpmuhr1A1SA947uFPaxpzQWc8g3RV4xAEnwgmMNsLt0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELy3kFGtROabQlOOW7vd5N88o3BjnpZY0y-jQlHfIuqw&oe=6A942828"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_
ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/228885152_700530435234040_6812901558081139575_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gS2pLwj-cMMQ7kNvwEK1x56&_nc_oc=AdqttVMp55cIugXvcK-xvnPWKtKrS5p3yLtrmcXxDPA4v_incUR9qT96Z44Qq2rGlzA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr92mT20TUZ3qzJHJGUMOvLjSgaRwCZRWfWmZT5KXRQg&oe=6AAC0096"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HkfjCFVERgQ7kNvwF248yf&_nc_oc=Adp1C2cYARDZJ3bUCpJK1q74wWGyvZsjwcJr_yxpoz9d8s-0CIAS2c-ZLlJqQJyTXRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8DhwhNCn2IjaaCznArRBG69Ox9w9B08x3A4NiUbChUQ&oe=6AABE328"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_
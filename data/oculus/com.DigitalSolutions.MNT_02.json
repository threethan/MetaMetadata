Q&oe=69C26D8B"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4yfGIDrlnMQ7kNvwF8UHbn&_nc_oc=AdoGggWMXEBIrjA9uhW_ikDadctAffReorD3i_uGWZDhX79BfGDXJdBr_THZdc6GJ_8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtMCiI4p0oef7Qqqikw4uASzzimvdzatQ8eakPp28IKQ&oe=69C291F1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YB8TS-lycGcQ7kNvwGo3NU5&_nc_oc=AdpRqBzskgmMDaby3v6vVa8cdHUh_vn3fS-YFq8S1HXI-YH7JSNRedR1LnBOiov9ELc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzJlONNVMFCKs4O7Z5yO7TElCE2juQ4lwLM3BIgxUrQCw&oe=69C28ABD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Bb9WPKO8IAQ7kNvwH6NUqv&_nc_oc=AdqNvFO49TLxJVBofF49Li8NejpSsrgwc491A6Mrne6Rd3Us4Z3NZO695gijGwpeFkA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJY1idcdMFBSY5AYoBM8KqwvnhMKrstakeQy_cKiz3Uw&oe=69C27882"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
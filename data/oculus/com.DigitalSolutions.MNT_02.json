Q&oe=69CFD4CB"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_Vl3pHM7UoQ7kNvwG0yPO7&_nc_oc=Adq1OLwcR6lkrtmAbNBetEHBF_5z3fiy384WozqUBjbmiSz0M_kxPqCui3HbLWrZl5E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0RaT-VHF4_9tT80Sn-S0kVASC8c00NdtxrUl_pjDdAw&oe=69CFC0F1"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRo4FQKyrFEQ7kNvwHtR2g-&_nc_oc=AdpxAW7FhWeJp7RjVVjz1ioJEpIq_PpUTqMy98RIIfe6gPaTlYrWrm00Nxca4YzPu9I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCQdnUzTLUD8WVj4JifcHa--VjjZd4DYzrFyB9LfMIlw&oe=69CFB9BD"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRNQCG_MoLsQ7kNvwFvixv0&_nc_oc=AdoTNCgAXj8YJpLsMZw6PFMJ8wG26tTLvK0RzdC3SDF5YhhaFl1pfY5FNNCs4OOD-aY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwISiwBjmt_AhGpHXrHUSMgQA49gpGPLCwrE6ACv-GYqQ&oe=69CFA782"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
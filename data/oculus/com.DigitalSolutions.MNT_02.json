sid=6e7a0a&_nc_ohc=M2Z4lm9hgSIQ7kNvwHTSG6-&_nc_oc=Ado7kaCPf36ko6LNZIaKBFxiu1totdeXcvZnqNTiVvTSXRKuJAKuq24qYIFPrMjvA2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbTdAK6INn9k1Smzyx4QAH5azFHvQMvtglgj3eObheKQ&oe=6A79E796"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNVcfOdOpVIQ7kNvwHdAstX&_nc_oc=AdqoJGCJjzzg65YaEUzx0iEjKtKgHpBAH-jXRMuIj5gMLJWP1tbh8cHKbjNzlr4nFOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVXoZie582LCdJKCNaewcOxUZ3G51HMa5_O6nXR57GNw&oe=6A79CA28"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [
g&oe=69D3910B"}, {"file_name": "3.png", "id": "1411922123312556", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391917_1411922126645889_7017155193336148517_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmKmX2z9frIQ7kNvwH7gK-3&_nc_oc=AdpXh1uzpmxwsHE5odiIGvk34KP1ieb3Uel2slmX7Q_P-YC33vR3bg9hHiwVFZr3Iag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1knU7vZKYQdx-DNa5BdHkPKy4HS_nZnMXY-1bmmXeZ0g&oe=69D3B571"}, {"file_name": "4.png", "id": "2409848569384956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392104_2409848572718289_2236004083571848068_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDot3niwyM0Q7kNvwH0fpR0&_nc_oc=Adr1SAedPpzcOc_czLDE7317NtQLj1Ho3Vqr1q-Th4XFpxqJmIGC1MoqrcFAxr7xDeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uBgUL9DOOkaPxcQzN7-JAd0vPCRQIQOlOpubk2km1Dw&oe=69D3AE3D"}, {"file_name": "5.png", "id": "2260133974417897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827018_2260133977751230_7450312865859974372_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsAUBXbnGpoQ7kNvwHryK9R&_nc_oc=AdrL0p8Pvi-WPCuT9EzKW8MH_7gfCwFIS5qQS82W7ReiztyBCTSfMxdWKHUHvza8AV4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_RUybdbGdM9YtokTuKo2YSNAzXbKLtjjsxjUWIh2JRw&oe=69D39C02"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongoli
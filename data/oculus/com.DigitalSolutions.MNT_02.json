&_nc_sid=6e7a0a&_nc_ohc=YI3_xfkIbhoQ7kNvwHEeODo&_nc_oc=AdriP70JMMTVGO6SBtSpI6XoofOScIdS2WpdDABCqF7RSaY0ZWZE2uWNN6QoqIH1Xhk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvFIA9p3AsEEyxRU7PmxerW_RQgS86Ws7_b3JbU0dpew&oe=6B0318A8"}, {"file_name": "shot.png", "id": "700530431900707", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/228885152_700530435234040_6812901558081139575_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT6vg1NU-HkQ7kNvwF3rtvW&_nc_oc=AdroCoHZACwdXgje_ZGKynelS04QcgybV-SDdoivXkpJjwI1fVghkBAXn4QzyvxB3-E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzbHW2ADwgBLDG-2ShFplgbmy3LOf2f_74-iSMCRa5rQ&oe=6B030396"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape2.png", "id": "7702966569717432", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75458092_7702966586384097_5778387012621659606_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDawyBV6QKwQ7kNvwF762fP&_nc_oc=AdrQyIxxfX6LmR6Lfrn04Grgzufw91aOdDnitev9-yt-1wcoq-rMlQGj0-QRDYqpOf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb3dFoG049_AZt6pTe9Ac-nOKGYuhOv5mYS3q_eqkHZg&oe=6B031E68"}, "display_name": "Secret History of Mongolia Volume 2", "keywords": [], "long_description": " As users navigate through the app, they are transported to different sites, each meticulously rendered to provide a realistic sense of presence in those places. Accompanying these visual experiences are detailed explanations and narratives, shedding light on the historical importance of each location, its role in the \"Secret History of Mongolia\", and insights into the Mongolian culture and heritage. This app is a unique blend of history, technology, and storytelling, offering users an engaging and educational journey through Mongolia's rich past.", "short_description": "The VR app focused on the places mentioned in the \"Secret History of Mongolia\" is an immersive educational experience. It features stunning 360-degree images of various historical and culturally significant locations associated with the Mongolian Empire's history."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "DigitalSolutionsVR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7651838978179196"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "943036434731543"}, {"status": "PUBLISHED", "id": "1320282125725362"}, {"status": "PUBLISHED", "id": "2081486955564516"}]}, "baseline_offer": {"id": "943036434731543"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776157980, "status": "PUBLISHED", "id": "943036434731543"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7652536898109404", "version": "1.0"}, "id": "232219556633736", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7651838971512530", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "7652536
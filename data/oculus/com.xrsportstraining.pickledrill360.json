_ss=7f20f&oh=00_AQRJOAKQiuyRtVWC2Fjcy6Np_bYE-Dcnrmjef4rxRaLn9Q&oe=6AFDD7BE"}]}, "id": "1826941645064253", "locale": "en_US", "screenshots": [{"file_name": "a3.png", "id": "1731930918170368", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307602_1731930921503701_5511450863583708577_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePMBayespV8Q7kNvwFd1mi6&_nc_oc=AdoFpaQrJpqk8FYfvokvayEPRr2o2-b-rjt9mtmJQB145uAjMFRVIeEeCUm5U-AV0L0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQF6osnHqd5gsESuoZNeIh41h1Zis6AXFc-4GPZbMBFA&oe=6AFDBED8"}, {"file_name": "15.png", "id": "1273923858125809", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300678_1273923861459142_5327374229022355974_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUYUWYp67rQQ7kNvwGv9PEM&_nc_oc=AdonRcJgY9DDUth4Oq_JigqoiiUQJkHyaHEWpylyaHhe66TZkj4F9e4J2hJAlPXUMwQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwboB1wrh8kY0a04nLiR3PkEeRfgzuJI7idjdQdThr4g&oe=6AFDC3A4"}, {"file_name": "a4.png", "id": "1433461268047876", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308131_1433461274714542_3265677367600588666_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vj90nMrAcAYQ7kNvwEKFtZT&_nc_oc=Adr0vXZCr56Mx299N-ppBR-ApRPL3hp2mvkrj3iTrL7g2O_pRag3rqDuWkH8deqBKbc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO7RvvcYE-z5dffnFMd62z1Ma2owuqhVdr3_9lLP-lxA&oe=6AFDE221"}, {"file_name": "14.png", "id": "889268210678853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300603_889268214012186_390680755023029844_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmQsqmaQToEQ7kNvwF7XJim&_nc_oc=AdpNEYSgLW7NFdaC7gPJOqHOIr0eSBkBucnN4bGFhNIF3495H07-B9BcjfmQcQn0FPE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToskLtMwh9Sg23PTc01WymTHw7HYTv9IIlIQ5S9I4LgA&oe=6AFDDFBC"}, {"file_name": "10.png", "id": "1256040156486821", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303140_1256040159820154_7144320371755253426_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzT4PHx4LdoQ7kNvwHaUij5&_nc_oc=AdrOG480VLHVhitiJ3OBvBLxavTfDuONMXGksUFtzav86RDzGNOR-wwgbzR3XimHb7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcukkRpd2NTwRR4i9Dy5wtdDezop-bZmD2psaDJ1ZMzw&oe=6AFDC36B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PD_2560X1440.png", "id": "984879524051473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499294650_984879527384806_3357291839058649939_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjzT8jnnLL0Q7kNvwHtMkjL&_nc_oc=Adp8hoa6n6GybCDUBNiMY_FM4RL6L9dQKtcM9UWG48cyVh16o2bPCxTuNG1u5excoOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5RMIhAS6hX1g018pCEbwW2lgwEh_qvK5rDwCCuTUObw&oe=6AFDE33B"}, "display_name": "PickleDrill360", "keywords": ["pickleball", "drills", "training", "coach", "practice"], "long_description": "# Train Smarter with PickleDrill360\n\nPickleDrill360 is a **Mixed Reality** training simulator designed for real results. Practice the shots that matter through structured drills, unlimited reps, and detailed analysis.\n\n{2389945388201829}\n\n\ud83c\udfe0 **Train Anytime in Your Space** \u2013 Practice at home in spaces as small as 10 ft \u00d7 10 ft up to a half court, using real footwork and movement. No partner, no court reservation and no balls to pickup.\n\n\n\ud83c\udfaf **A Large Variety of Drills** \u2013 Work on key shots like serves, dinks, drops, drives, and speed-ups through a growing library, with new drills added every month.  \n{1251572727070948}\n\n\ud83d\udcc8 **Track Your Performance** \u2013 Every shot is recorded, giving you insights into accuracy, shot types, speed, and spin so you can track progress and improve over time.  \n{1271311871100835}\n\n\n\ud83d\udd04 **Practice Game-Like Transitions** \u2013 Train multi-shot sequences that mirror real gameplay. Combine shots, move through the court, and build the footwork and timing needed for live points.  \n\n{1009793058331435}", "short_description": "Improve your pickleball game at home with PickleDrill360. This Mixed Reality training system delivers an ever growing library of structured drills. Move naturally in your real space while practicing serves, dinks, drops, speed ups, and more to build timing, consistency, and footwork for real match play.\n\nEvery shot is tracked with detailed stats and analytics so you can measure progress and improve over time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickledrill360.com/pages/privacy", "developer_terms_of_service_url": "https://www.pickledrill360.com/pages/terms-of-service", "publisher_name": "XR Sports Training", "support_website_url": "https://www.pickledrill360.com/pages/support", "website_url": "https://www.pickledrill360.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "39830234993288979"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299845_3369970123150780_4784626612895047806_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAIzYAOZbYwQ7kNvwES6Tia&_nc_oc=AdrGuKH41eQFIF
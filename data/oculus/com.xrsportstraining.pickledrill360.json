culuscdn.com&_nc_ss=7f20f&oh=00_AQQE44Gl2pkbId4Wz7504uDlOjlR1kf8CuR6XkCVlAuv7g&oe=6AFB1BD8"}, {"file_name": "15.png", "id": "1273923858125809", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300678_1273923861459142_5327374229022355974_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgwxQZz48KUQ7kNvwE_uGIm&_nc_oc=AdouRPQp9WaaaQAdQDS9mJwbGYv3gl_7AylL66Rgh4186FgdFE_rFzpoICQ8ycKiY8s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROx_blJrsHwDbj0bv4ATNtV0qvDJwQLq6o_TsQtvC45g&oe=6AFB20A4"}, {"file_name": "a4.png", "id": "1433461268047876", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308131_1433461274714542_3265677367600588666_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnYKZ4kG8UoQ7kNvwEfKM7z&_nc_oc=AdpTfw3Hgx-pLgrsof8NvLQ4AnUypCMggvrrRziltRUQXhdmQ01nyU6hI_-BTc3W3Sk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2G4dEaG2UIqOcX01aVmh5Q3RTwex_lIxZ9jVaGvz69w&oe=6AFB3F21"}, {"file_name": "14.png", "id": "889268210678853", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300603_889268214012186_390680755023029844_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmQsqmaQToEQ7kNvwFt9pLd&_nc_oc=AdrcL30itMgHPVXH2ZVUSvQ8DO7LmzPb-PeNFXCBSecy8xkn-EWAEyhki_T5rC_ghzU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlr-f_qEx3cG7aEK2n9TOln63YS3Fpjd5LWYE38fE9Lg&oe=6AFB3CBC"}, {"file_name": "10.png", "id": "1256040156486821", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303140_1256040159820154_7144320371755253426_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaBiyOvlS_kQ7kNvwGXr1Q1&_nc_oc=AdooT-o-N4hfJpHcFe_ALJbMRX5MGX7dOGXY4HHAI2wqA5szV79UZCneBDxbKV5NNtc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG5QH618xVcym1xKPMIaPwdCxoC0m5KjGcPRxboJdJbQ&oe=6AFB206B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PickleDrill360", "keywords": ["pickleball", "paddle", "racket", "drills", "360"], "long_description": "# Train Smarter with PickleDrill360\n\nPickleDrill360 is a Mixed Reality training system designed for real results. Practice the shots that matter through structured drills, unlimited reps, and detailed analysis.\n\nDevelop timing, consistency, and footwork with **measurable progress that carries into real match play.**\n\nStart your **free trial** today. Subscription is required for continued access.\n\n\n\ud83d\udd01 **Train Anytime at Home** \u2013 No partner or court needed, and no stopping to pick up balls. Get in thousands of reps and build consistency.\n\n\ud83e\udd7d **Train in Your Real Space** \u2013 \ud83c\udfe0 Practice in spaces from 10 ft x 10 ft to a half court using real footwork and movement.  \n{1503606424434016}\n\n\ud83c\udfaf **Train on a Variety of Drills** \u2013 Work on key shots like serves, dinks, drops, drives, and speed-ups through a growing library, with new drills added every month.  \n{1251572727070948}\n\n\ud83d\udd04 **Practice Game-Like Transitions** \u2013 Train multi-shot sequences that mirror real gameplay. Combine shots, move through the court, and build the footwork and timing needed for live points.  \n\n\n\ud83d\udcc8 **Track Your Performance** \u2013 Every shot is recorded, giving you insights into accuracy, shot types, speed, and spin so you can track progress and improve over time.  \n{1271311871100835}\n", "short_description": "Improve your pickleball game at home with PickleDrill360. This Mixed Reality training system delivers an ever growing library of structured drills. Move naturally in your real space while practicing serves, dinks, drops, speed ups, and more to build timing, consistency, and footwork for real match play.\n\nEvery shot is tracked with detailed stats and analytics so you can measure progress and improve over time.\n\nStart your free trial. Subscription required for continued access."}]}, "developer_name
humbnail": {"file_name": "PD_2560X1440.png", "id": "984879524051473", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499294650_984879527384806_3357291839058649939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ac5-FOcaD18Q7kNvwH7p7Sv&_nc_oc=AdoALJcdtX9BX3Q4i6R8jlmCtO8rMJXeqCVY3RyULG6X23Jbzw_kRZKeWcCt_hsgv7c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_s65EPUK74SevMmdqB1hWdoSZGDDGC6CdDz9jWfXNkQ&oe=6AEDD8FB"}, "display_name": "PickleDrill360", "keywords": ["pickleball", "drills", "training", "coach", "practice"], "long_description": "# Train Smarter with PickleDrill360\n\nPickleDrill360 is a **Mixed Reality** training simulator designed for real results. Practice the shots that matter through structured drills, unlimited reps, and detailed analysis.\n\n**Start your 7-14 day Free Trial today**.  Use the promo code **SUMB5-E9C070** and save 67% on the first three months after the trial ends.\n\n{2389945388201829}\n\n\ud83c\udfe0 **Train Anytime in Your Space** \u2013 Practice at home in spaces as small as 10 ft \u00d7 10 ft up to a half court, using real footwork and movement. No partner, no court reservation and no balls to pickup.\n\n\n\ud83c\udfaf **A Large Variety of Drills** \u2013 Work on key shots like serves, dinks, drops, drives, and speed-ups through a growing library, with new drills added every month.  \n{1251572727070948}\n\n\ud83d\udcc8 **Track Your Performance** \u2013 Every shot is recorded, giving you insights into accuracy, shot types, speed, and spin so you can track progress and improve over time.  \n{1271311871100835}\n\n\n\ud83d\udd04 **Practice Game-Like Transitions** \u2013 Train multi-shot sequences that mirror real gameplay. Combine shots, move through the court, and build the footwork and timing needed for live points.  \n\n{1009793058331435}", "short_description": "Improve your pickleball game at home with PickleDrill360. This Mixed Reality training system delivers an ever growing library of structured drills. Move naturally in your real space while practicing serves, dinks, drops, speed ups, and more to build timing, consistency, and footwork for real match play.\n\nEvery shot is tracked with detailed stats and analytics so you can measure progress and improve over time.\n\nStart your free trial. Save with PROMO COD\nSubscription required for continued access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickledrill360.com/pages/privacy", "developer_terms_of_service_url": "https://www.pickledrill360.com/pages/terms-of-service", "publisher_name": "XR Sports Training", "support_website_url": "https://www.pickledrill360.com/pages/support", "website_url": "https://www.pickledrill360.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36679495058363004"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299845_3369970123150780_4784626612895047806_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sfEn4J_TREQ7kNvwF461Bl&_nc_oc=AdrwWYAkl-xU7uoJIbOg0pFWL5s789rb7oq1z39DgiKvvU-I5Dkmd7GcSazWB22JZn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrmiHQq9yiVw9v8RdXtuxgb2-eFIL0qxBOOj-8m7xP0Q&oe=6AEE093B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PickleDrill360", "
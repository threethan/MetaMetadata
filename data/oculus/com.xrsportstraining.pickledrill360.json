268047876", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308131_1433461274714542_3265677367600588666_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZJuizJrW1YQ7kNvwF0WGrf&_nc_oc=AdoFJ-gjC48uKZ1OS0zsnjEeqGFxYJEddL8Uqhq-ja0SRx-u48K2NEyJZprrJlK32V0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zDRh5vNQ7esi8smvMRU8etYAY1K12C_K82XWQ1YUCZg&oe=69FDE6E1"}, {"file_name": "14.png", "id": "889268210678853", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300603_889268214012186_390680755023029844_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqNeXWxTSMsQ7kNvwEp-hIP&_nc_oc=Adp5Uxz51_gAEhqu68hULW-iQskWukY37IHjbmjb50q2HtHVHoCRA89ElShV18-CUZ0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LJhRvJGmurTuThgZlGSadCtXg3yskwskAAKvyoR8aUA&oe=69FDE47C"}, {"file_name": "10.png", "id": "1256040156486821", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303140_1256040159820154_7144320371755253426_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PgrE4DVK3ZYQ7kNvwFgmGNj&_nc_oc=Adpn7LEp5YV7Vj1t71JwYWr76CbNqRj1vZMSLt4Ymcr6TegcYaDu9ZgMIdMoQe4SEzA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hB_ufQtgoFk1q9gHFPhtJFVuBLHWdYMA857kgwTgRgw&oe=69FE006B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PickleDrill360", "keywords": ["pickleball", "paddle", "racket", "drills", "360"], "long_description": "# Train Smarter with PickleDrill360\n\nPickleDrill360 is a Mixed Reality training system designed for real results. Practice the shots that matter through structured drills, unlimited reps, and detailed analysis.\n\nDevelop timing, consistency, and footwork with **measurable progress that carries into real match play.**\n\nStart your **free trial** today. Subscription is required for continued access.\n\n\n\ud83d\udd01 **Train Anytime at Home** \u2013 No partner or court needed, and no stopping to pick up balls. Get in thousands of reps and build consistency.\n\n\ud83e\udd7d **Train in Your Real Space** \u2013 \ud83c\udfe0 Practice in spaces from 10 ft x 10 ft to a half court using real footwork and movement.  \n{1503606424434016}\n\n\ud83c\udfaf **Train on a Variety of Drills** \u2013 Work on key shots like serves, dinks, drops, drives, and speed-ups through a growing library, with new drills added every month.  \n{1251572727070948}\n\n\ud83d\udd04 **Practice Game-Like Transitions** \u2013 Train multi-shot sequences that mirror real gameplay. Combine shots, move through the court, and build the footwork and timing needed for live points.  \n\n\n\ud83d\udcc8 **Track Your Performance** \u2013 Every shot is recorded, giving you insights into accuracy, shot types, speed, and spin so you can track progress and improve over time.  \n{1271311871100835}\n", "short_description": "Improve your pickleball game at home with PickleDrill360. This Mixed Reality training system delivers an ever growing library of structured drills. Move naturally in your real space while practicing serves, dinks, drops, speed ups, and more to build timing, consistency, and footwork for real match play.\n\nEvery shot is tracked with detailed stats and analytics so you can measure progress and improve over time.\n\nStart your free trial. Subscription required for continued access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickledrill360.com/pages/privacy", "developer_terms_of_service_url": "https://www.pickledrill360.com/pages/terms-of-service", "publisher_name": "XR Sports Training", "support_website_url": "https://www.pickledrill360.com/pages/support", "website_url": "https://www.pickledrill360.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ad
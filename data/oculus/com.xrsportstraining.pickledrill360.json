humbnail": {"file_name": "PD_2560X1440.png", "id": "984879524051473", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499294650_984879527384806_3357291839058649939_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0Xu1gcvQhAQ7kNvwG-iprR&_nc_oc=AdrRBUB9dy4Jf6pKs6fGp_Ij9UqL_bCDHfbhlzDrObPCa23HZb9fuCcUKBSZseWReBg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VUULBkcxkOzRyyhMdSkD31UbwRXR6vJoVsqN1zfrbUg&oe=69FDE7FB"}, "display_name": "PickleDrill360", "keywords": ["pickleball", "paddle", "racket", "drills", "360"], "long_description": "# Train Smarter with PickleDrill360\n\nPickleDrill360 is a Mixed Reality training system designed for real results. Practice the shots that matter through structured drills, unlimited reps, and detailed analysis.\n\nDevelop timing, consistency, and footwork with **measurable progress that carries into real match play.**\n\nStart your **free trial** today. Subscription is required for continued access.\n\n\n\ud83d\udd01 **Train Anytime at Home** \u2013 No partner or court needed, and no stopping to pick up balls. Get in thousands of reps and build consistency.\n\n\ud83e\udd7d **Train in Your Real Space** \u2013 \ud83c\udfe0 Practice in spaces from 10 ft x 10 ft to a half court using real footwork and movement.  \n{1503606424434016}\n\n\ud83c\udfaf **Train on a Variety of Drills** \u2013 Work on key shots like serves, dinks, drops, drives, and speed-ups through a growing library, with new drills added every month.  \n{1251572727070948}\n\n\ud83d\udd04 **Practice Game-Like Transitions** \u2013 Train multi-shot sequences that mirror real gameplay. Combine shots, move through the court, and build the footwork and timing needed for live points.  \n\n\n\ud83d\udcc8 **Track Your Performance** \u2013 Every shot is recorded, giving you insights into accuracy, shot types, speed, and spin so you can track progress and improve over time.  \n{1271311871100835}\n", "short_description": "Improve your pickleball game at home with PickleDrill360. This Mixed Reality training system delivers an ever growing library of structured drills. Move naturally in your real space while practicing serves, dinks, drops, speed ups, and more to build timing, consistency, and footwork for real match play.\n\nEvery shot is tracked with detailed stats and analytics so you can measure progress and improve over time.\n\nStart your free trial. Subscription required for continued access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pickledrill360.com/pages/privacy", "developer_terms_of_service_url": "https://www.pickledrill360.com/pages/terms-of-service", "publisher_name": "XR Sports Training", "support_website_url": "https://www.pickledrill360.com/pages/support", "website_url": "https://www.pickledrill360.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35169294629383062"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499299845_3369970123150780_4784626612895047806_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTCtXiXg8DoQ7kNvwEitsRG&_nc_oc=AdqlYDkTYZNjc7m8ymW-o1vZ8qLiCQ5PSxyJv79CljcXEtdzPgkitomgs1xsf7Vbcag&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pJjoN7CVuVte8S31nzSbNjwxjXHg96YI2JMOZia9yqQ&oe=69FDDFFB"}, "is_concept": false
culuscdn.com&_nc_ss=7f20f&oh=00_AQR0DdpHn6bUrKLGX7B2SN6_zx1yJ9jZhN7qNCOnk4_2kQ&oe=6B045658"}, {"file_name": "15.png", "id": "1273923858125809", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300678_1273923861459142_5327374229022355974_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z83RElz3WMEQ7kNvwGWWcEC&_nc_oc=Adqxgdyt5pNCBlqeNUT2X3VMOXEtQxtVhAdKGd41MA_CPaPQhG7n1VNH9Ie4yxwZRzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJU-qh2s49XaCnwgDG-c8oBA0SVMhmwwQ3EZj2UNS9VA&oe=6B045B24"}, {"file_name": "a4.png", "id": "1433461268047876", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308131_1433461274714542_3265677367600588666_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZYfdT6-oLsQ7kNvwFuY2X5&_nc_oc=AdqXxWK1HSM-tuM_3RRo2DGoSbZfgXqnsCYS2NPrMBnvWLEMYwCgknfggEWw_1mVFx8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR6F__j8F2jCf_K3Tm2Wwlc7Jp0yA0-FaK9nisq0zmnA&oe=6B0479A1"}, {"file_name": "14.png", "id": "889268210678853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300603_889268214012186_390680755023029844_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TaLScw5e7MQ7kNvwH-4fXZ&_nc_oc=AdpAmoTYMutUITuCvm-nDyE8rtjWK5htn39rNC8vpCGRYoo4u0ckUT__X53bLGO3w0Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUfcd6wFkg1P2JYuTmzEqPOHAW95onhOEqr4OkNxaQkA&oe=6B04773C"}, {"file_name": "10.png", "id": "1256040156486821", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303140_1256040159820154_7144320371755253426_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5S4PWQDF2ngQ7kNvwGdUjXJ&_nc_oc=Adohk1yjnC-11Dcdzn4r9FSJUAcJM8Ga1LdkvqKkuJ2uHhtIcHJFb09I8B-bet-xxFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbRvM-nE-vSrrJae672_0RF8S8M5opOFIJ2l-Us1l8sw&oe=6B045AEB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PickleDrill360", "keywords": ["pickleball", "paddle", "racket", "drills", "360"], "long_description": "# Train Smarter with PickleDrill360\n\nPickleDrill360 is a Mixed Reality training system designed for real results. Practice the shots that matter through structured drills, unlimited reps, and detailed analysis.\n\nDevelop timing, consistency, and footwork with **measurable progress that carries into real match play.**\n\nStart your **free trial** today. Subscription is required for continued access.\n\n\n\ud83d\udd01 **Train Anytime at Home** \u2013 No partner or court needed, and no stopping to pick up balls. Get in thousands of reps and build consistency.\n\n\ud83e\udd7d **Train in Your Real Space** \u2013 \ud83c\udfe0 Practice in spaces from 10 ft x 10 ft to a half court using real footwork and movement.  \n{1503606424434016}\n\n\ud83c\udfaf **Train on a Variety of Drills** \u2013 Work on key shots like serves, dinks, drops, drives, and speed-ups through a growing library, with new drills added every month.  \n{1251572727070948}\n\n\ud83d\udd04 **Practice Game-Like Transitions** \u2013 Train multi-shot sequences that mirror real gameplay. Combine shots, move through the court, and build the footwork and timing needed for live points.  \n\n\n\ud83d\udcc8 **Track Your Performance** \u2013 Every shot is recorded, giving you insights into accuracy, shot types, speed, and spin so you can track progress and improve over time.  \n{1271311871100835}\n", "short_description": "Improve your pickleball game at home with PickleDrill360. This Mixed Reality training system delivers an ever growing library of structured drills. Move naturally in your real space while practicing serves, dinks, drops, speed ups, and more to build timing, consistency, and footwork for real match play.\n\nEvery shot is tracked with detailed stats and analytics so you can measure progress and improve over time.\n\nStart your free trial. Subscription required for continued access."}]}, "developer_name
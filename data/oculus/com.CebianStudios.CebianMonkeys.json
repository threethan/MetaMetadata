gdA50Q7kNvwEYypTF&_nc_oc=AdpXpVC86cZDhBv2N5HF-Kp_reHaR2Uejv44cK00TVe6vbDtmx09Zju5mpOg2YV90T0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kVOMaz6hBZr7tGLEcAaO34NAHicZmt1xnQjw2HydH9g&oe=69F76833"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cebian Monkeys", "keywords": ["cebianmonkeys", "cebian", "Monkeys"], "long_description": "\ud83d\udc12 Cebian Monkeys \u2013 A GTAG Fan Game\n\nCebian Monkeys is a fast-paced, physics-based VR-style fan game inspired by Gorilla Tag (GTAG). Play as a monkey and swing, climb, and bounce your way through exciting environments with your friends. With fun maps, a working shop, and even basketball, Cebian Monkeys takes the GTAG formula and adds its own unique twists!\n\n\ud83c\udf33 Forest Map\n\nExplore the main Forest area, filled with trees to climb, branches to jump between, and plenty of space for tag and parkour.\n\nIt's a perfect place to test your movement skills or chase your friends in a game of tag.\n\n\ud83c\udfc0 Basketball System\n\nGet sporty with the built-in basketball system!\n\nGrab, dribble, and shoot basketballs in dedicated courts.\n\nCompete in mini-games, score hoops, or practice your monkey moves.\n\n\ud83d\uded2 Shop System\n\nVisit the in-game Shop to browse and buy cosmetics like hats, glasses, and other fun accessories.\n\nCustomize your monkey to stand out \u2014 no pay-to-win, just style!\n\n\ud83d\udc65 Multiplayer Fun\n\nDesigned for fun with friends or strangers online.\n\nRun private lobbies or join public games to meet other players and show off your skills and cosmetics.", "short_description": "\ud83d\udc12 Cebian Monkeys is a GTAG-inspired fan game where you play as a monkey swinging through forests, scoring hoops with a basketball system, and customizing your look in the in-game shop. Climb, tag, dunk, and have fun with friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/cebianmonkeysprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Rexxy546", "support_website_url": null, "website_url": "https://sites.google.com/view/cebian-monkeys/home?read_current=1", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9967864583317849"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4089622681312003"}, {"status": "PUBLISHED", "id": "746253414822086"}]}, "baseline_offer": {"id": "4089622681312003"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1757874480, "status": "PUBLISHED", "id": "4089622681312003"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25838909189120134", "version": "0.29"}, "id": "939244461708692", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9935077253263249", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25838909189120134"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "939244461708692"}]}, "change_log": null, "created_date": 1776041205, "id": "25838909189120134", "version": "0.29", "
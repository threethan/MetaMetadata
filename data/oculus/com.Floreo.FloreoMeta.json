nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukiyNRn34dIQ7kNvwE1y-gO&_nc_oc=AdkYPAZ04GvJ_SNIOS4SzctLbd0t7jzq6F7D13-UwWweWbAn6lgFzZyGWdC5IMvDsv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnTawSniTWflsehugi2PXyUIAIU_GCpxffsuyLwi4dQg&oe=69BFE967"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FLOculus_TrailerCover2.png", "id": "434900168706817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974741_434900172040150_3046569544541794558_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ViqJWdRTq8Q7kNvwHOEshh&_nc_oc=AdkvXmEySvI-5UQB8WHcFzpmo9Nyo5bQsfkSglKZvSEpx8PQJP26MdJGIsV-J4_ec8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbgAXZ12zZsisYqg_oSiDjA9XXQ8odZBQqGVnrYW384A&oe=69BFDED3"}, "display_name": "Floreo", "keywords": [], "long_description": "Floreo uses virtual reality to teach social, communication, behavioral, and life skills to individuals with Autism Spectrum Disorder and related diagnoses. Our immersive VR experiences are based on established, science-backed techniques and designed to be used in therapy, educational, or family settings. \n\nOur standalone version consists of three sensory room experiences: a marimba, an aquarium, and a cave filled with crystals.\n\nEnterprise users can pair with an iPad to access our extensive library of over 175 lessons that teach social, behavioral, communication and life skills in a fun and engaging way. Our clinical team works hand-in-hand with game developers to create evidence-based lessons for individuals with ASD and other diagnoses to safely learn important skills in a controlled virtual reality environment. Floreo is running several research studies, including a study in collaboration with the Center for Autism Research at CHOP and National Institutes of Health.", "short_description": "Virtual Reality to provide calming spaces and to teach emotional regulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floreovr.com/priva
8677_622769229433143_1878365053994754488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXGD2-3hQ2YQ7kNvwGpMSg6&_nc_oc=Adq1HymxRflSOgDwi_MO1zDarc55arX-Wzfnw9Kft-_H04GYYbYrKzHWQ_eegy-a-3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h8xWGaUNFvyuODfrmCIljYNQemCjmIYzEPwxLUwBq5Q&oe=69DCEA67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FLOculus_TrailerCover2.png", "id": "434900168706817", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974741_434900172040150_3046569544541794558_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PL0jNcQGcQMQ7kNvwGHULdV&_nc_oc=AdoSkoiFVzHmGIg8J79xbdMdpZ7iB-CrzK5FdSAo7EB6sOkByaAtpWpBkvq6Uy4wR6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WMW7cQvAQgJ4Ye68ziZH0C7b_DfKTY0Lgqc4VOk1H3w&oe=69DCDFD3"}, "display_name": "Floreo", "keywords": [], "long_description": "Floreo uses virtual reality to teach social, communication, behavioral, and life skills to individuals with Autism Spectrum Disorder and related diagnoses. Our immersive VR experiences are based on established, science-backed techniques and designed to be used in therapy, educational, or family settings. \n\nOur standalone version consists of three sensory room experiences: a marimba, an aquarium, and a cave filled with crystals.\n\nEnterprise users can pair with an iPad to access our extensive library of over 175 lessons that teach social, behavioral, communication and life skills in a fun and engaging way. Our clinical team works hand-in-hand with game developers to create evidence-based lessons for individuals with ASD and other diagnoses to safely learn important skills in a controlled virtual reality environment. Floreo is running several research studies, including a study in collaboration with the Center for Autism Research at CHOP and National Institutes of Health.", "short_description": "Virtual Reality to provide calming spaces and to teach emotional regulation."}]}, "developer_name": null, "de
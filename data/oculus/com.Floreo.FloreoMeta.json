c=Adq6wA8T9VOvhtJ5jQnjPSTeRAQFDghNSIweNyn1wutTqP2fEJwdMZxmAhOn68lpCuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcrxywCpatGZ160fiA0ppQLAXCeM27tHtgQ1C-WKcg4w&oe=6A9ED74B"}, {"file_name": "FLOculus_Lobby2Standalone.png", "id": "622769226099810", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568677_622769229433143_1878365053994754488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PngPeDA23kIQ7kNvwH1RVb_&_nc_oc=AdrtRa_kwL5DZuwERBE8OPJDe5k1hwX8zhDh7lPn34XAm1nD3jYom8bzzknnovWetHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXyfWFJN5Ad42geC791v8DS8iYcoN0m-G79xRCO43nOw&oe=6A9EB6E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FLOculus_TrailerCover2.png", "id": "434900168706817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974741_434900172040150_3046569544541794558_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ho68cBPGPmAQ7kNvwGw7R1O&_nc_oc=Adp4Ow5p0gtOxa5JClNgpX66fbjakQseXMJiNEWbGIfM1rmGW2ReaLDYANnmgDTJz54&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbadcJLsKmxKEEDTMdQdsxIL1sngiFILk7m72_Iwa-hA&oe=6A9EAC53"}, "display_name": "Floreo", "keywords": [], "long_description": "Floreo uses virtual reality to teach social, communication, behavioral, and life skills to individuals with Autism Spectrum Disorder and related diagnoses. Our immersive VR experiences are based on established, science-backed techniques and designed to be used in therapy, educational, or family settings. \n\nOur standalone version consists of three sensory room experiences: a marimba, an aquarium, and a cave filled with crystals.\n\nEnterprise users can pair with an iPad to access our extensive library of over 175 lessons that teach social, behavioral, communication and life skills in a fun and engaging way. Our clinical team works hand-in-hand with game developers to create evidence-based lessons for individuals with ASD and other diagnoses to safely learn important skills in a controlled virtual reality environment. Floreo is running several research studies, including a study in collaboration with the Center for Autism Research at CHOP and National Institutes of Health.", "short_description": "Virtual Reality to provide calming spaces and to teach emotional regulation."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floreovr.com/privacy", "developer_terms_of_service_url": "https://floreovr.com/terms", "publisher_name": "Floreo", "support_website_url": "https://floreovr.com/learning-center/faq", "website_url": "https://www.floreovr.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "478089301798119"}, {"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "784429853239568"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "877881301126185"}, {"status": "PUBLISHED", "id": "738647178044973"}]}, "baseline_offer": {"id": "877881301126185"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744317180, "status": "PUBLISHED", "id": "877881301126185"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28362519016748441", "version": "7.31.3245"}, "id": "481982413585808", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
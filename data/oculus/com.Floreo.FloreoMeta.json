scdn.com/v/t64.5771-25/57568680_659211325329516_7066420976346001537_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgwI2ZVSjb4Q7kNvwGsqEUH&_nc_oc=AdpjI-XY1vAWn4HpCuMIy3k2VqkKD7gKM0mTF3vKOhgcV1EJ5rO3RsAdNdLRnZkSBpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPW7R4ALtN_msnRgwI774IEvkoT_9pIecwSig0yAaBtcA&oe=6AE4B6CB"}, {"file_name": "FLOculus_Lobby2Standalone.png", "id": "622769226099810", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568677_622769229433143_1878365053994754488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2Ij4RcV9J8Q7kNvwG1Dl_A&_nc_oc=AdoMvLr-ko40iTJj2N_xhifQQYQMjxdxh8gPQ1023CrIgGDwpdHeMe2-2MgjQT4dITY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi_8zmuTm5rip2n0iOaRt7lqX_r9tqM56HS9eiQhrr3Q&oe=6AE49667"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-05-28 at 10.52.02\u202fAM.png", "id": "2169417770110643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75412001_2169417773443976_8651808387819436021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GRFyXxjy0wQ7kNvwEJPDZE&_nc_oc=Adob5jyxpKV3uYSjyab6RU2l6ZjUPf8r-eIYO1u4ZfzzeghCOKcoyv9Nw_FOa1xhjgs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYO2W01raq2oglECHCzy8TeD_4JTU4tUlI1LlPzuFuyQ&oe=6AE48BC6"}, "display_name": "Floreo", "keywords": [], "long_description": "Floreo is an immersive virtual reality platform that supports learning, social connection, and life skill development through engaging, interactive experiences. Created in collaboration with educators, clinicians, and game designers, Floreo\u2019s lessons are grounded in evidence-based learning principles and designed to make skill-building fun and accessible for all learners.\n\nFloreo offers evidence-based immersive lessons widely used in autism education and support settings. These lessons promote exploration, communication, and confidence in a safe and engaging virtual environment.\n\nThe standalone Floreo app includes two calming sensory spaces\u2014an interactive aquarium and a glowing crystal cave\u2014ideal for relaxation, focus, and sensory exploration.\n\nOrganizations can pair Floreo with a coaching device (such as a computer) to unlock our full library of over 175 immersive lessons. Floreo is used in schools, therapy programs, and homes to create meaningful learning opportunities and shared experiences.", "short_description": "Build real-world skills in a virtual world!\nFloreo offers evidence-based VR lessons widely used in autism education and support settings to promote learning, connection, and confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floreovr.com/privacy", "developer_terms_of_service_url": "https://floreovr.com/terms", "publisher_name": "Floreo", "support_website_url": "https://floreovr.com/learning-center/faq", "website_url": "https://floreovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25695743710092665"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822723_878493001382602_4617713629059358674_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y309ID91HIEQ7kNvwHL0-RV&_nc_oc=AdqcAbwl78VfPmG1LhdRBH2kHb5sWP5pz1h8NOcLVFbGiKp713aNgRd35ZskX-nyslQ&_nc_zt=3&_nc_ht=scontent-iad6-1.ocu
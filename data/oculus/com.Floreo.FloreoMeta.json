scdn.com/v/t64.5771-25/57568680_659211325329516_7066420976346001537_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUAKRWFh0McQ7kNvwHcvKhn&_nc_oc=Adq92kMAOi1maVjMEFYqcGYF0SdnHcxfGr805YFDK3150PwfGUlNeesv6u7Dk6BNTyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9OHDQ2imATubfPC8CXVBIU1BydlM5b4l-3rmZQId91A&oe=6AB3EF4B"}, {"file_name": "FLOculus_Lobby2Standalone.png", "id": "622769226099810", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57568677_622769229433143_1878365053994754488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfxjIxJO8mcQ7kNvwE47GRM&_nc_oc=AdqyeeKE_XvUtCpfmWFSZlnMaqu22pxmiJg5g4TGSyH7sIuXZT07ji6EfKwfY4T6cb4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl95kQjM9TCyLvxJMf8ZqI1dyIC8Zt_2lWvgSNYzkEow&oe=6AB3CEE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-05-28 at 10.52.02\u202fAM.png", "id": "2169417770110643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75412001_2169417773443976_8651808387819436021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE0ZlBv7cGUQ7kNvwHyLOoP&_nc_oc=Adro8U5haunJLZ45JI8zrNNh74uUF1g1_O7eBq6o4Q_rifLgzHIind30l0DH4C2HXmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL53p6T-JbyNz6onlSDlJIkWq5AnGAJqo2h_YME65BH4g&oe=6AB3C446"}, "display_name": "Floreo", "keywords": [], "long_description": "Floreo is an immersive virtual reality platform that supports learning, social connection, and life skill development through engaging, interactive experiences. Created in collaboration with educators, clinicians, and game designers, Floreo\u2019s lessons are grounded in evidence-based learning principles and designed to make skill-building fun and accessible for all learners.\n\nFloreo offers evidence-based immersive lessons widely used in autism education and support settings. These lessons promote exploration, communication, and confidence in a safe and engaging virtual environment.\n\nThe standalone Floreo app includes two calming sensory spaces\u2014an interactive aquarium and a glowing crystal cave\u2014ideal for relaxation, focus, and sensory exploration.\n\nOrganizations can pair Floreo with a coaching device (such as a computer) to unlock our full library of over 175 immersive lessons. Floreo is used in schools, therapy programs, and homes to create meaningful learning opportunities and shared experiences.", "short_description": "Build real-world skills in a virtual world!\nFloreo offers evidence-based VR lessons widely used in autism education and support settings to promote learning, connection, and confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floreovr.com/privacy", "developer_terms_of_service_url": "https://floreovr.com/terms", "publisher_name": "Floreo", "support_website_url": "https://floreovr.com/learning-center/faq", "website_url": "https://floreovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25695743710092665"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822723_878493001382602_4617713629059358674_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4u6qEz_ZIKUQ7kNvwEovnNB&_nc_oc=AdoFnZIVWcIYSnGauADeJVU68sAcAstYUtm2hPu-3hRJ5JJU1frYKsqzCuL1-ye1QP0&_nc_zt=3&_nc_ht=scontent-ord5-1.ocu
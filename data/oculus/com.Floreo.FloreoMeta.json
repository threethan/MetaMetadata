nOxLMuQyEpwQ7kNvwEWnPhZ&_nc_oc=AdoKficr4TROQ0O8n3BS8lsn_kt_QcZF15Le8rJ9CFxGxgewNGBSBQeXT-6OQYl3oog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3OCZHcc15P1zdfeAM19CFmfwFCREavpLG2pGWYeUapVQ&oe=69F0D14B"}, {"file_name": "FLOculus_Lobby2Standalone.png", "id": "622769226099810", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57568677_622769229433143_1878365053994754488_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOjW02gOAJUQ7kNvwEapvL5&_nc_oc=AdoZ6poNDUxv98Ne4z2Br5dIfmDfCT4zSzIeQqQzPhP1C2wGz6VPl9U0WaeV1C8_KGA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0H9pRNFMuMfr3fEsgWX4tXUwuiweFN8Odo_b6tQLGENg&oe=69F0B0E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot 2024-05-28 at 10.52.02\u202fAM.png", "id": "2169417770110643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75412001_2169417773443976_8651808387819436021_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vzflzp7fc7gQ7kNvwHYLjVD&_nc_oc=Adrto21pahrA4acKN6vVbpMhIzlcCiua29clhxH6CzcbK2gpED8Zdvjk0FlsOiPUEEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0MyiDRfyvO2xBmROyd5I-3pP-AVEx6TDcPaOCYkt71MA&oe=69F0A646"}, "display_name": "Floreo", "keywords": [], "long_description": "Floreo is an immersive virtual reality platform that supports learning, social connection, and life skill development through engaging, interactive experiences. Created in collaboration with educators, clinicians, and game designers, Floreo\u2019s lessons are grounded in evidence-based learning principles and designed to make skill-building fun and accessible for all learners.\n\nFloreo offers evidence-based immersive lessons widely used in autism education and support settings. These lessons promote exploration, communication, and confidence in a safe and engaging virtual environment.\n\nThe standalone Floreo app includes two calming sensory spaces\u2014an interactive aquarium and a glowing crystal cave\u2014ideal for relaxation, focus, and sensory exploration.\n\nOrganizations can pair Floreo with a coaching device (such as a computer) to unlock our full library of over 175 immersive lessons. Floreo is used in schools, therapy programs, and homes to create meaningful learning opportunities and shared experiences.", "short_description": "Build real-world skills in a virtual world!\nFloreo offers evidence-based VR lessons widely used in autism education and support settings to promote learning, connection, and confidence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://floreovr.com/privacy", "developer_terms_of_service_url": "https://floreovr.com/terms", "publisher_name": "Floreo", "support_website_url": "https://floreovr.com/learning-center/faq", "website_url": "https://floreovr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25695743710092665"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822723_878493001382602_4617713629059358674_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqYLAeomAsAQ7kNvwEkgVTx&_nc_oc=AdqhrYy7P49BTwFLPaZdcyN_hhAlKrXy87_Fi-cS38DvhWSCkcl-8yBJII7zVQ3gwG8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3XEfgTQqyITXs7P4JzvRnXZJx1cbIOQP-LW_HKILdBXA&oe=69F0A6F1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displa
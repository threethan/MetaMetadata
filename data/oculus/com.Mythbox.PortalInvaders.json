AdoAMzy-pmyVbiN7jeDmo4NIvjPVlVLcnXbKJrvXBoNlFu8SXqaYtSqrJYfBsJD8gic&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x7sU551nH4a_6vMfWDb8FJxv4PD84ANu6GiUx0cPYww&oe=6A3D592A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "2036561643509937", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391795_2036561646843270_2421238445359438111_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mtx-a4XxRPwQ7kNvwGvbf9k&_nc_oc=AdrCElnNHV3A-XYGEj47DDv32nw2__zEoxfskklopFwO9jBZBYX_TwcTaOc8pSOtA_A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82vfpRyz0aFOEfr4ocbCUlz958Ic4hyxrPX074BRI8mQ&oe=6A3D5B3E"}, "display_name": "Portal Invaders: Mixed Reality Shooter", "keywords": ["MixedReality", "Passthrough", "Shooter", "Arcade", "Space"], "long_description": "Turn your home into a Mixed Reality battleground in Portal Invaders!\nGet ready as interdimensional portals rip open, flooding your space with relentless robotic invaders. Arm yourself with dual laser blasters, dodge incoming fire, and fight to survive as the enemy waves grow stronger with every second!\n\ud83d\udca5 Mixed Reality Action: Battle robotic invaders in your own space using passthrough technology, blending the real and virtual worlds seamlessly.\n \ud83c\udfaf Endless Wave Shooter: Face non-stop waves of enemies that get stronger and faster with each round. How long can you last?\n \ud83e\udd16 Challenging AI Enemies: Take on a variety of smart, hovering drones with unique attack patterns that keep you on your toes.\n \ud83d\udd25 Dual-Wield Combat: Equip futuristic laser blasters in both hands for fast, action-packed shooting.\n \ud83c\udfc6 High Score Challenge: Rack up points, push your limits, and compete to survive the longest!\nDodge, shoot, and outlast the invasion. Are you ready for the challenge? \ud83d\ude80\n", "short_description": "Turn your home into a Mixed Reality battleground in Portal Invaders!\nRobotic enemies are invading through portals in your space. Use dual laser blasters to fight, dodge, and survive!\n\ud83d\udca5 Mixed Reality Action: Battle robotic invaders in your own space using passthrough technology.\n\ud83c\udfaf Endless Wave Shooter: Survive as long as possible against increasingly difficult enemy waves.\n\ud83e\udd16 Challenging AI Enemies: Fight against a variety of hovering drones with unique attack patterns.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mythboxgames.com/privacy-policy-portal-invaders/", "developer_terms_of_service_url": null, "publisher_name": "Mythbox", "support_website_url": null, "website_url": "https://mythboxgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9668156026553524"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "651521090705498"}]}, "baseline_offer": {"id": "651521090705498"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743093600, "status": "PUBLISHED", "id": "651521090705498"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9802944719741320", "version": "0.48.0"}, "id": "614699761186775", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary
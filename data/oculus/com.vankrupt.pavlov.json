"Screenshots_Search&Destroy_17.png", "id": "296921139859592", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982670_296921143192925_549751589584275752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgvVj2gPab0Q7kNvwFxcqrz&_nc_oc=AdqX_1zJ8H5JgWhzRdihU4qTWq-7d8rx1GbSCIqxKDEhaVENjgrbgUqm0fGEB1WYd8I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdLm7hQNydOsWMxKUqFk-cPsgimDrUCfW1bvOrgySZLA&oe=69D0F68B"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUAQJ_bHEbUQ7kNvwG5npTs&_nc_oc=Adr1K3B3OVyKuhj-HkqV7WU_KxownJPQIO092MmSdzRL0uGn-65VB0f5sHbm2n-UX-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjSFJEROF6NHoP9YwofBGfWLQC5z9xcFYeZvJSi9TzkA&oe=69D0F553"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DecemberUpdate_Trailer_Meta_Thumbnail_2.png", "id": "2753312968348477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499305194_2753312971681810_2504298205666690873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBqKoirKCocQ7kNvwEhqmzL&_nc_oc=AdorVVekTlmvvt9Xp7vNOJi5alI1x9VJC4xEbeymny2Atsb5Qbbks4yBAe09lvylUZY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQAtvAJip--HMsN2oLobr-dOD54JsPTY5SEaAQ9Bcz-w&oe=69D1217A"}, "display_name": "Pavlov Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nPlay hundreds of community made mods. \n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26051377497780559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003255_354436843793827_5728163074395370719_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42VWkc_g3QMQ7kNvwHhpPF8&_nc_oc=AdocUKyFgeXtbt6OT5lD-zxZjXfjlCAUz8WT4KoOOEmhaJj8JRDHiApqh7UTYbKEAGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBTmYT9V1hYBNKmQm52oSH5N4Iv0q1ux1lKYdVWSg2hw&oe=69D1184E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
"Screenshots_Search&Destroy_17.png", "id": "296921139859592", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982670_296921143192925_549751589584275752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-12uwfgZdIQ7kNvwESp4lV&_nc_oc=AdqZ30wmeI2OycrtCbUOMleaDBOkRR3VEjIjMT5iL9ifyL5ivSCnGoLa_HKoKheLzQw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZcTpbvSky6_AC5LpuA2BsE1K1nY2I2KOkZrxWxkj26A&oe=6AE366CB"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pv94dzlwHU4Q7kNvwE_MG2x&_nc_oc=AdpjE7U6SbrrOQT-G2r6QF4C1E_2oAURj4GpWyHzMPgLvPq77lOqCw5Arg3ayMckiYE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcziZUg5cUU_JA13xDT6HUuPRTuS73bsYxzDVenQ9keA&oe=6AE36593"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PreOrder_Trailer_Thumbnail_2.png", "id": "1434733135421018", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299789_1434733138754351_7179589529050980947_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cvEJssJ56tYQ7kNvwENSuf8&_nc_oc=Adp-egQn1EmAxL1HLZm_G8moOnsi1OCyzhT22VBHgAO7svKPPQtkEIc_15m4cYuxnLc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPWHyD6yY5-LK006rYQTqh9tClj57LmZKQCKeCrmS65Hw&oe=6AE36447"}, "display_name": "Pavlov Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nPlay hundreds of community made mods. \n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "28493242320260719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003255_354436843793827_5728163074395370719_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70Lu9bPEt90Q7kNvwH3O2RE&_nc_oc=AdoYyv-w6wyVfqUjhTQ8fhN2dYrU5NNx8uD_80vUmLa3r6kdoROsx6aHJ3qz9K3uV3Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMo0EJpaikFGygth1McbuVmkNO_Z7Z6yxukrPz5G5cBvQ&oe=6AE3504E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
"Screenshots_Search&Destroy_17.png", "id": "296921139859592", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982670_296921143192925_549751589584275752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hmyP3QjdgIQ7kNvwE9031P&_nc_oc=AdqN0NYGwlH2X1xVG3LAdDIzI5v-N62PQX15GnIO13k9FHqYJ-L-zH-sQEa05LYHz5k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhFrN3pAGV710Vhz2oYyvJP0mqL-OPSsk3Tbm-nlvfmA&oe=6A8ADA0B"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4eRa7mUKEMQ7kNvwHu4Zjo&_nc_oc=Adr35zqmNvooT-P6QfRUIUaw9TRMZHderTk7jW3togfxAFlrbtZTezuAMZaSY-8kiRI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRj7FUYMx0TJdWyDo12KNtLpiuv7sH_ESyXM4_r-FGqg&oe=6A8AD8D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DecemberUpdate_Trailer_Meta_Thumbnail_2.png", "id": "2753312968348477", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499305194_2753312971681810_2504298205666690873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jo8rwwT_1pUQ7kNvwHemQ4G&_nc_oc=Adr1hBlFw3WWFql1Ot1nzdSD03KTM0K9UiFDtgCoB_V2brWhRACAfGyIEyycWVV61o4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1XWxchnqw09mKCQqz1uCdYX-tkJ1Vc9dQv5Q2s6H4sw&oe=6A8ACCBA"}, "display_name": "Pavlov Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nPlay hundreds of community made mods. \n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26051377497780559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39003255_354436843793827_5728163074395370719_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o9yWKPpcesUQ7kNvwFnpaIh&_nc_oc=AdrUh6Qm6mW9d8e0RtuQqG1LrlDqwf5cPv7n6FTSABOi5MAKzr3HpzA-v3EcKK3Back&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHsCBTBqiF3fKHC8vskEouuNX1JTwhZynWKXBMXeVDrQ&oe=6A8AC38E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
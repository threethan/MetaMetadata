"Screenshots_Search&Destroy_17.png", "id": "296921139859592", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982670_296921143192925_549751589584275752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEEf3l1faOwQ7kNvwEQrReb&_nc_oc=Ado4sAQqgT5vsBYU5fJKeMgfVF-xXJFLcTHzIvQGH2n7l59H33UyGD1rmd8PkE8tp0I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTqem6xTHg0ET0Bw7vQ72DP-udEIm08cyR4wvI5uAUEg&oe=6A58F94B"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hkvc4EzXIY8Q7kNvwF0Q2je&_nc_oc=Adpk1DMmvGom-f-lxa4PjRzhE8JiwcElAoCN8mX38LRtrhEOx0ddC2i1PSXB1KzErEA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCB8R4oRLsgsPEE4a85BsNOguBoksOOcbdOX2Hoy3cfIw&oe=6A58F813"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DecemberUpdate_Trailer_Meta_Thumbnail_2.png", "id": "2753312968348477", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499305194_2753312971681810_2504298205666690873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QxL7Huysz_wQ7kNvwEd4i0q&_nc_oc=Ado6ZKuQc85C68oTwR1L6uNVyxIpZOZezYSnD8jKv0iIk7rgKCU3viLZmk1BgluepBA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZNFzWP8c9SKuWyBi9E_tL6YYy_pXxoRxdwq0IItat3A&oe=6A58EBFA"}, "display_name": "Pavlov Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nPlay hundreds of community made mods. \n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26051377497780559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003255_354436843793827_5728163074395370719_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yGeZnpxXFoQ7kNvwHNAlTC&_nc_oc=AdqU8DMZV8qfZQ00paEWqOCQFq2pBBs5Ir4saLvpLbs2_nhgWKcW80MOKWTIwrBH2gc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDifWXfRSEtMA9ru52g_m23ywYGc1fjgLFHo-gQLqrZiA&oe=6A58E2CE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
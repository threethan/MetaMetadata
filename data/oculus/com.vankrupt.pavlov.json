arry through wall\n-Fixed exploit where a scope can be abused to see through walls\n-Fixed TTT Zombie issue not reviving players from thrown knives\n-Adjusted monster logic to break the objectives by stabbing them, when all objectives are captured the monster can still break them\n-Adjusted logic to slowly damage the monster when all objectives are captured", "created_date": 1786662678, "id": "28396573116594307", "version": "1.0.28", "version_code": 2356, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28396569626594656"}, "asset_files": {"count": 3}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2443267419018232", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28396573116594307"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786659197, "id": "28396109029974049", "version": "1.0.28", "version_code": 2355, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28396106206640998"}, "asset_files": {"count": 3}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
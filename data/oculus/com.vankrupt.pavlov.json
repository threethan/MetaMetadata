count": 3}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2443267419018232", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28396573116594307"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2340091246312543"}]}, "change_log": "\n-Refactored MOTD\n-Added custom watches to cosmetic store\n-Added custom gloves to cosmetic store\n-Added custom knife to cosmetic store (Infernal)\n-Added bot support to community servers (bEnableBots=true, RCON SetBotsEnabled True/False)\n-Added mipmaps to UI\n-Adjusted tracer material and refactored logic (Increased to 16 on screen)\n-Adjusted networking logic to reduce CPU overhead\n-Adjusted recoil to be decoupled from framerate\n-Adjusted player blocking function to hide profile picture\n-Adjusted watch to disappear profile picture of killed player slightly faster\n-Optimized texture resolution on all charms\n-Optimized the pawns rotation data\n-Optimized the player bandwidth\n-Fixed an issue where custom knives were not working in OITC\n-Fixed an exploit in Santorini\n-Fixed an exploit in Japan where damage would carry through wall\n-Fixed exploit where a scope can be abused to see through walls\n-Fixed TTT Zombie issue not reviving players from thrown knives\n-Adjusted monster logic to break the objectives by stabbing them, when all objectives are captured the monster can still break them\n-Adjusted logic to slowly damage the monster when all objectives are captured", "created_date": 1786662678, "id": "28396573116594307", "version": "1.0.28", "version_code": 2356, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28396569626594656"}, "asset_files": {"count": 3}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "A
"Screenshots_Search&Destroy_17.png", "id": "296921139859592", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982670_296921143192925_549751589584275752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpcHa68yfH4Q7kNvwFOdXcA&_nc_oc=AdotQmLhAD7s5VJTJ2HSB-3Uuxe9roIULOeU_m0JIt1XwAa4mGqw21bjzZbTNBOgzmU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58ewZewV-LEWThZyCYXJGazjHojkuutiFaviwDfxCYcg&oe=69FE01CB"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIURgcY6o48Q7kNvwE1GrpZ&_nc_oc=Adpp5Y_vag38keUwcdeRv_0auXaW_6QSgadxA4zsZph13RWeKWIQlYW87UhTFP9d4uk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yDIC4LAwRyZeLOMdfGlpD59a0ZQlFAbSEd8LtTkdtHg&oe=69FE0093"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DecemberUpdate_Trailer_Meta_Thumbnail_2.png", "id": "2753312968348477", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499305194_2753312971681810_2504298205666690873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1HfmtlzRpkQ7kNvwGou58M&_nc_oc=AdoYxNr1l1UangRX3NoQQvdRoVNGH3_2TbbmTWjLAK9o3whTD5HuGcIu5qi-u89P8uU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NYQTZnWQO26OrTinFSOHocltOcySUDofCLP-2kXUpPw&oe=69FDF47A"}, "display_name": "Pavlov Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nPlay hundreds of community made mods. \n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26051377497780559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39003255_354436843793827_5728163074395370719_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JbROcQLEzcQ7kNvwHCM9q3&_nc_oc=Ado8jp_T7KeNIXVdu8wIOGOAUbwrIGP22SdObhU-s80Sejke8WCDFEvxOiKShEQPVxE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lUryCQLyLviMciebE3J6zx0oR3Kz0_i5vDH8GUwyZWg&oe=69FDEB4E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
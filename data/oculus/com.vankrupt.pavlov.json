"Screenshots_Search&Destroy_17.png", "id": "296921139859592", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982670_296921143192925_549751589584275752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfnlvOhmeCkQ7kNvwEwD_Ca&_nc_oc=AdpmhovhSDkpgP8xcHeFrE8e6guZfLbBwLz_F2vS4QLAKvo1dOli8E74bMVd8J90qhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyaQ3Z3poVi22bemSe5R4oimsDwLHFFlNuTwuOWF7BMQ&oe=6ACCFD4B"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyZFGd3pagEQ7kNvwHX2HeB&_nc_oc=AdqWqV5q5L_sf7uRb82mclAsHQrma3D-ldndAF_fpAvcGtDtkQTv4jRin64zdH-g-JE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFRbfXg8OwqBau43aqv944mDGO_t-dg33pygFxOvmHNw&oe=6ACCFC13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PreOrder_Trailer_Thumbnail_2.png", "id": "1434733135421018", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299789_1434733138754351_7179589529050980947_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjMfyhqLENoQ7kNvwGmNF9f&_nc_oc=AdrDPd1EMu0JrVLVIbjW7bScH7x-jfPfOEGJ7lPSsNQr0NufOoZVrxkeDR4x73BX9Lo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPTekIDVVjVjSCecUQ1-naour6U-XM5aEsgv2XX908tg&oe=6ACCFAC7"}, "display_name": "Pavlov Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nPlay hundreds of community made mods. \n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "28493242320260719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_354436843793827_5728163074395370719_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aB80kKuLN-4Q7kNvwHqTOf8&_nc_oc=AdpBpux8EkKVV0moTFjOUJ_dVQXX3TtjR6CsD0ZIvRGvMwXJ3xU6LJMFhXfkXiTQT9U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2pybttHK4fJIwrLxPOMNOf6uRvuwPM3aqOBkLqWzhzg&oe=6ACCE6CE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
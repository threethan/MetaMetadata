D"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtMjaF6oD1EQ7kNvwFr-d6T&_nc_oc=AdrHGmajGk5MwxpoqZjdSWjY0ClH9y5miFK1f1Wb1vU5khLtf1YJM-h8evgMqsRBqcs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEk5j0WiQyE-OpI9ccLepbbB4VbF7XvxGkR-ci-ij9mPw&oe=6A8D7BD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pavlov Shack_PreOrder_Teaser_Thumbnail.png", "id": "685913936805545", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035417_685913940138878_383861971411671377_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFc7cPpJtEAQ7kNvwEQs9yv&_nc_oc=Adrz4nX6-D_cicYIbTHWS2RYVtzPI7FzDTVQje-j_EYPQVNy3MVscpsKav5L8b7rRF8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHh7_aVHVFaOiyqproC29SwZl4ILh79GVnrSrmb3au-UA&oe=6A8D85DA"}, "display_name": "Pavlov: Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity from the lab by relying on the flashlight attached to your rifle in dark environments in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "6995572930454302"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "874320845536874"}, {"status": "PUBLISHED", "id": "27944434581835638"}, {"status": "PUBLISHED", "id": "1467253858483207"}, {"status": "PUBLISHED", "id": "2570997473317944"}, {"status": "PUBLISHED", "id": "2206801310164844"}, {"status": "PUBLISHED", "id": "2129485177787309"}, {"status": "PUBLISHED", "id": "1135932555145369"}, {"status": "PUBLISHED", "id": "885174890624401"}, {"status": "PUBLISHED", "id": "4213530885554641"}, {"status": "PUBLISHED", "id": "1696701537664669"}, {"status": "PUBLISHED", "id": "2711831572360322"}, {"status": "PUBLISHED", "id": "954079546696920"}, {"status": "PUBLISHED", "id": "453535054403580"}, {"status": "PUBLISHED", "id": "1008660573750242"}, {"status": "PUBLISHED", "id": "355121043798498"}, {"status": "CANCELLED", "id": "864414812080877"}, {"status": "PUBLISHED", "id": "407965601930513"}, {
"Screenshots_Search&Destroy_17.png", "id": "296921139859592", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982670_296921143192925_549751589584275752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvtNKJlEVzcQ7kNvwH4bwam&_nc_oc=AdpkFQ2ybQ1r3_SZSzi-L3WdGQQulZqVcmj2GyAq4zHFcWl87X8vKAy_oW30Sb2pyzc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qMM4Yxc22_zEoLSdtG8skM8RpMbqTtn_HGTe6EbRZzg&oe=6A1076CB"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEbpjVbevuEQ7kNvwEiZZQ8&_nc_oc=AdpbS_oWJTSXtlnD1yh0CKkCQwQmXop83UVRBpuSsmFMlMss3G_OIxJetcuNN0Ro-HA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C72iq02gUC_H-6KSFo763c-Y9ixn54KSYOPsEpSt7wQ&oe=6A107593"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DecemberUpdate_Trailer_Meta_Thumbnail_2.png", "id": "2753312968348477", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499305194_2753312971681810_2504298205666690873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsIQR67c7mgQ7kNvwHRzwO7&_nc_oc=AdoPdSNsjIA2Vqd6DPa9PcL-1mzwqLrGJ-VG6ENYJjKmn7VgohmWLzctiLl9d-RIxX8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EB_zS_ROBUHJTzdRetwH1-LSDovN56-lWWDNdpneV6g&oe=6A10697A"}, "display_name": "Pavlov Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nPlay hundreds of community made mods. \n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26051377497780559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003255_354436843793827_5728163074395370719_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vozxmd_5S9EQ7kNvwFHY4_P&_nc_oc=AdoVJDf83aL3JzFQr-rchZz3HV6L-rIBu8Z12LAr0WLsyB9npoOCuis0fR_KUqw7t94&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-meK-3Nu3l_Vnesx9rIySC6CkerWC1l2IWg5W_G8Qfg&oe=6A10604E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
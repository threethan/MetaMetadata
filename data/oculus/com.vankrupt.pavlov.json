creenshots_Search&Destroy_17.png", "id": "296921139859592", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982670_296921143192925_549751589584275752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TkqTQpe5hQQ7kNvwEh9WlF&_nc_oc=AdoCzN2B16Sq6YzuW8xq_-wIRbnPBrmy4itzfoq8UginqmHqiAdj3v1Kigwt2x0ORKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmd-8RhpyAa_wdSwAXSybfut1PosIw_sYS1yox9Mh0HQ&oe=6ABD2B4B"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3j9DN92AQQQ7kNvwFRMpwz&_nc_oc=Adr4qdl2hVL7w6Rg8Jhz01hIwRXRkiVGryyoIyGBUnVhz5rGgLtIg_cY2z1PWYeNlVQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrB5ciTlIqTb14P9dPDrSjkpc2EMz1qLEjOitryn24aQ&oe=6ABD2A13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PreOrder_Trailer_Thumbnail_2.png", "id": "1434733135421018", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499299789_1434733138754351_7179589529050980947_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJBiRX4ev4UQ7kNvwGncRM2&_nc_oc=Adryn-xVOZrdgNVSf42XFMI9nUIsk5VtjCAr2b8GOMuXmVNXmZjGT2P1XCFwd2lO684&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJs8VGLx6zXRPT1nvf0Y7QkZ4LSCkftsh7gHqLEFLQmkg&oe=6ABD28C7"}, "display_name": "Pavlov Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nPlay hundreds of community made mods. \n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "28493242320260719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003255_354436843793827_5728163074395370719_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jg2g6dI7kDEQ7kNvwEq8pph&_nc_oc=AdoteOaxrTId8o5a5cH7zyCrFqShQ1HcfeJXAiPQ4lwHYI3tpuaUC-EIWGKADPh8x1w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhI_SPxrGfO3eidd16PruvBT2r0ASlc3ZwVyU1756shg&oe=6ABD14CE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displa
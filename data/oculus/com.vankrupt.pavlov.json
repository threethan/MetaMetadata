"Screenshots_Search&Destroy_17.png", "id": "296921139859592", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982670_296921143192925_549751589584275752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnsdvzSjpqsQ7kNvwHK32oE&_nc_oc=Adqdg-7eWuEbrD-_Z9AYZrAy7baFh-hjE_acm84T4eehA0sWmaEEbQHr1Tuy1ppS9TY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIl5Ug0Yr1lWh7WkkVtGL3pthLCWvj65wY7Ev3w4RZ5jA&oe=6AA8134B"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GSl5iyNAmIAQ7kNvwFapkU3&_nc_oc=AdpTnJPlu6TFpZm5SdkcpZIA1DQD1ouwAu-tOMf2P1p-0AQZlH6rRgbi3TfWHBbvS9Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfy7FP5d71NRFFNiUDOxb9y6MBWLE8avYUQa_wADmsBA&oe=6AA81213"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PreOrder_Trailer_Thumbnail_2.png", "id": "1434733135421018", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299789_1434733138754351_7179589529050980947_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsbN5ZajMg8Q7kNvwEFfOE3&_nc_oc=AdrvjkEvo0-XHKFzmJJlIu1DUY-K8KD95Gm8qmghcmjHcbe7JavVPvVLxFYHSqv9boc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo3TmiGe3dBYq8HnaWDdvLbt17PcMddwTkoJZM-wboJg&oe=6AA810C7"}, "display_name": "Pavlov Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nPlay hundreds of community made mods. \n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "28493242320260719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003255_354436843793827_5728163074395370719_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yHa9xBBBwq0Q7kNvwHu0cyj&_nc_oc=Adrt9qT8_u6YNxizg1VP7-ngljJ_TRbohGlhEW28z_ryMZww7S3U-n9bjjTWoGMS298&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKah-foOr8Sq28akrJxgrMSnYqO6f1iDohGqimihk9s-w&oe=6AA7FCCE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "disp
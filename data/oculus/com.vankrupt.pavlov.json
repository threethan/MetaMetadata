"Screenshots_Search&Destroy_17.png", "id": "296921139859592", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982670_296921143192925_549751589584275752_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsO62Qg-2IAQ7kNvwG1HGgs&_nc_oc=AdpEZ5nzGKddpa3eVbeZTKF9wbMMUoeAvTybXXdQYSXGHd-3f8IAP-xHVcC3xLafNow&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TlCKfrFJaamAW0ZzbuMHp7IMyVHOxAhVNZJWRtqfJ6w&oe=6A2C264B"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHjynkGm0FMQ7kNvwGJ7jiK&_nc_oc=Adr42nLBmDv0GiRW-E6MTfaOjDkXwq5n82iZJa0JHlTp8K2Vl9yFe4m3bDQvMdnUMvU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BVmjgsUiCrM-67FPfvOEurcz7HOHORc4ItLksEVS8Ig&oe=6A2C2513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DecemberUpdate_Trailer_Meta_Thumbnail_2.png", "id": "2753312968348477", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499305194_2753312971681810_2504298205666690873_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrHIaYCsh7UQ7kNvwE_96RW&_nc_oc=Adp9TXmJee5MXJ3TNC8CIwXMIFH0Mx19FFX9MTnciSmqyI-XvUhJ30Ovs_dah9jXQL0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wd4OJ__hAeUKf4EB6m-xD1CteUBGxwy-pIr-G858HmA&oe=6A2C18FA"}, "display_name": "Pavlov Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nPlay hundreds of community made mods. \n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26051377497780559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39003255_354436843793827_5728163074395370719_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9qYtmMXFPsQ7kNvwHNFtBi&_nc_oc=AdoeL9ucf6jSfiFUuyFhvDkuaElURjfmArOJkGk-Wao_zx5YV253Y5EyXh466YdGBDk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7EZp6hnZdBUY2SHxtHnvy4akaYM1xLG35drd7anHcHw&oe=6A2C0FCE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": f
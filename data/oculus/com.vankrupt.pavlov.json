fh5c4Q7kNvwE3D7vh&_nc_oc=AdoFat0sIxbHcCYGHqoiHlPrjT5cPKYVxusW9a-uvxgD1G-rTI14Nqahl1XEQQHKdcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQZ8XqVp43T61liwvIqvgYIJ2U-4f0GR6qRReq0SFt1ww&oe=6B0C7AAD"}, {"file_name": "Screenshots_Search&Destroy_17.png", "id": "296921139859592", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982670_296921143192925_549751589584275752_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2aGv9an0YkQ7kNvwHsHiS0&_nc_oc=AdrGhQg8BWGsoAvhzpIVl4LjtuGNrt-Xqh8tjuuJ2haipdTWTx3YbQ7jXU8Ffp57aSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQk3ZXddNLqmtJI1To6eRffIc40yBaCxrYeZUQh24HkpA&oe=6B0C7D8B"}, {"file_name": "Screenshots_6.png", "id": "997416164666388", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031626_997416167999721_6433022065639766756_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqQBaOhlFOAQ7kNvwEWPh1M&_nc_oc=AdrdWvQfp6JW48cwST8yq1FcM3ZlGPcSYIkrFmO7MHJOLtCtdxOXHUE89KXiVDrPfCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTFa9F7U9A6Yp1---9vvG-x1V4xKwkumJvi26lMy97Gdg&oe=6B0C7C53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PreOrder_Trailer_Thumbnail_2.png", "id": "1434733135421018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299789_1434733138754351_7179589529050980947_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV-D2aTok-IQ7kNvwGIR8rq&_nc_oc=Adrq3YPDD4mCXyNrZlz9t7XxwGRrDhLdL9z1FDTQo9uTQBjbeuMOvjwwqRNbkvWJsRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQFkTW0xw3dwQm7n_DhyQtN17pYN8VnNil1SLCQS98Jag&oe=6B0C7B07"}, "display_name": "Pavlov Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nPlay hundreds of community made mods. \n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url": "https://www.vankrupt.com/eula.html", "publisher_name": "Vankrupt Games", "support_website_url": "http://pavlovwiki.com/index.php/Main_Page", "website_url": "https://www.vankrupt.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "28493242320260719"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003255_354436843793827_5728163074395370719_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucke
_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0nUnIZiBR4Q7kNvwGbYZfr&_nc_oc=AdpsvYWfrxM2sUxmqKKf8ak8o2jcdSDVNt23-wwNU-XpZ5XomKv2ho3LnG2_iC2ocoE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2_XyhjQ7sI7GQrnEy4blCUvhZ6yQhsLbZMxIneaU2GPQ&oe=69F1EAD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pavlov Shack_PreOrder_Teaser_Thumbnail.png", "id": "685913936805545", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035417_685913940138878_383861971411671377_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W413vgQfA8YQ7kNvwGTi6FZ&_nc_oc=AdqwMVJq4mIbmk1KhO5c3qMcJWuPE_krXyCgcrnCTIO9E76emzkhnBABqfLatTA4czg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FOsq-erfEq6TjTekxAnGGzWGVnGOZdfbvZLEXqHEyaQ&oe=69F1F4DA"}, "display_name": "Pavlov: Shack", "keywords": ["Shooter", "FPS", "multiplayer", "pvp", "combat"], "long_description": "Pavlov is a team-based multiplayer VR shooter with realistic weapon handling. Play a variety of game modes with over 65 interactable weapons and attachments in various environments.\n\nTeam up in a match of 5v5 in Search and Destroy, a classic uncompromising competitive game mode where you must attack or defend against a bomb objective.\n\nUse your detective skills to uncover the traitors in a casual murder mystery gameplay with various player roles in TTT.\n\nNeutralize a monster that escaped captivity from the lab by relying on the flashlight attached to your rifle in dark environments in an asymmetrical 1 vs. 9 game.\n\nOperate vehicles such as 4\u00d74s or tanks with intuitive driving controls in a WWII match to defend your homeland in Stalingrad.\n\nBite the bullet, grit your teeth, and queue up.", "short_description": "Multiplayer shooter in VR with realistic weapon mechanics, features 5 vs 5 competitive and social game modes."}]}, "developer_name": "Vankrupt Games", "developer_privacy_policy_url": "http://cdn.pavlov-vr.com/privacy_policy.html", "developer_terms_of_service_url":
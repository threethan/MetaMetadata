raining"], "long_description": "WeldVR is an advanced virtual reality welding training simulator designed for professional skill development. It allows trainees to practice MIG, TIG, and Stick welding in a safe, controlled environment, with real-time performance monitoring. The simulator delivers precise feedback on technique, consistency, and accuracy, helping users build proficiency efficiently without the risks and costs associated with traditional welding practice.", "short_description": "Welding Simulator for MIG, TIG, and Stick Welding Training."}]}, "developer_name": null, "developer_privacy_policy_url": "https://weldvr.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Cythero", "support_website_url": null, "website_url": "https://weldvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26031715999788408"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572932_1738007866669949_3719022252608400538_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPrAZYUqZiQQ7kNvwGbZ5GB&_nc_oc=AdqIrS2uKj7o1iR9UNkhPRH_RypDonI559AVjOyI8SPtlv6GDH5QfBGvjv7-v0-9K0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbB5maOS6G5R8w4xaP9ZFKlwZ5bwMYDvhTtyIUWyBIkw&oe=6B0468B1"}, "is_concept": false, "is_test": false, "is_trial_of
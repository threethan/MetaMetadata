e": "Derby Baseball", "keywords": ["baseball", "batting", "homerun", "pitching", "sports"], "long_description": "Derby Baseball is the best place to meet friends, play baseball, and make fun videos.\n\nEnter a social virtual park, unleash your swing and throw heat!\n\nCasually compete with friends in a baseball home run 1v1, or become a champ on the leaderboards.\n\nEarn Peanuts to spend in the Snack Shack on a rotating selection of swag. \n\nBecome a member to earn exclusive rewards, and craft your own private park to host insane fan lobbies with friends.\n\nHit home runs, become a baseball star, and change the game! It\u2019s all possible in Derby Baseball.", "short_description": "Derby is the best place to meet friends, play baseball, and make fun videos!\n\nEnter a social virtual park, unleash your swing and throw heat!\n\nCasually compete with friends in a 1v1, or become a champ on the leaderboards.\n\nEarn Peanuts to spend in the Snack Shack on a rotating selection of swag. \n\nBecome a member to earn exclusive rewards, and craft your own private park to host insane fan lobbies with friends.\n\nHit home runs, become a baseball star, and change the game!"}]}, "developer_name": "Throwback Studios", "developer_privacy_policy_url": "https://throwbackvr.com/privacy-policy", "developer_terms_of_service_url": "https://throwbackvr.com/terms", "publisher_name": "Throwback Studios", "support_website_url": null, "website_url": "https://throwbackvr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
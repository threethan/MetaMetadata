_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZ-ogdjnIt8Q7kNvwFujclL&_nc_oc=AdpV4nJFS_Vg9Jb1gwI7kvfTYwzZ8bn1en5rXdJnNZM0SUgUdaLePtvRsnRXVlFzf-Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRT8-i1EcX-SnAK9h_ekLx27_eaLOpMD2tMez_hX_MYQ&oe=6A56460F"}, {"file_name": "Snap3.png", "id": "1055699900060001", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300910_1055699903393334_5764385113893552737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTrMsKLxK6gQ7kNvwGmiBPC&_nc_oc=AdpP4HBg_DJO6yV-kzLQkVNLp5Duqda1-mlzbfrpFSSt4r7db4SQztdnEVuk_Qic1aU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmYGrd8o0TOP_l7Sv2nKSoeCuDeKzcz_VZ6IR5jrvPYg&oe=6A562413"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Preview.png", "id": "1414512846469917", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499309014_1414512849803250_1426844627165770914_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyinvlG-Sx0Q7kNvwFzfy4h&_nc_oc=AdqsdnwL3ir_NM6W-KXgea94ixOdu_bNQRmLeoNjjYVQ_M990alF0R5BpWEOlgWr6to&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwv0_-GjWtvWgePwP_U9Fob15GtjZdsQgysvofSrMM8w&oe=6A562444"}, "display_name": "JetSuit", "keywords": ["arcade", "shooter", "adventure", "physics", "flying"], "long_description": "Take to the skies in **JetSuit**, an adrenaline-fueled MR flight experience where your body becomes the jet. Using intuitive arm-controlled thrusters, you\u2019ll soar through open environments, master precision movement, and experience the freedom of true personal flight. \n\n# Just you, gravity, and pure momentum.\n{1938102253438099}\n\nWhether you\u2019re zooming through challenging aerial courses, exploring vast skies, or refining your aerial skills, **JetSuit** delivers an adrenaline-charged adventure that feels both exhilarating and natural. The immersive design places you at the heart of the action, delivering fast-paced gameplay and a true sense of soaring through the air.\n>\n\n# Feel the Freedom of Flight\n{25827278673551104}\n\nWhether you\u2019re chasing speed, refining aerial control, or simply enjoying the thrill of flight, **JetSuit** delivers a fresh take on VR movement that feels powerful, natural, and exhilarating. \n\n{744828958681436}\n\nStrap in, ignite your thrusters, and discover what it\u2019s like to truly own the skies.", "short_description": "Strap into a high-octane VR flight experience where your body becomes the jet. Take control of dual thrusters, soar through dynamic landscapes, and master intuitive arm-controlled flight. Whether you\u2019re racing, exploring, or defying gravity, JetSuit brings an immersive and adrenaline-charged aviation adventure to Meta Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://progresslanding.com/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Progress Landing LLC", "support_website_url": null, "website_url": "https://progresslanding.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33487200044261110"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619680_4167270276820704_133877456129324926_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1lAVvBwUKwQ7kNvwGoW9UF&_nc_oc=AdpqZY40G0D57XlZ9GTI
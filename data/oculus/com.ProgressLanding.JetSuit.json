cdn.com/v/t64.5771-25/491818938_1231862055363426_2341879271666369323_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61YFJ04vlZ0Q7kNvwFKwxq5&_nc_oc=AdpFP-soggICKC2BPayU8_GDhLhMoJYINpMINYdyLfkTqHDJbHEeVsB_QdvU58JNcnQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjRXUZ87XT8JeSuwsY4Nt-NUBxn6rzv7_DuXugFYUQDg&oe=6A897241"}, {"file_name": "_RoomSnap2.png", "id": "606808898929809", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307451_606808902263142_2847081710908292068_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U3Ohy_qULeIQ7kNvwGvKZEt&_nc_oc=AdqE8voW-dZDwrIkiyYJg1YpBZzVSLSC3W9SsIhAZSRA_-MzJjhNZxe8uqgLuMZinqs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeeSyyCocsaVugmfi6GL0yOimH_3nfYsrW7PiSjhxUXg&oe=6A89784F"}, {"file_name": "Snap9.png", "id": "655389147587660", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310734_655389150920993_5790631350276993206_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njPMokSZ3FsQ7kNvwGc_IzP&_nc_oc=AdrhvFTV7siV57fyZu9tx-TbNHhHnA2cIkXiluGB1bjZxTfxbTNANUoLwbuFl1CG-Ws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbEoUbJLJZCC1u6Ku1aQ_NB8yU3VMplCX_szZZcsxJDQ&oe=6A899BE9"}, {"file_name": "Snap3.png", "id": "1055699900060001", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300910_1055699903393334_5764385113893552737_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoHTsKUFKUYQ7kNvwFccoLb&_nc_oc=AdrB4FdJfWIyBvVFJpZS8wgAutvQdEI42MmJmO2grBuSuQ-zTmDOv2KyzQTEEkUeZq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhq7TEZwQmsudxEqfbU2DmDdJpFpFMRa9u13-bSE6AOQ&oe=6A898E93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Preview.png", "id": "1414512846469917", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499309014_1414512849803250_1426844627165770914_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YclKzy39e3kQ7kNvwEFbLRQ&_nc_oc=AdoNipVuTfsPQskZ-bVeRyXIMCWd38mO3r1diHgM2PvC5m8OrUoKs7i1QGuXXDHLPmI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEMXggUjTq-U4ToxnfGkdKWrDxpqXtDGjNpXMWM8QFfQ&oe=6A898EC4"}, "display_name": "JetSuit", "keywords": ["arcade", "shooter", "mech", "score", "dodge"], "long_description": "What if your favorite old-school fuzzy-piloted arcade shooter got tossed in a blender with a Quest headset and a smack-talking AI mech suit? That\u2019s JetSuit.\n\nThis is fast-paced, wave-based alien-blasting chaos, rebuilt for modern mixed reality. You\u2019ll dodge like it\u2019s second nature, blast enemies out of the sky with intuitive, satisfying controls, and collect coins like mad. The more you play, the more parts you unlock to customize your JetSuit with swank new arm attachments and combat upgrades. Go full laser storm, get all rocketty, go weird - we won\u2019t stop you.\n\nAnd don\u2019t worry about barf bags or awkward head-flailing. JetSuit is designed to keep you fully immersed without motion sickness or complicated controls. No artificial world movement, no nausea, just clean VR & MR pass-through gameplay that feels like your mech is doing exactly what your brain wants.\n\nIt\u2019s retro energy without the wires, the quarters, or the wrist cramps. It\u2019s the game your inner arcade rat always wanted, now with a little more sass and a lot more jet propulsion. Suit up. Lock in. Let\u2019s cause some problems, Ace!", "short_description": "What if your favorite old-school fuzzy-piloted arcade shooter got tossed in a blender with a Quest headset and a smack-talking AI mech suit? That\u2019s JetSuit.\n\nIt\u2019s fast-paced alien wave-defense chaos with intuitive dodge-and-blast controls, coin-chasing mayhem, and full-on JetSuit customization to push your high scores higher and higher. No motion sickness, no flailing your head to dodge, just the very best parts of a classic arcade shooter, rebuilt for all this cool new tech! Let\u2019s do it!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://progresslanding.com/privacy-policies", "developer_terms_of_service_url": null, "publisher_name": "Progress Landing LLC", "support_website_url": null, "website_url": "https://progresslanding.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26938804789100701"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2144162832798443"}, {"status": "PUBLISHED", "id": "2145524875983527"}, {"status": "PUBLISHED", "id": "2805291836470995"}, {"status": "PUBLISHED", "id": "648050607891688"}]}, "baseline_offer": {"id": "2144162832798443"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786995060, "status": "PUBLISHED", "id": "2144162832798443"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32036040799377049", "version": "1.1"}, "id": "871114644727316", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26938804732434040", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32036040799377049"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "8711
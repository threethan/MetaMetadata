.oculuscdn.com/v/t64.5771-25/57570301_1839496169802327_2151255921570894725_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6QVai8jOwEQ7kNvwGeCL8p&_nc_oc=Adre2WW1SzzzdpUWohV7IuehI9elCrhxCu4ERF0OPCMgawkHp5NKElh1_KqZlnewOUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQCu2bjZZEGeVbawHqEmKpvcb1MC8sYuqqStcf7lrzzA&oe=6A9C3A37"}, {"file_name": "Freeland In-game Store Page Image 18.png", "id": "1698761464683978", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828608_1698761468017311_8283838942477581087_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mGbmfMnxVUQ7kNvwGVv92x&_nc_oc=AdoK8Qv9aEVpYDtrLeZ1qVEenffXnVRAv4d3IjwgbttxuvEBdI1qiH4AU9V4dOEux2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW4IrrDQNvFmDmn6jDDQx84fKQqmx0uFe9NZh59YaTRg&oe=6A9C23E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Freeland Banner 3.png", "id": "1944495342866724", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825497_1944495346200057_9215852616307874614_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L1D0-wOiTlwQ7kNvwGwW1WY&_nc_oc=Adr3UTXZLVE9l18PKKXHYWl_2KkCXs5DSeU23Is-slpDwbRBkDA8RFq_Uz1_cwvAIUw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5dqQLAwDap39sVJKWCUG85AzC0wlh7vpZ-BVkMNWJAA&oe=6A9C2A8E"}, "display_name": "Freeland", "keywords": ["Freeland", "FreelandVR", "VR", "free", "online"], "long_description": "**ENTER FREELAND - YOUR VR ADVENTURE AWAITS**\n\nFreeland is a massive multiplayer VR MMORPG where you decide how you want to play. Explore vast planets, meet players from around the world, embark on quests, level up, discover epic gear, battle powerful bosses, and build your own adventure across a living virtual galaxy.\n\nCreate your own full-body AI avatar simply by describing what you want to look like. Forge friendships, join guilds, become the strongest, or create your own path through the universe.\n\n\u25cf Explore vast open-world planets with unique environments, challenges and adventures.\n\n\u25cf Complete quests, level up, discover gear, master weapons and magic, and grow stronger.\n\n\u25cf Battle powerful bosses and enemies across the galaxy.\n\n\u25cf Fly through space and travel between planets in your spaceship.\n\n\u25cf Race cars and jet skis, or ride dragons, horses and other mounts.\n\n\u25cf Challenge other players in PvP arenas and compete for the top of the leaderboards.\n\n\u25cf Build your own planet for other players to explore.\n\n\u25cf Create your own stories and quests and give your world its own adventure.\n\n\u25cf Join guilds, team up with friends, and take on the galaxy together.\n\nThe galaxy is threatened by Ventax, the rogue architect whose corruption spreads across Freeland. Explore the worlds, uncover their stories, forge alliances, and shape your own destiny.\n\n**Your character. Your world. Your adventure. Your Freeland.**", "short_description": "Freeland is a massive multiplayer VR MMORPG where you create your own adventure. Explore vast planets, complete quests, level up, discover epic gear, and battle powerful bosses with friends. Fly through space, race cars, ride dragons, horses and jet skis. Create your own full-body AI avatar from a simple description. Join guilds and become the strongest, or build your own planet, story and quests for others to explore. Your freedom is limitless."}]}, "developer_name": "Freeland VR", "developer_privacy_policy_url": "https://www.freelandvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.freelandvr.com/terms-of-service/", "publisher_name": "Freeland VR", "support_website_url": "https://www.freelandvr.com/support/", "website_url": "https://www.freelandvr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "1023770785722696"}], "externa
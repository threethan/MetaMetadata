c_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkag74dpqUH-YL9P3ppWV7P72bADHuiyCJGdBCPMnsiw&oe=6A9C3B77"}, {"file_name": "TimeRiseCombat1-2.png", "id": "3270684533239576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_3270684536572909_5739980510827982019_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8GFG03_RWEQ7kNvwFFTtD7&_nc_oc=AdqV2KdZZtb8Fo9qWPRXt7Jjh85-2hJ2e59d94LwV5_gPMEcEt9-XMDd20FT6_Y9i1k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ41seC1lr0ylyIKvDbjCvEhzSh4rjupgAb1XMCvrNdig&oe=6A9C25C7"}, {"file_name": "HaeyannaHorses1-2.png", "id": "1839496166468994", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570301_1839496169802327_2151255921570894725_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6QVai8jOwEQ7kNvwGeCL8p&_nc_oc=Adre2WW1SzzzdpUWohV7IuehI9elCrhxCu4ERF0OPCMgawkHp5NKElh1_KqZlnewOUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQCu2bjZZEGeVbawHqEmKpvcb1MC8sYuqqStcf7lrzzA&oe=6A9C3A37"}, {"file_name": "TimeRiseCar1-3.png", "id": "891948402580443", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031354_891948405913776_8367965807676520846_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Td4uQrZ1QVoQ7kNvwFAVdhv&_nc_oc=AdqaJ4839yq0Eu8bHbjrQpb1lU9f9tmVTlHKooU4ekUvO-gPZLYYfDA7D7u5R7Sx21g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc77Acp7MvmK6LhZyNbpcsDlvO7p4f6vb7x0LR8FTYYw&oe=6A9C3628"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Spaceship1.png", "id": "1075579490532206", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031510_1075579493865539_1629575592564720329_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylyhvVwGEFIQ7kNvwH7qkc0&_nc_oc=AdotETYjkgpHaWd1ihPjU2HHZTRLH5ltm7_pMfzrAoYW5ZrzmaNzsL2D2HGHYjU55MY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpWR_T0E67UPNoKfnnJED9rtAa7cgrOL4rJxlzUq3DBw&oe=6A9C0B86"}, "display_name": "Freeland", "keywords": [], "long_description": "Freeland is a virtual universe waiting to be explored, conquered, and shaped by your choices in this massively multiplayer online role-playing adventure. Immerse yourself in a colossal VRMMORPG where expansive open worlds teem with endless possibilities. Engage in quests that will challenge and reward you as you traverse this ever-evolving virtual universe. Unveil the rich storyline and forge your identity while connecting with players from across the globe through unparalleled social experiences.\n\nThe galaxy is on the brink of destruction, and Ventax, the rogue all-powerful architect, threatens the very fabric of existence. Your mission is clear: to travel across multiple planets, forge alliances, and bring peace to the people of Freeland. \n\n\u25cfCreate your unique virtual identity.\n\n\u25cfForge alliances and make friends as you meet other players in the online universe.\n\n\u25cfExplore diverse open-world planets and become immersed in the virtual galaxy.\n\n\u25cfFind or craft gear and upgrade your skills, with magic and weaponry.\n\n\u25cfEngage in immersive quests and help save the Freeland Galaxy from Ventax.\n\n\u25cfTravel freely between planets with your spaceship.\n\n\u25cfFight in epic battles against Ventax\u2019s armies spread across the planets.\n\n\u25cfRace to the top of the leaderboards with cars, spaceships, jet skis, mounts and parkour races.\n\n\u25cfChallenge other players in arena battles.\n\nEnter the Freeland universe and join the epic adventure! Are you ready for the future of VR Gaming? Dive into Freeland now!", "short_description": "Freeland is a huge multi-planetary VRMMORPG. The galaxy is in peril as the Dark Lord Ventax spreads corruption. \n\nYour mission: traverse worlds, free the Valiants, and restore peace. Join forces with friends, embark on quests, and engage in races in the largest-scale VRMMORPG ever created. Discover epic loot to elevate your gameplay, become the best, and climb the global leaderboards. Are you ready for this unforgettable adventure?\n\nDive into Freeland now and discover your true virtual freedom!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freelandvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.freelandvr.com/terms-of-service/", "publisher_name": "Freeland VR", "support_website_url": "https://www.freelandvr.com/support/", "website_url": "https://www.freelandvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "EXPLORATION", "RPG"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "6968194433235916"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1367536417171449"}]}, "baseline_offer": {"id": "1367536417171449"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1726768800, "status": "PUBLISHED", "id": "1367536417171449"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28005870229041697", "version": "7630"}, "id": "363546185180291", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4214055731983147", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28005870229041697"}, "release_status": "REL
ures from the prehistoric world."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.vdimension.co.uk/", "developer_terms_of_service_url": "http://www.vdimension.co.uk/", "publisher_name": "VDimension", "support_website_url": null, "website_url": "http://www.vdimension.co.uk/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EDUCATIONAL", "EXPLORATION", "SIMULATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1051180958767318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162707_1583220361750488_985226791457128448_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NwXDXlORZ8Q7kNvwHTgoM3&_nc_oc=AdrrhC0KMu2DarC0M1leUoBBUyNwPidcvc8rrMuuypmLgghDz0p9kX3tV_P5aI4gKgY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4MCEz-rjUrP7g1q4G8mql0wvKX6nO5xJAFMqoQJyCgQ&oe=6A8D6F4E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Prehistoria", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1503594000, "lastRevision": {"nodes": [{"id": "1481288491929883", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1617001221678467", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1419360384777552"}, "iarc_email": null, "msrp": null, "transl
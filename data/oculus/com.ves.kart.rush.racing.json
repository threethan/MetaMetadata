MhaRDyU_iC7JlE3HxHvFRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZvx-t1Uf834isACB0tv5HzYfG1qIctXfsRXLrLnIQZA&oe=6AFDCAC4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kart Rush Racing Game", "keywords": ["kartracing", "racinggame", "kartgame"], "long_description": "Start your engines and get ready for the ultimate kart racing rush! \ud83c\udfc1\n\nKart Rush Racing Game puts you in the driver's seat of an exciting VR kart racing experience built for Meta Quest. Grab the wheel, hit the accelerator, and race through thrilling tracks filled with fast corners, challenging turns, and plenty of opportunities to prove your racing skills.\n\nFeel the excitement of kart racing from an immersive first-person perspective. Control your kart, improve your driving technique, find the perfect racing line, and push yourself to set faster lap times.\n\n\ud83d\udd25 Fast-Paced Kart Racing\nJump into your kart and experience exciting, high-speed races designed to keep you moving.\n\n\ud83c\udfce\ufe0f Immersive VR Experience\nGet behind the wheel and experience the race from the driver's seat with an engaging VR perspective.\n\n\ud83c\udfc1 Challenging Tracks\nTake on winding corners, long straights, and challenging sections that test your control and timing.\n\n\u26a1 Race for Victory\nPush your kart to the limit, improve your lap times, and compete for the best results.\n\n\ud83c\udfae Made for Meta Quest\nEnjoy an accessible and immersive kart racing experience designed for VR.\n\nPre-order now and get ready to hit the track!\n\nPut on your Meta Quest headset, grab the wheel, and prepare for an adrenaline-filled kart racing adventure. The green light is waiting\u2014are you ready to race? \ud83c\udfc6", "short_description": "Get behind the wheel and race at full speed! Kart Rush Racing Game brings fast, fun, and immersive kart racing to Meta Quest. Drift through challenging tracks, master sharp turns, and race your way to victory in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vision-edge-studio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Vision Edge Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vision-edge-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1347367905107082"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1863094014663112"}, {"status": "PUBLISHED", "id": "1378440137797414"}]}, "baseline_offer": {"id": "1863094014663112"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790614800, "status": "PUBLISHED", "id": "1863094014663112"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1347383518438854", "version": "1.0"}, "id": "37926064660372540", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1347367878440418", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1347383518438854"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3792606466037254
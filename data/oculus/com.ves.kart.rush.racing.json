aQnFwdcQ7kNvwEm3hvL&_nc_oc=AdqVU-IEh5AdDvN92_GbN1FwK65rEB7sVxEaHl2Q5uoBgBvUtDgCpFX8KP6Q0VL1TwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyTn1p8ef2L_f9GWs9AdWbrJsqkA5EPP2WfP_JEuHjUw&oe=6AFDB43E"}, {"file_name": "T53.png", "id": "1566667214718772", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673751957_1566667218052105_2621104910455169109_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEpPY3XmQawQ7kNvwFc8ETg&_nc_oc=Adqh31qN-yK8_h_TZr5Y92__AdF_gPUpQ69IS0HUW8V-ydAaMBpHFGYQkrVBXNPdRGU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT_cS89_XwmY1Ot0Bcp7_TtzQl57AXJKunAvlwDhSG3g&oe=6AFDC283"}, {"file_name": "V5.png", "id": "1104212925559387", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596068480_1104212932226053_8986703828158932982_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV6uOM_PDT4Q7kNvwH3vbcq&_nc_oc=AdrM1XnbclMDtIedYRzXP5wwVVCTMczfdrmo2A6nGnSMT6SV1PvUVO44uZoH99ayCrU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb2JkuuT1u0BkRSxL867LpBwjpwa7TkKIlU531wU0QUw&oe=6AFDDD43"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kart Rush Racing Game", "keywords": ["kartracing", "racinggame", "kartgame"], "long_description": "Start your engines and get ready for the ultimate kart racing rush! \ud83c\udfc1\n\nKart Rush Racing Game puts you in the driver's seat of an exciting VR kart racing experience built for Meta Quest. Grab the wheel, hit the accelerator, and race through thrilling tracks filled with fast corners, challenging turns, and plenty of opportunities to prove your racing skills.\n\nFeel the excitement of kart racing from an immersive first-person perspective. Control your kart, improve your driving technique, find the perfect racing line, and push yourself to set faster lap times.\n\n\ud83d\udd25 Fast-Paced Kart Racing\nJump into your kart and experience exciting, high-speed races designed to keep you moving.\n\n\ud83c\udfce\ufe0f Immersive VR Experience\nGet behind the wheel and experience the race from the driver's seat with an engaging VR perspective.\n\n\ud83c\udfc1 Challenging Tracks\nTake on winding corners, long straights, and challenging sections that test your control and timing.\n\n\u26a1 Race for Victory\nPush your kart to the limit, improve your lap times, and compete for the best results.\n\n\ud83c\udfae Made for Meta Quest\nEnjoy an accessible and immersive kart racing experience designed for VR.\n\nPre-order now and get ready to hit the track!\n\nPut on your Meta Quest headset, grab the wheel, and prepare for an adrenaline-filled kart racing adventure. The green light is waiting\u2014are you ready to race? \ud83c\udfc6", "short_description": "Get behind the wheel and race at full speed! Kart Rush Racing Game brings fast, fun, and immersive kart racing to Meta Quest. Drift through challenging tracks, master sharp turns, and race your way to victory in VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vision-edge-studio/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Vision Edge Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vision-edge-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1395903
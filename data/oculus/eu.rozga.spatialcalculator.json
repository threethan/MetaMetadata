 tool for your Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wrozga.com/privacyPolicyCalculator.html", "developer_terms_of_service_url": null, "publisher_name": "Wojciech Rozga Mobile Apps", "support_website_url": null, "website_url": "https://wrozga.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8902255199872226"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "550697308002204"}]}, "baseline_offer": {"id": "550697308002204"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739293020, "status": "PUBLISHED", "id": "550697308002204"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8874561589308254", "version": "1.0"}, "id": "393192567217704", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8873037119460701", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "8874561589308254"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "393192567217704"}]}, "change_log": null, "created_date": 1738772032, "
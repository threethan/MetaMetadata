ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXRR5r_aI3eOsB8IkeD4xpvan-UR7OxMq9kxQYjecldQ&oe=6AFDCA78"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Calculator", "keywords": ["math", "calculation", "numbers", "calc"], "long_description": "This isn't just another calculator app \u2013 it's designed from the ground up for Meta Quest. Enjoy a clean, intuitive interface with large, easy-to-tap buttons, all within your virtual environment. The locked aspect ratio ensures a perfect, distortion-free display, and the responsive design makes it a breeze to use. Whether you're working, learning, or just need to do some quick math, this VR calculator is the perfect tool for your Quest. \n\nPerfect for productivity or just crunching numbers in a new dimension!", "short_description": "This isn't just another calculator app \u2013 it's designed from the ground up for Meta Quest. Enjoy a clean, intuitive interface with large, easy-to-tap buttons, all within your virtual environment. The locked aspect ratio ensures a perfect, distortion-free display, and the responsive design makes it a breeze to use. Whether you're working, learning, or just need to do some quick math, this VR calculator is the perfect tool for your Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wrozga.com/privacyPolicyCalculator.html", "developer_terms_of_service_url": null, "publisher_name": "Wojciech Rozga Mobile Apps", "support_website_url": null, "website_url": "https://wrozga.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recomme
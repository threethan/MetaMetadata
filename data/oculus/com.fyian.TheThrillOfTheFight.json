4912_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxiRnT8nR6YQ7kNvwEauyDo&_nc_oc=Ado2-U2yv3VDl8LY6-PZ2WKZPTDrIQShnts2Ujfe8f2exDaAtxjMs7OyMJrafEu2QcQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_0-QrhziONSwJbzoAVzKZW303orfesIF9gOh3mQ2i-A&oe=69C2808B"}, "display_name": "The Thrill of the Fight", "keywords": ["boxing", "mma", "fighting", "sports", "punch"], "long_description": "The Thrill of the Fight is a down-to-earth VR boxing game focused on authenticity. Enter a virtual gym and battle a series of unique challengers with their own styles and techniques. Use timing and skill to land the knockout blow. Evade swings, land jabs, and block punches to become the king of the ring!\n\nRoom scale is required with a minimum supported play area size of 6.5ft by 6.5ft (2m by 2m). Please ensure your Guardian boundaries are set up properly for room scale and that you are willing to move and punch anywhere within and around the play area you have defined.", "short_description": "The Thrill of the Fight is a room-scale only VR boxing game focused on authenticity. Face off in the virtual ring where you'll jab, dodge, and sweat your way to the top of the boxing world. Grab your gloves, step through the ropes, and become a champion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.halfbrick.com/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Halfbrick Studios Pty Ltd", "support_website_url": null, "website_url": "https://www.halfbrick.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": nul
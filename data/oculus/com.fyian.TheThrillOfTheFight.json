93632228", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982518_502840696965561_5952425429276033024_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LY8JWzB_OfoQ7kNvwGpCEi3&_nc_oc=Adqr12dVkd_OXCNhTSILjc9ZMbzUE9n8Um8ihjYV3kGc4bWCjw9VF43ms2uL_KHC20E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEeoiHSdkCc49hfjmMq4DZxpazehTrobhx4CQzBiEmRA&oe=6B0317FB"}, "display_name": "The Thrill of the Fight", "keywords": ["boxing", "mma", "fighting", "sports", "punch"], "long_description": "The Thrill of the Fight is a down-to-earth VR boxing game focused on authenticity. Enter a virtual gym and battle a series of unique challengers with their own styles and techniques. Use timing and skill to land the knockout blow. Evade swings, land jabs, and block punches to become the king of the ring!\n\nRoom scale is required with a minimum supported play area size of 6.5ft by 6.5ft (2m by 2m). Please ensure your Guardian boundaries are set up properly for room scale and that you are willing to move and punch anywhere within and around the play area you have defined.", "short_description": "The Thrill of the Fight is a room-scale only VR boxing game focused on authenticity. Face off in the virtual ring where you'll jab, dodge, and sweat your way to the top of the boxing world. Grab your gloves, step through the ropes, and become a champion."}]}, "developer_name": "Ian Fitz", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Ian Fitz", "support_website_url": null, "website_url": "http://fyian.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FIGHTING", "SPORTS"], "has_in_app_ads": null, "internet_conne
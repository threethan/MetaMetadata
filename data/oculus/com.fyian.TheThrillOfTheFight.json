ontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCDKIT9geTSm2qxQKkNI1S_HQMsPbZtClkGFgFXGw7Ww&oe=6B0319A7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/3sdIHN", "id": "229767478220518", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462207_229767481553851_4477259868549414912_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y89V2HavT4AQ7kNvwGBwQJ7&_nc_oc=AdobjCrAT6I-adAK1w6JZx0iwaSMIMwfN9zlrZdu7PTaAROr8mVPx4DiYXlHbEw04Z8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlMP7V_lg-4-rjdSuB4aoQN5IXxd66gSF5e1eU7e9SAw&oe=6B03154B"}, "display_name": "The Thrill of the Fight", "keywords": ["boxing", "mma", "fighting", "sports", "punch"], "long_description": "The Thrill of the Fight is a down-to-earth VR boxing game focused on authenticity. Enter a virtual gym and battle a series of unique challengers with their own styles and techniques. Use timing and skill to land the knockout blow. Evade swings, land jabs, and block punches to become the king of the ring!\n\nRoom scale is required with a minimum supported play area size of 6.5ft by 6.5ft (2m by 2m). Please ensure your Guardian boundaries are set up properly for room scale and that you are willing to move and punch anywhere within and around the play area you have defined.", "short_description": "The Thrill of the Fight is a room-scale only VR boxing game focused on authenticity. Face off in the virtual ring where you'll jab, dodge, and sweat your way to the top of the boxing world. Grab your gloves, step through the ropes, and become a champion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.halfbrick.com/vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Halfbrick Studios Pty Ltd", "support_website_url": null, "website_url": "https://www.halfbrick.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534"
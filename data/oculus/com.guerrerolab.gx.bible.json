_name": "screenshot_3.png", "id": "2440998863408064", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/795000614_2440998866741397_7950180152420857247_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZxLDAegWwu8Q7kNvwFGJnU-&_nc_oc=Adqsp4diig0TU8wTG1iTTc5yQCYix9eQ9jBtYutNbtec6K8VYbVRa6N7_3y89SAfPRQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYU9vEoam9I8X3jy-KaGXkjKFeA_9b7SeTHi2a4otf3A&oe=6AFC6A1B"}, {"file_name": "screenshot_4.png", "id": "1569522338258899", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/595133382_1569522341592232_779847109774834793_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uq9QfMhtZAoQ7kNvwHyxEdC&_nc_oc=AdpZStjYsOjg7srd-z105bgSzgitzAuX12HPc0qk8vRRm_OrBWUP_-EUy7l6V2UjjtI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgRDmPblYJ0HshpKA39DUMSePcz3kSgvGZwV5DepeAXQ&oe=6AFC687F"}, {"file_name": "screenshot_5.png", "id": "1655053039601320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/646438748_1655053049601319_4987796389285098232_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-nvpykGMycQ7kNvwEyfKeG&_nc_oc=AdqjAD9AHdLqtff5VxBkQuxV8BgYkqN2tEl3tzzQ0AdgQj4oLS-r6niUl5XE2Rfws84&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeSpC8c32GXSPJnNtWN9ZR-ssmd6hctCYRSMlHtKqa2w&oe=6AFC8331"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GX Bible", "keywords": ["Bible", "Biblia", "Book", "Learning"], "long_description": "# GX Bible\n\nGX Bible is a powerful, free Bible reader built natively for Meta Quest \u2014 \nread God's Word in immersive comfort, right in your VR space.\n\n## \ud83d\udcd6 TRANSLATIONS\n- Access 1,000+ Bible translations from around the world\n- Spanish, English, and hundreds of other languages\n- Add or remove translations as you need them\n- Download translations for offline reading \u2014 no internet required\n\n## \u271d\ufe0f READING PLANS\n- Bible in a Year \u2014 read the full Bible in 365 days\n- NT in 90 Days \u2014 focus on the New Testament\n- Track your daily progress and reading streak\n\n## \ud83d\udd0d SEARCH & NAVIGATION\n- Full-text search powered by Typesense\n- Quick navigation by book, chapter and verse reference\n- Jump directly to any verse instantly\n\n## \ud83d\udcdd STUDY TOOLS\n- Highlight verses in 4 colors\n- Add personal notes to any verse\n- Bookmark your favorite verses\n- Full reading history\n\n## \ud83c\udf10 MULTILINGUAL\n- Complete UI in Spanish and English\n- Automatically adapts to your selected translation\n\nGX Bible is free, ad-free, and built with love for the Word of God.", "short_description": "GX Bible is a powerful, free Bible reader built natively for Meta Quest \u2014 \nread God's Word in immersive comfort, right in your VR space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://guerrero-lab.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Guerrero Lab", "support_website_url": null, "website_url": "https://guerrero-lab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_VE", "es", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1744165723327219"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-se
c=uL8-UtLNZWMQ7kNvwFz-sf4&_nc_oc=Ado075fotqpscKzV3nuVXInPHIOVduGv9YZEKELUc6eov48V0Lbf3208By-FVf_XszM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmVGHLEdQJjyYVhc-XgINRuKq63DGCUnXSL5Gsc7HQFQ&oe=6AF4811B"}, {"file_name": "screenshot_4.png", "id": "1569522338258899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595133382_1569522341592232_779847109774834793_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pgQ79fBWoLUQ7kNvwECQQsJ&_nc_oc=AdrgKhXMO3K9liRKvH7SEYqwXVD2ub9dt26WyQvWQUwrLrRMEkO8TCOdlKEZbz7V7oM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ04fOH9_TtQDp68rvuzGSBDd6iSbmQ4AbkW0zC0cqN_g&oe=6AF47F7F"}, {"file_name": "screenshot_5.png", "id": "1655053039601320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/646438748_1655053049601319_4987796389285098232_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJiX85mtiTYQ7kNvwH8O2Fc&_nc_oc=AdrdFRDAQpPUKBPuGla474GJ3R17CeHQWlriphyBCnwX8z-f6TfuA-08d5nyzSxGYQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwwQvTWEr7u6HAjyHqnF1MYOUtuLPhuNNDOqJYcql3HQ&oe=6AF49A31"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GX Bible", "keywords": ["Bible", "Biblia", "Book", "Learning"], "long_description": "# GX Bible\n\nGX Bible is a powerful, free Bible reader built natively for Meta Quest \u2014 \nread God's Word in immersive comfort, right in your VR space.\n\n## \ud83d\udcd6 TRANSLATIONS\n- Access 1,000+ Bible translations from around the world\n- Spanish, English, and hundreds of other languages\n- Add or remove translations as you need them\n- Download translations for offline reading \u2014 no internet required\n\n## \u271d\ufe0f READING PLANS\n- Bible in a Year \u2014 read the full Bible in 365 days\n- NT in 90 Days \u2014 focus on the New Testament\n- Track your daily progress and reading streak\n\n## \ud83d\udd0d SEARCH & NAVIGATION\n- Full-text search powered by Typesense\n- Quick navigation by book, chapter and verse reference\n- Jump directly to any verse instantly\n\n## \ud83d\udcdd STUDY TOOLS\n- Highlight verses in 4 colors\n- Add personal notes to any verse\n- Bookmark your favorite verses\n- Full reading history\n\n## \ud83c\udf10 MULTILINGUAL\n- Complete UI in Spanish and English\n- Automatically adapts to your selected translation\n\nGX Bible is free, ad-free, and built with love for the Word of God.", "short_description": "GX Bible is a powerful, free Bible reader built natively for Meta Quest \u2014 \nread God's Word in immersive comfort, right in your VR space."}]}, "developer_name": null, "developer_privacy_policy_url": "https://guerrero-lab.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Guerrero Lab", "support_website_url": null, "website_url": "https://guerrero-lab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_VE", "es", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1744165723327219"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595126537_1611905657618474_8323270054579331658_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSAX06PbPSAQ7kNvwFroKff&_nc_oc=AdryE_ZCBX5ce7ArJonVGFeT2SgQzoQls8v87mcy5XCu2YfL8kooJSpnLyG2Iz6X6ao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculu
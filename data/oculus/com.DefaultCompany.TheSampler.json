&_nc_sid=6e7a0a&_nc_ohc=i_c9Q8pcRMoQ7kNvwEVwRdk&_nc_oc=AdoJnYHIim7rGJp-JiCsSphWBoaEtl-I0CMnrcjkbE8uwoA4Zu65n0FRfl6mwsFK0CM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rJR-tx9VwGeeTKKP2M8WdzEbeq6yFx3TCJ-kLJoHmEg&oe=6A11ADF6"}, {"file_name": "6.png", "id": "864864149203839", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823259_864864152537172_8308102722050968595_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xN_wTw6Il98Q7kNvwEIPGr4&_nc_oc=AdqvZfBQSzUzI_XJRFcZZQ5xC5uVOCJxikz5SZX4Edr2uOb3r-UHfk-qEEVjdrGdb_w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kqoQCMS4r65wdXPUt_GDtDaDaPRWmkEUQid4Xc9wGew&oe=6A11CE3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "the sampler app 2560x1440.png", "id": "1769931543681541", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303864_1769931547014874_4101944452923536642_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzc4JtirghkQ7kNvwFNBmhC&_nc_oc=AdrxjwP-X9blAd2GarO6D7Wbz-4TQpQ9YjXt13Nt6ZeQNUvbNjnOZUNhcC1PeLD4E9k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7V3iwXAt7lW_0vKRuSYXorAxbr6bmrJ0i9FIfsU7n9aQ&oe=6A11BD36"}, "display_name": "The Sampler", "keywords": [], "long_description": "Step inside The Sampler VR the world\u2019s first virtual reality music competition and creative studio experience. Built for artists, producers, and fans, The Sampler VR transforms music creation and performance into an immersive, interactive world.\n\nRecord live vocals, join cyphers, explore custom stages, and connect with other creators from around the globe. Each season, new samples drop and producers and artists team up to create original tracks right inside VR. Whether you\u2019re performing, listening, or exploring, The Sampler VR gives you the feeling of being inside the music.\n\n\ud83c\udfa4 Join the Show: Step into The Sampler arena and experience the thrill of a live VR music competition.\n\n\ud83c\udfa7 Create in Real Time: Record your voice over beats, layer samples, and mix tracks in your own virtual studio.\n\n\ud83c\udf0d Connect & Collaborate: Network with other artists, producers, and fans across the world.\n\n\ud83c\udfc6 Compete & Get Discovered: Enter official Sampler events and earn your spot in upcoming seasons.\n\n\ud83d\udd25 Exclusive Editions: From the \u201cFallback Edition\u201d to \u201cTriple Threat,\u201d each version brings new sounds, visuals, and vibes.\n\nPowered by Map Out Experience, The Sampler VR is where music, technology, and creativity meet. Whether you\u2019re a seasoned artist or a first-time explorer, this is your stage your sound your world.\n\nVisit: ItsTheSampler.com\n\nFollow: #TheSamplerVR #ItsTheSampler", "short_description": "The Sampler is a virtual reality music contest app where producers and artists showcase their talents, create songs from real samples, and perform live in immersive 3D stages. Connect, compete, and experience music like never before."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/1a2c644f-2be4-47c1-937c-9db9a98aa110", "developer_terms_of_service_url": null, "publisher_name": "MapOut Experiences LLC", "support_website_url": null, "website_url": "https://www.itsthesampler.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "2687655338230691"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_
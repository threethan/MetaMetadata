": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984464_1497756740668745_7827896788019981950_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g523BK2EaJ4Q7kNvwEmclrD&_nc_oc=AdpTI7zSm8D-rvBOIxygfATWHqmCdoU3QliSk2AOX-y1d8c8ZGIP4G432FNks-oUCzw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoM-uRZ3dqfYdDv7RElnA-12WOi07SukSOonlapiqbYQ&oe=6B05D58F"}, "display_name": "Sierra Pacific VR Xperience", "keywords": [], "long_description": "The Sierra Pacific VR Xperience virtual showroom is the most incredible way to experience and interact with Sierra Pacific\u2019s luxury doors and windows.  Check out the different options for specialty doors while you immerse yourself in a beautifully designed custom home.  You won\u2019t have to just imagine what different wood species, or a painted interior would look like\u2026 you can see it for yourself in our virtual showroom. ", "short_description": "The Sierra Pacific VR Xperience virtual showroom is the most incredible way to experience and interact with Sierra Pacific\u2019s luxury doors and windows.  Check out the different options for specialty doors while you immerse yourself in a beautifully designed custom home.  You won\u2019t have to just imagine what different wood species, or a painted interior would look like\u2026 you can see it for yourself in our virtual showroom. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mediumlabs.com/sierra-pacific-vr-xperience-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MEDIUM Labs", "support_website_url": null, "website_url": "http://www.mediumlabs.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_R
=69B56ECF"}, "display_name": "Sierra Pacific VR Xperience", "keywords": [], "long_description": "The Sierra Pacific VR Xperience virtual showroom is the most incredible way to experience and interact with Sierra Pacific\u2019s luxury doors and windows.  Check out the different options for specialty doors while you immerse yourself in a beautifully designed custom home.  You won\u2019t have to just imagine what different wood species, or a painted interior would look like\u2026 you can see it for yourself in our virtual showroom. ", "short_description": "The Sierra Pacific VR Xperience virtual showroom is the most incredible way to experience and interact with Sierra Pacific\u2019s luxury doors and windows.  Check out the different options for specialty doors while you immerse yourself in a beautifully designed custom home.  You won\u2019t have to just imagine what different wood species, or a painted interior would look like\u2026 you can see it for yourself in our virtual showroom. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://mediumlabs.com/sierra-pacific-vr-xperience-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "MEDIUM Labs", "support_website_url": null, "website_url": "http://www.mediumlabs.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "877379582865093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3551659695077905"}, "review_messa
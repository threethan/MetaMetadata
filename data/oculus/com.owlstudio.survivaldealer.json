210398_956166979742641_7930863452095466447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-vpWWc905MQ7kNvwEfojH7&_nc_oc=AdqI-fJDaCbBz_xoU5FHkEXoO2bOUJAjRs1FZsf6vbara7wDYGrdFbhzdvkdy12W9yI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHQOLRuNhwWtgZpEgClDESkax1G71vgdpEanKqkmrdaA&oe=6AF32593"}, {"file_name": "Screenshot 2024-12-16 200924.png", "id": "560576760069670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75282164_560576763403003_438188916989991760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kTciGM18C4EQ7kNvwGplee5&_nc_oc=AdouHZpN624JJv4WPvARt5i8KdY77wZHia9L3yLmCayasU2Ekd1nDPrw0JGkbbZNvyQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIso-AejeT8ocfFWR2XcSn6usFgPN8dKD4h1WKIWljGA&oe=6AF3584C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER.png", "id": "1760779314767050", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974844_1760779321433716_6256278322676637327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OpJBub2s4IQ7kNvwHOe7m3&_nc_oc=AdrYAoPnzYgkMSe4IpWj9gbSv6JYH3XFSTuJ3Qw6bIHvs1Re8uVCJXBBQ6vNzOGjtVA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0S3KkpdzTS--9FVQ3dSiHcRNb_9LdEa1vjw85E9xIKg&oe=6AF3551E"}, "display_name": "Survival Dealer : Card Game", "keywords": [], "long_description": "Step into the heart of an apocalyptic VR experience with Survival Dealer: Card Game, a unique blend of card games, board game mechanics, and intense survival zombie gameplay. The city has been overrun by a deadly virus, turning its inhabitants into ravenous zombies. As one of the last survivors, your only chance of survival is your wits and your deck of strategic cards.\n\nEvery card drawn is a gamble, every decision a test of strategy\nThe rescue chopper is waiting\u2026\n\nWith immersive VR visuals and Unique Gameplay, this will be your favorite card game.", "short_description": "It's a new survival horror card game and will probably be your favorit
ng?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWs0GJ_1t3IQ7kNvwEMu6jV&_nc_oc=AdqvqYR21T8A667SbgqMPWOiTw-aqBThnyI4pq2biO22pRBiYX-UGMib5MgZlZe1WOo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeAhpIOQwjgVX56zk2tIbtqbmv_abrWhgKxf-nO0ozEA&oe=6AA94C0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER.png", "id": "1760779314767050", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974844_1760779321433716_6256278322676637327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s27AJs92x8YQ7kNvwEvH3zu&_nc_oc=Adpe3jGGfh0bqPLI5CaNWYSFRd5Il8Y1g-Oun63xIZJXRg6Z_eEaIj8hIID4QgDGDpQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm3pbFVVSRfP3-7IQdBNeQ5rgXz9nEFx9QvNB54wZ6Bw&oe=6AA948DE"}, "display_name": "Survival Dealer : Card Game", "keywords": [], "long_description": "Step into the heart of an apocalyptic VR experience with Survival Dealer: Card Game, a unique blend of card games, board game mechanics, and intense survival zombie gameplay. The city has been overrun by a deadly virus, turning its inhabitants into ravenous zombies. As one of the last survivors, your only chance of survival is your wits and your deck of strategic cards.\n\nEvery card drawn is a gamble, every decision a test of strategy\nThe rescue chopper is waiting\u2026\n\nWith immersive VR visuals and Unique Gameplay, this will be your favorite card game.", "short_description": "It's a new survival horror card game and will probably be your favorite coffee break game time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivaldealervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url": null, "website_url": "https://sites.google.com/view/survivaldealervr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics":
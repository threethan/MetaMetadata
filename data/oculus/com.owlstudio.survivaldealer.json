aldealervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url": null, "website_url": "https://sites.google.com/view/survivaldealervr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9132421976801953"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75641339_2354668154866623_4383222515824083518_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ExZ770Vpx8Q7kNvwGD-Lxx&_nc_oc=Ado1UNnKbQeRM4fvkbMoZa4jnv7UpMCuOcaX1bFj7GYgkAmyEnKM8OO6UNXmlUR-JtA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKmamHXq0YaVITjtnDHwAXc7pjyFqsVG1zhfjAiwTSuQ&oe=6AF09CBA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Survival Dealer : Card Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Strategy", "id": "275629210202852"}], "release_date": 1734533700, "lastRevision": {"nodes": [{"id": "9132422003468617", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "91324
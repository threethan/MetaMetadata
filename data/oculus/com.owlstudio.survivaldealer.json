576760069670", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282164_560576763403003_438188916989991760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMLPqBorl9IQ7kNvwEWD6sI&_nc_oc=Adrmdy3n0UtasX1OO26G0N9M7WqL2h1YYYCYtJyM_QidyOz0DR1lhbZYtfDwuStXqbA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUtCzG8zea6dlgjBRjrSlI5oJfxCcPzfrp93NkNbyN-g&oe=6ACE360C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER.png", "id": "1760779314767050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1760779321433716_6256278322676637327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUtuFI41_7oQ7kNvwFSGvdW&_nc_oc=AdpJ6r42mRsTv2_nTql9DdbwSucY-L7O_1gYtUQw4YTufL9WI7lB9A8Kn1rHNq1WvH0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTwCStkyE6xq5F_XV2QRcJT8PqZCxQJ-3T79N58dN2aw&oe=6ACE32DE"}, "display_name": "Survival Dealer : Card Game", "keywords": [], "long_description": "Step into the heart of an apocalyptic VR experience with Survival Dealer: Card Game, a unique blend of card games, board game mechanics, and intense survival zombie gameplay. The city has been overrun by a deadly virus, turning its inhabitants into ravenous zombies. As one of the last survivors, your only chance of survival is your wits and your deck of strategic cards.\n\nEvery card drawn is a gamble, every decision a test of strategy\nThe rescue chopper is waiting\u2026\n\nWith immersive VR visuals and Unique Gameplay, this will be your favorite card game.", "short_description": "It's a new survival horror card game and will probably be your favorite coffee break game time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivaldealervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url": null, "website_url": "https://sites.google.com/view/survivaldealervr", "category": null, "comfort_rating": "COMFORTABLE_FOR
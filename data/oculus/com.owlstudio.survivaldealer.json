210398_956166979742641_7930863452095466447_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M-sAeAKiN1MQ7kNvwG0yd8M&_nc_oc=Adp2HHgaWrN-o4Ml9cJIU_AOm5mFttyM_H8ssU7MIGo0l7KeydZHsNshLe03MPOBtVw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_Ie_0AbpF9xhzfb2mapsJhmCnzha9vcFGWeNSnpWWsg&oe=6AF1D413"}, {"file_name": "Screenshot 2024-12-16 200924.png", "id": "560576760069670", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282164_560576763403003_438188916989991760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HC1d6kH-ZoQ7kNvwEVrlqC&_nc_oc=AdqC02DdDEs5vuVILZCR1FEEeiVLHl1FL8MnmVKWXgiICwr_CInMPfG1z9HTQnliVQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpFG521vJX5ztVT2Lg72DdCw1c5jr_0YaGq-e006gPmg&oe=6AF206CC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER.png", "id": "1760779314767050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974844_1760779321433716_6256278322676637327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OpJBub2s4IQ7kNvwH9wEph&_nc_oc=Adr93DaV3ummAjMaDH9p4SxbvZqeSfd-44FUczAUBXITIKthVFvQ931YwhiLXa0H1iY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBzbvrtHUd8Cv-7lMdhxHHkqO16zIPYOE5BYnqS3nQRQ&oe=6AF2039E"}, "display_name": "Survival Dealer : Card Game", "keywords": [], "long_description": "Step into the heart of an apocalyptic VR experience with Survival Dealer: Card Game, a unique blend of card games, board game mechanics, and intense survival zombie gameplay. The city has been overrun by a deadly virus, turning its inhabitants into ravenous zombies. As one of the last survivors, your only chance of survival is your wits and your deck of strategic cards.\n\nEvery card drawn is a gamble, every decision a test of strategy\nThe rescue chopper is waiting\u2026\n\nWith immersive VR visuals and Unique Gameplay, this will be your favorite card game.", "short_description": "It's a new survival horror card game and will probably be your favorit
=00_AQScCcUFLE5bd4jeMZ_uXpg_IZihFzf-G_CgUsvHLVyrGQ&oe=6AE74813"}, {"file_name": "Screenshot 2024-12-16 200924.png", "id": "560576760069670", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282164_560576763403003_438188916989991760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvx7Oaz03YYQ7kNvwFydYmp&_nc_oc=AdrbqbsHVglKMTahFpUvv3LFwrrSLuh77gxxjypA-Nd2bKdywJVivPPYujhnH5K6BpI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb6XnnqprZdcXEm6V_3juxc7LE36xwpanetMdQnxfC0A&oe=6AE7428C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER.png", "id": "1760779314767050", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974844_1760779321433716_6256278322676637327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I32ln0D4Pd0Q7kNvwE6MPB0&_nc_oc=AdqFsz2sf6v2mttgBOFesyKM4_Rjqvs7cTx9VeXohevTz3q5lFFMtoYs13nTo4C4W2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLyIo6uQ8gghQw08vSR9RfuaB6tJQrG62GZrQnA6oCmQ&oe=6AE73F5E"}, "display_name": "Survival Dealer : Card Game", "keywords": [], "long_description": "Step into the heart of an apocalyptic VR experience with Survival Dealer: Card Game, a unique blend of card games, board game mechanics, and intense survival zombie gameplay. The city has been overrun by a deadly virus, turning its inhabitants into ravenous zombies. As one of the last survivors, your only chance of survival is your wits and your deck of strategic cards.\n\nEvery card drawn is a gamble, every decision a test of strategy\nThe rescue chopper is waiting\u2026\n\nWith immersive VR visuals and Unique Gameplay, this will be your favorite card game.", "short_description": "It's a new survival horror card game and will probably be your favorite coffee break game time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivaldealervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url
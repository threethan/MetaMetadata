2wsafzKqIhRIKc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29AQ6Uc4ukGsN-sGUnaxvy7MwIY-TWYU3MoTYktK-jsg&oe=69E77F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER.png", "id": "1760779314767050", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974844_1760779321433716_6256278322676637327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aylNS_qP3ooQ7kNvwG8zEMH&_nc_oc=AdrZBb20DHlV4UzXvsU0pXB12QDDsnePDRzc2IxzS-mrPBp8SYa_69k2971S8lEzXnM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18MYvQIg3GGdbBlYVfL-hdAuO_TujreRJ0TiC_7TMpxg&oe=69E77C5E"}, "display_name": "Survival Dealer : Card Game", "keywords": [], "long_description": "Step into the heart of an apocalyptic VR experience with Survival Dealer: Card Game, a unique blend of card games, board game mechanics, and intense survival zombie gameplay. The city has been overrun by a deadly virus, turning its inhabitants into ravenous zombies. As one of the last survivors, your only chance of survival is your wits and your deck of strategic cards.\n\nEvery card drawn is a gamble, every decision a test of strategy\nThe rescue chopper is waiting\u2026\n\nWith immersive VR visuals and Unique Gameplay, this will be your favorite card game.", "short_description": "It's a new survival horror card game and will probably be your favorite coffee break game time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivaldealervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url": null, "website_url": "https://sites.google.com/view/survivaldealervr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "644354873106712"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED",
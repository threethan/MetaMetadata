=00_AQME9e8blYuGwxdOnJETjWklbsKKc6P8w7UF2NyxVsSd5A&oe=6AE35393"}, {"file_name": "Screenshot 2024-12-16 200924.png", "id": "560576760069670", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75282164_560576763403003_438188916989991760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBXa8VTajVgQ7kNvwHfNdmZ&_nc_oc=AdqdoVlKF9kx-9A6D8jr7cfarns0cfNakchJFzgwl8BQqIyMkSnDTIPSCFjjdCM6xUo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpppYY0G-ZJkV3LSYsotRiVQmFNikMD3Kl-4tnY_if_Q&oe=6AE34E0C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER.png", "id": "1760779314767050", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974844_1760779321433716_6256278322676637327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UosGwhh3w-gQ7kNvwHY51kr&_nc_oc=AdoU_2br39hprvJ2PdU5Inmpah-MKFqXtPZ7qIuRNcXjxUyHgyp51VBnRGvh-9RCFSQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQDc3pdnR9BJDIa84FTgY5F8aWf4t5dQoDh-LBaJpimQ&oe=6AE34ADE"}, "display_name": "Survival Dealer : Card Game", "keywords": [], "long_description": "Step into the heart of an apocalyptic VR experience with Survival Dealer: Card Game, a unique blend of card games, board game mechanics, and intense survival zombie gameplay. The city has been overrun by a deadly virus, turning its inhabitants into ravenous zombies. As one of the last survivors, your only chance of survival is your wits and your deck of strategic cards.\n\nEvery card drawn is a gamble, every decision a test of strategy\nThe rescue chopper is waiting\u2026\n\nWith immersive VR visuals and Unique Gameplay, this will be your favorite card game.", "short_description": "It's a new survival horror card game and will probably be your favorite coffee break game time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivaldealervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url
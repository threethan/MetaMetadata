=00_AQRVlr6skYL1HonokgPjRJAyH-CDCzLhKqieG72a7KoMgQ&oe=6AE9EB13"}, {"file_name": "Screenshot 2024-12-16 200924.png", "id": "560576760069670", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75282164_560576763403003_438188916989991760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvx7Oaz03YYQ7kNvwFlDTOO&_nc_oc=AdpmPZieRAJiwVaYaqaCZGtZz7yrovxGQOdykYEaQDJKE5o8aU3IAbcqr_-KIYpfHAc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeh7blOWOx7C_oVJpY4Yob9Vf_AZDBEo9VRUBIm4jvaw&oe=6AE9E58C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER.png", "id": "1760779314767050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974844_1760779321433716_6256278322676637327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-NwG7mqcqSQQ7kNvwGzlLI_&_nc_oc=AdqkI3_aiMS2QnbJ1BJ04q7E-lZsVb2JPILWcJeTzQ-GZvUwTJYBKI0_uoDVm2IAhE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqvp9GHQmt278MizVN92un3z8LSQS-4ghzbt3aMQz0tw&oe=6AE9E25E"}, "display_name": "Survival Dealer : Card Game", "keywords": [], "long_description": "Step into the heart of an apocalyptic VR experience with Survival Dealer: Card Game, a unique blend of card games, board game mechanics, and intense survival zombie gameplay. The city has been overrun by a deadly virus, turning its inhabitants into ravenous zombies. As one of the last survivors, your only chance of survival is your wits and your deck of strategic cards.\n\nEvery card drawn is a gamble, every decision a test of strategy\nThe rescue chopper is waiting\u2026\n\nWith immersive VR visuals and Unique Gameplay, this will be your favorite card game.", "short_description": "It's a new survival horror card game and will probably be your favorite coffee break game time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivaldealervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url
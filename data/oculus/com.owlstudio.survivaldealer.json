=00_AQPcV1zFMwrTTCTPyTVHTA3UMp17ULWeT6SW2r1cqyy4RA&oe=6ADE0D93"}, {"file_name": "Screenshot 2024-12-16 200924.png", "id": "560576760069670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75282164_560576763403003_438188916989991760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nF13o5nRj8IQ7kNvwHS_o5J&_nc_oc=AdpK2Cu6GQAScIfYPts70-e9GTVJaAmaZFBZ9kPhAm3Q3l7kdSXkh2hwbXhETtbSGVU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhGY5fOtBBZZrQzE8AOCU4UqrZCEpiPveyNcT3YHE75g&oe=6ADE080C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER.png", "id": "1760779314767050", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974844_1760779321433716_6256278322676637327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMkPOdW1ojEQ7kNvwGgRDZ9&_nc_oc=Adpe5cZPmXYs_TRLifwMDqpYiEScLIK9ymNZ2qeyoXbccguAGD2-2nQJzbkjeaF2fTs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1U3RbT5uInGNTM_5OJj9_zG9YRrubl0qQT-GCgCTwkQ&oe=6ADE04DE"}, "display_name": "Survival Dealer : Card Game", "keywords": [], "long_description": "Step into the heart of an apocalyptic VR experience with Survival Dealer: Card Game, a unique blend of card games, board game mechanics, and intense survival zombie gameplay. The city has been overrun by a deadly virus, turning its inhabitants into ravenous zombies. As one of the last survivors, your only chance of survival is your wits and your deck of strategic cards.\n\nEvery card drawn is a gamble, every decision a test of strategy\nThe rescue chopper is waiting\u2026\n\nWith immersive VR visuals and Unique Gameplay, this will be your favorite card game.", "short_description": "It's a new survival horror card game and will probably be your favorite coffee break game time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivaldealervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url
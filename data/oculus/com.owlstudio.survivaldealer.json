ng?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPcarmkDapgQ7kNvwEUcJaG&_nc_oc=AdqCjtjraGVXOkmmNcV461l240ItNRH9agXHBKf5CDFrw76suXBzudYvF7Ohqibjyhw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBSFImw7d7QRF5ktjTamp6Ei2HMejawjjZoVjl2yWXOQ&oe=6A7DCA8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER.png", "id": "1760779314767050", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974844_1760779321433716_6256278322676637327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3JnWFKwIY4Q7kNvwE9ADYo&_nc_oc=AdoHyKnUmNby2UciAM4GFVVoeHrXPumrutirAZ48drJMRMQEUKu5Bcy-r1XKKqSohyQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgrz3osXtDhlYsytXFqncpSrSiJHE_u7Ca3oP2zX4Jgg&oe=6A7DC75E"}, "display_name": "Survival Dealer : Card Game", "keywords": [], "long_description": "Step into the heart of an apocalyptic VR experience with Survival Dealer: Card Game, a unique blend of card games, board game mechanics, and intense survival zombie gameplay. The city has been overrun by a deadly virus, turning its inhabitants into ravenous zombies. As one of the last survivors, your only chance of survival is your wits and your deck of strategic cards.\n\nEvery card drawn is a gamble, every decision a test of strategy\nThe rescue chopper is waiting\u2026\n\nWith immersive VR visuals and Unique Gameplay, this will be your favorite card game.", "short_description": "It's a new survival horror card game and will probably be your favorite coffee break game time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivaldealervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url": null, "website_url": "https://sites.google.com/view/survivaldealervr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics":
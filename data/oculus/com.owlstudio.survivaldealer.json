576760069670", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75282164_560576763403003_438188916989991760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftYOokKf6t8Q7kNvwEq3VaW&_nc_oc=Ado7svB0NiyF7OaLIoUoLfXNr4QPenPOONXHy8xxmwfJIfgaTOB-TMyHv2QaAYBlZ1M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2EHKGKtbtrwZwLX3FwkyCXGz8PkBelE3WqjsaCa40Zg&oe=6AD0D90C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "COVER.png", "id": "1760779314767050", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974844_1760779321433716_6256278322676637327_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUtuFI41_7oQ7kNvwHIHZ-6&_nc_oc=AdrSxz8aWN_MXsNdPsgi36bTVVEYq9cHzkNWdYSaryPFdPNf33A0aJOMjrE-KKb3W2s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrev9W1oyEjwmjVHEfU1J18oIPlKAkQFdDIOU-NnZ7nw&oe=6AD0D5DE"}, "display_name": "Survival Dealer : Card Game", "keywords": [], "long_description": "Step into the heart of an apocalyptic VR experience with Survival Dealer: Card Game, a unique blend of card games, board game mechanics, and intense survival zombie gameplay. The city has been overrun by a deadly virus, turning its inhabitants into ravenous zombies. As one of the last survivors, your only chance of survival is your wits and your deck of strategic cards.\n\nEvery card drawn is a gamble, every decision a test of strategy\nThe rescue chopper is waiting\u2026\n\nWith immersive VR visuals and Unique Gameplay, this will be your favorite card game.", "short_description": "It's a new survival horror card game and will probably be your favorite coffee break game time.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/survivaldealervr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Owl Studio Games", "support_website_url": null, "website_url": "https://sites.google.com/view/survivaldealervr", "category": null, "comfort_rating": "COMFORTABLE_FOR
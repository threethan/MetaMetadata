tant metallic groans, and the air hums with the unsettling sound of something moving just out of sight.\n", "short_description": "You are a baboon with gorilla-style locomotion, navigating a sprawling, dimly lit lab facility overrun with monsters. Swing, climb, and leap through crumbling corridors as you fight to survive the horrors lurking in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scarybaboonog/home", "developer_terms_of_service_url": null, "publisher_name": "Skidder", "support_website_url": null, "website_url": "https://sites.google.com/view/scarybaboonog/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "26303744642555513"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304019_918065364015107_9034334488298043671_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvuPKsQSwb4Q7kNvwGFafkj&_nc_oc=Adq0SHhAUFKrJyD8LDbHnynQd6-tJw-OM-GtmaTq7LEh0WcTvQKOaWYskg43IkPjUUk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mpDIwY-8lRdMtpxIiKShRPF74W_l0oahPMHLyfhNK2w&oe=69FC8B61"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scary Baboon OG", "platform": "ANDROID_6DOF", "context
file_name": "Screenshot_2026-02-13_065445.png", "id": "708859522309326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822968_708859525642659_5039696157717399336_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmZgpkofH7IQ7kNvwEnFSFc&_nc_oc=AdpW2K1k0hF6dj_P1OGrGpP-wiC9N2Fz_Z2Mu-kr6p_J69oqoTa7ZuPB4st58nmjD4I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkUfP0RGm4s7VRzpnxVWL9D2L7pwguKo5VW-UAbmPxKw&oe=6A50EB93"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Baboon OG", "keywords": [], "long_description": "Step into the role of a fearless baboon gifted with gorilla-style locomotion, trapped inside a massive, high-security laboratory deep underground. Once a place of scientific innovation, the facility has fallen into chaos after a catastrophic experiment unleashed unspeakable horrors. The sterile white walls are now stained and cracked, corridors echo with distant metallic groans, and the air hums with the unsettling sound of something moving just out of sight.\n", "short_description": "You are a baboon with gorilla-style locomotion, navigating a sprawling, dimly lit lab facility overrun with monsters. Swing, climb, and leap through crumbling corridors as you fight to survive the horrors lurking in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scarybaboonog/home", "developer_terms_of_service_url": null, "publisher_name": "Skidder", "support_website_url": null, "website_url": "https://sites.google.com/view/scarybaboonog/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "M
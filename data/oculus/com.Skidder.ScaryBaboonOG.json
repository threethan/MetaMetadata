fv8JC1BsCuNw_8T-8P6hHojQmfJulhSAVviBYaWI_8LY4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjvdeGeE9qXoDQT3_JYr8CDovYdcUum2sAa_lUsYmTuA&oe=6B086453"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scary Baboon OG", "keywords": [], "long_description": "Step into the role of a fearless baboon gifted with gorilla-style locomotion, trapped inside a massive, high-security laboratory deep underground. Once a place of scientific innovation, the facility has fallen into chaos after a catastrophic experiment unleashed unspeakable horrors. The sterile white walls are now stained and cracked, corridors echo with distant metallic groans, and the air hums with the unsettling sound of something moving just out of sight.\n", "short_description": "You are a baboon with gorilla-style locomotion, navigating a sprawling, dimly lit lab facility overrun with monsters. Swing, climb, and leap through crumbling corridors as you fight to survive the horrors lurking in the shadows."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/scarybaboonog/home", "developer_terms_of_service_url": null, "publisher_name": "Skidder", "support_website_url": null, "website_url": "https://sites.google.com/view/scarybaboonog/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes"
bhjb6AxgGFPDo8rukl1fWMg&oe=6A2EB31D"}, {"file_name": "Casting_Screenshot_1744112521918.png", "id": "630863499940728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393333_630863503274061_2327575283444424403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aOnrRkS2goQ7kNvwGc7CYg&_nc_oc=AdpgJSwNU4iJuu5dSRRO_JT9IdiVotgfZbtuVaCPab78Pt4hbpE0fsbe_VsDT_o2ZlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88Y0Ih0vQ4SDBA45eK1R6RruRE3ockQg4XyAtA1mV8lw&oe=6A2EB3B1"}, {"file_name": "Casting_Screenshot_1744112515001.png", "id": "1393872421612876", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393406_1393872424946209_7338149688487313331_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IVH66F81OEQ7kNvwHNN7OI&_nc_oc=AdqV4r4g-hgYGeHw47J9s9RLXWV4j0ax53ZP6ZiZ9MwI3HhVxB1lhouK-IxO8N-xTAw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o9TNCBZBYJTp5Ih_dw0_z4Q8sFNdWc7QT_dtWy2a_bg&oe=6A2EACE4"}, {"file_name": "Casting_Screenshot_1744112515555.png", "id": "1841492976699743", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393455_1841492983366409_2958677365502610883_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQqHeyUTXvsQ7kNvwEHr0vL&_nc_oc=AdpjmKjwklsgG06slDX1iKHEYQ8Q4ArBfyk61vDyrKohRNsUPmFr1jpPs946gKxhwYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99HQJwgSxD5BMoRCH6-7N2dPSu4rs9YhEflpNeY4zZoA&oe=6A2ECAFE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (15).png", "id": "576712081395440", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391917_576712084728773_7901000753456495241_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWLofidgQWsQ7kNvwGt4DMV&_nc_oc=AdrrZGLnfMQi9bbedU_L1PKLeWcFlVEV6K5ynFZl4jlRZDofpY6N4NKNyGeD9HT9Aro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XMa7CPqUnzX-B16GqU0CrAwNunIA8qrv4lhM0XdpbXQ&oe=6A2EB1A6"}, "display_name": "Monster Shooter Endless Runner VR", "keywords": ["monstershooter", "vrshooter", "VR", "shooter", "action"], "long_description": "Enter the world of Monster Shooter Endless Runner VR an intense VR shooter where players must survive endless waves of dangerous creatures in a fast-paced VR action survival game. Designed for immersive gameplay on Meta Quest.\n\n This thrilling VR FPS monster shooter challenges your reflexes, aim, and survival skills.\n\nIn this endless survival VR shooter, players run through dynamic environments while battling powerful monsters and creatures that appear from every direction. Dodge attacks, aim carefully, and unleash your weapons in this exciting VR combat shooter built for players who love action FPS games and monster battle experiences.\n\nMonster Shooter VR Endless Dance Action. combines the excitement of an arcade shooter VR experience with the challenge of an endless runner survival mode. As you progress, enemies become stronger, faster, and more aggressive, turning every round into a true VR survival challenge.\n\nWhether you enjoy VR monster hunting, wave-based survival games, or fast-paced VR shooting action,\n\n this game delivers nonstop excitement and intense gameplay.\n\n\nKey Features\n\n\u2022 Endless monster survival battles\n\u2022 Fast-paced VR shooter gameplay designed for Meta Quest\n\u2022 Immersive FPS action combat in virtual reality\n\u2022 Dynamic enemy waves and challenging creature battles\n\u2022 Arcade-style VR action shooter mechanics\n\u2022 Run, dodge, and survive in an  endless runner  game", "short_description": "Monster Shooter Endless Runner VR\nPrepare for waves of monsters in this fast-paced VR shooter. \nRun, dodge, and blast your way through a chaotic survival arena built for Meta Quest.\n\nMonster Shooter VR is an exclusive virtual reality designed for our users to experience the new Endless running shooting game. Run, shoot, and survive in an endless VR world filled with monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/3784613d-3a62-4d9e-8288-6839b8abd404", "developer_terms_of_service_url": null, "publisher_name": "Snowturtle games", "support_website_url": null, "website_url": "https://snowturtlegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26910546841921368"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619677_1663887671495191_5537521344551411535_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04XpG7iW4coQ7kNvwFLHhEE&_nc_oc=AdpCRnsB3mjafKThwcwI7wiy0UgGX-_XaZw6QaYTZ7MywD0LFU6Zj37V_04mjK9BbA4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eoosAKfsp2cxZkv9ah55C5jeRA8dOH1MnXfhQXIieYg&oe=6A2EC137"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monster Shooter Endless Runner VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "1592192974313489"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1744137780, "lastRevision": {"nodes": [{"id": "9515479331854722", "release_type": "SCHEDULED", 
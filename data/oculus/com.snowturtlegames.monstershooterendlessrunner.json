Casting_Screenshot_1744112521918.png", "id": "630863499940728", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393333_630863503274061_2327575283444424403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mrr2MjB3fZ4Q7kNvwFijJ74&_nc_oc=Adq54UC8VVnNzzcz1pg9auQ0XQylKVKbdhuoXcDFH104kD_rcNEXsU6c_Z5EdRGjbDA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwCt7SGE0yOSWohwA16svKkCYHZnrgRqrB5i61iptMYGQ&oe=69CFC7B1"}, {"file_name": "Casting_Screenshot_1744112515001.png", "id": "1393872421612876", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473393406_1393872424946209_7338149688487313331_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTZUyIKxaTcQ7kNvwFr0Otw&_nc_oc=AdrRch0Gc52qI8zt9Wo2turnMG_9K_x6uaX-s872_3obcT7BHGMggDFN5_Q9XUMM7Xw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpGDGiL9KKA4VrGCje5eWYXJpa4SuA2NkZur-LCgSsGw&oe=69CFC0E4"}, {"file_name": "Casting_Screenshot_1744112515555.png", "id": "1841492976699743", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393455_1841492983366409_2958677365502610883_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tAd0ILulmUQ7kNvwGfUZCz&_nc_oc=AdrC9XbvVmIu_I3j2VpTpw8cwxM0HqtAQ3yyeCc7cxIsBQG4M34IKCcGuivbzIjXcXo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyyyd0SWssPnJeUya2tO9Lr5wM-f8ToT0dDucDAMbc0gA&oe=69CFA6BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (15).png", "id": "576712081395440", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391917_576712084728773_7901000753456495241_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzDGHLK2JdoQ7kNvwF8bNhJ&_nc_oc=Adp2ZBCJeYD0BqDh4Dnk31Wj_4-8By86A_CPaY49MIAargsl0sO_vwdHwWvPEP6VOfE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzmZusTADimHEfPdRWbSBTttjLczVEruhmwl59HoWKG4w&oe=69CFC5A6"}, "display_name": "Monster Shooter Endless runner vr", "keywords": ["monstershooter", "shooter", "quest3", "MetaQuestShooter", "vrshooter"], "long_description": "Run. Gun. Survive.\nStep into the action-packed world of Monster Shooter: Endless Runner, a high-speed VR experience that puts your reflexes, aim, and endurance to the ultimate test. Armed with dual blasters, you're dropped into a monster-infested arena where the only way out... is forward.\n\nEndless Action in VR\nRun through ever-changing environments as swarms of creatures hunt you down \u2014 all in full VR immersion.\n\nFace Relentless Enemies\nFrom fast crawlers to flying nightmares, every monster type brings new challenges. Learn their patterns and blast your way to survival.\n\nSurvive longer, rack up kills, and create a new high score. Can you become the ultimate endless runner?\n\n Features:\n\n1. Fast-paced arcade gameplay \u2014 easy to pick up, hard to master.\n\n2. Endless procedurally generated runs \n3. Smooth performance on Meta Quest 3 & Quest3s.\n\nBuilt for VR players who love intensity, rhythm, and action, Monster Shooter: Endless Runner delivers pulse-pounding gameplay that never lets up.\n\nReady to run? The monsters are waiting\nThis  endless runner game will twist your brain around .\n\n", "short_description": "Monster Shooter Endless Runner is an exclusive virtual reality designed for our users to experience the new Endless running shooting game. Run, shoot, and survive in an endless VR world filled with monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/3784613d-3a62-4d9e-8288-6839b8abd404", "developer_terms_of_service_url": null, "publisher_name": "Snowturtle games", "support_website_url": null, "website_url": "https://snowturtlegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type":
Casting_Screenshot_1744112521918.png", "id": "630863499940728", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393333_630863503274061_2327575283444424403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDz7nPnQK08Q7kNvwFuhbXT&_nc_oc=Adq1x1IjR55fCw2Z4S8CltGiwn1GpAQc8ebbYXkeA2P0x2MUQoIIEbek7ykM-dcdibI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Z-CIyrHsYFP3N-pXPUrPRCVU_GsrL5IDwE1gjQaj8ag&oe=6A184A31"}, {"file_name": "Casting_Screenshot_1744112515001.png", "id": "1393872421612876", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393406_1393872424946209_7338149688487313331_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL0_PGLT0sYQ7kNvwHhLD4T&_nc_oc=AdrFHpVQ-vW-FATyNwQukw8y72pt-T9s_A7QcYp_NtAYQH75phA7MrJsEzMm3HjZuLk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nf9kdOMl4uvzAvalG5j_ym7yTsMz-triixAQ5hhmy3w&oe=6A184364"}, {"file_name": "Casting_Screenshot_1744112515555.png", "id": "1841492976699743", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393455_1841492983366409_2958677365502610883_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6ZJkHS6C04Q7kNvwHF_Es3&_nc_oc=AdpiihvQhnvnFY0La9bdFRFgyz_K56HdQ_n34X_21MGIwrogEXt2hFxb35J9hK_Mjt0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sU6Ea8742P_aRZIzqL2QlxwgP-ry-wSsD96buXICb4w&oe=6A18617E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (15).png", "id": "576712081395440", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391917_576712084728773_7901000753456495241_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtFUeHvNAZgQ7kNvwHYLSEZ&_nc_oc=AdrW8iLWanPq0_Pld89I4BQfCLhYmFOMnpOE2GRXbHJ79j0ElJtXSNaqfLZgmSFXqGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eSe6o80PzmdtQOiY0Jh5f_gke4qqoVDFiBmWnKgcQwg&oe=6A184826"}, "display_name": "Monster Shooter Endless runner vr", "keywords": ["monstershooter", "shooter", "quest3", "MetaQuestShooter", "vrshooter"], "long_description": "Run. Gun. Survive.\nStep into the action-packed world of Monster Shooter: Endless Runner, a high-speed VR experience that puts your reflexes, aim, and endurance to the ultimate test. Armed with dual blasters, you're dropped into a monster-infested arena where the only way out... is forward.\n\nEndless Action in VR\nRun through ever-changing environments as swarms of creatures hunt you down \u2014 all in full VR immersion.\n\nFace Relentless Enemies\nFrom fast crawlers to flying nightmares, every monster type brings new challenges. Learn their patterns and blast your way to survival.\n\nSurvive longer, rack up kills, and create a new high score. Can you become the ultimate endless runner?\n\n Features:\n\n1. Fast-paced arcade gameplay \u2014 easy to pick up, hard to master.\n\n2. Endless procedurally generated runs \n3. Smooth performance on Meta Quest 3 & Quest3s.\n\nBuilt for VR players who love intensity, rhythm, and action, Monster Shooter: Endless Runner delivers pulse-pounding gameplay that never lets up.\n\nReady to run? The monsters are waiting\nThis  endless runner game will twist your brain around .\n\n", "short_description": "Monster Shooter Endless Runner is an exclusive virtual reality designed for our users to experience the new Endless running shooting game. Run, shoot, and survive in an endless VR world filled with monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/3784613d-3a62-4d9e-8288-6839b8abd404", "developer_terms_of_service_url": null, "publisher_name": "Snowturtle games", "support_website_url": null, "website_url": "https://snowturtlegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type":
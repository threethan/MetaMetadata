.png", "id": "630863499940728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393333_630863503274061_2327575283444424403_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efmbbsYRoJYQ7kNvwH_fIwJ&_nc_oc=AdkoAGqNWQAbnj4VhgOINjGMC0lR51uL2tb9R1CVA6sPycefdAfga0NOqIowL7KWkYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwhlqKTAp_r1GSDu82dDbcLBrwC0VRcvwoh2noR6RLpBw&oe=69B95E31"}, {"file_name": "Casting_Screenshot_1744112515001.png", "id": "1393872421612876", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393406_1393872424946209_7338149688487313331_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGdvvTZ0eScQ7kNvwGt7uJQ&_nc_oc=Adn0eh3vtRQkEXRjFdklizHfcEJ8DjauL0Z5cKZmsHg0edJPF2rgNIoMg7FCo1tPYqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9w7YvSwV4o0DL4Dal9iQk7249mzvx-Sr2jf6bQ4tNTg&oe=69B95764"}, {"file_name": "Casting_Screenshot_1744112515555.png", "id": "1841492976699743", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393455_1841492983366409_2958677365502610883_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_xgiRNf9hQQ7kNvwEx7Vpe&_nc_oc=Adk0wq2mQ1tdSEcyM67Zb9H7DL4fylJ8fmOd03Zpvb93XtOAsoDkCY2cpbPFmHXzJQw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPgonxVHH2b1QrQ1WdVR-g2Q_dRCQLw6gbVaUCs4J2ww&oe=69B93D3E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (15).png", "id": "576712081395440", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391917_576712084728773_7901000753456495241_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKiHgf2OgWkQ7kNvwFHI9U-&_nc_oc=AdnQq-ojHgeE1MxU6bnlvIlVioj6TUZqoMWBpEY_uFUW36xcOUjLS8ruq0JxYuqPmLM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyeneyB3xgfnz1E2OMImvUcsQycYkmU6ql9d_wvLcOhVg&oe=69B95C26"}, "display_name": "Monster Shooter Endless runner vr", "keywords": ["monstershooter", "shooter", "quest3", "MetaQuestShooter", "vrshooter"], "long_description": "Run. Gun. Survive.\nStep into the action-packed world of Monster Shooter: Endless Runner, a high-speed VR experience that puts your reflexes, aim, and endurance to the ultimate test. Armed with dual blasters, you're dropped into a monster-infested arena where the only way out... is forward.\n\nEndless Action in VR\nRun through ever-changing environments as swarms of creatures hunt you down \u2014 all in full VR immersion.\n\nFace Relentless Enemies\nFrom fast crawlers to flying nightmares, every monster type brings new challenges. Learn their patterns and blast your way to survival.\n\nSurvive longer, rack up kills, and create a new high score. Can you become the ultimate endless runner?\n\n Features:\n\n1. Fast-paced arcade gameplay \u2014 easy to pick up, hard to master.\n\n2. Endless procedurally generated runs \n3. Smooth performance on Meta Quest 3 & Quest3s.\n\nBuilt for VR players who love intensity, rhythm, and action, Monster Shooter: Endless Runner delivers pulse-pounding gameplay that never lets up.\n\nReady to run? The monsters are waiting\nThis  endless runner game will twist your brain around .\n\n", "short_description": "Monster Shooter Endless Runner is an exclusive virtual reality designed for our users to experience the new Endless running shooting game. Run, shoot, and survive in an endless VR world filled with monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/3784613d-3a62-4d9e-8288-6839b8abd404", "developer_terms_of_service_url": null, "publisher_name": "Snowturtle games", "support_website_url": null, "website_url": "https://snowturtlegames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads":
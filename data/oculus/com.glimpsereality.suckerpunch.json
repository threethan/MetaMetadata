railer_thumbnail": {"file_name": "SuckerPunch_Cover_Landscape2.png", "id": "604185350586640", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75495672_604185353919973_3610203196190316007_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YpgCkAMtK24Q7kNvwGn8A3Z&_nc_oc=Adq71psq6i7yB03Hg_7Wb3WK2F1BFqBbmjXBtinwEhumItPcxB_TzGY-P4SmhTxMPx0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt2ooQr-jJ5yu605PFxRXPu_xw9jXn1u3JOohW5kK0PA&oe=6AFC782D"}, "display_name": "Sucker Punch VR", "keywords": [], "long_description": "Sucker Punch VR is a heart-pounding single and multiplayer experience! Battle your opponents in a variety of diverse arenas using an arsenal of power-ups! Punch point cubes as they come at you to send them flying back at your opponent. Unleash power-ups to overwhelm your opposition and defend your goal!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a single match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play a season and climb the league tables for trophies and ultimate glory!", "short_description": "Sucker Punch VR is a fast-paced, head-to-head, experience. Wielding a variety of powers, you'll punch, parry, and strike your way to victory by scoring cubes past your opponent while preventing cubes from getting past you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.glimpsereality.com/privacy", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192
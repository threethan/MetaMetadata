Pq5JimMDcJn9xd9yu5NqfZvm3b37BpR5A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--_5kZlgcWQ3rm6eE1GRPK50c8LiCQgnfOsKM3L0Tt5w&oe=6A4668A9"}, {"file_name": "ScreenShotsQuest_3.png", "id": "574799706906153", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984468_574799710239486_3788619864936051576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qd_sez_G8R8Q7kNvwFXso_w&_nc_oc=AdreX_6Oej8TjqqIM7Dl0z7jq-YFb4yScmR9qPsClMdCt_pP7cKXkz-ZXzdxZwcuXSE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BLVFIQmT9Jm4nFoM89QRpCZybXGt6yizBl3K_RmAovw&oe=6A4672B9"}, {"file_name": "ScreenShotsQuest_5.png", "id": "590949395274441", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035304_590949401941107_5392993543726171196_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8YbSffH1oEQ7kNvwHZzRtG&_nc_oc=Adp3Aav46xGSI8XM7WUfMh-oBBmKvCu6Sgf1FoFaKlAvWJLRjSqWSNPRP-Hmrim1x1I&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e-hdrnD4WfFY6Q9XFr-xCrJtOEB_WYlBqk6fHsJ6d1A&oe=6A465B43"}, {"file_name": "ScreenShotsQuest_6.png", "id": "854290091941881", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031481_854290095275214_7734332470451815493_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcpvlkIe3S0Q7kNvwHO4Qe8&_nc_oc=AdoE8kBwZF7wwgzTT1lkWITIpkJonSH21LSvhT_Me2sWYqaqhS011NWmg_j40gWWjDc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m1NL2bG6JJqpxyQ1Znf--kB08gGXr2zOad76XfjVV7Q&oe=6A468162"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunch_Cover_Landscape2.png", "id": "2072717382885472", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57569423_2072717386218805_1930698212690869894_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpV-py6JmUgQ7kNvwFnKvQ7&_nc_oc=AdqlK3MxpBDMjGBEuSrDC6zVv62EbMWVVJdFYioEjD_YJeQBhuKkmhBB5dxNhEReVjo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-a1C-cgnLNDKDXSm5sIgRRRmNGHBQlMCWhG8OPKiMOzg&oe=6A467124"}, "display_name": "Sucker Punch VR", "keywords": [], "long_description": "Sucker Punch VR is a heart-pounding single and multiplayer experience! Punch cubes past your opponent to score. Unleash power-ups to defend your goal or overwhelm your opposition! Level up and build your arsenal of powerful gloves and drones. Discover combinations that fit your play style. You\u2019ll need lightning fast reflexes and cunning strategy to become the ultimate Sucker Punch VR champion!\n\nNEW: Enter Arcade Mode and battle through progressively more difficult drones! Defeat each boss and push your high score up the global leaderboard!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a training match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play the new Arcade Mode or start a season and climb the leaderboards for trophies and ultimate glory!", "short_description": "Like Pong, in VR, with Superpowers!\nSucker Punch VR is a fast-paced, head-to-head punch fest! Wield an arsenal of powers to punch, parry, and strike your way to victory by scoring cubes past your opponent while preventing cubes from getting past you, easy\u2026right?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area"
EtNRYxGAGhRk_FOlCLexAKBuhoLLUbUgY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vrl3aPV1anAAxRgSUlOL4ErHjz9duwH9gTfNUzCStxw&oe=6A22D029"}, {"file_name": "ScreenShotsQuest_3.png", "id": "574799706906153", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984468_574799710239486_3788619864936051576_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6Yy7yotg2oQ7kNvwEJCUKS&_nc_oc=AdqQdZTridWw9sgtxPNlvQTi1ODEVw4vD5bDb-l9Xl4BsfHcL1jsxYDEGCyLvIhFklE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ujNiuTuocOTn-rEDklGLliuq4oz6xVc1PeFbDw0mlog&oe=6A22DA39"}, {"file_name": "ScreenShotsQuest_5.png", "id": "590949395274441", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035304_590949401941107_5392993543726171196_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbJ6b-7AF74Q7kNvwHZbkF7&_nc_oc=AdocIGfNRihycgZi1pvSb4O3L5ZS2GyZGmVE68OuQwi4TG9gEsWjLltQhUpBGxZ15Xk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NGQpVrw594fPp3K3Au44O1rVpmvWnC5tu1DgqBeDzQQ&oe=6A22FB03"}, {"file_name": "ScreenShotsQuest_6.png", "id": "854290091941881", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031481_854290095275214_7734332470451815493_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skTkI-_HTA0Q7kNvwFrm9oj&_nc_oc=AdpYHpZKFsf1hgv9ZUxFN9UlvXhNXBM9nSiD0DIckPXRE43wbtp5BplBNuHfjlqa-hs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qrVu7s94CGWMsbevltj4ynhbiJe4gBbrzpr5ooxT-AA&oe=6A22E8E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SuckerPunch_Cover_Landscape2.png", "id": "2072717382885472", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/57569423_2072717386218805_1930698212690869894_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gu-4_SUwSKkQ7kNvwEWq6iX&_nc_oc=Ado2ZEwUeFlwJN4poB3c13Gh0a05a_DHk1vPy0v_eKXQrjtU74DVEmwVTGYi3R4LKSA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wYYkZYwwSeG_1-iKkZadDzjybP3a-G6iuPGsr3W7VsQ&oe=6A22D8A4"}, "display_name": "Sucker Punch VR", "keywords": [], "long_description": "Sucker Punch VR is a heart-pounding single and multiplayer experience! Punch cubes past your opponent to score. Unleash power-ups to defend your goal or overwhelm your opposition! Level up and build your arsenal of powerful gloves and drones. Discover combinations that fit your play style. You\u2019ll need lightning fast reflexes and cunning strategy to become the ultimate Sucker Punch VR champion!\n\nNEW: Enter Arcade Mode and battle through progressively more difficult drones! Defeat each boss and push your high score up the global leaderboard!\n\nUNLEASH YOUR POWERS - YOUR WAY\nGain access to an arsenal of gloves and equipment, each with their own powers. Mix and match to find your perfect playing style.\n\nSINGLE AND MULTIPLAYER\nPlay a training match versus AI, or grab a friend and go head-to-head via multiplayer. Need a bigger challenge? Play the new Arcade Mode or start a season and climb the leaderboards for trophies and ultimate glory!", "short_description": "Like Pong, in VR, with Superpowers!\nSucker Punch VR is a fast-paced, head-to-head punch fest! Wield an arsenal of powers to punch, parry, and strike your way to victory by scoring cubes past your opponent while preventing cubes from getting past you, easy\u2026right?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.suckerpunchvr.com/eula", "developer_terms_of_service_url": "https://www.suckerpunchvr.com/eula", "publisher_name": "AR Glimpse, LLC", "support_website_url": null, "website_url": "https://www.suckerpunchvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area"
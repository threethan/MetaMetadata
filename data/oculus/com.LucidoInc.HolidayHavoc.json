u54TcMjHSlcQ7kNvwF74nye&_nc_oc=AdrSWdDUK2rrjVVgbEis8xey9yVziisfXiC8AJhvISqCn_AbnhYQdhXQJExIQQ5xHX4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX3PgUz04VwJdVuJDbjiDBfBVnvoclXbCnozn9MXRP6YA&oe=6B0F0215"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Holiday Havoc: Grinch Takedown", "keywords": ["action"], "long_description": "Welcome to Holiday Havoc \u2014 where Christmas collides with pure, snow-fueled chaos! Step into a virtual winter wonderland under siege by grumpy grinches, rogue snowmen, and toy-hacking troublemakers. In this fast-paced, hypercasual VR shooter, you\u2019re armed with holiday blasters, wrapped in festive madness, and tasked with restoring joy one snowball at a time.\n\nWhether you're ducking behind candy cane barricades or unloading foam darts at sneaky green villains, Holiday Havoc delivers a fun, family-friendly frenzy packed with mischief, mayhem, and merry destruction. It\u2019s the season of giving... and this time, you're giving them havoc.\n\nReady. Aim. Sleigh. \ud83c\udf84\ud83d\udca5", "short_description": "Holiday Havoc is a chaotic Christmas-themed VR shooter where mischief takes center stage \u2014 battle mischievous grinches, dodge snowball ambushes, and save the holidays with a blast of festive firepower."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucido.life/policy/holidayhavoc/", "developer_terms_of_service_url": null, "publisher_name": "Lucido Inc.", "support_website_url": null, "website_url": "https://lucido.life/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor":
=1-7&_nc_sid=6e7a0a&_nc_ohc=BZJdMtWd6dgQ7kNvwFWDgMo&_nc_oc=AdqbIDmm5Yd0r3AIhSbHelZacFuBFAbBR1vfcpxap2OURlafm2vBN0SRsJluHT32cJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQekPaozGj7a76_rlRTFlKjmG1qcnYgIDEBvLVwr4C6ag&oe=6AEB46E0"}, {"file_name": "Custom-Store-Screenshot-03.png", "id": "709270217942401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314851_709270221275734_1982130182265092284_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pcqv6eBFKDUQ7kNvwGYOIVe&_nc_oc=AdqJA_dEMJT2sApDyB_2VjwuUJ0fKGanLRLi932dbSQUsmX4eo86kCXipLn7f6wRlog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTksZdwGbAL01NEqH_ySHlXvmQSbUB47ktjiHA-hI9dRA&oe=6AEB4632"}, {"file_name": "Custom-Store-Screenshot-04.png", "id": "403575322072482", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_403575325405815_9104765126091360528_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaVA5FwYna0Q7kNvwEp3l-o&_nc_oc=AdooHVIiwhJN3eVB2eGo9ymUR0m8zkwHxDqET241snw2zIqllu-H0weEun0rTjhHtvc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNKRNIqQqZ0GdPo9XnaQUE3DH0gio1XaJatixKDOYPOA&oe=6AEB5D09"}, {"file_name": "Custom-Store-Screenshot-05.png", "id": "2157483627958701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566687_2157483631292034_5004514168971620959_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBoJze0Ye6IQ7kNvwGTJttE&_nc_oc=AdrcY98DZQ5KvO9h6l1zcHBfeEYb01CKiSUfZtJ_jrwT429bNaKzv71ZFSCE60TFMyQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW9W3f9Z_DMEIfSLvgx6ccCImPVHAclGcfWEZ1NDmOeQ&oe=6AEB55FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Biology Dissection Lab", "keywords": [], "long_description": "Welcome to Xennial\u2019s Virtual Reality (VR) Dissection Lab, designed for Middle and High School Biology programs. This innovative learning experience eliminates the need for physical specimens. The VR Dissection Lab includes the following specimens: Worm, Clam, Crayfish, Fish, and Frog.\n\nThe guided experiences allow students to master incisions and understand external and internal anatomy. An interactive gallery lets students review each specimen's anatomy before proceeding to the dissection. They are able to master the use of virtual tools like scissors, forceps, and a scalpel to dissect organisms.\n\nXennial\u2019s VR Dissection Lab also addresses logistical challenges, making high-quality education accessible by removing resource, storage, and cost barriers.\n\nThe VR Lab extends learning beyond the classroom, enabling students to access it anywhere, promoting independent and unlimited practice and study. Xennial\u2019s VR Dissection Lab is a transformative tool, providing a comprehensive, interactive alternative to traditional methods. Future plans include enhancing the VR Lab with full hand-tracking capabilities for more seamless use and adoption.", "short_description": "Xennial's VR Dissection Lab redefines education for Middle and High School Biology Programs by seamlessly blending traditional dissections with Virtual Reality. It features dissections of the following specimens: Worm, Clam, Crayfish, Fish, and Frog. This guided experience allows students to master incisions, as well as understand external and internal anatomy. The interactive gallery ensures a comprehensive understanding before performing the dissections. Xennial's VR Dissection Lab transforms "}]}, "developer_name": "Xennial Digital", "developer_privacy_policy_url": "https://xennialdigital.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Xennial Digital", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
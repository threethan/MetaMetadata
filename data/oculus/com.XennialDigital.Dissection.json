=1-7&_nc_sid=6e7a0a&_nc_ohc=Zzuj6EbKDs8Q7kNvwHXoluC&_nc_oc=AdoVLHZpIURQqaZAHwO9tUx6gupVzIF6e-aO2beT22DLqTqHFuOcAvisl6tfoHxIvFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwd7vKWJ27LtEBvRu7Yv25wvsiKyfOB3mfrL6jv2HVXQ&oe=6ABA7F60"}, {"file_name": "Custom-Store-Screenshot-03.png", "id": "709270217942401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75314851_709270221275734_1982130182265092284_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV9ElpZIhvgQ7kNvwEDKFIr&_nc_oc=AdpBE_CO2KesWBnKG8tDhctVUN4AutEhJuWk7Z1BVrJi70Ij605dOiri_bHx-b4ffCI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnSurMkkd6LNQPvgdKGrhKTgxrblEmEAGslK0kLl0pHg&oe=6ABA7EB2"}, {"file_name": "Custom-Store-Screenshot-04.png", "id": "403575322072482", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974637_403575325405815_9104765126091360528_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AhEh7cnT5LgQ7kNvwF-vNQT&_nc_oc=AdoV_40lqyidDooUANjkPCRpg1nGZ2J3zSslj2_AypgMg_abK8l-7QP_QNumS0M1iWo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxKeFTK8sL7t923TM0sbsgk813ilnjT_DMEHCYZF_69g&oe=6ABA5D49"}, {"file_name": "Custom-Store-Screenshot-05.png", "id": "2157483627958701", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566687_2157483631292034_5004514168971620959_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSheg2wN4lAQ7kNvwH5-f7-&_nc_oc=AdpbyH4QMw7f3JMHr1QjloI0KP65eg5_CNzhOTjlGEy7zQ-2ijrRx13lSh6l5RcMBBk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaAFsdycjzxuCHlRBI8PKPklS29_3KPCU0OsMid6O3mA&oe=6ABA8E7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Biology Dissection Lab", "keywords": [], "long_description": "Welcome to Xennial\u2019s Virtual Reality (VR) Dissection Lab, designed for Middle and High School Biology programs. This innovative learning experience eliminates the need for physical specimens. The VR Dissection Lab includes the following specimens: Worm, Clam, Crayfish, Fish, and Frog.\n\nThe guided experiences allow students to master incisions and understand external and internal anatomy. An interactive gallery lets students review each specimen's anatomy before proceeding to the dissection. They are able to master the use of virtual tools like scissors, forceps, and a scalpel to dissect organisms.\n\nXennial\u2019s VR Dissection Lab also addresses logistical challenges, making high-quality education accessible by removing resource, storage, and cost barriers.\n\nThe VR Lab extends learning beyond the classroom, enabling students to access it anywhere, promoting independent and unlimited practice and study. Xennial\u2019s VR Dissection Lab is a transformative tool, providing a comprehensive, interactive alternative to traditional methods. Future plans include enhancing the VR Lab with full hand-tracking capabilities for more seamless use and adoption.", "short_description": "Xennial's VR Dissection Lab redefines education for Middle and High School Biology Programs by seamlessly blending traditional dissections with Virtual Reality. It features dissections of the following specimens: Worm, Clam, Crayfish, Fish, and Frog. This guided experience allows students to master incisions, as well as understand external and internal anatomy. The interactive gallery ensures a comprehensive understanding before performing the dissections. Xennial's VR Dissection Lab transforms "}]}, "developer_name": "Xennial Digital", "developer_privacy_policy_url": "https://xennialdigital.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Xennial Digital", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
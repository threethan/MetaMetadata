=1-7&_nc_sid=6e7a0a&_nc_ohc=N8fLauNTFXoQ7kNvwEtNd-C&_nc_oc=AdqgExBhPyzS3AxHzXDoOL01KjOrQg3YQk_npSgZACMh0zOtskPITQTL_QrOIeiG3g0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJybNYGM2sLuuWQcEqA7emwFpIfHSo0wwwoMiB9xtfjmA&oe=6AB92DE0"}, {"file_name": "Custom-Store-Screenshot-03.png", "id": "709270217942401", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75314851_709270221275734_1982130182265092284_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JV9ElpZIhvgQ7kNvwG0LFAm&_nc_oc=AdoT2uiLMel56rGUxMEbN-M-GbMGOmHC_qK3EfQYoHAjY6lEYdZaG0QF3__NFyjgG3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaBITOZZy0zAEAjHuEObtnMoA-anlu-e4LdATrQ-tBLQ&oe=6AB92D32"}, {"file_name": "Custom-Store-Screenshot-04.png", "id": "403575322072482", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974637_403575325405815_9104765126091360528_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nv_pnAwxlaYQ7kNvwH3SiDx&_nc_oc=AdoanELQteLVkUopJ4VpGN6kmqb51hWymqym1xG8dZEH3bmAhMCvJ9nk_MaHfE7XeCY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPhOPU22amGIHDgDv9plwZth34vZa8Now3q1CJ6uj_tQ&oe=6AB90BC9"}, {"file_name": "Custom-Store-Screenshot-05.png", "id": "2157483627958701", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566687_2157483631292034_5004514168971620959_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSheg2wN4lAQ7kNvwFxjiSt&_nc_oc=Adp7FMN5HjZ9-8pJJmoFxKmjrvIywzPUG38CqRWcOa6QwkOCjdcTvuezkUFMtw1Zz6g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd3SZM7AZkPL6k-vHNXAfOTwGOZ6cG8ALSNC6RNF1oPA&oe=6AB93CFC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Biology Dissection Lab", "keywords": [], "long_description": "Welcome to Xennial\u2019s Virtual Reality (VR) Dissection Lab, designed for Middle and High School Biology programs. This innovative learning experience eliminates the need for physical specimens. The VR Dissection Lab includes the following specimens: Worm, Clam, Crayfish, Fish, and Frog.\n\nThe guided experiences allow students to master incisions and understand external and internal anatomy. An interactive gallery lets students review each specimen's anatomy before proceeding to the dissection. They are able to master the use of virtual tools like scissors, forceps, and a scalpel to dissect organisms.\n\nXennial\u2019s VR Dissection Lab also addresses logistical challenges, making high-quality education accessible by removing resource, storage, and cost barriers.\n\nThe VR Lab extends learning beyond the classroom, enabling students to access it anywhere, promoting independent and unlimited practice and study. Xennial\u2019s VR Dissection Lab is a transformative tool, providing a comprehensive, interactive alternative to traditional methods. Future plans include enhancing the VR Lab with full hand-tracking capabilities for more seamless use and adoption.", "short_description": "Xennial's VR Dissection Lab redefines education for Middle and High School Biology Programs by seamlessly blending traditional dissections with Virtual Reality. It features dissections of the following specimens: Worm, Clam, Crayfish, Fish, and Frog. This guided experience allows students to master incisions, as well as understand external and internal anatomy. The interactive gallery ensures a comprehensive understanding before performing the dissections. Xennial's VR Dissection Lab transforms "}]}, "developer_name": "Xennial Digital", "developer_privacy_policy_url": "https://xennialdigital.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Xennial Digital", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
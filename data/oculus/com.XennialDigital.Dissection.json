=1-7&_nc_sid=6e7a0a&_nc_ohc=JAGeRPeFC0QQ7kNvwGzTWur&_nc_oc=AdoQavlywPji2whHPtaqYedt-5z_9N_genTXE2sg2YZrP0ZN3Jwu_kuruRt5Ger8T-Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fbfS2tZNyjChgGTGoeKu492fWZzN_6ZWznYqPV3GuWg&oe=69EE26E0"}, {"file_name": "Custom-Store-Screenshot-03.png", "id": "709270217942401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75314851_709270221275734_1982130182265092284_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KsBPELO5WYQ7kNvwF6cFdY&_nc_oc=AdoiK4q0preFGa8COvxMsU2YGNMzdyv7GWJbixk__JeJNDSMDHjbhfIeBB70o7iQdQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jxTTa55kJ_xs0NFnBl1CxBNk70nA63-a_-KARQgZTdg&oe=69EE2632"}, {"file_name": "Custom-Store-Screenshot-04.png", "id": "403575322072482", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974637_403575325405815_9104765126091360528_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0P7hNJduI7cQ7kNvwHwfZ9c&_nc_oc=AdpKB-DJ6QVWgzbChLZKOE-Bn8FJFypam5DuIuiuqxg2aypIFmgtwBl8E6YiMxIGXw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kJ0xWj7uPFejfzyT1_pdas9MYo_VtGW4X-YQtdOuJig&oe=69EE04C9"}, {"file_name": "Custom-Store-Screenshot-05.png", "id": "2157483627958701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57566687_2157483631292034_5004514168971620959_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYgyo5vIlRQQ7kNvwFCMhOA&_nc_oc=AdqWWG-katRSwr9Nw1UoE9F8WQWM5JLzYUR9BxCcPud8braOKPEKavTuW8AZKme9R-E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xQQvP_9QM-6gsnfjrxqbF8HaGaMt39UEeY1kNg6r8zA&oe=69EDFDBC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Biology Dissection Lab", "keywords": [], "long_description": "Welcome to Xennial\u2019s Virtual Reality (VR) Dissection Lab, designed for Middle and High School Biology programs. This innovative learning experience eliminates the need for physical specimens. The VR Dissection Lab includes the following specimens: Worm, Clam, Crayfish, Fish, and Frog.\n\nThe guided experiences allow students to master incisions and understand external and internal anatomy. An interactive gallery lets students review each specimen's anatomy before proceeding to the dissection. They are able to master the use of virtual tools like scissors, forceps, and a scalpel to dissect organisms.\n\nXennial\u2019s VR Dissection Lab also addresses logistical challenges, making high-quality education accessible by removing resource, storage, and cost barriers.\n\nThe VR Lab extends learning beyond the classroom, enabling students to access it anywhere, promoting independent and unlimited practice and study. Xennial\u2019s VR Dissection Lab is a transformative tool, providing a comprehensive, interactive alternative to traditional methods. Future plans include enhancing the VR Lab with full hand-tracking capabilities for more seamless use and adoption.", "short_description": "Xennial's VR Dissection Lab redefines education for Middle and High School Biology Programs by seamlessly blending traditional dissections with Virtual Reality. It features dissections of the following specimens: Worm, Clam, Crayfish, Fish, and Frog. This guided experience allows students to master incisions, as well as understand external and internal anatomy. The interactive gallery ensures a comprehensive understanding before performing the dissections. Xennial's VR Dissection Lab transforms "}]}, "developer_name": "Xennial Digital", "developer_privacy_policy_url": "https://xennialdigital.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Xennial Digital", "support_website_url": null, "website_url": "https://www.xennialdigital.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "
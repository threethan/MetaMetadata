A"}, {"file_name": "2.png", "id": "285246717932861", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86627654_285246721266194_2575969446918668996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T93uNd8b2XIQ7kNvwFl8j3L&_nc_oc=AdrUvanRHEiMgmWLXzn2_Uzc0D5T8_QBp34Mrm-PWt1f3MUsyuOGu1e0N0yi7wt3kW4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LdV0qcyZnFBKX3QPNDIeoVh5mEODg11ntpVuhm8yCYw&oe=69E78B4C"}, {"file_name": "3.png", "id": "436292478867404", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982603_436292482200737_3040556094683052284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TvMgURaXaUQ7kNvwHsdfQj&_nc_oc=AdpYsZjZyUOLd-HLxxd1w8oHfa1IGpz-yVaqZHmfDQchPvUBNTRdqlYLJTiMs8g8HG4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00u9HzGwzTKr5ZMaJ5did6NAZioQAHI6MSLQ0_6IsYZg&oe=69E79127"}, {"file_name": "4.png", "id": "1527536304642649", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031429_1527536307975982_8067806095485934547_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnk7XS9U-E8Q7kNvwG6mYai&_nc_oc=Ado2YXAwtqE1DTxNCrU5d1cXtuZ8muTD_cIkUxB31wrdKmzYo1n2VVUuJTQGcel41lM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3g6TKUIk9fC700ErLRgxMy1ltPMT3aaEt4cJEGQiKWIw&oe=69E78484"}, {"file_name": "5.png", "id": "368211236050734", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230049_368211239384067_4433699725196166729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gemAY0xzrXkQ7kNvwEbCstk&_nc_oc=AdpZgaZP_XS_5hOqUlZgE70jutNPtvXxbeg_vvbe4PwmDRYL3r3nntwdL_ZtPeI1QPc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Gei5TnanGx7om3X970AzQYkIrhetspJReB-e9Mt-QHw&oe=69E76195"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PGVR_Trailer Cover Image_2560x1440.png", "id": "889830889410023", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974794_889830892743356_5440725574582926712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f5GWVj0AKyQQ7kNvwG7pRWp&_nc_oc=AdrTxGMgVtnUStZSRic9DAXcS1a3VN6bU2RkFHQ3JuWC5u4mdvSLvxDeIB1cn5bW4DA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2f7pWR2W5N8rwS-5xRpGrU_bzf9Y3VDfv-7n1l1DivJA&oe=69E759C6"}, "display_name": "Programmer VR", "keywords": ["ProgrammingInVR", "VirtualRealityProgramming", "VRProgramming", "LearnProgrammingInVR", "SolvePuzzlesInVR"], "long_description": "Want to learn programming and develop problem-solving skills in a fun way?\n\nSet off on an exciting journey with \"Programmer VR,\" a first-of-a-kind VR game on the Meta Store.\n\nYour mission? Help Bob navigate a virtual world, overcome obstacles and improve intelligence level.\n\nWith each challenge you conquer, you\u2019ll learn programming concepts like Instructions execution order, conditional statements, loops, arrays and much more. Boost your problem-solving skills and logical thinking - all while you play a fun game.\n\nBrought to you by the creators of iB Cricket, one of the highest-rated VR games.\n\nNo prior programming knowledge is required.\n\nKey Features:\n\nCampaign Mode: 75 puzzles across 3 difficulty levels. Challenge yourself!\n\nMultiplayer Mode:  Race against an opponent in PvP battles or collaborate with a friend to master challenges.\nEnhanced with voice chat and personalized Meta avatars, you can truly connect with players.\n\nDaily Challenges: Complete a new challenge everyday and top the global leaderboard.\n\nAchievements: Celebrate your learning accomplishments, track your leaderboard standings.\n\nLevel up your experience\u2026\n\nMR Mode: With the power of Mixed Reality, Set your puzzle anywhere in your room and move freely in the real world to get an excellent view.\n\nHand Tracking: Interact seamlessly with the virtual world using your hands, making your experience even more lifelike.\n\nProgrammer VR is your ticket to programming fun. Get started now and unlock your potential!", "short_description": "A first-of-a-kind fun game on the Meta Store to help you learn programming & develop problem-solving skills. \n\nYour mission? Help Bob navigate a virtual world, overcome obstacles & improve intelligence level. \n\nWith each puzzle, learn programming concepts like Instructions execution order, conditional statements, loops -- all while you play a fun game. \n\nWith exciting features like Multiplayer Mode, Daily Challenges, enhanced with MR Mode and Hand Tracking, learning is now a thrilling adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proyuga.tech/programmer-vr-privacy-policy/", "developer_terms_of_service_url": "https://proyuga.tech/programmer-vr-eula/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/ProgrammerVR_Support", "website_url": "https://proyuga.tech/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "6692918594141670"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036653_659017516443940_5413992496550596175_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmGEJhrS5R0Q7kNvwFG0iJc&_nc_oc=AdpykcFHWhnV3_RxN2IKvfzfeay-KaZ7Jflc6tonf2XpDOIAodUuiVC8eT7sCad3JQ0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss
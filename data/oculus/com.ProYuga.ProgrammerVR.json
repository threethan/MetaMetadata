A"}, {"file_name": "2.png", "id": "285246717932861", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86627654_285246721266194_2575969446918668996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdcmCkhzNE8Q7kNvwEprcAu&_nc_oc=AdprVqHOCgSN0hxCQfPODK7tR9eV4pqo6dLUUmEGP03MhAv03JEoaPPgNrEQdk1pEpk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNBuEJT0JvDH0_Qks4ayW1Lp93tlfERuisss4QX3iybg&oe=69C2A14C"}, {"file_name": "3.png", "id": "436292478867404", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982603_436292482200737_3040556094683052284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpsydtMfKAkQ7kNvwGGK4rZ&_nc_oc=AdqLluKOP5hBd7BeTVeJc6ge7TQzZy9n8PaWXhb_Zpnalju4us8oRZqsOK-gMDD3ifY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzB0s4SNTSTuCzbHcG1T3V-Cl97Op9xojnk7tgbmPI3tQ&oe=69C26EE7"}, {"file_name": "4.png", "id": "1527536304642649", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031429_1527536307975982_8067806095485934547_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8o-Yr77Fd8Q7kNvwHfQ_Ni&_nc_oc=AdocapaatMWlfXLa1y_uXFXuwfxfUwqf5N7NyUVHUuWWBaiva6-Q45fOfVefRAcuaUU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXq899eXk0dAatolHb7AAoBc7UPaQjRSLHK6QIZS75KA&oe=69C29A84"}, {"file_name": "5.png", "id": "368211236050734", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75230049_368211239384067_4433699725196166729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omiIvjlO-8cQ7kNvwHQOm6i&_nc_oc=AdqR5Z9WX8YW6jkTBNK5a2tPsOIaupg6aTz1qu6e_joZVhecG85cHWpODrYSS-YBD0c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxuGXnFrfSe2cEqHf_m4XmxFGTEo1j6Jjn5dkVmwa2v8Q&oe=69C27795"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PGVR_Trailer Cover Image_2560x1440.png", "id": "889830889410023", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974794_889830892743356_5440725574582926712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg5LGO2IWNoQ7kNvwFi3XtC&_nc_oc=Adr31KkA4TjXIlzmkpLJ6IZdvKLo6MCLxFg7vCeu1l9JgOLeLytrWyA9IyZawsJE-xI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxwiR1RQTWh3OAC7F4hVLge27QFNmUZzvjUNmz8A_AQZQ&oe=69C26FC6"}, "display_name": "Programmer VR", "keywords": ["ProgrammingInVR", "VirtualRealityProgramming", "VRProgramming", "LearnProgrammingInVR", "SolvePuzzlesInVR"], "long_description": "Want to learn programming and develop problem-solving skills in a fun way?\n\nSet off on an exciting journey with \"Programmer VR,\" a first-of-a-kind VR game on the Meta Store.\n\nYour mission? Help Bob navigate a virtual world, overcome obstacles and improve intelligence level.\n\nWith each challenge you conquer, you\u2019ll learn programming concepts like Instructions execution order, conditional statements, loops, arrays and much more. Boost your problem-solving skills and logical thinking - all while you play a fun game.\n\nBrought to you by the creators of iB Cricket, one of the highest-rated VR games.\n\nNo prior programming knowledge is required.\n\nKey Features:\n\nCampaign Mode: 75 puzzles across 3 difficulty levels. Challenge yourself!\n\nMultiplayer Mode:  Race against an opponent in PvP battles or collaborate with a friend to master challenges.\nEnhanced with voice chat and personalized Meta avatars, you can truly connect with players.\n\nDaily Challenges: Complete a new challenge everyday and top the global leaderboard.\n\nAchievements: Celebrate your learning accomplishments, track your leaderboard standings.\n\nLevel up your experience\u2026\n\nMR Mode: With the power of Mixed Reality, Set your puzzle anywhere in your room and move freely in the real world to get an excellent view.\n\nHand Tracking: Interact seamlessly with the virtual world using your hands, making your experience even more lifelike.\n\nProgrammer VR is your ticket to programming fun. Get started now and unlock your potential!", "short_description": "A first-of-a-kind fun game on the Meta Store to help you learn programming & develop problem-solving skills. \n\nYour mission? Help Bob navigate a virtual world, overcome obstacles & improve intelligence level. \n\nWith each puzzle, learn programming concepts like Instructions execution order, conditional statements, loops -- all while you play a fun game. \n\nWith exciting features like Multiplayer Mode, Daily Challenges, enhanced with MR Mode and Hand Tracking, learning is now a thrilling adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proyuga.tech/programmer-vr-privacy-policy/", "developer_terms_of_service_url": "https://proyuga.tech/programmer-vr-eula/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/ProgrammerVR_Support", "website_url": "https://proyuga.tech/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "6692918594141670"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39036653_659017516443940_5413992496550596175_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=duf4M8In1NEQ7kNvwGnfjp0&_nc_oc=AdphyT0EfXpqim1WazqAGLFwBATQ7iZWdpj9bq75IH-nvXUf73kENt7RN_wbIfnt3Bc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss
A"}, {"file_name": "2.png", "id": "285246717932861", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86627654_285246721266194_2575969446918668996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEvn0bdaIIkQ7kNvwGsXzlW&_nc_oc=AdqBVLn9NeoyCueYwQoXE2shA7O0Od3NmPP5WxN-FiQqNQnpWgFo_ADiKrekIAL05RI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JYB0EKTWeBpcUQuXPQjspT_aLY-Sfc5LSdMxwIRpkRQ&oe=6A048C4C"}, {"file_name": "3.png", "id": "436292478867404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982603_436292482200737_3040556094683052284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jGQnN9DkpYQ7kNvwGoAryM&_nc_oc=AdpCX9Tge1_tXk5Eju508N9XdKvt-T6o7UUD10dcq1h7ibOAov-9BGnNyBW-o6h-SSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e-WeXnyHShQZxzzEhRbt7hzF77ApyxlXzqrhGuyGR9A&oe=6A049227"}, {"file_name": "4.png", "id": "1527536304642649", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031429_1527536307975982_8067806095485934547_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVZzr395yqwQ7kNvwH6tgP9&_nc_oc=Adp33Vsvt9MnDn5WI2KydRDdab9x7z6IaDw1fkbEpwRzffEMRddTv4ysw17DHkYowvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mIZQUKbwkr3jCxX2926U34JF7qlwSo4JIDeyCtCiCmg&oe=6A048584"}, {"file_name": "5.png", "id": "368211236050734", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75230049_368211239384067_4433699725196166729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZWAaOIch4sQ7kNvwHmCaWc&_nc_oc=Adp3X9rNA2_SddxtYV21i6Ct9WwGtce_iWgwkuKRh96Z2VDJbziSQURzCSjnF95MLXs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b53xbN9P-ZoEHA7aft252LDHRrv2EMLPM5Qih8nxHMQ&oe=6A049AD5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PGVR_Trailer Cover Image_2560x1440.png", "id": "889830889410023", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974794_889830892743356_5440725574582926712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ExP8lzxSveAQ7kNvwGbkhj4&_nc_oc=Ado5rjNVc65f4B0derT2U-OP8zcQ75tlHlnNbh885-CjAWqa8AP_gh0abpvHvoiWgRI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K3mC3_fXyaEW2jiWZ2TzOCR9DsH_Ut9zCOUoAGILHoA&oe=6A049306"}, "display_name": "Programmer VR", "keywords": ["ProgrammingInVR", "VirtualRealityProgramming", "VRProgramming", "LearnProgrammingInVR", "SolvePuzzlesInVR"], "long_description": "Want to learn programming and develop problem-solving skills in a fun way?\n\nSet off on an exciting journey with \"Programmer VR,\" a first-of-a-kind VR game on the Meta Store.\n\nYour mission? Help Bob navigate a virtual world, overcome obstacles and improve intelligence level.\n\nWith each challenge you conquer, you\u2019ll learn programming concepts like Instructions execution order, conditional statements, loops, arrays and much more. Boost your problem-solving skills and logical thinking - all while you play a fun game.\n\nBrought to you by the creators of iB Cricket, one of the highest-rated VR games.\n\nNo prior programming knowledge is required.\n\nKey Features:\n\nCampaign Mode: 75 puzzles across 3 difficulty levels. Challenge yourself!\n\nMultiplayer Mode:  Race against an opponent in PvP battles or collaborate with a friend to master challenges.\nEnhanced with voice chat and personalized Meta avatars, you can truly connect with players.\n\nDaily Challenges: Complete a new challenge everyday and top the global leaderboard.\n\nAchievements: Celebrate your learning accomplishments, track your leaderboard standings.\n\nLevel up your experience\u2026\n\nMR Mode: With the power of Mixed Reality, Set your puzzle anywhere in your room and move freely in the real world to get an excellent view.\n\nHand Tracking: Interact seamlessly with the virtual world using your hands, making your experience even more lifelike.\n\nProgrammer VR is your ticket to programming fun. Get started now and unlock your potential!", "short_description": "A first-of-a-kind fun game on the Meta Store to help you learn programming & develop problem-solving skills. \n\nYour mission? Help Bob navigate a virtual world, overcome obstacles & improve intelligence level. \n\nWith each puzzle, learn programming concepts like Instructions execution order, conditional statements, loops -- all while you play a fun game. \n\nWith exciting features like Multiplayer Mode, Daily Challenges, enhanced with MR Mode and Hand Tracking, learning is now a thrilling adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proyuga.tech/programmer-vr-privacy-policy/", "developer_terms_of_service_url": "https://proyuga.tech/programmer-vr-eula/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/ProgrammerVR_Support", "website_url": "https://proyuga.tech/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "6692918594141670"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036653_659017516443940_5413992496550596175_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyTtkiJQk64Q7kNvwEc4ZJ4&_nc_oc=AdqTe7pxGfJfF4RwcdCDj1pOGrb3xx6_MtpF48G1Xqw-BsfbnpEpZeMIvn1FobuouOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss
A"}, {"file_name": "2.png", "id": "285246717932861", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86627654_285246721266194_2575969446918668996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxneR_XnV5AQ7kNvwHNpPz8&_nc_oc=Adph_PryKtGPYjEA_rJhbFeDR9mgynsqZbAgVUMC8PP7EWwR7kX_QmTlKRODthbewdk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxynucGcLwtaCoZZ8kUIzOJrOeipnovfCOpoePK_8hbiQ&oe=69C7E74C"}, {"file_name": "3.png", "id": "436292478867404", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982603_436292482200737_3040556094683052284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1Zt9kjGa8wQ7kNvwHo__uU&_nc_oc=Adob9STreQbalAnR6-GGcS2SrezO2wdx6kZSHevos6mbQGcYUIJqqIFnqxquyvqXK44&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcEbipoGuOyMWNU-YB827l-ZzuRNgxasRX4vDw9Dl9hw&oe=69C7B4E7"}, {"file_name": "4.png", "id": "1527536304642649", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031429_1527536307975982_8067806095485934547_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1HiMh-6k2_kQ7kNvwFasRUa&_nc_oc=AdokZsHSXJh95YVQx5QAAdvOH9NwrUIUmwh_JdTu1cTV1p67bGPU1nh1KuUjzlAuzWU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3SFtoiDXD7DW_RARknomQbMAww8bqFfGXj2zoV5FTow&oe=69C7E084"}, {"file_name": "5.png", "id": "368211236050734", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75230049_368211239384067_4433699725196166729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vy-f79CAu34Q7kNvwGJLpzq&_nc_oc=AdqP-CaPHkLBxY35FIUU0qAybNZvn9aEcr8C9q2_Y3dzojQuMirzlfON2ygDkoKAwpU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvOxH4QmkrIyYMg8cpxBFP3upL9rZ3TtgsOdG14ch_Jg&oe=69C7BD95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PGVR_Trailer Cover Image_2560x1440.png", "id": "889830889410023", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974794_889830892743356_5440725574582926712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk49e-3jz6MQ7kNvwFX-wyd&_nc_oc=AdoUXbDTGcEM5nxajzKcyqpXHHURo-Cu6a8LjvrkDEz1lByRXeYbdLMxwW8VjUdaJUk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzgL4uSLjrZH0ebpWtVNCZHFYZ9Uquaib73fTGEbzdHcA&oe=69C7B5C6"}, "display_name": "Programmer VR", "keywords": ["ProgrammingInVR", "VirtualRealityProgramming", "VRProgramming", "LearnProgrammingInVR", "SolvePuzzlesInVR"], "long_description": "Want to learn programming and develop problem-solving skills in a fun way?\n\nSet off on an exciting journey with \"Programmer VR,\" a first-of-a-kind VR game on the Meta Store.\n\nYour mission? Help Bob navigate a virtual world, overcome obstacles and improve intelligence level.\n\nWith each challenge you conquer, you\u2019ll learn programming concepts like Instructions execution order, conditional statements, loops, arrays and much more. Boost your problem-solving skills and logical thinking - all while you play a fun game.\n\nBrought to you by the creators of iB Cricket, one of the highest-rated VR games.\n\nNo prior programming knowledge is required.\n\nKey Features:\n\nCampaign Mode: 75 puzzles across 3 difficulty levels. Challenge yourself!\n\nMultiplayer Mode:  Race against an opponent in PvP battles or collaborate with a friend to master challenges.\nEnhanced with voice chat and personalized Meta avatars, you can truly connect with players.\n\nDaily Challenges: Complete a new challenge everyday and top the global leaderboard.\n\nAchievements: Celebrate your learning accomplishments, track your leaderboard standings.\n\nLevel up your experience\u2026\n\nMR Mode: With the power of Mixed Reality, Set your puzzle anywhere in your room and move freely in the real world to get an excellent view.\n\nHand Tracking: Interact seamlessly with the virtual world using your hands, making your experience even more lifelike.\n\nProgrammer VR is your ticket to programming fun. Get started now and unlock your potential!", "short_description": "A first-of-a-kind fun game on the Meta Store to help you learn programming & develop problem-solving skills. \n\nYour mission? Help Bob navigate a virtual world, overcome obstacles & improve intelligence level. \n\nWith each puzzle, learn programming concepts like Instructions execution order, conditional statements, loops -- all while you play a fun game. \n\nWith exciting features like Multiplayer Mode, Daily Challenges, enhanced with MR Mode and Hand Tracking, learning is now a thrilling adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proyuga.tech/programmer-vr-privacy-policy/", "developer_terms_of_service_url": "https://proyuga.tech/programmer-vr-eula/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/ProgrammerVR_Support", "website_url": "https://proyuga.tech/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "6692918594141670"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39036653_659017516443940_5413992496550596175_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFoT8ULKdpYQ7kNvwEx9WuF&_nc_oc=AdrjSQSojgvEw44BGyNB9xyQVNJACfZrcEkrnPxPacNOJZ4i4kEfTlaIdv90BKB5I48&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss
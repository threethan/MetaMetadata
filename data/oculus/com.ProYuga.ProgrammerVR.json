A"}, {"file_name": "2.png", "id": "285246717932861", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/86627654_285246721266194_2575969446918668996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnKrHBAXxCMQ7kNvwEjVTC2&_nc_oc=AdoD__p_0jxthsTJGazNtkkFKyj7L0UCaq3_JqS8n4cklvq6c4NTxJWC9_N4ocAnaOw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AfyIFs_f-4UUwVAiRff3ARprl9gX0XSgE4SqBCJYcbw&oe=6A09D24C"}, {"file_name": "3.png", "id": "436292478867404", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982603_436292482200737_3040556094683052284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3udhHMeZncQ7kNvwEDMgTp&_nc_oc=Ado9NXn763iay16c5P354eGo6E2Q-WXbhWZ0fzw7l_7oaqWP4j_J4yzLHP21dKZXXrc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-oDXxUnVtDJ-iM4oBorQ-n0D1ClSzhnWaTYEbsPijBA&oe=6A09D827"}, {"file_name": "4.png", "id": "1527536304642649", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031429_1527536307975982_8067806095485934547_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcYINhHsgWoQ7kNvwHm5SkC&_nc_oc=AdrwXeqirtFAjTUzXSflxJXKUj18H-YhTV-ob5Tsj4_PpKtO4A45q1UAvWpF45HedOM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5eU6mRqtDYNyAzb7i4_Dbk8sP_oMuKNk1k5VPoEiFLqA&oe=6A09CB84"}, {"file_name": "5.png", "id": "368211236050734", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75230049_368211239384067_4433699725196166729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dKYv3_RwVIQ7kNvwECS49U&_nc_oc=AdqEEXB7jL3rxdbwEh1mS8h4v8MTe_Q8_kg3_tjd2oHtnBIfMmhYPyBE0zvz_RJq6ZI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af644AlX9x7D14qTGTtlllKwWdU4yM0vsP_D-8aP3gBN8w&oe=6A09E0D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PGVR_Trailer Cover Image_2560x1440.png", "id": "889830889410023", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974794_889830892743356_5440725574582926712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pUNMu8CLtAUQ7kNvwGnIAlq&_nc_oc=AdrWkNBEs9uxkeUt1VPipfPbKQt3020aYr58byRrkhxQESJHixDMGHIaIBCr2M3dByI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QN0seC16Ctv5Y9YJtOvPMqdJ4jgIGyU-spT1re5mOPA&oe=6A09D906"}, "display_name": "Programmer VR", "keywords": ["ProgrammingInVR", "VirtualRealityProgramming", "VRProgramming", "LearnProgrammingInVR", "SolvePuzzlesInVR"], "long_description": "Want to learn programming and develop problem-solving skills in a fun way?\n\nSet off on an exciting journey with \"Programmer VR,\" a first-of-a-kind VR game on the Meta Store.\n\nYour mission? Help Bob navigate a virtual world, overcome obstacles and improve intelligence level.\n\nWith each challenge you conquer, you\u2019ll learn programming concepts like Instructions execution order, conditional statements, loops, arrays and much more. Boost your problem-solving skills and logical thinking - all while you play a fun game.\n\nBrought to you by the creators of iB Cricket, one of the highest-rated VR games.\n\nNo prior programming knowledge is required.\n\nKey Features:\n\nCampaign Mode: 75 puzzles across 3 difficulty levels. Challenge yourself!\n\nMultiplayer Mode:  Race against an opponent in PvP battles or collaborate with a friend to master challenges.\nEnhanced with voice chat and personalized Meta avatars, you can truly connect with players.\n\nDaily Challenges: Complete a new challenge everyday and top the global leaderboard.\n\nAchievements: Celebrate your learning accomplishments, track your leaderboard standings.\n\nLevel up your experience\u2026\n\nMR Mode: With the power of Mixed Reality, Set your puzzle anywhere in your room and move freely in the real world to get an excellent view.\n\nHand Tracking: Interact seamlessly with the virtual world using your hands, making your experience even more lifelike.\n\nProgrammer VR is your ticket to programming fun. Get started now and unlock your potential!", "short_description": "A first-of-a-kind fun game on the Meta Store to help you learn programming & develop problem-solving skills. \n\nYour mission? Help Bob navigate a virtual world, overcome obstacles & improve intelligence level. \n\nWith each puzzle, learn programming concepts like Instructions execution order, conditional statements, loops -- all while you play a fun game. \n\nWith exciting features like Multiplayer Mode, Daily Challenges, enhanced with MR Mode and Hand Tracking, learning is now a thrilling adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proyuga.tech/programmer-vr-privacy-policy/", "developer_terms_of_service_url": "https://proyuga.tech/programmer-vr-eula/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/ProgrammerVR_Support", "website_url": "https://proyuga.tech/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "6692918594141670"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39036653_659017516443940_5413992496550596175_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CX78gFoTbjUQ7kNvwEzcUgB&_nc_oc=AdoSP5NR199qmObdUrB_a51vgAdWxwjICdrfKBqCRRloij4eVYGOzrgmSQ6dN2E-whY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss
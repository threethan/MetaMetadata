F9LBgDR3OTyNDqa8wSX-5l2-IhA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OojrNcP0zlDVIXkUoKpm9PX-jNPLY0bKz1h35w4IF-Q&oe=6A20360E"}, {"file_name": "Code_Playground_View_Pond.png", "id": "1593305657751911", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974576_1593305661085244_1368760051307669731_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZujWjJsXHgQ7kNvwGzDDMS&_nc_oc=AdqzpIcSJGyNnukTCnLuBW2W8MjMKrQlnAlaprgoXatsVbVgh3SAwCTmbQEveW6DNKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79ONVRbbaxX3yQ1g8FZP4d8r6fxqk9RokMqTbHbekT_w&oe=6A203021"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PVR_Cover Landscape - 2560x1440.png", "id": "429997232540328", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75361360_429997235873661_5804819608709080672_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c12KXyp67vsQ7kNvwFv2qhY&_nc_oc=Adrn1W1gwaKHVbgoofkhh5Hyc77bh9b9krSxdgvLLq9Ug51cuqKkj3VCgNpXm9P_JUs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_hn3L3WObQ-96MGv1wSm_111xlo_RsqOgHXdJ5LDzbg&oe=6A203B88"}, "display_name": "Programmer VR", "keywords": [], "long_description": "Want to learn programming in a fun way? \n\nLook no further than Programmer VR\n\nHelp Bob collect rewards by overcoming obstacles in 3 breathtaking virtual worlds.  Learn programming concepts, sharpen your logical thinking and develop problem-solving skills in an easy, fun, immersive, and enjoyable way. This game is brought to you by the developers of iB Cricket, one of the highest-rated VR games.\n\nKey features:\n- 50 levels of programming fun\n- 3 enchanting virtual worlds -  Pond, Futuristic Neon City, and Neon Pyramid\n- No previous programming knowledge is required\n- Sharpen your logical thinking skills and improve your critical thinking skills\n- Learn programming concepts like Instruction execution order,  Conditional Statements, and Loops.\n- Co-op Mode\n", "short_description": "Help Bob collect rewards by overcoming obstacles in 3 breathtaking virtual worlds. As you help Bob progress through 50 levels, you\u2019ll learn programming concepts, sharpen your logical thinking and develop problem-solving skills in an easy, fun, immersive, and enjoyable way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://proyuga.tech/programmer-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": null, "website_url": "https://proyuga.tech/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "1275623976377558"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "2717759951934246"}, {"status": "PUBLISHED", "id": "26010743978606534"}, {"status": "PUBLISHED", "id": "907892638850767"}, {"status": "PUBLISHED", "id": "1593145648710577"}, {"status": "PUBLISHED", "id": "1086191570063063"}, {"status": "PUBLISHED", "id": "756724513804135"}, {"status": "PUBLISHED", "id": "1716955012270129"}, {"status": "PUBLISHED", "id": "986591200313410"}, {"status": "PUBLISHED", "id": "624703973461982"}, {"status": "PUBLISHED", "id": "1035682837997293"}, {"status": "CANCELLED", "id": "1695388824546938"}, {"status": "PUBLISHED", "id": "1198288288102376"}, {"status": "CANCELLED"
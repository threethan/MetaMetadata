A"}, {"file_name": "2.png", "id": "285246717932861", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/86627654_285246721266194_2575969446918668996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fl5_OO0JbCMQ7kNvwEjJCvB&_nc_oc=Adozbbe31608cE9BjSDBm-OaTIns16vaPaKNYA_nfbuwqdkxckBdJTETBFuSTJuSsck&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyUVrHZ9yh9duOtndhpfMFgyFyax0o6QesLgKLdo2NKA&oe=6A91648C"}, {"file_name": "3.png", "id": "436292478867404", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982603_436292482200737_3040556094683052284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nqeACs6gBP4Q7kNvwFI--XM&_nc_oc=Adqp-XRWQDanN8KzD6LWtVUy9tmW6RDOT0iUMiy-oqP8O2yes4mqUrQP50ti6ubBYs4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjEBmQ2kCUue5HLrubIj0qlmJxg6h_lDyeigtmjzDa4g&oe=6A916A67"}, {"file_name": "4.png", "id": "1527536304642649", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031429_1527536307975982_8067806095485934547_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQPjQ61A43wQ7kNvwGOD6IN&_nc_oc=AdqH2IZ56GeZijTYeAb0ma35pmRTFT-7H7Xdb14WUT95ZWZeCufvkmWA8N1nari8rVM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpf2393TT5ygQMuY6ZgI-BKsKb0lvSN25SOu6yLVMZQQ&oe=6A915DC4"}, {"file_name": "5.png", "id": "368211236050734", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75230049_368211239384067_4433699725196166729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pk5IW1DuFDwQ7kNvwFXpTnj&_nc_oc=AdoBf7GWcwZdaj7x8iFja9iPUcnak_iukhXFIiF1Jk11NUXwG4uVljepCbLGHY8o4h4&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgRjsDnNrh8YqwSzgTbYfacqxFSftGnrvhL_gRxw271g&oe=6A917315"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PGVR_Trailer Cover Image_2560x1440.png", "id": "889830889410023", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974794_889830892743356_5440725574582926712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40snaMrGN4EQ7kNvwG6xIxy&_nc_oc=AdoZjk8c70pO541PST7TEgjhp2RSrygrXJkCbpgXDL1Sm31qSCKvF5z_xmNeGmDkjE0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2Ve9_IPv4nfixQbpUweTdtYEbvHuxpg86uYvl818ubQ&oe=6A916B46"}, "display_name": "Programmer VR", "keywords": ["ProgrammingInVR", "VirtualRealityProgramming", "VRProgramming", "LearnProgrammingInVR", "SolvePuzzlesInVR"], "long_description": "Want to learn programming and develop problem-solving skills in a fun way?\n\nSet off on an exciting journey with \"Programmer VR,\" a first-of-a-kind VR game on the Meta Store.\n\nYour mission? Help Bob navigate a virtual world, overcome obstacles and improve intelligence level.\n\nWith each challenge you conquer, you\u2019ll learn programming concepts like Instructions execution order, conditional statements, loops, arrays and much more. Boost your problem-solving skills and logical thinking - all while you play a fun game.\n\nBrought to you by the creators of iB Cricket, one of the highest-rated VR games.\n\nNo prior programming knowledge is required.\n\nKey Features:\n\nCampaign Mode: 75 puzzles across 3 difficulty levels. Challenge yourself!\n\nMultiplayer Mode:  Race against an opponent in PvP battles or collaborate with a friend to master challenges.\nEnhanced with voice chat and personalized Meta avatars, you can truly connect with players.\n\nDaily Challenges: Complete a new challenge everyday and top the global leaderboard.\n\nAchievements: Celebrate your learning accomplishments, track your leaderboard standings.\n\nLevel up your experience\u2026\n\nMR Mode: With the power of Mixed Reality, Set your puzzle anywhere in your room and move freely in the real world to get an excellent view.\n\nHand Tracking: Interact seamlessly with the virtual world using your hands, making your experience even more lifelike.\n\nProgrammer VR is your ticket to programming fun. Get started now and unlock your potential!", "short_description": "A first-of-a-kind fun game on the Meta Store to help you learn programming & develop problem-solving skills. \n\nYour mission? Help Bob navigate a virtual world, overcome obstacles & improve intelligence level. \n\nWith each puzzle, learn programming concepts like Instructions execution order, conditional statements, loops -- all while you play a fun game. \n\nWith exciting features like Multiplayer Mode, Daily Challenges, enhanced with MR Mode and Hand Tracking, learning is now a thrilling adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proyuga.tech/programmer-vr-privacy-policy/", "developer_terms_of_service_url": "https://proyuga.tech/programmer-vr-eula/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/ProgrammerVR_Support", "website_url": "https://proyuga.tech/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "6692918594141670"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39036653_659017516443940_5413992496550596175_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DURVDdtryqgQ7kNvwHbau6B&_nc_oc=AdpDFgt0RlPf5xeAvkKVU2IJ4eAleEq1dAxLAGQwboRQnViMdsTP4o19Vrsg_mZ0Vnk&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss
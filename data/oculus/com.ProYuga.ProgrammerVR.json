A"}, {"file_name": "2.png", "id": "285246717932861", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86627654_285246721266194_2575969446918668996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnKrHBAXxCMQ7kNvwEHsNeG&_nc_oc=AdqCzOhnUap0QoZejXGC4y8LJ4usTYYJJBWk2E_RZGDwz9k92HxThEgR58BDSVWRueM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6kxE5BdimqvEpxnJZ5nbtKyoAqjU4JNVcag1-chW5Q1Q&oe=6A0C754C"}, {"file_name": "3.png", "id": "436292478867404", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982603_436292482200737_3040556094683052284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFh4E9Xr13sQ7kNvwHXmCmA&_nc_oc=AdpaOF0NIykMBdbtGTh3rSbW9v9l1nmPpwU_-jyjRMFPJEkz9m2g7-wOT5c24it90Jw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OGxnw1I7qy44hFgQbrxIHCUGx36iSvxU3eZElWBePsA&oe=6A0C7B27"}, {"file_name": "4.png", "id": "1527536304642649", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031429_1527536307975982_8067806095485934547_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQj83qI2ZUEQ7kNvwE4fTPt&_nc_oc=AdozqjgXjpMkbu-OrPHMN0CeJ7zXZNne7256FcFVtO3dQ81LH7LEaw6x0uM_X4oGUm8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UyU4oKD6PHazA3LjL3artNBfNysiOrhfOoSojf97dGQ&oe=6A0C6E84"}, {"file_name": "5.png", "id": "368211236050734", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75230049_368211239384067_4433699725196166729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dKYv3_RwVIQ7kNvwE96PVl&_nc_oc=Adr513DkAQOjN8jxU6I8G9M7gDz3LXhOHED-FyoiNESgI_2m9TE0SJrvAiNZtjIiNSs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-E7kN2KLsu56RAX0jliw4wreCIwTnh7QSVBMTce5eVg&oe=6A0C83D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PGVR_Trailer Cover Image_2560x1440.png", "id": "889830889410023", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974794_889830892743356_5440725574582926712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5vJda8utVYQ7kNvwH5vsHg&_nc_oc=AdraNaCwe1LqCyeO8JgCC_iG1By4AdISTzZS0Et8xxS64SsrJwhgmovkuqsdsLcyIZQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Hmah9oX7Zm3h6nUYbprWtDL0wV-B1sVBUxXanI2xdkA&oe=6A0C7C06"}, "display_name": "Programmer VR", "keywords": ["ProgrammingInVR", "VirtualRealityProgramming", "VRProgramming", "LearnProgrammingInVR", "SolvePuzzlesInVR"], "long_description": "Want to learn programming and develop problem-solving skills in a fun way?\n\nSet off on an exciting journey with \"Programmer VR,\" a first-of-a-kind VR game on the Meta Store.\n\nYour mission? Help Bob navigate a virtual world, overcome obstacles and improve intelligence level.\n\nWith each challenge you conquer, you\u2019ll learn programming concepts like Instructions execution order, conditional statements, loops, arrays and much more. Boost your problem-solving skills and logical thinking - all while you play a fun game.\n\nBrought to you by the creators of iB Cricket, one of the highest-rated VR games.\n\nNo prior programming knowledge is required.\n\nKey Features:\n\nCampaign Mode: 75 puzzles across 3 difficulty levels. Challenge yourself!\n\nMultiplayer Mode:  Race against an opponent in PvP battles or collaborate with a friend to master challenges.\nEnhanced with voice chat and personalized Meta avatars, you can truly connect with players.\n\nDaily Challenges: Complete a new challenge everyday and top the global leaderboard.\n\nAchievements: Celebrate your learning accomplishments, track your leaderboard standings.\n\nLevel up your experience\u2026\n\nMR Mode: With the power of Mixed Reality, Set your puzzle anywhere in your room and move freely in the real world to get an excellent view.\n\nHand Tracking: Interact seamlessly with the virtual world using your hands, making your experience even more lifelike.\n\nProgrammer VR is your ticket to programming fun. Get started now and unlock your potential!", "short_description": "A first-of-a-kind fun game on the Meta Store to help you learn programming & develop problem-solving skills. \n\nYour mission? Help Bob navigate a virtual world, overcome obstacles & improve intelligence level. \n\nWith each puzzle, learn programming concepts like Instructions execution order, conditional statements, loops -- all while you play a fun game. \n\nWith exciting features like Multiplayer Mode, Daily Challenges, enhanced with MR Mode and Hand Tracking, learning is now a thrilling adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proyuga.tech/programmer-vr-privacy-policy/", "developer_terms_of_service_url": "https://proyuga.tech/programmer-vr-eula/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/ProgrammerVR_Support", "website_url": "https://proyuga.tech/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "6692918594141670"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036653_659017516443940_5413992496550596175_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wY2_W3YmzJkQ7kNvwE8Qs42&_nc_oc=Adqs0LcF-62bAO388H-xzRLsbuOz6VbuYPph7eZ64PAawzPM9R6iBotlk9N6H1FKYEA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss
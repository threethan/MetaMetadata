.5771-25/86627654_285246721266194_2575969446918668996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4kRPw07emUQ7kNvwFvwul6&_nc_oc=Adkt2iXA41bIbufV2djHOe7wgiplFxhqSbjwaWACYnRXvCrgnH0BcspmvRkD5wy1NV0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftc4AOk0QO5kmvWGRQGnHzBVMkArgzjCZjefTQr2GyETw&oe=699B144C"}, {"file_name": "3.png", "id": "436292478867404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982603_436292482200737_3040556094683052284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eo9QQcdF88Q7kNvwEiRS0F&_nc_oc=AdllzhyA9I1MmwWutKBCv1U0ygkMP2PLTQX0_Z_s1ihLcuqmJ0f4DX_FQz7Wn8nquDw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftWk_88dKHamMrnGSmtPlkeuOKbiG1jfzwGQegYNz32Rg&oe=699AE1E7"}, {"file_name": "4.png", "id": "1527536304642649", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031429_1527536307975982_8067806095485934547_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNWJYVA3jv4Q7kNvwHNRLNb&_nc_oc=Adn6kPHtCvNtLFKIrZNtUlhaIlCaVZd0pD7ObcV6LfMJsKWw-fP4LKQfQDGu6p8Sswg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsY1a9bfTzrJx6NNrCLqb4E40If-dsVw0GlkpozydsZ1g&oe=699B0D84"}, {"file_name": "5.png", "id": "368211236050734", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75230049_368211239384067_4433699725196166729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1K0R72nHtYQ7kNvwGmU6jV&_nc_oc=Admg6uecj8yAZNPjkZzL2BDpVhx2rshGQB7KInc9h1Fp6ASo_sIIVMTRhKkfWA5EfCo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvvETvdvc-hhbmaHw1BvlmcGAr-iFUrah0FbuDF6D-QFQ&oe=699AEA95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PGVR_Trailer Cover Image_2560x1440.png", "id": "889830889410023", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974794_889830892743356_5440725574582926712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3pVyWMfnBUQ7kNvwHpA20x&_nc_oc=AdmgYYoHXT3yFMC0WSXIhlqmJU0dms4ag--DJv7W2-AVuYmyIGqxfz4OX_oHo2x3bDQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfujsojtIJZoonMyoTdooXs4sUxT517uAnrGkus4XEjTRg&oe=699AE2C6"}, "display_name": "Programmer VR", "keywords": ["ProgrammingInVR", "VirtualRealityProgramming", "VRProgramming", "LearnProgrammingInVR", "SolvePuzzlesInVR"], "long_description": "Want to learn programming and develop problem-solving skills in a fun way?\n\nSet off on an exciting journey with \"Programmer VR,\" a first-of-a-kind VR game on the Meta Store.\n\nYour mission? Help Bob navigate a virtual world, overcome obstacles and improve intelligence level.\n\nWith each challenge you conquer, you\u2019ll learn programming concepts like Instructions execution order, conditional statements, loops, arrays and much more. Boost your problem-solving skills and logical thinking - all while you play a fun game.\n\nBrought to you by the creators of iB Cricket, one of the highest-rated VR games.\n\nNo prior programming knowledge is required.\n\nKey Features:\n\nCampaign Mode: 75 puzzles across 3 difficulty levels. Challenge yourself!\n\nMultiplayer Mode:  Race against an opponent in PvP battles or collaborate with a friend to master challenges.\nEnhanced with voice chat and personalized Meta avatars, you can truly connect with players.\n\nDaily Challenges: Complete a new challenge everyday and top the global leaderboard.\n\nAchievements: Celebrate your learning accomplishments, track your leaderboard standings.\n\nLevel up your experience\u2026\n\nMR Mode: With the power of Mixed Reality, Set your puzzle anywhere in your room and move freely in the real world to get an excellent view.\n\nHand Tracking: Interact seamlessly with the virtual world using your hands, making your experience even more lifelike.\n\nProgrammer VR is your ticket to programming fun. Get started now and unlock your potential!", "short_description": "A first-of-a-kind fun game on the Meta Store to help you learn programming & develop problem-solving skills. \n\nYour mission? Help Bob navigate a virtual world, overcome obstacles & improve intelligence level. \n\nWith each puzzle, learn programming concepts like Instructions execution order, conditional statements, loops -- all while you play a fun game. \n\nWith exciting features like Multiplayer Mode, Daily Challenges, enhanced with MR Mode and Hand Tracking, learning is now a thrilling adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proyuga.tech/programmer-vr-privacy-policy/", "developer_terms_of_service_url": "https://proyuga.tech/programmer-vr-eula/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/ProgrammerVR_Support", "website_url": "https://proyuga.tech/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "6692918594141670"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39036653_659017516443940_5413992496550596175_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ImtZ32gcBgQ7kNvwG5xyw_&_nc_oc=AdnNN_KePILJp3XW5rW4SGn4h22_OR-zx6ZrvcuKe9816S-h0GfEi1JkHGml--JW4Mw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftOkGFgnwBiOYcOOmDsPlQD-RBxfqXsT1ZDEtROD9piZw&oe=699AFA99"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Programmer VR", "pla
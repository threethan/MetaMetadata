A"}, {"file_name": "2.png", "id": "285246717932861", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86627654_285246721266194_2575969446918668996_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vZvrqPdg9gQ7kNvwHi2X_O&_nc_oc=AdrSedVkMkl8onmBq_9BIP93_wt3YnaW9S-LUKAZFSu47352nsyFrcycUXKaCZ_3imw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjBpcgJaYp623vrn-nHiSBZ2teZU1GAxI9KD2ZSvRDSA&oe=6ACF934C"}, {"file_name": "3.png", "id": "436292478867404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982603_436292482200737_3040556094683052284_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7WU81LF-sMQ7kNvwHQAs8h&_nc_oc=Adpsit2PnS8-UBiqLH7FR--BrLIsgQznESiF4YL9uQ_SApDPGZg2sNThnl8qcYnJrqw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5qASIwHrxutA9QWVrPAH-B586ToMbsIkLMPaRQetomQ&oe=6ACF9927"}, {"file_name": "4.png", "id": "1527536304642649", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031429_1527536307975982_8067806095485934547_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NDfdtNhmpQQ7kNvwGI26Qt&_nc_oc=AdoUfVGXhVF4zn-0ll8KUa5aWgthJ1qqwDyQe5kFHY_lYeRiy9o7M7xfUj4Cw8KXKkc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNokZhsbSiXwmAFZHr31uDirRru7jy9Bmiki4l6E0ak8A&oe=6ACF8C84"}, {"file_name": "5.png", "id": "368211236050734", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75230049_368211239384067_4433699725196166729_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gjSXE7LAEXEQ7kNvwHc_cSv&_nc_oc=Adq0qCDBAl2P2R6RHK55dYHRauC-bUMRh3YO31u2bH2j5VBWoO0qeMxKlj87dBxHfNk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmVR6AqAWN-eEV6GMMBycURtnr9psCanvUJflIJJJazA&oe=6ACFA1D5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PGVR_Trailer Cover Image_2560x1440.png", "id": "889830889410023", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974794_889830892743356_5440725574582926712_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Krqs3Eq_AbUQ7kNvwGlX7_d&_nc_oc=AdpOVif64ArNCO3jttLEavWjbVIjjTRRke5DyZ00qExy_k2FtW4qA3kxUlFr0OtJo1I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgH04b7pXJDHwOfAs_h3pwf5Z8MusiklzuG6JaCFRI2w&oe=6ACF9A06"}, "display_name": "Programmer VR", "keywords": ["ProgrammingInVR", "VirtualRealityProgramming", "VRProgramming", "LearnProgrammingInVR", "SolvePuzzlesInVR"], "long_description": "Want to learn programming and develop problem-solving skills in a fun way?\n\nSet off on an exciting journey with \"Programmer VR,\" a first-of-a-kind VR game on the Meta Store.\n\nYour mission? Help Bob navigate a virtual world, overcome obstacles and improve intelligence level.\n\nWith each challenge you conquer, you\u2019ll learn programming concepts like Instructions execution order, conditional statements, loops, arrays and much more. Boost your problem-solving skills and logical thinking - all while you play a fun game.\n\nBrought to you by the creators of iB Cricket, one of the highest-rated VR games.\n\nNo prior programming knowledge is required.\n\nKey Features:\n\nCampaign Mode: 75 puzzles across 3 difficulty levels. Challenge yourself!\n\nMultiplayer Mode:  Race against an opponent in PvP battles or collaborate with a friend to master challenges.\nEnhanced with voice chat and personalized Meta avatars, you can truly connect with players.\n\nDaily Challenges: Complete a new challenge everyday and top the global leaderboard.\n\nAchievements: Celebrate your learning accomplishments, track your leaderboard standings.\n\nLevel up your experience\u2026\n\nMR Mode: With the power of Mixed Reality, Set your puzzle anywhere in your room and move freely in the real world to get an excellent view.\n\nHand Tracking: Interact seamlessly with the virtual world using your hands, making your experience even more lifelike.\n\nProgrammer VR is your ticket to programming fun. Get started now and unlock your potential!", "short_description": "A first-of-a-kind fun game on the Meta Store to help you learn programming & develop problem-solving skills. \n\nYour mission? Help Bob navigate a virtual world, overcome obstacles & improve intelligence level. \n\nWith each puzzle, learn programming concepts like Instructions execution order, conditional statements, loops -- all while you play a fun game. \n\nWith exciting features like Multiplayer Mode, Daily Challenges, enhanced with MR Mode and Hand Tracking, learning is now a thrilling adventure!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://proyuga.tech/programmer-vr-privacy-policy/", "developer_terms_of_service_url": "https://proyuga.tech/programmer-vr-eula/", "publisher_name": "ProYuga Advanced Technologies Limited", "support_website_url": "https://bit.ly/ProgrammerVR_Support", "website_url": "https://proyuga.tech/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "PUZZLE", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "6692918594141670"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036653_659017516443940_5413992496550596175_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srMtkjsSqpYQ7kNvwGqN0qY&_nc_oc=Adp6lyaXJHskLk-yKE8i5TJJO5s2cMM5nSnqcXG2Wmn6TpxTdyn2B9M_jfLYEtDRta0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss
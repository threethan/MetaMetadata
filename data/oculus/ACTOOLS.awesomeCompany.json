ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgoDCEWP7q0NOGhYtKVo61EAOjO7Zz3wsJnXHNljp-VQ&oe=6B0C5FD1"}, {"file_name": "491827038_1891514748299522_4492712028774879945_n.png", "id": "1586091722370736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820987_1586091725704069_5327403375364265573_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjkwCYFXyjEQ7kNvwGt3zQL&_nc_oc=AdrKg1vGmuB19-NI_SaJgE9JCCPkPaNM6yPq0zhccHb_WhrEBTZodGl9jA447Z0Z4is&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSVBKlak41okvnmeu7RCRyac7Tx0TlQqWkqqJus-7mKKg&oe=6B0C63F3"}, {"file_name": "491819944_1162526075561728_3612483772541259477_n.png", "id": "768033719317923", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821755_768033725984589_6246311372505386990_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haM3UU84Yi0Q7kNvwE0g9p3&_nc_oc=AdpMyl4b52JigqMW2w6CF3mMwxgppuskT3xJs6XUBHlkyA7kLYpgzYb5ugVekGJodWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSvz10GpXUPUs22D8qqjva8Cqztm47fifDnIh-TkC_WYg&oe=6B0C4FB3"}, {"file_name": "491830007_1265880018873602_23126377479945572_n.png", "id": "2530719833981480", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314667_2530719837314813_2718009522506649720_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGoBhd4n0TsQ7kNvwHonBNO&_nc_oc=Adr6JJ6Y43h0PxMPi3N-rhDIVyRa8-CpOE6z8RaEQnN5z3WIaTUux7_GIdMJN3rhfH8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR72te34NRKvs9rImJxcxmOeBYnH_YHL0B58MOy3QOXYQ&oe=6B0C80D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BananaCompany", "keywords": ["company", "adventure", "banana"], "long_description": "(AI)Banana Company is a fan-made tribute to the early days of Animal Company, built for players who miss the old-school versions and want to experience the game as it evolved through time.\n\nThis project brings back every major version from v0.1.0 to v0.9.0, letting you freely switch between them and explore how the gameplay, features, and mechanics changed with each update. Whether you're chasing that v0.2 jank or the glory days of v0.7, it's all here\u2014fully playable and preserved.\n\nPerfect for longtime fans, curious newcomers, or anyone who wants to feel that sweet banana-powered nostalgia. No modern changes, no patches\u2014just raw, vintage Animal Company chaos.", "short_description": "(AI)Banana Company is a nostalgic fan-made revival of Animal Company, letting you experience the original versions from v0.1.0 to v0.9.0. Relive the classic gameplay, mechanics, and vibes exactly as they were before the major updates."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZbqwSaRdL1h_B67HVfqsHYJPftNCzo_DnexeneRISDQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chroma LLC", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1U-n7jdghj6CsxHUZEaC0uuPfwpqNS-bm2F3KBMtqooM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24274073292257175"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"_
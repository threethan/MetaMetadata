fWx5J9o6pAQ7kNvwHCNBrD&_nc_oc=AdrCTiiD1_Wj1-IWp_dYtGfv2cNdYh9VWcLGNumo2TcdduIAGXi8fw-M-ed3nDzyIms&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0n4lfM54mFwVTt-S7FzpcOptO0lnnomolS2wBG02D5OQ&oe=69F49973"}, {"file_name": "491830007_1265880018873602_23126377479945572_n.png", "id": "2530719833981480", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499314667_2530719837314813_2718009522506649720_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XuewAjOISoQ7kNvwF7ngSo&_nc_oc=AdrH3UdsUQQC40dMxQiW_E_xKdTdkWWs3BpCLMpglrGjpSqnhYkn2gwIQZ-ld2okj7A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0eXxJx6EIxGfcMfEVFF7dxjni3v4SyPj3ng39sm1q3OQ&oe=69F49253"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BananaCompany", "keywords": ["company", "adventure", "banana"], "long_description": "(AI)Banana Company is a fan-made tribute to the early days of Animal Company, built for players who miss the old-school versions and want to experience the game as it evolved through time.\n\nThis project brings back every major version from v0.1.0 to v0.9.0, letting you freely switch between them and explore how the gameplay, features, and mechanics changed with each update. Whether you're chasing that v0.2 jank or the glory days of v0.7, it's all here\u2014fully playable and preserved.\n\nPerfect for longtime fans, curious newcomers, or anyone who wants to feel that sweet banana-powered nostalgia. No modern changes, no patches\u2014just raw, vintage Animal Company chaos.", "short_description": "(AI)Banana Company is a nostalgic fan-made revival of Animal Company, letting you experience the original versions from v0.1.0 to v0.9.0. Relive the classic gameplay, mechanics, and vibes exactly as they were before the major updates."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZbqwSaRdL1h_B67HVfqsHYJPftNCzo_DnexeneRISDQ/edit?usp=sharing", "developer_terms_of_service_url": null
77_n.png", "id": "768033719317923", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491821755_768033725984589_6246311372505386990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL49Kc-CXtsQ7kNvwHhCkCq&_nc_oc=Adp2pul_L55c5OkZL-qQDbAWxtbIW0J-PznuFV2tPX8t008CKX-wq7Ggvgh34FiXwe8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkZdMEUSJfSDKE2U3a-yOR796wu4yr-C9BYU8_J6-lmA&oe=6A859E73"}, {"file_name": "491830007_1265880018873602_23126377479945572_n.png", "id": "2530719833981480", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499314667_2530719837314813_2718009522506649720_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJtfbqKKoCEQ7kNvwHNPSxh&_nc_oc=Ado1qybxgFaDMFs_GjASrA18G-2WTPAUZuMVLmWQG9H_i-ouaVp_8i-4fxLzwPqqnkM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7QmPEd60Escck4TkPowJ1ItcudJsZIyNF4OzlaGLrpA&oe=6A859753"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hype Company", "keywords": ["company", "adventure", "hype"], "long_description": "Hype Company is a VR game for adventuring different types of biomes and PVP/PVE to make it out with the loot you collected to sell it for money.\n\nwith money you can buy gadgets and weapons for better adventures and advantages against others!\n\nExplore the forest, the dark forest, caves, haunted house, the MOON?\nhave spooky adventures with friends", "short_description": "Hype Company is not your average VR game\nHype Company is a unique experience with lots of adventure and BATTLES, have fun adventuring while fighting off enemies for your loot!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/neurolauncher/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Chroma LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/hypecompany/website", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"i
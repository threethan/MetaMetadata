XYZGNgKllMQ7kNvwGsu0z4&_nc_oc=AdoOWbCxQSH4Ukl4No2k87ZVt8XS4zaXLH8pTb3V9yeChQKnYIb-GDj8nBl4B2XXa40&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmSICunTVbXBtH6_ZuGRj8Fgvsq-9bO6bRR2zFsYYkYw&oe=6A6F34F3"}, {"file_name": "491830007_1265880018873602_23126377479945572_n.png", "id": "2530719833981480", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314667_2530719837314813_2718009522506649720_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8779-6aawDwQ7kNvwGDrWJt&_nc_oc=AdqfdPdO56mx1gaI07nfrAgvfkE4AR7p9SK81AVLm2xkcZSWY4lfhcTGquynOtvRTik&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXAmboKpaXaKaQmHS_5D7KXsjU3d8rfIT-w5ggP-l1Aw&oe=6A6F2DD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BananaCompany", "keywords": ["company", "adventure", "banana"], "long_description": "(AI)Banana Company is a fan-made tribute to the early days of Animal Company, built for players who miss the old-school versions and want to experience the game as it evolved through time.\n\nThis project brings back every major version from v0.1.0 to v0.9.0, letting you freely switch between them and explore how the gameplay, features, and mechanics changed with each update. Whether you're chasing that v0.2 jank or the glory days of v0.7, it's all here\u2014fully playable and preserved.\n\nPerfect for longtime fans, curious newcomers, or anyone who wants to feel that sweet banana-powered nostalgia. No modern changes, no patches\u2014just raw, vintage Animal Company chaos.", "short_description": "(AI)Banana Company is a nostalgic fan-made revival of Animal Company, letting you experience the original versions from v0.1.0 to v0.9.0. Relive the classic gameplay, mechanics, and vibes exactly as they were before the major updates."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1ZbqwSaRdL1h_B67HVfqsHYJPftNCzo_DnexeneRISDQ/edit?usp=sharing", "developer_terms_of_service_url": null
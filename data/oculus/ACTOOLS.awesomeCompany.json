.oculuscdn.com/v/t64.5771-25/491821755_768033725984589_6246311372505386990_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LL49Kc-CXtsQ7kNvwGg1UE4&_nc_oc=AdrPJ9iqrxO_PxG-CRelpUYJ07HSNEqjFtm96tcfktPggrg4Q-Cz7msfWl-Qs3RsOD0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgyhSWX441ae0QJkZNehtIaXwTlpeB6hXXvzbNZ4Lnew&oe=6A86EFF3"}, {"file_name": "491830007_1265880018873602_23126377479945572_n.png", "id": "2530719833981480", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314667_2530719837314813_2718009522506649720_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJtfbqKKoCEQ7kNvwFYfWWY&_nc_oc=Adpy7BavVggFNtbzd7zgmCr0PqSq0BVuXesmTTLWT3l8VegyNBRTY7FX5-68iPMbI-8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7y-sHpCvVemflFQnvDfdkNqAkLX82fYd_MW0N3i_e7g&oe=6A86E8D3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BananaCompany", "keywords": ["company", "adventure", "banana"], "long_description": "(AI)Banana Company is a fan-made tribute to the early days of Animal Company, built for players who miss the old-school versions and want to experience the game as it evolved through time.\n\nThis project brings back every major version from v0.1.0 to v0.9.0, letting you freely switch between them and explore how the gameplay, features, and mechanics changed with each update. Whether you're chasing that v0.2 jank or the glory days of v0.7, it's all here\u2014fully playable and preserved.\n\nPerfect for longtime fans, curious newcomers, or anyone who wants to feel that sweet banana-powered nostalgia. No modern changes, no patches\u2014just raw, vintage Animal Company chaos.", "short_description": "(AI)Banana Company is a nostalgic fan-made revival of Animal Company, letting you experience the original versions from v0.1.0 to v0.9.0. Relive the classic gameplay, mechanics, and vibes exactly as they were before the major updates."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs
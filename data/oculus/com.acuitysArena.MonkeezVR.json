yle, or just hangout!\n\nWill you truly become Monkee?", "short_description": "Climb, Leap, Interact, and Run in Monkeez!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monkeez/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "acuity", "support_website_url": null, "website_url": "https://sites.google.com/view/monkeez/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26028874570145544"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820980_864428092756953_7570716776593257323_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqULai_zcaAQ7kNvwFz5HQE&_nc_oc=Ado7Sz818mGXsrhPEhxxbdKcJaVCTY1LH2vSAFrpRClVM9SwYS7qbkJ4fC6dsn5V6C0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Jj9aWmshvM4nXOMSaO36Yz7wkrv0UL4hRJ2BEzpuIPA&oe=69E8BFBE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "(CHECK DESCRIPTION) Monkeez", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1768513500, "lastRevision": {"nodes": [{"id": "24861870260179320", "release_type": "SCHEDULE
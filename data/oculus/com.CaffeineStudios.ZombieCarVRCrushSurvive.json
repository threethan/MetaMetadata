IoQ7kNvwHAqPEg&_nc_oc=AdoImPXtR06BzfMOKX9hTW4ZTiTbU8D7u-7n1RWFWYtwnlK64JyhyGQ0O5vUn4hhhVk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-AE-BbX2dmv4l1AOeXyDTTSV-Q5NXb_OkNK27uRCNEA&oe=6A974CEF"}, {"file_name": "Zombie_Car_VR_Screenshot_5_4K.png", "id": "1064918213153337", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491818874_1064918216486670_7707283381487735226_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYJ8MPCaV7sQ7kNvwFKANaC&_nc_oc=AdpjJAdMMYUoGQNnUXObuj51vaaoEBqsaXQsCi0aMCDSuPQO5YgKNalDicNXk0c4QEE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5KA2pAWXUcOy31elwS0LNlnMXplGIypj3YFcN4ci3yw&oe=6A9727F0"}, {"file_name": "Zombie_Car_VR_Screenshot_1_4K.png", "id": "1776124010410376", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823783_1776124013743709_6597651251678821267_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-w72h3aLTYQ7kNvwHl-Ad3&_nc_oc=AdpCi43P64GI2M6qiEcfkpCOX42o9o8U3you0F42WqOCh88nvMF_VJW9pBTIgX_AG1E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHU-dnNxAybYiEBAERssC1au3uiab68qlVt6fu_vCkgag&oe=6A973285"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440.png", "id": "864742313114273", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491824291_864742319780939_192294404755014386_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuAwFjUJ_JAQ7kNvwEgG2nq&_nc_oc=AdrSfogVQtVozhaWbrVaWTqSj6Hhm_svSSJ619qBW2OCqPxqTwYTssgINsO-4fdPB0s&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgs20BxcyW7pPQJz6LFm42K1mKwNp1PgHJqjttIRoy4Q&oe=6A97256F"}, "display_name": "Zombie Car VR: Crush & Survive", "keywords": ["zombiesurvival", "VRdriving", "carcombat", "zombie", "survivalhorror"], "long_description": "Take the wheel and enter a city overrun by the undead in Zombie Car VR: Crush & Survive, an immersive first-person VR zombie survival and car combat game built for Meta Quest.\n\nDrive, dodge and crush your way through relentless zombie hordes. Normal zombies can be defeated only when you hit them with enough speed, so keep moving, choose your route and use your vehicle as your weapon. Every zombie attack damages your car, while unstoppable giant zombies join the chase and turn each run into an intense fight for survival.\n\nFEATURES\n\u2022 First-person VR driving with an interactive steering wheel\n\u2022 Fast arcade action backed by realistic vehicle handling and driving physics\n\u2022 Endless zombie survival gameplay with escalating horde size and difficulty\n\u2022 Vehicle combat: ram, hit and crush zombies to earn kills\n\u2022 Giant zombie encounters that force you to escape instead of attack\n\u2022 Immersive urban streets made for high-speed driving, sharp turns and evasive action\n\u2022 In-car HUD for health, time, current kills and best-kill high score\n\u2022 Quick restart and road recovery controls to get you back into the action \n\nHow long can you survive the zombie apocalypse? \n\nTest your reflexes, master the car, outrun the undead and beat your personal record. If you enjoy zombie games, survival horror, VR driving simulators, car games, action games, arcade racing, vehicle combat and high-score challenges, your next ride starts here.", "short_description": "Zombie Car VR: Crush & Survive is an action-packed VR zombie survival and car combat game. \n\nTake the wheel in first-person virtual reality, drive through city streets, crush zombie hordes, protect your vehicle and chase a new high score.\n\nMaster immersive steering and realistic driving physics, survive increasingly intense attacks, escape unstoppable giant zombies and become the ultimate road warrior in this thrilling arcade driving adventure for Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://faizanbashirarain.github.io/caffeinestudios/zombie-car-vr-crush-and-survive-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Caffeine Studios", "support_website_url": null, "website_url": "https://faizanbashirarain.github.io/caffeinestudios/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1239172619278015"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2357785177963156"}, {"status": "PUBLISHED", "id": "2250704482373450"}, {"status": "PUBLISHED", "id": "1364628185814588"}]}, "baseline_offer": {"id": "1364628185814588"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "2357785177963156"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1260110870517523", "version": "1.0"}, "id": "2399389260557037", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1239172612611349", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1260110870517523"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2399389260557037"}]}, "change_log": null, "created_date": 1785003922, "id": "1260110870517523", "version": "1.0",
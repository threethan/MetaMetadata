FuknaZeGR1WAGpcwWV99ZqI9YgHwGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUKuHcLBOaSQSnGL7fnCuoCLlTh4vz8aLWhZEUuPy0y4g&oe=6B0F1ABB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Jet Fight - Jet Simulator Game", "keywords": ["Jet", "Fight", "Simulator", "Shoot"], "long_description": "Get ready for exciting aerial combat in Jet Fight! Take control of a fighter jet, fly through the skies and experience the thrill of intense air battles.\n\nTest your piloting skills as you maneuver your aircraft, maintain control during flight and face challenging aerial encounters. Stay alert, react to your surroundings and take on exciting flying challenges as you experience the action from the cockpit.\n\n**Game Features**\n\n- **Fighter Jet Experience:** Take control of a fighter aircraft and experience exciting jet flying gameplay.\n- **Aerial Combat:** Engage in thrilling air battles and test your combat skills.\n- **Jet Piloting:** Control your aircraft and develop your flying abilities.\n- **Air Battle Challenges:** Face challenging aerial encounters and put your piloting skills to the test.\n- **Aircraft Maneuvers:** Navigate the skies and maintain control during intense flying situations.\n- **Immersive Flight Experience:** Experience the excitement of flying a fighter jet from an immersive perspective.\n\nAre you ready to take to the skies?\n\nStart your engines, pilot your fighter jet and experience the excitement of aerial combat in Jet Fight!", "short_description": "Take to the skies and experience thrilling aerial combat in Jet Fight! Pilot powerful fighter jets, engage in exciting air battles and test your flying skills in challenging combat encounters. Maneuver through the skies, keep your aircraft under control and face enemy aircraft in intense aerial action. Put your piloting abilities to the test, take on exciting flying challenges and experience the thrill of jet combat. Get ready, take off and enter the battle!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/next-bit-games/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Next_Bit", "support_website_url": null, "website_url": "https://sites.google.com/view/next-bit-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1496140280245420"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499292712_2132666580677456_8993874384804836300_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-Av_dN7794Q7kNvwGadKq_&_nc_oc=AdqAH6u2AMOydOfKfSB8Cc4nDK3bBrcaEfVwKXWlxQPZf0npRtN6rDCRhvYTpUUnxio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVysXHkYWcICqk42sq7fogU1HbtOWsU5O3I_b8W2JiDdQ&oe=6B0F1689"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Jet Fight - Jet Simulator Game", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1794939300, "lastRevision": {"nodes": [{"id": "1496140300245418", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"
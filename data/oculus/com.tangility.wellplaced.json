Mw_YOJBJO66bhKBquvDkP9N9502wtS_85blmi1hVys2H6GzY-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJpn3wH6zvOzX3A1wlfk01g4H_Cp-d_uFPuIsHW0mAVw&oe=6AB92552"}, {"file_name": "5895 - Konzept.png", "id": "1312350844098123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_1312350847431456_3592955786558442999_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6gEVxrbxJoQ7kNvwFCwBLx&_nc_oc=AdouTJ3t-uD_bSWshd2mAx7_PV1bn_jIgcm3_ib7KrMY6_AWUOCsofZ5zRokslVYoxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK22jRQggpLlzyVjD318v4uBU4zdNJ0UDmspqD_wIdx2g&oe=6AB92D1F"}, {"file_name": "karmin_room_1.png", "id": "3428498400661763", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_3428498403995096_754083309353191563_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rp8ztfmgN2gQ7kNvwEkpLo-&_nc_oc=Adq1U2s26jDEjqj4B7WcubqiJ_7UVgwoFDLa_PK-YXdp2RqaLKHjkCVDGOvhLBP3xxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsAk82iIYuId-BDEy-WyQrq_EDLU0Q17qucZJrmZPlhQ&oe=6AB91FA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover image.png", "id": "1061777950093443", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1061777953426776_6277121934929926064_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ8AgExTXREQ7kNvwGiZ1zS&_nc_oc=AdpoIqZbLvkMAzhtthlt-C9NA1MSRsFaLHXQKpD5lWn0mPpebxPU4kwYT2cQbtQ-D-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs8BqyA8Jl5SlkOCP0dLyvULf8xDkYJ7VfgoiY3N2lag&oe=6AB93157"}, "display_name": "wellplaced", "keywords": [], "long_description": "Intended for the AEC industry, wellplaced is your contech solution to save planning time and cost of complex building projects. Experience your 3D data alone or globally synchronised as multiplayer session with full interactivity of all objects and voice chat. Visualize simple geometry or high class designs depending on your stage of planning. Building owners, planners and stakeholders can fully immerse in new designs and check equipment and workflows for issues and collisions. Experience your design in AR on the spot in an existing building or urban context. Virtually move between 1:1 and any other scale. Change, add and delete objects or make simple changes to a building's geometry. Experience dynamic sun light changes.\n\nRegardless if you design an urban quarter, a hospital, factory, laboratory, retirement home, shop floor or fire fighter station, every complex environment can be optimized. Flag issues before they become costly construction errors, improve employee satisfaction and ensure smooth operation of your construction project.\n\nThe full feature software requires a paid plan. Get started for free with the Demo before upgrading to other plans to fully improve you planning process. The software even runs on a simple smartphone hot spot. For more details, visit https://tangility.com", "short_description": "wellplaced is your solution to save planning time and cost of complex building projects. Experience your 3D data alone or globally synchronised as multiplayer session with full interactivity of all objects. Visualize simple geometry or high class designs depending on your stage of planning. Building owners, planners and stakeholders can fully immerse in new designs and check equipment and workflows for issues. Experience your design in AR/VR on the spot in an existing building or urban context."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tangility.com/en/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TANGILITY GmbH", "support_website_url": null, "website_url": "https://tangility.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "en_US", "en_GB"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "1273961149137059"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828104_1785820439256078_5731016383447213045_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOSlYsiVrP0Q7kNvwEK4iP1&_nc_oc=Adr_J-H5TRnR8CH910LFOnfLsTPwAvoLnPV6qHor1eAsKSwuOGcww-0LXd2D8LthsuI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsNt2BS-jccOah4VUKr3-u8tq4n-X_zbaTKrGDDuDyfw&oe=6AB93814"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "wellplaced", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1789379760, "lastRevision": {"nodes": [{"id": "1228452990354542", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1228452977021210", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1816295629535406"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1389215556022373", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "wellplaced", "keywords": [], "long_description": "\u201ewellplaced\u201c ist speziell f\u00fcr die AEC-Branche konzipiert und bietet Ihnen eine ConTech-L\u00f6sung, mit der Sie bei komplexen Bauprojekten Planungszeit und Kosten sparen k\u00f6nnen. Erleben Sie Ihre 3D-Daten entweder einzeln oder global synchronisiert in einer Multiplayer-Sitzung mit vollst\u00e4ndiger Interaktivit\u00e4t aller Objekte und Sprachchat. Visualisieren Sie je nach Planungsphase einfache Geometrien oder anspruchsvolle Entw\u00fcrfe. Bauherren, Planer und Beteiligte k\u00f6nnen vollst\u00e4ndig in neue Entw\u00fcrfe eintauchen und Anlagen sowie Arbeitsabl\u00e4ufe auf Probleme und Kollisionen \u00fcberpr\u00fcfen.\n\nErleben Sie Ihren Entwurf direkt vor Ort in einem bestehenden Geb\u00e4ude oder st\u00e4dtischen Umfeld in AR. Wechseln Sie virtuell zwischen 1:1 und jedem anderen Ma\u00dfstab. \u00c4ndern, f\u00fcgen Sie Objekte hinzu oder l\u00f6schen Sie sie, oder nehmen Sie einfache \u00c4nderungen an der Geometrie eines Geb\u00e4udes vor. Schauen Sie sich dynamische Ver\u00e4nderungen des Sonnenlichts an.\n\nGanz gleich, ob Sie ein Stadtviertel, ein Krankenhaus, eine Fabrik, ein Labor, ein Seniorenheim, eine Produktionshalle oder eine Feuerwache entwerfen \u2013 jede komplexe Umgebung l\u00e4sst sich optimieren. Weisen Sie auf Probleme hin, bevor sie zu kostspieligen Baufehlern werden, steigern Sie die Mitarbeiterzufriedenheit und sorgen Sie f\u00fcr einen reibungslosen Ablauf Ihres Bauprojekts.\n\nStarten Sie kostenlos mit der Demo, bevor Sie auf einen anderen Tarif umsteigen. Weitere Informationen finden Sie unter https://tangility.com", "short_description": "wellplaced ist Ihre L\u00f6sung, um bei komplexen Bauprojekten Planungszeit und Kosten zu sparen. Erleben Sie Ihre 3D-Daten einzeln oder global synchronisiert in einer Multiplayer-Sitzung mit voller Interaktivit\u00e4t aller Objekte in AR oder VR. Visualisieren Sie je nach Planungsstand einfache Geometrien oder anspruchsvolle Designs. Bauherren, Planer und Beteiligte k\u00f6nnen vollst\u00e4ndig in neue Entw\u00fcrfe eintauchen und Ausr\u00fcstung sowie Arbeitsabl\u00e4ufe auf Probleme auf verschiedenen Skalierungen \u00fcberpr\u00fcfen."}, {"images": {"nodes": [{"file_name": "layered_icon_composited.png", "id": "2498606517313625", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_2498606520646958_7740815170543694394_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgXae5OOfbYQ7kNvwGALx6C&_nc_oc=AdrQMnHl0cZRXWdO7ZzVkDF1Kb7GzUm-MsHS1WzkzF0N8caf88mFxoSDJcT6jCZlKcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCRH9u2psBSNijrqq7A5wTInmcj0Nl6QTN9xsfMtL0kw&oe=6AB93F74"}, {"file_name": "uba_APP_IMG_COVER_PORTRAIT.png", "id": "1865277754447386", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/585819904_1865277757780719_5026076775512254485_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkGRRoI-3GoQ7kNvwGFtLGe&_nc_oc=AdqQLuLTTzFgeqpdsJuJwbsQjPjOKETJ71jB3N1ONvTm8buUeWbrdHQukqLMaInWJck&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2vTNPSxjNe_V7lo8aENxlEnst2aq0sMU5j-a9n1oDqw&oe=6AB936A3"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1785820435922745", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828104_1785820439256078_5731016383447213045_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOSlYsiVrP0Q7kNvwEK4iP1&_nc_oc=Adr_J-H5TRnR8CH910LFOnfLsTPwAvoLnPV6qHor1eAsKSwuOGcww-0LXd2D8LthsuI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLYkSg9KJCBwncnGXPjx96iHRjDflIiyLrDjhvRfFF6A&oe=6AB93814"}, {"file_name": "uba_APP_IMG_COVER_LANDSCAPE.png", "id": "1644924977345552", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824292_1644924980678885_404261032326826056_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8LrOQWf10gQ7kNvwEo8F3B&_nc_oc=Adr2jZrVsKqXf3KPq6XOHHF6Vw9fjWfugnBEgZ2rQIptBi3EF9SYpVh3_FG9QTM7syw&_nc_zt=3&_nc_ht=scontent-or
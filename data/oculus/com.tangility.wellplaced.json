- Konzept.png", "id": "1312350844098123", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823901_1312350847431456_3592955786558442999_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C6gEVxrbxJoQ7kNvwFCwBLx&_nc_oc=AdouTJ3t-uD_bSWshd2mAx7_PV1bn_jIgcm3_ib7KrMY6_AWUOCsofZ5zRokslVYoxE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK22jRQggpLlzyVjD318v4uBU4zdNJ0UDmspqD_wIdx2g&oe=6AB92D1F"}, {"file_name": "karmin_room_1.png", "id": "3428498400661763", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_3428498403995096_754083309353191563_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rp8ztfmgN2gQ7kNvwEkpLo-&_nc_oc=Adq1U2s26jDEjqj4B7WcubqiJ_7UVgwoFDLa_PK-YXdp2RqaLKHjkCVDGOvhLBP3xxE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsAk82iIYuId-BDEy-WyQrq_EDLU0Q17qucZJrmZPlhQ&oe=6AB91FA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover image.png", "id": "1061777950093443", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1061777953426776_6277121934929926064_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bZ8AgExTXREQ7kNvwGiZ1zS&_nc_oc=AdpoIqZbLvkMAzhtthlt-C9NA1MSRsFaLHXQKpD5lWn0mPpebxPU4kwYT2cQbtQ-D-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLs8BqyA8Jl5SlkOCP0dLyvULf8xDkYJ7VfgoiY3N2lag&oe=6AB93157"}, "display_name": "wellplaced", "keywords": [], "long_description": "Intended for the AEC industry, wellplaced is your contech solution to save planning time and cost of complex building projects. Experience your 3D data alone or globally synchronised as multiplayer session with full interactivity of all objects and voice chat. Visualize simple geometry or high class designs depending on your stage of planning. Building owners, planners and stakeholders can fully immerse in new designs and check equipment and workflows for issues and collisions. Experience your design in AR on the spot in an existing building or urban context. Virtually move between 1:1 and any other scale. Change, add and delete objects or make simple changes to a building's geometry. Experience dynamic sun light changes.\n\nRegardless if you design an urban quarter, a hospital, factory, laboratory, retirement home, shop floor or fire fighter station, every complex environment can be optimized. Flag issues before they become costly construction errors, improve employee satisfaction and ensure smooth operation of your construction project.\n\nThe full feature software requires a paid plan. Get started for free with the Demo before upgrading to other plans to fully improve you planning process. The software even runs on a simple smartphone hot spot. For more details, visit https://tangility.com", "short_description": "wellplaced is your solution to save planning time and cost of complex building projects. Experience your 3D data alone or globally synchronised as multiplayer session with full interactivity of all objects. Visualize simple geometry or high class designs depending on your stage of planning. Building owners, planners and stakeholders can fully immerse in new designs and check equipment and workflows for issues. Experience your design in AR/VR on the spot in an existing building or urban context."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tangility.com/en/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TANGILITY GmbH", "support_website_url": null, "website_url": "https://tangility.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "su
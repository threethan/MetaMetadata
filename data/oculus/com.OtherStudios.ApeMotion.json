5950", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619485_1227115899339283_2804745208881368741_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSlTANgI4sAQ7kNvwGeWwuZ&_nc_oc=Ado6TBFS_oALt9Gi6U7_vfFR6BwI2dm3pvBimY6YJRpDZc63vo2_2jbx8Etg5oZ1WpI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR985hnVXKRiAOR_Pj9ekSut8EdsA-shwaxcTX1RkyuMw&oe=6B0B4533"}, {"file_name": "Main_4K_27.12.2025_12-05-25.png", "id": "896660683025740", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619518_896660686359073_4384681839561965688_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-ZK3dsMnmkQ7kNvwHChWq8&_nc_oc=AdqE9FJSZ2Am472ZKJ4839erzqOK0lGBByNu9LkOMCypYwcPr6CzD7E6BCS3XM24DC0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSFK0KXvAulsAr38zGgLUGL6MGfHt3Yw590-yRJLCyvbw&oe=6B0B175E"}, {"file_name": "Main_4K_27.12.2025_12-05-31.png", "id": "1225257836217147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619485_1225257839550480_7464011580747444590_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssKBU0yV46AQ7kNvwF9nSnI&_nc_oc=Adok2uW1F0qSlmfijclzJsNikUtq0RV1I9IKcehjlIC_NnrxOoERwF6DPYvTKpPA4Lg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVLkARlw-62rrd6H0x8dVXXaefiWpWXIVOglKsbDAxQg&oe=6B0B1DF5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApeMotion", "keywords": ["fun", "horror", "social"], "long_description": "ApeMotion is a physics-based hand-movement gorilla game where you have no legs and move entirely using your arms. Push, grab, climb, slide, and launch yourself through maps full of fun, chaos, and horror.\n\nExplore the Forest with slides, trampolines, and trees, swing with friends, or test your skills. Survive the HORROR tunnels as a monster hunts you in darkness, and navigate the Facility, a hallways-and-rooms map where a bloody, legged gorilla-like creature stalks players.\n\nPhoton powers multiplayer, letting you see and interact with other players in real time, while Photon Voice adds proximity chat for immersive gameplay. PlayFab handles player cosmetics and bans, keeping the community safe and letting you customize your gorilla.\n\nWhether climbing, running, or escaping, ApeMotion turns your hands into your only way to survive.", "short_description": "ApeMotion is a hand-movement gorilla game where you climb, run, and escape across fun and horror maps using only your arms."}]}, "developer_name": "OtherStudios", "developer_privacy_policy_url": "https://html.cafe/x2ab457c7", "developer_terms_of_service_url": null, "publisher_name": "OtherStudios", "support_website_url": null, "website_url": "https://html.cafe/x776f351b", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33098745003106984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619680_860470550059184_1486090882165310076_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiqpEy0uQ_YQ7kNvwHvtPAX&_nc_oc=AdpJVNKdDbYu8h4ucwUp-8hl5U2ZaCWL8mKm7Nm9G-UP8B234wXqDE70Xo3RWrF_zu0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwQ0gAOPNT2J6QM3AM3zuAM-NsZxGNMeYxz3RpETqJyA&oe=6B0B167B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
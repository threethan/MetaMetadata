luscdn.com&_nc_ss=7f20f&oh=00_AQKY_MaUi8x39ecCoTS9O7YKm_Jc_4lM0oQpxsirCXV6Dg&oe=6AAE8BB3"}, {"file_name": "Main_4K_27.12.2025_12-05-25.png", "id": "896660683025740", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619518_896660686359073_4384681839561965688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3yWbjkpIEgQ7kNvwE1ibyq&_nc_oc=AdrV3mrr9qflvjmwjemSzQIRak4318x6E-IVgSFyg4fLofq3rq_y76EQ3UFRh-Ydm9k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlGrhKUrE5luOS6SyiBEhvrpYub4lSC9jiGAVaMEFGbA&oe=6AAE961E"}, {"file_name": "Main_4K_27.12.2025_12-05-31.png", "id": "1225257836217147", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619485_1225257839550480_7464011580747444590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p-mqis4s-XMQ7kNvwF_AYPB&_nc_oc=AdprwklfAx-8QbzDun2AfYuQDKkC8qiqgcMbn94sXU1GGaE5hSZf_5OfPUVcimADK8s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL96ro2LUiQgHLHfeXDB0bTULkFdcinKDYVl47S0YViCw&oe=6AAE9CB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApeMotion", "keywords": ["fun", "horror", "social"], "long_description": "ApeMotion is a physics-based hand-movement gorilla game where you have no legs and move entirely using your arms. Push, grab, climb, slide, and launch yourself through maps full of fun, chaos, and horror.\n\nExplore the Forest with slides, trampolines, and trees, swing with friends, or test your skills. Survive the HORROR tunnels as a monster hunts you in darkness, and navigate the Facility, a hallways-and-rooms map where a bloody, legged gorilla-like creature stalks players.\n\nPhoton powers multiplayer, letting you see and interact with other players in real time, while Photon Voice adds proximity chat for immersive gameplay. PlayFab handles player cosmetics and bans, keeping the community safe and letting you customize your gorilla.\n\nWhether climbing, running, or escaping, ApeMotion turns your hands into your only way to survive.
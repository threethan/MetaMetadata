"Main_4K_27.12.2025_12-05-25.png", "id": "896660683025740", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619518_896660686359073_4384681839561965688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5uL-XHYEUAQ7kNvwGpqB2o&_nc_oc=AdocZxzk2qKIaQ2r-_UxTZCnCMP3EkppkMgu9a51hIH9vlhGHJOzW2o8JPD0CLsSfwg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rIiUDhQa-r2xj64v0cIwE8rKfO1Ys6Lh78Tza1rS49g&oe=69F20F9E"}, {"file_name": "Main_4K_27.12.2025_12-05-31.png", "id": "1225257836217147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619485_1225257839550480_7464011580747444590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6Rfu6tCn1YQ7kNvwGPjWzh&_nc_oc=AdpKv0_RpVYdYyKqfPnnHoytz-LzJ7LAeVrqZLtqua34DqQsq5pAmaudjGT7JlGq4Yw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Gb05zsm1SPxugc1Q47cIodiXpYmrN12Q6KyuL11g4tw&oe=69F21635"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApeMotion", "keywords": ["fun", "horror", "social"], "long_description": "ApeMotion is a physics-based hand-movement gorilla game where you have no legs and move entirely using your arms. Push, grab, climb, slide, and launch yourself through maps full of fun, chaos, and horror.\n\nExplore the Forest with slides, trampolines, and trees, swing with friends, or test your skills. Survive the HORROR tunnels as a monster hunts you in darkness, and navigate the Facility, a hallways-and-rooms map where a bloody, legged gorilla-like creature stalks players.\n\nPhoton powers multiplayer, letting you see and interact with other players in real time, while Photon Voice adds proximity chat for immersive gameplay. PlayFab handles player cosmetics and bans, keeping the community safe and letting you customize your gorilla.\n\nWhether climbing, running, or escaping, ApeMotion turns your hands into your only way to survive.", "short_description": "ApeMotion is a hand-movement gorilla game where you climb, run, and escape across fun and horror maps using only your arms."}]}, "developer_name": "OtherStudios", "developer_privacy_policy_url": "https://html.cafe/x2ab457c7", "developer_terms_of_service_url": null, "publisher_name": "OtherStudios", "support_website_url": null, "website_url": "https://html.cafe/x776f351b", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33098745003106984"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1455498572661398"}]}, "baseline_offer": {"id": "1455498572661398"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767194160, "status": "PUBLISHED", "id": "1455498572661398"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33169277019387115", "version": "0.15"}, "id": "1176080427922836", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "33098744976440320", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33169277019387115"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1176080427922836"}]}, "change_log": null, "created_date": 1767266536, "id": "33169277019387115", "version": "0.15"
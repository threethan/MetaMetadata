luscdn.com&_nc_ss=7f20f&oh=00_Af_Cf_R-BBDaY3OqwcdFZsmEmDssTJPgFXkpV9pGRLAp6g&oe=6A466533"}, {"file_name": "Main_4K_27.12.2025_12-05-25.png", "id": "896660683025740", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619518_896660686359073_4384681839561965688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akWHLMbKW70Q7kNvwH0qnDv&_nc_oc=AdpE8Kw01bRZSzhFMMlbFck2M8LufbPC8eBPBdf5gP5Va9f0hYvLtpifVH1yXahmz7M&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_C_4IY_wgEhDoQsBBlgKBXy3SAR9VhSX2PvPk2-TMYA&oe=6A466F9E"}, {"file_name": "Main_4K_27.12.2025_12-05-31.png", "id": "1225257836217147", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619485_1225257839550480_7464011580747444590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1I2zbWZNuSYQ7kNvwETg9GR&_nc_oc=AdrI3P9sUkpcy8xaI-XQGBZ7dKx4gpE82waUjQ40UJQTHxnHbqZPPHyhCn2cXDYXGes&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97OCeVncabF0Xaz0gCG6UobeppSgoE6jQnT7zKK1R8VQ&oe=6A467635"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApeMotion", "keywords": ["fun", "horror", "social"], "long_description": "ApeMotion is a physics-based hand-movement gorilla game where you have no legs and move entirely using your arms. Push, grab, climb, slide, and launch yourself through maps full of fun, chaos, and horror.\n\nExplore the Forest with slides, trampolines, and trees, swing with friends, or test your skills. Survive the HORROR tunnels as a monster hunts you in darkness, and navigate the Facility, a hallways-and-rooms map where a bloody, legged gorilla-like creature stalks players.\n\nPhoton powers multiplayer, letting you see and interact with other players in real time, while Photon Voice adds proximity chat for immersive gameplay. PlayFab handles player cosmetics and bans, keeping the community safe and letting you customize your gorilla.\n\nWhether climbing, running, or escaping, ApeMotion turns your hands into your only way to survive.
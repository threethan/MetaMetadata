&_nc_ss=7f20f&oh=00_AQBI4X_gQf-yJXt1s9OsoMhfzPMmF5dMR9ABnkzaPVaOMQ&oe=6A64B7B3"}, {"file_name": "Main_4K_27.12.2025_12-05-25.png", "id": "896660683025740", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619518_896660686359073_4384681839561965688_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mC4TAxS4s0Q7kNvwEv5gIi&_nc_oc=Adpdxs0Bcrn2ed2G0JXUT5f3q5Ook-C4OOnr4fp1UOkKt7yLxUru4DtDLmWv_oLId80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgANpuS01bmqqVuIbl352h-v4q4VG7sm-VEv0bNTb5Pw&oe=6A64C21E"}, {"file_name": "Main_4K_27.12.2025_12-05-31.png", "id": "1225257836217147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619485_1225257839550480_7464011580747444590_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FLAglRnly0Q7kNvwHhqGLY&_nc_oc=Adr2f-To6W4T_x6Sr61PGCLUYbxMANsd_PnaDPU_s-ybdsJRwk2Ey7b5xXUmUTA0yac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpVIKRUgKFVam42scGd0xZE-fgwaW7bl7xjzpt0sviZw&oe=6A64C8B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ApeMotion", "keywords": ["fun", "horror", "social"], "long_description": "ApeMotion is a physics-based hand-movement gorilla game where you have no legs and move entirely using your arms. Push, grab, climb, slide, and launch yourself through maps full of fun, chaos, and horror.\n\nExplore the Forest with slides, trampolines, and trees, swing with friends, or test your skills. Survive the HORROR tunnels as a monster hunts you in darkness, and navigate the Facility, a hallways-and-rooms map where a bloody, legged gorilla-like creature stalks players.\n\nPhoton powers multiplayer, letting you see and interact with other players in real time, while Photon Voice adds proximity chat for immersive gameplay. PlayFab handles player cosmetics and bans, keeping the community safe and letting you customize your gorilla.\n\nWhether climbing, running, or escaping, ApeMotion turns your hands into your only way to survive.", "short_description": "ApeMotion is a hand-movement gorilla game where you climb, run, and escape across fun and horror maps using only your arms."}]}, "developer_name": "OtherStudios", "developer_privacy_policy_url": "https://html.cafe/x2ab457c7", "developer_terms_of_service_url": null, "publisher_name": "OtherStudios", "support_website_url": null, "website_url": "https://html.cafe/x776f351b", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33098745003106984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619680_860470550059184_1486090882165310076_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpwZGV7FC34Q7kNvwG1KN0i&_nc_oc=Ado8Bt91rpp5eIVwKoMpyuinzNkbOfH3Amn8OXJQDAvpo6EC9J5WQ52vSji9f_oyZUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCuYWidVqTpjOZH5GkIxIgrNowvi_XZyPeuP1LJ3Rmmw&oe=6A64C13B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "ApeMotion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1767194160, "lastRevision": {"nodes": [{"id": "33098745046440313", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_
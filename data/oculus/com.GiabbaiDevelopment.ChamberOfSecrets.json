ps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035431_424071913687023_7866494145204425949_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LW4FHGDeinsQ7kNvwH0X1rL&_nc_oc=Adq9zwHSpk8d4vLLb5UnDkiXnE1jXBNHqTAHWbl7s8B4DqV0AUppUmMxLVB1ojTW-WM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7clZ3_gcrCf1A_wSGX45sXYQgnkdZ0_a6oFPnCWmVxwg&oe=6A15AD19"}, {"file_name": "Horror Final.png", "id": "1820199461788873", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982690_1820199465122206_3226761703977612453_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGHbyoVUN60Q7kNvwHBP0p_&_nc_oc=Adp2tGeAJbr_vU0d495gESjRxVhg4fMPl8tSAPjVcpC9bHYxoshlOwIRi_0ix8-QYEE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DoSzcWIgq1Z7iX3oIupoQW0g9dwPHUp2c6fQhIVOlgA&oe=6A15B965"}, {"file_name": "Computer Final.png", "id": "1108024650468840", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036670_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgvEakMkcYoQ7kNvwGk18my&_nc_oc=AdrhpNb1s0jAqWgX7Rcj1GFAJSfw6vWTrHWOk_2W_cWNCN4khtj-xia6J56QZK-X89Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cZrd8ls2pLQssdB7B0T3BiIbZI6oX-iAiOb-zu1YPDA&oe=6A15A443"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BEUwpPVEToQ7kNvwGbCcAj&_nc_oc=AdpNfBK_dpFk3puQ-U1DUGWpeRCM45yjHhqptl4plQBv8KnZvPczmQegsVBGH__nRGg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N_VXyiEQ5nmUlbWu4ZRRyyiUU5BkhydW_QfJiSGLvkg&oe=6A15AF5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KYR3hCW4dCAQ7kNvwFlk0qZ&_nc_oc=AdquTpXrZDLP7me-s7hDt5uu-UETEDfS3EZUgF6SqNzVtcRl8aQH6_MxLwq9tjoujoM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A1kq2SNwDFzmSahSyV110MuDrHSV2JEhccdAKaH3I8g&oe=6A159D0F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, become monkey, watch movies (non copyrighted short films), hang out with your friends, change your looks with our cosmetics, and be spooked with your friends in the horror mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1JQvEMsa0rsobamUTRfP5XBBMwPxH97M3R_bkc5U7WCQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://giabbairyker.wixsite.com/my-site-2", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYPjFg5Z8icQ7kNvwErKHHF&_nc_oc=Adm-yUMh7X1Fil8RrtbG6gbfV1uYbBGviKDkoXaI_nhX3jErg-tpYasYxUFS3On2Vgc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftRjuEu_htulVjK6AWKWe20jG5BUuiIHBW9uLaxNN0i0g&oe=699DABC3"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-CIw88jb5QQ7kNvwEDobF9&_nc_oc=AdmPJ1Etv3iSWF4iJKDa9q3W279ZR2TtYCof1bjYyKjxcJ5MDijP_5Fm1J-R267olqs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqluxEVRFOLyBgMABEVhTfaa16_TFp7AW1T9e640bTcA&oe=699DB6DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=au1HVbbBKLMQ7kNvwEYQbS5&_nc_oc=AdmPNp-5w6EVyVfYbQkl5S69c5eGPRDANe6I-x8J798sReqQ1Q58Gkgjen0Us8X7PVE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuI2brP6YOVN1y37Gk1uUchT-3wOgX1GJh7MSB3gXUung&oe=699DA48F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, beco
_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BYPjFg5Z8icQ7kNvwEyw8LB&_nc_oc=AdkSMG5z6_ngznKFf6bcLCbMllWMXD8Gt0t3j0UmODnTCiACo0iLefXU3usVt30uZSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsF05Ygwh4Y_XitT8Ol7K_4pV0u0dqm-WLbBHpSfntFIg&oe=699B08C3"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-CIw88jb5QQ7kNvwHCyQ4t&_nc_oc=AdmyoV2vRx7nBXLOSYi9QkrEoE5njjmPd82SZY9fBg-H5M5G0-g3STHBB3mrlza6WIA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsUnvURVhdxsoSyqcbsmdIve4If5xXrQQziFHYkjexjcQ&oe=699B13DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baRMIVRfSAkQ7kNvwGHEAfT&_nc_oc=Adm5K1NHjHEG9CRl3qGNxSwSCMt9530mueg-BUERprdCVO4jer7Xn766O1iF3v_Co2A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuYDkLiXPkaii-OOLZG0mmUtkioRifXHWuqX1NQ4hfwpQ&oe=699B018F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, beco
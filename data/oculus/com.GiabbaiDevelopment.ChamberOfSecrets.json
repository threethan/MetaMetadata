ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035431_424071913687023_7866494145204425949_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRPKHMooKNgQ7kNvwH9Wqtf&_nc_oc=AdpK6hhU1lP7Lead7pJLRZC-dY2y9HTDiKYkZJ9yLuER_Ydhrgri-myQ71A36r3Hrn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwE91RE6rHY6ZtS5_8AyqzdWWeKk7hvPMV_3hLuYnY4aQ&oe=69CE7C19"}, {"file_name": "Horror Final.png", "id": "1820199461788873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982690_1820199465122206_3226761703977612453_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6abcFVex9LUQ7kNvwFlu60r&_nc_oc=AdoWvht4o3BvDYL_vYERP4yU6U_FHwGm08IzJqWxGtuSNKIKKMDtqUwBhB2Nrdcv2Hk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz4I43MjZ7uY2DjlR3R8qqjU78t-Iytjc8TN_bjS4ibWQ&oe=69CE5025"}, {"file_name": "Computer Final.png", "id": "1108024650468840", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuN0MIoT60sQ7kNvwHtsNwE&_nc_oc=AdppeLUkxcfYfm3-2O0rpAt49V61MUeMy3yqT53n0HzbsBVqspoO5joLGnQjWFj1KDI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNRU-HKAoO6_mCHnH8xSYzts4Y_Ozgbxi7d9acx2XjwA&oe=69CE7343"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfaeTYEsC7wQ7kNvwFelD00&_nc_oc=Ado5o-7nnk4I558uImo8q7ya5ozPxlYodFVI_LjFkOTnyotjfbOiiPbtBXS8mlSwMaI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwD8bEyEavzGkLH_P32VWMW0LmLd1Gb_Gtp0adXqydlAA&oe=69CE7E5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Fq5aYjh1OIQ7kNvwH9AQWT&_nc_oc=Adq8qK1ZcWhYqhK9Kumc7ZQi0ny6UQupf9IqtWJeGYadQdMewxBka90LncY2VRRXmcM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4jbYJjqWIFNNNFx1Fgppgv357P4roFcE3FJazkRj8cw&oe=69CE6C0F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, become monkey, watch movies (non copyrighted short films), hang out with your friends, change your looks with our cosmetics, and be spooked with your friends in the horror mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1JQvEMsa0rsobamUTRfP5XBBMwPxH97M3R_bkc5U7WCQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://giabbairyker.wixsite.com/my-site-2", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
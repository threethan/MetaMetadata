scdn.com&_nc_ss=8&oh=00_AfxlEHsBs24Oo-uwQ0V4JAoEvToObNM5OjxiUf3KgLGcMQ&oe=69AD5AA5"}, {"file_name": "Computer Final.png", "id": "1108024650468840", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036670_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfTiLipCFNkQ7kNvwHVPNt6&_nc_oc=AdkeaCjGKQXTOHejJMJ3LAcV8JqlTj-N5f3ra3ac1CipEdSpvM0FPu7Y0qcr1gQnm7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6JTN40D0nZeIm23FdBSXsSPqGKrbnQfIGvUDFe0Er5g&oe=69AD7DC3"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maqm5KZolAYQ7kNvwFTzzl6&_nc_oc=Adl7lfKrhjNFyl4e14unUzfQWSQWq2W4fHGz8EgbNNK8TnCSTvk9PLkv__n4MGgfPtM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzTdMyicXMTt4dBhiI9cFnT23hjLeD1VgQYmoJMpu9c2g&oe=69AD509C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7akhwysSBqgQ7kNvwFHMXrv&_nc_oc=AdnBgCQG7dS6aCAxgMR37N1lnM6g0GzEA2U2aYfXO4ezNQwge12jSVRXXxV6lzS_rPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZ_2gaWv_HB6EUKwlkGcunmc_lMQIDFbtswtL4RK28Jg&oe=69AD768F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, become monkey, watch movies (non copyrighted short films), hang out with your friends, change your looks with our cosmetics, and be spooked with your friends in the horror mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1BR4XqhmQ5D__WT3GyUlvbD6Vq40dTO7iZUwUuCkUtvM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://giabbairyker.wixsite.com/my-site-2", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7927630133922839"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8146914251994425", "version": "1.4"}, "id": "7442203655816797", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7927630123922840", "is_concept":
_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seVLtsOORvQQ7kNvwHEbjok&_nc_oc=Adm9g3Fsf0CkpBywbWEq_DOjnvXlV7Uw2BzJ1KERRMoiiEPfpwZPlILl9_pZe9hZgWU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv1BmdVBk5AK5ha8bp_QSlXSAOufRadZgutTuOK1zBpnw&oe=69A2F1C3"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jto5E41RkqUQ7kNvwFetwct&_nc_oc=AdmogfG9gWIomPjY0MXmA1SPj5H1U6u_7RScR1J-2Em2Nb-3_riMvrryiB4TZ6nWcFI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvKh9qIxQFEXmIufqEMEOTgN9FIBRCBWXFKvaAqmWw68Q&oe=69A2FCDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aN4fmJHUmJwQ7kNvwGOfM4e&_nc_oc=Adk-RUceeZOyeq3EGikHmFtke8Cau5_VbPo27LqLzbNxQvhXEvTqSF_QrSNds5FwQ-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvH7vCCrdqHkWpc67wb--GC7r7ZPj8fGDzYFmlYDWd6Rw&oe=69A2EA8F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, beco
B04871C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2IDXtAPpdgQ7kNvwESNMfY&_nc_oc=AdpUwR6HCKZMmS0RI4e6u2Z04PW-HdsVRYW7IECrUYdOKzkgWYG2tRRTwHh1H4VLDXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSK3tjxLJ1qj_w8aBMbUZhepBoVfSyy8GYMH3zy35_vw&oe=6B0474CF"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, become monkey, watch movies (non copyrighted short films), hang out with your friends, change your looks with our cosmetics, and be spooked with your friends in the horror mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1JQvEMsa0rsobamUTRfP5XBBMwPxH97M3R_bkc5U7WCQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://giabbairyker.wixsite.com/my-site-2", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}
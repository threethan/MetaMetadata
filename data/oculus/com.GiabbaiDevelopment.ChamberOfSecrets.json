_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADkvAhdUscgQ7kNvwHMSTZX&_nc_oc=AdpVD1g9t4s3Qox4r9e9H_g7ff9Q79zkEQigfWjFut05sK_f8VZS9B4feMUwdMM1zM4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0jpz8mxhZTxcf026SHIs6Fpiil_FkvO-uVxEkQQa5blg&oe=69F0BA43"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgbP5AJX8ewQ7kNvwGXzDe9&_nc_oc=AdpM3-5niH5yKTpEmPSB9WFykG72VDFeteXo6MyoefTD-MjFu0gvT7YNIo5IGjhArxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1DswOU8g4nNkxulkX23qR7bXLPAMUlC4f8GR82ejdKig&oe=69F0C55C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0b5Sg5dIgUQ7kNvwHJetdx&_nc_oc=AdqMG3Qme5gkRdxYF4apkW9BgDc0V4xsxdIyPzOC5Y-W7WzddyhuPdoku-alEMfv5Xc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3_7fc5ow3ATOiaWAK_JnznBc0Z8KCvvD6jv6gE5PPTBA&oe=69F0B30F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, beco
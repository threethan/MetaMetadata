ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035431_424071913687023_7866494145204425949_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFJVAOUEM0kQ7kNvwE_gKLP&_nc_oc=AdrNMlGi9BjqsjN885ETXxdC7x2nsiaQ_PCtx7Hnoy4XtP9B7QIDZ_wUhtqmOmyb1no&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZdaLmSPdStVTQnBT37hk0mz6vgBdX7DzkdSx7CwDoIQ&oe=6A1D9619"}, {"file_name": "Horror Final.png", "id": "1820199461788873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982690_1820199465122206_3226761703977612453_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1sB-JBOA0UQ7kNvwG9Xv_k&_nc_oc=AdpFoYHeyNfKbgQPO9AT19az2MzNIPFlCD_sUa9GIGCj4GrqpUHv1Uc2gZZaNKxIi_g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af458CCOREJRAMfxFuEK9WibWdaKUc31QKHC4poRFMeF_g&oe=6A1DA265"}, {"file_name": "Computer Final.png", "id": "1108024650468840", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036670_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZ1-dCx9tAkQ7kNvwFxjMNq&_nc_oc=Adqy4CF2OoEQkec8R9SysC9qYfsgezsBY0wCAjHGJn4U88nmvejE5z-wnCahqlqQ-q0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZN_O9HRdG-xi5bQocXdAP5ukTlX1bu_nS4xBs5UN27A&oe=6A1D8D43"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lhwa4vbOzpoQ7kNvwGeJOHT&_nc_oc=AdpMUbbpZ3v0qTTaFzKUHfUPhIFeE7u4RXIXUrzaurxrmNib5wo9wSHlgv1-HiFxEhw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52U9DKLKDcxjwtCKwOAZNSGK6opfY-IWBR18ip4QJwaQ&oe=6A1D985C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DGvTlj7GUcQ7kNvwF-Puhx&_nc_oc=AdqgOVRzYPzBIzlp3ZSFGax8e3F1H7b0KFT1y2SuO4tvjts5B3jDoJM8ad1bM8qYXlI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YueYPD1gkLuREsl2wE0-YSaYCGkjn8aLmW_FkcxOpHw&oe=6A1D860F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, become monkey, watch movies (non copyrighted short films), hang out with your friends, change your looks with our cosmetics, and be spooked with your friends in the horror mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1JQvEMsa0rsobamUTRfP5XBBMwPxH97M3R_bkc5U7WCQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://giabbairyker.wixsite.com/my-site-2", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
scdn.com&_nc_ss=8&oh=00_AfwEH-L_h4i60WVcYV3EQGwjW_HZuyVmTI2_etTPb5anZg&oe=69C12125"}, {"file_name": "Computer Final.png", "id": "1108024650468840", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036670_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvUYqWTmppsQ7kNvwF6KQGb&_nc_oc=Adpsf2sfCbIbYeJ8VxVzJWxLpb_vOtCGaWwn_4FBwSYPlMAg44AIFSNqNv_zEs8XzBc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afwm57v3TezLOkpxOF-GVonTRwIqZudA7VRoPftEA_zejg&oe=69C14443"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Rx9Z423wPQQ7kNvwG2HR3t&_nc_oc=AdohycPjWE4ZdZJPLJ7AOhYQAgpZXxSYNR5JQJRRvq7fCrNDWi18DaSeKZa5HiOGpAw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz8SkFdYAGUb-kSCqNAkqNe7Ay5YBMH8kSqDtzHOA-50w&oe=69C14F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMQle577lWsQ7kNvwF3FnzI&_nc_oc=AdrE4paR5uzlGWP3QzN07xu07_vxcFbeALFYVe_ocU8kZLDvzd2BtmbjvBjqEnrtNHM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxuaiRuwAtahYEd_Wg-67ixy4rfipzn-WqS-XlcbSLMUQ&oe=69C13D0F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, become monkey, watch movies (non copyrighted short films), hang out with your friends, change your looks with our cosmetics, and be spooked with your friends in the horror mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1BR4XqhmQ5D__WT3GyUlvbD6Vq40dTO7iZUwUuCkUtvM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://giabbairyker.wixsite.com/my-site-2", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7927630133922839"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8146914251994425", "version": "1.4"}, "id": "7442203655816797", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7927630123922840", "is_concept":
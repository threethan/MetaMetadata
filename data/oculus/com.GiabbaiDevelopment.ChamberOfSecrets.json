_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seVLtsOORvQQ7kNvwHeXBRm&_nc_oc=AdmBv1fyY2Y_uFUs_-IEp5wQzDuazSIJe7YzUKkknOsHnzL9lYVTqspTX4LtXCAcidM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuqaVSnPcPxsUtRsMPAf-qvouzDd56VarP-kfyj6gqEJw&oe=69A594C3"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jto5E41RkqUQ7kNvwF-8e_p&_nc_oc=AdmcMGZzPr0geajjBiyZn0oRtPxUru2LZtdzLRoFHJ_9nNztrkzy_GE-rAAL921ivks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuIAq2l_ImFGmDXYiMZBPovo7Arx41PlH9Wel5ICmq5iA&oe=69A59FDC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMgDeR7j1wcQ7kNvwEMUi4f&_nc_oc=AdmfjuI0mV8pWhXplsQ_3uFDTG_KGHmA0mhV7QvIwu_h9Z7sksN9K6JUJUXH0XkbPNI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvbjH092kMrkEUQNqQijUNmtyQIsu6RDr4tLmsrcT2oIA&oe=69A58D8F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, beco
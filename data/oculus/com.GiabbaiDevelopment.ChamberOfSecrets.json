om/v/t64.5771-25/39035431_424071913687023_7866494145204425949_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6JTs5nXQlDYQ7kNvwEZ3UTO&_nc_oc=Adnh7gMpMM1RpmqBnoRRXiEI8ePHjs0ai_RXXS17Mt1RTC-Junn4-qF3VSLgeoDDrio&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzbIisfl4u5KVZLd6Qi6PDdhsbLRvcEu2iAhRYZ-intqg&oe=69B81299"}, {"file_name": "Horror Final.png", "id": "1820199461788873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982690_1820199465122206_3226761703977612453_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nspTN9_F9WMQ7kNvwGBgR6f&_nc_oc=AdnVdMd6NriyF5dwDcGDwaiZf7ioSXQJhX58Dxkw0K2eb0SGfJlgUZyt5JiDmFj3Kms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGYer_kZf6C2GqXGfcm-Xi49qu7SXRPn02fjgnJYFhBg&oe=69B7E6A5"}, {"file_name": "Computer Final.png", "id": "1108024650468840", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUJ6biwCjsQQ7kNvwFX4PFE&_nc_oc=AdnfYMVrT257d9_A4WIRbFPOdAHTZ7m0kPCXK1jkXMR3iw1F5X_EiSUVfP3isZS0b8Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzc9iEuDJR1hDuCHpZr5Emj5TWfbzap1sLlaPAhHdCJyg&oe=69B809C3"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJxA24m2u1gQ7kNvwH0ekhK&_nc_oc=AdlPg7MaD5Zd341Y-shwA-yYKSXjRmJVzWiPoqS7Uo3sLmdTSlT3TLBy50yQoBeq180&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw1D_YyKb_AIIbqukXzqE7xOu3f-6rh2Nh2eLSt60JB3g&oe=69B814DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5MKQzjo66cQ7kNvwE06xWE&_nc_oc=AdkxGwBE7EXLgZ8-U-RbnUgpIDLfTd86rUdaNrUCemhMymSKqRrDqgp-9KHbQoPh2XM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy78IDxrILoSOzAPQiN5U-C_xOpA1VmvJGG75KgKasDfA&oe=69B8028F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, become monkey, watch movies (non copyrighted short films), hang out with your friends, change your looks with our cosmetics, and be spooked with your friends in the horror mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1JQvEMsa0rsobamUTRfP5XBBMwPxH97M3R_bkc5U7WCQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://giabbairyker.wixsite.com/my-site-2", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "
ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035431_424071913687023_7866494145204425949_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8w-_0Q7XnUQ7kNvwEhyk4u&_nc_oc=Adr_sbAuazWWLTc5BsQ_iGkM9S7PLcGUT04x39N4aTIhfbYCyrxALCcKrbGK-jChKks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH757Spc4au7ne6uOrND4ya4M81NQhlDOCo7zoll8Ursg&oe=6A7B3099"}, {"file_name": "Horror Final.png", "id": "1820199461788873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982690_1820199465122206_3226761703977612453_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CK8vycsEYEQ7kNvwG9Lv0Y&_nc_oc=Adr6uqHVp0qC7QcjtuX1Y9_MCI_IJ5K3EMhrUcWPZ-UZ2SO_ZzZV52PZzOOBqckb0FU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRmCEH-eiq_Vj_awv_7-0TV-ZmKXGl5i-bGOtBTtZy3w&oe=6A7B04A5"}, {"file_name": "Computer Final.png", "id": "1108024650468840", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VrRIVadPEMQ7kNvwHpZCuy&_nc_oc=Adq8fKNTo4ow3zcGBQfiq5Li-sMYev6LuTJU_0oKTJf_ktNJFIakHTe-yJu7vFwdPzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFltasY4O1lUKAL0HE_u9a9gHcvj3TZ1sl9X3UuQI2ggA&oe=6A7B27C3"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0gevcadvN4Q7kNvwGKw-pZ&_nc_oc=AdraYcRPyMMmv8rJnC046wljwCYmpB820GP47Nl_VugSL-g4SR7IOOzc08_yR3ll0zk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvo0jwnBuXMHNRaDiCvU_vSwXW33T2vFbBdz_FTWibIA&oe=6A7B32DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMxXwQukDLEQ7kNvwGlp_t2&_nc_oc=AdoD1HrkykPEDIe_CTv5Re2xLU10IwwUEmUoZ7Ld38OBsGHeW3T_jxL8Fd9lwMC8aSc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZtKcd9E29ywdc4DLPhex7r3ZjKlBOSlhhw9XHVYNvmw&oe=6A7B208F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, become monkey, watch movies (non copyrighted short films), hang out with your friends, change your looks with our cosmetics, and be spooked with your friends in the horror mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1JQvEMsa0rsobamUTRfP5XBBMwPxH97M3R_bkc5U7WCQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://giabbairyker.wixsite.com/my-site-2", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
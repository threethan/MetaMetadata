ps://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035431_424071913687023_7866494145204425949_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wI3l29Xl48kQ7kNvwGknkvK&_nc_oc=Adq9ux78wUtoplQIgRfxIKVDd9UFz9sU58nX5mmGBe_gXlscwI2ConahNiWnXKxRw9I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tbTCqeOYXjhJ2pty8cCn0M6He6weEMdkuS03x84mVIQ&oe=69EB7D19"}, {"file_name": "Horror Final.png", "id": "1820199461788873", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982690_1820199465122206_3226761703977612453_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypxo6O6s0kAQ7kNvwE0aKoJ&_nc_oc=AdpuF6-JQF8U4C6OAMwBNRhk-F5Vf6TvVmYKgIYL4rtbeeWmRhYzTJjnm-9_olz6gZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03Jqps8DlipoVtsITZSYOoC48pmp9E7tAwZxTYcVDlbA&oe=69EB8965"}, {"file_name": "Computer Final.png", "id": "1108024650468840", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036670_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nEBvw8qvbkQ7kNvwHQ1oP2&_nc_oc=AdoJuw1w_g4svHduy9SANIj2MzepxM5otshDCml7IFuV1kW2fszZIKHs0B63W2aCliQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30MHXWwkvOCcVfarSLUOxDHm4SHdeRAdpQprSyYI9Y4g&oe=69EB7443"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnLP-CwvSeIQ7kNvwFyaESZ&_nc_oc=Adrx9TbWojiCATRUHSc03VHTEMS4W1AHJSzy19nb_c1rbHS3CcSGDOXxNWvVi5111Dk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Cq7zqveivSfYqEVlxugWVOw2ahZtoP1dy_FLrvx76LA&oe=69EB7F5C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HnKLWoagkmgQ7kNvwFGpo5O&_nc_oc=AdrqNMpLx2kx5GhJ56YhOBiwP55JTMaQrYRbmfUZiPrHRGJrDInLjfM0lqsvXcmEnYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z0Ac7X1evxyL1QjN0wj2yD37tRB-3OrYzkfUF6QhytQ&oe=69EB6D0F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, become monkey, watch movies (non copyrighted short films), hang out with your friends, change your looks with our cosmetics, and be spooked with your friends in the horror mode!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1JQvEMsa0rsobamUTRfP5XBBMwPxH97M3R_bkc5U7WCQ/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Ryker Giabbai", "support_website_url": null, "website_url": "https://giabbairyker.wixsite.com/my-site-2", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCUL
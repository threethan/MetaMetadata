_1108024653802173_6922810019100931257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJAON8w1OoMQ7kNvwFY8Eku&_nc_oc=AdkBfvlrvkKhIk1Ii3Gk5yvMvHalh5zw7MEqBpSYKz4cB0lnlzsbBIcc3QZxPAGquXI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfttyVulmUthk6XDMTrClqMfb1gOa4N3u5WEb1GwpFlOjQ&oe=699EFD43"}, {"file_name": "Horror Inside Final.png", "id": "916471900216859", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974821_916471903550192_4499429631367683600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rk0jPHfPWXQQ7kNvwEBPp_B&_nc_oc=AdkLaVyQdvNQdGRIjbP9CCjP6ae5CqZi9tmRCSPXWHswgpqYCQZdSnrWMFeiD1Xn5V0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftoWhGgamnkgyc-d_7-Ixsn518VKdWrAUItWZIR77kppg&oe=699F085C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Movies Inside Final.png", "id": "410569995037857", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_410570005037856_8573017682005162977_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=au1HVbbBKLMQ7kNvwEIxbJ_&_nc_oc=AdkE7RK4rL5dsckqjYj4rqY_O8t5--sI3CxwcLGSmAviWgX6OgCm3X0xC5stc1gxdp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfttGYRPNp1k4A170BmwLdC5NLYd4SeLVxTihiltphfYdw&oe=699EF60F"}, "display_name": "Chamber Of Secrecy", "keywords": [], "long_description": "\"Chambers of Secrecy\" merges Gorilla Tag's dynamic movement with heart-stopping horror. Navigate intricate chambers using Gorilla Tag's fluid mechanics. Face unspeakable horrors in dedicated horror mode, testing your courage and wits. Feel tension mount with every step into darkness. Unravel mysteries as you confront terrifying creatures. Take a break from adrenaline with in-game movie theaters, offering thrilling films and documentaries. With seamless gameplay, spine-chilling horror, and innovative features, \"Chambers of Secrecy\" promises an unforgettable gaming experience. Ready to uncover secrets within?\n", "short_description": "Chamber of secrecy is a game wear you can reject humanity, beco
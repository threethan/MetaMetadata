ncsJsQg&oe=6AF34420"}, {"file_name": "screenshot_5_2560x1440.png", "id": "3043787996013219", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_3043787999346552_535167534212494436_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8gR2O0WPBAQ7kNvwEKqmfR&_nc_oc=AdpeJiJLh4b_BSWHl7XOGwFWBOCdurR_Fv607hVZKVXxEa7nobflSwdhfomAarhph4U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBRMv5brlkj2kbvANFEvo0BTqBNQOgdenumtV-WjoFqA&oe=6AF35203"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2103997270201575", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831569_2103997280201574_122185743710021106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BionImd3BcQ7kNvwEJSXIl&_nc_oc=Adq-1JFR03cVutEsLFsI3SV_IDEkwMaAgwQYsOA-jSvx6NKaVcQjl2nkIpvWA7DIUu4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0UdrwQtBupPbkr4B-Vzjr4ToErrk3aH-pzeF8x2rbpQ&oe=6AF3351A"}, "display_name": "Tennis", "keywords": ["tennis", "sports", "racket", "practice", "training"], "long_description": "A full indoor tennis club, built to the book and rendered in real PBR.\n\nTHE COURT IS THE REAL THING\nRegulation dimensions to the centimetre, from the baselines to the centre marks, painted on an acrylic hard court under a gabled steel roof. Afternoon sun rakes through the clerestory and across the blue. Look right and you are looking into the players' gallery through a full-height glass wall.\n\nTHE BALL MACHINE PLAYS PROPERLY\nIt stands on the far baseline and feeds down the court, moving the ball side to side so you have to move to it. Every feed is a real ballistic solution onto a bounce point, so the ball dips into the court and kicks up on the rise, right where a groundstroke is taken. Turn the pace up and it feeds heavier topspin, exactly like the real thing.\n\nFOUR FEEDS, FOUR DRILLS, FOUR LEVELS\nGroundstroke, volley, lob and serve. Rally to warm up, Set for twenty feeds, Targets to land the ball in lit discs, or Climb, where the machine adds a mile an hour every time you return one. Social to Tour, 36 to 67 mph.\n\nTHE RACKET IS YOUR HAND\nStep behind the baseline and it is there. Swing across the ball and the strings aim the shot. Tap B for slow motion to meet a fast one; contact snaps you back to full speed so you can watch it go.\n\nScoreboard with returns, shot speed, streak and your best. Return one at 80 mph for a winner.\n\nSingle player. Standing or roomscale.", "short_description": "Step onto a real indoor tennis court. A baseline ball machine feeds you groundstrokes, volleys, lobs and serves at up to 67 mph, the ball bounces and kicks the way it should, and the racket is in your hand the moment you reach the baseline. Four drills, four levels, and a club you will want to stand in."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/tennis/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/tennis/", "website_url": "https://citiview-games.pages.dev/tennis/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1239709952568311"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1350948070449541"}]}, "baseline_offer": {"id": "1350948070449541"}, "is_approved": true, "firstOffer
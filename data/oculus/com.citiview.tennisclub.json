png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-222_rq0meMQ7kNvwHBZTr1&_nc_oc=AdqY0DORvPaOV5NayLjMEbxZhlyT5U6F8KChwVD9iBMwp1O2-T9dsUChsPNpRVOssqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2FbomYcI4kwHdYQkx96ega2oMaE9bjcyA2Q0trMLH4Q&oe=6AF88A20"}, {"file_name": "screenshot_5_2560x1440.png", "id": "3043787996013219", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831299_3043787999346552_535167534212494436_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zpb4QhvKuwQ7kNvwG8PqfH&_nc_oc=Adqv4k4umBVF4B13vgFYUGo2BS22L7sw8pFDBSDOqvuddpHlr5Ik6RfW6mfklc9MLtM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpqD6WhDLf2jn7d3Sq3K7gnsWKSsgDvAkNtqSAOuVDyQ&oe=6AF89803"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2103997270201575", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831569_2103997280201574_122185743710021106_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2mTgp4csSAQ7kNvwHzX_CY&_nc_oc=Adp1UD0IPis5Rfh5ggykyktB_1ej50-hvW_zn3mGxA1QBMDXXEREAJ-viMX6tCoJFTE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFF13PdqDJnCXyAveNy2p5_iVrdS8Qz_edU62vP6AQ7w&oe=6AF87B1A"}, "display_name": "Tennis", "keywords": ["tennis", "sports", "racket", "practice", "training"], "long_description": "A full indoor tennis club, built to the book and rendered in real PBR.\n\nTHE COURT IS THE REAL THING\nRegulation dimensions to the centimetre, from the baselines to the centre marks, painted on an acrylic hard court under a gabled steel roof. Afternoon sun rakes through the clerestory and across the blue. Look right and you are looking into the players' gallery through a full-height glass wall.\n\nTHE BALL MACHINE PLAYS PROPERLY\nIt stands on the far baseline and feeds down the court, moving the ball side to side so you have to move to it. Every feed is a real ballistic solution onto a bounce point, so the ball dips into the court and kicks up on the rise, right where a groundstroke is taken. Turn the pace up and it feeds heavier topspin, exactly like the real thing.\n\nFOUR FEEDS, FOUR DRILLS, FOUR LEVELS\nGroundstroke, volley, lob and serve. Rally to warm up, Set for twenty feeds, Targets to land the ball in lit discs, or Climb, where the machine adds a mile an hour every time you return one. Social to Tour, 36 to 67 mph.\n\nTHE RACKET IS YOUR HAND\nStep behind the baseline and it is there. Swing across the ball and the strings aim the shot. Tap B for slow motion to meet a fast one; contact snaps you back to full speed so you can watch it go.\n\nScoreboard with returns, shot speed, streak and your best. Return one at 80 mph for a winner.\n\nSingle player. Standing or roomscale.", "short_description": "Step onto a real indoor tennis court. A baseline ball machine feeds you groundstrokes, volleys, lobs and serves at up to 67 mph, the ball bounces and kicks the way it should, and the racket is in your hand the moment you reach the baseline. Four drills, four levels, and a club you will want to stand in."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/tennis/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/tennis/", "website_url": "https://citiview-games.pages.dev/tennis/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
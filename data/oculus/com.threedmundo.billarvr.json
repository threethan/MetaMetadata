n3ZLunE3JFlxwcexQnTr6wOnBbkFpt9jZ83dvzBgCzqj4RJELaCRVmLl84&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6VhZ5TAm9PIFK5v_zXj9k8zuNlSWRa1NBaJFQBC1Xzg&oe=6AF9D15E"}, {"file_name": "screenshot_03_table.png", "id": "28732163159750254", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302374_28732163163083587_6171694785748320381_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4A-xFrYHMIQ7kNvwFv5zpM&_nc_oc=AdpQ7Nok5dzKzzgGb4eE3XVHh9vZHqahaRyDGV1AvQ6GgsTzpSnz-SrJ0QyurhXwo2U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqI_8Plxwy1DYub1LplSimKScGHMy042v3ur4nPz7AJg&oe=6AF9D852"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1090818376657377", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499302527_1090818383324043_47996097430840120_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otyyNcApTtYQ7kNvwFRif1y&_nc_oc=AdqdoE--IO2EVSjdt01TP7XWxJSTPq69oXA3_y28Rrp5W6Bv22Nbw2mA1KA9_whSglk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRa2UCWQcdjUjSSR8v89AOPTCexNB3ImM59RWE1z9FAnw&oe=6AF9E659"}, "display_name": "Carambola VR", "keywords": ["pool", "billiards"], "long_description": "**The pool table is waiting. Your cue is on the rack.**\n\nCarambola VR puts a regulation 9-foot pool table in front of you and lets you play the way you\nwould in a real pool hall. No buttons to charge a power bar, no aiming arrows you cannot turn\noff: you grab a real-size cue, lean over the table and strike.\n\n---\n\n**A CUE THAT RESPONDS LIKE THE REAL THING**\n\n- Hold the cue with one hand, or with both: your front hand becomes the bridge and the cue\n  slides through it naturally.\n- Stroke power comes from the real speed of your hand, from a soft touch to a full break.\n- Where the tip meets the cue ball decides the shot: follow, draw, stun and left or right\n  English.\n- Raise the butt and the shot changes too.\n- Chalk your tip on the cube by the cue rack. Forget to and a hit far off-centre can miscue,\n  just like in a real game.\n- Controller haptics on every strike, scaled to its strength.\n\n---\n\n**PHYSICS YOU CAN FEEL**\n\nEvery ball is simulated with the models billiard engineers use:\n\n- Balls slide, then roll, then spin down, with real friction between ball and cloth.\n- Ball-to-ball collisions carry friction, so cut shots throw and spin transfers.\n- Cushions are modelled at their real nose height, so rails and spin interact as they should.\n- Squirt pushes the cue ball off line when you use English.\n- Pocket jaws can rattle a ball out or swallow it.\n\nThe simulation is event-driven, so even a hard break never tunnels through a ball or a rail.\n", "short_description": "Real 8-ball pool in virtual reality. Pick up the cue with your hands, bridge with the other,\nand stroke the cue ball for real: your hand speed is the power, where you hit is the spin.\nRegulation 9-foot table, true billiard physics, official-style 8-ball rules, three CPU levels,\nlocal 2-player and practice. English and Spanish. Fully offline.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/CmHX4S4BTcDoiWbjftaxab", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Tera Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/CmHX4S4BTcDoiWbjftaxab", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ST
nt-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXygXqLJuFLjHfSTc4DptR2cg5MMY-B9Lwt0ifKIF3r0Q&oe=6B103671"}, {"file_name": "screenshot_05_menu.png", "id": "1096500002724880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/654904853_1096500009391546_5902208606017140510_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VrkXjyMZ_fcQ7kNvwGt8Q2U&_nc_oc=Adp8DoSneeZKYnfTX_PG_9mTVUhNIeWWGI-_ZDUMPPvudqLycW0R--Z52LXmB3mTa8U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW0QtJ1ctBYYAONPyITqw1LpNoMs2AZ0-Uu5RovVQ8O_Q&oe=6B104764"}, {"file_name": "screenshot_01_break.png", "id": "1056548153848631", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312338_1056548160515297_1719778629856922817_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aiagPYvgon8Q7kNvwFQOsxa&_nc_oc=Adr92LCCtxwSLQaQZKleQD0zVpJ_eFmBl9dwAfeqsHvONyqEo7viqHG-4AYxlbYi_K8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVphhA_DJ7DNMaJb07ruIG4PISwA7t3Wx9c6XskJUzfiQ&oe=6B103ADE"}, {"file_name": "screenshot_03_table.png", "id": "28732163159750254", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302374_28732163163083587_6171694785748320381_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KbJC0LKucMQ7kNvwG5Hm2H&_nc_oc=Adp3MqFqZixP1F6xiog7ajB0v_LYuezkb0EGCeQOsaTS5f5SIqJEGs2j7btBqq2Mll8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJAIrUt_Mr0zROyqs0D9qvITuIBRXMqA5bm8sDsKZnPw&oe=6B1041D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1090818376657377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302527_1090818383324043_47996097430840120_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3QlgUhwUSEQ7kNvwEoy6ey&_nc_oc=Adrvns9LHua-7RxBVH4PFTU2wWQXo-5FgYM8ams6Oo9fHFQGOeSmJ0aYP013qDStLqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEszLvHi6gHpmMATGmwj_9qrecG7esqBhNb3W6MTKHpw&oe=6B104FD9"}, "display_name": "Carambola VR", "keywords": ["pool", "billiards"], "long_description": "**The pool table is waiting. Your cue is on the rack.**\n\nCarambola VR puts a regulation 9-foot pool table in front of you and lets you play the way you\nwould in a real pool hall. No buttons to charge a power bar, no aiming arrows you cannot turn\noff: you grab a real-size cue, lean over the table and strike.\n\n---\n\n**A CUE THAT RESPONDS LIKE THE REAL THING**\n\n- Hold the cue with one hand, or with both: your front hand becomes the bridge and the cue\n  slides through it naturally.\n- Stroke power comes from the real speed of your hand, from a soft touch to a full break.\n- Where the tip meets the cue ball decides the shot: follow, draw, stun and left or right\n  English.\n- Raise the butt and the shot changes too.\n- Chalk your tip on the cube by the cue rack. Forget to and a hit far off-centre can miscue,\n  just like in a real game.\n- Controller haptics on every strike, scaled to its strength.\n\n---\n\n**PHYSICS YOU CAN FEEL**\n\nEvery ball is simulated with the models billiard engineers use:\n\n- Balls slide, then roll, then spin down, with real friction between ball and cloth.\n- Ball-to-ball collisions carry friction, so cut shots throw and spin transfers.\n- Cushions are modelled at their real nose height, so rails and spin interact as they should.\n- Squirt pushes the cue ball off line when you use English.\n- Pocket jaws can rattle a ball out or swallow it.\n\nThe simulation is event-driven, so even a hard break never tunnels through a ball or a rail.\n", "short_description": "Real 8-ball pool in virtual reality. Pick up the cue with your hands, bridge with the other,\nand stroke the cue ball for real: your hand speed is the power, where you hit is the spin.\nRegulation 9-foot table, true billiard physics, official-style 8-ball rules, three CPU levels,\nlocal 2-player and practice. English and Spanish. Fully offline.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/CmHX4S4BTcDoiWbjftaxab", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Tera Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/CmHX4S4BTcDoiWbjftaxab", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1132212192578216"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296157_2012944909423071_7429176828402380314_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bh5kDzbYZFQQ7kNvwEmgYJl&_nc_oc=AdrjE6eibVxU-CrLCF1NY1Ycl4Bc9JhGE4zejR2-8l6f1I9P_3Oru1ptaE2NSN5NzvE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUbJNr_q-AmtnbZxr0_VUcZ8HDsmanZL2Gqdh_vYFyxtg&oe=6B105884"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carambola VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1790085960, "lastRevision": {"nodes": [{"id": "1132212202578215", "release_type": "SCHEDULED", "administration_status": "APPRO
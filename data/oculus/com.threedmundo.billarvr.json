nt-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7Hd1z2DkAoRNkjWOpXn-0fYUEBQsomCBLTDcPvQZ2Mg&oe=6B01EE31"}, {"file_name": "screenshot_05_menu.png", "id": "1096500002724880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/654904853_1096500009391546_5902208606017140510_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWNYHN-NuQQQ7kNvwGoP_9o&_nc_oc=AdoKhR6Lx0YgHsC3S6tLLaeyHVTJVVt9RtG9PGgNQjEoiePOT8RO8NiTl_V9QyCDb8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFX44I1zQ-5qUyFY4khQw89jolLsYnLonQVfz5ziLZuA&oe=6B01C6E4"}, {"file_name": "screenshot_01_break.png", "id": "1056548153848631", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312338_1056548160515297_1719778629856922817_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xR0qISv8t40Q7kNvwEEmOQK&_nc_oc=AdobwJw3WvUojVOUu4slwCfdwAEgC9xwcoQY26pTDQSHs3J3Vp75P7kQ3t0EwAtReVw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB4s-Zoxo2feP2JhzyTAC_Q3ebg-es6UYfKBuInJgisQ&oe=6B01BA5E"}, {"file_name": "screenshot_03_table.png", "id": "28732163159750254", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302374_28732163163083587_6171694785748320381_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FDWZVvXn8l4Q7kNvwFoGk1P&_nc_oc=AdqZF5ym5WYp8_TtkO81Lxf9s2Kuaq75YcHOix-dFr9oRZel-GQnqXTkszvmVQq-pkM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoM9T5Y_9GY85cK87-8vdgHsUaAi6YEEPAOUqm-SeXLg&oe=6B01C152"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1090818376657377", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302527_1090818383324043_47996097430840120_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDuGYv1xa9kQ7kNvwEztPLD&_nc_oc=AdpoF6CXr-K7sbjiYy8U-NKrpZayGSCex-Y1oxi_HS5ID6czzYm30DsgrTUaZN8_rTA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrE5hdTAQgCgIDZ8hjZYg8ReXhLOWxZ5t8DnIU2S6K8w&oe=6B01CF59"}, "display_name": "Carambola VR", "keywords": ["pool", "billiards"], "long_description": "**The pool table is waiting. Your cue is on the rack.**\n\nCarambola VR puts a regulation 9-foot pool table in front of you and lets you play the way you\nwould in a real pool hall. No buttons to charge a power bar, no aiming arrows you cannot turn\noff: you grab a real-size cue, lean over the table and strike.\n\n---\n\n**A CUE THAT RESPONDS LIKE THE REAL THING**\n\n- Hold the cue with one hand, or with both: your front hand becomes the bridge and the cue\n  slides through it naturally.\n- Stroke power comes from the real speed of your hand, from a soft touch to a full break.\n- Where the tip meets the cue ball decides the shot: follow, draw, stun and left or right\n  English.\n- Raise the butt and the shot changes too.\n- Chalk your tip on the cube by the cue rack. Forget to and a hit far off-centre can miscue,\n  just like in a real game.\n- Controller haptics on every strike, scaled to its strength.\n\n---\n\n**PHYSICS YOU CAN FEEL**\n\nEvery ball is simulated with the models billiard engineers use:\n\n- Balls slide, then roll, then spin down, with real friction between ball and cloth.\n- Ball-to-ball collisions carry friction, so cut shots throw and spin transfers.\n- Cushions are modelled at their real nose height, so rails and spin interact as they should.\n- Squirt pushes the cue ball off line when you use English.\n- Pocket jaws can rattle a ball out or swallow it.\n\nThe simulation is event-driven, so even a hard break never tunnels through a ball or a rail.\n", "short_description": "Real 8-ball pool in virtual reality. Pick up the cue with your hands, bridge with the other,\nand stroke the cue ball for real: your hand speed is the power, where you hit is the spin.\nRegulation 9-foot table, true billiard physics, official-style 8-ball rules, three CPU levels,\nlocal 2-player and practice. English and Spanish. Fully offline.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/CmHX4S4BTcDoiWbjftaxab", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Tera Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/CmHX4S4BTcDoiWbjftaxab", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1132212192578216"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296157_2012944909423071_7429176828402380314_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6s7DRhfkn1AQ7kNvwGAuoaK&_nc_oc=Adrf0dJAtxJ5Nzn23Ma5Wl24Yjuzs_ODagBfuuwdSFBLeWTKscLc0qCneLZV2LDjH58&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCp31c7mnJ5_MLUDmqyRXmG6AfY4F57Gpq1zETU-1nng&oe=6B01D804"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Carambola VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1790085960, "lastRevision": {"nodes": [{"id": "1132212202578215", "release_type": "SCHEDULED", "administration_status": "APPRO
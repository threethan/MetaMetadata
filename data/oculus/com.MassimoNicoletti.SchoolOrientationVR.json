-7&_nc_sid=6e7a0a&_nc_ohc=__e-NlrZfloQ7kNvwH8tjoR&_nc_oc=Adrmm7_tgdQZSRZcV84Zo62SqX4wXE2PW09KJbSZXBoWA7Qw1BGGBNbQPoiqh0iQb4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC32eJw-1KZqqa3x7G0KcA4P_jy39kFNpUcdBBT3eihQ&oe=6B01D0AF"}, {"file_name": "Screen4.png", "id": "1638942920716880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818885_1638942927383546_64491909359003769_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0OZ93AzyJwQ7kNvwELyo2u&_nc_oc=AdqS0G1NmIhP1HoYyFj4a5r3kAZ6_1BhDAfD_OQi0TF_EcRQTE2zTui9tG13-a3kWCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYaVLLoDiQujN0027t7vJ9r0xb6wxuT1GSAn_jm3CADA&oe=6B01DD23"}, {"file_name": "Screen5.png", "id": "1755479232107741", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825305_1755479235441074_5994484144304008040_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdjNaLp9TXwQ7kNvwHc6rtd&_nc_oc=AdqGvDyEEDjhY80GgR3hdbAqQZ25gR1mcJx-s1ItW8yOqUtIP7nwUa8-XOc27WNNzbE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNDznu3Z-05rFIFQqI_mecceiNLP3Vma-y3mUELAHJtA&oe=6B01E82C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "4397079430608272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_4397079437274938_5368497134026920143_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uinaKFialDkQ7kNvwG83sev&_nc_oc=Adpkde9wh5w32GnysV9zcx13KMLiECmu5rbGxjhaDuq5jE6F6EHsiILGjwwTvebSR94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxqQehW-6YdNW9J7W6qOfTrZ7UPryGiDpkfAfE_AOkfg&oe=6B01C0F3"}, "display_name": "School Orientation", "keywords": [], "long_description": "\"School Orientation\" is a VR application designed to support middle school students during the transition to high school.\n\nThrough an experiential journey, the app helps reveal personal talents and natural inclinations through various activities:\n\nPractical Lab Activities: Test your technical and manual skills with hands-on challenges and simulations.\n\nAptitude Tests: Discover your strengths with activities designed to identify the fields where you excel.\n\nExploring Knowledge: An interactive journey through different subject areas to understand which sectors spark your interest most.\n\nInformed Choices: An engaging tool for students to reflect on their future and reduce uncertainty when moving to high school.\n\nThe future begins with self-knowledge: discover your talents before choosing your next educational path.", "short_description": "Helping middle school students discover their potential through practical activities, aptitude tests, and interactive challenges for an informed high school choice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15KIlecGQvJyZ9AabROjLecaxB0u947x1CXUJwCL4Y44/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Massimo Nicoletti", "support_website_url": null, "website_url": "https://cartellata.altervista.org/mfei/SchoolOrientationVR.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27062357783360566"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1504500041185556"}]}, "baseline_offer": {"id": "1504500041185556"}, "is_approved
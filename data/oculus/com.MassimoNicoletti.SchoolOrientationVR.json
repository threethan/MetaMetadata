uA&oe=6ACBC32F"}, {"file_name": "Screen4.png", "id": "1638942920716880", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491818885_1638942927383546_64491909359003769_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xg8xqgppMoQ7kNvwHI6MYz&_nc_oc=AdpkFLB79aqEvzQAeLmBCUXL0Z8bfN8jl-hyF9B_L-p5qMPVhjoV8HCf9PnSVWDXYh4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBMqp6wfFrPbPcVUsBYwyJLrrPTCOVjpfi2s7UsZR59Q&oe=6ACB9763"}, {"file_name": "Screen5.png", "id": "1755479232107741", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825305_1755479235441074_5994484144304008040_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pzcqi8ZXTVsQ7kNvwG3F0us&_nc_oc=AdpforIREYlk_BbTgpZGcdMqMp-uKs7yT6jZytk2EXH7JigSE6jAqp8_BJb7Jx4bBzM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYfXiH9CqqJ_ZiyTbKx2HwFJaGkwi5n_gsR7erVPo0NQ&oe=6ACBA26C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "4397079430608272", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_4397079437274938_5368497134026920143_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HuN9gkLjt8gQ7kNvwHVWlyQ&_nc_oc=Adrvpw0pOOYis-c6wTltGXNsbKeIh1siri6Vt8UYSleHvTkrzCRvkhnxlZxYgF2Aty0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKU72xrMDE28NKxjDwtASk__g4XSmfJstINppo16f-Hw&oe=6ACBB373"}, "display_name": "School Orientation", "keywords": [], "long_description": "\"School Orientation\" is a VR application designed to support middle school students during the transition to high school.\n\nThrough an experiential journey, the app helps reveal personal talents and natural inclinations through various activities:\n\nPractical Lab Activities: Test your technical and manual skills with hands-on challenges and simulations.\n\nAptitude Tests: Discover your strengths with activities designed to identify the fields where you excel.\n\nExploring Knowledge: An interactive journey through different subject areas to understand which sectors spark your interest most.\n\nInformed Choices: An engaging tool for students to reflect on their future and reduce uncertainty when moving to high school.\n\nThe future begins with self-knowledge: discover your talents before choosing your next educational path.", "short_description": "Helping middle school students discover their potential through practical activities, aptitude tests, and interactive challenges for an informed high school choice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15KIlecGQvJyZ9AabROjLecaxB0u947x1CXUJwCL4Y44/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Massimo Nicoletti", "support_website_url": null, "website_url": "https://cartellata.altervista.org/mfei/SchoolOrientationVR.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27062357783360566"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1504500041185556"}]}, "baseline_offer": {"id": "1504500041185556"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778519100, "status": "PUBLISHED", "id": "1504500041185556"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28796954503234210", "version": "0.1.5"}, "id": "1498937921597791", "
id=6e7a0a&_nc_ohc=vY5rQ9wyeQAQ7kNvwHtLYik&_nc_oc=AdoC-228Vgu_R2MM-Yl2WgkViA4ppegmg1_Q7gexRidXh7T1t39Y8Y8AFZpBsjLAnr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QwbyEeZgm3HoHAvtxmMu_OCUtyU-Qe_q6Ocio1ssarQ&oe=6A08846C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "4397079430608272", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_4397079437274938_5368497134026920143_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAcHF_O1mKoQ7kNvwGUxXwy&_nc_oc=AdpJUtkDWo75q_jpXreibBVM7WeA6pD93YrktADKJ1FCpLLC8IEON5lmhhJ-cJQ4RXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5m1BZduiYsLGNZ0RCEA5oItgMAO3ZeV-Gp3BNgInnjXw&oe=6A089573"}, "display_name": "School Orientation", "keywords": [], "long_description": "\"School Orientation\" is a VR application designed to support middle school students during the transition to high school.\n\nThrough an experiential journey, the app helps reveal personal talents and natural inclinations through various activities:\n\nPractical Lab Activities: Test your technical and manual skills with hands-on challenges and simulations.\n\nAptitude Tests: Discover your strengths with activities designed to identify the fields where you excel.\n\nExploring Knowledge: An interactive journey through different subject areas to understand which sectors spark your interest most.\n\nInformed Choices: An engaging tool for students to reflect on their future and reduce uncertainty when moving to high school.\n\nThe future begins with self-knowledge: discover your talents before choosing your next educational path.", "short_description": "Helping middle school students discover their potential through practical activities, aptitude tests, and interactive challenges for an informed high school choice."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15KIlecGQvJyZ9AabROjLecaxB0u947x1CXUJwCL4Y44/edit?usp=sharing", "d
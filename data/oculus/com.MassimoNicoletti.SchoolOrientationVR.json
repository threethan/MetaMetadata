wfDvYxRMBb-w&oe=6A6F4E63"}, {"file_name": "Screen5.png", "id": "1755479232107741", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825305_1755479235441074_5994484144304008040_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nf3YNQPw68EQ7kNvwFb6rvA&_nc_oc=AdrZUc8XsNxGKFep6_WmtZ8-UOsIVe_gkvECOMITS8PAJULR4BXatjGEUnHGIJuAd7Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9dy0cCtJcEf7s8518X6fL6o2d5w3_vqqKIj05uSSy-g&oe=6A6F596C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverImage.png", "id": "4397079430608272", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823746_4397079437274938_5368497134026920143_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JganaFuzdYQQ7kNvwEpcmzy&_nc_oc=Ado6DkiyDInE-tVDSgvDhJrhxqw3z_8_NOE0EV0xMkiBL3olxCsJiy8-LB7tjwn4y-U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUMBUUzomdpdjLiL1wxJqWFByMQLYA8yqtiuEyMLd51g&oe=6A6F3233"}, "display_name": "School Orientation", "keywords": ["school", "education", "orientamento", "scuola", "guidance"], "long_description": "\"School Orientation\" is a VR application designed to support middle school students during the transition to high school.\n\nThrough an experiential journey, the app helps reveal personal talents and natural inclinations through various activities:\n\nPractical Lab Activities: Test your technical and manual skills with hands-on challenges and simulations.\n\nAptitude Tests: Discover your strengths with activities designed to identify the fields where you excel.\n\nExploring Knowledge: An interactive journey through different subject areas to understand which sectors spark your interest most.\n\nInformed Choices: An engaging tool for students to reflect on their future and reduce uncertainty when moving to high school.\n\nThe future begins with self-knowledge: discover your talents before choosing your next educational path.", "short_description": "Helping middle school students discover their potential through practical activities, aptitude tests, and interactive challenges for an informed high school choice."}, {"images": {"nodes": []}, "id": "986183017239865", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orientamento Scolastico", "keywords": [], "long_description": "\"School Orientation\" \u00e8 un\u2019applicazione VR progettata per accompagnare gli studenti di terza media nel delicato processo di scelta della scuola superiore.\n\nAttraverso un percorso esperienziale, l'app aiuta a far emergere le attitudini personali e le naturali inclinazioni degli studenti tramite diverse attivit\u00e0:\n\nAttivit\u00e0 Laboratoriali: Mettiti alla prova con sfide pratiche e simulazioni per testare le tue abilit\u00e0 tecniche e manuali.\n\nTest Attitudinali: Scopri i tuoi punti di forza con attivit\u00e0 mirate a identificare i settori in cui sei pi\u00f9 portato.\n\nEsplorazione del Sapere: Un viaggio interattivo attraverso diverse aree tematiche per capire quali ambiti stimolano maggiormente il tuo interesse.\n\nScelta Consapevole: Uno strumento coinvolgente per riflettere sul proprio futuro e ridurre l'incertezza nel passaggio alle superiori.\n\nIl futuro inizia dalla conoscenza di s\u00e9: esplora i tuoi talenti prima di scegliere il tuo prossimo percorso di studi.", "short_description": "Aiuta gli studenti di terza media a scoprire le proprie inclinazioni attraverso attivit\u00e0 pratiche, test attitudinali e sfide interattive per una scelta consapevole della scuola superiore."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/15KIlecGQvJyZ9AabROjLecaxB0u947x1CXUJwCL4Y44/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Massimo Nicoletti", "support_website_url": null, "website_url": "https://cartellata.altervista.org/mfei/SchoolOrientationVR.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27160148163581527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499312376_1296619955915680_6748535085184527849_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHXC3xj2fXEQ7kNvwE6g0TF&_nc_oc=AdoeD-6YJ0hA8ODwAxEnbZIscbOkaZBdFkZqLWx-S7cE7wJ5bsMfPkOlb7iC_vj1j3Q&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAevPCsVFQ6UWrfUN19diQuqszTyfuYud-cNRepK9Z7ow&oe=6A6F5176"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "School Orientation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1778519100, "lastRevision": {"nodes": [{"id": "27062357846693893", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27062357730027238", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1952459282064777"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1512320867028611", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orientamento Scolastico", "keywords": [], "long_description": "\"School Orientation\" \u00e8 un\u2019applicazione VR progettata per accompagnare gli studenti di terza media nel delicato processo di scelta della scuola superiore.\n\nAttraverso un percorso esperienziale, l'app aiuta a far emergere le attitudini personali e le naturali inclinazioni degli studenti tramite diverse attivit\u00e0:\n\nAttivit\u00e0 Laboratoriali: Mettiti alla prova con sfide pratiche e simulazioni per testare le tue abilit\u00e0 tecniche e manuali.\n\nTest Attitudinali: Scopri i tuoi punti di forza con attivit\u00e0 mirate a identificare i settori in cui sei pi\u00f9 portato.\n\nEsplorazione del Sapere: Un viaggio interattivo attraverso diverse aree tematiche per capire quali ambiti stimolano maggiormente il tuo interesse.\n\nScelta Consapevole: Uno strumento coinvolgente per riflettere sul proprio futuro e ridurre l'incertezza nel passaggio alle superiori.\n\nIl futuro inizia dalla conoscenza di s\u00e9: esplora i tuoi talenti prima di scegliere il tuo prossimo percorso di studi.", "short_description": "Aiuta gli studenti di terza media a scoprire le proprie inclinazioni attraverso attivit\u00e0 pratiche, test attitudinali e sfide interattive per una scelta consapevole della scuola superiore."}, {"images": {"nodes": [{"file_name": "CoverArtTitolataPortrait.png", "id": "4431696520441516", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823351_4431696527108182_7060174588343904590_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXv_zYb5aIgQ7kNvwGbQ7RX&_nc_oc=AdoZxXqpZlJQSL5KE-efMqo5CQBSAW1FoMTbE6ATS80UyzIDOPgmUwOiMyl0EekQxrA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpem0SQqDgXjiZuAJF97c_sUlYFvzqbB7ud_Q95fF_qQ&oe=6A6F2517"}, {"file_name": "icona512x512.png", "id": "1624162438844874", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821702_1624162
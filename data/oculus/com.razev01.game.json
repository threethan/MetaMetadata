6885957773_3610941092769634389_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o734QymP57kQ7kNvwHToLkR&_nc_oc=AdkIHpxuubFfxtTEraQSbB1bUW4tIWdqZjzatGhlFXH7UVN7sE5Ql-HaDoNLYL8Om7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyXpZwQ9Ejwfo-_VmLukDMRtVyQ3whv8ZOxcdUxjMwDxw&oe=69BFE339"}, {"file_name": "Raze_01_03.png", "id": "738513365334701", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824076_738513368668034_1069377668876744109_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_Ao9LmoxO8Q7kNvwHosnla&_nc_oc=Adnton0d5Z-I0F8_rlHmnfzZORQYhbHlHzFyUO26p8cSrnUfTvkudHmQokTr3CqaFJ8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkjsendqpQAQaCfqsPCqQj7ITlVlN137Nbpqjgbuulxg&oe=69BFDA0D"}, {"file_name": "Raze_01_08.png", "id": "2491277537906016", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819417_2491277541239349_730312310095139208_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7EIQCR8MLcQ7kNvwFutRl2&_nc_oc=AdnqYZliV6-g946nfr2yuxi4mAe6zMGxDXUSprV5VpC2fxAtox1rhgyMLt32PicxV9A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzE2VW-35eN4rS_eiWecYp8CRll_B3JZ4yO8YdH55S5lQ&oe=69BFDBA6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raze Vol. 1", "keywords": ["platformer", "escape", "puzzle", "punkrock", "comedy"], "long_description": "**Raze Vol. 1** is a satirical punk rock VR puzzle-platformer where you team up with Raze\u2014a sharp-tongued leader of an underground punk band\u2014who gets zapped into a twisted alternate reality after a freak stage accident involving her guitar pedal and a collapsing amp. Now trapped in a bizarre, influencer-dominated world, you and Raze must work together to escape four surreal, influencer-run environments built to manipulate and control everyone's thoughts, tastes, and ultimately, spending habits.\n\nArmed with a glitching cybernetic arm that adapts to each world\u2014flame, freeze, electricity, tractor beam\u2014you\u2019ll solve brain-bending escape-room puzzles, platform through chaotic landscapes, and crush enemies in immersive VR. Dive directly into Raze\u2019s mind, shifting into first-person to unlock her perspective, or use her damaged eye to reveal hidden clues and subvert traps set by MgaFusion\u2019s corporate influencer overlords.\n\nThe game is voiced by **Lzzy Hale** of **Halestorm**, bringing Raze to life with raw, rebellious energy. The soundtrack features tracks from active punk and alt bands, fueling the action with real noise from the underground.\n\nWith a narrative full of satirical bite, genre-blending gameplay, and a heroine who embodies DIY ethos, anti-establishment rage, and pitch-black humor\u2014**Raze Vol. 1** is more than a VR game. It\u2019s a playable riot against toxic media, fake personas, and the commodification of rebellion.\n\nStory & Arcade Gameplay! ", "short_description": "Raze Vol. 1 is a satirical punk rock VR puzzle-platformer. Team up with Raze, a punk guitarist who\u2019s zapped mid-gig into a warped, annoying influencer-run world to escape bizarro worlds and battle enemies using her power arm. Dive into her mind (there\u2019s a potion for that!) and reveal hidden clues with her damaged eye. Voiced by Lzzy Hale of Halestorm and featuring by a soundtrack from active punk and alt bands \u2014this isn\u2019t just a game, it\u2019s a rebellion. Raze is gonna blaze!\nStory & Arcade play.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.creamproductions.com/raze-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cream Productions Inc.", "support_website_url": null, "website_url": "http://iamraze.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "528142316460358"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genre
Odq31il9lCUQBwew&oe=6B05B622"}, {"file_name": "Raze_01_05.png", "id": "703848025735301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507820112_703848029068634_5668971632879337133_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a3Pq2Qa9IzcQ7kNvwGiBGb6&_nc_oc=AdqhTiWCE1MKp0mvZFAv-d9_uBBlDIGW2y5A541hELZV4yg99YftyG1Gqkny7rzCxa0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrRDMximLsvzOK21mxUJ5nZ-UQ-sp_MK-n8ublIJvb5A&oe=6B05CE00"}, {"file_name": "Raze_01_04.png", "id": "1779636882624440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824081_1779636885957773_3610941092769634389_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcVY6DbD9HEQ7kNvwG3rxNq&_nc_oc=AdpWsaLqOVaQu8o11IeavUVpI7zLj4rN3U7PDNxO8-FmsAmsmMtSbjAHaBYOSPf8JPM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOb5yGu7IDg9cs5bfaVP_fRQaVve1Zg3c1Tmyqc6F9gQ&oe=6B05BDF9"}, {"file_name": "Raze_01_03.png", "id": "738513365334701", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824076_738513368668034_1069377668876744109_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCAvsGABNoEQ7kNvwE54wZs&_nc_oc=AdqlCGTUu4sx55GGopH8373qJ37rIt8amPI9LKBn_WJ52nsnye9LzPTYAdPMVCDnPhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBmfKG16P_YCSLMr_8wpq3_XKZE4twPrl5EMAf3kTjwA&oe=6B05B4CD"}, {"file_name": "Raze_01_08.png", "id": "2491277537906016", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819417_2491277541239349_730312310095139208_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEw0Z8Hop68Q7kNvwEmNXlH&_nc_oc=AdpFYB-RhMZxKsGkhFjpNpOd9tqBhnLLbXKC9IpeNXOBf7J5UDcFCDgq9kdLqIOujC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxUd_MYLX5OBRN-DqTITa_rL-eOALQzRUgHV9mnPT9Ig&oe=6B05B666"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Raze Vol. 1", "keywords": ["platformer", "escape", "puzzle", "punkrock", "comedy"], "long_description": "**Raze Vol. 1** is a satirical punk rock VR puzzle-platformer where you team up with Raze\u2014a sharp-tongued leader of an underground punk band\u2014who gets zapped into a twisted alternate reality after a freak stage accident involving her guitar pedal and a collapsing amp. Now trapped in a bizarre, influencer-dominated world, you and Raze must work together to escape four surreal, influencer-run environments built to manipulate and control everyone's thoughts, tastes, and ultimately, spending habits.\n\nArmed with a glitching cybernetic arm that adapts to each world\u2014flame, freeze, electricity, tractor beam\u2014you\u2019ll solve brain-bending escape-room puzzles, platform through chaotic landscapes, and crush enemies in immersive VR. Dive directly into Raze\u2019s mind, shifting into first-person to unlock her perspective, or use her damaged eye to reveal hidden clues and subvert traps set by MgaFusion\u2019s corporate influencer overlords.\n\nThe game is voiced by **Lzzy Hale** of **Halestorm**, bringing Raze to life with raw, rebellious energy. The soundtrack features tracks from active punk and alt bands, fueling the action with real noise from the underground.\n\nWith a narrative full of satirical bite, genre-blending gameplay, and a heroine who embodies DIY ethos, anti-establishment rage, and pitch-black humor\u2014**Raze Vol. 1** is more than a VR game. It\u2019s a playable riot against toxic media, fake personas, and the commodification of rebellion.\n\nStory & Arcade Gameplay! ", "short_description": "Raze Vol. 1 is a satirical punk rock VR puzzle-platformer. Team up with Raze, a punk guitarist who\u2019s zapped mid-gig into a warped, annoying influencer-run world to escape bizarro worlds and battle enemies using her power arm. Dive into her mind (there\u2019s a potion for that!) and reveal hidden clues with her damaged eye. Voiced by Lzzy Hale of Halestorm and featuring by a soundtrack from active punk and alt bands \u2014this isn\u2019t just a game, it\u2019s a rebellion. Raze is gonna blaze!\nStory & Arcade play.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.creamproductions.com/raze-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cream Productions Inc.", "support_website_url": null, "website_url": "http://iamraze.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "528142316460358"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9717818131634642"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "31227588580161639"}]}, "baseline_offer": {"id": "31227588580161639"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1756400400, "status": "PUBLISHED", "id": "31227588580161639"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24442126135443932", "version": "0.4.6"}, "id": "1330264998270826", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9717818088301313", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24442126135443932"}, "release_status": "RELEAS
PVQvc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMs3Es2Za8Cymg1ogpYxj-6BY9uD64NQQcr7Wt3FELjw&oe=69AAC7E1"}, {"file_name": "MovingCar.png", "id": "1413039096453782", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491828855_1413039099787115_2820054585149932811_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQnkJes9wJMQ7kNvwHh_R77&_nc_oc=Adm1WG84_Zzavs2D5lBvFVOr5FsiSqUOApqqL7q1issjnZ18x0tcBiyvwyMnT_kO8lM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfztFyvk4Nyo_2i_BukYuuCFdcB4HxCxst2WctN80ugjlw&oe=69AAB4D0"}, {"file_name": "Starlina02.png", "id": "1809864803264803", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822779_1809864806598136_8575946155505766252_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wtuyjc-hY6MQ7kNvwFmJqfw&_nc_oc=AdnucWDGQiBRJOojg2F3245YuAoS9gFup4pmfqq7rYj0mfoHCwatJp1FW-sL8hU5PyE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzwiawcmgnRxsx38f-4tVomcazLexc8yscBRaZNfsUaJw&oe=69AAB97A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 (1).png", "id": "1477243086630217", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499293201_1477243093296883_6557678459282323465_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvzL5WXde2MQ7kNvwHbN7Be&_nc_oc=AdlJpF4xpOgsHetbCtvQKVgbXzUa_kxBkNFTwKan9TlIit_muSRVGldfFzGsWrZ4fEw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afw8RcJRSTE9WunQfO63CT4jx1lPQTleSJlRzMmTLX2TGg&oe=69AAC1F9"}, "display_name": "Raze Vol. 1", "keywords": ["platformer", "escape", "puzzle", "punkrock", "comedy"], "long_description": "**Raze Vol. 1** is a satirical punk rock VR puzzle-platformer where you team up with Raze\u2014a sharp-tongued leader of an underground punk band\u2014who gets zapped into a twisted alternate reality after a freak stage accident involving her guitar pedal and a collapsing amp. Now trapped in a bizarre, influencer-dominated world, you and Raze must work together to escape four surreal, influencer-run environments built to manipulate and control everyone's thoughts, tastes, and ultimately, spending habits.\n\nArmed with a glitching cybernetic arm that adapts to each world\u2014flame, freeze, electricity, tractor beam\u2014you\u2019ll solve brain-bending escape-room puzzles, platform through chaotic landscapes, and crush enemies in immersive VR. Dive directly into Raze\u2019s mind, shifting into first-person to unlock her perspective, or use her damaged eye to reveal hidden clues and subvert traps set by MgaFusion\u2019s corporate influencer overlords.\n\nThe game is voiced by **Lzzy Hale** of **Halestorm**, bringing Raze to life with raw, rebellious energy. The soundtrack features tracks from active punk and alt bands, fueling the action with real noise from the underground.\n\nWith a narrative full of satirical bite, genre-blending gameplay, and a heroine who embodies DIY ethos, anti-establishment rage, and pitch-black humor\u2014**Raze Vol. 1** is more than a VR game. It\u2019s a playable riot against toxic media, fake personas, and the commodification of rebellion.\n\nStory & Arcade Gameplay! ", "short_description": "Raze Vol. 1 is a satirical punk rock VR puzzle-platformer. Team up with Raze, a punk guitarist who\u2019s zapped mid-gig into a warped, annoying influencer-run world to escape bizarro worlds and battle enemies using her power arm. Dive into her mind (there\u2019s a potion for that!) and reveal hidden clues with her damaged eye. Voiced by Lzzy Hale of Halestorm and featuring by a soundtrack from active punk and alt bands \u2014this isn\u2019t just a game, it\u2019s a rebellion. Raze is gonna blaze!\nStory & Arcade play.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.creamproductions.com/raze-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cream Productions Inc", "support_website_url": null, "website_url": "http://iamraze.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24423672490622630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830887_3155856441230673_8083665750414869622_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BII5goFcCgQQ7kNvwGRUb1W&_nc_oc=AdnVgl498zJDOoovKHHtolUdNrqbnWbl2lExzEPAOl8SNzNoUv_N8F3qw53pXIqdHuI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZAgBr86qfm4Joa_Z0HOnlRPIg0--GfvaR-XT-3pZ38Q&oe=69AACD54"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Raze Vol. 1", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1756400400, "lastRevision": {"nodes": [{"id": "9717818198301302", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "9717818088301313", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1405118797463004"}, "iarc_emai
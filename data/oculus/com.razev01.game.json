/scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819385_1150926873464290_4494313915624124602_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zkz1FUu09DYQ7kNvwHtubYN&_nc_oc=Adok8sF4WxFaCEtHXEbGOmUflQCdJVByZ7DlzowLw7_EqxIJSRcTHeokn4esrZ97fGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2I9eFCN2-FlX7H0B6SB0CWMBoq-CmONOnbGf9syNY1w&oe=6AFDD1A1"}, {"file_name": "MovingCar.png", "id": "1413039096453782", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828855_1413039099787115_2820054585149932811_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2gtI1J7WKoQ7kNvwHnZzJr&_nc_oc=Ado9mxBHvGuGkOuRgzn422T1hA1VrpL_dueKF7vipTBPdToVNowX--2OVT9-6goi60A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1N457gZkjsGEzNO24mxE4tS7xLMDAKvgy2ttWP9_aQQ&oe=6AFDBE90"}, {"file_name": "Starlina02.png", "id": "1809864803264803", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822779_1809864806598136_8575946155505766252_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4tiUFpHgc4Q7kNvwEI7RX8&_nc_oc=AdqDp6B1agWm8MMY6WpcMy3HYAefMrMDnxM0Bg0tKzTp1-1KG6rSOdEHzZzxwVGOU4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-B06W5iQZ0xrEIymPePwKAoTWQyvAlVieHu5orOzrNw&oe=6AFDC33A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 (1).png", "id": "1477243086630217", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499293201_1477243093296883_6557678459282323465_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpG3_HT2HMsQ7kNvwEjgSO1&_nc_oc=AdqN999ce62s9Q-6798GRh_71H-QukWoHfYQrSijXiaESB57_KcGJ8UW-UoN5FmIykE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-g-Y6wWXysbacAXI8pk9t8T1FxjShzeoZs0tAAH7tKw&oe=6AFDCBB9"}, "display_name": "Raze Vol. 1", "keywords": ["platformer", "escape", "puzzle", "punkrock", "comedy"], "long_description": "**Raze Vol. 1** is a satirical punk rock VR puzzle-platformer where you team up with Raze\u2014a sharp-tongued leader of an underground punk band\u2014who gets zapped into a twisted alternate reality after a freak stage accident involving her guitar pedal and a collapsing amp. Now trapped in a bizarre, influencer-dominated world, you and Raze must work together to escape four surreal, influencer-run environments built to manipulate and control everyone's thoughts, tastes, and ultimately, spending habits.\n\nArmed with a glitching cybernetic arm that adapts to each world\u2014flame, freeze, electricity, tractor beam\u2014you\u2019ll solve brain-bending escape-room puzzles, platform through chaotic landscapes, and crush enemies in immersive VR. Dive directly into Raze\u2019s mind, shifting into first-person to unlock her perspective, or use her damaged eye to reveal hidden clues and subvert traps set by MgaFusion\u2019s corporate influencer overlords.\n\nThe game is voiced by **Lzzy Hale** of **Halestorm**, bringing Raze to life with raw, rebellious energy. The soundtrack features tracks from active punk and alt bands, fueling the action with real noise from the underground.\n\nWith a narrative full of satirical bite, genre-blending gameplay, and a heroine who embodies DIY ethos, anti-establishment rage, and pitch-black humor\u2014**Raze Vol. 1** is more than a VR game. It\u2019s a playable riot against toxic media, fake personas, and the commodification of rebellion.\n\nStory & Arcade Gameplay! ", "short_description": "Raze Vol. 1 is a satirical punk rock VR puzzle-platformer. Team up with Raze, a punk guitarist who\u2019s zapped mid-gig into a warped, annoying influencer-run world to escape bizarro worlds and battle enemies using her power arm. Dive into her mind (there\u2019s a potion for that!) and reveal hidden clues with her damaged eye. Voiced by Lzzy Hale of Halestorm and featuring by a soundtrack from active punk and alt bands \u2014this isn\u2019t just a game, it\u2019s a rebellion. Raze is gonna blaze!\nStory & Arcade play.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.creamproductions.com/raze-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cream Productions Inc", "support_website_url": null, "website_url": "http://iamraze.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}, {"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24423672490622630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830887_3155856441230673_8083665750414869622_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OK8GuAcOaqAQ7kNvwGtKDz7&_nc_oc=AdqYFilnq2gdw-ug75LEsiq87p-kpskVEBS01evO96C6n2rsQ0zdWO-jhpRcrv2QGq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB1m4s50_eYVaVL0hqJU3qu3bdUAcb7G94TcuEC9Iw2w&oe=6AFDD714"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Raze Vol. 1", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "rele
dSosP0Gml7yV1T6RsOjCimltrsMO5Lc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pmn_LM1UolVtSI23N3_eTC0jk0bz3VXYWajhWrb8StQ&oe=6A341C21"}, {"file_name": "MovingCar.png", "id": "1413039096453782", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828855_1413039099787115_2820054585149932811_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3DctbBLOVUQ7kNvwHIn7Fo&_nc_oc=AdptZ58T5aTWiyUyiYseDPrVdP946aTjrNKQz5jcRSA_7G8CuvbOTjJcTjfHdE_AebE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SGlSfR1rvmLj1Wc_gcKs0JTg0ySeklg9dbGmlfYheGQ&oe=6A340910"}, {"file_name": "Starlina02.png", "id": "1809864803264803", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822779_1809864806598136_8575946155505766252_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7igyqvhM7JgQ7kNvwEM9MAE&_nc_oc=AdouBMmbcMkly6R3qil7RCiKROjmecHq_SPfkQ5fXqce43nZ1K05XooyHkdgvs81Po8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HitPKuCbNHqBCDk1CpVnQuDAoicLetj4Uj2jG3kIa1w&oe=6A340DBA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 (1).png", "id": "1477243086630217", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499293201_1477243093296883_6557678459282323465_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsxmU4XKTzoQ7kNvwGaZLOc&_nc_oc=AdqnA-90rNOu1htn7r1fHItcjqjvsxxoPtndJxggkrDN7gmpTqZOPnfsN9_6e68LQmw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r4JFhsSiTxw2qgsKHpJz1S-Dh5z-4x919lUTmfJvBFQ&oe=6A341639"}, "display_name": "Raze Vol. 1", "keywords": ["platformer", "escape", "puzzle", "punkrock", "comedy"], "long_description": "**Raze Vol. 1** is a satirical punk rock VR puzzle-platformer where you team up with Raze\u2014a sharp-tongued leader of an underground punk band\u2014who gets zapped into a twisted alternate reality after a freak stage accident involving her guitar pedal and a collapsing amp. Now trapped in a bizarre, influencer-dominated world, you and Raze must work together to escape four surreal, influencer-run environments built to manipulate and control everyone's thoughts, tastes, and ultimately, spending habits.\n\nArmed with a glitching cybernetic arm that adapts to each world\u2014flame, freeze, electricity, tractor beam\u2014you\u2019ll solve brain-bending escape-room puzzles, platform through chaotic landscapes, and crush enemies in immersive VR. Dive directly into Raze\u2019s mind, shifting into first-person to unlock her perspective, or use her damaged eye to reveal hidden clues and subvert traps set by MgaFusion\u2019s corporate influencer overlords.\n\nThe game is voiced by **Lzzy Hale** of **Halestorm**, bringing Raze to life with raw, rebellious energy. The soundtrack features tracks from active punk and alt bands, fueling the action with real noise from the underground.\n\nWith a narrative full of satirical bite, genre-blending gameplay, and a heroine who embodies DIY ethos, anti-establishment rage, and pitch-black humor\u2014**Raze Vol. 1** is more than a VR game. It\u2019s a playable riot against toxic media, fake personas, and the commodification of rebellion.\n\nStory & Arcade Gameplay! ", "short_description": "Raze Vol. 1 is a satirical punk rock VR puzzle-platformer. Team up with Raze, a punk guitarist who\u2019s zapped mid-gig into a warped, annoying influencer-run world to escape bizarro worlds and battle enemies using her power arm. Dive into her mind (there\u2019s a potion for that!) and reveal hidden clues with her damaged eye. Voiced by Lzzy Hale of Halestorm and featuring by a soundtrack from active punk and alt bands \u2014this isn\u2019t just a game, it\u2019s a rebellion. Raze is gonna blaze!\nStory & Arcade play.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.creamproductions.com/raze-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cream Productions Inc", "support_website_url": null, "website_url": "http://iamraze.com/", "category": n
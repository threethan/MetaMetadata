b-FOjaAJ4HYavj6-VzLtgLl896DNHAc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eZzGpMMrDMUBH5BnHPFI_WJzpgzm0l1qffuEoFKZlpA&oe=6A3140E1"}, {"file_name": "MovingCar.png", "id": "1413039096453782", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828855_1413039099787115_2820054585149932811_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuzOn6B1O_sQ7kNvwFpQnDf&_nc_oc=AdoygixKWZ0ZAfFwU-qz56mqjqRAQabj7ynuh1qtNFkz-jX6_TIX4978COLSHLwBGb0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vA0HtiU_aoqnjXuOT83NjUXhSn6Mf0lbWgh4R1U_s9A&oe=6A316610"}, {"file_name": "Starlina02.png", "id": "1809864803264803", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822779_1809864806598136_8575946155505766252_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7igyqvhM7JgQ7kNvwHtOjxU&_nc_oc=Adqdb8qwsl4YFAAjjnq-WQ5cn7HkKrZjtnCnkM0XSynnyAA0Uj85frdj03l2_ig1gzk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pkIBKikoWOoP3KJTcPLUVmtHNFjQHtEfXI94WQcLbbA&oe=6A316ABA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 (1).png", "id": "1477243086630217", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499293201_1477243093296883_6557678459282323465_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsxmU4XKTzoQ7kNvwHL76Ff&_nc_oc=Adr_U7ZKgh9kD4ogtcLT3jT3npf5-1Er5zBZgwgTMwLGMOzz51IEiXpAOsUtH4PHPBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WKATv2I_3N1kgGia54XHbdOLTHNmdzNzZqLo5fVoaLQ&oe=6A317339"}, "display_name": "Raze Vol. 1", "keywords": ["platformer", "escape", "puzzle", "punkrock", "comedy"], "long_description": "**Raze Vol. 1** is a satirical punk rock VR puzzle-platformer where you team up with Raze\u2014a sharp-tongued leader of an underground punk band\u2014who gets zapped into a twisted alternate reality after a freak stage accident involving her guitar pedal and a collapsing amp. Now trapped in a bizarre, influencer-dominated world, you and Raze must work together to escape four surreal, influencer-run environments built to manipulate and control everyone's thoughts, tastes, and ultimately, spending habits.\n\nArmed with a glitching cybernetic arm that adapts to each world\u2014flame, freeze, electricity, tractor beam\u2014you\u2019ll solve brain-bending escape-room puzzles, platform through chaotic landscapes, and crush enemies in immersive VR. Dive directly into Raze\u2019s mind, shifting into first-person to unlock her perspective, or use her damaged eye to reveal hidden clues and subvert traps set by MgaFusion\u2019s corporate influencer overlords.\n\nThe game is voiced by **Lzzy Hale** of **Halestorm**, bringing Raze to life with raw, rebellious energy. The soundtrack features tracks from active punk and alt bands, fueling the action with real noise from the underground.\n\nWith a narrative full of satirical bite, genre-blending gameplay, and a heroine who embodies DIY ethos, anti-establishment rage, and pitch-black humor\u2014**Raze Vol. 1** is more than a VR game. It\u2019s a playable riot against toxic media, fake personas, and the commodification of rebellion.\n\nStory & Arcade Gameplay! ", "short_description": "Raze Vol. 1 is a satirical punk rock VR puzzle-platformer. Team up with Raze, a punk guitarist who\u2019s zapped mid-gig into a warped, annoying influencer-run world to escape bizarro worlds and battle enemies using her power arm. Dive into her mind (there\u2019s a potion for that!) and reveal hidden clues with her damaged eye. Voiced by Lzzy Hale of Halestorm and featuring by a soundtrack from active punk and alt bands \u2014this isn\u2019t just a game, it\u2019s a rebellion. Raze is gonna blaze!\nStory & Arcade play.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.creamproductions.com/raze-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cream Productions Inc", "support_website_url": null, "website_url": "http://iamraze.com/", "category": n
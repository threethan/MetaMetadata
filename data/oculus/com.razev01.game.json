1OV4-2noRmnrfbkeokQGST3-noGJMl0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGccCEbpG6DrJ1kk8Dma30q7QLteGeXICYqV3U_5OOQxA&oe=6A747D61"}, {"file_name": "MovingCar.png", "id": "1413039096453782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828855_1413039099787115_2820054585149932811_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWq0IKjUSVUQ7kNvwEJHlaW&_nc_oc=AdqkoFhS4L6nvkQKwxmT205xB6uXkW5PgHmq1IUbi2Dab1pkfJ7y5VPPE6tqjoCIw3w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2t2uLyRuad1_T9ft4NLsGEm204YBX_LZK4A7YQ3DHJw&oe=6A74A290"}, {"file_name": "Starlina02.png", "id": "1809864803264803", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822779_1809864806598136_8575946155505766252_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BLgPL-v1ZRMQ7kNvwGVOPTL&_nc_oc=AdoEYj3C_c0Nzd9cd1P9m5Ono8oDEx0KO_lczup8JMoRWRppz3d-UX1-Ppwk7BacyVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxLOc0BpCn1AVg_Gyf0auW-R4BA5_uNX_nqdDjHsS8eQ&oe=6A74A73A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560 (1).png", "id": "1477243086630217", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499293201_1477243093296883_6557678459282323465_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nffiDLOaJGoQ7kNvwF8hRCi&_nc_oc=Adr2LTktWZKIJJNbETAuFHQrBAaO9C4RNPOAWUJJ6ZldLil8GCHODru_BHrG6JdZNJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTASVlgWnuzz6FVXKy0ChL1T6u6W4ASqp1VT4s0L_CFQ&oe=6A747779"}, "display_name": "Raze Vol. 1", "keywords": ["platformer", "escape", "puzzle", "punkrock", "comedy"], "long_description": "**Raze Vol. 1** is a satirical punk rock VR puzzle-platformer where you team up with Raze\u2014a sharp-tongued leader of an underground punk band\u2014who gets zapped into a twisted alternate reality after a freak stage accident involving her guitar pedal and a collapsing amp. Now trapped in a bizarre, influencer-dominated world, you and Raze must work together to escape four surreal, influencer-run environments built to manipulate and control everyone's thoughts, tastes, and ultimately, spending habits.\n\nArmed with a glitching cybernetic arm that adapts to each world\u2014flame, freeze, electricity, tractor beam\u2014you\u2019ll solve brain-bending escape-room puzzles, platform through chaotic landscapes, and crush enemies in immersive VR. Dive directly into Raze\u2019s mind, shifting into first-person to unlock her perspective, or use her damaged eye to reveal hidden clues and subvert traps set by MgaFusion\u2019s corporate influencer overlords.\n\nThe game is voiced by **Lzzy Hale** of **Halestorm**, bringing Raze to life with raw, rebellious energy. The soundtrack features tracks from active punk and alt bands, fueling the action with real noise from the underground.\n\nWith a narrative full of satirical bite, genre-blending gameplay, and a heroine who embodies DIY ethos, anti-establishment rage, and pitch-black humor\u2014**Raze Vol. 1** is more than a VR game. It\u2019s a playable riot against toxic media, fake personas, and the commodification of rebellion.\n\nStory & Arcade Gameplay! ", "short_description": "Raze Vol. 1 is a satirical punk rock VR puzzle-platformer. Team up with Raze, a punk guitarist who\u2019s zapped mid-gig into a warped, annoying influencer-run world to escape bizarro worlds and battle enemies using her power arm. Dive into her mind (there\u2019s a potion for that!) and reveal hidden clues with her damaged eye. Voiced by Lzzy Hale of Halestorm and featuring by a soundtrack from active punk and alt bands \u2014this isn\u2019t just a game, it\u2019s a rebellion. Raze is gonna blaze!\nStory & Arcade play.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.creamproductions.com/raze-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cream Productions Inc", "support_website_url": null, "website_url": "http://iamraze.com/", "category": n
o be efficient. ", "short_description": "Shooting Practise is designed to improve you aiming skills, so you can survive in Multiplayer Shooter. Even the best strategy does not help, if you are not able to aim and shoot quickly. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://logic-horizon.com/privacy-policy/", "developer_terms_of_service_url": "https://logic-horizon.com/termsconditions/", "publisher_name": "BrownBuckGames", "support_website_url": null, "website_url": "https://logic-horizon.com/shooting-practise/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9280079665347344"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982689_524520214077519_3853889678739979404_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X6W_OroLFkQ7kNvwEY7dd8&_nc_oc=Adq4EZkjttCvTB2ZVD0tANghUQrJOhvk0AXKT0niC61p9B1w63OL3a77d9AaFqc_OI8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5StUlPN3_wACnf8L_Q2G0QDsecKbsPd_qZEl7CmD5aAQ&oe=69FDFF37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shooting Practise", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"
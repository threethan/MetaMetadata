0a&_nc_ohc=y0t3WQpqjxQQ7kNvwHSe9Rx&_nc_oc=AdqcJWMJRpN3y7QD26ZL7-nb0x0d1zRg7U_e2C1HZ-pAO2bC7c4GkSPUG_BzoO96bSQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvlIWax-VFArQxAPtJa7g0QtGX9NwO4SqHdah0rP_0hQ&oe=6AFC8E7E"}, {"file_name": "9.png", "id": "2079717355560130", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031609_2079717358893463_8771329512861211721_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oYo397Q16ZoQ7kNvwFDKDxz&_nc_oc=Adqn2OacDbGvKbHh3sCqFdNjmTLW9om0RmD7hKQDA76t9uTupTqNR6K7Ye-UG1Xx0Io&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAxqyd5x-VZZidyiBoLKWT66vGdKsqK0T7Hi_Uo2BKOA&oe=6AFC7834"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art 2560x1440 (1).png", "id": "531077289237999", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031609_531077292571332_8393939499051798506_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LSCnMrzzEI0Q7kNvwFfUWGH&_nc_oc=AdroGLPRM6JGnllhDXGLANjx2oM4VIfVhLCTmaoOqRBhhqrTt2LSiOOcYkv1HOo3wPk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdT0fiHAyGYraoLKHeM_L1DkTey0rsvjEPschqQC-_9Q&oe=6AFC5E3C"}, "display_name": "Titans Clinic - Free Demo", "keywords": [], "long_description": "Explore Titans Clinic - a casual VR game, you are a dental doctor for the Titans! A titan comes to you with problems and your task is to find solutions for them using various tools inside the game! \n\nTEETH CLEANING\nIt's not every day people brush their teeth, but customers want it more often!\n\nCARIES DESTRUCTION\nDestroy caries in every way you can think of!\n\nX-RAY\nWith this tool, you will be able to see the hidden problems in the mouth of a titan!\n\nPICKAXE\nDo you think you're in the sandbox? Yes, that is right! Destroy caries and tartar. And not only\u2026\n\nDRILL\nYou can\u2019t destroy the mountain, but it will help a lot in healing!\n\nVACUUM CLEANER\nSucking is not always a sin, especially if you are a vacuum cleaner!\n\nHEAL GUN\nWhen you are very sloppy and messy, this particular tool will come to the rescue!\n\nTOOTH CREATION PANEL\nOnly 1 percent of the people in this game can make 100 different teeth!\n\nINCRUSTATION\nDiamonds, silver, gold, beautiful accessories - all this can decorate the smile of the titans. Mustache too, why not...\n\nPLIERS\nIf the titan as a client is very picky, then this might help...\n\nKEY FEATURES:\nCustomize: In the game, you have the opportunity to create a unique jaw for each client!\nTools variety: Brush, pliers, heal gun, pickaxe, drill, x-ray, vacuum cleaner - all this will help you and your clients!\nFun: Mixing different incrustation elements, tooth shapes, and tooth materials will give you unique smiles and jaws of titans!\nComfort: In our game, you will have co", "short_description": "The Titans are in trouble - help them treat their problem!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://newfolderstudio.com/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "NEW FOLDER GAMES LTD", "support_website_url": null, "website_url": "https://newfolderstudio.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3432298987011845"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "538052442697516"}, {"status": "PUBLISHED"
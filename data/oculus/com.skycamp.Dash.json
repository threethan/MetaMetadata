701707", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618274_1633470658035040_1387256766995943077_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73JzyAKi8TcQ7kNvwF4P9xh&_nc_oc=Adq0D3zQqo_a0In4Mo9dbvaEp2whSXPpKsai4W90YW8ILvJIgtqpm88RrE8YGByQuzU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6-TRQJHy6nRwWw6AZjyuTQ-RCQ5mITNkqazCYxgbo6A&oe=6AA01FD8"}, "display_name": "D.A.S.H.", "keywords": ["parkour", "racing", "runner", "endless", "cyber"], "long_description": "As a cybernetic agent dispatched by humanity to counter OMEGA \u2014 a super-intelligent AI system plotting to annihilate humankind \u2014 your codename is D.A.S.H. (short for Dual Axle Speed Hawk). After you successfully implanted the virus, the emergency protocol in OMEGA\u2019s HQ was activated and your mission is simple: DASH TO SURVIVE!\n\n**Temple Run Meets VR**\n\nA gameplay loop that\u2019s easy to pick up yet insanely addictive. Dash with the dynamic rock-electronic BGM as you ignite dopamine in sleek, cyberpunk-themed neon pipes.\n\n\n**VR-Optimized Parkour Controls**\n\nShift dual light wheels for quick direction swift and deploy a laser grappling hook to leap over obstacles. Dodge massive chip traps and use the power-ups wisely to run further.\n\n\n**Upgrade & Unlock Boosts**\n\nCollect byte coins to unlock power-ups like Magnet, Multiplier, and Shield. Push your limits round after round to beat your highest score.\n\nAs humanity\u2019s last hope against the rogue super-AI \u2014 can you make it out alive?\n", "short_description": "D.A.S.H. (short for Dual Axle Speed Hawk) is the VR endless runner: easy to pick up, brutal to master, and highly addictive. Built for VR, D.A.S.H. redefines endless running with intuitive VR controls for smooth obstacle dodging\u2014until the challenge spikes.\n\nDodge hazards, upgrade gear to push limits, and compete globally for top leaderboard spots. A quick thrill or high-score grind, D.A.S.H. hooks you from your first sprint."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skycamp-studio.github.io/Home/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Skycamp Studio", "support_website_url": null, "website_url": "https://skycamp-studio.github.io/Home/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN", "zh_HK", "zh_TW", "ja", "fr_BE", "fr_CA", "fr", "de", "de_CH", "it", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "pt_BR", "pt", "ru", "ru_UA", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9034119096712330"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2147513845785060"}, {"status": "PUBLISHED", "id": "2632055730508738"}, {"status": "PUBLISHED", "id": "4159801980907705"}, {"status": "PUBLISHED", "id": "3700965063369123"}]}, "baseline_offer": {"id": "3700965063369123"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "2147513845785060"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9760498944074338", "version": "1.0"}, "id": "1323615149148221", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename
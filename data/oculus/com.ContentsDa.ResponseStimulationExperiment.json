9_899529742152751_3356553972096000486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKBJRbKNZX8Q7kNvwHDtCuf&_nc_oc=AdnrlUsHWRNNC0jPAvSFGXYOPs1fOf3OAUzrG9sD1u73YKSPCiTBF2iIV8syVb0Jea4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afue6qxaxgf-ZtS9pmOSL3tzLXZUr5NgENk09mV6vTJJkQ&oe=69A96325"}, {"file_name": "ApplicationFrameHost_ryEErQjKGZ.png", "id": "1594586524468382", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982451_1594586531135048_2510921839297879906_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcEzsraMvxMQ7kNvwGls2Aq&_nc_oc=AdndLSqSa-S8xpTxX6Dp3YespBX7b9fb2KwGsqBFWfE5kFOLCbiU-RAGb2vgUFj2d1Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs9jKJx2o2ML206xmNjis8O1dc3F1XY9fdNvV7Eurc9Qg&oe=69A96342"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Response Stimulation_Landscape.png", "id": "1505811293485114", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75355155_1505811296818447_6089045940579417558_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tzh0Bp4eAywQ7kNvwE4jm79&_nc_oc=AdmUqF0KBmSN_drO79NnnuRRE4cfoxrN7gLQ9iQSXcgDdRcbuUxPSkYLQGd5NV-SIS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftSupNJth9LxQwIbBR0sOLtMDJ3A6Y_8bk2On1zRThXKA&oe=69A98CB3"}, "display_name": "Response Stimulation Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "biology", "response", "science", "contentsda"], "long_description": "1. Watch and catch the ruler falling in a well-lit area.\n2. Listen to the sound of the ruler falling in the dark and catch it.\n\n<Result\n1. when looking and catching: light stimulus \u2192 visual cell \u2192 visual nerve \u2192 cerebrum \u2192 spinal cord \u2192 motor nerve \u2192 hand muscle \u2192 reaction (catching the ruler)\n2 When listening and grasping: sound stimulus \u2192 auditory cells \u2192 auditory nerve \u2192 cerebrum \u2192 spinal cord \u2192 motor nerve \u2192 hand muscles \u2192 response (grasping the ruler)\n\n Understand that this is due to the different pathways the stimulus travels and the different speeds at which the brain processes information about the stimulus", "short_description": "Experiment with the difference in reaction time between catching a falling ballpoint pen in virtual reality using sight and hearing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8773653436089292"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57569423_373322982098572_4602769949033781431_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YJ-qxlbVctAQ7kNvwHsPhHi&_nc_oc=AdmxDMu6eQSirzs1cD0EoFahZNcuKJGXHLdB28xMG0aryeg4s4P40Nvd5GZGC51BsMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsHamgFzh7QTgqcp9VtM_3U_C_1bZ7xfupVwFj9fYxASw&oe=69A9833C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Response Stimulation Experiment - ContentsDa Science Experiment", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "
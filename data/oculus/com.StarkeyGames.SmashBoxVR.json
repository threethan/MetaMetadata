E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvUC-DFsqjOkV7qVivn1YtuSPWeBZJaHY7_wSLFkkgdIQ&oe=699C4E32"}, {"file_name": "Screenshot4.png", "id": "773080018977067", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304084_773080022310400_5309348799631564994_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EID1VpsI5rsQ7kNvwHAGQlJ&_nc_oc=AdlrwmHmEmQO2HK42U2Ef6jwbEGrwKbqFONf-vonhrM0TAg7yef-XExCq0UUGhKowjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfstS8duYacgfKS1OVcg93IeTPDY1dKwwPx_6yCx8SCZJA&oe=699C4DE6"}, {"file_name": "Screenshot5.png", "id": "1138572974893186", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499296278_1138572978226519_8119699990807229295_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cmR6bo5xLwQ7kNvwEg8kN0&_nc_oc=AdlumgbncVPdA1QAWH3Qsz_mJiJm3Arh_CUrR15UJTS6Bvd4U_WTkPXah4uzNZJV_uo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft64QWItfe-wicd0w9Qa_3woNbYMpM0vHKHTEnhcW2EDA&oe=699C57CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SmashBoxVR", "keywords": [], "long_description": "Step into a high-intensity VR world where blocks fall from the sky \u2014 and your fists are the only answer.\nSmashBox VR is a no-music, no-rules boxing workout built for gamers who want to sweat, crush, and keep coming back for one more round. Each block has its own health bar, and only your speed and power can break it before the timer runs out. Smash it, and a tougher one drops. Fail, and the challenge resets \u2014 simple, brutal, and addictive.\n\nSmashBox VR adapts to your pace for a true HIIT-style workout in virtual reality. Whether you\u2019re warming up for a PvP boxing match, stress-smashing after work, or chasing your next endurance streak, this is your cube-breaking dojo.\n\nFeatures:\n\ud83e\uddf1 20 unique block types with distinct feel and physics\n\u23f1 Timed smash rounds \u2014 break it or retry\n\ud83d\udd25 HIIT without music \u2014 pure focus and flow\n\u2699\ufe0f Progressive challenge \u2014 harder cubes, same clock", "short_description": "Punch hard, smash cubes, and burn calories in this high-intensity VR boxing challenge. Break each block before time runs out \u2014 no music, no rules, just pure motion and destruction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://smashboxvr.netlify.app/smashbox-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "StarkeyGames", "support_website_url": null, "website_url": "https://smashboxvr.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31445993345015043"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "796628983062466"}]}, "baseline_offer": {"id": "796628983062466"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760687880, "status": "PUBLISHED", "id": "796628983062466"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "32113540661593638", "version": "0.2"}, "id": "2166285113839364", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "31445993321681712", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "32113
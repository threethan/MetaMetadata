 experience that keeps you on the edge of your seat", "short_description": "Dangerous Vehicles: VR Road Crossing Adventure\nDive into the thrilling chaos of Dangerous Vehicles, a VR game where your mission is to safely cross bustling roads filled with speeding vehicles. Test your reflexes and timing as you navigate through traffic, dodge cars, and find the perfect moment to sprint across. With immersive VR gameplay and realistic urban environments"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dangerous-vehicles/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VP Invention", "support_website_url": null, "website_url": "https://sites.google.com/view/dangerous-vehicles", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7837930746326356"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035358_2141679066215879_816895994027322912_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vV0kS4SvFAcQ7kNvwHdtfsf&_nc_oc=AdnuHKemKzbr62UvNW3vNh9Ljdru66tdlBFDGgRNBXUN6RjkRMobUhxVOHqM8LYeiYU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRLoaxmXzEH2Me85T-DYeF_g_IwCo7CI5-ARTK6sesmg&oe=69BE9D71"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dangerous Vehicles", "
_sid=6e7a0a&_nc_ohc=GbOK7bYXvKEQ7kNvwHo0SdR&_nc_oc=Adq-fUyQ8A8c6vCpHMp3tJf4dYFpyBWI4zgqAPjXaL8wYwfbA4VBMTgIA4dViNXLMYA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw6tQ6A_fMRGRjdBCf0sNRQHV_Mrvf7-8bYmIrnb3YzQ&oe=6A881F8D"}, {"file_name": "5.png", "id": "1729816754565169", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824560_1729816757898502_3200623509332299434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bkZqYga0O0Q7kNvwE0gAT_&_nc_oc=AdoP7i2AIkHgS_ewAZ8SFdy7amHE80gp2TNr_0na808JNhKe0Gf3DaAf-b3ia9utJoI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzneUxkSHtI57wqb7KBfC613zGQQTwoD9_6DWBysQEhw&oe=6A882D4C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440 (11).png", "id": "1354180016746633", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820428_1354180020079966_3730687944046423316_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMHDtiDRUBAQ7kNvwHjF7xe&_nc_oc=Adof8T91zqGjGlVkOyeyy42R9p9ldmaJOCFGRC9BiaI_5OphgAHjutzUENjdbcNNKGw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEoenIu09aJuZcas8ChpmFGWu7eKdKIfbF4SVNYYsoUGA&oe=6A8827E1"}, "display_name": "Gorilla Runner - Banana Dash", "keywords": ["animal", "rush", "baboon", "parkour", "tag"], "long_description": "# Get Ready To Unleash Your Inner Gorilla In This Wild VR Dash Adventure! \n\n\n**Unleash Your Gorilla Power**\n\nJump, climb, and dash your way through fast-paced obstacles, improving your speed and reflexes. Each level brings new challenges that push your skills to the limit, ensuring a fun and dynamic experience every time you play!\n\n{1163512665826790}\n\n**Gorilla Dash: Outrun the Chaos!**\n\nLeap, dodge, and sprint through wild environments as a Gorilla. Can you stay one step ahead of the madness?\n\n{1054144750250401}\n\n**Collect Bananas and Conquer Obstacles**\n\nBecome a Gorilla, dodge obstacles, and collect all the bananas in this action-packed adventure. The race to the top starts now!\n\n\n{1664056530954124}", "short_description": "Swing, jump, climb, and dash through thrilling obstacle courses packed with jungle traps, tricky jumps, and fast-paced fun. Conquer 10 action-packed levels, each more wild and challenging than the last! Race against time, test your reflexes, and dominate the jungle with powerful gorilla moves. Whether you're leaping across vines or dodging jungle hazards, every run is a wild ride!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33540092502270825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819356_1444647880472560_6216543196363910097_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PL30MThg_TwQ7kNvwGMkFjv&_nc_oc=Adrytz4rS50BJaupqVjeYimS7crBApbFq9UfTZzqMdDGWUa8IbFIIe4bvaEATWjfkik&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdT6kDGzHK8--TjTxSWutCTUKq2ifl9lCcahfVYnGryQ&oe=6A8846AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Runner - Banana Dash"
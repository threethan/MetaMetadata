/499312439_1193177065911064_4648995657536586294_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEDTIxgQ9csQ7kNvwFyjR5Y&_nc_oc=AdrKX6yYsL8FKMSS9dmAmfUR1Tmz7yHrqA7NgPGq6vEvmhzHur3vm7MDQEgBWW2GNSE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qghc5HobhlCxDbJYvUfW085UnbR0xsB4DU7ZD1EEYFw&oe=6A369D92"}, {"file_name": "4.png", "id": "1103718284583809", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499300678_1103718287917142_6100558851514025561_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AmskiOnDj0oQ7kNvwG3AvIG&_nc_oc=Adp8Zjh5lizzVjVSbkx0FdbM31Sj1ZO5aXwH85UFMS62ATQWzWJthCA_9gkVdwx00TA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-JJBoH1-nZVvDg_6bHavinmv6CaMFEARfxFm3chZSSaA&oe=6A36AF65"}, {"file_name": "3 (1).png", "id": "744144771585678", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308010_744144774919011_2345049285269105217_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wk99jPrK6RYQ7kNvwFoRrq8&_nc_oc=AdokwVvZqmMDCsMGLK4XXP2S6MGXiYW9S3p-Q1uthe08mSdVzjGmQ1nPP1HSx7HYlPM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dmk4HNJW7Miepdt8SESvh0f6ULOYrKt_S-iV2ByGo8w&oe=6A369ACD"}, {"file_name": "5.png", "id": "1729816754565169", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491824560_1729816757898502_3200623509332299434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGVzuVcv-58Q7kNvwFEYzHb&_nc_oc=AdpPvqCzefb_RMhr53DPlErqQhbHDX7yGmS8RusZjPKv-z-hFRF0TxZ_UMSIM-RyIKc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dJt41M8Wlmp7D66gT0DcRIHo6bZTUGrjKHrkC4-91Ug&oe=6A36A88C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Fun Dash VR - Run & Jump", "keywords": ["animal", "rush", "baboon", "parkour", "tag"], "long_description": "# Get Ready To Unleash Your Inner Gorilla In This Wild VR Dash Adventure! \n\n\n**Unleash Your Gorilla Power**\n\nJump, climb, and dash your way through fast-paced obstacles, improving your speed and reflexes. Each level brings new challenges that push your skills to the limit, ensuring a fun and dynamic experience every time you play!\n\n{1163512665826790}\n\n**Gorilla Dash: Outrun the Chaos!**\n\nLeap, dodge, and sprint through wild environments as a Gorilla. Can you stay one step ahead of the madness?\n\n{1054144750250401}\n\n**Collect Bananas and Conquer Obstacles**\n\nBecome a Gorilla, dodge obstacles, and collect all the bananas in this action-packed adventure. The race to the top starts now!\n\n\n{1664056530954124}", "short_description": "Swing, jump, climb, and dash through thrilling obstacle courses packed with jungle traps, tricky jumps, and fast-paced fun. Conquer 10 action-packed levels, each more wild and challenging than the last! Race against time, test your reflexes, and dominate the jungle with powerful gorilla moves. Whether you're leaping across vines or dodging jungle hazards, every run is a wild ride!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31202820535998045"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "P
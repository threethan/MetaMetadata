QTN1H_oqthjZ2HoGVSGcqXJ9--AM-44uupfNnqNStvPmw&oe=6B0C7AA5"}, {"file_name": "3 (1).png", "id": "744144771585678", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308010_744144774919011_2345049285269105217_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTPSpPaWZ-oQ7kNvwG61zrg&_nc_oc=AdouB-DzSm3Bq4qLsf4kg3besNvtwlk1Qcxx3rNGzGD66Rv4qcveSWHkK96mdGJeAyY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQmxvtGH2j_avvF7Z_YaxcOq54sdZKrYeA2Az5SBnk1VQ&oe=6B0C660D"}, {"file_name": "5.png", "id": "1729816754565169", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824560_1729816757898502_3200623509332299434_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4qYgxnYjgIQ7kNvwFukSd8&_nc_oc=AdogO3l7swG7LGXapdePHyYFlQw4GeBPOkMf-iUBiZnZG51qcUtshsYJ5RzGfARs41k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvck80R9DNSLB-xfdugNEQdFu1fyk3wTjuBxFb3I7VRw&oe=6B0C73CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Fun Dash VR - Run & Jump", "keywords": ["animal", "rush", "baboon", "parkour", "tag"], "long_description": "# Get Ready To Unleash Your Inner Gorilla In This Wild VR Dash Adventure! \n\n\n**Unleash Your Gorilla Power**\n\nJump, climb, and dash your way through fast-paced obstacles, improving your speed and reflexes. Each level brings new challenges that push your skills to the limit, ensuring a fun and dynamic experience every time you play!\n\n{1163512665826790}\n\n**Gorilla Dash: Outrun the Chaos!**\n\nLeap, dodge, and sprint through wild environments as a Gorilla. Can you stay one step ahead of the madness?\n\n{1054144750250401}\n\n**Collect Bananas and Conquer Obstacles**\n\nBecome a Gorilla, dodge obstacles, and collect all the bananas in this action-packed adventure. The race to the top starts now!\n\n\n{1664056530954124}", "short_description": "Swing, jump, climb, and dash through thrilling obstacle courses packed with jungle traps, tricky jumps, and fast-paced fun. Conquer 10 action-packed levels, each more wild and challenging than the last! Race against time, test your reflexes, and dominate the jungle with powerful gorilla moves. Whether you're leaping across vines or dodging jungle hazards, every run is a wild ride!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "31202820535998045"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "782296851527313"}, {"status": "PUBLISHED", "id": "1872156683372739"}, {"status": "PUBLISHED", "id": "622331377304259"}, {"status": "PUBLISHED", "id": "1409334856966195"}, {"status": "PUBLISHED", "id": "768863735525917"}, {"status": "PENDING", "id": "2001112414036402"}, {"status": "PENDING", "id": "1168220811784117"}]}, "baseline_offer": {"id": "782296851527313"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765166100, "status": "PUBLISHED", "id": "782296851527313"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33281
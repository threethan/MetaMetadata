_AQO50Qx3owBVJ9yiL5W4MrO0C2WANFo__XLgiE99azOyJA&oe=6AE21265"}, {"file_name": "3 (1).png", "id": "744144771585678", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308010_744144774919011_2345049285269105217_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hio6LwuhuhUQ7kNvwGfov5v&_nc_oc=Adp8MjZMf1CWJNdpspBEbSo3k9LNbV2xV44E9YMW2Bl-LL0A_KynGYeSIqzEBofvNeY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0uKRVFuyRS3ShnIfA1WykTgv5li__Tq0Ad5g9YKMnAA&oe=6AE1FDCD"}, {"file_name": "5.png", "id": "1729816754565169", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824560_1729816757898502_3200623509332299434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wr95FBQsQuwQ7kNvwEyhSQC&_nc_oc=Adp6nk-pOiDInitumOZvP5YAw-v6Zei7_w5d60t8QLCC84VM0bAY_9GfU6Eo9L3e_Hw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz1eqzDOjWG2hpIzUHh6q5lrz2HkRAT5eAei0mfVOung&oe=6AE20B8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440 (11).png", "id": "1354180016746633", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820428_1354180020079966_3730687944046423316_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9PabQdGLSYQ7kNvwEtTrKd&_nc_oc=AdqVUCjdag9ej3UOC98IFUeMc0rs_yyr-jta2VYhprDqgTpkhseM10tfrlRaFCe3VfQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIF_2Ern2_wEg1Sz1lVi2ChAsDK6sCYpxnYQSM5Irzcg&oe=6AE20621"}, "display_name": "Gorilla Runner - Banana Dash", "keywords": ["animal", "rush", "baboon", "parkour", "tag"], "long_description": "# Get Ready To Unleash Your Inner Gorilla In This Wild VR Dash Adventure! \n\n\n**Unleash Your Gorilla Power**\n\nJump, climb, and dash your way through fast-paced obstacles, improving your speed and reflexes. Each level brings new challenges that push your skills to the limit, ensuring a fun and dynamic experience every time you play!\n\n{1163512665826790}\n\n**Gorilla Dash: Outrun the Chaos!**\n\nLeap, dodge, and sprint through wild environments as a Gorilla. Can you stay one step ahead of the madness?\n\n{1054144750250401}\n\n**Collect Bananas and Conquer Obstacles**\n\nBecome a Gorilla, dodge obstacles, and collect all the bananas in this action-packed adventure. The race to the top starts now!\n\n\n{1664056530954124}", "short_description": "Swing, jump, climb, and dash through thrilling obstacle courses packed with jungle traps, tricky jumps, and fast-paced fun. Conquer 10 action-packed levels, each more wild and challenging than the last! Race against time, test your reflexes, and dominate the jungle with powerful gorilla moves. Whether you're leaping across vines or dodging jungle hazards, every run is a wild ride!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tretastudios.com/vrprivacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "TretaStudios", "support_website_url": null, "website_url": "https://tretastudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33540092502270825"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_1444647880472560_6216543196363910097_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcp8Pk4RMhcQ7kNvwECkOtD&_nc_oc=Adp_uKV8q1Ylb59vZmdNvKkBcfq-ITzWkS4fnjOTHfUWRH0_54ykhMfCvhgGO
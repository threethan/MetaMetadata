-2.oculuscdn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5bgycZTXEcQ7kNvwFEEQDP&_nc_oc=Adqd61b73L9-T7WpMvBddflKUADWC59FpTTNtb2zErGumfyItSEoz-2xNIZVKDV0zrY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg9_GMQc3fhs7XcaKDhm1Q3Tr3l0d5znWlASl569vJWg&oe=6A7DA3FB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFaa4DpsK60Q7kNvwHh2KeF&_nc_oc=AdqATazLUMXvK4xxM-u6EfxdrMuVcYQgUrLMrXImbjdMCQX-mDDbwOrqRhhMZW-ZUzY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXgQUKfPKISwZufbpNjsRbkbkV4AsRLaNT4So5oEaScA&oe=6A7DBE3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukMgbGTW9kYQ7kNvwESJMo5&_nc_oc=AdpMQPz9azMSniGKrL2rV-5yybmoKY-rVi77YSAzl7jvaI_2gJxSLruuCHzutvOXQwg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw0YevXNbuDBPUVYB9XTv6S5W4ywZZV4pQa4z4ZUvK7A&oe=6A7DD219"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth and break through obstacles.Simple operation, exciting rhythm like arcade hall,Suitable for those who don't like strenuous exercise after afternoon tea.New game modes will continue to be added. Come and compete with your friends to see whose baby snake kills more blocks!\n"}, {"images": {"nodes": []}, "id": "469748607607774", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5de8\u86c7\u72c2\u5954", "keywords": [], "long_description": "\u8fd9\u662f\u4e00\u4e2a\u653e\u677e\u7684\u65b9\u5757\u4e16\u754c,\u4f60\u8981\u4f7f\u7528\u6fc0\u5149\u5236\u5bfc\u6216\u8005\u865a\u62df\u6447\u6746\u63a7\u5236\u4e00\u6761\u62bd\u8c61\u7684\u86c7\u8eb2\u907f\u969c\u788d\uff0c\u51fb\u6740\u65b9\u5757\u83b7\u5f97\u5206\u6570\uff0c\u8fd9\u6761\u62bd\u8c61\u7684\u86c7\u6700\u521d\u7684\u957f\u5ea6\u662f1\uff0c\u5b83\u9700\u8981\u4e0d\u65ad\u7684\u83b7\u53d6\u8def\u4e0a\u7684\u8425\u517b\u8865\u5145\u8eab\u4f53\u957f\u5ea6\uff0c\u5229\u7528\u4e00\u8282\u4e00\u8282\u7684\u751f\u547d\u529b\u649e\u51fb\u65b9\u5757\uff0c\u524a\u5f31\u65b9\u5757\u76f4\u5230\u6d88\u706d\u65b9\u5757\uff0c\u4f60\u9700\u8981\u4e0d\u65ad\u8c03\u6574\u7b56\u7565\uff0c\u5728\u91cd\u751f\u548c\u635f\u5931\u4e4b\u95f4\u505a\u597d\u5e73\u8861\uff0c\u8ba9\u86c7\u6b7b\u7684\u66f4\u6162\uff0c\u6d88\u706d\u7684\u65b9\u5757\u66f4\u591a\uff0c\u83b7\u53d6\u66f4\u9ad8\u7684\u5206\u6570.", "short_description": "\u8fd9\u662f\u4e00\u4e2a\u653e\u677e\u7684\u65b9\u5757\u4e16\u754c,\u4f7f\u7528\u6fc0\u5149\u67aa\u6216\u8005\u865a\u62df\u6447\u6746\u63a7\u5236\u4f60\u7684\u5b9d\u8d1d\u86c7\u4e0d\u65ad\u6210\u957f\uff0c\u51b2\u7834\u5c42\u5c42\u963b\u6320\uff0c\u7b80\u5355\u7684\u64cd\u4f5c\uff0c\u8857\u673a\u5385\u4e00\u6837\u523a\u6fc0\u7684\u8282\u594f\uff0c\u9002\u5408\u4e0b\u5348\u8336\u4e4b\u540e\u4e0d\u613f\u610f\u5267\u70c8\u8fd0\u52a8\u7684\u4f60\uff0c\u65b0\u7684\u6e38\u620f\u6a21\u5f0f\u5c06\u4f1a\u4e0d\u65ad\u589e\u52a0\uff0c\u5feb\u6765\u548c\u67
dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDhyo_NSWoMQ7kNvwGJohec&_nc_oc=AdrJMFsZNacgcRPtzMCFrLwrHErNKpgEax5OerchArhxGUDiguiy7_z0M8y9wAn91jw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpOQhx-HyozQC94yEptVF5C0EN--AgTfsUKmlaa7cE_w&oe=6AB146BB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cxnmJ18AOTIQ7kNvwGMp0TF&_nc_oc=Adqc6ijAY-eLIk7wl9Icilz61ZDvdnA_HBM6R6dmBqhphaqQZ6R3N8VMMLHqP3jIdVA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDItP0BkiwZwZX2KDss1e5Rpex2BxQQuZ_RC7xsFfWdA&oe=6AB128BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPtSaFujctIQ7kNvwGIs8Ep&_nc_oc=Adp9u_W-e4E98CJkw9IlFZxizqtwnIVqssPbkJ-Ec4acrkGtVeL3oV6bLVs1p2Tgt9s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxPR3lrHYz8RP6NVU6eZF6ZqRhOzSJTntnMuv2dL9JtA&oe=6AB13C99"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbTilSzKU3MQ7kNvwH4uvSM&_nc_oc=AdqArNXXprWjx4cAHwa9lB0R-EcAnmHLX9cE6ua9xLnZnyx-UJ_xD2q4ypKhS03TIfg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeZFQtZp3ct7WiJgf2EDgWRKufXmmFM8m4q0tMQ2aRVA&oe=6A81987B"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVSj6_Xja_QQ7kNvwH8KHSV&_nc_oc=AdowJvuOI79CGKrTEYs26XN_l735dE1gwZekuHYSsaFeHngwkzOtiMkMzVVjaGSqefQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3ZzbaSMfuuZay453ln8i5wXy5wAfN6p0iWoozZ8y9wA&oe=6A81B2BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaXmHUcv3AwQ7kNvwHL14Hv&_nc_oc=AdoyDgt9AA4KkXvYjJSjIVL17ZDdWXg5vsxmZQm-vgLKcpccdKXb2Pr24jf7ZJOrzFw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuqUatM-ujO5qNZGSF6MBok8Uehjv-MhMwh-jgy0KghQ&oe=6A81C699"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
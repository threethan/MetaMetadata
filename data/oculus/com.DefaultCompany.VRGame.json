dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rzKKib6ZEoQ7kNvwHQewb5&_nc_oc=AdpShzVgnEXfr6U-mGOhaonFWQU2suM-QF9g-s8wJMxAPrAT5BkEYeYP-Zb6IbUFxAQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGInrrWm5vMKTyp5lrNcP6Q8whzDC4D83h1Jmw6nAkgtw&oe=6A89817B"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SN_uU3w0cX4Q7kNvwFmgoxf&_nc_oc=AdrZBgDrVTd2DTDMD9FVABdXSFL3U4c_QQUL8liaHY6cYeAKDGz9A4_DM-AlxrUXBo4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGD-rGur5dhHYSd9zYjLTj56ZfC0Uwo3GgIHtYq618Usw&oe=6A899BBF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PslQfN90qLwQ7kNvwHb7KEA&_nc_oc=Adr0MBDEqYvcBB3rDcY1Y9YIULrlJE-7efNKZzXCS4YASW22TPgWsIq1E0AzJdBLpRk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVnMfIh9EcVfka3iIjS-N5U6Py6xzyBfkyOt6FzO1fIA&oe=6A897759"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
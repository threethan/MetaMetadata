dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Nq9KyqXCPEQ7kNvwF9bidy&_nc_oc=AdpVM5j1aYmYbDj2B0_ZBdAgj1YxoAiKRTakv04CtuYJlJQwEGVmgtjnprvaUZmUpdI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsxCSmVFLvTTnr8l2L95fXrW0zc3EKLh-6v-VA9QWPYw&oe=6A983A3B"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peF6RMry9_IQ7kNvwFApe27&_nc_oc=AdovshqutA3HJW5vA43-raGgdgr1AYzsC_z5Yqadl9LWE02XZf1_wJmkJmDokphMP-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIl-NXhkcGm9fzrpR3428aVqhCG2XIt5qmHxFz0Kvurkg&oe=6A98547F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQSzgDwM2fEQ7kNvwGL8MTp&_nc_oc=AdrCteapQd3tQlfl_VgpFZVh2LblBhMpT7W0cypsCLAhukqqSrsFG9roPIM3ZNmQckg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILQbQngCNYRFmFGCgxgTg6nODJZvUSsMyZpYt9NPEuuQ&oe=6A986859"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
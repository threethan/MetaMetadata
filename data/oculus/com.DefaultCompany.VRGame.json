dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7x-NCW7X_sQ7kNvwHczOc7&_nc_oc=Adp8hz7y4b56etVF9_p0zf7GT2J6NCsEoTRRsD0op_lcrOzojx0RS0IF6tc62fqPdO0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPxG7fPFuWLHlFiT3l2_xLZpemkxDVgPuakREjQLJXwA&oe=6A6DD1FB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Wh7lMYCLkQQ7kNvwGDZ6E_&_nc_oc=AdrPw3-UCefEuhXpTw_8qKqeaNvnpbFfPiaHX-wiXnkB-XT0TlRu0drD85xPwURe1Co&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBayNLbrzJxS7e73_c13J1Mv0EozRk4YNLw2Zv_pa9Qew&oe=6A6DEC3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0KulDrERpQQ7kNvwEwKok5&_nc_oc=Adoqq8eHYm2Jc4eB21JiWqWc3HJEd-TI9H28BMd0LapVU7a7pRjjpO4UHKXsFOLDfew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuMvCKYjoYLF5E2cGFLt6OJM7KKO0jMF0lZZqd_CrHzw&oe=6A6E0019"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
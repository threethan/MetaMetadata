dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZX-H4DS6D8UQ7kNvwHVW5ih&_nc_oc=AdqKlwxAhm0DT4Se_c8iRwK33Z6W4Fdj2-5us3zzzGkyf1YDLvryXNI54ZLR_v4YSmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dVP1OizeMkIfz5neRutZmqZgXNRL34b16JApPjpRVcQ&oe=6A1EF03B"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vo-m2G6QjXIQ7kNvwEC-cpS&_nc_oc=AdqU_A2HwTV4MPqcyvxe_jnOODpxkJank9qRNG00BpefnBCcjJSesAXybi2FTk5L7uE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bYbOU_3CtficvxXK5j7DaB7turHChmWRNHvXwjFxLdQ&oe=6A1ED23F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkEcKlT6N7IQ7kNvwHNbaay&_nc_oc=AdoPNk8BvjT28sLWf18r_3WOg91na3clnzibpCEwRVLNvD927RREWwkRjFgjADuhPfo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ODYNN7N8lGRedJVFlQLZ0hqzQqBSk1r8tGgIKTmlPAA&oe=6A1EE619"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em6sKQMtzYcQ7kNvwEyxmQO&_nc_oc=Adr62NI3iRHGvoIpANYVw8s8cACHANthBJcA9oHtp-R5l0LeaNfL70FhirHfBBXIUvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dI63s5CaFojxwsp-3K-23GWGOX8u3GtzH774sO2InTw&oe=69E8AA7B"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5ZWWzsgAzMQ7kNvwEjbAok&_nc_oc=AdqmKwCcYZ31xvUArKfXoBJ5EtpbRg2JcXv3m3Waeq9C7ZCuoEggIe0Nbr52Xq_H7vg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0t-wkW-goHlREp4Il296aSLq0Z-pomgyrE_qreADZCxw&oe=69E8C4BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BNK_OB7Ne4Q7kNvwGROa8v&_nc_oc=AdrCNZlnRGAWOe4yjDE4Wwq7-45fmGRrBjzUOLy-Ql_QdSXpXcDd-AuH_EBGxNDXUig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af253gEQXoL0cwDR5-6iHiDNoli1jJ8_1EgkixcPPgXUBg&oe=69E8D899"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
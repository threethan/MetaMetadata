dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLi1VTDWsc4Q7kNvwF9O3j_&_nc_oc=AdrzS778172vcukODOYFVYbYVh9v3YmNvE-GegByEJ3nJ21P92-yQ3xleCAuOeawQF0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqqzS-CmkWWwAxs8A3JAz9RnPvKd90yFJYvo327tTsbg&oe=69CE4C7B"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gV6nHqwfbMoQ7kNvwEActmK&_nc_oc=Adrut50UwTVKoKLzSyhTTNlAUR5_mBjoGAlIgKX0RQ8WPxSJXW4Sf9P2VJt6_hR4P0o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqZ5kl_4JXNjRgyerawrxyLuypu6KCto74QwVJdIaC9A&oe=69CE66BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_IZmSbwSHUQ7kNvwHYkdQr&_nc_oc=AdpCcbZOBAKRYt3Rn8LXwejlWvXe7qJHxyHfXCz3E604_cAiv-4h4R3iuSkTbPqq4CA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6_y_E7GMeySgMHQ8nw0xJ_udya3yx7O84OiQcwE1ovw&oe=69CE7A99"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
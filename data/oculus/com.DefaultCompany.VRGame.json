dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unwtJ85vvwUQ7kNvwEfx7y3&_nc_oc=Adp-QSEC9p1jxIS9rLeBK0MFYSxPrGFs4rxBa_VkG7FKxORuRX6ymc7WIR64tMvAWFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4C-QOge8bHKy6GpMiaVW_z89UwFTQjEWMpt1WQO2wpPg&oe=6A05E3BB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou10AV7g9xUQ7kNvwHFi2N4&_nc_oc=AdqPbq8EE89zMtl9qS_-Dw6xCPHpsTU_18vE5UuLz_LqffcjPaEfMPUJrMMFw11f1LE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6He4dXVKR33TFTvJiEUj_mxet-8yP_YxH0K65bEeLFsQ&oe=6A05C5BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dR6Z6vHMFBAQ7kNvwHBZyZf&_nc_oc=AdpQ6HX-j46EEuyiKx3SU46BW1tuScL6E_X40gSiyE9-52x4vLOaUjxFLgGnyqFo-fg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jeFEd4fHI8EBsyNIHpAhSBX48HDpLK3mbpf0IdI9VgQ&oe=6A05D999"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
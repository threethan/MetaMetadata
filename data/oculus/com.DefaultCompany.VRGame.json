dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNtnbPzz7J0Q7kNvwH6hcoN&_nc_oc=AdovgHtYkQ7HsfnSyPA_W3Y3c6lml-3CRs9fAasiY0V_2ZEBRHXl6fHEGdh8H6O35hg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vU36u_JP7xdPCQtQm85tXK2ADiPTiP4RxpmoHwGCHyw&oe=69FF4C3B"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59AWG-DDMBkQ7kNvwFpbHak&_nc_oc=Adqn6uwWpJDTkC9eHCd9shCewR64uOI46CN6lere_V09ueJloU3UP5-xzBUO4JRAOrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qdx0gRGmO3qCd2CMc4vzG8KcenoY166ZtGbiMMnz0Cg&oe=69FF2E3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xdR5qokru4Q7kNvwFrIeRU&_nc_oc=AdoLpT7wdcaTJExDXWSfCp5Yb5I96FbRaYlKe36x-P-3u2D-oXaPnct72MPUKrN3Wd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GZ7FhYb39sYlX6nDbRYQ4dBkEZ6ZqF9Ahh_hquZLBpQ&oe=69FF4219"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
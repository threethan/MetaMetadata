dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lphCE8hGeO4Q7kNvwExXx0i&_nc_oc=AdrWk7H6vFUdGMRZZYgmAztFLPVxMyi-A0JiQ9YZMJFU5r93S4Tbnvb01OECJ4Qmt4s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0V9ET_52FCGtCz9pNZgDVrQpPCiOTmiJCP1e7nP5XHHw&oe=69F36EBB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJIO3uqeQUYQ7kNvwGtz77s&_nc_oc=AdrzfKGZGx2JHlAyChpFkYx-8b0erGKOZVpimQX_LdIFG7VnOMG9gzfYfD7SuaDonAE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0yrilp3WYXVptX7dzK1JNriM-LQDFuNDi8vgotznPMqQ&oe=69F350BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSeJSKNplroQ7kNvwEdlokz&_nc_oc=AdrLBuVHuwfiiyqk3twbaLAxpjep6j12dteuJ8D_0DDivV-F78GacjYcWgm7Xrrg0Qo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af324f32NBjmedq-Oib4Tz6jCB3OD7nQlTY5W0v43V8T9Q&oe=69F36499"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
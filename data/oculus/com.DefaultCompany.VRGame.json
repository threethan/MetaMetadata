dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7x-NCW7X_sQ7kNvwHx-vtX&_nc_oc=AdqoQPNfzTiu9JJ_z8ZGZkc1QvA67wf6eKjhEj35MciS9QMcTJMKkNe0uOOTh6S7APc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjLOk_NCOD3CstcmU9d2rTHGXGV-7Tu3G-l05TALJKLw&oe=6A6CB8BB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5Nl5BUMARwQ7kNvwFxuiqG&_nc_oc=AdouJgrB3XxUo4vorLfe8kRLZ3G9mdC55MDEIs8bYbsYM2lylcg1SGzXaCBnCVFQy-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrgkekCEDmko9wO6xYkWhEOo3-SVxTk3QZzAd94Y_8LQ&oe=6A6C9ABF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1kIqHHc-z8Q7kNvwGFfEa5&_nc_oc=Adrzw-drwIJ6ABLWd5cgYCTiiKBwdk9deM2PqAEo9nT8kyAFKjVaalrbUpBDvGpIuV8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZ2BY04T1f_QEpzWSaZdebVekVS8gUCO3QyW2b_LAydQ&oe=6A6CAE99"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
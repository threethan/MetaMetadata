dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQ8Og-7ttvMQ7kNvwEdH4tz&_nc_oc=AdpRn4x3F2xcYzar8gioAOJGwqFl6sYAMDpxjNfOG0c8RIb2OS7DIulW9JVd8qBC-DA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ro_zZe7pKKYy_K-aGvJzrXEodAeKmLatQOJgWdyPXaw&oe=69D786FB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvclzCZXl2EQ7kNvwF4TE9H&_nc_oc=AdrIbpEfttCNAfr2tCn0-JiQ-0gcfuW7M0nd6IsiG5lU3VgpEz_wjIUi25ygOt_B8ZI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UuHR_mhljIlL4HrI0EnQgKYRd8TEJEqwM5ffK0fKu7w&oe=69D7A13F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NT_JDHpBx0Q7kNvwHoHuFo&_nc_oc=AdqAsaeL6FXWmNIJkBEzfv5wP4jeDqbPycXwCj7aaM9iLrdIg1y-F2WlCPKUpTsoWtc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M_y56RYtyuGbDJ2ToukjVSoY9mmISHl27zxKBNMNMQA&oe=69D7B519"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
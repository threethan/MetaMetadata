F&_nc_oc=AdmMrTwX9nvRTjO_eCg8WMl-qgVlnFpgPqmqUDMXtkgHcXEmMhpd-WFLoY-DyCL76tA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsU2vPWKnoLYYhf15InRUnmwX2zyyC30Jx6W8la5K54Xg&oe=69A81EEE"}, {"file_name": "\u622a\u56fe3.png", "id": "610530289924358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974503_610530296591024_7418990752784972941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piE6PINYabkQ7kNvwH8KE-H&_nc_oc=Adl7xsF1svu49Gd-bnJG0aAejKrooZmp1EEj4oaeUHncXAqEc-3alPIaIGxSvlw91H8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs5F05mRtO7gMIuW0t8p3aFo4HI4jBmIU1gjNGUz9V-WA&oe=69A83F4A"}, {"file_name": "\u622a\u56fe4.png", "id": "612937859666837", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X14DNzWOLQ0Q7kNvwHZqAOg&_nc_oc=Adl5GUTriqqLVWHwTIrf404Ownj26mSd50IprLVlzxcoP24kdBgLV9NoBm1e1zWSsCw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvsVXVl5u2eWgm4TuTPQXrHL5fgsYIEAX0HMOYjt0gkSQ&oe=69A810FB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuu0ZSnYAuwQ7kNvwERO9UN&_nc_oc=AdlvDP9vqNek-Ron1hHi-pGlmsndpkBmZYVBM3Q_vnk4aFcPlv5IQLDpnU1dTbR1qfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvNH462NidnQob1K-yDSNDiuXR2IdQ5qccebaqMfgl-YA&oe=69A82B3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEFttczh5gwQ7kNvwEouUCj&_nc_oc=Adn68yrn-4x7LBnpmGGgSO4Y_eXwL2AZfoq3QnFbhS97jL5gPKlTsbKKBE9-7XXIVBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsEVNuH9aQqtk7cX9HFUDrEcrisbMVadLBFE3O2CA7qdg&oe=69A83F19"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth and break through obstacles.Simple operation, exciting rhythm like arcade hall,Suitable for those who don't like strenuous exercise after afternoon tea.New game modes will continue to be added. Come and compete with your friends to see whose baby snake kills more blocks!\n"}, {"images": {"nodes": []}, "id": "469748607607774", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5de8\u86c7\u72c2\u5954", "keywords": [], "long_description": "\u8fd9\u662f\u4e00\u4e2a\u653e\u677e\u7684\u65b9\u5757\u4e16\u754c,\u4f60\u8981\u4f7f\u7528\u6fc0\u5149\u5236\u5bfc\u6216\u8005\u865a\u62df\u6447\u6746\u63a7\u5236\u4e00\u6761\u62bd\u8c61\u7684\u86c7\u8eb2\u907f\u969c\u788d\uff0c\u51fb\u6740\u65b9\u5757\u83b7\u5f97\u5206\u6570\uff0c\u8fd9\u6761\u62bd\u8c61\u7684\u86c7\u6700\u521d\u7684\u957f\u5ea6\u662f1\uff0c\u5b83\u9700\u8981\u4e0d\u65ad\u7684\u83b7\u53d6\u8def\u4e0a\u7684\u8425\u517b\u8865\u5145\u8eab\u4f53\u957f\u5ea6\uff0c\u5229\u7528\u4e00\u8282\u4e00\u8282\u7684\u751f\u547d\u529b\u649e\u51fb\u65b9\u5757\uff0c\u524a\u5f31\u65b9\u5757\u76f4\u5230\u6d88\u706d\u65b9\u5757\uff0c\u4f60\u9700\u8981\u4e0d\u65ad\u8c03\u6574\u7b56\u7565\uff0c\u5728\u91cd\u751f\u548c\u635f\u5931\u4e4b\u95f4\u505a\u597d\u5e73\u8861\uff
dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKEGio5o0mYQ7kNvwFfV_Ec&_nc_oc=Adqe8DQz5E8gYdQtT5dqjuuo987uChcvUDcU9FNGKcxc-tFuQ7HqPK4S8RHy05Ijk9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IeTgGGMuTvUA1_Reer5CLBNLQCAOFLWXpF6sb3KyEZw&oe=69D4E3FB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owlyKzfQLG4Q7kNvwFT3VDd&_nc_oc=Adol_Dk2goFJ478LlbpoH6hKEPXk6-j8lbXiFuL8GL9tKMwdZkYGa3v3aVRXlZuJwj4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IFvQvDSMihmGhjXjzOwqztob0DbwgtFZVW6iUWKwPBQ&oe=69D4FE3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmS5mtfp7WoQ7kNvwEoZWRB&_nc_oc=AdogJQN2I8dwq0R07uFufhD63QKRAbNhDOTPTljat5TkZ7u-2waOylL9yuq3J5y46zM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PWhCMo3yZTVvb-0CA14f1G2oeLcbnLBTjuVQdrsKWbw&oe=69D51219"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
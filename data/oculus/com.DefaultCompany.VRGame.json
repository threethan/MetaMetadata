dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-OZOhSc71cQ7kNvwECWcOM&_nc_oc=Ado9R89T2j0KddgOm_6Bd5Rwpt-atc_lg6FZNTN_b2RB0G1Lrqf1wg5vow19PtEsXvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZsTp7rhko8dWn4HL8sSNjugcCRks_NylLoRsgeDYewA&oe=69EB85BB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlvBj5HDDhgQ7kNvwGuxaVD&_nc_oc=AdqM0-1u6pLPZm8yC2WZXkgArfX9xOocuI3gHoyZugnhIcvERT9o4pwyl6WHeFSbqns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_XpHBNMVHpSsepCxO2ZcHh4Y2SePFOi28Fu7H12Ld-A&oe=69EB67BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nsczik91G8Q7kNvwE4uesf&_nc_oc=AdoRD34WtpSomzJAxP_Nud_ziqSkfgp944Rm_fqIllJCoOO6aMaTGoRxqDy_4B-rHWg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_YE3DZyPetNXmsfKMr05Rm8pP7xgsHUEwy3ajjlay0Q&oe=69EB7B99"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
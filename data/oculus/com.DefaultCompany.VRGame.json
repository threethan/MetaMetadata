dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM_7jvMclGUQ7kNvwHTDh8X&_nc_oc=Adrqx82EiGvSxwDvQkN-PAKU-n2O6fjjwgpTZZ5J0HX8oWdNGOCtrsWG9272tpyUEaw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GbjajG1WwUyaFK1kizvftUcRAH7IqwTDZoDRNvP91Pg&oe=6A15B5BB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4KSxpOnlR8Q7kNvwEp39xV&_nc_oc=AdrNJ6aAzunwKVMaz5JEJaJgnEaEQq3PkUoPw8xtd9_dqF11b9F2l_mZmQ3UIaPVmtY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sgH2RYA3nbhXEK5E21Xp-EWbu-uqcGEhWCFD9n5c87g&oe=6A1597BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFrJI9A-l8oQ7kNvwFA2zXW&_nc_oc=AdrXYIUNPg8Vd5Li0OgXxpxRmYRyUpiduu-89kso_B9czj-RJI2vGhHQgMozV_IqYWw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oHvqS3yHjWfNd6oMnXFU3WoIVrBKr0KNQWysENAAX8A&oe=6A15AB99"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
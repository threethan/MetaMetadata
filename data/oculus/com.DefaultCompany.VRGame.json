a&_nc_ohc=HmYMnaKMu5IQ7kNvwGZQ3Vc&_nc_oc=Ado2jfi36JluVnOP7raIvSCAi_kiVyqaw7kfHJNjzuV4L_wxURE99goueg91MYcxhoo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yxm0eANfAl-CC8a1wcqItTaWGueEgmQTYpiLWIgl7Dw&oe=69E8B86E"}, {"file_name": "\u622a\u56fe3.png", "id": "610530289924358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974503_610530296591024_7418990752784972941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTEgcwiIrxEQ7kNvwF239Ys&_nc_oc=Ado9FXC63ksKITN7mr9-EqSWJna3g3Mik1W7nQTP3u-hp1RPIegoCDqDKuFDiflA8aw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mWnl1NDnvdvIN6YkOg_vrZzNCub6YU5jF8IchpWeIqQ&oe=69E8D8CA"}, {"file_name": "\u622a\u56fe4.png", "id": "612937859666837", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Em6sKQMtzYcQ7kNvwEyxmQO&_nc_oc=Adr62NI3iRHGvoIpANYVw8s8cACHANthBJcA9oHtp-R5l0LeaNfL70FhirHfBBXIUvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dI63s5CaFojxwsp-3K-23GWGOX8u3GtzH774sO2InTw&oe=69E8AA7B"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5ZWWzsgAzMQ7kNvwEjbAok&_nc_oc=AdqmKwCcYZ31xvUArKfXoBJ5EtpbRg2JcXv3m3Waeq9C7ZCuoEggIe0Nbr52Xq_H7vg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0t-wkW-goHlREp4Il296aSLq0Z-pomgyrE_qreADZCxw&oe=69E8C4BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BNK_OB7Ne4Q7kNvwGROa8v&_nc_oc=AdrCNZlnRGAWOe4yjDE4Wwq7-45fmGRrBjzUOLy-Ql_QdSXpXcDd-AuH_EBGxNDXUig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af253gEQXoL0cwDR5-6iHiDNoli1jJ8_1EgkixcPPgXUBg&oe=69E8D899"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth and break through obstacles.Simple operation, exciting rhythm like arcade hall,Suitable for those who don't like strenuous exercise after afternoon tea.New game modes will continue to be added. Come and compete with your friends to see whose baby snake kills more blocks!\n"}, {"images": {"nodes": []}, "id": "469748607607774", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5de8\u86c7\u72c2\u5954", "keywords": [], "long_description": "\u8fd9\u662f\u4e00\u4e2a\u653e\u677e\u7684\u65b9\u5757\u4e16\u754c,\u4f60\u8981\u4f7f\u7528\u6fc0\u5149\u5236\u5bfc\u6216\u8005\u865a\u62df\u6447\u6746\u63a7\u5236\u4e00\u6761\u62bd\u8c61\u7684\u86c7\u8eb2\u907f\u969c\u788d\uff0c\u51fb\u6740\u65b9\u5757\u83b7\u5f97\u5206\u6570\uff0c\u8fd9\u6761\u62bd\u8c61\u7684\u86c7\u6700\u521d\u7684\u957f\u5ea6\u662f1\uff0c\u5b83\u9700\u8981\u4e0d\u65ad\u7684\u83b7\u53d6\u8def\u4e0a\u7684\u8425\u517b\u8865\u5145\u8eab\u4f53\u957f\u5ea6\uff0c\u5229\u7528\u4e00\u8282\u4e00\u8282\u7684\u751f\u547d\u529b\u649e\u51fb\u65b9\u5757\uff0c\u524a\u5f31\u65b9\u5757\u76f4\u5230\u6d88\u706d\u65b9\u5757\uff0c\u4f60\u9700\u8981\u4e0d\u65ad\u8c03\u6574\u7b56\u7565\uff0c\u5728\u91cd\u751f\u548c
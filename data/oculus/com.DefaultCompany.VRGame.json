dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbIPX6T0BKoQ7kNvwFhv_GD&_nc_oc=Adr_YehStxNY2FeUZYOhBjlqS7y3NKrKNTKOF_haCS3Y2uBwL8lff3lp_x-cy6tN3M8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZmZQa2IeVIIlP5CGZ3DbpPXzYE9RTv827jLboX5ciZA&oe=6A4FB7BB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JMlzxctPSkQ7kNvwEr6Vz8&_nc_oc=Adp9-Q0-F3-vt79cRwfWeo24ImKeco310TdqcXLefBQMJkucEeuFJfoydGIFfG-ngPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABq-TV8_Q5OMnzsn8TsJq8O7I2rPgK0jTDXe_u8xkP9g&oe=6A4F99BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKGH0KrNeFkQ7kNvwHZyuok&_nc_oc=AdpvJAya_v6Kohhccw5pA6ou4S-0IbzgPLqDIV0CbUsp5ckcu5OY5jy6vitycNpAvRg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4sSDiayFomTxFNyxP2lzP9pq3NKRzo0vS86F2wjyesQ&oe=6A4FAD99"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
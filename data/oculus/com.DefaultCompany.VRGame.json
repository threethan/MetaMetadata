dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPQe5mj_ycEQ7kNvwEaIDtx&_nc_oc=AdrcabZyTrLj6hrNVATAbYIsrQ0zKPT67D1bn98oIXxdQlHIU-dRgKBUkIqtkJLcCnY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1N86fdX-mPL4ubVsZ1ZkY1e4F15lN5qLNP9SMn9qYoQ&oe=6A66213B"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfSRVirfELoQ7kNvwHDgbYU&_nc_oc=AdpmzN12-qkzYZuu9cI0b8w7TQjWocKltR6KykooMhklSnHgfKT6CLTO7VA3YclTZZo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhS3jmzf_NEVbAlRokWbSXDXcSymkbDmPXs5QsVN4a5Q&oe=6A66033F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5fwB_caPxgQ7kNvwHfQAn8&_nc_oc=AdoeIbzb08UxlYWtBacYfhS7Kne-3MtZKM5GvLPpyu89JH5CUkTG7A7Fszzc7xUKYXg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlxlGsY2eS6s3gnQeQbkPGvfV0SMoF0Yc3KavjzfcOBQ&oe=6A661719"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
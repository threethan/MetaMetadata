dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKNJ_FzPy7IQ7kNvwEftp2x&_nc_oc=Adq9fqIL--FzeBlcpYO3gkC3EK9RF8pRjRnOndz8W9lV5cjIBjUhK92sctTc0vtjMaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4g9B0rxK0d65zXqDmcBVPpgcRMQGBdKUHsvogI6aTIA&oe=69CCFAFB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gV6nHqwfbMoQ7kNvwHMC-_k&_nc_oc=AdqNWgaX-c-Oj3qQZzv4c8xq-iOwVl3KEEIyWn5-5YDSu359jyQx5rHCbWKEvGD-UsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFWPHk0wtQVZC9nEBg-JTelDDuryg6Qog-dEM1Xw3IcA&oe=69CD153F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_IZmSbwSHUQ7kNvwGRpdsD&_nc_oc=Adq8Tp1fGy4IywAADS9eqBdCh2YNfxMdyX5zBgO6vQ9YPU0ezxgY9OTV94Hitd_Keko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjujsU0DWyyTGME867JrcVivBF2nV99Ylb4nmRqy5TmQ&oe=69CD2919"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
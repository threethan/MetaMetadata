a&_nc_ohc=IYiNJ0y4pIwQ7kNvwGE0Mna&_nc_oc=AdrlUUG4N5cuQkPlyySByeVkz0KOZH1uUowL21zg2LXHV_yToTZDGCYf81hdlegGCIQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vbLzwKZAa4VbmYoY0N0LdW8G386wXaW0onoowxzkT_g&oe=69EB5B6E"}, {"file_name": "\u622a\u56fe3.png", "id": "610530289924358", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974503_610530296591024_7418990752784972941_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htCJxbhzhk0Q7kNvwEGJsAX&_nc_oc=Adr3kcoc2enk5VEnQWrSR6WuAC4Ll9oa22wLYGNE1oND-hbM8eTPhVk5ytuBh5IJXg0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pST-kdLeij-94ZS-8lEwyaKzP7i-Xjp1sGU5gALoW2w&oe=69EB7BCA"}, {"file_name": "\u622a\u56fe4.png", "id": "612937859666837", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-OZOhSc71cQ7kNvwECWcOM&_nc_oc=Ado9R89T2j0KddgOm_6Bd5Rwpt-atc_lg6FZNTN_b2RB0G1Lrqf1wg5vow19PtEsXvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZsTp7rhko8dWn4HL8sSNjugcCRks_NylLoRsgeDYewA&oe=69EB85BB"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlvBj5HDDhgQ7kNvwGuxaVD&_nc_oc=AdqM0-1u6pLPZm8yC2WZXkgArfX9xOocuI3gHoyZugnhIcvERT9o4pwyl6WHeFSbqns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_XpHBNMVHpSsepCxO2ZcHh4Y2SePFOi28Fu7H12Ld-A&oe=69EB67BF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nsczik91G8Q7kNvwE4uesf&_nc_oc=AdoRD34WtpSomzJAxP_Nud_ziqSkfgp944Rm_fqIllJCoOO6aMaTGoRxqDy_4B-rHWg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_YE3DZyPetNXmsfKMr05Rm8pP7xgsHUEwy3ajjlay0Q&oe=69EB7B99"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth and break through obstacles.Simple operation, exciting rhythm like arcade hall,Suitable for those who don't like strenuous exercise after afternoon tea.New game modes will continue to be added. Come and compete with your friends to see whose baby snake kills more blocks!\n"}, {"images": {"nodes": []}, "id": "469748607607774", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u5de8\u86c7\u72c2\u5954", "keywords": [], "long_description": "\u8fd9\u662f\u4e00\u4e2a\u653e\u677e\u7684\u65b9\u5757\u4e16\u754c,\u4f60\u8981\u4f7f\u7528\u6fc0\u5149\u5236\u5bfc\u6216\u8005\u865a\u62df\u6447\u6746\u63a7\u5236\u4e00\u6761\u62bd\u8c61\u7684\u86c7\u8eb2\u907f\u969c\u788d\uff0c\u51fb\u6740\u65b9\u5757\u83b7\u5f97\u5206\u6570\uff0c\u8fd9\u6761\u62bd\u8c61\u7684\u86c7\u6700\u521d\u7684\u957f\u5ea6\u662f1\uff0c\u5b83\u9700\u8981\u4e0d\u65ad\u7684\u83b7\u53d6\u8def\u4e0a\u7684\u8425\u517b\u8865\u5145\u8eab\u4f53\u957f\u5ea6\uff0c\u5229\u7528\u4e00\u8282\u4e00\u8282\u7684\u751f\u547d\u529b\u649e\u51fb\u65b9\u5757\uff0c\u524a\u5f31\u65b9\u5757\u76f4\u5230\u6d88\u706d\u65b9\u5757\uff0c\u4f60\u9700\u8981\u4e0d\u65ad\u8c03\u6574\u7b56\u7565\uff0c\u5728\u91cd\u751f\u548c
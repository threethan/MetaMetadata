dn.com/v/t64.5771-25/38982448_612937866333503_4358291612730994530_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvF8BOfHX_cQ7kNvwGzDZ4j&_nc_oc=Adoo1OpalZqaAALoSmZw-4HJSvgHGefzcUNkasH7DieNcB6z7h1lhV_vpK2HGiRf8Cc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y9j4OEBGOHwc5QYNifISCVhmoixCflgYSHpdEuYInJQ&oe=6A0C7B3B"}, {"file_name": "\u622a\u56fe5.png", "id": "3092707154295718", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39001725_3092707157629051_3861884023844041321_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0Yz8wpmtqcQ7kNvwGRe_7C&_nc_oc=AdqfqXJGGhYLxkR7L27sYdLRvCwCkug9r3bIZTfv4oQ5mk6Zst2FX8ZYIGDR4lSEIa0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y0S8LE15-iiGzLwdmelO7rsdg2_uAs1zKuiwqqCF47g&oe=6A0C5D3F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u622a\u56fe4.PNG", "id": "519170696122507", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974861_519170699455840_8753948634308012683_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46VmHNTdjaYQ7kNvwE854K9&_nc_oc=Adpma5ng3tcaEMUGRMGOkypah76UPeNJUalIe1rZmW-bmTemGh7fcNHeX-q56PRid-I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AfcwG5QL-aoggxJlsJ-Z6DnSpbhLdaHpvNqkhkA2EGQ&oe=6A0C7119"}, "display_name": "Snake\u2018s roam", "keywords": [], "long_description": "This is a relaxing cube world, You use laser guidance or a virtual joystick to control an abstract snake to avoid obstacles and kill blocks for points.The original length of this abstract snake is 1, and it needs to constantly gain the nutritional body length along the way.It hits the block with its vitality section by section, weakening the block until it destroys the block.You need to constantly adjust your strategy to balance regeneration and loss, making snakes die more slowly, kill more blocks, and score higher.", "short_description": "This is a relaxing cube world, Use a laser gun or a virtual joystick to control your baby snake's growth 
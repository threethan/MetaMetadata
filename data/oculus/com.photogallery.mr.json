_ohc=YIYGzzzBqcoQ7kNvwEnE7pz&_nc_oc=AdqbVtZQWfUxHHiDOE_gmrQ9FgLCyxnDs1fOdKgq4PtLp8rQyH_4Q8QyHD5U4bU7SRw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3jm92NKCiP_4T_Q3dc5HCo0Xg4PZByp8rtJWFxfKCLQ&oe=6AEA1361"}, {"file_name": "BandiView_PhotoGallary (3).png", "id": "39339672682314614", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_39339672708981278_307889581072310241_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElaL3H4pwHIQ7kNvwHac404&_nc_oc=AdqPDq75yxFx1pCWBzYnqr_sqGSn8hdKSAvHmpw-CDQOCt4MJorBgZBifCY6XuRPJNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSguYVVHmYjxyn-x6Znq7uZgbG-RpgkvLYbCVY4ZQWi1A&oe=6AEA0534"}, {"file_name": "BandiView_PhotoGallary (1).png", "id": "1739863053760036", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624656_1739863057093369_7090613735587752978_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyqcCSouOrkQ7kNvwGoBjOK&_nc_oc=AdotzwRXNICseKfyEINpbpjZOFnX7IhFZ9QDeSUueyaB77meGS5MOx9dyKn6gn8tWk4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDZO3O7_xNk6Nga5tuvvHNeafT5V9M1rK8epZS_3S4sg&oe=6AEA079C"}, {"file_name": "PG01.png", "id": "2199642620963573", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620599_2199642624296906_1632623424780064377_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGY1t7w8AhwQ7kNvwE5HXcw&_nc_oc=AdqPg_SzOYLejPlZNXDezLzKoHe-gM1MLFCdwbZncYaA3hySN12NDCFokBRC8-aDPAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHXgpQS2jORl9vhmN4EMZxOLY5Uve05zJdhhFu2fNoNA&oe=6AEA1222"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499622153_1843947446759185_6768921148336806738_n.png", "id": "1119788727413886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628447_1119788730747219_5018074499616464406_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jULBcBb85JcQ7kNvwGQ3ffQ&_nc_oc=AdqOPW1Gc95ureWEUXM6pZBUyKzoX79Ttcd4ov1-XSpKA2_Nxa2AOmIOdOjoeuXJrv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDz2s4PMFXRjvaiGuP2Isksog3posohSPylD2kvv68_Q&oe=6AE9DDB3"}, "display_name": "Photo Gallery : Spatial Anchor Photo", "keywords": ["photo", "gallery"], "long_description": "Turn your room into a personal photo gallery. Hang your photos on your real walls in mixed reality and arrange them using only your hands.\n\nUPLOAD FROM ANY PHONE OR PC\nOpen the address shown in the headset menu in a browser on the same Wi-Fi and drop in your photos. They appear in front of you instantly. No app or account needed, and photos stay on your local network and headset.\n\nNATURAL HAND CONTROLS\nPinch to grab, use both hands to resize, and bring a photo near a wall to snap it flat like a magnet. Or simply flick it toward a wall.\n\nAUTO ARRANGE ON WALLS\nOne tap reads your room from Space Setup and hangs every photo at viewing height with even spacing, keeping doors, windows and furniture clear.\n\nSTAYS WHERE YOU LEFT IT\nSpatial anchors keep your layout in place every time you return.\n\nDEPTH OCCLUSION\nOn Quest 3 and 3S, your hands and furniture naturally hide photos behind them.\n\nSHARE AND EXHIBIT\nLiveSync shows the same gallery on several headsets in real time. Admin mode with a PIN, view-only mode and automatic layout reset make it ready for exhibitions.\n\nA short built-in guide gets you started in minutes.", "short_description": "Turn your room into a personal photo gallery. Send photos from your phone or PC over Wi\u2011Fi and hang them on your real walls in mixed reality, using only your hands. One tap auto-arranges every photo at viewing height, and your gallery stays in place the next time you return."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blog.naver.com/uc7/223929197098", "developer_terms_of_service_url": null, "publisher_name": "woojoung", "support_website_url": null, "website_url": "https://blog.naver.com/uc7/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [],
ughout the game world.\nThese installations can take the form of intricate patterns.", "short_description": "\"Aura Runners 2\" A New Interesting Gorilla Tag Fangame"}]}, "developer_name": "Fays", "developer_privacy_policy_url": "https://docs.google.com/document/d/1fqGMxfwoaE3518dghk7vucYDTRqbjxbSPV0n8peZx4I/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Fays", "support_website_url": null, "website_url": "https://html.cafe/xa09989ee", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9298268066949591"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_1005561181671725_6130661128948018135_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ViXCZ4RXmbYQ7kNvwFS09rG&_nc_oc=Ado3pIOPsX0kt5E85FJqTo0ytHGHN_dsFa8IcrGCTX7I0rLLWve2xVSo4InoJmsd0Us&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsGo4q1n5HEIQU-DIPYrcSNdF8g_emkZIki5KzTdJhoA&oe=6A6A0FCB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Aura Runners 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Hango
c_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mm0lF47eny0Q7kNvwEX2SDr&_nc_oc=Adq1QSjJV4tfelMPukMB3TsAakgzQ6FeJ1XFgse05wFoq3llOCBrduSu3naboZ3iqKE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6p4d6eUNPe-x1_obxDS9UcR8Pc7YC8Mmrh0aYANNoAQ&oe=6A92AB7E"}, {"file_name": "3.png", "id": "1689558102293813", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823949_1689558105627146_3781080296636817560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7uileKlU4gQ7kNvwE1QG9Q&_nc_oc=AdpEjM712TMtHKlbRWh8YLJhZVq_6VayYQcvze4G8meDuyeRPzSGmc2IOPV0lGf2BOQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHywEpNd8Eoid8WN1QBgi77R8haawugWjxODAZiGxrx7g&oe=6A92DF10"}, {"file_name": "4.png", "id": "1563386828641685", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1563386835308351_7586830551001519604_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iMO3MA9AnksQ7kNvwEui2uZ&_nc_oc=Adq8I8HHUtYXYqqQyxgx8qzuat36uVVgjhGyacaABQGhy97_6bNUmO3-1U4ies10fDs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1VM5oPjOcglNPBrVu25p7exHErMrEahGy-WNFCAUj4g&oe=6A92D7EA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Chaos Dog: Pet Simulator", "keywords": ["dogsimulator", "doggame", "petgame", "dogchaossimulator", "animalgame"], "long_description": "Welcome to I Am Chaos Dog: Pet Simulator, a fun and action-packed adventure where you become a wild and mischievous dog in a fully interactive world!\n\nExperience the ultimate dog simulator where freedom is everything. Explore a detailed open world, interact with objects, and create chaos like never before. Whether you want to run through the city, jump on objects, chase characters, or simply cause playful destruction, this game gives you complete control of your chaotic pet life.\n\nEnjoy smooth and realistic game play designed for all animal game lovers. Perform fun activities, complete exciting missions, and unlock new ways to express your inner bad dog. The sandbox environment allows you to experiment, explore, and enjoy endless entertainment without limits.\n\nGame Features:\n\nRealistic dog simulator experience\nOpen world sandbox game play\nFun and chaotic pet actions\nSmooth controls and animations\nInteractive environment with objects and missions\nExciting animal game mechanics\nOffline game play support\n\nIf you love dog game and pet game experiences with freedom and humor, this is the perfect game for you. Become the ultimate chaos dog and enjoy a world full of surprises, fun, and endless action!", "short_description": "Step into the wild paws of a chaotic dog in I Am Chaos Dog: Pet Simulator! Explore an open world where you play as a mischievous dog causing fun, funny chaos everywhere. Run, jump, destroy, and interact with objects in a fully dynamic environment. Experience a unique dog simulator with sandbox freedom, entertaining pet game play, and endless chaos. Enjoy animal game fun with realistic controls, exciting missions, and nonstop action in a lively pet simulator world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "developer_terms_of_service_url": null, "publisher_name": "Lucid Forge Studios", "support_website_url": null, "website_url": "https://lucidforgestudios.wixsite.com/lucid-forge-studios", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "S
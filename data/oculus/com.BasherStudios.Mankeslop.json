uluscdn.com&_nc_ss=7f20f&oh=00_AQMVzpw2OWEgTJ_U_cLmo7Qt1nsR2KRdAh9q8XIJqG11lg&oe=6AE1E85E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5 (1).png", "id": "1883650075984055", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623534_1883650079317388_5898965473140322005_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZjBTfkgTfgQ7kNvwE_PWT7&_nc_oc=Ado6Kd24iM5eLDxtr0HR2WGN_Ij6wTZgiQe1NHtYuRRwP7ep4D_jZ-I9fPR4oYDiBxg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM_MVy7SJxbuKRL4aKByLh2lvdYj29IBvXIHV9d6UZ6Q&oe=6AE1F6FA"}, "display_name": "Manke Slop", "keywords": ["Monkey", "Monke", "Gorilla", "Horror", "Tag"], "long_description": "Manke Slop is a VR horror game where movement, exploration, and survival come together. Enter a strange and dangerous world filled with dark environments, unexpected encounters, and things that are better left undiscovered.\n\nUse your hands to climb, jump, and move through the world as you explore what happened and try to survive whatever is waiting for you. Whether you\u2019re playing alone or with friends, every session brings new scares and challenges.", "short_description": "Manke Slop is a VR horror game where movement, exploration, and survival come together. Enter a strange and dangerous world filled with dark environments, unexpected encounters, and things that are better left undiscovered.\n\nUse your hands to climb, jump, and move through the world as you explore what happened and try to survive whatever is waiting for you. Whether you\u2019re playing alone or with friends, every session brings new scares and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/manke-slop/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Basher Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/manke-slop/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "co
uluscdn.com&_nc_ss=7f20f&oh=00_AQSWoXldgOik6TtTDKM1Tn6llARv0YrFKBUGsiB2Wth_3g&oe=6AECAC9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "5 (1).png", "id": "1883650075984055", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623534_1883650079317388_5898965473140322005_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ewMKsTi2_kQ7kNvwFPjbqj&_nc_oc=AdqQ0_UXyg5wXYrInN1gl8WlIV2R_ZZNa9l-o6oELm7u9-5DeSoG82psa9KgukgvPk8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw-xPiJ48UPdqLzP2ldaibCRyegImy4PBcrxxEvPIALg&oe=6AEC82FA"}, "display_name": "Manke Slop", "keywords": ["Monkey", "Monke", "Gorilla", "Horror", "Tag"], "long_description": "Manke Slop is a VR horror game where movement, exploration, and survival come together. Enter a strange and dangerous world filled with dark environments, unexpected encounters, and things that are better left undiscovered.\n\nUse your hands to climb, jump, and move through the world as you explore what happened and try to survive whatever is waiting for you. Whether you\u2019re playing alone or with friends, every session brings new scares and challenges.", "short_description": "Manke Slop is a VR horror game where movement, exploration, and survival come together. Enter a strange and dangerous world filled with dark environments, unexpected encounters, and things that are better left undiscovered.\n\nUse your hands to climb, jump, and move through the world as you explore what happened and try to survive whatever is waiting for you. Whether you\u2019re playing alone or with friends, every session brings new scares and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/manke-slop/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Basher Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/manke-slop/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "co
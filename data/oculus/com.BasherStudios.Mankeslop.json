ile_name": "5 (1).png", "id": "1058191513346343", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619805_1058191516679676_2628246542632611707_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPoae6ZzzqMQ7kNvwFA5LYh&_nc_oc=Ador7jMCKPYH0A4uovGIsShc4umGZRbv25hGb2IcwDDrHT5g7dqTo-KGvG9RTmR1l-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTISFBe96lR7ylhr9BsyV0P8poAkbFgbqyhcnizMmTIBw&oe=6AEF4F9E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manke Slop", "keywords": ["Monkey", "Monke", "Gorilla", "Manke", "Horror"], "long_description": "Manke Slop is a VR horror game where movement, exploration, and survival come together. Enter a strange and dangerous world filled with dark environments, unexpected encounters, and things that are better left undiscovered.\n\nUse your hands to climb, jump, and move through the world as you explore what happened and try to survive whatever is waiting for you. Whether you\u2019re playing alone or with friends, every session brings new scares and challenges.", "short_description": "Manke Slop is a VR horror game where movement, exploration, and survival come together. Enter a strange and dangerous world filled with dark environments, unexpected encounters, and things that are better left undiscovered.\n\nUse your hands to climb, jump, and move through the world as you explore what happened and try to survive whatever is waiting for you. Whether you\u2019re playing alone or with friends, every session brings new scares and challenges."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/manke-slop/privacy-policy?authuser=0", "developer_terms_of_service_url": null, "publisher_name": "Basher Studios", "support_website_url": null, "website_url": "https://sites.google.com/view/manke-slop/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAM
0_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssIXuBAW-1YQ7kNvwGmW8n-&_nc_oc=Adkd-GzOua0XXZzOlO1UXMPlyFWxTMWRsy2m_BXhfeDSdTjs8WTZ1ecjhSGvIM5ZwA4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Afs1Rf9PBWFDjk3FUzj7JeXChiHXgU1bfUuld8kWGADugw&oe=69A58593"}, {"file_name": "migrated_image.png", "id": "883675935391142", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982679_1758739041001693_8016769999462989824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3MdpVKx1GkQ7kNvwEPTrEe&_nc_oc=AdnBt0zLhUmEwGwMirAnr29a3YkNYZTA7OSaguq_uT0ABbGCjNbOdgJJV24PIHG6jUA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftUjXA9r8zPIrybZ7zO54OdZdDDSM7D2t61v2KSJdxKKA&oe=69A589D2"}, {"file_name": "migrated_image.png", "id": "843028109535114", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003224_511784736012705_1616856617721004032_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBHDWLF6zVIQ7kNvwETDEcg&_nc_oc=AdmXlHZyV48nQkJmMpmdO3KUAf4zv7YiJFW6B3h8NYYXm9dwxGJx0Gkgwp-UmHc_bN8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftBzf0GSHinPBFvRy98MMqjjrZ4mYO52Kvgbrw-2dF04w&oe=69A56F35"}, {"file_name": "migrated_image.png", "id": "235108140977493", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982559_296345414378321_8211754531084566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2RsDXOAvyAQ7kNvwG5pWg2&_nc_oc=AdnCoh-WK8N2jsBqAe179VBmC_8RhbpcKenu_QX8KnNLKhYb5y49_LA-lAYOZ5iq1-c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afv-WZ_awNfONKaVDN2BPXaQZzQalBn4iGffuIfkf51zQg&oe=69A56B13"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/lZ6Ryf", "id": "2133195983651863", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974506_2133195986985196_2245220671112085504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0cLM06_SL4Q7kNvwHu896Z&_nc_oc=AdkVzdrXepkSzHTr8rI_awyFlcbvB1Lt2adU4UXg-envFk9tePFpNeSWRqT3NCHmfLU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afte9Z5MW5plpqAZM8gZCicc-BmppwTgaTz3eq8nsiAZiQ&oe=69A58EAA"}, "display_name": "Hockey Player VR", "keywords": ["hockey", "sport", "nhl", "multiplayer", "ice"], "long_description": "Play hockey in first person view and develop your own tactics and tricks. Finally, a hockey game where you have 100% control. Test out your puck skills in online multiplayer mode.\n\nFeatures:\n- 4 training modes\n- Multiplayer for 2 or 4 players\n- 100% control\n- Realistic physics\n- Leaderboards\n- Voice chat\n\nIt's quite easy to start playing it but if you want to become a master then well, be prepared for a countless hours spent on the virtual hockey arena. Feel invited to play the game, you will be surprised!", "short_description": "Play hockey in first person view."}]}, "developer_name": "Brosvision s.r.o.", "developer_privacy_policy_url": "http://hockeyplayervr.com/terms-of-use/", "developer_terms_of_service_url": "http://hockeyplayervr.com/terms-of-use/", "publisher_name": "Brosvision s.r.o.", "support_website_url": "http://hockeyplayervr.com/", "website_url": "http://hockeyplayervr.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1087173092107281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974644_533622203827927_8440027189553922048_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N661JrIMC_YQ7kNvwFF18X_&_nc_oc=AdkAnYGIPKDmUe8G1w1nY58IC17mKFFjwQ5wUzOGfCjNw16
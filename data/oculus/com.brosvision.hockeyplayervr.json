0_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIeJpmCbvx0Q7kNvwEhn_67&_nc_oc=Adnr7-L0IKbMcFJiV2iEFE2kRg0YKLH2mBblr9U2t5RG4IiUe0ZMxrH4_ap3Dbd5spQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfugeqyRNVHzgZqM9vFXylH14_XEEKdBJ6ftwZVB2Szxww&oe=69A03F93"}, {"file_name": "migrated_image.png", "id": "883675935391142", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982679_1758739041001693_8016769999462989824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6uuBn0fqJYQ7kNvwEVzk48&_nc_oc=AdnS8JviVM9034BGRVRHD9UKsaYAzLVkbTwJUsuOS6XxF-SdsIQdPVhLdX043fwaqj8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsmIlscCA-f-CGT86WdX2MIK9RZUVimDrEttU16UZskSQ&oe=69A043D2"}, {"file_name": "migrated_image.png", "id": "843028109535114", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003224_511784736012705_1616856617721004032_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qV-Mhmbu8icQ7kNvwFXssm8&_nc_oc=AdlN5T1RWHRXNR56_XWhn5kyjLkMfod0PRve1LtfkMMw7p5OJSQAXoqBuUm_RgNTWDg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsozmiVZw0NJJrjoM4vi42wrSf_MZDHaarAdZNmlkaCoQ&oe=69A02935"}, {"file_name": "migrated_image.png", "id": "235108140977493", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982559_296345414378321_8211754531084566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQ9k8luXkEIQ7kNvwGzeUH4&_nc_oc=AdmUE11vdHT8UPZTKJySbCv21WaPU5OHYN9qafDSPC7pdkgcAYNWBEsbsYp2hssxOeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuXDcklpDJ9HNPBsnuyyQBf1S626ulHHfEjhXd5JQcyTA&oe=69A02513"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/lZ6Ryf", "id": "2133195983651863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974506_2133195986985196_2245220671112085504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQsG9h3gufMQ7kNvwGVNmAM&_nc_oc=AdlcS6iKxyeTGdZ-Ux9OrEM-vsWLF4bLbtplBefoO5wdlWWgUj6UECrMxMVAYM6L60o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftSZnAV0yr_JZEdB1-uc0uIa7EmXjKz6_piezHD2CTD5A&oe=69A048AA"}, "display_name": "Hockey Player VR", "keywords": ["hockey", "sport", "nhl", "multiplayer", "ice"], "long_description": "Play hockey in first person view and develop your own tactics and tricks. Finally, a hockey game where you have 100% control. Test out your puck skills in online multiplayer mode.\n\nFeatures:\n- 4 training modes\n- Multiplayer for 2 or 4 players\n- 100% control\n- Realistic physics\n- Leaderboards\n- Voice chat\n\nIt's quite easy to start playing it but if you want to become a master then well, be prepared for a countless hours spent on the virtual hockey arena. Feel invited to play the game, you will be surprised!", "short_description": "Play hockey in first person view."}]}, "developer_name": "Brosvision s.r.o.", "developer_privacy_policy_url": "http://hockeyplayervr.com/terms-of-use/", "developer_terms_of_service_url": "http://hockeyplayervr.com/terms-of-use/", "publisher_name": "Brosvision s.r.o.", "support_website_url": "http://hockeyplayervr.com/", "website_url": "http://hockeyplayervr.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1087173092107281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974644_533622203827927_8440027189553922048_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eduCZmt5y7cQ7kNvwF8PJxH&_nc_oc=Adnot1OVp1Ed3S-eXVzDbfkChLKz5Pq2G-OhDlBJdOGSIvn
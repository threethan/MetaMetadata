0_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZBIzNyaQ6wQ7kNvwEdu-9-&_nc_oc=AdlunnJSz4cNQP9F4BAbXMYZGspd9DVV3ozIFeDR3Vo-H-XhtKeyBDdno1g-1RqnzJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv0lMrpptYhNzHuINHhInBNMy1ggH-CjU9VwYYryFzymQ&oe=699D9C93"}, {"file_name": "migrated_image.png", "id": "883675935391142", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982679_1758739041001693_8016769999462989824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7pYSbo-518Q7kNvwHP6qbs&_nc_oc=AdnN8BscJ-Al1hsJFKTSAKwVfPDepUzvO9-oALr4Fj5Vke5wH5VSWSC79TukfrGXT54&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs6NNK68awDuEMD_3ms6lEYaxzpN03ZrMSyyneLu4Iweg&oe=699DA0D2"}, {"file_name": "migrated_image.png", "id": "843028109535114", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003224_511784736012705_1616856617721004032_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qV-Mhmbu8icQ7kNvwG4dS7e&_nc_oc=AdkGul_TkhrWyez2O0tqDJb9rrNivcJxCI57QwFUUCVdtVTN6RKexDlh4E8DKDo8pIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsI8kR_fvR8DtdUPKCHLFmgedJo2_QALsZtIWxkZX4oQw&oe=699D8635"}, {"file_name": "migrated_image.png", "id": "235108140977493", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982559_296345414378321_8211754531084566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6e7VfQeAOfIQ7kNvwF3sxiZ&_nc_oc=AdkxiHo3uY2CgBSbz2kwQ99gn56JyCHLyQRxtRKYHnKHyzhxIpusI4N7ozuIXPzSU3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvSTEakHW61IxOCu4f5yA4tnyauur6f0wOxSVST5ix6Fg&oe=699D8213"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/lZ6Ryf", "id": "2133195983651863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974506_2133195986985196_2245220671112085504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_0zCLcAl8cQ7kNvwH9mQbf&_nc_oc=AdkSdwWd2CxeMSFdT9az2-JXcNM5tAlbYoZnglRi5wiPsB1pRG_FrB8FgMehlMdoH-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu15vxjxLvRDWMqDfuJ7yGwBRY0Do0AAIPdxreZQVwrdA&oe=699DA5AA"}, "display_name": "Hockey Player VR", "keywords": ["hockey", "sport", "nhl", "multiplayer", "ice"], "long_description": "Play hockey in first person view and develop your own tactics and tricks. Finally, a hockey game where you have 100% control. Test out your puck skills in online multiplayer mode.\n\nFeatures:\n- 4 training modes\n- Multiplayer for 2 or 4 players\n- 100% control\n- Realistic physics\n- Leaderboards\n- Voice chat\n\nIt's quite easy to start playing it but if you want to become a master then well, be prepared for a countless hours spent on the virtual hockey arena. Feel invited to play the game, you will be surprised!", "short_description": "Play hockey in first person view."}]}, "developer_name": "Brosvision s.r.o.", "developer_privacy_policy_url": "http://hockeyplayervr.com/terms-of-use/", "developer_terms_of_service_url": "http://hockeyplayervr.com/terms-of-use/", "publisher_name": "Brosvision s.r.o.", "support_website_url": "http://hockeyplayervr.com/", "website_url": "http://hockeyplayervr.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1087173092107281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974644_533622203827927_8440027189553922048_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6VZdQE0FQ4Q7kNvwEHZplh&_nc_oc=Adl1_GCQOAJkhHxDSc-0BVV6TrqYwp6VWttHbCSf52TLdkS
341072", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974702_301639227168391_2791089329143808000_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tpTR00sc5uMQ7kNvwFXptlT&_nc_oc=Adrr_2zw1cdRGjV0YwS7InnBZTtNX7cz4aUJ62mndblXFhlDh7hcKC0cf4kLyfi2778&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHitHVOSii_iJxu5O3lmVMMEedBObGSlzXhcZRzX-41gw&oe=6A8EDF13"}, {"file_name": "migrated_image.png", "id": "883675935391142", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982679_1758739041001693_8016769999462989824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUlMp5ExWKgQ7kNvwFOo1XF&_nc_oc=AdoG9KI_A4-OrkkaIfPbXV4-OtNwH4eUVxUgFB_bHKurnXW9sPIyozIKJmZyibgDTvc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwbgCc8BUX1Zs3SM55kg7ImQWXhjGoio_NpAgvOzB2yQ&oe=6A8EE352"}, {"file_name": "migrated_image.png", "id": "843028109535114", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39003224_511784736012705_1616856617721004032_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRBMthHdxRgQ7kNvwG2lDyT&_nc_oc=Adq-JzZly_C0fPEyprjdaJMRfNl0_otWqutze0GozhRbGGi2wSwszgy0tKJyJsFfifE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV4bT2pM1FaFReXQTphqaH7X0VKIH-5tmswe_r_Z_qPg&oe=6A8EC8B5"}, {"file_name": "migrated_image.png", "id": "235108140977493", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982559_296345414378321_8211754531084566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7W9iJ_soQpAQ7kNvwEiJkYV&_nc_oc=AdpmkrnnsemuIv57KpQrHQLEM9i68hRopT5M6-9Vc8dr297JOlRYHHW40zcieDlaDKI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW1yIQh42BbYRzbXFEOjJDpnHgQinpcSPZWk3nRRO3Gg&oe=6A8EC493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/lZ6Ryf", "id": "2133195983651863", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974506_2133195986985196_2245220671112085504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNWQjor6EyYQ7kNvwHKdHJL&_nc_oc=AdoZq2o03YuWlYmuQ57PzeMaUFVpAQ1QnWuuj2zf8CynCwcs1_WT77XXXWldoAhPRUE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8XrtQkZWiVaUf8d88kM8nO9xCiQ4QQ7brF79ON0_XxA&oe=6A8EE82A"}, "display_name": "Hockey Player VR", "keywords": ["hockey", "sport", "nhl", "multiplayer", "ice"], "long_description": "Play hockey in first person view and develop your own tactics and tricks. Finally, a hockey game where you have 100% control. Test out your puck skills in online multiplayer mode.\n\nFeatures:\n- 4 training modes\n- Multiplayer for 2 or 4 players\n- 100% control\n- Realistic physics\n- Leaderboards\n- Voice chat\n\nIt's quite easy to start playing it but if you want to become a master then well, be prepared for a countless hours spent on the virtual hockey arena. Feel invited to play the game, you will be surprised!", "short_description": "Play hockey in first person view."}]}, "developer_name": "Brosvision s.r.o.", "developer_privacy_policy_url": "http://hockeyplayervr.com/terms-of-use/", "developer_terms_of_service_url": "http://hockeyplayervr.com/terms-of-use/", "publisher_name": "Brosvision s.r.o.", "support_website_url": "http://hockeyplayervr.com/", "website_url": "http://hockeyplayervr.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1087173092107281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974644_5
Q&oe=6B005DD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/lZ6Ryf", "id": "2133195983651863", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974506_2133195986985196_2245220671112085504_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24bcktYU4tIQ7kNvwG33Pdq&_nc_oc=AdpW57gwQE3ICd4vcnzO_Ru0FYXNdH6bjX9KkmpjKAA-LLrdX6NO3_OY8KfA3z5b3sY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS39nMzEaEjkoEJ1OONrHD3CGfjq7rApFoRGBhTgw7YzQ&oe=6B00816A"}, "display_name": "Hockey Player VR", "keywords": ["hockey", "sport", "nhl", "multiplayer", "ice"], "long_description": "Play hockey in first person view and develop your own tactics and tricks. Finally, a hockey game where you have 100% control. Test out your puck skills in online multiplayer mode.\n\nFeatures:\n- 4 training modes\n- Multiplayer for 2 or 4 players\n- 100% control\n- Realistic physics\n- Leaderboards\n- Voice chat\n\nIt's quite easy to start playing it but if you want to become a master then well, be prepared for a countless hours spent on the virtual hockey arena. Feel invited to play the game, you will be surprised!", "short_description": "Play hockey in first person view."}]}, "developer_name": "Brosvision s.r.o.", "developer_privacy_policy_url": "http://hockeyplayervr.com/terms-of-use/", "developer_terms_of_service_url": "http://hockeyplayervr.com/terms-of-use/", "publisher_name": "Brosvision s.r.o.", "support_website_url": "http://hockeyplayervr.com/", "website_url": "http://hockeyplayervr.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "
Cmaa9Q8zAJQTbORcNqh41tgl74IvUn-XgaQS5CwWqMGNxPs-i8sHzW9bIKqLWzlU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPYL_crZ_55J7rcZiY9Z0nzHeEp1qnxC5eNg6GodecKA&oe=6A58DAAA"}, "display_name": "Hockey Player VR", "keywords": ["hockey", "sport", "nhl", "multiplayer", "ice"], "long_description": "Play hockey in first person view and develop your own tactics and tricks. Finally, a hockey game where you have 100% control. Test out your puck skills in online multiplayer mode.\n\nFeatures:\n- 4 training modes\n- Multiplayer for 2 or 4 players\n- 100% control\n- Realistic physics\n- Leaderboards\n- Voice chat\n\nIt's quite easy to start playing it but if you want to become a master then well, be prepared for a countless hours spent on the virtual hockey arena. Feel invited to play the game, you will be surprised!", "short_description": "Play hockey in first person view."}]}, "developer_name": "Brosvision s.r.o.", "developer_privacy_policy_url": "http://hockeyplayervr.com/terms-of-use/", "developer_terms_of_service_url": "http://hockeyplayervr.com/terms-of-use/", "publisher_name": "Brosvision s.r.o.", "support_website_url": "http://hockeyplayervr.com/", "website_url": "http://hockeyplayervr.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1087173092107281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974644_533622203827927
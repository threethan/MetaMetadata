0_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssIXuBAW-1YQ7kNvwGAyM3_&_nc_oc=AdkzXvUL0ssrsobijYbrHnPhR5SWI4mOoBCwlT7zc3iuOgbfNxgL3NFbIzSmUreBi38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsHBAVSQkstckR76oLU7LlG41YcAWEKnSysEmrCkBH2DQ&oe=69A43413"}, {"file_name": "migrated_image.png", "id": "883675935391142", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982679_1758739041001693_8016769999462989824_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3MdpVKx1GkQ7kNvwEeqidz&_nc_oc=AdmF2o0CEwaWhz5my90LB6IDIQ2Kfq7pdg7R_hkDV7YZ3M5NTbl4Fc7rFSjAtsBZekU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu6on5qAk2HEN67lU2DKexc6EfI-ZUzfMdsj7aBCjPDiQ&oe=69A43852"}, {"file_name": "migrated_image.png", "id": "843028109535114", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003224_511784736012705_1616856617721004032_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMxLPvvC0KUQ7kNvwGYnfK1&_nc_oc=AdmjUtemKsN7gmfNH1-KyIbXkxzSuxhTPDKcmMIes9QUyMqUIW1TXvNIuqAqvmDdCZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsgUnbUMoTkwCV8enZAHQtN71DAfZAfRjv7Ktumhftx2w&oe=69A41DB5"}, {"file_name": "migrated_image.png", "id": "235108140977493", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982559_296345414378321_8211754531084566528_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2RsDXOAvyAQ7kNvwF3mRTW&_nc_oc=AdmKvDsNXN60awkWZXvktSAYjEiPdW_L8iuOQPqTBOEN5pK0D5zu_e-4q02wftHgV1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs93fq52qJYDveELnTZJ3eS06ptdzkVjjgCwBVUlhjrJA&oe=69A41993"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/lZ6Ryf", "id": "2133195983651863", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974506_2133195986985196_2245220671112085504_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0cLM06_SL4Q7kNvwEJhJ5x&_nc_oc=Adk5_8xf-1ujspmjov3BFbPyou4UK4okCayDTKCvXPsd-bN2isRWxYJHr8FBkFRyBPE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvwKkQJbgcB2Qrmo8yaxJtJQY-GgbU2MbS8L9_kKAOzig&oe=69A43D2A"}, "display_name": "Hockey Player VR", "keywords": ["hockey", "sport", "nhl", "multiplayer", "ice"], "long_description": "Play hockey in first person view and develop your own tactics and tricks. Finally, a hockey game where you have 100% control. Test out your puck skills in online multiplayer mode.\n\nFeatures:\n- 4 training modes\n- Multiplayer for 2 or 4 players\n- 100% control\n- Realistic physics\n- Leaderboards\n- Voice chat\n\nIt's quite easy to start playing it but if you want to become a master then well, be prepared for a countless hours spent on the virtual hockey arena. Feel invited to play the game, you will be surprised!", "short_description": "Play hockey in first person view."}]}, "developer_name": "Brosvision s.r.o.", "developer_privacy_policy_url": "http://hockeyplayervr.com/terms-of-use/", "developer_terms_of_service_url": "http://hockeyplayervr.com/terms-of-use/", "publisher_name": "Brosvision s.r.o.", "support_website_url": "http://hockeyplayervr.com/", "website_url": "http://hockeyplayervr.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1087173092107281"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974644_533622203827927_8440027189553922048_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N661JrIMC_YQ7kNvwGaSD98&_nc_oc=AdnYRveV31vQoNO4J_2-sl1faMAlnbI7QCLkNluBLssTjBT
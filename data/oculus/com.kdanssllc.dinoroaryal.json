c_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9HqIQJqxeeALtp8-Bf2XT9oYvRqPKtcZ2cS8Xr1XvSw&oe=6AAFE69E"}, {"file_name": "Screen3.png", "id": "555960036464171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003247_555960039797504_6283154447311500594_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpfLulw9Mq8Q7kNvwHS8g9I&_nc_oc=AdqMOP5inA3wfHFR6w_KzBlRNBzzqwzu1MZpSh94ingPPsEPHablFlNJb4ff6SAXsQk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1l3ASWlHiJ1CFFjwpnQtAxyztoAhH2SDRhsA0SJPOKA&oe=6AAFD606"}, {"file_name": "Screen5.png", "id": "1659979641107269", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75207242_1659979644440602_5068102189490911809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joVkP1EhELsQ7kNvwGhCZPk&_nc_oc=Ado3yk0zn8YmBI88GGfw2H-Oal6ZHp7ntpxtyRPTnvFqeZt_rjbbQQDhftdwMGWmzgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNRtOEJfgGT7BLcdaOrYHCLGsl7i3wNwxKTOf5jGVA1g&oe=6AAFD4F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqwytx6xplkQ7kNvwEbpO9G&_nc_oc=Adp3jimFbp8Ff3IDQYQ0QoFvR5n4bxEl4Z3-BxEJchDGuRyb-vEz0ZI8M-4fjJ0U65o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqwVRjljIF3OEaPEZLRufydV0dvUgMqfJYOm0S961wxg&oe=6AAFFFE6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141512129892633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75348039_643163971147937_2869582510757944570_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBbZwH2Sf28Q7kNvwFEg1ta&_nc_oc=AdoWcit9VNoU3GhKfg01x6UuGanHenj3FWoaydoPfRs4OhOrfksO7gQ-OFMNxda4W7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxUZ5dd22i7T7PNWep5QbynMxvSXv6Xvu5bYZSHQSwuQ&oe=6AAFD7D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Roaryal", "platform": "ANDROID_6DOF", "context_categ
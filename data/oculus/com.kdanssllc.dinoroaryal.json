c_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cUlb7zu4WnF5GwO22GBt84Pu0uHCgkfO4gS5qyqd9Eg&oe=6A3BE29E"}, {"file_name": "Screen3.png", "id": "555960036464171", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003247_555960039797504_6283154447311500594_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Nmlj9fimbwQ7kNvwE4k774&_nc_oc=AdrkNmmehZODIM9J27uLaxj0ceQsNVpGN-BvVejD1LDA50JGrJncL8w8gr_0Z3D0xik&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VMkJWlmyQ0Bw1zPJhp0l76TRXgM20CQA3kuoCPq8bUw&oe=6A3BD206"}, {"file_name": "Screen5.png", "id": "1659979641107269", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75207242_1659979644440602_5068102189490911809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5_HsWygFaMQ7kNvwH612qU&_nc_oc=AdqiSeUiF5z7Sbr4CFvhXOM6w0WPP5w14Fa-3UbjJxunu7pjKo7i7Mie6qF46nHivhE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qBwiDDGWFmw-2NLJCMYWteeTK7II64TKO1PJbbPwFcw&oe=6A3BD0F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dzowic94YI8Q7kNvwFjlJgS&_nc_oc=AdrDHUzDRJmzVZMPpGD50ViyiMqTuG15W1uEcIO25Rh14oWkRZS7urR-m4IhE_Np5i8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b1QLW6vj--kcxjmzuN4FuszyG_h5DvrgD89ct0sipcA&oe=6A3BFBE6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141512129892633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348039_643163971147937_2869582510757944570_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoOvAoODXlEQ7kNvwHRo2eS&_nc_oc=AdrkvlM3-dDENW1cJ-jB0xkPtk9pepZqwPyvEgIKOmFKKViDoZSO6IRV1UtHFzf5geg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_toaS7r_l8UIAxPKeCRplJ7T-4yASjLY5CEAEwSUuFCA&oe=6A3BD3D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Roaryal", "platform": "ANDROID_6DOF", "context_categ
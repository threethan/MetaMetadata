-7&_nc_sid=6e7a0a&_nc_ohc=k4BrYyV1pQAQ7kNvwGswDEj&_nc_oc=AdqbSfeo0Z3NZt7S1p4df27rDZXgeapdZliaHeIy9BscBGe1W95JqsToqxmb4lzTHUM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2DFNRA9OR_i7o4XGDWKSA654gkkMqvufFhNf7yW0Hqw&oe=6A6600F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-GoZQE-VOzAQ7kNvwHstX0d&_nc_oc=Adrw5n-P6C_vTTcKA3BfO2voTlpq0yBH7p7Y_R7vYYCUjuJDZQfAInPr3cDGaGk1W3w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLQ2yaqFnN1LsbDH-fVrWDy00hqHncVUlDQoJWB3CMGw&oe=6A65F3A6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfor
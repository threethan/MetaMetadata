c_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af959TJPIWmhoNL-O2RTBAopWMUKlaWqe9RZEgFUzg6PIw&oe=6A31569E"}, {"file_name": "Screen3.png", "id": "555960036464171", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003247_555960039797504_6283154447311500594_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G54DRHH7WnwQ7kNvwHj2B7r&_nc_oc=AdqFGS0cM27vCdvzE7WxGlDLKgO4cZODoAmBVda3MDjAuS_kkFbY3uPxiHrHRkyBeLg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XL-sZwYQrHmw0oE9ZzfNqnG6RFY1WOFSYxcIL3E_JBA&oe=6A314606"}, {"file_name": "Screen5.png", "id": "1659979641107269", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75207242_1659979644440602_5068102189490911809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DKwYJ4bpzIQ7kNvwFQbKSC&_nc_oc=Adrtyoa30Dumamx41GPiqhHsF6gZFxdf7AVCidFKEh1sNCWspCWCSO6XzLEkh9XF9do&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xh8Gd7A16VfksyZhDxCt2eucH5Zd8DTwtOID7ttsuig&oe=6A3144F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HyyGxY9Vj4UQ7kNvwHv29ZI&_nc_oc=Ado2OheoJl8gJVloJ7RBM-TpnFgiqcmvTBkU2a2b7lFjLc1dT4qhFprHyVTu7ONwkTU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9iygMKTfgn0H2UXKt0NGNlfwPzqpENig6fFgMD1WiFA&oe=6A316FE6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141512129892633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348039_643163971147937_2869582510757944570_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDDJyRF6F6sQ7kNvwHIIyzg&_nc_oc=AdrMOk4_GeUd9ld69Nv2MQDz6RqRn9Jw8Fd0xtkmnXLuON_OppiOm-VsX9ElbhZoBmY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OAahNho7z0KBhyXDw1evzXERa2aC8H8iF_Q1HOA38pw&oe=6A3147D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Roaryal", "platform": "ANDROID_6DOF", "context_categ
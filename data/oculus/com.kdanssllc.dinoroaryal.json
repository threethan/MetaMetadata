-7&_nc_sid=6e7a0a&_nc_ohc=pyJaumBdB4EQ7kNvwEMJSNU&_nc_oc=AdrujH_YzLs5_qHomZOQjF0LrItqiVLPfSWe4q5ZBN4q2h_sWjIL4Mz5z5h9vH1L2EQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZc3ZDqVOyXXTvhc-JxncimmGmjHFqN1B68oDX8nmXMg&oe=6A79C770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiZtjZGfklwQ7kNvwGNjTM-&_nc_oc=AdodPvKlVto-EUjYeMiv2Q-aM0DFQP0-3yoxbV4tToYnQYiZN170xSKZkFdAqFCEabo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP5Clzfi8O8OdbHbkXdenuPLjc8Apdg0V0EPM_U6vslw&oe=6A79BA26"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfor
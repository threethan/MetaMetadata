c_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbvP1eJ7la6C4_joICCb-uIWTmzV3CKRYFy12nsO1JpA&oe=6AD3B75E"}, {"file_name": "Screen3.png", "id": "555960036464171", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003247_555960039797504_6283154447311500594_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgK0A4Jg_LEQ7kNvwHiS0Cp&_nc_oc=AdqxPfZ9yRPA-q99C_M-_mDa9lkNSQWYXNX_v2fOBsDUYjn1LnoOt65_Iw7X9hCj3T4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3K6ZIMCIMBkhG8YsmHxzUriL16UoScGjXWPBnmc495Q&oe=6AD3A6C6"}, {"file_name": "Screen5.png", "id": "1659979641107269", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75207242_1659979644440602_5068102189490911809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCnkQNAmbBcQ7kNvwHnN9D1&_nc_oc=AdogYBZZwzIqtfPM_zzPBRw_rsqRwraQDoCFMq4ofSFOLN4sk7swQ1ldhi3laG8rBOY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4N8c2gapAZylnoCtNQLVJySifjh3dUsJaT76alvbuvw&oe=6AD3A5B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFxD1360OY4Q7kNvwFv164c&_nc_oc=AdpX-3HVLzJx62SoBwD36-KJgnBt3nkwowrTjw8LxkBNBPsLyIX_9oLT-HmdstvPwsc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOchxQbAPVB1BC_tK3M0VvQOGBxxA33fvC7FKyZDUSR_A&oe=6AD39866"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141512129892633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75348039_643163971147937_2869582510757944570_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_VV1iECUjoQ7kNvwEHOUHj&_nc_oc=AdoeTLyTyl59NZpXZxeFbITPcAgPgnZyiQ2QPGxAdKulKu7pZI1jdUmlwxQpiRvgDYA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtKjrHKgSb5_0miFuwseOVqCasKNBLFkiMy9iM7fPKTw&oe=6AD3A890"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Roaryal", "platform": "ANDROID_6DOF", "context_categ
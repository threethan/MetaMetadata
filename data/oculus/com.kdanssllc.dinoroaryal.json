c_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxfTWwnG0oB_WnR78l3EHyifRf0S8aEWcyKooynDbcSA&oe=6AD0DC1E"}, {"file_name": "Screen3.png", "id": "555960036464171", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003247_555960039797504_6283154447311500594_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biL7Zd-xpz4Q7kNvwGudaG9&_nc_oc=AdpmjJftmA6INo0xNf3sHYR8Vvr6FLtr-MraI2nCCCXLu3Upqbf_gZespb3xGmvBhDY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9VW0nwsIerXiwhtLr9-v7Xz2p9wxT9pOIepfBvc0VsA&oe=6AD103C6"}, {"file_name": "Screen5.png", "id": "1659979641107269", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75207242_1659979644440602_5068102189490911809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKsi4e5GFo8Q7kNvwEltofY&_nc_oc=Ado4s99j22L7lpanhajlJn14aG5DWqQYl7WjFja_UCzGC0wV9L1LKXnBdbzHDDv7v98&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZMiQGcy5UPbI-u7PC3C-D4GN53rZbx-d7wupLDw8wvA&oe=6AD102B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFxD1360OY4Q7kNvwFFgyvk&_nc_oc=AdpUSLLZiB7okMyMw3onTxtZx6N1_f3T2c0VFeSe-beQbDhiE30DFhlG2AOU3z_KIDU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvr33pcMH987jCrfJ6aPL4lGQsB50OhrMWW2ddXAk_Dw&oe=6AD0F566"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141512129892633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348039_643163971147937_2869582510757944570_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_VV1iECUjoQ7kNvwGTCxMZ&_nc_oc=AdqmQ0B6QHlZRIX7d42c_fS-zi9a2x4js13bpE95JdB07xHz4u_sjVV63dYfYaWwyyY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdMr6g_i-W7JfkINl0DWrI63hTNwJmrPJS4XlGlPX_aA&oe=6AD10590"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Roaryal", "platform": "ANDROID_6DOF", "context_categ
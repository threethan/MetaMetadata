-7&_nc_sid=6e7a0a&_nc_ohc=to6ywx8pXtkQ7kNvwHIZdHo&_nc_oc=Adp1GtKgsCI-o1aZzul5bKUMviw69CiMlQ8ESe0RyEpXBJVzzk_d5rrVJt_g4E6olAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWrPeHOBVtlvZaGb0EKOlVffWbU0x_aQ4brBKdwBwA2A&oe=6A5F6970"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTGhKuXt1NoQ7kNvwFqDvkY&_nc_oc=AdoHDzRelHscn8-RGcfV7AlNmxgCGbNgq0WWq8wcFSJhB112cD8PuFY4lPQ5SsYLW0Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5R1k3KegQOoel6mOAtgh-v8f827axqeYDT4TB8UFp0Q&oe=6A5F5C26"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfor
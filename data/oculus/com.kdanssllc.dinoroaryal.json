-7&_nc_sid=6e7a0a&_nc_ohc=7AXVKWz1u_kQ7kNvwH2RRQl&_nc_oc=Ado5SYdaN9TKp27YgKEXrtIBqCGrFfAPzSqx3mbh28Rxz5Sgb34lqORYc0r6xoBLJ8Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03nR07fO0FFVCO2JFSBszf0dDiJy20q48gB9dMU9he-g&oe=69E8C270"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hlXgM74ow0Q7kNvwH_XVdg&_nc_oc=AdryMLziTXGkOCt_qWVhKkHsIzEKk8Yv0b2b0OUYR1O_VikVmSBvCYeMIFOEbV3bEIY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IIJ3ww_QmCo_RFy5Opp4VYWbZ15mKLOgyHMky4nM4BA&oe=69E8B526"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfor
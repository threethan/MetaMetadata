=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWlDeTZHAGqoqZSuWHyddnPBwGkMx_XpsmWf75S1MUJg&oe=6A7DCD9E"}, {"file_name": "Screen3.png", "id": "555960036464171", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003247_555960039797504_6283154447311500594_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0FD8IHjjHMQ7kNvwGsL_1W&_nc_oc=AdpamYd85H1Viz0C1ksn0OGD8esMzTqbupvxhIGbR7nXJoEN0Ma8iY1n5uMEifqVxEk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzsKnS5HW-qhwSJKSu6hArLRej6_s7WGfvs89as7rC1Q&oe=6A7DBD06"}, {"file_name": "Screen5.png", "id": "1659979641107269", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75207242_1659979644440602_5068102189490911809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXROzzcmfXsQ7kNvwGAyrkm&_nc_oc=AdrxZ3C2QZngGRVzNZifnEqdLgHKar2WO47V8Oj9JuLZPFvuYU98ZbdFYANPvtULNeM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu1TvPYBH4eT9qVkb_t3oC91Fj2ggAcqCU76sbHU_VTQ&oe=6A7DBBF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn1KvWj-o3kQ7kNvwFaB8Jr&_nc_oc=AdpoTzvX8H0W6jw2IJWiExKklb5VfQ-y9-8DoF4H3MralVB_KFqTIO3ntfGtxeAxZUo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuDR9wTKqWzamHnr3faOPdq30VVqSAE6oDi3htOTXiGQ&oe=6A7DAEA6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141512129892633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75348039_643163971147937_2869582510757944570_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5UjjmoU4Fj8Q7kNvwGov4hO&_nc_oc=AdrA-M3Dt3rhWnBQRnxYfkhrBlTpp5Xc1NEOLAfsAOxcYJaQ3ANKkHoXG5_w3Zh91Nc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERpds60_Ks066DKMi9-oue4ATAlRsdSORdp2sbGKFukA&oe=6A7DBED0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Roaryal", "platform": "ANDROID_6DOF", "con
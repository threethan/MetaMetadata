-7&_nc_sid=6e7a0a&_nc_ohc=joVkP1EhELsQ7kNvwGhCZPk&_nc_oc=Ado3yk0zn8YmBI88GGfw2H-Oal6ZHp7ntpxtyRPTnvFqeZt_rjbbQQDhftdwMGWmzgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNRtOEJfgGT7BLcdaOrYHCLGsl7i3wNwxKTOf5jGVA1g&oe=6AAFD4F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqwytx6xplkQ7kNvwEbpO9G&_nc_oc=Adp3jimFbp8Ff3IDQYQ0QoFvR5n4bxEl4Z3-BxEJchDGuRyb-vEz0ZI8M-4fjJ0U65o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqwVRjljIF3OEaPEZLRufydV0dvUgMqfJYOm0S961wxg&oe=6AAFFFE6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfor
-2.oculuscdn.com/v/t64.5771-25/75557065_874143490521137_358369232386626125_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbBIXZPkyY8Q7kNvwG25Nh7&_nc_oc=AdoZFZ7GgvTtKRCCu442rtDM2Po__YKDJ39l7AIU371pHUncDx2iqK3r82MAZXc9-jI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStUBs-PF9N5MIlkdD1sWVj7YbSqfdHwSo1v-PqcwIQsw&oe=6AFF009E"}, {"file_name": "Screen3.png", "id": "555960036464171", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003247_555960039797504_6283154447311500594_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqlDgu9tNYoQ7kNvwGTwIr2&_nc_oc=Adr8L7zUhkgBHHY_eaFzOtnBQtVL3y6teD10TFBfMCP3egjj5zn_Vp04fCaypVu6ULs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3Z8-9Jg01FvLyvzyQaexUykrF0IWNAeBsyMI7FJdcSg&oe=6AFF2846"}, {"file_name": "Screen5.png", "id": "1659979641107269", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75207242_1659979644440602_5068102189490911809_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S2tjYCX4QC8Q7kNvwHLJbaT&_nc_oc=AdozDrGa16f0SacmixZ5juvIUkRMcYUTO9G52eS8oopoUGVQAC0LSBMJ8Pvh6Ykxrck&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcJuBda5kYB83SkP2ibdUHBVuW3G9Xjaawlv4uiv1HWw&oe=6AFF2730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgV9DqzAKdwQ7kNvwGLeHH5&_nc_oc=Adpam67H4INKm7up5a30irtfm4SYHPvmctxE35n9cjmkAc2scbLrh_LaEHzHC1yNbNI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPH_6ul48Veq2XGaxl5kkmgQxAR2C-RgsktT5U9tCUtg&oe=6AFF19E6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141512129892633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348039_643163971147937_2869582510757944570_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIrLFk
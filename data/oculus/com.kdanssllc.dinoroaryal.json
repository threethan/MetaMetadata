-7&_nc_sid=6e7a0a&_nc_ohc=L6LXy1VX_FcQ7kNvwEVuPF7&_nc_oc=AdpJqdLtwixiOpP_Ch8FdOoc7AhEWN9qzCPrkb_Y8feTrW3_mpMJZX3DAkBQp94GCm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvTAUd7D_EZEXSDPQhjsINp6GHGHoAVid-cSBD2g87tg&oe=6A523A70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljcSB6DYaGgQ7kNvwFvINxY&_nc_oc=Adro6IyekqB6OcFtn1JMsMVE5FacZl6SgUqgQay0nUgQ3XGPP5R7kj7eFt63ZDX9MvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvZ8ITkswie6LT9TaIcpxac--t9gPNgh9dOL3dgsHP2A&oe=6A526566"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfor
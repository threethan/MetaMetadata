-7&_nc_sid=6e7a0a&_nc_ohc=UDPZ7Nrb1n4Q7kNvwGAHA9d&_nc_oc=AdoYxj1U3rkaDUIyM9EUpmvxV_1VIlf_GmSBCkQ07PHRT5H5BGM9eS_ZKB7uNHluJlM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoBVsEV4yNsroNFBcfHVF8bEvYHXU_xFbNcswLz41m7w&oe=6ABD03F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ip3omXmne8Q7kNvwGs87Ff&_nc_oc=AdoTFpRpDgco8SyeIfZnRiNJ-wt8CcB5rwvYhFNMv-46vMNn011dVFUZX-cfLrloCts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZIxhiIiNm_keYHIDDvLhbrRD-JlDFMaZa1qRMkll0mg&oe=6ABD2EE6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfor
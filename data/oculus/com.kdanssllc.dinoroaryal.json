=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OCSN-P2Msalw0f0-Xn4VG2PBUffub185IBmLEQ9u44w&oe=6A393F9E"}, {"file_name": "Screen3.png", "id": "555960036464171", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39003247_555960039797504_6283154447311500594_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e1_O9NnDIoQ7kNvwGnDtmj&_nc_oc=Ado4AHOXrAQF-AguPVkrrXVood3NZY19cKZbHx1kxvD_RGCdH8n0WBtAzaDUmcbcuvo&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_Zavvb3JFv8SSgbCIQrDnW95DXuh6F8LdATKSlDN0dQ&oe=6A392F06"}, {"file_name": "Screen5.png", "id": "1659979641107269", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/75207242_1659979644440602_5068102189490911809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbyIqF51LuQQ7kNvwHWhoHs&_nc_oc=AdpUIaN4wElv7Zzc1B0z0mLGx139NEsq3OT0i_hFMzX9eDVGojmpBoWz0a5bj8yOkbo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2ktlLwb0hiMddRjd4VlKT1PriPS552WN3VOOQL2laew&oe=6A392DF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kRc_UHkN188Q7kNvwFlkmE4&_nc_oc=Adp0MSWYblYYKTlu3G5-DDVDuQDX69ldnJ87AiaV7tiGvClx-ijCF-k2Hfnd0vDmVcM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KGSiRm_eGhkO4bSb7Mv_1d4uCTmyv6Hqeku1IfVvpVQ&oe=6A3958E6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141512129892633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75348039_643163971147937_2869582510757944570_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmA_rd8yTf8Q7kNvwFDUn8l&_nc_oc=AdoIhSe4qFnkTHtDbijC9O4BGrQHFLKyvc8KoLLtTkI-QRBPRJFO2_O1l5oWF40Hpdo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1QEr5E0yRA2G7OSeUD0XKp88-Di5QR08L_Qk5GZTjzQ&oe=6A3930D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Roaryal", "platform": "ANDROID_6DOF", "con
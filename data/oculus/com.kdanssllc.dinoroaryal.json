c_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEWNNvkUH3RWg5G5HG7qcu2476MbpvO29N2s6o7rvepg&oe=6A56409E"}, {"file_name": "Screen3.png", "id": "555960036464171", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003247_555960039797504_6283154447311500594_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22tX9OgWR_gQ7kNvwFx0tBG&_nc_oc=AdrDCyH5gtylqPwL2VyIjI__yZO_Gd1Ad8LTBVpUhBu4YDxrD3cKLvRtuk6aBforV9o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAm1v2vSAIpTUZwONlggUvnWeOBkYcmAP_2Q7liECdr_w&oe=6A563006"}, {"file_name": "Screen5.png", "id": "1659979641107269", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75207242_1659979644440602_5068102189490911809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lS5TRPGumq8Q7kNvwFKTpVN&_nc_oc=Ado-SOYydEAIKfoZx0np8ajXrL-zAu3S3Ssp2HQIVFVv9IWw6CRAfXH8opqfo92X9V0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGrKzvQl_uH0u_nNPRFBRCMZCD4WXGa2ury-kS4L3lUQ&oe=6A562EF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aft6K-KD2O8Q7kNvwF8vcH4&_nc_oc=AdqxwNFaeVwyf3Z_eofCHqQtaMKtvoP0x-CVPseLmLIauKLkeiyDJBKbnXsNIoo0Loo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNDhWbrQRiGKeeHrcrcCnmLqjh1GeLVxZ5O9m8sY1yEQ&oe=6A5621A6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141512129892633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75348039_643163971147937_2869582510757944570_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXSFqcUU9vAQ7kNvwF4hRr8&_nc_oc=Adrp4X0Dpw3HClfcV93WUdAw2v-XgKd8kdOgVVjCoz5EuxWg0-RntJs4JnRpJFwJfuc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD6w2VkIwd_ni6J__gJfprdyCOwsh6sLyFOrVsSgmWrg&oe=6A5631D0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Roaryal", "platform": "ANDROID_6DOF", "context_categ
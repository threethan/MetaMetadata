c_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTw_fCtuianEm1fkiNSiIxNeOYbXKG3vgT-ojOt612ZQ&oe=6AEC8B9E"}, {"file_name": "Screen3.png", "id": "555960036464171", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39003247_555960039797504_6283154447311500594_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MukISraIesEQ7kNvwFM209V&_nc_oc=AdpuWgtUiikQLVrz3fA4Ne4pQStdmcNMvfk9sdYC8BlUJX2ett0CrByazosOGXDjcTg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR47PE5xmP4XvtqvEh_7GRy8mVSKg9SeUyHbDtb4BQd4Q&oe=6AECB346"}, {"file_name": "Screen5.png", "id": "1659979641107269", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75207242_1659979644440602_5068102189490911809_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThlH8Tx2Ri4Q7kNvwHCwqtz&_nc_oc=AdrxFBOQC8S8oIOSOsXhz7RgHONseKXYdLj2aYHUz06lLXy0HIBnstRWRqRXA-_080w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTG7MNtCbvBlMSLt8jYbESSPUMkczT1H0vgIFZC12z6Q&oe=6AECB230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bxTHTPdSE4UQ7kNvwGhLYbl&_nc_oc=Adqru_Xn99VSY3XrwuesSBnpoGWny-K1GoAeQMY8OEC5hiG8wP6tDqB_16uQyMQEyns&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpKuPoCOAC1H155M3zrGJkUQxNMksJ4FqXBYuO_Mgi3Q&oe=6AECA4E6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141512129892633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75348039_643163971147937_2869582510757944570_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36_zbyRmnRcQ7kNvwGO2ws6&_nc_oc=AdoEZ0njFENPxbwUWXNJpjp01DOLB1BBYgLw9maB0adecbRxBiKDtW6_4s4Zq3bVQiY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyK6DJpfrJfnIOnfhDI3PRt281-ZI0FIjP1aWpD_Z02Q&oe=6AECB510"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dino Roaryal", "platform": "ANDROID_6DOF", "context_categ
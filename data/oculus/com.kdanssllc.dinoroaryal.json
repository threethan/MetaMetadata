-7&_nc_sid=6e7a0a&_nc_ohc=L6LXy1VX_FcQ7kNvwH6Qa4p&_nc_oc=AdoL_0zPILdBlBIC5E3EENbOIrJkQwM6o1VBazK2l4umG24dEqkT3dgjbTJT3ZJxeE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjpkHiGq5zxkWNhi7ocvmJhLZv6FCZEoaDnZwtTKRrBA&oe=6A4F9770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXnPF5hCn0MQ7kNvwFxHySI&_nc_oc=Ado1P5hM7lzF1p8fCm7HcuzsQNsQ45PHpxMzZ8Ov3ko_yhjEmO7skMZWxVF6utJ3UtQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhc0uS5bAmZy8dAHItJzl6KBzKRUbiOWfjeigNcbyxQA&oe=6A4FC266"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfor
-2.oculuscdn.com/v/t64.5771-25/75557065_874143490521137_358369232386626125_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83dOlHNllGsQ7kNvwGLlRtA&_nc_oc=Adr-NkCNo3JA-3thNt6ohrWuRdw0AA39bd8ejYJUOvjawX29h3B8qH07LRldCLI1NHA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN9FI-5VbjKxujY6CPtnWVbWNNE0OgXQYdafzL2vH-jQ&oe=6AFC5D9E"}, {"file_name": "Screen3.png", "id": "555960036464171", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003247_555960039797504_6283154447311500594_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHI5jircY64Q7kNvwEKA2e-&_nc_oc=AdqGmrY2ieN8dH9xWpv2uJGcNf5CDCf_wOxbkIL5XoXk640CB51oWdyI7n9vHLEeW_I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYoF5C7EVr5lmMqJKqqqgi9znjaaaZl5y8jebfSDkETg&oe=6AFC8546"}, {"file_name": "Screen5.png", "id": "1659979641107269", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75207242_1659979644440602_5068102189490911809_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQfjxPXLrQ4Q7kNvwFlN4Tr&_nc_oc=AdryvgmzDJW3KEbp9Wo3hnPLGyh82Dq3fmMFdQYOyO8mDDYsjQ14gb2h58DhoLO2eNA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9Lm2Pyd8eEmS54_cmwdhIomzlF2LCNHKE__PRZaki6g&oe=6AFC8430"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail.png", "id": "572102931190200", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39035453_572102934523533_7056446585574448466_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgV9DqzAKdwQ7kNvwHEOdh7&_nc_oc=Adq7DHr8wKJKvHZmFwURd-JTzNwSZyep1-h5s9TTfOzLymPOr4CSqNFnr1EG3VMDhZ0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShEWoESSdR46YJ76Cn_6rhDj2PNnZynqG4KUElmRv03w&oe=6AFC76E6"}, "display_name": "Dino Roaryal", "keywords": [], "long_description": "Dino Roaryal is an arcade fighting arena VR experience where the player is put in the perceptive of riding a dinosaur and battling their enemies. During the ancient times when Nephilim walked the earth, Dino Roaryal is the story and gameplay of giant men riding on dinosaurs (T-rex) and fighting those dinosaurs in order to conquer their enemies. In a case where your T-rex's health get low, the game offers different spawns to help recorder health and projectile power.\n\nDino Roaryal is best played sitting. Standing positions are also okay but are not recommended as they limit the player's view. Dino Roaryal offers the player a different experience through the Oculus Goggles than the normal VR Pawn experience. ", "short_description": "Ride your chosen dinosaur and battle your way through the arenas. Overcome your enemies by using projectile attacks or physical tail attacks. "}]}, "developer_name": "KdanssLLC", "developer_privacy_policy_url": "https://www.traindz.com/dinoroaryal", "developer_terms_of_service_url": null, "publisher_name": "KdanssLLC", "support_website_url": null, "website_url": "https://www.traindz.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1141512129892633"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75348039_643163971147937_2869582510757944570_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tIrLFk
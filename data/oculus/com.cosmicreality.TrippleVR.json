aoHK9p7f9XZhTsJoF8XyWHNXxYzrlEH9V8RTbQE4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYw8BTpcHqugmMKmtH0rrmacgdON2w17pSJXJdbk3G0Q&oe=6A788280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1221271379332828", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391911_1221271382666161_7149431134316709269_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wq7FLMrxCN8Q7kNvwGMeCYh&_nc_oc=AdrON1hbG3QafVAirfBpp7VMfF5hNFt9lBQoi9Uk45w_PjX5dumujLcinzKlM8EddQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwAI5BgJgjrQjv85ux79wHUFcMUnhTEOC4ChUY5AIuGg&oe=6A7890ED"}, "display_name": "TRIPLE THRILL VR", "keywords": ["VRArcade", "Free", "Freegames", "boxing", "ActionSportsVR"], "long_description": "TRIPLE THRILL VR \u2013 Three Games, One Ultimate VR Experience!\nGet ready for TRIPLE THRILL VR, an action-packed virtual reality game designed to test your focus, reflexes, and strength. Featuring three thrilling game modes, this experience will push your skills to the limit!\n\nDeveloped by Cosmic Reality, TRIPLE THRILL VR is the ultimate test of skill and excitement. Are you ready for the challenge?\n\n", "short_description": "Dive into the ultimate VR adventure with TRIPLE THRILL VR! Experience three exhilarating games: battle in Fist Punch, slice through an ancient temple\u2019s fruit bazaar in Fruit Delight, and test your agility in Catch Me Challenge. Developed by Cosmic Reality, this game delivers nonstop action and immersive fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/bb305052-920f-4af4-b086-9a6519e27a49", "developer_terms_of_service_url": "https://www.freeprivacypolicy.com/live/56c2234d-3d22-44a7-8995-ceb961fdf13d", "publisher_name": "CRYLN TECHNOLOGY PVT.LTD", "support_website_url": null, "website_url": "https://www.cosmicreality.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [
"video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1221271379332828", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_1221271382666161_7149431134316709269_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WpPM9bltEsQ7kNvwG9-mym&_nc_oc=Adn7_TXiYwUjq8KDFx-zDKmQgOOBtIYLXqahD6bKHxrR98il527JoW4FGJK8jZZnYW0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuQnkLgtRAqLNiCv3mQ1U2BrjQKpLHw4dE9KK5CCZrD-Q&oe=699F096D"}, "display_name": "TRIPLE THRILL VR", "keywords": ["VRArcade", "Free", "Freegames", "boxing", "ActionSportsVR"], "long_description": "TRIPLE THRILL VR \u2013 Three Games, One Ultimate VR Experience!\nGet ready for TRIPLE THRILL VR, an action-packed virtual reality game designed to test your focus, reflexes, and strength. Featuring three thrilling game modes, this experience will push your skills to the limit!\n\nDeveloped by Cosmic Reality, TRIPLE THRILL VR is the ultimate test of skill and excitement. Are you ready for the challenge?\n\n", "short_description": "Dive into the ultimate VR adventure with TRIPLE THRILL VR! Experience three exhilarating games: battle in Fist Punch, slice through an ancient temple\u2019s fruit bazaar in Fruit Delight, and test your agility in Catch Me Challenge. Developed by Cosmic Reality, this game delivers nonstop action and immersive fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/bb305052-920f-4af4-b086-9a6519e27a49", "developer_terms_of_service_url": "https://www.freeprivacypolicy.com/live/56c2234d-3d22-44a7-8995-ceb961fdf13d", "publisher_name": "CRYLN TECHNOLOGY PVT.LTD", "support_website_url": null, "website_url": "https://www.cosmicreality.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type"
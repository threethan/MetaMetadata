s nonstop action and immersive fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/bb305052-920f-4af4-b086-9a6519e27a49", "developer_terms_of_service_url": "https://www.freeprivacypolicy.com/live/56c2234d-3d22-44a7-8995-ceb961fdf13d", "publisher_name": "CRYLN TECHNOLOGY PVT.LTD", "support_website_url": null, "website_url": "https://www.cosmicreality.in/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9534738239916147"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "4539671749683116"}, {"status": "PUBLISHED", "id": "2251076355433583"}, {"status": "PUBLISHED", "id": "4469512616663240"}, {"status": "PUBLISHED", "id": "809610918785076"}, {"status": "PUBLISHED", "id": "1909355636435780"}, {"status": "PUBLISHED", "id": "841278595722283"}, {"status": "PUBLISHED", "id": "1375634433939498"}, {"status": "CANCELLED", "id": "1538061603895246"}, {"status": "PUBLISHED", "id": "1174511931241668"}, {"status": "PUBLISHED", "id": "1248679589919716"}, {"status": "PUBLISHED", "id": "1441890927122598"}, {"status": "PUBLISHED", "id": "1056798889207245"}, {"status": "PUBLISHED", "id": "1019890587009420"}, {"status": "CANCELLED", "id": "980213384192457"}, {"status": "PUBLISHED", "id": "635605015719949"}]}, "baseline_offer": {"id": "8412785
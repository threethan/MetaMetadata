": "Saritasa VR Product Display", "keywords": ["saritasa", "drone", "passenger", "future", "product"], "long_description": "The purpose of this VR experience is to showcase the passenger drone of the future in an industrial setting. These modern 2-seater drones have pre-programmed flight plans and fast replacement batteries. The industrial location would be a typical waypoint where the Drones can quickly land and swap out a used power cell for a new one. Each power cell has a maximum range of 300 miles (Max payload of 500 lbs or less). The VR Experience has 1 scene set in an industrial outdoor setting with the 2-3 Drones lined up on their platform. The participant shall be in the middle space and can use point and click locomotion between 4 points around the drone.\nDeveloped by Saritasa.", "short_description": "The purpose of this VR experience is to showcase the passenger drone of the future in an industrial setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/f37ae3ae-7dd4-4486-9e14-dcfbbcaf87a6", "developer_terms_of_service_url": null, "publisher_name": "Saritasa, LLC", "support_website_url": null, "website_url": "https://www.saritasa.com/virtual-reality-development", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27534504206195056"}}]}, "scheduled_offers": {"count": 1
91_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOUkJz8NWJEQ7kNvwFrSyi3&_nc_oc=AdpVPrXWQrDS2TdSBM8veJTb3XDYhaun6YzWStGe9x2eFOE1raCXgYY2FlJ365OnEz4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYRfRr0alNlTQkBBlfweKMH0h19l5VfiC5l1uoMfZofg&oe=6A91820B"}, {"file_name": "VRPD_SCR1.png", "id": "1191646835916964", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391986_1191646839250297_309510344195430627_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6XZwNrevLQQ7kNvwEppXuP&_nc_oc=Adqw0o2yZfAE6ph_ISBNA6aZ_I5GhHs2-U7JJtzMkS-Lc7Bk8I6L0n70d3-3Jga-2lw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0EKQTb-8in0V50OE9XclDF1uPNGw8PKJtR3pB9psuvQ&oe=6A917031"}, {"file_name": "VRPD_SCR4.png", "id": "908161281346530", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391890_908161284679863_7296581741696732641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huC6NFRxVlAQ7kNvwFMW_2F&_nc_oc=AdqwXZWwyMU5wBD8jX-sJXWylD_NItWAGL_HE5PRN47SCJl2tEg1_5UUSxYdoAn7uiQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHViNCOKEzN3Z0FaAvsAwzB_p4DUsK_xSXwI-FSHBe-2A&oe=6A919005"}, {"file_name": "VRPD_SCR6.png", "id": "7510942822363579", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473391904_7510942835696911_3444790511787246813_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLUW-4hRmRAQ7kNvwFsb-Kh&_nc_oc=AdqImy7FZ496LqeLzg91kNKpeNQC77tD6cwYT8AAG7NMlQ4N1tcb0u4QA_4ogdYpu04&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFb1a1-jbsX41EaBqu4FZBRRsWw1Pd2WAzBLs7T1DeFeg&oe=6A919008"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Saritasa VR Product Display", "keywords": ["saritasa", "drone", "passenger", "future", "product"], "long_description": "The purpose of this VR experience is to showcase the passenger drone of the future in an industrial setting. These modern 2-seater drones have pre-programmed flight plans and fast replacement batteries. The industrial location would be a typical waypoint where the Drones can quickly land and swap out a used power cell for a new one. Each power cell has a maximum range of 300 miles (Max payload of 500 lbs or less). The VR Experience has 1 scene set in an industrial outdoor setting with the 2-3 Drones lined up on their platform. The participant shall be in the middle space and can use point and click locomotion between 4 points around the drone.\nDeveloped by Saritasa.", "short_description": "The purpose of this VR experience is to showcase the passenger drone of the future in an industrial setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/f37ae3ae-7dd4-4486-9e14-dcfbbcaf87a6", "developer_terms_of_service_url": null, "publisher_name": "Saritasa, LLC", "support_website_url": null, "website_url": "https://www.saritasa.com/virtual-reality-development", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27534504206195056"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2419959745003746"}]}, "baseline_offer": {"id": "2419959745003746"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739884680, "status": "PUBLISHED", "id": "2419959745003746"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_res
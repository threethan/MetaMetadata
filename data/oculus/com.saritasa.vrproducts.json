91_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFV_hhSxw6MQ7kNvwFO5d84&_nc_oc=Adqdvwyfg4O6rTRZS8M9zzJBifQxFz9PS_qizu9raSB5Xrdkp_CXnWjxiMcYnMHwdV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR57skqqQyORSeAdOPbZ0MBRKvH-o-QIjd0qaKbaKgEwQ&oe=6AF1F7CB"}, {"file_name": "VRPD_SCR1.png", "id": "1191646835916964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391986_1191646839250297_309510344195430627_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Sd2ImbdXOsQ7kNvwFGFJQK&_nc_oc=AdrsqxVbnTWuw5SLS6Y9uqbtZ7CuDfNJqomw18xN9addeEMpdn1_qW1Xs7k64Kgw9n8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDCe3bbxGfH6MA9zwYyPrJSO2gamf5iXy4YMp8PV-pWg&oe=6AF1E5F1"}, {"file_name": "VRPD_SCR4.png", "id": "908161281346530", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391890_908161284679863_7296581741696732641_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=020_hIcc1QoQ7kNvwH6-R-T&_nc_oc=Adoq5BwomvkpzzfVjVxpNs6-eiOEynoNvCeZNaba12cuM3MuB-r4CwBNYRXaFs9PTGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtBK4TaqI7UitlPqP_iHun7Tzn69_VBGX6TuI2n9qA6A&oe=6AF205C5"}, {"file_name": "VRPD_SCR6.png", "id": "7510942822363579", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391904_7510942835696911_3444790511787246813_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm2lNXVPmm4Q7kNvwGGifyd&_nc_oc=AdpUtiJal0W9bQU-gAvPhb5paFspTXnO8sAyfqMMQcv6xi19pOM3ZPZzjkNvT_VBorg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqQ_d4oYq9akRQo8JyMVU5RyvIE330lo87kjv4WP8oNA&oe=6AF205C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Saritasa VR Product Display", "keywords": ["saritasa", "drone", "passenger", "future", "product"], "long_description": "The purpose of this VR experience is to showcase the passenger drone of the future in an industrial setting. These modern 2-seater drones have pre-programmed flight plans and fast replacement batteries. The industrial location would be a typical waypoint where the Drones can quickly land and swap out a used power cell for a new one. Each power cell has a maximum range of 300 miles (Max payload of 500 lbs or less). The VR Experience has 1 scene set in an industrial outdoor setting with the 2-3 Drones lined up on their platform. The participant shall be in the middle space and can use point and click locomotion between 4 points around the drone.\nDeveloped by Saritasa.", "short_description": "The purpose of this VR experience is to showcase the passenger drone of the future in an industrial setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/f37ae3ae-7dd4-4486-9e14-dcfbbcaf87a6", "developer_terms_of_service_url": null, "publisher_name": "Saritasa, LLC", "support_website_url": null, "website_url": "https://www.saritasa.com/virtual-reality-development", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27534504206195056"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2419959745003746"}]}, "baseline_offer": {"id": "2419959745003746"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739884680, "status": "PUBLISHED", "id": "2419959745003746"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_res
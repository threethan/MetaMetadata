74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96dvSk9xr2EQ7kNvwGgF9J-&_nc_oc=AdobuZjpezYjkT86S0cdRlWQv8SWp57M-aUdIpNIO32j_voW_0RRAuwiO69HcX7Jydc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItkJzSlZvdCmSjGwS6tpRTF3i0jY462uNIi4Gd8qyR3w&oe=6AB66D1F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTmkvyB_D_cQ7kNvwEK1qDg&_nc_oc=AdqcSHShgV5CnQ5uECaVZrQSs__P2zVZNSoMH_MrrcpqwDaArh_P0hSeFS_VHntqVRs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmF-6KrOC2D_e9pBp7OfgmipOBT2P2st2XYFAiQpoeDQ&oe=6AB67A06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQMnzhQ8KnoQ7kNvwHczGhp&_nc_oc=Adqaus8XQGHjJLr7DhJpZsX7EK5lansn8aeeG8JtJZYgY5CQudNPh0N5Q0apBG3H0Yo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlrtUawikHa5GHoea8HSgJgdsNEuv1fSTn3k0_O3lIGw&oe=6AB697EA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
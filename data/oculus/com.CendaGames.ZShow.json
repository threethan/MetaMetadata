74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gg9UCqoIrj4Q7kNvwGcFu7d&_nc_oc=AdqXFaLhZcnjrqrayzjM3VFDBViTVmqrS0CYx7CdJSS9WLYPboEPJZ6VskN6AaXllDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIi3fyQDgdAN4cwZiCPCvIumh9JWEyqGZU29X56CQNjQA&oe=6ABE561F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0YoBvtbkToQ7kNvwGilpAN&_nc_oc=AdrRl6PTlG47u4Q9cOE7CLUyEY-BBWjTDLwDipx6ua7DPyg8cTA5ZmQwSjAM3gO5SFw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO5R7OTUFyzaLsWu8nGJFk5yK10JxZyDh3fB9mwdmfRg&oe=6ABE6306"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuSzgaG9oQAQ7kNvwHjX6gZ&_nc_oc=Adrq-ih73Zd_ypl_e5w7vvk1taVj4YWYDOz3lZwArQBgLQ5-NF1RJ4-zlIGEqD7mPHc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRka7coPO_tEO2odd40LVaVBIVzJIdipQ4Dhudy6JvMA&oe=6ABE80EA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
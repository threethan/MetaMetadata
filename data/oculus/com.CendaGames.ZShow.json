74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw0IHkzunkUQ7kNvwE55PZV&_nc_oc=Ado69y359lEp0YP5Zrp1j4tCUsoIWJsF99kCOm5n-ugC_2oVRdWgi8R71i2Vp_NvFhU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS739T87vsTtln4C4VpJZ6zjJqXVsWJtqzY22WqdFfzYw&oe=6AE8BE5F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JXdC4QvQ_-0Q7kNvwH_h-WR&_nc_oc=Adpgrmn9mnWTUiMBt-G_jJueBDaum7UKion0y630kN3wWn1JuODiFY9AX-XaGpQ0zYU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTW3_ARz9ES1tB5jGqEG2EBta8KBvIMMPuYUdiPMl1ujQ&oe=6AE89306"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6H4gE8YP_gAQ7kNvwHwlfx7&_nc_oc=AdrGuxSo9F9UqIgqKAJemWZgLrnmB6WZL-u9KvMjP4kF8AUp9Yj0jhhvUI20dJsy1WA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJt0u6S_1FE4J0nnZA6iZlSb6ODJ5BXCJQEW2i_kuBEg&oe=6AE8B0EA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SwnMU4sYWrYQ7kNvwHKL8iS&_nc_oc=AdoNH7h9KiPwhX39PPeg9CpAhvHmoLcQqcI2Nb-FpiHHMEektPt5ui2DKKjRKet3Ofs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW0-3V8zA6biPdarnan-w_z1RrciSZgIprrJj-IJsCRg&oe=6AC3D45F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnZxhNFC7YUQ7kNvwEKY_61&_nc_oc=Ado6W2oHA1nbTjIJQoLoLJMh8EL8T5wVCL-JC1NsSDXUKZhPlBs-vM_ekviTo5l9wtI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0nkt6_3dmlhWy-7xyZT5D7YeSbxbhdyszMiKP0KXT7Q&oe=6AC3A906"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWrayP3KpMEQ7kNvwEv_X1h&_nc_oc=AdrS95MTFhW2a5jk_0ga5oR4NAJcX19kmu_R03T-sIlfQGsp3VRKK3ao1rLgHymkyOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVkoCcuOyQobJGHie8QY0zq-M4fX0aderYdcAEFaZV8g&oe=6AC3C6EA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
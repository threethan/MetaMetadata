74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KVTd7uTFdsQ7kNvwH-tfVf&_nc_oc=Adp7c3ysU8iA5ZCbeSku9-twjsc8NOoK85ADRbwJwhxEkGz9JixPXbvmbGUvpvXv0JY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MeuRskDYNIlDAlpJ3Xi8YEywaX0nDx7_mXnL-BvVIHQ&oe=69ECB79F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwru3sVWA_0Q7kNvwG3wc0d&_nc_oc=AdoCseq0ZvEoyit2FWE7euACrPplpUKIw1uMATSoi26C4sy-8mH_IfxxPjJaXR8EDPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3izOkegq3g3YI0AVtq45S2V_QBuy69PMCwOsqxUs13fA&oe=69ECC486"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDRajhbJLjMQ7kNvwESrUZr&_nc_oc=AdoIvNHGvg_2HJwwq5yNS4_AH4-XwXZXbruMnXvq8rWXhrFmraFYbDCj-9Pf8qLQ4oI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_7WqdTmgVcfG8kC6cg0f1UWfeUX5d-xti2Fff_WPAhw&oe=69ECAA2A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
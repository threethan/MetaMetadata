74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_e5A_9FJB4Q7kNvwF_rUzQ&_nc_oc=AdqMXtiGwveZxzj4WJD8EVMCooKLpL_iZg9rNLUa-rePl6up8Q-HsMSKMEcQWFWy4Kk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXk1q0QPB3xD6nuY8GrbZeYuPODb3d4uwBjOiPpUhZXw&oe=6A6DEA9F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYzC0s1lWVMQ7kNvwE10xFE&_nc_oc=AdrdqDrb07E40MMTNQkBvpj7A6jJIqKOVYifpDV9aDQhnQPTRgXELq_mSvXDsmRyrp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYaY-sFj3t-03yNy6M5zeA4rC998YDKjhg32Rv1tf7OA&oe=6A6DF786"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGRlkQUBEmgQ7kNvwGPjktr&_nc_oc=AdoW0DBsEfGldtkTl-SXP5vhzksG908jktj7R4NBCVwICIIJ7sqmSffIeszTJzoJpN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxpezs1JI1BASgrecrjlj5L5tT85U_rbcs3yATcOAqYg&oe=6A6DDD2A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
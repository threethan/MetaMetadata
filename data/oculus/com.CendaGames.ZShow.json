74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8l9OiK52lwQ7kNvwHShYXI&_nc_oc=AdrGkS5uvd-gwS2XQV5xCoeQaXrKi_1z7iaYdsjwMNiQU38dAtxN3PM6VIO7wyl-ibY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW_y4uInezZpgLZLaDQc9RsSdnLW8QBBcg5SmLZNJ1xg&oe=6A57811F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdhGq1UEVX8Q7kNvwGUPen_&_nc_oc=Adq-VDh2o93751M5p1PezCcBQSnfT42UCozMpXc5QxwHNTWI9o3ryvzrbqSOdpkws20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7HU9aRkdNLJC_b_0-xlImxWitShbt_R-FIWA-I8DrZg&oe=6A578E06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsquzKEa4_oQ7kNvwGN83j-&_nc_oc=AdobxeUNR3MAC9KqDlRoB0Tan6SeEMJzcYwxtiUetfHT3gjhtNhPLhr3kEFotmDh3r0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCy-_-OEBmIbrEK2G5421b78D7JaQVK_xlQQSj7z0xTbQ&oe=6A5773AA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
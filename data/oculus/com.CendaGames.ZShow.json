74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvaYPcJLRusQ7kNvwHfrvVQ&_nc_oc=AdrIfG7fO_O0Cat0_BaP1P4k86dWurPAOYgWw25tvzAN13bRkb12UCRwLAFdm_U4yro&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zCqDK6ibA6eI2O6dK415ve5vtfhq4lNHJhQSfBg0cGQ&oe=6A15961F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfPYZ4KbJZ4Q7kNvwE6Urvy&_nc_oc=AdpaJq_UhHIMcH_ipoUp7NMaI_wj0XnberTk5VUuxwpprdAqiZ_BAY0y7RVS8IhBMbU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f3cgZ_1sLkMZmq4Cq7d73797ek_rVabvniAmJaFb2eA&oe=6A15A306"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXWpG_CvNAcQ7kNvwHB54jS&_nc_oc=Ado3B169YlAQyFxLJcPb4BBWzgTS4a9SxfxiUktlTliLFMNow3r9Xz5psh7udicC1K8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76_Jr4m5kK-wWZa0GOyNc90GtLiWLsAmkERtbLXy0srQ&oe=6A15C0EA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
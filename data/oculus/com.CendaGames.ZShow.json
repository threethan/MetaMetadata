74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfazUhGuqg4Q7kNvwGWrS3i&_nc_oc=AdpiHX3yLQo_Q7500w9csKQ4kQVH3rqM-qCzAO2iwf-F1cEFKCNKsMcqLk8mdrwEA8g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJadUFmTfd9jS9I986BwhlkW3pTfVDOFx8jN6X55-sRBw&oe=6AAFD59F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fPli2QyIyAQ7kNvwECZLL5&_nc_oc=AdpaZZtDAjXRUsV9NBuQLctLYcg4lFleVa67_eJPobF225-bIhvP-UO-BPMee58gUCo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD4n0IDC79n6OzB2qiOL4Z7VDONSQFN7jS9LGPjeGRRA&oe=6AAFE286"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hu_Qi_WdLxsQ7kNvwEAoegv&_nc_oc=AdruI7DjsQHbYEV6thhpLUP9eR88_JbWyIdkMh7T8r-YA18rxe1x-NjVuxd2JEq_xXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdrVCPqfpl9TaaKZ4rc08V_WFz1jPsdI7T5Y4yChXfXA&oe=6AB0006A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
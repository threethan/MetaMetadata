c2Zd-kOrlbFp1vv0XrYB4MH85quGGDfC3cIoWusc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afucta-hl0wn5V52Y9Ojt9E3UfZqiatHWCC-TaCF_ywbvg&oe=699AFA9F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32nDrbsbSTYQ7kNvwHVbGv2&_nc_oc=Adn902Qofwl3UF8e3ojnTaP08aDF64yB1s2PfhT8LjT-ap3dDRgUdI2pWics9ac5T_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftvUebWcNKTGW-96v9VgCniHdJiGMfvk_xN3X9T2EZarA&oe=699B0786"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNX_l8fWFlgQ7kNvwGsb0a2&_nc_oc=AdlXrKvt3HeryMtUXaU-rVnVlD9ZXMPAms7EKuYy-gy3WfZ11Bcl1GYQcA7rcOFMQbQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsQpDPP-pwCB4WoxNMY4hLABaoclZDKn_-VK5jm_4QkHA&oe=699AED2A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole new reality show for the rest of the world.", "short_description": "Reclaim a city from the zombies"}]}, "developer_name": "\u010cen\u011bk \u0160trichel", "developer_priv
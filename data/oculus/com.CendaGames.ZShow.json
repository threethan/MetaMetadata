74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KVTd7uTFdsQ7kNvwHJKY9X&_nc_oc=Adq-rRJXhLp4HcPm2AqQTXSe8I1jPi2R8_mMG6ReCJVb5bbeigTGp6-UnqpG5ZgCvzQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zP2TRPrErtIQDMoF3xSVi_UVQ2hvRbSVZDW60H7V-Jw&oe=69EA149F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOfd_NwEBW0Q7kNvwG7sHed&_nc_oc=AdqFGOksxYKvBtNqiQuY-IG7Er8Y_hQW5kkZKH4JoN_vZR_VXkncy3KL9SWrTaxV9GQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dPPfV2YLginFqbbdz6HKmYv2nsEYOI2ApM7BnpRtVtw&oe=69EA2186"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gmju1oCMOfIQ7kNvwFPwWvw&_nc_oc=Adof_9ZlxGKHEBj9Plif6bhR5ECNKsqWPIa-rj3kCtkic78xY09pA4vS4VBJyc5itw8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1g5gBzyDEO5adbYZDlmBb1-1c9XCzjYz-L7tyAQ-xX5g&oe=69EA072A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
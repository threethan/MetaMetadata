74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phHI_5x1nkUQ7kNvwHl9J0G&_nc_oc=Adr-sZcBQ77GYqcmXiwEVgE-W4NAqq01cQOg5N7u4HaDs4vwv3veo29aqjWH0uLZPMg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQytgLLgtznLxNSzrgS-1hS5uMuyDCq--JIVhZIVOKsg&oe=6AC7C8DF"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mXEx94xOTqgQ7kNvwGrsAqf&_nc_oc=Adr73xZhteC27S2B5TmyAIYi_ZP0MpLzY9sQIB-dTJweMr6Ov2yynY6r0ahCJu_vnHU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkYQdgbpjKnNGLmQSYi8zy33WVTUfDvnslwbVshq5elA&oe=6AC79D86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUs5f0vO8EEQ7kNvwHqS7ve&_nc_oc=AdoFvDVLt4DxtCbGgfKetwbjxTW1R8dWE2dRau1o9ArTmhl9dtTaU7idS1sK18HlDQo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLUctdHTBIy9lIt13j7VxkQQ47RK7VSND1TUUw1O7mxg&oe=6AC7BB6A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfazUhGuqg4Q7kNvwF3YEdn&_nc_oc=AdpK7B1b40h-zSe7ZvthUxiUeP_vbQm9rOGuJYHxeBY6OB1CQLUeWfHwCnYpjqZwb9k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAaBRm-zSX53Dv6rohEJZvoHqD9uKNn3BuebhWynVv7Q&oe=6AB2789F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1SVO31FjrbMQ7kNvwEj3SbM&_nc_oc=AdoinB3MmLo3UBf3rLsHPychzchlhCm-MEMI0ydamT-mCzEUxxD_ej2F2_ob08j1n-Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-sOMEuOFwyecDb5WclyLR59a1Z3rfg6c-y1GtBcdPVw&oe=6AB28586"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pv0ugRjnaV8Q7kNvwHgdfSh&_nc_oc=AdpgOEZD1CIx2dwDMg0m8AlbYo6CYB0eAbeusjsb15FfiHQzkVDugryvkqa_GeKcU4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjmvhrgbqUiydkaW2zgxGPHmTx7KLofPVfkHBtIcwZ2g&oe=6AB2A36A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
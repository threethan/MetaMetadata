74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReVR_1ngVWcQ7kNvwEeJyG6&_nc_oc=Adqdj-CoiH-0XQX9X9mxpvRCelxchoDe7gisQNoMMB-xlGQ4aUHWawvjvNtue73_PWk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ySkGhkMSpqXTZsgz7JPvLxqALc-BDb5J9c68bnjdkDQ&oe=69E7719F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpovBHG5LysQ7kNvwE8GP97&_nc_oc=AdqiYN7-_AH08ldzbiSXmEc2Fp-ZRQWSqTXUWUZEGcIic09zMXf8DjxAlOVsH11Uk9A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1A_fCJ1aH-VQpuPeLtycn1yNk0AYfdKgHFKg__P38HYA&oe=69E77E86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMfbrd2uS-YQ7kNvwGiH_V3&_nc_oc=Adqd9tjmE6KUCUMNS0cSHrFzyj9Tj0AsB96fyOLns00lk2nuCBeQxrsTJOVod1vaj-g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3OE6Sgc_QOpu0biiYTgP8HlEDvlRGWgW0rut8n417fyA&oe=69E7642A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DdcRVtXwolEQ7kNvwF0SLt6&_nc_oc=Adr3-6sKmqcMZy7E0EWyKAlq_7jTTDasNLVO8xkpYvmFUjWfwpol5Rini50KaBcX9Eo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFByUaOPVN9yWIlNzUlfkkJJ8pqnGIy62KCqZ7sg70Zg&oe=6A95AFDF"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OB0dQ5eazkQQ7kNvwHra_qT&_nc_oc=Adrz-r8JzDkwCie0eJ_DlQQY7s8RUoOWO_W5UnWT98WDC7lCIDpFbk1X9YGbU1rCWZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8B1-bbI867SDDY7ELROC7jLtmTtO1_Ttt-8nPDDW_xQ&oe=6A95BCC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rD1kL0x99TsQ7kNvwEnCTwR&_nc_oc=AdqWskvrYCXcvGmpgZ6BAXjzvOtUWHeBt-lhxT26sbMbvAfJW0HeLUE8dyGsct5v2Hs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGG2QyshcCEqGdjbEuxMXIrDBSH9HDUMKgsW5gl62ePNg&oe=6A95DAAA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
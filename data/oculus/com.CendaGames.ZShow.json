74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhamw22of9oQ7kNvwHTc7N-&_nc_oc=Adq8iNRzKjeHvFTA1K5UqtQ2B16xavlW-UBsI0wh1k6uqaacbLURTA39O-0P2PYuR5Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ERsIKAz0ZCaAmle7HNJFiNN0TPnh7QOWLwOmBWvNlPw&oe=6A14449F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QfPYZ4KbJZ4Q7kNvwG9WlML&_nc_oc=AdrDWRgOZiKzrqE01FTOdKw0oF_xRs9kDPpo0UPrU1V6hTRpL1ydJ5A87RWZzMEomSE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W34esIPj4kuQZ6gQmTQmV7LSo-BO1Lw8yQy39S611vg&oe=6A145186"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXWpG_CvNAcQ7kNvwENh1Km&_nc_oc=AdoTqN-UMtyPyZ8-OZv7ZgUbtfjtX1sxB8k17bwVJF5DO_SNUgIaddtVJWlbsjzd1H0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TilumM9QnswgLvPfdf0pVLj-hSkQ9fYx2J7Gh4kHmRA&oe=6A146F6A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f_FyxVAiKEwQ7kNvwE8R0Hh&_nc_oc=Adq78HkKkaZeIYfhSyv_8BBUUcusTV4BTZ83Eczf-845U0UhucWqB_T7yzVNnQpKl60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBeTn0qTbnvQPKZdiY1l1iEBzwZTnKqTtDaqurzTXzozA&oe=6A67531F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUgpK78BhpQQ7kNvwGqywrP&_nc_oc=Adq1zQS23C_4ORqfM60cc1r7hCSuR_aS9EN9tv-F4DNuuSGUO4BQ7AfATTdVdH0PCrs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4cW-_FY8c9h9hAWfWeQJ46tILh2ZfI0Q8swLL2o7VnQ&oe=6A676006"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRL7a0Y56b0Q7kNvwHis0cK&_nc_oc=AdrunBVZkfGyOVS_73Lv3cnQQslX4xGqz53MLxjtozZw3IYxeMMJD5HErQepRcSQsdY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALaLLV6Rwu5nEZqGGoqCnHm_hMiqXspiRIXiBDqUiOXA&oe=6A6745AA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_e5A_9FJB4Q7kNvwHObI4u&_nc_oc=Adq9EqNJlAgYrqxuBOKHJtrD4lJkFhBTAL0cxXb3AnU28iXA6hdu3Jg-HHViBW-OgyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSxt1RKMWc_nZUNKmGVdQodF6YQPnhRm7Ch8JM8p1caA&oe=6A6C991F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYzC0s1lWVMQ7kNvwHkdsRI&_nc_oc=AdqzukgtKEgP_1Y1y1FFtEFhPmhDAjXI97srdIhjFmJBF0L_ry6OGwkSNOIJa-twLsE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9a0uywbdokI_MqA90Es1xoLTU0M8C7kQfou5hBKgXJw&oe=6A6CA606"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGRlkQUBEmgQ7kNvwGTI6z8&_nc_oc=AdqyNrh4i4ezUTL39lx716nhpZjR9QvuGg_vZJbXkNAJHokbIpoj1xHnyNaYwdu7i5U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIIJc_8JEghtFWrjqunDmboIVG5UJTStIyZjJ3xB8YJw&oe=6A6C8BAA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
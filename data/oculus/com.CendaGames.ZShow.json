74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojYOGNBT8qAQ7kNvwGD2he-&_nc_oc=AdrwGxfTZoqZzm0v9yG89QN2u2qzbm_PJUFCYj2ECXFBvmaWFoXezl1BvHgwrYf_TBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIT9od0KxbAYrI9qYZ8SU0iwgZEGVmKwjqPRZ26Zczww&oe=6A49009F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E19UNsQPuyMQ7kNvwENrL9B&_nc_oc=AdoH6Ykwp3g02AH5_hq_asPcLjeZ3OKqnOSE4nbrXNkpQYRJuGwOx1FWhoPANv_DeNs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3HLIutr7-falaVOy6II-pnKFTPzHrVullBrpC0wZ21Q&oe=6A490D86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnxFgVH2bakQ7kNvwGoO05y&_nc_oc=AdrL-lekjkz2oRAqLGaGK9mKEU-X-kcc-OO7r10wBQ1rR7zCpZa2R4F_QMMycmPo1-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMF38BgebJwDgtSsnKuqvaUI2LIHxu_AkT296jvxzEvQ&oe=6A492B6A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
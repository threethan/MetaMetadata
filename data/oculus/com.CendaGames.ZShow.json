74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KVTd7uTFdsQ7kNvwFiZp1V&_nc_oc=AdriLEcvtda7xec2-4waPp9PbMsfzQVJPxNj6sWtGX0P9dNDFrw3bBcbWMPZSLug5vc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ClOADnimcUtgd2DYr1zSvvHf5ngJrPmqU7knMpWc0Qw&oe=69EB661F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOfd_NwEBW0Q7kNvwFLrkJk&_nc_oc=AdqlaFqVZe33GDep3x3QDnpDPhyIk54oc3dql9lxGa6rooy6Dv6u3Czz1IQj8JiEbmQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39K-o5ZE-RaKAJfPT7F7I2JBX14TFO--GYYnexZZYOMA&oe=69EB7306"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gmju1oCMOfIQ7kNvwEIJKce&_nc_oc=Ado10UZaOdg_D-7-tHcv7BeJdB-6BbC0TGvDQfg9z0ChdWiRludjWX5oXCBBDcGGeUI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03t8lzi9Uzgti2-azs1zyUoYRekdfYnZwkEVuuIbN5jA&oe=69EB58AA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
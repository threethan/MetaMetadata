74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-S69PVa35UwQ7kNvwHMoRHW&_nc_oc=AdoXaO-fpFNxPw_UiDBpwVKjDEUXOzdKQDcvObquIuzOlUNsQxKz6hlnFzz-UdCHqSI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afztss3tq8GagWqCsY-1mGvEdzkKSRdKceA8WgygXuZKBA&oe=69CE651F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LIls2rPfhAQ7kNvwHK2c40&_nc_oc=AdpcztopJk1tbjGL5cdgtHPUy8X7__pFTb3uAx1_epIJTXcoX1dLw23Pmg8zr0fQa0A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzstK3REeuZhHxdJrXQMv32otQIGTe_2J3mGSYlY39cUQ&oe=69CE7206"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CyqvUClMSHwQ7kNvwFIFVRp&_nc_oc=Ado3coxy-J7L469qRjSPCJi7OgpjoGRsIBJJCH2zXPAl4gTQANM6wnjVRepgNcP6lbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKo-y8WYdynx9yUo9_FCI7CjPtA0svwUrULnHOXhfNnw&oe=69CE57AA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole new reality show for the rest of the world.", "short_description": "Reclaim a city from the zombies"}]}, "developer_name": "\u010cen\u011bk \u0160trichel", "developer_privacy_policy_url": "http://cenda.cz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "\u010cen\u011bk \u0160trichel", "support_website_url": null, "website_url": "http://cenda.cz/games/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RACING", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "sk", "es", "pt"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "270836058408017"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75210400_854117335376532_2733415870526083236_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DWY2CwnpTqoQ7kNvwHWDoyT&_nc_oc=AdrrNk-B6dtUdnAcXCTxFw9Pberh0tyFOOHwbGDvL9PVafNADf9VpbdX-dhFMcLucYA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPB04KGXfhebHIwfOHnrxVCuj5PRe6WqPJos9PRG0Grw&oe=69CE6934"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Z Show", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1608314360, "lastRevision": {"nodes": [{"id": "2374076852901269", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "5051863508172341", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "1
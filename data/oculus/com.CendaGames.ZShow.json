74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4uBPHW17S_UQ7kNvwG5bFXH&_nc_oc=AdoWjs6dDy2CHTeptl77JySE9aaCSL-OfDx7Mek6vRYvS8UHlP53lOXYs7RxQF0aUf4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hAM6YkgeKBSY5pVk_ptZT-8hZ0m6CrKduRStnx4uP1g&oe=69F7439F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_KS87gtDYSQQ7kNvwFvCqgy&_nc_oc=Adpv4mu3lu11pahz1pYEaNjYq1E9sSJr4BRBalSYgz4qfSq_BGyhUKW2HJGZw9utsA0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Q0BY59LuMVtdWbofRmcLlmwLVW0xK7kQ1QmT4v0czxQ&oe=69F75086"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Zb2xyylsx0Q7kNvwFaRxl4&_nc_oc=AdrFov3-EnSv-wX5YAerY_-xz4froGywvOE8nooc0bmmpT-SWMxdeCLN2Y4Iw2SG994&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1rwtrcn1-5CYOi5XRr5F0PYB6MJQtAW0l40kAxJdco2A&oe=69F7362A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
wHZf4be&_nc_oc=AdpxQ0rStUQVtCioyvrC6h7ZtgTi-98_zv74WlwHvkBG1Ye9Ni1HBVs3ZRXvvGf2oWA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiXTyazj--PKye45SHxr60pd4snEv4djhqTpJNIGX3Jw&oe=6AFF20B1"}, {"file_name": "Untitled_3.2.1.png", "id": "351886843388683", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570295_351886846722016_2623960593027096659_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLraGYAXKLsQ7kNvwHA3Tk3&_nc_oc=AdrEK3FoTtnSOiVj00GZG0409rRMs9I-loNsRmyvS5u30rhBSL0_t8eT27_RQQVZ0E8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5tAezG19IayPJ9eO1U6FOdKOHj1krpyi-f8uSK5-mNg&oe=6AFF2A22"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "837081756977880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566679_837081760311213_2634296862002943462_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7yUErEhZrkQ7kNvwEjYT-g&_nc_oc=Ado_JamjPzbsPXx-LJp_7PHryihPDbKgu0JIFjC7bu8_5BKrbYK2MiGJVLJnOZc7N2A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLtqnub-QQuldHlSPmb9n34P9u-oZirXix6sUuYKZfNw&oe=6AFF291C"}, "display_name": "Zombie Show", "keywords": ["zombie", "goat", "car", "speed", "crash"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole new reality show for the rest of the world.", "short_description": "Reclaim a city from the zombies"}]}, "developer_name": null, "developer_privacy_policy_url": "https://cenda.cz/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "\u010cen\u011bk \u0160trichel", "support_website_url": null, "website_url": "http://www.cenda.cz/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "ACTION", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27871792212469527"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031384_240832617974580_2448601998352780991_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vL-TP1_o4PcQ7kNvwE4cyPD&_nc_oc=AdqC0OABG1hOcntnjJVDBVRjodSHo-NHgZbsY2Y5dt_4IVA_0ip3L4iK0o7pu5g5Qgo&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHWOyD1EfAWJLHOlDiTvc6-jkcuJMDK1GxUlFf0gU_0g&oe=6AFF2413"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zombie Show", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1651687639, "lastRevision": {"nodes": [{"id": "2635201966788755", "release_type": "SCHEDULED", "administration_status
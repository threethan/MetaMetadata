74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CE5QZt5qDdIQ7kNvwHmWWeh&_nc_oc=AdrniC1YqGuGKEfud8k7orcHaZ8XTQiWKSGpy2c2bQLucoVWW7_94t8-XAw-u6Eb0z8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVldk6uBWRGks97Jl39-PD150EAvTd4dh_ZQTeVJCQ0g&oe=6AF49BDF"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hN1Qsqi3isQ7kNvwF2LiZL&_nc_oc=Adpf9XOjsJ3mV7gDVs9jBWQoCEh2j470F7Qrnd783V7pwxObeuJtmrFaCluS_e1h-1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYiARAOhlMVRmrQZdzhi0H4JSGiGmnv66Pq6puoCG02w&oe=6AF47086"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4lN0RAeAWc4Q7kNvwHpz_G8&_nc_oc=Ado3rGabkQ9LTio3w9FKuIVaC3V3m1a3adP77KzxCS73ugx_0YXFueVAAHFVxMk5Zuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDTa20heqhvjiV04b6JOYLoFCovkkInBK_yAQiPaJF5g&oe=6AF48E6A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
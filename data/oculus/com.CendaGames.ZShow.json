74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kT8Ry-N49OwQ7kNvwEmDlYG&_nc_oc=AdoRRBfQ-Y7pLFApRgWMtjF4JOrOrxpAVaH56Q-cLP1GzGXt9fF6IIqhff04VZBs2cM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ngQVraOHlvhnjDAWrYeU1x_DvfVGRz-bSJvFsP8LlOA&oe=69FC899F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6TJI9kJIXoQ7kNvwHqNRqS&_nc_oc=AdpDEa0pxzLTPlEMwO2WUdC9rffnP7_b4RjNpYeX6XsAdmpLu9nKdLAj6whVgOsL4QY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Cw2FAToZgglW0jZTOvhBPQCpxoNqwoq7dCKb2twAlhw&oe=69FC9686"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PZDyyaejQ48Q7kNvwE3_0Hh&_nc_oc=AdrUJV4lM4Iqy6bWK3rb0l8t24dskCfFFirCsY1vhozYU38BgirBbLSrwfq87RiEMLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tIn_POlQs17CK0tIHoMHde7TmnrUK2ZLI4gAM4H5HRA&oe=69FCB46A"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
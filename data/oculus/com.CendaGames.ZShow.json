74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REcHp1iblssQ7kNvwG1TqAC&_nc_oc=AdoinIljO4suxwDKM3AXP64yUJ5L99p1cBzkoDGekOtM4dchOpTByTUf54S5HcmlJMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCk2Vyr4IykOxmgA_tMtGWM84HJ-v8o5cr9J3594-U_ig&oe=6A4CF51F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeDpIxkdRuYQ7kNvwH-eKH5&_nc_oc=AdrCTYj5cJm5Rliwm5Pmzy7kRaqJJ_80A7n-wi7KOc6SQHFMCszr3uSfeBUarOtI944&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5kb6MQ44MSg5tmrH6aqEy7CNVoWYimu0np43zcWkj9A&oe=6A4D0206"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJA1PhxC5A8Q7kNvwEz0QRW&_nc_oc=AdpuCmTjpyTiSFHEQLp-v7zexBfoMXW5B1lI_rRseRMRPbZVhZ8fZ0JjrnXIPPUHYv8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAI1CxaaXZwO43KHhnL94lEuEiC5TpNlzT7yD-c91uJIw&oe=6A4D1FEA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
74_8773502145702696159_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReVR_1ngVWcQ7kNvwHnATh0&_nc_oc=Adp_lI8bD9SMtWR6loD0NeeO7Y2e_Q0a0j8uTUSMecPpDWIMyCYQl-5WTVDVs3PsPHk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a2qNdfEhH72VUnTntvERZrQfEwjelIqeaDt1i9mMsMg&oe=69E8C31F"}, {"file_name": "Untitled_3.2.5.png", "id": "144733484070168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75262744_144733490736834_2143293251610750282_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOfd_NwEBW0Q7kNvwGP-_mC&_nc_oc=AdrmpKTGnM5NVv22vtYI-KZrOBogFaoVOXl6o97tvOT9U98UGfSUixE42wsIzjJnLFk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BIxWVQeMsnaDE2zGGQUiRcVIrt2ELyX_LwAMvveRRjA&oe=69E8D006"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "405527460648133", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404372_405527463981466_6779948108308608227_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gmju1oCMOfIQ7kNvwHxKwQx&_nc_oc=AdrJedrXiCLyYk2lfsy0TYQAYthN-VoKTR2Xw-Qezfh95CP8Z8zMsI0hLOpgZpdrvhw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dBFx05VqJ4wFiIfDrpuNp6sw0127ou-Kgfp-saZaWQw&oe=69E8B5AA"}, "display_name": "Z Show", "keywords": ["zombie", "car", "gun", "fly", "goat"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole ne
wF5h6dL&_nc_oc=Adp-Z588Lje_BVMJjKhimp5Gih8SU8-Om6K5SsTys6m8q9aRSycQHlSwQNjuk2RV0Dg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0mlM9wjV3dISfkZZbWteoTLkOIJP4o66pcIutaKKQ-g&oe=6B031531"}, {"file_name": "Untitled_3.2.1.png", "id": "351886843388683", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570295_351886846722016_2623960593027096659_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDQf_IWBB5sQ7kNvwHsNTyW&_nc_oc=AdpcO79wy-q-ULcIePmEEhFsfQFuRcXawfE6cDo2VkKBUbU6A0aqbmrpuV23B1tKZJ4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAyE_hs7vzw_H7EIUaGVWS3nIs5_FbGoS9pOiyAlCfpw&oe=6B031EA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "837081756977880", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566679_837081760311213_2634296862002943462_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d21DFD7jEz0Q7kNvwFltvEG&_nc_oc=Adpnywn0j-zJLT3TA_faV7D3kiF-RSwnr4-2gGyQDFh_QMK3lAHRHtOLkcaSOWvC6Ag&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaNn3KQci6qy4DJjxwJ1nOywUhPpAKQaW7bXelWCg2Kw&oe=6B031D9C"}, "display_name": "Zombie Show", "keywords": ["zombie", "goat", "car", "speed", "crash"], "long_description": "Choose the car, reload your guns, get rid of zombies and take your city back!\n\nAt the beginning of the 21st century, the television used to only broadcast telenovelas, reality shows, singing competitions and fake news. People became fully addicted to these shows.\n\nIn 2036 there was a blackout in Eastern Europe and for the most people the world came crumbling down. They became aggressive, wandered through the streets killing innocent little kittens and in the end became zombies.\n\nThe best brains in the world, scientists, TV moguls, and producers of soft drinks have put their heads together to resolve the situation.\n\nAnd so they started to broadcast a whole new reality show for the rest
ing each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Gorilla Corp drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gorilla--corp/home", "developer_terms_of_service_url": null, "publisher_name": "hexa", "support_website_url": null, "website_url": "https://html.cafe/xe4e35f5a", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9966291850161585"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_2021726291708691_4877913042793776592_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=57YM1uL14swQ7kNvwF5IYxm&_nc_oc=AdoId-32yyG6GdCnWZbbJbb8FFLQjdC9WscGdUn_Es8XNz-C6VO8ElwFtb_1kOrW_L4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7Z-N7y_0k7U2vepXsYntutKZH-ztBh5Sq_7pgVAWjnw&oe=6B0DBA37"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla Corp", "platform": "ANDROID_6DOF", "context_cat
0_2071729403487842_867535948357567750_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVD4lbiSCLsQ7kNvwH15oNZ&_nc_oc=AdqqTShSHz4lFNEQt445BJHuxAtEg-grTHraSV0LJBXWhr1tWIsJLArmFACvQ67UwYg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDbOUcF3Kk6Rt-9Gnlv3iuO7b3oIktS31kU1FvhPOsMw&oe=6B0DA360"}, {"file_name": "3_deposit_counter.png", "id": "1446698400237498", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624577_1446698403570831_6999893059511032789_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cPQe4mu5cSQQ7kNvwFuZ5TY&_nc_oc=AdpxRie9zXZVw719tlFDuAiEaYbzkkOcLWKViZJiW0YvbKmlVHft_iRXLE5Ni42wnMs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR-z_4B4L_dxjPg_ykIbZelXp4OtXxoW3l_OFpoMYlxAQ&oe=6B0DAAEE"}, {"file_name": "4_upgrades_panel.png", "id": "1145549325005252", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593832569_1145549328338585_6914523402982640519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ng0LeqLtwcQQ7kNvwEaZ0d-&_nc_oc=Adr2oT82Dx8l18_n4fgANKyVBtZaG4BTS5rHAY01dNsp8ual7Zre2KVwWrN3j0p_zWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRU-JVoWXKDHGFa_Qu_Q29W_x-or0XcvxVcyGJWkp3sSg&oe=6B0DB587"}, {"file_name": "5_vault_from_above.png", "id": "1745560803210343", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628875_1745560806543676_6760540748743224648_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2Z4Z6AqwF8Q7kNvwGlW-hY&_nc_oc=AdoG93BIOgXflWLvzp_pscCJEqDVD0FQQOQYEFhPJOyqiGdaX6wpvGNWIFxtjNUGt5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSiYh27Dl6qPBjslfzD8NbxxrzlHbLfZQUt39mPMIdSeQ&oe=6B0DC40A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCover_2560x1440.png", "id": "1458124156467893", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/748811223_1458124159801226_4948192800548882266_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eL2qaieHKHEQ7kNvwE-yKOW&_nc_oc=AdpzerDCZU43rcZ__12zhA8vQ4pytb--6YWQncZURlbRVUyy4ebMyIwRA_Gj4Wu6ii0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrjKRV658XruKV_LAlijIz748qdRMK5BZ1BZf4PXuBpA&oe=6B0DA18F"}, "display_name": "One Million Gold Coin VR", "keywords": ["Simulator", "Casual", "Incremental", "Collecting", "Mining"], "long_description": "**Welcome to the ultimate VR gold rush!**\n\n*One Million Gold Coin VR* is an incremental simulator designed to make getting rich feel incredibly satisfying. You begin with empty pockets and bare hands inside a massive bunker containing exactly 1,000,000 physical coins. Your goal is simple: **collect every single one.**\n\nUsing the tactile freedom of VR, physically reach in and scoop up gold. Haul your riches to the deposit station to bank your earnings, then use physical terminals to buy powerful equipment. Grabbing handfuls of coins quickly escalates into wielding high-powered vacuums and heavy excavation tools that pull in massive waves of wealth.\n\n**Key Features:**\n\n* **Tactile VR Excavation:** Ditch laser pointers! Physically sweep, scoop, and grab coins using your motion controllers.\n* **The 1,000,000 Coin Vault:** A massive, finite pile of exactly one million coins. Clear it out at your own pace.\n* **Massive Upgrade Tree:** Unlock a 250+ node skill tree to enhance movement, reach, tool power, and deposit efficiency.\n* **Satisfying Progression:** Start with bare hands and upgrade to trowels, magnetic vacuums, and industrial-grade harvesters.\n* **Bunker Restoration:** Invest gold to repair infrastructure, unlocking faster cargo lifts and advanced deposit stations.\n* **Casual & Cozy:** Play seated or standing. Speedrun the vault or relax with a low-stress gathering experience.\n\n**Grab your gear, step into the bunker, and start scooping!**", "short_description": "A tactile VR incremental game where you physically dig through a vault of exactly 1,000,000 coins. Scoop, bank, and upgrade your way from bare hands to heavy machinery in this highly satisfying casual simulator!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://w42dev.netlify.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "W42", "support_website_url": null, "website_url": "https://w42dev.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1486554094533041"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1081510141533495"}]}, "baseline_offer": {"id": "1081510141533495"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794533220, "status": "PUBLISHED", "id": "1081510141533495"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1482589681596149", "version": "1.0.0"}, "id": "1929827961050061", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1479495521905565", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1482589681596149"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1
536_3844366324913639381_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENZQRHczKFgQ7kNvwE1QioW&_nc_oc=AdqxrIEWIXGdzfM0XOm_mHUGiMhsACRmikhCpYRfo9EI4LHkrzV6wDpVrNeWmu4ecso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWtZ7Tv08C9rySnMaQA8HO81FfszzuDlgEGNSCgcCPD9A&oe=6B1047FA"}, "display_name": "Hellevator", "keywords": [], "long_description": "Ride the Hellevator down and commence with pest control on the lower circles of hell. Undead run around your room attempting to escape, and it's your job to smash them before they can! Charge your magical hands and slap them out of the air or crush them on the ground before they have the chance to fly! Try to take out as many as you can and compare your scores with friends and family in this demented Mixed Reality game. ", "short_description": "Tame the underworld unleashed upon your very own living room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644788237286934"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75375755_749884933636978_1244154928067038098_n.png?stp=dst-pn
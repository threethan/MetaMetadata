4p9TVvsio-9_-TABpgBDKscbGQ&oe=6998468C"}, {"file_name": "ss4.png", "id": "669955175123583", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974883_669955178456916_6515306649275840329_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wlTQZ7fCPsUQ7kNvwE-TXxl&_nc_oc=Adm49RciYQLwD1n88UEFcUXsuIP_-1b0Axk11YHzhNagYTJac-BM_GcD0UPJxOA1Efg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afvcg8gciQA2AMIoFQny0PgEofhI98udFhRWdy6LeyZNsg&oe=699851B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "helvatorwuide.png", "id": "1176820946611203", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974899_1176820949944536_3844366324913639381_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtEPzc4UfzwQ7kNvwF0NMYY&_nc_oc=AdmqQx2SnoKiKT4Bnn3X1OdpzPA4fppyHvCDdkuN5cko0ZVPgh_XrsLS8mHTZkydcqE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvhGvQ-uAHnR_bwI89J5JCz-PdW53bgqtebnpED1XmWvA&oe=6998543A"}, "display_name": "Hellevator", "keywords": [], "long_description": "Ride the Hellevator down and commence with pest control on the lower circles of hell. Undead run around your room attempting to escape, and it's your job to smash them before they can! Charge your magical hands and slap them out of the air or crush them on the ground before they have the chance to fly! Try to take out as many as you can and compare your scores with friends and family in this demented Mixed Reality game. ", "short_description": "Tame the underworld unleashed upon your very own living room!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "exte
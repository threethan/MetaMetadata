64.5771-25/499312267_988545754046795_2419926583975884140_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4BB7EvyHiEQ7kNvwFDoHEU&_nc_oc=Adr6d7IoLPPwV0k9zdfmLuL55GcWpBLf563VKGgN6txUc1MpNu9HOSHXggNCMWTlamI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_1G0PUKlIkcK-F1fzQPem2GVZ-9t6-4z3BVgyv82ynw&oe=6A733FC1"}, {"file_name": "Blade City Brand Assets Guidelines Screenshot (1).png", "id": "3915626092078551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296127_3915626095411884_5364719753103044987_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e_K5FkTE_moQ7kNvwHpQO81&_nc_oc=Adpk1XBn0LPmHu8SbfYdT1zxXYViqVB4qNoWi_HFNuhsk32QjUByVNBjUSmHvbPVG68&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyZHdgojD_tbhOyZFwZYa80R0abhblohNlC6G-OI9XWg&oe=6A7353DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blade City Brand Assets Cover.png", "id": "1655153859945519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310667_1655153863278852_7997685239185590787_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEjU3af0sKAQ7kNvwGuXNlQ&_nc_oc=AdqWup57qSfExZmVlBH59N6wSlJD_KutpNOKwmniPv7a6y9_nr_q1Sw_PVP2z4U5ag8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiq_QQxkNo77gQuMutNidZNSoJzmvP33f4O4XYpcxGmg&oe=6A735711"}, "display_name": "Blade City", "keywords": ["sports", "social", "sandbox", "platformer"], "long_description": "A rookie Ninja Monkey with a rusty blade, an empty wallet, and one impossible dream...to become the Master of the Blades \ud83e\udd77\n\nDodge & deflex \u2694\ufe0f in every match to win coins \ud83d\udcb0 \n\nSpend coins to upgrade blades, slay-high abilities, aura \u2728\n\nCoins also unlock mini-games across the city \ud83d\udd79\ufe0f\n\nSkate. Slice. Socialize \ud83d\udef9 \ud83c\udf54  \ud83c\udf63 \n\nGet rich\ud83d\udcb0. Get jacked \ud83d\udcaa. Throw rooftop parties \ud83c\udf89 . Flex \ud83e\udea9\n{1899581750729344}\n\n{2088024375447461}\n\nWanna help us build arena maps, blades, and expand this Ninja City? \ud83e\udd1d\ud83c\udfd9\ufe0f\n\nJoin discord.gg/playbladecity\n\n{1714375429586515}", "short_description": "Become the ultimate Ninja Monkey in Blade City! \ud83e\udd77\ud83d\udc35\nYou have a blade. Everyone else has a blade. Good luck! \u2694\ufe0f"}]}, "developer_name": "Blade Lab", "developer_privacy_policy_url": "https://bladecityvr.com/privacy-policy", "developer_terms_of_service_url": "https://bladecityvr.com/terms-of-service", "publisher_name": "Blade Lab", "support_website_url": "https://discord.gg/playbladecity", "website_url": "https://bladecityvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "1990104051447093"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1614607460665188"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2372246093265216"}]}, "baseline_offer": {"id": "2372246093265216"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781905200, "status": "PUBLISHED", "id": "2372246093265216"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1672239238235343", "version": "1.0.10a"}, "id": "2403174663506544", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1672239238235343"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2403174663506544"}]}, "change_log": " v1.0.10 \u2014 Dance Arena Update\nNew Game Mode \u2014 Dance\n\nMove when it says DANCE, freeze when it says STOP.\nPush your opponents into danger and be the last monkey standing.\n\nWeekly Challenge \u2014 Outlast\n\nObjective\n\n*  Accumulate 100 total minutes surviving across all matches this week. \n*  Every second you stay alive counts toward your progress, even if you die between matches. \n\nReward: Overcharge Ability\n\n* Charge your power over time and unleash a stronger shot the longer you hold it.\n\n\nNew Content\n\nNeon Cleaver Collection\n\nThree new Neon Cleavers have arrived: Crimson, Azure and Emerald \nThree striking neon variants forged for the arena.\n\nWarrior's Gate\n\nEnter the arena in a whole new way.\nGrab the rail with Trigger or Grip and ride straight into the waiting area.\n\nRobot Quests\n\nRobots have appeared throughout the lobby.\nDestroy them and dodge their attacks to complete new quests.\n\nAll-Time Leaderboard\n\nLeaderboards now include:\n\n*  Daily \n*  Weekly \n*  All-Time \n\nSee how you rank across the entire history of Blade City.\n\nBlade & Cosmetic Shop Renewal\n\nThe Blade Shop and Cosmetic Shop have been redesigned and relocated.\nBrowse the updated shops and discover new items.\n\nWorld Collectables\n\nCoins and Upgrade Chips are now hidden throughout the city.\nExplore rooftops and hard-to-reach places to collect extra rewards.\n\nImprovements\n\nMVP Photo Zone\n\n*  Fixed an issue where recorded MVP poses weren't saved after reconnecting. \n*  Added 3 new dynamic photo backgrounds.\n\nGameplay Improvements \n\n*  Improved avatar finger movement and overall player motion. \n*  Various bug fixes and performance improvements.", "created_date": 1785384868, "id": "1672239238235343", "version": "1.0.10a", "version_code": 104, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1672239238235343"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2403174663506544"}]}, "change_log": " v1.0.10 \u2014 Dance Arena Update\nNew Game Mode \u2014 Dance\n\nMove when it says DANCE, freeze when it says STOP.\nPush your opponents into danger and be the last monkey standing.\n\nWeekly Challenge \u2014 Outlast\n\nObjective\n\n*  Accumulate 100 total minutes surviving across all matches this week. \n*  Every second you stay alive counts toward your progress, even if you die between matches. \n\nReward: Overcharge Ability\n\n* Charge your power over time and unleash a stronger shot the longer you hold it.\n\n\nNew Content\n\nNeon Cleaver Collection\n\nThree new Neon Cleavers have arrived: Crimson, Azure and Emerald \nThree striking neon variants forged for the arena.\n\nWarrior's Gate\n\nEnter the arena in a whole new way.\nGrab the rail with Trigger or Grip and ride straight into the waiting area.\n\nRobot Quests\n\nRobots have appeared throughout the lobby.\nDestroy them and dodge their attacks to complete new quests.\n\nAll-Time Leaderboard\n\nLeaderboards now include:\n\n*  Daily \n*  Weekly \n*  All-Time \n\nSee how you rank across the entire history of Blade City.\n\nBlade & Cosmetic Shop Renewal\n\nThe Blade Shop and Cosmetic Shop have been redesigned and relocated.\nBrowse the updated shops and discover new items.\n\nWorld Collectables\n\nCoins and Upgrade Chips are now hidden throughout the city.\nExplore rooftops and hard-to-reach places to collect extra rewards.\n\nImprovements\n\nMVP Photo Zone\n\n*  Fixed an issue where recorded MVP poses weren't saved after reconnecting. \n*  Added 3 new dynamic photo backgrounds.\n\nGameplay Improvements \n\n*  Improved avatar finger movement and overall player motion. \n*  Various bug fixes and performance improvements.", "created_date": 1785380668, "id": "1672197804906153", "version": "1.0.10", "version_code": 103, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1672239238235343"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785377906, "id": "1672168241575776", "version": "1.0.10", "version_code": 102, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1672239238235343"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1785374546, "id": "1672133721579228", "version": "1.0.10", "version_code": 101, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes"
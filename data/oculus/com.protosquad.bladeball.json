_name": "Blade City Brand Assets Guidelines Screenshot.png", "id": "1563954155334405", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499305349_1563954158667738_5148344098817643433_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Qa-nIzjoj8Q7kNvwFhceAa&_nc_oc=Adp4zVnybB7kUVSHLpqU_lhJM_b-MjzBm0OGlq6T4eqoRFYH-gdQLuL3ewWxXYjpvOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EUl77vohT0uCHb5k1NozZXqXddFcbCZQOLJEKOQ2Hjw&oe=6A3FBFCC"}, {"file_name": "Blade City Brand Assets Guidelines (3).png", "id": "988545750713462", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312267_988545754046795_2419926583975884140_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDHVIkw9q1gQ7kNvwFLzl4-&_nc_oc=Adpu4M8QMzjzqqSP9JSWhV8sEnvVaIzc-clxDRdRApWWUJ5aDp_oxU0fZPBlEK5sqGQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eL0ZSJXwrTzIkJ5uVa7DQmWqSecdIQwFY-8OX9vsTmA&oe=6A3FD541"}, {"file_name": "Blade City Brand Assets Guidelines Screenshot (1).png", "id": "3915626092078551", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296127_3915626095411884_5364719753103044987_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aARu2vNuOv4Q7kNvwEA_HMF&_nc_oc=AdqVkh5ApAqluDH04pkx8B9wxhvvK9Php2J5g4V3WrVfKHR53ePT3RmBU75VncpSUPk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hf5gzVOzkhwdlrBlutjD7GsEk0JzbHL-kHCxZo9OIQQ&oe=6A3FE95A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blade City Brand Assets Cover.png", "id": "1655153859945519", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310667_1655153863278852_7997685239185590787_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_abQtbBexjcQ7kNvwGtm8hj&_nc_oc=Adrk1L28qw3Q8MheMm5TyhJlanm4k9lVBDvIPQ3x_lWOut85ZPvUC635QK9sE0QeBIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97W1mTKKY-h_M3SXKAjoHnqSIz22H73zyqNcDyJirToQ&oe=6A3FEC91"}, "display_name": "Blade City", "keywords": ["sports", "social", "sandbox", "platformer"], "long_description": "A rookie Ninja Monkey with a rusty blade, an empty wallet, and one impossible dream...to become the Master of the Blades \ud83e\udd77\n\nDodge & deflex \u2694\ufe0f in every match to win coins \ud83d\udcb0 \n\nSpend coins to upgrade blades, slay-high abilities, aura \u2728\n\nCoins also unlock mini-games across the city \ud83d\udd79\ufe0f\n\nSkate. Slice. Socialize \ud83d\udef9 \ud83c\udf54  \ud83c\udf63 \n\nGet rich\ud83d\udcb0. Get jacked \ud83d\udcaa. Throw rooftop parties \ud83c\udf89 . Flex \ud83e\udea9\n{1899581750729344}\n\n{2088024375447461}\n\nWanna help us build arena maps, blades, and expand this Ninja City? \ud83e\udd1d\ud83c\udfd9\ufe0f\n\nJoin discord.gg/playbladecity\n\n{1714375429586515}", "short_description": "Become the ultimate Ninja Monkey in Blade City! \ud83e\udd77\ud83d\udc35\nYou have a blade. Everyone else has a blade. Good luck! \u2694\ufe0f"}]}, "developer_name": "Blade Lab", "developer_privacy_policy_url": "https://bladecityvr.com/privacy-policy", "developer_terms_of_service_url": "https://bladecityvr.com/terms-of-service", "publisher_name": "Blade Lab", "support_website_url": "https://discord.gg/playbladecity", "website_url": "https://bladecityvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "1990104051447093"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULT
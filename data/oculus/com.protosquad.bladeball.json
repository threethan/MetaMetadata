e_name": "Blade City Brand Assets Guidelines Screenshot (1).png", "id": "3915626092078551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296127_3915626095411884_5364719753103044987_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cb1b7aeXgqQQ7kNvwE9Pp_m&_nc_oc=Adp7JJETvEVYELdBHFEabIlLp3wz5BsTUKfkOuuvw4dSkxnmwCLAQLof6JcQDWo76GA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDKcXL062qgURrUzFxN7BVshqNu0MZFD_7IUy99WA1XQ&oe=6A62305A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blade City Brand Assets Cover.png", "id": "1655153859945519", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310667_1655153863278852_7997685239185590787_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YF46Y1Aw7sQ7kNvwGkmLkX&_nc_oc=AdpxYCJOkMgGRgrNmlhgYOEeWHsrhLtcHakF5z-zzyU3BZa3zzKkytRKkA9n5DXfBaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzYlwNeWLpZ7Q0OK7DgrvHpg8wUI5FjH9eE_Pb9PE4hg&oe=6A61FB51"}, "display_name": "Blade City", "keywords": ["sports", "social", "sandbox", "platformer"], "long_description": "A rookie Ninja Monkey with a rusty blade, an empty wallet, and one impossible dream...to become the Master of the Blades \ud83e\udd77\n\nDodge & deflex \u2694\ufe0f in every match to win coins \ud83d\udcb0 \n\nSpend coins to upgrade blades, slay-high abilities, aura \u2728\n\nCoins also unlock mini-games across the city \ud83d\udd79\ufe0f\n\nSkate. Slice. Socialize \ud83d\udef9 \ud83c\udf54  \ud83c\udf63 \n\nGet rich\ud83d\udcb0. Get jacked \ud83d\udcaa. Throw rooftop parties \ud83c\udf89 . Flex \ud83e\udea9\n{1899581750729344}\n\n{2088024375447461}\n\nWanna help us build arena maps, blades, and expand this Ninja City? \ud83e\udd1d\ud83c\udfd9\ufe0f\n\nJoin discord.gg/playbladecity\n\n{1714375429586515}", "short_description": "Become the ultimate Ninja Monkey in Blade City! \ud83e\udd77\ud83d\udc35\nYou have a blade. Everyone else has a blade. Good luck! \u2694\ufe0f"}]}, "developer_name": "Blade Lab", "developer_privacy_policy_url": "https://bladecityvr.com/privacy-policy", "developer_terms_of_service_url": "https://bladecityvr.com/terms-of-service", "publisher_name": "Blade Lab", "support_website_url": "https://discord.gg/playbladecity", "website_url": "https://bladecityvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "1990104051447093"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1614607460665188"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2372246093265216"}]}, "baseline_offer": {"id": "2372246093265216"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781905200, "status": "PUBLISHED", "id": "2372246093265216"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1660327346093199", "version": "1.0.8a"}, "id": "2403174663506544", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1660327346093199"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2403174663506544"}]}, "change_log": "* Fixed the shield visibility bug\n* Adjusted 3D sound to be louder at short distances", "created_date": 1784255017, "id": "1660327346093199", "version": "1.0.8a", "version_code": 77, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1660327346093199"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2403174663506544"}]}, "change_log": "v1.0.8 GridFall Arena\n\nNew Arena: Gridfall \n\n* Normal Mode has been renamed to Survivor Mode\n* Fight across three layers of disappearing grid platforms and be the last ninja standing.\n\n\n\nWeekly Challenge: Twin Blades\n\nWeekly Challenges begin and end every 5pm PDT / 8pm EST\n\n* 30 Kills with your Right Hand\n* 30 Kills with your Left Hand\n* Be the first to unlock our brand-new Dual Wield ability! It may or may not come back in the future.\n\n\n\nNew Weapon \n\n* Cyber Rapier \n\n\n\nDiscord Hat Reward\n\n* Join our Discord - Free Blade City Hat will be added to your vanity inventory.\n\n\n\nInventory Machine Improvements\n\n* Search and equip your Blades and Ability Orbs in the same Inventory Machine\n* Peek at your opponent\u2019s inventory machine to see what bro has unlocked\n\n\n\nCrafting Table Improvements\n\n* Crafting your blade is now filled with aura.\n* You can now destroy unwanted Ability Orbs.\n* Overwriting an enchantment now consumes the previous Ability Orb instead of returning it.\n\n\n\nDaily Quest\n\n* After unlocking every Ability reward, you'll start earning duplicate Ability Orbs from Daily Quests.\n\n\nChanges & Fixes\n\n* Ball outlines are now always visible, even when the ball is hidden behind platforms or other obstacles.\n* Curve Edge: Fixed an issue where the ball could fall through the floor, and increased cooldown.\n* Ball Speed: Increased the maximum ball speed cap by 16%.\n* Team Mode: Increased the spawn interval for Revive Items.\n* Bots: Improved bot behavior to reduce accidental falls in Survivor Mode.\n\n\n\nKnown Issue\n\n* Discord Hat: The hat may become unequipped after restarting the game and return to your inventory. We'll fix this in the next update.", "created_date": 1784182258, "id": "1659553189503948", "version": "1.0.8", "version_code": 76, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1660327346093199"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784177193, "id": "1659505006175433", "version": "1.0.8", "version_code": 75, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1660327346093199"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784174401, "id": "1659479256178008", "version": "1.0.8", "version_code": 74, "release_status"
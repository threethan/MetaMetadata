ults": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1660327346093199"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784773886, "id": "1665708605555073", "version": "1.0.9", "version_code": 91, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1660327346093199"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1784770788, "id": "1665678085558125", "version": "1.0.9", "version_code": 90, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1660327346093199"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2403174663506544"}]}, "change_log": "* Fixed the shield visibility bug\n* Adjusted 3D sound to be louder at short distances", "created_date": 1784255017, "id": "1660327346093199", "version": "1.0.8a", "version_code": 77, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1660327346093199"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2403174663506544"}]}, "change_log": "v1.0.8 GridFall Arena\n\nNew Arena: Gridfall \n\n* Normal Mode has been renamed to Survivor Mode\n* Fight across three layers of disappearing grid platforms and be the last ninja standing.\n\n\n\nWeekly Challenge: Twin Blades\n\nWeekly Challenges begin and end every 5pm PDT / 8pm EST\n\n* 30 Kills with your Right Hand\n* 30 Kills with your Left Hand\n* Be the first to unlock our brand-new Dual Wield ability! It may or may not come back in the future.\n\n\n\nNew Weapon \n\n* Cyber Rapier \n\n\n\nDiscord Hat Reward\n\n* Join our Discord - Free Blade City Hat will be added to your vanity inventory.\n\n\n\nInventory Machine Improvements\n\n* Search and equip your Blades and Ability Orbs in the same Inventory Machine\n* Peek at your opponent\u2019s inventory machine to see what bro has unlocked\n\n\n\nCrafting Table Improvements\n\n* Crafting your blade is now filled with aura.\n* You can now destroy unwanted Ability Orbs.\n* Overwriting an enchantment now consumes the previous Ability Orb instead of returning it.\n\n\n\nDaily Quest\n\n* After unlocking every Ability reward, you'll start earning duplicate Ability Orbs from Daily Quests.\n\n\nChanges & Fixes\n\n* Ball outlines are now always visible, even when the ball is hidden behind platforms or other obstacles.\n* Curve Edge: Fixed an issue where the ball could fall through the floor, and increased cooldown.\n* Ball Speed: Increased the maximum ball speed cap by 16%.\n* Team Mode: Increased the spawn interval for Revive Items.\n* Bots: Improved bot behavior to reduce accidental falls in Survivor Mode.\n\n\n\nKnown Issue\n\n* Discord Hat: The hat may become unequipped after restarting the game and return to your inventory. We'll fix this in the next update.", "created_date": 1784182258, "id": "1659553189503948", "version": "1.0.8", "version_code": 76, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
e_name": "Blade City Brand Assets Guidelines Screenshot (1).png", "id": "3915626092078551", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499296127_3915626095411884_5364719753103044987_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1rHVwzNoO0Q7kNvwFEtd7b&_nc_oc=AdrOJdYSJmMhkLqC_oZHY4zGrwqiQbtwFCF6R3pqdQoon9uA07fhUnw2f-23M2H7HN0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxJhOhruYDdJn91Z4RzomA0shT9u3Xego5EoWY4IvN3A&oe=6A55015A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blade City Brand Assets Cover.png", "id": "1655153859945519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310667_1655153863278852_7997685239185590787_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-rHATJu2NAQ7kNvwFVEIW-&_nc_oc=AdrC8IsYj4qLGI8EoGBpVLvpMxLvQBQdslM7ZzljseF07bHdV-hnXizfqBR5WW2bxxY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0q3DSmCAvUyn2fON02eagQW2HvHjUFrdMWmG4eYnK4Q&oe=6A550491"}, "display_name": "Blade City", "keywords": ["sports", "social", "sandbox", "platformer"], "long_description": "A rookie Ninja Monkey with a rusty blade, an empty wallet, and one impossible dream...to become the Master of the Blades \ud83e\udd77\n\nDodge & deflex \u2694\ufe0f in every match to win coins \ud83d\udcb0 \n\nSpend coins to upgrade blades, slay-high abilities, aura \u2728\n\nCoins also unlock mini-games across the city \ud83d\udd79\ufe0f\n\nSkate. Slice. Socialize \ud83d\udef9 \ud83c\udf54  \ud83c\udf63 \n\nGet rich\ud83d\udcb0. Get jacked \ud83d\udcaa. Throw rooftop parties \ud83c\udf89 . Flex \ud83e\udea9\n{1899581750729344}\n\n{2088024375447461}\n\nWanna help us build arena maps, blades, and expand this Ninja City? \ud83e\udd1d\ud83c\udfd9\ufe0f\n\nJoin discord.gg/playbladecity\n\n{1714375429586515}", "short_description": "Become the ultimate Ninja Monkey in Blade City! \ud83e\udd77\ud83d\udc35\nYou have a blade. Everyone else has a blade. Good luck! \u2694\ufe0f"}]}, "developer_name": "Blade Lab", "developer_privacy_policy_url": "https://bladecityvr.com/privacy-policy", "developer_terms_of_service_url": "https://bladecityvr.com/terms-of-service", "publisher_name": "Blade Lab", "support_website_url": "https://discord.gg/playbladecity", "website_url": "https://bladecityvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "1990104051447093"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1614607460665188"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2372246093265216"}]}, "baseline_offer": {"id": "2372246093265216"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781905200, "status": "PUBLISHED", "id": "2372246093265216"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1646332040826063", "version": "1.0.6"}, "id": "2403174663506544", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1646332040826063"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log"
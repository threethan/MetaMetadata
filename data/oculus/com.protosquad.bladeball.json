00_AQQPDJ3rxShbiy7FBKOfR5HvijXkyvbYn2ZMl7dHym2PNA&oe=6B070A8C"}, {"file_name": "Blade City Brand Assets Guidelines (3).png", "id": "988545750713462", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312267_988545754046795_2419926583975884140_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b55qRr18A8MQ7kNvwEW858B&_nc_oc=AdqOIO_bUpaBulge6LgP6b2AO4MJ5TKTZyht9BPnWN-bbBONwh_vDj7NtE967nyDVTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpIliuuWaoCVa03gyW0bB2rKHtycyRU16N9RBy1nQ5yw&oe=6B072001"}, {"file_name": "Blade City Brand Assets Guidelines Screenshot (1).png", "id": "3915626092078551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296127_3915626095411884_5364719753103044987_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdXwEwHjaDcQ7kNvwGuSK6J&_nc_oc=Adr77Dxsx56ujAQ6tQIzibxVNwXeLVWCICFhRWWK-7O594cJxyiDLoY4QPBE0dZ8QGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn2ar97e1La98LGHJB5JjTirbnFLvBA8oqBfdHrEbDqg&oe=6B06FBDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blade City Brand Assets Cover.png", "id": "1655153859945519", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310667_1655153863278852_7997685239185590787_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXl1EHz5gTYQ7kNvwGOIOfm&_nc_oc=AdpubvD6EkLddV30on3ILytGrTgAhMHbSUtEorq0hgRb9bZa9MEJEQftLpTB4X7pRSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO6R3dDx8_-aoGXyj6QcrOXRYe9Z9mh4X0nOsRsXSo0Q&oe=6B06FF11"}, "display_name": "Blade City", "keywords": ["sports", "social", "sandbox", "platformer"], "long_description": "A rookie Ninja Monkey with a rusty blade, an empty wallet, and one impossible dream...to become the Master of the Blades \ud83e\udd77\n\nDodge & deflex \u2694\ufe0f in every match to win coins \ud83d\udcb0 \n\nSpend coins to upgrade blades, slay-high abilities, aura \u2728\n\nCoins also unlock mini-games across the city \ud83d\udd79\ufe0f\n\nSkate. Slice. Socialize \ud83d\udef9 \ud83c\udf54  \ud83c\udf63 \n\nGet rich\ud83d\udcb0. Get jacked \ud83d\udcaa. Throw rooftop parties \ud83c\udf89 . Flex \ud83e\udea9\n{1899581750729344}\n\n{2088024375447461}\n\nWanna help us build arena maps, blades, and expand this Ninja City? \ud83e\udd1d\ud83c\udfd9\ufe0f\n\nJoin discord.gg/playbladecity\n\n{1714375429586515}", "short_description": "Become the ultimate Ninja Monkey in Blade City! \ud83e\udd77\ud83d\udc35\nYou have a blade. Everyone else has a blade. Good luck! \u2694\ufe0f"}]}, "developer_name": "Blade Lab", "developer_privacy_policy_url": "https://bladecityvr.com/privacy-policy", "developer_terms_of_service_url": "https://bladecityvr.com/terms-of-service", "publisher_name": "Blade Lab", "support_website_url": "https://discord.gg/playbladecity", "website_url": "https://bladecityvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "1990104051447093"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1614607460665188"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2372246093265216"}]}, "baseline_offer": {"id": "2372246093265216"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781905200, "status": "PUBLISHED", "id": "2372246093265216"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1720619430063990", "version": "1.0.17b"}, "id": "2403174663506544", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1720619430063990"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2403174663506544"}]}, "change_log": "\ud83c\udfd9\ufe0f v1.0.17 \u2014 City & Elevator Update\n\n\n\ud83c\udfd9\ufe0f A Whole New Lobby \u2014 The City\n\nThe old lobby room is gone. You now spawn into a full open city.\n\n* Ziplines and railings to get around, shops and stations as real places you walk into.\n* Combat is live outside Safe Zones \u2014 draw on anyone in the street. Step into a Safe Zone and you can't be touched. (Street kills don't count toward matches or rewards.)\n\n\ud83d\uded7 New Travel \u2014 Elevators\n\nArenas are no longer a vote inside one room. Each arena is its own place, and you ride there.\n\n* Step into the elevator, pick a Category and a Map, press Submit. The first vote starts a 10-second countdown \u2014 majority wins. Press again to cancel.\n* Everybody in the car travels together, voted or not. Step out to stay behind.\n* In a hurry? Your Watch now has solo quick travel.\n\n\ud83c\udfea New Feature \u2014 Global Trading Center\n\nTrade with the whole server at the new kiosk in the city.\n\n* List anything you own at a fixed price per unit, and collect the proceeds \u2014 or whatever didn't sell \u2014 later.\n* Blades, costumes, pets, eggs and dye ampoules are all tradeable.\n\n\ud83d\udc38 New Feature \u2014 Pets\n\nHatch a pet and take it everywhere with you.\n\n* Buy a Frog Egg (10,000 coins) and hatch it at the Hatch Altar in the city.\n* Equip from the PETS tab on the Inventory Machine\n* Your pet hops along behind you, and you can pick it up, pet it, throw it, swat it with your blade or roll it into ball form. Hand it a burger from the vending machine and it'll eat right out of your hand.\n* Pets level up from your kills, your wins, and time spent together.\n\n\ud83c\udf9b\ufe0f New Feature \u2014 Custom Match Console\n\nTake an arena's match over for your party.\n\n* Enter a room code at the lobby terminal to make a private lobby \u2014 the code follows your party into the arena and back.\n* At the console in the Wait Area: pick a side, sit a match out, set bot count and difficulty, give the bots abilities, set the time limit, and start immediately.\n\n\ud83e\ude93 Chopping Arena\n\nThe Chopping arena got its full environment art pass.\n\n\ud83d\udcb0 Economy\n\n* Match coin payouts up 50%.\n* Kills now drop 5 coin pickups instead of 3.\n\n\ud83d\udd27 Improvements\n\n* Bots \u2014 bots block ability shots 10% less often, so your orbs are worth using on them.\n* Respawn \u2014 the return prompt appears twice as fast.", "created_date": 1789699500, "id": "1720619430063990", "version": "1.0.17b", "version_code": 230, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1720619430063990"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2403174663506544"}]}, "change_log": "\ud83c\udfd9\ufe0f v1.0.17 \u2014 City & Elevator Update\n\n\n\ud83c\udfd9\ufe0f A Whole New Lobby \u2014 The City\n\nThe old lobby room is gone. You now spawn into a full open city.\n\n* Ziplines and railings to get around, shops and stations as real places you walk into.\n* Combat is live outside Safe Zones \u2014 draw on anyone in the street. Step into a Safe Zone and you can't be touched. (Street kills don't count toward matches or rewards.)\n\n\ud83d\uded7 New Travel \u2014 Elevators\n\nArenas are no longer a vote inside one room. Each arena is its own place, and you ride there.\n\n* Step into the elevator, pick a Category and a Map, press Submit. The first vote starts a 10-second countdown \u2014 majority wins. Press again to cancel.\n* Everybody in the car travels together, voted or not. Step out to stay behind.\n* In a hurry? Your Watch now has solo quick travel.\n\n\ud83c\udfea New Feature \u2014 Global Trading Center\n\nTrade with the whole server at the new kiosk in the city.\n\n* List anything you own at a fixed price per unit, and collect the proceeds \u2014 or whatever didn't sell \u2014 later.\n* Blades, costumes, pets, eggs and dye ampoules are all tradeable.\n\n\ud83d\udc38 New Feature \u2014 Pets\n\nHatch a pet and take it everywhere with you.\n\n* Buy a Frog Egg (10,000 coins) and hatch it at the Hatch Altar in the city.\n* Equip from the PETS tab on the Inventory Machine\n* Your pet hops along behind you, and you can pick it up, pet it, throw it, swat it with your blade or roll it into ball form. Hand it a burger from the vending machine and it'll eat right out of your hand.\n* Pets level up from your kills, your wins, and time spent together.\n\n\ud83c\udf9b\ufe0f New Feature \u2014 Custom Match Console\n\nTake an arena's match over for your party.\n\n* Enter a room code at the lobby terminal to make a private lobby \u2014 the code follows your party into the arena and back.\n* At the console in the Wait Area: pick a side, sit a match out, set bot count and difficulty, give the bots abilities, set the time limit, and start immediately.\n\n\ud83e\ude93 Chopping Arena\n\nThe Chopping arena got its full environment art pass.\n\n\ud83d\udcb0 Economy\n\n* Match coin payouts up 50%.\n* Kills now drop 5 coin pickups instead of 3.\n\n\ud83d\udd27 Improvements\n\n* Bots \u2014 bots block ability shots 10% less often, so your orbs are worth using on them.\n* Respawn \u2014 the return prompt appears twice as fast.", "created_date": 1789629302, "id": "1719804980145435", "version": "1.0.17a", "version_code": 229, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1720619430063990"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789628140, "id": "1719792360146697", "version": "1.0.17a", "version_code": 228, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1720619430063990"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2403174663506544"}]}, "change_log": "\ud83c\udfd9\ufe0f v1.0.17 \u2014 City & Elevator Update\n\n\n\ud83c\udfd9\ufe0f A Whole New Lobby \u2014 The City\n\nThe old lobby room is gone. You now spawn into a full open city.\n\n* Ziplines and railings to get around, shops and stations as real places you walk into.\n* Combat is live outside Safe Zones \u2014 draw on a
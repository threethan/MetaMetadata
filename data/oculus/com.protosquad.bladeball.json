latformer"], "long_description": "A rookie Ninja Monkey with a rusty blade, an empty wallet, and one impossible dream...to become the Master of the Blades \ud83e\udd77\n\nDodge & deflex \u2694\ufe0f in every match to win coins \ud83d\udcb0 \n\nSpend coins to upgrade blades, slay-high abilities, aura \u2728\n\nCoins also unlock mini-games across the city \ud83d\udd79\ufe0f\n\nSkate. Slice. Socialize \ud83d\udef9 \ud83c\udf54  \ud83c\udf63 \n\nGet rich\ud83d\udcb0. Get jacked \ud83d\udcaa. Throw rooftop parties \ud83c\udf89 . Flex \ud83e\udea9\n{1899581750729344}\n\n{2088024375447461}\n\nWanna help us build arena maps, blades, and expand this Ninja City? \ud83e\udd1d\ud83c\udfd9\ufe0f\n\nJoin discord.gg/playbladecity\n\n{1714375429586515}", "short_description": "Become the ultimate Ninja Monkey in Blade City! \ud83e\udd77\ud83d\udc35\nYou have a blade. Everyone else has a blade. Good luck! \u2694\ufe0f"}]}, "developer_name": "Blade Lab", "developer_privacy_policy_url": "https://bladecityvr.com/privacy-policy", "developer_terms_of_service_url": "https://bladecityvr.com/terms-of-service", "publisher_name": "Blade Lab", "support_website_url": "https://discord.gg/playbladecity", "website_url": "https://bladecityvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "1990104051447093"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULT
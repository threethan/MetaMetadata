e_name": "Blade City Brand Assets Guidelines Screenshot (1).png", "id": "3915626092078551", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499296127_3915626095411884_5364719753103044987_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13ez3X3vd-8Q7kNvwGGbPcZ&_nc_oc=Adq8XhpkqtGRsF6CF8utIMtenELiiMAaBuGyfs76enwNZQi4cJ7x-kQ80zUxHVSV8Ek&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmOUAItDYGT2S4asBKLjjk-JmGCx9-uebvBGgc27Fj-A&oe=6A58F5DA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Blade City Brand Assets Cover.png", "id": "1655153859945519", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499310667_1655153863278852_7997685239185590787_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO9W4GD21WwQ7kNvwFaKMEk&_nc_oc=AdqdjVbJRE0ADIDvFdhGgAf4Lxk2EuLVAbU5L25VraO18KDznND_6k22qsXLPAw0zW0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVjVVy2K644nEPs1GjRJbR8dnlJ8yAn7YRAehHhvPDIg&oe=6A58C0D1"}, "display_name": "Blade City", "keywords": ["sports", "social", "sandbox", "platformer"], "long_description": "A rookie Ninja Monkey with a rusty blade, an empty wallet, and one impossible dream...to become the Master of the Blades \ud83e\udd77\n\nDodge & deflex \u2694\ufe0f in every match to win coins \ud83d\udcb0 \n\nSpend coins to upgrade blades, slay-high abilities, aura \u2728\n\nCoins also unlock mini-games across the city \ud83d\udd79\ufe0f\n\nSkate. Slice. Socialize \ud83d\udef9 \ud83c\udf54  \ud83c\udf63 \n\nGet rich\ud83d\udcb0. Get jacked \ud83d\udcaa. Throw rooftop parties \ud83c\udf89 . Flex \ud83e\udea9\n{1899581750729344}\n\n{2088024375447461}\n\nWanna help us build arena maps, blades, and expand this Ninja City? \ud83e\udd1d\ud83c\udfd9\ufe0f\n\nJoin discord.gg/playbladecity\n\n{1714375429586515}", "short_description": "Become the ultimate Ninja Monkey in Blade City! \ud83e\udd77\ud83d\udc35\nYou have a blade. Everyone else has a blade. Good luck! \u2694\ufe0f"}]}, "developer_name": "Blade Lab", "developer_privacy_policy_url": "https://bladecityvr.com/privacy-policy", "developer_terms_of_service_url": "https://bladecityvr.com/terms-of-service", "publisher_name": "Blade Lab", "support_website_url": "https://discord.gg/playbladecity", "website_url": "https://bladecityvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "821934236779161"}, {"id": "1990104051447093"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1614607460665188"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2372246093265216"}]}, "baseline_offer": {"id": "2372246093265216"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781905200, "status": "PUBLISHED", "id": "2372246093265216"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1653309593461641", "version": "1.0.7"}, "id": "2403174663506544", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1653309593461641"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1783700919, "id": "1654612319998035", "version": "1.0.7", "version_code": 65, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1614607450665189", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1653309593461641"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2403174663506544"}]}, "change_log": "# New Content\n\n## Weekly Challenges\n- Weekly Challenges are here!\n- Complete a new set of challenges each week to earn exclusive rewards.\n- **This week's exclusive reward:** **Red Cyber Rapier**\n\n## Level System\n- Earn EXP by playing matches and level up your **Lifetime Level**.\n- Current level cap: **20**\n\n## New Ability\n- **Curve Edge**\nA new ability that curves the ball's trajectory, making it harder for opponents to predict.\n\n## New Skin\n- **Ninja Assassin Outfit**\nA brand new outfit for players who prefer a stealthy look.\n\n# Improvements\n\n- **Voice Changer**\nTemporarily removed while we explore a better implementation. It will return in a future update.\n\n- **Match Joining**\nPlayers now join or leave matchmaking by physically jumping into or out of the arena.\n\n# Fixes\n\n- Fixed an issue where the ball could pass through your blade after eliminating a player and immediately retargeting you.\n- Fixed an issue where **Dragon Spiral** could appear larger than intended.", "created_date": 1783581148, "id": "1653309593461641", "version": "1.0.7", "version_code": 64, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinary
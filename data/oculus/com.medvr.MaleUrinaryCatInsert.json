.com/v/t64.5771-25/491822467_1723199178382144_4696257946175454543_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QE40e9pU8sAQ7kNvwE4yf7X&_nc_oc=AdoCbnYT5FfzJKFgk8gbp1frCXjolQVrB8D2NsREfUeYkU1lIbw_Cyee6wqiUSXdroc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoqazECDGMLAMOVjMtkF2NFa7LAqkBLQ6QgtL_s_ShjA&oe=69CBCB4B"}, {"file_name": "male urinary catheter insertion.00_26_07_18.Still006.png", "id": "1444339940228160", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820548_1444339943561493_862611697872705139_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFQqUxK-VBgQ7kNvwHazkiW&_nc_oc=AdpV3dKo5RUkILc4fww6JdSaPlClYFS5KOT41r2uSXgDSlLKBAAnwWxh4dTR45nFJ50&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyg28peEuK4X1DYN0spjDGqSY2uceGgXG4kWpIqczon0g&oe=69CBAA10"}, {"file_name": "male urinary catheter insertion.00_38_43_06.Still007.png", "id": "1417438996178640", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823395_1417438999511973_424626288690117040_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyVRuz-32koQ7kNvwFyWMpc&_nc_oc=AdqoZq_Zn58xt9HUEi4gyXV5Jrbntds0BRXPoXgFMa3jFtphRxV2FMQwhzFmjvQMtyI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJiCcwt5DZm0wlcK90dSvBQGO1_tuwDTG89gX52gJJCQ&oe=69CBDAF0"}, {"file_name": "male urinary catheter insertion.00_24_36_20.Still002.png", "id": "3065658216973545", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824210_3065658220306878_6589193120308744424_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLVGpBwxZ8UQ7kNvwESTVwz&_nc_oc=AdoDvMvV59GutbfnLfGJkUnwiV4CnHJi9C7MS2Im4UzrIMoOn_vegfAvpXrlZn5AARw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwo9wRro6vtwquop9AYe-vwcv6RFgpz_hTlh1Wel55VYw&oe=69CBAE0A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Urinary Catheter Insertion \u2013 Male", "keywords": ["Medvr", "VR", "Male", "Foley"], "long_description": "Urinary Catheter Insertion \u2013 Male is a high-fidelity VR simulation designed to help medical learners master the essential clinical skill of inserting a urinary catheter in male patients. The simulation guides users through proper preparation, anatomical landmarks, sterile technique, catheter selection, and safe insertion steps. Users receive real-time feedback to reinforce best practices and reduce the risk of complications. This training tool is ideal for nursing students, medical trainees, and allied health professionals seeking hands-on experience in a safe, repeatable environment.", "short_description": "Learn and practice the step-by-step procedure of male urinary catheter insertion in an immersive VR environment. Ideal for medical students, nurses, and healthcare professionals to build clinical skills in a safe and realistic setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24297638216511287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820983_1082100784124663_1557743088951261672_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h5YDb3Nw88Q7
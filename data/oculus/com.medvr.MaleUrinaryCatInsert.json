 Male is a high-fidelity VR simulation designed to help medical learners master the essential clinical skill of inserting a urinary catheter in male patients. The simulation guides users through proper preparation, anatomical landmarks, sterile technique, catheter selection, and safe insertion steps. Users receive real-time feedback to reinforce best practices and reduce the risk of complications. This training tool is ideal for nursing students, medical trainees, and allied health professionals seeking hands-on experience in a safe, repeatable environment.", "short_description": "Learn and practice the step-by-step procedure of male urinary catheter insertion in an immersive VR environment. Ideal for medical students, nurses, and healthcare professionals to build clinical skills in a safe and realistic setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24297638216511287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820983_1082100784124663_1557743088951261672_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pycMLvsrssQ7
6857_2249474879496953057_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sgh7ow03-HQQ7kNvwFpyhd7&_nc_oc=AdpuqCjasZLGkfbF72lpM15BVunlxSRL5Ugj9acFfHCDkHIE6kazqWu3j60k59l9EeU&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sddT_4H7fO3-XvI4xuLZpo6KFdMovDcwhVr8EzUFTsA&oe=6A11AA75"}, "display_name": "Virtual Battlefield", "keywords": [], "long_description": "This is a multiplayer VR game that offers various exciting features and modes, such as the thrilling Boss Mode with epic battles and rewards, and the dynamic Free-for-All Mode for intense combat. Players can explore a diverse arsenal of weapons like bows, pistols, and cards, while enjoying additional features like a Shop System to purchase items and characters, and a Friends System to team up and strategize. With stunning graphics, immersive sound effects, and creative design, the game delivers a true battlefield experience full of action, cooperation, and endless fun.", "short_description": "This is a multiplayer VR game where players can enjoy various game modes such as Free-for-All, Boss Mode, and more. The game features a wide range of weapons, including bows, pistols, and cards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/lijiafu01/Virtual-Battlefield/blob/main/Virtual%20Battlefield%20Policy", "developer_terms_of_service_url": null, "publisher_name": "Enzo2602", "support_website_url": null, "website_url": "https://lijiafu01.github.io/Virtual-Battlefield/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["O
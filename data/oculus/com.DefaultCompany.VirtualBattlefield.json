ad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXVqi7i3mk8kUeImAmgixjzeNbZxg8jMdq37ZMNPGbZWg&oe=6B104C09"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Virtual Battlefield (1).png", "id": "1493375604673524", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001728_1493375608006857_2249474879496953057_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8OYYapxBIQQ7kNvwEUh1pl&_nc_oc=AdrENUgZpvOV7llbcr2SPNpiomaMIt1oIIwuN6KluoIkHpnLdNsn9dj3oth4Pkg9IGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV0lGP2Iy23b1Uo65ZVZ4yc3Mk7tsh5IkOTnI6qPZRzoQ&oe=6B105435"}, "display_name": "Virtual Battlefield", "keywords": [], "long_description": "This is a multiplayer VR game that offers various exciting features and modes, such as the thrilling Boss Mode with epic battles and rewards, and the dynamic Free-for-All Mode for intense combat. Players can explore a diverse arsenal of weapons like bows, pistols, and cards, while enjoying additional features like a Shop System to purchase items and characters, and a Friends System to team up and strategize. With stunning graphics, immersive sound effects, and creative design, the game delivers a true battlefield experience full of action, cooperation, and endless fun.", "short_description": "This is a multiplayer VR game where players can enjoy various game modes such as Free-for-All, Boss Mode, and more. The game features a wide range of weapons, including bows, pistols, and cards."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/lijiafu01/Virtual-Battlefield/blob/main/Virtual%20Battlefield%20Policy", "developer_terms_of_service_url": null, "publisher_name": "Enzo2602", "support_website_url": null, "website_url": "https://lijiafu01.github.io/Virtual-Battlefield/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"i
 {"file_name": "01-journey-library.png", "id": "1063622489557066", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823310_1063622492890399_5393649776826319142_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AShbjppbbbIQ7kNvwE57mho&_nc_oc=AdpGZAdWkwsT1yczk4PaCnYsUgnU1_q-GF8YnRXGz-_DDm1VRys_BRQNyKy8ej739vM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFxWPnbPbFc3JhiZ5QwxbKD5yAyAtQiPlHxoLjgERbwA&oe=6A9180A3"}, {"file_name": "03-immersive-journey-controls.png", "id": "1204389656096251", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491823259_1204389666096250_8472737937657594449_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeG0Mf6UagAQ7kNvwHzRE1a&_nc_oc=AdoFnhPfJdDRHRfTv8BWU4Svi4eN50JYSvUhxYAVLvzq4pOMDcpdsr5a5MxALWpGe74&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVSdZlz_UVsOjIMyWYpfwkrdhgO43XNfjfJ2dYcWX06w&oe=6A918009"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iHypnosis: Inspiring Journeys", "keywords": ["motivation", "reflection", "relaxation", "immersive", "wellbeing"], "long_description": "iHypnosis: Inspiring Journeys opens in a cinematic, comfort-first sanctuary and pairs seven immersive 360\u00b0 locations with six original motivational speeches. First choose a setting, then choose any narration to create your own reflective journey. The original video audio is muted, and a shorter scene loops gently until the selected speech ends.\n\nVisit a woodland sunrise, a sunset, the Czech waterside, a tranquil sea, Attali Monastery, a peaceful park, or the Canary Islands' ocean. Pause, restart, recenter, adjust narration volume, enable English subtitles, or return to the library at any time.\n\nThe comfort-first design supports seated and stationary standing use without artificial locomotion, forced camera movement or flashing effects. All launch media is included for offline playback after installation.\n\nThis application provides motivational and reflective audiovisual content. It is not medical treatment, crisis support or a substitute for professional healthcare.", "short_description": "Pair seven epic 360\u00b0 journeys with six original motivational speeches, offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihypnosis.org.uk/wp/index.php/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Jakub Tencl Ph.D.", "support_website_url": null, "website_url": "https://ihypnosis.org.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1173424459194929"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1658882251849282"}]}, "baseline_offer": {"id": "1658882251849282"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787328000, "status": "PUBLISHED", "id": "1658882251849282"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1211010275436347", "version": "1.0.0"}, "id": "1600239361678063", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1159633383907370", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1211010275436347"}, "release_status": "R
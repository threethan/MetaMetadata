S", "screenshots": [{"file_name": "05-settings-accessibility.png", "id": "3295900627287593", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_3295900630620926_6522298400690846895_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOg_oLbO1j0Q7kNvwG-oozq&_nc_oc=AdrrYkAvxA6tLH4ENw3zOAYh4JqWi7Xy_4QuzswYKFdKUaUHbfZT23Zsy8LB4jHn8dw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfwtMtyrDoQzsKFsva9iWN-XHPktHqyvL9IkOidjwVzQ&oe=6AB295A1"}, {"file_name": "04-immersive-journey-subtitles.png", "id": "1846853333342259", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823910_1846853336675592_55773025947418446_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRnxV9qohM0Q7kNvwFJLF94&_nc_oc=AdpRRe_hiz_ev3IBbe60QoI_ILiXRXEqqM_xY4zasDiiHxqRA1I7e0hcYpbCAw-gHy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4pijVaKJb0GWsW6uG7h0GxeszLqNzGv_X2WBuDk2dKA&oe=6AB295A8"}, {"file_name": "02-speech-selection.png", "id": "3182563611943121", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823259_3182563618609787_9081537162958732788_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC3HC8AxwxgQ7kNvwFXWEhx&_nc_oc=AdpZtPlBrMQhbkLLdzWyL9ntqq2Df9umadMVrdHf7s8Agtkv8BdCShlv_FFGStaZ-NY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhhBpxn9U1uAlImx7keZIVJ9PvVSLIku_ln777QBNcJw&oe=6AB28C2F"}, {"file_name": "01-journey-library.png", "id": "3286928298153287", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824318_3286928304819953_5672951820788054842_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YklEJzxPNWIQ7kNvwGTjP0o&_nc_oc=Adoq7oWH9R0goTjQ5nniXMlfnTBmGTiiTQ0rjDtVlyGda5k3qF8cSBSHNAvGBiNfEAs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcHHg8cutYubk7iyJAEVZuHMbEfZxeH00LK-VpX1AM4g&oe=6AB282C5"}, {"file_name": "03-immersive-journey-controls.png", "id": "1061110209976641", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_1061110213309974_6820914588363451742_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8SpNxPPie-0Q7kNvwFvbSXZ&_nc_oc=AdpVwkj34yX2kKfJS9MFW7c4bkvdY7jHT0JmJAUZgtVm3DC5ewrkWqHy0lAA0vtwct8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3nQ12-X-b9sObzBefcYAtAKJniZ8sMvSQQzN2Ng03PQ&oe=6AB271C8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "iHypnosis: Inspiring Journeys", "keywords": ["motivation", "reflection", "relaxation", "immersive", "wellbeing"], "long_description": "iHypnosis: Inspiring Journeys pairs seven immersive 360\u00b0 locations with six original motivational speeches in a cinematic, comfort-first sanctuary. Choose any setting and narration. The original video audio is muted, and shorter scenes loop gently until the speech ends.\n\nExplore nature and heritage settings. Pause, restart, recenter, set narration volume, use English subtitles or return to the library.\n\nOptional, user-controlled biofeedback requires a supported accessory, sold separately. After a 60-second baseline, the app can suggest a Journey and Voice and create a quiet adaptive sound layer locally on the headset. Choose Baseline fixed to keep its pitch, spatial spread, texture and modulation steady, or Live responsive for slow, limited changes from recent reliable attention and relaxation readings. The layer remains beneath the narration and can be adjusted, muted or disabled. All journeys also work without biofeedback.\n\nBefore-and-after readings and optional check-ins provide a personal comparison of sessions. The adaptive ambience is designed to support your chosen atmosphere for relaxation, focus or reflection; experiences vary, and no outcome is guaranteed. Readings and scores are session-relative, not medical, diagnostic or psychological assessments.\n\nDesigned for seated and stationary standing use without artificial locomotion, forced camera movement or flashing. All launch media is included for offline playback.", "short_description": "Pair seven epic 360\u00b0 journeys with six original speeches, plus optional biofeedback and adaptive sound."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ihypnosis.org.uk/wp/index.php/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Jakub Tencl Ph.D.", "support_website_url": null, "website_url": "https://ihypnosis.org.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1219505041253537"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/604338899_2452372985240297_5462842023964395057_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pE-n8idxEAQ7kNvwHdrEJa&_nc_oc=Adr4UgxOzEAa_mvme8os4x0ZK1cb8x6RaOCHKhcnvLTPK8KO-Vr_ULAgY_PHVY4n3Ns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3vLS0kx9igdo8W8dApmzmU4rmNe32u3-NAVOyCBAzxg&oe=6AB28BF5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "iHypnosis: Inspiring Journeys", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1787328000, "lastRevision": {"nodes": [{"id": "1159633427240699", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale":
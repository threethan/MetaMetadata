 "meta-store-nordpass-hero-cover-3000x900\u00a0.png", "id": "912535618591314", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823448_912535625257980_5300651614057342206_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lnk0NTJyYW8Q7kNvwEMuJjM&_nc_oc=AdqAu7JoMCt-J7za6gWzyi0YFvlBldGXqLzkBdsh7VEEwa8UPiJUBFBVxYp9_Znhy2U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5GOqVIxVnEu2deU8bVeHZQ_EY83MHjgMijEhv4W6Yrw&oe=6AF9B6EF"}]}, "id": "2957294087938114", "locale": "en_US", "screenshots": [{"file_name": "meta-store-nordpass-screenshorts-2560x1440-1.png", "id": "1699273224405586", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823757_1699273227738919_1569322690882439911_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gK-n0YEipmAQ7kNvwFHwANn&_nc_oc=AdqdnTGDulJH34HPzWGxjQEL02fyecbGMNb1W93fQmd2W4LzPAZ3C8dszNyGotj96D0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc6RvvIUEkxyRjtcCDLYjLBCxc__knDyq76p0lO5ClNg&oe=6AF9DAFA"}, {"file_name": "meta-store-nordpass-screenshorts-2560x1440-4.png", "id": "1793911635350746", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821702_1793911638684079_435918378000012941_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOStsWiKlJsQ7kNvwEW0Ww1&_nc_oc=AdoHIYHLAh5bpeswqAJSIKObW9JJiDOI3WEk-oAAqLax9fEgz3bV67fxXKGeFQ8TIwQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_PHarZYCYCaBk4TFWVyMf1vnSmvR2rL61TH-cTOE8nQ&oe=6AF9D033"}, {"file_name": "meta-store-nordpass-screenshorts-2560x1440-2.png", "id": "1529209505240582", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819982_1529209508573915_1053508358017507237_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CntiOSiGCzUQ7kNvwGF1p-l&_nc_oc=AdqX5oGq3_fvQO94U20ghk3cAnT8prWHUbGgpdhpG_WvnUW-EsDuYHLSzoLRO5jC8wY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfFmnivnyBpc78vK6D_Nk--G1d7f2jNnhywfzcaQPfAw&oe=6AF9C531"}, {"file_name": "meta-store-nordpass-screenshorts-2560x1440-3.png", "id": "1485685229875998", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820141_1485685233209331_2698855519218418346_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jD_CrnWcYIIQ7kNvwHjOrFC&_nc_oc=AdqUvreSm211btBUDLzB72sZrX8xiGXLK-yemawGbWOHf-p5mMEklzluOy0B5TxZHM8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTfhlpvXoCzL29QMTngyWsK8pFeewkYzxJbqTI-AaalA&oe=6AF9DA7E"}, {"file_name": "meta-store-nordpass-screenshorts-2560x1440-5.png", "id": "984827053939202", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819375_984827057272535_3161080848428972249_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4UFeS3VAK9UQ7kNvwGDG9ks&_nc_oc=AdqAmmZUDIGnHY6cw68b0HiWLYoIjKEVliclt5273Rmd1bjs5pV9ewLaLmlcBZUyWZo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi394MnjtSNBHHDipD5XtHTszxttLDBTMQupnqvlUPAw&oe=6AF9C2DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NordPass Password Manager", "keywords": ["password", "passwords", "passkey", "autofill", "vault"], "long_description": "Stop wasting time on typing passwords. Stop reusing them. Stop trying to guess which ones are safe.\n\nNordPass keeps your access smooth and your security tight.\n\n**Log in without friction with autofill**\n\nSave your passwords once. NordPass autofills them across apps and websites, so you don\u2019t have to type the credentials every time.\n\n**Find and fix weak passwords with Password Health**\n\nMost accounts fail because of reused or simple passwords. NordPass scans your vault and shows which ones are weak, reused, or outdated \u2014 then helps you replace them with stronger ones.\n\n**Catch leaks early with Data Breach Scanner**\n\nIf your email or passwords appear in a breach, you\u2019ll get alerted. You can act early instead of finding out after an account is taken over.\n\n**Keep everything locked with XChaCha20 encryption**\n\nYour data is encrypted before it leaves your device, so no one else \u2014 not even NordPass \u2014 can access it. NordPass uses XChaCha20 for stronger protection and better performance.\n\n**Secure more than passwords**\n\nSecurely store credit cards, personal details, and important notes in one place and share that sensitive data safely when needed.\n\n**Use it anywhere with cross-device sync**\n\nYour vault is synced across devices, so your logins, payment cards, personal data, and secure notes are always available when you need them.\n\nNordPass focuses on what matters: faster access, fewer weak passwords, and early warnings before problems escalate.\n", "short_description": "Store your passwords in one place and stay ahead of problems most people miss. NordPass saves and autofills your logins, shows which passwords put your accounts at risk, and alerts you if your data appears in a breach \u2014 so you can fix issues before they turn into account takeovers. Built by Nord Security, the team behind NordVPN."}]}, "developer_name": null, "developer_privacy_policy_url": "https://my.nordaccount.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NordPass", "support_website_url": null, "website_url": "https://nordpass.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TRACKED_KEYBOARD", "OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26180186
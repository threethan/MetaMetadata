d=6e7a0a&_nc_ohc=4UFeS3VAK9UQ7kNvwGDG9ks&_nc_oc=AdqAmmZUDIGnHY6cw68b0HiWLYoIjKEVliclt5273Rmd1bjs5pV9ewLaLmlcBZUyWZo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi394MnjtSNBHHDipD5XtHTszxttLDBTMQupnqvlUPAw&oe=6AF9C2DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NordPass Password Manager", "keywords": ["password", "passwords", "passkey", "autofill", "vault"], "long_description": "Stop wasting time on typing passwords. Stop reusing them. Stop trying to guess which ones are safe.\n\nNordPass keeps your access smooth and your security tight.\n\n**Log in without friction with autofill**\n\nSave your passwords once. NordPass autofills them across apps and websites, so you don\u2019t have to type the credentials every time.\n\n**Find and fix weak passwords with Password Health**\n\nMost accounts fail because of reused or simple passwords. NordPass scans your vault and shows which ones are weak, reused, or outdated \u2014 then helps you replace them with stronger ones.\n\n**Catch leaks early with Data Breach Scanner**\n\nIf your email or passwords appear in a breach, you\u2019ll get alerted. You can act early instead of finding out after an account is taken over.\n\n**Keep everything locked with XChaCha20 encryption**\n\nYour data is encrypted before it leaves your device, so no one else \u2014 not even NordPass \u2014 can access it. NordPass uses XChaCha20 for stronger protection and better performance.\n\n**Secure more than passwords**\n\nSecurely store credit cards, personal details, and important notes in one place and share that sensitive data safely when needed.\n\n**Use it anywhere with cross-device sync**\n\nYour vault is synced across devices, so your logins, payment cards, personal data, and secure notes are always available when you need them.\n\nNordPass focuses on what matters: faster access, fewer weak passwords, and early warnings before problems escalate.\n", "short_description": "Store your passwords in one place and stay ahead of problems most people miss. NordPass saves and autofills your logins, shows which passwords put your accounts at risk, and alerts you if your data appears in a breach \u2014 so you can fix issues before they turn into account takeovers. Built by Nord Security, the team behind NordVPN."}]}, "developer_name": null, "developer_privacy_policy_url": "https://my.nordaccount.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "NordPass", "support_website_url": null, "website_url": "https://nordpass.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TRACKED_KEYBOARD", "OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26180186071622809"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2305807893283848"}]}, "baseline_offer": {"id": "2305807893283848"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780563060, "status": "PUBLISHED", "id": "2305807893283848"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27878713658436700", "version": "5.15.5"}, "id": "26079816108377018", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename":
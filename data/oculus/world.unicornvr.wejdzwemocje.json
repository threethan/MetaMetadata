ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0FOXU-sofgQ7kNvwGQwEnQ&_nc_oc=AdrHG_kNFrlRw0NOuR-1mDtgJxJ03X-GkWlB4O1cSpVhSi3LtqvMGvDdyVWZjtf_Fq4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPW5es_VnqCi9n0MY9Tu4dqm2Q3WcEBLYV_GF_kobpBg&oe=6A5F832E"}]}, "id": "2496915647312084", "locale": "pl_PL", "screenshots": [{"file_name": "image_001_0002.png", "id": "2361950064203833", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391822_2361950067537166_985318004217444264_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeGwrcl2lqgQ7kNvwFp7fU9&_nc_oc=AdrVjduJxG38SNCEBqAeaqWxAVdUyDJBcZH3qezFSw5uoPyF1Cw_zgwc_tEbCa4nGsk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD50V7yajxigopi-kUs3OkQIJicvdT7i8XoxKNWGmyf2g&oe=6A5F7F78"}, {"file_name": "image_003_0000.png", "id": "972286471513326", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391798_972286474846659_8867345942380752028_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j0IWYw6l9-sQ7kNvwEzNHqW&_nc_oc=AdooroKANJ4YkssUoQt6RUJU95XoM5wV_ws4JrbY-SEnpymKiq0SKfQLADDt5M7u-Js&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC1nq3WbgVLB4Axsge9JkPddg0MqlYT9j9rDWQM0YiKA&oe=6A5F5B3B"}, {"file_name": "image_004_0715.png", "id": "1477091096742204", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391859_1477091100075537_4580701442176205306_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5lYVi7d2yEQ7kNvwF0Efxm&_nc_oc=AdpJ4cDqlzSk8AgODRmTYsMtsKkTJoSpsker3iT-LHSIT-KeW6-mfrmSaDW8ufXXG-I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHtkSVVxGCXFYMZKXUwc4kuGZPQLG2mrvZZCnKFwKJFQ&oe=6A5F7690"}, {"file_name": "image_005_0000.png", "id": "924620303166415", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391784_924620306499748_4922722424684428420_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQlaHb8cCtoQ7kNvwGEl1Vi&_nc_oc=Adr1DaayygP5JKBadqJK-kU33uctJhVEawmqKPHW2ANy-_71QDeHB9iWZz1BwU1yIJ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARzz9AkwmKQ3U7BqNax7m84DyJUlj_pXK4IKEK-LXxZQ&oe=6A5F625D"}, {"file_name": "image_006_0761.png", "id": "1154797739384035", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393649_1154797746050701_2978200627084714095_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiuHYc449sgQ7kNvwFbauhN&_nc_oc=AdpLDAX1qHkHOBELzUYfxDzvq4awnedABOWKpGmmbV-UzXBrCO3cDWReTlj8Q3M558c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDew63jfdKEILrFYcM_SvXAceryV6RnKiHhgeuLtQiEWA&oe=6A5F6A00"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wejd\u017a w Emocje", "keywords": [], "long_description": "Aplikacja **Wejd\u017a w Emocje** to innowacyjne narz\u0119dzie, kt\u00f3re wspiera rozw\u00f3j inteligencji emocjonalnej poprzez immersyjne do\u015bwiadczenia. Sk\u0142ada si\u0119 z kilku kluczowych modu\u0142\u00f3w, kt\u00f3re wsp\u00f3lnie pomagaj\u0105 u\u017cytkownikom lepiej rozpoznawa\u0107, rozumie\u0107 i regulowa\u0107 emocje. Ka\u017cdy z element\u00f3w aplikacji odgrywa istotn\u0105 rol\u0119 w procesie nauki i treningu emocjonalnego.\n\n## Kluczowe elementy aplikacji:\n##\n1. **Animacje**  \nS\u0105 wprowadzeniem u\u017cytkownika w \u015bwiat emocji. Wizualizacje pomagaj\u0105 lepiej zrozumie\u0107 mechanizmy dzia\u0142ania emocji, ich wp\u0142yw na my\u015blenie i zachowanie. Dzi\u0119ki realistycznym scenom u\u017cytkownik mo\u017ce obserwowa\u0107 r\u00f3\u017cne sytuacje spo\u0142eczne, analizowa\u0107 emocje postaci i uczy\u0107 si\u0119, jak odpowiednio na nie reagowa\u0107.\n##\n2. **Scena relaksacji**  \nJest fundamentem przygotowuj\u0105cym u\u017cytkownika do dalszej pracy nad emocjami. Tworzy spokojne, immersyjne \u015brodowisko, w kt\u00f3rym mo\u017cna skoncentrowa\u0107 si\u0119 na oddechu, odpr\u0119\u017cy\u0107 umys\u0142 i zmniejszy\u0107 poziom stresu.\n##\n3. **Trening uwa\u017cno\u015bci, koncentracji i szybko\u015bci reakcji**  \nPomaga u\u017cytkownikom w zwi\u0119kszeniu uwa\u017cno\u015bci, koncentracji szybko\u015bci reakcji. Regularne \u0107wiczenia poprawiaj\u0105 zdolno\u015b\u0107 do radzenia sobie w dynamicznych sytuacjach.\n##\n4. **Gra**  \nDoskona\u0142e \u0107wiczenie uwa\u017cno\u015bci i spostrzegawczo\u015bci. Zadaniem jest zapami\u0119ta\u0107 jak najwi\u0119cej charakterystycznych element\u00f3w przestrzeni, a nast\u0119pnie poprawnie odpowiedzie\u0107 na pytania formu\u0142owane przez terapeut\u0119 np. Ile kaczek p\u0142ywa w stawie? Gra zawiera kilka poziom\u00f3w, r\u00f3\u017cni\u0105cych si\u0119: ilo\u015bci\u0105 element\u00f3w oraz zwi\u0119kszon\u0105 ilo\u015bci\u0105 bod\u017ac\u00f3w d\u017awi\u0119kowych i ruchowych.", "short_description": "Aplikacja Wejd\u017a w Emocje to innowacyjne narz\u0119dzie wspomagaj\u0105ce nauk\u0119 rozpoznawania i nazywania emocji poprzez wirtualn\u0105 rzeczywisto\u015b\u0107. Tworzy immersyjne \u015brodowisko, kt\u00f3re pomaga u\u017cytkownikom do\u015bwiadczy\u0107 i zrozumie\u0107 emocje w kontrolowany, bezpieczny spos\u00f3b. Aplikacja zawiera animacje do analizy emocji, \u0107wiczenia relaksacyjne oraz trening uwa\u017cno\u015bci, co sprzyja rozwijaniu pami\u0119ci, koncentracji, uwa\u017cno\u015bci i samo\u015bwiadomo\u015bci."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wejdzwemocje.pl/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Justyna Bogus\u0142aw oraz Magdalena Benedyk", "support_website_url": null, "website_url": "https://www.wejdzwemocje.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
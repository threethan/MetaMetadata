_name": "meta screen4.png", "id": "1191771062298931", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391901_1191771065632264_6521127702624501965_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKPaRTAAP48Q7kNvwGERa2n&_nc_oc=AdqsFzG9cokH_Qrih9so5Td6N_SUlKv_aP-oRDCVMkL2tHgJj3iY4v-cyDtyvbNVJ1U&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ERdjHbOg5ZCo_c9FMDOf06FMpl-UhcsMYnxWFe3ZQMg&oe=6A1063E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMNAILmeta.png", "id": "1366843524351986", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391883_1366843527685319_8844536611129946370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rr36SSPsyyAQ7kNvwEfp2k3&_nc_oc=AdrUjjPIOpawQMU56AYK20o3Jexvq8iSUEgQYeGUTAmwivfSHOijDQRmCVQk5-ofoUI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RPOdFVWYuzYinMuEYfZDqSrewnYdTH5Q_PHTv2FpXVg&oe=6A106A99"}, "display_name": "Paranormal Mayhem", "keywords": [], "long_description": "Enter a haunted battleground of chaos in Paranormal Mayhem,\na 3v1 multiplayer VR experience where three interdimensional explorers invade eerie mansions, searching for hidden crystals\u2014while one player becomes the Overlord, a vengeful demon determined to stop them. Armed with guns, the team must work together to locate the crystal and escape before the Overlord\u2019s zombies overwhelm them.\n\nAs the overlord, you control the chaos\u2014locking doors, summoning zombie hordes, and setting up ambushes to terrorize the intruders. But once they grab the crystal, your powers surge, and the final chase begins. Will you outsmart the Overlord and escape, or will the haunted house become your grave?\n", "short_description": "Hunt, survive, or terrorize your friends in Paranormal Mayhem, a chaotic 3v1 multiplayer VR shooter where three interdimensional travelers raid haunted houses while one player controls the demonic Overlord, setting traps and unleashing terror. \n"}]}, "devel
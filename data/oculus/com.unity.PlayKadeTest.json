f&oh=00_AQS4LPaNc2QrJWyhFZzLl92Bm77iaSWBfBgNzqmCZGuQ0w&oe=6B05C5C1"}, {"file_name": "meta screen4.png", "id": "1191771062298931", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391901_1191771065632264_6521127702624501965_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msFwo63YTG0Q7kNvwGjp2jA&_nc_oc=AdoFb7OhZHn1kR4sOQkVxnCtdPUIqgHmKE8EexhEzkskf2_NbGqP6aWgHxUL4Pup2q4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmBQkuGxJ-kE0L-827jE-K_Q1bX0HMCkSXwFRbXMe61A&oe=6B05D324"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMNAILmeta.png", "id": "1366843524351986", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391883_1366843527685319_8844536611129946370_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZP-IZWFrgIEQ7kNvwEL3mZT&_nc_oc=Adqif2WznIdabLyPXpAnnLlm9wC1QdrP4YKNJLdtM3cRgB1WRyc57Ss06DBSszhVw4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrRS1ZgrHkjvHuxaCx-SCUbXCdQxZwMDFtYDf7Bju9ZQ&oe=6B05A199"}, "display_name": "Paranormal Mayhem", "keywords": [], "long_description": "Enter a haunted battleground of chaos in Paranormal Mayhem,\na 3v1 multiplayer VR experience where three interdimensional explorers invade eerie mansions, searching for hidden crystals\u2014while one player becomes the Overlord, a vengeful demon determined to stop them. Armed with guns, the team must work together to locate the crystal and escape before the Overlord\u2019s zombies overwhelm them.\n\nAs the overlord, you control the chaos\u2014locking doors, summoning zombie hordes, and setting up ambushes to terrorize the intruders. But once they grab the crystal, your powers surge, and the final chase begins. Will you outsmart the Overlord and escape, or will the haunted house become your grave?\n", "short_description": "Hunt, survive, or terrorize your friends in Paranormal Mayhem, a chaotic 3v1 multiplayer VR shooter where three interdimensional travelers raid haunted houses while one player controls the demonic Overlord, setting traps and unleashing terror. \n"}]}, "developer_name": "Boombox SLU", "developer_privacy_policy_url": "https://boomboxco.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "http://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8624551957580910"}}]}, "scheduled_offers": {"count": 16, "nodes": [{"status": "PUBLISHED", "id": "4179007202316331"}, {"status": "PUBLISHED", "id": "1481854540087296"}, {"status": "PUBLISHED", "id": "2403234700132572"}, {"status": "PUBLISHED", "id": "712323478184117"}, {"status": "PUBLISHED", "id": "1072336594712178"}, {"status": "PUBLISHED", "id": "1773069380004457"}, {"status": "PUBLISHED", "id": "1303396311415967"}, {"status": "PUBLISHED", "id": "1252998153152405"}, {"status": "PUBLISHED", "id": "1643926073138229"}, {"status": "PENDING", "id": "1073561634674760"}, {"status": "PENDING", "id": "713229944713919"}, {"status": "PUBLISHED", "id": "1212335517057181"}, {"status": "PUBLISHED", "id": "2026887508192594"}, {"status": "PUBLISHED", "id": "1180845323537855"}, {"status": "PUBLISHED", "id": "4020880564823501"}, {"status": "PUBLISHED", "id": "1165782958237051"}]}, "b
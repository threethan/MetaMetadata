_name": "meta screen4.png", "id": "1191771062298931", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391901_1191771065632264_6521127702624501965_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BmWQZNzFf7kQ7kNvwFMHG8c&_nc_oc=Adr2tJNkWCTM_1LvzCAGQQnxfsX6nkHicJggU2tyNPWO-saIu0mHc8sm2cgUCuj39U4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rvzl2Z4vCoWXqpBVceM_Mo21ZFCH9lSGYGuk-YLIuVg&oe=6A01E364"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMNAILmeta.png", "id": "1366843524351986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391883_1366843527685319_8844536611129946370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH90Qu9YvOAQ7kNvwFBJQIR&_nc_oc=Adp5AbTDri3YZK9IPnuRXIJtPZVrcYJ373KwNDIRLD9J6FJaONI77DNF3R8wmN8tgaY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wl0G1kxtVbKGOxF-Me5kSRgJFJS05DFz9soY_ahdD7A&oe=6A01EA19"}, "display_name": "Paranormal Mayhem", "keywords": [], "long_description": "Enter a haunted battleground of chaos in Paranormal Mayhem,\na 3v1 multiplayer VR experience where three interdimensional explorers invade eerie mansions, searching for hidden crystals\u2014while one player becomes the Overlord, a vengeful demon determined to stop them. Armed with guns, the team must work together to locate the crystal and escape before the Overlord\u2019s zombies overwhelm them.\n\nAs the overlord, you control the chaos\u2014locking doors, summoning zombie hordes, and setting up ambushes to terrorize the intruders. But once they grab the crystal, your powers surge, and the final chase begins. Will you outsmart the Overlord and escape, or will the haunted house become your grave?\n", "short_description": "Hunt, survive, or terrorize your friends in Paranormal Mayhem, a chaotic 3v1 multiplayer VR shooter where three interdimensional travelers raid haunted houses while one player controls the demonic Overlord, setting traps and unleashing terror. \n"}]}, "devel
_name": "meta screen4.png", "id": "1191771062298931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391901_1191771065632264_6521127702624501965_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHJywEKtPWAQ7kNvwErO_Qt&_nc_oc=AdovAnAKUc096-GYLIzejKuGEBsuoy96rqPq-mTWUGVjk4HLGkxT41bzoqH-S4QHj30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S7g4EHYo9_5kIP1WMqt0g-nepEHe3SmTx0yIKrdJc4A&oe=69E390E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMNAILmeta.png", "id": "1366843524351986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_1366843527685319_8844536611129946370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jxVDd-7h6B8Q7kNvwES6WUQ&_nc_oc=AdpFq-2jZxN_IrOVJOeIVUSZllTVqR6HdbTv6qbuw8k3_Ly_dA6IRBXAE_a5ENMQzI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sN0SlAWm6XN-J5Kf6fxZkkKvoPCdDf_YMCpvnYaaSXg&oe=69E39799"}, "display_name": "Paranormal Mayhem", "keywords": [], "long_description": "Enter a haunted battleground of chaos in Paranormal Mayhem,\na 3v1 multiplayer VR experience where three interdimensional explorers invade eerie mansions, searching for hidden crystals\u2014while one player becomes the Overlord, a vengeful demon determined to stop them. Armed with guns, the team must work together to locate the crystal and escape before the Overlord\u2019s zombies overwhelm them.\n\nAs the overlord, you control the chaos\u2014locking doors, summoning zombie hordes, and setting up ambushes to terrorize the intruders. But once they grab the crystal, your powers surge, and the final chase begins. Will you outsmart the Overlord and escape, or will the haunted house become your grave?\n", "short_description": "Hunt, survive, or terrorize your friends in Paranormal Mayhem, a chaotic 3v1 multiplayer VR shooter where three interdimensional travelers raid haunted houses while one player controls the demonic Overlord, setting traps and unleashing terror. \n"}]}, "devel
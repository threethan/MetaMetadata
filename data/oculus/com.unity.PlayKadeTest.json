_name": "meta screen4.png", "id": "1191771062298931", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391901_1191771065632264_6521127702624501965_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4MOhe5gn-sQ7kNvwHhkN9W&_nc_oc=Adq8YbiqDTCeFpAmoPRg_2CD4hVpbsSI1SnbeM70AaRRax_3dsjOg1Spel5IXW7V7TE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TsNOlO1A2z0rXkdrb-p2QR3it2kyc7JtPmMfiPq8FPA&oe=6A2035E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMNAILmeta.png", "id": "1366843524351986", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391883_1366843527685319_8844536611129946370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4BMJIWRSQQIQ7kNvwH1UGqR&_nc_oc=AdqnVEcY7SP4CCuThcGXXMRItuOR-bQfbUY4UjKl4wVbcsg4Uu1SDXYcguiCvbbUfX4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nXWGLMdQEPk0NDgHRYQ8DWgk18AYuUYARDL3cPGVn_w&oe=6A203C99"}, "display_name": "Paranormal Mayhem", "keywords": [], "long_description": "Enter a haunted battleground of chaos in Paranormal Mayhem,\na 3v1 multiplayer VR experience where three interdimensional explorers invade eerie mansions, searching for hidden crystals\u2014while one player becomes the Overlord, a vengeful demon determined to stop them. Armed with guns, the team must work together to locate the crystal and escape before the Overlord\u2019s zombies overwhelm them.\n\nAs the overlord, you control the chaos\u2014locking doors, summoning zombie hordes, and setting up ambushes to terrorize the intruders. But once they grab the crystal, your powers surge, and the final chase begins. Will you outsmart the Overlord and escape, or will the haunted house become your grave?\n", "short_description": "Hunt, survive, or terrorize your friends in Paranormal Mayhem, a chaotic 3v1 multiplayer VR shooter where three interdimensional travelers raid haunted houses while one player controls the demonic Overlord, setting traps and unleashing terror. \n"}]}, "devel
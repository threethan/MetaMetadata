_name": "meta screen4.png", "id": "1191771062298931", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391901_1191771065632264_6521127702624501965_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAcbsx4iifUQ7kNvwFz4rIf&_nc_oc=AdogcvNuI6dxA4SBBSf6ilZVa16PlPl0BsImSGaruV3Z1xb4TFjKXH3dMYt7btwz8r8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3zZoa4a4d8SVx1baV-Yl7DIMekeXo-186XUfLlugblXQ&oe=69F75764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMNAILmeta.png", "id": "1366843524351986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_1366843527685319_8844536611129946370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3O9wVJ5UvQQ7kNvwF81z-B&_nc_oc=AdqfLAF2N-Aj7QQqn2bdydeK3dc2-dYRqdRTOyuGVPkKEe1ohd1H1iRfx0_QgarPdMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LhS1UYM9k5DLOmrMJoHU0oJIcU58sGGm4GnLs4S6RXw&oe=69F75E19"}, "display_name": "Paranormal Mayhem", "keywords": [], "long_description": "Enter a haunted battleground of chaos in Paranormal Mayhem,\na 3v1 multiplayer VR experience where three interdimensional explorers invade eerie mansions, searching for hidden crystals\u2014while one player becomes the Overlord, a vengeful demon determined to stop them. Armed with guns, the team must work together to locate the crystal and escape before the Overlord\u2019s zombies overwhelm them.\n\nAs the overlord, you control the chaos\u2014locking doors, summoning zombie hordes, and setting up ambushes to terrorize the intruders. But once they grab the crystal, your powers surge, and the final chase begins. Will you outsmart the Overlord and escape, or will the haunted house become your grave?\n", "short_description": "Hunt, survive, or terrorize your friends in Paranormal Mayhem, a chaotic 3v1 multiplayer VR shooter where three interdimensional travelers raid haunted houses while one player controls the demonic Overlord, setting traps and unleashing terror. \n"}]}, "devel
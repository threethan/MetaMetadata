771-25/499308208_1072231174884587_5518215482381252384_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNSFsqbwt2YQ7kNvwFCNwtY&_nc_oc=Adrq6nFmOhiMP7pfxze7tRuqjNvcH-DOrtzbel71fBjwUgqFcyXcEP7pZmutmrnB-vI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ySiAO-_ZDDa_6CIH7UAV69ByULPvXNTni4s4dyvfBzQ&oe=6A26C5DE"}, {"file_name": "com.unity.PlayKadeTest-20250709-030617(1).png", "id": "757228220195762", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499308204_757228223529095_557235652477410747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN2MToc0eNoQ7kNvwEbC8wB&_nc_oc=AdrHxS7TciFx0fvbtbIWlsaBEXEyQBmXSKjYLz5rYI_dJiSRCpdkBPTG64IqmwnMwxs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H6e2GpwTY7kqsKcwVz_WPjlLfwSH-uaeMeXk6RF4F0g&oe=6A26D4F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMNAILmeta.png", "id": "1366843524351986", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473391883_1366843527685319_8844536611129946370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nC24ZWTl82kQ7kNvwE8Ah2u&_nc_oc=AdrjyMbipTA82qghDNHSp3Vtj5nqJzz7ObaOXSQLxl2BuOIVhSev7c0worfE17j-Mfw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zfp3G0E0_1E6NsJE5l1t8shRYcK0dCXIv_99nYG2ifg&oe=6A26D419"}, "display_name": "Paranormal Mayhem", "keywords": [], "long_description": "Enter a haunted battleground of chaos in Paranormal Mayhem,\na 3v1 multiplayer VR experience where three interdimensional explorers invade eerie mansions, searching for hidden crystals\u2014while one player becomes the Overlord, a vengeful demon determined to stop them. Armed with guns, the team must work together to locate the crystal and escape before the Overlord\u2019s zombies overwhelm them.\n\nAs the overlord, you control the chaos\u2014locking doors, summoning zombie hordes, and setting up ambushes to terrorize the intruders. But once they grab the crystal, your powers surge, and the final chase begins. Will you outsmart the Overlord and escape, or will the haunted house become your grave?\n\nJoin our Discord server in order to connect and play with others!\nhttps://discord.gg/4DqaSPcSM9\n", "short_description": "Hunt, survive, or terrorize your friends in Paranormal Mayhem, a chaotic 3v1 multiplayer VR shooter where three interdimensional travelers raid haunted houses while one player controls the demonic Overlord, setting traps and unleashing terror. \n"}]}, "developer_name": "Boombox SLU", "developer_privacy_policy_url": "https://boomboxco.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "http://www.globissinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24626104116999105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393620_2118028431950617_2728773331394255832_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1XDskNkI2gQ7kNvwGiO1Li&_nc_oc=AdpWOktrc_wljDpelEU2KPubqT92kfGM2FjMnOlbkkinbeqCcCSLguPDMAQYh5XTNfw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HS7D91y5lTUbB9N3iZViBjEZbZdFmBISngSICFN2sxg&oe=6A26D4D9"}, "is_concept": false, "is_test": false, "is_trial_offe
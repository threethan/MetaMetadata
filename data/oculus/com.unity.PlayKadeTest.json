NvwGc6SIT&_nc_oc=AdlouJvF76stY_Kg1GRhdOE5JKL6jiZ5D70i9usbW6AToDd2VGuPiiohYfaw4M6qZ1A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftMU6Cw6iULYHajpKHjf-AXsI7-61hYD9h68-3nbx4JRw&oe=699B06DE"}, {"file_name": "com.unity.PlayKadeTest-20250709-030617(1).png", "id": "757228220195762", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308204_757228223529095_557235652477410747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ou2JWLMTAasQ7kNvwGmP9C7&_nc_oc=Adm_9Uk0y6J2zqYhVaHA4WLTlyJCbT5JkwKuTDUNHc0BX3tnmzGlan7f3WWSmyIhPl8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsl6HC19dBMqP-mPad_AtRzySc-pLjV6gARU5Y3VGI58g&oe=699B15F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMNAILmeta.png", "id": "1366843524351986", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1366843527685319_8844536611129946370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PE1gqIr9g1gQ7kNvwHh7DYa&_nc_oc=AdkfxuVuxd6UuEVN0FD5gWeH1eFXRcti0arwKlBuy5NLAsdnZVlp0ITQkyRi-QeoIfI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftkpJIxgXQ-fj0DXol5Wrsuhb69RxTak9fg3ShNswqREQ&oe=699B1519"}, "display_name": "Paranormal Mayhem", "keywords": [], "long_description": "Enter a haunted battleground of chaos in Paranormal Mayhem,\na 3v1 multiplayer VR experience where three interdimensional explorers invade eerie mansions, searching for hidden crystals\u2014while one player becomes the Overlord, a vengeful demon determined to stop them. Armed with guns, the team must work together to locate the crystal and escape before the Overlord\u2019s zombies overwhelm them.\n\nAs the overlord, you control the chaos\u2014locking doors, summoning zombie hordes, and setting up ambushes to terrorize the intruders. But once they grab the crystal, your powers surge, and the final chase begins. Will you outsmart the Overlord and escape, or will the haunted house become your grave?\n\nJoin our Discord server in order to connect and play with others!\nhttps://discord.gg/4DqaSPcSM9\n", "short_description": "Hunt, survive, or terrorize your friends in Paranormal Mayhem, a chaotic 3v1 multiplayer VR shooter where three interdimensional travelers raid haunted houses while one player controls the demonic Overlord, setting traps and unleashing terror. \n"}]}, "developer_name": "Boombox SLU", "developer_privacy_policy_url": "https://boomboxco.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "http://www.globissinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24626104116999105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393620_2118028431950617_2728773331394255832_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWvDHyTjNW0Q7kNvwFcOac3&_nc_oc=AdlSM-pL3hPraKRKmHOGG-I0MdsCALPfEJev1bu_UGapTYFQQcMDoR1TJ_UPXPmy-Qk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmJF7bSRW_iVoDvrz0XPbNwmuVD7ysAlrovf5J4Fpa_g&oe=699B15D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Paranormal Mayhem", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_t
NvwG28ptw&_nc_oc=AdlBLdRCmxNL2YBOUHne_T4Ocrfj-EoRy07JlAKDCNOqir38lz63RkFLk4bz-RIZkbI&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfuQyOLjMIR1578vKUNktDtR8DKRcKfbQg7FzT7QTr5_Lg&oe=69A19E5E"}, {"file_name": "com.unity.PlayKadeTest-20250709-030617(1).png", "id": "757228220195762", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499308204_757228223529095_557235652477410747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBDrm9hrqk4Q7kNvwGLlTsN&_nc_oc=AdmPE54uZ2WxGgQMisPHi9OJ-JKc_UU8P-b9ogVMF522ppcp3Wh81TFo-yZlrVXdyUo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsiG7O7VaBO1Z3ybI70pRRyWs8ufWBOPDWRg6K3ao0wLQ&oe=69A17534"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMNAILmeta.png", "id": "1366843524351986", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/473391883_1366843527685319_8844536611129946370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8kKVfKwPnEQ7kNvwFvHOgo&_nc_oc=AdlaGtaPTEs4ZV54u0CZqH7qHknadmmQLUu5BIfnq4GaUoN_pesbSsR8FaROC--Srys&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftI2zmPthEJWr1_3EqjvSZAdYf3j1XWCrAEGtnNgKjHXw&oe=69A1AC99"}, "display_name": "Paranormal Mayhem", "keywords": [], "long_description": "Enter a haunted battleground of chaos in Paranormal Mayhem,\na 3v1 multiplayer VR experience where three interdimensional explorers invade eerie mansions, searching for hidden crystals\u2014while one player becomes the Overlord, a vengeful demon determined to stop them. Armed with guns, the team must work together to locate the crystal and escape before the Overlord\u2019s zombies overwhelm them.\n\nAs the overlord, you control the chaos\u2014locking doors, summoning zombie hordes, and setting up ambushes to terrorize the intruders. But once they grab the crystal, your powers surge, and the final chase begins. Will you outsmart the Overlord and escape, or will the haunted house become your grave?\n\nJoin our Discord server in order to connect and play with others!\nhttps://discord.gg/4DqaSPcSM9\n", "short_description": "Hunt, survive, or terrorize your friends in Paranormal Mayhem, a chaotic 3v1 multiplayer VR shooter where three interdimensional travelers raid haunted houses while one player controls the demonic Overlord, setting traps and unleashing terror. \n"}]}, "developer_name": "Boombox SLU", "developer_privacy_policy_url": "https://boomboxco.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "http://www.globissinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24626104116999105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/473393620_2118028431950617_2728773331394255832_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sW12TDt1KgQ7kNvwE32fTS&_nc_oc=AdkvATW10hOu9ZRev32UcO40P1x1u7kob-rgxALZe0z41DMrY5pMD4glsZE4qghw14U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftpPHLKxaSH1K8UTyDGk6Y9p4MIuCjep2rQvkKuaG87DQ&oe=69A17519"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Paranormal Mayhem", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_t
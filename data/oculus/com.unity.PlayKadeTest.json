18215482381252384_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9D6sn3vxbF4Q7kNvwEVJqCJ&_nc_oc=AdmhBark34MVociC96T9wxhTuVJGqQUve5f1qFObRG5Kfk_zXBQJM17eae6hzjdgXSc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzbLxT-TGBWTZx65ipGstTD0-dE-OPDR0YZsNpMkFRffg&oe=69B564DE"}, {"file_name": "com.unity.PlayKadeTest-20250709-030617(1).png", "id": "757228220195762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308204_757228223529095_557235652477410747_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cYDGEGprA_IQ7kNvwGsuVJk&_nc_oc=AdmPXREzm9tZntf6YnIX72yIrjnKS7sjQ5C_E1SBaivVRDhzf0TVTraDcuZKHf3ugeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyX_B57vmRd_I0B6b-KIkr4olun1IoLk8wfWpruvKE16g&oe=69B53BB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMNAILmeta.png", "id": "1366843524351986", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391883_1366843527685319_8844536611129946370_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q7jNj9MyP3YQ7kNvwFt53tI&_nc_oc=Adm_EhbtQO1VhskW0U3mxlpKfg0wHEoYPoxSO6x2Ddnqo3XmIblZPqzBhHByHVfZHJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmqgYGCoGeT8q0biSNko-1Rxss9IukYiK4CQj4svl2bg&oe=69B57319"}, "display_name": "Paranormal Mayhem", "keywords": [], "long_description": "Enter a haunted battleground of chaos in Paranormal Mayhem,\na 3v1 multiplayer VR experience where three interdimensional explorers invade eerie mansions, searching for hidden crystals\u2014while one player becomes the Overlord, a vengeful demon determined to stop them. Armed with guns, the team must work together to locate the crystal and escape before the Overlord\u2019s zombies overwhelm them.\n\nAs the overlord, you control the chaos\u2014locking doors, summoning zombie hordes, and setting up ambushes to terrorize the intruders. But once they grab the crystal, your powers surge, and the final chase begins. Will you outsmart the Overlord and escape, or will the haunted house become your grave?\n\nJoin our Discord server in order to connect and play with others!\nhttps://discord.gg/4DqaSPcSM9\n", "short_description": "Hunt, survive, or terrorize your friends in Paranormal Mayhem, a chaotic 3v1 multiplayer VR shooter where three interdimensional travelers raid haunted houses while one player controls the demonic Overlord, setting traps and unleashing terror. \n"}]}, "developer_name": "Boombox SLU", "developer_privacy_policy_url": "https://boomboxco.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "http://www.globissinteractive.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SHOOTER", "ACTION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24626104116999105"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393620_2118028431950617_2728773331394255832_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEygbGPGq1kQ7kNvwHlMGVb&_nc_oc=Adk_dyrQHM7kH1zamBD3fy13Y8So_QpL8a63CcGEq20HXl-RWQvTQLCCZnAtH9CneZg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwvILk2sKfJZ5lEZ7yslA4L4AuV44oNYaIYmEffwVBBKQ&oe=69B53B99"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Paranormal Mayhem"
f&oh=00_AQR3IkOLs6raAE6Gh9V4BbJQB8ZmwYP0z8MJyRy9g3RmdA&oe=6AFB39C1"}, {"file_name": "meta screen4.png", "id": "1191771062298931", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391901_1191771065632264_6521127702624501965_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7Q_ysDVRC0Q7kNvwE7Rqgu&_nc_oc=AdpTHtUgmmL12YjoRPpKszqMcvVCGk9z4ZWeQinXDC9pZMiWYWdDucmxpFbzTt8vvjE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3eunXJYhmUKxxJfPYC6sGMbIazhbp2XSIWRHwREnQFQ&oe=6AFB4724"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMNAILmeta.png", "id": "1366843524351986", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391883_1366843527685319_8844536611129946370_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gtfq0gOvd28Q7kNvwFrum18&_nc_oc=AdqaHwnuaI1M_Kr6G0U6GdrVGUQbMoe6ElRpqfAsH_rOgVkD0N24A9PQrs59Ei9PpFo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsQsgMIU0GcDMzFiz-7N95rb0ozJX9NYXh-8_v7U_qMQ&oe=6AFB1599"}, "display_name": "Paranormal Mayhem", "keywords": [], "long_description": "Enter a haunted battleground of chaos in Paranormal Mayhem,\na 3v1 multiplayer VR experience where three interdimensional explorers invade eerie mansions, searching for hidden crystals\u2014while one player becomes the Overlord, a vengeful demon determined to stop them. Armed with guns, the team must work together to locate the crystal and escape before the Overlord\u2019s zombies overwhelm them.\n\nAs the overlord, you control the chaos\u2014locking doors, summoning zombie hordes, and setting up ambushes to terrorize the intruders. But once they grab the crystal, your powers surge, and the final chase begins. Will you outsmart the Overlord and escape, or will the haunted house become your grave?\n", "short_description": "Hunt, survive, or terrorize your friends in Paranormal Mayhem, a chaotic 3v1 multiplayer VR shooter where three interdimensional t
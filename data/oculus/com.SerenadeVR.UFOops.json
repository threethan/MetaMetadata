nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMDp4-ohY0MQ7kNvwGI3EF9&_nc_oc=AdoLf643o597dVKL2-u00RiU4APcYPsf7-U8fqA-tTyaHMrA-2wuBgNfuX6rqPS-ScI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSVExf9tuvrApG-NFVdzd5AW73wzyF0AGbNr2XIBG24A&oe=6B05AF10"}, {"file_name": "05_Worlds_And_Modes.png", "id": "1114119730959621", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620655_1114119734292954_2162319783485688152_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58CBhM_w3lkQ7kNvwEihSZT&_nc_oc=AdpzoDCOtGl-KWLUshwCE4lFlajFDD32VggFtjPR0rRdMAOAaMYoCHrgNlovrBidFXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_UgkUUyKgtAQ_FvRIwZyVP4nclqkuoJLHhDRcBuDsug&oe=6B05C854"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UFOops!", "keywords": [], "long_description": "Small UFO. Big trouble. Plenty of \u201coops.\u201d\nTake the pilot\u2019s seat in UFOops!, a playful VR abduction adventure where an ordinary day on Earth becomes your next collection mission. Fly over a glowing night city, explore the countryside, and use your tractor beam to scoop up unsuspecting citizens, farm animals, and even vehicles.\nYour cockpit is your home among the chaos. Work the controls, watch your onboard displays, and enjoy the strange little alien decorations that give your ship its personality. Look through the window, line up your next target, and let the trouble begin.\nPick a world. Choose your kind of chaos.\nTake on Missions for specific objectives and extra rewards, or choose Free Roam to explore at your own pace. Track down particular citizens, hunt for the right vehicle, or head out over the fields in search of wandering animals.\nKeep your beam steady.\nAbducting a person is one thing. Lifting a vehicle takes more commitment. Purchase Heavy Lift charges with your earned credits, hold your beam on the target through the countdown, and watch it rise. Break your lock too soon, and you\u2019ll need to line up another attempt.\nGet paid for causing a little extraterrestrial inconvenience.\nEarn credits from abductions and collect bigger payouts for completing tasks. Spend your earnings to unlock another world and stock up on vehicle-lifting charges before your next outing.\nInside UFOops!, you\u2019ll find:\n- Cockpit-based VR flying with hands-on controls and onboard mission displays.\n", "short_description": "We come in peace. Mostly. Pilot your own UFO, beam up unsuspecting humans, snatch vehicles, and complete mischievous missions in a playful cartoon world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://serenadevr.github.io/ufoops-site/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Serenade VR Studios", "support_website_url": null, "website_url": "https://serenadevr.github.io/ufoops-site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1787380215607476"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1001861082348876"}, {"status": "PUBLISHED", "id": "941715521953007"}, {"status": "PUBLISHED", "id": "1783706729439097"}, {"status": "PUBLISHED", "id": "1094636719990635"}, {"status": "PUBLISHED", "id": "1705903283835347"}, {"status": "PUBLISHED", "id": "1767411234541990"}, {"status": "PUB
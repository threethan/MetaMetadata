&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJI1YXLg6XgQ7kNvwH6s76f&_nc_oc=AdrKH9-SanrOYzmYD2JADwYXC8EZNHfS94DkwyngZNEbqovVwKfR9D4pbgWCdRzCN2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx4Fw51lDGICbmm1etNZZwDaUpXSJRbgalhsK8hCoO1w&oe=6AFDB791"}, {"file_name": "screenshot_4.png", "id": "978252037915565", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585799753_978252041248898_6228133640565242889_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWtNv0AH5C4Q7kNvwFQebC7&_nc_oc=AdplKGUNINUqpdSwBAg_-6V5L0BxkIHJ2mNf-D1hKId8oeuDpO4mSOVoov3k9SZPu8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJj6p03Spm4b6Vtl0baQCmhbDEB5NVn3JW-tGdOvPKMQ&oe=6AFDC62F"}, {"file_name": "screenshot_5.png", "id": "1003920916069365", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_1003920922736031_1436467718153117241_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L19uSlZxysAQ7kNvwFwEnpS&_nc_oc=AdqlUk0BC9gbBNanqzeZW0hgYsMq2hB2amXwYKtaqPwpQeSzznAv2pLakisCyU3YmL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLpLO2s3xXFPWVOQtJcV631HiiAQIMzvw8ohnTrC6Dng&oe=6AFDC0D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2576846446167207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312263_2576846449500540_1890882644815561231_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aeWd1hhg9YQ7kNvwEM1sqD&_nc_oc=Adp1hZTsX_VuBjP7IHK2sXRaIqXnq_XTy-sUCi7oMtTwkftJMsWCmaST3KoTN8zlgis&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTF9LcyRnjRCrH--lwMLy7219_xFv_r1IB38R3-yY9HmA&oe=6AFDAED7"}, "display_name": "Rescue Simulator", "keywords": ["rescue", "helicopter", "hoist", "simulation", "adventure"], "long_description": "The helicopter is in the hover. The door is open. Someone below needs you.\n\nYOU ARE THE RESCUER\nStand in the open cabin door of a modern rescue helicopter, reach out and grab the hook. Clip on, and the hoist lowers you out into the wind.\n\nWORK THE CABLE\nWinch yourself down and back up with the right stick. Call the pilot with the left stick to move the helicopter over the survivor - every metre of cable is yours to judge.\n\nSTRAP THEM ON\nReach the survivor, put the rescue strop round them and they hold on to you as you rise. The crew pulls you both in through the door and they take a seat in the cabin.\n\nTEN MISSIONS\nA climber on an Alpine ledge, a man overboard, a family on a flooded roof, sailors on a capsized yacht, rafters in a canyon, a glacier crevasse, a burning tower, a collapsed bridge, an oil rig and an erupting volcano.\n\nA REAL CREW\nThe pilot briefs you on the way in and the hoist operator talks you down on the intercom: ten metres, three metres, feet down.\n\nEARN THREE STARS\nFaster rescues earn more stars. Fly any mission again from the menu to beat your best time.\n\nSingle player. No account, no internet, no in-app purchases.", "short_description": "Ride the hoist cable out of a rescue helicopter and bring people home. Clip on in the cabin door, winch yourself down to a stranded climber, a family on a flooded roof or sailors on a capsized yacht, strap them on and reel back up - ten real hoist rescues from the Alps to an erupting volcano."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/rescuesimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/rescuesimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
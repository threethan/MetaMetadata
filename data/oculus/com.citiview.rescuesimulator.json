&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9n0yje8rbcIQ7kNvwEqU3H4&_nc_oc=AdphZxZpMOqHJ9XswjdMVw5PUWxvtHnMm8xtm0OLyOAv8_Q1bzDinNrOfa4_n9r78Og&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVy2YQJytVQvMkjWaTvYG1hfJZypSvyRLj3tM7p0LTkBA&oe=6B0F1351"}, {"file_name": "screenshot_4.png", "id": "978252037915565", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/585799753_978252041248898_6228133640565242889_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QCdXcUEsmCsQ7kNvwFWdKUl&_nc_oc=AdpLTVMoU5NFpDFLiF8Np_YMZbSYbjBBakRtddj8U8AhkOOOUM0kPRQFF9UjEQSqf14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW5wQZKynYPI5N0MwNFhauwz53TaBtjZ22awYHzzrZdIQ&oe=6B0F21EF"}, {"file_name": "screenshot_5.png", "id": "1003920916069365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831299_1003920922736031_1436467718153117241_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-1i8HL7BTIQ7kNvwFS2_Km&_nc_oc=AdqF1snJDICyGpIgUqfpS2qE1KGXkHu3hPA7vkLy4dOUrIWqo91LbbN1vZtnKtZ7N5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUUOXtTIrZaRgW-XJxuxfzdJt8fmJ3XfoE4YDbkuDGK-w&oe=6B0F1C97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2576846446167207", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499312263_2576846449500540_1890882644815561231_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itjs7GUF5XEQ7kNvwFnYu4f&_nc_oc=Ados_huGKy6ZZBrUGJ9qV30J1fJHBb38ODbzGI7yyt-lyz6uFjuIA2XyOyC2tIFIjQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9rLVExkpdHInNRxvMwG3OGu92OgZALjYPkxMianm2QA&oe=6B0F0A97"}, "display_name": "Rescue Simulator", "keywords": ["rescue", "helicopter", "hoist", "simulation", "adventure"], "long_description": "The helicopter is in the hover. The door is open. Someone below needs you.\n\nYOU ARE THE RESCUER\nStand in the open cabin door of a modern rescue helicopter, reach out and grab the hook. Clip on, and the hoist lowers you out into the wind.\n\nWORK THE CABLE\nWinch yourself down and back up with the right stick. Call the pilot with the left stick to move the helicopter over the survivor - every metre of cable is yours to judge.\n\nSTRAP THEM ON\nReach the survivor, put the rescue strop round them and they hold on to you as you rise. The crew pulls you both in through the door and they take a seat in the cabin.\n\nTEN MISSIONS\nA climber on an Alpine ledge, a man overboard, a family on a flooded roof, sailors on a capsized yacht, rafters in a canyon, a glacier crevasse, a burning tower, a collapsed bridge, an oil rig and an erupting volcano.\n\nA REAL CREW\nThe pilot briefs you on the way in and the hoist operator talks you down on the intercom: ten metres, three metres, feet down.\n\nEARN THREE STARS\nFaster rescues earn more stars. Fly any mission again from the menu to beat your best time.\n\nSingle player. No account, no internet, no in-app purchases.", "short_description": "Ride the hoist cable out of a rescue helicopter and bring people home. Clip on in the cabin door, winch yourself down to a stranded climber, a family on a flooded roof or sailors on a capsized yacht, strap them on and reel back up - ten real hoist rescues from the Alps to an erupting volcano."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/rescuesimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/rescuesimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_conn
4.5771-25/491831299_1003920922736031_1436467718153117241_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2vOkv8v97QQ7kNvwEihXWs&_nc_oc=AdpYkFJZ_F3C3lK7wON8wyW42Vr-Lg3EXBB_Kzgput7f4Ks7xjq6rTaBTFMYKOvKQA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKPm1g-dgO8M3q5K6PslZ7wXfJpG_-rXhglRYerSFTZA&oe=6AF72957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2576846446167207", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312263_2576846449500540_1890882644815561231_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viPQ390MWOsQ7kNvwHqZYt-&_nc_oc=AdrYw3bBp-tHbhG6RY37EhpZR4OTCrokaIxZ7Qs5Bx4us2XpZ6Yd7kJJsnh0cBldO40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhfFdknJ7dzlKnS0o4TOfpK3Kq78wHEJYsjvxZBcKQBw&oe=6AF71757"}, "display_name": "Rescue Simulator", "keywords": ["rescue", "helicopter", "hoist", "simulation", "adventure"], "long_description": "The helicopter is in the hover. The door is open. Someone below needs you.\n\nYOU ARE THE RESCUER\nStand in the open cabin door of a modern rescue helicopter, reach out and grab the hook. Clip on, and the hoist lowers you out into the wind.\n\nWORK THE CABLE\nWinch yourself down and back up with the right stick. Call the pilot with the left stick to move the helicopter over the survivor - every metre of cable is yours to judge.\n\nSTRAP THEM ON\nReach the survivor, put the rescue strop round them and they hold on to you as you rise. The crew pulls you both in through the door and they take a seat in the cabin.\n\nTEN MISSIONS\nA climber on an Alpine ledge, a man overboard, a family on a flooded roof, sailors on a capsized yacht, rafters in a canyon, a glacier crevasse, a burning tower, a collapsed bridge, an oil rig and an erupting volcano.\n\nA REAL CREW\nThe pilot briefs you on the way in and the hoist operator talks you down on the intercom: ten metres, three metres, feet down.\n\nEARN THREE STARS\nFaster rescues earn more stars. Fly any mission again from the menu to beat your best time.\n\nSingle player. No account, no internet, no in-app purchases.", "short_description": "Ride the hoist cable out of a rescue helicopter and bring people home. Clip on in the cabin door, winch yourself down to a stranded climber, a family on a flooded roof or sailors on a capsized yacht, strap them on and reel back up - ten real hoist rescues from the Alps to an erupting volcano."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/rescuesimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/rescuesimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374741209055748"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1424462249639488_4361309511904184143_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NOlTgUUw1kQ7kNvwHz0iqp&_nc_oc=AdqBSfxe1YmAmNC_JPvRwPmdkoOJCVP3KkzjR2uRYMjoibAYmNGYXmDljVtRMWoQOn8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTXNYJLZUnh6LleK4EII5MgVPXjoi2a0b32ED-W3IO9w&oe=6AF72E9F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_
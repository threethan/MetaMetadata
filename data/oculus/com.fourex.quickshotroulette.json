_DWbm8EaDBfY_rz9RxjcuzgzMW4lnjRsyO3OeX8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2MvA_0mm1QMhFqLozxHc-Oo9pbD_AVcxsZvj8hT9drag&oe=69F1F7D8"}, {"file_name": "deadeye_saloon_003.png", "id": "1533807587891135", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618251_1533807591224468_7225354536590570107_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jWcISiXBAdwQ7kNvwFsrKGS&_nc_oc=AdqbynyCMMVC15XJE5mJfWiLsOEzoKF9aKcBklqefK-tYJjfFRC-B_l-wCs6d5BdLnw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Dyh3G-VEjx5uS5NXyV8wh6xCiOXGmvTl3-Bd34b69nQ&oe=69F1E5DB"}, {"file_name": "deadeye_saloon_007.png", "id": "1394096562246069", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618103_1394096565579402_5327944850542890591_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WS8z7OR0i8Q7kNvwEHpDM_&_nc_oc=AdpWdfYkzp9-7HoO7fY7G1EabQ2Ln6fRVUD-3THlOqfuf1YatYHzTiOKWuR9Qx2feLE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0KJWpiLV_2dfJXxh9-u8V-SoKydiIb8szt_SjRlSsiZQ&oe=69F20CD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCover_2560x1440.png", "id": "1511443186749788", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618251_1511443190083121_6071622312822294156_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7no8XUn3K40Q7kNvwEAvHd1&_nc_oc=AdpgDfH5slKmc3h2xK7NHL-jYTbXd8jFvFNisdDhq67_zRjS7ApvGsF8mo6d-EU4u2o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1xBnLV7vsIeMFcPPb-1IqyUELgXoH7YBRMC-nwmszfbg&oe=69F1EDC2"}, "display_name": "Deadeye Saloon", "keywords": ["party"], "long_description": "# Deadeye Saloon (Beta)\n\nWelcome to **Deadeye Saloon**, a simple and playful VR showdown you can enjoy **with no controllers, no movement, and no hassle.** Just sit back, raise your hands, and let your gestures decide the duel.\nIn this saloon, victory comes from **recognizing matching card pairs.** See a pair? **Quickly form the right hand gesture** to strike first and outplay your opponent. Fast reads and fast hands win the round.\nDesigned for pure comfort, you can play **seated**, in your most relaxed spot, using only your headset and your hands.\nDeadeye Saloon is currently in **Beta**, with more rules, items, and modes on the way. Jump in now for lighthearted duels\u2014and stay tuned as the saloon grows with future updates.", "short_description": "Deadeye Saloon is a fast multiplayer VR party game built entirely on hand gestures.\nAll players draw and reveal cards simultaneously. When a matching gesture card pair appears, performing the correct gesture activates powerful abilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1siPztmxhlIPsCskr2MIo3liJmgP1yFzLwWF-qobSDSg", "developer_terms_of_service_url": null, "publisher_name": "4EX", "support_website_url": null, "website_url": "https://deadeyesaloon.myportfolio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25571721795787008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618512_737962742046784_7055242470885297303_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdJ-PsgqTmwQ7kNvwE56U3Q&_nc_oc=AdrQmVJiZsU9xXUWH0vzzsJ8b-XiCFl6tvmU-aT95_Ud-sAjcm-uZTZgEyQNDNfrxBQ&_nc_zt=3&_nc_ht=scontent-atl3-2.ocul
&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1V_NjutfSwoQ7kNvwGnMrLI&_nc_oc=AdqalXgbBSIgZ14Syy5bseif_o5BRYTJ3pyQzuOOeuJfaNI4tkeN2oABpnioj59oN8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0a-BnRqzcQiThAQJuvio_BvBJr1cE3tNwkDUVgqpkvLw&oe=69DB8E58"}, {"file_name": "deadeye_saloon_003.png", "id": "1533807587891135", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618251_1533807591224468_7225354536590570107_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXjlFEfEBDMQ7kNvwE87smP&_nc_oc=AdrnAZx5EEDRO4M9GCxzjU7VY5Rx-BPtYIhHgh7ePWoG5YRcCoAE_UZBhFafxun4cfU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2otWJNp_N1NlAGIocHs80A3NXOBdPAlKsnOJ50Wn7GvA&oe=69DB7C5B"}, {"file_name": "deadeye_saloon_007.png", "id": "1394096562246069", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618103_1394096565579402_5327944850542890591_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Bru-nJDPCcQ7kNvwHWYsHU&_nc_oc=AdqtrQa_LJRNOrxsJzFPg_v1e64xjCNeWv_5H0ss_YTVc9XgjrRSIN8Ed0rX9sgBP9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jcoxrBQCwr9z2tSFO47467gUyvB3Rwj0UrhgBbv-zNw&oe=69DBA359"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "StoreCover_2560x1440.png", "id": "1511443186749788", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618251_1511443190083121_6071622312822294156_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xgWneWnL04Q7kNvwGJWS5V&_nc_oc=AdrQHQDuC_cZ1Dqtiib7wxNunjsCZ6sZz3QsGQTtosn1SOL4NUm1p7tpE-Rgx-TM2fo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CytLV09ExjFtHfYI7u99GnJpF1dNA3E03SMzgzj0aRg&oe=69DB8442"}, "display_name": "Deadeye Saloon", "keywords": ["party"], "long_description": "# Deadeye Saloon (Beta)\n\nWelcome to **Deadeye Saloon**, a simple and playful VR showdown you can enjoy **with no controllers, no movement, and no hassle.** Just sit back, raise your hands, and let your gestures decide the duel.\nIn this saloon, victory comes from **recognizing matching card pairs.** See a pair? **Quickly form the right hand gesture** to strike first and outplay your opponent. Fast reads and fast hands win the round.\nDesigned for pure comfort, you can play **seated**, in your most relaxed spot, using only your headset and your hands.\nDeadeye Saloon is currently in **Beta**, with more rules, items, and modes on the way. Jump in now for lighthearted duels\u2014and stay tuned as the saloon grows with future updates.", "short_description": "Deadeye Saloon is a fast multiplayer VR party game built entirely on hand gestures.\nAll players draw and reveal cards simultaneously. When a matching gesture card pair appears, performing the correct gesture activates powerful abilities"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1siPztmxhlIPsCskr2MIo3liJmgP1yFzLwWF-qobSDSg", "developer_terms_of_service_url": null, "publisher_name": "4EX", "support_website_url": null, "website_url": "https://deadeyesaloon.myportfolio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25571721795787008"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618512_737962742046784_7055242470885297303_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re5AkNFW_1gQ7kNvwH
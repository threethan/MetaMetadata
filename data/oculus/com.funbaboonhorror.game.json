id": "4193216157480573", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823366_4193216160813906_6876756199772115312_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMf1MNJH-5kQ7kNvwHpkpp9&_nc_oc=AdqCp70a0eAuJu-gqFs_gvxr0-PuJj97GYFMyJRhw7u4OXRukpEmE1eATTcw0oW9qu0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQECY6EoaEA45CyZqX871l5AOsnxOAIUk_yae06Hr2AiA&oe=6AFDD6A8"}, {"file_name": "8.png", "id": "1770989660874353", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823790_1770989664207686_2647951330470737441_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kUFNYnfaDUQ7kNvwHd3sR5&_nc_oc=AdpBOiSaQ-33Z2hRzlzQ3hx1FjKHfD3jtqmhb3KUnAL-oShcV60F_Vo4i8NV_Wb4Dqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXS2CRU-s4LiYQqNIs9hWSbvj7NZRd8XQ0pa-g3fw8CA&oe=6AFDB70E"}, {"file_name": "7.png", "id": "1784096089525560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1784096092858893_694798587585038516_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElLgp8PFAVIQ7kNvwFyuhZO&_nc_oc=Ado4YNdHPiHWGUTmnsRV7kLU1694FjybADyf_VAO-PIZY-wUyEHZPqhdAfQSO2PEZ0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDHEdbXIXeq_2t7ZRvTBL59_mFL6APW5lg9adtWCArgg&oe=6AFDE13C"}, {"file_name": "5.png", "id": "1142508821552097", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828050_1142508824885430_1299244850997637524_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtskWmUiYLIQ7kNvwF-7OfP&_nc_oc=AdrR8UbVkXtXRZSJD2ljvP5KWYqhpZdJCMP2jTxhKWf_f_UWIF1Ix2jnrloIcWF-0Ow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOAgSH2R9R1JYEjBnUbDEeotB7sVnjSnqcG2Nh86NCJw&oe=6AFDDAC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape (2).png", "id": "1110575725295958", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604317775_1110575728629291_1001682290316571351_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGLiyZBA3nYQ7kNvwE0RHbw&_nc_oc=AdpVs78bGMDbYd4NMOqyZ0p0wMun4LlhgVIgZSEmIumh0tqk1K5RJm1XXUjshvAjwxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRcw0RBshEmyZGZOIDnKNG1fcfodW3jVn1oOhrOspRVg&oe=6AFDBC8C"}, "display_name": "Ripple - Don't Splash", "keywords": ["baboon", "horror", "backrooms", "ripplevr", "lethal"], "long_description": "Ripple- Don't Splash\n\nUnlimited horror. Unlimited chaos.\n\nJump into a multiplayer VR nightmare where water is unsettling, loot is tempting, and your friends are only slightly helpful. Climb, push, run, and grab valuables with your own hands. Escape the monsters and sell your loot.\n\nExplore Three Nightmares\n\nThe Poolrooms: Eerie pools, tiled corridors, and endless blue spaces. Every corner feels wrong.\n\nThe Backrooms: Endless yellow halls full of loot, dead ends, and terrifying surprises.\n\nThe House of Locust: Stay alive long enough to claim the big prize. Risk it all for the reward.\n\nSurvive With Friends\n\nMultiplayer VR with positional voice chat.\n\nHand-based movement and physical loot grabbing.\n\nValuables to collect and sell.\n\nUnlockable avatars, pets, and wild gadgets.\n\nMini-games, scares, and ridiculous moments.\n\nLove the chaotic VR horror of Lethal Ape, Be the Monster, or Slop? Ripple- Don't Splash brings its own blend of teamwork, terror, and loot-filled fun.\n\nExplore. Scavenge. Survive. Sell. Repeat.", "short_description": "Ripple- Don't Splash is a chaotic multiplayer VR horror adventure! Explore the eerie Poolrooms, endless Backrooms, and House of Locust with your friends. Grab valuables, survive monsters, escape with loot, and earn rewards. Climb, push, and run with your own hands. Talk in positional voice chat, unlock avatars, pets, and crazy gadgets, and enjoy mini-games. Love Lethal Ape, Be the Monster, or Slop? Dive into scary, hilarious chaos. Explore. Scavenge. Survive. Sell. Repeat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpvrofficial/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "https://sites.google.com/view/chimpvrofficial/home?", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpvrofficial/privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "1338887745984635"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595129854_2979380875728849_8078030767390622875_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRa21o7faQYQ7kNvwGN1pVD&_nc_oc=AdqNBpOsl6u26lqZMqw_p75s2gR8hIR3fVqweY0Vip9rlb1i1LIII51nhw3KYdREOkY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSy_or51tklCw58OCUgEDw2pOqLuki8U1u9jH3BTJ3ilA&oe=6AFDB970"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ripple - Don't Splash", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_na
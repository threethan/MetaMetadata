_oc=AdpBOiSaQ-33Z2hRzlzQ3hx1FjKHfD3jtqmhb3KUnAL-oShcV60F_Vo4i8NV_Wb4Dqs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXS2CRU-s4LiYQqNIs9hWSbvj7NZRd8XQ0pa-g3fw8CA&oe=6AFDB70E"}, {"file_name": "7.png", "id": "1784096089525560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1784096092858893_694798587585038516_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElLgp8PFAVIQ7kNvwFyuhZO&_nc_oc=Ado4YNdHPiHWGUTmnsRV7kLU1694FjybADyf_VAO-PIZY-wUyEHZPqhdAfQSO2PEZ0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDHEdbXIXeq_2t7ZRvTBL59_mFL6APW5lg9adtWCArgg&oe=6AFDE13C"}, {"file_name": "5.png", "id": "1142508821552097", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828050_1142508824885430_1299244850997637524_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtskWmUiYLIQ7kNvwF-7OfP&_nc_oc=AdrR8UbVkXtXRZSJD2ljvP5KWYqhpZdJCMP2jTxhKWf_f_UWIF1Ix2jnrloIcWF-0Ow&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOAgSH2R9R1JYEjBnUbDEeotB7sVnjSnqcG2Nh86NCJw&oe=6AFDDAC1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fun Baboon Horror", "keywords": ["baboon", "horror", "fun", "party", "backrooms"], "long_description": "# Unlimited horror. Unlimited fun.\nGet in. Grab everything. Survive. Get out rich.\n\nFun Baboon Horror is a multiplayer VR horror game where you and your friends break into places you should never enter, fill your arms with loot, and run for the exit while something decides it wants you instead.\n\n\nSome runs you come home rich. Some runs you come home with one shoe and a story.\n{1082471424328891}\n# The Backrooms: grab everything\n\nYellow hallways that never end. Rooms that all look the same. Find the valuables and carry them out alive. Drop it and it is gone. Panic and it is gone.\n\nYou are sure you came from the left. Your friend is sure you came from the right. Something is listening to the argument.\n\n# The House of Locust: survive and take the prize\n\nA different place, with its own rules and its own very bad ideas about visitors. Here you do not loot on the way past. You last long enough. Make it to the end and the reward is far bigger.\n\n# And when the running stops\n\n- Physical gadgets: flashlight, radar, camera and stranger things\n- Climb, push and jump with your own hands. No teleport.\n- Positional voice chat, so screams come from the right hallway\n- Unlock avatars and characters, then raise your own pet\n- Mini-games, darts and PvP back in the safe area\n- Take photos and post the chaos to Signal\n\nMore maps on the way.\n\n**Explore. Scavenge. Survive. Sell. Play. Panic. Repeat.**\n\nWelcome to Fun Baboon Horror\n", "short_description": "Unlimited horror. Unlimited chaos. Fun Baboon Horror drops you and your friends into the endless Backrooms to grab every valuable you can carry, then into The House of Locust, where you survive long enough to claim the big prize. Climb, push and run with your own hands. Talk in positional voice chat. Unlock avatars, pets and crazy gadgets, play mini-games, and turn every terrifying run into a funny disaster. Explore. Scavenge. Survive. Sell. Repeat."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/chimpvrofficial/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "https://sites.google.com/view/chimpvrofficial/home?", "support_website_url": null, "website_url": "https://sites.google.com/view/chimpvrofficial/privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "pla
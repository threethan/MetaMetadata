-nDPvACh7qYxzjoRWx6_qGA-pvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRttolFgzxAh8l1_CWdzTOXABHf7R3Rf5V5bB6TKFscxg&oe=6B0DC47F"}, {"file_name": "f6f713e2a9d75913aef73a45dc18cb79.png", "id": "1172479745432415", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842225_1172479748765748_6954748743363504141_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wx6_udop8T8Q7kNvwGTytu3&_nc_oc=AdqnTo1S9kfw5OjmM9TbIiI0sTLgrnlR8y-oxGDu3X27IorrWLy_VqbnvTtZsKOMP5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9px_jQ7PjblRZC2JkztxyoID9qv1DlY7FNLZa3zxlcw&oe=6B0DC07D"}, {"file_name": "79909136003faf3eae654931729d913c.png", "id": "4599674830299717", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842204_4599674833633050_5575425429638436321_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhzOk5safsoQ7kNvwE3lfri&_nc_oc=AdprtNwWTUtHzM8hJmn90j-rsErr9TMPX9-ZrX0Z_YnPzCvrPaQtyYfAdNIKY8pTvB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-qz4ybtHwLhn-DrEV4qgahgia_zIQefg04aK6DBLmyg&oe=6B0DB7B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VSS Grounding", "keywords": [], "long_description": " VSS Grounding brings the grounding sessions of the VSS Grounding app into a calm 3D space, in your own room (pass-through) or in a quiet dark room.\n\n \u2022 11 guided sessions \u2014 Alpha Calm, Theta Deep, Delta Ground, Focus Dot, Beta Focus, Snow Counter, Womb Rest, Tinnitus Relief, Rain & Alpha, Somatic Release and Somatic Movement\n \u2022 Breathing orbs, eye-movement and focus exercises rendered as soft 3D lights\n \u2022 Binaural beats, pink and brown noise and notched tinnitus sound therapy, with recorded voice guidance and optional subtitles\n \u2022 Heartbeat haptics in both controllers \u2014 in sync, alternating left and right, or following the light, depending on the session\n \u2022 Movement sessions: trace circles, H-shapes and rectangles in the air with both controllers to release neck and shoulder tension\n \u2022 Tint matrix: try 48 color tints (12 hues \u00d7 4 densities) on your surroundings, inspired by the chromatic filter (tinted lens) trials used in visual snow care, and keep the one that feels calmest\n \u2022 Short before/after check-in for visual snow, anxiety and distress\n\n Fully offline. No account, no tracking, no data leaves the headset.\n\n VSS Grounding is a wellbeing tool. It is not a medical device and does not diagnose or treat any condition. Stay seated and stop a session if you feel dizzy or uncomfortable.", "short_description": "Calm, guided grounding sessions for visual snow, anxiety, tinnitus and depersonalisation \u2014 breathing orbs, sound therapy and heartbeat haptics in your hands."}]}, "developer_name": null, "developer_privacy_policy_url": "https://visualsnow.pages.dev/privacy_grounding", "developer_terms_of_service_url": null, "publisher_name": "Entropy Vector Group", "support_website_url": null, "website_url": "https://visualsnow.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "810139357995560"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1428429253692238"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842271_29100087262993919_9005499014069258889_n.png?st
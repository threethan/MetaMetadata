n.com&_nc_ss=7f20f&oh=00_AQRZGqgaMFax5mzCAQVXmbz-uc6ITr_BpDLEC5xGMqw_bg&oe=6AF33EBD"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ingQM6m7KQkQ7kNvwFk4KTN&_nc_oc=AdoOG0zZSQDUVz8v7LJ2bOJGT6l_Pv40G7yaS3WKj2w-cLxI775NgSkFinVnn0A_YLQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw_kqSpyUyUnEIPdH6pDwoPnVhmqnUii42W1MYXSrA7g&oe=6AF32E56"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fC--YBuEY_wQ7kNvwHc2K4o&_nc_oc=Adpy5_iI-xtByfrLrsTdKkaUyN9MJe-zpJmZVldVduzTCEc4obxec43VUzZImIHNmRU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSf9xUXSoJ1mi7rcCSFZAXFgbQni12AwDg8f0kpXgXcWA&oe=6AF343DC"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgxUFY0zhHoQ7kNvwGqWywx&_nc_oc=AdpsO5yRZplL0oIbwcZLwH1YLczmIQoZ3drqEK78acOWyU0c0TIqEWaOg4zZJK2EgsU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7Y_Uus52VLL5TA3DmfYoY4FXXCpk6bKeONLS-aGfgWQ&oe=6AF33D67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162810_1854831351396912_7739590110307418112_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJaatHT5R_AQ7kNvwHEeRB6&_nc_oc=AdqTq-kQCUgTbwIYkhfVgjxoBmrWzgAq_HBOiaTvY04GqqM2QmJnGe0gRc--mZg
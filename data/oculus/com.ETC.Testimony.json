2249725808337747968_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wclC3auLi8kQ7kNvwG2mCf1&_nc_oc=AdrwkyaDkPww07AlUKC_WWoyS7vd6vSu6JmyZIalVQG8J_ZVfMj-GxHmdmZBzWyHvpE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTjdkhty385ovyqEc1scDnOt16b0jaKpyU8DaU3WR-zAg&oe=6B0B31FD"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_OkRQ5QBXrQQ7kNvwHVryBB&_nc_oc=AdouTzaHVw-P3vCWUp4DHukN3oWEVVphLdJ09jr8dcSLz44bHL0-vM6C7o6LEFMzYOE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTHZDACG4BTZ8Go-d3I11xzo63ogWpMoYY4O8dYzB-nSA&oe=6B0B2196"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpWRkrPo6mgQ7kNvwGKf4Xb&_nc_oc=AdpSpQJ1VewqWUmdt4DVn1cZBqt8sdKsTtAhkDV92nCI911SjJaj643lEl8RzO-uEnk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0yDWKN2b5Yt-qj0Jm8l6JynISwYCsJdj4j8M6VDAX_w&oe=6B0B371C"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InV9D41bOEAQ7kNvwFUJyON&_nc_oc=AdqRJEs6VboAYCaIObvhpOYlON4p4auoHU1O5yDXpqBzEbfanKH5YvFwo3sWT5ttCaA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0TZa05dRU1SU6_--1sDvuOAa3TMMJvrCsuA62XpmV5w&oe=6B0B30A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review
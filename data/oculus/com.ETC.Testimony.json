/scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgYfTmwcuigQ7kNvwFEkvOm&_nc_oc=Adqf8TZmWc0mSNell8uxIHlaj1NZORf7PUinS3QiSUq4lnsQEqXRMQwkpOR8I3A91ro&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Qx9DfFOehhoc9zkrUWHM7Bd4BXfNAxTaRX6yxp5PGWA&oe=6A3D4E67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. The Brock Turner case, Bill Cosby\u2019s sexual assaults and Bill O\u2019Reilly\u2019s harassment of women are three recent examples that have helped create the perfect storm of public outcry over sexual assault and issues around consent. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. ", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Evolving Technologies Corp", "support_website_url": null, "website_url": "http://testimonyproject.net/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfor
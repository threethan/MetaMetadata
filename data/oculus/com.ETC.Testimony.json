2249725808337747968_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4-2tIdzYC0Q7kNvwG6SaUJ&_nc_oc=AdoZA-cWYnCnZqsUHfh8P9pEjauAjIgFx3HHLeosm9xIvL5yNTrhyZlpMCQtE4PhYzk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsHefbj1SE8TXLvC5ipZHLuJCspTQTRmke3MSSpJo9ag&oe=6B0856BD"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDlQOU2ZRpUQ7kNvwF6ixw7&_nc_oc=Ado8WYBnQKVfsRXn4lr0il9F64gYA645_lACB2i8WCWWQOneTb3wFOtr-wyVbikVCI4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzsb4_QlxJ7QJo83q5JuQo8vgaicdrcWzQ2ZuDCcC-kQ&oe=6B084656"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z35pLUYqGnYQ7kNvwEOjsKa&_nc_oc=Ado4Gcs4-Xcrxo7HTjGQks2p3gUJPCdsEHc8iGnf771rW0pLqoCAD0HF1yphAcRIjTI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaZolCNn7nfzRlHRdHsYLnlTt15Vgj-jAFd7qbsJfiHw&oe=6B085BDC"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=56SAP-0sjwgQ7kNvwHCpcIr&_nc_oc=Adp8kr5AguZ_NGsvQpsPOVKuCjHKiRLzgnw0E0EsjWjXGf42vT813lhr2c7YRrkUQLE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnVKFu_5R22mzlJ3-S4cxFHvyb9M-QyEH99wFaWgD9sQ&oe=6B085567"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review
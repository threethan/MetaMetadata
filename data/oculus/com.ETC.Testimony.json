2249725808337747968_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ9K1WOPeHQQ7kNvwGO2h-d&_nc_oc=AdpOU-KVPHhlRYxYSH-QRozDJkBzZ7-CqdaSvDDkZeOFIW26y4uC-mDA-0KXJGeeFks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCsZ4X1PJxhbBmFEPc9zbprS4TNmchXVDc0BfPiD7N9w&oe=6B0310BD"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7YL5I6ebyYQ7kNvwGb22_m&_nc_oc=AdrvAG4EpZ3XArgSBnOkHaSfVd5J0v4qHcKLQ1JXgNj9wBHomBkN3jBlIy67OuuY5A0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4P7tnvddBw1fgrLOLxwiyyff6Um1euvgt-xVx7FnNUg&oe=6B033896"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHW7gSPvpFcQ7kNvwH-u70_&_nc_oc=AdqVDgnPYemvD1oEsXsBArcSLfw2dZINfb47Eu0PIZ80M5BaSPzCHjtSMHOl8GCizd4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoGnD1BRMgQcvM--OTVYvA_p_NRr-OtkiIaJS3yjA1PQ&oe=6B0315DC"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dWeidlWnCQQ7kNvwHhf74h&_nc_oc=AdqW0Rv1kSmKrrZ52F38I0-bbHKaQBlIVzzv3MZqX6y6ami1UlRjDlotu7rnU6jm5Xs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR419y6qkR3qavfrSq-3e2wmX5184UQgObYGPx7pNcTYg&oe=6B030F67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review
n.com&_nc_ss=7f20f&oh=00_AQBDzyGTTAS4XzaXDlQN-rjiuv5khWG_gp4XjdHXk-q1dw&oe=6A4E3AFD"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=526YZpSg6pgQ7kNvwHS7y-O&_nc_oc=Adqnr3PPd_9SoxtUtQZUqLRwdnwSkE_xgWAw4HdqlZxtKatzw_ow8M1VY0VIp6s7xow&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVkdhlbc8SAgr6a1WyJGNcPToIMu-CQ32qKD8ezaTIlQ&oe=6A4E62D6"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-erpjodtQsQ7kNvwFxyHUw&_nc_oc=Adrs9klLvoegG4_PfRN4lF87SCiXmxLFH2jIkcX3qcQujd9d774y5Eqc28JXsaE_cIE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXtt6wTbIxLLPUOFiktwjY5pdwlFkIWcO_WuBE6tn2IQ&oe=6A4E401C"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrcPA_ScZFQQ7kNvwFXUqHs&_nc_oc=AdrR_uOBTzKbqyqh7yswsigG_rG2N9jpIDK_5xzYwa575Yls9Gd1uKSlBH2oQ-zHJ34&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDabDMuvg8bVoS8MQhI5FN_TwFWGMsGta8X3PdkXVg3xg&oe=6A4E39A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162810_1854831351396912_7739590110307418112_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFQ0P0zJFagQ7kNvwEUY7Ux&_nc_oc=AdrMmcrNRDrSOxPBHFJOjvcwDA3xnnE7c6CS6GO5JSWhjWZU6vHpCoFBd0p6BCT
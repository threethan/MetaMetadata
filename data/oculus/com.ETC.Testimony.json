n.com&_nc_ss=7a30f&oh=00_Af3t9mXFapevSQ-O96D_HRdgdlc4kYAR22upYYs5Yw2n8A&oe=69DCD9FD"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOZrn3JUhiEQ7kNvwEIpaJ_&_nc_oc=AdpVXFjUIkh1EDGsGCc433uqH4XqYhPE2OtlozByQxqH4zUiqLTcSAkL-JsdcIDI6A0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FwN_ERvtuvWMwJ1WLplcCqStOG6nvfTMJ27TnZmXJAw&oe=69DD01D6"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VkY_oBzEbYQ7kNvwE0aGmm&_nc_oc=Adp21on_YLyK6feFlMMJWxRQcNCMyaUwiLoUj1CVbcWBRUieFJDvzF1v1fhjHQvoeos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FMdVhLDyuf8rE69RUByZIAxM20nNy52fZwCeADWDFQw&oe=69DCDF1C"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggTCOKaylhkQ7kNvwExTDYK&_nc_oc=Adp5bsxYl_Y7R2GPqu7Z_-CPB_VbIMLQEQR9qEjwAvrIK9ktMSfdlDzjfFJyQoWuRwQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qUbX--KjpRHAkk4rHZ7mGCfyziRVh13xUH0mS1csRjw&oe=69DCD8A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162810_1854831351396912_7739590110307418112_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0t7Gov5WqzMQ7kNvwHSD6cB&_nc_oc=Ado3YMPtZF2vjKEoUGr1Puo2vqe2SK-YKej9WeJ0zsxmh4y8kqirpvEyGG8Ok-4
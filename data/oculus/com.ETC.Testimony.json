n.com&_nc_ss=7f20f&oh=00_AQLwN8dzD9n0oFoHw1quFC4KtxUwLQZAJBEw5A92ES1LWg&oe=6AA5763D"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km7xnyRedLgQ7kNvwGvXCWY&_nc_oc=Ado1NQzgxh-o2NDCsEDW1r6KKbq179_JCdB6tTVs6cImml7UxwkczlkT6e8xENA7wyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqcLnm__TtkFBZ-QJNG8gTbJxwxEARsU592-Kc5X3cpQ&oe=6AA565D6"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRIQ3q1TjHIQ7kNvwEj4lQD&_nc_oc=AdrIGaZgWz_AE5bjjH-YAQuooMjmxReytyW75_cDD6GoBnq4beTf5s6cDLuE1dMh7n4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUYB5obAHdgkWsfmhjSzXoDU38Oc278_XzXTBQtJEuAg&oe=6AA5431C"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt95VnH_dNIQ7kNvwFxwC7b&_nc_oc=Adr7OZ-YIdClRIMCPsXdYNJIo9IBSZq_x-9vb7-bP878Sq-IbBaUORAmd-l9I3FRYzY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvNPYNcEUj_js3ctg9JjXLg5kxnNjUQUwCpaMCe63ynw&oe=6AA574E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162810_1854831351396912_7739590110307418112_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljWq5zOYIscQ7kNvwF6A98T&_nc_oc=AdqOHT7TpHg4zAt7QjKtaCfDCJ1PLkXQ91SHt3lnZwbpHwYFDTnHXj7LJyxjQ07
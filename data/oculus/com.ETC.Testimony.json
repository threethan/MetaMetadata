2249725808337747968_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_V5PNsP4-oQQ7kNvwE1QTDb&_nc_oc=AdpbN0QB7IoMkXmWsA_uDOZYYX5HlSfG0sEAxOcRT6szxRTe5tFWpXUEnJ9OZn-KOm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTcxjyxYjtHRThVKz86mogwa6o6fKHFIpnDFixBqjbmA&oe=6B01BF3D"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7YL5I6ebyYQ7kNvwE6ZXZJ&_nc_oc=AdrGg9K1ohJJaNKKc1QZtEUIGz9JkoghMCHuf4aOWQ6zD2CHX6hgLxi79ge9QggZj0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEsGE9aiuJb6DoOy-SrH_JinYQMHgLFqFS3cpZurO-6g&oe=6B01E716"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLeMgQ1tcdwQ7kNvwEasYpF&_nc_oc=Adr1iudf8CpB1a6HflPBDG2uw6aNwhrJeEynaNGhpacQgzsVgP7ZMFiiSgkUcbLtNiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1cckyiNDqZcwU7qt0w_GcI9_5hesB3ojYLzy3P2lkJg&oe=6B01C45C"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MG1upr42N_0Q7kNvwHPC0Uv&_nc_oc=AdpR_BTO7oX1e4YJXzdihaiHMIYS40Qi8NQPAnV6vM3GRTln5gfNoUx4Ll0JEHTb4Yw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTipl_YobJ9oUcd9RAeZcAzgX5xCsrV_jmPg3UDnENmQ&oe=6B01BDE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review
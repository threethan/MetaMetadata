n.com&_nc_ss=7f20f&oh=00_AQKcdf1OesxZpAUtXTHsZ8CcWaylS6DfMZ91kWxZjMjM8g&oe=6A9D54FD"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFSjyDguQicQ7kNvwGshiS2&_nc_oc=Adr3miz8Di4nIHWL5geKJke-4b7l2S-V3P5W1qTNOghAxSKsWuO_hiLKDyLWqS7In60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp4oUZly7kL3QdU99BwBoOMcgrDzMFzTq56CqjRBHhmw&oe=6A9D7CD6"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA4dBoLfv4sQ7kNvwGlWkuQ&_nc_oc=Ado4JwO_1BERLFmAEXL6VQhdnV7UNKbjwcnFmVPZXIVEH1oL_5Hmex646x4XO-dMBtQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU1gte2RNfe3PR96JnoEqvQZaA7612vGlHpgA-VgPJpQ&oe=6A9D5A1C"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wES8F5qbfKEQ7kNvwE9KIVq&_nc_oc=AdqO-oiUA7ehIwcJg8sJz99_Ll1Jy45vn0yRY5JrnTVxmyNQdhvnbDG6iD67HkY1G5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ5_gx0KFt-poTnkMA83XcQWDbfZci1RLbi6exnkiqnQ&oe=6A9D53A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162810_1854831351396912_7739590110307418112_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jzjmx7yesCwQ7kNvwG6eX2r&_nc_oc=AdrzHX_yyqQc1YcYFVSq8yeeyyZB7E125mUFoRdhcLgF8a0WkxmYrYstdr_TPcK
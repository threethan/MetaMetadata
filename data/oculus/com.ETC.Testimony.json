n.com&_nc_ss=7f20f&oh=00_AQL5EIsv5jNFxxXt44YbJR5t9ajYl-hu36l40efkzwWwGQ&oe=6A9FF7FD"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CeQjjtLXxtAQ7kNvwGQZg8w&_nc_oc=AdpJ0ngzmFxRJoI9aUkCa0hEna9OckxrUDmHq32K-RkBBrkCe7R_pSPKNZmzV9CkeJw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIEkWAHmS0A9lTL3egGsb9dz037Ar0UDjzXTZ22iS9RCQ&oe=6AA01FD6"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA4dBoLfv4sQ7kNvwEhCri1&_nc_oc=AdrwHNotHBASY0ykgKaKxvDyCdRcnSwB2-DxnYbdpVc-xsuKEbWELfLIjew5YXpkTKY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRRI7msFWUsADMUY_r7yLw-rfHo7Qn-Qsp87JErarpXg&oe=6A9FFD1C"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in6gaAcBfcMQ7kNvwEJyzYO&_nc_oc=Ado86QvZOOaWFJEGdONfsJtJkm6aRJqSqPgjUAUzk7bpxTdt-T68Vigt8KGKzSWy9j4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIESg6qcy6DeRbDfLw8z6paAWepXQt3iCNb3HiD7eiEg&oe=6AA02EE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162810_1854831351396912_7739590110307418112_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQYigpS4N2kQ7kNvwGgfA-X&_nc_oc=AdpRtuo80p5R9ecNJ_fScn0ZC0zsFJIb3PqHnX8Aaw6V54IDmA_M15SfK_60XVc
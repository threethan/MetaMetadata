2249725808337747968_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZ9K1WOPeHQQ7kNvwH8KFQf&_nc_oc=Adq_slgHYoEnBkWCnjsd-4Dj68ci0D8Kl83wo9ELYBO3ol4euVRJ9RnIgbGde1RY_HI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXavZgzW0_Kvc9H1XiOrB37og5hvvFm8W-0vUnY1HGAg&oe=6B04623D"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7YL5I6ebyYQ7kNvwF5eQZS&_nc_oc=AdonrTSlCWGk5man-MLL-XbsZo9z2007rkmE4nDbPE_QNrDIQt-2QNSCsIwT0cY6-p4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT51xoi_iYx4bBXg6v-oIbYmgfRrtMmtHx6WUArm8HIcw&oe=6B048A16"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NHW7gSPvpFcQ7kNvwFNLK1f&_nc_oc=Adr9CuRVCq6auSiGf1haTpDPok_xipgWAwzXtnwzkhV3UlXr1ykA3vYRc1zKJb9Khow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR78lMABY-XUcsHx_H4U-l5bdWyb-iiga9WaYai9m76Dw&oe=6B04675C"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dWeidlWnCQQ7kNvwGEaExx&_nc_oc=Adr6pvECOhFOZxjvgs4yUnc-Tt2yf7o9s8KajyxKHTThqHZLqWQbEk2fW6HyngDpUhs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj3lT9DyqJrIbzYTMwpTFJ5FAakcnxzMIod2bHl1e7KA&oe=6B0460E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review
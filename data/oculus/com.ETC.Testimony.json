2249725808337747968_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wclC3auLi8kQ7kNvwHoprGU&_nc_oc=Adqyo4Mre-fIK2VIis8RCCt7p84Xi8g3KERA2hA0FNEexnBgdnLirGgfAf4bRLjoyFU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTiOueDv9F2BCPrYV2xshoOF5WrvAbSnp5VDIpGmNDFsQ&oe=6B0D9CBD"}, {"file_name": "migrated_image.png", "id": "803462046801411", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162810_108781466337933_3138800677313052672_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lzXdbjkBcdYQ7kNvwHcTsT8&_nc_oc=AdpyB0REhGSXgV0NeyzbYpKn4bj51pSlcWWMG_KEm6-6zcRZaKfD2Wrd66pnpTS0o-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTIFhpJhxgJoIQeYWcHUfsRHS7c3YtumDOUaW_B0sZSg&oe=6B0DC496"}, {"file_name": "migrated_image.png", "id": "843877559450290", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162812_250250238772596_7641480954048937984_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpWRkrPo6mgQ7kNvwFGwxlQ&_nc_oc=Adrul9fvxu_LQjbFlfYRCDaZlBiyxBB5uu-iIFD5Wz_c2pd-Z1YhgrJskrTnfbvbnm4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRce2xG5eiBIsHoKgUwuZzufWNRgcTer1-r-sf5yGMEZg&oe=6B0DA1DC"}, {"file_name": "migrated_image.png", "id": "2527530027500930", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162811_1529966513688348_5085785326266351616_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InV9D41bOEAQ7kNvwF5A7_p&_nc_oc=AdoShCcp_K7zRrdNRKGDmfa1edLL7xkrhpTXVyorVyojGto1rDAOwZHKafsGkfGLBmE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSq2s9yf-p-eOp7MRc1Bc5iWSngQMK7hw47Y3lB0a6q6Q&oe=6B0D9B67"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Testimony", "keywords": ["Testimony", "Tribeca"], "long_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing. Beyond just a film, Testimony is an advocacy platform to allow the public to bear witness to those who have been silenced. Despite persistent victim-shaming and the discounting of their experiences, survivors are increasingly coming forward, empowering one another to become agents of change and hope. Testimony is an interactive investigation that aims to tackle the obstacles women and men still need to overcome in order to report assault and confront the legal system. \n\nCREDITS\nDirector/ Producer Zohar Kfir\nExecutive Producer Kaleidoscope VR\nOriginal Composition Josephine Wiggs\nUnity Development Evolving Technologies Corporation\nWorld Premiere Tribeca Film Festival 2017\n\nThis project highlights the testimonies of sexual abuse survivors and touches on material that can be experienced as being of a sensitive nature.", "short_description": "Testimony is an interactive documentary for virtual reality that shares the stories of five survivors of sexual assault and their journey to healing.  Witness these powerful testimonies and help us shatter the silence."}]}, "developer_name": null, "developer_privacy_policy_url": "http://testimonyproject.net/oculus/ps/", "developer_terms_of_service_url": "http://testimonyproject.net/oculus/tos/", "publisher_name": "Kaleidoscope", "support_website_url": null, "website_url": "http://testimony.site/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1373975123039041"}, "review
iler_thumbnail": null, "display_name": "Art Puzzle VR", "keywords": [], "long_description": "# Art Puzzle VR\n\nStep inside a virtual museum and use your own hands to bring iconic masterpieces back together \u2014 one piece at a time.\n\n## Gameplay\n\nPick up jigsaw pieces, rotate them freely, and snap them into place on a beautifully crafted wooden puzzle board. A\nreference panel displays the full painting beside you so you always know where each piece belongs. Pieces that slip\noff the board automatically return, keeping the experience smooth and frustration-free.\n\n## Features\n\n- **Iconic paintings** \u2014 Reassemble world-famous works including the Mona Lisa and Lady with an Ermine\n- **Three difficulty levels** \u2014 Easy (4\u00d7N), Normal (5\u00d7N), and Hard (6\u00d7N) grids to suit any skill level\n- **Timed challenge** \u2014 Beat the clock or play at your own pace\n- **Intuitive controls** \u2014 Natural grab-and-place interactions powered by Meta Quest 3's XR controllers\n- **Immersive environment** \u2014 A calm, museum-quality setting designed to let you focus on the puzzle\n\n## Who Is It For?\n\nWhether you're unwinding after a long day or looking for a mindful VR activity, Art Puzzle VR offers a relaxing,\ntactile experience that bridges fine art and interactive gameplay. Perfect for puzzle enthusiasts, art lovers, and\nanyone new to VR.\n\nSolve the masterpiece. Own the gallery.", "short_description": "Art Puzzle VR \u2014 Step into a virtual museum and reassemble iconic masterpieces with your own hands. Pick up, rotate, and snap jigsaw pieces to reconstruct famous paintings like the Mona Lisa. Choose Easy, Normal, or Hard difficulty and race against the clock. Built for Meta Quest with natural hand-tracked grab controls. A relaxing, immersive  puzzle experience for art lovers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/artpuzzlevrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/artpuzzlevr.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26647003308335630"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1733642984322183"}]}, "baseline_offer": {"id": "1733642984322183"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779821160, "status": "PUBLISHED", "id": "1733642984322183"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26702498226119471", "version": "1.0"}, "id": "1322506943137713", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26647003275002300", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26702498226119471"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1322506943137713"}]}, "change_log": null, "created_date": 1779690728, "id": "26702498226119471", "version": "1.0", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": nul
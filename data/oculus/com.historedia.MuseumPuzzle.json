IP6IaZMI7EA5Y0Lgc_OQO7EUAjx470w&oe=6A393958"}, {"file_name": "ArtPuzzleVR_Screenshot_03_2560x1440.png", "id": "1000301265860382", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499623384_1000301269193715_5495348685688301539_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmDglhol6RIQ7kNvwFS7ZQQ&_nc_oc=AdqReMOTsSMairm8iu4xkZ94OH8RUiZb-U588b5xbGvu0MJIdPyaJPe-rJVqeNThID8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0oRMyLm4D5F-PYlIOoT9fWGsXhPrjaW_9Kj3r51Wweg&oe=6A3945B0"}, {"file_name": "ArtPuzzleVR_Screenshot_02_2560x1440.png", "id": "26999266046370253", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620860_26999266056370252_1340080510270580655_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urMqm984SrwQ7kNvwG-Z6p1&_nc_oc=AdrPFrfNzQZO9e5mYFL-YRiKDeP8k_71_8RA3RACT6Yjd2VrWVMzS_ZKUJRSrRYJohY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rTB1_wjsReYijEDYvC0JKYEgXCUSa0yQYK72V3YWoeQ&oe=6A395CCA"}, {"file_name": "ArtPuzzleVR_Screenshot_04_2560x1440.png", "id": "993161263649112", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499622325_993161266982445_7198853303340595441_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YNC-useoThgQ7kNvwHvDr9I&_nc_oc=AdqqaEHHlZBt6u04MUC3UaJDrNeSYCpzj7mg0UKcMtjAODs6PNLxEXkbwTyktbqB67w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Npy4IM0tJk8uyIBLTYhwwYdvEOjllrJQ4WLODXmYjzw&oe=6A3961BF"}, {"file_name": "ArtPuzzleVR_Screenshot_05_2560x1440.png", "id": "1666288664698398", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623115_1666288668031731_3289295726449074841_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqsh32VGDngQ7kNvwGTA1nE&_nc_oc=AdrMQc53ycnJYdsBNM4OJ1CFtGaWdGYE9Y6gbcnOY3iAmiJNKvRTp1jAwXX9ns6Yc1s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Daur7fSINXFUioALW0hJPi6z8piLPi94-cIo2ZimdEw&oe=6A393BF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Puzzle VR", "keywords": [], "long_description": "# Art Puzzle VR\n\nStep inside a virtual museum and use your own hands to bring iconic masterpieces back together \u2014 one piece at a time.\n\n## Gameplay\n\nPick up jigsaw pieces, rotate them freely, and snap them into place on a beautifully crafted wooden puzzle board. A\nreference panel displays the full painting beside you so you always know where each piece belongs. Pieces that slip\noff the board automatically return, keeping the experience smooth and frustration-free.\n\n## Features\n\n- **Iconic paintings** \u2014 Reassemble world-famous works including the Mona Lisa and Lady with an Ermine\n- **Three difficulty levels** \u2014 Easy (4\u00d7N), Normal (5\u00d7N), and Hard (6\u00d7N) grids to suit any skill level\n- **Timed challenge** \u2014 Beat the clock or play at your own pace\n- **Intuitive controls** \u2014 Natural grab-and-place interactions powered by Meta Quest 3's XR controllers\n- **Immersive environment** \u2014 A calm, museum-quality setting designed to let you focus on the puzzle\n\n## Who Is It For?\n\nWhether you're unwinding after a long day or looking for a mindful VR activity, Art Puzzle VR offers a relaxing,\ntactile experience that bridges fine art and interactive gameplay. Perfect for puzzle enthusiasts, art lovers, and\nanyone new to VR.\n\nSolve the masterpiece. Own the gallery.", "short_description": "Art Puzzle VR \u2014 Step into a virtual museum and reassemble iconic masterpieces with your own hands. Pick up, rotate, and snap jigsaw pieces to reconstruct famous paintings like the Mona Lisa. Choose Easy, Normal, or Hard difficulty and race against the clock. Built for Meta Quest with natural hand-tracked grab controls. A relaxing, immersive  puzzle experience for art lovers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/artpuzzlevrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null
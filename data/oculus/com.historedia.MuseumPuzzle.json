OXUDDg&oe=6A22F34A"}, {"file_name": "ArtPuzzleVR_Screenshot_04_2560x1440.png", "id": "993161263649112", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499622325_993161266982445_7198853303340595441_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbtcB_TW8gUQ7kNvwHsPrdY&_nc_oc=AdoR98GdmGha-SCkBIE_NwakICgZCA_gs4_cgXvPDlvg_5yXPcfpRKxLbYdYtxmnUlA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82MXOMWtD3Pr-21tJj9sWXNlmGhbAD2BBFWduAOJBqCg&oe=6A22F83F"}, {"file_name": "ArtPuzzleVR_Screenshot_05_2560x1440.png", "id": "1666288664698398", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499623115_1666288668031731_3289295726449074841_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x64Jmnzpy_YQ7kNvwGT0cw7&_nc_oc=Ado0pQCl91gB3lvt4gPbmx-1fZmBWfno-RUA_xjFVOENw9ESPi_xy2hPx4XIe6lYkzQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lgi_CK--YK1bQLAPo7Guj1CeUJnJdPz-VsP7AazBISA&oe=6A22D279"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Art Puzzle VR", "keywords": [], "long_description": "# Art Puzzle VR\n\nStep inside a virtual museum and use your own hands to bring iconic masterpieces back together \u2014 one piece at a time.\n\n## Gameplay\n\nPick up jigsaw pieces, rotate them freely, and snap them into place on a beautifully crafted wooden puzzle board. A\nreference panel displays the full painting beside you so you always know where each piece belongs. Pieces that slip\noff the board automatically return, keeping the experience smooth and frustration-free.\n\n## Features\n\n- **Iconic paintings** \u2014 Reassemble world-famous works including the Mona Lisa and Lady with an Ermine\n- **Three difficulty levels** \u2014 Easy (4\u00d7N), Normal (5\u00d7N), and Hard (6\u00d7N) grids to suit any skill level\n- **Timed challenge** \u2014 Beat the clock or play at your own pace\n- **Intuitive controls** \u2014 Natural grab-and-place interactions powered by Meta Quest 3's XR controllers\n- **Immersive environment** \u2014 A calm, museum-quality setting designed to let you focus on the puzzle\n\n## Who Is It For?\n\nWhether you're unwinding after a long day or looking for a mindful VR activity, Art Puzzle VR offers a relaxing,\ntactile experience that bridges fine art and interactive gameplay. Perfect for puzzle enthusiasts, art lovers, and\nanyone new to VR.\n\nSolve the masterpiece. Own the gallery.", "short_description": "Art Puzzle VR \u2014 Step into a virtual museum and reassemble iconic masterpieces with your own hands. Pick up, rotate, and snap jigsaw pieces to reconstruct famous paintings like the Mona Lisa. Choose Easy, Normal, or Hard difficulty and race against the clock. Built for Meta Quest with natural hand-tracked grab controls. A relaxing, immersive  puzzle experience for art lovers."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tools.justinzheng.com/artpuzzlevrprivacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Fan Zhou", "support_website_url": null, "website_url": "https://tools.justinzheng.com/artpuzzlevr.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26647003308335630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499620860_970005942439114_283665262384290726_n.png?stp=d
-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSvUi-DE9NIgJGye17yNm3rZ0L-9xPoCsJEpv9nMJ2jw&oe=69AAC100"}, {"file_name": "RouletteUpdated.png", "id": "552109507646381", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974778_552109510979714_5435347592425873375_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QLeI6o8JhCQQ7kNvwEgKSQX&_nc_oc=AdlLE4MW3CeRRurAcbZAGHunFG1E3xrWxGRejcineIuJ-hVbO2ooEflF4x79gFc-FNw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfwWEzgDDkiLtXUO0p8FIqZl6YuGHAxAOC-b41XPLYJ99Q&oe=69AAC3F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta_74180_PDP_Update_Landscape_FNL.png", "id": "1293279522613469", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499302770_1293279525946802_5131980362392977419_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqyHidClvroQ7kNvwHPFdfU&_nc_oc=AdkNW_fFSrZ1dM1K5zy1uf-KHTbhpmk56vkMlT2IJD8WwtERHDsCG8H9MHCHtyPT5cA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCtM__90703A13qObnxMArSfaV5S33Dbm16jwoER3AMA&oe=69AAC93D"}, "display_name": "PokerStars - Vegas Infinite", "keywords": ["Poker", "Blackjack", "Slots", "Roulette", "Casino"], "long_description": "PokerStars presents Vegas Infinite, your limitless **free-to-play** casino. Leap into multiplayer **poker, blackjack, roulette, craps, baccarat, sportsbook** and **slots!** Score a **30,000 Chips welcome bonus** and spin for **free chips every 8 hours**.\n{1414050236262763}\nExplore **breathtaking venues** from stunning casinos and open-air poker rooms to galactic space stations, or your own **luxury suite**.\n{610512428706005}\nTake on friends and players worldwide at the casino or in private games. **Chat live** and study their tells!\n{1691268885093437}\nLight up the tables with endless **props** and deck out your avatar with **customizable apparel**.\n{2066560483866108}\nPlay **cash, Spin & Go, and tournament poker** daily, with epic leaderboards. Become a Metaverse Poker Tour champion!\n{3945360479064957}\nCheck out **craps, blackjack and roulette**, plus Infinity Roulette, and back your favorite team - **all under one roof**!\n{9842525962522731}\nSpin a **world-class range** of slots packed with bonuses and prizes. Play in companion mode, your suite, the casino, or the Slots Floor.\n{971759978157454}\nWin big with our own **progressive Infinity Jackpot!**\n{1005803868423398}\nTake Vegas home with you with **full mixed reality**.\n{667706922777816}\nYour seat is open.\n{724645200134409}\nThis is not a gambling product and does not provide an opportunity to win real money. **18+ only**. Please play responsibly.\nAccess to IAP may be restricted by location.\nVOIP real-time chat is monitored by ToxMod.", "short_description": "Vegas Infinite, formerly PokerStars VR, is a world of entertainment with no limits. Hang out with friends and play poker, blackjack, roulette, slots, craps, baccarat, and more for free in stunning environments with realistic chip and card movements, and an endless supply of interactive props and apparel.\n\nVegas Infinite is not a gambling site and does not present an opportunity to win real money. 18+ only. Please play responsibly."}]}, "developer_name": "Lucky VR Inc.", "developer_privacy_policy_url": "https://www.vegasinfinite.com/privacy-policy", "developer_terms_of_service_url": "https://www.vegasinfinite.com/general-terms", "publisher_name": "The Stars Group Inc.", "support_website_url": "http://support.vegasinfinite.com/", "website_url": "https://www.vegasinfinite.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SOCIAL", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "reco
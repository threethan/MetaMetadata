_name": "migrated_image.png", "id": "574231910108927", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974688_1497268573740322_2007296302005616640_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjrbKrPiycYQ7kNvwFDePRU&_nc_oc=AdraaLjS1CzBif-uQF3D7nDdoSNQtPmwGs6h2wbEcOszu_bnUNx2rzKGJOn7nQYemBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0ucAjK8OUC9uJhVwTjFQYRy8gXKnehR8UMOMWtsXI3w&oe=6ACF9B8F"}, {"file_name": "migrated_image.png", "id": "1346115318922917", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974908_339481883587410_5992345088708050944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6b_GCHx0AToQ7kNvwGYmVwY&_nc_oc=AdpX2QgGOxQdx1ckrfda3k2wHPKNPU9KI8CFRssrMP4ZggPKZN0AOKZYr1WgSM_O8dU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvLF2nCOcJtsYwWc-N0cDaYP44-mZGRbEtTF7PWgPTFw&oe=6ACF875C"}, {"file_name": "migrated_image.png", "id": "242748943571033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974528_2099504643436815_3522082699814633472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iT_REafb-MMQ7kNvwGD2exy&_nc_oc=Adq1kfZwgOsrFuCShDiph3iOBfpY4ar5n3tCX9TJU5Ph2IBHRO6Myhg1WiJhIiqM144&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOg-kq53VgCe8C926tOZ-Z_ezMUpmeTKJWQbn30iAB6YQ&oe=6ACFAC32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZWu7Vw", "id": "951964714974068", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974549_951964718307401_1299692627444105216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYSpSjNmTxUQ7kNvwGgs2_V&_nc_oc=AdoirVwhm-BODOjiEjT2xSROysJ8Oztf4PW9QpmsIhJCofvnX0s7avdr-NVh-g2OWgs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhtNqM5jm7ykP5PVH5QKsbgzIHsA2JGI-HAx59ns46Qw&oe=6ACF9E5E"}, "display_name": "PokerStars VR", "keywords": ["Poker", "PokerStars", "Social", "Holdem", "Casino"], "long_description": "PokerStars, the world\u2019s leading poker brand, has combined live and online poker in a truly immersive VR experience.\n\n-Study your opponents, pick up on their tells, and chat in real time\n-Handle your chips and cards, just as you would at a real-world poker table\n-Keep the table fun with interactive props and toys, summoned in an instant\n\nThis is the most exciting poker game on the planet, and there\u2019s a seat open for you right now.\n\n- Key Features -\n\n-Authentic poker action\n-A fully immersive, social experience\n-Simple, intuitive, easy to play\n-Play real opponents\n-Realistic physics, from cards and chips to balloons, pistols and more\n-Unlock free chips every day\n\n- Exotic locales -\n\n-Macau 2050: A futuristic re-imagining of Macau by night \n-Macau Suite: An opulent yet intimate and relaxing environment\n-The Showdown Saloon: Play in a classic Wild West saloon\n-The Monte-Carlo Yacht: Take to the high seas\n-The Void: Play with no distractions", "short_description": "Step into the future with this game-changing release from the biggest name in the business. Visually stunning environments; realistic chip and card movements; an endless supply of interactive toys, props and accessories; and the world\u2019s best poker software powering multiplayer Texas Hold\u2019em action."}]}, "developer_name": "Lucky VR Inc.", "developer_privacy_policy_url": "http://www.getluckyvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.pokerstars.com/poker/ps-vr/tos/", "publisher_name": "The Stars Group Inc.", "support_website_url": null, "website_url": "http://www.starsgroup.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_
ile_name": "migrated_image.png", "id": "574231910108927", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974688_1497268573740322_2007296302005616640_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IUb5c3EnJgQ7kNvwG-OYD-&_nc_oc=AdpxMqT0-So6TfWQH_H37AF8Hf5c79A2A9cOC-qQGtWVj2U3RIJFhXWF-a7TXWa6hzk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMDeRe75amjxDiDBek1a9ZlfHvqaTF6U0h_na-Tl6Frw&oe=6AF3340F"}, {"file_name": "migrated_image.png", "id": "1346115318922917", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974908_339481883587410_5992345088708050944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxymmeLa50IQ7kNvwGWEWYz&_nc_oc=AdqZvG6QYWjLw_x-cqnz1dpGgpu22HAX_5b-TaWqcNTZuhkyeShm-wnVGxI3ffIUb9A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZPTbdyEuKIiCQ8qj3IPR_bpA44ldzoSY7ewGD07cSvg&oe=6AF3581C"}, {"file_name": "migrated_image.png", "id": "242748943571033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974528_2099504643436815_3522082699814633472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ThK6KjVJij4Q7kNvwHHs20P&_nc_oc=Adrqa-tS4j7j_Jz-2LsqDmiVjbKLc3arYTUqVIzMRjNG13yEZPlZCkNVl34lsw89odU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnr2go5Pen39U7vfFswocI1PAB8zDFO_XFdTJPhiLT5g&oe=6AF344B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZWu7Vw", "id": "951964714974068", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974549_951964718307401_1299692627444105216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6YH0J6PVJYIQ7kNvwE6LYuv&_nc_oc=AdoU8KptacJ7LY8vsO0GgvUfD3t4u6d0lF2rPy1sOKYU6WnnBeLbD4Jaf4J8xPahnUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTabV8bv-gCMRh6TIj6ct3Rx6c_SFZ8j5xpecUBz98Zfg&oe=6AF336DE"}, "display_name": "PokerStars VR", "keywords": ["Poker", "PokerStars", "Social", "Holdem", "Casino"], "long_description": "PokerStars, the world\u2019s leading poker brand, has combined live and online poker in a truly immersive VR experience.\n\n-Study your opponents, pick up on their tells, and chat in real time\n-Handle your chips and cards, just as you would at a real-world poker table\n-Keep the table fun with interactive props and toys, summoned in an instant\n\nThis is the most exciting poker game on the planet, and there\u2019s a seat open for you right now.\n\n- Key Features -\n\n-Authentic poker action\n-A fully immersive, social experience\n-Simple, intuitive, easy to play\n-Play real opponents\n-Realistic physics, from cards and chips to balloons, pistols and more\n-Unlock free chips every day\n\n- Exotic locales -\n\n-Macau 2050: A futuristic re-imagining of Macau by night \n-Macau Suite: An opulent yet intimate and relaxing environment\n-The Showdown Saloon: Play in a classic Wild West saloon\n-The Monte-Carlo Yacht: Take to the high seas\n-The Void: Play with no distractions", "short_description": "Step into the future with this game-changing release from the biggest name in the business. Visually stunning environments; realistic chip and card movements; an endless supply of interactive toys, props and accessories; and the world\u2019s best poker software powering multiplayer Texas Hold\u2019em action."}]}, "developer_name": "Lucky VR Inc.", "developer_privacy_policy_url": "http://www.getluckyvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.pokerstars.com/poker/ps-vr/tos/", "publisher_name": "The Stars Group Inc.", "support_website_url": null, "website_url": "http://www.starsgroup.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memo
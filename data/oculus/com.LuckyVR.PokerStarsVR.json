_name": "migrated_image.png", "id": "574231910108927", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974688_1497268573740322_2007296302005616640_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uE_eDT2NYoMQ7kNvwGwbu5C&_nc_oc=AdqSNwmB-5OY_dfWAsevAFfmh4cWRl2FD06Hln8I8elSzWoAw45-AjgjDZoQW2zBx0k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzxgFfjETe4ja3zzqNzGGuuvaSi4z1RZnEWyxl_4XeTaw&oe=69C2714F"}, {"file_name": "migrated_image.png", "id": "1346115318922917", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974908_339481883587410_5992345088708050944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c06KizIpMTIQ7kNvwGLUsvT&_nc_oc=AdooLjQeXkuqYvwBK2yafWf50pXMFri1Acmr4N0_s6NLnXR3_Eu8lKOye9g5W_gVoSk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyI5lQUtTQ_wzcnVSwIopaFTWB0v4ZyH9tGcEOQCeu4kA&oe=69C2955C"}, {"file_name": "migrated_image.png", "id": "242748943571033", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974528_2099504643436815_3522082699814633472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocFlpSjDIHoQ7kNvwHGAof8&_nc_oc=AdpFwkcBS_FnpGiwmRPcHUelemu-q9_XPPMntOfwSO3FX3w7iWvLdrdHOHfiwxMebEo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDFeeJLGEoqZow68MrSKk950gFIxPkIbNXNQATqe62OQ&oe=69C281F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZWu7Vw", "id": "951964714974068", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974549_951964718307401_1299692627444105216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPGxt0s0kjoQ7kNvwEA1t3W&_nc_oc=Adp4lRqfTmVx6ON8satrE5E9_8YpaOx7a2mFlvZrzWx5t7snuzCZjMddZMKthk-ji3U&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7bcYYoxE4OLUQD7pLsGk2gI054S3QIbs-bO_cp103ig&oe=69C2741E"}, "display_name": "PokerStars VR", "keywords": ["Poker", "PokerStars", "Social", "Holdem", "Casino"], "long_description": "PokerStars, the world\u2019s leading poker brand, has combined live and online poker in a truly immersive VR experience.\n\n-Study your opponents, pick up on their tells, and chat in real time\n-Handle your chips and cards, just as you would at a real-world poker table\n-Keep the table fun with interactive props and toys, summoned in an instant\n\nThis is the most exciting poker game on the planet, and there\u2019s a seat open for you right now.\n\n- Key Features -\n\n-Authentic poker action\n-A fully immersive, social experience\n-Simple, intuitive, easy to play\n-Play real opponents\n-Realistic physics, from cards and chips to balloons, pistols and more\n-Unlock free chips every day\n\n- Exotic locales -\n\n-Macau 2050: A futuristic re-imagining of Macau by night \n-Macau Suite: An opulent yet intimate and relaxing environment\n-The Showdown Saloon: Play in a classic Wild West saloon\n-The Monte-Carlo Yacht: Take to the high seas\n-The Void: Play with no distractions", "short_description": "Step into the future with this game-changing release from the biggest name in the business. Visually stunning environments; realistic chip and card movements; an endless supply of interactive toys, props and accessories; and the world\u2019s best poker software powering multiplayer Texas Hold\u2019em action."}]}, "developer_name": "Lucky VR Inc.", "developer_privacy_policy_url": "http://www.getluckyvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.pokerstars.com/poker/ps-vr/tos/", "publisher_name": "The Stars Group Inc.", "support_website_url": null, "website_url": "http://www.starsgroup.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_
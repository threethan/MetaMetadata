ad3-2.oculuscdn.com/v/t64.5771-25/38974908_339481883587410_5992345088708050944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2Cac8KyfRQQ7kNvwFet55D&_nc_oc=AdmZ1KOAG7EDBz2Aaimd6skYG1VrNdSXLYuO2R8c_jGUqhBta5tyuoZl_mbviVeFJzY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft7L0PmMfHbZfJqslwCX5QFEJ9b9HDgaKYPiIN3gC1Big&oe=69A2F15C"}, {"file_name": "migrated_image.png", "id": "242748943571033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974528_2099504643436815_3522082699814633472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTyMkLrxjhEQ7kNvwFK5XUS&_nc_oc=AdmH86QcousG1eHMFNabf1EX3hTA-C5V9cHlgDPbdf3_2ElmKSB8wttUFSGr_-Qowyw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTKkCxTbvxVw4P6RJlNFL_kq5dWvl-QNYAls_YpXwT5A&oe=69A2DDF2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZWu7Vw", "id": "951964714974068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974549_951964718307401_1299692627444105216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL_DLCqf7ksQ7kNvwFuvwZ6&_nc_oc=AdmM46rYr_hMu2QXnHtE4JS0BPL3i6ZUcCe-isFVJeSUoPluPeLcISyz5WnqvkWRS5M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYyBxD0r5giB_dEHp2-bXMnrug1RGMqd46ndQdDggE1Q&oe=69A2D01E"}, "display_name": "PokerStars VR", "keywords": ["Poker", "PokerStars", "Social", "Holdem", "Casino"], "long_description": "PokerStars, the world\u2019s leading poker brand, has combined live and online poker in a truly immersive VR experience.\n\n-Study your opponents, pick up on their tells, and chat in real time\n-Handle your chips and cards, just as you would at a real-world poker table\n-Keep the table fun with interactive props and toys, summoned in an instant\n\nThis is the most exciting poker game on the planet, and there\u2019s a seat open for you right now.\n\n- Key Features -\n\n-Authentic poker action\n-A fully immersive, social experience\n-Simple, intuitive, easy to play\n-Play real opponents\n-Realistic physics, from cards and chips to balloons, pistols and more\n-Unlock free chips every day\n\n- Exotic locales -\n\n-Macau 2050: A futuristic re-imagining of Macau by night \n-Macau Suite: An opulent yet intimate and relaxing environment\n-The Showdown Saloon: Play in a classic Wild West saloon\n-The Monte-Carlo Yacht: Take to the high seas\n-The Void: Play with no distractions", "short_description": "Step into the future with this game-changing release from the biggest name in the business. Visually stunning environments; realistic chip and card movements; an endless supply of interactive toys, props and accessories; and the world\u2019s best poker software powering multiplayer Texas Hold\u2019em action."}]}, "developer_name": "Lucky VR Inc.", "developer_privacy_policy_url": "http://www.getluckyvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.pokerstars.com/poker/ps-vr/tos/", "publisher_name": "The Stars Group Inc.", "support_website_url": null, "website_url": "http://www.starsgroup.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "947216472618112"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "578617912645734"}, {"status": "PUBLISHED", "id": "1184051545573403"}]}, "baseline_offer": {"id": "578617912645734"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1558136220, "status": "PUBLISHED", "id": "57
igrated_image.png", "id": "574231910108927", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974688_1497268573740322_2007296302005616640_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vmbnZEIYb9oQ7kNvwHG3Dj7&_nc_oc=AdrCywjK7tz4cePpM1jI6bwo1bHZjeVb5oi5fcTmH4TdA76TQtKYLwn0Xew6FravKLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aC6ALCWHF6hnRH5VjpeQiXPQW3Jx1fj_XFBa2aqboLQ&oe=69D637CF"}, {"file_name": "migrated_image.png", "id": "1346115318922917", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974908_339481883587410_5992345088708050944_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlvVm34c5jMQ7kNvwEMzxRq&_nc_oc=AdpbEIdL4WqHW3ZIbT2f6tImNXX9jFFIjbLfnmGO1s99wUkTy_xDAygqUuSGz4tHsGA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZMQ8oAXQ_nd18hekIQUIMS_4kPQFW3FuzhGSYkYM45A&oe=69D65BDC"}, {"file_name": "migrated_image.png", "id": "242748943571033", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974528_2099504643436815_3522082699814633472_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfvVjeldI70Q7kNvwHaNrIm&_nc_oc=Adp_8jB0JBlhsVPiceiD-p4Qet4HbK7QBqQdCenjnitmor2fVpJ6FgR8wBT5U3F9GqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a7rrrXKZ93pkPuAWhkXgaRkfCzMZsuFQSrwrsGqVqnQ&oe=69D64872"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZWu7Vw", "id": "951964714974068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974549_951964718307401_1299692627444105216_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXbSna58BUkQ7kNvwEyr2xq&_nc_oc=AdrNuh4et6Egx5Gy4FB3FB-qEfolCJUF2OaVmpMkH0osehXEaiqKmwblCR0Uyp9auc4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AOi9ehr7uNn95EQMXJMwBQuP_6BKJb4pUdFknotQoFQ&oe=69D63A9E"}, "display_name": "PokerStars VR", "keywords": ["Poker", "PokerStars", "Social", "Holdem", "Casino"], "long_description": "PokerStars, the world\u2019s leading poker brand, has combined live and online poker in a truly immersive VR experience.\n\n-Study your opponents, pick up on their tells, and chat in real time\n-Handle your chips and cards, just as you would at a real-world poker table\n-Keep the table fun with interactive props and toys, summoned in an instant\n\nThis is the most exciting poker game on the planet, and there\u2019s a seat open for you right now.\n\n- Key Features -\n\n-Authentic poker action\n-A fully immersive, social experience\n-Simple, intuitive, easy to play\n-Play real opponents\n-Realistic physics, from cards and chips to balloons, pistols and more\n-Unlock free chips every day\n\n- Exotic locales -\n\n-Macau 2050: A futuristic re-imagining of Macau by night \n-Macau Suite: An opulent yet intimate and relaxing environment\n-The Showdown Saloon: Play in a classic Wild West saloon\n-The Monte-Carlo Yacht: Take to the high seas\n-The Void: Play with no distractions", "short_description": "Step into the future with this game-changing release from the biggest name in the business. Visually stunning environments; realistic chip and card movements; an endless supply of interactive toys, props and accessories; and the world\u2019s best poker software powering multiplayer Texas Hold\u2019em action."}]}, "developer_name": "Lucky VR Inc.", "developer_privacy_policy_url": "http://www.getluckyvr.com/privacy-policy/", "developer_terms_of_service_url": "https://www.pokerstars.com/poker/ps-vr/tos/", "publisher_name": "The Stars Group Inc.", "support_website_url": null, "website_url": "http://www.starsgroup.com/", "category": "EARLY_ACCESS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "SOCIAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
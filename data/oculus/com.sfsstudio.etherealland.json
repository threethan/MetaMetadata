55_4869908892482827573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbxIR8OIxcAQ7kNvwH4rDr8&_nc_oc=AdlXGdbtD9mlL2sR11uVIjya3MJr0yezDswkaYK_X4cyHa3s91HtMRjgpzBsPS8DarA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvP_FVE1sSloYT4jiQbnArBaxL1DH_Co4yKomqay_ulrQ&oe=69A96B58"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "269398401815424", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75356794_269398405148757_4001608527998605695_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCTEQwZRh5UQ7kNvwEVKs2D&_nc_oc=AdlRzcnTnNc77XROevunJiFSP3pX2Z2pgTw0_w0nZiWS85HZAQ5HukVnmwtrtylCIHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv9T_njP0bQDjfFdhhosqXHY4RvWigHlMz_7deyNMOFoA&oe=69A968EB"}, "display_name": "Ethereal Land", "keywords": [], "long_description": "Ethereal Land is a unique meditation application of oriental ink painting style. \nIn this poetic world, you will:\n- Experience the changes of seasons\n- Discover inner peace in a relaxing mindfulness journey\n- Immerse yourself in the ink painting scenery\n\nOur goal is to bring you a new visual meditation experience. Through breathing training, awareness practice and mindful escape,  you may find your own ethereal land.", "short_description": "Ethereal Land is a unique meditation application of oriental ink painting style. \nIn this poetic world, you will:\n- Experience the changes of seasons\n- Discover inner peace in a relaxing mindfulness journey\n- Immerse yourself in the ink painting scenery\n\nOur goal is to bring you a new visual meditation experience. Through breathing training, awareness practice and mindful escape,  you may find your own ethereal land."}]}, "developer_name": "SFS Studio", "developer_privacy_policy_url": "https://shufeishu.com/ethereal-land/Privacy_Policy_20220225.pdf", "developer_terms_of_service_url": null, "publisher_name": "SFS Studio", "support_website_url": null, "website_url": "https://shuf
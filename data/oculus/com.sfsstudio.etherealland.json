55_4869908892482827573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3t3yWeNJk7AQ7kNvwFMQfvb&_nc_oc=AdmbcHzLKxSNUdO8QvuOivt7LYppa_qedkwxxySPQUOpWmWVazXG91pk2rQsXD5Jhec&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvLf2irGkkeGs8WjP0hA_Vg19kQ9Ixl1BvRltfMUJ3_A&oe=69BD31D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "269398401815424", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75356794_269398405148757_4001608527998605695_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Uto-FbGF8AQ7kNvwFSlIGw&_nc_oc=AdlSIbmyttmR8bWjk0yJ5jtg6TK_WnjuLu2_IEFe14uIWG9K24Lip6fR05N7r3ArCHQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzIlbwMlmVQwHKXRW0BMxc6IwsSXyjJHev40n6givoRg&oe=69BD2F6B"}, "display_name": "Ethereal Land", "keywords": [], "long_description": "Ethereal Land is a unique meditation application of oriental ink painting style. \nIn this poetic world, you will:\n- Experience the changes of seasons\n- Discover inner peace in a relaxing mindfulness journey\n- Immerse yourself in the ink painting scenery\n\nOur goal is to bring you a new visual meditation experience. Through breathing training, awareness practice and mindful escape,  you may find your own ethereal land.", "short_description": "Ethereal Land is a unique meditation application of oriental ink painting style. \nIn this poetic world, you will:\n- Experience the changes of seasons\n- Discover inner peace in a relaxing mindfulness journey\n- Immerse yourself in the ink painting scenery\n\nOur goal is to bring you a new visual meditation experience. Through breathing training, awareness practice and mindful escape,  you may find your own ethereal land."}]}, "developer_name": "SFS Studio", "developer_privacy_policy_url": "https://shufeishu.com/ethereal-land/Privacy_Policy_20220225.pdf", "developer_terms_of_service_url": null, "publisher_name": "SFS Studio", "support_website_url": null, "website_url": "https://shuf
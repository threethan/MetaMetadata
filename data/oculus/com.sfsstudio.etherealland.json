55_4869908892482827573_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbxIR8OIxcAQ7kNvwE1_2fc&_nc_oc=AdmecgRYJL4e-wC4u6X3a1JKIHOBu2wZVGVSA5zpx2IDSpHIuKeDnqZ2xiw3AMtdfJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft7lXANwIbAw_6ELi7KcUYC1Dar-ON3RjsqukUP_ftJIw&oe=69A819D8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "269398401815424", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75356794_269398405148757_4001608527998605695_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GCTEQwZRh5UQ7kNvwGaASF6&_nc_oc=AdnyWJgWtWTQ4yVvypI2ed292rnAjeDyCPppfCfhW2eIgXwRZ9MM7rJouk69bZOQBUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuvR-NMrbDIAEbNkKDmcsis2gTkuxGoqlUyn-HK9CTV0A&oe=69A8176B"}, "display_name": "Ethereal Land", "keywords": [], "long_description": "Ethereal Land is a unique meditation application of oriental ink painting style. \nIn this poetic world, you will:\n- Experience the changes of seasons\n- Discover inner peace in a relaxing mindfulness journey\n- Immerse yourself in the ink painting scenery\n\nOur goal is to bring you a new visual meditation experience. Through breathing training, awareness practice and mindful escape,  you may find your own ethereal land.", "short_description": "Ethereal Land is a unique meditation application of oriental ink painting style. \nIn this poetic world, you will:\n- Experience the changes of seasons\n- Discover inner peace in a relaxing mindfulness journey\n- Immerse yourself in the ink painting scenery\n\nOur goal is to bring you a new visual meditation experience. Through breathing training, awareness practice and mindful escape,  you may find your own ethereal land."}]}, "developer_name": "SFS Studio", "developer_privacy_policy_url": "https://shufeishu.com/ethereal-land/Privacy_Policy_20220225.pdf", "developer_terms_of_service_url": null, "publisher_name": "SFS Studio", "support_website_url": null, "website_url": "https://shuf
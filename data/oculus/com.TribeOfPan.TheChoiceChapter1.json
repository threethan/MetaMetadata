qT2jx33YvuQMKfgevN81Gi4hxAc46pRTV_aeSA0sA&oe=6A15BE40"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQDvQFKVfuUQ7kNvwHQt-NP&_nc_oc=AdrQZDLBpvSQW6zqulaRSWOMFx2ZAF9pe6IaQRLoDfR15pj5QzLS2_u6ombxBBB9xN0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-Rhml1ntqFuV8I21tf-f0zObE8ObT0iV0WwiF9GASQw&oe=6A15BDDA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCx1coS6zskQ7kNvwG2HLx9&_nc_oc=Adr6Mb8ovpqTARnZ1dLOH3IZZJLeKgzS2x9fU0DI9J1qAFiMuwXeKNhGeSR3GEA_uHA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s3HgG8UOr6jQZoAd8WVtiCSmbgrDuBMuxIgcqtFPtCw&oe=6A15A035"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gk8KfCXAN4Q7kNvwEs4Ivs&_nc_oc=AdpT0YGVdsdkWBS_JqbW2SQv7gcg5ZRUMBIe4dcdTBti2KWdNGQkgxNi0V5kR7UY1GM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OyI_hrlLCtE5AQr1603t4fdgqSdRI6rNEdIq0wYBvAA&oe=6A15B9E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNjZGTXv_k0Q7kNvwHjFoIx&_nc_oc=AdrhrySWqDmKWkUIj6rPF1pH0PWteAd5vLCORW9b-JLI4a7CwPHKQiKVGpVICn928N4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7i0rj1y1Dk-I0BSwlDk_FhMAoKPa6Zz3yRSUFsw-dW5w&oe=6A15A726"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
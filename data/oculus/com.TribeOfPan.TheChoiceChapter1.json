0vUXoT5lu8dF4IeQPPOMEuLrhVw_rGvcxOckJaqGA&oe=6A2D7940"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiL7VLcIX1AQ7kNvwE9vgaG&_nc_oc=AdpDeOwDK4Ywn7FfmRV17eAjQR6sMvb5YBYWu698mMzGMTOIJtTWBqHDCKaHEXdkq3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8isIWLfnxDpEvtG7FMVrqhfH8rp5WPnTOQp2un94lXiQ&oe=6A2D78DA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwIa-n50Z3kQ7kNvwHToz1e&_nc_oc=AdpKjltXwtiR8yCw5zZN6qSbgsxZ3lJsbZmxG62HfXj4WvaWrtogQTgjIL8WWEbVDXs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82KdwVmG7zlYLEsGW6G_FYygjQwRnGEIZY7i3YpRayrQ&oe=6A2D5B35"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqIfoFvZ4FgQ7kNvwFUCjCI&_nc_oc=Adr5-wTAKe6pSvYjhjIYGOzB4Bj9Rw_uI8ZEQrHexYaCcEkEPQMqIyvDsgBLIBXwyLU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Wd0SfFKs41iOZvblPCI0IaNnVLDPPwHlAuBMcg2DY3Q&oe=6A2D74E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gj5bA-b6FVQQ7kNvwFVJaMo&_nc_oc=Adqjim15_JAP1rLzt4YSWRHxzrif0DG8h6WiJ8k6EuX11zvvcVyikY0LxFlfcAfTLl0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1Pgr1dK9-wjHbI6fOdQ6V8nyMbjgdHLp4BijpH0SXVQ&oe=6A2D6226"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
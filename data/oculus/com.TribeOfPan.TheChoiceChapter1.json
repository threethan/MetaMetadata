kkT-KhfcmbBrKJZOInZhWO66O4lHCaNNJlV5L_hsg&oe=6A3E9CC0"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKQpfUmfR-kQ7kNvwFkx5ll&_nc_oc=AdpiPZ3282tKU-gExuqSBEdGQR0G6xXnIZGYJ_HpVvHxNAOCdhUFhwcarp0LVgPvAPQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CApZmSIGl1pbe_zOY4agR5KxaII_kN0vlEeRLx622ig&oe=6A3E9C5A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKO3tAVbVeQQ7kNvwEBP_Oc&_nc_oc=Adr64176Mlnw3wHuPueEckX8wIsTNn7_hUbnPDbcktvQb21jVJx99zEtD7vZ7Oz93EM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_y12upvGq2CZpIIupx2O-WKm25mXuu7jGFEJVXnxv3cg&oe=6A3E7EB5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuX-ABfHh68Q7kNvwG612ZW&_nc_oc=Adpt1OEyB0V6cDJP6A0cm-v9wqUInFKZ4D2wLyeXBOGerELkDC1c76AUTX2NW3yn2v4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lris7SOddRF3hc4EZA_SqHPnCxPiUOd5IeTlIh43FoA&oe=6A3E9864"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEwbnvBUPlMQ7kNvwGWDMLr&_nc_oc=AdquDIXeV7bPlcLYmMz04X9Ov7-F4R348GjezKzslk3ivTfUwwyfiv8e1U5amMYqew8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GTg4fzmpR19F_QlqY423EVo-s-EBTez_KUjSt63yvZQ&oe=6A3E85A6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
i_Hby3C-sYJzw97klv0hwkCwdol27uu1w6JDlm0_A&oe=69D78F80"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-o-4k_mrLXsQ7kNvwGq5zmS&_nc_oc=Adp0aljczRnwhVNiUs_OqksAYwenw5wJwMynPiq-bM9EfYN1iuh0TfrAIgIBt2_9Y7Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zzQDtsdEWVXA7h2GsMGIVuTnQhu19t6AnTvoWx3ijYg&oe=69D78F1A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1FUG2_hc0cQ7kNvwGtd5pI&_nc_oc=AdrBy7tQ1b-vc-4f-a8YBIKpe46bKPdZCGeGGoUCHBr3yXZxYoObJBfbdUdyr2jJuOk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2D9pH9X3FFUPzZmSh7g0KjBdTtM5z6o5OF4_lM_m0XPg&oe=69D7A9B5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjdKwelMfIMQ7kNvwF-XWj3&_nc_oc=Adr-XpcejwtxrdrO4eKalOWLy1ZARQXr23c2O_3noHITsq1Yw1023e7pHGBwOP3fDz0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30BdFjIzEqJD5JY_7ysKhFuv5zGqnlwzQUhutcVcz-cQ&oe=69D78B24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ANsjx6ByvUgQ7kNvwFrgiO2&_nc_oc=Adpae1Law-UB9tSRV1byifDyElW-eYUX4yq_WXh28ay7gXx9c8gUnjrYDDOgtzasKiQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ce7z12HXcfV2yyYHhz9r5iJQqkfAx6RkwdGVSix1rdg&oe=69D7B0A6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
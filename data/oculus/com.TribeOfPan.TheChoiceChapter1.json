MhNMpGdboY4GK_y0qdeQLkDe040-HR2Lut30WEWgg&oe=69E21B80"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPMF6n9QDUkQ7kNvwE2mdrq&_nc_oc=AdojLhEc-rirMZS5i6HnuczswZbk5VmqNn5mzQ6uefgWZg9IO77IUX1FeKdHthIDJfY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jmm6QICFj1HBBhJTAc9PnZTtAdXOF6Nxj37OvXPlXYA&oe=69E21B1A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jO1uHbMuIV4Q7kNvwGrYgFB&_nc_oc=AdofWDK9bWY22IofjEZTmGb5yb4AZW7CRLGqNdH0HU7CmF1feRb_wXIh9l-EikNl3uU&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ai7R0pK4cmpRusS4PEfrfJ4q5vMR7YyY4_2YO1NRgMA&oe=69E235B5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsJPWn8U0O0Q7kNvwFGQ3Ky&_nc_oc=Adpygzh1zWd4NBKgBbwlcUa1MWr3n6kRvEO2R1ALIwndKf_d6pAVzjTRFwM4bmCzo9Y&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Wa87cBlQWmGFJun4VIN-rxySCQYjZ4BW81IvlswtJww&oe=69E24F64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opoDD0aKU5sQ7kNvwHGznhw&_nc_oc=AdpcTH5Xmz3O5aLtluU0ub5sToSriZxulJQSpm--Q_gJ8Iy1OFfpyHd1DjJ9WhmHi-4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h22iIxh-EwJbWTx1QwSptljraLtNkmXoGfONX6PtJHw&oe=69E23CA6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
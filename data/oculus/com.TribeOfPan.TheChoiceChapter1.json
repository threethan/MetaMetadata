X9lrp5j_hRVI3eHBO_Tx8RtYUoHFjzdaYW_eb1EKg&oe=69F8BD40"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtwRj7_oI40Q7kNvwEr6a-k&_nc_oc=AdrgqzGbjJKCSNhBxWyvg6uSJauQqxsyVMhjZwJJRqFGw7h9YBzn8PHikoU-zPI0fis&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1LeMk5X8wjoZG9Ts9rD9RbcuplEkKr_RHInw2nQXMIcg&oe=69F8BCDA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNEChKVeIrgQ7kNvwEp-VK8&_nc_oc=AdrIi2RROqaBC8eeskmdta7YDwaLHQF9BHXqh31LzoCVGzClRNENvqVZNhgXrZecmto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EdJ0g277PHsz7RP2Vmp3JtSKRflud9ex0brVmBC0-2g&oe=69F89F35"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mbvQ-XpQMUQ7kNvwHcLMST&_nc_oc=AdoHw-07A2OQd6CinDUkGzO6EVpGbGOXxPgVvJjqZGYeg2ofyAUiKdMu53nBSeE-STI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27W94-zPfBOzVYVpPc5Os3n3ROKdzqPOG44gCgV7BmDg&oe=69F8B8E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYbb9wHQgPYQ7kNvwFVGBMU&_nc_oc=AdrTqHS1NSTFh4eSBy89wufszflAIagOl4lvJFJ4q5hzz9wfc0e3vtZ1sQQKrQQeHMg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af38xoGy-9ZFPv5-tGwhzXtt5HaaysiwXCB80DAZgqDWBA&oe=69F8A626"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
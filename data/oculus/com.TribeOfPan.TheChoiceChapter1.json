6TOtZQfY6YtioFUrYagVbnFjnrlAkxsHIRH5qSvOg&oe=69FF1C80"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmaBXy-x6n0Q7kNvwFPk6Nt&_nc_oc=AdoyoSBFEMWVPuyBqCQzAtWwaVb93BNxOK_b5cF2VODNiVS4YwdHdvFpJs7hjPZUVLc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ea7ktmXcjmHEnusGJR4tOG0PQzI3HBLZbvYfhA8PNag&oe=69FF1C1A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1r-gRAuFa9gQ7kNvwF8kPMU&_nc_oc=AdoR3kie6HdQXOXZOTuXiB7-n08NZZ8wOeRjTpYW9ai_h5w8-n4qG6F5Us5U4hqskxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UVZV3JN0rLL7M7l4eLJZ8rgss4-jPrFvXnIB-ynTp_Q&oe=69FF36B5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi5CWKk2-0YQ7kNvwFUKXpo&_nc_oc=AdrxLFHBwPCDgQHoeuSTqP0i3qRvWJDFHeQzfTnP9NRBkRdG5r1N1kPUo3P6Llup21s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UOsUlsqTa2q-HEdYaI_V5T8yJhzP-S_ktAUWaAgPF6w&oe=69FF5064"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpiOtBJwTSEQ7kNvwF80qHy&_nc_oc=Ado5Z8shqrMgvaf4m2LDl7fuJghpjJnAVp4gTCbS5Ix5r87lfB0GPflYjak7oc8sK4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af416pdVYArgS4wAdz2p0fa6dCw36OHsQuONHKf3f7VxDw&oe=69FF3DA6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
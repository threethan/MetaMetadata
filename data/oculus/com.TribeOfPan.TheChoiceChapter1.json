WTyDqht0frjZk4U2aoKuMhPtSCf7EwjqA2INAbtgg&oe=6A219BC0"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZEAZ8drDoMQ7kNvwHJ3ts0&_nc_oc=AdpW_lTG9JVWHGqw1f40bD-tpfP-jUp7PJRjnQI4FA26Rg8BzfiWKRTgeXVdbLsG0aw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hZqC_eo-WxoeCpGU2vJIInEsgEe55WtamyaPsq8iU7Q&oe=6A219B5A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4kK1fVG1cAQ7kNvwEJkoT5&_nc_oc=AdqV9Av6U0TZOLlKKXH4WDEF_Q2yo2afGxjE5VOxGbtWNHzkr2-E7yBcNWlC6sZ2_d4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZfoUGKPSScDKWCc0knma7WLywJL4j7Cfyc7YqLkuOPQ&oe=6A217DB5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzXYSviMgIQQ7kNvwEpmd5N&_nc_oc=AdqgroQO2ocNk6lIs-EVNJkoxfC4Nt23MYRAD1uPY3xbbRpr-cuchrTBSPBRI0G3j-c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MKdus5ZkXtBa--uDYtCfJWnfA-w57iuqejTD-d5_P0w&oe=6A219764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zjD_C71UzgQ7kNvwF2SdV8&_nc_oc=AdrBkKYrkEGvQslCRY4t0A4Ko_AbD1hQlDZ9fESn4hbHGtF2KgttinW1SDQVkgdG25E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m-eQ_I_tRBMusQwJpfq6cZSQQ7KNg0_8v02C4_lbYZA&oe=6A2184A6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
AvqySkcO1lCRwqD9VQ-Rb0qR5FwkJfAHIn0DVOeZQ&oe=69FE0340"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmaBXy-x6n0Q7kNvwEuitBj&_nc_oc=AdpXNtOwnfvz4VnjuACvLTXxoVMH1c7Pt-uwi6opkXkcfZSZT7AE9g5u4jfYAhnbkVU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SLXBiDhMZaENwQNlME7W6EPNZFHpS7Z5vNinxYvxAHw&oe=69FE02DA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1r-gRAuFa9gQ7kNvwFvA0-b&_nc_oc=AdrERiOv9IuyAsMjftRl9E69IpmXd3XNHb9n5_Mocr36Sb0p0j7fRpLU02dDla0F3YM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QfqI-W8YVAj6j1kZYsLW0dIRdoembKz-wZ0aHAOxMSw&oe=69FDE535"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vi5CWKk2-0YQ7kNvwH5fct8&_nc_oc=AdqOEH_1dXKySl2SwEnenAwKawPJMG95LbzUGLIGHUSoApzV0bF2UfIgfg5XpY5GfS8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6D2Xt5MIBTRy_0aaqtb88NPSEaecueyzcPkCasxhJmdg&oe=69FDFEE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8kMgDGY3L_AQ7kNvwHdAs5q&_nc_oc=AdpS97nfoKzQvFq436IS8Drqv5wvC_m7iSOJs2wRcPCcsrgxKHGatuO4m1KtpqPbKws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Mq68MfNlUIDKgtLSQT7fUBuAQCsMn_bM91rLNemTAJw&oe=69FDEC26"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
-NsLsDOeU88SDtvC5Bf9PXaPj8le_NGdPjXHUOCDg&oe=69D0F800"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmw574f7_OsQ7kNvwGumCYl&_nc_oc=AdoQOYfgkax5Mb4ZWnVUulya3V2xF0I5ZdLvGB1PSujcNK8m58ykhtPeGLnsjPnPxbk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3iAQBS0uN1fN5MXafdrwzru_TdxuSX1pwfCBC3y0Mrg&oe=69D0F79A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rYzMMY7qRi8Q7kNvwGqOtVq&_nc_oc=AdpnHb92KcwBeO83Oi7oRZfTXUvx1L24wgiXnAOojeCmX0l2DPqoNi0EEICOj6y5jj4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwuETKtpbEHpjIGRZRLrkhPx8QSpG3HJcnouvGgPeLLQw&oe=69D11235"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCGdUU5Bd88Q7kNvwGDUUkM&_nc_oc=AdpliIsVmD3SjBVXwJXhvzluyRnrUuXNuCJ7XrJXEUSFanYcSLrEzBYEb5XIP9_alrc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYaYT_9O627sIHfmOP0jbhWC7o99EFK0fnSHeNKlufRw&oe=69D0F3A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHUmhArLwXUQ7kNvwF3pkoM&_nc_oc=AdqJsgGgYeCBBvvUaKen7Ao-xuayPW1lLuWSKBaDL8jjlvU5nwQvihLCONKbTm4cv_U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyQGOxN4K_eZRMbGUlEHEKHrjEfv-MTRue_RAOeeY-dHQ&oe=69D11926"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
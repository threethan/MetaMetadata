gFfyhxp8_f_tUIylrbbkatiKu89Q5OKJyOn3kwSoQ&oe=6A26E1C0"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAIKvmQyr-UQ7kNvwF8K5g3&_nc_oc=AdoY2Lbj6vIY6gLr1g_QRG0tvEO1rYYpQXgKfZyi2R1hkLvNkAudvE-P_qTPjKyyNvY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_k0dVCtzlGbS7tnYInF6xC6F5S_CqvTNGjpiQufaZPxQ&oe=6A26E15A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsTw1C5N9CwQ7kNvwFHKLLo&_nc_oc=Adowfl3dLJW2Zowu2C5COnoXbVbRWIfJ_NARXepqpkQizpSvBYUMa1YazMhQpyAqzzw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1KqkwLlO2gDkTItyGGcEtyn41xEWGzN-kF75FwENopQ&oe=6A26C3B5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnPrMNeH6W4Q7kNvwGtvnmy&_nc_oc=Adpnj3TpJoH00PSsTRJ8F8gp3hxTcVPIEGcHqPpMGGGKYFKr9tvFjXJfmlc3pPLZSvs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8r6IzmBXIG3ODRdKbP_PVFdPucgabq4zPi9mmZQhzJVQ&oe=6A26DD64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8SL15LAY1AQ7kNvwErG8hh&_nc_oc=AdpViTPvwFsgg4VNgiHMCO3KT4UcgQC5MOfksqO9-0qXUTtC_TzIdo9bkWgP3gHtJ44&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6pJ32YScrOAHOKVoRIUDHRdvfEXK8NyOuXZShJVR9ZQ&oe=6A26CAA6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
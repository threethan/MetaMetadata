BbvnAxte01LY6FzH0i4SkDbszj_GpxXXsKRa9kB9Q&oe=6A05EC40"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avGtsdWpLn8Q7kNvwGferCt&_nc_oc=AdpL-V1-xklPM-LKxUeuRe8sOEm-lfZ2h-8J0jaExde78PV-cgHA9R_vIHWP_F5Z9h8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zyWjGXpIQKUg_594WHxOMUYTeqmJWZvc8r9vy9AKX_Q&oe=6A05EBDA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOQfVyBoTgwQ7kNvwG7BzFi&_nc_oc=AdpWXSEkpqV5YDYa3fFq6RCNlRRjT_ay1zyWUCxDt38Fu4dW-u_ZE1qimnnmfTKqWJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZI8ZuKQdVXE7hH972LO6TEa18eoomquMdaL7AWvSikg&oe=6A05CE35"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMBHbwV8cb8Q7kNvwFDVoZI&_nc_oc=AdpxDXKWhzjE5ShCb_kLe_KJWquxm3s-prjD5mnWflfshRwI4QiWK7C6-UNMm45fmiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FBI241aY2lsnwlViiwH0Jk_jVab9NNq2kfyuAdgkJAw&oe=6A05E7E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMfLrFcCzVkQ7kNvwHR9i6k&_nc_oc=AdpmuJbZUW2YGnU_KPgubMf5ZZMrhq5lhfmwXFHWS25VaCGwApjCtZTXq3oiwpmKFJ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vyW1exJ_C4z29sE39olUTKxZLvUbNjYFT2BZw8_VDQg&oe=6A05D526"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
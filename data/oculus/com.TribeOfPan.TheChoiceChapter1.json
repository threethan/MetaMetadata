_IpR_3tnf2-fKl8Ncsq6cbltqR6srEJoNgIvw2oQQ&oe=6A1B0440"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UguYcO2v90EQ7kNvwEWPTyn&_nc_oc=AdrzPk88CUftNkMZVNPGbiHEl_y5eOSHG37Gt8UQE60_G7RETcf8dHuvvEvDkUQ6nVk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sa9oWc5GY4d4GkoXDxptbGuA6Z-_WtTxUMo2kvDCvlQ&oe=6A1B03DA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvHb5gWo0PgQ7kNvwHjZDC9&_nc_oc=AdobyTa-9hVzAbWYAVIrP8qq4wG2ZPVbY_PhXIvvc13kkzj84I_WoFaEsnRHRMCgQyA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Qg88LE70EcSuVOR4NnydA6xBdnqXS1716mu4e0Griww&oe=6A1AE635"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Am1VLkTOlbAQ7kNvwG4-dp7&_nc_oc=Adrl56hhhG-5caM8fg32jIEOvnphEmWtJl10uUeQ9uZs0E_ntPpWB6l_L6ROMJ9CAMg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ptBcoZrqvXdrZUFBsiuDjbSEgb1eNtkhm_XWmIg6TdA&oe=6A1AFFE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qTBfoqBj-kQ7kNvwGfI1RI&_nc_oc=AdpgV6EndGNE7f_fG3kJ5DskwSZnTiVLa0ri6WaN3cerJVJD4Qsa5Y3aL7t6nHLceWc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WzFi6Kr4xy1v5yOhN550fhJDFIdeq2E2D2H7H_6IOjQ&oe=6A1AED26"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
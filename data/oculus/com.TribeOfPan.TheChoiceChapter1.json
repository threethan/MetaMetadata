2pNsHMHAixu6om02g_qsgyo57eL2FwYJNySxPoh5Q&oe=6A09E0C0"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pl4BNMkRdhsQ7kNvwGCBixH&_nc_oc=Adr-Oqx5OizIzSSLSNROX-HY8TDMcB5LTc2ia1PDQfIdTlm3qVbgZdcP0vPKbF7TArU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NC-KWWSX_ACArys_rBVWLbH5v8-jFZ7fdThQmLASfGw&oe=6A09E05A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e16miQ_EvroQ7kNvwGxdQ1f&_nc_oc=AdodLHh8r1iaT9k9UhoE2Qw3u57vr5e08LPf1oKmejnvZjmCaSPL9FsdcGiEjngGUtE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YfDHDXCbfChWclq1ugrZsorL7A2bhmDZe0SRJc_jU1Q&oe=6A09C2B5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1620-Go6ecQ7kNvwGP8jTA&_nc_oc=AdqN-ENVasJbytRVDhR8FoIBtVNRrBOgZdyDJmicEnlk1e6uuz3bzGO-DgBWV4-tP3s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60wVg_bErEJOs-c4jaVwkUPnrf2DhvkTaXtysppveGZw&oe=6A09DC64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4Ny7zJWTHUQ7kNvwFG49A-&_nc_oc=Ado87J8GH1zW_3wXgBYqhQzkE2W8OVKS5joIshyyTXvgx2DYLCbPM6BxXEiUaZF9XSE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jNm8hlotPnpShlmll2blD0O4D5InNQxMUadLU2cEjiw&oe=6A09C9A6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
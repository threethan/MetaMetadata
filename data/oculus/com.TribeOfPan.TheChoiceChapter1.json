qNZ2s3EPq3FPVeYw_nF0ZkX5euWGxFlkUxML84vlA&oe=6A316DC0"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGyeV_tg_PcQ7kNvwEPnTdV&_nc_oc=Adr34En_i3PlLQ0A_SnF1e3DPzECWYdXv4hHIvhpA4UxZG__6HX4fis1txJBbQwZSHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ArOE5ssGOi0V9hMkYCcqjUqIIty6zOFoSdVTlg2qtnw&oe=6A316D5A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcXA08cOVjgQ7kNvwGYn3i1&_nc_oc=AdpP90EoL-rj5EllLIn9M4SmTEHV2lP_Ub_Mzs_FFBqwUdWl7RQ-I-Iq11Fu-WzASVQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IK3eUz1oUTaLUzTYJtz2gxD7Qjw_ckQ-1zRzipk3ZdA&oe=6A314FB5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPuSgIifP-cQ7kNvwFc0E9E&_nc_oc=AdppYc6P9DYW9gnrEV91yMiJVqJU-YtHwbPWF6nVTpXX1XoXkRb1edK48gmi243Stsc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nXlc2d-YS2zvwMTI-7PEn6TnDYIc_-FFp2_e6iABsnA&oe=6A316964"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5BeTSmvbqsQ7kNvwFcqRj-&_nc_oc=Adozgp9CiwO4eI7mXYJ6GDpFQRkNwbnVoWyLi2hl6mf1KX6McTJo0Fg1F5OpzgiaiJA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aXjBgoXnCl5KB-YDb_toqREmYUgZ7Nhk-yE-RdHpjtQ&oe=6A3156A6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
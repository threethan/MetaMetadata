L41rPuTWjUmwiiKDGiO55LiF0sO-yPsQra_c-zZVA&oe=6A131B40"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRkJgZQRDW4Q7kNvwHyuK23&_nc_oc=Adq-emPe1wKD1Q9GM8L5GkGM_f7bl4nMB6jSVfKnJUXGO2Zyf-CUH3Ben40tYSiu4UM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5anK_kqUkMNt9Txar_AOziCUtPqlzbt7N1GAQxwcKV0A&oe=6A131ADA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNc0zBRkAvEQ7kNvwHQVAmY&_nc_oc=AdqoGFzW16StsgL6VOG2sUvTwPgnVL-t02hf0DnzfmkBfjyK04pvTcGeYyagLeMhS3k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4noHsxxuwu1xPoCr2lqJ7gOz_fSwZzQagSGIJi2krR4w&oe=6A12FD35"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooQWRZL-WMwQ7kNvwE25Jhd&_nc_oc=Adp9J5ZsKTDi7yVYHoCYq8-Z40AK1gV6RJIFuJK-019ia09bWzo_2h08j2RgzMRo1vU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-7yxAJl-IHgqeOGMZwcKAPnSxMyczKBidajnhogysRg&oe=6A1316E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNjZGTXv_k0Q7kNvwGPxB_1&_nc_oc=AdpYxKY5iyvxATp04VgA5GXlHHjdG5BV95VrJ5P0wYJRwYRoeeGkQMozy01owHSiefE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EoxMC_A8xnwp9WNXsZx3sY7LfVI4T8NZGP-tU9PIaew&oe=6A130426"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
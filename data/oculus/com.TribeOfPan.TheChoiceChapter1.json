_I55aHW1pzGONGdsI1DaDbwwcqnXE2KCCE3iWde6g&oe=69D39B00"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALtKjy-6S0wQ7kNvwG1u8ug&_nc_oc=Adp8ELDJux0-m-DE8tnKghEX3pD522ZPMkiSuotUZmdo38ZWoPT2EUghSOWYNmGVHaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RCHdj570qwmuR-Wfh1C2y-k8eyiwgzisIHUilHM6a3Q&oe=69D39A9A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e3EVRS0THc4Q7kNvwEbdIea&_nc_oc=AdoH3HhABFAzaUnUFAYRYvWVVJLSb4lvJsv79R8ekeQFUXs6sWyIdS84hrECBU8Cc1A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SxUUfSEQnnHHkdZmNB4JiFDCyv2hbFi_UHNV9a-gu8g&oe=69D3B535"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCGdUU5Bd88Q7kNvwFrudEq&_nc_oc=Adre9jHrzJnBd9R3mXyGrMWZQViH3CkPoVE7JMty6mB3KDeuLfAMQgG8qzuC3ngYJLM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WuTDmIX4Iw9pRA1eKBPXS8pPWfjla9ygIfNRavj_jTw&oe=69D396A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yf1PDoU2qqYQ7kNvwEhSFtZ&_nc_oc=AdroFzo1I4pNUOYWT0EUWS9aQgcRwvyxpe89_3TwDJfmVA6HzaujLx2tZ5rvMa71F4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2h4L6ot-eWYIsCBgW5jzlh9h8XIXb-wf6yJq3HPhi6kQ&oe=69D3BC26"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
K2IEPOLXgTbUd9xdjtfzeH3QbR5anh3QGchI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmYq4Msw_8GoWLRSSDHg1X50s5bFL6P4pAqvRdJDHjzQ&oe=6A524C26"}, "display_name": "The Choice", "keywords": [], "long_description": "The Choice is an interactive VR experience inviting viewers to engage in a personal conversation with women who have had an abortion. The first interview introduces Kristen from Texas who shares her late-term abortion story. Through an interactive conversation, the viewer learns about her challenging decision to terminate a planned and wanted pregnancy for medical reasons.\n\nKristen\u2019s story is made even more powerful thanks to a very unique capture technology that combines depth with stereoscopy. Her facial details, body language, and emotional cues have a new and remarkable clarity.", "short_description": "The Choice is an interactive VR experience inviting viewers to engage in a personal conversation with women who have had an abortion. The first interview introduces Kristen from Texas who shares her late-term abortion story. Through an interactive conversation, the viewer learns about her challenging decision to terminate a planned and wanted pregnancy.\n\nThis project is currently in development, and available here is a short teaser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_gr
tRwJhf9Iz5_uNk6DYAemhfJJr6XZMsyvtbH-OkpWw&oe=6A170FC0"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQDvQFKVfuUQ7kNvwH8MksL&_nc_oc=AdqotGtVEOh_LShnvtclvMtTCpqnlyzgEuS2SClMuNs8LMQEnhJEE_vAWW8MsJrjagE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69R3lrrd8x5XIktgmsKFPUawlszIQ0meOt5H3qGteEsA&oe=6A170F5A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCx1coS6zskQ7kNvwF_iJgQ&_nc_oc=AdqNO6M5YWkZMr0KhzOntaULuRbDkXKO_yf06sy-VYTnLfP7gfKeOT6vady-UOfaaxA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ns-YbSwDWWplvHKRHKNVwzH54oKWiq0tf6l2nECEYpQ&oe=6A16F1B5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gk8KfCXAN4Q7kNvwFKUbiQ&_nc_oc=Adr66JAnrOrZME3EDYQ_2s3COa62yZ6e20WamSaXNVS1Nm98bHxqvjrUo7lwqSRSq_I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53H0QzXa-K0sEi3rNltWp7p9iPphNs92426OdHUIeTHw&oe=6A170B64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljUrEP9lHncQ7kNvwGmsjiq&_nc_oc=AdpN23O1QsYPXAXnLCB1K8YWNUN4F8boVmSEUAyqhhXQCIjB4raxkB4oTmy5TGcNR_s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74ZXV7WbHjSQoM2f5QGNx-wp8byT-5rpMwAp_py_D7nQ&oe=6A16F8A6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
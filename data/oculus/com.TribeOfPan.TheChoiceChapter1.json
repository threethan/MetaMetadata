i2Oqq9W8Rz11P1RedPMtV7ZNzxfqa3MzrQ_wCRZLQ&oe=6A356240"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gOAnu2w-mOUQ7kNvwFfaYJP&_nc_oc=AdocAXF6ur82ZY-NjcfQ6-pmDxk6e0b7sLOV2WcSqmKXoXdTeSts35UShmA2tOO-7q8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eprgjALMgUYgI65kQc_NrMKbcr_aGVZnyY2QhGhOG9g&oe=6A3561DA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Is_1w7NMwkQQ7kNvwEm9qY3&_nc_oc=Adr8SYSHY4BLUsAs2b9aZ2-oYpUajcR1v9llrHTvS0UF0Lw7nUk3PIf_1ReXQXPW3XE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ldZ_dKB_4ILD7qoUGWP8x45t7XjXS2hFelbYdBbS60Q&oe=6A354435"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20t69Y5gQy0Q7kNvwGeHXIe&_nc_oc=Adp6u6Q896R_q6lXizp8QY5rOg7ukc-9UnHq0mKmkhenQ0cj3JcpiLvueebpzLqM2j8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HUvneUQGUo_XtXi5YFq3NU3ywPGFgLDtLpf3-f4gecQ&oe=6A355DE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvyaNsl4mLsQ7kNvwHwkgJc&_nc_oc=AdrOgRBv7MKvlkqrO_H94keKo8OBWuiwZvYA_Bjh4agetkdwVoDSc9x_yCTjZJltoBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Tdx65dQyfFFgOiJ8px5vb7Ey0jDhiF8D-Q-XZ6hZ8ww&oe=6A354B26"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
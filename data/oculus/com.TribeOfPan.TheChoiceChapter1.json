SHDFYJB7AVWpFm36jFhCR-_K92Ko05XlvEBvcJDqQ&oe=69F37740"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7tB3K2IFlAQ7kNvwHRLAyc&_nc_oc=AdpIIkfEvGFWy881NioyjgfBEaOpWHrwpUPBlPZW0IfZ179-9maYxne6ITYZ0FuK6fU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2t7d0VJJctGZQCwugCfneGr3VgwwhW1Bc6Q71GUVZcyw&oe=69F376DA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RKVWv3Y7MsQ7kNvwGauxCh&_nc_oc=AdoaKhbH71ac6UxJdtzsINFIfTtsdwqnPk-3VMIKGnFfd-qzji6EHl1MbPX1nS1gXBQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YwnC7WUKNtmK-uaFPEZ85zi5t8x2Y5d_Kap-hgloxDQ&oe=69F35935"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxuzy-G83q8Q7kNvwGph4th&_nc_oc=AdpA7tPmhozOoxWPFsUklflmfXgV7fmSAshoqyeU8Mr_F7FwxlgfCJZ2oiKtrtg4f4g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2otrL7g7ZLqrsdTKqjp550eyBmtkmxmJCA3aHqGt1QTg&oe=69F372E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDy_2mC5wGwQ7kNvwHCwBf8&_nc_oc=AdobWxo7Ug0GWVELiGJheFQ2ZM9qV00at-6VlB3E4DPU_GV0161VVbCZbBGFgvZsyM8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0el-iFUW_N1cwfxYiRbwEecn8kIi_CL4K-sAfQ9Pphzg&oe=69F36026"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
os0oFdPkWP9CSV7wZIadkYG3-zO8T4Gs4LWEo22Hg&oe=6A32BF40"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGyeV_tg_PcQ7kNvwFmjf8q&_nc_oc=AdqnP9h8U59xfWnvy4mckNcAM6SWLFNIF-XgHA1wraXcld4UqPProiJ6_lmt_FP9Bo4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KO7pxo-HuPXJNCmUjKTQ6570XexrXvg4kM_9jXXyn8w&oe=6A32BEDA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcXA08cOVjgQ7kNvwHFJXbz&_nc_oc=AdrlEub0NFOKltEZgJWX4gMrZmz-IR3TIYV2pGjKZAxVMoL0VuIa15tczV0HDXNa4xg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cZFszs7FrGndQK-xPIYivFPf1nhyBVViju8pVzoJnZQ&oe=6A32A135"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPuSgIifP-cQ7kNvwGE8oLC&_nc_oc=Adov4tRepPkn5cXwZdEQC8Jl5ItRJiF7QnJPobD42nwvsmkhK6VXY0PBhFIQLa0IaJ8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DgEktsMXR1L8sDHXv9vHmnmpT7IIz4QYU6loeHsB9MA&oe=6A32BAE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvyaNsl4mLsQ7kNvwGCD_US&_nc_oc=AdogteimX4ROYPU3TG6VjlKjcKSM7qhsfunAOYZF_tk7v_0tFbgkTiaCsdcz8Tl5SXk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dsM4T43_rlaYES2SXtgOIMJZooJy0DbGRTKAZFHgZkw&oe=6A32A826"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
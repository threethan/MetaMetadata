qvoKvE0VT7ZVkQo0E3xUC8gYW5XOa6xTt1H9lgQQA&oe=6A3AA840"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf_mrDmFUKoQ7kNvwE7RIvD&_nc_oc=Adqz7TEofETHwH7zN8-kIuTbv3prTIyIGXg1EmKIr8pGzSh51mU0j9gTnenBfD2UOpc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NH2YjHV53_IhUalHNjdxORFMwWTgiq-Lr_SXhnEHEfQ&oe=6A3AA7DA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5vM7a6nUGcQ7kNvwEuJAU9&_nc_oc=Adq-nuenmxdS8TXmTMhPMp8hD3bwTr5sZFEdbmRfvSE4e7tICYP3z_kn3w2GKdenBDc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af826eBbd38I1ZXJMI4b5OTU-ERju6b-Q5YTTVJwT-fIgg&oe=6A3A8A35"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61MPdcP5VJgQ7kNvwGgfK1d&_nc_oc=Adqf6QEWq8Tna3-AhTtlO-UJfwrwSMBG6n0nrjt9ilSSRqp1E70D8NMlxdws8CnThrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h9Vmjf-JWrmds2phVOwLR2nlytHGEuzIl0fcR0wcOfw&oe=6A3AA3E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sItXwCVzasQ7kNvwEiM-p6&_nc_oc=Adomng0WgIYmITdEPN3N3dxbyE0tRW8Due9b8p-N7U6yv2WZDhtylk5193IDdkO6pd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RnUJSl2fd5MziivQyy5aYyFyMn2p-tOlePLNmAf7B7A&oe=6A3A9126"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
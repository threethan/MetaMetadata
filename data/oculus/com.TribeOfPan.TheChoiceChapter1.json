xw4G1cY917vnVi6ma1i2GAWy_PMyB5E8jAPzFufDA&oe=69CBB200"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZaYNxAnchoQ7kNvwEGNOX4&_nc_oc=Adq4bzobq-ITpvNlojDls7vSGNLI7hjQDkdVEUnVnHYblJR0m-wtuNWZySI_9ggcwYY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYKkJgW6y2qFYjekoqfx6480CwtwKcvLcUMLx8sfTH1g&oe=69CBB19A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmNy1cknp9cQ7kNvwGcqD79&_nc_oc=AdoS7FsRMBbB7iojvFZwCOX_c9ESgbcOKSWx9XY1TFZwhYfA_LMaql_FVAwjgZOLUzU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzbVWGCCSlzOQTpVHObHzZgccrsIJv7i-Mwf3dmaAyWiQ&oe=69CBCC35"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojVM5c8hSEMQ7kNvwEjIRKR&_nc_oc=AdqZ1o2p4um-AksNN2kzmqF7cQ3eMU8pXfn7hUdv6j_SEs604CZG9PEKUTKzflt2pMA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgITQh8vMzD0jSxWdFEP0CTqLsFgV9W-A3OEmC84stpw&oe=69CBADA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0sYwdBN8R0Q7kNvwGsvDuq&_nc_oc=AdrLOjC_avi2Zz61gfwQY2_KfayDlksr-hbp2jIlR90yVMjzsotQFzBhRB0V0X70X_M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxgFEx2H7f5aRiEI67b_SO0HWaJA98XYgkRdn_8maGRlA&oe=69CBD326"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
MYkcN_LHCC0pD5DeftdGzrgDpgyYL1OrekF0xZWlA&oe=6A3D4B40"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UKQpfUmfR-kQ7kNvwG259kh&_nc_oc=AdpIYnLg9d454ikqemCkTKnLGcECiqCaGPtSL73CIzqX0jTrR01hIruJuiF2NqxbfEM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KqFfb-IoGSYLa-1YqDDX-8OWHNWTVNmtCJP9tj9vUog&oe=6A3D4ADA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKO3tAVbVeQQ7kNvwHy2XpW&_nc_oc=AdogFdf5fnMpfnuu2cYHtv66L6uH5RA7ZWYtrnHK-NtVx0Fbkiczg1WNVk1HXD3g_gg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J5FH3YwOStV7j-FmR1P9ej9j_Q0czhDjAGyY2MZkabw&oe=6A3D2D35"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuX-ABfHh68Q7kNvwFjzBni&_nc_oc=Adq1VmAcAB679iZIWkQIXio_oRKmru07QdZtMaabljj6oIzcYjszKjq9SuriVhnNg10&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ibjeLZDKTGKV7YH5lU7lfyaOQbGmrZ3rfnaUEgAbGAQ&oe=6A3D46E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8sItXwCVzasQ7kNvwH4Uj6P&_nc_oc=Adq-ctg5c5hWSV85V0UZaor1FvjoyNegwJsvGD-vhYjBG6VI4UY3EwDV-4IcCIqjaxM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jX74RUP--9nnawiiWJhSlceEI4KJ8c534_a2QGDYlIg&oe=6A3D3426"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
83tG1-Qjig1h6p8P024ioWwERx-nsGoaJbc8UZGEA&oe=6A19B2C0"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UguYcO2v90EQ7kNvwEJpeUp&_nc_oc=AdoBzGdoNNEU3UN_GFxSPCdWbD1unrwOqcJFKVxvtmJVxrLDmApkQIEQjtfKYO6iQkI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NQ1CrdnMAqtjNRfFsZya-Vu8_pVG3GC1qlJCutBiAHw&oe=6A19B25A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvHb5gWo0PgQ7kNvwEOMl1d&_nc_oc=AdrlHahLU81lkcuSSEAL8y1DqppjCWH8p7V1u89zY2iYDBdGwrqIxW-dncl1nt1qrF8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tqsI7IHSks0FSto7CXUJf-pDOgQw_3p-DGQquOnwMgA&oe=6A1994B5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Am1VLkTOlbAQ7kNvwHE9l36&_nc_oc=Adq3ybMOZNd2Jkko5o-JryKvnvZVbVapymdsd-Q2HL0NXwuYVi6297vqrofQyUTAsDg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cTDtzXcnaAErmCq86JKRpppoV2vF25gP6Nxhpr5n2DA&oe=6A19AE64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ljUrEP9lHncQ7kNvwHAMxIy&_nc_oc=AdqtdYRbtgHvSLl8hLhoraBd2_1C69yvKolNjtAsrN-YFMZCnipBarqEsO4Ey6vkoDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a21vV3S0F3pFjb-5hKJvL01owiOFYTTskSHZcJ0F7vA&oe=6A199BA6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
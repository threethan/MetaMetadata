f9gi3sLsqTYhIIAKiRNNq8PXoSFVcd4pYmg_hQkvQ&oe=6A243EC0"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZEAZ8drDoMQ7kNvwE2BIQe&_nc_oc=AdpODntl0YM20A9YqZlGdWUDll4poJtnF6_tQCMdsEE4GPJsIbkGy6lFoDtgXS6ieoE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lkQEY1D7s2HjaCc82vYbUkhAC0QCQyVrQiiVBGdhqWg&oe=6A243E5A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4kK1fVG1cAQ7kNvwE40nj_&_nc_oc=AdoshEuSGbEe8y9FlySPD_VTMRyu_JEY6UoCaXRSMyZCKrhR9LCN82Uug_8NxjJ1HyE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SVl9fx7gr3RQCy8_pO3Z60l5XEW-v69MGhGSsFLYyOg&oe=6A2420B5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VnPrMNeH6W4Q7kNvwH8NGBZ&_nc_oc=AdpjuiPdYXC1Nt2nZZuUqpvUoWCHqbUwkPjAVoCItwtil759DXJ7vN7k465tdX9G3p4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PIOCtjGsYEywqDDTMtY_5Z7-v139nmSHrjBO20vmiGQ&oe=6A243A64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9JCbv-GmwoQ7kNvwFktMGh&_nc_oc=Adqws9gdD4OAT20mUrktMwKlHh3Y-jAwmta_ZTED8r7wU6xAtbLhrfPlFoJ64etZYLU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tc-Q5xFpm_NiU5zDr65PBVRBlBY_pC3KnmYNwJ5KfpA&oe=6A2427A6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
BtO_Ey9aSrcQauzFBhuOnuArDgIVgXExcUt71gQqg&oe=6A0F26C0"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DW6DqdyKrEQ7kNvwFLjtn1&_nc_oc=AdqGEK4URWzFahbH1O0ByxTDY6HyKpJ_qA8yJX1hhGdGopOo7KD28Rs7omTkeweDNRw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JaAM1RlQHTDiVtDosk3pIlY0iBbswfIST-plzcjwUDg&oe=6A0F265A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-w8oKtWS6EQ7kNvwFMLqGa&_nc_oc=AdqE3MV6MgdIrstt5XrnOA_IBuU2_iDGLnK_o9-f8ZLgm_-nOB9-FAoeqnnIWHwXB0M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44dpf_tuWoIgemCczt3ZTQSRV61cd9MxewwWCfC5hXFA&oe=6A0F08B5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBua822P7IwQ7kNvwFYhnuF&_nc_oc=AdrijUFgKonEsknImTWT9JVBhFZK_KyJjsC_WsAoiDX3sepDPzrQb-1Zx9Y2BQ6aemE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fHNEa-SJ0Jdp6xEo7zducEKotxfaFY5pPSvtoVe6g-Q&oe=6A0F2264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPtTv8odDxQQ7kNvwHyv7AW&_nc_oc=AdrEmshdYR7f3PpElNeYmL_K8Q0koBpUcJAcVvTAdjoGNFO5n4UNst2Fj3Z1-XQt2io&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JA8d2yxQQ93SPNRV2MdpoP4or6bBgwN4US0vnCpu9YA&oe=6A0F0FA6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
QhM6EXld94OglKZJ4lDFtBXrrXnSj_qfQKuSQnH-w&oe=69FA0EC0"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGAltcaEeTcQ7kNvwH2-zxt&_nc_oc=AdpqintspDwZzO8h_Uv7c3h4-lJk4Fu2_mkkiBRbxY1X9yVvmmQqUHoEpUNH1SswEew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mqL2ap02d57VGro16be6aK6y-a_Pfu7t4sIF55zT55w&oe=69FA0E5A"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9klw3fnO6MQ7kNvwEOBfXs&_nc_oc=AdqyCsRj-w-Um1riuhHa9WSOrVntM4RxK7VUFOFIHOK_suAy0n52ZadNpKwPZEIqBJY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Tm3k8cq3HvFsoImx0E2Cfm9YCiZyNolPjj7WKrUsRyQ&oe=69F9F0B5"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mbvQ-XpQMUQ7kNvwGOAQkB&_nc_oc=Adry17redcECyyMUUqnzFjchFcKh4MnG04rtA1WNagFRnIJNegw4FPMtI47cknq-7XA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M0c3m7fZkDe2MClI4ez6RImpQtPdciqEkpwvyQGdQGw&oe=69FA0A64"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYbb9wHQgPYQ7kNvwGmoPM9&_nc_oc=AdohfOUu_9zbkxidZCRg3ZpZ4OeRF6VARogObzP1H1fOwGwOBYQrdVgKoeN5DRoM4EM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V4A-P4S_j9Py8voWCbeufL6Ra2LMTPeYU8JwfBMXAug&oe=69F9F7A6"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
VUc_prun_Y1n0uVL91N451IysLM2u1uu1jMMEL1eQ&oe=6A4D1D40"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n-_e3NwSZYEQ7kNvwEoxd9D&_nc_oc=AdrFTuEAkZ34oA2f5MJJ9QDH29R1qMoNfSbOYUN6QL7vBskDc5-gLkhW-Psx17dZl_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjvsqbQSTlibcXVgyt7sOib5rrS17vOgVlGh7aGFWjIA&oe=6A4D1CDA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dszCPJNUEtYQ7kNvwEyYBrW&_nc_oc=Ado33DXstotwxfw2iBANxrpz5KT1iPr6ky5o9dEUn5u9_FrEVpm-UCkk92ml5UlEsn8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbbjZOQOsr9JS5XKitkpt8wmt22CuAqj6kWP0okNjOLg&oe=6A4CFF35"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgFoOaBoK1EQ7kNvwGB4Ryy&_nc_oc=AdrWCcrj0j-uBzeN9WjHG6tDMASAJxOwHiQlzxXHSaJRi_7KbtFQTRipJ6hTBuths8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQbcgD1EcEncEmKWumsKtVJ-LhdlGplv1romUf34r_0Q&oe=6A4D18E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keHCnz07ZRUQ7kNvwFctHAk&_nc_oc=AdqgVlqPidqzZ8xd5rn1e7QqKuH3ZziQmvRCB10hS3KN-N9U5XgMlgaPZ3ouFssb8CU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa5aWcIVhhPrSZ1BEbI6dbCr_84QjuwOe_-anOEbjZKg&oe=6A4D0626"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
Zg-etcfMtRnetVZqF-WnFfr4zDTibrXd-JiV62v5w&oe=6A034940"}, {"file_name": "Screenshot_03.png", "id": "294515802452892", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974904_294515805786225_2812237055007873962_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0seWYM5TL4Q7kNvwFqhfxJ&_nc_oc=AdoCR02QriUBVdaEx_6xSi2AhRO79cxQZbUKA46ZcvTEAIVGytO4mXWzqdhcfvOGsy8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47NgwQ2pOGA1AkgJbrMSQFOehZ5HJb3UUzec1ecZqC0Q&oe=6A0348DA"}, {"file_name": "Screenshot_04.png", "id": "509157983493178", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_509157990159844_8803311728382954972_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sOeB2jcZqKAQ7kNvwHORh-X&_nc_oc=Ado14q7tnmmMXncYbx4fFfBP4_S1F0ZuQs0LqNo2gXYhWSjINHBEtqzD8SipX8U0cuI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TgxXJQmEHkOU5x-KWPaNpBontcoSaQ3XbGIxYzYyzzg&oe=6A032B35"}, {"file_name": "Screenshot_05.png", "id": "984974365691177", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974750_984974369024510_9172211031033835620_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PS4zI1X9ek4Q7kNvwEYxP0x&_nc_oc=AdolcNs7UoEb2GlXFjT5LtXHS9Un3l2F2M-jbPkcYEIiB9t3YqYG9vKPGznfeB95QoE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gnn9-ReWbYWjR9Rmo33fbIBQuDYKTY8P3vqeTzlmA5Q&oe=6A0344E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TheChoice_TrailerThumb.png", "id": "159707529705124", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982502_159707533038457_2023841811780682826_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMfLrFcCzVkQ7kNvwHZhow9&_nc_oc=AdqcVclnkHlTBQReqvFL8GA2qZM-Mt3I1wO6Ml__kldpg6RWeJH9y0kiMjZLXlEQ15A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZOxuzCFdExJWpcwrwE5CE6YH0GNJTLIG3EJ2kHqDAgA&oe=6A033226"}, "display_name": "The Choice", "keywords": [], "long_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n\nThe Choice blends techniques from traditional documentary storytelling, volumetric video capture, and animation to redefine not only how we tell these women\u2019s stories but also the agency in which the audience experiences them and connects with the subject on a deep, emotional level.", "short_description": "Debate about reproductive rights is often heated. But behind every family planning decision, there is a human story. The Choice is an award winning virtual reality experience (VR) that lets us see from a different perspective the emotional and complex nature behind one woman\u2019s choice.\n\nMeet Kristen, a young Indigenous woman from Austin, TX, who dreams of raising a family but instead finds herself facing a dehumanizing system working against her survival. \n"}]}, "developer_name": "Infinite Frame Media", "developer_privacy_policy_url": "https://www.infiniteframemedia.com/the-choice-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Infinite Frame Media", "support_website_url": null, "website_url": "http://www.thechoice-vr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supp
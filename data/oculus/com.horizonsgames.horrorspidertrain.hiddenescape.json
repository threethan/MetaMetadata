ision matters\u2014can you survive until the last stop?\nImmersive VR Gameplay: Experience horror like never before with fully immersive VR mechanics.\nWill you survive the spider-infested rails and escape the darkness, or become another victim of the Horror Spider Train: Hidden Escape?", "short_description": "Survive the haunted rails! Escape deadly spiders and uncover hidden horrors on the cursed train."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/horizonsgames-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "HorizonsGames", "support_website_url": null, "website_url": "https://sites.google.com/view/horizonsgames-com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25594279676848730"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1413804250587866"}, {"status": "PUBLISHED", "id": "1515534263501344"}, {"status": "PUBLISHED", "id": "1512157417202841"}, {"status": "PUBLISHED", "id": "1522155316103803"}, {"status": "PUBLISHED", "id": "972293841793897"}, {"status": "PUBLISHED", "id": "1270233838358821"}]}, "baseline_offer": {"id": "1270233838358821"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786726800, "status": "PUBLISHED", "id": "14138
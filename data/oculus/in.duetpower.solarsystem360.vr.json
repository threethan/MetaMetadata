_nc_ohc=xEJS9tUW03UQ7kNvwGh25vr&_nc_oc=AdoDz1RRmWyTxHWVUi4pJvzUQpUASxVh_PC2wZjJtyOF5EROiUvJKaOASunAPhlD77c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-HLhWcWRDXwrLmTC_0FZu6gaw6adzaKXeKXZuVhHeMQ&oe=6B085FD3"}, {"file_name": "SCREEN-4-chandrayaan3.png", "id": "2238116037130387", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499624583_2238116040463720_5151426307279300467_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or_mqThbZmkQ7kNvwHeR5j1&_nc_oc=AdozJkTn3ymfj7WRaQnBEVQZ3d4wrW1V-kxAY4chjCckyFEQpJkXgW7j3gVG9zpZ2N0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsK5lXErAMUpleSNLLz8ob9sxDct2Q_4xxTmXtqstYgw&oe=6B084A04"}, {"file_name": "SCREEN-5-compare-sizes.png", "id": "1439977721603817", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593839439_1439977724937150_3653970249898361498_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsmsGOePtW0Q7kNvwG9dEns&_nc_oc=AdpIu0yXguDPX1mQ9mPNzMs1MBb3XmdEhI6VWWw4WlmKnJojJ5itE-laeGqTQGHpyFg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmP7Ci2trAvWuxWQW_ecuh_5ncQ3OTh-vTRVza-bx0IQ&oe=6B0856B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DUET Space Lab VR", "keywords": ["space", "astronomy", "rockets", "education", "planets"], "long_description": "DUET Space Lab VR takes school students into space, with real distances, real textures and real missions. It is the VR companion to DUET Solar System 360.\n\nStart in the lobby and choose a place:\n\nSolar System\n- Space walk: float among the Sun, the planets and their moons.\n- Planets and moons in 3D with NASA surface maps and facts, and a size comparison.\n- Stars, constellations and the Milky Way.\n- Real spacecraft, including India's missions.\n- Landing sites in 360\u00b0, and Chandrayaan-3 on the Moon at real size.\n- Tools (your weight and age on other worlds) and a planet puzzle game.\n\nRocket Shala\n- India's rockets on the launch pad at Sriharikota, and the world's rockets at real size.\n- A build-a-rocket game, rocket size comparison, a 3D museum and 360\u00b0 tours.\n- Orbits and India's space missions.\n\nPoint and pull the trigger, or pinch with your fingers. Left stick to fly, right stick to turn. Narration in English, Hindi or Hinglish, or off.\nWorks offline after the first launch.\n\nFor schools: full access comes with a DUET STEM school subscription code. Without a code, a free demo is always available.", "short_description": "A VR space lab for school students: float among the planets and moons, compare their sizes, stand next to India's rockets at real size at Sriharikota, and stand on the Moon where Chandrayaan-3 landed. Narration in English, Hindi or Hinglish."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ashutoshduet.github.io/duet-lms-media/space/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DUET Power", "support_website_url": "https://ashutoshduet.github.io/duet-lms-media/support.html", "website_url": "https://ashutoshduet.github.io/duet-lms-media/space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hi"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1306446612560989"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828028_1360099179326458_133439990
EDE7"}, {"file_name": "New Project (6).png", "id": "1491631045150184", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300929_1491631048483517_2066411197839307666_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghkbub-aSZEQ7kNvwFC4ksY&_nc_oc=AdrkEv3NSrbVp_CHY1tp9dixWEhJ9Lhp-L--62ONz31lLhFnH3vt2SqVcKeAKMAOcSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcMnUa7eWFScY2NnkfG4KotGvW-RwRXBp8AKuJt7ex9w&oe=6A50FFE6"}, {"file_name": "New Project (5).png", "id": "2466677753668060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295547_2466677757001393_2353131284551362229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sajpN-1nKY0Q7kNvwFXYzcW&_nc_oc=AdokNUvEvne98b8Ag7O3C0wOVILXB4C6QDawnl-gy5RLd9tgx0HgZJfZMFT7h9GnfVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe5FaPttEE0LXz8p9_XwFjC7opVTGwH6jVzQ46GX1MZg&oe=6A510A37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (20).png", "id": "1541806216452131", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974913_1541806226452130_2974751808429784036_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NU3Uavui-BQQ7kNvwHqOKk-&_nc_oc=AdqmMjHVRrwQr4LRGj_lWilsM69rYHbSG2IrTFPUsw-MEMBMT3yCwUtoG6tqBPFZLEA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHtU8uBFi8RGNa0LVkRltYqJuypKOV5jRqJ5PDOPw4aA&oe=6A5115B9"}, "display_name": "Primates (New Game Coming Soon)", "keywords": ["Monkey", "gorilla", "primates"], "long_description": "Game Development Update\n\nUnfortunately, this game has been cancelled so get our new one Manky Land https://www.meta.com/experiences/manky-land/24582836298019303/?require_login=true\n\n\nhttps://discord.gg/n5GHbKd44Z\nBecome the primate, hang around on the branches, or get bullied by the little David in shop. Or, get some style, with more cosmetics on the way. You could even float in zero gravity, listening to the beautiful music. Go into caves for a swim, and discover something new. Here in primates, you can find something right for you.", "short_description": "We are primates, we swing, we climb, we run, we bond."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/primates-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cosmo O9", "support_website_url": null, "website_url": "https://sites.google.com/view/primate-official-site", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27221940230809202"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/227894857_1072013821085163_6910026801743547415_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b637scDgiy0Q7kNvwHDr3rP&_nc_oc=Adp2semt9uG7EbaX5pHC2Mri5siQgfRM2uKo5Rdyz4w4vITtpjV9Uc3bN7BNin0VFTM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdRqrHNOkoHHKGC88t6DNm4J1hrMHXlR2pGxIXYLEhPA&oe=6A50E715"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Primates (New Game Coming Soon)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1709763060, "lastRevision": {"nodes": [{"id": "7164665536963301", "release_
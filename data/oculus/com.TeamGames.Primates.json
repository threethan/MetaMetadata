dn.com/v/t64.5771-25/499626152_728708662938268_7898361092488105408_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4o0Lip3yToQ7kNvwFjJZnz&_nc_oc=AdoxiSF4-6MNAwxQU1e3PqYc97qOenofH4a10kgxu5g1vgfOj8bJx36gvz8t8mZneRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhJWUh3tQ2QnYYC0OsyIaUlPWCB_iHh89ohQcVSCo1ZA&oe=6B047227"}, {"file_name": "New Project (6).png", "id": "1491631045150184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300929_1491631048483517_2066411197839307666_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mwQlchPlYwQ7kNvwGX1qNX&_nc_oc=AdpJR0RVCwRyJRhW89XZ0xs1oNU-4GcuScSDVZZyXrZgVTbeBhKiQ-v5xKC5M_vY3gc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnPMOhE3XX9kDLtcyctUHV1syaLcsAA4xsxv_T-Fnb1g&oe=6B048426"}, {"file_name": "New Project (5).png", "id": "2466677753668060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295547_2466677757001393_2353131284551362229_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjrHc88eeogQ7kNvwEX-LW2&_nc_oc=AdrewbOriWdrK8niUyBt9ccsVvPEn4eSK4rc6xP-QcioVEKyR-VEmNC6ZWbsNwa-T6c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSOX1lAf8pLW-h8bvpcXFzGsdkB6e0f3jBZX9d2LVsUg&oe=6B045637"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (20).png", "id": "1541806216452131", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974913_1541806226452130_2974751808429784036_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l_MKbrGD18Q7kNvwECOYTX&_nc_oc=AdqgwOtbS3e42PlNE-w5VgO8JWUMvd1ln1t2-1AEvHOuicT_qYEK9SniDy-Nj4ULoCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmHevz66_62o_dGeGTrGJwF1Qm5g9qHskniz8RMMrZVg&oe=6B0461B9"}, "display_name": "(Get GorillaLab VR NOW) Primates", "keywords": ["Monkey", "gorilla", "primates"], "long_description": "Game Development Update\n\nUnfortunately, this game has been cancelled so get our new one Manky Land https://www.meta.com/experiences/manky-land/24582836298019303/?require_login=true\n\n\nhttps://discord.gg/n5GHbKd44Z\nBecome the primate, hang around on the branches, or get bullied by the little David in shop. Or, get some style, with more cosmetics on the way. You could even float in zero gravity, listening to the beautiful music. Go into caves for a swim, and discover something new. Here in primates, you can find something right for you.", "short_description": "We are primates, we swing, we climb, we run, we bond."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/primates-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cosmo O9", "support_website_url": null, "website_url": "https://sites.google.com/view/primate-official-site", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27874393215563897"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/227894857_1072013821085163_6910026801743547415_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9DOUBco6U8Q7kNvwFLhwOg&_nc_oc=AdpyvYgJ9l3XmzmzOLCPNjfL4n3Ss2Q0r_hd9R4aX-eaJx0sWkNH8LmRrYiKIu3Feh8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLTZb8yDBs-W6wDkYvv63KIcDAAKgXMYnFj2ZY
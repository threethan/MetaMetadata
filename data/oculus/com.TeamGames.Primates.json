t for you.", "short_description": "We are primates, we swing, we climb, we run, we bond."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/primates-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cosmo O9", "support_website_url": null, "website_url": "https://sites.google.com/view/primate-official-site", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25927866630216575"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227894857_1072013821085163_6910026801743547415_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rHHPvu_uumsQ7kNvwEftZbp&_nc_oc=AdnkZNSniPYI9XtsjkFrfFvOD8f8RcjU_7PLIa_b7g09eoqiipoBRwBINZL6It3Mvu4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw5Pky-tD8Wk3LPxdMMKKkL_cKVwHmoSpmRv6kEhKWMag&oe=69B94A95"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Primates (New Update Coming Soon)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1709763060, "lastRevision": {"nodes": [{"id": "7164665536963301", "release_type": "SCHEDULED", "administration_status": "APPR
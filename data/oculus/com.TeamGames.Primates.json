3F67"}, {"file_name": "New Project (6).png", "id": "1491631045150184", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300929_1491631048483517_2066411197839307666_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghkbub-aSZEQ7kNvwFwTkWd&_nc_oc=AdqnrI7cKs2Z7-XQ7BviDUAuhxeUKUGOXLlBfw5AezXF9DphNQ5oUy-JuFkKHppPZSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN12K1AIdhJZWc3FxL7G-ogkZ6OGgvFLkdFQ-8XBkqqg&oe=6A525166"}, {"file_name": "New Project (5).png", "id": "2466677753668060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499295547_2466677757001393_2353131284551362229_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hS2T-H2kgYcQ7kNvwFl4KrQ&_nc_oc=Adq--eIc4lzbfeVRkwHuWgzbeZqwFqMAr8KPBlDv0nVvLkTqxW4riYJijJtMVrYmbkw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPGcanfwytYs-EbcrzcVyWhI0IUn34-ls4pqwVqjFoCQ&oe=6A525BB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "New Project (20).png", "id": "1541806216452131", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974913_1541806226452130_2974751808429784036_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NU3Uavui-BQQ7kNvwFWrHP3&_nc_oc=AdplU5XHele7QOr6rJttP1yJ64pLGdVnq_1MJHseiQ-xmMrTdAUScWBRS1bl2j30bvI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYvQNr7PMnixI5P3fYgE0Uc9AcMWf2QsxLzXRmT1Zmaw&oe=6A526739"}, "display_name": "Primates (New Game Coming Soon)", "keywords": ["Monkey", "gorilla", "primates"], "long_description": "Game Development Update\n\nUnfortunately, this game has been cancelled so get our new one Manky Land https://www.meta.com/experiences/manky-land/24582836298019303/?require_login=true\n\n\nhttps://discord.gg/n5GHbKd44Z\nBecome the primate, hang around on the branches, or get bullied by the little David in shop. Or, get some style, with more cosmetics on the way. You could even float in zero gravity, listening to the beautiful music. Go into caves for a swim, and discover something new. Here in primates, you can find something right for you.", "short_description": "We are primates, we swing, we climb, we run, we bond."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/primates-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Cosmo O9", "support_website_url": null, "website_url": "https://sites.google.com/view/primate-official-site", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27221940230809202"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/227894857_1072013821085163_6910026801743547415_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b637scDgiy0Q7kNvwEQ4Q4i&_nc_oc=Ado6HZJ-cFgSAru4w6LI6EW85SYXmVOmFprgPCka7zpHPP7POcle3uYVLM9cPDZj69Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-bRnZuRG5yaec0yExOxKlcIZLGHe7Ix2J8xyNHKZs8g&oe=6A523895"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Primates (New Game Coming Soon)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1709763060, "lastRevision": {"nodes": [{"id": "7164665536963301", "release_
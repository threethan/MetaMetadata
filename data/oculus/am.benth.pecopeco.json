350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDczfr844PQQ7kNvwHhWXnZ&_nc_oc=Adrbb7n1L_i1Dp_gAq7yDZ2sBHzonU3Lyg8e0fwbUdicWnueZ12140eK6NCDifW4DFQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rjrSZewDSBJmhaf1rfIK6t23DjcW3eLDlReHvAY4Kgw&oe=6A47D27A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiDyFEjq-5sQ7kNvwGK8s4W&_nc_oc=AdoNOOBh0ctScSIgeKVR9T09ndv__LzNOcSujsQaq7Gin4n71F2-0kGHsPHiCXrT5Gk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Q6V9Wc2f6zg0jLodQO66ENHaN_ybW0sX942zbHhRYng&oe=6A47BBBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCeThP3xrdAQ7kNvwHbV_ad&_nc_oc=AdqhQM55RfjmpyaiB_FZkYd9okXwMbsS-HbLRkAjWHKqZNwpR8Qm-ncoPbv4IwqTTvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z0e4N-2BG9edXwI0XBL1K8ltYLh8pU8KrgKgCgNR8_w&oe=6A47CDEF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICsimk457WwQ7kNvwFJwbaH&_nc_oc=AdrGVVSB39q9-fxmOyP2VVIdyjpqI8tkhizkySKqyANU4Z5kkClmdjNaqt7dPBAd-50&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Y9R_ZUVyx9yvPP-VKJLGc7VeTaIx2Q0tnnZcsEWquWw&oe=6A47C855"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nGVq4AO8DUQ7kNvwGuywg4&_nc_oc=AdqCABi181EQJyaecuLNn0Y2ATpj3qw1Hdjj4jYUkdT61Pa5sGcNwgO8p2EPmmoBaR0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tmFJkyL56xICRh9_YX4KSx3i7cDfCv_3Ip59MKclSgg&oe=6A47AF2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
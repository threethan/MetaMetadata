350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yv6NKkXyV3IQ7kNvwFNZ8Oy&_nc_oc=AdpSm34S9Qc1Ku2WRUJ_nnr0PONr2HILFhLI5mmUvaon95xOmuWJ2E5KGCobEzymLGU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1109FCyxnlMJ3npaEtUEi5s4feYPlFhJAQg2RH2_qm4A&oe=69E8AE3A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z0WzAsAbe4Q7kNvwFV5sVr&_nc_oc=AdqXQIiqAysbPG55XcKq91xcb4gf9zHKsHUw2ifBRpcDqG4rgkO93DgfLMZk8eKA5u8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LD-2VujIdLQ601V2IQEEwEVreqIkzmI9YW8QcyzsNvQ&oe=69E8CFBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAJ9CiCUA2gQ7kNvwFKGWBA&_nc_oc=AdpG-iReZg8WoThSFOpracCQlDA9EU7Q1kzrjLJv3J2e4SD47A7Y4zBaPd5bkfYsTeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af285GunILdjSbq-g9IM2Ikm31Yat_Ltb9v1O4REVHUSHQ&oe=69E8A9AF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erQPa4nWZ2IQ7kNvwFivbJB&_nc_oc=Adrx-dkGIZs8115PndvMW0hzD5tEnYU4zni5rWz2C5bb6cIKZIzbShhUtL9E7VsIrHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qvigbkp-cgWVi-lgGo38EGfdQZysLL5sPsotg7zfXag&oe=69E8DC55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2S1opnZEqoQ7kNvwHaea_h&_nc_oc=AdrRr-uuJ3tgK90so-Zqxh6nz-dAr1lsR3Znu6VA1mpvUJhQpVBx0zwYG5nlxY4pABg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZrNjiv9WqBPeIxaWuF5SaL2pBTdDDZlerAB5-T7_KGA&oe=69E8C32F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZQ_ndvaC14Q7kNvwF9_F4O&_nc_oc=AdrBtKjHdrp_RalblDBgoVBcpdPxkIEyCC9dko5nHVwRCySYbRjp7ksBTGqXK213-9M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U6pg5hNX61I0G8qhOfcjsoDd__Doj1SSq9YgWjdhV0A&oe=6A3E97FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=davXoHGiiJoQ7kNvwGT12cP&_nc_oc=AdrwE1XNMLEqyD1RL16jbLeIeMgDJJNI1heMtvrGgnbhdhK7TU-iKoCGfUY3zCItim8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6I2AY4TJoOo-YnA-RKu72WWwLSPSFzNcmW-lqy11mfg&oe=6A3E813C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDovvW_TZJUQ7kNvwFBpwPK&_nc_oc=AdrGhaE2d4gjb3XSM1X6lG47iUAAKETjGwKLhrlqprmQ6Q5cVHOvA4eDP8Iqu8iII1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8YBU_9dLpR4-aByWJqqabPOms5fEpka3xIGDuOI17M_w&oe=6A3E936F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwXy8r6DbjMQ7kNvwH7kmAU&_nc_oc=AdpZBXzvGei4KKxybqZlUdx6odAG4lhBqe9LwV4PUqkGqxU8QVd9GSJqe_VSotjVAlY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RGyaRPeXncIRawTAm18AG1cy0YdAtbwwWzH8VjZmB4w&oe=6A3E8DD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsSCYg9fS7kQ7kNvwGbLGOY&_nc_oc=AdrA3pYLSvP8hph5SDQ2HrMnxFykgnQe6WFMYR99ne07Op4vjsZPG6G2mVmUXB3BUOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TjJA4GolEu2O6KzyU9KyblExIY83wjMeCuOr3Fr4TQw&oe=6A3EACEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X4qnao1djgQ7kNvwEmUWpI&_nc_oc=Ado4BUHQvGjHXzWVkSsrjr-Xdko7hcA0c0eCf4YUlaAUcha7MFLgJ4nmhoVnr_CUhyQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wIAX85Y2HpsvRCrUXQWCs8SYWMuFWeKQF6KqD7kqL1Q&oe=6A0C7EFA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MP8srb9p1gQ7kNvwFfaK2L&_nc_oc=Ado8yCjaKF7SaAZvCcijXqGAcb39TAgl21geDrxC1A8ypgFnfkZzCY0PJ8zIr_hA2ZY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-tRl24yzmvmUpUL8frD47l0DIA-UdI-xZ9yjDvg7uMw&oe=6A0C683C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IpsEa4H2fYQ7kNvwECTFrS&_nc_oc=AdpNMYlI3L_rjwfcWLAqHQdA746lSwx_ADbHPsnc39BDbEivxFDSn1jvCuRW_LSOFHY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45h0ye7Gehcr-4D0ebZFNDcgTCsmgtrkEiCq0PZVhGgA&oe=6A0C7A6F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXQQSkQhqowQ7kNvwEDhhlW&_nc_oc=AdqTy2Ddr0YaHjyIkshRBRg-mamGsM3IDg7Zs86tWrYtsgPV8n_nlGLGk6KYh0qL8tk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66hnkjiTJSxdRR8BsbmSY_ZklcbO6SalmS4ImM-UdThw&oe=6A0C74D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtYPRi8sjuwQ7kNvwFsS-cP&_nc_oc=AdrCdtJN9CdVjMRolFSlviCD2-eAYB4g2TDgvCJpduM9rofOi8dKd3_p1xZ14sVtSLc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Bu1_UGNtmXsyFgXTQhxmd4M7SDpPEJ3PtIzYrsJQGrQ&oe=6A0C5BAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
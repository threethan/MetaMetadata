54350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB4q7AyDkPsQ7kNvwHZIacx&_nc_oc=Adqko2DQKzp4XJlmhy2V3s4cFGO9YyZaEXOxsZZ4v-rK6GkYEXGYbLcizQrTAD8_K90&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l1Prbb_tfSWBU7cWO4l8vWnDLta8vW45FyMyuRhMpbQ&oe=6A36AEFA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s_QV5a-QsS0Q7kNvwGD3wEY&_nc_oc=AdqD_3MV-myEI5EWn_QJRd74wSgQ8uEDFtjTdmfPcoduOBDQyJclVKRZLVjkw-ap2ik&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OATnXC152uhdQd2ZAXB6XZwR9GsU7VXn4ZAgBNcP3VA&oe=6A36983C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WriuOroxFsQ7kNvwGxbgAm&_nc_oc=AdpLjjlY5ydG5Enlv08yqn0xY7BhfIEKjPLup3qJjJdhvz6-IaesWg_be0beunKOZvM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EBD8y29ltHJppQss6wIktBGae96FdsquH0hP-tslDAQ&oe=6A36AA6F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0khnYEQkvFkQ7kNvwG7uDWD&_nc_oc=AdqHzI53DcPkH2pxRQY4yO8xbZopq4nSmma9yC2MWmE1OAHeCDzHMBX13qk0knKGcxY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8opOgGglMQ03V4K_JRI4rWaVsSgYWuxvHifyXXUIZYag&oe=6A36A4D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArkqpNVvRBQQ7kNvwHAbTjg&_nc_oc=AdprZdS6s-_10eYZQT0OOaPgeHuhgElYIBUvfJjUoGwytqb_20eWkjJ2ymFLmsMynUo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yuWt3cFnoFLBv3e2v62TvfhyIkm19AyHPMJLMSRPMfA&oe=6A36C3EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopec
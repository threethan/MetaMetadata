350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ADVoJ-RDVUUQ7kNvwEB3mfP&_nc_oc=AdrndL3EWrGwYZaW4XiZQXSjkFX4Xjutnus7qrKasgDpB1aomezRkIw_S2ingHA6oto&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bCHbNkOhlWEkd-hrHXYOVZZZn5Uu-xpH3R4UhIns56Q&oe=6A413AFA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=davXoHGiiJoQ7kNvwEGEBaz&_nc_oc=AdrcrjdzGEiRkT7qnUvUEKNZNHR4krqiAb19ZzR66XrofqlaqbRKwt7dSTcOYhOhLfc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OPaS56FKVuiV0Y-JLP9kI4wRzlIYCf7c4IDkHtV3CDw&oe=6A41243C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQVgt9R2ouoQ7kNvwGB1KLh&_nc_oc=AdqHQW2RDC2tUwu5YqYNNaIECgd7VrI4VAITF7D9DR2UTNen0E1vrnpxM02N5v3YPBo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fSGL6wKhzLvw4N3D9CBJquGesByM8OsJQVkNN0kgVfw&oe=6A41366F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwXy8r6DbjMQ7kNvwHZEbvR&_nc_oc=AdptPsEIL6N0qbY8GJYeiVjIUAEv2K44MeA46R22sdhIoRHGHqzEhgdff6H6mDp0rLg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iQz6dwKgO6RKxvocSgEtl8jStll5_p5-1YNTQ6w_fng&oe=6A4130D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsSCYg9fS7kQ7kNvwGnZJTJ&_nc_oc=Adr80LyCL8PI-z0choSeji0OxIjeZN7K988bcyVUbdCnscU_Zc2A-c3h08f_DMX4h2k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8DnhZgFOnkxml_oFf5JFfsYBjf2qXRxNvU0pj_IyBSbA&oe=6A4117AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
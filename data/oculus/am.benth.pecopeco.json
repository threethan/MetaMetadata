350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTHuv5LZjtkQ7kNvwF-mEDA&_nc_oc=AdpxNgrnr_jNhE4IO6L_i1GO0N_hNdPzKlw-pUqQs3yVAdwGhy_jxL2IvoOwoNf-EhE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nJIxNx8gHpGskO66MLrKUv9zj-BxMN7Ru3YaUfKZOzg&oe=6A1467FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z2wvTP0XYEQ7kNvwGUFc5N&_nc_oc=AdrUMmUWErUi-tZq-Ocbg2VEBN99JXCsBbHpun0_0Yee-NI98TvwAAFEPxrCMdkyEEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Npdd19vD8-yrkz37CHeTEj1zz7AlKG4fWd2g2xJxAlw&oe=6A14513C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PQB2qVT4YAQ7kNvwG1fkCd&_nc_oc=AdoGjGA2WelluyHq-gqgq1x2D06HKcSWWwLAq7RsG7uyiLArOBsecio0VIggpXEsC4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66b-v3XiXbLg_nHY0pNes6dca7_QlI0cfBNfB7VIzMfw&oe=6A14636F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiTtyJfFdqsQ7kNvwERUNvk&_nc_oc=Adp4XOmjOI-ApMh1Ct9oG3UpCkjG57g3Hi5efB6gtK49phcstenwpu48qx3MCJkysxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EkzG_u32HGhxlOTv21x4rNt0mdH5sXbh5b8Z415FBRA&oe=6A145DD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdfLikzmsRAQ7kNvwHqsFyd&_nc_oc=AdrR_gmxUJlj1z5kDAgG1NOY90_JwiVjMvrgHM8AgYXmmvA6EE9FG9ssjilGWpaPcO8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rZZuBxU8EVp8RMHL30Z1sZ8UWrOy0BrpNwoMObCxgMg&oe=6A1444AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
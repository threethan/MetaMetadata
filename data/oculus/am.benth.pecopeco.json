350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsooOyN7t3gQ7kNvwEAc8mb&_nc_oc=AdobLNX236gD0qMwz2ZUEbvFtlDKnC8jf3de-RGaHmCYzsl05riWZwCnjSmFkcOy4uE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKtgLM-dh0PtIhMrSTFWpJC6neUqSRRstKEytIrFmoEw&oe=6AD0EE7A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_6XPvwQt_EQ7kNvwE9Z1TQ&_nc_oc=AdrocpUIcSwL24JSFa-EVT3zyUAGWWxx0HrCrdoiZP-XFi3SU4hAyLiZ5Gar9aMjIKs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQEDAGGGqIWjXEFJ5h5vbmYr7ZcFhkmN5QZGi3fgyodw&oe=6AD0D7BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IdrgEIQmL90Q7kNvwEXoKn4&_nc_oc=Adq6f5yIhRya42gWRtbp14JZDN1o7tX4ENs7q-jm1LVBYpt9Uu960iNCd5KkrWfaotk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUYeWGIBlYwH9FIjBpkaPkaqVt5BHyXNmA8HFk-_rSdA&oe=6AD0E9EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwSYByP4tRQQ7kNvwFpJTwC&_nc_oc=AdqtHMq5GbmRxnLNGGaoFIX-pCxxEYohrfEVxti6Yc302-NbBSrwwUIm_zXbSehv4SU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRa6QnIuk4QhiJO0VWUJiwfa3UPYX-urDeL3CjI_4R1g&oe=6AD0E455"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rybftwYgRXQQ7kNvwHN0xVf&_nc_oc=Adr1S9FYbEdDngliCpzg8fpeaFvMWX4mJoDrSh_xoRWdH8xOxMw2Gh38frUnNEXIu0c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmFCbTrdM78TFQrkzb5cdcxN2-nShMPUyuem4l0C2ydw&oe=6AD1036F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jkm4L6qlTpYQ7kNvwGpG2Se&_nc_oc=Adow0O0BuLGm7Wa-eqHL_fHrJK5clau1B5sDR2m9feRyoxMJJ4Xjj9tLdl_NN3hf43Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuuxidmDfiZGUvOzpcPL4siGj3yryD_SMLnmYd4Hq2nQ&oe=6AE757FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8Hvg0udvx8Q7kNvwGmk-RN&_nc_oc=AdobtFtut5N5EAojFZYSh17LhxcDMnlaM_yHQYlGsKMkcOyjbNyoTc0w-ucWlZtq4iQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOeg2kLsxkcwcWSENgkfhZS3WJtldM1xhucuypIJybhA&oe=6AE7413C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN3oYiD6u9QQ7kNvwHjVJ0e&_nc_oc=AdoLLffLHS6T5hLeKyINWPhzacvYHQ_F-vb3sbK4zSqFlcQUSvmPJhopkHbmR9bnU10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpWwHf7f1Y9KzmsmoYm34ND1Cg2TPxajbC-lBbA84Q4w&oe=6AE7536F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Pb7fTfcvv8Q7kNvwH1OREZ&_nc_oc=AdrBj0TT7bv6T8PzV0jZkAAZ52cNj5tB8G7-YnvqgDyRcLEyhalaMPEDUuysYNgsIR0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7YWsZb8wvPuqgXE47Yxp-qAxsQzL8CdOA8FOmC5jHLQ&oe=6AE74DD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QwkIKU4QMcQ7kNvwGncpMS&_nc_oc=Adq8n8j44UZVJsm2mZyy-pdfVjkdqWvRiPUCKfHCVQ27haP5f5R8-e-DxFLTtalPzqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3egtI07uo85ZIagV8xIYpRB6wUycuMYhSf0CxMd4DZw&oe=6AE76CEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlbEdtoDnGIQ7kNvwHWfZaj&_nc_oc=Adq9a9KsOKmlYK3pH0qCQJMGHDIn00mxrZpNFZdPjsupvLAkQy0u01C7md2ksMK-aoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK27PzkdXqjilZKXuuW8upESnsBF5EO5aqmyB_cmARNDg&oe=6A983DFA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Xit8RyUqGoQ7kNvwHoWZ2M&_nc_oc=Adqmus9iN5C7vQbDzoadnRqsS_c-lwpWZc6aS9l67x2SarnC0twCWtTgWly6gP7x9vE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4h2QLxPJKVizwPX4032B3rrXngb3TUUxEihHnNR0hUw&oe=6A985F7C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnKydQNKhskQ7kNvwHRdKL-&_nc_oc=Adp_wPhMnDz7oXw9h4uPR8TSsmdxITclMAImA79pJ5ShoJvbmm6GAYCgIoTVV1_IqZU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtOj02UhF8w1x55hHRx4QhzDcIx88KjrhoxYSZVEGd9w&oe=6A98396F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEiM12iBfrcQ7kNvwF8q45q&_nc_oc=AdonY147MA5cI_66K7J3a2qG0embtcS5M-QckT7JTVe4TRe_bDzBrTStulZOqnjgi74&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgf9aAagslKp8CqmnnNCVFgrACdkswPCw-iiYgSI3i-A&oe=6A9833D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkPWgn7SBoAQ7kNvwEs0-Qa&_nc_oc=AdqpM_KQwbZ8iywCMFJ8liaoPSRED_faUeF6FeR8WKjvof5nwm2ePKC-JpEg6qCmmN8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVCT2HJs4X7-rOO4v3358MZPipvJWkHc5zEBpVP1_--g&oe=6A9852EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
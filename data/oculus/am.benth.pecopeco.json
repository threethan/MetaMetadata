442_762656354350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfaQ_Hsl_BUQ7kNvwG5jhc6&_nc_oc=AdreZG080Bif-NAJ7DqxNVgkyz4nF75jXSWBztRx4TW0hi81jyg-5lnUp3qFidMS_xs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZO7sihNzXCbGXBfKdKf4ePSapEixyoP3WYOSX8xPmdw&oe=6A8ECB3A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjOCrYmKYFcQ7kNvwGXIUy6&_nc_oc=Ado7oFcAfGM_mgcIP_BlR6ZiJHpixbideJcpfauOpvyCx3ICEQbjWvlnOjNCfpllcEc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIE88UWaAjp7_bBXdvNUmkyhQz31yfYV72gG8eDwYWZQ&oe=6A8EECBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRpGmgbeOKgQ7kNvwEmWf8K&_nc_oc=AdqSPYVk8M2S19WACjmi9I_ie6PtkmPpEZOUUYPrEdgjjTC7PhgRGPWkPOY7VxOszuw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeWGqn6t15NiTf0tEYbeAtoiy3d-CPtSWuO3ESUkrHeg&oe=6A8EC6AF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEaRdeB8GAYQ7kNvwH4HKuz&_nc_oc=AdorRVyVOO8rapP9xs4AkMpC8oTBO_JZuj667Cf5_uBYWACNeLUahUFNkAySMkYdwuk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuYEx5cJUwASFtULwEkADfbTFVLPhIQ0YKeRFBd61TYg&oe=6A8EC115"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo37x-wXoWoQ7kNvwFH5KNV&_nc_oc=AdocplTT1PnU1j-uFJVHkSA6knBcWi_C0j9pBu46C1AV5tmdVOnl4bQZrOQUWKL-bVc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiWVF1Yad6Y5xLS7Wx3o5MzChMWLQmpg_raKZMIfhPlQ&oe=6A8EE02F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://be
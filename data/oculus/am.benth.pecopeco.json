350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ke8TtNDg4NQQ7kNvwH0yA5a&_nc_oc=AdrLzK6365l3E0d6BJCy2AZt1qyjI3SamUdWbOLKdVijlGc2tM6rBkbZUrJA19ZfBWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xnngvM1QyXxXzQXXV3nAAjzrwAjfSrIsHZiivBKwiRw&oe=69FB5B7A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt2ADkoORpgQ7kNvwHEpquA&_nc_oc=Ado-Tutmseb5CbX5HpddefUzHGYJhPCJDttS4wzRMF6u2jdkfC-vM-eB06ZNSv7k2_Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jK2yjIjzmM_wV19GHETlj-XyDJeTrtt_vR8SFivn4BQ&oe=69FB44BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t66b7m-M-s4Q7kNvwFUa3wG&_nc_oc=AdqBUdhbCpZw8GNO7CooiJ54ENNsh9El3lqstKYviwo6UtKsBMjvs6xPpuHmbWCKPGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UjGHjKWhcXOP5fzvMfbdEVm1vO4FmwTrEDdiJQXiiBw&oe=69FB56EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y84h_KhcRcAQ7kNvwGW2Qs3&_nc_oc=AdrRjxw7SPtCCGpvPGXXOjXNdzQ7Kh6euCY3QfFULZpIq75YKLTfGbxnmdHcHwmWgHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ClBfE1Emr-uAas59S_F5vLeV-uoHGaIC6Q1uZf3WPcA&oe=69FB5155"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulb4FqW__DUQ7kNvwEFgO7h&_nc_oc=AdpEGCJ6U00LZ6oqTyvkOBzuvqLbw4JehGAYrXm7gJ2LfKH56HaAu7x3a68A0g-Sx6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79feZdCveZB_zvn_p2LhTPbtoqaUtwhbJ58kF9i5mWAw&oe=69FB382F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
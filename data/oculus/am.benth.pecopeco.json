350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hG9BUAIFsDMQ7kNvwEehuhQ&_nc_oc=AdqXnX3h_m_0CLfOKEHdbN1htEO8wJB5beyl3m4ebLllNPfHo0rIIU6ridm-r5vQ_4k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAqioEYQkNZgGt5XoRfSaesBPmzAOakyUPuR2BPc3gmw&oe=69C3C43A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DI341VmiSs4Q7kNvwGCdrEv&_nc_oc=AdraYHzZSqwFVNoGZxWL63RRPUuGGKH8OqFUiDKAkslb83sHqrScg9A2vTrf35ANBEA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWhwMi_7E6mcw9Pu-OG-gHGuK6qG3PVqG5ySoQcUXHWw&oe=69C3E5BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd7AbijxnX4Q7kNvwEIgsu7&_nc_oc=AdrXoBgQnwIF3m1Ku4urhVH4ix2IkW-I_Skvcs1QUtf9uCLp5_zzj7X6HD_xliUbr4U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwkgt_xCr4TWB17CE7RH2F7-YhMSy_7N_WmwpvBsQo81w&oe=69C3BFAF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQuvWoDA6WYQ7kNvwFTCvt3&_nc_oc=AdpswU1VvjLA7UXm6-_YHmIqk6Uc-tZL00x9X0DY7wTD5TjQiZGJGCRxHDZrGRVGhhA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwrtN_slWsq77J6TmaoRNqDBPmE_skV7ObPZEypT35nHw&oe=69C3BA15"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqsQfdt0KOwQ7kNvwFqPR51&_nc_oc=AdrMIGKT_uJE4kCZII_HdnRx3_lqjV9DN2E-flUA4iXlkltAo7Spz41d6Za6aZjO9YM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydpP23ukVhpII_A5xNkFVo4_j4H-dw6OGu2IAQ2b0ASQ&oe=69C3D92F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1pJDg1Q524Q7kNvwGmk__L&_nc_oc=AdpNwD92z6Y0I_XXFBX34yPDuPnSVDljcD5eCs5JPF1BfgXVJ4M0sYWw5Jt0sTJ16A0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HTKq2CDlKZfgYPh_O08r4GsB3aUb00MWdXu2rIvHRTw&oe=6A2AD17A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DitnKkfmQisQ7kNvwGYzAzW&_nc_oc=Ado_5n_SVDtoc9L0Jvd_rhci9TwUOCPh40VFuNoe-IdPGSybZ5Gie0efWkDBbG1wvDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lFqifGAtIs_j-e_iQ_7EvbZT1hNner-QRbnJE3v8Z9w&oe=6A2ABABC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTYtX1azPyAQ7kNvwFDT__R&_nc_oc=AdqRvf1YBz1soiNLMVmrm06fIia9bGD7qEiOwoW_rQFpDCrenql4bnCaFnll38rH_XI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_O7WnFdPTXB-CPzbYiTBBULC5wKUk26-fe2o0yVYTNyw&oe=6A2ACCEF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ionq6UFXUBMQ7kNvwHAHyNF&_nc_oc=Adot2FJe5TCZZmlkrUz4tkffA0AgLtZnjinpM45W7mPzmgv8JAqriTac-yT3srDRDes&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_8QOvORCAcAUyKh6JTIb4tTfLGEqDpr9azZYLhJvR7A&oe=6A2AC755"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZekbBYCpN0EQ7kNvwEDoO-0&_nc_oc=AdqrweMV0eyEfBS_aVLGZHeL_fVOpZoi3c8pCH-jKA6fd9kmDo3PnL8lJ-0ZC1PCEXc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dqNNt0eDkrDVuAEfxEyqbt77B_uGN1FZY42AkhaoRaA&oe=6A2AAE2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CRNIwB3MjrQQ7kNvwEH_s6f&_nc_oc=AdqZUHrpOL8vZh16_CFqSfcLG9cxfA0w342E9O6CPckQNaCkky1KMngNcLdXsnJzFk0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpv_yORO_2u0BAh373qeP2wEZ9FP4298B8rHsJDsBLkw&oe=6AF486FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NNNnIqcWhEQ7kNvwGeZy_j&_nc_oc=Adp1nobMXOOLC00G3XfAvfRkr0auLNOVF-J54t_MRc2oTNaZGbtYNJeX29LPDE8TqSo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBj1RQ-1R9IlHiHtx4JofKiKu7ChNBF-YeKrPZSU-4pQ&oe=6AF4703C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zlWAqdu7qoQ7kNvwGzVszQ&_nc_oc=AdqfzhvwHFtY5tjcI_RG0gyxiurstSyBM8-RaN_yNxom7AROoWt9tBhXBsa7ljl0eNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnBToLE4E2pnllYznR_o76x2Kod4PfMT682Yt3KYiB_g&oe=6AF4826F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrRkHkYQO9AQ7kNvwEmOx7S&_nc_oc=AdpG8Dzo2OBZVxpYAb44adb1tkTKUTifojyakpUjI0anTzRF1fDgCn3TqJF4FOck6kE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyzPkRHkYldx8R1EaUg-f61aFKAsej4QbNay760mIcMw&oe=6AF47CD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVCqYHDWPwYQ7kNvwEEbEol&_nc_oc=Adqa2Dp0UaqlypdWQMleUFAtlzjp_fL5wtdi3zZCyIPMisJ_lSSszUerZMJnuHoL4cM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6ynTOEi8dQzTk1fveIMji9jB1ECk5-PvbZv7nq0MggA&oe=6AF49BEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPNsBFhLd8sQ7kNvwFIsOp7&_nc_oc=AdoKOPUyErp1HNgl7mN58xYAVa9R5ml4M-59Y1sItO0HoKReNWTGuY_YIfPx3sHKogA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLBB1OuVdwBdeEwDvMz9w8EKy2KXSKGh_axHRlqN59XQ&oe=6AA2C9FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYt-mnej9D0Q7kNvwGypmZN&_nc_oc=Adqk9DLbeuZ0cXr90Zn-uljxBhXrQi0pEBiMegZfdeKoAR31YUTvbnGbYO3QRSa1ZVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbgiPsggsQQDGlWHDyHg6UVbLmI5mcCBmjFtsMojNVtQ&oe=6AA2B33C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8k1_XEfQR8Q7kNvwE3RU3G&_nc_oc=Adou80_PdjFHiVRVZmyW6VvsWNiLXMKum-Oc-hai4AbMDoCCVVEQ7eplMa8v2vzAx4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLltTAku3lv8z1MMRQbyf03pH-2jhScfb8qqSPRdR0FNQ&oe=6AA2C56F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3eAvUFx93AQ7kNvwHP0PBM&_nc_oc=AdpEPaHeW5y92k8VpcazrJTEFAIg-xuOUE1RaDSobmz6ew-SqoV04JLCRDhKMt6d6o0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuVohjnRryId1S9o4BTa1b-i5uFQfMZzjrJrbSEdGCHg&oe=6AA2BFD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-d1Y4hPCmIQ7kNvwH1r7yq&_nc_oc=AdqwleSEyFZQW3DnD-qKwqsWIYk2ed1fq_UzIlQXNQcGHLcC9NCEKqZSRXR7sZnCy50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN4T-opvWwMisipVSqnB2GN1qS2lmrG9uKg-YQ7xSzZw&oe=6AA2A6AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKw4WY9Ur4AQ7kNvwEnOqFV&_nc_oc=AdmVTg2IJD2EDyz2Rbhprcw7DTSCJbwRgG6WAwQDES-uxc6gz9T_qr1vkmYCmMEDyAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afy4WL9-zm2gucCVUsFwO-VmUrT-a-rZ-ZCqRIGd56mO6g&oe=69B9383A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEKW-IXkqEEQ7kNvwFnvgLy&_nc_oc=AdkQKJk7ECzsq5ciMgW6spsH1sr-ng98BqlqmKrove4MXQD-tlC4yE6TVIrWmyyZbPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyb5Dx4F2twE6KX0W8ToRV0sGoPZECu79dF8jnp975glA&oe=69B959BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdxISsmZxgUQ7kNvwFdlIkB&_nc_oc=AdlQFwCbhuymrv9wy0tfKOpD6GhGh15WgRDk64i32swTpY0Fk0If1r37wFAvYNnxBX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxD3Mhlo2qNMdHf-yuCVuwGUI2y3yyCA_IAkx-ZpH055w&oe=69B933AF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2nvH356VygQ7kNvwE044kt&_nc_oc=AdnkmHNygFghYGAUD_hKViJ5_BXFdbUaercowMH0rJ_f94Cum_CgU97c-hxsR8Wp4Ks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxgUt3f8l8jRs0opwM6flqgu9s1gJ9UmZXJti0Mgfc5zQ&oe=69B96655"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HgfCED6AgoQ7kNvwFy8Fkx&_nc_oc=AdkR5QO471CciDWJVl4nYipi3vkx7w9mLY1efOJr1ekLLtRGDlh6i6TpODxCXyBObFM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwkhAD5eFY7Tj0AQhg-MOVpWvJL6PIW5NKO_AZWwWjlag&oe=69B94D2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", "category": "GAMES", "comfort_rating": "NOT_RATED", 
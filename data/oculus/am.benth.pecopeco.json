54350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwNY1ZWVdD0Q7kNvwHXlYLJ&_nc_oc=Adq2LpVJ9jOAbWhD6nt0XcSEVXTVSnMxEKHPTRpsxVucCoEWUqK54K5okx8Zprk-i6Q&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uCWP4qQMSdiNU3zjgTzxyqlgoEe9yeiIROy4Qofcmxg&oe=6A11C4FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDY2zDlIe7IQ7kNvwHh472w&_nc_oc=Adqq0tpyB5f39R3zec0dIrIAPcwprsW5aqJCWr_f6WTQVd-wT2Xmxwk8q2QWlXkEoQQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78SFVrygIVRnq7Wy8S51TctvgZcS80iQ-0NSZQOsoRSA&oe=6A11AE3C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu3476vRPZ4Q7kNvwGjm8Ey&_nc_oc=Ado8FFMwp65G8dQ-wegEY5bHAouABdo8HkY1Kb0stz1gYIV88ludCBf-1WlOXJCPdJo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bbB7rvxi3xxO94shm2vyV4aNN7swkYG82pParvw1mPA&oe=6A11C06F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl7mgcEO-Q0Q7kNvwF9TjnZ&_nc_oc=AdrP0hFqeIOX1eEVjgmUoNgEk2PnlPPcM0jL4fhguPFs01w0I-ymlEBUZqy8f5Go_iA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eziG2jpcQgUPbR_9R4_iTyed9CsW4tn8oPR9RFGvApg&oe=6A11BAD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOosykTzpvgQ7kNvwHIEoQw&_nc_oc=Adq4zCCFtwluEB3SWdrMVC51BFE1VpFY7dFfL9zHZj4EoXDWDjj3d6k_2rZgULR5lgs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48wWSkRHoC_0XG_D8piwgM2Wr_8z15Fcb7Gb5Ihuec5w&oe=6A11A1AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopec
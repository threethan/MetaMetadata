350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ2c7FEb9XsQ7kNvwGYOi26&_nc_oc=Adq2SG-BMYFv1AUIi5p_Hj0bCE5sI5fty2UhH-Gl9Q_CeTKvtqm6lv6MulGbPCmblDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyya3iZZrXZm4Y2rz8nMk6_gDxTGWkMhVS5f-_3JGZMuA&oe=69C90A3A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4LyqY9sv5gQ7kNvwGP7waB&_nc_oc=Adro0RxlmSd1w7cZozGRqZSMqE0Mqs55QXHRZgcN7aV9fbKE-iEUWJniIouSc2z0Les&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyG2oIOQ6KRzeRBjvfG7ekHK_mKr_Tk7fULxdVM0qsaqw&oe=69C92BBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpKNjJ10awcQ7kNvwEHSBu8&_nc_oc=Adof-aIzw5lrtj9CP5pWvdfwwZb49dduWphereWEPDxo3v09gf7XkdfZqTPIhVQFnYs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYOMV1o4paZPrOdZUOrZ-9mG7fmlalxCfwidVd-uvK8g&oe=69C905AF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xO9RDeKfOzcQ7kNvwF1G6TJ&_nc_oc=AdqlJEMjIqkp2_L7p8UOh1e7Fkj-FEshPcrLBySoyd-JBC2GC6hi_ThaGq5QgvfocwU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxTu8TMHim3q8BxhS5tSQjK0DRzO-r4PsHZiZlpSaE9aA&oe=69C93855"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTBWuHHDsY0Q7kNvwGN6_em&_nc_oc=Adoa0ggCwDAbsj1QvqAjoMkCLBn_i9ZYbpoKRjL7aTuaiw90rTL2WF_KY_2cY6L0ZsA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8W6R9PSGt9tnIgMqkHZXkDM-gV6JLVLKVWLVVZ5XeGA&oe=69C91F2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
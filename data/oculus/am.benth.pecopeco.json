350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pWJ7nY7btoQ7kNvwGveasm&_nc_oc=Adqc2mC7jpsR4WFWUX0At2q-L6fuzD5QCSU68B9mEMX2FMxO1cDBcRyashf2qWoPL3c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zlmWhivqIKJ1VZqoGveV5agvWuXQ5d_jAJfhgbH7l5g&oe=6A2D747A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DitnKkfmQisQ7kNvwF3B9bk&_nc_oc=AdpmLxIczqy4fCyJuzvYi2PvgnsA1mTFIMqKOFb4B48zTzLVAMxjpKcfwng56e_f1Kc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ux4-g5Evtk9Gj4Z7PQ53CD1QEd2uCjxixpwy9jeSX-A&oe=6A2D5DBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIEkc0mYqMgQ7kNvwGqRUzV&_nc_oc=AdocoVp2fH4ZIs8Gva0QjfFdNeHoSpDx_oNuprBwgj8uRnlYkzbudMDhuVs-iFWEwTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CF5DO1oFsi-TvgXvx6Uj8bf9eB3AmDLgH-130H2m3Nw&oe=6A2D6FEF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ionq6UFXUBMQ7kNvwHuIaR6&_nc_oc=Adrnu3J_jcbCE4oQAph1WNkZnN6LHsCe464MJNOmPerx6bLQStPvUuHarJ_3oXmakOU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RWZ3OePHAxGFDiFjRoDlcW6ua7iwPHSeslY6Dze_L3A&oe=6A2D6A55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZekbBYCpN0EQ7kNvwHiOYX9&_nc_oc=AdqI2xj8B71BpKZYobBj8n6wDom8B16ELobTohbF37CnynU7aNTyuOJIEDIjfIaGWAU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u9X5Fh0zjp-gVfkdgysd1tcnwAEC278mCCx36TjqCIQ&oe=6A2D512F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
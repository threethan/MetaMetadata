350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlbEdtoDnGIQ7kNvwF6clHm&_nc_oc=Adp8fmk_r7G0PvvzVq63C6brdqVk0i5RKr6_1sY4dqNlBhX9od1tocwoj6HN-5S3EI4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLIXqn1MzxBW7sIKKhkFEAo6hLqZqH6O53Jykg457AiQ&oe=6A9724BA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Xit8RyUqGoQ7kNvwEO3wUV&_nc_oc=AdrDr8QEGyhMJgtChTtB5c8oisea5u5XL14bhNcwH_92veEH_6LUVp1uukeQUeIa5Jo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhKv9HvLtsfp54dTBVGGnARULfnrMC9eCFpLtPZb1wCg&oe=6A97463C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnKydQNKhskQ7kNvwEkVjnJ&_nc_oc=AdrbHP1eQG6aB9CY_W5ETze28ugaUB9dsCrB25rNO6k2NNpCsMUbNnHElBtdI9EmIiU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxMk_QKeIABDG6e16uHgdK21sBx1PLa7HXRxpzBQIZhw&oe=6A97202F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEiM12iBfrcQ7kNvwGU542_&_nc_oc=Adrl68ff-7t0xOvWtJTWQYSogECIjUn5-c8q5HQUZS0_dxdBMPEPFUxKNjP4IHZ6WGw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESM6O0pcxbCGo434Ezp2N2EFEisCGsS70S0i1g6rxvJg&oe=6A971A95"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CkPWgn7SBoAQ7kNvwGCjSNV&_nc_oc=AdqZo1_hiIKcrfHQrUqmMTxhFLWZGHJ5el06o3Ehl9fHWK6jY7nxHVEaQXxyiYUACvw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNYyevvLWjbjyM-XebwzICWk2Bo1aeyQ-XP9rvUiB_kA&oe=6A9739AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
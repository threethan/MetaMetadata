350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZInp8N8RLKsQ7kNvwE8K9xz&_nc_oc=AdpxFayMpgddN5yryC1dP4CDbKXIb-xYQWmSj3tkzyHCRufIZEiuC16sI1oTpQblxo4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhbQ1IG4XYAHy2-Ua9ZHCwWVP3l_aoBOI01lixB67KMA&oe=6A819C3A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1bp8L22PasQ7kNvwEGq6wi&_nc_oc=AdovSrMVmF7Ihx7h4f2yeMiKiGITSoMQX9jmATa4YKM-YwOFcGUnefAuY5hAOW5DPPU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB_DdPcxrxsBE154CX_V4UBg-esJ100153eL_Kh6k7nQ&oe=6A81BDBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mi_1hIHItRgQ7kNvwFNjqqm&_nc_oc=Adpw1hlqOxt3J-V5-Kyknu9bPKxCNOG3drC19WM5IlGhz2iI5SO4q_HYCotEUVGomOM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpfR0_bLqVtHuXt5BV-wWEwr-5imppRgxA6-guyKKSDg&oe=6A8197AF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b7bf6MMjnFcQ7kNvwF5dFyS&_nc_oc=AdoMlPAstqWMbbzxSN8t0aOdlkLCLetX8XbtiOB-bVNtQqaukRsTxcWZ0J5uBiDUOWg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1Su-PhrElM1U6paUwhhcv1fktYlXra2BxtADERIaCzg&oe=6A819215"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWTbDVj6XR8Q7kNvwEbR5oz&_nc_oc=AdpjFa0j4Ra0bqr6f1t3aDmtBWrC_BlQHBTXy6iIRzYG1bYb87ynkg4Fce5PcmRBwWA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_Dl_dxqq_7jUmDBiun-ZmXMjgV1D-XS9RJp49q0ekww&oe=6A81B12F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
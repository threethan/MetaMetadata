350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61zuH2NcX0YQ7kNvwGAV0kI&_nc_oc=AdpLSfkGUWlAtI4qc0USOKJmZR0DCPI8VsfS0pFXdiINvkgV5FgR-lJFKdjsSQb-xoo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtXiDf2RROuKZEInaVFPXkOQ3mpaZ2zuFtkLonddOAbQ&oe=6ABBD67A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoC6EiXn2HsQ7kNvwFlyRPN&_nc_oc=AdquE6V4S2AEb_-8N5_N8AI4KEGhHoLybNgc0PsOJsPk3loxfPPRktVY6lp1Fin920c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKveSZHfIaZkLkvuTTBbYvP-beMCbxbLcTW_YffsbuChw&oe=6ABBBFBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RllGL5eaX0Q7kNvwGXF-St&_nc_oc=AdruKtqPJakhVCbmI7QRotBHy7oG8BmIUgV5G9gcCgn_N8k_54u0Yazaaom08ku_syo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpdB26IOGztw-jZUD1jjn0C1qr-ZDOOQmJ3GbJo4ULkg&oe=6ABBD1EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep24pAgdGesQ7kNvwFaOqw_&_nc_oc=AdrrE-YXOrnNFhUw7TGjZFkJJlQurgozSzgoKtBaMJUTDiujIINvZI9c8a3Fp_G8nSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXlIbhKOmYbB1HrCY6jlqhrIYplPV2J-9DZqsIU4pKEQ&oe=6ABBCC55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HxwgZ9gIDYQ7kNvwFRaGUH&_nc_oc=Ado-1-6pd3VYGYuedywE0iBMH8ivWycuJMznP0M1YPBIVC76YiCxRwFFk2r5fsnBfeg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXE9OaHZcdzOD63LXG_kh-4Q_7r3KUoy6XLBmYAKPvAw&oe=6ABBB32F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
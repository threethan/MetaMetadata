54350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pkZDBSd_8gQ7kNvwGPw2_6&_nc_oc=AdrgZ_HY8RN6qlGUt56GN85ZXCqB44q5yO0fbAvIhP_SBVzczJc9WtMMndFYLqhWWBY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FrO_d8yN76bum5y8x2PIhmco0u0AxbBO28qoLkPB1mg&oe=6A22E87A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfMudx3iB2AQ7kNvwGgJuzT&_nc_oc=Adr9xmnEK3gGJeHh6FfxSz2M8qfzLLvsjm6PTBnDywXRA_HINdNOWhiKgGiN-SpsHVQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tsIsn0N9A_a6MCMcwtFbRl8eItj-cmvMuE166tZ5QRw&oe=6A22D1BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0Za9BY2tioQ7kNvwGg67wQ&_nc_oc=Adq4CvDkLgTmxANU_Lad8-rMs0ZwnfJw8CyMyKKFsSFoImWfQRI6p40juR32RI7nQJw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LwT6pyRf-H2LrcyP9DIC4aJ7Tg74k0z-NhrCho-ifLA&oe=6A22E3EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WpMDtOizXwQ7kNvwFj32gd&_nc_oc=Ado41V7KzdZX5jLFUE14PIK9fxzvI9Lo0vTIsSY9u0X61wKOyzL-yQoSs0hy3SB-3u8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ikuLMvB5LydeLASIEw-8I4Brgrjgvm6EGBuZL2_faDg&oe=6A22DE55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3oh5Jjefa0Q7kNvwHN4A37&_nc_oc=Adp0ljx91MMCog5JA1DgfDZJAIHHw8mioL3SPAzfvGR4muKrCx-rSzgfw8wrH-_cgro&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FuBTZ9oE_Es9SqLouyibnySIYz3Cm9mmgfRMwRZqvDg&oe=6A22FD6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopec
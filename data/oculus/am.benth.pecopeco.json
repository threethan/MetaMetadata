350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59zBWVMkNdgQ7kNvwGaqI06&_nc_oc=Adp5wlCBmvknBLx5lMxPiGKS0IBnoXQks0CwrrmkB1MeyED2N_sQhw1Zht_SuyEbFrA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy3VnlKu0W4gdniIX_PRwAgQ2ID6KJ9GXGGWDdDJc2xw&oe=6ADCCBFA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODJxOJJrP5kQ7kNvwHI5Oeb&_nc_oc=AdoluMRcbdI70UTUNiauHxvrwmRPYIU9aWvSE6aXmEdfnDJ05cBdkxKKfYD17fNtjNI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmdxAxf2XgxPFtelUPyA3VT9eR-n2-sbm_8zmIDZYZUw&oe=6ADCB53C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMNWf5LUHr4Q7kNvwGkC0Xx&_nc_oc=Adrd-p_WCNC-zBS-ZfPt5aqkNcT7IxLjUbsobQA5RHc9DvIU2ed3OfEuz2uvF1-FZKc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrLBSWYXVpl5iKxbJ9F3zEBa3pD1ct11ZzkuS9-KinkQ&oe=6ADCC76F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HoIykvhzoKUQ7kNvwEfb9Cy&_nc_oc=AdoTVK0i3sC79A55s3O6TCCQ8FVxbCS9HqljabPT0EFBt6s-JQuqY19KHDVqTUePDJ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc1UIVg3zbNJSwd3RRRzXO5AYD7LQQ9ynHFYyKwDZFWg&oe=6ADCC1D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fSrvEzCxskQ7kNvwExSLuK&_nc_oc=AdqCUugSD92sZgEI89uYg9Jxhd2TGUsHLnuli8PfPU1RU-ILcVM1M3aNJRxpfDYsvUc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWK0zXEDUyGulonUuQ670AbTem6WQO646myFrSlQrRyA&oe=6ADCA8AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
442_762656354350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6dDUd_J2ecQ7kNvwH258Ie&_nc_oc=AdoGE2AE0XygEOj7dJT7vxs5OVIIFp9RjtEUxzgC6he8JuaFyV70mqbKff5YlhJ1lyU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1ADJVpe8TspivOlcNbKXYH7hU6taJjpGlPrwsfhXl6g&oe=6A8590BA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WZdIKmvhVMQ7kNvwGg3NSs&_nc_oc=AdqI3CuFTfHnuiaUNVgePblvC93PjehpYEuWBijvRV85x2DxV9k82FCfKRD_EB636uI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfKoOc3N_hrvpiMjcmvpQ7fleYeJy9xK9CqElMfMjl0g&oe=6A8579FC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wl4Qr0OHrQYQ7kNvwF_BJBw&_nc_oc=AdqPXv6XaVJ9uTvtiG2WF3v8DlVYBLBW5yeLHf8-tNBQ3dS7lrveQ3cIhwXiDXHlaUs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVwZo14ZADGTTkcwkjQhfNhiH7UGjSv12QkegsO-XRvw&oe=6A858C2F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZ3cmKpPTg8Q7kNvwGy76hV&_nc_oc=AdoraXdmJfc0ORZ6h_N3F_0tCsNhjOba0603WCbM5RPWc2s3fZ5-NxikXGlVVKzx4BA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfPBB-UroFZVg84SHjgEC4DyboUdYxPe-WwJTZMzQ8mA&oe=6A858695"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBO1i_pwrRMQ7kNvwFAlzbJ&_nc_oc=AdqD1tBWElohNzC5xiE12RVozDABoL0I_-aCYv0eu-ZcBLExgFnPNEWbGfb8xJfoTUI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHeUclcw-4Qsy0mCOqXEpwLZTdG6N7L2xzNiX29g4ykw&oe=6A85A5AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://be
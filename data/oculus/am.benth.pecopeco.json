350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pWJ7nY7btoQ7kNvwGoTLyU&_nc_oc=AdoK2o1X2HNmHs9a5O-DH43CtvCORVLFC5Jef2rLBgEL8BYPCqgyc5mCU-7LjAgIbYo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EqFnos3Ty8GOcAU2YI7PbrarrLB7fVsTq53iojE4r9Q&oe=6A2C22FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DitnKkfmQisQ7kNvwEggjNB&_nc_oc=AdqYAoNOkvLUrbA5ilspPi2wdrBeNFFW5wBC43hnXISDJh-3bsEDivAIjnD8E9CdESY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83vP5wr2L-F9-TZDnAZlj7DQpkR5SeTVMelOUZncXqCg&oe=6A2C0C3C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIEkc0mYqMgQ7kNvwE_n16o&_nc_oc=AdqtuhsiadudJGsSyREshtCEUURx7KCLFUhA_P4JXQIHBSS6wRb643RoOrHbHMlaJD8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Aa--y7bRTbjWdAK75HH90Sa6SRFAVMAa3cFlAnKdshg&oe=6A2C1E6F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ionq6UFXUBMQ7kNvwEc1C3r&_nc_oc=AdogdMvctiYwfeD4TAQp62iXd3XH6ZXxhwUAtLYzzLRNqVQQnVx-1gIW2vca7_ykT2k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qsegd0cEPhWlHXXNmC-6gAYgnkH0rPpa-s0_qQzYd5Q&oe=6A2C18D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZekbBYCpN0EQ7kNvwERC7_s&_nc_oc=AdqnSUv8VqASr5Lh7eUyRTrqDGAgu8MZWjZF7uyevpciwumjFfDX1gP5onJ6COjgIDM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Bi2raRKhOalIYNPaaOviuPWv_b0nx6rNY2b3do2AO4A&oe=6A2BFFAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
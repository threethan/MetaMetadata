?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n61v7fUhY0QQ7kNvwE2E2oj&_nc_oc=AdmimP1jUo7i_quWKGY4rLkDNDaOvQqu2pAbBOPFb29JcTwQjIEbUtTKLjvmfLRcZSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwcuMtuSwk2xrrw9Fqe3ZDjZm8QPBDFZdew-l1w_q8jnQ&oe=69B543BA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc9g2sSyJXQQ7kNvwEeLcQd&_nc_oc=AdmCpzPwftSxtdpORhHPSvzTzVasiDQ_XZCDY1ARdH5f8bXupkcYptl46IGIGCNy_-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz4jsv5ctJdIqzjw8jrWCjPFxsBvs2IoNeSwgyuXqM9EA&oe=69B5653C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JjsqQQvPfwQ7kNvwH-uAN9&_nc_oc=AdkMHhWmkH8R0vi4Mgb5txb0tX4KVa3v7wIKFTxgSP-Jj5RHMp1g0x4GCG2OZ9VMCvs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxEZJHuN2DazX4nJGJE4uyozhmDL2wF_CJUcMjQ_-3xfw&oe=69B53F2F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEdh2ed5MhgQ7kNvwEWW8S-&_nc_oc=AdmFUY-2xr-OBJqZXOvPgwCFkH9EN1uZgRKQmuzgkYq1MmoZ2_Ai61PViN6AdRK0Dgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-pSvHqcqs9pmCxR2Rq4Hblao1p_6_tmZ5UjdO3eHQxg&oe=69B571D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVKVAKpGyx4Q7kNvwEG9QcC&_nc_oc=Adm3XKdgTcEpzUy8uZPRaJVCqmVxZi1Tj06XUkOZhxNslJ9elVY3sV-89A8vjnKOpXc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQN7Za4sr2esZp2CnmQNzUi36sEKG3a_l-2Hp8XcGKRQ&oe=69B558AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", "category": "GAMES", "comfort_rating": "NOT_RATED", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b24bCz1n2uEQ7kNvwGRIVF8&_nc_oc=AdqALFf1FJx7jlzyXXlY17ypDuv3FRdvCiTkOFvucOtaZ5KG-lU29JBOOEvX1r100KE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS-BkyA4IsRoWLbOyuCub5udqYgvLtYxSqNim0UlGKmg&oe=6A5CB23A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3BZ_UyylyS8Q7kNvwEPYhLg&_nc_oc=AdoO68CLnC3rtQi4xcRBkLO81tO9SXN4cIsado1MfceK7OjueE1sYXLJB1Fw7xQwCnY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEztL2uKZJJN7QjSvly7m-A-yijmbgSKW5079rw9kbBA&oe=6A5CD3BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iz8T9oK75m0Q7kNvwGvScjL&_nc_oc=AdpBXpMVVNEaHSaVkVZp_jaDGChhyiAUsgmQUWHmBPJC-4pcWWhYoxoD1NieHuxBpk8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVX03_A3Gv-LlO71MiXVvTY-_BNuEVDXkabYLID8H1-A&oe=6A5CADAF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9DXmg4F44kQ7kNvwE0s2_8&_nc_oc=AdoruoO2k7OEtDmuJPwDl-q2Vl1aVwQLA61m7k0YeF93jHC9W69STZngGkZ285GYsyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd3RZFdCIOl6DGxGt7g-TJuSwBVdmahjZDlTBx35Gy5w&oe=6A5CE055"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdwvBQexduAQ7kNvwEhjH2q&_nc_oc=AdovUfjjpY5kcqjOG3afPKPNfRjTqfng4al9-2BXY86S9od1c1gbMKk0g89odxoRN7c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV943Fn2YpTtv6RHC5NoWEqk-rSRkdYXm-DUiTWN0BeQ&oe=6A5CC72F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
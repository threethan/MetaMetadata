350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfsDYcErm-4Q7kNvwG9BSi7&_nc_oc=AdrgSLbFlX7FbOaUBdlYsa98MUaU3Tvjg_E4VSta9ArzSxf1Sd84_FNd3cq6Rl1KHL0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAIhTNqOUKJAHNLQPxf7gqsvn-Gi8PsKrUC4gqHqKkPA&oe=6A94113A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Pjv-CE41esQ7kNvwEaEA2s&_nc_oc=AdpOSwepzlc-BlDXgwl2qsE8Y3ULlvcDhzBHbvFozkaL2r4nu4XfnF3_7noycBXRkto&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5IdJ-ZNjxeJ2D0S0xqVFSgRuOMQZEXbZt2-pl2uupZg&oe=6A93FA7C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDl-H_Sj1ZkQ7kNvwEgfFr-&_nc_oc=AdrsRreHkdj4NWk-_qOmxiDMYFwWdHfK7DpHljwKS16LNb9A9P9w9TulJjNCre5x5Gw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEM5gecsrLLVKO1y7zpfd1oJIrj7tuX2BfzVlagapHcA&oe=6A940CAF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGfZyguEGgMQ7kNvwFJL3z2&_nc_oc=Adqre2ZUaV5KRogW1cChKtd2btKiSau3JyGP1YLEh9BzfDnDY_9xXdoDabcsLSTNiak&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgI626XNtEzjUfSkRoVM68CLOFM98smv3cqnAKIi733w&oe=6A940715"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtJ_7wrcDRQQ7kNvwEjmEje&_nc_oc=Adob-hWan5toTq8nhDYubo6WFG6g_0dqFbWxt8yE9JDYqQa1cLUpQqNnYyxuFb7HC-A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRmRfRuM_zoaoXKWUb660VWIWfr9_uQPr7m-PKTjP1hQ&oe=6A94262F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
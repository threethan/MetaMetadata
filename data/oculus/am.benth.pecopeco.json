350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jksjjZxxK3QQ7kNvwGvDmVG&_nc_oc=Ados7arYnIAz5WRVX2t8Goy0p2Si2kvud4F4J1tAjgrX0gmvFFPHZ8bpnKd3r825tlg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kXeJVNceAsyn7pifchZX1GBc3oryJI046INMjTXiyHQ&oe=69F4C3FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNAmXnW_vV4Q7kNvwHoPaW6&_nc_oc=AdrOQ_WlTK-FLYnU5y8NaS1OJfH2-Yq0_Dafq-yOVe5RPiLsMbWMoZA2bKDudFU7IUY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Dm9E7S6qWKM0fvi4pY36NNQ3gXCt42iE1ZFMZ5DGuCA&oe=69F4AD3C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NA0zPyc4En0Q7kNvwF3TsSv&_nc_oc=AdrwxGiuB8JmJ2gZ9_JkckhbLrDNVZ0HYkzE_dugrWcH2qo8AwtnilWhUJhLpTbXYwc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1hKSX9l3P5CjaPbGmfq600IC0HhcfoI5VfSW0V_yqAmw&oe=69F4BF6F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ifs4OnOoPH0Q7kNvwF9yCcH&_nc_oc=AdqaE5rGzWrGV3TEhhchWJ4jgUOcxSvfxjR1ysFqGTmU159xAvgSuFEUUrjo7EEVhOw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2A2ePPvdJCNKz75azWaDNM5AgNcQiZFoD-zxjnv6Zpag&oe=69F4B9D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pLOsVO3rEQQ7kNvwEw1JEH&_nc_oc=AdoBDpVG2j9NfEC00aiLFozXvEUNxFRs8IgFoa3iE-vlFbIq4JgJ5dAJdZaZyiBxpaE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2guqvQJW76oN-SWmfjyB00X0oLf4HpSvbmnSBVYjAvZg&oe=69F4A0AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
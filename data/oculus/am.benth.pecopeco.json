350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1X4qnao1djgQ7kNvwEMapiq&_nc_oc=AdrAm803nt7QogLmazeNUq3EvOWNdcie6rqCYKAP1MYrBHmY9h5E8T6qDO1B-HXePAI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HvK6Zwy9EnxOuo-_gVm-fcxHJFCyKVO_U4VTIVxScYw&oe=6A0F21FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDY2zDlIe7IQ7kNvwFqQZXO&_nc_oc=Adrpdtv2t4BsQj1nPGWfmScStIBjcYur8WySQE5OAELGs2y7NIVRm01p1PNDbHZihL0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UCUxUhPXgzN00EszQ4qifuswKy8qvqpRuDVcubFu-Hg&oe=6A0F0B3C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IpsEa4H2fYQ7kNvwGztBmt&_nc_oc=AdosdPk4IM1oVbbBzY91YLUVxB4WLBFXaFHhVIdrllhsb-I9i0ZlPdFEmz7YRzqfsWQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vz7TW1Daw1-cvOkVHXbD3wSLOhfPAS6-vbZPxlfrQkQ&oe=6A0F1D6F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl7mgcEO-Q0Q7kNvwELpJdS&_nc_oc=AdrSCPImYMsv9lzoiUs7uIpjwIrI50ldJx4mtvizq8b0cyjhVff7y3ebjnHOvYye-W4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MklgmsPo3LDF8onbJWjdTCR8CQ5yl-1AJPNZb8_PG1A&oe=6A0F17D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOosykTzpvgQ7kNvwEObCMV&_nc_oc=AdoGQ9kJXV_by4scU5r0zyFc7XDCKkS3g0DF8uRtsoa7EtS6Pr5qnvD9Jk9oWhmWNt8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T_2Crj7DeISqE_RUG9GXPzNgSBRE01XdfeRcc4Ckyug&oe=6A0EFEAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYtskRM6I_AQ7kNvwGjGloc&_nc_oc=Adqr7GsPvypDVFVdWilVcuPKjPsi-_gCABLkvECxFvD2hYAGjrPlaVuvqJ0UbQy5Xp8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KTbafzonyUEb41FOOeVM0nWt5uPF53louip0uB12ftQ&oe=6A32BA7A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybRLdqDZXvIQ7kNvwEQUir2&_nc_oc=Adq30o_in91zXW83W6LKIvzo3_vOZ02x1pQGVkj2pBSf29XIj-eIHF-YSXnAzdZsEvQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DapLA542iTmOyqBDT-cnyukNlKdz7xET1U1HgqHJ0gw&oe=6A32A3BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K7m1LG4774EQ7kNvwHflSk4&_nc_oc=Adp0JqgYw4nKhXjZwBNm1nEh-J9DTI3FeFyjalDneLrD5R1ey0kAeaMBw3FKBUVE9Ew&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CKB3q94Mn09DoEObo9izyF6z3GP1ol0xQqouN_ky7EA&oe=6A32B5EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYjFeWrKSGAQ7kNvwET7OYi&_nc_oc=AdrR1QbLuu24UcFyDA0Zm4GBfhDxJkhGYVDiEtknLWD_GWhZO4_hcT3Ph3kOCVvwzRY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5NutiqrSZmrcnxlu50Z7VcxofZv95TEkP34CWDft-1Q&oe=6A32B055"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2Wcg6v6UgoQ7kNvwEa2Erd&_nc_oc=Adrc1ACgBsow35xhxdVVv_44MN6U4pMwCD_gxVJGkyyZsQ2ODhgdYhpaHg0f-B5kMT8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q7AN2qvH42e1BBDxOMyk7m5xj8lVmNWrpGCDC9ylleg&oe=6A32972F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
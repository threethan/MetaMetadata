350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVP8qOhK71UQ7kNvwFsEGOn&_nc_oc=AdogjzuWkzBJumYv1ocKJ7FGwRvQb-Q67cIa0zZ9rf8RBXm95DreUHyT3ujBm405uwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRKXr4-zrnNh6nqpoux7i3jfXnXntHBTp3f_quh2BdAg&oe=6A7C563A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Py9p4vfOq4AQ7kNvwH4RsoI&_nc_oc=AdrDnEmgZ1tVZhgq2_sB8f--W9pD_GItTRMOa7NWI-yK0gnr1HBvWRY2c8JC0SXy3-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcm6jGhXFTKR7i4xcAMK-_QvX--NXpz_NsuSdL0WJMog&oe=6A7C77BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L6pdhC1jM4Q7kNvwEdY-eq&_nc_oc=AdqCsYx14bGUy65GwYDbyjq2A3IBtWZg3ZtarE__qYadDg3iBRuxBrHrO-ZHxtUYwAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfwCt4Aag-6hev-knTS2BjLzuM3uz_z8DdwBRqo7EcJQ&oe=6A7C51AF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jS2GCZPoCxwQ7kNvwF7mwX0&_nc_oc=AdoCUMH7HorQf3oJaqHRHtSpWLHlQEbl09_jDDm9UQT3Dh3M_WJ3zDhHeX6J8KCPM24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCC5-EG46um-dgnqWUviQtDj1GR9tzBK8g6-ZYsP7QMw&oe=6A7C4C15"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9cYh6rNFRcQ7kNvwFzpETS&_nc_oc=Adot493HYTTBLDDSrbshXeEETEntK9m9flJ1d0jWmHj6WF98-mQE6i9n5swOrRHH-ss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGLBdB2f8fDhQHBwIQbOqLO9tOjgB3jWsNbEkVO6xQjw&oe=6A7C6B2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
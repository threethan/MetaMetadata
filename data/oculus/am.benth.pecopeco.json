54350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6qNO0IxWzUQ7kNvwHLaEJc&_nc_oc=Adq1HiYNs01SNKqw3suk5OBatKyDfNGNQp5OQUhf4P0sQdKOdtZ8G-PJsU5FOYGkuA8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MvSKNSouM2jXoJLSFwp7lN_SiIlc7JbwxrWWgtHRiIQ&oe=6A4680FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AiDyFEjq-5sQ7kNvwGZmOd4&_nc_oc=AdqcbGaaYiKTK7UXZiCrAZPx14nyvmYDcAp9QF9gVGhtYNAuznG0GkA0rSsrqLF8Yq4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ddRTp6yIZatXUK2JmkkGj_ug-PdmM8Xp2Tk6fppZkxg&oe=6A466A3C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O9EepFEPTTEQ7kNvwEsOkxY&_nc_oc=AdqCrOUKX6NwasyC7U7E68xztZ7CHsQFC9LRc6hwxQyFke-gXsO-av44MOMSSVYl9ds&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_X3iDhlvwbW_Vy-nuwjhVtw1TDc2Ea6dhxMGYipUXjag&oe=6A467C6F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICsimk457WwQ7kNvwH3dRaO&_nc_oc=Adpasv63F4CxhYtMUDMD5VuKjSohfuBpXKtb7yh8nUp5TMcUB3ehSYVyi2D3CcGaQwI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Cow2nOBSA6qt3i9ig6ndSVYoh4ATTsNEfQFp9MUIsrQ&oe=6A4676D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nGVq4AO8DUQ7kNvwH8G40W&_nc_oc=Adq72hW92-s1UNGql5WllwR2Jg9Cjp48JmGwc6NDwYA64vKe88b23qJMvwTgEA4doe0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9arW_6_71TDRD8ViLAd5WuAdEirsKIQxNraCiXWUvbA&oe=6A465DAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopec
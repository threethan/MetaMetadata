?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deB0LdL2CxkQ7kNvwEMHDHU&_nc_oc=Adnqouy1gulHKKOnT5Z6sbzcLht2ynB3s2EqZEH2mVVySbWJgvqaa5erIV9Y_HCRJ0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftf5wL5RWZtw1vTIOHxy7h02K0_PjrNKBXmQaNIoRKflw&oe=69A9663A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IibzD-o9uaUQ7kNvwGwZw0U&_nc_oc=AdkHudWx2keT804DOpEWOSx1_C0zlrc9dg-LMVqICTQdGa0v69WbljASNpOp2U8abqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftQ9nTm-I55eR-ddb3SZeMSBvqjv9jEPX6z1LtjzGcPrA&oe=69A987BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkSByfFSFYcQ7kNvwG2MSeq&_nc_oc=AdlLaSEpEY1JCjol7lNBhVKQhGgjNy7tYgSOXP3jDe2RUuYu4se2lunplANO7zSanKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftlGo3M7Z2tbeffef3w5aYEMn_wmvQPm6Gc6b0J05dKVQ&oe=69A961AF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugHMaMQ2DJkQ7kNvwEDO4Bt&_nc_oc=Adk42RkpsB06Q2ho11EC--AuMQMt8RLyrVXF2uRjUE4GTUMIqENV9DUbc0w0X14cFTU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvujQ_lKUfwgA8cAsYuzgPIi3MICa5YT3aE_Qhnmaro2w&oe=69A99455"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDqjX1cM0b8Q7kNvwG0K39l&_nc_oc=Adms29J3wxmDKGFz0t1Au9mlleTfpr0iiG95DHfBYmksIdYvoePyhEEK_vPEfd85SCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv9Dk5pPZp2w1opsf4xTu0IJWXZQ5sg0kCTL6WIrBaxLQ&oe=69A97B2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", "category": "GAMES", "comfort_rating": "NOT_RATED", 
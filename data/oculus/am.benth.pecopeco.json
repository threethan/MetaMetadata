350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kN5pmdltHQgQ7kNvwHg1Wom&_nc_oc=AdqvO5JrgpCX_7dmsO1iVU84FvGUMIf19RO0dasvJ0y7yPYkeHcC5JRbFZPCJW---Lo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp9_NALWc86lSkUAHEEe8Bu2f09DSdMsNNZcOq8q6EZA&oe=6A6DD5BA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6NEJtcPsXEQ7kNvwEDCsr4&_nc_oc=AdrAaul0g5_CTWNwtpCK11LSW9o0bb-5vZqnYCC-RZ8wxYuoVKqP9bKBLKjrrnL7oPU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZLeYJmRM26ACNRMaDvY-vwH5M0U85MuBr0GRpFGqYeg&oe=6A6DF73C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULeYCZe0Qs0Q7kNvwHHukYP&_nc_oc=AdoTw7wkHUN4lE89TB6CxMgjgbMOUybwJaGdnqaQdzOpiymTdZktQA6S7m6ChOqjMfg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlJrSMkhhb9x6JHlZsLZAtu3kFCVSOi2Mr3exDsIt2-Q&oe=6A6DD12F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddKwFBFn9msQ7kNvwFD5j4x&_nc_oc=AdoiUmuVr1V1EXChp6Nsg3LA8dTXtcY3LkrpbLgDo9ZJTw-ug75k9SSTQy5T17O2WLk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIBsWGOuwUzwRZC77wUBCmJ722__PEyPE5atoXtC3iQw&oe=6A6E03D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eVu10cJsvUQ7kNvwFhy-9J&_nc_oc=Adpzik9cooHLqYCqHIEMjgalUC-9b4y_YYjW9S8xS1aVrDqxzFyNcyyEQbQoKy8u1k8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDd7ETvfpxAPWPYU1z5e0P45BvK5uVLMNFcuSWOr2i8bg&oe=6A6DEAAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n61v7fUhY0QQ7kNvwHyipWR&_nc_oc=AdkqMmalDcFgMpzotSgPtqJZM3TyOacA7ApO8NtW3_7xoVwu_35cWTAlmRG_9CRqqhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx1RBdpKWtpxtqlRTzjQgAu05idfI1_o48m4ylMz4AQGw&oe=69B7E6BA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEKW-IXkqEEQ7kNvwHYudL2&_nc_oc=AdmKNiYLXnwQibRBmoLAppJUjqXt5L0hf-Ibf_SGozERNLpyetBFVQz0gDx5Z9VvVHs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7XTg6GJbhrvspvHYfOCJKleULC3UTIuMjduZ_hZRGSA&oe=69B8083C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8JjsqQQvPfwQ7kNvwFz46fe&_nc_oc=AdknmgXXCI0PQrhe2HMHXhgoAf5BittBVp_Z6D3gqpdfRSvrHODlxcPdWBDtg9XHFFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZY1hwY5yeH_u7Y08o2OzUImP2ql33Erff5XFjpW6TwQ&oe=69B7E22F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2nvH356VygQ7kNvwHN07gu&_nc_oc=AdkkOprm76O9LymrV8O8n6lYLk2rPe5py9cnugWeXsyNWX4CNDuex7bKHDuyKr4AO7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy_-i58KnE_mEoSNCIK0TwS-B8ldrOwIrhaj2XymSdGTg&oe=69B814D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HgfCED6AgoQ7kNvwGMOlvv&_nc_oc=AdmRmHmXTyouFz4F9lgbUg_nfkvnOtM28u9FOGm7cGFxgN3SqWGj13uOTDQG-rGWwYs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw9G92RjjccW9iKeL-wgVakD_RUFks3F6TH2ps5vxiqjw&oe=69B7FBAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", "category": "GAMES", "comfort_rating": "NOT_RATED", 
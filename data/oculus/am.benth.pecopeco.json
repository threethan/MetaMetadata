350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jXiSpJCOwEUQ7kNvwE3PG7U&_nc_oc=Adpjf3U-PvME6sON6ayed7LN9Z6UdA_Ny9D2hfcj-LXSDNYHzzQwpHRcs4joofNK94w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKs5CeSSUeIKif_RP31NurURBQpKJpzzIQJEIFUfSt5w&oe=6AA6BE7A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kRwXkCsnvkQ7kNvwGLuNbz&_nc_oc=AdrhWoh6dSQYbY8yQkSmvTw0y1HRDfsKN0T2EdGvERuehT_6yXj1lEaChWSJlR53rQM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC69cTdrnbmWY3jNCAT063xJnY6ab44E7_tMkWZAPyrw&oe=6AA6A7BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSxEqiS51kcQ7kNvwHoBMSK&_nc_oc=AdqdGpjVPPmcBo3hd18x8FYDa_RQYfv1LCvP0UPEZ0I8o-_mfenZ022HoAByMbovAJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLqMoMDh-m4YSRyEg_h6E4jVnO1269P0VYG1zh8Dxa7ww&oe=6AA6B9EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V74w-Jsgp-kQ7kNvwEy3-Bk&_nc_oc=AdpgJgcPFR0TjqVaxFxkEXiZ-7DogtLUEjrbHBfulYiIv16qiFIYIXTyEah-vdkNxVk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWtElXX4qAAAR6c_1bCKIRRCpnNhBvpE3VVqE4j0yfmg&oe=6AA6B455"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ir5xqD9UX8MQ7kNvwFWLQ-I&_nc_oc=Adp4XhOLBqXlB44mgM8WoOHA4O3wpdSCX7wPq3oihZYZDnTzl49KVW9_w2LdeqQfh74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbHZNanyQ4PsDPVxgYBEVPBQlmFFEeKvAjT0rKEAFKGg&oe=6AA69B2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
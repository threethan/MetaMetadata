350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTRjSA6Jh9MQ7kNvwE1sDNV&_nc_oc=AdqKKyH45dJ5Lf14LZ0AsPC_-Hwv9U77E2rpcJZo3sNqGD4BbrDdQj7Rw2wDl-WCoag&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTjmQmRqJz2lkdzzSVF5z_JH1pEfqQPySFnLJa4KzuBw&oe=6A60A6BA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpL9LEjYceEQ7kNvwHcNZN5&_nc_oc=Adp4_vQ96dB8_1NMIcdNd9tGn975GiBjoKlElzf6cNmyF_ThFFOIwBPZ0GzjzbIShE0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJuzcUs2sQQRM9ZQf0a6yeXLqGbKgM0oABhWnhIdhRzA&oe=6A60C83C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQKr1XF-DbUQ7kNvwE0Lfjl&_nc_oc=Adr3AxQTct6ZYnvyc9PyWVkxOODI57piPcDVzFRz1hf2Dh-5BeZ6p12bF_l4NqObwDU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhzPO8YCWzTfae76WfrizxDOkrate0Z1mjQ-EeiwRr0A&oe=6A60A22F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBBBT2L7hIkQ7kNvwE8Y5Ep&_nc_oc=Adr5abj9zm3qdrH9jhR7FPzzuOa19qJ5Hz7jwT1ZISwVZhDosHTcTcaj_iJpEtzhV6I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTPaDbfDq1yC558l6zlEm-UH577M_tAznT_L-dYVOXIw&oe=6A60D4D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VAAuz4XasFEQ7kNvwHsdRGt&_nc_oc=AdqCRFXJaAauZBk9HO0_YLfyVjuo03jH6xCEPmBxkSkY4qPrAdexCzNL9b5jWhb5I_Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmFUjPO5XUwHceaCSnNeav8HTuf9wRkSrU-n1hDhebpA&oe=6A60BBAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
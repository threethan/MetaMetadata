350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yTHuv5LZjtkQ7kNvwFxBjkg&_nc_oc=AdpeLtfyK3WgGpn_6jLoekOGY32-YW_OMCuki7sgPlt0mnzTxm4UJQmqMfYCcRn5Nw0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E33CK9nnXgzZ5YJ2nc4FP_uaEyWCHngPmibkArs0Ajg&oe=6A15B97A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z2wvTP0XYEQ7kNvwGjK-o4&_nc_oc=Ado83X8PdJgnbsuBEuN7g9rUtQX2-mr8urxxyBGVI6VJxvP2TBW1_nmUvgYQhmQVNBQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_fO7LatJvEk8vbWO14ueH8M7fq2meMaKEbUTFFl4CBQ&oe=6A15A2BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PQB2qVT4YAQ7kNvwGpNg2n&_nc_oc=Adoxua_UEnHcVkuTnnFoft6wIPX0-ulzpV0_hKkmJmyZMeBqNYczXBsRy0zhXdYKlGk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55JE41NQcteksfcRcZ9ZeXzib5ahrHnhplr3tRMYlHyw&oe=6A15B4EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiTtyJfFdqsQ7kNvwFNZciG&_nc_oc=Adof9e-qRo_CwgI_qupgdflgZSpp5twujUSGshhWVHQFlzHjK2RLP-0bzKy3jK07Vpo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N3QW7t13a97O6KU3QL1tYjknSgGdwp4iNsBM5q1GBFA&oe=6A15AF55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdfLikzmsRAQ7kNvwGOn42G&_nc_oc=Adrj2KRsV4OXLEkqcbZztRJSE8TgeT-fkgbpCuWHBpsvUXOi7GFvCVCN32Go-JNGHCk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EXLkvXEAASZeISPW36b5X4VYyRDKCRWvTlVQNu2gjVg&oe=6A15962F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIOpIftCrT4Q7kNvwHsecl9&_nc_oc=AdqyhUwCV35bX0QQ32Y1TA90pYYj48E9XuvE5eLFOPHolzh9dK8i2kTjYGRRW-MJhnM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIFBjtdd2vz0TRzJSX8tX2bOe2RnbbG2JfpDFEwBh9Lw&oe=6AF5D87A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NNNnIqcWhEQ7kNvwGj8ybW&_nc_oc=Adqxto9rG3eS3FEjaJjOyKizFcqNxopwS_QfmKI_bfD7m6YIVnj3NufKNC366gZS09U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3Qwz7oZOSIMPq8Lf5KiFlvZj35jcAroY7Bcas6UZaiQ&oe=6AF5C1BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfSuw53nLwMQ7kNvwELKsoz&_nc_oc=AdqX61CUiPmmZaXoXaPHAxybWqt019kbzsl-KUHD-1a6rAvFyFgTrACcI1pmaZ_MjMw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJQmOiNX1UqaiG8gYH5_ZLSeDEFkYCeI8v3dg9sbBAgw&oe=6AF5D3EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrRkHkYQO9AQ7kNvwG-TVB-&_nc_oc=Adqq_OEp23Ns5Iczxu5mBB4shBBxN-xWj4O_KR2T2IUMUWHYOUFDlQkJmBJVj5cJfXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCcdmav6VUqCSJcOG3vgAyFNRAT2qZp2aJJoLo3vM6VA&oe=6AF5CE55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EVCqYHDWPwYQ7kNvwF2kx7L&_nc_oc=AdqqmYnKNWWG229Opa_flxOmnqHnbB_Rv_9f9-0Lf5N0C8FXDjTBnCTceOsv6ClbOx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9ZdajVXKQ0TncYOchq_lYUZyy0JL5Mwf0UhcHClms6g&oe=6AF5ED6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMw6PhhTQcwQ7kNvwGegUGM&_nc_oc=AdqjpXt16J2HY09TWUHt9ygbyHjRrWC_aFHfZdCf6rHXTzQ52BaqCxyeEx-MKAbZo90&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIyEdlrsPcH5TKR3uCmxN_mCvl9F4s5H_4XnQZIOIzIg&oe=6A6F273A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6NEJtcPsXEQ7kNvwHlht7D&_nc_oc=Adra0_j9BmilBJmvnJ4ZTy9lGcXiNnnv_Q1bhLY6eBesZ22ZqYMvpDo9wgMt9632mc0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAy0ho9JAfCW_4GenIr-REs7WpVJLsoZmb-ZKuaI3tTyg&oe=6A6F48BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBCLJ7h8hPsQ7kNvwFU4IC5&_nc_oc=AdrBei6EJUp58NuH7gxLmZGMxZX3la5aKmfnfoKjKx5XAIz-dlnPWbUoPAYYpR2IZCU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZgzxyf18UprGSvMnUZoEswEG084dANU5a0SQFxjbekQ&oe=6A6F5AEF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddKwFBFn9msQ7kNvwFzch6D&_nc_oc=AdqYkQln7pSFfvj5yCY2E5_97yaB7PoftzJHa4R3Uli__vzLpSqNhA-fMGTC5FDBoxk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXYwwUj9QpMIxK8VmhhJz2TvynhiLytOUOmxWV7icGQA&oe=6A6F5555"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eVu10cJsvUQ7kNvwEMHOYk&_nc_oc=AdqRd7iTdzqY8GVfGgVpZFMylvXphoziceWrMuqapQJSxwHYzLWFwV-h_hzs5k3UzlM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnZ6pRBM1pfEmhBO7rN4thLrfEpEtDyUk0SL9sX0Y0Vg&oe=6A6F3C2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
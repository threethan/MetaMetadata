350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VB2TF-aYNBsQ7kNvwEmlwet&_nc_oc=Ado7TATgt2bTlUEubWFnNvg2s-l_qkHyTFSTpzp1PxAUz6gMQgBsqVy9vPh77VHnYYY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw77ZwLoctzyI9ABH04p1O-zZfqPeFa_6J7mwYLAAWGcQ&oe=69C515BA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DI341VmiSs4Q7kNvwHID0eS&_nc_oc=AdogGHwYoxp7v0icLb7GlVSUS4A6kvlIoBD0ZZ9WAddfBpBD_imrTCqkqQdwuOjsUWM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzy-26rOo-alJmM2hporlNYUGl6mAKIPkaL6ohksRoUWw&oe=69C5373C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8jjzvIdrYUQ7kNvwFx0ogL&_nc_oc=Ado-nAsjLFYVFB6q8dTk3AeiG8Cr6BH12lb9-miXvNaLhutUIakwBfDJbFvaK90kc-A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydV8hdZFid8RiIHRRLvmRXGJOnQys6ST90SliKyu1Y2w&oe=69C5112F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQuvWoDA6WYQ7kNvwHTqlCn&_nc_oc=AdoXIcWUj5vSjjsZZeTHLIUfoYvpTDozTKsqLMyP5lV8peSGSMtGntqUzX93dCvG2ZY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxeja3UJIs7jf_OGFZt32JySj07DIXkKp2sBqS0IRQ8ug&oe=69C543D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqsQfdt0KOwQ7kNvwEF3AXb&_nc_oc=AdqTvnI9i8lTkEUTFn8FHW2ifa5SdU3CAF5yC-0YcwDW5vcQDFH45rGvOyViAfRjhTw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRfbVJm2Fx0BVr1aaEj2hP7VOgwZpWhe9eBTQLYjdu7g&oe=69C52AAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
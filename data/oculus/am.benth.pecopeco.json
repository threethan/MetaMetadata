350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pkZDBSd_8gQ7kNvwHACRPE&_nc_oc=AdriXudxqRvZYiy5S756mg1uDb_e_GulPDFHCxc1DYR3GSK9n4HpqlNbtyhUadQgKfg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o-fpjllw5FVxN9sKm82ZLx5iew-VRovb58rR-YDMwrg&oe=6A20457A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmfPXgMwvN8Q7kNvwG6p5CV&_nc_oc=AdpgDmlXyvN2HHqL0vddjwwwECplEdkjD7opjkqZtQL6kJ6bCfU3rZe-WxUG3qzLIzM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74GRFpz5NGIkGVVp_wQoZ_-6rb5mRFxgyxC0_uX1HGUA&oe=6A202EBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0Za9BY2tioQ7kNvwFIKeov&_nc_oc=AdrphLc8yEoF3tOCxFvXSEDcu07ewc0pCQubX-w8VPdrKVcVFwWIY6kzMqv1YnkM1u0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Pf6ipkFuxKP9Uo5BV0iRYUqqlB3h6XA6bQ1EfIu5X9w&oe=6A2040EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2SADvGZ-pgQ7kNvwGpNtNs&_nc_oc=AdoE5WwlJFVxPBwDkhlri95Hqkg4abaBLOhnwNfmeTnGqxYgC0H-P6tcFkghdhaKNY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SaYgLX1uuFjeBZ9cb8Gk2oR5_5PU5IgYz9ezGKVe1ZA&oe=6A203B55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_CTEm__naMQ7kNvwFByWwp&_nc_oc=Adoj8YShZI-p9Cgnil2GwxxuiZRDAT2Hl8JjIxRy5h8nEP7_wFGsuRydWAoWCxK6OkE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Mx285ZYYMH8SkB16asNkITS97KZUIGY2kyDsSH0IhrQ&oe=6A20222F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
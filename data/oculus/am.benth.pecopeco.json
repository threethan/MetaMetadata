350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyG_Y4FCQzAQ7kNvwGKUaLL&_nc_oc=AdoNmFnw69Ts6FiIamTlyGIYqa4rVaQg4T6urpg6hcRS7Qv19ni10bj36cqBQZ4078s&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZBkSHYa224w13gpPzuT_GhCIwuqaKF3eCFYvvbaPOEA&oe=69FDFE7A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt2ADkoORpgQ7kNvwG_zmZK&_nc_oc=Adri3p1YffA_JM5zGO2pEC6DfVegJbtxNd31_UpLhfq_vnk503ROOwsSis43kJlGjkU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af587QndKFAtEAlWfrU5NAz-uoiQl3FqAH6x0hvQqMqNFA&oe=69FDE7BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQDaS93Wqd0Q7kNvwGPvuSl&_nc_oc=Adp8PIv_1N3jLU99fuPUxHO6HWLK58c31-r5t_La0OY7FToTC-QJ5IHJJxfiriGBjqc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lyeIOCf3OYas09aYQQ1LceaP5baprAmTDjoNCRXmpcQ&oe=69FDF9EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y84h_KhcRcAQ7kNvwF9-tsF&_nc_oc=AdpZN0QKHWmlP8wYZVo2pgFFHZlljPvgN2A7zQeDVLfVAxC89_2QsLaFo2RrMQsqONc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-tllYgHEUUA3J4ouSI0T2RKv4djlSJ8aN87k2TFQXRg&oe=69FDF455"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulb4FqW__DUQ7kNvwHLNc8h&_nc_oc=AdpnB3PPjAmVtYwTqObLcv2vOoXoXqg9vzgZk_MTPGMAvauPGorMh7rvkTulV7KrZ74&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uGcGHaDwqFePg5g_9LASkesvmM3QyBGqJjzcCAhHfzA&oe=69FDDB2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xw5Qu9nhIdQQ7kNvwGc-T5m&_nc_oc=Adr1oZLWxFVLkKqKBgU5yPIT72ks0tSNywLMS6tgVjLlnKRuOPueGQpmQWEr-UOUh3g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WAHlqjoweINL0Vobwey9oMoF7du00u6EOZ2ppsOPozg&oe=69DA2DBA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7XB9HvGnBcQ7kNvwGVnlaE&_nc_oc=AdoI8cUvQ9WTklqKbDMJOjn77xcL06x_whT8YtJ7svkQhzeJC-eTDKAC-4DHwrEOR7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oqcNazy9_2IeWDySILMBLbrIfdgodWA31cEhLAEWE7w&oe=69DA4F3C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFiebMJkHAcQ7kNvwG9m6p3&_nc_oc=AdrQ-kaOFgt9Kst53Woft3LDfKPO0UNZ6z9XMUrf1fRM4i70U4q5paDnwCVSUX5xHKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21nQ2v9JasIgL-UNt-dWpYWC0kkZ-8N94yVT8Zh_ZiJg&oe=69DA292F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY1XCLw1_zcQ7kNvwE8fLyZ&_nc_oc=AdoNcNnGDAbY72C_XbD45ean0KYLOkTSikWBxNvUtj0nb8TM0Pcohwt8zX1yUnxJvH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mf9qZf1v3tTjO6kmMGHI1gNFGEEaED73AmJtBnOz_ww&oe=69DA5BD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFvhjd6W89sQ7kNvwF8prPl&_nc_oc=AdrBplpGFXJK7PmqtF4yMtEhQjetIXLnOCEbpQGj45w-lTPg6rOhECB0Kt_LC6Icg70&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RBZiZm_JliDvGtN_tdtQhrnlDeJAyMiV_GxqamqssxA&oe=69DA42AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
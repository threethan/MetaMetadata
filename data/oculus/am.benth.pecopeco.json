350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pRVhNJxE9oQ7kNvwH5T25s&_nc_oc=AdrbIbXyzFIRMhN8ICNRgkMkqNV9jkbA5n3-l7h_xY22olU78GBKRRjAMnY26WKbGMc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg-0b9pY-rAJUCYq7wLW_Vh9wXqcC9YRjYQwAkG7qhOQ&oe=6A4E69FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTxxIlF8BOMQ7kNvwENeqQk&_nc_oc=Adqjz1atDgEyqtIgUHnSWIYeSxmyobLn0oJJyi4yuQQAfh21g_YAUfguKCpzQlaYlX4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_tkTufkMbdCGqwqjFpfVDSjLvLVQzyob6n6VGK3DNDA&oe=6A4E533C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tN6KYhiU2sQQ7kNvwEVdC_e&_nc_oc=AdqHpV5Am66nwV2CL5NT0FUGe_dEmfQD0kl9qnNEcIwH8Qob1qKuyw8WNruoK-u7FHk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbX96cTLNj0A5WZYVaPPjePVhV3lWchjv_H-ggKfgWbw&oe=6A4E656F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xh03eBXkUqYQ7kNvwHvsmYS&_nc_oc=AdqyH5QAfyEtulDIoVXUFP6dzxD9CaLC5xI6jXQOG5ZuE6xuv3cI2FzoXFKds84KdZM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATlPVAurqObILCBT_q56Fh9tSx2eCiIhaM8BujR7vF-g&oe=6A4E5FD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7n18gyLapU0Q7kNvwGsNijn&_nc_oc=AdoRh4wTIvzJunK2jzAyGBTyVZIqS1Y6VsknkTQT5qjgHV5boec0dVeVUgaVkGY-1ek&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIj_sYUoX18dN9ykw2P2iYV1cYnN2L7a2RGgRLpzDluQ&oe=6A4E46AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
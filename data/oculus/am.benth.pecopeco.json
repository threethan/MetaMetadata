350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kRa1k1KXlAQ7kNvwFRCnvw&_nc_oc=Adr8VNXCThz4ZTk56top6hRgDu4GOH1NlMIMolZdqaNbsH0vfG6hNR7xEVF1VhacjyI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPf8Cs2fnd2O8QbV4ddHaFZ6EEdwoA1WArGrcUSDWIhQ&oe=6AF0927A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lYgdIei-90Q7kNvwE4CRqa&_nc_oc=AdosuZxNTYErZKjWkUAoqeVfm47jRLRmQDcziv-P-BcYK-G-LMsio57yqmGD7CEwDhw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRESV6DbOlQj26qJ0vYJxT9iOc9NJJSwHTMnAKp3d9TPg&oe=6AF0B3FC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KO2_pOHZ8oQ7kNvwHSvgTy&_nc_oc=AdpYYNXemJ-OWpqIw8A0LpVHc3lW5dj91R0Wdi7V64P2jMeLgZkZFfhY3Y2KxgZK1Ys&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi9hbHoJmL6Z9LRx0X0U2XTX5Hj7XqENNnF3mjVcGaow&oe=6AF08DEF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1hY--wEj7YQ7kNvwE-l2KC&_nc_oc=Ado7uLAkCTnvhy0QFF5VolbV59T2LeRVpF0GTxf3BivW3ks9vezZFR1SIQFyx-M4czc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc-XZDM33KwoI0ZIa-p1IJTOVAZVIC2olNf8NB0pI2sQ&oe=6AF08855"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BMLSXRGRJMMQ7kNvwHgTVwP&_nc_oc=AdrTGt_uSy_zbyd3MzONVOWk78YvxNfDty8oo6CX-M0s17xpgq0Mo1lZtIfMnrTSaqk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgRq9JNusB6ox3gqt-O39SfzBESTSElNMz1pqtvYFQ2Q&oe=6AF0A76F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
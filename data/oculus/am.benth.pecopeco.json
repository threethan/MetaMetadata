350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xw5Qu9nhIdQQ7kNvwFphhGk&_nc_oc=AdrqA0Y-G1j-8a7I69Rk6wn8oRBJzm17XKceZmMdOtwqSSAoyW6W9XvI758arStPkp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B22fsetoXSEQinQWqrjAd7mJgebUDNwak26jAYxjTkg&oe=69D8DC3A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7XB9HvGnBcQ7kNvwFQxQNd&_nc_oc=AdqduvozsErEimycVUnCb5XRNnMb1erpbRFK6zJOOTdYu2M-3Pz50bl8Jpirm3fgZ40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZnmTYo4ZqymqlwPQ8a3kkZydCAymKGXGdjjpO7pqg_g&oe=69D8FDBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFiebMJkHAcQ7kNvwGBJ7m_&_nc_oc=AdpVjzydxFzX3woOFgxveF79_C5SsWDpjYePD48QnRYzZpnzuj4S6WmWbTqKSM_X6SM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25YGiym738uCII7HRcT9BKOMtz_8R8QGXITfzSWUrEjQ&oe=69D90FEF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IY1XCLw1_zcQ7kNvwG9xiAo&_nc_oc=AdpWR0JtJmpio-oQGPCEs_X_AAfpmjrT1xaUgsRPE6waUjq4ADbTHYxVxc266DfaUBA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ic0mNZAaRAdBrtpFFHD94e7qpd-OtobdJb3XsHk8QCg&oe=69D90A55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFvhjd6W89sQ7kNvwHzIC-Y&_nc_oc=AdqTrdGXHVqj8TL-TcOiDSq5qRZJ9MaaXJ3MJzgNVMe58b6y5a3m44dw_GWdsCgXODM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0B_4J1PlOavoMgJl6u-EJ6D_W1_lq0hv_EF8dV5VPaTQ&oe=69D8F12F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
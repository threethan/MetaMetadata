350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdsblyfQek4Q7kNvwEc3B6j&_nc_oc=AdoKaWyCCIpt1drt_Qx4qiqVZ1KWfmeiKuzyRMiCa1l3Jkv7bmAFrjnDdMDQKzEVpR0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEgnoiXdtCcXOf8m29Bfkmh3sUgaWe1to5-5B3jQvfuA&oe=6A7899FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eA2dR00gPxgQ7kNvwH0lC2Z&_nc_oc=AdqaxuxtZPNLTC57nGWsjuvP6jq-Gv52EJPijCRyTokxMTWTUnkVlLdalbEzToyW-UI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ_Ys_0ngtSO6Z7OUKhGLzO8-mfoaKcI_sbeGVnSQaiw&oe=6A78833C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWhUh_dPHEMQ7kNvwHh2hyv&_nc_oc=AdpYKJwVr17-tBicqR1gmx1rD0F_K9723k04cimJ6XblqJNoBfeKzEq-nrFNrSE0ekM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcINu9MfHiGI7ufqW2ynI9Lx8oa07m5IGQwcCr5jIevQ&oe=6A78956F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cH9KJAamfiUQ7kNvwH8oqmg&_nc_oc=AdrrElwuDansgB06vTF_tPOGpzPrOzwQN_jx-IvVpyOEDTIYxsX1_T9vrXFywVGE3hU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOqMAk44EB_ntcOV3q5x20luNrk3ZgaPkULp-lTF5RZw&oe=6A788FD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NlGaV0XGPoQ7kNvwETMiTL&_nc_oc=AdoNH1Otbma_2Lkh3M5OyTuFo1GH8NQKdeHyL3F-RNrUFEMD8wkHbVV5bBqubskQIWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuBk0UIPMhqJL2Bg1m2n5CixtGo2QDL_-qrBA48blYRw&oe=6A7876AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
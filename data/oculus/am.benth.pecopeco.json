350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqatSvXw8T8Q7kNvwGsNanL&_nc_oc=AdrGjo6iyAYJrSg5m8gYbk_72ebn74LI6CXatskMo6SBFfMCQ2_iPJn1R36DRg3Y8to&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7JJEKBdlncqwC1DCvopG1c7F1injDYnlbx9Y_to8lJw&oe=6AA1787A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYt-mnej9D0Q7kNvwFesNLG&_nc_oc=AdrhmqcpgaIgVN8ATZ9dUbhJQW9hhr7tQ6C74kWBX1ri-kt3GxBcrLB4dri0QK9fvgQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPO8QGyIsCfEhhrFlikbyBMc_7gclRyVzIsf3zYaBZSQ&oe=6AA161BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZBG6PAAPY4Q7kNvwEr4pHR&_nc_oc=AdqRUqO32JTkbVri_WBOkwxigPiZgFy2FOmbLTreECEsphOJw3UGIwaQJneKr4cFyWI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYrH-BLjbOBVZIRry71rqdpPcJCTIpOc8MjM46aLKhBA&oe=6AA173EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3eAvUFx93AQ7kNvwFhD74n&_nc_oc=AdqYF3i2CDfQAqoJwTXk9poOghyxT1x-Chu-F4fN33edXxPKJYLRrzSrHpHqyi2ANu4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7IS3Fw07KndAJFl7f_dU0hlsJkyQbIF2cRRxN3AdYew&oe=6AA16E55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-d1Y4hPCmIQ7kNvwEjUVRD&_nc_oc=AdoXur3LlmMqKgBvXs8a29HCmX1eeEkp7bewh5soC2QT4GdNUTknLhAp7USKqd4SZxE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiLyJh4MIuOiFIg_wL2tztHbr65a9_si_eWp25KrjbRg&oe=6AA1552F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkaC4k-UDAUQ7kNvwFLnopT&_nc_oc=AdoVlPuczXmGYBhcfKSzpNYhskLeG1DIiwSiqDbu6SxleAjL-x2i1wbIMfZ896OMgBk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNi5gDvWadCr2qQ3l2PD5_h9aY6-ilalapgxXmKOOf7AQ&oe=6AD3917A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_6XPvwQt_EQ7kNvwEQAkmy&_nc_oc=Ado9Xbjn7XNW9z9CEPpfYZ-bBN3fhOOPLGJ0yttgFobJSpRfV5SrquXIfgJdsMWPT8A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfHZHuveOQqGVKBeQmL7MykBZ1TQivetuRm2ci1JU3iA&oe=6AD3B2FC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iSlBc2fhgOMQ7kNvwEV05-C&_nc_oc=AdpofSfML8QTNLnCx8eZEXZTC80se-RflPBiQE7-VDpqPNqlQjnM0BWpUpnvBe520NA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPozrQUOTKFIX9CtzAFVZKxajBlya1YS3o7I4nDLnZ-UQ&oe=6AD38CEF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwSYByP4tRQQ7kNvwFnrCVr&_nc_oc=Adr2LEh7iY1hgPT4iAfGdncdpW2UCqbGWa06dGmZyYuq7-pMqp5U-aBOznQqYnnCyyA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5AVyXTZLWit1icxfefwmYxQhub-efE9aeAoCeoJ9MZA&oe=6AD38755"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rybftwYgRXQQ7kNvwHU52Mm&_nc_oc=AdqkfVK34rwX5zFBQ6HjKP2GJYGxTtwXB_eZjeaqOUafdmhYU-jbR_4tUcpoa6LZLIQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-zBbYrSVdqGfiETriaL8TI_o3Ds38yDobBkBZGm-J0Q&oe=6AD3A66F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
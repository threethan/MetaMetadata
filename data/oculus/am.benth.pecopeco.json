350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqatSvXw8T8Q7kNvwE3Y0E2&_nc_oc=Adode5HAHe6IPrwRoEQd3FXc0Sfg3XCxPLKtEV8_PlnH7wzq1Dig2WBHI8W7m3RLu2E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT41Q78TzLdAIg-JIIm1TffKrNh5Wn69KS7ezOV8uENA&oe=6AA026FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbv116oaN-MQ7kNvwE4RE59&_nc_oc=Adq0OpbGcvQQjHxzZtdmdcZBxNiFMD3L54irYoEmNrYdSAGnk4p84WD_1r6ATplZkE4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5w_IU3iUEkSHgSwq6FK-kQaOAcLYUpxBEg1-V4ABMRw&oe=6AA0103C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZBG6PAAPY4Q7kNvwHpvPTI&_nc_oc=Adr7-JfP4FUr0vcTLp9NhtGhTvqGT6SQbBUdjFpRDsncU6RxvzcYL_C4xEXBFzaPH2E&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpA-7_Fp1HpFHF9esezaKEHq5z_mizHaJglXQcuIENGQ&oe=6AA0226F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPyFP8rx4uYQ7kNvwGI81ZP&_nc_oc=AdrcpAukd_h9hYzHHzfjKjdyB585bp5nkcmXKhCfdK5gmREn_r0s8Jx4sVIx5t7Bocs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_i7npFEVBY58YrlRmrZY3k-2oPQ1c4m1Z6zUyw-xx6g&oe=6AA01CD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kllXb88F9NAQ7kNvwFHI0cY&_nc_oc=AdpaH8syTlHwx3NRNlcFyCaPujvqywrSZu_rpsLdduuAo6k9xBW3HAaASJDn2IngakU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWaGybFaxK9EZmg3h5hxn9zWO-h1sm4BYekIjgmxqw_Q&oe=6AA003AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
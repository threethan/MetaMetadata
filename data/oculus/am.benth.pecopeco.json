350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eg-jvDJueN4Q7kNvwH0Rl-t&_nc_oc=AdofBV3Ia9CUYWnQSycmKhB8AtmBgpV8ME8aE4I9nBTktmln1wshJ4XAXyWivBrXpjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74TGtdpZVx59lwtAmjXg0oLbOPXpOPuMrC19C-g5FJcg&oe=6A05E77A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnZv-vXM7tYQ7kNvwGkt8q9&_nc_oc=Adqi72gWO-nH9OOzyYXcBePD113-W4D4ZzSbg9qeyfYVN5EgfJ6EeBnmxI8vYjay83o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wOL70HBkqwcSd7oKF3EiABK7lh6-Wy-xZ8Ro8rhegWw&oe=6A05D0BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VyYWKjbtgvsQ7kNvwEuuLGu&_nc_oc=AdqcnZ6B_UhPXfowMv8lHBt3tEEsyzjHeFkUM5WqPTluVqtpdQ-4-URwkmf8HtU2eLk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Nz1lybAHnB4tRyEGQcCjXothRQ5SZkat-xI-hLNSj9w&oe=6A05E2EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoVhvwEZIZQQ7kNvwFekoP4&_nc_oc=AdqPMTYC4tRR-6eDAj5-JQFslbxue-zt1gZ1sRmIn2HUVRLILq_EdpzFQhvUUS4d1Nw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5j0y9tdk8pZKKcay42ZU6qA4MeE25TADgARZvCU6xGOA&oe=6A05DD55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKa-dPZcxSYQ7kNvwEyTYwN&_nc_oc=AdqvOjxYfwdHPnqEQtu_dZJK_dIu2s56aM4dCN5swVRhIlKRHlO8LCVunkSO1z2u7Ec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rkq4SgNKVMegRwNumGEVu8Z1PX65_w8zTXtdqjyaLFA&oe=6A05C42F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kN5pmdltHQgQ7kNvwGXKr0N&_nc_oc=Adqo46Xz1mvVepIzT_B6sJfvbajihLBKK0gBuh2EDMy32T2KaliwVoPCHlqg60CnFcw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLXLH-nubdVI13wwJI9t-2YwYuxdifx-1putDNjZsJDw&oe=6A6B6AFA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDDK3CLubDQQ7kNvwHQgTKo&_nc_oc=AdovNBVSOzQiXJw8mcxpRGBXD49yHgbGNcPAwbt1sXyrghw6kZvRqFhqJfV0n9G4ECw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8CMTKqgOQC-JL8fBmmmvvuzfEwrYaci-AxaX9HxRAkQ&oe=6A6B543C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULeYCZe0Qs0Q7kNvwGJSPpe&_nc_oc=AdoPo8Sccmdl1RLcpGlHIjWT4ku-pAE_l_cy8qZn3_Xu0Wwid7-Qmuf1asNS5IzK1rk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUGHJnXyaQ1oet69OZr1NZS3PTxK4SQAhTv-rUhaIx1g&oe=6A6B666F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvjiS55uxi8Q7kNvwHcoNQ5&_nc_oc=AdoEjBx4yQAIkB5sxC3Y8-iRhzIcQEwXri61stwS7fL12FzWu0ZlYr0ALHJQXg4pkyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFhfw2rVXcF4x8YZkfj7UniH1KdA68vtTashWkyND63A&oe=6A6B60D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkWLVmrZ9xYQ7kNvwF5qC-2&_nc_oc=AdqkaPnJUmVWGIVApz4xGxWlpMvpWY7o2ulGz2-8OC-fTmfB0oY1qJb-dJJcO1R_OyM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK684rOved6qclbb1eFEm0N_rI1YesCBD6PA0gRKueOw&oe=6A6B47AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
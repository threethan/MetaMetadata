350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwNY1ZWVdD0Q7kNvwHQfiSg&_nc_oc=AdpbJF8TMUfo8_bQKVRUR5g9xfjnAPRlXHPLK3ARGiRd2DunQLS2CZ_EPDi5apRqXy4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vd-Hne5pDVeXmdh7i4QU7HlT2EEX7oMcUCcNc2c3jbg&oe=6A10737A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDY2zDlIe7IQ7kNvwFgg6Kw&_nc_oc=AdqYFuErQnaRJfGYsEeAnW60fEsxsW-tJS0yYGkuk_hMAFJAJhwmvt65uGOO0Ta_058&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w6JvWVyNObVMumP8JtncNFSH30SfSaR_K1bzC3MVZow&oe=6A105CBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fu3476vRPZ4Q7kNvwF27Vbb&_nc_oc=Ado7c8ekTTUnn6bqfXfgmqFbfVB3iADFXpOIKzsDMq2nh3xg2SaLhT_7yKo2FPL7wsE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vAPRw2yKurIHK5U5xaoCf3Ey2eTUIJyM-GWlEwdSezA&oe=6A106EEF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl7mgcEO-Q0Q7kNvwFXLdRA&_nc_oc=Ado_Pb1_y2N4Sj8nmkxXqM8l79xLqYt97m7gWrIan-xIJ4KVbHP7k2UxQQsX42iLJ8g&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59FpQqIzf51oSAhKf5wMTeLcA82y1HwBLQZtPhHgYaJA&oe=6A106955"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOosykTzpvgQ7kNvwG7DVLt&_nc_oc=AdoCNP8ON3-KKHj26f2OKbpaEJ2Ylx1B9bS92UFc-q8BS0a79_oz2AZBKwFX-VCRmI0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NgcloMdO7Y3srikMGQcOo4off_apn1yX11h17gJylXA&oe=6A10502F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDczfr844PQQ7kNvwH3jELo&_nc_oc=AdpqcXrWvEg8vxlSpJEYVLaqPK3KZfytlswbS1EBzEI8yDCVDrF2lvAU3QEQuwE0Rkg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG4lsqq1aPUA0Y6IfJ0XDax8BOjcBIErTqHFHyvIE_OA&oe=6A4A757A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12XQrBPqB-EQ7kNvwEjfP1M&_nc_oc=AdowsYgnuQP7lLuvoVjCcumTWzUyOqKVwPbr_NO335KLAy9RMZ4bbnNUupykhX1cPco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHdMtb1l7kdk8nOn_4G40Ox3oUajKvqDKNHgIrC8tm2A&oe=6A4A5EBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCeThP3xrdAQ7kNvwEdjeFt&_nc_oc=Adp--pRqC7Fi41suQS9XuHMio6dhNzzPxjyoYOfzuDVvrNxgiJ12N7jl7c_V70NZh6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRpr7bl6fhTfbLzU4cD8wPGJjLBzqjgQ1nk8kjGVOlew&oe=6A4A70EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WSLLZxlGt44Q7kNvwF6TVDa&_nc_oc=Adq11jTrn9NDgGGk9HwxOwUmRGZ2psP_H_9EY4jYPd9hU8CAFpsI-QdvNO2IGZwodPQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMgDUcQdOn951mJK5u4B-PVF3xqJqRW04wCQv_dXzerA&oe=6A4A6B55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKd_ixJIeewQ7kNvwEu-8jD&_nc_oc=Adp8VRV-qtdOMFhHv0Uj9tkHS-rY0am6baOqSX8i50gKknjn3fLvDUAFmZp0f4mgSNY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlXIQNkI_5WCjx_Wa2r9apJ9uo12QCVhI9O8d1pHFPSQ&oe=6A4A522F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfaQ_Hsl_BUQ7kNvwE-a4Ls&_nc_oc=Ado4uaTNj5TnOsvDQjtaWVb6GGWCy2VttVyxAgFevCUY1FmuSNltdbn_cWC6pljDiNs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEypIYabIkaWNgYvnfS8fPPQBugQEADv9Ib9UE0SN_UOQ&oe=6A901CBA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjOCrYmKYFcQ7kNvwFziLv2&_nc_oc=AdqZs8UHyVBypLoTzFcqfQtibhN9M2Dq8mq6-SvScC8nrgdaugauHg6zKdH_t3dcdGs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHe8t-jVfnSiwYrWB-1vFrfH9_etIPF8y9BUYVWk47MyA&oe=6A903E3C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QRpGmgbeOKgQ7kNvwHa7grx&_nc_oc=AdqZ2URZYjDOPvdixCHdvPZ64rQ_2K9Jz1lmL9IVnsIC20NEoibZQ6jOgCOKwyDbI9Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJlbfsVhIULDruPjMlX0MW-PGVI6P3fc9wPfIqBflInw&oe=6A90182F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEaRdeB8GAYQ7kNvwFKrDlJ&_nc_oc=Adqwsx55kkL3HW0s3rA2EUj_1EEYta8N2wJGT7jv-pu0r7mhwbOakWNdiUqjyOO_iZ0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkklDd3g79xK8OIUqU-zQCbwVZZT5P6YahgRrbIFQ0Aw&oe=6A901295"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yo37x-wXoWoQ7kNvwGCx828&_nc_oc=AdoDt371FPpw1IwQZpvNkVyu_57dSuD3D__SX_D0G_U3I-PMUtNC9iSzZpAAo9Rh4p8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3C2Nn2l91c_B9rnhjTl7bHY5Mw0WwyPIAwjD5jomUqw&oe=6A9031AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEuFkpE-y_8Q7kNvwEVmUah&_nc_oc=AdlfWj4k9yLnrw1sqcdBERnl3YSkPB48ZqqPw5L0uF9SPBIX_oLPSc-doRrxRnEKHoY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxG4eBLTVH_xJbM6py4eOgLMZM6UwhhihzQOBTzU7ciOg&oe=69B3F23A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc9g2sSyJXQQ7kNvwHqi35J&_nc_oc=Adn6x3UXhuEOn_jqwfuFoJWOgExzizjju0vs-X0iENnNQWCW36Nd2hHqPBUnrLl7D8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuF7ff9it6-r4SLvIZ9dQHHarkYQ3FbmEU6d9oNMOwCA&oe=69B413BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07-VfJFMXZEQ7kNvwG4grhR&_nc_oc=Admj6wihfY3YArMjVnNItf4eZKGZrzaNEHKqlGf9Om5snPzLf45FeFp5F43Hfwh0leM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afztq99XzX97BAwGO_c-QHWpLNBXOYnZncGVH6NI5tj8qg&oe=69B3EDAF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEdh2ed5MhgQ7kNvwH2nmG-&_nc_oc=Adk63EEzb3XSMK4fJdFmjcS7UiGSv8l-g-xEN0B-NwhIgX8do_w43GP6OKn5-0dUdAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzwk_-tlryP0tb9VFodoCn4Bgn4NBEfOfzadet04NLX_A&oe=69B42055"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVKVAKpGyx4Q7kNvwE_Qe6g&_nc_oc=AdmV1-u-GDYfdN5_G_ZsQ2sfMvUgrAvBvqOK73ZkddCy6NUMm1gUY3KkC0DAhYG9F9Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxJxS193M41ZdY1mlJ4_aLQBXtgaj-up7QeQQ3KjvygtQ&oe=69B4072F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", "category": "GAMES", "comfort_rating": "NOT_RATED", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7amBPITQd0Q7kNvwFCkswJ&_nc_oc=AdqPN-IgkH3ZMmMOUhR7UaBmfSf__AyejZt-XOYT-ACc0ClTrb6lF_I11t7UyDZAPiM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAivJ9ztuijefZzh6ZmGvXTfBLFQ4_Nh-wuviHNupl_BQ&oe=6A525E7A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwZuUEIF5LoQ7kNvwH5pd7S&_nc_oc=Adp2R4Z_iBI99ah6m1Afi2xKI-pV3VGkayJGlev8KYNUDlywqnhNUVeGSSflGMlRQRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTs3tl6UMq0SKWRxDFJVjkFPF6uyJLqLq1bFy-IKkEJw&oe=6A5247BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tj4eCDu1higQ7kNvwFxcPwd&_nc_oc=AdqEuc_bqPAbrpVqqVnNsQkemAVUR3ImR95_zxRPyKLzDJ3R3EFv5cLpIZHBclZUbHA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl0WQe8FdGkpQiTc87KWSJ7it1MY7TFJ7elyFGR-iwfg&oe=6A5259EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqS8paESvkQQ7kNvwFov9EM&_nc_oc=AdrthE_6ih3s3wV0D57JlssbbD0UM9jT9n_PUsoFxmk1Z_85F5mtxnZBGEJxpMZGONM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0f9eZmxu2u6Mg0MdC2RVBgtOYYwd7TcKMX_o6ZdQBZQ&oe=6A525455"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxCIJ7G1Se0Q7kNvwGQIHzn&_nc_oc=AdrFouISvGiZuzCl-MBZ3zbuy8FN4baB5cM2Xc3K4fgJ_z7yC8Ndf4C8ZDvU4Ggt85M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVFm7M60QM9H9jdRFRLXPB7JbHPxZv5zSnJrbv-AGqnA&oe=6A523B2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
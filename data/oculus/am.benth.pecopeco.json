350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jksjjZxxK3QQ7kNvwEXreF0&_nc_oc=AdpBJ5pKvOqTy912BF4AriZ8i2sHzbVpaF1HDXkvG51ApQrw3m8slGR8fMGLdb33gIA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2a8R8jx5lb-zPEPp_PcaoYUflxdzaa9V8LHXpHVB4SYA&oe=69F766FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3Jf6F_jIFgQ7kNvwGYLuGM&_nc_oc=AdoLEx5k4nLiNN5ieI7rq6tbfSk6gGoGaII_deyFZxapXGt0DlFbCeo6u9glfrytrmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3NATO9K8Ob85TKTGB-7OMn2DP-jdHojML5HLWBJvAY3w&oe=69F7503C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NA0zPyc4En0Q7kNvwFdEHrl&_nc_oc=AdrpMHUlU0iPezyUd6qQbIk7l7R80pA-A47BP2cza7s0l2afx29Umn5WtWeTiX1AY-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pzFtTZNvEV8v87qtmKQbz9PqXwlkPjf-tIrvzy5aUjQ&oe=69F7626F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP-pI32OAn4Q7kNvwE2dnFf&_nc_oc=AdrAqNJTuvndbg2Uu51DjBlQkaj2R2-yznTFShVbh6pBfBwSA2UTLepK5tuQxJOTAI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af33m7xQpwzccz5fldyPHrVWtsbUIjUVmKwpvhZ7FC-4XQ&oe=69F75CD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-3gnyVRZocQ7kNvwGhXjV0&_nc_oc=AdoS_0mz5qtRCZSV6-JGQ3hsC74eUatnREUFXvVCgCRnb75jeOFUlJDImcCfaRYafGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3RNpDvFNMp912JGRo7VACBRObH-tvyo1U7sto9B75Djg&oe=69F743AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
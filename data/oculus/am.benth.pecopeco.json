350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQFtSXzf8cEQ7kNvwFfUvzP&_nc_oc=Adq8seh9r3D7p-kZah-r83TBSm7nIXdTqnM6LSFSs7WRvIKWi8LfUChdL11pwOPCWFw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73c9hpRxpbn6o-T_Qedk2PjgnsKcDiYMSZ6kCm57f-jQ&oe=6A1AFF7A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWDTvtZKyscQ7kNvwFPHTh9&_nc_oc=Adqv5HcJ1pqRC7gDLNeIxjrUJTBGUKIXL57s7iKh5wqwowFL78qXHVAk9Ce6YEBeiJY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5M2w5PnbIRaXmxUKFMe8E5f79wZetv5rPhD3uVe_LnZw&oe=6A1AE8BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPPcCpbiWNMQ7kNvwF8ax9M&_nc_oc=AdrAzgcWazbW0YBxkzz-uxRebrdBfQV7bmwslnom2s7sRpYGFiE_xIuZMfOswlgZAQQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YcCmCYhbDezqlT2exSZmaOWLy3f4u7STtAzlxnqbjpQ&oe=6A1AFAEF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAvRU9f21ngQ7kNvwFwdZy9&_nc_oc=Adqd2b6QHRyIwXCT8hxoLqPjByUcP5PRRn2JpOyqZ9TX8G9jMWMW8GEvZKcjxQgWVXg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fSKktm9hp8LH7_rKaLCCVD9rs0fREH9xbtfKhUsg8FA&oe=6A1AF555"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY-8WNHGby4Q7kNvwFHlOak&_nc_oc=Adp251sCuPzs9BJb3yIyL9ZKdFxVsM-PKuyBUsS2F6YZT2Vs6XU15aIUw528kSDskio&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Svw17qzrw9YTvRff4Cmlg2lnMY6GMIRx8XhloIKsQNA&oe=6A1ADC2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
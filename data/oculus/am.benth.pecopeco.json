350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCaSAN_J_5IQ7kNvwFjiqal&_nc_oc=Adp7FtmbIHZOBeSE-1xrmq7WsTaYRGUTKeEzPVlwT1E0GAJKVzOn3vBBWZI61B_-wr4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLjn_d1kbNffQw8CnxErsfvKDkp7UF4TmueWxd5r_H1g&oe=6A9AE0FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7LInrdZ1WAQ7kNvwFCcyp1&_nc_oc=AdrsH8D2qyqd9hs1UBhKRY79WW9gx4zjV9EYjf52oWvo8e9XBlQXMk1CKRXNFYudQ80&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZ1PTqLksqFVxmXxBhV3Cv-aucVPCaANLLZIaz_Fy64w&oe=6A9ACA3C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVaveeWL5VsQ7kNvwFV53Rr&_nc_oc=AdpY_9HJUSXb8nBZlCkdGHSzun0eqLAJN7bnVxIctpiu0Vi878d4DPf59xFPdU19ETo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8QAfZfb9ydCHbu0llivLpvou-ZD7KTvbKO8D0gQLMww&oe=6A9ADC6F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpgjmRqOkNEQ7kNvwGwI8AR&_nc_oc=AdpAYw5DzEelm0hF9ZeKMcBjCuZYhU-w-JkqvmKu6iKubHPo9Hdzjl1Jeuk_ASyKSuc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSak0DECQQtzhnhOmFl72zGmj9Sd8LXRfpEcZKhNbyfQ&oe=6A9AD6D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Q0Zvvw0GMIQ7kNvwE-kweX&_nc_oc=AdqM1o2-vEQNpvb1p-pHLXcJJnmMocwknnO_NStsstfWWWMF7t494zc_GqY49zt5fgg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNgiL1JKM4mjmZJxohLjFwZVtJUAJKawMXpzSku7XBYw&oe=6A9AF5EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Co3s6YlqF0Q7kNvwE7y40v&_nc_oc=Adoo2kxO5PVdXmad9-jQYNaQMFwLcJeC94inZ9-dQ90q9J6bc5eKKtVL3ZI4HXINf9o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hkqauZIKOUbCcRxzRcTh2w4wlnONqSf1h-1dVxaaRnw&oe=6A03447A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XnZv-vXM7tYQ7kNvwGcH6CD&_nc_oc=AdoBtIgfEEnfrsBZcXaMoLRGr78XgkZaSWdjYz_q0ypkXehJf2eNmag8PQN-Ley96hc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ErrgwjDvIvqOD92ZEi3XuVxvWsd9prTin-o86KSSFLA&oe=6A032DBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxoYKwszG4AQ7kNvwG0RwaI&_nc_oc=Adrk6VzqXSQiKxzTX3g0oAliD-9-X_ua4jO09KWrbHC75mtHmlnrPb_C_daXOnxec7M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N4bnZoaVbE4t16MoHyT-fNxm7XTDbz4yFJq-HoAqZOA&oe=6A033FEF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qoVhvwEZIZQQ7kNvwF7dfyE&_nc_oc=AdraCjLuwpnKotlOZ2yC8D0AF9xrAqKJC2oiAFDw8J-ZH0B-hmxlqm61OqqnrxAXFhs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-SpORdmYL9z5ac-SZPB9pjuw1q_k-ykfViVhek1r06g&oe=6A033A55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKa-dPZcxSYQ7kNvwGKb-3v&_nc_oc=AdprvXanfK5KH3DdsUgaWbh38rTzSqeRwj545rgNtBs6fBuLCsSLpcdAN_sTbdMIUoQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OoREf3bHWO4ODuZU6QNA-2wahBk1WwfEyAYh1KBoN4A&oe=6A03212F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
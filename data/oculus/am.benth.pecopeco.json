350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qttjl85UcUYQ7kNvwGSRG3T&_nc_oc=Adp4CcpoGOAQZAKoemJZ8Zay5puBNyFRE22ijwkr-D60MQVfwlXg-A2GbC297xG4Aao&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JcbKkv-fjUM_Axrmz4vAOCJFPdN2WVD_l-NjrjDGSXg&oe=6A09DBFA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OUdER95Y7KcQ7kNvwGW2tQw&_nc_oc=AdrTTgJQxKdUE_o568SdVGIi-nHjcqg0Otw-V0foERQljKiYvuTT3rVjXzjrCkHmnH8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DDwoURisB-axPctPqQuqPcboo84GrOxmGmBZvGBUxMQ&oe=6A09C53C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_enj-oP6VUQ7kNvwEqYesK&_nc_oc=AdocMbwjj84EcRGG7od8uqZrAjaRmEcweyVLK1DIXCUy7OHs1pw4PgjjLmYLNsS8B6E&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4OWsWwomrA27fqkhqeFNGCJxwRRXQPI38PSgfNhXgYEQ&oe=6A09D76F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s3KqtM4qYwQ7kNvwGT8BiF&_nc_oc=Adq6P-Xf-V9iQV9CJ90lAJCevJeLREbU_k9OXEmjgVMfJvtrulaW29LUZP4P03W1CrQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HAOgIdASIYnfmqNBdnj-LWR7SYjfCM8lMDN58NLG4nQ&oe=6A09D1D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec8-pPWTjxMQ7kNvwEdFWhi&_nc_oc=AdoGndI14SEOiNjaKT7MycVfqpzKuFnlC6aN8Y3EDMpPnORbqpx6XSZuYeAfcvM6jOQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dMnifKrjdPM0Je1-XiDgJdDPZB8nhwCzN6buurV920g&oe=6A09B8AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
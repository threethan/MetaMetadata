350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZQ_ndvaC14Q7kNvwHo2g8-&_nc_oc=AdpYhzYU_ZC5U8mOLiWUaNXByblzwBLHy9oFwXpA2gf9BQorXj8GwKXa-a9p9gqeVlo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Waw8aFSU29q8Lo1m_QWGX9ksZPNUOK3nWCLXkijvudA&oe=6A3D467A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mR6LACj2RrwQ7kNvwHNsG0v&_nc_oc=AdrZSFZjKEGTKOYUPYn4hjupjvmV7mWu87b6divJjAzIzWXKZr-RO_hDMQFcdNqLAGc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Go9DNiMb4ivI4ppPWJDJ_pNAOH1_-xlAB3vI3RWGQ8Q&oe=6A3D2FBC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDovvW_TZJUQ7kNvwFn0LXb&_nc_oc=Adpi_5vrHXalCnJjok8vjp6A0_zf49kIBbgfiUIeoezpfVDnkBp-7VatM043gY6ciRE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tleua8o3fAoelxU9viffQaiIVcfVCl3owvMwmgO3mvg&oe=6A3D41EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfsjzYbp5lYQ7kNvwFSgrrM&_nc_oc=AdoRFwt7B2qwd6CQ22QgBFqn8PYWrMN9pisSv3o7JfYfvH23Gu_cNXrvnpnRynkIR3c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fAXdf2cKyE_iWZ-2PyzJrFxnPOPqb5PzF6-B4IzLX3Q&oe=6A3D3C55"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kdUjGufC8lAQ7kNvwHeVrL2&_nc_oc=AdqmQE99LYWWAPrH_Q004OE7K1O2ZG2gfaMURs2CfEBekibVdodViXtyrjWzZ44O8VA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Evz9ZRtk7ohPSHQuIjcYLTNVvU2DzCJIBn1kBaKSPoA&oe=6A3D5B6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
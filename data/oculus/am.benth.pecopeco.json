350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kbn504u3wIQ7kNvwFsR8Zx&_nc_oc=Adr-A-GnSXtzkM-pqcZgaGsuvkh_Pv7GWyvgfKpFC7f1RkPLCozZGjs7edxgoW3dUC4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAeUDq2x1ml-774wp4NV84fV5FIIXbxwLGLsD9Ucx0kw&oe=6A53AFFA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwZuUEIF5LoQ7kNvwHDKmiR&_nc_oc=AdrO42UInKwI_jneiDC8Dc6F0AognSov73dqW2fkj1TmzzIxMU-Qcy-5oDzx_MCkw_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDuvZzRCvv3DOzrXsmm9qSuNMbqWNazOQ-3IBWqq5njQ&oe=6A53993C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zPYwcE6k6psQ7kNvwHYYHrh&_nc_oc=AdrCb16g0OPpfUJMat-E1ynNS4Bft11JMzqU8OpzvCaf_GoX4q2dgi9pITalK9aCNBE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXsiKzAsjIRW6CpvJ6OMk8MEydRPtj6MnrHIEaZpJ0xQ&oe=6A53AB6F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqS8paESvkQQ7kNvwEGNbL9&_nc_oc=AdpqHi0XO5s_Q7YaC_mOKR40U2j4CSEpcuQD-sk1BDRLkTxbZuthkz-oy6ssPxJL1Jw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQNeYe_MGZz1btZchKNkyO_FmxVg3dyaWb8sk3pRz2lw&oe=6A53A5D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxCIJ7G1Se0Q7kNvwFJ8-Em&_nc_oc=AdrzUrHai7knGCkhM3BmjkJLjRFUtu_MfLRtjjnnxJgEIeIuzdpOCi9CmvsdMj2JKR0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeIg-yKsO7Uo4j5OfFIlnOQcHEjda5Dw7s_2CizH_ykA&oe=6A538CAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
54350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vVP8qOhK71UQ7kNvwFG8fQN&_nc_oc=AdqEhp73sie26761yoJ4NOdcEZG-avr5eua3M4GPBMB7ZUvf4YpU7wGmlt-lx3le9do&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIzg1z40CkHJH7X2B4coVu4se0072oUkXVTrMbiDw5vg&oe=6A7DA7BA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUhB2tkHIGAQ7kNvwFYU4xg&_nc_oc=AdrknJOTkP3m72cvx5bhBPxU1u_4mjgByacQ1kSFWlLnkVtPdc1Ws1jeF5dg2EsUaYs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2eVemw5lVeTzawEZGfSvfY3thA2LiPoOd_gAfBByJ4w&oe=6A7DC93C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L6pdhC1jM4Q7kNvwHCoe5d&_nc_oc=AdrUe9njHH9QgaJxrS5H1FT7EbJGWo0b4lDzsL3dKy_kacuYb1gbSIYP6oua_LQfWBI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-FTu8HtsnfUrf8g_MqKfPnNFbxxV-lTDwAG3LgphbRg&oe=6A7DA32F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TkCe8tSoJsQ7kNvwHGGT7W&_nc_oc=Adp_f7UhrLCQsfRKz_41aMootGyHWCdSAL0I2FMtL4NUxp_Mpuyh4ArWEualjOout64&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWMkFjifziAPZZXlU9EXumKVSYOzSQo4EHNkuf6rIz1g&oe=6A7D9D95"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4biox4FtnnEQ7kNvwFRu7qR&_nc_oc=AdoyRV_3FI_6fEG1NBH7OH49_Bk0_Hdzbh1ofzlZvp6BTwlZjDSIVBrT8v1EinoIWvc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeHaNlXKk_VZz7c46J7KKbk9OqzdPfgk8eRJqUrThXWw&oe=6A7DBCAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopec
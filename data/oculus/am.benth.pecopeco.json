350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24F93YsXP_gQ7kNvwG4tITH&_nc_oc=AdqkA-cLqqfM-Dez_1iAdgh8KBM-7lzNkp0NlDUV4zyTyIoNDhDjbrS20fSREjBQUeg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsJ4_yQwDQF9x8jm8NPXuugyW5TiqlA-zm2La45WexpA&oe=6A58F5FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlKI-y7PqH0Q7kNvwEVuuyx&_nc_oc=AdpjpOAQt0o2R-D7OI58mbwoSsCjl6wV7J9VJDJ3KNlXxWOAMWxEDwH6_Eiz0l4iJdc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVmg6XA8l4CRxy9-ixZMwg7EWHsNMhJIx0UM7fTF9jaQ&oe=6A58DF3C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6zVmlloSn8Q7kNvwH_pdvg&_nc_oc=AdrmnWUo8NKKEDMETQYIMwpuOto-TJ_HcL8ZteNfa4J2Biuuy1ZEjkaY1mSEpmRnDjs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAec4CFcR8QjuKYynlUxmnkTcXrQgRAvlge34XBxpRPw&oe=6A58F16F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJ6hG33839YQ7kNvwEkFSLF&_nc_oc=Adqiu6El1buqe6zmXXv72GKBRENrcOQyy7P0myz1Jq5ePPALJhlrYWqQE0qOuI9oPAQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSXKBA-n5_x5z8OrqSSqcoxijukimJ45dKLCPZvzs_BQ&oe=6A58EBD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaFEblXq_OUQ7kNvwH9pOX7&_nc_oc=AdoU0GhUn9WlHOA8-QEiNIllsq9RG1heGR3pNpWcLMUIUkavd35xvDO_Q84Ocv80DD4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIF825J1P2Q5monI_VgE85IRghvm6qEFkC2PNf9uyucg&oe=6A58D2AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
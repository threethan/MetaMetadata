?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEuFkpE-y_8Q7kNvwE0tfOG&_nc_oc=AdmjT5vDgRIqHVBeg1IbNRNNGh1JsgGzuF9Cfj2RSZ37tUN29CHfSkJ57cD0MyHdx3E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx8KbngzfPYbpmwiU9yL5m2sy6qZowIAmsZ6HbPqhvINA&oe=69B2A0BA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CD4DRSFHxAQ7kNvwFKjdda&_nc_oc=AdkjANXDqAaQcyf13Z5SaYKacbcIzI8yRTNGtnQPAHCCulrU0trd1xcnAmOMoYi3HNU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAkCFcDyvPYoz8qhbsWsRgRO2YLcOnaRC0jz17qhkrBg&oe=69B2C23C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07-VfJFMXZEQ7kNvwGr7I5i&_nc_oc=AdkV2zLaLaYmefz_sARlJpOmRMxKWcmrpz_5jMVa5q5LtFaZeo9LVHWaHnFY_fKqRek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afztd51xhNzxt1XONT-y3waXAc984_KZYduHjEO9G__PbQ&oe=69B29C2F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RZRW7QJEAUQ7kNvwHcBH_L&_nc_oc=Adln4VatAdd9u2yE5BDLTh3xbWqb__y0J_MkIDqrb48KA6bZRuDCN1sykJCzK_6kjrM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgXrMapfRggKxm10rC0ZFxukQxfFkzWdEbCUfIKxjd7Q&oe=69B2CED5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwjRjC-7DigQ7kNvwFmSMr5&_nc_oc=AdmX3xuY_LPy8Lyx4CPuZ_jZXLQTyZItsiRSV2IgGTOUhKi1VN-rr78kL1aI5JMFFfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyyHhLmEkezX6xVo0xWBEahuDlSSec0WDjC3svpJdivGw&oe=69B2B5AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", "category": "GAMES", "comfort_rating": "NOT_RATED", 
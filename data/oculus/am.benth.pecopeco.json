350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61zuH2NcX0YQ7kNvwHtTfv8&_nc_oc=Adp0UL0YqZVl-1Tq8brN93M9BZ0qxxfy3oAap9cRk_EL89bOR_V0WWvpt6_sVQ--Nmk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZQd7GDdCDG9M-ELhQ9wy7_BEEQ_7EKM8vMzspAdTf3w&oe=6ABA84FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KoC6EiXn2HsQ7kNvwHaG8mK&_nc_oc=AdpG2dUCtFAYn7_2iBTQCBB3M4TVPr8S1gVdvJD3beQNw4qPcJ7p0uusGcN6uyZqcuY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITI2Dqw-dwJl4NN9CqyMXmtNg4mj97yg9XS01HATSLjw&oe=6ABA6E3C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RllGL5eaX0Q7kNvwHOlzFm&_nc_oc=Adr4ruGqqhou-R-SgVNsqDl-ObISN4Yd8foIln6yZqFrmAEmphdg794cGPzLcyUOeLY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxND2AtUFsFqnHJoNnTnA4S5Ib15D1VyPdOpywDF5cBA&oe=6ABA806F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ep24pAgdGesQ7kNvwEDL21q&_nc_oc=Adpdt1iCP3ml8U1f0OdKns69IIjftIBJs5P7aJT-zUSBfiB_Jsx7gAU-piPW1xdYEZ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKDLtVEeLJ9VwK3wiq2JAwCC6csx4ae2g_JEabt7LqsA&oe=6ABA7AD5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HxwgZ9gIDYQ7kNvwHM9jO7&_nc_oc=AdqQHor3gv1pSvaXtyPaqOipJcJgHuTI2PCUBFGg6BOak1y6GUCSrEWs3KKrx4tTSKY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPMjxiSo2smWX4xFV9qYOs6v8Vj2LdEL2iokQs_Knc9A&oe=6ABA61AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qttjl85UcUYQ7kNvwGRfvSA&_nc_oc=Adr7kY3ZON0M9-y7cRitLcZKWJ7JBIzT_s537NRk-1JlaO8URmAHXKmph-QBHz-1zW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O8J5oGOSNuaHFiHIX4Dq8pYk6U4YC-p1EbAWFhbXq7Q&oe=6A0B2D7A"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MP8srb9p1gQ7kNvwEa5DOT&_nc_oc=AdrfCDHwIYRPEZERkPKHV4EgLKwKsr33VmF92tx-xQcXrO4Bnunz0BgXDAD02BD2gKg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DJYfh_IJ5st5bKny-rjy2WyzlVc89xqpqJvrj-OlqgA&oe=6A0B16BC"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_enj-oP6VUQ7kNvwFQVWoX&_nc_oc=Adqmc75I1q2foawsxyHMx3K6RUZ_BbXU9R-VddnK34jGSPtoLywaUizeKN1lNsgiETk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qS2trg5OWAdwkma0AjKZGB89yqXFZHdxS8wMWxvEjGA&oe=6A0B28EF"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXQQSkQhqowQ7kNvwFdGX8W&_nc_oc=AdpcSRdy2eARpeMZY9xmJa1CfJSnMaxqxUm14oNRl7DAT8COX8dCHsX1-06O5Cqnlp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NtfkqKsl9spFoiesg17FFTLk0ZsPHVROZQ7oQrjwt4w&oe=6A0B2355"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PtYPRi8sjuwQ7kNvwGCUbx9&_nc_oc=AdoF2j4Ic0SLg-n99DvfdeVF1tvNqz8CB0BVf2SGt_ASPwKqw9ThHpG4eqshla6fDJ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aUwEJNmU1z-v90qs9aesfgyn2P2JXA-ybZ2EPAxKR3A&oe=6A0B0A2F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
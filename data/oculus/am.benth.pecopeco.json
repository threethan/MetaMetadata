350762_1538808582512550715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXlcZ1en4oYQ7kNvwHIoxZm&_nc_oc=AdrC-KL1UvfMNQpS7JpEQe7DGxz0BqHsZLIVUU5rSEWVyAh63axkBzisqV56Bo-_R4g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGm6yLcVaKXzRUdEKIa7G4Zp2PCvGm1nf8VDsiDghPww&oe=6AE211FA"}, {"file_name": "am.benth.pecopeco-20201217-154027 - crop-up.png", "id": "881764652583160", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982563_881764655916493_2241438375300718900_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_WyRqFtvR9YQ7kNvwF_2UsY&_nc_oc=AdqV6MU2KgRZvjrWsJ8r8yw3dN0pmwvpzqPK9sCpLAHPARcDA49U_-vu-fpQ7covPZk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3lpnZ-CYketogbTlD7kDsk1VQ69LqAMseq5mupZaC4A&oe=6AE1FB3C"}, {"file_name": "am.benth.pecopeco-20201217-152701-up.png", "id": "1151072482006762", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982466_1151072485340095_3679396863860658620_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjEv4LBuWgwQ7kNvwHbQB41&_nc_oc=AdpqfD9azEam00w30oeGdWihHInH-h2p4_aIfAnIxaSTtDVNfIRnUcUo88Ex7y59I4w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhRaMEAiXb2wWDVFH-XlyEuTz4jTuwW6YK5o_dgd_-SQ&oe=6AE20D6F"}, {"file_name": "am.benth.pecopeco-20201217-153248-up.png", "id": "137602808209002", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974873_137602811542335_3226003001957246514_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyD6srmU-JEQ7kNvwGYfFWN&_nc_oc=Ado0DAhOKGukFYot8FptgwMC8RAywYrXeWCa6cINksBpte9ClqLPTBqEB2ULfs2UCMg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOf5VRQEPd1G5XDIoO02DUY-Gm_uhRR0ghwp05Z5eLvug&oe=6AE207D5"}, {"file_name": "Greek Temple-up.png", "id": "867743704011142", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031414_867743707344475_248885544165530773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcXH4-qnnYcQ7kNvwGVDi7P&_nc_oc=Adptcr7Fo_N-umNpV1SIQnYiDkMEGRMLmdLpI92XgFfad1e4-Gh-qQAIJXAeAvlVVlA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCf2_nLeu3JIN5KnhMCEVLdqsrKL9AzMN1wDqdC7gUOg&oe=6AE1EEAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Peco Peco", "keywords": [], "long_description": "Snap back giant 3D jigsaw puzzles in VR, and cut your own 3D puzzle gift for friends.\n\nIn this release: \n\n2 series: Comfort Food and Diorama\n24 models from 21 creators. Some models are animated, but not all.  \n30 different puzzle cuts in total (we're adding more cuts regularly, updated over the air, no re-install).\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. \nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations. \n\nThanks to VR, the models are much more impressive than your ordinary puzzles: giant cookies, dancing jelly fruits, entire miniature mythical battles, small magical worlds with floating boats and moving clouds\u2026\n\nComing Next: New free series in preparation for Q1/Q2 2021, each including 12 models and 36 cuts:\n\nRetro Collection\nNASA\nCute cars\nAnatomy\nSwords and Katanas\nFull-Size Robots ", "short_description": "Solve dozens of giant 3D puzzles in VR, then cut custom 3D puzzle for friends and family\nIn Peco Peco the jigsaw puzzles feel physical: you manipulate the colorful pieces, you snap them, and as you snap them, the model comes to life with sounds and animations.\n24 models from 21 creators, 30 different puzzle cuts.\n7+ hours of play time to finish all the puzzle cuts\nCreate your own cuts in VR for your friends and family to play. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://benth.am/pecopeco/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Bentham Realities", "support_website_url": null, "website_url": "https://benth.am/pecopeco", 
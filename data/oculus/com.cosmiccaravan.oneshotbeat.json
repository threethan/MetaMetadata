491825497_948696641334645_4081968092701997310_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_DJQ6-M2X8Q7kNvwG9ET1V&_nc_oc=Adp2Eu6NnzbM3NRzc3_Q7cQgWPK6FH3NxqUAmOT0VeJOdzfNrVVXyTE4OqTIjVWOIic&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4pFoLgaIHGlPxwKPaz9Blr_bJpzMy-S8m-M5Ua5p0Xw&oe=6AFB3F5F"}, {"file_name": "12.png", "id": "1444560827423347", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619718_1444560830756680_3298850522319972552_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBTFumcbU6oQ7kNvwGqcaeZ&_nc_oc=AdqwDpAEOWqGgoaEFW6hYF527mw-obbmQbmWnWrc49UysZedZ5f6FSiH7oqQyHE-__A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvD98zI-O8oWFmXasFrSNvGl7Dnln9mEkSxJuTCXQE7w&oe=6AFB3552"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape cover3.png", "id": "931648519979145", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823812_931648523312478_842223399553496432_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9Gcu07CD_sQ7kNvwGXHO3a&_nc_oc=AdoaqC6CSuyvgGnC2ucuTH9Qml7IeBtVSIjy8aeYNvHy4Br_JbFQBT89aGO2SvnjSXw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb8inXOYUKeXcuKE7GdNQnV72JfRVVYhusWG6AgQSTHQ&oe=6AFB4A87"}, "display_name": "One Shot Beat", "keywords": ["shoot", "beat", "rhythm", "gun", "action"], "long_description": "#  **One Shot. One Beat. One Flow**\n  \n  Leap through dimensional rifts into explosive music-powered worlds. Blast enemy swarms, dodge incoming fire, and let every beat drive your next shot.\n\n#  **Rhythm Meets Action**\n\n  Shoot on the beat, weave through incoming attacks, and build unstoppable momentum as every perfect shot fuels the action.\n\n#  **Choose Your Challenge**\n\n  Pick your difficulty and feel the beat your way. On harder modes your streak hits harder, you can deflect bullets with your shield, and every beat feels more intense.\n\n #  **Worlds Built on Music**\n  \nEvery world has its own look, its own sound and its own enemies. Race along neon highways through floating cyber-cities as drones and attack choppers sweep across the sky. Ride a disco train through deep space and fight your way across glowing dance floors among the stars. Battle across city rooftops and face a towering boss who won't go down quietly. Push through endless desert dunes and ancient temples as undead armies rise to meet you. Each\n  journey is built around its song: the music sets the pace, shapes every wave, and turns every fight into a performance.\n\n  More rifts are opening. New worlds with completely different themes, new songs and new enemies are on the way.\n", "short_description": "One Shot. One Beat. One Flow.\n  Leap through dimensional rifts into explosive music-powered worlds, from neon cyber-cities to disco trains in space and ancient deserts. Blast enemy swarms, dodge incoming fire, and let every beat drive your next shot. New worlds are on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cosmic-caravan.com/privacy-policy", "developer_terms_of_service_url": "https://www.cosmic-caravan.com/copy-of-privacy-policy", "publisher_name": "CosmicCaravan", "support_website_url": "https://www.cosmic-caravan.com/", "website_url": "https://www.cosmic-caravan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"]
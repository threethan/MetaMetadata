/v/t64.5771-25/499619718_1444560830756680_3298850522319972552_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_wmZYuGABIQ7kNvwGXUfse&_nc_oc=Adp8s2GaRHrEIN0WIO8vHDwh3RTkbV8y8UMxnLlw7I11IpbsPlyr_MQMO01ZMcBjQ0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5FiL4_nZZrmSiugp01u0lPkjTN7p2uqXgpYkHLxUuVQ&oe=6AF5EF52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape cover3.png", "id": "931648519979145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_931648523312478_842223399553496432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuiNEgZBqwoQ7kNvwEe2xgP&_nc_oc=AdrQ2IefkPdMVxRGNJaUrCQDE4_E1K2karHpO_uglrv8cEQ-hTs7-SDzY94SCPBqkn4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRZRh1kp4nYdhj2TKUHaQAr3Fi9CZzHSMMRYp9A4g0MA&oe=6AF5CC47"}, "display_name": "One Shot Beat", "keywords": ["shoot", "beat", "rhythm", "gun", "action"], "long_description": "#  **One Shot. One Beat. One Flow**\n  \n  Leap through dimensional rifts into explosive music-powered worlds. Blast enemy swarms, dodge incoming fire, and let every beat drive your next shot.\n\n#  **Rhythm Meets Action**\n\n  Shoot on the beat, weave through incoming attacks, and build unstoppable momentum as every perfect shot fuels the action.\n\n#  **Choose Your Challenge**\n\n  Pick your difficulty and feel the beat your way. On harder modes your streak hits harder, you can deflect bullets with your shield, and every beat feels more intense.\n\n #  **Worlds Built on Music**\n  \nEvery world has its own look, its own sound and its own enemies. Race along neon highways through floating cyber-cities as drones and attack choppers sweep across the sky. Ride a disco train through deep space and fight your way across glowing dance floors among the stars. Battle across city rooftops and face a towering boss who won't go down quietly. Push through endless desert dunes and ancient temples as undead armies rise to meet you. Each\n  journey is built around its song: the music sets the pace, shapes every wave, and turns every fight into a performance.\n\n  More rifts are opening. New worlds with completely different themes, new songs and new enemies are on the way.\n", "short_description": "One Shot. One Beat. One Flow.\n  Leap through dimensional rifts into explosive music-powered worlds, from neon cyber-cities to disco trains in space and ancient deserts. Blast enemy swarms, dodge incoming fire, and let every beat drive your next shot. New worlds are on the way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.cosmic-caravan.com/privacy-policy", "developer_terms_of_service_url": "https://www.cosmic-caravan.com/copy-of-privacy-policy", "publisher_name": "CosmicCaravan", "support_website_url": "https://www.cosmic-caravan.com/", "website_url": "https://www.cosmic-caravan.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1406421042558604"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823296_1137105092610934_4639465947062574658_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmBLDN89G-QQ7kNvwHdfQYj&_nc_oc=AdoAA7W7uCCRMnJHysz-In1oX4bCq1bof535uaBuQk-e206jrzMS48nd6D1qGCk1lQw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_
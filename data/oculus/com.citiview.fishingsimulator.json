8922363677964501_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pEg0PJoznoYQ7kNvwFCLXOD&_nc_oc=AdqsqaqovbjV5_chAVFRqTePYcv54i7Q4qOZr0TW0JNEUsJFrMsak1Jc9-Hc9ErzTfE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVCi8w7cfecxyv6oEB_3-ILfAvJwAbJbbwRRmbDFUPmA&oe=6AFC73D9"}, {"file_name": "screenshot_3.png", "id": "2591425181305777", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596149727_2591425184639110_9095429232818377884_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIA_2HzrnzAQ7kNvwFVkJzE&_nc_oc=Adrxirn8pSVSuzMxmT1oGV_jxtzdpbtBgxvNDYohl-Xp_hJH9e3vkInDPGqvEKQGStE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU7jyViFWC9nhu-mR5OSnuz2xxoIyC6003f9SP5l-gwg&oe=6AFC8829"}, {"file_name": "screenshot_4.png", "id": "2363562654180515", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673716021_2363562657513848_3018084573834958575_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B17s1DYya1cQ7kNvwG_4TkO&_nc_oc=AdrrzPHgLO8allMu8DrIgzXpLM1G71KECyR11101fkdi2-xs-n_zxTpXMlF6eV2MJQs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyE4XYrwmTeOyZLpPOsoqCvygIP8CtX4c7np7pWg0r9w&oe=6AFC7837"}, {"file_name": "screenshot_5.png", "id": "4487703681503573", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673573223_4487703684836906_5902573088310624396_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3SCxlz40p0Q7kNvwHcZ8zC&_nc_oc=AdoDgPOB41ePE9uKydsr1YXmZ-wr-s81FmC-HeYMmhZZYIyf0RhQ4S-1uMRRpOD9c4I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTOB1voOJ8Bp5pcW_rvLQaTv4RGSBdWu5C_T8nguYYbA&oe=6AFC81EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1870489387466837", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673716021_1870489390800170_1945666840201669137_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2KKyWlJY6UQ7kNvwGOc4q1&_nc_oc=AdqJpM7XZNYKAmy59pXTprSeDJHnYJfEdQDmZG_rVTeyvO4nGHnVOpv6ljhaoyucp7M&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIvD9-9dmb1I8BURtfAvz1t3wklYwPspwdtIUcXdjiaA&oe=6AFC65F7"}, "display_name": "Fishing Simulator", "keywords": ["fishing", "fish", "lake", "simulator", "relaxing"], "long_description": "Morning mist on Pine Lake, a loon calling across the water and a bobber that just went under.\n\nA REAL ROD AND REEL\nHold a 7 ft spinning rod in your right hand and reach for the reel handle with your left. Squeeze the grip and wind: every turn brings the line in through the guides while the rod bends against the fish. Set your drag, keep the tension in the green and keep winding when it jumps.\n\n13 FISH, TRUE TO LIFE\nYellow perch, bluegill, black crappie, largemouth and smallmouth bass, northern pike, walleye, rainbow and brook trout, chinook salmon, channel catfish, common carp and a giant lake sturgeon. Every fish is a 3D scan of a real one, swims in the clear water where you can watch it, and is weighed and measured when you land it. Lift it by the jaw to admire it, then keep it or let it go.\n\nFIVE SPOTS ON PINE LAKE\nThe cabin dock, Lily Pad Bay, Granite Point, the Deep Hole off the island and the River Mouth. Fish from the dock, the shore or a boat, and walk around with the left stick.\n\nYOUR LAKE, YOUR WAY\n15 real skies from first light and morning mist to golden hour, sunset glow, rain and moonrise. 9 water colours from crystal clear to tropical and glacier blue. Summer, autumn colours or first snow. Six rod colours and three relaxing guitar tracks.\n\nMORE TO DO\nSix lures that unlock as your angler rank grows, a catch log with your personal bests, challenges, and a 10-minute tournament against three pros. Just you, the lake and the next bite.", "short_description": "Stand on the cabin dock of a quiet northern lake with a real rod and reel in your hands. Cast, watch the bobber dive, set the hook and wind in 13 true-to-life fish species. Five fishing spots, 15 skies, 9 water colours and the seasons, all yours."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/fishingsimulator/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/fishingsimulator/", "website_url": "https://citiview-games.pages.dev/fishingsimulator/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1282849714921001"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604293968_2514206549060645_197985918362977213_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pd67v87QqJgQ7kNvwGQ9gxy&_nc_oc=AdoBz7wb3YepG2YyopyhJXmRN57prU9jn7Apc5Z2aSwjuPq0nLwA9Dnj6kRwWwaNedQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRryktphcqUxYDbm1UTt6EqOXwpaxv_I0W5v-ucWb4I6w&oe=6AFC68E4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fishing Simulator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Simulation", "id": "331529188132278"
fxgagxZRH6lOOKCAOFLpVtyfBO69pPI2Lv68g&oe=6AFC9688"}, {"file_name": "Screenshot_01.png", "id": "621615320642989", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473393566_621615323976322_5209888280568289303_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1LFoLzxRVIQ7kNvwEF7iYZ&_nc_oc=AdqW2WRAx85GQhkDtQNtwZL4lPn1EdrGsC2euFkKnC8bJKE_eE1kSRPzkI7B-hhh74I&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCxMTxtQrnfNYXdPUVNwaAwwnE2XkeKi9JblcFsEWnyw&oe=6AFC6937"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX3ut_1IMQgQ7kNvwG8_VQt&_nc_oc=Ado13TGD4H7z58qU7lsk6XT-B1ubxHmEAUckfHLPLDE1Co9PeGHEJaPlPfMPxJz2mdg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVsi73n6Ea04aXRY74-50cnv9mnkB2oAyA2FGuL7eVkQ&oe=6AFC8665"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, "website_url": "https://www.draeger.com/en_uk/Home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24597059373256789"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499296890_4041976322726999_2520562916604941807_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_z18KUJ9qcQ7kNvwFESGu-&_nc_oc=AdoRMnt14NTIxG96GRigzKdHVr-JqAoItlCCt_d1tgCfOX_LHNKgGbcdKKIwOpezKBc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7cGFCHHmKNASpCvJFuv_To_dNWn1kMb49jnPaJNv0fA&oe=6AFC847F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VISTO Explorer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1742367600, "lastRevision": {"nodes": [{"id": "9210651172324192", "release_type": "SCHEDULED", "administ
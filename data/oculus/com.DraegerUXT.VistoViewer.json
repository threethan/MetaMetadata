06&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0b6hj1l97XIQ7kNvwG6QKf2&_nc_oc=AdonuSkmPxtOXgpuTViVsYZuQJ1_jgjnLHow4G6sjYAkcOYpeTBQxuUKcYUnbJ_KHeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7h9Hbroak8RCzZ9t65SMJQ9nx7Wpb3ql1ZKHZEQdcSiw&oe=6A1EED37"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ul_LmQe8JoQ7kNvwF2eYeR&_nc_oc=Adoj97je2-MBHKeQhmC1oVpMmYsinKj3nRdgip5SPxJIK9DgELUpNyaGacU1SVBwyI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56DRt7l-l7xHbv6cbSSRkXOMjF67gZjN4o_3jDPwSdZw&oe=6A1ED225"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, 
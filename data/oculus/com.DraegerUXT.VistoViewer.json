06&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1rMA6WpotgQ7kNvwFLyvRW&_nc_oc=Adp7OOihG4nXqeb2EArWf7A6VTyQBTBhupkVhZio6UPYqr7-Fhd7XfInsryhreXH8vw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxnilb3d-SampGvWRE2IrKaKltXPwL3nIcUtFHaevOgLQ&oe=69CE81B7"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEhrgC-0fVkQ7kNvwGuNFkh&_nc_oc=AdoqQXQLvMJRpHTcdT6WPnE03mQJbOz4VUyIYY4sgEYvdB5TiKC2Y2u4LT1cSJDh3Bg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzMDZYWcBr9aPMWqUlKXbmbx56rGrpcPgqHgs3EmaAREQ&oe=69CE66A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, 
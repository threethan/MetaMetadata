06&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEjxWSe_dCoQ7kNvwH-tMe_&_nc_oc=AdoyYe5X6BXI1vV-4q4yEAvcOnofTnW40pOthmdgD_34kIa6IOkmke3t2BQ7e47RPas&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzRrNWnCz-R2eW9oIXTJpHPlq0-zOYQ2tbSMrmoilRyyg&oe=69C26BF7"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVAOts8OzjQQ7kNvwGO5q1l&_nc_oc=Adp7MXeQkpx26XpG-OZRjAh9XxBjkbehpIkVKmPJI58yYzq6O8VgSR9r7CgGjwMLaWQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAy4jkR_ST-jXRzC2a5TyFf8EK9di0W1ZPMMG1Giwzrw&oe=69C28925"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, 
06&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdCfjSuSp2YQ7kNvwErcKMh&_nc_oc=AdoHY5daR0GXIDZ79qrejCJKDqZ7jVJW8ZZlbwDgJ_egMC85AyicIv-iIdHi3i3DnKg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36Je3qynIhT65mZbxjV3gJMqev_gM7GmP_wFkc0hw31g&oe=69DE53B7"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pKdcOAFDIBQQ7kNvwE1Ihto&_nc_oc=AdprCPkS7fT8jIn2g9GCP8ycDHGz6Vx8QywebeHEGJLKR2FyU6CBfj3b_7C1yUtvRaU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af205ddt7YRigkoTG3uSYi2A0tH-m6IpUXL1x2ts0UPtLg&oe=69DE38A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, 
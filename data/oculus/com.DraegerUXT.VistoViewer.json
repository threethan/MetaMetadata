KkcrFLmEIQ7kNvwGO5Kzl&_nc_oc=AdnMbw5BC3akYfKNHpBZnvMlOpjhusVe2DsdO9pDCEpGL2XWuw-V_ej2fPrY78-TYCQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwBqJOCK_Zu5wQ4NCuuasb4as_QVWVjDYKNII0nHTR6zg&oe=69B14877"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7B8EuE5696AQ7kNvwHIDOv9&_nc_oc=AdlRd2reyW2FiKESXsJEouWcHC-UNBKjr2rL9voc-RHaK26zKtOSkS8gi1Zk7RE1m8A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMIShhxtVsYs54vYU8z5z5NAtGs77FuudLW11dBIflAQ&oe=69B165A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, "website_url": "https://www.draeger.com/en_u
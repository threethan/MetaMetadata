06&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FwC-YEAH8wQ7kNvwHkUvRp&_nc_oc=AdoDEZwsrxbeIMjP7CvO3p1DlFELulYRGd68D6L5ScTp7zK8yLN4zuGcXHrg6jUpBT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFaInwjWe2HKbtISr13SZysyzalU74Tiugq74wUxqFtLg&oe=6A789337"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXWZkhJ_qLAQ7kNvwGrm7N3&_nc_oc=AdoXrWZMlWfgUZzaP74aWURi8VMyqUDtQjJvbZK5PaIP1kc0ZeEpmPjk-Khk2PDghiA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3gqULPbv72NpY2gqmvtK8HL8jAhmI1KK4Lc6nBEd-Rg&oe=6A787825"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, 
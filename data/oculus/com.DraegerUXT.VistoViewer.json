06&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHR_woc0_ZYQ7kNvwEzC0IR&_nc_oc=AdrVR44N9UXtl-vbCDQXOde2-epMIwGbuUrt1ts-C47Xdqmoh_vHwjCQ2vfeff4ebw4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sGSvpogIqtozf3eT0DkIkrs44Eco8lESCFH7Chvbqrw&oe=69D7BC37"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lRdqvHsWTUQ7kNvwEO6_qG&_nc_oc=AdpANyIy-2mKxwnOr0c3O6i63P4L6rY9q650EwW-pflv64vENcUCJO3oe8hl6RJ0r5g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hhlCVYQFZFFyN-lMIhqynI33FWX6wiDH7cq7i6e6Gnw&oe=69D7A125"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, 
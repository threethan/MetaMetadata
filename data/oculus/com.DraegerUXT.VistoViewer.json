yGwo5JuiQKPRz689QZ9WUUpzKAba8JK3Jb0Ag&oe=6B0C6888"}, {"file_name": "Screenshot_01.png", "id": "621615320642989", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393566_621615323976322_5209888280568289303_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJLB3Gt7zOMQ7kNvwFbxXlo&_nc_oc=Adoq_hGS7qfgSifYOY_ec8NVB_6qa8nmBVeeJjjapHg_Uw1Steo8RAAWz8I3eJZN5TE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTp9vaH8_0hQ4KezurRNaleoWoOFjgY-RM5rhTrul3DeA&oe=6B0C7377"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BnI_vzLYBG0Q7kNvwHp8v5h&_nc_oc=Adrj-yA4A8cmLKiF708MPnevMV17Z5oifK5PQgqGfc9pValuH9kQoitYD5eecUNthFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSib6x76ileS1QB--2FNecb0sAfUGjwjdYUeOelD7SdlA&oe=6B0C5865"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, "website_url": "https://www.draeger.com/en_uk/Home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24597059373256789"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499296890_4041976322726999_2520562916604941807_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdkrxI-aWUYQ7kNvwF_fBca&_nc_oc=AdqHpiT44qFOydApmqycIPGZYPa6M7wGJHNKpRnsO7cHFy9V2T0Y7uiOnK9eDMzwF7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQhX4w29nRiRCAxWfvdD0hw-YsPpELb1r47clHYAJEM_Q&oe=6B0C567F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VISTO Explorer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1742367600, "lastRevision": {"nodes": [{"id": "9210651172324192", "release_type": "SCHEDULED", "administ
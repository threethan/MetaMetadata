uL6Oyl_scQ7kNvwFBqyZ1&_nc_oc=AdmkQDUMWJg1riyrR9qq1T1nzmnR6podFKGdFemAfYbZgpHOeQ5FChuJOT1JJBJ7Pfs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfycPj6v-CK7uUgzV96k0tMZPxTJpiQC36vv6eHElkV45A&oe=69B68E77"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNfvNuc9lrwQ7kNvwEe6oqK&_nc_oc=AdmuwW2G5syXi-TETpiuUIxP58l2XXArE03BqquPFKnW1EErQcmaG0oXAwmmRbVGBnM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCYDp0MDDtpLKEQ9b8TYmflMfhhFc5NPpbY0RFRC7pqQ&oe=69B6ABA5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, "website_url": "https://www.draeger.com/en_u
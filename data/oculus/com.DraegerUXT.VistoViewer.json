06&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mumUMFF8PqkQ7kNvwFmuTyR&_nc_oc=Ado6kvwJE3_NEqyF_JxMVFQmCrFy0zxT1wpuQT707fVbx3RCh6tZxN78xKFu-q2oBVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ohnmgxBu5Isjlsw8pcO_fa6svwEUVF9GQoma48IVNMQ&oe=69DBB0B7"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9poUYiEUPekQ7kNvwGynqTY&_nc_oc=AdorhJHzd1G8xAz07grk1b08D_xjWUjZDA4kibjIqpMWZcNe3cQpFK8owtpY-gQsLlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HvX85XiVCfC12Q6qbw2YnaBIkMYcRQ2eunyC14LMVKQ&oe=69DB95A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, 
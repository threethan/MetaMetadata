06&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z1oA06HQzMQ7kNvwHBHaDY&_nc_oc=AdpOokmNuTZSlYiETyZZNwn2yFxIa3kyPGpS14n3XE-sCS-kGSEigic1oo2WKKMjzME&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G55Ylq2KjSWnGePpISzrfQ27xsvQOPJglOJivsVv8nw&oe=6A32B3B7"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_-iuAsokpUQ7kNvwG0TSRY&_nc_oc=AdpkzI1gH_zTb0hhl4BgRFx8APyxS9I8FkRvbKU9-v1okiAKKxfzTyREw3RtOqeQvwE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SdcyAv7OvRsVbnzgRrZwZxxDjVxekJCAY_URuaG5PyA&oe=6A3298A5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, 
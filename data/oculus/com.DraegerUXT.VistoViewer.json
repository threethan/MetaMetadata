06&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fCu5RwvGiwQ7kNvwEQ_MxF&_nc_oc=Adq67iu4C_B3sbS-FHTZ35tS6GLL7HyK_BnqVypCBmqibsldYTqBcfnho6kMqT2ygPU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9yaEvjSPMKW-gxFb6_AB3448I0O2Zt6Nw9T9f3ayQdQ&oe=6AF32EB7"}, {"file_name": "Screenshot_03.png", "id": "669860235483501", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391811_669860238816834_1151198703293093630_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_hwTuBqwZQQ7kNvwE3XUDm&_nc_oc=Adqmen_rSB4LQxi_dlBjCv9rJd3WR7ULn6f-XxONlVpSRAD4-IaHpRYI2QEE2s5s98Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgmPTjJ14_Uj-EpscPX7ay9-afGTjXUOo5CEvkF7qThg&oe=6AF34BE5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VISTO Explorer", "keywords": ["medical", "safety", "dr\u00e4ger", "workplace"], "long_description": "The VISTO Explorer takes your workplace solutions to a next level experience. You can immerse yourself directly in your project solutions and experience products and their actual size, spatial arrangement and functionality.\n\nComplex workplaces, devices and processes can be conveyed more vividly and convincingly than ever before. The technology not only inspires tech-savvy users, but also makes innovations tangible for laypeople. \nIdeal for trade shows, customer events or internal training - the VISTO Explorer transforms presentations into memorizable moments and leaves a lasting impression. \n\nYou will start in a main menu and can only see its contents after clarification with us. ", "short_description": "Immerse yourself: within the VISTO Explorer you can experience solutions from a new, impressive perspective to get maximum impact."}]}, "developer_name": null, "developer_privacy_policy_url": "https://uxtstorage.z1.web.core.windows.net/VISTO_Explorer/visto_explorer_privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "User Experience Technology", "support_website_url": null, 
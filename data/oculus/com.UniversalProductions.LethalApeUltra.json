30f&oh=00_AQXyCmW9zkNi4bgQFaXJOPcpNFDfWzTnn5Zdj4g7BhjhgA&oe=6B105D5A"}, {"file_name": "Hallelujia_Custom..._02.10.2025_21-28-16.png", "id": "817792547444649", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825050_817792550777982_4432222696042689151_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxMWAHTMtpgQ7kNvwG9rupt&_nc_oc=AdrcFRGsQzgxfLxKXDvex5j_IlFg-jy94TjgwnHjZo7zTq10c5VufKZ777YiPjncOAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXCLyhIbeDfmLrIG8jHIYUlOIbENLNb9Ge1dxea7YeYug&oe=6B10681A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape Ultra", "keywords": ["Lethal", "lethalape", "ape", "lethal", "LethalApe"], "long_description": "Lethal Ape Ultra is a spine-chilling VR horror experience where survival is never guaranteed. Trapped inside shifting, nightmarish levels, you must explore, solve, and escape before the darkness\u2014or something far worse\u2014catches you. Every corridor hides danger, every shadow conceals a threat, and every choice matters.\n\nPlay solo for an intense, heart-pounding challenge, or join friends in cooperative multiplayer to explore together, share scares, and strategize your escape. With immersive environments, terrifying enemies, and unpredictable twists, Lethal Ape Ultra pushes you to the edge of fear and keeps you coming back for one more run.\n\nDo you have what it takes to survive the nightmare?", "short_description": "Lethal Ape Ultra is a spine-chilling VR horror experience where survival is never guaranteed. Trapped inside shifting, nightmarish levels, you must explore, solve, and escape before the darkness\u2014or something far worse\u2014catches you. Every corridor hides danger, every shadow conceals a threat, and every choice matters."}]}, "developer_name": "Universal", "developer_privacy_policy_url": "https://universal790132.wixsite.com/my-site-9", "developer_terms_of_service_url": null, "publisher_name": "Universal", "s
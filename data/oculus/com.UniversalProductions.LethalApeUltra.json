5/491825050_817792550777982_4432222696042689151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1L-EA79L6_cQ7kNvwE06t61&_nc_oc=AdqSSfu2lRkqwj9AlLKPvJStVw4O88OPB7H2d9t4OKRQCCsKpPVbxMFl_yfYFTrmD5g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEV87kLyoo8GgawklE0njQIVHVy9bAnaN3QbQnyKyBasg&oe=6A8D731A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape Ultra", "keywords": ["Lethal", "lethalape", "ape", "lethal", "LethalApe"], "long_description": "Lethal Ape Ultra is a spine-chilling VR horror experience where survival is never guaranteed. Trapped inside shifting, nightmarish levels, you must explore, solve, and escape before the darkness\u2014or something far worse\u2014catches you. Every corridor hides danger, every shadow conceals a threat, and every choice matters.\n\nPlay solo for an intense, heart-pounding challenge, or join friends in cooperative multiplayer to explore together, share scares, and strategize your escape. With immersive environments, terrifying enemies, and unpredictable twists, Lethal Ape Ultra pushes you to the edge of fear and keeps you coming back for one more run.\n\nDo you have what it takes to survive the nightmare?", "short_description": "Lethal Ape Ultra is a spine-chilling VR horror experience where survival is never guaranteed. Trapped inside shifting, nightmarish levels, you must explore, solve, and escape before the darkness\u2014or something far worse\u2014catches you. Every corridor hides danger, every shadow conceals a threat, and every choice matters."}]}, "developer_name": "Universal", "developer_privacy_policy_url": "https://universal790132.wixsite.com/my-site-9", "developer_terms_of_service_url": null, "publisher_name": "Universal", "support_website_url": null, "website_url": "https://universal790132.wixsite.com/my-site-9", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
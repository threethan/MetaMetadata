sid=6e7a0a&_nc_ohc=66h_Bp63RYEQ7kNvwFWy1G9&_nc_oc=AdlRK_PtkX2oy1BXxF4I5-DzFxb-KGIYRCSVY_Vsc-puiv7F_FtG-uSO3kMxz_SizcQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQtZwhGkI44UdDh4_TOZTl6FpgmeatHLe0jnHcLcKKFg&oe=69B1761A"}, {"file_name": "Hallelujia_Custom..._02.10.2025_21-28-16.png", "id": "817792547444649", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825050_817792550777982_4432222696042689151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yg3U8JbHAS8Q7kNvwGm8ZJy&_nc_oc=AdmFligMsTPtxzFeMWmdLWctK7BjWqLNcbjq2lkuLxS6K0GU5fPJ15QKFIDuWoC_vmw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdwVd1XgkzqN8h0q5CpnfryQqWyq_qmBXD5lRxVNHnng&oe=69B1489A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape Ultra", "keywords": ["Lethal", "lethalape", "ape", "lethal", "LethalApe"], "long_description": "Lethal Ape Ultra is a spine-chilling VR horror experience where survival is never guaranteed. Trapped inside shifting, nightmarish levels, you must explore, solve, and escape before the darkness\u2014or something far worse\u2014catches you. Every corridor hides danger, every shadow conceals a threat, and every choice matters.\n\nPlay solo for an intense, heart-pounding challenge, or join friends in cooperative multiplayer to explore together, share scares, and strategize your escape. With immersive environments, terrifying enemies, and unpredictable twists, Lethal Ape Ultra pushes you to the edge of fear and keeps you coming back for one more run.\n\nDo you have what it takes to survive the nightmare?", "short_description": "Lethal Ape Ultra is a spine-chilling VR horror experience where survival is never guaranteed. Trapped inside shifting, nightmarish levels, you must explore, solve, and escape before the darkness\u2014or something far worse\u2014catches you. Every corridor hides danger, every shadow conceals a threat, and every choice matters."}]}, "developer_name": "Universal", "developer_priv
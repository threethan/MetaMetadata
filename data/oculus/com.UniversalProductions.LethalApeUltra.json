sid=6e7a0a&_nc_ohc=J8K19Sl8yzYQ7kNvwF_JVJ4&_nc_oc=Adnkvw0QCEU_MHEPhyrEzz72ekVcD2AZ0xcjcQvNZfD0Ir5LO0fNLhnpxojpDN2PCu4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftWcqP24VARPGx0U5iNfgRTZ1Y7WQJwSxWJcYXDHoJe1A&oe=69A83B9A"}, {"file_name": "Hallelujia_Custom..._02.10.2025_21-28-16.png", "id": "817792547444649", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825050_817792550777982_4432222696042689151_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QsyrZUQHx6kQ7kNvwFECRP6&_nc_oc=AdlZUIkRHNfTMleV9_fKVYzZrFVIGLcS0SFY9U2w1juUwOdaQgVxNCB7fcpM2qTnj0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsJB2iEPh2r-eU4nU_D5c0wEVCNQg8aba_-IVLd3Ft9zA&oe=69A80E1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lethal Ape Ultra", "keywords": ["Lethal", "lethalape", "ape", "lethal", "LethalApe"], "long_description": "Lethal Ape Ultra is a spine-chilling VR horror experience where survival is never guaranteed. Trapped inside shifting, nightmarish levels, you must explore, solve, and escape before the darkness\u2014or something far worse\u2014catches you. Every corridor hides danger, every shadow conceals a threat, and every choice matters.\n\nPlay solo for an intense, heart-pounding challenge, or join friends in cooperative multiplayer to explore together, share scares, and strategize your escape. With immersive environments, terrifying enemies, and unpredictable twists, Lethal Ape Ultra pushes you to the edge of fear and keeps you coming back for one more run.\n\nDo you have what it takes to survive the nightmare?", "short_description": "Lethal Ape Ultra is a spine-chilling VR horror experience where survival is never guaranteed. Trapped inside shifting, nightmarish levels, you must explore, solve, and escape before the darkness\u2014or something far worse\u2014catches you. Every corridor hides danger, every shadow conceals a threat, and every choice matters."}]}, "developer_name": "Universal", "developer_priv
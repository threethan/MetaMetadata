e": "ss3.png", "id": "530436034602889", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75622021_530436037936222_8780272009754914973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_5pe6IfhdkQ7kNvwG1Ojkg&_nc_oc=AdkwCks_kmi1tiiMTeE3iePzVeO5wlbZdYyIX_e_XkaN5raLtnlj7J8bspiMMOom4fk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftAFkOll249easP5xgLPDf0aIZknpIrca43J7r8a6fCxQ&oe=69A59D47"}, {"file_name": "ss2.png", "id": "475886666748867", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982467_475886670082200_3616718904525995219_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5fu8IpfAHYQ7kNvwFzw4Uz&_nc_oc=AdmTMn2uTn27sunv3BNQ0hcDTdkFaP1U90HDVv0KYcbrg14S4zj0kNlIdTnI_hrSrlI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvsPzDGAKEGSg4x6tR5ESqitQ2ApSmTLnJq776LvzZzzA&oe=69A578D3"}, {"file_name": "ss4.png", "id": "417081722715360", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982634_417081726048693_5988279231847315668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZP4PZsNyyIQ7kNvwE8rAMS&_nc_oc=Adk7Hfe5B-DzS0j76Wx8sYp55xBdowXRrpCKKMqk_aXZ-fkY3F4yMTm7y1NILP8MN7w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvghpxmeexXUiDVQx8S6sRQTxVsZB5PgkGDEWUGnd7YBw&oe=69A58EDB"}, {"file_name": "ss0.png", "id": "439878230781409", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974797_439878234114742_7874420401664685677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-MUL3Vcw1b4Q7kNvwH_9zSo&_nc_oc=AdkF8SuG0idnZuFrFbb7XIAjAl6dk6mFyTkB0AdZhTi3QAYsYvrMMLsk8TG6zp3foq4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuNGFGF7NH_VsiOs5hfBgBdvp7uzDGcJNLazHG1XYDk3w&oe=69A597CA"}, {"file_name": "ss1.png", "id": "4447790451901223", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75203624_4447790455234556_8863764793175938292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmNXj_D1mGcQ7kNvwHZMsVp&_nc_oc=AdnYXcOsqpUsR_EJZTO86n_624aZs7twZixVP1wHksQifA5o2PGWPSiFPUMKz22vqv4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftkgZfHq-w-K688LMkx5vfrXxxdNfSKIoQLpe2c7NzGNg&oe=69A57698"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVR Metrics Tool", "keywords": ["Performance", "Graph", "HUD", "Overlay", "FPS"], "long_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second.\n\nIn Report Mode, the tool displays a performance report about a VR session after it has concluded. Report data can be easily exported as a CSV with PNG graphs. In Performance HUD Mode, OVR Metrics Tool provides performance graphs over running Oculus applications as a HUD overlay.\n\nOVR Metrics Tool may be used with any Oculus mobile application, including those built with Unity, Unreal, or our native mobile SDK.\n\nFor more information, see OVR Metrics Tool in our Mobile SDK Developer Guide.", "short_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second."}]}, "developer_name": "Oculus", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/documentation/mobilesdk/latest/concepts/mobile-ovrmetricstool/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
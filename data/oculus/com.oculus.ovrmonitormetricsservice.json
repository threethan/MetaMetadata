9quGduUpYGGEu-YUunDhN_d84jw&oe=6AF0AF9B"}, {"file_name": "ss0.png", "id": "439878230781409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974797_439878234114742_7874420401664685677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTBwVjuei7sQ7kNvwHHUSaD&_nc_oc=AdqNd5lueupZg3X6nSnoyjqkmH1Pn27GBCZleyWRMiZcs0TocJT7ILsIrTFzAv1qQqo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZCZZloQrQC2QVG2sDDBw64nEPZ6hKHUbVZBOqSDeQAQ&oe=6AF0804A"}, {"file_name": "ss1.png", "id": "4447790451901223", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203624_4447790455234556_8863764793175938292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baizV2L7ghcQ7kNvwGn84Am&_nc_oc=AdqOOmvK6D2zhpu6da6MwC-cg3pdwH0vPQS5gON_Po1lZnzU-d1wAk_UyI4pPWMeuOg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRr-i9upybC3EK8ZThzbDtqiSBp41V3WJZLbAMuU71TuA&oe=6AF09758"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVR Metrics Tool", "keywords": ["Performance", "Graph", "HUD", "Overlay", "FPS"], "long_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second.\n\nIn Report Mode, the tool displays a performance report about a VR session after it has concluded. Report data can be easily exported as a CSV with PNG graphs. In Performance HUD Mode, OVR Metrics Tool provides performance graphs over running Oculus applications as a HUD overlay.\n\nOVR Metrics Tool may be used with any Oculus mobile application, including those built with Unity, Unreal, or our native mobile SDK.\n\nFor more information, see OVR Metrics Tool in our Mobile SDK Developer Guide.", "short_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second."}]}, "develope
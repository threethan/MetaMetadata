mSr1LgGBt-2fMOCK531G2Kk_e1Q&oe=6AEE0C9B"}, {"file_name": "ss0.png", "id": "439878230781409", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974797_439878234114742_7874420401664685677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ditGVv19loQ7kNvwHbbZQp&_nc_oc=Adp9fqkYHB4mElPWoxudNDh3Qs2yJ4yJ6H3DjMYZCAbKGeca5oAIpCJ4MVsIQX9oiVw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRESHnZsHeNL9E9o294Lbt9V3ykWGQPk80IK12Fz_Gd2A&oe=6AEDDD4A"}, {"file_name": "ss1.png", "id": "4447790451901223", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75203624_4447790455234556_8863764793175938292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fTyhyGE-uVgQ7kNvwGo4bmu&_nc_oc=AdpTJJ8ckq8QbSS0oLvQxVuM5xM97XzrqF6K2y9Nd2Ti2GzKJvbPLlKqCv8ra2wgzSA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3TrF3CLHwUtVUItHFXtCUd-WyaJmUe8IUrXNDCceKHg&oe=6AEDF458"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVR Metrics Tool", "keywords": ["Performance", "Graph", "HUD", "Overlay", "FPS"], "long_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second.\n\nIn Report Mode, the tool displays a performance report about a VR session after it has concluded. Report data can be easily exported as a CSV with PNG graphs. In Performance HUD Mode, OVR Metrics Tool provides performance graphs over running Oculus applications as a HUD overlay.\n\nOVR Metrics Tool may be used with any Oculus mobile application, including those built with Unity, Unreal, or our native mobile SDK.\n\nFor more information, see OVR Metrics Tool in our Mobile SDK Developer Guide.", "short_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second."}]}, "develope
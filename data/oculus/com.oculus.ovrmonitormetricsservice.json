bQMr-n33hdiVPgtPnEDyrST2YGQ&oe=6AF9EA1B"}, {"file_name": "ss0.png", "id": "439878230781409", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974797_439878234114742_7874420401664685677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZKKR06Ny0oQ7kNvwHsDt2f&_nc_oc=AdrNbQXonw0II8bGgwQZGBy_udxfEgx8adxcCMvTyxU6m47s9Qhca5OcbMQD2vDqn5Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGp8B9SLKEss_QM0KHO92CWX2if7Tgka-If0X4zKgmUg&oe=6AF9BACA"}, {"file_name": "ss1.png", "id": "4447790451901223", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75203624_4447790455234556_8863764793175938292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Y8kcVF2f0AQ7kNvwGfOaUV&_nc_oc=Adpqhf8XU-RorZhwOt1NmSp8i88Ce0g80TjdBC23_dFZqYhJ3MaUu-kYuHDwtXo4HQA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjvAalwkeAL1WEXVe0oUqLQrqUnmg_g8PQugBfy4MBdA&oe=6AF9D1D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVR Metrics Tool", "keywords": ["Performance", "Graph", "HUD", "Overlay", "FPS"], "long_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second.\n\nIn Report Mode, the tool displays a performance report about a VR session after it has concluded. Report data can be easily exported as a CSV with PNG graphs. In Performance HUD Mode, OVR Metrics Tool provides performance graphs over running Oculus applications as a HUD overlay.\n\nOVR Metrics Tool may be used with any Oculus mobile application, including those built with Unity, Unreal, or our native mobile SDK.\n\nFor more information, see OVR Metrics Tool in our Mobile SDK Developer Guide.", "short_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second."}]}, "develope
n.com/v/t64.5771-25/38974797_439878234114742_7874420401664685677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWMQDDuwvEcQ7kNvwH7jPzN&_nc_oc=AdnA2Sg0A9TWiiinXcuXjkrGCPCaIk2-N-g7upvtOUbPdgFcZcJbxHY8FFejot6jQVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu81eTKp7DuttQwyjMVKH2W-p5B0hKJ4JMQTh2nw661AQ&oe=699C5D4A"}, {"file_name": "ss1.png", "id": "4447790451901223", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_4447790455234556_8863764793175938292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvA8uKggDU0Q7kNvwHwbD_z&_nc_oc=AdldVXpAdb7relwOSwAwfabu6KoXlvFg9rLglPkAoj8GAKu5yq0El90h-HGs6Hh8soQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs6Nd77lv8AIPPx5ddTLrCCKEAL6Yi5NPZgDq52mX8wwQ&oe=699C3C18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVR Metrics Tool", "keywords": ["Performance", "Graph", "HUD", "Overlay", "FPS"], "long_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second.\n\nIn Report Mode, the tool displays a performance report about a VR session after it has concluded. Report data can be easily exported as a CSV with PNG graphs. In Performance HUD Mode, OVR Metrics Tool provides performance graphs over running Oculus applications as a HUD overlay.\n\nOVR Metrics Tool may be used with any Oculus mobile application, including those built with Unity, Unreal, or our native mobile SDK.\n\nFor more information, see OVR Metrics Tool in our Mobile SDK Developer Guide.", "short_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second."}]}, "developer_name": "Oculus", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "O
M0aSJqVxyN5la5vA&oe=6AF328C7"}, {"file_name": "ss2.png", "id": "475886666748867", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982467_475886670082200_3616718904525995219_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqLNAYcAgiMQ7kNvwFRoly2&_nc_oc=Ado70vH0euk43lPZxoKitl16WHRNvqMVKK18QU7lw_MJmaiZJeGldNCFfjrXt5Dq6PQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYZr6vLCaAPK2jv-pp-4irS7gxsDbYXJHQZepboitrUw&oe=6AF33C93"}, {"file_name": "ss4.png", "id": "417081722715360", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982634_417081726048693_5988279231847315668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWZTXFW5KSQQ7kNvwGVYOp5&_nc_oc=AdpQlbaq38N2f_9a27SoQCKJMKmzMm9D0t6sZiGT78DtuPUhyI5ozyvY2gA1L_CbkHs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPKTbdIvQTcdC0HGCKypi1F5t7eCN2YIr6CJFK6xkaeA&oe=6AF3529B"}, {"file_name": "ss0.png", "id": "439878230781409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974797_439878234114742_7874420401664685677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMLw4pp8JIoQ7kNvwFav3_x&_nc_oc=Ado3kagueY1Oj3NmCaw984v1JiVV97116RGWIOdMJM-VzK-egYq7KxowIxK9IkFOMWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTr6x3tqkfXU-zkItYs9kzJEZcV77jIcGGxAoL-z6ztwg&oe=6AF35B8A"}, {"file_name": "ss1.png", "id": "4447790451901223", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203624_4447790455234556_8863764793175938292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anlil8hP47QQ7kNvwHSHcyG&_nc_oc=AdrMMQ38yTXzGeyaOFy4AmLGAOeIv-uj_nObLZKgqbq_a8oKzNEEsCjTbSbPOdKqvYU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTOIHiWLqFVNg-N_1CBuqv1W5UR5sS_nhUbLBS3NdiSQ&oe=6AF33A58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVR Metrics Tool", "keywords": ["Performance", "Graph", "HUD", "Overlay", "FPS"], "long_description": "OVR Metrics Tool shows performance metrics for apps on Meta Quest and Meta VR Glasses, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second.\n\nIn Report Mode, the tool records a performance report about a VR session that you can read after the session ends. You can export report data as a CSV with PNG graphs. In Performance HUD Mode, the tool shows performance graphs over your running app as a HUD overlay.\n\nApps can also define custom metrics to track their own performance data alongside the built-in stats.\n\nOVR Metrics Tool works with any app, including those built with Unity, Unreal, or the native SDK.\n\nFor more information, see the OVR Metrics Tool guide in the Meta Horizon developer documentation.\n\n**Before you install, update or uninstall:** doing any of these while a VR app is running restarts the system UI. You will see a black screen for a few seconds and the running app will close. **Close your apps first.**", "short_description": "OVR Metrics Tool shows performance metrics for your Meta Quest and Meta VR Glasses apps, including frame rate, heat, GPU and CPU throttling, and the number of tears and stale frames per second."}]}, "developer_name": "Oculus", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/documentation/mobilesdk/latest/concepts/mobile-ovrmetricstool/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supp
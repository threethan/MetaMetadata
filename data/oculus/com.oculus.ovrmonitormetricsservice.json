e": "ss3.png", "id": "530436034602889", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75622021_530436037936222_8780272009754914973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Bal7Yf-VKkQ7kNvwHDxIAI&_nc_oc=Admg8LV16qkUON0T5tJCRTU-oGAHhxUoUHN976oHtWE3Ki2eScKxZrC6ArEXgUU2s7M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuQu5p0JGls--GaA4MaE2DM5ovJGnTYDhAuDZzQ04h5xQ&oe=699C62C7"}, {"file_name": "ss2.png", "id": "475886666748867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982467_475886670082200_3616718904525995219_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYHFWNVonXAQ7kNvwGpBHDW&_nc_oc=AdlQ4gGCEgWP2ntZTM6xfWSl0KweeKz6AmtOaUm1xuwqGJWGOWAo99YzNzJEP4N9aQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftDV1Pwa8sAYIMufECS8HrUCNLVBMGNT6jYHfb3BdVnTQ&oe=699C3E53"}, {"file_name": "ss4.png", "id": "417081722715360", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982634_417081726048693_5988279231847315668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_5Pc7j4MiAQ7kNvwEEgRMk&_nc_oc=AdmFFNeZUdZLe50WjFrZktn8kv5ZGwJGa3awUmdLoxTkzB-xv8CPTs6BNL8HBtiwM9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvpH9ggNCFFyIQGaBCgeHFSwCu2XJnFJjGRruHSrk04qQ&oe=699C545B"}, {"file_name": "ss0.png", "id": "439878230781409", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974797_439878234114742_7874420401664685677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWMQDDuwvEcQ7kNvwH7jPzN&_nc_oc=AdnA2Sg0A9TWiiinXcuXjkrGCPCaIk2-N-g7upvtOUbPdgFcZcJbxHY8FFejot6jQVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu81eTKp7DuttQwyjMVKH2W-p5B0hKJ4JMQTh2nw661AQ&oe=699C5D4A"}, {"file_name": "ss1.png", "id": "4447790451901223", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75203624_4447790455234556_8863764793175938292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvA8uKggDU0Q7kNvwHwbD_z&_nc_oc=AdldVXpAdb7relwOSwAwfabu6KoXlvFg9rLglPkAoj8GAKu5yq0El90h-HGs6Hh8soQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs6Nd77lv8AIPPx5ddTLrCCKEAL6Yi5NPZgDq52mX8wwQ&oe=699C3C18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVR Metrics Tool", "keywords": ["Performance", "Graph", "HUD", "Overlay", "FPS"], "long_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second.\n\nIn Report Mode, the tool displays a performance report about a VR session after it has concluded. Report data can be easily exported as a CSV with PNG graphs. In Performance HUD Mode, OVR Metrics Tool provides performance graphs over running Oculus applications as a HUD overlay.\n\nOVR Metrics Tool may be used with any Oculus mobile application, including those built with Unity, Unreal, or our native mobile SDK.\n\nFor more information, see OVR Metrics Tool in our Mobile SDK Developer Guide.", "short_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second."}]}, "developer_name": "Oculus", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/documentation/mobilesdk/latest/concepts/mobile-ovrmetricstool/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
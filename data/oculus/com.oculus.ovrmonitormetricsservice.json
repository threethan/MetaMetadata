e": "ss3.png", "id": "530436034602889", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75622021_530436037936222_8780272009754914973_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Bal7Yf-VKkQ7kNvwF0njOh&_nc_oc=AdlG30aZ85S2m3w_J5drinhGRfCftSGNVLBV5-5fom0nn_fzcVx2RfazxfwMn_DHCvc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvknXW_37m5CiIX3yby4052zsh3w-iioF79_XmyMriI2A&oe=699DB447"}, {"file_name": "ss2.png", "id": "475886666748867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982467_475886670082200_3616718904525995219_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYHFWNVonXAQ7kNvwGJ3ApS&_nc_oc=AdmAaZTXnVYqZkty_xMeX9DESNMf4Y1gBu3IvxdmJWxKIQhiY7QyNUdaYHDTrVEW4aw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWdlKx8KS7ucYX-_SZMLBdpedxKoy_KDyEdyNXHIw-5Q&oe=699D8FD3"}, {"file_name": "ss4.png", "id": "417081722715360", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982634_417081726048693_5988279231847315668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_5Pc7j4MiAQ7kNvwHFHwAk&_nc_oc=Adn8t7p4I2GtB76r0pjSVK11Wr3pIn7h6rDH2BGetFV2Dtm5lPI8TqFbqBQxDyDGOLo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuoDDdmf_jSC-4YVhHpLaDxElwY1ZT7fYaenyLR9NfnBg&oe=699DA5DB"}, {"file_name": "ss0.png", "id": "439878230781409", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974797_439878234114742_7874420401664685677_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWMQDDuwvEcQ7kNvwG8z4Ga&_nc_oc=AdnQsZ26S2cusOGqpa9AVDzflOfhsmyKfuFLohFFNrBoM5K6OGBpIICIh6VL-hch4iQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvhrrM112zOaKvblId50Dg3UZhrAyArmGAH0HGONJlu1Q&oe=699DAECA"}, {"file_name": "ss1.png", "id": "4447790451901223", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75203624_4447790455234556_8863764793175938292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvA8uKggDU0Q7kNvwFgCND9&_nc_oc=AdlOlU3JQ9mXH52sA0yumKY70RotAnaUkyDoYujgWYOc0BdlqPuroAr45jkyQ5expWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftA0kDS82chUyS_bj69InuFNmiOA12dOWB5I3srE0HgfA&oe=699D8D98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "OVR Metrics Tool", "keywords": ["Performance", "Graph", "HUD", "Overlay", "FPS"], "long_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second.\n\nIn Report Mode, the tool displays a performance report about a VR session after it has concluded. Report data can be easily exported as a CSV with PNG graphs. In Performance HUD Mode, OVR Metrics Tool provides performance graphs over running Oculus applications as a HUD overlay.\n\nOVR Metrics Tool may be used with any Oculus mobile application, including those built with Unity, Unreal, or our native mobile SDK.\n\nFor more information, see OVR Metrics Tool in our Mobile SDK Developer Guide.", "short_description": "OVR Metrics Tool provides performance metrics for Oculus mobile applications, including frame rate, heat, GPU and CPU throttling values, and the number of tears and stale frames per second."}]}, "developer_name": "Oculus", "developer_privacy_policy_url": "https://www.oculus.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Oculus", "support_website_url": null, "website_url": "https://developer.oculus.com/documentation/mobilesdk/latest/concepts/mobile-ovrmetricstool/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOU
7_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-C9FCJmG9IQ7kNvwFuM5LY&_nc_oc=Adqzyldt-HMn7I8kMJiApQv8H4yCRFTos9WFdLqP89I0fCHZpXYbM1olIQthtnFHeB4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IEixuSwn2WByIGc2K_rjWxQrj1vm9FRWx5CqTPdU7aQ&oe=6A22E94B"}, {"file_name": "image4.png", "id": "1368327617927296", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/473391917_1368327627927295_4914998345471438339_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nuUcicQnm9sQ7kNvwGJ-8Mz&_nc_oc=Adr1rb9ZiGEMb57_cFcEgWLSaNKFCbD7LKntHXH95FuTjPcKCqeU9f6lbyuidduTad0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l-Umb-w-cw8hVZJoeqY3H7AMGeZbyPFeJ43q5OCJnlQ&oe=6A22ED0B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mongolian Nature World Expo", "keywords": [], "long_description": "Step into the heart of Mongolia, a land where the landscape feels endless, untamed, and ancient. Traverse vast steppes that stretch to the horizon, where the golden grasses sway under wide-open skies. Explore the rugged beauty of the Altai Mountains, their snow-capped peaks rising sharply above deep valleys and glacier-fed rivers. Wander through the mysterious Gobi Desert, where towering dunes meet rocky canyons and hidden oases. In the north, find tranquil lakes cradled by pine forests and rolling hills, where morning mist drifts over the water and silence echoes through the trees. Mongolia's landscape is a living canvas, raw, majestic, and ever-changing, inviting you to slow down, breathe deep, and feel the profound connection between earth and sky.", "short_description": "Experience the raw beauty of Mongolia's landscape, endless steppes, rolling hills, towering mountains, and serene lakes. From the Gobi Desert\u2019s golden dunes to the alpine forests of the north, every horizon tells a story of untouched wilderness and timeless wonder"}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9529586547095630"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "944165341131220"}]}, "baseline_offer": {"id": "944165341131220"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744116780, "status": "PUBLISHED", "id": "944165341131220"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9955279391193008", "version": "1.0"}, "id": "3992042381046347", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9515161091871509", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9955279391193008"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "3992042381046347"}]}, "change_log": null, "created_date": 1749118814, "id": "9955279391193008", "version": "1.0", "version_code": 9, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "99
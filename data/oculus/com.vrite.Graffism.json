_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtwK0EwYfRQQ7kNvwHC6qNH&_nc_oc=AdpzIlAMKAKVA_9yJwYc0dbYJZBKzMoGA_ovalrZRP4Z7k_0EmSu14WBNeg_7SfyDBQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzBFr8U0IkWlyX1kxHsI2hP135-76t91pHwmUYgFUopdg&oe=69CE568A"}, {"file_name": "screen1_n-2.png", "id": "680187444626376", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827271_680187447959709_9124110539933742660_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5TX9ufkX0MQ7kNvwFnpRSF&_nc_oc=AdqlU6-uv05UV0r9B5p0AkJLYNu-2OopmRhNfHz1WJwmvhvzbYQJ2OCO_KPS_ahTiQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfywvqZypq3sYp5ovl1CRlP3TfO1Lm64FR4snXIPvGP0-g&oe=69CE56FD"}, {"file_name": "Screen5.png", "id": "1042517784410719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822905_1042517787744052_6979393694925539448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9ctA4hPuFsQ7kNvwGm7jvt&_nc_oc=Adpv21KMLLXq0tSbCpePjHbhRD1PWMfQ49WM6P2-8-whQozLyv1EO9KjumsAOHi713c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_xBNbZELh3Iz9GC2L1e_Y2YIPYfIDFOE-HNHeH04Csg&oe=69CE7CFC"}, {"file_name": "Screen2-2.png", "id": "651687084317622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824187_651687087650955_6933614689484969381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbdmazmyN1QQ7kNvwEuoJ_4&_nc_oc=AdqaM3yr2gwJK3mwPKHqVcMDPZ0Gr1TZpzcvkfZZfZ5nkiPopP5z3ZTNx_NOwCeT450&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzdgo6lO1biFFbpfhCo27dlFyGKf3RBRDWa6ROjrw8zJQ&oe=69CE772C"}, {"file_name": "Screen3.png", "id": "668066719305568", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391937_668066722638901_3498256822523435979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_5CVzCUCn4Q7kNvwHmRFxj&_nc_oc=AdpU5F2IuvDzVRo5ZYcQE9J8FtMi1_O7waZ4Mxj19o3vlqmA428stEvGe7p88g9Jx_c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwRryJt4CiIkxov4QPsYAhqpb2PdFyk0cgd1SSJCs4-9g&oe=69CE666C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "985805120210977", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821568_985805123544310_8472653037325680476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mdMuTSUrMMQ7kNvwG_Pw3J&_nc_oc=Ado2Sh8M6zNQE3wd3lctr4fExvZKa5ESVWdhl23-f-5ZIVwuwarbNveNMjRPcaivfAQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyk702kgEx1P-qsEdDYYmKdQOoH0V_ib_DYDDjRmrVT9A&oe=69CE5A7B"}, "display_name": "Graffism", "keywords": ["graffiti", "paint", "simulation", "spray"], "long_description": "Step into a VR graffiti world where creativity flows freely. This immersive painting simulator lets you create art on any surface within your reach giving you room to express yourself like never before.\nUse a variety of tools: spray cans, markers and even fire extinguishers. Paint across richly detailed urban locations or visit the paint shop to decorate individual objects in your own style.\nCustomize your avatar with a wide selection of clothes and accessories.\nIt\u2019s your creative freedom in VR.", "short_description": "Experience full artistic freedom in VR! Use spray cans, markers or a fire extinguisher to paint wherever you can move and reach. Explore detailed scenes, customize your look, and share your photos!"}, {"images": {"nodes": []}, "id": "772918158463297", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Graffism", "keywords": ["graffiti", "spray", "farba", "malowanie", "symulator"], "long_description": "Wejd\u017a do \u015bwiata graffiti w VR, gdzie twoja kreatywno\u015b\u0107 jest nieograniczona. Ten symulator malowania pozwala Ci tworzy\u0107 na ka\u017cdej powierzchni w zasi\u0119gu r\u0119ki, daj\u0105c pe\u0142n\u0105 swobod\u0119 wyra\u017cania siebie.\nJe\u015bli nigdy wcze\u015bniej nie malowa\u0142e\u015b graffiti lub chcesz poprawi\u0107 swoje umiej\u0119tno\u015bci, skorzystaj z trybu nauki, w kt\u00f3rym profesjonalni arty\u015bci poprowadz\u0105 Ci\u0119 krok po kroku i poka\u017c\u0105, jak tworzy\u0107 efektowne prace.\nU\u017cywaj r\u00f3\u017cnych narz\u0119dzi: spray\u00f3w, marker\u00f3w, wa\u0142k\u00f3w, a nawet ga\u015bnicy. Maluj w szczeg\u00f3\u0142owych miejskich lokacjach lub odwied\u017a lakierni\u0119 i dekoruj obiekty w swoim stylu.\nPersonalizuj swoj\u0105 posta\u0107 dzi\u0119ki szerokiemu wyborowi ubra\u0144 i dodatk\u00f3w, maluj wsp\u00f3lnie z innymi na wsp\u00f3\u0142dzielonych scenach lub po prostu ciesz si\u0119 kreatywn\u0105 atmosfer\u0105.\nTo Twoja tw\u00f3rcza wolno\u015b\u0107 w VR.", "short_description": "Do\u015bwiadcz pe\u0142nej swobody tw\u00f3rczej w VR! U\u017cywaj spray\u00f3w, marker\u00f3w, wa\u0142k\u00f3w lub ga\u015bnicy i maluj tam, gdzie mo\u017cesz si\u0119gn\u0105\u0107. Odkrywaj dopracowane lokacje, maluj wsp\u00f3lnie z innymi, personalizuj wygl\u0105d i dziel si\u0119 swoimi zdj\u0119ciami!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://graffism.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Vritelabs", "support_website_url": null, "website_url": "https://graffism.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "30603279082651589"}}]}, "scheduled_offers
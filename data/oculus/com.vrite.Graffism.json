_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIUvPyMDsH0Q7kNvwEahe2b&_nc_oc=AdpE2Ji-HBXOnryQOoTiKRGDwY8hqnds3iY_hCNMlMTE-wYrgVW82izjAqQi-eKW1EQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF-T8LDOkfwnzTesemFNZXsOizuLShT5EWdCyEGRwDbw&oe=6ABBDCCA"}, {"file_name": "screen1_n-2.png", "id": "680187444626376", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827271_680187447959709_9124110539933742660_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fF7-TK38HssQ7kNvwHTWHMe&_nc_oc=AdpWnNeFkq4g8XY2f6wUuLJ3L5idomyMwVSgNSwu3LbveIZK9MApnIydtIZxVK25Ay0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrwU-2FvxVi6VKxLA47tHaYkA7F27YZreO196LiPA4OQ&oe=6ABBDD3D"}, {"file_name": "Screen5.png", "id": "1042517784410719", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822905_1042517787744052_6979393694925539448_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szkRYoGejeEQ7kNvwENXHwH&_nc_oc=Adqx-EZgdxU_cYugut1KwoimRYVfmnVd7D4z9TK_WEwGWj2ySVT31230Fv4Yv3ts-hY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-1s6wMKTd6IVAzVwxJp7C4M9vnct65f5HFD7VrjMlPA&oe=6ABBCAFC"}, {"file_name": "Screen2-2.png", "id": "651687084317622", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824187_651687087650955_6933614689484969381_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPVDUVDvgGsQ7kNvwHztRUe&_nc_oc=Adr56_KuI8v7TXH2E3mpN68G5KkhDasbX2ayYosUo64j_FQczKy1j_aYjpOLaUUJ5Ek&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrNGSISIKtbH9hFrGGXrvlisT17tbFiojXroY2OnJ9ug&oe=6ABBC52C"}, {"file_name": "Screen3.png", "id": "668066719305568", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391937_668066722638901_3498256822523435979_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eb1IbrNULcUQ7kNvwFXIn6D&_nc_oc=AdpCnXfUJxI1QHSfJ08oD6DK_6BIU4lJqcvvNMzbJ9nCpIOlYWNvqiegu2XQWAXbp80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOJiC3MkQwndMQEPhs2LHd6j1HdkpccuokCzbyti_W2w&oe=6ABBB46C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.png", "id": "985805120210977", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821568_985805123544310_8472653037325680476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQAlkxpHla0Q7kNvwGuIB1n&_nc_oc=AdqU5iWQivUBlPaHCUIrzU1B2RViDZ2vum13vbwnmwbi_7qIYza5JsG9q8oOmFLvAss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV1srRz5fs7fd6PxZvNhmjfgHWKbWZl0Ka_NiG2t4FPw&oe=6ABBE0BB"}, "display_name": "Graffism", "keywords": ["graffiti", "paint", "simulation", "spray"], "long_description": "Step into a VR graffiti world where creativity flows freely. This immersive painting simulator lets you create art on any surface within your reach giving you room to express yourself like never before.\nUse a variety of tools: spray cans, markers and even fire extinguishers. Paint across richly detailed urban locations or visit the paint shop to decorate individual objects in your own style.\nCustomize your avatar with a wide selection of clothes and accessories.\nIt\u2019s your creative freedom in VR.", "short_description": "Experience full artistic freedom in VR! Use spray cans, markers or a fire extinguisher to paint wherever you can move and reach. Explore detailed scenes, customize your look, and share your photos!"}, {"images": {"nodes": []}, "id": "772918158463297", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Graffism", "keywords": ["graffiti", "spray", "farba", "malowanie", "symulator"], "long_description": "Wejd\u017a do \u015bwiata graffiti w VR, gdzie twoja kreatywno\u015b\u0107 jest nieograniczona. Ten symulator malowania pozwala Ci tworzy\u0107 na ka\u017cdej powierzchni w zasi\u0119gu r\u0119ki, daj\u0105c pe\u0142n\u0105 swobod\u0119 wyra\u017cania siebie.\nJe\u015bli nigdy wcze\u015bniej nie malowa\u0142e\u015b graffiti lub chcesz poprawi\u0107 swoje umiej\u0119tno\u015bci, skorzystaj z trybu nauki, w kt\u00f3rym profesjonalni arty\u015bci poprowadz\u0105 Ci\u0119 krok po kroku i poka\u017c\u0105, jak tworzy\u0107 efektowne prace.\nU\u017cywaj r\u00f3\u017cnych narz\u0119dzi: spray\u00f3w, marker\u00f3w, wa\u0142k\u00f3w, a nawet ga\u015bnicy. Maluj w szczeg\u00f3\u0142owych miejskich lokacjach lub odwied\u017a lakierni\u0119 i dekoruj obiekty w swoim stylu.\nPersonalizuj swoj\u0105 posta\u0107 dzi\u0119ki szerokiemu wyborowi ubra\u0144 i dodatk\u00f3w, maluj wsp\u00f3lnie z innymi na wsp\u00f3\u0142dzielonych scenach lub po prostu ciesz si\u0119 kreatywn\u0105 atmosfer\u0105.\nTo Twoja tw\u00f3rcza wolno\u015b\u0107 w VR.", "short_description": "Do\u015bwiadcz pe\u0142nej swobody tw\u00f3rczej w VR! U\u017cywaj spray\u00f3w, marker\u00f3w, wa\u0142k\u00f3w lub ga\u015bnicy i maluj tam, gdzie mo\u017cesz si\u0119gn\u0105\u0107. Odkrywaj dopracowane lokacje, maluj wsp\u00f3lnie z innymi, personalizuj wygl\u0105d i dziel si\u0119 swoimi zdj\u0119ciami!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://graffism.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Vritelabs", "support_website_url": null, "website_url": "https://graffism.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "30603279082651589"}}]}, "scheduled_offers
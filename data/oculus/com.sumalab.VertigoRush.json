ts": [{"file_name": "screenshot_01.png", "id": "1324042015957556", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499311597_1324042019290889_9217294984474310889_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwzELlN5pWUQ7kNvwEFBaze&_nc_oc=Adp_Z5s5-UpJtVnjnbujTr-hrVHk_BRM2eZhmskFvEylQpKIeRkjYbFCM17dC5mwuUQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuKVOF4MxIMloNoM_fER66EfXkgAbCA7sMk_xrYNC2dA&oe=6AB29958"}, {"file_name": "screenshot_02.png", "id": "1756084235828275", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312236_1756084239161608_664582119359489004_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-mqFYaFrUkQ7kNvwFG1mS1&_nc_oc=Adqhvomq1koesoA83I_p8x7_L76JY-_l57ZejKeLmAfjDyqshUPOM48F6cddurGj5qU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0JXIyJXMTWaTybMY1iQJ36yYAeFBlrnSLF9ooTRliIw&oe=6AB27447"}, {"file_name": "screenshot_03.png", "id": "3066939056828164", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593863731_3066939060161497_5498323505800902544_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpQ_BIBUWxoQ7kNvwH2PRb2&_nc_oc=AdoQsubl2NPvJreLFdquNmz8bKkfHbdojpu0gsAzuQTdTqT8Pirr3YE2ULH4HC-sNeM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcKQy4RMC6xw_a0iOy8afZqZbLySxQ2mmFdww_qPCeCg&oe=6AB28C7A"}, {"file_name": "screenshot_04.png", "id": "1562983155485149", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308050_1562983158818482_6226307691049698950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9kCnz62JKcQ7kNvwHGy3l-&_nc_oc=AdpTmgImnKtUofuKMftbctqJvLNzPJPTVcgsr6a1gamhucU1aBfmCAyzVogLDk_nsjM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzZv5yHjoeh6_3m5Z00ZTi4-Bx63cvTTqvHl-eu4JFTw&oe=6AB27587"}, {"file_name": "screenshot_05.png", "id": "930302130103124", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/507849536_930302133436457_3138869386692012922_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nbaNv7wX0ugQ7kNvwHLVvGZ&_nc_oc=AdpGgzwuIr9-XdclnmR3V7OWJo0v-8Bz_5a80nZcSMJmyqPH7HKYabSugOFNuW8N8W0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO57CVXLVTqJcfWqudepEKzRbL2rvJqMFW8PDSFXXlUQ&oe=6AB276E9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Vertigo-Rush-Trailer_Thumbnail_2560x1440.png", "id": "984667384433930", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307962_984667387767263_8515357954831539739_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkVAfje75YQQ7kNvwEyQOzf&_nc_oc=Adqq4hwY1SMBeOvTl6cVQDw6s_QPR06PKypdSaYJcruRmk_Yw8GXK3jihGdYu33mqD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk1qyHEOh99ukRgjT-LwzUAJnVnN88PwunYgcEyLOrdA&oe=6AB2A6C4"}, "display_name": "Vertigo Rush", "keywords": ["Racing", "Parkour", "Multiplayer"], "long_description": "# Race. Climb. Fly.\n\n**Vertigo Rush** is a high-speed VR racing game where **your hands are your engine**. Climb, swing, launch yourself through the air and master a polished hand-based movement system built to feel responsive, precise and satisfying.\n\nRace across **visually stunning, highly detailed tracks** filled with vertical challenges, shortcuts, jumps and hazards. Every map has been carefully designed to reward skill, exploration and route mastery.\n\n## Available in Early Access\n\n- **Single-player races** against AI opponents.\n- **Time Trial** mode with **global leaderboards**.\n- **Online races with friends for up to 10 players**.\n- Multiple handcrafted tracks with strong visual variety and detailed environments.\n- A refined movement system designed specifically for VR.\n\nThis is an **Early Access** release. The game is still growing, and player feedback will help shape its development.\n\n## Coming in the Full Version\n\n- A complete **Story Mode** following Jack and Sarah through the Vertigo Rush championship.\n- More tracks and racing environments.\n- New gameplay features, content and improvements based on community feedback.\n\n**Easy to learn, challenging to master.** Find the fastest routes, refine every movement and fight for every second.\n{2024588458224551}", "short_description": "Vertigo Rush is a high-speed VR racing game where your hands are your engine.  Climb, swing, launch yourself through the air and master a polished hand-based movement system built to feel responsive, precise and satisfying.  Race against AI, compete in Time Trials with global leaderboards, or play online with up to 10 friends across visually stunning, highly detailed tracks. Now in Early Access, with a Story Mode, more maps and new features coming in the full version."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sumalab.com/vertigorush/eula.html", "developer_terms_of_service_url": "https://sumalab.com/vertigorush/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "https://www.sumalab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "28149647634663731"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596149727_1412762910286018_5674797709221512407_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhV0Uym8f3kQ7kNvwF3vDci&_nc_oc=Adq49hdjRKCYKGe
7", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75269595_835624911858930_1260453945174392246_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acje4VsaoIwQ7kNvwHgpRzw&_nc_oc=AdpC__EvnPEIMWNbCu9E-jlAdN5xh5GlmK0DcVWqgIrWwOTBo1EeNLWv5-25GF3NbZs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-81XymHCgBYZYcVtc9T7wEYHUABGdZvgu2l4oqXi4Tw&oe=6A9ACC59"}, {"file_name": "Screenshot_20241119_140521.png", "id": "545567651683833", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035349_545567655017166_6774721218901152261_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wl_N7uHyozMQ7kNvwEG-0VB&_nc_oc=Ado01pxYEEdrQHTf5bemJbUEbGbo2SL9vdQcZN-b3etEZED7-C_NI-WViOO08y1txB0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqn5EWAQnAgbrJ3JVHHQeYr4s7tEYFsqxbLQgDgD5Qmw&oe=6A9ACD23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Vertigo-Rush-Teaser-Screenshot_2560x1440.png", "id": "2595497833975582", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982619_2595497840642248_7032374948246604877_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPQ-wNa_CB8Q7kNvwFKXF-B&_nc_oc=AdoSeReIoDpeL5nJELLpGpwDbzmcs8VdFscLRqo-E5bEH8QJP0_JiYJxrj2AwS_VBMM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMCRorLnz0iiK3r7wOSe6NQtuNA1vV5dHPPev7u2JWhg&oe=6A9AC998"}, "display_name": "Vertigo Rush", "keywords": ["Racing", "Parkour", "Multiplayer"], "long_description": "Vertigo Rush is a virtual reality racing experience that combines speed and parkour in an intense physical challenge. Players control agile robots, propelling them through vast, detailed environments by moving their own arms in a heart-pumping race.\n\nInspired by the mechanics of classic arcade racing games, each level is crafted to test player\u2019s skill and endurance as they race through Haven's floating cities.\n\n\u2022 Competitive Online Multiplayer up to 12 Players in Each Race with Global Ranking System, Time Trial Mode, Character & Robot Customization and Cross-Platform Play.\n\n\u2022 Polished full-body physical control for high-speed parkour racing, with fluid and satisfying movement mechanics (jumps, climbing, running) designed for an exhilarating VR experience.\n\n\u2022 Immersive and emotionally engaging narrative: In a world divided between floating opulence and terrestrial struggle, two ingenious siblings defy their destiny in robot races to save themselves from oppression and rewrite their future.\n\n", "short_description": "Vertigo Rush is a virtual reality racing experience that combines speed and parkour in an intense physical challenge. Players control agile robots, propelling them through vast, detailed environments by moving their own arms in a heart-pumping race.\n\nInspired by the mechanics of classic arcade racing games, each level is crafted to test player\u2019s skill and endurance as they race through Haven's floating cities."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sumalab.com/vertigorush/eula.html", "developer_terms_of_service_url": "https://sumalab.com/vertigorush/eula.html", "publisher_name": "Sumalab", "support_website_url": null, "website_url": "https://www.sumalab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26011963171765532"}}]}, "scheduled_offers"
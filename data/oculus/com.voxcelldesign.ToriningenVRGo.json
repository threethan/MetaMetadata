.com&_nc_ss=7a30f&oh=00_Afz5QQ1pP-epN0ekLjvLTQ1xrMWl81KWNOoPh6mhAAg0fg&oe=69D0F03E"}, {"file_name": "migrated_image.png", "id": "528608127849663", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138836_215548252632429_566499563502829568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rf3VkSNuB1MQ7kNvwFK72Li&_nc_oc=AdqxL6RJ3bnfqaueQyDXzgDtuAjw4oERn5Ajcuh939ulzIU6-nH45dqZws0S5_a6EBo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYYVAHfQRxVIcMafHmOvDFezvu6g7DwUOKi7bnFaSMeA&oe=69D0FAB1"}, {"file_name": "migrated_image.png", "id": "1480777065430033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138999_246126126203174_2071505509030035456_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ubZ1fZib4gQ7kNvwGGMurZ&_nc_oc=Adr8FCGaUNaJNQ-8p2pkOalF2BsJouuZW4AdVQxwFIOmVDWobVAgKTv-XZzrvTxo25I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzGaiQJsCRoXbDTBNmZ5Z-_NQHoyq0mtbIQO6yJcHBjJQ&oe=69D0EE36"}, {"file_name": "migrated_image.png", "id": "650409715792363", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12386222_1233560716781064_2812458633982377984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbzWviil_BUQ7kNvwHfclsa&_nc_oc=AdrtFrB8cpLfGORZGvEYRhDgeh-3Vpkj7cSzoZJwgohNMYrM1hFZM-pjtcmnSfflF8s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoliX4nrRyxm7DTPgu0W_3OGN4FKn2JpUusnrrhunjXQ&oe=69D123F6"}, {"file_name": "migrated_image.png", "id": "624348195074913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427695_286269188599228_8138822576194453504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVJBbdSlc4wQ7kNvwEsL7Jv&_nc_oc=AdpOCv3qJabdN7PZrg5i4lv1n9SxwUD21sjVkT63JEaZ_7Ne4oj9Eg78NDPXC-1sEKQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwy4UtKthsQli-WCs_azc7ROun0piZpMWtN-tSFTWRWhQ&oe=69D0FF45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Japan Birdman Rally VR", "keywords": ["Birdman\u3000", "Japanese", "TVprogram", "glider", "aircraft"], "long_description": "THIS IS IMMERSIVE!! \nDive into the venue of \u201cJapan Birdman Rally\u201d by grabbing and shooting one of four spheres, known as Spatial Gates. Designed by a Japanese VR creator, Voxel Kei and one of Japan\u2019s most well-known official Tilt Brush artist, Aimi Sekiguchi, the Spatial Gate is an innovative viewer system specialized for 360\u00b0videos!\nExperience a whole new world by grabbing and shooting the spheres to warp through the 360\u00b0 VR world!", "short_description": "One of the longest-running TV specials, \u201cJapan Birdman Rally\u201d finally debuts into Oculus store!\nYou can fly as a pilot on a glider or a human-powered aircraft by diving into the Spatial Gate, a sphere which contains a 360\u00b0video."}]}, "developer_name": "Yomiuri Telecasting Corporation", "developer_privacy_policy_url": "http://www.ytv.co.jp/privacy/", "developer_terms_of_service_url": "http://www.ytv.co.jp/birdman/vrapp/agreement.html", "publisher_name": "Yomiuri Telecasting Corporation", "support_website_url": null, "website_url": "http://www.ytv.co.jp/birdman/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en_US", "en_AU", "en_CA", "en_GB", "zh_HK", "zh_TW", "ko", "tl", "fr", "de", "de_CH", "es_AR", "ru", "ru_UA", "es", "hi", "ar"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "234425985558266"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/1241035
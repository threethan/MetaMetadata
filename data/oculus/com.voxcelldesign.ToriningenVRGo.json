.com&_nc_ss=7f20f&oh=00_AQHX2sY4Ve1Pj-L84NPTwvmE4Q8ZHqeAoUw_ExuYHrxdFw&oe=6A7B01BE"}, {"file_name": "migrated_image.png", "id": "528608127849663", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138836_215548252632429_566499563502829568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-7C-Chi_ptEQ7kNvwE56TQx&_nc_oc=Adp3fcaGqlqp2fLgDQ5kv2GNMs9pzS1fcK9P5mVXBcNYJn7SWSuXzBD-wEmAs12DoYo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOoOrMsA_OWxe-_y6VhYFcCvyj2FGvQYU5ofDwNhe8bw&oe=6A7B0C31"}, {"file_name": "migrated_image.png", "id": "1480777065430033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138999_246126126203174_2071505509030035456_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7E80BNZ684Q7kNvwEVSsKV&_nc_oc=AdpqcY6I8C_a_OsCtLX_brFtKyXXmZFR0fI07xx7edaMaKAsPDrUwquw__W5a3wY5Y8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0mvGzkUCg7rXwWB5uTDcl8G5PRkXowFBe8KwtgnQ99g&oe=6A7AFFB6"}, {"file_name": "migrated_image.png", "id": "650409715792363", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386222_1233560716781064_2812458633982377984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RELxFN1WuOYQ7kNvwF9HzBO&_nc_oc=AdodacWK45jKc8XHsOdanEFG_BJ7X8XNi8YEmmu8xyRdKRy8iEP9Y8vshvvhAkzDRY4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_7CIGuzaoqDbh0AdVnH4XleNmTdhqpuPCsJ1asHtqgA&oe=6A7B3576"}, {"file_name": "migrated_image.png", "id": "624348195074913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427695_286269188599228_8138822576194453504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDOXIbYUh_4Q7kNvwEXfg98&_nc_oc=Adpmv7waCV7_dA8Zi7tA1sOX028nVS1dsfqUX4IeN3Pt9L7mWtEeA15z2NWgrylwbpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGS_dNRI6ad4v4jMb24_3sAiN9wWmuoIq1KoJYVuIsdAg&oe=6A7B10C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Japan Birdman Rally VR", "keywords": ["Birdman\u3000", "Japanese", "TVprogram", "glider", "aircraft"], "long_description": "THIS IS IMMERSIVE!! \nDive into the venue of \u201cJapan Birdman Rally\u201d by grabbing and shooting one of four spheres, known as Spatial Gates. Designed by a Japanese VR creator, Voxel Kei and one of Japan\u2019s most well-known official Tilt Brush artist, Aimi Sekiguchi, the Spatial Gate is an innovative viewer system specialized for 360\u00b0videos!\nExperience a whole new world by grabbing and shooting the spheres to warp through the 360\u00b0 VR world!", "short_description": "One of the longest-running TV specials, \u201cJapan Birdman Rally\u201d finally debuts into Oculus store!\nYou can fly as a pilot on a glider or a human-powered aircraft by diving into the Spatial Gate, a sphere which contains a 360\u00b0video."}]}, "developer_name": "Yomiuri Telecasting Corporation", "developer_privacy_policy_url": "http://www.ytv.co.jp/privacy/", "developer_terms_of_service_url": "http://www.ytv.co.jp/birdman/vrapp/agreement.html", "publisher_name": "Yomiuri Telecasting Corporation", "support_website_url": null, "website_url": "http://www.ytv.co.jp/birdman/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en_US", "en_AU", "en_CA", "en_GB", "zh_HK", "zh_TW", "ko", "tl", "fr", "de", "de_CH", "es_AR", "ru", "ru_UA", "es", "hi", "ar"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "234425985558266"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/1241035
"TVprogram", "glider", "aircraft"], "long_description": "THIS IS IMMERSIVE!! \nDive into the venue of \u201cJapan Birdman Rally\u201d by grabbing and shooting one of four spheres, known as Spatial Gates. Designed by a Japanese VR creator, Voxel Kei and one of Japan\u2019s most well-known official Tilt Brush artist, Aimi Sekiguchi, the Spatial Gate is an innovative viewer system specialized for 360\u00b0videos!\nExperience a whole new world by grabbing and shooting the spheres to warp through the 360\u00b0 VR world!", "short_description": "One of the longest-running TV specials, \u201cJapan Birdman Rally\u201d finally debuts into Oculus store!\nYou can fly as a pilot on a glider or a human-powered aircraft by diving into the Spatial Gate, a sphere which contains a 360\u00b0video."}]}, "developer_name": "Yomiuri Telecasting Corporation", "developer_privacy_policy_url": "http://www.ytv.co.jp/privacy/", "developer_terms_of_service_url": "http://www.ytv.co.jp/birdman/vrapp/agreement.html", "publisher_name": "Yomiuri Telecasting Corporation", "support_website_url": null, "website_url": "http://www.ytv.co.jp/birdman/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en_US", "en_AU", "en_CA", "en_GB", "zh_HK", "zh_TW", "ko", "tl", "fr", "de", "de_CH", "es_AR", "ru", "ru_UA", "es", "hi", "ar"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "234425985558266"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25
.com&_nc_ss=7a30f&oh=00_Af3mfA6klHhxyQd-AeGn015bjvww56GTWMDXN9QM5LDnSw&oe=69E6407E"}, {"file_name": "migrated_image.png", "id": "528608127849663", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138836_215548252632429_566499563502829568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MRvC-mKrADYQ7kNvwGVKBEt&_nc_oc=AdoaqsjaKf9M8tZN-MkPtt2gFBfiVrmcDvR93hBemfPBowZsHbQZq-6bYxoXD6YrsLI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09sL_ZZVpJ1b6kHIbKkZEN5qzAcOwsGFcIQoqQrWKHKw&oe=69E612B1"}, {"file_name": "migrated_image.png", "id": "1480777065430033", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12138999_246126126203174_2071505509030035456_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_-6oMvpuH80Q7kNvwHjdkcg&_nc_oc=AdpGIqvcP6xa4yQqjJwXJKNd27xDSPmyyoMUgbHaqxC6cIelUEJIAjKRkDkyDqgTfnk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kQCOM58H0cBc6CbT3LGDfBaQP3Xe7364eVx2K0VegJg&oe=69E63E76"}, {"file_name": "migrated_image.png", "id": "650409715792363", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12386222_1233560716781064_2812458633982377984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TC0clrvvJQQ7kNvwFn1G4i&_nc_oc=Adowc_VitZ2v_M1ieCQP6pjSoGmh4Mva4C2Se0LSkKHmTCEZYHvxjozr_Ywr0sQNKB8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ihCsz73G0oRrAQnxpzWu8qUG0bovnGVCYflH8Az6u8g&oe=69E63BF6"}, {"file_name": "migrated_image.png", "id": "624348195074913", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427695_286269188599228_8138822576194453504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XC0kJ_v12ZsQ7kNvwFn_JyO&_nc_oc=Adqtg-MongYyhDYvrZufwcGcY0eM07orwSzNco1d-93GDMnWNhjXlCTVI9vG8XyBfZA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aXOAnzElUYxMeWcViAEuDBGUPw-qlsnBw8QAqCuXOBg&oe=69E61745"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Japan Birdman Rally VR", "keywords": ["Birdman\u3000", "Japanese", "TVprogram", "glider", "aircraft"], "long_description": "THIS IS IMMERSIVE!! \nDive into the venue of \u201cJapan Birdman Rally\u201d by grabbing and shooting one of four spheres, known as Spatial Gates. Designed by a Japanese VR creator, Voxel Kei and one of Japan\u2019s most well-known official Tilt Brush artist, Aimi Sekiguchi, the Spatial Gate is an innovative viewer system specialized for 360\u00b0videos!\nExperience a whole new world by grabbing and shooting the spheres to warp through the 360\u00b0 VR world!", "short_description": "One of the longest-running TV specials, \u201cJapan Birdman Rally\u201d finally debuts into Oculus store!\nYou can fly as a pilot on a glider or a human-powered aircraft by diving into the Spatial Gate, a sphere which contains a 360\u00b0video."}]}, "developer_name": "Yomiuri Telecasting Corporation", "developer_privacy_policy_url": "http://www.ytv.co.jp/privacy/", "developer_terms_of_service_url": "http://www.ytv.co.jp/birdman/vrapp/agreement.html", "publisher_name": "Yomiuri Telecasting Corporation", "support_website_url": null, "website_url": "http://www.ytv.co.jp/birdman/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en_US", "en_AU", "en_CA", "en_GB", "zh_HK", "zh_TW", "ko", "tl", "fr", "de", "de_CH", "es_AR", "ru", "ru_UA", "es", "hi", "ar"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "234425985558266"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/1241035
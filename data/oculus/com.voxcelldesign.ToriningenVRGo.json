.com&_nc_ss=7f20f&oh=00_AQH2KOzfJxxr2mhy5Nld1dv3d3JKnIzFFQMYoh1tQR1jWQ&oe=6A8830BE"}, {"file_name": "migrated_image.png", "id": "528608127849663", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12138836_215548252632429_566499563502829568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2f4B5KimJeoQ7kNvwEoC2DN&_nc_oc=AdqXfRBoD4pl6b_4b9FXOa_-lylruuc9f2iWr4I2Rv03gnIIQO7m69kUf7M3UtNtabk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0wo2HKSWe_lTC2MLmrvv8aU34EBC4zhKFYoti9j_xUA&oe=6A883B31"}, {"file_name": "migrated_image.png", "id": "1480777065430033", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12138999_246126126203174_2071505509030035456_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NV6zU4Da_UQ7kNvwEs9TZa&_nc_oc=AdocALxxzyYuqHYa8lhZPHWcLeza2mTDUtSzagkvbYYtUdH5fmyQwS-d79RvnhAYv20&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqVVfmF8RYEYIn7ABo7-JC0iPCZA5XwdSqbyqFAHxIrw&oe=6A882EB6"}, {"file_name": "migrated_image.png", "id": "650409715792363", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12386222_1233560716781064_2812458633982377984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iehaWNgQzkEQ7kNvwGSh-ZY&_nc_oc=AdpE_z-XBghFia8-eXmdLSvfTqraZgRdnhMdlRxkJPVQ8-aSjwYe_hfQjIOT0EbqG1Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiVTpA9nvpsDnAHPxOmfyD1PsRSjhu_lmTAne19eOutg&oe=6A882C36"}, {"file_name": "migrated_image.png", "id": "624348195074913", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12427695_286269188599228_8138822576194453504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGRe9-8PZosQ7kNvwEGOEMS&_nc_oc=AdpH-M_5-YUNezzEt8d9P-RbEPfdasmyaQfQPdx_wrlHgL9CLD-rlTgJwRbqv-mvjJI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPFwK6Ybf7No-zYqk7pHGIrbodi5FtqAoGI5C2uef94A&oe=6A883FC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Japan Birdman Rally VR", "keywords": ["Birdman\u3000", "Japanese", "TVprogram", "glider", "aircraft"], "long_description": "THIS IS IMMERSIVE!! \nDive into the venue of \u201cJapan Birdman Rally\u201d by grabbing and shooting one of four spheres, known as Spatial Gates. Designed by a Japanese VR creator, Voxel Kei and one of Japan\u2019s most well-known official Tilt Brush artist, Aimi Sekiguchi, the Spatial Gate is an innovative viewer system specialized for 360\u00b0videos!\nExperience a whole new world by grabbing and shooting the spheres to warp through the 360\u00b0 VR world!", "short_description": "One of the longest-running TV specials, \u201cJapan Birdman Rally\u201d finally debuts into Oculus store!\nYou can fly as a pilot on a glider or a human-powered aircraft by diving into the Spatial Gate, a sphere which contains a 360\u00b0video."}]}, "developer_name": "Yomiuri Telecasting Corporation", "developer_privacy_policy_url": "http://www.ytv.co.jp/privacy/", "developer_terms_of_service_url": "http://www.ytv.co.jp/birdman/vrapp/agreement.html", "publisher_name": "Yomiuri Telecasting Corporation", "support_website_url": null, "website_url": "http://www.ytv.co.jp/birdman/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en_US", "en_AU", "en_CA", "en_GB", "zh_HK", "zh_TW", "ko", "tl", "fr", "de", "de_CH", "es_AR", "ru", "ru_UA", "es", "hi", "ar"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "234425985558266"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/1241035
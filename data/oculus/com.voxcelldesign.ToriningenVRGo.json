.com&_nc_ss=7f20f&oh=00_AQPeMYJEt5HdVrf1RqvAYZF4O8HLAPEPwM00lwTpE6jwxg&oe=6ACBA57E"}, {"file_name": "migrated_image.png", "id": "528608127849663", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138836_215548252632429_566499563502829568_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJkfbOAPpLQQ7kNvwEsqOex&_nc_oc=Adpy5EE65kPBQ5Znn8UQPIFWSeKknNnSrso2_GHHVTbxEOH6LgxLgKqVcGFnZyIT_PI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXGSMvU93EKEH-ERQpgXp5jI4qcyMzdJCnMAEJMyYAjg&oe=6ACBAFF1"}, {"file_name": "migrated_image.png", "id": "1480777065430033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138999_246126126203174_2071505509030035456_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bJg1pboOSUQ7kNvwFnF_cn&_nc_oc=AdrXRz7SVaIOPUe2cRnuoNlnhu4iTHm_z199lxSy1AtgYc_lL7mDOtFtX3cmKmAU69w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJvxRlMV0MT9CFCRxbuINlNtn48XM1SPpA8INS_QLdTQ&oe=6ACBA376"}, {"file_name": "migrated_image.png", "id": "650409715792363", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386222_1233560716781064_2812458633982377984_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9GGdQvo4VAQ7kNvwF6ECfp&_nc_oc=Adrq4zd1CNB310GvRelGRwTyylvK_o7sicnP5asegfg8gEKkKgSnUAiCAj4RpnpvmhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS3OI71QyAg_Q72tf_giwsML51NzVq6C0OFMPq6tBMMg&oe=6ACBA0F6"}, {"file_name": "migrated_image.png", "id": "624348195074913", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427695_286269188599228_8138822576194453504_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wScUnXajGsQ7kNvwHY8Bzg&_nc_oc=Adr9dDz7gWyFeIZ4TdTtlSbx3xNiiQY9xEqfes-RdqKp2nvYHu-iGy774MFW6S3cgdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJL5xt59HOEL1MY9Tx8jSVkR0HeT9bDD2PsofMxrEvpg&oe=6ACBB485"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Japan Birdman Rally VR", "keywords": ["Birdman\u3000", "Japanese", "TVprogram", "glider", "aircraft"], "long_description": "THIS IS IMMERSIVE!! \nDive into the venue of \u201cJapan Birdman Rally\u201d by grabbing and shooting one of four spheres, known as Spatial Gates. Designed by a Japanese VR creator, Voxel Kei and one of Japan\u2019s most well-known official Tilt Brush artist, Aimi Sekiguchi, the Spatial Gate is an innovative viewer system specialized for 360\u00b0videos!\nExperience a whole new world by grabbing and shooting the spheres to warp through the 360\u00b0 VR world!", "short_description": "One of the longest-running TV specials, \u201cJapan Birdman Rally\u201d finally debuts into Oculus store!\nYou can fly as a pilot on a glider or a human-powered aircraft by diving into the Spatial Gate, a sphere which contains a 360\u00b0video."}]}, "developer_name": "Yomiuri Telecasting Corporation", "developer_privacy_policy_url": "http://www.ytv.co.jp/privacy/", "developer_terms_of_service_url": "http://www.ytv.co.jp/birdman/vrapp/agreement.html", "publisher_name": "Yomiuri Telecasting Corporation", "support_website_url": null, "website_url": "http://www.ytv.co.jp/birdman/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en_US", "en_AU", "en_CA", "en_GB", "zh_HK", "zh_TW", "ko", "tl", "fr", "de", "de_CH", "es_AR", "ru", "ru_UA", "es", "hi", "ar"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "234425985558266"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/1241035
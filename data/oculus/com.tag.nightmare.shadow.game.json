gVWUHA&oe=6AD3B387"}, {"file_name": "ddd.png", "id": "1773182927016726", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/507840144_1773182933683392_2628727936559849019_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mBgBfY_s2kQ7kNvwEROQsV&_nc_oc=AdoeD1fGxYGTD--kUgWncKEFPCp-7Ars2euTUvMLoQa-27KKWEihHNsPIGtf7yq_iu4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFdW_Kp6pRnJVEN6ldMDrtjLvu9pQXJ1GqESWADOfENQ&oe=6AD3A470"}, {"file_name": "bb.png", "id": "2205287903662206", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499313063_2205287906995539_8886496068570266019_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLjXlcl_KuUQ7kNvwGkTINZ&_nc_oc=AdrU6SnuwEezQNNo5gLccOoA5JIWbYcPjsKHM4qeo1zkcEOX0CnlBLJvk-xIXBsCK5U&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZNEzDOXO0_ZHHnZi6QMt1s926LzzLJhrEN83jr9Mw6Q&oe=6AD3A878"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Shadow Hunt VR", "keywords": [], "long_description": "Nightmare Shadow Hunt VR is a simple and intense VR zombie-hunting experience. Enter a dark and dangerous environment where your only objective is to survive and eliminate every zombie in your path. Explore the environment, stay alert, aim carefully, and fight back as zombies come after you.\n\nEach level takes place in a single environment with a clear goal: kill all the zombies to complete the level. There are no complicated objectives or confusing missions. Pick up your weapons, hunt down the zombies, survive the danger, and finish the level.\n\nWith an immersive VR experience, dark atmosphere, zombie enemies, and straightforward gameplay, Nightmare Shadow Hunt VR is perfect for players who enjoy quick and action-packed zombie hunting.", "short_description": "Nightmare Shadow Hunt VR is a simple VR zombie shooter where you enter a dark environment, hunt and kill all the zombies, and complete the level. Aim, shoot, survive, and finish the mission!"}]}, "devel
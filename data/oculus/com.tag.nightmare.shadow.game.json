nger, and finish the level.\n\nWith an immersive VR experience, dark atmosphere, zombie enemies, and straightforward gameplay, Nightmare Shadow Hunt VR is perfect for players who enjoy quick and action-packed zombie hunting.", "short_description": "Nightmare Shadow Hunt VR is a simple VR zombie shooter where you enter a dark environment, hunt and kill all the zombies, and complete the level. Aim, shoot, survive, and finish the mission!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/top-art-games/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Top Art Games", "support_website_url": null, "website_url": "https://sites.google.com/view/top-art-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1247248341810394"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1864043361243586"}]}, "baseline_offer": {"id": "1864043361243586"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787335680, "status": "PUBLISHED", "id": "1864043361243586"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1250104011524827", "version": "1.1"}, "id": "2029214944384098", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__
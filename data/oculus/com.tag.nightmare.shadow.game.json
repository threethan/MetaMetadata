oAUUag&oe=6ACF86C7"}, {"file_name": "ddd.png", "id": "1773182927016726", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507840144_1773182933683392_2628727936559849019_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ue5SYxAVUIQ7kNvwGKqvb9&_nc_oc=AdoEAo4ZzTkgi7xOhfyvC7rA12_d03E17a0Y-_6kgtoWzvAHpyE5EsIR-_X-OI3Aks4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBqaxoDYoMYIfhgAUiyIpuCFe76MKGg90lUyJwR4sVCw&oe=6ACFAFF0"}, {"file_name": "bb.png", "id": "2205287903662206", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499313063_2205287906995539_8886496068570266019_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnEHiAWdkO8Q7kNvwHXlXh0&_nc_oc=Adol6O-v3LHydFl_KX4LV5X760wdeQtFb6S9cCh52U6N_w5r8FLY4qJaKUWgh_TkTJA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjIJX1834GwDRTOdjydwsFk6j0wd7ZFLJlb8ousKurEQ&oe=6ACFB3F8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Shadow Hunt VR", "keywords": [], "long_description": "Nightmare Shadow Hunt VR is a simple and intense VR zombie-hunting experience. Enter a dark and dangerous environment where your only objective is to survive and eliminate every zombie in your path. Explore the environment, stay alert, aim carefully, and fight back as zombies come after you.\n\nEach level takes place in a single environment with a clear goal: kill all the zombies to complete the level. There are no complicated objectives or confusing missions. Pick up your weapons, hunt down the zombies, survive the danger, and finish the level.\n\nWith an immersive VR experience, dark atmosphere, zombie enemies, and straightforward gameplay, Nightmare Shadow Hunt VR is perfect for players who enjoy quick and action-packed zombie hunting.", "short_description": "Nightmare Shadow Hunt VR is a simple VR zombie shooter where you enter a dark environment, hunt and kill all the zombies, and complete the level. Aim, shoot, survive, and finish the mission!"}]}, "devel
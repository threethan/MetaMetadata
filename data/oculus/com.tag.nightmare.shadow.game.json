lls to survive every encounter.\n\nExperience simple and exciting VR combat with immersive shooting gameplay, challenging enemies, and nonstop zombie action.\n\nAre you ready to enter the fight and become the ultimate Shooting Rival?", "short_description": "Fight through a dangerous zombie outbreak in Shooting Rivals VR. Grab your weapons, aim carefully, and survive intense VR shooting action"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/top-art-games/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Top Art Games", "support_website_url": null, "website_url": "https://sites.google.com/view/top-art-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1282662438268984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/604317775_1826439915007917_1823004366722962316_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSrCAIn0EEkQ7kNvwFKyGNQ&_nc_oc=Adre5XSuo-8SfXKz9QFbTcDyrrkGE_y1-DeQNpYTgA0L3tR3uG4193k6Nrscp7JONoY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJobeXFVEMokoV9T8gtm4b7tfKUbd-iq9jYuOvr65q8hQ&oe=6AAEB403"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shooting Rivals VR", "platform": "ANDROID_6DOF", "context_category
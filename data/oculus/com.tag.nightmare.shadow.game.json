59440", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/507829691_944104845392773_8761368018674675488_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zm15KezdCecQ7kNvwGWDzF8&_nc_oc=AdoKChpyRhFwFbq81uulcS_wx-mJdTPnYLtr7Ck1780VZNvpQBi-kWfn5IABwwekRWI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPtVrpN8EaaUxGvhXDwPmp9Cg8m3Rbhi5aNYFl6_EnTgQ&oe=6AC3AA4A"}, {"file_name": "eeee.png", "id": "1746149583101712", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507829686_1746149586435045_8909391763824958787_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axIV9C-_G0sQ7kNvwFOLD_m&_nc_oc=AdpFbGbWwgPKvBIKyjvYi_rI8F23MbP6l4p2XoyvNj82z2Gapkos0ruXWL3449aSoO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO76105iKoyd8Z11zOzKmkNI4kZRP1xtgldzOtKIoT26Q&oe=6AC3A947"}, {"file_name": "ddd.png", "id": "1773182927016726", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507840144_1773182933683392_2628727936559849019_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch49SiYUhTAQ7kNvwHbvrv9&_nc_oc=Adr5u8qQMACEVyOhLmEkLwNjIJzg5s3_Mn4YeujiozOW7m8ErK5tgd4WNaqmwQqcDsw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOioQFXMtuwijeqUzFRbcE-APtSlg-VIFFRIW9Gsuwo7Q&oe=6AC3D270"}, {"file_name": "bb.png", "id": "2205287903662206", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499313063_2205287906995539_8886496068570266019_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8awhCYLMPIUQ7kNvwF6F_gK&_nc_oc=AdobLlWF1CbtNLBHJ96dWHbYI02OVChqXh9NBO1raWvDQEnCLlrYRIzvoUUO39_raDQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIYv9vARkDRGobE7U2OGsy5FRK_mRDOi4kMwppBPz69g&oe=6AC3D678"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Shadow Hunt VR", "keywords": [], "long_description": "Nightmare Shadow Hunt VR is a simple and intense VR zombie-hunting experience. Enter a dark and dangerous environment where your only objective is to survive and eliminate every zombie in your path. Explore the environment, stay alert, aim carefully, and fight back as zombies come after you.\n\nEach level takes place in a single environment with a clear goal: kill all the zombies to complete the level. There are no complicated objectives or confusing missions. Pick up your weapons, hunt down the zombies, survive the danger, and finish the level.\n\nWith an immersive VR experience, dark atmosphere, zombie enemies, and straightforward gameplay, Nightmare Shadow Hunt VR is perfect for players who enjoy quick and action-packed zombie hunting.", "short_description": "Nightmare Shadow Hunt VR is a simple VR zombie shooter where you enter a dark environment, hunt and kill all the zombies, and complete the level. Aim, shoot, survive, and finish the mission!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/top-art-games/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Top Art Games", "support_website_url": null, "website_url": "https://sites.google.com/view/top-art-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1247248341810394"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1864043361243586"}]}, "baseline_offer": {"id": "1864043361243586"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 17873
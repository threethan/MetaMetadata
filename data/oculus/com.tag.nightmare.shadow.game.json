71-25/499313063_2205287906995539_8886496068570266019_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yK_eUJ-1CpUQ7kNvwG2yo96&_nc_oc=Adq7SycOWz5NZHfc90yKTT2oxb9QFJABKV5WHbWJh_bvE8g7FWuZsmyASHEMYKV1EN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-y5kvNARi7yo2T1QUKxUxYIR5sSwfDf2_sFEEYTrOtw&oe=6ABE5838"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Nightmare Shadow Hunt VR", "keywords": [], "long_description": "Nightmare Shadow Hunt VR is a simple and intense VR zombie-hunting experience. Enter a dark and dangerous environment where your only objective is to survive and eliminate every zombie in your path. Explore the environment, stay alert, aim carefully, and fight back as zombies come after you.\n\nEach level takes place in a single environment with a clear goal: kill all the zombies to complete the level. There are no complicated objectives or confusing missions. Pick up your weapons, hunt down the zombies, survive the danger, and finish the level.\n\nWith an immersive VR experience, dark atmosphere, zombie enemies, and straightforward gameplay, Nightmare Shadow Hunt VR is perfect for players who enjoy quick and action-packed zombie hunting.", "short_description": "Nightmare Shadow Hunt VR is a simple VR zombie shooter where you enter a dark environment, hunt and kill all the zombies, and complete the level. Aim, shoot, survive, and finish the mission!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/top-art-games/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Top Art Games", "support_website_url": null, "website_url": "https://sites.google.com/view/top-art-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQU
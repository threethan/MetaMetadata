64902503303", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031477_4308564905836636_6274524008135682620_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CbJufWPHzIQ7kNvwEj6pL_&_nc_oc=AdqlF949RARb9dF8Rm0c_AtFhrRq3rNnXkONCbFvw60gy8fN0wGF-E1FqHObnV8Y3Cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTx84bNDPQv5cKx6mJiAyYxZby4WQZLzLgCPJKv_K9DNA&oe=6B0DA64A"}, {"file_name": "TokyoChronos_AddScreenShot15 (1).png", "id": "268064451290987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_268064454624320_6690619984376577959_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xGZi_po3UaIQ7kNvwEAQ29i&_nc_oc=AdqfEuhhjYIEwLBjY19sHX3Aj5G4AsrD-h9BBIG9ts6QYDT8Tjg08HZijwuUyIV1CtM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhBXnW-U6AKKX9Bccq9OTw4WmAENGsWJZe6oilfGK4rQ&oe=6B0DC308"}, {"file_name": "TokyoChronos_AddScreenShot13.png", "id": "472847610346262", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031639_472847613679595_4542425813744423185_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UUq0xQueksQ7kNvwHaQNQ7&_nc_oc=Adr4PZSB2NpPubFfTU176Xbs8YkVKTraFpkXGZnqefSHNbeRPO8GzxsaSqoDCcaMTuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ520-GbS8op5s_YawP_vtJb0c3LA6QBMStZzw0t7_ddw&oe=6B0DCB93"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TokyoChronos_AddScreenShot15 (1).png", "id": "1347271088998137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393566_1347271095664803_5387546881034672347_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQV9cMZfWooQ7kNvwEHyCy1&_nc_oc=AdqO-GBS0GaebPqclZFKfsu-_OjdDkRUk9JybJTiUtMDul5zsNSX91kQlq1xI3ZFY64&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQlKgTYQBDilYWsFQHcYEbaoKwztAllgwe7aMiJopyvww&oe=6B0DBD00"}, "display_name": "TOKYO CHRONOS", "keywords": ["TOKYOCHRONOS", "CHRONOS", "VisualNovel", "adventure", "Anime"], "long_description": "Note: This game takes around 10-15 hours to complete, with new paths that unlock with multiple playthroughs. Don't stop playing after the first credits roll! \n\nTOKYO CHRONOS is the VR game that has multiple-choice decision points as well as more than one ending. It has a long story you've never experienced before with VR.\nThe game takes place in Shibuya, Tokyo, which has only eight people, including you, the protagonist, Kyosuke Sakurai. Can you solve the mystery and get out of the silent Shibuya?\n\n-Features-\n\u25cf Drastic advancement of visual novel games with VR \nThe total gameplay time reaches to 15 hours. The story has multiple-choice decision points as well as more than one ending.\n\n\u25cfMoving scenario making your HMD wet with your tears \nOne review says, \"I've purchased several games at the Oculus store, and none of them satisfied me. But TOKYO CHRONOS is no comparison. At first, you're surprised at the beautiful images. But the deep story surpasses it\".\n\n", "short_description": "TOKYO CHRONOS is the VR game that has multiple-choice decision points as well as more than one ending. It has a long story you've never experienced before with VR.\nThe game takes place in Shibuya, Tokyo, which has only eight people, including you, the protagonist, Kyosuke Sakurai. Can you solve the mystery and get out of the silent Shibuya?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tokyochronos.com/en/privacypolicy/", "developer_terms_of_service_url": "https://tokyochronos.com/en/terms/index.html", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://tokyochronos.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED"
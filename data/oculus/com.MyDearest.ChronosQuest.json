Design\uff1aLAM (Illustrator) Theme Song\uff1aUNLIMITED / Eir Aoi", "short_description": "TOKYO CHRONOS is an all-new VR Mystery Visual Novel, designed from the ground up for VR by the creators of Expelled From Paradise and Sword Art Online. Experience an engrossing storyline 15-20 hours long, with multiple routes and endings. An empty, deserted Shibuya where time has frozen over. 8 childhood friends trapped inside. Lost memories; A strange message: \u201cI am dead. Who killed me?\u201d Who is \u201cI\u201d? Why did we lose our memory? Who is the killer? To kill, or not to kill \u2500 YOU decide."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tokyochronos.com/en/privacypolicy/", "developer_terms_of_service_url": "https://tokyochronos.com/en/terms/index.html", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://tokyochronos.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "MUSIC", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477909637263704"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1607213693854172"}, {"status": "PUBLISHED", "id": "1921167968528476"}, {"status": "PUBLISHED", "id": "1241029257449112"}, {"status": "PUBLISHED", "id": "623266766793692"}, {"status": "CANCELLED", "id": "1185189106094388"}, {"status": "PUBLISHED", "id
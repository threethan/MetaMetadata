64902503303", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031477_4308564905836636_6274524008135682620_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fc206DJb5NEQ7kNvwFPLwG7&_nc_oc=Adrbr16qx0OesREdJrLH6p_IETsy6fWL_50_3huHKeO-jS2dxsGLdp4Nck5uBotTrLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRNyZkP0bi_zstQFYekBRmTLdQHfGCXSozX8yk_X6xrg&oe=6AFDD44A"}, {"file_name": "TokyoChronos_AddScreenShot15 (1).png", "id": "268064451290987", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_268064454624320_6690619984376577959_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HEy9TKOOY4Q7kNvwHHrK6h&_nc_oc=AdpxaO5o2lwGbQrdOy818aP6oaPonTKlbFy3YF-Pg8mCBnwiX0pKAIcBYSqWCM6ifmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0HU3BTcicF3pb5EPmEIMAPizmiqJfEQZjZ1AVRVn29Q&oe=6AFDB8C8"}, {"file_name": "TokyoChronos_AddScreenShot13.png", "id": "472847610346262", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031639_472847613679595_4542425813744423185_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7ZhS0eXC_4Q7kNvwFCHd1t&_nc_oc=AdoY-GbP_DEsVdWe-Zt26zsUnvlfMBdqLXbr9QcWNFfL9m_OKMqVNP2DULgidBf0bzw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpwI9rK0hsbNRrca_pHyZzT6caLUOuaUNq9imFUDIiXg&oe=6AFDC153"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TokyoChronos_AddScreenShot15 (1).png", "id": "1347271088998137", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393566_1347271095664803_5387546881034672347_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrdxV9iDoNsQ7kNvwH42Q0J&_nc_oc=AdrlHHgOhvohkeMSMKa-qn-5cnCQMewBDnXUc8t3icfAz9IyF40_C345a-Oa0N9Fg5M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM2LyP6QTPhKe9xat17RhUJD5dmN6RMO7oJx6oxgHoVA&oe=6AFDB2C0"}, "display_name": "TOKYO CHRONOS", "keywords": ["TOKYOCHRONOS", "CHRONOS", "VisualNovel", "adventure", "Anime"], "long_description": "Note: This game takes around 10-15 hours to complete, with new paths that unlock with multiple playthroughs. Don't stop playing after the first credits roll! \n\nTOKYO CHRONOS is the VR game that has multiple-choice decision points as well as more than one ending. It has a long story you've never experienced before with VR.\nThe game takes place in Shibuya, Tokyo, which has only eight people, including you, the protagonist, Kyosuke Sakurai. Can you solve the mystery and get out of the silent Shibuya?\n\n-Features-\n\u25cf Drastic advancement of visual novel games with VR \nThe total gameplay time reaches to 15 hours. The story has multiple-choice decision points as well as more than one ending.\n\n\u25cfMoving scenario making your HMD wet with your tears \nOne review says, \"I've purchased several games at the Oculus store, and none of them satisfied me. But TOKYO CHRONOS is no comparison. At first, you're surprised at the beautiful images. But the deep story surpasses it\".\n\n", "short_description": "TOKYO CHRONOS is the VR game that has multiple-choice decision points as well as more than one ending. It has a long story you've never experienced before with VR.\nThe game takes place in Shibuya, Tokyo, which has only eight people, including you, the protagonist, Kyosuke Sakurai. Can you solve the mystery and get out of the silent Shibuya?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tokyochronos.com/en/privacypolicy/", "developer_terms_of_service_url": "https://tokyochronos.com/en/terms/index.html", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://tokyochronos.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED"
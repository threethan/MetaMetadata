&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UH9HJCGufoQ7kNvwEa7ziw&_nc_oc=AdokTaysQGcGQOlqrX93PoIym55lPNMCK_OcXjmDA5R2ILdPj8u2db4XZOK96zXxiw4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pr2SVlCWO6KpqCqLs0Ei02o6jtzmg9bJ65KEEF24b-w&oe=6A451FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MhbJmg", "id": "2268367739936684", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974614_2268367743270017_5856843195551318016_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seIw86kjQrkQ7kNvwGV0qJJ&_nc_oc=AdpoHMQYlEZt-HxFns_e6yXKucdEb1rZfsXxAwLLiIwoGW7bQaTaJc3PJ0tJIQA6Gfo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y-JTa0NZ3pRTBjf-htkFegRJBc-trNkBhWhtC4pIwZQ&oe=6A4510C5"}, "display_name": "TOKYO CHRONOS", "keywords": ["TOKYOCHRONOS", "CHRONOS", "VisualNovel", "adventure", "Anime"], "long_description": "\u201cThe next Visual Novel awaits beyond the screen.\u201d TOKYO CHRONOS is a VR Mystery Visual Novel told in an immersive 360\u00b0 world. Characters with personality come to life right before your eyes \u2500 their fate lies in your hands. An empty, deserted Shibuya where time has frozen over. A suspenseful mystery woven by 8 childhood friends trapped inside. Lost memories; A strange message: \u201cI am dead. Who killed me?\u201d Who is \u201cI\u201d? Why did we lose our memory? Who is the killer? Fragments shattered like a broken mirror. Where does the truth lie? To kill, or not to kill \u2500 YOU decide. # Features - All-new Visual Novel designed for VR from the ground up - Engrossing storyline with story duration of est. 15-20 hours - Over 5,000 lines of professionally voice-acted dialogue - Multiple routes and endings # Staff Director\uff1aHaruki Kashiwakura (Expelled from Paradise) Script\uff1aKou Segawa (Nazozuki Otome) Producer\uff1aKazuma Miki (Sword Art Online) Character Design\uff1aLAM (Illustrator) Theme Song\uff1aUNLIMITED / Eir Aoi", "short_description": "TOKYO CHRONOS is an all-new VR Mystery Visual Novel, designed from the ground up for VR by the creators of Expelled From Paradise and Sword Art Online. Experience an engrossing storyline 15-20 hours long, with multiple routes and endings. An empty, deserted Shibuya where time has frozen over. 8 childhood friends trapped inside. Lost memories; A strange message: \u201cI am dead. Who killed me?\u201d Who is \u201cI\u201d? Why did we lose our memory? Who is the killer? To kill, or not to kill \u2500 YOU decide."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tokyochronos.com/en/privacypolicy/", "developer_terms_of_service_url": "https://tokyochronos.com/en/terms/index.html", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://tokyochronos.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["NARRATIVE", "MUSIC", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "477909637263704"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1607213693854172"}, {"status": "PUBLISHED", "id": "1921167968528476"}, {"status": "PUBLISHED", "id": "1241029257449112"}, {"status": "PUBLISHED", "id": "623266766793692"}, {"status": "CANCELLED", "id": "1185189106094388"}, {"status": "PUBLISHED", "id": "220248296155207"}, {"status": "PUBLISHED", "id": "1471710153002830"}, {"status": "PUBLISHED", "id": "137353061804288"}, {
64902503303", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031477_4308564905836636_6274524008135682620_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHUGJ4VL99YQ7kNvwE0d8Fu&_nc_oc=Adpwnl3JKPSqVs6UXzF4WZ6_cCGZzWWWClx03l5yZ7JdJTOnVmwE4gj7pHyA48l4XY8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxmBc8XBN9I1kpHlGFXvCekQ0sYOxPvpc2KMVu5M4njA&oe=6B070ECA"}, {"file_name": "TokyoChronos_AddScreenShot15 (1).png", "id": "268064451290987", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031467_268064454624320_6690619984376577959_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5U6J8fU2rcEQ7kNvwGMFcFH&_nc_oc=Adq0zA1mum9gyxGoefFeV2RJNI21tA2tlN-fBQhZvCjATyHPN19kcNElyYrjNmDSiLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQidk60VEegG-kO8dHn3GgFRcTm7r_iGUforqXv6NoaA&oe=6B06F348"}, {"file_name": "TokyoChronos_AddScreenShot13.png", "id": "472847610346262", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031639_472847613679595_4542425813744423185_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yz6A6zEJXhMQ7kNvwHowCHD&_nc_oc=AdriWQIAMRWzvMAElrc3YtTelbnW-_FycNyUBrC9x9P81v9de2t7x0bYJz9WiXUwnIY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaG_Cpa3iEkB2FM3bTS1_d9DkRA--9ayezB6u0NU0u7g&oe=6B06FBD3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TokyoChronos_AddScreenShot15 (1).png", "id": "1347271088998137", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393566_1347271095664803_5387546881034672347_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7iblB66lGQQ7kNvwHf-psq&_nc_oc=Adqz4U-6tP3Dt6HvfKOdufNUDPpzPCFI0xTgekcyfOUcEgVYaScc44RYDHzTK9cQu6k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSID4Gr-whtqpue6fi6Owd-5wwYV8X7SSFnoGezxif0OQ&oe=6B072580"}, "display_name": "TOKYO CHRONOS", "keywords": ["TOKYOCHRONOS", "CHRONOS", "VisualNovel", "adventure", "Anime"], "long_description": "Note: This game takes around 10-15 hours to complete, with new paths that unlock with multiple playthroughs. Don't stop playing after the first credits roll! \n\nTOKYO CHRONOS is the VR game that has multiple-choice decision points as well as more than one ending. It has a long story you've never experienced before with VR.\nThe game takes place in Shibuya, Tokyo, which has only eight people, including you, the protagonist, Kyosuke Sakurai. Can you solve the mystery and get out of the silent Shibuya?\n\n-Features-\n\u25cf Drastic advancement of visual novel games with VR \nThe total gameplay time reaches to 15 hours. The story has multiple-choice decision points as well as more than one ending.\n\n\u25cfMoving scenario making your HMD wet with your tears \nOne review says, \"I've purchased several games at the Oculus store, and none of them satisfied me. But TOKYO CHRONOS is no comparison. At first, you're surprised at the beautiful images. But the deep story surpasses it\".\n\n", "short_description": "TOKYO CHRONOS is the VR game that has multiple-choice decision points as well as more than one ending. It has a long story you've never experienced before with VR.\nThe game takes place in Shibuya, Tokyo, which has only eight people, including you, the protagonist, Kyosuke Sakurai. Can you solve the mystery and get out of the silent Shibuya?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tokyochronos.com/en/privacypolicy/", "developer_terms_of_service_url": "https://tokyochronos.com/en/terms/index.html", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://tokyochronos.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED"
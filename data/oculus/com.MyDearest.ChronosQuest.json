j70MxE3HfXXUx1WxI2QUnVGe_3y5g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jk-tXKiNYoJqP59HS-ESJQflzpxi_Vw3LwUK1Ql8pDQ&oe=6A4526C8"}, {"file_name": "TokyoChronos_AddScreenShot13.png", "id": "472847610346262", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031639_472847613679595_4542425813744423185_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLBK6NWULH4Q7kNvwEftKEi&_nc_oc=Adq06xLMVuUn34rcfiWwcxTQp3hwQa5Tub9J0KXccESPDhPcwSi9tjS7Cuere2uNI9I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tbWlxi_sblk-eMmvSLjzeFy1wSYiXRFtP2HfTaUvhMw&oe=6A452F53"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TokyoChronos_AddScreenShot15 (1).png", "id": "1347271088998137", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75393566_1347271095664803_5387546881034672347_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fWHCCTawcxMQ7kNvwHVj7ZB&_nc_oc=AdqekcNiXJS2neaszHN52dbSBXMFvHkAz_FY1XVWNSvDw0PRDIn0Lskgznn_vx6k4Qo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ik7Khfk8_92Ef8g5l5ZwRuD8N0DrkdE8CHUhKRy-UjA&oe=6A4520C0"}, "display_name": "TOKYO CHRONOS", "keywords": ["TOKYOCHRONOS", "CHRONOS", "VisualNovel", "adventure", "Anime"], "long_description": "Note: This game takes around 10-15 hours to complete, with new paths that unlock with multiple playthroughs. Don't stop playing after the first credits roll! \n\nTOKYO CHRONOS is the VR game that has multiple-choice decision points as well as more than one ending. It has a long story you've never experienced before with VR.\nThe game takes place in Shibuya, Tokyo, which has only eight people, including you, the protagonist, Kyosuke Sakurai. Can you solve the mystery and get out of the silent Shibuya?\n\n-Features-\n\u25cf Drastic advancement of visual novel games with VR \nThe total gameplay time reaches to 15 hours. The story has multiple-choice decision points as well as more than one ending.\n\n\u25cfMoving scenario making your HMD wet with your tears \nOne review says, \"I've purchased several games at the Oculus store, and none of them satisfied me. But TOKYO CHRONOS is no comparison. At first, you're surprised at the beautiful images. But the deep story surpasses it\".\n\n", "short_description": "TOKYO CHRONOS is the VR game that has multiple-choice decision points as well as more than one ending. It has a long story you've never experienced before with VR.\nThe game takes place in Shibuya, Tokyo, which has only eight people, including you, the protagonist, Kyosuke Sakurai. Can you solve the mystery and get out of the silent Shibuya?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tokyochronos.com/en/privacypolicy/", "developer_terms_of_service_url": "https://tokyochronos.com/en/terms/index.html", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://tokyochronos.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4802221313188946"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75643375_2502834173342169_1905876374764285425_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KOZuV5BmnaYQ7kNvwHgTZ-9&_nc_oc=AdrfDwUrH3QHIaVfQ_ySMa0T6fNxb-ocruvubKhv5cY1Kmy4YrH
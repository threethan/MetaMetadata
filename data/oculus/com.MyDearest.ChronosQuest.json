577959_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OhQIpKsrxvkQ7kNvwH_YUUn&_nc_oc=AdpEWOmNRYY12aOUSPZCKEld6fejJV96OFrW5YDV_YoDDVjQMeCHllbTTIQdKrgEyU8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlZYUM2ZtanvVt2O4iRIBR4a3P0xsMqjn74QmDxzjZUw&oe=6A971C08"}, {"file_name": "TokyoChronos_AddScreenShot13.png", "id": "472847610346262", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031639_472847613679595_4542425813744423185_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tvru4VRXWBIQ7kNvwF6IMF0&_nc_oc=Ado9_UpTyTID3-tb5Icf9B8MEzuLR141bY7IKbVj7XN2H4I6rAY1C3HjSvj1B5-2l3A&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq16VVi99Ix035EhmehUEQFP07-7OGOI8iJgj_dswwqQ&oe=6A972493"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TokyoChronos_AddScreenShot15 (1).png", "id": "1347271088998137", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75393566_1347271095664803_5387546881034672347_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6fGVp6x52gQ7kNvwG6UZoE&_nc_oc=AdpuTMh-S8HGYLxh9qMehmJI9t12B_IUwCGN6v-b5tKssspfTkpshfWmU5OHiS6syhY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIbLjudQxgcBdcuRVjJkpprVE6G8r7aAtH2Ze-fr4iKw&oe=6A974E40"}, "display_name": "TOKYO CHRONOS", "keywords": ["TOKYOCHRONOS", "CHRONOS", "VisualNovel", "adventure", "Anime"], "long_description": "Note: This game takes around 10-15 hours to complete, with new paths that unlock with multiple playthroughs. Don't stop playing after the first credits roll! \n\nTOKYO CHRONOS is the VR game that has multiple-choice decision points as well as more than one ending. It has a long story you've never experienced before with VR.\nThe game takes place in Shibuya, Tokyo, which has only eight people, including you, the protagonist, Kyosuke Sakurai. Can you solve the mystery and get out of the silent Shibuya?\n\n-Features-\n\u25cf Drastic advancement of visual novel games with VR \nThe total gameplay time reaches to 15 hours. The story has multiple-choice decision points as well as more than one ending.\n\n\u25cfMoving scenario making your HMD wet with your tears \nOne review says, \"I've purchased several games at the Oculus store, and none of them satisfied me. But TOKYO CHRONOS is no comparison. At first, you're surprised at the beautiful images. But the deep story surpasses it\".\n\n", "short_description": "TOKYO CHRONOS is the VR game that has multiple-choice decision points as well as more than one ending. It has a long story you've never experienced before with VR.\nThe game takes place in Shibuya, Tokyo, which has only eight people, including you, the protagonist, Kyosuke Sakurai. Can you solve the mystery and get out of the silent Shibuya?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tokyochronos.com/en/privacypolicy/", "developer_terms_of_service_url": "https://tokyochronos.com/en/terms/index.html", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://tokyochronos.com/en/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja", "zh_CN", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4802221313188946"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75643375_2502834173342169_1905876374764285425_n.png?stp=dst-png_s360x360&
://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12138856_1640726729538031_1230096389_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTrqU6SYK9cQ7kNvwHrfvo6&_nc_oc=Adq1_6D_mP0TfH-3-dACIkRCS4HjrxqFvQCHLrgL_6OW2TQu79Y14-IQdgj9N2wjUkY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWrsah48SI3MytAyzz8IM5INljYIEWvX4JXv8L4LpYOg&oe=6AFC607C"}, {"file_name": "migrated_image.png", "id": "588078341791489", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12138990_107834796239160_1793361246_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KORX_U3porwQ7kNvwG3akd_&_nc_oc=AdqpUho9RQrUZlgUZjEt5zcMg5mJ5GdBNFc0WpK8QQgAPQPT7cpfemrgshl6SjZrhvY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1CsoHWnxZrV830oVI3nhihV-RVu0AD8YLJ2nBXu6k6A&oe=6AFC68DA"}, {"file_name": "migrated_image.png", "id": "138159877633058", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12138910_897386600354716_1997145406_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWPv95fGdDkQ7kNvwFxKBYa&_nc_oc=Adq16NTFtC4_EBGbslGmVXs5ddYp820N38RnS74M_Uj3Nik6s8v-CwdfBCJVpcHLetk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcrmuzmmz2c6oguMuPRXTmhvauqDd1Pcjsa-0aCbKUbQ&oe=6AFC736E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Colosse", "keywords": [], "long_description": "'COLOSSE' is a real-time virtual reality storytelling experience, with a stylized, character-focused visual language. The story of the long lost Great Spirits known as the COLOSSE explores themes of fear, power and respect.\n\nVR storytelling is no easy feat. We set out to create an experience that requires no direct input from the viewer and yet allows them to experience a story crafted for real-time VR. This is quite a challenge, and elements of the scene \u2013 animation, audio and visual design \u2013 guide the viewer's attention toward important story elements. Additionally, while the viewer has no direct control over the action, their gaze \u2013 things they pay the most attention to \u2013 will direct the experience and exert a subtle influence over events as they unfold.\n\nWe've set out to create a highly-stylized aesthetic that will immerse the viewer in a visually impactful environment with appealing characters. The art design is engaging, but also seeks to maximize the graphic potential of mobile hardware. Our team created hand-drawn 2D art and built it into a 3D, real-time rendered VR world around the viewer. This approach is one that we feel creates a unique environment for the story to develop.\n\nNelson Boles \u2013 Animation\nJoseph Chen \u2013 Producer\nKevin Dart \u2013 Art/Concept\nAlex Grigg \u2013 Animation\nEran Hilleli \u2013 Art/Visual Style\nDavid Kamp \u2013 Music/Audio\nJasmin Lai \u2013 Art/Concept\nNick Pittom - Development/Art\nDaniel Sproll \u2013 UX/Development\nJason Storey \u2013 Coder/Development\nJasper Trenfield \u2013 Animation", "short_description": ""}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "ColosseTeam", "support_website_url": null, "website_url": "http://colossevr.tumblr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["NARRATIVE"], "has_in_app_ads": null, "internet_connection": null, "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": [], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "633253944555021"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "858487657581240"}]}, "baseline_offer": {"id": "858487657581240"}, "is_approved": true, "firstOffer": {"no
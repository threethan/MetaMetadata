rogramas educativos."}, {"images": {"nodes": [{"file_name": "491821230_802970628785494_7031154739964414915_n.png", "id": "26948289431446973", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/595143057_26948289451446971_5931148687434737436_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hLLqM3LnfwQ7kNvwH66_Ci&_nc_oc=AdqBVyapRlpjFon0iUnqNjrXIIRlYbdH-qA__E0ifoVc-G6Mlnj7MSJizabgLHB7Vv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uzu0M9zAc2OaNHBv1mt0lWRV1SNp5S7IJ0GxGkSlnqw&oe=6A3BDECA"}, {"file_name": "Cover Art Landscape 2560x1440-01.png", "id": "1980223739422520", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825050_1980223742755853_8927552925906080453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fm76EnZdQcQ7kNvwEGrJRw&_nc_oc=AdrpMGvaKMCbifWe17FWbSY907wWVFiLZmP9CXszVIwpyXPZ96ITsWxKuU_wW76OQyE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X8KuSejmWJRywBjJKn9ditq3QFEKN0i1fgKjmZvHjeQ&oe=6A3BD7ED"}, {"file_name": "Icon 512x512-01.png", "id": "1958707404948906", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820548_1958707408282239_952158833739797915_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGPsYshZrOMQ7kNvwF_bNlU&_nc_oc=AdoBOhkkR5CgYirM11TTcr5w3MwBt3xT4IH-xmv29F1WqNs27jB_wqKYTltiBs56qNA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EoyuY5lSyA0-nY5Ce-CgFxziGZeBFvgb2zsTA4x_Hvg&oe=6A3BD3B2"}, {"file_name": "491822581_817511174189170_4478826360259989864_n.png", "id": "1784112582844599", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622334_1784112586177932_6438434074761199102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWSaOqaTNewQ7kNvwEIPkEr&_nc_oc=AdpvESEAFYLzWbNKObByWGEjFHXXE2btlDpX-eMU4RJ5oM0OcsWh0WvLPg1qxlvlqPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-E
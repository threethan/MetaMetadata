3.png", "id": "1099709929041107", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818938_1099709932374440_3041211310705972345_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0Yh9B30n2wQ7kNvwGt6FrN&_nc_oc=AdojI-lkQ28WXnE5nSMJc32-rEsmnsC5_nW1vAJu-rIRSRRGjGd9MD2mNGytarLP0d0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_I153rJZTZBQ2iKMKfF6_teW5aN5zDT854UEtIZquZw&oe=6A3D4FED"}, {"file_name": "ScreenShot-04.png", "id": "1337318304800710", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820585_1337318311467376_159200751625933356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNo7z_9WmYoQ7kNvwGjqgWZ&_nc_oc=Adp-D7QlTJW-V9stsMLwYvzvK_xhHW_1qCNt9W3LSXUslWiu6UQG2PXgt0kWPQL0-gU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zpfVF_cNbyirpVEKpYHb49oO6u-XKg2OB31oWruutQQ&oe=6A3D431C"}, {"file_name": "ScreenShot-05.png", "id": "682680914850733", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823876_682680918184066_4843740821197245477_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gD0AomKRtbgQ7kNvwEG7UxG&_nc_oc=AdovP0ZQ7812xRYXcM97Gdx9cOTupg0jfZhbnbB173khWfaxfc0iNycmJYtD7ZoYiq8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uO5WKmSOGwl96L-IeNv5A3l7GIihL6LKi642_pjAWsA&oe=6A3D454D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape 2560x1440-01.png", "id": "1435446094217683", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824592_1435446097551016_1067909250866758337_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lfa-VZZFrEIQ7kNvwGXMvxu&_nc_oc=Ado5Om4FZRjdSv3pI1aj9rf3zAzaj2KbKz8sFDJULJ3wsSojl8kf4JshX38bx512fkc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aDL8gduUrw1lX3JAIYDvodavBTNPej9_c7xCmU3m3Jw&oe=6A3D4BE7"}, "display_name": "Safe Driving", "keywords": [], "long_description": "Have you ever wondered how you would react behind the wheel in critical situations?\nPicture this: you\u2019re driving at night\u2014tired, distracted, or after a few drinks\u2014and suddenly everything changes. Would you be able to stay in control of the vehicle? At Four Players VR, we\u2019ve created a driving simulation in Virtual Reality that allows you to safely and powerfully experience how alcohol, fatigue, and distractions affect your reflexes, attention, and decision-making.\n\nGet ready to drive with awareness:\n\n\ud83d\ude97 Experience: Discover firsthand the effects of alcohol, drowsiness, and cell phone use on your reaction time.\n\n\ud83d\ude97 Live: Realistic scenarios that show you the risks of driving under dangerous conditions.\n\n\ud83d\ude97 Learn: Turn every immersive experience into a practical lesson to promote safer, more responsible driving.\n\nDon\u2019t leave your safety to chance. Join us and transform the way you drive with Four Players VR! \ud83d\udea6", "short_description": "\ud83d\ude97 Experience: Feel how alcohol, fatigue, and distractions affect your attention and reflexes behind the wheel.\n\n\ud83d\ude97 Live: Immersive Virtual Reality scenarios that realistically show you the risks of irresponsible driving.\n\n\ud83d\ude97 Learn: Turn the experience into awareness\u2014perfect for training, campaigns, and educational programs."}]}, "developer_name": "Soukai", "developer_privacy_policy_url": "https://soukai.com.ar/en/soukai-fpestudio-privacy-policy", "developer_terms_of_service_url": "https://soukai.com.ar/en/soukai-fpestudio-terms-of-service", "publisher_name": "FourPlayers VR", "support_website_url": "https://fourplayersvr.com/", "website_url": "https://fourplayersvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT",
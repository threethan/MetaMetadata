3.png", "id": "1099709929041107", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818938_1099709932374440_3041211310705972345_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0Yh9B30n2wQ7kNvwFZZtp-&_nc_oc=Adr_5mbmEJw5WqhemnWBhChJOtE0io_tDVwu_kwUTq3Mw7T10oCRIa1dguF9RKDkywQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VxADyD0Z-Z6F2Mxnp1LUQQLrV_JakrBhEqerDiTCRuw&oe=6A3BFE6D"}, {"file_name": "ScreenShot-04.png", "id": "1337318304800710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820585_1337318311467376_159200751625933356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_IUxI6dymgQ7kNvwF7VJcd&_nc_oc=AdqyKakinNqwECyekM7Ktsivq8UfODyqX_Cwy5BEVskgAm_CPLA2FP2iQk7w_FFeGmU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3oqrHyht1LDr9dYpBMicjMyyG_JMsCm7-aSEPAsq69A&oe=6A3BF19C"}, {"file_name": "ScreenShot-05.png", "id": "682680914850733", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823876_682680918184066_4843740821197245477_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mAyV5i5rTEQ7kNvwHB-GBe&_nc_oc=AdrubO6GeQDyVpEolNJ3VUbNc5zUU6JUWWG46LbpX6K_XjaDYwglbfMZQVpAszA0Z50&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T7qjrXZTRfsgsT_5PGyI--rL7et6Km5ZDIWS_wsKi-A&oe=6A3BF3CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape 2560x1440-01.png", "id": "1435446094217683", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824592_1435446097551016_1067909250866758337_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lfa-VZZFrEIQ7kNvwFR2d6b&_nc_oc=AdrnKXwTn4y_7FNll0ICZeYQ6WZ8c_4O9kb4x6pnUdoZo7QjSuE7DUzE9QqWsglnkhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-q4-5WvR7zW5Ny9auSBwlS4Blv9wm1w7dteY9tTDq1UA&oe=6A3BFA67"}, "display_name": "Safe Driving", "keywords": [], "long_description": "Have you ever wondered how you would react behind the wheel in critical situations?\nPicture this: you\u2019re driving at night\u2014tired, distracted, or after a few drinks\u2014and suddenly everything changes. Would you be able to stay in control of the vehicle? At Four Players VR, we\u2019ve created a driving simulation in Virtual Reality that allows you to safely and powerfully experience how alcohol, fatigue, and distractions affect your reflexes, attention, and decision-making.\n\nGet ready to drive with awareness:\n\n\ud83d\ude97 Experience: Discover firsthand the effects of alcohol, drowsiness, and cell phone use on your reaction time.\n\n\ud83d\ude97 Live: Realistic scenarios that show you the risks of driving under dangerous conditions.\n\n\ud83d\ude97 Learn: Turn every immersive experience into a practical lesson to promote safer, more responsible driving.\n\nDon\u2019t leave your safety to chance. Join us and transform the way you drive with Four Players VR! \ud83d\udea6", "short_description": "\ud83d\ude97 Experience: Feel how alcohol, fatigue, and distractions affect your attention and reflexes behind the wheel.\n\n\ud83d\ude97 Live: Immersive Virtual Reality scenarios that realistically show you the risks of irresponsible driving.\n\n\ud83d\ude97 Learn: Turn the experience into awareness\u2014perfect for training, campaigns, and educational programs."}]}, "developer_name": "Soukai", "developer_privacy_policy_url": "https://soukai.com.ar/en/soukai-fpestudio-privacy-policy", "developer_terms_of_service_url": "https://soukai.com.ar/en/soukai-fpestudio-terms-of-service", "publisher_name": "FourPlayers VR", "support_website_url": "https://fourplayersvr.com/", "website_url": "https://fourplayersvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT",
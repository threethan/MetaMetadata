rogramas educativos."}, {"images": {"nodes": [{"file_name": "491821230_802970628785494_7031154739964414915_n.png", "id": "26948289431446973", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/595143057_26948289451446971_5931148687434737436_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrzhBGzsfEcQ7kNvwF7inPs&_nc_oc=Adoy6lHJhX8ihTixJZYm8DSxgQe3l22m49mv6M3rEVbMFEH_NFmT583111hMj5ffsp8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eebimVGEG_ZtzAfpjtL_-vJshUCKH0zp7M34NpjxePA&oe=6A30014A"}, {"file_name": "Cover Art Landscape 2560x1440-01.png", "id": "1980223739422520", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825050_1980223742755853_8927552925906080453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUtPx8VdVbEQ7kNvwH9cYsc&_nc_oc=AdrX_5CLOmj55C0AZriLP6EaqE4mEj3jlozZPaf01JWvtnxsxFQVCc9_Z6zOJgvpfKo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qqZE2RynX-WLQ5QpqyxU9eBI_fMo3icZHHR8me3VGKw&oe=6A2FFA6D"}, {"file_name": "Icon 512x512-01.png", "id": "1958707404948906", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820548_1958707408282239_952158833739797915_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeNz5jnKIQUQ7kNvwFRs04K&_nc_oc=AdquARZzNltebGY0IpbiUxRBRsTpArR7wgrHN5154OKObtF_Wsu6eOn7-2819kkfYUc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_72RiZaufCyxC_gYLbST3riYbTxtb64WIPsukBUgkvEw&oe=6A2FF632"}, {"file_name": "491822581_817511174189170_4478826360259989864_n.png", "id": "1784112582844599", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499622334_1784112586177932_6438434074761199102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hMvt0kds6HYQ7kNvwFLOFhR&_nc_oc=Adp7YnXG2BYCqJRBQo8nk1SwVCRxv670YJcfvKEavV0DEwK47wXTIjJo2g30BZsKq_s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tW
-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af850WIOCf5XJyO89E9mpw5XA_OBj5EGGOFUEiQoRdq6Pg&oe=6A46763B"}, {"file_name": "ScreenShot-02.png", "id": "1600273487625358", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821923_1600273490958691_8691150999689159543_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NaQc6SPpqYkQ7kNvwEKJaSf&_nc_oc=AdoonUl1VYTnzlKh_AAvWV8U7p-93aZf3sv9Z___kF-YMrmjwKW5jAUYjqNWMMJO2Jc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_b_q85RPVqWj9ES5FvhG-AsIPurZDZTD8YHnsgrYeCQ&oe=6A467E6C"}, {"file_name": "ScreenShot-03.png", "id": "1099709929041107", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491818938_1099709932374440_3041211310705972345_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUpmT3g3TdUQ7kNvwEWyJ0A&_nc_oc=AdoF6FGUSuKvqKmZWWB8c7pbIAFOa9gm590gmUdKOV3SkQXzHbZL31_XoPNmZY5wq90&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eNhssgzBvWmPztsH-2oOJp3nb5t14aqU_QDN2LEMrSg&oe=6A468A6D"}, {"file_name": "ScreenShot-04.png", "id": "1337318304800710", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820585_1337318311467376_159200751625933356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YlzseZyqIdAQ7kNvwF8u8u-&_nc_oc=AdruD0gABNPdON44zOm7KdXa13pOwlMZ87ZRO4AeIE0uIlHc6xJWMop0H1BR4_pBI9Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DX5eeZjvEz4TvTnkxyXF_Q75ePnQ0w86GITJRlFrQcw&oe=6A467D9C"}, {"file_name": "ScreenShot-05.png", "id": "682680914850733", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491823876_682680918184066_4843740821197245477_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_x66pfDkir8Q7kNvwE81e5L&_nc_oc=Adq9hL_I_pb7aXuVmaVzrSitvgYtg5HsS2y8Z11rJbm-9faa-yGWbknr6cnkuAxSzHU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9l89jISI85K5OvxagT_ucn6bYIZjISTg7QAGHo23kbcQ&oe=6A467FCD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape 2560x1440-01.png", "id": "1435446094217683", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491824592_1435446097551016_1067909250866758337_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SS3-IMoI3B0Q7kNvwG4thKY&_nc_oc=AdpmPEAqVQ6kpnwcZqWykdAeU7PkLXC5VpjXDHZDO6ygXTipVPwuSpsZWNALX02XdHY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zhz4f2WGQKNxl9KkqyIKC-wmmRpsWAy40Rhn6f0m3ig&oe=6A468667"}, "display_name": "Safe Driving", "keywords": [], "long_description": "Have you ever wondered how you would react behind the wheel in critical situations?\nPicture this: you\u2019re driving at night\u2014tired, distracted, or after a few drinks\u2014and suddenly everything changes. Would you be able to stay in control of the vehicle? At Four Players VR, we\u2019ve created a driving simulation in Virtual Reality that allows you to safely and powerfully experience how alcohol, fatigue, and distractions affect your reflexes, attention, and decision-making.\n\nGet ready to drive with awareness:\n\n\ud83d\ude97 Experience: Discover firsthand the effects of alcohol, drowsiness, and cell phone use on your reaction time.\n\n\ud83d\ude97 Live: Realistic scenarios that show you the risks of driving under dangerous conditions.\n\n\ud83d\ude97 Learn: Turn every immersive experience into a practical lesson to promote safer, more responsible driving.\n\nDon\u2019t leave your safety to chance. Join us and transform the way you drive with Four Players VR! \ud83d\udea6", "short_description": "\ud83d\ude97 Experience: Feel how alcohol, fatigue, and distractions affect your attention and reflexes behind the wheel.\n\n\ud83d\ude97 Live: Immersive Virtual Reality scenarios that realistically show you the risks of irresponsible driving.\n\n\ud83d\ude97 Learn: Turn the experience into awareness\u2014perfect for training, campaigns, and educational programs."}]}, "developer_name": "Soukai", "developer_privacy_policy_url": "https://soukai.com.ar/en/soukai-fpestudio-privacy-policy", "developer_terms_of_service_url
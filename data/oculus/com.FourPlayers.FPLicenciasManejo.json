NjwgIQGmoQJKOrB9iPolbWajM8QIWtF8yRr2HEVrXo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMZB168aFZTXfKepx6CE2_CfAKMlbthJkZHNoBWHoWxg&oe=6A7476AD"}, {"file_name": "ScreenShot-04.png", "id": "1337318304800710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820585_1337318311467376_159200751625933356_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IK1D10QQ5aYQ7kNvwFsCkhq&_nc_oc=Adqq9eS73tH57SdhmBg170cIGUhzHgFL8d7w6JTQfEzqUI8L6k5GGeNN8DLLXdaM5ls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnu0JUKbCEofOWQ29dKCKhjQl1KTxzmhFHEDxkRtcN1g&oe=6A74A21C"}, {"file_name": "ScreenShot-05.png", "id": "682680914850733", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823876_682680918184066_4843740821197245477_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDfTy_Mvn4sQ7kNvwFvjJq9&_nc_oc=Ador16KHxHWYMj1UeUg6VkMpa8mq6pTcPHIToT1TW75vY7uq_Ag2VkXPtaq5YyAd3Ts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAYu8Oa1VM7nkxkAAz0cERfgo3aJm5mi035ukwtcyWZw&oe=6A74A44D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape 2560x1440-01.png", "id": "1435446094217683", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824592_1435446097551016_1067909250866758337_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qf1M9rbsKDoQ7kNvwF93Nb8&_nc_oc=AdoM5LrunNu7XLn60rVUvZwZw_NFHawHI_UyobE977rud8MdC3yXv_E8uvaQ4TDm5Uo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLTv2lTD9No1Vamt5z2DJ-Tkyrks0Yznjkwsvel7PJ-w&oe=6A7472A7"}, "display_name": "Safe Driving", "keywords": [], "long_description": "Have you ever wondered how you would react behind the wheel in critical situations?\nPicture this: you\u2019re driving at night\u2014tired, distracted, or after a few drinks\u2014and suddenly everything changes. Would you be able to stay in control of the vehicle? At Four Players VR, we\u2019ve created a driving simulation in Virtual Reality that allows you to safely and powerfully experience how alcohol, fatigue, and distractions affect your reflexes, attention, and decision-making.\n\nGet ready to drive with awareness:\n\n\ud83d\ude97 Experience: Discover firsthand the effects of alcohol, drowsiness, and cell phone use on your reaction time.\n\n\ud83d\ude97 Live: Realistic scenarios that show you the risks of driving under dangerous conditions.\n\n\ud83d\ude97 Learn: Turn every immersive experience into a practical lesson to promote safer, more responsible driving.\n\nDon\u2019t leave your safety to chance. Join us and transform the way you drive with Four Players VR! \ud83d\udea6", "short_description": "\ud83d\ude97 Experience: Feel how alcohol, fatigue, and distractions affect your attention and reflexes behind the wheel.\n\n\ud83d\ude97 Live: Immersive Virtual Reality scenarios that realistically show you the risks of irresponsible driving.\n\n\ud83d\ude97 Learn: Turn the experience into awareness\u2014perfect for training, campaigns, and educational programs."}, {"images": {"nodes": []}, "id": "1398165785463844", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manejo Responsable", "keywords": [], "long_description": "\u00bfTe has preguntado alguna vez c\u00f3mo reaccion\u00e1s al volante en situaciones cr\u00edticas?\nImagin\u00e1 esto: est\u00e1s conduciendo de noche, cansado, distra\u00eddo o despu\u00e9s de unas copas, y de repente todo cambia. \u00bfPodr\u00edas mantener el control del veh\u00edculo? En Four Players VR, hemos creado una simulaci\u00f3n de conducci\u00f3n en Realidad Virtual que te permite experimentar, de forma segura e impactante, c\u00f3mo el alcohol, el cansancio y las distracciones afectan tus reflejos, tu atenci\u00f3n y tus decisiones.\n\nPrep\u00e1rate para conducir con conciencia:\n\n\ud83d\ude97 Experiment\u00e1: Descubr\u00ed en primera persona los efectos del alcohol, el sue\u00f1o y el celular en tu capacidad de reacci\u00f3n.\n\n\ud83d\ude97 Viv\u00ed: Situaciones realistas que te muestran los riesgos de manejar bajo condiciones peligrosas.\n\n\ud83d\ude97 Aprend\u00e9: Convert\u00ed cada experiencia inmersiva en una lecci\u00f3n pr\u00e1ctica para fomentar una conducci\u00f3n m\u00e1s segura y responsable.\n\nNo dejes tu seguridad al azar. \u00a1Unite a nosotros y transform\u00e1 tu manera de manejar con Four Players VR! \ud83d\udea6", "short_description": "\ud83d\ude97 Experiment\u00e1: Sent\u00ed c\u00f3mo el alcohol, el cansancio y las distracciones afectan tu atenci\u00f3n y reflejos al volante.\n\n\ud83d\ude97 Viv\u00ed: Escenarios inmersivos en Realidad Virtual que te muestran de forma real los riesgos de conducir sin responsabilidad.\n\n\ud83d\ude97  Aprend\u00e9: Transform\u00e1 la experiencia en conciencia, ideal para capacitaciones, campa\u00f1as y programas educativos."}]}, "developer_name": "Soukai", "developer_privacy_policy_url": "https://souls.soukai.com.ar/politicas/privacy_policy_en", "developer_terms_of_service_url": "https://souls.soukai.com.ar/politicas/terms_en", "publisher_name": "FourPlayers VR", "support_website_url": "https://fourplayersvr.com/", "website_url": "https://fourplayersvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26718122274533935"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595143057_26948289451446971_5931148687434737436_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpWbhK2qcbcQ7kNvwEr7XjH&_nc_oc=AdrKRqSGQUhmH3mDYez3yfz4CmuZt_HlamL4WfuheUQhq8cRg4wtkQsUsA8-Z6gq71A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFl_0HDEO7tT_4b7bpwj9DY6f-qxDUOHuS9y526KzwK-A&oe=6A748F4A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Safe Driving", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1780591500, "lastRevision": {"nodes": [{"id": "8464435306995910", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8464435243662583", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "799464839448027"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1544949343688660", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Manejo Responsable", "keywords": [], "long_description": "\u00bfTe has preguntado alguna vez c\u00f3mo reaccion\u00e1s al volante en situaciones cr\u00edticas?\nImagin\u00e1 esto: est\u00e1s conduciendo de noche, cansado, distra\u00eddo o despu\u00e9s de unas copas, y de repente todo cambia. \u00bfPodr\u00edas mantener el control del veh\u00edculo? En Four Players VR, hemos creado una simulaci\u00f3n de conducci\u00f3n en Realidad Virtual que te permite experimentar, de forma segura e impactante, c\u00f3mo el alcohol, el cansancio y las distracciones afectan tus reflejos, tu atenci\u00f3n y tus decisiones.\n\nPrep\u00e1rate para conducir con conciencia:\n\n\ud83d\ude97 Experiment\u00e1: Descubr\u00ed en primera persona los efectos del alcohol, el sue\u00f1o y el celular en tu capacidad de reacci\u00f3n.\n\n\ud83d\ude97 Viv\u00ed: Situaciones realistas que te muestran los riesgos de manejar bajo condiciones peligrosas.\n\n\ud83d\ude97 Aprend\u00e9: Convert\u00ed cada experiencia inmersiva en una lecci\u00f3n pr\u00e1ctica para fomentar una conducci\u00f3n m\u00e1s segura y responsable.\n\nNo dejes tu seguridad al azar. \u00a1Unite a nosotros y transform\u00e1 tu manera de manejar con Four Players VR! \ud83d\udea6", "short_description": "\ud83d\ude97 Experiment\u00e1: Sent\u00ed c\u00f3mo el alcohol, el cansancio y las distracciones afectan tu atenci\u00f3n y reflejos al volante.\n\n\ud83d\ude97 Viv\u00ed: Escenarios inmersivos en Realidad Virtual que te muestran de forma real los riesgos de conducir sin responsabilidad.\n\n\ud83d\ude97  Aprend\u00e9: Transform\u00e1 la experiencia en conciencia, ideal para capacitaciones, campa\u00f1as y programas educativos."}, {"images": {"nodes": [{"file_name": "491821230_802970628785494_7031154739964414915_n.png", "id": "26948289431446973", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595143057_26948289451446971_5931148687434737436_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpWbhK2qcbcQ7kNvwEr7XjH&_nc_oc=AdrKRqSGQUhmH3mDYez3yfz4CmuZt_HlamL4WfuheUQhq8cRg4wtkQsUsA8-Z6gq71A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvOQq23fDbH6w8oezOSwDF6mDrrC7zJDUeEW_004Ggsw&oe=6A748F4A"}, {"file_name": "Cover Art Landscape 2560x1440-01.png", "id": "1980223739422520", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825050_1980223742755853_8927552925906080453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FM9Ip_3c2cQ7kNvwGJXCvm&_nc_oc=AdqMnDBhN3xsPxv3CFZgfUW09Y8ESqS-3UGhIK0jWelUIpUCtSy5WEoTGb7PthE6J_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_
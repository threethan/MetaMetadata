rogramas educativos."}, {"images": {"nodes": [{"file_name": "491821230_802970628785494_7031154739964414915_n.png", "id": "26948289431446973", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595143057_26948289451446971_5931148687434737436_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_wpAZiNNv4Q7kNvwFnV6f-&_nc_oc=Adr1bA9nI0LFLwPwkkUz7tOWP3FXo0JpvMmLH5pMX6WpnXRNWr77qZ2dxiNSA87UMAE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80BC6NTLZzj58A3xz44lZ59mhuvYyv3dY1Dv3hJda9bg&oe=6A2ABB4A"}, {"file_name": "Cover Art Landscape 2560x1440-01.png", "id": "1980223739422520", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825050_1980223742755853_8927552925906080453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO-GDpGQJvMQ7kNvwHhY0Iy&_nc_oc=Adp5rFYqaXI9H0rAmiEnQ9CzBysomPTu5mHZDfLe38ujrxZQApuPCGPBLNCLJplRs0A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8As_zU6DRPwjlLDiYsdhaCqLhx4mBCHN10E-X4tNCCaA&oe=6A2AB46D"}, {"file_name": "Icon 512x512-01.png", "id": "1958707404948906", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820548_1958707408282239_952158833739797915_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_pcFZpCNP8Q7kNvwGiboL7&_nc_oc=Ado3wvapLy4G8JROgSeIXeUHG9dc514vG0P2SQh9xQQo6DMSl0EL9YrkqUhRJec87EU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ogWUezjupJSZ1KS9btFhbQPm97JY9gTzI8bEKvi59dw&oe=6A2AB032"}, {"file_name": "491822581_817511174189170_4478826360259989864_n.png", "id": "1784112582844599", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622334_1784112586177932_6438434074761199102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g1umcHTYRCIQ7kNvwEh9zn-&_nc_oc=Ado6tq-DTTbkoxkgIzfD1Ud3u5hoNcdw4QHcazeyrMxrIrzzNiL3hbpNDkZdK9-5tmw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BT
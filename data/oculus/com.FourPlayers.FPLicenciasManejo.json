rogramas educativos."}, {"images": {"nodes": [{"file_name": "491821230_802970628785494_7031154739964414915_n.png", "id": "26948289431446973", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/595143057_26948289451446971_5931148687434737436_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hLLqM3LnfwQ7kNvwEnFKYN&_nc_oc=Ado5b3H46pD_A_PR-01o5W_1nPWO5wpVR-hLKIAxdOLwbqkFg67w--SFGyk-f1BEgRc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83iTb7-O-1kx8FGPu_fECpB0U7GEqONPpIwc886ObBMg&oe=6A3A8D4A"}, {"file_name": "Cover Art Landscape 2560x1440-01.png", "id": "1980223739422520", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825050_1980223742755853_8927552925906080453_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2fm76EnZdQcQ7kNvwFRlQVH&_nc_oc=AdpQWI_JgvWl32ZY0_-PKg9_pz5zUogyH9yg983hIuu7d571vXUFabsJBBFc-IApVS8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FoMJ0dGq_2B-ZS_Zi2Kcx1m7Zb2iFfLrRr6TjlzJe2A&oe=6A3A866D"}, {"file_name": "Icon 512x512-01.png", "id": "1958707404948906", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820548_1958707408282239_952158833739797915_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGPsYshZrOMQ7kNvwEn0-iY&_nc_oc=AdrEwpRZaZ4C2qhf8_cshMmFeX75B0Zu9RgMj1aC0tGc5YloOwg-Q0XYdZiAkseW23A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CvRy38yTXadc1d1kJvY4U3gDYElhvv2Z407J0XvnJkw&oe=6A3ABA72"}, {"file_name": "491822581_817511174189170_4478826360259989864_n.png", "id": "1784112582844599", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622334_1784112586177932_6438434074761199102_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6NZxLyiP5gQ7kNvwEwBEBt&_nc_oc=Adqihz2XJ0cCgks8nCerQ85nNtKX-Qe_QWGJy3vssCuqy0-xlmdgjJ6A9RbTKLUuOSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pf
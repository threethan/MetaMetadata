_sid=6e7a0a&_nc_ohc=wdl-HeUkr0oQ7kNvwHX2UNe&_nc_oc=AdpyeA9x24gsmoLoj_SpFMFW3Inp4G9jV8ZB6CiuMa5CSdxGHZz7dxrnnpfsINTbhzo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qyIsUp5TH9MPKrO3GUM-pQu0rOy2bZ6Gv9Wpa-fF5UA&oe=6A36C3A8"}, {"file_name": "SS4.png", "id": "1086848919103664", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75334064_1086848922436997_7714959779751117552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_3Ki86nzl0Q7kNvwHVIkbs&_nc_oc=AdqJIuvpICCvSvkSxcKSVb5tB2Tj4hJ2n-YspVxxYJPCfnJrzrP0LQLK-lrwhz8d1g8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2A9L9TIBX5ft_QDfhBtbEU4AADYz0B38Av5yF0E8l5A&oe=6A36A79E"}, {"file_name": "SS2.png", "id": "276461161958052", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982647_276461168624718_3129704507020597762_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbEIRGFzPVkQ7kNvwF1R23q&_nc_oc=AdqHVZnQZxI4lfKTYfXiOsghhH516u1Odz4pnJkUairQVBeMP3tK5INQZ_fHcsU5rig&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I39J5k4ddNnJF_qvth52ZpcF7CA2lL8rYHZFJJEwAjg&oe=6A369234"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PetroVR", "keywords": [], "long_description": "Oil Drilling Rig Safety VR Training is an application designed to educate workers on the essential precautions to take while working on an oil drilling rig and to raise awareness of occupational health and safety. Users can experience realistic working conditions in a virtual environment, observe potential hazards, and learn how to prevent them.\n\nThis interactive training application allows users to practice maintaining balance while working, staying clear of hazardous areas, using safety equipment correctly, and responding to emergencies. Additionally, it educates users by simulating the consequences of real-life accidents, enhancing their awareness.\n\nOil Drilling Rig Safety VR Training aims to make occupational health and safety training in workplaces more effective and engaging. Through this application, workers are encouraged to develop conscientious and safe working habits, contributing to the prevention of workplace accidents.", "short_description": "An interactive VR simulation focused on occupational health and safety. It educates workers on the essential precautions to take while working on an oil drilling rig by allowing them to experience accidents firsthand."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/privacy-petrovr.html", "developer_terms_of_service_url": null, "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25460521983593338"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "384636044260081"}]}, "baseline_offer": {"id": "384636044260081"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1711576800, "status": "PUBLISHED", "id": "384636044260081"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25460527663592770", "version": "1,6"}, "id": "892708765837181", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary",
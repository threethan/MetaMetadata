d&_nc_oc=AdmNFTV7nCR2Yh8jV3bHFFX06XWFy5Mbb5O7uqYzhQIgs40jk3qkaS3cFFdTy-PBe1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxjej8sreJ7wghP16kI0VL5pQRI_8ajuHMZraxH3rU0Lg&oe=69B55868"}, {"file_name": "SS4.png", "id": "1086848919103664", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334064_1086848922436997_7714959779751117552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fgFukmao4qgQ7kNvwHwQWlw&_nc_oc=AdnI-bg-Plph0Y1W_qsEvJKYdpuPl_2QTAmaH1FzsG1RMfI1r3znwrrsaR7WVeY2yQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzmF-klEys2B14UxIrebVLxXKaffZdzsNCCYvtP3QFHnQ&oe=69B53C5E"}, {"file_name": "SS2.png", "id": "276461161958052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982647_276461168624718_3129704507020597762_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8TeufMKnToQ7kNvwFGnkeg&_nc_oc=Adn_XjQQd16RvpzLikEk__JXiIgKWeL2pT5UAz46dQBdC1AlWWjkrm2TOHNdrshhcHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afztjp2arPgZMG5ON-y4f9SfpiJm-9xmX65yrt2QNgchVg&oe=69B55F34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PetroVR", "keywords": [], "long_description": "Oil Drilling Rig Safety VR Training is an application designed to educate workers on the essential precautions to take while working on an oil drilling rig and to raise awareness of occupational health and safety. Users can experience realistic working conditions in a virtual environment, observe potential hazards, and learn how to prevent them.\n\nThis interactive training application allows users to practice maintaining balance while working, staying clear of hazardous areas, using safety equipment correctly, and responding to emergencies. Additionally, it educates users by simulating the consequences of real-life accidents, enhancing their awareness.\n\nOil Drilling Rig Safety VR Training aims to make occupational health and safety training in workplaces more effective and engaging. Through this application, workers are encouraged to develop conscientious and safe working habits, contributing to the prevention of workplace accidents.", "short_description": "An interactive VR simulation focused on occupational health and safety. It educates workers on the essential precautions to take while working on an oil drilling rig by allowing them to experience accidents firsthand."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/privacy-petrovr.html", "developer_terms_of_service_url": null, "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25460521983593338"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "384636044260081"}]}, "baseline_offer": {"id": "384636044260081"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1711576800, "status": "PUBLISHED", "id": "384636044260081"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25460527663592770", "version": "1,6"}, "id": "892708765837181", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id
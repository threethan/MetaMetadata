7f20f&oh=00_AQTt6EhnYbIhNiidO9e-1HI6isNLHIstay-3K1eA6jBo_Q&oe=6B06FABF"}, {"file_name": "SS3.png", "id": "339411332420548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031474_339411335753881_7749206364299217410_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8qj5L_DoLUQ7kNvwGTQa4C&_nc_oc=Adqso1hCAX58dnceKLZKeiQZCzzVabtpkzg1vEaARSMsCuqPdkGd5ne35kK9VIo1A1M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwY7SHCqLlhtS2S71gCb380vBpp7_u4RoZfD3zHaMI4Q&oe=6B0710A8"}, {"file_name": "SS4.png", "id": "1086848919103664", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75334064_1086848922436997_7714959779751117552_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43Y26EULPN4Q7kNvwEfSvmI&_nc_oc=Adpwz-Ez6LHVp-wVwfFVHS3M0V-RxUpUoEHRqdoHS9ORtbMjz0t9b96iAzIPI4U4NL0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7fU8gad7YCHIFy7TilyFK9KH8EfX27YzN_3wsUMn6Zw&oe=6B06F49E"}, {"file_name": "SS2.png", "id": "276461161958052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982647_276461168624718_3129704507020597762_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyu85wICJtkQ7kNvwGoWYRz&_nc_oc=AdoXzhLeefWz67cIbVOKkXrgommZGgVRuiQ4MztXs5rd-LcIixRj-GIy-QzPs3RYUZI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5Kim4Yuz18LEOeM31r83mXjHVTvjIqLs1kTZriJfcJQ&oe=6B071774"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PetroVR", "keywords": [], "long_description": "Oil Drilling Rig Safety VR Training is an application designed to educate workers on the essential precautions to take while working on an oil drilling rig and to raise awareness of occupational health and safety. Users can experience realistic working conditions in a virtual environment, observe potential hazards, and learn how to prevent them.\n\nThis interactive training application allows users to practice maintaining balance while working, staying clear of hazardous areas, using safety equipment correctly, and responding to emergencies. Additionally, it educates users by simulating the consequences of real-life accidents, enhancing their awareness.\n\nOil Drilling Rig Safety VR Training aims to make occupational health and safety training in workplaces more effective and engaging. Through this application, workers are encouraged to develop conscientious and safe working habits, contributing to the prevention of workplace accidents.", "short_description": "An interactive VR simulation focused on occupational health and safety. It educates workers on the essential precautions to take while working on an oil drilling rig by allowing them to experience accidents firsthand."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/privacy-petrovr.html", "developer_terms_of_service_url": null, "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25460521983593338"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "384636044260081"}]}, "baseline_offer": {"id": "384636044260081"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1711576800, "status": "PUBLISHED", "id": "384636044260081"}]}, "liveChannel": {"n
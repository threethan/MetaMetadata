7f20f&oh=00_AQQVdgKlLRA1F-CnXl-Cjcv_SflWqannqCyq0flhQmd-Xg&oe=6AFC6EBF"}, {"file_name": "SS3.png", "id": "339411332420548", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031474_339411335753881_7749206364299217410_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvk9V5tmOLkQ7kNvwE0NtRv&_nc_oc=AdooGvBC98u78bvmGGWrdFT3LgmN3y-6TwZX5IzAIMWkW3zH-AMzflaLVUDPGZAQFVY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQgKZrLglZIsRyozW-73W129BHJprUNN815PpaDT-j5Q&oe=6AFC84A8"}, {"file_name": "SS4.png", "id": "1086848919103664", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75334064_1086848922436997_7714959779751117552_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0YWbnIwOEgQ7kNvwGCMDyQ&_nc_oc=AdqJmI8mHfuPaDBePFtEHvsmjOqtW3zIolwLEWY3pq9rOBi0nnDUbxuso4Eb5c6PaJw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLePNpm8cRciZJdZNYS2nol2lXTJ6r83W1qeVVJps6RA&oe=6AFC689E"}, {"file_name": "SS2.png", "id": "276461161958052", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982647_276461168624718_3129704507020597762_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZahT_6Hoc6cQ7kNvwE8LvU3&_nc_oc=Adr4l63BaIXX9H_F_U_3kSPsI1uXSLIrwaSbhffdhwgNjPOI9ub4Lm5pziNVclqJdH4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjxcQsXt6xGJ0QC5UV2Hl5a0EFOew6vUghdXSEOMwYQQ&oe=6AFC8B74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PetroVR", "keywords": [], "long_description": "Oil Drilling Rig Safety VR Training is an application designed to educate workers on the essential precautions to take while working on an oil drilling rig and to raise awareness of occupational health and safety. Users can experience realistic working conditions in a virtual environment, observe potential hazards, and learn how to prevent them.\n\nThis interactive training application allows users to practice maintaining balance while working, staying clear of hazardous areas, using safety equipment correctly, and responding to emergencies. Additionally, it educates users by simulating the consequences of real-life accidents, enhancing their awareness.\n\nOil Drilling Rig Safety VR Training aims to make occupational health and safety training in workplaces more effective and engaging. Through this application, workers are encouraged to develop conscientious and safe working habits, contributing to the prevention of workplace accidents.", "short_description": "An interactive VR simulation focused on occupational health and safety. It educates workers on the essential precautions to take while working on an oil drilling rig by allowing them to experience accidents firsthand."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iottech.com.tr/policy/privacy-petrovr.html", "developer_terms_of_service_url": null, "publisher_name": "RevinoLabs", "support_website_url": null, "website_url": "https://iottech.com.tr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25460521983593338"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "384636044260081"}]}, "baseline_offer": {"id": "384636044260081"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1711576800, "status": "PUBLISHED", "id": "384636044260081"}]}, "liveChannel": {"n
 200108 (2).png", "id": "1009533857612606", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75612008_1009533860945939_3518180760877685287_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZG1HXPZuOKIQ7kNvwGzKbDo&_nc_oc=Adr5DWE3SKTyE7YrD9opSxVYO30Ue7Jk1ES7hpqR3uxGWtVop4bjGW2-06nEd6T0LJI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX4fvgZHVdITwHxxrtkNSsskZ7F-qSVh1OlcOBvBZ8f8A&oe=6B104B58"}, {"file_name": "Screenshot 2024-10-07 200344 (2).png", "id": "917658046900171", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974570_917658050233504_1091060620281586117_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihg5AJh51QEQ7kNvwGx2Zm1&_nc_oc=AdokLhrnJRWEaSkeD1TgX5jUVoz5ww6P4FGsGnmw8ZxL7A6bi_E6D077TyNgWsTsx3o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXAiUxwP1EcKw01JQwLF73uJddzEZvHCaVH7zwVT3hVRQ&oe=6B10569C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974670_6890311307696251_293647471797831381_n.png", "id": "1333625427353294", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031441_1333625430686627_7601787466549361560_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHO5VrhJ-Q4Q7kNvwGyEPh-&_nc_oc=Adoplme3IZ7V41hM7hiaifN21zyff9P3-lDFKPgymrAP-7-Et44ICjtHRBnvB4j44AE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWpjrkdQOa8bF6AAhZ8IO9DHjWhJiCePhWZ9EQUA2SeIQ&oe=6B1058F5"}, "display_name": "Roadside", "keywords": [], "long_description": "Roadside is a game where you can explore, create, and do so much more! In Roadside, you can create and run your own in-game store/business and have other players come to purchase in-game products from you! Or do one of the ingame jobs to stay easy. You can explore the large and expanding map! You can find and customize places to your liking! Be careful for the ingame criminals trying to get quick but risky items or just trying to cause havoc! Or join the in-game law enforcement and help keep the criminals in check and keep Roadside safe from ingame criminals! Don't forget about the nonplayer buildings, some of those can be pretty cool. Explore both the player and non-player-based parts of the game and most importantly we want you to have fun! The best thing is the game is free and multiplayer!", "short_description": "Start your own in-game store/business and sell to other players! Join the in-game law enforcement and stop crime, or cause in-game crime and havoc but don't get caught! In this game, you get to experience both player and NPC parts of the world!"}]}, "developer_name": "Lifeworks Entertainment, LLC", "developer_privacy_policy_url": "https://www.lifeworksent.com/roadsideprivacynotice", "developer_terms_of_service_url": null, "publisher_name": "Lifeworks Entertainment, LLC", "support_website_url": "https://www.lifeworksent.com/contact-us", "website_url": "https://www.lifeworksent.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8543502222339173"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1196940295628057"}]}, "baseline_offer": {"id": "1196940295628057"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774888860, "status": "PUBLISHED", "id": "1196940295628057"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBi
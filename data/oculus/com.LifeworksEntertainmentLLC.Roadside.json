dfw5-2.oculuscdn.com/v/t64.5771-25/75612008_1009533860945939_3518180760877685287_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxJipmkWb84Q7kNvwFf9rUB&_nc_oc=AdqT49V2Db5maXo5Jp2VC47W14VxAQ0XqeFqgWlezro4R_QQEi_na0MVidISYFAos3E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dVggspI0v5BVQXYLDJ0-XGN75dZP1zNfEgwHTOkk6jg&oe=69FDDB18"}, {"file_name": "Screenshot 2024-10-07 200344 (2).png", "id": "917658046900171", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974570_917658050233504_1091060620281586117_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuJogz861-kQ7kNvwFjVzty&_nc_oc=AdrhKjyksDc1bLL-9ciue_8Tgw_KjfbxPwh_ork4hgCvNQjNZo1bRmVYfDHxz5PB-zI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BwwqHvsfe-FfvCdxxTNads2rziqb_qNImLhI7M6BWOQ&oe=69FDE65C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974670_6890311307696251_293647471797831381_n.png", "id": "1333625427353294", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031441_1333625430686627_7601787466549361560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vdl4D14Vg2AQ7kNvwHWz2Uu&_nc_oc=Adqzw2lmx314fJNWiSiqDHxIwJ2FG0-Ku64Wpz8dsaqk5v5zgrss8sktZ8PX8dpOS0U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WjsmYcnWNag-npn1YJ9CZVPYffavypBbPqSwLGIsjMQ&oe=69FDE8B5"}, "display_name": "Roadside", "keywords": [], "long_description": "Roadside is a game where you can explore, create, and do so much more! In Roadside, you can create and run your own in-game store/business and have other players come to purchase in-game products from you! Or do one of the ingame jobs to stay easy. You can explore the large and expanding map! You can find and customize places to your liking! Be careful for the ingame criminals trying to get quick but risky items or just trying to cause havoc! Or join the in-game law enforcement and help keep the criminals in check and keep Roadside safe from ingame criminals! Don't forget about the nonplayer buildings, some of those can be pretty cool. Explore both the player and non-player-based parts of the game and most importantly we want you to have fun! The best thing is the game is free and multiplayer!", "short_description": "Start your own in-game store/business and sell to other players! Join the in-game law enforcement and stop crime, or cause in-game crime and havoc but don't get caught! In this game, you get to experience both player and NPC parts of the world!"}]}, "developer_name": "Lifeworks Entertainment, LLC", "developer_privacy_policy_url": "https://www.lifeworksent.com/roadsideprivacynotice", "developer_terms_of_service_url": null, "publisher_name": "Lifeworks Entertainment, LLC", "support_website_url": "https://www.lifeworksent.com/contact-us", "website_url": "https://www.lifeworksent.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8543502222339173"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1196940295628057"}]}, "baseline_offer": {"id": "1196940295628057"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774888860, "status": "PUBLISHED", "id": "1196940295628057"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26814151091514341", "version": "0.1.0"}, "id": "803377921518333", "channel_name": "LIVE"}]}, "i
4_1091060620281586117_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w981592v0mkQ7kNvwEYcKtN&_nc_oc=Adp9WUZ05B6i_2_J8t7B4iRfh0DRng3mkYcVjPhBzSzsJEoQATxaZwLK1JogU55TeD8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SXse9z8TnaklWllJi6x0h_vgMhKP_U8FE1UJg845gmA&oe=6A08725C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974670_6890311307696251_293647471797831381_n.png", "id": "1333625427353294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031441_1333625430686627_7601787466549361560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hio-fk1FJnMQ7kNvwFa7fp8&_nc_oc=AdoCCu9OQGzHjxvGoQSTVY-FjJ7NLiY-uvc54m9Db2WysHf2X62jJAMK1J_gPxLUCB4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yXnl8HCSPoXdI7iT2Kf77dcNYIAR3h_lhdg1Yt1vXMw&oe=6A0874B5"}, "display_name": "Roadside", "keywords": [], "long_description": "Roadside is a game where you can explore, create, and do so much more! In Roadside, you can create and run your own in-game store/business and have other players come to purchase in-game products from you! Or do one of the ingame jobs to stay easy. You can explore the large and expanding map! You can find and customize places to your liking! Be careful for the ingame criminals trying to get quick but risky items or just trying to cause havoc! Or join the in-game law enforcement and help keep the criminals in check and keep Roadside safe from ingame criminals! Don't forget about the nonplayer buildings, some of those can be pretty cool. Explore both the player and non-player-based parts of the game and most importantly we want you to have fun! The best thing is the game is free and multiplayer!", "short_description": "Start your own in-game store/business and sell to other players! Join the in-game law enforcement and stop crime, or cause in-game crime and havoc but don't get caught! In this game, you get to experience both player and NPC parts of the world!"}]}, "developer_name": "Lifeworks Ente
74570_917658050233504_1091060620281586117_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f87_nc9_3WMQ7kNvwE-DnaM&_nc_oc=AdqZM6W-AJ0cvbNkhPOOc8XTs0Z_PZ32qRr6NOXTCq4wkeUx0jbUwuQA9UbGO3tS_ro&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_0ubD5hk76ZfXn8VHDmLknxVSqwo0BZPGwt_OG5Kedg&oe=6A85B0DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974670_6890311307696251_293647471797831381_n.png", "id": "1333625427353294", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031441_1333625430686627_7601787466549361560_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPOEASLTJlQQ7kNvwHWYsSh&_nc_oc=AdqLnssmazQWSLdTO92gm5Uyf9wjk_Gn812jaNIy-kkddP1_L4stBrbh6VupeXXercs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFsGy1hXHlsEgknZu_Qai-i25SSk-MGcsSJGd1Y7tgTg&oe=6A857AF5"}, "display_name": "Roadside", "keywords": [], "long_description": "Roadside is a game where you can explore, create, and do so much more! In Roadside, you can create and run your own in-game store/business and have other players come to purchase in-game products from you! Or do one of the ingame jobs to stay easy. You can explore the large and expanding map! You can find and customize places to your liking! Be careful for the ingame criminals trying to get quick but risky items or just trying to cause havoc! Or join the in-game law enforcement and help keep the criminals in check and keep Roadside safe from ingame criminals! Don't forget about the nonplayer buildings, some of those can be pretty cool. Explore both the player and non-player-based parts of the game and most importantly we want you to have fun! The best thing is the game is free and multiplayer!", "short_description": "Start your own in-game store/business and sell to other players! Join the in-game law enforcement and stop crime, or cause in-game crime and havoc but don't get caught! In this game, you get to experience both player and NPC parts of the world!"}]}, "developer
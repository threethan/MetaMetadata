nt-sea5-1.oculuscdn.com/v/t64.5771-25/499308204_2080918092475936_6995035616191633730_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8-lEn6Eq1UQ7kNvwGk4dcU&_nc_oc=AdoSoab7RuhQl_3H1v9N7mjvIlPga9sEm11GL53sUyi1VW9kh6C4plVXLKL9N4PbEP4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpETejVrGlyQWA0Hn9Pj9Id70VzvaWfQy5SqfjmFTO2g&oe=6AE21FBC"}, {"file_name": "image 7 (1).png", "id": "2712295299151209", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301053_2712295302484542_4788466614888441906_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xqUmkdoUc4Q7kNvwHkFPl6&_nc_oc=AdodfZC_US_FeFI4LGsNsG_cVvsuBUK3ffYFk6t20jtncIrY70P6lD5kGob2vCxIszU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNMATT3xDH4IRKdo836u46lmp6cghegBXX7bIFSlrW0w&oe=6AE1F731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 18 (2).png", "id": "869165779468342", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303679_869165782801675_2482481544807730589_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uznpj3Wj35sQ7kNvwHJi_lA&_nc_oc=AdrQTHohBHO6yaH_4i9XN7zDVl9-mgsjjCf0BK61yGTFN1CsNFO5xpN4l2ZLRQr4cfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ0pI4MKRgxsk2_SJ8UGywj2JVFCa0MEgMMzu9hsKWBA&oe=6AE21168"}, "display_name": "Roadside", "keywords": ["Free", "Multiplayer", "OpenWorld", "side", "road"], "long_description": "Roadside is a game where you can explore, create, and do so much more! In Roadside, you can create and run your own in-game store/business and have other players come to purchase in-game products from you! Or do one of the ingame jobs to stay easy. You can explore the large and expanding map! You can find and customize places to your liking! Be careful for the ingame criminals trying to get quick but risky items or just trying to cause havoc! Explore the entire open world map all multiplayer with your friends! And best of all it's free to play! With tons of fun expierences to be had, just have fun!", "short_description": "Start your own in-game store/business and sell to other players! Cause in-game crime and havoc but don't get caught! In this game, you get to experience a MASSIVE open world to explore!"}]}, "developer_name": "Lifeworks Entertainment, LLC", "developer_privacy_policy_url": "https://www.lifeworksent.com/roadsideprivacynotice", "developer_terms_of_service_url": null, "publisher_name": "Lifeworks Entertainment, LLC", "support_website_url": "https://www.lifeworksent.com/contact-us", "website_url": "https://www.lifeworksent.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27378913151704796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821178_1442337270280299_982816653654785892_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQw97ygGq5YQ7kNvwGGGV97&_nc_oc=Adoiq14jHXsD8w-ycJCfTag487Pm1ba5XHGuTy1pmxYF2Fzzow8awVGHKTLJc-K8OFU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYrGF_3hdqwiV5U2DFPSBNCLrkpnNdWkXUwxtJfRWyBQ&oe=6AE208B1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Roadside", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "World Creation", "id": "1725996564472128"}], "release
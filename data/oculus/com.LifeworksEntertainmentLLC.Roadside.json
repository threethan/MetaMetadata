-VdZwt5UhmU6WmMdjJLLpKCtkkDP4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXHfuZXVwhakEemThiHsiGf1BP44l_BMhbA3kcXxpdGCg&oe=6B103EC2"}, {"file_name": "image 6.png", "id": "2080918089142603", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308204_2080918092475936_6995035616191633730_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxnhI3E7qxYQ7kNvwFx4BTM&_nc_oc=AdqlLb0HbLaqcmYXdml8YikenLRlE7jb1bPG308FwkBGreSHSxx0NATGv1DwhSXGZJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVpN_S8hwgkipHWfTPGB6iITVNLgGZyirINc3RXk8E50g&oe=6B10443C"}, {"file_name": "image 7 (1).png", "id": "2712295299151209", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301053_2712295302484542_4788466614888441906_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D74oZzbs9o8Q7kNvwHX9TLt&_nc_oc=AdqjV6Sg_Vkp8TN5KT2BQeXb5WFrUlCh86HM0NSxI7uth7Q7JDjNub-XYPs4czbmp8A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXF8lNSlkushYQJOi1V3NdtdYx-MZHDq5vmSH2LLGzp2Q&oe=6B1053F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 18 (2).png", "id": "869165779468342", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303679_869165782801675_2482481544807730589_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucD5LnELYGEQ7kNvwEAdnBn&_nc_oc=AdoQZ1O_hpGiZJPZy4mFVMYMJyFhNaSzbO5JeLYY3ZLUOmJoGLCJjWcfScJnW-y6g6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX5QsK6jvmkyWLbDdJWsASmzyGATtEhacQ-ZWbJy-1Ucg&oe=6B1035E8"}, "display_name": "Roadside", "keywords": ["Free", "Multiplayer", "OpenWorld", "side", "road"], "long_description": "Roadside is a game where you can explore, create, and do so much more! In Roadside, you can create and run your own in-game store/business and have other players come to purchase in-game products from you! Or do one of the ingame jobs to stay easy. You can explore the large and expanding map! You can find and customize places to your liking! Be careful for the ingame criminals trying to get quick but risky items or just trying to cause havoc! Explore the entire open world map all multiplayer with your friends! And best of all it's free to play! With tons of fun expierences to be had, just have fun!", "short_description": "Start your own in-game store/business and sell to other players! Cause in-game crime and havoc but don't get caught! In this game, you get to experience a MASSIVE open world to explore!"}]}, "developer_name": "Lifeworks Entertainment, LLC", "developer_privacy_policy_url": "https://www.lifeworksent.com/roadsideprivacynotice", "developer_terms_of_service_url": null, "publisher_name": "Lifeworks Entertainment, LLC", "support_website_url": "https://www.lifeworksent.com/contact-us", "website_url": "https://www.lifeworksent.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27378913151704796"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821178_1442337270280299_982816653654785892_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bs2RHoFRbnwQ7kNvwF1hMKM&_nc_oc=Adr1R9ndF4BCG6Qb73_pmEtrpPFCVo5k6rrSqx1fDehtEUHSOufUyphEkB4MT1R7JOk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZeG9RVw8A5i_
EE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID9bdvcfaRR0L7AKotw0tOWgz2V8kq-mWuKMXq-UcSaw&oe=6AA16619"}, {"file_name": "screenshot-5.png", "id": "2473382706503184", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_2473382709836517_1947850311282647681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sja_j8J2umsQ7kNvwFPzMz4&_nc_oc=AdqQbduNgUXC6IblEF2bUx5UUX9fIKHnfYtraSCCV9pI6GqFiiQHgiBeg_K1IDobs6M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-Hy6zSlvCrv_L2LrB211HwJkHqi-hv0ZFUeiHPXjPPw&oe=6AA1599B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PasteToPlay: 180/360 VR Video Player", "keywords": ["VR180", "DLNA", "SBS", "videoplayer", "autodetect"], "long_description": "PasteToPlay is a VR video player built around one idea: **paste a URL, press\nplay, and the app figures out the rest.**\n\n**Auto format detection**\n\nPlayback starts immediately while the app reads the actual video frames and\ndetects the projection \u2014 no filename conventions needed:\n- **View:** flat / 180\u00b0 / 360\u00b0\n- **Stereo:** mono / side-by-side / top-bottom\n- **Lens:** rectilinear / equirect / fisheye\n\nIf a detection is ever wrong, one tap on the dock corrects it instantly and\nlocks your choice for the session.\n\n**Two ways to play**\n\n- **Direct links** \u2014 paste any video URL from the Quest clipboard. The app\n  connects straight to the source: no companion app, no server, no account.\n- **DLNA** \u2014 browse and play from media servers on your local network, with\n  cover-art grid browsing.\n\n**Playback**\n\nNative ExoPlayer decoding: MP4, HLS, DASH and SmoothStreaming adaptive\nstreams, with an automatic fallback that keeps the session alive.\n\n**Privacy**\n\nNo accounts, no analytics, no crash reporting. The only stored data is your\non-device link history \u2014 clear it in-app anytime.\n\n**Scope**\n\nA personal project, actively developed. PasteToPlay plays media you provide \u2014\nyour cloud-drive direct links and your own DLNA servers. It includes no\ncontent catalog.\n\n**Planned**\n\nSubtitles (SRT/ASS) \u00b7 resume playback \u00b7 SMB/WebDAV shares\n", "short_description": "Paste a video link and it just plays. PasteToPlay reads the actual video\nframes and auto-detects the projection \u2014 flat, VR180, 360, side-by-side,\ntop-bottom, even dual-fisheye \u2014 and one tap corrects it if a guess is ever\nwrong. Streams MP4/HLS/DASH direct links and browses DLNA servers on your local network. No account, no analytics, no catalog: it plays your own media."}]}, "developer_name": "CheerChen", "developer_privacy_policy_url": "https://cheerchen.github.io/pastetoplay/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CheerChen", "support_website_url": "https://github.com/CheerChen/pastetoplay/issues", "website_url": "https://cheerchen.github.io/pastetoplay/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1256669307533259"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554013426204157"}]}, "baseline_offer": {"id": "1554013426204157"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788393060, "status": "PUBLISHED", "id": "1554013426204157"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename"
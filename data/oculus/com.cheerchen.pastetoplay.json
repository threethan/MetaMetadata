/v/t64.5771-25/499628108_1888880559184857_7095700230642049960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7hiu0ED9JUQ7kNvwEZJw77&_nc_oc=Adr8kw-2zQomZt7VMoStwu2NKKgFYHCUTm11jX0ac5s_XOslEFFUoJqMIL_ARV2PB0k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1gKoMEvNMjEdj134TLMc3_WUphjCjCdp0hY_w2mTEcw&oe=6AA2B031"}, {"file_name": "screenshot-2.png", "id": "1027653830039962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593919959_1027653833373295_7331662864302707778_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vT8VlPRMu9cQ7kNvwFVQexN&_nc_oc=Adp5-3xyEJDb9rmHFzX1YPospGrGujg3tA4CLqdG91OEJpHy9sw6-num-pGmX3S31dU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcMLwLvrxB_z2ubm8mB_PMssE641hhAEaS5rLEqS090Q&oe=6AA2CEBD"}, {"file_name": "screenshot-3.png", "id": "1045150038508372", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626172_1045150041841705_6791071861128121272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HOHGKrbiscgQ7kNvwEgix7O&_nc_oc=AdrlcYHs3ogqkEHar2SA0Uj7uLTiOY1JPKaOj72__mv-oMkqS--w1o39e5KRu2DiPsY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjqRl9Tv7NmIOfI2hi5I76QtyDxGNOeaQ3qvQSU7S7Bw&oe=6AA2C01D"}, {"file_name": "screenshot-4.png", "id": "1540678080512568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298137_1540678083845901_7023925869269734961_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RI5ByUIoBwQ7kNvwHkwliQ&_nc_oc=Ado7mBL7JJyhKBhIIfRmNOGGaI7yalIZHuL5bW4HrWcqzCX9fn93jZGvU_m7zkpsX4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLggPnjXxE4gV_d7iL3_noQH3yhhsseWk7TogJU42SoSA&oe=6AA2B799"}, {"file_name": "screenshot-5.png", "id": "2473382706503184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2473382709836517_1947850311282647681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sja_j8J2umsQ7kNvwE5ZubJ&_nc_oc=Adq70clwctBy7Raud5H3QH9clDl0sQA9BVPqmuFTlwMQurgkZ_qidngR9KZeH3EJVwM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8LLo37a3OFFvsLAbQ_ChuXKOfRpo1_UJEeU0JN9bAkA&oe=6AA2AB1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PasteToPlay: 180/360 VR Video Player", "keywords": ["VR180", "DLNA", "SBS", "videoplayer", "autodetect"], "long_description": "PasteToPlay is a VR video player built around one idea: **paste a URL, press\nplay, and the app figures out the rest.**\n\n**Auto format detection**\n\nPlayback starts immediately while the app reads the actual video frames and\ndetects the projection \u2014 no filename conventions needed:\n- **View:** flat / 180\u00b0 / 360\u00b0\n- **Stereo:** mono / side-by-side / top-bottom\n- **Lens:** rectilinear / equirect / fisheye\n\nIf a detection is ever wrong, one tap on the dock corrects it instantly and\nlocks your choice for the session.\n\n**Two ways to play**\n\n- **Direct links** \u2014 paste any video URL from the Quest clipboard. The app\n  connects straight to the source: no companion app, no server, no account.\n- **DLNA** \u2014 browse and play from media servers on your local network, with\n  cover-art grid browsing.\n\n**Playback**\n\nNative ExoPlayer decoding: MP4, HLS, DASH and SmoothStreaming adaptive\nstreams, with an automatic fallback that keeps the session alive.\n\n**Privacy**\n\nNo accounts, no analytics, no crash reporting. The only stored data is your\non-device link history \u2014 clear it in-app anytime.\n\n**Scope**\n\nA personal project, actively developed. PasteToPlay plays media you provide \u2014\nyour cloud-drive direct links and your own DLNA servers. It includes no\ncontent catalog.\n\n**Planned**\n\nSubtitles (SRT/ASS) \u00b7 resume playback \u00b7 SMB/WebDAV shares\n", "short_description": "Paste a video link and it just plays. PasteToPlay reads the actual video\nframes and auto-detects the projection \u2014 flat, VR180, 360, side-by-side,\ntop-bottom, even dual-fisheye \u2014 and one tap corrects it if a guess is ever\nwrong. Streams MP4/HLS/DASH direct links and browses DLNA servers on your local network. No account, no analytics, no catalog: it plays your own media."}]}, "developer_name": "CheerChen", "developer_privacy_policy_url": "https://cheerchen.github.io/pastetoplay/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CheerChen", "support_website_url": "https://github.com/CheerChen/pastetoplay/issues", "website_url": "https://cheerchen.github.io/pastetoplay/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1256669307533259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626728_1047973774637745_5835376351914541004_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY0TMQqgw00Q7kNvwFqTPG9&_nc_oc=AdrkEphJMJuFpxwpw6ww620m0FNrhhzYsZIVykWa4XAcd3EnebGcXzV0wvlDCxkJ_ng&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvkZiIH75epioXIrTaYO1Bpb-C4QDS3fASl-Rawi-IZg&oe=6AA2BB78"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PasteToPlay: 180/360 VR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1788393060, "lastRevision": {"nodes":
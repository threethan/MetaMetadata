/v/t64.5771-25/499628108_1888880559184857_7095700230642049960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z4FUeVFuUwQ7kNvwGtl8s0&_nc_oc=AdpXBy5uOEMamms9nmIvmVznr9uJ9O_IsBm53SGHRg1nP3kL0trWuAzEn9zXKUtxO2A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKQHN2zqKRj7Hg7ub4H6DPbvjGvSR5MOJ1QxweBZQW5Q&oe=6A9EBBB1"}, {"file_name": "screenshot-2.png", "id": "1027653830039962", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593919959_1027653833373295_7331662864302707778_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=646T97BQztkQ7kNvwF1aaNJ&_nc_oc=Adov2tBzMHo2epvXNhgg50YNw6RA3_ZzXV21KxZAbM-0kgvzJBw5R4nLYixNC1NNDYg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7HsYUvoIAe2xXygJfl37niDU4Up3A6UCl09KPYYI53g&oe=6A9EDA3D"}, {"file_name": "screenshot-3.png", "id": "1045150038508372", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626172_1045150041841705_6791071861128121272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG73mqLjvW8Q7kNvwHM3QN5&_nc_oc=AdqvbbsssdVgxOJLHodNhFymgSwITRoZsQCeFD79NgZiA7LzabZPRFJOd76HMMFpYbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJc3J8flML4HJfKe6HeL7X1lPT3BMyDwzzUdAO7OmuNGA&oe=6A9ECB9D"}, {"file_name": "screenshot-4.png", "id": "1540678080512568", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298137_1540678083845901_7023925869269734961_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkN4N_sfcEUQ7kNvwFOIkne&_nc_oc=Adqxb9GgudwmsK5WJmAKG2TYk73-Mjs3_0vwEv1qFnxGkjeNAe4Q7AnC13TYhr32e4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSExdSGY9c1liwZ49_2DYHyn24XTuvLI6I_nkX-dFJ0Q&oe=6A9EC319"}, {"file_name": "screenshot-5.png", "id": "2473382706503184", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619672_2473382709836517_1947850311282647681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sja_j8J2umsQ7kNvwH9DjRs&_nc_oc=Adp53LdlTQUp1YadlWgaPS5-aLIQK1tM725kCUCJCQVoTlAwBvupx1Al8PFz7F2Ujzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_UaHFyV9ozZWYmqLwkFHv8-0Y7OEMg6RJXiD2Mh_yTw&oe=6A9EB69B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PasteToPlay: 180/360 VR Video Player", "keywords": ["VR180", "DLNA", "SBS", "videoplayer", "autodetect"], "long_description": "PasteToPlay is a VR video player built around one idea: **paste a URL, press\nplay, and the app figures out the rest.**\n\n**Auto format detection**\n\nPlayback starts immediately while the app reads the actual video frames and\ndetects the projection \u2014 no filename conventions needed:\n- **View:** flat / 180\u00b0 / 360\u00b0\n- **Stereo:** mono / side-by-side / top-bottom\n- **Lens:** rectilinear / equirect / fisheye\n\nIf a detection is ever wrong, one tap on the dock corrects it instantly and\nlocks your choice for the session.\n\n**Two ways to play**\n\n- **Direct links** \u2014 paste any video URL from the Quest clipboard. The app\n  connects straight to the source: no companion app, no server, no account.\n- **DLNA** \u2014 browse and play from media servers on your local network, with\n  cover-art grid browsing.\n\n**Playback**\n\nNative ExoPlayer decoding: MP4, HLS, DASH and SmoothStreaming adaptive\nstreams, with an automatic fallback that keeps the session alive.\n\n**Privacy**\n\nNo accounts, no analytics, no crash reporting. The only stored data is your\non-device link history \u2014 clear it in-app anytime.\n\n**Scope**\n\nA personal project, actively developed. PasteToPlay plays media you provide \u2014\nyour cloud-drive direct links and your own DLNA servers. It includes no\ncontent catalog.\n\n**Planned**\n\nSubtitles (SRT/ASS) \u00b7 resume playback \u00b7 SMB/WebDAV shares\n", "short_description": "Paste a video link and it just plays. PasteToPlay reads the actual video\nframes and auto-detects the projection \u2014 flat, VR180, 360, side-by-side,\ntop-bottom, even dual-fisheye \u2014 and one tap corrects it if a guess is ever\nwrong. Streams MP4/HLS/DASH direct links and browses DLNA servers on your local network. No account, no analytics, no catalog: it plays your own media."}]}, "developer_name": "CheerChen", "developer_privacy_policy_url": "https://cheerchen.github.io/pastetoplay/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CheerChen", "support_website_url": "https://github.com/CheerChen/pastetoplay/issues", "website_url": "https://cheerchen.github.io/pastetoplay/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1256669307533259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626728_1047973774637745_5835376351914541004_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFpge1dfOesQ7kNvwHPkQrV&_nc_oc=AdoNZhL4k4oa3BFETv6hse2-7OG_nXdWqZd_mjoQb97OrJi69KNPFAWGEpHtIanNhx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuTuFerr9DFQVI2YHd3TWa-cCdrCB73vSHiQZOfVjtAw&oe=6A9EC6F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PasteToPlay: 180/360 VR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1788393060, "lastRevision": {"nodes":
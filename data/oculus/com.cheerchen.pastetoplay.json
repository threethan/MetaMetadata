/v/t64.5771-25/499628108_1888880559184857_7095700230642049960_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z4FUeVFuUwQ7kNvwH3TOjc&_nc_oc=AdqSN4QqEwDqxVQkZ-yA007j4_DN9PqHp_xK6ks3rRXXBdACOmHfVU3BtjL-HLm3sos&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBwsF61AyvZDYjLww4YS6kQ5c327vVgHKZQWCnzVOzeg&oe=6AA00D31"}, {"file_name": "screenshot-2.png", "id": "1027653830039962", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593919959_1027653833373295_7331662864302707778_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=646T97BQztkQ7kNvwFWerCL&_nc_oc=AdpQofGiskl7rH-sTZ7cxv_yO8W8UoGHAmm-6jvT12e2m6Ibuyc748XHKPURjY-F-IM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1gmUDPnIJ27RLqZFSfzNx1PI9RqCoAxzlB5c_kiJctA&oe=6AA02BBD"}, {"file_name": "screenshot-3.png", "id": "1045150038508372", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499626172_1045150041841705_6791071861128121272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EG73mqLjvW8Q7kNvwGEhjp0&_nc_oc=AdrWfF8dOlnthqCvrYjOfIVtEbzwteUJbkTaTaocZHIM1ZK1sLZsZtaRYbRdbXPCdu0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK44qV5dFcdyRZiULkHNeIZJC0ez7hlUWRbnQkz420ijg&oe=6AA01D1D"}, {"file_name": "screenshot-4.png", "id": "1540678080512568", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298137_1540678083845901_7023925869269734961_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RI5ByUIoBwQ7kNvwF7upoz&_nc_oc=Adqt7hNYfCXTeYExEnA53_F-ZgMeJzvfOKWiYrTFOKpT8QXbDcIqRUH12lt3dYe6VWY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtmHO_SCqr3lSv8CiwbJsvk_bSdIL9tDX680D9jxPnUQ&oe=6AA01499"}, {"file_name": "screenshot-5.png", "id": "2473382706503184", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_2473382709836517_1947850311282647681_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sja_j8J2umsQ7kNvwFQNyWV&_nc_oc=Adpt1W3kjmrlnfTND6BxCRs9BVIkUcSVKPAN1p8wI0YpMpsgD18GQdbfrqQKIX32KQg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-e-JtE-SjmRjpNhugFc7F9HvQ9gnm9101xOPltg5YZw&oe=6AA0081B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PasteToPlay: 180/360 VR Video Player", "keywords": ["VR180", "DLNA", "SBS", "videoplayer", "autodetect"], "long_description": "PasteToPlay is a VR video player built around one idea: **paste a URL, press\nplay, and the app figures out the rest.**\n\n**Auto format detection**\n\nPlayback starts immediately while the app reads the actual video frames and\ndetects the projection \u2014 no filename conventions needed:\n- **View:** flat / 180\u00b0 / 360\u00b0\n- **Stereo:** mono / side-by-side / top-bottom\n- **Lens:** rectilinear / equirect / fisheye\n\nIf a detection is ever wrong, one tap on the dock corrects it instantly and\nlocks your choice for the session.\n\n**Two ways to play**\n\n- **Direct links** \u2014 paste any video URL from the Quest clipboard. The app\n  connects straight to the source: no companion app, no server, no account.\n- **DLNA** \u2014 browse and play from media servers on your local network, with\n  cover-art grid browsing.\n\n**Playback**\n\nNative ExoPlayer decoding: MP4, HLS, DASH and SmoothStreaming adaptive\nstreams, with an automatic fallback that keeps the session alive.\n\n**Privacy**\n\nNo accounts, no analytics, no crash reporting. The only stored data is your\non-device link history \u2014 clear it in-app anytime.\n\n**Scope**\n\nA personal project, actively developed. PasteToPlay plays media you provide \u2014\nyour cloud-drive direct links and your own DLNA servers. It includes no\ncontent catalog.\n\n**Planned**\n\nSubtitles (SRT/ASS) \u00b7 resume playback \u00b7 SMB/WebDAV shares\n", "short_description": "Paste a video link and it just plays. PasteToPlay reads the actual video\nframes and auto-detects the projection \u2014 flat, VR180, 360, side-by-side,\ntop-bottom, even dual-fisheye \u2014 and one tap corrects it if a guess is ever\nwrong. Streams MP4/HLS/DASH direct links and browses DLNA servers on your local network. No account, no analytics, no catalog: it plays your own media."}]}, "developer_name": "CheerChen", "developer_privacy_policy_url": "https://cheerchen.github.io/pastetoplay/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CheerChen", "support_website_url": "https://github.com/CheerChen/pastetoplay/issues", "website_url": "https://cheerchen.github.io/pastetoplay/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1256669307533259"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499626728_1047973774637745_5835376351914541004_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY0TMQqgw00Q7kNvwEVPZgT&_nc_oc=AdpLEMVkZsIgqrSJLDgCEQBS56Df-tQf4OIyOPUPh4HFexumA1tI4A-buMOWp4UpG84&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1SpDMnAJ0cRqDjNKYSJYfwg8ZX4ANruvH07eQBHyBaA&oe=6AA01878"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PasteToPlay: 180/360 VR Video Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1788393060, "lastRevision": {"nodes":
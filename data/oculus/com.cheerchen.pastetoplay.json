20f&oh=00_AQQyU8gsdWeJKDtKjZmn6mpHXAJ9ifJ2NQB3eDxJeyewaw&oe=6AFB21EA"}, {"file_name": "cover-landscape-2560x1440.png", "id": "839445745824737", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619685_839445749158070_207091035790949544_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1IgHgxY42AQ7kNvwFl0-Jq&_nc_oc=Adq54_4UnbOJGMxf4SGu5vsMogcFIMwyFnD0ex3rw-CAc07AvVjZEqXx9cw_xcKdb9w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV8DVe11MQZfhsVlGiszSVmazP8azbY5UqorvR3LvEfQ&oe=6AFB3C5A"}]}, "id": "1484577943004292", "locale": "en_US", "screenshots": [{"file_name": "screenshot-1.png", "id": "1888880552518191", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499628108_1888880559184857_7095700230642049960_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wqB4DBXCCsQ7kNvwGUGZol&_nc_oc=Adp6raRo-cTSmSHFSue_yYetHnN9-XnTxT2Hk-nKKAJKkCpg22ahV4z-KxQh78oCmHE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr0T-k0x1a6w7Zt6ZiTPcMb85tbv8MUWZKSAf1t6SvsQ&oe=6AFB3CF1"}, {"file_name": "screenshot-2.png", "id": "1027653830039962", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593919959_1027653833373295_7331662864302707778_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwhDhnvk4lUQ7kNvwHuoGKo&_nc_oc=AdrBqkU7YL64j2Qgj0zETwYcdoN23T0MIKjnG8ZcRCBmvX_7Lfm4gly2LWw4Vs94nbw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPyMTEjhTB7baKmn59QfdhG1s2mzs0O3kndilygJXt8w&oe=6AFB233D"}, {"file_name": "screenshot-3.png", "id": "1045150038508372", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499626172_1045150041841705_6791071861128121272_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1jq2Omzaou0Q7kNvwF3_zEd&_nc_oc=AdqQMciZgyoPx8PvZM4Qw8tAMejiiGeZx2BQwWFUNo_Mm7fOU6e5es5D6cOrsXz1-Ac&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvvqMM5zAJ5XWfXDsq5EvqZZ11WKiAzTt3gmgvjPQ06w&oe=6AFB4CDD"}, {"file_name": "screenshot-4.png", "id": "1540678080512568", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499298137_1540678083845901_7023925869269734961_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJSwvSw9ouoQ7kNvwE7i5N6&_nc_oc=Adq0p5q4NO6buo3Qeh9ZemGFaKlBVBZmafvfwfYPdy2knTbtHOmFeb5Cch4WsxDmhrQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7iWYS8OjIlFI-w1KTiVFaAJDMrDwLw7l6efxgbZYf8Q&oe=6AFB4459"}, {"file_name": "screenshot-5.png", "id": "2473382706503184", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619672_2473382709836517_1947850311282647681_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLwkAIJCclAQ7kNvwGLGUlE&_nc_oc=AdpLboezv0g8a-3ce84lfosOF0Ku8_J-6OqS-hSMLnW32jKEYQuQM0ABldIMevVclr4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmYOy-Xyk7pWWPnHWvMPCZ4vtOhKtb3LsX1DXzjmzgHg&oe=6AFB37DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PasteToPlay: 180/360 VR Video Player", "keywords": ["VR180", "DLNA", "SBS", "videoplayer", "autodetect"], "long_description": "PasteToPlay is a VR video player built around one idea: **paste a URL, press\nplay, and the app figures out the rest.**\n\n**Auto format detection**\n\nPlayback starts immediately while the app reads the actual video frames and\ndetects the projection \u2014 no filename conventions needed:\n- **View:** flat / 180\u00b0 / 360\u00b0\n- **Stereo:** mono / side-by-side / top-bottom\n- **Lens:** rectilinear / equirect / fisheye\n\nIf a detection is ever wrong, one tap on the dock corrects it instantly and\nlocks your choice for the session.\n\n**Two ways to play**\n\n- **Direct links** \u2014 paste any video URL from the Quest clipboard. The app\n  connects straight to the source: no companion app, no server, no account.\n- **DLNA** \u2014 browse and play from media servers on your local network, with\n  cover-art grid browsing.\n\n**Playback**\n\nNative ExoPlayer decoding: MP4, HLS, DASH and SmoothStreaming adaptive\nstreams, with an automatic fallback that keeps the session alive.\n\n**Privacy**\n\nNo accounts, no analytics, no crash reporting. The only stored data is your\non-device link history \u2014 clear it in-app anytime.\n\n**Scope**\n\nA personal project, actively developed. PasteToPlay plays media you provide \u2014\nyour cloud-drive direct links and your own DLNA servers. It includes no\ncontent catalog.\n\n**Planned**\n\nSubtitles (SRT/ASS) \u00b7 resume playback \u00b7 SMB/WebDAV shares\n", "short_description": "Paste a video link and it just plays. PasteToPlay reads the actual video\nframes and auto-detects the projection \u2014 flat, VR180, 360, side-by-side,\ntop-bottom, even dual-fisheye \u2014 and one tap corrects it if a guess is ever\nwrong. Streams MP4/HLS/DASH direct links and browses DLNA servers on your local network. No account, no analytics, no catalog: it plays your own media."}]}, "developer_name": "CheerChen", "developer_privacy_policy_url": "https://cheerchen.github.io/pastetoplay/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "CheerChen", "support_website_url": "https://github.com/CheerChen/pastetoplay/issues", "website_url": "https://cheerchen.github.io/pastetoplay/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1256669307533259"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1554013426204157"}]}, "baseline_offer": {"id": "1554013426204157"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1788393060, "status": "PUBLISHED", "id": "1554013426204157"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1402970279569827", "version": "1.2.2"}, "id": "2057274198494697", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1231909206675936", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1402970279569827"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2057274198494697"}]}, "change_log": "Smoother playback on a busy home network: the player now keeps up to a minute of video buffered instead of a few seconds, and a grey bar on the progress bar shows how much is loaded. Recent links have a new grid view with a cover for each video you watched. Clearing recent links now asks for confirmation.", "created_date": 1794319240, "id": "1402970279569827", "version": "1.2.2", "version_code": 10007, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1231909206675936", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1402970279569827"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2057274198494697"}]}, "change_log": "Videos you have watched before now open in the format you last used, and your\r\nmanual format choice is remembered per video. The app is now available in\r\nJapanese and Korean, keeps playing in 3DoF when the room is too dark for\r\npositional tracking, and no longer requires the system keyboard.", "created_date": 1790882906, "id": "1320344954499027", "version": "1.2.1", "version_code": 10006, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1231909206675936", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1402970279569827"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2057274198494697"}]}, "change_log": "\\\"DLNA folders now load up to 500 items, sort by name or date, and show loading\r\nprogress with a retry option if part of a folder fails to load. When playing\r\nfrom a DLNA folder, the new previous and next buttons move through the videos\r\nin that folder. The playback controls have been redesigned with a clearer\r\nprogress bar and new format icons.\\\"", "created_date": 1790422995, "id": "1306586119208244", "version": "1.2.0", "version_code": 10005, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1231909206675936", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1402970279569827"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2057274198494697"}]}, "change_log": "\"Fixed jagged edges in high-resolution VR videos and improved VR180 format recognition in close-up scenes.\\nAdded a video-format detection\r\n  indicator.\\nDLNA now remembers sorting and grid/list preferences, shows a retry option when a folder cannot be loaded, and fixes list highlighting\r\n  and edge clipping.\\nWhile browsing DLNA folders, the B button now goes back one level.\"", "created_date": 1789194527, "id": "1282342201632636", "version": "1.1.1", "version_code": 10004, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1231909206675936", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1402970279569827"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2057274198494697"}]}, "change_log": "\"- In-app URL keyboard: type or paste links without the system keyboard\\n\\n- Resume playback: pick up where you left off for direct links and DLNA\\n\\n- Traditional Chinese (zh-Hant) UI for Taiwan and Hong Kong users\\n\\n- Controller ray now hides with the playback dock\\n\\n- Stability fixes\"", "created_date": 1788561073, "id": "1269857309547792", "version": "1.1.0", "version_code": 10003, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
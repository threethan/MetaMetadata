fd5Ug96fDdsO4joxzImoUqS268M8afLBER79jL7Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQy-I7uHRGlilErz2wICCTxaqW_ZiSYwhaCrphhdnkZXQ&oe=6B0716AD"}, {"file_name": "sceenshot_basic_closeup.png", "id": "1821694675253498", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391785_1821694678586831_2094353334131241748_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7BXeVTM3fsQ7kNvwE84j5_&_nc_oc=AdpB7fnYUjYbvbO_ilcVc1mFuymgVW1ZExO3ehYnw-cqwOLzh5tmSsGgy7GCMC5hNsM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwZjOJGZQR_IlihcTtJkstLcAsIrhHxLQ2g6bu05MxeQ&oe=6B06F517"}, {"file_name": "screenshot_winter_far.png", "id": "841246664789644", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391780_841246668122977_3266000963836138597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWHlvWZdl2YQ7kNvwHD2Rw7&_nc_oc=AdosAWU2yFOSeMiqhvmds6VQV9OALxjzw5xUizq2GIjQR4c9bGSb-xhAWQXZQb89w1Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6feZq9m5GOIzG3OdpHH0iLMLJeVAcQXGihcLC57VXUw&oe=6B06FC26"}, {"file_name": "screenshot_side_winter.png", "id": "1354342655752018", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391773_1354342659085351_2568580280427656843_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2KOfTvzDB8Q7kNvwEgttSp&_nc_oc=AdrZmTf1qwXElOultyFXRQyfgwBCH_nztXUvuKSJTwi6XqxSvIWWxu9t0CpxCap-Fgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVrdqB_WxPVCnzGUOgb9oK7z7anPm8a-wLvlS7qUIvww&oe=6B071922"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_with_title.png", "id": "1582812743113245", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473397245_1582812749779911_8699269137288905481_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LuA2ywogcIQ7kNvwHNTFEj&_nc_oc=AdrQNndaJOqMTHVud6TxsPRJryF9cO95JeAcp3SlZCxBfhiqnS5SsUiuMIL2yW7SrpE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2G_aWPkH3NQOT9Jtu0Y-nC61GBA8PqHGu4GDw0ofEaA&oe=6B06F8AE"}, "display_name": "Steady the Drums!", "keywords": ["rhythm", "RTS", "medieval", "lowpoly"], "long_description": "In **Steady the Drums!** you play as a War Drummer tasked to lead the army to protect the city of Velaris from a onslaught of monsters.\n\n**Gameplay** is mixture of a **Tower-Defense** Real-time Strategy and a **Rhythm game**, where your goal is to play **Drum Patterns** corresponding to different strategic commands, like *Attack*, *Defend*, *Retreat*.\n\n{2999391823560903}\n\nIn the Latest Game update, we have added a lot of new additional content:\n\n- **New** **Winter Level**: Velaris has been enshrouded in a grip of icey winter, but the evil wizard Amaranth, has found a way to continuoue its siege. Protect Velaris against new Monsters.\n\n- **New Study Gamemode**: We have designed a new gamemode, where you can improve your rhytmic skill simple rhythmic tasks featuring varying Rhythmic Timings and Patterns.\n\n- **New Ability and Cavalry Unit**: added a special ability to spawn **Cannon Balls**, with which you can reign the monsters down with **Cannon Fire**\n\n**Story**\n\nYou are the blacksmith\u2019s son, living in the medieval town of **Velaris**.\nThe King of your land is in the east, forging important alliances. The malevolent sorcerer **Amaranth**, in all its cunning, has been waiting for Velaris to be left defenceless.\n\n\nThe army is in desperate need of a drummer, that would help lead the defense of the city. \n\n\nProtect your loved ones, find the key to victory, and lead your army, your friends, your **Velaris** to triumph!", "short_description": "In Steady the Drums! you play as a War Drummer tasked to lead the army to protect the city of Velaris from a onslaught of monsters.\n\nThe game works as a mixture of real-time strategy and rhythm game in which the player must beat the drums according to the command 
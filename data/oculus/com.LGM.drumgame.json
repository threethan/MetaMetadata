mjB7YTOn6BDe7QC_P2SPhq58OILOoJtOW6Jk6OMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2lyyVpmD__DrP8GgFkrvFjAld8wah6m1IZyo9wLm-Dw&oe=6B03222D"}, {"file_name": "sceenshot_basic_closeup.png", "id": "1821694675253498", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391785_1821694678586831_2094353334131241748_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVbmKZd_jAcQ7kNvwFHct6O&_nc_oc=AdpzputfOr1uLj58awurTI6YOxN13W5J5UHAVM4SMllneMH9N8hXIKHda62qDLs5AwE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3n5jaU_CNZ350zs3WJR0vvxHKwqz3LG9TM5hUudlWig&oe=6B030097"}, {"file_name": "screenshot_winter_far.png", "id": "841246664789644", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391780_841246668122977_3266000963836138597_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xX2wkaQwnYQ7kNvwG66QTB&_nc_oc=Adq2CMnMkx_zRX8ZyP-hiGaIGf4dNQOWy7DKB94XON7qXykkiokRdyZlZ9Y_L4nVf1g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJjFKRdpS86Pt-m61swA3-glTw6jDs5MOh_n7gNcBsKg&oe=6B0307A6"}, {"file_name": "screenshot_side_winter.png", "id": "1354342655752018", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391773_1354342659085351_2568580280427656843_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X2GYP8HGZUQ7kNvwFMHeZK&_nc_oc=AdrKuBeqnstesGmKGYIJX92AB5tYFFm3r8XL-WEAjL4ZDbl27MYIREKrnyJe-7tlykI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSl5m6teZJApgaxW9tjtk9SLcJmxDtXKN41VD7VbiANog&oe=6B0324A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_with_title.png", "id": "1582812743113245", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473397245_1582812749779911_8699269137288905481_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H5rdkNWASkEQ7kNvwGOdbHP&_nc_oc=AdpR-u-DkoLaVrHNGd1YR5WOj0G9TGSz8FHqIxtLVajzmFllTOPKZ1pHl_rqHsP4t6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1lwyfY4Wo6sMwL2SZkvnLV7rZaC-AcviaT_FMwkf66w&oe=6B03042E"}, "display_name": "Steady the Drums!", "keywords": ["rhythm", "RTS", "medieval", "lowpoly"], "long_description": "In **Steady the Drums!** you play as a War Drummer tasked to lead the army to protect the city of Velaris from a onslaught of monsters.\n\n**Gameplay** is mixture of a **Tower-Defense** Real-time Strategy and a **Rhythm game**, where your goal is to play **Drum Patterns** corresponding to different strategic commands, like *Attack*, *Defend*, *Retreat*.\n\n{2999391823560903}\n\nIn the Latest Game update, we have added a lot of new additional content:\n\n- **New** **Winter Level**: Velaris has been enshrouded in a grip of icey winter, but the evil wizard Amaranth, has found a way to continuoue its siege. Protect Velaris against new Monsters.\n\n- **New Study Gamemode**: We have designed a new gamemode, where you can improve your rhytmic skill simple rhythmic tasks featuring varying Rhythmic Timings and Patterns.\n\n- **New Ability and Cavalry Unit**: added a special ability to spawn **Cannon Balls**, with which you can reign the monsters down with **Cannon Fire**\n\n**Story**\n\nYou are the blacksmith\u2019s son, living in the medieval town of **Velaris**.\nThe King of your land is in the east, forging important alliances. The malevolent sorcerer **Amaranth**, in all its cunning, has been waiting for Velaris to be left defenceless.\n\n\nThe army is in desperate need of a drummer, that would help lead the defense of the city. \n\n\nProtect your loved ones, find the key to victory, and lead your army, your friends, your **Velaris** to triumph!", "short_description": "In Steady the Drums! you play as a War Drummer tasked to lead the army to protect the city of Velaris from a onslaught of monsters.\n\nThe game works as a mixture of real-time strategy and rhythm game in which the player must beat the drums according to the command he wishes to perform in the accompanying rhythm. \n\nGameplay is mixture of a Tower-Defense Real-time Strategy and a Rhythm game, where your goal is to play Drum Patterns corresponding to different strategic commands."}]}, "developer_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "developer_privacy_policy_url": "https://pages.flycricket.io/steady-the-drums/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Laboratory for Computer Graphics and Multimedia at FRI-UL", "support_website_url": null, "website_url": "http://lgm.fri.uni-lj.si/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "STRATEGY", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9643398229011682"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391807_1282503929691704_5586182503870529574_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7st_l-h6JVkQ7kNvwFcsrjS&_nc_oc=Ado-SFHWZLWj9lPxBPb6ymADemTfsyeKd-niLDrpdA7uQGzzbN01qvwx3JVuIi_QZIU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbdN4t_nxQ6U0WS4VO5rt5OgZ9a-Mo7SGXeOKT2NKcOA&oe=6B032BD6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Steady the Drums!", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "274332603592553
s2IQ7kNvwE4yhxL&_nc_oc=AdrHAs1y7R3uFrFFt9kkSuHtvs-Fldwv4EAXWKmcaTbr43r0HexXqpJ3zY9xjfVTi9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kGjTdvUYp7CukgTi2OLSOxKEsixayFtKKp_xDW3Ncmg&oe=6A3E7B05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "1714653025865142", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818860_1714653029198475_691150643460279243_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwZagPs6SEIQ7kNvwGzJPqZ&_nc_oc=AdpZ9vb-gKi556RF4qteCxV4r-kAB0aYQKzeKUN_0BanlHHUaUlCFDpsV1Wl-uixwE8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_e9MYsiZY4pHJa17plsYXGFzBupa0-VKHYoFnyTnvCOw&oe=6A3E7C67"}, "display_name": "Cluebox: Impossible Escape Room", "keywords": ["escape", "room", "horror", "puzzle", "brainteaser"], "long_description": "# AN (ALMOST) IMPOSSIBLE CHALLENGE\n\n Solve all the riddles around a wooden box, pull or push levers and buttons, rotate wheels, and, most of all, use your brain. \n\nThe box contains a remote to open the metal shutter and help you gain your freedom.\n\n{25491469020445502}\n\n# So,  can you escape?\n\nIf you will, there's another challenge waiting for you: **The Puzzle Room**, where you'll have to crack 40 weird riddles written on an old piece of sheet and type each solution on a rusty computer.\n\n{844163881482395}\n\nHave fun, and good luck!\n\n", "short_description": "Your only way out of the shadowy basement is locked inside a cryptic wooden box. You must crack a series of intricate puzzles to unlock the box and reclaim your freedom"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "conte
lcIQ7kNvwFwFkZ8&_nc_oc=AdpI2iFsewoA4nh_WiuE77SdWT9w_urrxW9yXqPZZt87PjKu73jrRWoME9mqM0K9jNk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnYS0M3ijVrnNy-MLkcWulILhU24W3K4s0ZAFpKpe6qQ&oe=6AA15B85"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "1714653025865142", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818860_1714653029198475_691150643460279243_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfCkEOibQgsQ7kNvwE5NeN9&_nc_oc=AdpQvDr3DGwQNqJ0XIH95x9M6yAwQ3KOoi6Hye3jea1Q_iFM7HPDJyOFYIhvJkGbakc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuh3bG8PeLkTBQ0CJDKH5YuqvmbamHetYE4bT5JAMVpA&oe=6AA15CE7"}, "display_name": "Cluebox: Impossible Escape Room", "keywords": ["escape", "room", "horror", "puzzle", "brainteaser"], "long_description": "# AN (ALMOST) IMPOSSIBLE CHALLENGE\n\n Solve all the riddles around a wooden box, pull or push levers and buttons, rotate wheels, and, most of all, use your brain. \n\nThe box contains a remote to open the metal shutter and help you gain your freedom.\n\n{25491469020445502}\n\n# So,  can you escape?\n\nIf you will, there's another challenge waiting for you: **The Puzzle Room**, where you'll have to crack 40 weird riddles written on an old piece of sheet and type each solution on a rusty computer.\n\n{844163881482395}\n\nHave fun, and good luck!\n\n", "short_description": "Your only way out of the shadowy basement is locked inside a cryptic wooden box. You must crack a series of intricate puzzles to unlock the box and reclaim your freedom"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "conte
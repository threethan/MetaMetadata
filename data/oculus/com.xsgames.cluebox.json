j4gQ7kNvwFY3Jnf&_nc_oc=AdobccQYDoD8CDgC81NnGlpYsaBP_f1dhXAi2737xDTLzz13zuzy-tcwySUvoMTh0oQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VHS-rYAc8RyN1HdQvLztCpG_YSMQ41lWo1VHkOG6UBQ&oe=6A202885"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "1714653025865142", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818860_1714653029198475_691150643460279243_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nycdJbQbVgYQ7kNvwF7ebmi&_nc_oc=AdqKjBo_QUqRE4kp409xBae6Aph-gaqg_-_DipknVa6rjKXdjYG2LEvNOeXP7fhNYKA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7m1wucpq6xJvHZOVI05kuOBgOVhf47mp5tdnn2eCi3Xw&oe=6A2029E7"}, "display_name": "Cluebox: Impossible Escape Room", "keywords": ["escape", "room", "horror", "puzzle", "brainteaser"], "long_description": "# AN (ALMOST) IMPOSSIBLE CHALLENGE\n\n Solve all the riddles around a wooden box, pull or push levers and buttons, rotate wheels, and, most of all, use your brain. \n\nThe box contains a remote to open the metal shutter and help you gain your freedom.\n\n{25491469020445502}\n\n# So,  can you escape?\n\nIf you will, there's another challenge waiting for you: **The Puzzle Room**, where you'll have to crack 40 weird riddles written on an old piece of sheet and type each solution on a rusty computer.\n\n{844163881482395}\n\nHave fun, and good luck!\n\n", "short_description": "Your only way out of the shadowy basement is locked inside a cryptic wooden box. You must crack a series of intricate puzzles to unlock the box and reclaim your freedom"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "conte
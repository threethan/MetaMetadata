6bQQ7kNvwGVYq8v&_nc_oc=AdoOeJ90eO1uueqarlI6h_Enu3NKHAoUauT6SSMz7wtj7f9KF6XcvRpDm6EKQ_1-YrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsYSZcZZ8SHq2BNbq2dNaYIooZMDgsPk50g_EedazUGw&oe=6A4BAA05"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover.png", "id": "1714653025865142", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_1714653029198475_691150643460279243_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebzGQFNYO08Q7kNvwH78Drk&_nc_oc=AdpqGqxTncI87jcXASQxj9BWd6RUbBgLof3qlNuGFJvR8jvlEcXnUlu_FSToC-a31qc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQOVttFrQjd459v2c7JJRg6rvLLzLZw9-8uh6udoF2DQ&oe=6A4BAB67"}, "display_name": "Cluebox: Impossible Escape Room", "keywords": ["escape", "room", "horror", "puzzle", "brainteaser"], "long_description": "# AN (ALMOST) IMPOSSIBLE CHALLENGE\n\n Solve all the riddles around a wooden box, pull or push levers and buttons, rotate wheels, and, most of all, use your brain. \n\nThe box contains a remote to open the metal shutter and help you gain your freedom.\n\n{25491469020445502}\n\n# So,  can you escape?\n\nIf you will, there's another challenge waiting for you: **The Puzzle Room**, where you'll have to crack 40 weird riddles written on an old piece of sheet and type each solution on a rusty computer.\n\n{844163881482395}\n\nHave fun, and good luck!\n\n", "short_description": "Your only way out of the shadowy basement is locked inside a cryptic wooden box. You must crack a series of intricate puzzles to unlock the box and reclaim your freedom"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "conte
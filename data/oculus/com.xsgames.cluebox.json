dom.\n\n{25491469020445502}\n\n# So,  can you escape?\n\nIf you will, there's another challenge waiting for you: **The Puzzle Room**, where you'll have to crack 40 weird riddles written on an old piece of sheet and type each solution on a rusty computer.\n\n{844163881482395}\n\nHave fun, and good luck!\n\n", "short_description": "Trapped in a basement, you must crack many puzzles to open a wooden box to get your freedom back"}]}, "developer_name": null, "developer_privacy_policy_url": "https://xsgames.co/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "XSGames", "support_website_url": null, "website_url": "https://xsgames.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24222685117406374"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "678998105266927"}]}, "baseline_offer": {"id": "678998105266927"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1762369560, "status": "PUBLISHED", "id": "678998105266927"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24327982640209954", "version": "1.1"}, "id": "2561003027607238", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinar
alization tool that can be used by furniture producers in their design-to-production workflow for the purpose of creating more efficient designs with less resource consumption. This has direct effects in the way designers and producers collaborate, in real-time feedback on small details of products that have not yet been built. The app strives to improve both quality and timing of a furniture object's production life.", "short_description": "Wellview VR Furniture Prototype is an advanced visualization tool that can be used by furniture producers in their  design-to-production workflow for the purpose of creating more efficient designs with less resource consumption."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meet.wellviewsolutions.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wellview Solutions", "support_website_url": null, "website_url": "https://wellviewsolutions.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "524383562613205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974871_5348813101837628_7178336892354301006_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SJ_sKKhReRgQ7kNvwFrZ7K9&_nc_oc=AdpMwXD5ECsf_Px81D7hm8PkMf6oLp7BNCzDh4txZVLUEkjl_uB34D38AZRqiN
h quality and timing of a furniture object's production life.", "short_description": "Wellview VR Furniture Prototype is an advanced visualization tool that can be used by furniture producers in their  design-to-production workflow for the purpose of creating more efficient designs with less resource consumption."}]}, "developer_name": null, "developer_privacy_policy_url": "https://meet.wellviewsolutions.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wellview Solutions", "support_website_url": null, "website_url": "https://wellviewsolutions.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "524383562613205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974871_5348813101837628_7178336892354301006_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSwxs4M6tX4Q7kNvwFraNTi&_nc_oc=AdloTPeLDwMTWpGOkcZ0jy5VxIPr3K4JDav9VF7xdpFtW-xughfYUdTI_6scpfmU-Ac&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzdM4a2OBCQvZtF0rPeZj17qUM4ZqVGE8DTaQWDHzUOXA&oe=69B7F955"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Furniture Prototype", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativ
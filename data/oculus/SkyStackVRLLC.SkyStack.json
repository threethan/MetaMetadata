ng?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-rPEPePt9UQ7kNvwHJz6dJ&_nc_oc=AdlP5ZUiGHHvW39e93nEg6bSiYwJGqjZSTombPPSB_Jjb2t1amj0rDVqaXsPXkt1O5I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzvRpsDtX1otJ4ppqnedl0slC7npTVHPuoazGBz2o_ZDw&oe=69BE7D4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SkyStack", "keywords": [], "long_description": "SkyStack is a stacking game that escalates as you gain more levels by clearing four-by-four slates, with better scores for more slates cleared with a single block. Grab blocks at either wrists and place them on the gameboard, just before the timer runs out or else it becomes garbage. Don't let the blocks break the ceiling, or it's game over.\n\nWith four game modes and a level selector, you can stack at a relaxing yet intensifying pace, or start in a frenzied rush that tests your calm and mettle.", "short_description": "SkyStack is a stacking game that escalates as you gain more levels by clearing four-by-four slates, with better scores for more slates cleared with a single block. Grab blocks at either wrists and place them on the gameboard, just before the timer runs out or else it becomes garbage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skystackvr.blogspot.com/2023/12/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "SkyStack VR LLC", "support_website_url": null, "website_url": "https://skystackvr.blogspot.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
KWQMw66gAmKQHJL9qw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYOzelFkuE8j9kPSZkVOfyXIJhYCrWi0SUj6HpOgvfaQ&oe=69A2E156"}, {"file_name": "resized-screenshot4.png", "id": "1044474850021335", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575356_1044474853354668_6080111687495962093_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XYF5V_k9GMQ7kNvwH9SuU8&_nc_oc=Adke_2z9S3HgsoK2nUlKx_8SxbwWUTryko5MtERqbeBxOV7QBCKeQ__wGtH2tikbU-E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvC7tOshVOml6KDcNldKDW5SU4tARaIFPJT2lQz0QwhKw&oe=69A2E976"}, {"file_name": "resized-screenshot2.png", "id": "1371606680118768", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031356_1371606683452101_779640778477454705_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtbIm3ZDW_8Q7kNvwEsXpiy&_nc_oc=AdnFnVPkedpQWlCk5mthNg3GT4fYD8zEDIm7wLIOZevbo9F7OX1X05pswsQ67bibpz0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsdhvCccQpvLKa2CQh9wCzMEecsIRMI6ulDepB4sC0U_Q&oe=69A2CDCC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1113697799994243", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031584_1113697803327576_1985612176060167774_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eqyjNCKJHQgQ7kNvwHgfR7p&_nc_oc=Adkkk3qQ6tbYKrQnY6aXF-fbGADNS9nLrFa1ZW-4JCIqjI79MHGM_oKiM366hzxHvOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv8L7ZXaIROXvmYpsg4tE7k7xyqxU5hytKu2vNpG73bTw&oe=69A2E64F"}, "display_name": "SkyStack", "keywords": [], "long_description": "SkyStack is a stacking game that escalates as you gain more levels by clearing four-by-four slates, with better scores for more slates cleared with a single block. Grab blocks at either wrists and place them on the gameboard, just before the timer runs out or else it becomes garbage. Don't let the blocks break the ceiling, or it's game over.\n\nWith four game modes and a level selector, you can stack at a relaxing yet intensifying pace, or start in a frenzied rush that tests your calm and mettle.", "short_description": "SkyStack is a stacking game that escalates as you gain more levels by clearing four-by-four slates, with better scores for more slates cleared with a single block. Grab blocks at either wrists and place them on the gameboard, just before the timer runs out or else it becomes garbage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skystackvr.blogspot.com/2023/12/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "SkyStack VR LLC", "support_website_url": null, "website_url": "https://skystackvr.blogspot.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7110802265652585"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031479_873761157542486_1101738390553393204_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwqjI8JIzEQQ7kNvwE3fuaM&_nc_oc=AdlmzX80ZbCL7mVJsYrzipgNA3EmM_EPcQUNJeP62NptD3DA344nBSoi1gJH_u5c5Z8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft7pGmMEP4cCMRRloy0gtiicht4qc7GregT6_a5ktyGgA&oe=69A2D689"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkyStack", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context
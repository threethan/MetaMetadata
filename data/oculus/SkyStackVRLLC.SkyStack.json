enzied rush that tests your calm and mettle.", "short_description": "SkyStack is a stacking game that escalates as you gain more levels by clearing four-by-four slates, with better scores for more slates cleared with a single block. Grab blocks at either wrists and place them on the gameboard, just before the timer runs out or else it becomes garbage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skystackvr.blogspot.com/2023/12/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "SkyStack VR LLC", "support_website_url": null, "website_url": "https://skystackvr.blogspot.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7110802265652585"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031479_873761157542486_1101738390553393204_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEvsGhHdffcQ7kNvwE0h4Se&_nc_oc=AdkGaUNBAB3qlkDy106wlyL9-MdaMEY8RyceKIU4vaAIbJGivcfcsDAvwUzMTXqB6Vs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftaa0-NT9XmMWdyjylTr42kgg9CNMCzmkSULe8hhIOXgA&oe=69A42809"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SkyStack", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context
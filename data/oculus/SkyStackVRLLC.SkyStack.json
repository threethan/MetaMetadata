comes garbage. Don't let the blocks break the ceiling, or it's game over.\n\nWith four game modes and a level selector, you can stack at a relaxing yet intensifying pace, or start in a frenzied rush that tests your calm and mettle.", "short_description": "SkyStack is a stacking game that escalates as you gain more levels by clearing four-by-four slates, with better scores for more slates cleared with a single block. Grab blocks at either wrists and place them on the gameboard, just before the timer runs out or else it becomes garbage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://skystackvr.blogspot.com/2023/12/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "SkyStack VR LLC", "support_website_url": null, "website_url": "https://skystackvr.blogspot.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7110802265652585"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031479_873761157542486_1101738390553393204_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWe2QrcfCW8Q7kNvwGHzUQb&_nc_oc=Adp9Zjx-RBzBy5_EZd-C-r6dvFK0aAMvV0oKquJBVFeTFbp9SL10fUHdIxgJNJZeEJg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_ugADSPebmj6-7R6X6rNSlkPkd8cDYp_WN3zdcK2pJw&oe=6A8ED309"}, "is_concept
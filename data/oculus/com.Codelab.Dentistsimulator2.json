t=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxNKrj0cKdPPXvGC1YB3nm1myjQyxVtSxqFDR2SpgWkQA&oe=69C3E00A"}, {"file_name": "0 - Gameplay4.png", "id": "1333957884964212", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618270_1333957888297545_3184333804290299438_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61SfcgoVPcEQ7kNvwH0cIG0&_nc_oc=AdrpjOHcAYaJa4AUax3vl9tFtvzNoOp4x06ZO455KaWxDcPtv0yZ6iF2IfhWPou1zyA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQmV50-OQY4GxCwVtnWWGIQt5XUw4K3Cw4pvDKGOrBew&oe=69C3B9B5"}, {"file_name": "0 - Gameplay5.png", "id": "1130322172245526", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618947_1130322175578859_4936474821690703346_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kdc_C5tuebkQ7kNvwHnOpw3&_nc_oc=AdreTMaFWz3UyJKwJepF0ALEzqBxxsZMZO-gmDguDv3cXP6TkwKm1kQWoqhWfDj4JdM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxhSk9Auyd6Pd_kGy16bvq1GZLVfqzvTHfXb_J349NxIA&oe=69C3F06E"}, {"file_name": "0 - Gameplay2.png", "id": "765362316015496", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619591_765362322682162_3128029177609815588_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUJUYgS2ZhsQ7kNvwHAiiX_&_nc_oc=AdpkScfSVVif_6Y_HMbkZDiz535zjMkWjMfZe8oU4UCPEjFMyCd57vGIWOtNUNh0bAM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyC_3L9DmDg70695yKxN8LciNnPviElwi9KIzIT7W-73A&oe=69C3C086"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 - PNG.png", "id": "2118319971984808", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491822817_2118319978651474_6066534562781589164_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrNZOFb4WeEQ7kNvwHyCB2y&_nc_oc=AdoyHfIbmo-dMkxTjEzUvBnyNiTKCtay1PbuQOdZJSzKTxzQ66yDG_yGGjqBxkNmuCA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxh7cDnCQukwI_O1Ta7fRG2UooC04UJv9BZcPM6S1F-Cw&oe=69C3D903"}, "display_name": "Dentist Simulator 2", "keywords": ["DentalSimulator", "DentistGame", "VRDentist", "MedicalSim", "Dentistry"], "long_description": "Screams, panic, and fear of the dentist\u2019s chair \u2014 who hasn\u2019t felt that rush of anxiety? But now, the tables have turned \u2014 YOU are the one holding the drill!\n\nStep into the most realistic, immersive, and heart-pounding dentist simulator ever created. Grab your anesthetic syringe, pliers, and precision tools \u2014 every tooth is yours to master.\n\nBut beware \u2014 these sharp instruments demand skill, patience, and a steady hand. One wrong move, and your patients won\u2019t just scream \u2014 they\u2019ll bolt out the door!\n\nMaster every thrilling detail of dental work:\n\nAdminister anesthesia with pinpoint accuracy\n\nSkillfully cut and retract gums\n\nExtract single or multiple teeth with finesse\n\nStop bleeding before it gets out of control\n\nBut that\u2019s just the beginning! Take your skills to the next level by:\n\nApplying braces with colorful rubber bands\n\nCrafting dazzling gold and silver teeth\n\nInstalling dental implants like a true pro\n\nUsing inhalation sedation to keep patients calm and comfortable\n\nWith a completely overhauled gameplay, you have unmatched freedom to approach each procedure your way. The stakes are high, the pressure intense, and the fun absolutely addictive!\n\nAre you ready to prove you\u2019ve got what it takes? Step into the virtual dentist\u2019s chair, face the challenge, and become the ultimate dental expert \u2014 but remember, keep your patients calm, or you\u2019ll be the one hearing the screams!\n\nDownload now and experience the most addictive, realistic, and thrilling dental simulator.", "short_description": "Screams, panic, and fear of the dentist\u2019s chair \u2014 now YOU hold the drill! Master anesthesia, gum surgery, extractions, and bleeding control with precision. Go beyond basics: apply braces, craft gold & silver teeth, place implants, and use inhalation sedation. With totally reworked gameplay, enjoy unmatched freedom and thrills. Keep patients calm or hear their screams! Download now and dive into the most addictive, realistic dental simulator ever!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24506047708990069"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "2120992278678083"}, {"status": "PUBLISHED", "id": "1205058421714949"}, {"status": "PUBLISHED", "id": "1288960299584519"}, {"status": "PUBLISHED", "id": "1183097516968687"}, {"status": "CANCELLED", "id": "4077441195855750"}, {"status": "CANCELLED", "id": "2779823848893883"}, {"status": "CANCELLED", "id": "1972823936897225"}, {"status": "PUBLISHED", "id": "1240676614015283"}, {"status": "PUBLISHED", "id": "1108326167881145"}]}, "baseline_offer": {"id": "1183097516968687"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "2120992278678083"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"no
8_3125730497109165172_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYsyyhwlmiwQ7kNvwF91Unu&_nc_oc=Adp1rPY_mO0zYMSh56ddxkgSWSI4CfBmkhM5acEwZ8flr6yf-qp4YSb4uSxOZ0nxpq8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ro0exFGA8jGqxfOZawsmvdiQ6jXQjUPuwN7TO42rdEg&oe=6A00A0A1"}, {"file_name": "Imagem- recepcao.png", "id": "1371786307967047", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310667_1371786311300380_6395334634932557604_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REbSP7HLMfcQ7kNvwH919Qp&_nc_oc=AdpF7h5bxYc1c7RB-jBKj0i40vmapAGBhFbWu7GzPZQ5v8ILzfp_hk0hqiW_5pLo6K0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vBQZPZ7tUlBbkT-vykj6qztZR3U0GJgteQdEoAcN8EQ&oe=6A008C25"}, {"file_name": "Imagem1- tablet.png", "id": "943933494879421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303864_943933498212754_7475202180803033388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPyEj_OyblwQ7kNvwHuvP00&_nc_oc=AdpbnkUC_56c_HvcDhu039OLYWJQfU7tXnszaMoI8h9-j_wdU8Oib6xry4NXb5CTkI4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P_6I8WRxKcze9XgTI5XVJXngrwL3q2tj5owedqz2GKA&oe=6A00872C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 - nova4.png", "id": "1257955169773348", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307479_1257955173106681_204765621684128669_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C2vdu_TDJnEQ7kNvwHSVewW&_nc_oc=Ado_gq9PoW4UnqzM_Hv5GGFEVlrxWFPxHGSQ2FPHDJSdMcgVomMxnF3H0hB4Acc3i7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PynUJCd7LAsrpF4TfE6VMvyb87osvPGMx0-mMlUFOUQ&oe=6A007273"}, "display_name": "Dentist Simulator 2", "keywords": ["Dentistry", "Casual", "Sugeon", "Teeth", "DentalClinic"], "long_description": "Jump into Dentist Simulator VR, a realistic dental clinic simulator where every procedure matters. Clean teeth, give anesthesia, cut gums, extract teeth, control bleeding, and place implants like a real dentist. \n\nMaster every thrilling detail:\n- Customizable colored gloves and player speed adjustment.\n- Dental prophylaxis cleaning and Sandbox mode available in Practice Mode.\n- Administer anesthesia with pinpoint accuracy\n- Cut and retract gums with skill\n- Extract single or multiple teeth with finesse\n- Quick Time Event system with adjustable difficulty.\n- Control bleeding before it gets out of hand\n- Daily randomized appointments\n\nGo beyond the basics and push your skills further:\n- Apply braces with colorful rubber bands\n- Use headgear and face mask in advanced orthodontic treatments\n- Craft dazzling gold and silver teeth\n- Place implants like a true pro\n- Keep patients calm with inhalation sedation\n- And make the experience even more addictive with:\n- Achievements to unlock and master\n- Global leaderboards to prove who\u2019s the #1 VR dentist\n- Fun stickers to collect and share\n- Lessons with real dentistry theories\n\nWith completely reworked gameplay, you have total freedom to treat each patient your way.\nThe pressure is real, the stakes are high \u2014 but the fun is absolutely addictive!\n\nDownload now and claim your spot as the ultimate VR dentist\u2026 just don\u2019t let the screams get out of control!", "short_description": "Jump into Dentist Simulator VR, a realistic dental clinic where you clean, extract, treat, and save smiles.\n- Dental prophylaxis cleaning, customizable colored gloves. \n- Extractions, anesthesia, gum surgery, bleeding control, sandbox mode\n- Brackets, bonding, and colorful rubber band changes\n- Braces, face mask, headgear, gold & silver teeth\n- Implants and inhalation sedation\n- Achievements, leaderboards, and fun stickers \nReworked gameplay, total freedom, and addictive fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26696022899992528"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499302483_1981526759467752_7459391932989639590_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4u49zLoVLAgQ7kNvwFn2nfk&_nc_oc=AdpFe1DHvsdzMJIBqzhXXtAHmRLSR5ywCOUghrKx__zVTFuWLZsMkfGSgEOqrg2qynM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rakimcbaEdsGpxcgWIE_F4NhueFN9BYpCZsqGTeOZtw&oe=6A008800"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dentist Simulator 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1753906200, "lastRevision": {"nodes": [{"id": "24506047752323398", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24506047688990071", "is_first_party": false, "enables_in_app_ads": false, "is_conce
08_3125730497109165172_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWBxTsl6xhMQ7kNvwHCl8uU&_nc_oc=Adrp1BIEwyrvRLZO_mpRe5VNVyTTdv-Z3TrkrKb8N-X8gwPXSgRxd3y1ODsFfhndYqo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwkxLwp5qfabPy-FM6NymlQFi5h0MYoVAFKcLU6qa6Y5w&oe=69C3C361"}, {"file_name": "Imagem- recepcao.png", "id": "1371786307967047", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499310667_1371786311300380_6395334634932557604_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hjbtZQ_-BcQQ7kNvwHJ99tC&_nc_oc=Adqb87EN_gGsPLuvo_B6VRRIszfOenRWP9O6WQgs1wBgFAdqC9vRKjGjHM_8psLpfGY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzH0sCK12Voym0kU6g390TTfx_EIiF66gvDvvaawVgg-A&oe=69C3E725"}, {"file_name": "Imagem1- tablet.png", "id": "943933494879421", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303864_943933498212754_7475202180803033388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygytzuU2B4oQ7kNvwHRF7rW&_nc_oc=AdpsZLrF0Cqfi2zV2nxkSFtr9mty1wCzYMY0sZJhGS93Z8eBOq_58hX9gQu_Rm_BEU8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPjCEABcbh_90-g0rmvRhliYx4Zmf7wJPsVFDqZzJS5A&oe=69C3E22C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 - nova4.png", "id": "1257955169773348", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307479_1257955173106681_204765621684128669_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuMjLsPWOIMQ7kNvwEjnsgr&_nc_oc=Adofd4xZCEeSg2G6MZO5DIp9MpReBpOQzNrmCFvuliii69kuuVKj7EnICo9iP3cGlYY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY8vUKnB4dRiEdQdIe0CghbfQ2OC_3iOiZKNMQd5Lbmg&oe=69C3CD73"}, "display_name": "Dentist Simulator 2", "keywords": ["Dentistry", "Casual", "Sugeon", "Teeth", "DentalClinic"], "long_description": "Jump into the most realistic and immersive dental simulator ever made. Every procedure hits different \u2014 one slip and your patient won\u2019t just complain\u2026 they might sprint out of the clinic.\n\nMaster every thrilling detail:\n- Customizable colored gloves and player speed adjustment.\n- Dental prophylaxis cleaning and Sandbox mode available in Practice Mode.\n- Administer anesthesia with pinpoint accuracy\n- Cut and retract gums with skill\n- Extract single or multiple teeth with finesse\n- Quick Time Event system with adjustable difficulty.\n- Control bleeding before it gets out of hand\n- Daily randomized appointments\n\nGo beyond the basics and push your skills further:\n- Apply braces with colorful rubber bands\n- Use headgear and face mask in advanced orthodontic treatments\n- Craft dazzling gold and silver teeth\n- Place implants like a true pro\n- Keep patients calm with inhalation sedation\n- And make the experience even more addictive with:\n- Achievements to unlock and master\n- Global leaderboards to prove who\u2019s the #1 VR dentist\n- Fun stickers to collect and share\n- Lessons with real dentistry theories\n\nWith completely reworked gameplay, you have total freedom to treat each patient your way.\nThe pressure is real, the stakes are high \u2014 but the fun is absolutely addictive!\n\nDownload now and claim your spot as the ultimate VR dentist\u2026 just don\u2019t let the screams get out of control!", "short_description": "In this incredible game, you\u2019ll play with real dental procedures \u2014 minus the real stress:\n- Dental prophylaxis cleaning, customizable colored gloves. \n- Extractions, anesthesia, gum surgery, bleeding control, sandbox mode\n- Brackets, bonding, and colorful rubber band changes\n- Braces, face mask, headgear, gold & silver teeth\n- Implants and inhalation sedation\n- Achievements, leaderboards, and fun stickers\n- Lessons with real dentistry theories\nReworked gameplay, total freedom, and addictive fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "
08_3125730497109165172_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKgo5h3avr8Q7kNvwGWL8UZ&_nc_oc=Adq2u1NAG38VbADkozgQ-KCB5yN1uzeaTb_dTZkSnpzQQPX-aC4r9qN8vBzFHSM2zOA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-2pqh-_6N3iPdL58YXINHSVH1NrgFbzY3BmU9HwQF6w&oe=6A3016A1"}, {"file_name": "Imagem- recepcao.png", "id": "1371786307967047", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499310667_1371786311300380_6395334634932557604_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cOB2dyk07AkQ7kNvwHWEFAR&_nc_oc=AdrpOl4m7ymA87_9pzNQym_vaqhmYjTYWrpuhpn98odCwHZbBRRUZw96CmSQ6jzlvpU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0r_Ra9HqmlecmbGbc6nVWKaKJNQbQYm6I7b8t75oqwQ&oe=6A300225"}, {"file_name": "Imagem1- tablet.png", "id": "943933494879421", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499303864_943933498212754_7475202180803033388_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Glwpdl9refAQ7kNvwHDVQnf&_nc_oc=AdpfWABbXKKfzEJBPnSiQ16lRJXto38AyqJskoz8VJ0clNRtlxzMtp07FtENWPmDsug&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NcA3E3J_bNhKDFqCAe07n5njjCvTvGHr4CjMLbDkXww&oe=6A2FFD2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 - nova4.png", "id": "1257955169773348", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307479_1257955173106681_204765621684128669_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIlYlSb2dyYQ7kNvwHsCx_T&_nc_oc=AdqCGQVhjLqv1KR5Bu6x72l9UWmjkXXuaZbB45HKLC1BAi5eRcichMt-zB_LmqkZJ_Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C9Z2qEhqo5hoYUIxDbv9GShSMQABXaae2nMG5UwXxkA&oe=6A3020B3"}, "display_name": "Dentist Simulator 2", "keywords": ["DentalSimulator", "MedicalSim", "Dentistry", "Simulator", "DentalCare"], "long_description": "-Clean teeth, administer anesthesia, cut gums, extract teeth, control bleeding, and place implants like a real dentist. \n\n- Extract single or multiple teeth with finesse\n- Quick Time Event system with adjustable difficulty.\n{1001403445714858}\n\n- Administer anesthesia with pinpoint accuracy\n{884761534650450}\n\n- Use headgear and face mask in advanced orthodontic treatments\n{1307180054156832}\n\n- Place implants like a true pro\n{1608998404559137}\n\n-Dental caries cavity preparation using a high-speed handpiece.\n{2417460272067152}\n\n-Tons of fun\n{27631492563123923}\n\nGo beyond the basics and push your skills further:\n- Apply braces with colorful rubber bands\n{1640973893857472}\n\n- Customizable colored gloves and player speed adjustment.\n{1668131087739566}\n\n-Phosphoric acid etching, light-cured composite adhesive application, and photopolymerization\n- Craft dazzling gold and silver teeth\n\n- Cut and retract gums with skill\n{998041606043201}\n\n- Dental prophylaxis cleaning and Sandbox mode available in Practice Mode.\n{1662555105073791}\n\n- Daily randomized appointments\n- Control bleeding before it gets out of hand\n- Keep patients calm with inhalation sedation\n- Achievements to unlock and master\n- Global leaderboards to prove who\u2019s the #1 VR dentist\n- Fun stickers to collect and share\n- Lessons with real dentistry theories\n\nWith completely reworked gameplay, you have total freedom to treat each patient your way.\nThe pressure is real, the stakes are high \u2014 but the fun is absolutely addictive!\n\nDownload now and claim your spot as the ultimate VR dentist\u2026 just don\u2019t let the screams get out of control!\n", "short_description": "A realistic dental clinic:\n-Dental caries cavity preparation using a high-speed handpiece.\n- Dental prophylaxis cleaning, customizable colored gloves. \n- Extractions, anesthesia, gum surgery, bleeding control, sandbox mode\n- Brackets, bonding, and colorful rubber band changes\n- Braces, face mask, headgear, gold & silver teeth\n- Implants and inhalation sedation\n- Achievements, leaderboards, and fun stickers \nReworked gameplay, total freedom, and addictive fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-dentist-simulator", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27303683589226453"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499302483_1981526759467752_7459391932989639590_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KGa4XzMBzIQ7kNvwHTc3kN&_nc_oc=AdrlxAkQlQjs-2yvTs5llnzCz0Rdas97uKjFXjSI1zxJQX91TArFBHv0LsFs3FE9D4g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iRbhcNdBh1o7q5oFTcWaY0paefRBP3_qlu3-ZmZp5ZA&oe=6A2FFE00"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dentist Simulator 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1753906200, "lastRevision": {"nodes": [{"id": "24506047752323398"
lrTavw1F3Q47H2U3_gzfW89sycVeBNw&oe=6A3E7BE7"}, {"file_name": "oranguimage8.png", "id": "950680763536481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391888_950680766869814_7707144921812958125_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYirIinHOmsQ7kNvwFY5Sv8&_nc_oc=AdrT4hm_gHL-TBEHWIGvYeuO3r1sl73ZPsktkt45iKkD0rKVSGnZcN0wQIwtcAOT5Uw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_aayis331Hi8HjC87Fb69-BtE7qsxcqAm4ya0fwzmZ8g&oe=6A3E8DB3"}, {"file_name": "orangu9.png", "id": "2109136772923533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2109136776256866_4125570572889998659_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-l7hld4m9IkQ7kNvwEnpFil&_nc_oc=AdqtuOBgCAla4S5Ohnp26HuRaUi5N9rofVSfLnC0C0vdVpqOwxZZFNNY54B-OL-OXfo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Im3acCy4QC2hvS1Eeh_BHgX0SGx7WNkWYORxIm_KjwA&oe=6A3EA4EE"}, {"file_name": "oranguimage5.png", "id": "682066421048559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_682066424381892_4940362221998167016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dtKAh19eDwQ7kNvwH9NE-j&_nc_oc=Adrjqyvp-1LoYVbVIwP7q9m6mdNxK7yZq2wuvcSi1efEOA4zPAES628mrQXqfqU4Y5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0vTvhu7Jpv9cdY7DGTUCy38_T0qpVXkquGp55pl64aQ&oe=6A3E8B56"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orangu!", "keywords": ["adventure", "sandbox", "explore"], "long_description": "Welcome to the exciting world of Orangu! Traverse the Orangu world as a unique species of monkey, a mix of gorilla and orangutan! \n\nIn this game you can interact with other players in fun and unique ways. Explore the maps, including the forest, zero g space, the cove, the crystal mine! \n\nIf you're feeling like making your player more personal to you, customise it in many ways including colour, name and outfit by purchasing cosmetics from the Orangu shop! \n\nEnjoy your stay in the Orangu world!", "short_description": "Run, jump and bounce around the exciting world of Orangu! Embrace your inner orangutan and explore what the Orangu world has to offer including a forest, a cove, a zero gravity chamber, a crystal mine, and a shop!\nInteract with fellow players by joining a room! So what are you waiting for? Play Orangu today!"}]}, "developer_name": "OranguOfficial", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/orangu/f94c7fee-0198-4bf9-a4df-e8af93ff200d/privacy", "developer_terms_of_service_url": null, "publisher_name": "Nux", "support_website_url": null, "website_url": "https://doc-hosting.flycricket.io/orangu/f94c7fee-0198-4bf9-a4df-e8af93ff200d/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1990104051447093"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9114666091978444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_1008425897320977_4460026960122888463_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRITEH9Jxe4Q7kNvwEzSMXa&_nc_oc=AdpcelOVUJFd7UCFl4t2rIpw185wPREYyDJne77VZdwXVHyS-sn0SJkWw50vUypS3is&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UPCiXi5wwGABU0UtWv8Uk82CZ8AyLSbWa0lAUhuMt_Q&oe=6A3EA5C4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
jcZv6zhOalYI2AA7vTXQBb07qBaTaYQ&oe=69D260E7"}, {"file_name": "oranguimage8.png", "id": "950680763536481", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391888_950680766869814_7707144921812958125_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJmg29DWkQ8Q7kNvwE2cfPk&_nc_oc=Adp54U_aKKdZTGwMka4w1_VKawELiRQXXf_jXS113SsNqgxj_ufNHBLwzI8supqFstc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-uzJ-rO1uh2HkL4bAETH4JZpnCbZbl1MhTSLd0LkVBQ&oe=69D272B3"}, {"file_name": "orangu9.png", "id": "2109136772923533", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392025_2109136776256866_4125570572889998659_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zry3uXowPRsQ7kNvwF8s71N&_nc_oc=Adrb5x0zia6u0_7CPwzDsCXH2aVwKhsbPe3PNG7OGXJqrfubiRcy7c2TzRGfMAnlBho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HhE4lYmcMbr0EzESjoM3co6Rh3FY6LOyUPGuN3AiVQg&oe=69D251AE"}, {"file_name": "oranguimage5.png", "id": "682066421048559", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_682066424381892_4940362221998167016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhRUUOBYlbMQ7kNvwHbHDTe&_nc_oc=AdqB3zQiMQSz_V_sNO6jx27Np0Jc4xgB2Hy1DBYOGPEcNMNh1a6x6BnqlXA1P_t0wyw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NuUUH5YERODawnoigCYYRF_GN_tISpnyjrkVfnntKNA&oe=69D27056"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orangu!", "keywords": ["adventure", "sandbox", "explore"], "long_description": "Welcome to the exciting world of Orangu! Traverse the Orangu world as a unique species of monkey, a mix of gorilla and orangutan! \n\nIn this game you can interact with other players in fun and unique ways. Explore the maps, including the forest, zero g space, the cove, the crystal mine! \n\nIf you're feeling like making your player more personal to you, customise it in many ways including colour, name and outfit by purchasing cosmetics from the Orangu shop! \n\nEnjoy your stay in the Orangu world!", "short_description": "Run, jump and bounce around the exciting world of Orangu! Embrace your inner orangutan and explore what the Orangu world has to offer including a forest, a cove, a zero gravity chamber, a crystal mine, and a shop!\nInteract with fellow players by joining a room! So what are you waiting for? Play Orangu today!"}]}, "developer_name": "OranguOfficial", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/orangu/f94c7fee-0198-4bf9-a4df-e8af93ff200d/privacy", "developer_terms_of_service_url": null, "publisher_name": "Nux", "support_website_url": null, "website_url": "https://doc-hosting.flycricket.io/orangu/f94c7fee-0198-4bf9-a4df-e8af93ff200d/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1990104051447093"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9114666091978444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391911_1008425897320977_4460026960122888463_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM1fDSOvSfkQ7kNvwGESrRP&_nc_oc=AdrHaSY9gJltjZHSrm_NOjwciVh6R6YhWNe_SX1H47_hICmIQwcJ1JdyAeeUnXHW_iI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YrDTxVxfWr6SKuBSsBF5eJPaiRAUniZJ5cjVd058H2A&oe=69D25284"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
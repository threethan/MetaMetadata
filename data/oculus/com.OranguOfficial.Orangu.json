fKeevHF8j41JzIqQvobTYmW0IgnZCpA&oe=6A05CB67"}, {"file_name": "oranguimage8.png", "id": "950680763536481", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391888_950680766869814_7707144921812958125_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRogEqCYl6MQ7kNvwH2jOrE&_nc_oc=AdrV2Okb7jCeCh7jZJ4bTiPHtI4T31EYEQ-0wpXgLf4apeRFlHcFJTSAT2736YMw1-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DZHvFjpX89UBbUxbWl9Yl-ZUetqIi5VxSpHdIUTHmCQ&oe=6A05DD33"}, {"file_name": "orangu9.png", "id": "2109136772923533", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392025_2109136776256866_4125570572889998659_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2B8Sn04h5ksQ7kNvwGW7UC2&_nc_oc=AdrtQMM2lczWH5MVKew6Vk8HQO4E5djUKwCB_fpNYxrRv7IagTjvybdIgatLrpxoU5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41X-FAKTP2N7s_XeX47L1SUpl4_9eaCuUgJhkIE91rqA&oe=6A05BC2E"}, {"file_name": "oranguimage5.png", "id": "682066421048559", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_682066424381892_4940362221998167016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WzyAm3Mj_fAQ7kNvwHPbpqO&_nc_oc=Adou-Q06A5k2-39sr-v0uRoaps1RBoquZ-5z26WQbNeRlZ76JJ9mx2UFI4a5xrUt0VA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fauNf0U2wKsa4vULiXoR6gGrOcvXk8DthsOoB9vL7gA&oe=6A05DAD6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orangu!", "keywords": ["adventure", "sandbox", "explore"], "long_description": "Welcome to the exciting world of Orangu! Traverse the Orangu world as a unique species of monkey, a mix of gorilla and orangutan! \n\nIn this game you can interact with other players in fun and unique ways. Explore the maps, including the forest, zero g space, the cove, the crystal mine! \n\nIf you're feeling like making your player more personal to you, customise it in many ways including colour, name and outfit by purchasing cosmetics from the Orangu shop! \n\nEnjoy your stay in the Orangu world!", "short_description": "Run, jump and bounce around the exciting world of Orangu! Embrace your inner orangutan and explore what the Orangu world has to offer including a forest, a cove, a zero gravity chamber, a crystal mine, and a shop!\nInteract with fellow players by joining a room! So what are you waiting for? Play Orangu today!"}]}, "developer_name": "OranguOfficial", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/orangu/f94c7fee-0198-4bf9-a4df-e8af93ff200d/privacy", "developer_terms_of_service_url": null, "publisher_name": "Nux", "support_website_url": null, "website_url": "https://doc-hosting.flycricket.io/orangu/f94c7fee-0198-4bf9-a4df-e8af93ff200d/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1990104051447093"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9114666091978444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391911_1008425897320977_4460026960122888463_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FseOFGgXU68Q7kNvwFkQy8G&_nc_oc=AdrhXW-i0iyrhSrFGq3q8nMGmDLg2y_4zHjrFRIau9NOvpngssTLikxE4ZqPnuvYiL0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6NUWcQdYZ8HUhSEL5FBT-_VkHznAhDMb0ApkZ4zmBmOA&oe=6A05BD04"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
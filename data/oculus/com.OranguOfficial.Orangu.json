K_Sv_nqryfaajwm9P2xo476ns3zaVgQ&oe=6AE1F5E7"}, {"file_name": "oranguimage8.png", "id": "950680763536481", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391888_950680766869814_7707144921812958125_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfl_8Ji2KAsQ7kNvwGumRSY&_nc_oc=Adp_NUA2UVMxaIUEgC0ps0Ft7XeB793Bhp6cMY8VxKeknvSOQpq9PnrJbSeH4MTDkoY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0sZLHUXBD_sV1CFQNetsSbYW_43BIDywfHnlp78oHRA&oe=6AE207B3"}, {"file_name": "orangu9.png", "id": "2109136772923533", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392025_2109136776256866_4125570572889998659_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaP4kNuLGEUQ7kNvwEdbvzR&_nc_oc=AdoUrIFekFlQyRDpCXqjypDfi3Qz29i9D4w2extniX9aSU_Ix3RrLitEliF9RE01v8A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb-SkHpjATIMLHeUIQM_hcH2gLWDuQF9LBdUbtKVj72Q&oe=6AE1E6AE"}, {"file_name": "oranguimage5.png", "id": "682066421048559", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391924_682066424381892_4940362221998167016_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGVX1B_B4-kQ7kNvwEtA-OI&_nc_oc=Ado1S6OPBuRQaunza_W859DBvsZOC9NT_6WtU7ZpWthv8H0QbeAA_JqFV4EpO0UmZwY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9wp_J8oVumemhXgB8yWJ7VhI4113vrT3NReCURCsXoA&oe=6AE20556"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Orangu!", "keywords": ["adventure", "sandbox", "explore"], "long_description": "Welcome to the exciting world of Orangu! Traverse the Orangu world as a unique species of monkey, a mix of gorilla and orangutan! \n\nIn this game you can interact with other players in fun and unique ways. Explore the maps, including the forest, zero g space, the cove, the crystal mine! \n\nIf you're feeling like making your player more personal to you, customise it in many ways including colour, name and outfit by purchasing cosmetics from the Orangu shop! \n\nEnjoy your stay in the Orangu world!", "short_description": "Run, jump and bounce around the exciting world of Orangu! Embrace your inner orangutan and explore what the Orangu world has to offer including a forest, a cove, a zero gravity chamber, a crystal mine, and a shop!\nInteract with fellow players by joining a room! So what are you waiting for? Play Orangu today!"}]}, "developer_name": "OranguOfficial", "developer_privacy_policy_url": "https://doc-hosting.flycricket.io/orangu/f94c7fee-0198-4bf9-a4df-e8af93ff200d/privacy", "developer_terms_of_service_url": null, "publisher_name": "Nux", "support_website_url": null, "website_url": "https://doc-hosting.flycricket.io/orangu/f94c7fee-0198-4bf9-a4df-e8af93ff200d/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "1990104051447093"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9114666091978444"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391911_1008425897320977_4460026960122888463_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFFDrbyCJFgQ7kNvwHMmz99&_nc_oc=Adqwbvjg2MVV6uvJ_GLe-hcJPDGzLTSA_K_PdE8U3pRpFFTB96Ygtv432WfqBkNfKY8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgH0wqRAunV6TXrNF89kEAKWtTQIZo8J40TImtdMtscg&oe=6AE1E784"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
.com/v/t64.5771-25/38974677_1309072916251133_1101076410640916070_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCQAWVOL0ZkQ7kNvwFdWHLf&_nc_oc=AdoXGmHukcroLvouqd4iXwJ36ZYyU1AhmU5f1UZ0p19q4qJ4-I0tsaC9emzwJvATTzw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9ZufozgW-4SFuvb4LBwe1kiZxJJvi1oHfT9f0qj88uw&oe=6A8EEC67"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_CoverImage_2560x1440.png", "id": "506065724543567", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974798_506065731210233_4643156156780775954_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6gr8Y7STsUQ7kNvwH81Zh6&_nc_oc=AdonC0clYM5-YPmEYYHt1y-GbbKJ4ENgwt2c8ofrG0ft7RcOs35pQE9OpXQmf5D8V9I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDw7Og4BDEBk1_j4pIIZtdzTMEci1ZzC8ufdAo3V8LZg&oe=6A8EEA9C"}, "display_name": "Awake Heart", "keywords": [], "long_description": "Awake Heart takes you on an immersive journey through the human heart and lets you discover its most interesting secrets. Interact with the detailed representation of the heart in 3D space and challenge yourself in solving engaging puzzles. Dive beyond the visuals and explore the heart through the lens of anatomy, physiology and electrical activity. Awake Heart is suitable for anyone who wants to learn more about the human heart.", "short_description": "Immersive journey through the human's heart."}]}, "developer_name": null, "developer_privacy_policy_url": "https://awakematerials.blob.core.windows.net/%24web/Legal/APP_Awake_%20PP_20210707.pdf", "developer_terms_of_service_url": null, "publisher_name": "Awake Health", "support_website_url": null, "website_url": "https://awake.health/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIO
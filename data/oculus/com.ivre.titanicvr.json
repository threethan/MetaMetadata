.oculuscdn.com/v/t64.5771-25/473391888_2428529724173331_6363713023271912180_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZWX1cgWwR8Q7kNvwEpoMtz&_nc_oc=Adop-KqC2Bjw134dYGGQZD04QxYmFQISbolxBf3GHFBjU7jDLmLuB6bVXUbohF3DDMs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18xjWhA4IXZmXIYQXbpDa9wZWmgKNwZAlj4W8a21nHOw&oe=69E0EEA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1180712426697247", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473393589_1180712433363913_5379711721573673575_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qof0B2LiUGYQ7kNvwEm157W&_nc_oc=AdqbZJG1XgKohzqNS7iWgHTb9TxQuHS0LRcqzWZPtXqpPg_ankdkJr98bfFO__fBZZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DyrTxQIDhh4lfH0h54lo1NavC_an0ElRF0MM6QtK2kw&oe=69E0F3DF"}, "display_name": "Titanic VR", "keywords": ["submarine", "driving", "titanic", "simulation", "educational"], "long_description": "Titanic VR is a submarine simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912.\n\nDiving to the bottom of the North Atlantic, you take on the role of Dr. Ethan Lynch, Associate Professor of Maritime Archaeology at the fictional University of Nova Scotia. With funding from a mysterious investor, Dr. Lynch and his PhD Candidate Jean Robinson have set out aboard a research vessel to dive the wreck of Titanic and answer questions that have remained submerged for a century. This game allows you to explore the full shipwreck inside and out and recover items and complete missions such as recovery of a downed ROV, Documentary Film Making and the creation of a photomosaic.\n", "short_description": "Titanic VR is a submarine simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912."}]}, "developer_name": "ENGAGE XR Ltd", "developer_privacy_policy_url": "https://engagevr.io/wp-content/uploads/2025/03/Titanic-VR-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "ENGAGE XR Ltd", "support_website_url": null, "website_url": "https://engagevr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24641087888883251"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391952_1877385013095613_85489774920597468_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTerITnPYgwQ7kNvwEIlCfI&_nc_oc=Adp6NjLz1Gh-pAz3NHLMnHLXnhHBeXQL91Ny8zbpej0bDSXyU7zmgC0bBE4VrzRVDfA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0EbO8UOXeGYK8PeZxVmyz-VRR_C4q8q5gVfaPOiOvXmg&oe=69E0CA32"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Titanic VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1744678620, "lastRevision": {"nodes": [{"id": "9391298370955451", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_local
jxjf8SQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVZTFwXGVTRkR6nOohYkMCBxMlIDek7HapqauHT1FmduA&oe=6B106C9B"}, {"file_name": "11162716_1977084465901772_672696233373990912_n.png", "id": "2428529720839998", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_2428529724173331_6363713023271912180_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfxjYzBCXUsQ7kNvwFcDp8j&_nc_oc=AdrNNjCPlG2iMChB52ZIx1_A4wU8t4IeGu9Fxy7W7eaxrYU7HtuTne-x5BmGDq-CUGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX2XrM9IzZVH2vavkRe2zZQr2WdKIpGCselAzvkAwMiEQ&oe=6B105FE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1180712426697247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393589_1180712433363913_5379711721573673575_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJOTcSOO35EQ7kNvwH_sMEN&_nc_oc=Adpg9K-nnSPE9m-e2cIfWnt8z-UOzeDFCtFUbQ-jpTREYI2Bl4omI7F5saXgVRmsERw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXTi_Y6StYtV27zJ2PP7iDdc91uNB5ksKW7EnOp_0v-BQ&oe=6B10651F"}, "display_name": "Titanic VR", "keywords": ["submarine", "driving", "titanic", "simulation", "educational"], "long_description": "Titanic VR is a submarine simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912.\n\nDiving to the bottom of the North Atlantic, you take on the role of Dr. Ethan Lynch, Associate Professor of Maritime Archaeology at the fictional University of Nova Scotia. With funding from a mysterious investor, Dr. Lynch and his PhD Candidate Jean Robinson have set out aboard a research vessel to dive the wreck of Titanic and answer questions that have remained submerged for a century. This game allows you to explore the full shipwreck inside and out and recover items and complete missions such as recovery of a downed ROV, Documentary Film Making and the creation of a photomosaic.\n", "short_description": "Titanic VR is a submarine simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912."}]}, "developer_name": "Hairy Frog Studios", "developer_privacy_policy_url": "https://hairyfrogstudios.com/titanic-vr-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Hairy Frog Studios", "support_website_url": null, "website_url": "https://hairyfrogstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29369888889336437"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391952_1877385013095613_85489774920597468_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43r7nEbaJVUQ7kNvwEbH7Y3&_nc_oc=Adpx0j3oEf5thxfzZ-h5NqJuSNfC07xbueTTgc261vdzaa42HPqM69ZMvL3IpZfK_Vs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUP12GBXoh5DIReVcV2S93zwOsNN3MMfKDkazmvseyDFw&oe=6B103B72"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Titanic VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}
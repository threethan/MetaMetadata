.oculuscdn.com/v/t64.5771-25/473391888_2428529724173331_6363713023271912180_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJeODfisV5MQ7kNvwElaNRu&_nc_oc=AdruQtLnFi46hD1rR4A1hnek6mevLFzavs5mRBX5A0ZqzIBz7i_4nITwJtkvrt5bO8A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EP_kNRkaH-j2rMT2sQvpKO-WY4c1yGQrMKuFticxnPg&oe=69F363A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1180712426697247", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473393589_1180712433363913_5379711721573673575_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHaI1aIVokoQ7kNvwFxfzow&_nc_oc=AdpWsOVP45ZEWkTlMaezdl5UOOlCjDjmCcJWdA4FlttE3mc-b7m8pIhu9qzTz5WPkKE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2N6Jus0QfH3oEVIpdO-uWjMhYEV1AAxhkAtREfiDL2Xw&oe=69F368DF"}, "display_name": "Titanic VR", "keywords": ["submarine", "driving", "titanic", "simulation", "educational"], "long_description": "Titanic VR is a submarine simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912.\n\nDiving to the bottom of the North Atlantic, you take on the role of Dr. Ethan Lynch, Associate Professor of Maritime Archaeology at the fictional University of Nova Scotia. With funding from a mysterious investor, Dr. Lynch and his PhD Candidate Jean Robinson have set out aboard a research vessel to dive the wreck of Titanic and answer questions that have remained submerged for a century. This game allows you to explore the full shipwreck inside and out and recover items and complete missions such as recovery of a downed ROV, Documentary Film Making and the creation of a photomosaic.\n", "short_description": "Titanic VR is a submarine simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912."}]}, "developer_name": "ENGAGE XR Ltd", "developer_privacy_policy_url": "https://engagevr.io/wp-content/uploads/2025/03/Titanic-VR-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "ENGAGE XR Ltd", "support_website_url": null, "website_url": "https://engagevr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24641087888883251"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391952_1877385013095613_85489774920597468_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfM2ueS_L9IQ7kNvwGUOM5s&_nc_oc=Adp-ZQuUy1WEA9LMFcfNLhvVKsw5GH8NPwYuTGNt2Qo06TBkCddgwgfPwhqjwpAa6Sg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2C9QIystckA80pxOPsIkqVDjfx8WmfcCsvQoW0uLNLIg&oe=69F37772"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Titanic VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1744678620, "lastRevision": {"nodes": [{"id": "9391298370955451", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_local
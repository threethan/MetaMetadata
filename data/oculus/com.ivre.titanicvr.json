vwHHigsk&_nc_oc=Adlg0jF4693XEu4TD4JdB9uA_jvHH4S1R8TQ8HlL1nl-sGo2Ak0aIS0wW6Pp07q64Ao&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfzgTo1rssp-Y2P-Fs5i99FkHfMvg0J89GgF7hLnTfD0Ww&oe=69AADE14"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Titanic VR", "keywords": ["Titanic", "Simulation", "Education", "Submarine"], "long_description": "Witness the sinking of RMS Titanic. Explore the shipwreck. Titanic VR is a diving simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912.\n\nDiving to the bottom of the North Atlantic, you take on the role of Dr. Ethan Lynch, Associate Professor of Maritime Archaeology at the fictional University of Nova Scotia. With funding from a mysterious investor, Dr. Lynch and his PhD Candidate Jean Robinson have set out aboard a research vessel to dive the wreck of Titanic and answer questions that have remained submerged for a century. \n\nThis game allows you to explore the shipwreck inside and out and recover items and complete missions such as recovery of a downed ROV, Documentary Film Making and the creation of a photomosaic. \n\nIn the 1912 experience, players will witness key events through the eyes of a survivor onboard lifeboat 6.", "short_description": "Witness the sinking of RMS Titanic. Explore the shipwreck. Titanic VR is a diving simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912."}]}, "developer_name": "ENGAGE XR Ltd", "developer_privacy_policy_url": "https://engagevr.io/wp-content/uploads/2025/03/Titanic-VR-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "ENGAGE XR Ltd", "support_website_url": null, "website_url": "https://engagevr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "
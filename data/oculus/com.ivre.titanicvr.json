.oculuscdn.com/v/t64.5771-25/473391888_2428529724173331_6363713023271912180_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jC1V0Bmw-2gQ7kNvwFG6PEo&_nc_oc=AdpxVLVZHYyIoDJpib4JMOW0zzpmLe0Z2LdKERZVMRhirmZAa_u_zm8nZUsg2AeFv0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfnCUE1-eZlj42iZgfsgi9FPSwo9IHt-VCf60Fa7FFkQ&oe=6A4FACA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1180712426697247", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393589_1180712433363913_5379711721573673575_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcqazTi6btgQ7kNvwG8VuaV&_nc_oc=Adp2k6oHoCyNLNmZbjfWS4RiHN1HQIjQsnaFrMjFcp0EPupUpVoMarRaXxZMNYoLwkg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNEL5TArO0OUBNWF7raDsiNG_3a2prUgDMvvS6UBxvNg&oe=6A4FB1DF"}, "display_name": "Titanic VR", "keywords": ["submarine", "driving", "titanic", "simulation", "educational"], "long_description": "Titanic VR is a submarine simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912.\n\nDiving to the bottom of the North Atlantic, you take on the role of Dr. Ethan Lynch, Associate Professor of Maritime Archaeology at the fictional University of Nova Scotia. With funding from a mysterious investor, Dr. Lynch and his PhD Candidate Jean Robinson have set out aboard a research vessel to dive the wreck of Titanic and answer questions that have remained submerged for a century. This game allows you to explore the full shipwreck inside and out and recover items and complete missions such as recovery of a downed ROV, Documentary Film Making and the creation of a photomosaic.\n", "short_description": "Titanic VR is a submarine simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912."}]}, "developer_name": "ENGAGE XR Ltd", "developer_privacy_policy_url": "https://engagevr.io/wp-content/uploads/2025/03/Titanic-VR-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "ENGAGE XR Ltd", "support_website_url": null, "website_url": "https://engagevr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24641087888883251"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391952_1877385013095613_85489774920597468_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJYRIiHqAugQ7kNvwE7JpGv&_nc_oc=Adp72F1rW_lJ7v5G7Hvzbv3NTzN2gSR2_CXS7Gnzl6ndue3cdz9P1SSPAZ3zadHE85M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBACixxURGCiYVI3Ls08PxbV5AdJsSqd9JDLGbDrrYuSQ&oe=6A4FC072"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Titanic VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Travel & Exploration", "id": "726368587961803"}], "release_date": 1744678620, "lastRevision": {"nodes": [{"id": "9391298370955451", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_local
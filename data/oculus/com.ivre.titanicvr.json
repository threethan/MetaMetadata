id": "2428529720839998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391888_2428529724173331_6363713023271912180_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoXvo6ikp2EQ7kNvwGnECgi&_nc_oc=AdqT-KjLX9GbuFDoPlA3GHAGxxeFGe_4u4eMAVNvK2ZA6SARMqhtVLxGay9NAGVWZRw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXbjhIkuuoRz1vBwkSdGmuKuO7mBSfL5zt2bntDC6Ceg&oe=6AFDB2A4"}, {"file_name": "38982474_265509074062125_7146435696297771008_n.png", "id": "656669356811137", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393859_656669360144470_1242251888400715046_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUTBtHHmXBkQ7kNvwE_a8QW&_nc_oc=Adr2jjsQ5Rmvl3iQerWXKOR4RSHS-4v50qyFH71cVYsC5t63kXZHbfrgUx-NOGu5IuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlFIRa1Ac_Q3sE8uWb4iEVw4px6PZPgvA-9R6iYr60LQ&oe=6AFDAF94"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Titanic VR", "keywords": ["Titanic", "Simulation", "Education", "Submarine"], "long_description": "Witness the sinking of RMS Titanic. Explore the shipwreck. Titanic VR is a diving simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912.\n\nDiving to the bottom of the North Atlantic, you take on the role of Dr. Ethan Lynch, Associate Professor of Maritime Archaeology at the fictional University of Nova Scotia. With funding from a mysterious investor, Dr. Lynch and his PhD Candidate Jean Robinson have set out aboard a research vessel to dive the wreck of Titanic and answer questions that have remained submerged for a century. \n\nThis game allows you to explore the shipwreck inside and out and recover items and complete missions such as recovery of a downed ROV, Documentary Film Making and the creation of a photomosaic. \n\nIn the 1912 experience, players will witness key events through the eyes of a survivor onboard lifeboat 6.", "short_description": "Witness the sinking of RMS Titanic. Explore the shipwreck. Titanic VR is a diving simulator and immersive interactive story. With over 6 hours of game-play Titanic VR you will leave with a greater understanding of the historic tragedy that unfolded in 1912."}]}, "developer_name": "ENGAGE XR Ltd", "developer_privacy_policy_url": "https://engagevr.io/wp-content/uploads/2025/03/Titanic-VR-Privacy-Policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "ENGAGE XR Ltd", "support_website_url": null, "website_url": "https://engagevr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9458607157557905"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1125783657045953"}, {"status": "PUBLISHED", "id": "1652964986175379"}, {"status": "PUBLISHED", "id": "1828805291820524"}, {"status": "PUBLISHED", "id": "1504149194008559"}, {"status": "PUBLISHED", "id": "25458752570428314"}, {"status": "PUBLISHED", "id": "1705457110147348"}, {"status": "PUBLISHED", "id": "3322079937959047"}, {"status": "PUBLISHED", "id": "24222537850775832"}, {"status": "PUBLISHED", "id": "1195423015491074"}]}, "baseline_offer": {"id": "1195423015491074"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "
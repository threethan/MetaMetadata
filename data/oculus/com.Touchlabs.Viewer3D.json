4.5771-25/499312338_1679140476475771_3320893067775363471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Yhyc5zRjRMQ7kNvwG_uetk&_nc_oc=Adqivn2hZxzzxTVYMndEVkY8OC_HZGbotf-wvuNKkCHtFJorbKCQWzqgkDoRG8TXqFk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXhRY0ILoKVLxUc-woiiHLz61Wxm9p6ba0FB0Q4hUqEg&oe=6AB69679"}, {"file_name": "com.Touchlabs.Viewer3D-20260731-153023-0-260.png", "id": "1591953052453135", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311597_1591953059119801_6014210226794197053_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lcR_c4FmboQ7kNvwEYGG6J&_nc_oc=AdooF5zIhJ9uSiW7f3_IJyDLsIQhYITDS0ECJYV73OR4cbU42TcHcNW81fTErAciCyY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZvBiMDgFuZ0ng41dX3uCrVXybQGfR6TggYZ_2gtnv5Q&oe=6AB6885B"}, {"file_name": "com.Touchlabs.Viewer3D-20260731-153023-0-327.png", "id": "1438627638091138", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499312454_1438627644757804_7473524040016437356_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXN-xuCysfsQ7kNvwEZU-p0&_nc_oc=AdpxSGVcjTJLu4o3Srruq4aeu0Kj1vURjsxrPUfJmdBfQTbzIxtQnnqMlDuG3QdHeJU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeqYqIswZP-TPwHw8a_Jv9Vrncci_d6J7hHA0B23W92A&oe=6AB66E9E"}, {"file_name": "com.Touchlabs.Viewer3D-20260731-153023-0-393.png", "id": "1773761013935040", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673759338_1773761017268373_1457341276885183751_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pfucMjQ_tZEQ7kNvwHlMqvp&_nc_oc=AdoVKLtDBpNbhsXBUGpyGz_OPt9ildyJ_AiFlq3CdJSsIknA2lxGI-keszuMiQy2jkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrwtRRvZ0MPmtT87JJzAlKFvdURyXVa5vbOlZ2HB3x2A&oe=6AB66ABB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-08-05-11h25m15s152.png", "id": "1332708838851282", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311582_1332708842184615_4676341280472556007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EISnpjWWpgkQ7kNvwEOaVEC&_nc_oc=AdqQeARIkwyYiGkZ1BKIPWPS_Yq83yfgPBm2sfFjbgzDPU3TF_-n-85ZY14ObYeilog&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwQIzM6uqr1Gjhc-FqHKV9WmvK_EpKz_9DkQ4w1NX_uw&oe=6AB69671"}, "display_name": "TwinLightReality Viewer", "keywords": ["tool", "3D", "Viewer"], "long_description": "**One viewer for models, images, and videos, built for Meta Quest.**\n\nTwinLightReality Viewer lets you open and inspect professional 3D models directly in your headset, alongside reference images and videos, for a complete review in a single immersive session.\n\n**Supported formats**: \nFBX, GLB/GLTF, STL, OBJ, 3MF, and DAE \u2014 all loadable through a single workflow designed for Meta Quest.\n\n**Key features**\n- **Global and local transforms**: move, scale, and rotate the whole model or individual submeshes for precise comparisons and spatial setups\n- **Materials and textures**: view and adjust material parameters, review textures, and quickly compare aesthetic variants\n- **Animations and playback**: browse available clips and evaluate the content's dynamic behavior\n- **AR placement**: place the model in real space for contextual reviews\n- **Screenshot and measuring tape**: capture views and measure distances without leaving the session\n- **Geometry insights**: check measurements and polygon count to verify file weight, scale, and cleanliness\n\n**Customizable environment**: \nAdjust HDRIs, skybox colors, and light direction to display each model in the right visual context, from material checks to immersive presentations.\n\n**Seamless workflow**\n- **Google Drive integration**: access shared libraries and bring content into the headset in just a few taps\n- **LocalSend**: quickly receive models and media from desktop or mobile, no cables needed\n\nPerfect for demos, internal validation, sales support, and on-the-go quality checks.\n", "short_description": "3D models viewers for the Meta Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://twinlight.touchlabs.it/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Touchlabs Srls", "support_website_url": null, "website_url": "https://twinlight.touchlabs.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24902251726071851"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2555928564818728"}, {"status": "PUBLISHED", "id": "2088542108415356"}]}, "baseline_offer": {"id": "2088542108415356"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2555928564818728"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28347404418223214", "version": "1.0.7"}, "id": "4242648802686442", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24902251672738523", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28347404418223214"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4
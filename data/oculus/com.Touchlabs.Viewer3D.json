=1-7&_nc_sid=6e7a0a&_nc_ohc=thueqw6HqqgQ7kNvwE5g9QY&_nc_oc=Adpxoy3aUB8YKytlNgJYy8yAnu8JAM8n_mh1NC9xXtWCk3M8e3WtIxplrmi-YAl9IcI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_Qy25--GP3BbuEMePbOSWkbN2s_M-zw96qbNsH84DRw&oe=6AC91BDE"}, {"file_name": "com.Touchlabs.Viewer3D-20260731-153023-0-393.png", "id": "1773761013935040", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673759338_1773761017268373_1457341276885183751_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F1BOszIYfwQ7kNvwG8Y3No&_nc_oc=Ado-5xMPTlaxwOR1DdIIL3KkatR9ROEEHVnHpQFPBRYqAFpLVNKDqtsthWL_bp7Qp-A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrwPy4tqzKF92jFQaQUfV8oW7wZHRgjahdxyEfkt957A&oe=6AC917FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2026-08-05-11h25m15s152.png", "id": "1332708838851282", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499311582_1332708842184615_4676341280472556007_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-zk9NCgDRAQ7kNvwEkoh4f&_nc_oc=AdpYG-y0RhV_edoL3oBHYLvRl2I7vi468z2B3OXNNoh2az7QVvGe_N_oqqJU52-rdQA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBwvkMGHAt4jffEWtv-MNuPLeDJ-weXSQqps8Nw5ZXMw&oe=6AC90B71"}, "display_name": "TwinLightReality Viewer", "keywords": ["tool", "3D", "Viewer"], "long_description": "**One viewer for models, images, and videos, built for Meta Quest.**\n\nTwinLightReality Viewer lets you open and inspect professional 3D models directly in your headset, alongside reference images and videos, for a complete review in a single immersive session.\n\n**Supported formats**: \nFBX, GLB/GLTF, STL, OBJ, 3MF, and DAE \u2014 all loadable through a single workflow designed for Meta Quest.\n\n**Key features**\n- **Global and local transforms**: move, scale, and rotate the whole model or individual submeshes for precise comparisons and spatial setups\n- **Materials and textures**: view and adjust material parameters, review textures, and quickly compare aesthetic variants\n- **Animations and playback**: browse available clips and evaluate the content's dynamic behavior\n- **AR placement**: place the model in real space for contextual reviews\n- **Screenshot and measuring tape**: capture views and measure distances without leaving the session\n- **Geometry insights**: check measurements and polygon count to verify file weight, scale, and cleanliness\n\n**Customizable environment**: \nAdjust HDRIs, skybox colors, and light direction to display each model in the right visual context, from material checks to immersive presentations.\n\n**Seamless workflow**\n- **Google Drive integration**: access shared libraries and bring content into the headset in just a few taps\n- **LocalSend**: quickly receive models and media from desktop or mobile, no cables needed\n- Also supports SMB\n\nPerfect for demos, internal validation, sales support, and on-the-go quality checks.", "short_description": "3D models viewers for the Meta Quest"}]}, "developer_name": null, "developer_privacy_policy_url": "https://twinlight.touchlabs.it/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Touchlabs Srls", "support_website_url": null, "website_url": "https://twinlight.touchlabs.it/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], 
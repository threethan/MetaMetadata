4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkzhXz7OwLyJc1RxiyL655f-rIcwTAmAlhJrc4IFRpcg&oe=6A649F19"}, "display_name": "Tiny Island", "keywords": ["Beach", "Beautiful", "TinyIsland", "Island", "Relaxation"], "long_description": "Have you ever been to a tropical island? With Tiny Island you can dive into a True Tropical Island.\n\nPlease use this app when you are relaxed.\n\nEx:\n-While you are lying down in bed \n-While you are sitting on a massage chair\n\nWhen you dive into Tiny Island, you can see the beauty of nature. Leaves, clouds, sky, sun, moon, shadow, birds, boat, waves, nature sounds, etc... all delightfully animate. \n\nThese animations will help you relax and achieve peace of mind. \n\nEnjoy!\n\n\n", "short_description": "Have you ever been to a tropical island? With Tiny Island you can dive into a True Tropical Island.\n\nPlease use this app when you are relaxed.\n\nWhen you dive into Tiny Island, you can see the beauty of nature. Leaves, clouds, sky, sun, moon, shadow, birds, boat, waves, nature sounds, etc... all delightfully animate. \n\nThese animations will help you relax and achieve peace of mind. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://taovisor.com/tiny-island/", "developer_terms_of_service_url": "http://taovisor.com/tiny-island/", "publisher_name": "Taosoftware", "support_website_url": null, "website_url": "http://taovisor.com/tiny-island/", "category": "GALLERY", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": 
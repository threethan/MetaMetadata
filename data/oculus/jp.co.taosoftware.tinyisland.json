ny Island, you can see the beauty of nature. Leaves, clouds, sky, sun, moon, shadow, birds, boat, waves, nature sounds, etc... all delightfully animate. \n\nThese animations will help you relax and achieve peace of mind. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://taovisor.com/tiny-island/", "developer_terms_of_service_url": "http://taovisor.com/tiny-island/", "publisher_name": "Taosoftware", "support_website_url": null, "website_url": "http://taovisor.com/tiny-island/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MOVIE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "333145868687246"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/12727849_1588481258127586_31803528452243456_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x04Fd-ppauwQ7kNvwFo70r1&_nc_oc=AdpJ_I4DAK37ySj-duXu1Gr18fcT2KkELDyneGfP7wCTqivOAjY5zMWxWtbLMd4xD1o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7V3SptHoin9St1Z2SPshiCt0OFh-HDB5uoZKOwseN-Q&oe=6AA424BA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tiny Island Relax", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1470207600, "lastRevision": {"nodes": [{"id": "1068408639884487", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1284669471561141", "is_first_party": false, "enables_in_app_ads": false,
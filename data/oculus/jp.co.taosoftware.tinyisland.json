YM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvKlNWCpN9Jgg62Zbgb8-KIMba4lRwNXgT2ndTh2TSwXg&oe=699AF422"}, {"file_name": "migrated_image.png", "id": "143896463643654", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12602331_1775844242676785_4998138323793870848_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80sSHuLJrMQQ7kNvwFqUd00&_nc_oc=AdlKN9dFfJktOukReqTNRwnVzBJDEZyKnDlrrPd5T-JeHoIbvJkv25UslXtlcKgUbjg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afslst8gieIdITmtqfMksHSbn2WPOv2TVm6PbLeEaHpRXg&oe=699B033A"}, {"file_name": "migrated_image.png", "id": "139253220822612", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12331034_1225188754171751_832821709_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyYIZ1HzjDgQ7kNvwEk4ODt&_nc_oc=AdnJ06RbGVK0p0IzVQPGpSP6yu7DjwQzGOYCz53AsCn632JwsQYREh_xGrLq1Bia4Q0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftCSEYqLlgWrTCA1AAvr9OPxdnO6oVUZeeUYM1bl7OEuA&oe=699AE745"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tiny Island Relax", "keywords": ["Beach", "Beautiful", "TinyIsland", "Christmas", "Relaxation"], "long_description": "Have you ever been to a tropical island? With Tiny Island you can dive into a True Tropical Island.\n\nPlease use this app when you are relaxed.\n\nEx:\n-While you are lying down in bed \n-While you are sitting on a massage chair\n\nWhen you dive into Tiny Island, you can see the beauty of nature. Leaves, clouds, sky, sun, moon, shadow, birds, boat, waves, nature sounds, etc... all delightfully animate. \n\nThese animations will help you relax and achieve peace of mind. \n\nEnjoy!", "short_description": "Have you ever been to a tropical island? With Tiny Island you can dive into a True Tropical Island.\n\nPlease use this app when you are relaxed.\n\nWhen you dive into Tiny Island, you can see the beauty of nature. Leaves, clouds, sky, sun, moon, shadow, birds, boat, waves, nature sounds, etc... all delightfully animate. \n\nThese animations will help you relax and achieve peace of mind. "}]}, "developer_name": null, "developer_privacy_policy_url": "http://taovisor.com/tiny-island/", "developer_terms_of_service_url": "http://taovisor.com/tiny-island/", "publisher_name": "Taosoftware", "support_website_url": null, "website_url": "http://taovisor.com/tiny-island/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MUSIC", "MOVIE", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "333145868687246"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727849_1588481258127586_31803528452243456_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CaeVWax_csQ7kNvwHw_Au2&_nc_oc=Adl9KX1F7rY3NITnB1mxoVww4yaPOyVrj8jYH4kQcLAek2DpVwID9j3Y70QJnQOvHW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsyUIdNrSXuj-al8UTGcuFoGTqHDXLFTjDsC8rx42xRIA&oe=699AEEFA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tiny Island Relax", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1470207600, "lastRevision": {"nodes": [{"id": "1068408639884487", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1284669471561141", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "migrated_image
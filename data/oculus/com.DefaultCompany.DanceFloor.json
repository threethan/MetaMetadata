7&_nc_sid=6e7a0a&_nc_ohc=N32CwV4jnGkQ7kNvwFQthpR&_nc_oc=AdoafypcaWI5j6NCvokNVln9ZYs5ThseX4Evzp1IWNcFmIdD_tmSolNTU4BdBpCgvg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJp00uJfRqhTORuba92_lihQ00mtzT5GXk3cbIaZFKLrA&oe=6AAAA0C4"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xfsNJvsohIQ7kNvwG-qIZO&_nc_oc=Adp7E5uM3iqjJEheg0TxtFHfk507BLMz6vx30B3HqwvBmvH44lTgIvoGUGwvhVWMkvE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3egmZsdL-2rz-8tIsXBwEK-D7h35O306GreE-gOfY0A&oe=6AAA8B0F"}]}, "id": "2432589163760004", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "507042665792771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391991_507042669126104_8045757676306318155_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YyqNk71CC4IQ7kNvwHzYUxo&_nc_oc=AdoZOHTa6Lwfh-lL87hFN2RHtviABqkT7aU-Y9hUCnQB3P9y47qkXrVow4nBjmW71-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLh_jbHhb9UfewoyU7CpbNgSktxchhgnJqVxZBeK1h3oQ&oe=6AAAAD24"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wYCMpYVYpMQ7kNvwF_-Cug&_nc_oc=Adpg8qCrBgUgVxEkmHq2F9qsacTC4DNT2J030DJARnFCGoGqTQVboEIloCDHTxsOj8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLVhNTI8YjriIco4hnxSmDx7PLOnbex5YTLgfuBwzmpg&oe=6AAA9530"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pphm1e2p1IUQ7kNvwG_mdcS&_nc_oc=AdqTsmbE3-F28ZfZfn-QIacH2YUUaYUnO-tg8stZ5vqvyFbp44N3h5Y7Qt47U1gq4hs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHcxJakrqW34ONazanUM1IMKiwAtyej0D9-CH0BsBfJg&oe=6AAA8C45"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHfpu2u3Sb4Q7kNvwG8eF98&_nc_oc=Adp13Aq59xouS31k-3tv6xk250NE8tv1cTz8ENh6clKBjnLrZ1J8ANoZxVY1b1kX0-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfenvKT-9gds9-PJ1cWWhYjRR1RCZTS_A68S4SvK72GQ&oe=6AAABB64"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6LPL2DfRbwQ7kNvwHUalt4&_nc_oc=AdoJZB3Q4Q9tHzbC5u3qRaxpJ7opOTTtXIBhE6Dr6VvCQxK91yecaDX74YoBg7uzvrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3uKzCC14U57znSKNeJ2G4k2AON8hu8vjM2a1r-QKewg&oe=6AAA8EB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "1188312709333188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742474700, "status": "PUBLISHED", "id": "1188312709333188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
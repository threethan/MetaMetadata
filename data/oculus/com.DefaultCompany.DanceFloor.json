ms2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG2M8H9E_ZfQA45kXCk0ovdcfQitaVLoJj3cw9Nq9QgA&oe=6A510A52"}, {"file_name": "screenshot5.png", "id": "1973472886838925", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619078_1973472890172258_1321755227202967019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgy8PzuL81IQ7kNvwGyUEnB&_nc_oc=AdqjPq2UmW-cILDGSvTo_V9NDxguBmqEkWQygPnsim3KUjQ44EDk-hxq39p4agJD_Po&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA67btE4V5panj3bL8hEiCQRH8ZglUvMXJehNjv1enT9g&oe=6A510664"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440v2-neon3.png", "id": "1676340970062461", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618297_1676340973395794_4887370990995498402_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkCKB-yQbCYQ7kNvwFrtXDO&_nc_oc=AdoaTS2AFPr9rdLkAYVBCxBD6Myyp9JQTznI_sHnR7smwwyF9Pr1Zs9SsuOxdejkg8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjXK0w1aM8y1Wd2PfSy8naPyTGzN4sME7I4SmoXwckpA&oe=6A50E8E8"}, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade", "rhythm"], "long_description": "DanceFloorVR\u2122 \u2013 Step into the Rhythm and Rule the Floor!\nMove, groove, and combo your way through genre-themed arenas in this dynamic VR dance game! Whether you\u2019re chasing high scores or vibing to the beat, DanceFloorVR\u2122 turns every step into a show.\n\n\ud83c\udfb5 4 Music Genres \u2013 12 Levels to Master\nChoose your groove and unlock multi-level challenges in each genre:\n\u2705 Electro Pop \u2013 Neon City Lights\n\u2705 EDM / Cyber Rave \u2013 Underground Laser Club\n\u2705 Hip-Hop \u2013 Graffiti Battle Rooftops\n\u2705 Synthwave \u2013 Retro Pixel Arcade\n\n\u26a1Each genre has 3 progression levels with increasing speed, complexity, and unique wall visuals.\n\n\ud83d\udd7a New Combo & Badge System\n\n\u2705Hit 3+ perfect moves to trigger glowing COMBO chains\n Unlock Achievement Badges like:\n    \ud83e\udd47 Combo King\n    \ud83e\udd48 Sync Master\n    \ud83e\udd49 Rhythm Explorer\n    \ud83c\udfc6 Bonus: Beat Champion (Earn all 3)\n\n\u2744\ufe0f Bonus Finale Level\nComplete all genres to unlock a hidden Snow-Themed Stage with its own vibe and difficulty.\n\u23f1 Over 40+ Minutes of Gameplay Designed\n\n\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.com/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.com/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres":
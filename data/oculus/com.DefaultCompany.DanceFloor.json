7&_nc_sid=6e7a0a&_nc_ohc=oB8ljC0pk8MQ7kNvwER4oqf&_nc_oc=Ado0nRV0ucpPstF1DmCSu7SluDDuaHu6PUcj74xPMmxU2WavAFKTwCPFrPNBRxfnZVI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvrc3iP0ztXA4dlIDT2oPwJ86ouDC2z0-cZunq49oAMg&oe=6A846544"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TNSaI9ecVcQ7kNvwH9wSLL&_nc_oc=AdpLF8jslvKTaOrlzlmIGc1cKwmxrEujoSBXCSP3mn4oJZtmiHThaTYz7pLVP8tlAAs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSIQ6a8X4l1etZL7gywtK1D9lNYTHBKKHzGztkTv9F0Q&oe=6A844F8F"}]}, "id": "2432589163760004", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "507042665792771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391991_507042669126104_8045757676306318155_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMRLxqCmwjIQ7kNvwHpLB2H&_nc_oc=AdofZ5x4_c58OLm0GPG3J02hrUKVRCbvsewlmOkZNCuOLyxzau3fdnY7ZgSD8gKx5bQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkUbveh-F0fbv-nYpapsLIDJF55HXoPvguInRTv_gTfg&oe=6A843964"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zFXQcIKSxQQ7kNvwGI-sVF&_nc_oc=AdoSkM3urH-UC6O1ShG1SR_j5EiPcIPyKDwWeyIL7ggHKLOG9tzBJfSS5NzcmHGZyc4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4dEUb6V2TH6oEwnbwUNv3gyrhocpGTUzyWnxgXpPaKg&oe=6A8459B0"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpJZFrA4wtgQ7kNvwEGOd4q&_nc_oc=AdqbAVx650NNKrJ-tqKpbozEbBmXnYJ4irKiiVS308QAFMv48J-bafKXQ9gZhnjhJ14&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESGeLomfz_PnAPuF_V4jgJSRxdEsj_auDxEIH-jy_O3A&oe=6A8450C5"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCqGqrMTXtMQ7kNvwEvmAV-&_nc_oc=AdoIHMgoLrgHhVOpH1qMizO8mWQ1uFUMDBfQDqpKp9X4KgpToPA5HGoSiAyS-ypCArk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_jFcH1iCBE0u1kk2erNsL6sYEH9Z3BCY_C1-tOZURDw&oe=6A8447A4"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DosJ2W9I4VsQ7kNvwHhZIkL&_nc_oc=AdoNtVGx7MZr9vSoyw6lRGKTcCosO3PliwWjCwdCuGQhgDoEyLz7XA7zLOHchGRO0rg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuxweZ6L5ZmV8nIW4ADra6YBD4nM6HmKe03dx_K9sd9A&oe=6A845337"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "1188312709333188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742474700, "status": "PUBLISHED", "id": "1188312709333188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
7&_nc_sid=6e7a0a&_nc_ohc=1nec18bn1u4Q7kNvwHtd15v&_nc_oc=AdpGd5SyZpcdlQgckdA8MhgFCmQj-utXiTEaZgwTfHNvrglRGWL9z514uWyyrCHboGc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_mWKg70xCraKRSB3CTN_BkMDTkhvBeHQ86rQ8ltjZNw&oe=6AC7A1C4"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVO3CbZ1BYkQ7kNvwHQwwWf&_nc_oc=AdoPWbYIREr0o9X_qvLhJCeLZJ9mosMmpWlVtAUKLEbKBrVgdHzF2oO2Z2Z-xUtrlVs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC4eChQ_CEtg7pFwFiDFoAqB1MXEIHMjSRHwkJcDt1rg&oe=6AC7C44F"}]}, "id": "2432589163760004", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "507042665792771", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391991_507042669126104_8045757676306318155_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NETKFHXtx0MQ7kNvwF_PJD_&_nc_oc=AdqT7vT8V8kjriqtffX_4jxBj2ZibbDIhQ6u6TwTh5WJju1tl3E45ShWYXwc5F6EbjM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfnGREh24f-Y7c8SuTQVCDT0awKaWLxPTT7zXKdQm8hQ&oe=6AC7AE24"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZqEIuEHm1gQ7kNvwFlINS3&_nc_oc=AdraZI-VKgbYYsCZydA8silkvkbn5rH96lN0u2HJNeL8IT8TDJ0yv-W6zi3YM2TVADA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_Psrzjx8MT1AZKOHH-eoutTaLN-_n3NH8MLx30OZn0A&oe=6AC7CE70"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38jjkn173eMQ7kNvwEaqaPm&_nc_oc=Adq8grjO6TUyY0G0dSkCI8KStldj1Jb76o91Nromae-IvSRZGGsmWG_TBi4pHeInONs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrCe5uDuKBsXIDY1CTjcAcKtbJKHW2r5lVDaOJmse6FA&oe=6AC7C585"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewycnxQ-XMMQ7kNvwFysnqH&_nc_oc=AdrMXKz514FWyjfjUE2Wirm3gaKFeg6zQGAQMNcmMlVA7L2VT5rniMoZB1sC6xGBQXs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNj__V3yxY4IS0XJE22EVPv8C3qiXjIpUqnLlfxNHbSCg&oe=6AC7BC64"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im5knULdlGwQ7kNvwFYEM39&_nc_oc=AdrSzVGSzQZH0wvApySvaGNf_5qhNUIfLZJiUWsI0VbkI2p6Dld7YsL4BtgAPSoQHws&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_SiiEOG84qSRox8669ezYsrKoGeCNC03nUkmIk9BmgA&oe=6AC7C7F7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "1188312709333188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742474700, "status": "PUBLISHED", "id": "1188312709333188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
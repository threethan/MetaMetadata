jVUSXX-gVn8ym_IUmG91X795WsRfhK4w&oe=6A64A8CF"}, {"file_name": "party-screenshot3.png", "id": "2877449459272448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620817_2877449462605781_4517218137279365623_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yky0jKqwIzgQ7kNvwHIK1mc&_nc_oc=Adocq01l1o-9GIwR8dyt3huFeonSxULKMQJUK7y-tHkbJTy9zxpZ2_jBK50rLtcrZSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANpFRg2F7PQD9Hl-HvBr5jq2sMcdbUYojauetOa66qkA&oe=6A64D2B6"}, {"file_name": "screenshot2.png", "id": "2029407427797804", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300897_2029407431131137_1932227168694123530_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27Oc_G-9_LAQ7kNvwFXUZQj&_nc_oc=AdqgpzoA5EMDmERbH4NAlX3awfD8KdC_5V4dOVem6gvpMurlqsJwoQCt-ZqMnd-IkT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-aYmjBNHVS926FD_foAMOkOVXcgScLG4rZH4CG-_7iA&oe=6A64D0D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_2560x1440v2-neon3.png", "id": "1676340970062461", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618297_1676340973395794_4887370990995498402_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5CPnrwi0hoQ7kNvwE_rcpz&_nc_oc=AdppfKLg66GeFqNkexNNnMCOdyIh_K5bijooU2spcC8XOkIGZM5p0Z6KDX2YGqv5Df4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtCfqY7iF4IkJSNNHkXkQAKE6M5m3w6pC_V0NFJc40dA&oe=6A64AF68"}, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade", "rhythm"], "long_description": "DanceFloorVR\u2122 \u2013 Step into the Rhythm and Rule the Floor!\nMove, groove, and combo your way through genre-themed arenas in this dynamic VR dance game! Whether you\u2019re chasing high scores or vibing to the beat, DanceFloorVR\u2122 turns every step into a show.\n\n\ud83c\udfb5 4 Music Genres \u2013 12 Levels to Master\nChoose your groove and unlock multi-level challenges in each genre:\n\u2705 Electro Pop \u2013 Neon City Lights\n\u2705 EDM / Cyber Rave \u2013 Underground Laser Club\n\u2705 Hip-Hop \u2013 Graffiti Battle Rooftops\n\u2705 Synthwave \u2013 Retro Pixel Arcade\n\n\u26a1Each genre has 3 progression levels with increasing speed, complexity, and unique wall visuals.\n\n\ud83d\udd7a New Combo & Badge System\n\n\u2705Hit 3+ perfect moves to trigger glowing COMBO chains\n Unlock Achievement Badges like:\n    \ud83e\udd47 Combo King\n    \ud83e\udd48 Sync Master\n    \ud83e\udd49 Rhythm Explorer\n    \ud83c\udfc6 Bonus: Beat Champion (Earn all 3)\n\n\u2744\ufe0f Bonus Finale Level\nComplete all genres to unlock a hidden Snow-Themed Stage with its own vibe and difficulty.\n\u23f1 Over 40+ Minutes of Gameplay Designed\n\n\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.com/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.com/terms.html", "publisher_name": "Jessvrworks", "support_website_url":
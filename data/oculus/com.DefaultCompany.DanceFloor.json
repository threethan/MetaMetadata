-1.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyG9uK4LqEoQ7kNvwFmTKzh&_nc_oc=Adod-1JsQpTNoQKAPrUfsBL864snZaarbf2izxPypjAa5bKC49gaYXDQLMoKgsSEcBQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5z7k0wguXLCMBD5Bi0KqxbbRUmZkG-3zetyJnrzAk6eg&oe=6A1055B0"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LTw-1t9hZigQ7kNvwE9fyLf&_nc_oc=Adoyk6KxFbB0bNYKiMhGwHd8fsWxv1l1v_gbOhlprDOI0E6vAMhJSSfuj4tUbGfZ-cQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XKkHeukt-KNd77wzl4o8eSlBUdS_FeF5i5g21Km_YnA&oe=6A104CC5"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKjkrrpcFCgQ7kNvwGnK9y_&_nc_oc=AdrYkfapkH3IHB2OqCPDEtPxU9m_VNXAR_kpr6m8xFW5owlhJMTn3_vpToTG_-w4rhg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4r-iEGPm7UYW2pTtq_8lZdJ8VlDztXg0eMZlV8LWe9WQ&oe=6A107BE4"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uw5Q0ClVD7wQ7kNvwH_wi23&_nc_oc=AdphnUnst-6yAjYC01MATsvn6ZE-BMTTNpikFhqOXcMKYGXUfjTDXZAnHH-YDYp23QA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jX6jN5DgzFUpsIy9XqBdlNF1jBe9bAQMQfRUjWNtQVA&oe=6A104F37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEM
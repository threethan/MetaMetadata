7&_nc_sid=6e7a0a&_nc_ohc=-NlJHSIlNyUQ7kNvwEChwsr&_nc_oc=Adog7gYN1DNi4JEY4Vtm1Yi-ThxNLZlh1Qza72uXrFexj-jUXR_W_Vq1LIZz0Io8xt8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETCyf4G2Y20FGM3ttYsfRrZQ5C47FSwhk_kCcJT6QXtQ&oe=6A8C1604"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4mWb166DV8Q7kNvwGpwRYg&_nc_oc=Adq2kCq7N86pg610ojQiAJQsqKAxv8osgdWoXdFbXn1iYVHFddxP-hWPQrXRClO0bqA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_19Viem5X7ol9m2X8VnbqP22Cx0C4aLb82xnPnCabJA&oe=6A8C388F"}]}, "id": "2432589163760004", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "507042665792771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391991_507042669126104_8045757676306318155_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQv2tLlFOvQQ7kNvwGw0N8d&_nc_oc=AdoRTV63BKiM_vJMomXgzjkf0yGLGCBdx-c9ph9EbG7k2PgaMppExh-RKrgUMEd6w5k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf2pgRrIPumikgXDwL-qhuCUrh6NeWlxiN3lxKp5Xasw&oe=6A8C2264"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmOVvqzrHKAQ7kNvwGSKU_t&_nc_oc=AdqiY60kQk-B9htNAsgd63WHHWgJpuBtChs-fJMehzpmTSQLPlBThq4p0HGtxsP4aH0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5H1VOMYtVSn94e0MI2Aj14YCc6KU70WarZphBRS0Y1A&oe=6A8C42B0"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwAIE_5p7YEQ7kNvwH10kB-&_nc_oc=Adpemx4KCtkD5z02TtQSB24uLJr-ffH6WeQfHAZHxvypB6Oz42r5_yafTtVSEMpMlZA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAFCx79U9uWkRZKfmmv6li5kgPdxCgH7IhINzmdhKTAg&oe=6A8C39C5"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gwjr6diUVuoQ7kNvwFMQIkh&_nc_oc=AdrQ2FqKqVajfL4ycuGj9akjBFFlf6NHoXwKBHqgUoriT9-Xy-9mq9aDOcQKKd4-ybA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWYr9CFkd6yFO-tnNwZIprex1LvQu3cHHpKHtFH8EEHg&oe=6A8C30A4"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxZfRHrwAFMQ7kNvwFz2rOY&_nc_oc=Ado0bgYpzxGgkBriHiGg_bheQqZbLggjGaDASg2c-PoDGQ4UHZmGmltICP4lChR6y-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4-7N7Gn_DPgVS9zRdFgufn6Sm3gqBpR_A5LMVadQsow&oe=6A8C3C37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "1188312709333188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742474700, "status": "PUBLISHED", "id": "1188312709333188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
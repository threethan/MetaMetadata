-1.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFYQCP3k6q4Q7kNvwHEF8YO&_nc_oc=Adq8Y2SICTJOJD8zVsSoET-CEoUsP-ajkVAyF_OQrgx9P1DhIwqz14HNt0ekQbcpj0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w2QhzgC1ju3NLIViKWyzCWhxNggSfISGDP1JfHQoVBw&oe=6A159BB0"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-g20Gai5SL4Q7kNvwG6s_yN&_nc_oc=AdpbHEu_zg8yx3yqj3l4KwHxqO3MBxlsMr_toPXUv7nHgA929xI95bZNyjbhMttoaPc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65UepwFQQY5u-C9ZQRELjO6gdUmQq_pvKuVSpBv0z8lw&oe=6A1592C5"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMSynJPoopYQ7kNvwGOqsbA&_nc_oc=AdrUXzOt6gdx4eoBo_74xrQl0pRyg4Eqwa74JGBgrCEaODbHhqr40kMj8XUY_Utcwok&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q8m8M1Zq0Dw2gvddEjnKTQhEUsAXESvlf3w0MdwNW1g&oe=6A15C1E4"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTfHlm9-dDYQ7kNvwEF7d_O&_nc_oc=AdprNx_CiHa9yau_UE13KU4AErHS3dzKn0PtHoRe3a-dDG42KJdupUFLXVWmNg5f-cM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z4gWMCLdgdZ9HS_4hk-0WcB2OKBKHie9K6kSFB77SZg&oe=6A159537"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEM
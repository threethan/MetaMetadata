-2.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnJhn5wUIjkQ7kNvwGnNtOE&_nc_oc=AdrwlcNgAGNKKeqXxBqgIewG4eA9TTGSEOVIPnXZRQcOnzoU9MvDDXw4UFsFL4u6nXs&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d6Kse7MzmppVFQObmblP2nQWh3eZsvgPDFt_ihZZFjw&oe=6A09BE30"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGotpTj4QU8Q7kNvwFTC06v&_nc_oc=AdoboGYVw6Ujikd7D1A8f6ptcKOyN3yqd9wi4zK0EOUEM0lDnc79KrCnVHD8itwvif4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ggqiKlbOJI6odHBzklWZooDcJ2ziEiIIvoXOrpOamwA&oe=6A09B545"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1xLYGutAEgQ7kNvwGhCvUM&_nc_oc=Adr5SJAGZvPgkYxbj4vJjQ0G5scwEd4cATWJ2WVPvhmgU0QMgtb1EN-pX-hU4OCT4hA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4puwv_LTYrLyZvELIYtA_yXbmdnlDt9QyAvTtv2Dx77A&oe=6A09E464"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=deJB4-3Iid8Q7kNvwGocx8M&_nc_oc=Adr68j9HSUab1NzsMwc9jsw1BlaP9QAthnyspLa0Wy-G-kkXeLG3f78v0gP22TVK9aM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6itr-cqQVD6WKr1I5yKY4b14Zfx2szIjK4GxDTAqAATA&oe=6A09B7B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEM
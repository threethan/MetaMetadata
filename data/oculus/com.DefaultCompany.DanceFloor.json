7&_nc_sid=6e7a0a&_nc_ohc=STzyVfTznrsQ7kNvwFJyB8z&_nc_oc=Adq-oHskZx7BCOvmLRMPTinw3kdyHPBrU5LTsQ8Srj9g26-_EMRicCAWlv8OIz7LHI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiCuIpZ81MKEFn31gLS8byTFL_oB7wPIx1RMUqGjqxVw&oe=6AF8A184"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUF2IvsD4hkQ7kNvwGvt8gt&_nc_oc=AdrkRxgPBAzZHUTB_Zmq41F0_2NgmHOMmkr1gdTw1Zxno1NMkSNQt0psJXeqI-fP-GQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxRzXOE4Do51qj4q0dyc27cIYLeZYYoSCkPd9ayLdkKg&oe=6AF88BCF"}]}, "id": "2432589163760004", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "507042665792771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391991_507042669126104_8045757676306318155_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7cLHiGfN14Q7kNvwFTPI42&_nc_oc=Adrv5QQBNM8C3V0HAb6uAsyfOV53SNmJ14sevS0aDNRkjHVrX2Rds-9mV-fg5JYVqIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLCHVHervoOstTWeLVIwQoYtJPXkcWeAFsLpeuXng9yQ&oe=6AF8ADE4"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzNTvgpW7UoQ7kNvwFVJ3cg&_nc_oc=AdoJj4pntwp6YfMH6VQpdz91H-9wuVqzrOa1b-itkWY_PzOi-VQsJ8vZz6gIlBEajgg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7aFfLJmaAkiUFjUZR3VA9XF_FU1WHTXIxO9dCmEpNiw&oe=6AF895F0"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLsiz8OOzBkQ7kNvwGm35r7&_nc_oc=Adrrj4AMJ1S_ootAPHg8U0VA0JZNHgBXGVKpnoa0SaqVutZbLTcGenQygnHl7fWPm3E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFEO4au_-Jfowe-i1UuQ39T_g0RufC9nfuWPQIPvz8EQ&oe=6AF88D05"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd5089-PhFMQ7kNvwGmIDxp&_nc_oc=AdqrmA5Dghni21TxDA7Y742FkPLwGKWfgZz-vidslhVD69qm9B1xy7r0NXqBoJtqrSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRc7GbXzjsOEaFIQV81ExDDcUdNLcOHWNUgMBt-lMh0GQ&oe=6AF883E4"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7eoNn8fTIgQ7kNvwGAyuMB&_nc_oc=AdqAt1Hw37GHAFPEVS7bVsuiFTna48Kjac3xu5NgXmyZbB4k5f_UzG2KbnwDCWJsn6I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBDG7eb-ly6wBU2RHu9a4OU8ueM6Gx0q9g-evSlVFUVA&oe=6AF88F77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "1188312709333188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742474700, "status": "PUBLISHED", "id": "1188312709333188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
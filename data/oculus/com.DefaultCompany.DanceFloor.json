e4XwMfzz_-bTVDA_WmLKg&oe=6A68C224"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnTa5HMxeJoQ7kNvwEzulI9&_nc_oc=AdpBqBQZyAhTFp40sSM6gWHzcCP2Fo-7V7Vi4tp_kjmT7b-dmJNsOoIaq3ezNn4ezEw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-n-dVePkp1imYb8-LJZJu9cjxeG1MzusU_Qu3fcCqiw&oe=6A68AA30"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cqTMtAaVzeMQ7kNvwHRXGu2&_nc_oc=AdpmU8Ikf8Jv5ebb3GPFC03d-lYtwBBpcHFOlpiZB0dZCuCm8r_iW6dyD5yKq8OL-_U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAo8iE1I9OiaHIVRASN1JYTq7fpcLRI9A-_OyHYIFRGHg&oe=6A68A145"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16UG6pKg9iAQ7kNvwEmgLM-&_nc_oc=AdqRaDMFkB3X8TyZN2yvWeB48w0iX6oCGFbp9q67_V-YxE5IvGPaCfJ2GtDSaRlypWM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhuXnOrJxyJmf5SGzyRJW75mbhjIy3FexUoivjf8kIvQ&oe=6A689824"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKRy6Rk5PfkQ7kNvwGVIxgF&_nc_oc=Adp7ziA1VW2SCxGM4yKC3HT4jr7RC6l4HH1biSNDf3zUAN3kMYv3rHiQooX4MsEADUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYiLWe4PpeLVmw8fvAul6vFQFyOn2aHnVclXRKHweBpQ&oe=6A68A3B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscri
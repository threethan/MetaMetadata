fsRDIYKbW0-ZLP1hMt3-XlostqM6LWz_qKdSQux7NFHiMec5KkepRNqcRHI41DBk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54oxzjDpvI8iHbT5aSS0VGeDr36rf5gTXSHdeCqPMPhw&oe=69FB4944"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6f23irKKmYQ7kNvwE-DjjQ&_nc_oc=AdpkMPttI3krsO4J73kg0FCS0nvvTGZyNHll3-4uX2plgtO9-_2G5F6ZWUGi7CbC674&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_dK-JISw1u0ozmTG7Mzgrhp2oq6_1ejHcseUi2AgYRg&oe=69FB338F"}]}, "id": "1586167559298937", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "1877974659741515", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310896_1877974663074848_1873784755076576078_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFr8kUMbsJQQ7kNvwFUOu5F&_nc_oc=AdrFqWCjY_Gv70mh_9VIPpeIrxEzVe69wpoxcx_myK2t7JeB2wEU7-cODeoivDKdcOU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kXLYHhuHUlXxygNUPCSgv-F_QVjTtsskG3B5zKTf_Vg&oe=69FB2E61"}, {"file_name": "screenshot2.png", "id": "2029407427797804", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300897_2029407431131137_1932227168694123530_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiR9D_wHfyYQ7kNvwG5EopG&_nc_oc=AdriYN6GutaqWPbM9OL85M-ljA_OiRXpnszd5sliv1Dk73I8t7IPC9DkCayU4fBuxWA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53VTh-QxWNBcdAW3Rno0LRmI34QXn6UQ4xCx9QCnfecw&oe=69FB58D2"}, {"file_name": "screenshot3.png", "id": "1528662618579631", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618254_1528662621912964_6700960828432675246_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQwQ_327zMwQ7kNvwHivW39&_nc_oc=Adq8A67BJPGCz42s2eJQG2yfaiec05szOOLbTxumS1Mc5lMlrqxGV0yC0b1cVhBTkww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YjBEyIpB_X3jWhS0Y-8-yQe9dR8o7wyAM_lhKIF33FA&oe=69FB3328"}, {"file_name": "screenshot5.png", "id": "1973472886838925", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619078_1973472890172258_1321755227202967019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-3lzuRZJUUQ7kNvwGO0VJE&_nc_oc=AdpOa00u68hMG2ZWlyIyvOknWTQtkKxYiDMKG7euoHnFGJruyNM26uEkAMtgiM1otbU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PFWnvrOQbJIscFBx5bDVwcnLqVyng-7zdwI0_3-88Mw&oe=69FB54E4"}, {"file_name": "screenshot4.png", "id": "775069592058872", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300913_775069595392205_3776958193569187234_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLjwkaZ_0sUQ7kNvwEp3YB_&_nc_oc=AdomEtsF94ykMfn8nH28qq83hBp409rDLnTMLSXIOTltGNcQtWsQ4l7B8U4-sGLA0nU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77pdaytohI-YZ-4zL9eViYJiFoo-P1KQB8zDEBJcQnAQ&oe=69FB569B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade", "rhythm"], "long_description": "DanceFloorVR\u2122 \u2013 Step into the Rhythm and Rule the Floor!\nMove, groove, and combo your way through genre-themed arenas in this dynamic VR dance game! Whether you\u2019re chasing high scores or vibing to the beat, DanceFloorVR\u2122 turns every step into a show.\n\n\ud83c\udfb5 4 Music Genres \u2013 12 Levels to Master\nChoose your groove and unlock multi-level challenges in each genre:\n\u2705 Electro Pop \u2013 Neon City Lights\n\u2705 EDM / Cyber Rave \u2013 Underground Laser Club\n\u2705 Hip-Hop \u2013 Graffiti Battle Rooftops\n\u2705 Synthwave \u2013 Retro Pixel Arcade\n\n\u26a1Each genre has 3 progression levels with increasing speed, complexity, and unique wall visuals.\n\n\ud83d\udd7a New Combo & Badge System\n\n\u2705Hit 3+ perfect moves to trigger glowing COMBO chains\n Unlock Achievement Badges like:\n    \ud83e\udd47 Combo King\n    \ud83e\udd48 Sync Master\n    \ud83e\udd49 Rhythm Explorer\n    \ud83c\udfc6 Bonus: Beat Champion (Earn all 3)\n\n\u2744\ufe0f Bonus Finale Level\nComplete all genres to unlock a hidden Snow-Themed Stage with its own vibe and difficulty.\n\u23f1 Over 40+ Minutes of Gameplay Designed\n\n\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.com/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.com/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
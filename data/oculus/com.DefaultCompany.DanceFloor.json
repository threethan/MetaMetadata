-3.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FioopzeWo18Q7kNvwEqSQ2F&_nc_oc=AdoaOXPDddJT98n1zRn_rbSxu4sfpd8fHg4Y23ll6Wj86132oXC2ckQFrkFF5sCsZIA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9q5U1Stjoev5zxqrNxvRNiyjjIfvjZ951zeLZ4gwaGsg&oe=6A217930"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xY_swt9mT0Q7kNvwFO9K5j&_nc_oc=Ado9WDHmElBEswNnMMTtvrS5-pQ2m7lnqOnmSo_7AHWi9wcPuYWLdVw_yPkU99WaJ3c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PVPIVkKZQTy9LjmEE2Y-KtZ_uAUKmld6uEdsJPh0k8w&oe=6A217045"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQ9OWbb-mIMQ7kNvwHrSaoW&_nc_oc=AdroI0DYv2GWIZjcIJLbsrWjm6ciwjIGBfu6IZHb98HrqsH0zI_IRr4NGfXegkpK2aA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NENPFnaNaC2nn3UvUjJah0QhMnQ6Sf6vhAEbn4f9l5g&oe=6A219F64"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWqdCs7IJNAQ7kNvwHeO52E&_nc_oc=Adp1QO6UKbDdtBB8D9ic0B0lxNqdLlrXEtFMgyDDRA0TyNsS6lWkjUs-iD3cESfzMPg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80TSv5o-UGh4WuRC7Ks0b_X4s4rOiHtvdz3sSLLD4BCA&oe=6A2172B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEM
X62aEC_GJTBRcZLN85edw&oe=6A71FCA4"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZofIh0Ledc0Q7kNvwFW6R3p&_nc_oc=Adpe5xXxF-RNeSUyFDYC9QbS2yY5p2zz0pRFm6hhSM9mkstVqMCDvNWpdgGWzmSXtZw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk1m8BSRPHIpX18VOwWKRRDSePg7bPkwuFsfPqJcypkw&oe=6A71E4B0"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfnNGEPxArsQ7kNvwFv-Y2r&_nc_oc=Adrxg_CxpRwE7B7ymmUqmw9Hwo_qJx1ft2G8ICkF0IOscLaIsUFeYoImxWjlBhhySnU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0CDHMBNdLANvtIl2Jaapwfn6GnlL4b5iffjcVXuiqFg&oe=6A71DBC5"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Go8DMyKOZIQ7kNvwFhEfgs&_nc_oc=AdohLxe24RRSfAZdaMaJWlJoMsECT92J2MDSzcNcxXW46ntKupre7QuAD8_uuZlb8j4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEYMtU0LkE5uE-tVzvkvmn_L9NOH_ltliXm4KDLypjNg&oe=6A71D2A4"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=URk7TDleXqEQ7kNvwGxj5ST&_nc_oc=AdrWuD-9IoZpTOYv4Qi7GjTqN6_bdB-iFWQ_twuBv7ZkK6wn5QLMtV46c-VeRa6DXPc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8J_OKFzYNXGmDO5NI5Ag-DybBPhxBZuiGM-gPb2MRsw&oe=6A71DE37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscri
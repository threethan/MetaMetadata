7&_nc_sid=6e7a0a&_nc_ohc=lJwkXmNnx0oQ7kNvwEnEaBF&_nc_oc=AdqNuCWzXY1nNbCBNvVbW5lgT58vK2d5kgl3uairLWLjB6pF-FvQ7dfx2Qqlrxwt2vM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYP7mqF_BIyHcsgM4Od_p0z_r1boDIk5f3w9X8mdHJ4w&oe=6ABBC444"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9PkfPBXada0Q7kNvwGojW8Y&_nc_oc=Adoa6q6w5BR-2cFXjyh_qPwicFJtRx7lyHoocaeDCcgMFYhVdsKxmX-QVRLAYmAkHSc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEclcbgSh8BoB3ZMV3XZxzWP6yxOi1RAmZTiWIyLqJpQ&oe=6ABBAE8F"}]}, "id": "2432589163760004", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "507042665792771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391991_507042669126104_8045757676306318155_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btgNs_NzJYcQ7kNvwEfh_xG&_nc_oc=Adovxyu8mYNemaXBZt0Pfki6ymADOFbiuFSluZyNpo4ABit-Cm1ZF-xz_0foDCG64Ck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXqgOA2xlU5U7jEFzoaeXUtFOpOCqpF1nJhW6lcPaXAg&oe=6ABBD0A4"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec3TRXESfhQQ7kNvwGdjEBK&_nc_oc=Adqk31f2AF8t6mEVBfrgmeNwDrkcEu5Voy5lSf6ITeEE5F5-9saK5Jn-M4poBkWwIkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYLreIRwPmrCPI9nM2V6qrlJJziKHlUJGsSrGFEdsSkA&oe=6ABBB8B0"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTijaT-HFqcQ7kNvwGQ9bDk&_nc_oc=AdoO2vyszrGaEaefwgkNcZJT_Tsw8corhYL8WdYIohX0HJMvAVIItcE7HMJELoWLv1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCNADkyjUyIBsJ27JC4yw78Iy0cNBT_VuOiEh5m4Dtmg&oe=6ABBAFC5"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfTlqAWp8msQ7kNvwFVDiIL&_nc_oc=AdqWFB-ETijheNn8gxxUXrYRtsQDSRgMMYmleju24eJSBXyMZDWfR9U42ygZb4ty2NE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxdnMhcsOGmszNLv8ah-CmeZfQwMzyLtyadrM6RGCRMw&oe=6ABBDEE4"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM8_-v5X0w4Q7kNvwHTW6YX&_nc_oc=Adr5AbtSXlXOCvWMiF5k5okpz-PJv0ChFPk98v0YBJgCY9FX0RuP5H48xHHoBmPhE_4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxY15ExR-GYBqQp7B-HMHmlD00hXtUxwx5Tkw5wtVK_g&oe=6ABBB237"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "1188312709333188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742474700, "status": "PUBLISHED", "id": "1188312709333188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
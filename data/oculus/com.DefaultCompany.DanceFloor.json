-3.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpjpWz4RBhcQ7kNvwE0y_c1&_nc_oc=AdoDE0RgmfbJK5XJ_zNP6MqAPCJZXjSlfRfASqDWC5NF-RklDl-uBwou0jwIPJoKLTU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XGVYMaanOoK9WzrbHQjSwCoRvQpQtsQhVQTlLFarxZQ&oe=6A1D84B0"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ga3KyOL1AiIQ7kNvwFktBLU&_nc_oc=Adq42bRwgvoK3rNH2T_F5c9sM6QpcNtPRPcOOt8NC95GZbAzthXOLgL1wLy5GQapbTo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DkvD_1n0IbgiYru_EiRQ-JMPpmuoA2F4yAhYU-88dTw&oe=6A1D7BC5"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsO_I_zmX8MQ7kNvwHYmFuB&_nc_oc=Adq_msG9gA_Lnrctr7JqFVDP6g2UbjQU8l5OzKmd-b5XEgXXWeSbyIqNZjvNxyHfLZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u15coDEcPTO9Qq0KmYZVpjw-cBHjDi-e30EJltmXO_g&oe=6A1DAAE4"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8QLy8ZRGrLsQ7kNvwF05iXM&_nc_oc=Ado1Dd1C_KwsyJkLdinKcMSAo0wz4f2uvkOYUIqoze5l7wfexpNsM8--uWNkMQhB6_E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EmaqZAQXcl6ID4vX3EAIx3xo4Zehlf_sTYxn5qTzXWA&oe=6A1D7E37"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEM
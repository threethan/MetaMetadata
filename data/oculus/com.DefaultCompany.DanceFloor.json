7&_nc_sid=6e7a0a&_nc_ohc=CieaTYikj1UQ7kNvwFOuVzi&_nc_oc=AdpZhxn-Yv0HYZep4hT4tYLV-wgcE6YlZS_x4HJ8O0QFj_NBlcsZHP1zt7D1JCOTa0M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYeVwQleKQ7KTYV8pwCEjBQnqqHwKZ1YqShkBTeOJe5Q&oe=6ACCE7C4"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRILYIGANysQ7kNvwFAaYEA&_nc_oc=AdrWf-B4l0t6u3jI7gFosPIsf04KAnoiboFJMXzs9I8TxmJI5GNUVA-Uqcx4BS2J9eI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9bsrsdCpTiPG_l2BLtPITBFaQfh-Y1k7U-yHhm47Jiw&oe=6ACD0A4F"}]}, "id": "2432589163760004", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "507042665792771", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391991_507042669126104_8045757676306318155_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZ_7ufmHN30Q7kNvwHlVOVO&_nc_oc=AdqETDAZ26HfoF1mrCRPquehRKBJ1wq7gzwZvdcAMFWZAQHlLOjdN-bdC68ZgdK2hf0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSiRvCvIVZmCSwsiVjrMRlok_DZm6lcA8HMfrPIIM3aw&oe=6ACCF424"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghMM7tPE6p8Q7kNvwGyiMdv&_nc_oc=Ado9MvOuuh9D3a5wXHJYJG1oBXmPSzi7mVZQ29aC2VshN81q1PpTYQ8HhltGd1J1UYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNKbjCpkmQWAsFP_svNrD-TxZSoHlO11uAsaFjj6pOag&oe=6ACD1470"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbj8bWbjYj4Q7kNvwHGHFFt&_nc_oc=AdpOQfpiyuR4VnpzYgFwmlqHqnK3L2B8CSUlRah08sloK6Oiw_7W-OdjSILXusIlLJg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2VMm2AtyyNZJY8tKLN02Hj4KcWSwC12FXvm-D4FemWg&oe=6ACD0B85"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D-qQ1e3N60Q7kNvwEJMvxW&_nc_oc=AdraIqAg_2qjF-Rgx7ac-AnuwE56UL7QCjPW5xM5vWqrUVjyiirq8RF0OT83trxI9Lo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCRaMs9o70-8dpHmW7iBi04oEtfOYB9oYSsuIaSpKzXw&oe=6ACD0264"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad0xW0qp-VkQ7kNvwHs6RNG&_nc_oc=Adow3mLKh1N0ATVjuT-IMwLrokIj5gMB6mVGtD7m8tWJzQMVl8gOkBU923WOx7VCCUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrv1czskf4K_ckbiSLJo2FGmcGXQpk2CL72-ajCcd_kQ&oe=6ACD0DF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "1188312709333188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742474700, "status": "PUBLISHED", "id": "1188312709333188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
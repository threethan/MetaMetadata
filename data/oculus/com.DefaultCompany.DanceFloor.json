7&_nc_sid=6e7a0a&_nc_ohc=np2QleblUTUQ7kNvwH42fwF&_nc_oc=Adpu4DkkD0TNJ2IeYSrEsdO0hwkV6enf1cLlbVnz_V1m3SdYiTry8sECoI1o0oYtCqA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3M49Cve6Pi9E4tcYqQsDKorraPHdwDozAfxnKU2NjTQ&oe=6AF717C4"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUF2IvsD4hkQ7kNvwEkXhUq&_nc_oc=AdpBmzAy1G1tuntaYzMjm6CfUwXOb18fP6rE1kgp7e6g5aZEpn5gSab5C0JAf8wPpew&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR4nbXrAazyZdlVfwu1Iw5sIDpdsQJL3u_1TPZ8sGFkA&oe=6AF73A4F"}]}, "id": "2432589163760004", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "507042665792771", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391991_507042669126104_8045757676306318155_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7cLHiGfN14Q7kNvwFDJEv4&_nc_oc=AdqENKjPm5oHIFhDYGC7LaK5axezxuQ56iKKzz6I8XrpjmvEAGoaBu5ikG5iNiPEkE8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_byM3HHvbRPNgZI4q9q-yJ2zdV6l2ol79ldDqeEUWcg&oe=6AF72424"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzNTvgpW7UoQ7kNvwEO3yTf&_nc_oc=AdpeVRwHb3qH5vG4RDRm9fEHllxDHf8oH3O0Hfmxxo_Eai9vJuyexpsqoz7cEuL4l84&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqoEgDG3rjkioNZwqWZpnni1Gheu_IzgKlKQnHFui0fA&oe=6AF74470"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLsiz8OOzBkQ7kNvwH0HFjl&_nc_oc=AdofxVRJoAOAlWOH3yXEzFGTVKF8seS9X44WvY8srrfh96vTucaq9qwE0lvuy15jDeo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2nIbXbOrbzj_DIEDB6nVWjPE9gIp_UgvBLfjh7Ynigg&oe=6AF73B85"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dd5089-PhFMQ7kNvwHVq7uu&_nc_oc=Adoj8ohiqOWy74upIm-1JszTFF-ZAMBbleiqyCr359bSf9u4Gpmm0kzMBENkEdND68M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5d5BTMsgO3eARyclvj6o8PnHKVyO0AGSWKkK8uMRMPA&oe=6AF73264"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7eoNn8fTIgQ7kNvwGV1gm7&_nc_oc=Adrg-UrZ39BSdpKKHyvONU2wxVfeYzMfhOO4Ieislfz-8b99cO7totvoNKSFOudGvSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8i4Z1ItuL8hd3rZ2LZ_FNEo6XNZ_7YDK3-vp9Hi8tFw&oe=6AF73DF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "1188312709333188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742474700, "status": "PUBLISHED", "id": "1188312709333188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
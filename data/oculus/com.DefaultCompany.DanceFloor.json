7&_nc_sid=6e7a0a&_nc_ohc=2ulDAem6li0Q7kNvwFW0qVA&_nc_oc=AdrQhU7PB_ceZgNE3pLiW46pwrOE9HwA7vzOsJ2nFkP3FeSdzsBIcLGsQRA_eSzgKxg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy5ctCSdiblhrGDBKWeDJjjwVrBdTbkNAsdGJqV1Q2Cw&oe=6AA7FDC4"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_N3ApFjzJLYQ7kNvwGOqJqN&_nc_oc=AdoU4fWqVg-y_bN-XZYNKPYXk0RS5XtuqlWwtGHt5AgZK84Kg0WVSMJVvy-3lr7sB0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnjMJaXk6kLOTYbJPoq09b_9Yg0Jhi7_lCTeGmY8SYsg&oe=6AA7E80F"}]}, "id": "2432589163760004", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "507042665792771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391991_507042669126104_8045757676306318155_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGY2aDfTl0QQ7kNvwFj5w52&_nc_oc=AdpBs41NUe-nI-GPzbl4IGGuzkQhqx5IGogiklhp6EGsC7L0y-OqkSrtL1ocjKDfVL8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyWCPhU6ao3Qlq_J1F5PjfR7pVJV1KlrsqkeX6gqc8Mg&oe=6AA80A24"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wYCMpYVYpMQ7kNvwFGWSfV&_nc_oc=AdqDP_E9pUt3QRipaxSKEOSLQHTFawzi2cvUrJRd_GloapOqeSKLooar3ik4-7sDI-8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy15YgcmIyLQtrVJkDIBehr7Y_-xI50GYWVtui2mkSbw&oe=6AA7F230"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pphm1e2p1IUQ7kNvwFQIhmQ&_nc_oc=Adr6PLzM2qtSViQLD33uKiJKdfgcB43EGYWw64TjkEyVXgGLnWLZlm7ZlNR0_suvPW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1-SAaA_qFCTEY6Q5NhZGrYnTOGnTjIUTU2lOhKlSjMQ&oe=6AA7E945"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=82U_PyKXqf8Q7kNvwE1xJ60&_nc_oc=AdoBX918wapbGEBx8dYNHdA_el2GCg7LnsX2xcrTb6H3FK-j7Dg6i3-mvi8CuaefgdI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU859V-K_597z2ut9i8eYykA9bTntL4RkS03YsE0j7_A&oe=6AA81864"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6LPL2DfRbwQ7kNvwE6Hud0&_nc_oc=AdoOZp69mkKu8-RGJ2YJNcmQO12UNfvqQJVhpFV6W1LSa7ZneY9PxsuK_N3f4m898QU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUXKGhdN0OsyjH_zkJa8SxWd_QoTlRpZJqE4k4BwUnSw&oe=6AA7EBB7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "1188312709333188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742474700, "status": "PUBLISHED", "id": "1188312709333188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
": "615612738015542", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392317_615612741348875_2498305108518180279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bMsskGUbZdkQ7kNvwGRt0m2&_nc_oc=AdqEfkyg40JH4bMxdFmm7I2Y8WyNF0fMFCOUMeaggBodKLGQ2wPQgKt4pNapfs_7QBc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cDNKGBTt4aMVmenhxlBZ5mM2JojytFn5dB1sgAJZyvw&oe=6A05D544"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnuJBmeuwikQ7kNvwH-Q67o&_nc_oc=AdrgqVO6-U_f-vQ7Jwt0Zrt7RoJO-nzzPoM01-T2zMroRsHg5gv49XtUWvTQop3L8Ro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44gxD9jEf7MsUvJ71qyeEC5tf7S0LzT-wbIE4q_bUwQw&oe=6A05BF8F"}]}, "id": "2432589163760004", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "507042665792771", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391991_507042669126104_8045757676306318155_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uetk7iD_UC8Q7kNvwH1TCm4&_nc_oc=AdpsyMS-FMZnU7IY1GBfmLCOOYI4-Li5GQ8gEPw7RXMhjadI3sWqut-dMcq4yC3VxxM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jD2EZBqga5TxCbmIlqkNJAKJfuL4w0DvFxnvG2arbMg&oe=6A05E1A4"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6KwybjHf2YQ7kNvwF0Z0qE&_nc_oc=AdqKz4t1KJ-tNvYj-5ubRblj8BG66ZtvW462bJ5JJVi_zuL5uzDO0MMsqvaes9yypl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W04OhPoJog3Kd4j9hq0zSW5xpx_IVH2Hc8dZUczQdBg&oe=6A05C9B0"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpqChFumf2UQ7kNvwF56Jnh&_nc_oc=Adr_TvZHjpf-YspVuFpyKQNdfGqiBj8ul4XY2FuW7M7a5JNTMICzUaLTs1p9XQU1aiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76qcxQC8pvqbGfAYB-RvsM0Z8OYDg5Dq8M39h5U_YtXg&oe=6A05C0C5"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Glqzb0BQtDsQ7kNvwEUnhxH&_nc_oc=AdrZlzx1XJ6Reh5-FQhdeeDz85yxbtF0bJjoJXPgVR0ScGWaeqSBfZVmpmUWBqLPCvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZJGlLJL3ILTopXw6IFTHQW2oq4GkIAE2W_uZNQoCWWg&oe=6A05B7A4"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBPunMVlNtAQ7kNvwH-XfiM&_nc_oc=Adq_1sJBhUUeDbYWWH1g5lJoU_5Vo_R-8g-tnOxExyNJQtX7T7E-jTKenf-kBBZ8S3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kIWzkcWHVbCWM08WNxrYZl-jayeZV4ufBpdxrAKcP7g&oe=6A05C337"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "118831270
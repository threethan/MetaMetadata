Fp4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOe14U5FiRJaPNzBeNAAwX_SToDOa5jHx-MptpDKL3k9g&oe=6ACA6885"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D-qQ1e3N60Q7kNvwEUa9mM&_nc_oc=Ado4sdQuYaor0BDLnIknvXP0ZODa_BRbUk7oG0o8cXnHDiMo1wfa6KDPP2lm91r74sw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXdMV_S-fXBeILk88SMHoY2Ik1ohjp2IF4Z0tv4X5uSg&oe=6ACA5F64"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im5knULdlGwQ7kNvwGpp6Cb&_nc_oc=AdqwKZ-bQHxBG7ZkXaq5ZnfMtPA22GQYcAk2GopsRwbqh0kdAwg0rF8ED3FNvxtMntk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJs56SQXGtzzKlqHtbLGiz6SNRmabM93PJh6UO9Ha5-A&oe=6ACA6AF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "1188312709333188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742474700, "status": "PUBLISHED", "id": "1188312709333188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
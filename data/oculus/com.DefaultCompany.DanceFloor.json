7&_nc_sid=6e7a0a&_nc_ohc=LIGflWk0t_oQ7kNvwFIvz97&_nc_oc=AdroEElEoa8S1_ozwiPehLg5JcYgk0cwP9zr0kOAbFoLaN_JL7uJ8Yr_FrrVzsZBa08&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS3lEDRmsLrb6RrSUd9pmO0bNeahtVadcdbNfpOkDRug&oe=6AA014C4"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5nKa2IuUkUQ7kNvwHYUtK_&_nc_oc=Adp2va8NH_ZHfX6OhVAOZJF1yYbZgDJOKpI84rLml_M91ptumyCb4kiBz_hBQg8EupQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWxZNNwpeoVNMWNrQMtGTtPcK6rbuMJUJ3ThvWTv8gOw&oe=6A9FFF0F"}]}, "id": "2432589163760004", "locale": "en_US", "screenshots": [{"file_name": "screenshot2.png", "id": "507042665792771", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391991_507042669126104_8045757676306318155_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18UhPJA4v7kQ7kNvwERimVn&_nc_oc=AdrtCSIGwtnsGELlFUleKykSHre6y_FrKnJRm5KaSxu0bLj3MZ-QmqanVb6InNNvf-Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_gw6RPx8tuzb72dABq_WB5mnnHgZ2-x-saW1xf_bwwQ&oe=6AA02124"}, {"file_name": "screenshot3.png", "id": "1213244920133888", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393977_1213244923467221_9054039048155430876_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nb5YH8B6gwQ7kNvwFdarB6&_nc_oc=AdoZFZHA3tJtmXoS-Sz2S_7F33BA8wHlgp7rd4qeaE3NhCau5wsgxe8sEZ8xgDk-0OA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqdshNuCbPA71cm28x49r8FxVfDFn6YXjKnadvrxFE0A&oe=6AA00930"}, {"file_name": "screenshot4.png", "id": "1162986475467949", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391991_1162986478801282_1803552261898926506_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-66Ik2LD_YQ7kNvwEUCL8l&_nc_oc=AdqAKxv7IpdhSrsXdBW7klBqN9egPLPUFw2HoJIsNYGc0pPO9LVyVe6bs5xHOdhsAss&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGY9JARFj_lEsgiXZaSOMZBVUJgBjUD4qmFQ9pTc3vMA&oe=6AA00045"}, {"file_name": "screenshot1.png", "id": "923991529641784", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473392195_923991532975117_7031696587560170527_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=td1vwMdxhFAQ7kNvwEvKxQ2&_nc_oc=AdpNkAo_sy1oChRlxY3fLAwVp7GsprHrugmsb0zHurAh3rvBqMZQEHuyCYKgm280CWk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfELcMic2B9vfxzYt1lMZ57sFegYlLLAsybgmo_RWCmg&oe=6A9FF724"}, {"file_name": "screenshot5.png", "id": "2207031993086561", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391950_2207031996419894_1582256944475189718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8APCRQzCwsQ7kNvwGOSjU4&_nc_oc=AdoJHGNE_layygFjIKNCPSFFEzJaeetF6ydb1PmhIHi8xiinnPCdG-Lahimu4RGiQLQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6xr0t1LPOBu3YAi8LUyJn04Io554g1i7hxobDPtdD7A&oe=6AA002B7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade"], "long_description": "\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.\n\n\ud83c\udf1fUser Interface:\n\u2705 A clean, easy-to-navigate main menu featuring options like Start, How to Play, and About.\n\u2705 In-game UI elements (such as a countdown timer and pause/resume controls) are designed for clarity and immersion.\n\n\ud83c\udfc5Game Modes & Replayability:\n\u2705 A standard game mode with increasing difficulty.\n\u2705 Leaderboards and scoring systems to encourage replay and mastery.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.site/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.site/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9352674784850299"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1188312709333188"}]}, "baseline_offer": {"id": "1188312709333188"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1742474700, "status": "PUBLISHED", "id": "1188312709333188"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"
Xcsl1JC0nPVFcuaZ9Hbdkb6Bd0FLAk0I3jFn-LTy31HeZVlxHYYBX5BsTg47U1c0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TbBfgW4vdCXV7xvZGxO7QsIPQOI_-tSMBgtwoNB7XFQ&oe=6A01E0C4"}, {"file_name": "Cover_Landscape_2560x1440v2.png", "id": "479997645067633", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396584_479997648400966_3387819829939650592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJ8f3M4VB34Q7kNvwGno3u-&_nc_oc=Adqeyh18V0tr4MFeQSilBEa7oMO2_GYX0iA5fxqPDkEzXTIq83ach1IzJVZFxLNTBos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TyugORz4GODWi4FNprZBFFAYP6bTVwgsyY_4HP2kvIg&oe=6A01CB0F"}]}, "id": "1586167559298937", "locale": "en_US", "screenshots": [{"file_name": "screenshot1.png", "id": "1877974659741515", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310896_1877974663074848_1873784755076576078_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5U9J6dNrF4Q7kNvwFbRWOZ&_nc_oc=AdqRX-XZfcLi-30spO_IhXlOi3QpqnpR8SID_qLEiwIJyJEGy25RvV3ZyHvxKU54Umw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4zwdw_j015nokmwQJAnwa5p93NqpzQNY82FrG43c53pw&oe=6A01C5E1"}, {"file_name": "screenshot2.png", "id": "2029407427797804", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300897_2029407431131137_1932227168694123530_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kTqrxj8iCMQ7kNvwF7ZSL4&_nc_oc=AdoMAACMeXogF1YurxdZ-dSOa6AZWDVZeb8LP9QdJpkjtt-nXTxJWDlld54d9yKfedY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ahCrKzWrPEQVTokIWo9hc33IFf0LcQE9s74Qb7MH9NA&oe=6A01F052"}, {"file_name": "screenshot3.png", "id": "1528662618579631", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618254_1528662621912964_6700960828432675246_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGVTLLqo6PkQ7kNvwHNkaGd&_nc_oc=AdpXx9YogAS-oehljfeRE8OSoAqqL7Hy6TKXhq6VJ7601FDtPSU4fbAOanQlR9NG2AE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6w2mjSCNgjMDGKjKdOAZZ3dikVk4Z3Y4afeHx4Hbh1Gw&oe=6A01CAA8"}, {"file_name": "screenshot5.png", "id": "1973472886838925", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619078_1973472890172258_1321755227202967019_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TjSb9UZkqCgQ7kNvwH7RWJR&_nc_oc=AdrQj2Pp4R_gFj8dJAQE2dzXWJA0wEKU9WjGR9yKSkwSvyUc6FCuKB5PVT46uF3lsLQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zgynicRdOXgT-C0joMxEpPDpyuXWjIdLCBbwC6x63ag&oe=6A01EC64"}, {"file_name": "screenshot4.png", "id": "775069592058872", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499300913_775069595392205_3776958193569187234_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKNCSdWAEr0Q7kNvwEFCJkx&_nc_oc=AdoJ615IX76SgvP_5xJvzQtNafBQqu28e8OHwlQlcPo_ruBKsbGRVUBhG7EJWlZ_CAU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ap06ZMVdXefyI5zZhxPTzH2pdsjcQXPNH0WtyKIQf7Q&oe=6A01EE1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DanceFloorVR", "keywords": ["dancefloor", "dance", "party", "arcade", "rhythm"], "long_description": "DanceFloorVR\u2122 \u2013 Step into the Rhythm and Rule the Floor!\nMove, groove, and combo your way through genre-themed arenas in this dynamic VR dance game! Whether you\u2019re chasing high scores or vibing to the beat, DanceFloorVR\u2122 turns every step into a show.\n\n\ud83c\udfb5 4 Music Genres \u2013 12 Levels to Master\nChoose your groove and unlock multi-level challenges in each genre:\n\u2705 Electro Pop \u2013 Neon City Lights\n\u2705 EDM / Cyber Rave \u2013 Underground Laser Club\n\u2705 Hip-Hop \u2013 Graffiti Battle Rooftops\n\u2705 Synthwave \u2013 Retro Pixel Arcade\n\n\u26a1Each genre has 3 progression levels with increasing speed, complexity, and unique wall visuals.\n\n\ud83d\udd7a New Combo & Badge System\n\n\u2705Hit 3+ perfect moves to trigger glowing COMBO chains\n Unlock Achievement Badges like:\n    \ud83e\udd47 Combo King\n    \ud83e\udd48 Sync Master\n    \ud83e\udd49 Rhythm Explorer\n    \ud83c\udfc6 Bonus: Beat Champion (Earn all 3)\n\n\u2744\ufe0f Bonus Finale Level\nComplete all genres to unlock a hidden Snow-Themed Stage with its own vibe and difficulty.\n\u23f1 Over 40+ Minutes of Gameplay Designed\n\n\u26a1 Rhythm-Based Challenges:\n\u2705 Players must step on highlighted grids in time with the music.\n\u2705 Each successful hit increases the score, while missed steps reduce the momentum.\n\n\u2b50 Responsive Controls:\n\u2705 VR controller and head tracking ensure intuitive, natural movement.\n\u2705 Visual feedback (e.g., grid \u201cpress\u201d animations and material changes) confirms successful actions.\n\n\ud83c\udfb6Dynamic Audio & Visuals:\n\u2705 An electrifying soundtrack that drives gameplay.\n\u2705 High-quality visual effects and lighting that respond to player actions.", "short_description": "DanceFloorVR is an immersive VR dance game where players step on illuminated grids in sync with an energetic soundtrack. With fast-paced gameplay, responsive controls, and a futuristic visual style, players must keep up with the rhythm to score points and climb the leaderboards. Designed for both casual gamers and dance enthusiasts, the game combines intuitive motion-based interactions with a dynamic, music-driven environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dancefloorvr.com/privacy.html", "developer_terms_of_service_url": "https://dancefloorvr.com/terms.html", "publisher_name": "Jessvrworks", "support_website_url": null, "website_url": "https://dancefloorvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connec
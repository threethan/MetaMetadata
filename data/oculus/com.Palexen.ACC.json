jlBRRV7oHLLG_vQdOJstzdsjYkCgwhjE91MmRz-k4Zrof-6mVV81Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wBUWt2IfxNxjXmB110VYtszSWfL7LohvPlR-AQjQVvQ&oe=69E76F5B"}, {"file_name": "ss_4.png", "id": "4397045060563396", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619485_4397045063896729_4352944780811830360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dhzIBUwLsp4Q7kNvwH7qOaV&_nc_oc=Adrq2OTs5j6RstoAGw2-rd0vKRwnm9Ec4_N0ZfbDZDJrLAhiI9OVIFRZK4v5M9ezXc8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zMRINtajK8uywXHUY0BWtyXsLel6OW2-o9Zu-cOh8Cg&oe=69E763BA"}, {"file_name": "ss_2.png", "id": "946862151537831", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619677_946862154871164_760489102457682612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0bTVFtd8A4Q7kNvwHyQs4v&_nc_oc=AdpZPTJkddLg13rhQP-QVTNwRVZjVArjaYWsBVv2RDaDSrhYKUQE9sgzx8pA1yIJvY8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nDhpNiO9cofYDu52E2SyyufVV7WDQh89wD1p8GQLz9Q&oe=69E77030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ACC_Cover_4.png", "id": "979833021278698", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618432_979833024612031_3055658976065684673_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SnT6c2uehbYQ7kNvwFKDqXp&_nc_oc=Ado-E0GvXyhZitJWnSRnmcR8vo4Fs09jl8RGLQAPvM8B7XD9xzQi3jftW-5vTQdssiE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11P7lG8BuJWZrfAPgXCfOJM74Chcny75Mh2iQ6ykj_zQ&oe=69E75B93"}, "display_name": "Aura Concert & Cinema", "keywords": ["cinema", "concert", "music", "beat", "hype"], "long_description": "Aura Concert & Cinema isn't just an app; it's a whole new way to experience sound and visuals.\n\nTurn your music into an immersive concert and feel every note as if you were right there on stage. Step into your own personal movie theater where your films and videos come to life with a level of realism that completely transforms the experience.\n\nThanks to its powerful spatial sound, forget about flat audio: every detail surrounds you, envelops you, and makes you feel like you're right there in the moment.\n\nPlus, Aura gives you the freedom to take your content with you. With support for external hard drives connected to your headsets, you have direct access to your library without limits.\n\nThis isn't just listening or watching\u2026 it's living it.\n\nTransform your space into a cinema, a concert venue, or an interactive environment where music comes to life.\n\nOptimized for MP3 and MP4 (better performance and compatibility)", "short_description": "Welcome to the Aura multimedia center!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://devward.wixsite.com/devward/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen XR", "support_website_url": null, "website_url": "https://devward.wixsite.com/devward", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26512703808387673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618293_2156432861787345_4891167889834132531_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZIq9Br6_6oQ7kNvwGRL1ST&_nc_oc=Adp7dvHBOeR41OmUHpeCNGH9pdLE07iHPGj5L6ipGsNIL6cF6Ct-KXtSrJ4aHDTLcpU&_nc_zt=3&_nc_ht=scontent-lga3-
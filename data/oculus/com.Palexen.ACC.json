x1tCQ_Je5qEQerQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2coRBwOBY-r_G-ne1U08__KPFZ-OPkcvTVlASfBo6szw&oe=69E24C71"}, {"file_name": "ss_5.png", "id": "1470380617979380", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499618432_1470380621312713_493364948805685970_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwuIYxnZfwoQ7kNvwFe1IHH&_nc_oc=AdqSLaSn05Ob8_X5V-Q1_PyCk9hNCi4rKA4_i7276Jt4Zl8P4brvt9wZsZSmvx_j2Jg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZjgUdTznA9MY_Xv3mhgbyz7pE2Lbfx7lv4dzA9aXhdA&oe=69E2295B"}, {"file_name": "ss_4.png", "id": "4397045060563396", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619485_4397045063896729_4352944780811830360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAO5X_T8M_MQ7kNvwFQm5G-&_nc_oc=Adrskhm9d8iNhy-9_NGrKaJGFOpIH8V18LNM4Y93xAToRQ8FJhf0XcZPsdLSt85Vr9Y&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QquTQwFukDf-YbV0flPedKOzNvf7FIrfm2q45cwjEbA&oe=69E21DBA"}, {"file_name": "ss_2.png", "id": "946862151537831", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619677_946862154871164_760489102457682612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuETBgQpw-AQ7kNvwFYh1XG&_nc_oc=AdqZVN77E5RMVV6tovbteZForEI85Pae5fhF50Ek5MpqaDit2tsZq8k1u7YGeh0RFG4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0joai4c5mF1v8_gtwbHBmfhKkvRGIeUeieGnnZrItVAg&oe=69E22A30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aura Concert & Cinema", "keywords": ["cinema", "concert", "music", "beat", "hype"], "long_description": "Aura Concert & Cinema isn't just an app; it's a whole new way to experience sound and visuals.\n\nTurn your music into an immersive concert and feel every note as if you were right there on stage. Step into your own personal movie theater where your films and videos come to life with a level of realism that completely transforms the experience.\n\nThanks to its powerful spatial sound, forget about flat audio: every detail surrounds you, envelops you, and makes you feel like you're right there in the moment.\n\nPlus, Aura gives you the freedom to take your content with you. With support for external hard drives connected to your headsets, you have direct access to your library without limits.\n\nThis isn't just listening or watching\u2026 it's living it.\n\nTransform your space into a cinema, a concert venue, or an interactive environment where music comes to life.\n\nOptimized for MP3 and MP4 (better performance and compatibility)", "short_description": "Welcome to the Aura multimedia center!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://devward.wixsite.com/devward/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen XR", "support_website_url": null, "website_url": "https://devward.wixsite.com/devward", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26428098173514904"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499618293_2156432861787345_4891167889834132531_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IMeOfC7-E2UQ7kNvwGMWgjQ&_nc_oc=AdrrIUXbWFMhhQD7Wp7cl3QMQXXkCb54PV1uj_Zy_ZVkTVxtmGIaCk6dTIKuVNXvg9U&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2
1lYgJd5wsApo-cpmPVL0nbtgU4u5HT2cTm5GB_gHzsGYZg61_RXUE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_72B_LYI95kGRhL2E_wQJLCGasl-gYNzFgf7eUg7wKA&oe=69ECB55B"}, {"file_name": "ss_4.png", "id": "4397045060563396", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619485_4397045063896729_4352944780811830360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osI6hzPZLSoQ7kNvwFukPkm&_nc_oc=Ado4JKg5P5-nluDktJCI7wUlsj8oMtEE3C7KbQkistpq1OXTjq4KO4JVEfESAE9AgT4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gzBAOxKLL1IUhJmdovK6zexzJbQctYeW96ju-6ostIw&oe=69ECA9BA"}, {"file_name": "ss_2.png", "id": "946862151537831", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619677_946862154871164_760489102457682612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sucN27-s97cQ7kNvwH9Xe2a&_nc_oc=Ado5gTWEVPXD9HqWVtH-GUgzp5TM7o2LMdb5QwT9NucVj8aez-PUJP539BfehIU6iFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IubzIeUkcyB1XVvgB-Bw5U5bYX4Dw16iM5hvaro8Q-g&oe=69ECB630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ACC_Cover_4.png", "id": "979833021278698", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618432_979833024612031_3055658976065684673_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWx1fHmmJhEQ7kNvwGqQTDe&_nc_oc=AdojlIKJN1ylUnzwHttWFFNpRNqKDzvFj3XEyID3M1F8M6xBGyiYbbj_teZAZnKgQks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MZwWVK8pAgbEIEOHrHfIlWz9H7vSZoeasDCa1RzwjUQ&oe=69ECA193"}, "display_name": "Aura Concert & Cinema", "keywords": ["cinema", "concert", "music", "beat", "hype"], "long_description": "Aura Concert & Cinema isn't just an app; it's a whole new way to experience sound and visuals.\n\nTurn your music into an immersive concert and feel every note as if you were right there on stage. Step into your own personal movie theater where your films and videos come to life with a level of realism that completely transforms the experience.\n\nThanks to its powerful spatial sound, forget about flat audio: every detail surrounds you, envelops you, and makes you feel like you're right there in the moment.\n\nPlus, Aura gives you the freedom to take your content with you. With support for external hard drives connected to your headsets, you have direct access to your library without limits.\n\nThis isn't just listening or watching\u2026 it's living it.\n\nTransform your space into a cinema, a concert venue, or an interactive environment where music comes to life.\n\nOptimized for MP3 and MP4 (better performance and compatibility)", "short_description": "Welcome to the Aura multimedia center!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://devward.wixsite.com/devward/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen XR", "support_website_url": null, "website_url": "https://devward.wixsite.com/devward", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26512703808387673"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618293_2156432861787345_4891167889834132531_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpBtCNP9OVwQ7kNvwExP-xI&_nc_oc=AdrIMw0MBbC87jdR06bf9Hr7F1TmwPemCUBO12pW9CrU74LxP-lmqR846OZu791A--4&_nc_zt=3&_nc_ht=scontent-iad6-
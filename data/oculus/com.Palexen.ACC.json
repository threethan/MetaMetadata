5E9VmavEN4rSO5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dEpxKtmTii-QjYSCdkTWj47TSTWLmawMgOHzs8tsPTw&oe=69DE1FB1"}, {"file_name": "ss_5.png", "id": "1470380617979380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618432_1470380621312713_493364948805685970_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xg5EXrIT2gcQ7kNvwGwy4-F&_nc_oc=AdouzmzdlGTCxFHhPSzub3ralFaHIt6lus_4T-rHxwWKA8lBljnoJGQgruY3pKo4_qg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BP0cAW8BRjJJxBeG_UWtuJbem1bfR_AM-wxcxp4v-dg&oe=69DE34DB"}, {"file_name": "ss_4.png", "id": "4397045060563396", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619485_4397045063896729_4352944780811830360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkD1XF-_nWoQ7kNvwEyBWp9&_nc_oc=Adqwz4mFP-T9ghUmDMSkq_fXz-bsGWQxofzqdnKwv1v0fKb9548hdwvztl9FQxFxmoE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0osqBVjyNdWl6JsK9kcke6vcn89Q15dXkwd_iC2oMZqw&oe=69DE293A"}, {"file_name": "ss_2.png", "id": "946862151537831", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619677_946862154871164_760489102457682612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pb_NvvX61iAQ7kNvwFl4x-V&_nc_oc=Ado8ohtXHEZ8XixSk8s2VuTnIEb-x5AJ10vCselMhRDFaOsNVIlm3eU0CI2BIQYFZek&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af063xaFdWSPerNuDnAzx7T3q9i1GchPGuhmkTr7CS4mIg&oe=69DE35B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aura Concert & Cinema", "keywords": ["cinema", "concert", "music", "beat", "hype"], "long_description": "Aura Concert & Cinema isn't just an app; it's a whole new way to experience sound and visuals.\n\nTurn your music into an immersive concert and feel every note as if you were right there on stage. Step into your own personal movie theater where your films and videos come to life with a level of realism that completely transforms the experience.\n\nThanks to its powerful spatial sound, forget about flat audio: every detail surrounds you, envelops you, and makes you feel like you're right there in the moment.\n\nPlus, Aura gives you the freedom to take your content with you. With support for external hard drives connected to your headsets, you have direct access to your library without limits.\n\nThis isn't just listening or watching\u2026 it's living it.\n\nTransform your space into a cinema, a concert venue, or an interactive environment where music comes to life.\n\nOptimized for MP3 and MP4 (better performance and compatibility)", "short_description": "Welcome to the Aura multimedia center!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://devward.wixsite.com/devward/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen XR", "support_website_url": null, "website_url": "https://devward.wixsite.com/devward", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26428098173514904"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618293_2156432861787345_4891167889834132531_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v70Mlh38vPkQ7kNvwG7gosN&_nc_oc=AdptPKy-_SOC4ey8qIRSbsmVn2_0fWLj7t__fP_FC5PygNqFwBU9MAs9qSS-eQ6mfgU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1
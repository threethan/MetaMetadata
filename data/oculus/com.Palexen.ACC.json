_name": "ss_4.png", "id": "4397045060563396", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619485_4397045063896729_4352944780811830360_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNdUAgiFvxIQ7kNvwE3COdd&_nc_oc=AdrFjCgM5pniqsxd8ANy4pYZkVoxfK-7RMKk4w_XVEmT9UUiNb7MX82BZTW4bor1_tI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7d9wg33_i3q16SmUbfVBBotmAMGIxWiUltONCamKQ5g&oe=6B08547A"}, {"file_name": "ss_2.png", "id": "946862151537831", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619677_946862154871164_760489102457682612_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QFK137Ort0Q7kNvwGWw7D0&_nc_oc=AdqBAVHNizxSvUrkPwLq6IJxt4KCsZf0b_i-LPRZwwCCtwJO9xu9PO5dIXzD3riHo9c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU1_5lkAqRE8oMQfyny10SywTTFQjGGdPtFDUbOzaIdA&oe=6B0860F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aura Concert & Cinema", "keywords": ["cinema", "concert", "music", "beat", "hype"], "long_description": "Aura Concert & Cinema isn't just an app; it's a whole new way to experience sound and visuals.\n\nTurn your music into an immersive concert and feel every note as if you were right there on stage. Step into your own personal movie theater where your films and videos come to life with a level of realism that completely transforms the experience.\n\nThanks to its powerful spatial sound, forget about flat audio: every detail surrounds you, envelops you, and makes you feel like you're right there in the moment.\n\nPlus, Aura gives you the freedom to take your content with you. With support for external hard drives connected to your headsets, you have direct access to your library without limits.\n\nThis isn't just listening or watching\u2026 it's living it.\n\nTransform your space into a cinema, a concert venue, or an interactive environment where music comes to life.\n\nOptimized for MP3 and MP4 (better performance and compatibility)", "short_description": "Welcome to the Aura multimedia center!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://devward.wixsite.com/devward/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen XR", "support_website_url": null, "website_url": "https://devward.wixsite.com/devward", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26428098173514904"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "829559182816676"}]}, "baseline_offer": {"id": "829559182816676"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775688000, "status": "PUBLISHED", "id": "829559182816676"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26934449646213085", "version": "1.0.1"}, "id": "2015663496020703", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26396699313321457", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26934449646213085"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2015663496020
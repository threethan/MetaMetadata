GDlFVbWFVyQcgz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KMdA2UbjWtFBC_cvV24q1bQuS8UHUYrd2o0OEP5r3Dg&oe=69DCCE31"}, {"file_name": "ss_5.png", "id": "1470380617979380", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618432_1470380621312713_493364948805685970_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xg5EXrIT2gcQ7kNvwG75qu8&_nc_oc=AdogICnTrmw-jkEfvlZ5YXG-Sr9TBhNaG8OF-MKEAVkZ0tritbJ7HdjjVnnS78YZfA4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09psi4M56vMhFkTyo_dOn2qLSB7DhSKV6uGGs8tJrXXg&oe=69DCE35B"}, {"file_name": "ss_4.png", "id": "4397045060563396", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619485_4397045063896729_4352944780811830360_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxBmYHrIPX0Q7kNvwHc_web&_nc_oc=AdqdTo4yQ32xezKX9wRybo_8EtQS8vF8RRpb_pJ7JKaAu6fRE6_zofKf_FMIJbCEIZA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lur04TgO8bs05Ml8vJIHS8jbjeyiJdM8ZLazGV54gMQ&oe=69DCD7BA"}, {"file_name": "ss_2.png", "id": "946862151537831", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619677_946862154871164_760489102457682612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pb_NvvX61iAQ7kNvwHYmjbG&_nc_oc=Adq1l4nDxPMqUYpjc4jQpsgq_1EWXQf0XkMnwynBlhzf0ItX64s0Jv4IarCG7X47B9U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BC0WMA9pFOomdmdoDtkICnNxVuLVjF4PTjUiB6z3shg&oe=69DCE430"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aura Concert & Cinema", "keywords": ["cinema", "concert", "music", "beat", "hype"], "long_description": "Aura Concert & Cinema isn't just an app; it's a whole new way to experience sound and visuals.\n\nTurn your music into an immersive concert and feel every note as if you were right there on stage. Step into your own personal movie theater where your films and videos come to life with a level of realism that completely transforms the experience.\n\nThanks to its powerful spatial sound, forget about flat audio: every detail surrounds you, envelops you, and makes you feel like you're right there in the moment.\n\nPlus, Aura gives you the freedom to take your content with you. With support for external hard drives connected to your headsets, you have direct access to your library without limits.\n\nThis isn't just listening or watching\u2026 it's living it.\n\nTransform your space into a cinema, a concert venue, or an interactive environment where music comes to life.\n\nOptimized for MP3 and MP4 (better performance and compatibility)", "short_description": "Welcome to the Aura multimedia center!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://devward.wixsite.com/devward/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen XR", "support_website_url": null, "website_url": "https://devward.wixsite.com/devward", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26428098173514904"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618293_2156432861787345_4891167889834132531_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZu7Vu90xXUQ7kNvwGm0vjW&_nc_oc=Adr-XUneS7GGUJwQMUYGyL4TzaoU721pq4VosPtGir21DBkYwZbSI7Dw0CwvSgpDfYY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3
2.oculuscdn.com/v/t64.5771-25/499619677_946862154871164_760489102457682612_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13IWZ4TyXHUQ7kNvwH3rmgM&_nc_oc=AdrumJiDR1YVWrscAHrVZwafMlFMF3-HxzgsAEdRUJrsAHLSPgvg-kZBj_yUpJW8tPE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RlFGL3pZYTIVyVoVwam8RyG1hUzBLb2z4lLyBKW4iZw&oe=6A0EFD30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aura Concert & Cinema", "keywords": ["cinema", "concert", "music", "beat", "hype"], "long_description": "Aura Concert & Cinema isn't just an app; it's a whole new way to experience sound and visuals.\n\nTurn your music into an immersive concert and feel every note as if you were right there on stage. Step into your own personal movie theater where your films and videos come to life with a level of realism that completely transforms the experience.\n\nThanks to its powerful spatial sound, forget about flat audio: every detail surrounds you, envelops you, and makes you feel like you're right there in the moment.\n\nPlus, Aura gives you the freedom to take your content with you. With support for external hard drives connected to your headsets, you have direct access to your library without limits.\n\nThis isn't just listening or watching\u2026 it's living it.\n\nTransform your space into a cinema, a concert venue, or an interactive environment where music comes to life.\n\nOptimized for MP3 and MP4 (better performance and compatibility)", "short_description": "Welcome to the Aura multimedia center!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://devward.wixsite.com/devward/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Palexen XR", "support_website_url": null, "website_url": "https://devward.wixsite.com/devward", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215
dn.com/v/t64.5771-25/491820441_778877561592209_8654474130156082530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKtW0-xP0N8Q7kNvwH6Cxqd&_nc_oc=AdoGACxqzDUCqRM1hKZF7b0DvH7Yw1ZOqPatYvs3gLRfLTlTBmknMeHYI0NV579JToo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BS4M_06ygOPMPZL8NQgj4zVRgJmgXB2nlY28Q5U8P2w&oe=69EE0A9A"}, {"file_name": "Screen 2.png", "id": "1251108686534120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820923_1251108693200786_6197569094929844717_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXWnHlR3UiEQ7kNvwH2SqDP&_nc_oc=AdrbnNcjYHRbh0RY0xaH7s7hHN2FdE9tLGynIVVYEJKh5kPEjzaHav0ey6p18L_5-Dc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25j3PzYOUVOudBaJs77NkckvNQOYfneAvtFX5A1Aicwg&oe=69EE0A7E"}, {"file_name": "Screen 5.png", "id": "1355405989686694", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1355405993020027_5854755309017124648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFRDJT4Sn3cQ7kNvwFUdS1D&_nc_oc=AdpDqAlrAvMbMsGeL1NB_2Jh75tD5iACQ8Q1miaUW6LJb5mamw0gM9aFUGoBTnmgMN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DHOPiXvxAQGL6ZxDkVTDnRgKBOwnMoUDkEbMk8Hatug&oe=69EE21C4"}, {"file_name": "Screen 4.png", "id": "1457129862862308", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_1457129866195641_1019562618307577126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZSnnj_GAWMQ7kNvwF-9FxO&_nc_oc=AdoGsscK_gjwc4oPLp70yxJZyB8SomaXl6EEJMJSc-Bfk9P_2_GQkbYi9hif70DVXAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Le8KLzTpSZiOY83YzW6uQnZW0OKI25MkiaFEbP0kn0Q&oe=69EE05D6"}, {"file_name": "Screen 3.png", "id": "1461704342115261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1461704345448594_1407268789165231594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6hhuw5-dcqcQ7kNvwFPhxeX&_nc_oc=AdoZXkazmb2q_WzGOTytyIRJZDI7yKljls-IK-kCMUlPGPRl7fwzWUYZTTgr_TGDmLo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11m5CNGz71nDvtpo8SrN03WhSsgpITkL8MIRHo-xU21g&oe=69EE11A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bear Scouts", "keywords": ["multiplayer", "social", "animal", "climbing", "coop"], "long_description": "In this free multiplayer social game, you play as a bear scout hanging out at camp with your friends! \ud83d\udc3b\n\n**Take care of the camp** \ud83d\udd25\n\nGather wood around the forest to keep the campfire burning and enjoy grilled marshmallows under the stars, then help keep the camp clean by picking up any trash you find along the way!\n\n{1228876602782778}\n\n**Fish in the lake** \ud83d\udc1f\n\n\nFrom tiny fish to massive sharks, you never know what you\u2019ll catch in these mysterious waters...\n\n{1736798894369995}\n\n**Hang with your friends** \ud83c\udf32\n\nThe forest has everything you need! From climbing wild parkours to crazy dance battles on the dancefloor, there\u2019s always something fun to do with your friends!\n\n{907226338962900}\n\n**Customize your bear** \ud83c\udfa9\n\nPick up your favorite hat and show it to your friend!\n\n{911352718547215}\n\nNew updates are coming soon bears! Stay tuned and in the meantime **join us on discord** : https://discord.gg/qDc94fFRE9\n\n\n\n", "short_description": "A free multiplayer social game where you play as a bear scout hanging out at camp with friends!\n\nGather wood, grill marshmallows, clean up the forest, and fish for everything from tiny fish to massive sharks. Climb parkours, dance, and customize your bear with hats."}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://www.arianestudios.com/bear-scouts-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
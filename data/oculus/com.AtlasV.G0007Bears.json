RwMWxxnNTNMvjB-bLoxhBdwYpvhyjFnRNIo9b0ceCh3kzk6fWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vaUOdgf3n-S7MwsDm4A1s7gEKO42sxuMkgTDQ8YDpdg&oe=69DCE71A"}, {"file_name": "Screen 2.png", "id": "1251108686534120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1251108693200786_6197569094929844717_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG69FsObpA8Q7kNvwEvdh7G&_nc_oc=Adq1-ITtcrsBkIL-906U-QSzAowNGttGAS-H3-BJv-o2mMahJ2gYIuYhjKPnHftaHDs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3r1GR09_09vwu81uGxRULMTF5aMxSNZe0J1cUL3cYq3A&oe=69DCE6FE"}, {"file_name": "Screen 5.png", "id": "1355405989686694", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_1355405993020027_5854755309017124648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H9LpK8UKU84Q7kNvwGfrUhT&_nc_oc=AdoAtD4nYKvftX3CBKXZRFNllr3gPpd_Rc9dm6mtXlpQayINSyhrhnMxa_BmXK3GVbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eP24LwX0n7GQQT6W6-Sn5TE5ruPUigGfZIZJ8QaoLqA&oe=69DCFE44"}, {"file_name": "Screen 4.png", "id": "1457129862862308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827567_1457129866195641_1019562618307577126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMA4noCjpIQQ7kNvwG4aYP7&_nc_oc=Adoz9YSoT1ZbyMclyvaW2BFdc9AgcIkhPHIBFnLp1rCAwKTXAGgD0tF8fhANaqny7uw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Nzct_HFns1R6wNK6KIPmePiEDVuTWsPZG8oHS2vPNDg&oe=69DCE256"}, {"file_name": "Screen 3.png", "id": "1461704342115261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1461704345448594_1407268789165231594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nE5kfq6uhkQ7kNvwE3RqBp&_nc_oc=AdpxRegMfxNS-Ifq4jXy0xPlPoxVe1JmZy3QBl8nOvZU2OUqOOWODbrk7vgZO3nyWFQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aW58M8lu7v_lSDDbHCI0NRX5dVohaxleHWDms0K7uug&oe=69DCEE27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bear Scouts", "keywords": ["multiplayer", "social", "animal", "climbing", "coop"], "long_description": "In this free multiplayer social game, you play as a bear scout hanging out at camp with your friends! \ud83d\udc3b\n\n**Take care of the camp** \ud83d\udd25\n\nGather wood around the forest to keep the campfire burning and enjoy grilled marshmallows under the stars, then help keep the camp clean by picking up any trash you find along the way!\n\n{1228876602782778}\n\n**Fish in the lake** \ud83d\udc1f\n\n\nFrom tiny fish to massive sharks, you never know what you\u2019ll catch in these mysterious waters...\n\n{1736798894369995}\n\n**Hang with your friends** \ud83c\udf32\n\nThe forest has everything you need! From climbing wild parkours to crazy dance battles on the dancefloor, there\u2019s always something fun to do with your friends!\n\n{907226338962900}\n\n**Customize your bear** \ud83c\udfa9\n\nPick up your favorite hat and show it to your friend!\n\n{911352718547215}\n\nNew updates are coming soon bears! Stay tuned and in the meantime **join us on discord** : https://discord.gg/qDc94fFRE9\n\n\n\n", "short_description": "A free multiplayer social game where you play as a bear scout hanging out at camp with friends!\n\nGather wood, grill marshmallows, clean up the forest, and fish for everything from tiny fish to massive sharks. Climb parkours, dance, and customize your bear with hats."}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://www.arianestudios.com/bear-scouts-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres":
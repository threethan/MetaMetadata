dn.com/v/t64.5771-25/491820441_778877561592209_8654474130156082530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL2RwSvV9bUQ7kNvwEqsJaw&_nc_oc=Adp3Qh5VBIi1P3SM0mp0761x0QW0lhEhpCf3DYsTPaYoTvuVzN9dta0MUgPTQwWp5rk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yRxcDOlgts8Q9MAJLTAtYW98S92WOxd_n0H4iYM2_ZQ&oe=69EA161A"}, {"file_name": "Screen 2.png", "id": "1251108686534120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1251108693200786_6197569094929844717_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txoSMpOeJ7wQ7kNvwFVzuFR&_nc_oc=AdpAEr2ft0gQFpyfqYSf3_C-157x1ZKmj6nS6mVIgmKdNHv2f6BGFjgVcS61nppcdFA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oVtInsQ2HY-QQsan78bKsWsbC9LTYFs56LdpDP2gp5w&oe=69EA15FE"}, {"file_name": "Screen 5.png", "id": "1355405989686694", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_1355405993020027_5854755309017124648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGKvZmYTIXoQ7kNvwHbOXtK&_nc_oc=AdrRa26bEWyruIsegPXtry3LtNplpR3EZew2l6h5Ix9SP8HNgqiI9T1AncG3L4aF-qA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N7Nwevd3Ii5Vuf4MkEh_OBCDLTgglZJ8bPwb41OD94g&oe=69EA2D44"}, {"file_name": "Screen 4.png", "id": "1457129862862308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827567_1457129866195641_1019562618307577126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fh4skl5b-WgQ7kNvwGkxVkP&_nc_oc=Adoe7MpSZlwogShGLO6arfbfM6AyMkWoxeCmFjE3UbECkXPy9VdIn6JPfyz4mWyBHzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xCeEzQ1yu6clHe_wWzvi8BVxERoHnEf14B98KrLipRQ&oe=69EA1156"}, {"file_name": "Screen 3.png", "id": "1461704342115261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1461704345448594_1407268789165231594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8xaFgS_TjMQ7kNvwEKMCs2&_nc_oc=AdrriWSG6SFEVvoF5KWwmdoryctJnUz3kL2f8wD2pQ84WROOmeFO4s8RJWttWp9bXhs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gK1QqF4uvahvMnhafFBe99CYaemM0fzPZuFmekyKuUQ&oe=69EA1D27"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bear Scouts", "keywords": ["multiplayer", "social", "animal", "climbing", "coop"], "long_description": "In this free multiplayer social game, you play as a bear scout hanging out at camp with your friends! \ud83d\udc3b\n\n**Take care of the camp** \ud83d\udd25\n\nGather wood around the forest to keep the campfire burning and enjoy grilled marshmallows under the stars, then help keep the camp clean by picking up any trash you find along the way!\n\n{1228876602782778}\n\n**Fish in the lake** \ud83d\udc1f\n\n\nFrom tiny fish to massive sharks, you never know what you\u2019ll catch in these mysterious waters...\n\n{1736798894369995}\n\n**Hang with your friends** \ud83c\udf32\n\nThe forest has everything you need! From climbing wild parkours to crazy dance battles on the dancefloor, there\u2019s always something fun to do with your friends!\n\n{907226338962900}\n\n**Customize your bear** \ud83c\udfa9\n\nPick up your favorite hat and show it to your friend!\n\n{911352718547215}\n\nNew updates are coming soon bears! Stay tuned and in the meantime **join us on discord** : https://discord.gg/qDc94fFRE9\n\n\n\n", "short_description": "A free multiplayer social game where you play as a bear scout hanging out at camp with friends!\n\nGather wood, grill marshmallows, clean up the forest, and fish for everything from tiny fish to massive sharks. Climb parkours, dance, and customize your bear with hats."}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://www.arianestudios.com/bear-scouts-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
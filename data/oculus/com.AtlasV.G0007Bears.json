5/491818890_1355405993020027_5854755309017124648_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_YXsoQoqbwwQ7kNvwElVJ_i&_nc_oc=Ado2DTlJ3KkNUVrQG4iobq6aEhpUVSQbx1HOegKZ9jOaY_HjNe-9zYlOVtjaJz_TyUM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRi40QVbs3Ip6fOGUe4AU64j9UTo40p9Bz6_k67D6KBBA&oe=6AFB4C04"}, {"file_name": "Screen 4.png", "id": "1457129862862308", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827567_1457129866195641_1019562618307577126_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1awIxKIpbEQ7kNvwEi2PjN&_nc_oc=Adp7ZwCBbSDf0fA4GqjTMdyVQhz4lqJohD1plTaxg0zYPE9Uszb915xf3YQolWf4ibo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVh7TTYI1gIh-MGI5Qr0gXE1iIZVMJo_h5ETXR-m6zfg&oe=6AFB3016"}, {"file_name": "Screen 3.png", "id": "1461704342115261", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823783_1461704345448594_1407268789165231594_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lj6TS9ZEOdYQ7kNvwGGJhhz&_nc_oc=AdpYbcrUneoyr2izCoOfFU-B2zjMvtj205MtxswcB4i3LsF4VOv8XbMCr3JQz-K8QOw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2MrnsuKxn0g_Z7hYQ8DRYVtKDZyW00myOGnqwmkoBrg&oe=6AFB3BE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "keyartDay002.png", "id": "2219481588794786", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491818890_2219481592128119_928219023459520759_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_uO63W6Cm4Q7kNvwGtn51Q&_nc_oc=Adp169rDynyQrRcW0a_yfjlgAb8I4lyXyKw-8bnI0ewx-RsBfWkT0QVOvpHRkBJto5A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7h6z2gnd7D4JrV6c-O2I0z1tYTRshKUbmml5z6y24KQ&oe=6AFB4DD2"}, "display_name": "Bear Scouts", "keywords": ["multiplayer", "social", "animal", "climbing", "coop"], "long_description": "In this free multiplayer social game, you play as a bear scout hanging out at camp with your friends! \ud83d\udc3b\n\n**Take care of the camp** \ud83d\udd25\n\nGather wood around the forest to keep the campfire burning and enjoy grilled marshmallows under the stars, then help keep the camp clean by picking up any trash you find along the way!\n\n{1228876602782778}\n\n**Fish in the lake** \ud83d\udc1f\n\n\nFrom tiny fish to massive sharks, you never know what you\u2019ll catch in these mysterious waters...\n\n{1736798894369995}\n\n**Hang with your friends** \ud83c\udf32\n\nThe forest has everything you need! From climbing wild parkours to crazy dance battles on the dancefloor, there\u2019s always something fun to do with your friends!\n\n{907226338962900}\n\n**Customize your bear** \ud83c\udfa9\n\nPick up your favorite hat and show it to your friend!\n\n{911352718547215}\n\nNew updates are coming soon bears! Stay tuned and in the meantime **join us on discord** : https://discord.gg/qDc94fFRE9\n\n\n\n", "short_description": "A free multiplayer social game where you play as a bear scout hanging out at camp with friends!!\n\nGather wood, grill marshmallows, clean up the forest, and fish for everything from tiny fish to massive sharks. Climb parkours, dance, and customize your bear with hats."}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://www.arianestudios.com/bear-scouts-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppo
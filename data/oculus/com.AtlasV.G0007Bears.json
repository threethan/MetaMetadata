Gs782683nMNp1hmxDbBpzIYqeCvm69Na-wu8q_c1FxlPKlItGU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31T3_bnf9ct0jDfdXY4P52ovU4ZgRR_GQG1n_171p5QQ&oe=69D8F29A"}, {"file_name": "Screen 2.png", "id": "1251108686534120", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1251108693200786_6197569094929844717_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgE8fQ4WCJsQ7kNvwEzWuwo&_nc_oc=Adpqo5nBvsd4MUSD4YouRAhVaKT7BvHMKTy_Pri_7cLAhwP37sT_6gX1j_E_91xoEIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NLdmNYWm392q4ZwUQ1YTNp9i3mQw7bHQg4J3_Iviang&oe=69D8F27E"}, {"file_name": "Screen 5.png", "id": "1355405989686694", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_1355405993020027_5854755309017124648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf5NgwZ3YW8Q7kNvwGvJ9Gz&_nc_oc=AdqswTpElQNStog57aOKVNYp4exX7SNn3mAlzGCe4C-cfZCLMkvUMAGV0CWpVSPTcK0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-OeIPXPvJlRVCOwPitShU3AgsJvM0Ye3vQlqwR8al4g&oe=69D909C4"}, {"file_name": "Screen 4.png", "id": "1457129862862308", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827567_1457129866195641_1019562618307577126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUWAjja5nM4Q7kNvwG4n9mM&_nc_oc=AdphbdzCThr3n_DrlJ1gHM68l5_KUu_tWOrq_Q2qpCLEM7mjK3PzhWgmanXsL7LA4xk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3guW02RCUhwqA3XOpebaVv833UjOwTlP794TvbKt0IZA&oe=69D8EDD6"}, {"file_name": "Screen 3.png", "id": "1461704342115261", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1461704345448594_1407268789165231594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pnYmVmex_vgQ7kNvwE2vfCP&_nc_oc=Ado6v21iiqKmlFdNmt8FDRV4-kOj0kSURzgSDJahw4ihOCCdNdjMNOD2uQGcB6ExlMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KKfD9sNCSaRvZ7ixmRu-cAM42JpKEfTcZadiN-vMOpQ&oe=69D8F9A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bear Scouts", "keywords": ["multiplayer", "social", "animal", "climbing", "coop"], "long_description": "In this free multiplayer social game, you play as a bear scout hanging out at camp with your friends! \ud83d\udc3b\n\n**Take care of the camp** \ud83d\udd25\n\nGather wood around the forest to keep the campfire burning and enjoy grilled marshmallows under the stars, then help keep the camp clean by picking up any trash you find along the way!\n\n{1228876602782778}\n\n**Fish in the lake** \ud83d\udc1f\n\n\nFrom tiny fish to massive sharks, you never know what you\u2019ll catch in these mysterious waters...\n\n{1736798894369995}\n\n**Hang with your friends** \ud83c\udf32\n\nThe forest has everything you need! From climbing wild parkours to crazy dance battles on the dancefloor, there\u2019s always something fun to do with your friends!\n\n{907226338962900}\n\n**Customize your bear** \ud83c\udfa9\n\nPick up your favorite hat and show it to your friend!\n\n{911352718547215}\n\nNew updates are coming soon bears! Stay tuned and in the meantime **join us on discord** : https://discord.gg/qDc94fFRE9\n\n\n\n", "short_description": "A free multiplayer social game where you play as a bear scout hanging out at camp with friends!\n\nGather wood, grill marshmallows, clean up the forest, and fish for everything from tiny fish to massive sharks. Climb parkours, dance, and customize your bear with hats."}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://www.arianestudios.com/bear-scouts-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres":
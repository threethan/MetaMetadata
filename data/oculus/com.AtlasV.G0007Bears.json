dn.com/v/t64.5771-25/491820441_778877561592209_8654474130156082530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IKtW0-xP0N8Q7kNvwGpcV7M&_nc_oc=AdpGIog2QqysdiG9uf77rdTHXSqcDu7vLK_viV0nLr4GPDHKdQwx99YJ5NtiZnrvhm0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17-0wnRrf0zupsBXrfqnH5xNjkjtVraCEFivL6KsMTBg&oe=69EF5C1A"}, {"file_name": "Screen 2.png", "id": "1251108686534120", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491820923_1251108693200786_6197569094929844717_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXWnHlR3UiEQ7kNvwHgUu32&_nc_oc=Adrh7gijx3TkJ8iJeFLTg0_e26nNIjExVezDz55l9x8cEGD5B4Uu3oRfVJ9F3RhgIKc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2XHZtPomLQ4fBSCF3Cq8ObshEMY9RMHc879NdDvSRauA&oe=69EF5BFE"}, {"file_name": "Screen 5.png", "id": "1355405989686694", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491818890_1355405993020027_5854755309017124648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFRDJT4Sn3cQ7kNvwF2rAmE&_nc_oc=AdoA9_mV42vXoXFQLHiRkaR2EiQQ8CQFyIlawLedcbtKbb9Q6hm0QbEp34HR7-JUyR8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2N16sZsH2pEk_vEdiyyPO8cnNsYg6WAO1CCvgNuMnBRQ&oe=69EF7344"}, {"file_name": "Screen 4.png", "id": "1457129862862308", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827567_1457129866195641_1019562618307577126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FZSnnj_GAWMQ7kNvwFy8JEW&_nc_oc=AdpquorKyUcsoKELJw6N5dllWCxgAQa8R2UAZdQGqofnMv8XNN1fjuIh3QSoDTq7emI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vr4QNfUF0GsOkzH8lW03rROUlKDlstM7cWf8mZZ3MQQ&oe=69EF5756"}, {"file_name": "Screen 3.png", "id": "1461704342115261", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823783_1461704345448594_1407268789165231594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLoavxscQj4Q7kNvwE1BCAE&_nc_oc=AdqfYRsmiHCMhAIqOnLMpk6THVvssBVVjQN9LJUKQmqX_eqaqqLd4G9jgYmQIRtMUR4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XffuwZ4N8poj3IDjtk5IJVsmLo6n0K9mUDLHp-u8IOg&oe=69EF6327"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bear Scouts", "keywords": ["multiplayer", "social", "animal", "climbing", "coop"], "long_description": "In this free multiplayer social game, you play as a bear scout hanging out at camp with your friends! \ud83d\udc3b\n\n**Take care of the camp** \ud83d\udd25\n\nGather wood around the forest to keep the campfire burning and enjoy grilled marshmallows under the stars, then help keep the camp clean by picking up any trash you find along the way!\n\n{1228876602782778}\n\n**Fish in the lake** \ud83d\udc1f\n\n\nFrom tiny fish to massive sharks, you never know what you\u2019ll catch in these mysterious waters...\n\n{1736798894369995}\n\n**Hang with your friends** \ud83c\udf32\n\nThe forest has everything you need! From climbing wild parkours to crazy dance battles on the dancefloor, there\u2019s always something fun to do with your friends!\n\n{907226338962900}\n\n**Customize your bear** \ud83c\udfa9\n\nPick up your favorite hat and show it to your friend!\n\n{911352718547215}\n\nNew updates are coming soon bears! Stay tuned and in the meantime **join us on discord** : https://discord.gg/qDc94fFRE9\n\n\n\n", "short_description": "A free multiplayer social game where you play as a bear scout hanging out at camp with friends!\n\nGather wood, grill marshmallows, clean up the forest, and fish for everything from tiny fish to massive sharks. Climb parkours, dance, and customize your bear with hats."}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://www.arianestudios.com/bear-scouts-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
d=6e7a0a&_nc_ohc=S_88upy_yyYQ7kNvwH8ox3u&_nc_oc=Adpo1ZBuyBmT3xpAlMIz9ZP8pg-d2EucL-idsWhdlrWcIq1l959aBaa5z0qPBFE56-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6KXK0P4l4B2gpTWUSrMRWOCcrqymHUmimZI_lT-jknA&oe=6A843484"}, {"file_name": "Screen 4.png", "id": "1457129862862308", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827567_1457129866195641_1019562618307577126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_7KINRaSfQQ7kNvwF3X_W1&_nc_oc=AdpUtMNtoRp03xJ9RqbHeuzgHf_Ch2eUWYsphKprvBskYUHYZaQqq5wTWJhseWfxbWE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkkP6l4KbSMYLmSJ9NSDlG2fss6xo7Nk5h3rKs690Rxw&oe=6A8450D6"}, {"file_name": "Screen 3.png", "id": "1461704342115261", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823783_1461704345448594_1407268789165231594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PoBbYi5YtFEQ7kNvwFR5E5j&_nc_oc=Adoq6cFl9gLEYAyCVf7lSUJBBhMcaTariRAUiFNeHNW3yqcIFsiUyH-K9BuYqYHRx_A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqakENwvrXCqr0NiRDh_DkDL4xqfmBCILGNu5w6qJNwQ&oe=6A845CA7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "keyartDay002.png", "id": "2219481588794786", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491818890_2219481592128119_928219023459520759_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vc3gcDlv4RAQ7kNvwFpHMyT&_nc_oc=AdorNGqCdY-_GEPZEx56P59jnSSBpsB5FIT9NbW28M3uIMnfjR0hN8882Wt8ey6X1Ck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgUPsXjzAxn-VmcWigTqyMpxCMQbbOnB9x0bgldpHiUQ&oe=6A843652"}, "display_name": "Bear Scouts", "keywords": ["multiplayer", "social", "animal", "climbing", "coop"], "long_description": "In this free multiplayer social game, you play as a bear scout hanging out at camp with your friends! \ud83d\udc3b\n\n**Take care of the camp** \ud83d\udd25\n\nGather wood around the forest to keep the campfire burning and enjoy grilled marshmallows under the stars, then help keep the camp clean by picking up any trash you find along the way!\n\n{1228876602782778}\n\n**Fish in the lake** \ud83d\udc1f\n\n\nFrom tiny fish to massive sharks, you never know what you\u2019ll catch in these mysterious waters...\n\n{1736798894369995}\n\n**Hang with your friends** \ud83c\udf32\n\nThe forest has everything you need! From climbing wild parkours to crazy dance battles on the dancefloor, there\u2019s always something fun to do with your friends!\n\n{907226338962900}\n\n**Customize your bear** \ud83c\udfa9\n\nPick up your favorite hat and show it to your friend!\n\n{911352718547215}\n\nNew updates are coming soon bears! Stay tuned and in the meantime **join us on discord** : https://discord.gg/qDc94fFRE9\n\n\n\n", "short_description": "A free multiplayer social game where you play as a bear scout hanging out at camp with friends!!\n\nGather wood, grill marshmallows, clean up the forest, and fish for everything from tiny fish to massive sharks. Climb parkours, dance, and customize your bear with hats."}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://www.arianestudios.com/bear-scouts-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes":
yk6V-4JM8cN3rPHq42ubs8snxSi2jm18LSZqouJGYZdeb3LzFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EYL1Ra-8Ilgm_a3aRUr2dVANlXikbnSMZ7ywFjP6Mqg&oe=69E37E9A"}, {"file_name": "Screen 2.png", "id": "1251108686534120", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820923_1251108693200786_6197569094929844717_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ea5yh2u53RgQ7kNvwHWcTsB&_nc_oc=AdpnOChzB4b96Mbd3TmF_BXCOD4twP0-ftSYj-Xta-4d-FflIAikOkz6tM4w_gIkzmk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NxMvv7mQoJeUQQz62mclUp37FB77UoCBhg7-OvP9LOw&oe=69E37E7E"}, {"file_name": "Screen 5.png", "id": "1355405989686694", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818890_1355405993020027_5854755309017124648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1GioizubVQQ7kNvwEpNwmP&_nc_oc=Adrz89oNdAww7JBWoj5f4F2OEziUdBkSPxtf_NmkasjA66TFQXaxWpZWloIlpAgn35U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Y-5sdb9V3U7wStl2_8bTr_OkTXUgZzK-Uw8Q63-__zw&oe=69E395C4"}, {"file_name": "Screen 4.png", "id": "1457129862862308", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827567_1457129866195641_1019562618307577126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRv2RxhMAgsQ7kNvwHNfzH6&_nc_oc=AdoMG-wtx3_IU-Cdc5lAil5W4Hzolx4_QP3tpZn_AzfVag9C9BntkrNCUmlMyRCO21k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lu6hFDwm7gUKx_ooXmQcTgHICA_Ufr8kuPe0xgDHGow&oe=69E379D6"}, {"file_name": "Screen 3.png", "id": "1461704342115261", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823783_1461704345448594_1407268789165231594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGEHVW8HUq0Q7kNvwFvKb8V&_nc_oc=AdqsW_C_iJlTgGDTPv1sk0HPHhR7rBJcueALJdWG7wzvjsuZnrh3i00RYlFoeqYp4Tw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SsBRUSOy1tSGevBKki8M7AaYO-JunYb4CAW5HBvwDZg&oe=69E385A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bear Scouts", "keywords": ["multiplayer", "social", "animal", "climbing", "coop"], "long_description": "In this free multiplayer social game, you play as a bear scout hanging out at camp with your friends! \ud83d\udc3b\n\n**Take care of the camp** \ud83d\udd25\n\nGather wood around the forest to keep the campfire burning and enjoy grilled marshmallows under the stars, then help keep the camp clean by picking up any trash you find along the way!\n\n{1228876602782778}\n\n**Fish in the lake** \ud83d\udc1f\n\n\nFrom tiny fish to massive sharks, you never know what you\u2019ll catch in these mysterious waters...\n\n{1736798894369995}\n\n**Hang with your friends** \ud83c\udf32\n\nThe forest has everything you need! From climbing wild parkours to crazy dance battles on the dancefloor, there\u2019s always something fun to do with your friends!\n\n{907226338962900}\n\n**Customize your bear** \ud83c\udfa9\n\nPick up your favorite hat and show it to your friend!\n\n{911352718547215}\n\nNew updates are coming soon bears! Stay tuned and in the meantime **join us on discord** : https://discord.gg/qDc94fFRE9\n\n\n\n", "short_description": "A free multiplayer social game where you play as a bear scout hanging out at camp with friends!\n\nGather wood, grill marshmallows, clean up the forest, and fish for everything from tiny fish to massive sharks. Climb parkours, dance, and customize your bear with hats."}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://www.arianestudios.com/bear-scouts-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres":
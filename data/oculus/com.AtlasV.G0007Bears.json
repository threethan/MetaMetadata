dn.com/v/t64.5771-25/491820441_778877561592209_8654474130156082530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8tBhBVMidwQ7kNvwHYoEGl&_nc_oc=AdqtcP2Txa90BKdbC4PlwLWkXPDyswI1ygXUWzpeNBWLOTCFLDz0_ZoHxljrB2zlkUU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kPGf3YGUzQVDDTHw-QxCFal7w87A9RfogP6XM1CmF0A&oe=69F5F39A"}, {"file_name": "Screen 2.png", "id": "1251108686534120", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820923_1251108693200786_6197569094929844717_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQiA-IK0YQwQ7kNvwHo2AXm&_nc_oc=AdqvoLdtqOfnIh5nyckDfvsHBBbRxcYuGa8X7uZa008lJSWAdfRHahWhWcO5aTx89vY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00U28uChgCZUhxRxx6r1-fk5fcU6tn0HDCPTqEuBIsIA&oe=69F5F37E"}, {"file_name": "Screen 5.png", "id": "1355405989686694", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491818890_1355405993020027_5854755309017124648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjyHfn6ZMMEQ7kNvwEJ_Z_H&_nc_oc=AdrAkh2qdvlGm90XappxvY2l5rOTX_-yc_lx6HgywHXXzsYT3qP4R3QvgEvHJBE6fjE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1muWE0_zJfbdrdDuxagtL-u7rEQ7M0JEbZVGA3BdwWWA&oe=69F60AC4"}, {"file_name": "Screen 4.png", "id": "1457129862862308", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827567_1457129866195641_1019562618307577126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ybwi73iDNY0Q7kNvwHr8HT4&_nc_oc=Adr78oo1OsSw5aif8GS9Qm6Pgpcm4L8YP6o9j4FD11hUevucWwMqFkPAAaZQeDG5vhs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2UyZj_6MCBWFOnVg0GUPXVcDSlB7iEDWdsk8KHLwmLJA&oe=69F5EED6"}, {"file_name": "Screen 3.png", "id": "1461704342115261", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823783_1461704345448594_1407268789165231594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BaO9xZraBGkQ7kNvwFLlbgw&_nc_oc=AdouIqp5lSnLnwgj3uX2ST-_R9aCK0Nlo_rW4KsGwab63da8rgVLzu4-gQpQas1AkZw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3dz3Xib2ouSUYeW0h1fIPM7nostm-pdP7-qnO8B1Xm3Q&oe=69F5FAA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bear Scouts", "keywords": ["multiplayer", "social", "animal", "climbing", "coop"], "long_description": "In this free multiplayer social game, you play as a bear scout hanging out at camp with your friends! \ud83d\udc3b\n\n**Take care of the camp** \ud83d\udd25\n\nGather wood around the forest to keep the campfire burning and enjoy grilled marshmallows under the stars, then help keep the camp clean by picking up any trash you find along the way!\n\n{1228876602782778}\n\n**Fish in the lake** \ud83d\udc1f\n\n\nFrom tiny fish to massive sharks, you never know what you\u2019ll catch in these mysterious waters...\n\n{1736798894369995}\n\n**Hang with your friends** \ud83c\udf32\n\nThe forest has everything you need! From climbing wild parkours to crazy dance battles on the dancefloor, there\u2019s always something fun to do with your friends!\n\n{907226338962900}\n\n**Customize your bear** \ud83c\udfa9\n\nPick up your favorite hat and show it to your friend!\n\n{911352718547215}\n\nNew updates are coming soon bears! Stay tuned and in the meantime **join us on discord** : https://discord.gg/qDc94fFRE9\n\n\n\n", "short_description": "A free multiplayer social game where you play as a bear scout hanging out at camp with friends!\n\nGather wood, grill marshmallows, clean up the forest, and fish for everything from tiny fish to massive sharks. Climb parkours, dance, and customize your bear with hats."}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://www.arianestudios.com/bear-scouts-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAME
eLl56Bg0NC4r1W8ciMs2x5oLlKVoWM0dVvKTsqGbCjLlOQ_08E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DDz9V6dM2ubpqOwlVRpGkGT25AQ8wlagHEKG-T7jlPQ&oe=69DE389A"}, {"file_name": "Screen 2.png", "id": "1251108686534120", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820923_1251108693200786_6197569094929844717_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG69FsObpA8Q7kNvwFMy4ff&_nc_oc=AdqnDkxF376XKWTiv24e4LVvYKAiaKpwfIb4mGuOvvFnjWKsZVfMvwEcaSsirXOjk08&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21wMAcGttgxIm93qF2LpPACr50rpKPo0gbshuigjtSUA&oe=69DE387E"}, {"file_name": "Screen 5.png", "id": "1355405989686694", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818890_1355405993020027_5854755309017124648_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rGTFFzn1YMQ7kNvwE9yffE&_nc_oc=Adpc3gM1cte2VLGbgu1tDECMeVmxccpw3LVBh9yIYfBAd2njmfY5T7N1WTaZkjZdBwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wGr4jzlTPY674KDT6mLWFxYiFTvOTq3igN-CK-NQn6A&oe=69DE4FC4"}, {"file_name": "Screen 4.png", "id": "1457129862862308", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827567_1457129866195641_1019562618307577126_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMA4noCjpIQQ7kNvwEX9hrA&_nc_oc=AdotqNWUZ4QZ6KcPDgga2rvv0HozepEgIYdyaVsNMKBmq8BVMvZVy-HAGm2a528ttdA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2v3NQ_-F9jjsTgsr4jY-w1wZ7N3LbReGCuaZ6286oLWw&oe=69DE33D6"}, {"file_name": "Screen 3.png", "id": "1461704342115261", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823783_1461704345448594_1407268789165231594_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nE5kfq6uhkQ7kNvwESM0wM&_nc_oc=AdqVvpkmvyRF0pUNu7bTgYRB8MrA_k6hAjyblpXOI4Ru8Yz2zEXYM1jTUuWZjeKj_vw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vMbvxnnFpQH8TIyYPP-yCJoOjBg8nYe20o6JeToSn2Q&oe=69DE3FA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bear Scouts", "keywords": ["multiplayer", "social", "animal", "climbing", "coop"], "long_description": "In this free multiplayer social game, you play as a bear scout hanging out at camp with your friends! \ud83d\udc3b\n\n**Take care of the camp** \ud83d\udd25\n\nGather wood around the forest to keep the campfire burning and enjoy grilled marshmallows under the stars, then help keep the camp clean by picking up any trash you find along the way!\n\n{1228876602782778}\n\n**Fish in the lake** \ud83d\udc1f\n\n\nFrom tiny fish to massive sharks, you never know what you\u2019ll catch in these mysterious waters...\n\n{1736798894369995}\n\n**Hang with your friends** \ud83c\udf32\n\nThe forest has everything you need! From climbing wild parkours to crazy dance battles on the dancefloor, there\u2019s always something fun to do with your friends!\n\n{907226338962900}\n\n**Customize your bear** \ud83c\udfa9\n\nPick up your favorite hat and show it to your friend!\n\n{911352718547215}\n\nNew updates are coming soon bears! Stay tuned and in the meantime **join us on discord** : https://discord.gg/qDc94fFRE9\n\n\n\n", "short_description": "A free multiplayer social game where you play as a bear scout hanging out at camp with friends!\n\nGather wood, grill marshmallows, clean up the forest, and fish for everything from tiny fish to massive sharks. Climb parkours, dance, and customize your bear with hats."}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://www.arianestudios.com/bear-scouts-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ariane Studios", "support_website_url": null, "website_url": "https://atlasv.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres":
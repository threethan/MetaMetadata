8556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60pIc9o-d6gQ7kNvwFxWPpC&_nc_oc=AdptOc3K8xXkOahneMj3AON0KvcE7_4fgMlJkUcUlZCH1WHvc2axS8XSbk-7wPTAE9M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af565mx-KbADP-4VsaME5P8NwykPVZSujfaz64Odb0oL3w&oe=69FC8E03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FIREZONE3Test2560x1440.png", "id": "2950852928552779", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974756_2950852931886112_4069845081673903176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z04tkB1bOW4Q7kNvwEoe2T8&_nc_oc=Adojkk5Xq-I7ujV7JiItCiEpKr9menC1SVKs_OQlcIRV25k15QYCy3YE0mSt9fdf2Iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ThzNBdgDD6KajsgvLpBibGjcuR-UnvIPXbe0afOyItA&oe=69FCA895"}, "display_name": "FireZone", "keywords": [], "long_description": "Hop onto the battlefield in VR like never before. In large scale battles of up to 16 people, players can hitch a ride in multiple types of vehicles, land or air, to compete across intense game modes featuring exciting VR combat and chaotic gameplay. \n\n- Control a variety of vehicles such as jeeps, tanks, and helicopters\n- Huge battles of up to 16 players, with AI bots as well\n- Fight through multiple classic game modes like Team Deathmatch and Capture the Flag.", "short_description": "FireZone is an all-out battle of shooting, vehicles, and explosions!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "FLYING"], "has_in_a
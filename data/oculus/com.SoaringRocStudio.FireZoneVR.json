cdn.com/v/t64.5771-25/39035384_1152092905415398_3671014561611948556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhVxxr0YzS0Q7kNvwFDZRL0&_nc_oc=AdkTP9bzme3iE0nyROgsf_EKoYl9f6nMjX_buWPR8DNTagZx2VYgJwBsqqkZqqCF4O8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvOP0zSdBySZ-fF3Axz_8JFIqM9z-f3ezNwAvy9y9t8fw&oe=69A97F83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FIREZONE3Test2560x1440.png", "id": "2950852928552779", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974756_2950852931886112_4069845081673903176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcBjhMltoTsQ7kNvwHNzv8I&_nc_oc=AdmhfUQNqeUOm-ZzG8zilczhZBTb4hvd8EoyyqBmYsZgY83oIbuEWizv7z13Jomlvh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuxrjbpjHTWCH8fRwjmqDpSh0QuvR8t8nO45W00HhX0Sg&oe=69A961D5"}, "display_name": "FireZone", "keywords": [], "long_description": "Hop onto the battlefield in VR like never before. In large scale battles of up to 16 people, players can hitch a ride in multiple types of vehicles, land or air, to compete across intense game modes featuring exciting VR combat and chaotic gameplay. \n\n- Control a variety of vehicles such as jeeps, tanks, and helicopters\n- Huge battles of up to 16 players, with AI bots as well\n- Fight through multiple classic game modes like Team Deathmatch and Capture the Flag.", "short_description": "FireZone is an all-out battle of shooting, vehicles, and explosions!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/firezonepolicy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringrocstudio.net/", "category": "GAMES", "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres
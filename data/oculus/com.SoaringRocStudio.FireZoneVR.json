d3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1f4AIqfsBIvfCUQHEU8ByksH1MXQzq9yBbUgrIKVIlA&oe=6AF5D049"}, {"file_name": "ss5.png", "id": "1152092902082065", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035384_1152092905415398_3671014561611948556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZgI_fZ7s1cIQ7kNvwFZDYPI&_nc_oc=AdonRQCURaF9gUEfUfFxytgiRbnJUzSUK5nH2fuq4b3Xk8yrGNT17VmIj183xVFqDZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOqYMC8ckV_cO4fJdmu81WZXpi0N7C7PWgMM0osLgfMQ&oe=6AF5F1C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FIREZONE3Test2560x1440.png", "id": "2950852928552779", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974756_2950852931886112_4069845081673903176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkw8-fTbI2sQ7kNvwFFeIFI&_nc_oc=AdoxDMC1hILCbEaoI-ZEFaydKDnty6LRJ25kotMp3msKJ3ZSFNEvVTmDs83w-SANNTI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgYOYjVj2TsGA115f1ba5Iq0xvoQQa6iKSD3HSJdkp8w&oe=6AF5D415"}, "display_name": "FireZone", "keywords": [], "long_description": "Leaving Early Access, FireZone is launching fully! Hop onto the battlefield in VR like never before. In large scale battles of up to 16 people, players can hitch a ride in multiple types of vehicles, land or air, to compete across intense game modes featuring exciting VR combat and chaotic gameplay. \n\n- Control a variety of vehicles such as jeeps, tanks, and helicopters\n- Huge battles of up to 16 players, with AI bots as well\n- Fight through multiple classic game modes like Team Deathmatch and Capture the Flag.\n- Two large, intense maps with elevation and plenty of sight lines for each class to succeed in", "short_description": "FireZone is an all-out battle of shooting, vehicles, and explosions!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_w
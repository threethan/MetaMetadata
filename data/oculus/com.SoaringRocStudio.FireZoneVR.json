o1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvuj5NiJBZm8GflHt-QuV2i3yrdnx9KEisnOS6BtO9RQ&oe=6A940909"}, {"file_name": "ss5.png", "id": "1152092902082065", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39035384_1152092905415398_3671014561611948556_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsMEYTAgBFsQ7kNvwEhTF4G&_nc_oc=AdrdEgA-aF66TYqJpyrbGJknDxA_AsYA4xpv95VTyDKqRPNMXQAdpCRltxGNOjbUQ0o&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrcRdkgoYUajXyPR9vIb06fVmCeDwMzpH7S09vCU4H4A&oe=6A942A83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FIREZONE3Test2560x1440.png", "id": "2950852928552779", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974756_2950852931886112_4069845081673903176_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNYnibQSSeMQ7kNvwGpvcyY&_nc_oc=Adp5u1lird0M4nZVufJ8xHG5Swmz0pIiLBWnw9bfHdWagitI1ii5vpudBMRGPBQI3HI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEc-VwFZG3e-Q9l83Xn1obwZV8dtJ3HNjltF979pUtLw&oe=6A940CD5"}, "display_name": "FireZone", "keywords": [], "long_description": "Hop onto the battlefield in VR like never before. In large scale battles of up to 16 people, players can hitch a ride in multiple types of vehicles, land or air, to compete across intense game modes featuring exciting VR combat and chaotic gameplay. \n\n- Control a variety of vehicles such as jeeps, tanks, and helicopters\n- Huge battles of up to 16 players, with AI bots as well\n- Fight through multiple classic game modes like Team Deathmatch and Capture the Flag.\n- Two large, intense maps with elevation and plenty of sight lines for each class to succeed in", "short_description": "FireZone is an all-out battle of shooting, vehicles, and explosions!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://soaringrocstudio.net/policy", "developer_terms_of_service_url": null, "publisher_name": "Soaring Roc Studio", "support_website_url": null, "website_url": "https://soaringr
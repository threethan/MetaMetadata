0Zj2hkb19mpOGF4dcRvqQ0QumojgLdsZEn8TXmj2mtl6YtHQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHUosZMbVuKX-3njAbqIJDTF_tEXLUDP6Z0Hityl6Y4A&oe=6AFB269E"}, {"file_name": "04_stocking.png", "id": "1679933817077934", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_1679933820411267_8921075198480104329_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bFvbKad2FoIQ7kNvwEtbpuF&_nc_oc=AdpN3X-4akgJEMXUffHso0aDAzviAUaXM8N71Xt5haDnQcjQPp3QD9-hj2ZWIR-dGJg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2Xr1TFc19oPBp3zhoQeEyrY4pOe03XTKlh1knEX04aA&oe=6AFB40A6"}, {"file_name": "05_computer.png", "id": "2138257580397994", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827646_2138257590397993_1266252543763381337_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4ZvO6KokOEQ7kNvwF_Ngf0&_nc_oc=Adp5s1xx2dURiEWwL2XjXk9NgDsQCUeUmOZ8ip_gOlxbL5jvPpFoDFgq4Nv2jMtd0Ck&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYxAP1xqX17XAZ2jO6QmBFnFdG7eZ-DbPga2ghUP_A5g&oe=6AFB33E2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1428964186031420", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491831393_1428964189364753_7230262222615469005_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=falsfxeEosQQ7kNvwHCoM_Q&_nc_oc=AdpUveu4L2fTpQWUQKS9P4OH4ggvb_P9iPs2gqL8W9WqgPA84-2PKEsE_fcOUqclAVk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR44rc5XXMg4yoeFprpzYYq0XzPBcW-ztxOT-g7bBcDg&oe=6AFB2A9E"}, "display_name": "Super Store Manager", "keywords": ["supermarket", "vrsuperstore", "marketsimulator", "storesimulator", "shop"], "long_description": "Step into the ultimate retail experience in Virtual Reality! Run your own supermarket from the ground up and build a thriving business in this fully immersive, hands-on simulation.\nGet ready to roll up your sleeves. Use your VR controllers to physically grab boxes and stock shelves with a massive variety of products. Jump behind the register to scan items and take payments from a growing line of customers. Every detail of the business is literally in your hands!\nAs your daily profits rise, it's time to scale up. Hire staff to help manage the checkout rush and keep the floors clean, giving you the freedom to expand your store. You have total creative control to design your layout\u2014place aisles, freezers, and checkout counters wherever you see fit to optimize the shopping flow.\nBut retail is about more than just what happens inside the store. You'll need to manage your supply chain and purchase goods from online or local markets around town to keep your inventory fresh and your customers happy. Want to offer premium service? Pack up boxes and personally deliver online orders to your customers out in the virtual neighborhood.\nAre you ready to become the ultimate retail magnate? Put on your headset, flip the open sign, and start", "short_description": "Run your own supermarket in VR! Stock shelves, and expand your store in this immersive retail simulation.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://w42dev.netlify.app/privacy", "developer_terms_of_service_url": null, "publisher_name": "W42", "support_website_url": null, "website_url": "https://w42dev.netlify.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "sup
n.com/v/t64.5771-25/499623443_1073042831788476_8918416842256940847_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6C_qVZdzI0Q7kNvwGhwJA0&_nc_oc=AdryeisIjAzIb5s4OgzepGD_Zkgy2t3WtepYmaapHqLnPkEAHMvviF80fo9mIwzYI_A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_sYjnnGXKsP9vYN65kv4XKRswGjo3TLUulkbEUZdCBQ&oe=6AFDCA4B"}, {"file_name": "newss_6.png", "id": "1559439922291545", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619113_1559439925624878_6582267867456558521_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RaY8ffP14MQ7kNvwHcqzxi&_nc_oc=AdqiPCXtLVBh2r0XqAw9Wj2fptwIp17mjae5asnOXZGVvvO0sgO7_uoPnYBuGBAy1ZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHYSeZ6aqCsIjEJs49HSC_WbwvGQD6UyMiXcvL2mU1XQ&oe=6AFDB685"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover image.png", "id": "1430724185778886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628108_1430724189112219_8877498020104590462_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmT6x_pxfrgQ7kNvwEJUsAZ&_nc_oc=Ado2xelz0JMFXV8c51b2-AezC5pPNRv5Q11x8H3h7F4x06SAFcV-z_ULlGLVxULcoyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWY3Y_axsdva0ubHi8EEcAOp0OlflJ5GTkxp10GXay5A&oe=6AFDD6BE"}, "display_name": "Ages Of India - Cave Art Studios", "keywords": ["India", "Museum", "History", "VRMuseum", "IndiaHistory"], "long_description": "Welcome to Ages of India, an immersive educational experience designed to bring the rich tapestry of India's past to life. Designed for students and history enthusiasts, this virtual museum offers a quiet, focused environment to learn about the moments that shaped the nation.\n\nWhat You Will Experience:\n\nThe Hall of Leaders: Stand face-to-face with portraits of India's greatest visionaries, from the imperial might of Raja Raja Cholan to the leaders of the 21st century.\n\nScientific Breakthroughs: Discover the minds behind India's greatest contributions to science and astronomy.\n\nPivotal Wars & Victories: Learn about the battles that defended the land and the strategic brilliance of its commanders.\n\nCurated Exhibits: Each photo frame is paired with detailed historical context, allowing you to learn at your own pace.", "short_description": "Experience the Ages of India in VR. Walk through a curated gallery of heroes, wars, and discoveries, spanning from Raja Raja Cholan to today's visionaries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.agesofindia.com/Privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "CaveArt Studio", "support_website_url": null, "website_url": "https://caveartstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1275861502279057"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619485_1425714482704144_7545182127245913863_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVZdzpmeq0AQ7kNvwEfK3mG&_nc_oc=AdpTm-u4o1Z7Spyawvg5P7atDP8GHw2y6xIMZ4PhI51nM2X2UW-LVxVr0LiTFfSam5s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYKB18XH75rbCIcI7RlTrAbBwuecOz9jhinpaTj_NqcA&oe=6AFDB142"}, "is_concept": false, "is_test": false, "is_trial_offer_vali
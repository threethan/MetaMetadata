n.com/v/t64.5771-25/499623443_1073042831788476_8918416842256940847_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud7KjJmPpn4Q7kNvwExagfb&_nc_oc=AdphQWHXa0xh2GnGOaC2sPD23ferYv5V9naH51S4CHkdrrhp8nFnfQ8AAa7Qd80QcsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSR-KZv5aNmek2ehqNDdxpLIuGXqFoxCqBgJY-Qby-2Xg&oe=6B0D9C4B"}, {"file_name": "newss_6.png", "id": "1559439922291545", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619113_1559439925624878_6582267867456558521_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvPlQwPpHsUQ7kNvwGnqEiO&_nc_oc=Adpdg0ZeyMcpCltxbhXR0fGJrQZXKNB0wHhkhef5YhlXufjoFeOpYvFxcQ6N-d49NGk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQOmJgyfLcaGn8oiApPPL_XI2_k8z07OqUKlR85ZUlddA&oe=6B0DC0C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover image.png", "id": "1430724185778886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628108_1430724189112219_8877498020104590462_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebbDao2CwRkQ7kNvwGE5uJe&_nc_oc=AdpwCBwIbT0XfJ6dDRIW8w25Z0IIFM2RKpNuaNP-h7iOEg_YTgXGhCVzlwwiqsiFCSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRiX-yHqPY88z_Vk9tKEPVbmU33FxG4_2AalSKv_GCZWg&oe=6B0DA8BE"}, "display_name": "Ages Of India - Cave Art Studios", "keywords": ["India", "Museum", "History", "VRMuseum", "IndiaHistory"], "long_description": "Welcome to Ages of India, an immersive educational experience designed to bring the rich tapestry of India's past to life. Designed for students and history enthusiasts, this virtual museum offers a quiet, focused environment to learn about the moments that shaped the nation.\n\nWhat You Will Experience:\n\nThe Hall of Leaders: Stand face-to-face with portraits of India's greatest visionaries, from the imperial might of Raja Raja Cholan to the leaders of the 21st century.\n\nScientific Breakthroughs: Discover the minds behind India's greatest contributions to science and astronomy.\n\nPivotal Wars & Victories: Learn about the battles that defended the land and the strategic brilliance of its commanders.\n\nCurated Exhibits: Each photo frame is paired with detailed historical context, allowing you to learn at your own pace.", "short_description": "Experience the Ages of India in VR. Walk through a curated gallery of heroes, wars, and discoveries, spanning from Raja Raja Cholan to today's visionaries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.agesofindia.com/Privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "CaveArt Studio", "support_website_url": null, "website_url": "https://caveartstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1275861502279057"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619485_1425714482704144_7545182127245913863_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MznM4mw4yUgQ7kNvwGPSiEz&_nc_oc=Ado3sT3Y2JkqHNygkU8cRCH2JdxSAfEKyLi0Ol_fbgYmzl2V-RoOdWLhE5sO4JrSZU8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSkWhqmaVNJ37Aue1I_m3cqNPCUHeK6ka4rch4E0mN2AA&oe=6B0DBB82"}, "is_concept": false, "is_test": false, "is_trial_offer_vali
n.com/v/t64.5771-25/499623443_1073042831788476_8918416842256940847_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=im63UIm_WtMQ7kNvwEB5qeL&_nc_oc=AdomucwKRWKVTiar8i8wz8y3pk51AZdpHGYFJQl4BiThJo47vQBOf6orVBWB328ZIdE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3BfMSvQU65-KZ4cVGVEWJAO7QA83rlHKexQwkHmpVvw&oe=6B09A7CB"}, {"file_name": "newss_6.png", "id": "1559439922291545", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619113_1559439925624878_6582267867456558521_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svb5wtloL5sQ7kNvwGFLgX1&_nc_oc=AdpZm0xVo2ERejvGqQ-m0e9j-rdXRcPLYEt0aHq8O8QOjE2M13-o05UYM3F-_jChlBo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStYLcgTsQ8JLWlFJexfExp71_6AVf3D2uttLRJXUJf9w&oe=6B09CC45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover image.png", "id": "1430724185778886", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628108_1430724189112219_8877498020104590462_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iX1QKi4-tKcQ7kNvwG5L7aw&_nc_oc=Adr2hLim2WS_lXuug9K3N6bT0C_ZKBbhTxw7looQeGRTliX5ZZMDaplMEpk9pffQ-Qk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnFGfKK5EOwu4SPiZLahqCXOpvph_Vc6WTK59zgXOjjQ&oe=6B09B43E"}, "display_name": "Ages Of India - Cave Art Studios", "keywords": ["India", "Museum", "History", "VRMuseum", "IndiaHistory"], "long_description": "Welcome to Ages of India, an immersive educational experience designed to bring the rich tapestry of India's past to life. Designed for students and history enthusiasts, this virtual museum offers a quiet, focused environment to learn about the moments that shaped the nation.\n\nWhat You Will Experience:\n\nThe Hall of Leaders: Stand face-to-face with portraits of India's greatest visionaries, from the imperial might of Raja Raja Cholan to the leaders of the 21st century.\n\nScientific Breakthroughs: Discover the minds behind India's greatest contributions to science and astronomy.\n\nPivotal Wars & Victories: Learn about the battles that defended the land and the strategic brilliance of its commanders.\n\nCurated Exhibits: Each photo frame is paired with detailed historical context, allowing you to learn at your own pace.", "short_description": "Experience the Ages of India in VR. Walk through a curated gallery of heroes, wars, and discoveries, spanning from Raja Raja Cholan to today's visionaries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.agesofindia.com/Privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "CaveArt Studio", "support_website_url": null, "website_url": "https://caveartstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1275861502279057"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619485_1425714482704144_7545182127245913863_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDYjqacJ7EgQ7kNvwFvmi_D&_nc_oc=Adpc4FKF8-Vxt4HFDFYkGAZ-p7FQRg8y_0QxMd0Iac3Vawe5p631D6mn2bnGhwxZim8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3so8_VUBlkC1sqUztbrVA5DE_8gbZMs3U-TFRzepzaQ&oe=6B09C702"}, "is_concept": false, "is_test": false, "is_trial_offer_vali
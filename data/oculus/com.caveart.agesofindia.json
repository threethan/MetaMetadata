JNGGwY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgXxz7YeqhuLi0_Yd19kkCq2pl0tDuyWMVzPWzhIxmBQ&oe=6AD39A4B"}, {"file_name": "newss_6.png", "id": "1559439922291545", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619113_1559439925624878_6582267867456558521_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shE302KBY9oQ7kNvwHC5f4g&_nc_oc=AdpElhHLR_fzGwaFS5FdemYnyhEVLfFQ8I3Ug_BcAfJEM5_maP3gNqZeJkoXLvbWmMM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-9nVr1CqP4-ZeR-4aIfbDjTVCpwBNhnttNJ-w9imMZQ&oe=6AD38685"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover image.png", "id": "1430724185778886", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499628108_1430724189112219_8877498020104590462_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVlKaqzVuAAQ7kNvwHVfVO9&_nc_oc=AdoOO1wGMH8Wo5mbZGfOK8e9LFbYLlQXLNf9ja6p3Wx1rCaX6rwllGDfir_4uUIP80s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDpAzfXyOatY5VYxrMnIsy_PbAzX8GwgQzCKnsJ4NH5w&oe=6AD3A6BE"}, "display_name": "Ages Of India - Cave Art Studios", "keywords": ["India", "Museum", "History", "VRMuseum", "IndiaHistory"], "long_description": "Welcome to Ages of India, an immersive educational experience designed to bring the rich tapestry of India's past to life. Designed for students and history enthusiasts, this virtual museum offers a quiet, focused environment to learn about the moments that shaped the nation.\n\nWhat You Will Experience:\n\nThe Hall of Leaders: Stand face-to-face with portraits of India's greatest visionaries, from the imperial might of Raja Raja Cholan to the leaders of the 21st century.\n\nScientific Breakthroughs: Discover the minds behind India's greatest contributions to science and astronomy.\n\nPivotal Wars & Victories: Learn about the battles that defended the land and the strategic brilliance of its commanders.\n\nCurated Exhibits: Each photo frame is paired with detailed historical context, allowing you to learn at your own pace.", "short_description": "Experience the Ages of India in VR. Walk through a curated gallery of heroes, wars, and discoveries, spanning from Raja Raja Cholan to today's visionaries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.agesofindia.com/Privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "CaveArt Studio", "support_website_url": null, "website_url": "https://caveartstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1275861502279057"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619485_1425714482704144_7545182127245913863_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NldUBoan5ewQ7kNvwGceEh4&_nc_oc=Adrdy0eyrlX2gAxc5V22wJ9Y9luOt6yT5s69z3ZMHRXkv2cCG8Yp4qX3lycQ68naVE8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPg4cCMZmWVLxZY0jRqM-7NgrAaL6tdwH9n3d3yAiLBDg&oe=6AD3B982"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ages Of India - Cave Art Studios", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_d
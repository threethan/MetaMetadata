n.com/v/t64.5771-25/499623443_1073042831788476_8918416842256940847_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUKYgb0j-csQ7kNvwGlfMpf&_nc_oc=Adp3l_iL6kmzzyTHSTzxa93ENFMgPGRsPnNzdWuPCNe0T7KolbLwRteEns_tuC8s8Mc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4lFfjQakDjzTBh1MNAWrCXWG-9DaMZuZm1UOZiGGvvA&oe=6B0704CB"}, {"file_name": "newss_6.png", "id": "1559439922291545", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619113_1559439925624878_6582267867456558521_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mGg7ulSLuYgQ7kNvwEcPpd6&_nc_oc=Adqi5ytb4dsf2QL4TiVj5KggHgnPFctxG1nX_HAXEhNt8eMWJjIHdEM42ukx2PqDpFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMH_4ZrSOwl2A0emRs3QF2jsB-tXUaR5BEKGk9hmR3bA&oe=6B06F105"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover image.png", "id": "1430724185778886", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628108_1430724189112219_8877498020104590462_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rtgYYBXmuiYQ7kNvwEe6quL&_nc_oc=Adr-WgvQbd9aR9Z6o95zF1ywPAfO8O90C7nZ4X5hpilfpUnPkKfM2_9dcjAjXxao4Jw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDAUZjojPuJXFbvOVj8qZa9SOkfpsk9cXUWgi7C8Agdw&oe=6B07113E"}, "display_name": "Ages Of India - Cave Art Studios", "keywords": ["India", "Museum", "History", "VRMuseum", "IndiaHistory"], "long_description": "Welcome to Ages of India, an immersive educational experience designed to bring the rich tapestry of India's past to life. Designed for students and history enthusiasts, this virtual museum offers a quiet, focused environment to learn about the moments that shaped the nation.\n\nWhat You Will Experience:\n\nThe Hall of Leaders: Stand face-to-face with portraits of India's greatest visionaries, from the imperial might of Raja Raja Cholan to the leaders of the 21st century.\n\nScientific Breakthroughs: Discover the minds behind India's greatest contributions to science and astronomy.\n\nPivotal Wars & Victories: Learn about the battles that defended the land and the strategic brilliance of its commanders.\n\nCurated Exhibits: Each photo frame is paired with detailed historical context, allowing you to learn at your own pace.", "short_description": "Experience the Ages of India in VR. Walk through a curated gallery of heroes, wars, and discoveries, spanning from Raja Raja Cholan to today's visionaries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.agesofindia.com/Privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "CaveArt Studio", "support_website_url": null, "website_url": "https://caveartstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1275861502279057"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619485_1425714482704144_7545182127245913863_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N2gIfJJ9sgQ7kNvwG97Vck&_nc_oc=Ado_XmJrkhZ_xXmI7PxsVsG0brmeeS2Kht-v3ZeITYV_Ib-to1JlV0FpTruDWX-RmRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCG6tO2KRxExQJrf9iHL7qYnB_LdbEx2TuTn2uj1ynEA&oe=6B072402"}, "is_concept": false, "is_test": false, "is_trial_offer_vali
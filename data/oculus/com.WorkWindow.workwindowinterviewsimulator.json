&oh=00_Af43fkCV5cUqbfycE35YLFbsmFh_LtFB3zveklCaa1HvQw&oe=6A106A95"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J_LyanLxhh4Q7kNvwG4OWS3&_nc_oc=AdoPNJolnZhgwx91Qi_bAxYJQPxHYY6Wo9T49zJUecj2MDc46N5dKHwbMC4fPzgxObE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FZk-O4e7fzHEstn0_gqp0ROs9rKwyFWJU5i6tyARoqA&oe=6A104ECE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3ngIX27pecQ7kNvwGOsioB&_nc_oc=Adp2-UYsfkOiucqjKRW4bkdM0m1aFxjyq5QyqPd95sM0qFM9lLIejEWB27gm-EGLeuc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gioR8i9Aot1VG8NIg59EcDpQVWkENc8CyhYVhTGGqHA&oe=6A104E50"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
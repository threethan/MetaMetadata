&oh=00_Af3vywKPJF2jrNMJnKh0ws5le6PfxAdffqs0UyoyLgId5w&oe=69E39795"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsMryrbuiTAQ7kNvwFwc2pI&_nc_oc=AdrDpFRQww-9xxcN_nBr_NSJZrVSUzu9vdGczPaRt19Xo5NPjn7DmIhraP0wfGEo6-M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-iTxRzuZnuZFsB1yDCSFqVEgRHjivA0r_T91WCbVHZg&oe=69E37BCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2MVOYTupYMQ7kNvwFoITSL&_nc_oc=AdosN6s8cLT9F0U5fyOoy6HKZfLS2p4oPaF8u0ma-uepZnfd-iiLs1OTetpJmPR4nS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DjUvL-18WiWHF3Nx-VC6W6-9DmYAlbFL8d5h6pllW7A&oe=69E37B50"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
&oh=00_Af9JwDFTVBY8KF0lB6PmCfYInn6f2fr2J7ea9pAoJqwfMA&oe=6A26D415"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VWbAlbmiV9AQ7kNvwHwbPLc&_nc_oc=Adr0U4ElN5A9tCz-vWsEb-wjs46Gbfm-Q6flaevnhnFeDNiTVZQRiCjje5GyCeGoeaU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97iXnraLhawTUwucRVEQfsE1iP7a5vURB1e37euJMraQ&oe=6A26F08E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZpwSRNO82QoQ7kNvwEfdaqQ&_nc_oc=AdrexJRg59vAjV_cRrMNm4T7AFZza2YGPUYpc6yKNlhjBSqMKQZXRu9DEWp1OS8Pys0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m3lcbsT-ff3fSrpbvcW6Xo4LSp65IkOg_xiYryh04wg&oe=6A26F010"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
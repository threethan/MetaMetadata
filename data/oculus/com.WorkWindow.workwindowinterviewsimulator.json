&oh=00_Af23IuS8x4o4MChG6kbxNvCCBaPkyaFyLD7qfQOcFbU8sA&oe=69ECD215"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFxLsiymBBgQ7kNvwEj2v65&_nc_oc=AdrNX9YrVPXQ00AxEITjXOce8OBJcuhSDJ9_VTJPbfHPTB2X9IGvqPKtn1-IaLNzsfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2M2oZOWH55CW0v6NRI0gpSGh-4EignHWkjsWSvyeIEsw&oe=69ECB64E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtkvtjjWh3QQ7kNvwFndeqa&_nc_oc=AdoTxATDaXdUbTNIz3sU1F22O3Wz2bN-9gM1-lAkalJNuhKfhnzhO5jX3bhTOetTwkk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZrngeUhSqa75yn2w-qsMU2H6AHL3Jl1rcwuv6p1eKdw&oe=69ECB5D0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
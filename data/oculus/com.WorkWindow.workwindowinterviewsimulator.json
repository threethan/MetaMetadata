&oh=00_AQH_qjYQS2IXZX9j4BrDyhMtucRDU5Fd34y6bkhVUpN2Lg&oe=6A971BD5"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcostG9X38kQ7kNvwFZ7Q5P&_nc_oc=AdogRSXv43NfN4rBpApjWXpTr4Ael1SeBY6m_Y245Q7jXUyNGpt3A0TTVjDA1Djtr7E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG12a7cgFg3mdINvU8kH-9x-seV6lnBqUMTzUSyU_v7Qw&oe=6A97384E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHObVZKKc-4Q7kNvwGX8u8i&_nc_oc=Adp5QO1l2KYum6p61VH4UOV6w5KhXOBcfvyfiZkvRiasOWbAfQfnMtowjZy1hUz9_qo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHboI8ymi9pgIIbsiBTT4Y_YMF0u8GovVhl8fAY6TY3Sw&oe=6A9737D0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
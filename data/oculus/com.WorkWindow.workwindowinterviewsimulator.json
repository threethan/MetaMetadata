&oh=00_AQB7FQkXPdDUvkfx2t0Gv0jVm1OGQfu65lw0u-cs7H_nGw&oe=6A6F5695"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrUksOQot7kQ7kNvwGR2dQO&_nc_oc=AdqgSYC7BYv0IlrZxMCIMQlTXu6aVj_tOzWlwz2Htev0YeiZiv16yGxgTufBAXUe86M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYcZ3MCXkrdF4u8fW2OzD0puQicsP14GhYdvYkSk2sDQ&oe=6A6F3ACE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx6mExH_rHMQ7kNvwGM4oye&_nc_oc=AdrhfOhkx5A6cWobCv9ZGdH_ughWau3JKiBXBRhvWl7K6SQrv6ucZpuAUVCBrohrTPY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBr8ZRI1oeNuLJXATiZnBcPd9fh9coNqXy-7ZbB5MqabQ&oe=6A6F3A50"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
&oh=00_AfxOJD6dSJY1VdGDuv1lwfOuBsAWGo2JwxCirKmsFSBt0g&oe=69C3BB55"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSDthHezvlUQ7kNvwFpyr8K&_nc_oc=AdoVqts-Kyl2nlwlOz8guAtdLbiS6hSyyDY8fnZ9Mn6H69dj141RqCmvb8HKOvAUATI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzmbs9xb240IgH9UjVzYql6pbREnOChiOWwZjkQLfZdBA&oe=69C3D7CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29sLH06jFtAQ7kNvwHqsSGw&_nc_oc=AdoxE_zY_oiX_cZ_DLl0n22i5yALX7efj9IVWZBZ0byrQUDQtKqosjG-TG6m5GDaI4E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHDC5XsTrUiQH6LJaxpv5rR1TcOP7qzhvAr5uw6OzH8Q&oe=69C3D750"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
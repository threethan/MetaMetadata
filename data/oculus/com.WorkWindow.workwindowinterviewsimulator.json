sea5-1.oculuscdn.com/v/t64.5771-25/38974862_694455895013305_5365825317235734912_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Frd8SPVjdsQ7kNvwF4-ZRt&_nc_oc=AdokH_OKVBqTPa9OKVvfcYGr9hm4wmpEq0W92fiQxxw0USZEjzg5Fnt1XGfH-vcEjAc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbdmS2hf-80oCin73ow1MfgjsFavHMwl7tF5IJzjQZQQ&oe=6AFC6715"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQxx-AXwWU8Q7kNvwGyo83x&_nc_oc=Adpkod8AxiZF5uToX4vz-SHveuOQYEzIG5DS88gjzGFxJhGF7ZgRoIVfaNKG2uNY8mQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ8kgTkZUbEjgEFEQRIgyX4cz4MY0TzUXdNRwDhgf2Hg&oe=6AFC838E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HEuF01wrUEQ7kNvwHkprEz&_nc_oc=Adq2wy92JV-fL9M1MWEnHHorNT51-FyEKkNdUNiKtq8um3Xp7OUbmnPBav6BeqWqKRw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIEp8uyRvLqrLvSO1ibVbSq0bOL-4npemVi2W_opu4sw&oe=6AFC8310"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window ", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3271013276447340"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "580901821586231"}, {"status": "PUBLISHED", "id": "825030802220866"}]}, "baseline_offer": {"id": "580901821586231"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737333960, "status": "PUBLISHED", "id": "580901821586231"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9039368326144019", "version": "3.1.0"}, "id": "321439943420134", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5008217522592473", "is_concept": false, "latest_released
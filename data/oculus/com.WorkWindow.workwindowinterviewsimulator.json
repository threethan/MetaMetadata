Hnt8g&oe=69AEDB95"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sqlq4ORoHE8Q7kNvwGJlMmp&_nc_oc=AdngQeFCQSZHdXirnV6YqSo05ZZwNayPW5tMpmR2iJvWBpJ5f2Qp9nYIyqNXAav340k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeIShBN2l0sLAEkR2BtaVDy8jjM-SwSdiKVQcRorGB6Q&oe=69AEBFCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsXBM8ad-6UQ7kNvwGx011_&_nc_oc=AdkeABADMA1QzXme44hTZrMz4gG-6HZ2G2acrVZgf9mN1vnAin3kKnnW8mSyDHosGak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-X0B_sDvUILISv4ix7kv_QuZrwrkSMlQueWKMB_V0vA&oe=69AEBF50"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Wind
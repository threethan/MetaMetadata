3-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wHjs9W6YLUQ7kNvwHPoHCO&_nc_oc=AdnlmhMjwhh_Wq73jS-nUlEgutTTIRwdZNZ69dP84EF1bbyAeAn1Wht11PEgaUTMWPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftKlQxn2T7kFH2rm9iwyUVQ_AJLnAck7ickZ1Rt_vdTuA&oe=69A2E24E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58kjL2nKbIYQ7kNvwF6lUUN&_nc_oc=AdlSwwqpFATIqT6BInhza4UdqlQ5mZVbwUdnDMFvsEP3ciXdYR_SALWGvBLxBrPygts&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftE6VpbUWISyUTt6qZtPhHk1itsG1c83QH5HI6F3T1Prg&oe=69A2E1D0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Window ", "support_website_url": "https://support.workwindow.com.au/en", "website_url": "https://www.workwindow.com.au/", "categor
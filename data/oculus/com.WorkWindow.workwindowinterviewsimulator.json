&oh=00_AQBMr_v60gz_0yqCTg2LWhUnD5qMWYrLaauk9zPkKsR07w&oe=6A661C15"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h15JMQ63DtsQ7kNvwGwKwFP&_nc_oc=AdpGpcyfapzsFQT_HE1yx63Oryayhpg5II09BZjsufat1qIILGNsssZ-XJB7F2GiY4g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCleDyR-eoNLhaey_evgxR94V-LkZxxJSHCr1hlnl3BpA&oe=6A66004E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB35Bmt5vFYQ7kNvwGc5o-N&_nc_oc=AdpZOMQB68d8dNwGxDwM9OEn2bOwoHeJBTiPWxwYRLqa5Q79AwXvRpcB-Azch0k8tM0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkgBsSJsuPAx7DCGdR_ETl2k9B-q6a4JUHr6Pa2cryow&oe=6A65FFD0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
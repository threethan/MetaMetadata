uscdn.com&_nc_ss=7f20f&oh=00_AQFGCmrLGy1ytqxLJal5naWgoYODGzDFvh_tcbpAt1FAfw&oe=6A8587D5"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfMZRAQH5bUQ7kNvwER7HCC&_nc_oc=AdrI84v0t5vpcQr0iI5Ry0Pn6Wum7HQwchRfQ3LLsx1fsM9JZ2Fxfwas1EEj0wdK7Ek&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJWlol2Vv9UsrJuZAN-wXMSzJ3M3N0I9R8ZWy-7wPwNw&oe=6A85A44E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fi_bkVm-u5sQ7kNvwETRYSp&_nc_oc=Adqq7rn5DiPZbm-is2CaygTvtMtkIGbbOQdDVK8Acf9QqZsKEIlJRzqwcrMMfx0kgmY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5eSSc9qzBsFOB2vMEnYRqZNF5PBtmEyRW1THJhv-jqA&oe=6A85A3D0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "h
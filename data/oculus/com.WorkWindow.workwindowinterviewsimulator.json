&oh=00_AQGsnKIrQ0TM9Peehmzvci-IhrkiOZI3tGN4K1zyTlcj8g&oe=6A8ACDD5"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgxqCHsTO_oQ7kNvwEc5AT-&_nc_oc=AdoVdNwgbf5ZxnxU44CR72FNCL49cL8kSUkAK67t7wKIiPSumWzCpzt67de1zFUZKTg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxXKZMNjD4Y1W5wvXAqgDhaxaL79ds8CDH-G-hngVZ_g&oe=6A8AEA4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQ0ENdblgFAQ7kNvwHQYEqN&_nc_oc=Ado0SVmAl7Ki9st_cLOmOtcSNPy5CYgGEP_tOLvFaHQRia5ddmET-mZ7PnKyJTf9M4I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNmguBqkiZwG0r-BGzoipn7fPvTFBy89dj8Ti3DaHJ6A&oe=6A8AE9D0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
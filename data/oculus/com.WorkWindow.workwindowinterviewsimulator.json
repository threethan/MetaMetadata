&oh=00_AQDagIdnuhqCHskjSTWOOun5WX3HZLNMJJLUANVpYG2Wkg&oe=6A4E6115"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2B13JJO4qYQ7kNvwHdIwJR&_nc_oc=AdqcwLKgb-SvNrMjtoNWIqY8DvuaK5vjVHeDcEDK7Wbk3PJGr5rxGr3xGQVto0ThDX4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvTk_tgyFdEfNGLWadqXQbtGlsg0qUPV_4SsILQFYqVQ&oe=6A4E454E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j4kPHVjVeyEQ7kNvwG6IeXX&_nc_oc=AdpzVBiGnUikCJ_J-SwuLLi1G8oFcUeLgSAVPxsokjHj2GpLZ1aAKs737KmJnqKT0W8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEf264pe_Yzywf7ZauCUijPRG59UlQgZ_69b2TTDNFWQ&oe=6A4E44D0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
&oh=00_AQDY8nGxLcqHfJw7AIBrGL6F-I_pE4B1hrZDb9jNCMjPIg&oe=6A58ED15"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EBUp_oLSTMQ7kNvwE4QIBT&_nc_oc=AdqRR-8gHxN7k7zb8_8fvnsriTkWRQ-a4c0xAo85m1UnkOf94nhMMys5rbGLYWcKl5k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKRjWgjCiCya0eJa0e5WfP-KGOcuVGv3WGEGzsMpeuKw&oe=6A58D14E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AtqwO3j_G8YQ7kNvwGo_uBm&_nc_oc=Adrf9TQ5jLHMct_3H4mf5rgi2zLJ-QHJ2xaPAkjZCYvzp5M56_A88EPX9IFiNoy-2ck&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6s5NxGTxGBg27JEi6rU4FriUYwA4xwxLjEmL0MvoQPA&oe=6A58D0D0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
&oh=00_AQMsgFbrzU7FxTKnaT5zmCiMXZKk6c3FL0bLWJMUIZd_Eg&oe=6AD0E595"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcMPZkAlE8cQ7kNvwGatuF_&_nc_oc=AdqgFPFacLz7gBKjdRl5hIhEn4k32IF4dXleofwo5DojcU7UGAZeJLvIb9xJhln4Dwc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCI3ee65FE1GXWg6dcxeaEsCzBEWZD7ftedUXFooOZ4g&oe=6AD1020E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AkGnq1uFdYQ7kNvwElZTqt&_nc_oc=AdqYDGO8IPiK4ECNhO4U5fy01V-XRW0vbBAGBlth-5J3TYwtRbhvC2w6yLcgLCsPGcg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1K2vnOF9-w5YjYt_d3g92XtZfa8xFg63BkwMllD4tyQ&oe=6AD10190"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
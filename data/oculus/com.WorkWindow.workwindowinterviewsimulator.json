&oh=00_AQIGgy7vC3pBadDCvi7AfzivziIKeA6gluiWAmQ7VaSTrg&oe=6AAD4D15"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9yCfDACM8EQ7kNvwHtja8P&_nc_oc=AdrJRL8F8f0Cn57qHLcicWB0IEDM50jK35NHp_BfczH-LS6ydWZ3d-x8cMVbbBFGMqc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFvO3nKXwekrTRzbalb_2ODIWPi_t2gEOggO_knCwbjg&oe=6AAD314E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-o2rVlx5EMEQ7kNvwGofPLq&_nc_oc=AdqGWgvkp-n496MU4cXXrjZSyaRZQHDjDnLIcmLKkz73hPri6aJYZhqObfNwo-_ttTU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg1z4mqK8sWONIYwz0xeRjPVNg73Vh50_qm_r2n0immg&oe=6AAD30D0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
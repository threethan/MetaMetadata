CtZ2g&oe=69BD5C15"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFQhTCTZPssQ7kNvwF25U_S&_nc_oc=Adkn67BRAQh_SwwtNOQWiXfBBMbsl3BtrDdoNWQW5MlIiSGIOKMlY44kZ1bfWVQYCSg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7-ET7LF0kHNMHtcgMKIPcds6eeajunB6hCtJT99A3tg&oe=69BD404E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFjn7yTPTS8Q7kNvwFAMfJx&_nc_oc=Adm45FIR-n9vhwpXuyQx26IRsDK2XWmGlKb1pcEwRVHwSrAmDfG_W8FdRsMXMS7G3zU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwdtIbFxWCCWJq0nlG8ZA44HXxPQeitP2nSBJgJUK_thw&oe=69BD3FD0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.com.au/terms-and-conditions", "publisher_name": "Work Wind
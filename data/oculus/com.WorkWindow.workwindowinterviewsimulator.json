&oh=00_Af4lZGCgWnw26TFtGhNAV-tKSCicZylBRNPdfeql-ytXEA&oe=6A09D315"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXafpWZZ12gQ7kNvwGxyvCt&_nc_oc=AdpEBHSQnHA2V3fKS7Pz0Py7Puj-2e8sMA6T_s0mnC-QcVPPhx4knWPqeAUm6BWBEF8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SC6LZv4D1NXaFOnxv_MuxRAyiY7g71aduFO8-eryG5w&oe=6A09B74E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6df8MNHjGkQ7kNvwFySCWq&_nc_oc=AdrWLf7i-NK7OIFm9SLGISepTNH_kMu-JB_murkn7YOCjDc54JTTmh8VMS__c2z04yA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nT1J8nNVJXxXM42IlkrT9-DND0Sm8jJO-AjgBxS6DBw&oe=6A09B6D0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
&oh=00_AQJzVktWgD7dKaMrm8VxIBrSkv2lvtdXV9cILxlJjGl0yA&oe=6AA01E15"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iYjlq7nfHpUQ7kNvwGTUoqu&_nc_oc=AdowlX32Ju2Z45TqpStOrXhksHUTbtn_F6JROVruDqpcIo2oGSpr0xCfyp9TH_wBQi8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIySnzun40DCvxKIw-Zo2PY_Z-1qJz6rRjuHL505WpJCg&oe=6AA0024E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR8xsn7AOqEQ7kNvwHpRv34&_nc_oc=Ado3GebVh6AMA0n2qeV0m3cOAdQpMoomdoLVr5Ho1rJtu_GfgsTzYpWbYvuYHu0cMlI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMrrRF-TUTmhTJug1U-2JL9G0La_tg84nw_dT5baNESQ&oe=6AA001D0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
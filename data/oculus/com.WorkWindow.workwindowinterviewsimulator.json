&oh=00_Af1bgF79Mh9tTRdkzPGAxxPMu0rugFp_NMmR0ij01knnVA&oe=69D7BA15"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CIBr19pbZEQ7kNvwH2ZiXq&_nc_oc=AdpwSK7WhVV4JVbM6d_Nucvzk7whQnNgSEN9yp4RfaKkd3Tf1jcvOSQu0zH7Skpp1J0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N2oLxN0AxkU_Jqw_IjIXW2mTKBgkXEAwstXkil8RaMg&oe=69D79E4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blICDIdPCSIQ7kNvwF0mryi&_nc_oc=AdpsXL8FdZvYrLrYuddUZdMkppt8z02wC86TFqugMDVWG85skU3I_3N6-P3jiV1Epfs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m2yTx0Thu5F4ttMfwkbh0jrohIXFyku5Oi_SscP8ZAQ&oe=69D79DD0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
&oh=00_Af621Ln9dJNYrAuOO9fVwcY3Si5uyJDPncuDT8XUbBAHGg&oe=6A0F1915"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1zTIOH9dnYQ7kNvwFabNow&_nc_oc=AdoFqcNJJDoGRWSddl9Pf1Why9VtL6qcU9GB5KArlDsjuY0ktmkN4npA1Vo0NcG6nlg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Jv9k_-l3uotzCTfdVAxNTvj-hVW3KTWKVmAR1fnaoqQ&oe=6A0EFD4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G3ngIX27pecQ7kNvwGjGVEG&_nc_oc=Adpd_OqUv1Qcu4oj8K0n9irKkuFZZ3Z13OJ0aY8IjF4vsBId9b3dBeR5WFPPfawpbjU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48v8iJx9aIKEEstLjcN_svqfXn1BTxMmJelMLSk4trSw&oe=6A0EFCD0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
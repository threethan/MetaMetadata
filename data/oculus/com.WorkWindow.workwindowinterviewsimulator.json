&oh=00_Af2IeDRTu9hG4NwWC3GJSpLYkETfvb1VlTt1V1Dp5UuEFA&oe=69D90B95"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY42FZzhV2cQ7kNvwEEzZPH&_nc_oc=AdpuATMU1A8Rh0Qg1c190o1L6RY2ka31lAYIMa2Y20j1glrHZ_oeZWoICNloORFRF2E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uu_BfEb5dDTyfb6bxBv2nueXMUdpzwlxbnmDxahqyLw&oe=69D8EFCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blICDIdPCSIQ7kNvwET-YLV&_nc_oc=AdoqSohDfBNKISjGZhVfAskzdgFFssCBE-oLuryJ9-lMEdEifeX2pgjC13DwIF8CwUw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pKgqsfe0XVlXu6kSm2QIPFDn9OOm1dSE-uDUS7tOf_A&oe=69D8EF50"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
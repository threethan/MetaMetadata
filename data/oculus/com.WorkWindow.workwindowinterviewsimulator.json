uscdn.com&_nc_ss=7f20f&oh=00_AQGcZYwOi22uT0B51FXxQE9QXFVIrK0qD4juyI-Y7a1enQ&oe=6A8EC255"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK-Va89BYhcQ7kNvwH84xRL&_nc_oc=AdpkvaEidNO2o8YE0Yg8xoJq1sHJY32qY3RkCpfNxYQXnuoDXRP2Hr9dxTBfqv7BUvI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF4F0c3kI1SbtRuA80pjuCabzVUKOlhYx5f9xo9lo1Wg&oe=6A8EDECE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAoc72dCHYkQ7kNvwEA_Cn-&_nc_oc=AdoaYxNRdxWlRKAzV4K7BXaMzujGYgMUpu_foVTrzjOHdhcqwnPmySopH4Bcqeo_Ea8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA4i8jboIO7rpCloGgqJitYnCvauhMMjUxHWE8hc_wQA&oe=6A8EDE50"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "h
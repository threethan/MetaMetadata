&oh=00_Af1Wqh_AgXZeAdO2epTFQgpCFXfXkXyXTIMFCVKSnGKUaA&oe=69E8DD95"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9ciqnMpp9QQ7kNvwFTIZln&_nc_oc=Adp7t4OwUnEc9XHAHRIauZ74gLfhCnXVEDWtmPeloISBgeWc2XSztEqz1Lr90wMnCJI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bNOlB-ur21KW6BxDd3RvcTuc9YyaBSZtYxO4QU4zCpA&oe=69E8C1CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xdKHUwJqmf8Q7kNvwFBTZUy&_nc_oc=Adpx01JiqJO5ikmk9e4Gev9iu946VtsCbh168YWnrrzATTblDFnTR9R_PmrxEx4OT88&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-7_NMS9jChnxsTq1L-Q0UBYpJGIp2_1fdWkCcY0he1A&oe=69E8C150"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
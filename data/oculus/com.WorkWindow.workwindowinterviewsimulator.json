&oh=00_Af0WixhTVINAsgjHCNy1l5x7pIwOsBTV5s_aZqhWqfuGiQ&oe=69E4E915"}, {"file_name": "Interview_01.png", "id": "558098475502894", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982460_558098478836227_2195642163881727498_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vR1hMsoJ-8Q7kNvwFJKn0D&_nc_oc=Ado-xK3x85GGphHzL5cbC49RJ1nKMdzPI3njDt2F-Z-HewHb79IIeHMtSmISIjIH_Tc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_f6s08hicMisnCtti5wphLczMws6y8wxsLzh_uwDP6A&oe=69E4CD4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "JOb INterview Simulator (4).png", "id": "371985591479423", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035469_371985598146089_1320847157226308449_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2MVOYTupYMQ7kNvwF650No&_nc_oc=AdogHHGaXeBPEM1FgPigp3fqjZVkzGXymQ9kPOAWKvo-xFKxS5ptk0OvjpUwRqPkj0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gW-POWyBNi1MI-TztvTN_CAVyweUjkQpVfaajhi8zBg&oe=69E4CCD0"}, "display_name": "Job Interview Simulator", "keywords": [], "long_description": "Proficient job interviewing craft is vital to attain the careers of our dreams. Unfortunately, it's difficult to practice this skill in a realistic way.\n\nThat's why we built the Job Interview Simulator. Simulate the entire interviewing process; from emailing HR before the interview, picking an outfit, arriving on time, catching the elevator, greeting the receptionist, and acing the interview. \n\nFeel the situational pressure of a Job Interview in an immersive virtual environent, and refine your interviewing craft with automated feedback. \n", "short_description": "Simulate the experience of a Job Interview in Virtual Reality. Practice and hone your interviewing craft in a safe setting, so you can ace your next job interview!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.workwindow.com.au/privacy-policy", "developer_terms_of_service_url": "https://www.workwindow.co
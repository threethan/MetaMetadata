ent-iad3-1.oculuscdn.com&oh=00_AfvN9rHS1W7vvWlcyCCjn6m2g2GlFXXN610LvIaY3vzJfA&oe=69A2D6D4"}, {"file_name": "1 Copy.png", "id": "721745565151732", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75348038_721745571818398_684500577590025373_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gPc4myX_TAQ7kNvwGrWrpK&_nc_oc=AdnPmTBdHSC_uYu4lKX5eeMoD_v21KkNsS8uuVu91nd2SCCZEjO0l5qvAxAvMAaywEw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs3VvjaB_Kznjy4d9y7kWhlGF2MRtP2s1xTx4sTS1rIZQ&oe=69A2D797"}, {"file_name": "5 - Copy.png", "id": "419617582706910", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003251_419617586040243_4410886308495245384_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KH4XOnm7vKQQ7kNvwEmBkw8&_nc_oc=Adm2jNoF24e8e-TbezdlxEyZ41sIb3IhnZ4I1SMlYf5Mnmq08NSgptkPHuYocLGcIxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft34k3QUOtivCxznjVwCraPB5HJrI3ATL75Djcp_vMd3g&oe=69A2EFA4"}, {"file_name": "2 - Copy.png", "id": "233435565097163", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75234364_233435568430496_2650167103344535397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EQbaKz3q30Q7kNvwHR4g7w&_nc_oc=AdlByVi97ynzA769G19J3ACv-81U3bLhuSO9yMF3yzkAxeQQ8RFtTKQaYTeArs35O9Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv5eAkXlRy2FmRIO20D5W4gKtn1lLdckuyv3oNnBNFuTg&oe=69A2DC0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRtuos", "keywords": [], "long_description": "Just calibrate your real piano and press play! Notes will fall directly onto your keys, so it's really easy to learn how to play any song pretty fast. There are many songs included, but you can also import your own .mid files.\n\nYou can also connect your midi piano using the Companion app from https://vrtuos.eu. If you do that, you will unlock two more modes and you will see keys press down.", "short_description": "A VR piano learning app for Oculus Quest"}, {"images": {"nodes": []}, "id": "491991228712757", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRtuos", "keywords": [], "long_description": "Zkalibrujte si sv\u00e9 opravdov\u00e9 pi\u00e1no a hrajte! Noty padaj\u00ed p\u0159\u00edmo na kl\u00e1vesy, tak\u017ee nau\u010dit se novou skladbu nen\u00ed \u017eadn\u00fd probl\u00e9m. Vyberte si z mnoha skladeb, nebo si importujte vlastn\u00ed .mid soubory.\n\nPokud m\u00e1te midi piano, m\u016f\u017eete si ho s aplikac\u00ed propojit s Companionem z https://vrtuos.eu. D\u00edky n\u011bmu se v\u00e1m otev\u0159ou dal\u0161\u00ed dva m\u00f3dy a tak\u00e9 uvid\u00edte stisknut\u00e9 kl\u00e1vesy p\u0159\u00edmo ve h\u0159e.", "short_description": "VR aplikace kter\u00e1 v\u00e1s nau\u010d\u00ed hr\u00e1t na piano"}]}, "developer_name": "Pavel Marceluch", "developer_privacy_policy_url": "https://vrtuos.eu/PrivacyPolicy.txt", "developer_terms_of_service_url": "https://vrtuos.eu/#eula", "publisher_name": "Pavel Marceluch", "support_website_url": "http://vrtuos.eu/eula.html", "website_url": "https://vrtuos.eu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "fr", "de", "ru", "sv"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1388501858248200"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_443765793489615_2414528281973950576_n.png?stp=dst-png_s360x3
wFGdbjT&_nc_oc=AdpEhCVVq69xuQeNL-Tl1pPZsf2dKxAkVQpZxMgUoM_s-PSFtfjkg8K9la4Jfrv5elE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Jzvy3xWjHfCNjbvWaxSnciTPqs02f8kMVdA3WYSW00A&oe=6A01C2D4"}, {"file_name": "1 Copy.png", "id": "721745565151732", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75348038_721745571818398_684500577590025373_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVaaIEfF6YYQ7kNvwEBt7Qv&_nc_oc=AdrM__4v4Xf1eExY6p_3bPeK1-YBLcy0vYT2Cd4MPrhw3V3FhIBMoYRdJhanwE7MLpk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wB7vt47QTtaxh53dAAYDJH8LMJ2-yfb9yLK1mAA8lDg&oe=6A01C397"}, {"file_name": "5 - Copy.png", "id": "419617582706910", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003251_419617586040243_4410886308495245384_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOdySPkW8BEQ7kNvwHwhD1P&_nc_oc=AdqBxjRJ90mk0eMq7Flt-ixtAaq6urR35KZcmImeBNNDNjoFKmgS_LLrwSiwaLOSga4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xjOQgV0sP5--kNBn9AmmJrBS3_RyNoDEIqoXUnpGu6w&oe=6A01DBA4"}, {"file_name": "2 - Copy.png", "id": "233435565097163", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75234364_233435568430496_2650167103344535397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDQQYep_SXQQ7kNvwG3xchS&_nc_oc=AdpGVXIXGQS5AfH3i9q3Iqi-9eCDwhub6Baj5cnb9bdah2GF73zyh16L3Ef_xOdo31I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a_ekQKG4VcXyk9HRUipdW_0LhZH760NyNaKZLf5jwAQ&oe=6A01C80C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRtuos", "keywords": [], "long_description": "Just calibrate your real piano and press play! Notes will fall directly onto your keys, so it's really easy to learn how to play any song pretty fast. There are many songs included, but you can also import your own .mid files.\n\nYou can also connect your midi piano using the Companion app from https://vrtuos.eu. If you do that, you will unlock two more modes and you will see keys press down.", "short_description": "A VR piano learning app for Oculus Quest"}, {"images": {"nodes": []}, "id": "491991228712757", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRtuos", "keywords": [], "long_description": "Zkalibrujte si sv\u00e9 opravdov\u00e9 pi\u00e1no a hrajte! Noty padaj\u00ed p\u0159\u00edmo na kl\u00e1vesy, tak\u017ee nau\u010dit se novou skladbu nen\u00ed \u017eadn\u00fd probl\u00e9m. Vyberte si z mnoha skladeb, nebo si importujte vlastn\u00ed .mid soubory.\n\nPokud m\u00e1te midi piano, m\u016f\u017eete si ho s aplikac\u00ed propojit s Companionem z https://vrtuos.eu. D\u00edky n\u011bmu se v\u00e1m otev\u0159ou dal\u0161\u00ed dva m\u00f3dy a tak\u00e9 uvid\u00edte stisknut\u00e9 kl\u00e1vesy p\u0159\u00edmo ve h\u0159e.", "short_description": "VR aplikace kter\u00e1 v\u00e1s nau\u010d\u00ed hr\u00e1t na piano"}]}, "developer_name": "Pavel Marceluch", "developer_privacy_policy_url": "https://vrtuos.eu/PrivacyPolicy.txt", "developer_terms_of_service_url": "https://vrtuos.eu/#eula", "publisher_name": "Pavel Marceluch", "support_website_url": "http://vrtuos.eu/eula.html", "website_url": "https://vrtuos.eu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "fr", "de", "ru", "sv"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1388501858248200"}, "review_messages": []}
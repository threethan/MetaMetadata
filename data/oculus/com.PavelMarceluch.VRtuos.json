pGI3ssZTG0a2yyBiemm2gJIdJXllxR8-u2qgoMlBzu_1lQEb-o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXV9B02U3l_BfFb6AYbMURMt4Ipdni6dqGKevOkodcPg&oe=69B005D4"}, {"file_name": "1 Copy.png", "id": "721745565151732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75348038_721745571818398_684500577590025373_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt5XokaRfPAQ7kNvwFHesEZ&_nc_oc=AdkWCmlrfYfF7LXigbeRD4es3JqaL_EcZKq6tyFFhQH0qBkXV8rByLv60COWvZil_Jk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-sEqYvTnlFzl391bqpYsGvVZZJCS8Q9U-7XOHiU1oww&oe=69B00697"}, {"file_name": "5 - Copy.png", "id": "419617582706910", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003251_419617586040243_4410886308495245384_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOMuWKFlRrQQ7kNvwF9HLnd&_nc_oc=AdkMH9KclDJo93MMUZdYvL_DLAQUgXwH103KQajuLtyO_CTG-1I2e27aIx6oFs1xY8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbgdnE6hX2X5YJV9kijndiqX5x13sIf5UMBQHdacwjiw&oe=69B01EA4"}, {"file_name": "2 - Copy.png", "id": "233435565097163", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234364_233435568430496_2650167103344535397_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6XAr6U9snEQ7kNvwHc2_wl&_nc_oc=Admr890Ktei0TT7da6ZD8odD5YPYq7sdv1CeQ4rtBeryf4DEn63Hn1FF55Iv6DepPHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJVzQed8296bWWRmx8V7X2gTQnJApOc3fwQAv7gqCjMg&oe=69B00B0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRtuos", "keywords": [], "long_description": "Just calibrate your real piano and press play! Notes will fall directly onto your keys, so it's really easy to learn how to play any song pretty fast. There are many songs included, but you can also import your own .mid files.\n\nYou can also connect your midi piano using the Companion app from https://vrtuos.eu. If you do that, you will unlock two more modes and you will see keys press down.", "short_description": "A VR piano learning app for Oculus Quest"}, {"images": {"nodes": []}, "id": "491991228712757", "locale": "cs_CZ", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRtuos", "keywords": [], "long_description": "Zkalibrujte si sv\u00e9 opravdov\u00e9 pi\u00e1no a hrajte! Noty padaj\u00ed p\u0159\u00edmo na kl\u00e1vesy, tak\u017ee nau\u010dit se novou skladbu nen\u00ed \u017eadn\u00fd probl\u00e9m. Vyberte si z mnoha skladeb, nebo si importujte vlastn\u00ed .mid soubory.\n\nPokud m\u00e1te midi piano, m\u016f\u017eete si ho s aplikac\u00ed propojit s Companionem z https://vrtuos.eu. D\u00edky n\u011bmu se v\u00e1m otev\u0159ou dal\u0161\u00ed dva m\u00f3dy a tak\u00e9 uvid\u00edte stisknut\u00e9 kl\u00e1vesy p\u0159\u00edmo ve h\u0159e.", "short_description": "VR aplikace kter\u00e1 v\u00e1s nau\u010d\u00ed hr\u00e1t na piano"}]}, "developer_name": "Pavel Marceluch", "developer_privacy_policy_url": "https://vrtuos.eu/PrivacyPolicy.txt", "developer_terms_of_service_url": "https://vrtuos.eu/#eula", "publisher_name": "Pavel Marceluch", "support_website_url": "http://vrtuos.eu/eula.html", "website_url": "https://vrtuos.eu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "EDUCATIONAL", "MUSIC"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "fr", "de", "ru", "sv"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1388501858248200"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
4XvrXHOPOj1NIpX79vCAU3hIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwOi8_PDIbPmkqRq9eNrzposSJrMtkfV0zJUcGeGrwxpQ&oe=69B69B36"}, {"file_name": "thumbnail-safespaceforest3.png", "id": "2568262943376785", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393150_2568262946710118_7210572152262734508_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTHevvyfSl4Q7kNvwFEU8KJ&_nc_oc=AdmJUwyrs9czkAWjbvROMVFyhUt0CgUeln8tKAfy5-Tciy8Rt6EK1xbNxwt5SALlGCU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3eQZTDZK1zmZ0N0MAK4m69Xz3dvw2LYRDl53o1rXN1w&oe=69B6C23B"}, {"file_name": "thumbnail-meetingroom1.png", "id": "634345539155359", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391788_634345542488692_5242654204809949471_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6SOrFpO6nYQ7kNvwFcjD74&_nc_oc=AdkBJ8geWrQxuCoXQSTdeh4KuT1xmUlt_Q-r0kYfJLKt7E-wJ3DOdjKxeqOBSJyunfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDGWRr7uNKCRHVGKpxkGin49D_fwGrW5gzpGdH8NxnIg&oe=69B693FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "air Trailer cover.png", "id": "623790446774367", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391777_623790450107700_1145871172210334362_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tt48ZSg2C1MQ7kNvwF3xhET&_nc_oc=AdnwUM0y2rTQuMR5G_IMcFY0xDIzSjjyuNQrtep3tWbotawvqDkmbXZSWc_GbxlpQHk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrkmDROZzHXkRzFbW7_vAOnPNS9NaKefEA7eq_aR3e-A&oe=69B6A206"}, "display_name": "Evrience Air", "keywords": ["therapy", "coaching", "psychology", "health", "exposure"], "long_description": "VR Counselors and their clients meet together in immersive, carefully designed VR environments. Before welcoming up to 5 clients, the VR counselor selects, from a library of specialized programs, the one that best supports their client\u2019s needs.\nSimulations vary from spaces that challenge fears, to places that bring calm and comfort. VR counselors guide the experience, giving clients a sense of security and support as they explore and overcome obstacles and broaden skills.\nDesigned to support growth, healing, and resilience, Evrience offers tools that bridge the gap between traditional counseling and the possibilities of virtual reality.", "short_description": "Evrience is a space where care meets the transformative power of virtual reality. In Evrience Air, therapists, trainers, or coaches become VR Counselors, receiving their clients from anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evrience.com/evrience-air-privacy-policy", "developer_terms_of_service_url": "https://www.evrience.com/evrience-air-terms-of-service", "publisher_name": "Evrience", "support_website_url": null, "website_url": "https://www.evrience.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8888247824562163"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1113683993312665"}]}, "baseline_offer": {"id": "1113683993312665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737933780, "status": "PUBLISHED", "id": "1113683993312665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "bi
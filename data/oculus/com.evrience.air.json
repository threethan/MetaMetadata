me": "Evrience Air", "keywords": ["therapy", "coaching", "psychology", "health", "exposure"], "long_description": "VR Counselors and their clients meet together in immersive, carefully designed VR environments. Before welcoming up to 5 clients, the VR counselor selects, from a library of specialized programs, the one that best supports their client\u2019s needs.\nSimulations vary from spaces that challenge fears, to places that bring calm and comfort. VR counselors guide the experience, giving clients a sense of security and support as they explore and overcome obstacles and broaden skills.\nDesigned to support growth, healing, and resilience, Evrience offers tools that bridge the gap between traditional counseling and the possibilities of virtual reality.", "short_description": "Evrience is a space where care meets the transformative power of virtual reality. In Evrience Air, therapists, trainers, or coaches become VR Counselors, receiving their clients from anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evrience.com/evrience-air-privacy-policy", "developer_terms_of_service_url": "https://www.evrience.com/evrience-air-terms-of-service", "publisher_name": "Evrience", "support_website_url": null, "website_url": "https://www.evrience.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "u
mTGRWzAmPGD9dJqwnXJ1t-FNA&oe=699D8EB6"}, {"file_name": "thumbnail-safespaceforest3.png", "id": "2568262943376785", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393150_2568262946710118_7210572152262734508_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi_fi0jgJ8cQ7kNvwH5iCDt&_nc_oc=AdlMDXv627AQN6f85W6wzZ1RS7blGy_wXQ24B38y157irbjndhN7sF26QNE6lAhXOkk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsGU8NWsEun7hx3Xzhp51hrbaqmiqT1eBPwYsMfu_9GGg&oe=699DB5BB"}, {"file_name": "thumbnail-meetingroom1.png", "id": "634345539155359", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391788_634345542488692_5242654204809949471_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmlyYejdBgMQ7kNvwGfhDT6&_nc_oc=AdmMi_E5OZ12XQ4Fv1thB7vLnBZSHis8wf18uPFTId78R4n7gZT8sUs7v5KtN--enok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsVPw9oGDpy9iK9b2I9c8a4bdlit1oE1_7Sc6Xh45ggHQ&oe=699D877E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "air Trailer cover.png", "id": "623790446774367", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391777_623790450107700_1145871172210334362_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lE-UCTQ8NoQ7kNvwECndFR&_nc_oc=AdkSxFq7w_0FDAqr0bp5hZSkIG2sQ3yxOAmdTSnrwovIarK9TxdjioNDsCTT3G-QxBY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsZg83kuqheCl6q2qcGFc5gyTXV1r0C-Y7TNtqPZvU2fw&oe=699D9586"}, "display_name": "Evrience Air", "keywords": ["therapy", "coaching", "psychology", "health", "exposure"], "long_description": "VR Counselors and their clients meet together in immersive, carefully designed VR environments. Before welcoming up to 5 clients, the VR counselor selects, from a library of specialized programs, the one that best supports their client\u2019s needs.\nSimulations vary from spaces that challenge fears, to places that bring calm and comfort. VR counselors guide the experience, giving clients a sense of security and support as they explore and overcome obstacles and broaden skills.\nDesigned to support growth, healing, and resilience, Evrience offers tools that bridge the gap between traditional counseling and the possibilities of virtual reality.", "short_description": "Evrience is a space where care meets the transformative power of virtual reality. In Evrience Air, therapists, trainers, or coaches become VR Counselors, receiving their clients from anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evrience.com/evrience-air-privacy-policy", "developer_terms_of_service_url": "https://www.evrience.com/evrience-air-terms-of-service", "publisher_name": "Evrience", "support_website_url": null, "website_url": "https://www.evrience.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "478089301798119"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "8888247824562163"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1113683993312665"}]}, "baseline_offer": {"id": "1113683993312665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737933780, "status": "PUBLISHED", "id": "1113683993312665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9116391728414437", "version": "1.0.081"}, "id": "531413099709417", "channel_name": "LIVE"}]},
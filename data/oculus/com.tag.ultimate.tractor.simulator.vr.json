iMUcY7ekB0drPuqczjgYabBT6Ukir8vWwDq7UOHhwk2WffOfIGg41frKU4ir8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR39igZ281QGCVtQFs2PsFqB-pDAomG8IqAIfvHK1GCQg&oe=6B0C5428"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultimate Tractor Simulator VR", "keywords": ["TractorSimulator", "TractorDriving", "FarmingVR", "TractorGame"], "long_description": "\ud83d\ude9c Ultimate Tractor Simulator VR\n\nGet behind the wheel and experience tractor driving and farming in immersive VR!\n\nUltimate Tractor Simulator VR puts you in the driver's seat of a powerful tractor. Explore the farming environment, complete tractor-based tasks, and progress through 3 challenging levels.\n\n\ud83d\ude9c Master the Tractor\n\nTake control of your tractor and experience an immersive first-person driving experience. Learn the controls, navigate the environment, and complete your assigned farming tasks.\n\n\ud83c\udf3e Complete 3 Levels\n\nThe game features 3 levels, each designed around tractor driving and farming tasks. Complete your objectives and progress through every level.\n\n\ud83c\udfae Immersive VR Gameplay\n\nExperience tractor driving from a first-person VR perspective. Use your VR controls to operate the tractor and interact with the gameplay environment.\n\n\u2b50 Key Features\n\n\u2022 3 challenging levels\n\u2022 Immersive VR tractor driving\n\u2022 Farming and tractor tasks\n\u2022 First-person VR gameplay\n\u2022 Tractor simulator experience\n\u2022 Farming environment\n\u2022 Level-based progression\n\u2022 Easy-to-learn tractor controls\n\nStart your engine, take control of your tractor, complete your farming tasks, and conquer all 3 levels.\n\nGet ready to drive, farm, and experience tractor simulation in VR!", "short_description": "Experience immersive tractor driving and farming in VR. Complete challenging tasks across 3 levels and master the art of tractor driving in Ultimate Tractor Simulator VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/top-art-games/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Top Art Games", "support_website_url": null, "website_url": "https://sites.google.com/view/top-art-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1312750191926875"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1095133536616885"}, {"status": "PUBLISHED", "id": "1403423478636746"}]}, "baseline_offer": {"id": "1095133536616885"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792425660, "status": "PUBLISHED", "id": "1095133536616885"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1308498172352077", "version": "1.0"}, "id": "1090232826829862", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1306377462564148", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1308498172352077"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1090232826829862"}]}, "change_log": null, "created_date": 1790358993, "id": "1308498172352077", "versi
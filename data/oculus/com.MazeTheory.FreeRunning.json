zu5Gw9_bR4aUG2Yye5OYgcr9z1l5ho8MTWHzA&oe=6AFB19FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FreeRunner Landscape.png", "id": "1019442932609668", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982548_1019442935943001_5378732379731031128_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L4guX1-0uswQ7kNvwFSlo06&_nc_oc=Adq4B69_YWZsfT2XTE8iCS4G5eEhibFJAmGjomhS3uUwvGBuwer1Twt4Xo_9zl7AAsw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD5p7bsQ1E9F-x33qwPDIAdnNDKLP80_iHH-3e6m7sGQ&oe=6AFB4081"}, "display_name": "Freerunner Championship", "keywords": [], "long_description": "Update 0.16 Released - Enhanced Movement for Better Vaulting and Scrambling, Plus New Leaderboard & Challenge Features\n\nFreerunner Championship is a parkour-inspired racing game where strategy and precision collide in an exhilarating race through challenging urban landscapes to achieve the fastest time!\n\nEvery move matters, with speed and accuracy being rewarded. Your mission is to find the quickest route to victory!\n\nCompete against international opponents - only one can top the global leaderboard!\n\nFreerunner Championship is a Maze Theory i-labs prototype. This project is under continuous development, and we greatly appreciate your feedback.", "short_description": "In Freerunner Championship, every move you make is a step towards perfection or failure. This is where precision and strategy collide, with the ultimate goal of reigning supreme on the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.maze-theory.com/legal/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Maze Theory Limited", "support_website_url": null, "website_url": "https://www.maze-theory.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480
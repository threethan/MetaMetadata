eT2e7pzrgXHXxb-1pT336g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8n3ivdCG7WbddQQGVOALiLX8nEiJLJQRuYJb53u5CZw&oe=69CA586D"}, {"file_name": "Freerunner-screenshot-4.png", "id": "875563257541462", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_875563264208128_1340155476064611569_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxEs_r6xKzsQ7kNvwGjCn_W&_nc_oc=AdqUzA0glE0w2lRenOLl4XUvK6YeDzbNcQbC1PSARIQ6MsURyTRMWJY__oCIz0rvOqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwwbn7gy9Dt3ynd6cj78uY5LR0DkzBHXKKGA3B7h7XB_g&oe=69CA7A3D"}, {"file_name": "Freerunner-screenshot-3.png", "id": "1480129506118048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974800_1480129512784714_3456502508510626327_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wfin_-dd68Q7kNvwEtyUKE&_nc_oc=AdrUfE6y3QVLEtOmilQjqADMSP4ZfzB6xpRO0apcJl1CBRbjmn3BkeazpuRaOGdDQPI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyj5lHicWZdneCM5OGMgY4f5UKD_Mb-G1kv1-gepvb3iQ&oe=69CA7120"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Freerunning-coverart.png", "id": "1383227005604287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031462_1383227008937620_6178204217613389819_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_ZZRhmS7eYQ7kNvwGEuLmO&_nc_oc=AdoOQbtf3Hv-OyTTmbUupLboc3JnHYoWGwa3-8WE0Q9mpYxteZ2WI2FU2m_tJd0Zucg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyXJirhwTs9lfS4uHoSXchO3XnODEsEuvsk6SGpb-8F9g&oe=69CA6F23"}, "display_name": "Freerunner Championship", "keywords": [], "long_description": "Climb the leaderboard in Freerunner Championship, a competitive VR parkour game that will push your skills to the limit! With heart-pounding action across 5 levels, scale towering walls, navigate treacherous rooftops, and execute death-defying leaps. \n\nRACE TO THE TOP: Compete against global players to clinch the fastest time.\n\nEVERY MOVE COUNTS: From skyscrapers to narrow ledges, precision is paramount. Your route choice and strategy can make or break your record.\n\nURBAN MASTERY: Delve deep into parkour; ascend massive structures, manoeuvre across slim rooftops, evade barriers, and launch into fearless leaps.\n\n5 UNIQUE LEVELS: Traverse diverse settings, from towering rooftops to bustling streets, each offering distinct parkour hurdles.\n\nWith high stakes and higher drops, it's not for the faint-hearted! Are you daring enough to dominate the urban jungle?\n", "short_description": "Climb the leaderboard in Freerunner Championship, a competitive VR parkour game that will push your skills to the limit! With heart-pounding action across 5 levels, scale towering walls, navigate treacherous rooftops, and execute death-defying leaps. With high stakes and higher drops, it's not for the faint-hearted! Are you daring enough to dominate the urban jungle?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.maze-theory.com/legal/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Maze Theory Limited", "support_website_url": null, "website_url": "https://www.maze-theory.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9932927900115661"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3530331940559072"}]}, "baseline_offer": null, "i
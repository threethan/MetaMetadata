KxKxjgCpL18nQrtGsSyJQg4Iuc-9ZOm3b8V0nw&oe=69BD296D"}, {"file_name": "Freerunner-screenshot-4.png", "id": "875563257541462", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_875563264208128_1340155476064611569_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SykA4w1pVnoQ7kNvwEPy_An&_nc_oc=Adn1u60bqlLneuO_DSsdS0WYD6f53TM2-7zH0LNdmYivXRzExMT4z3ND9JcLu7KKA9A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyz3Zr_ghQMJdnoTPckoqI7puFS-uIuCUbRnI1wa8C4tg&oe=69BD4B3D"}, {"file_name": "Freerunner-screenshot-3.png", "id": "1480129506118048", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974800_1480129512784714_3456502508510626327_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TlK9L48dOEQ7kNvwGsXCZ_&_nc_oc=AdkjtZVb6ph1pTnPNB2ULSAvkO1NfVIH8Yg7E0IIwX6l-N9Y-u8TdIJPJGFGQIjbBfE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYfwm_gLlPKeFqszIcBEoop9XwFCxBFKtHBUb-CDWgUQ&oe=69BD4220"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Freerunning-coverart.png", "id": "1383227005604287", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031462_1383227008937620_6178204217613389819_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnyXogv0DAYQ7kNvwE5pJyY&_nc_oc=Adnh0gc4fFnWddAtdVzKBXKbgaxi--yqNQ953Gtjd476OXuPp1IE4rJMsL010zt9r-I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwfK6-Z_MWJ0Sl1_-qeYhg9OPheQzZqnGdI5dEELM8Hcw&oe=69BD4023"}, "display_name": "Freerunner Championship", "keywords": [], "long_description": "Climb the leaderboard in Freerunner Championship, a competitive VR parkour game that will push your skills to the limit! With heart-pounding action across 5 levels, scale towering walls, navigate treacherous rooftops, and execute death-defying leaps. \n\nRACE TO THE TOP: Compete against global players to clinch the fastest time.\n\nEVERY MOVE COUNTS: From skyscrapers to narrow ledges, precision is paramount. Your route choice and strategy can make or break your record.\n\nURBAN MASTERY: Delve deep into parkour; ascend massive structures, manoeuvre across slim rooftops, evade barriers, and launch into fearless leaps.\n\n5 UNIQUE LEVELS: Traverse diverse settings, from towering rooftops to bustling streets, each offering distinct parkour hurdles.\n\nWith high stakes and higher drops, it's not for the faint-hearted! Are you daring enough to dominate the urban jungle?\n", "short_description": "Climb the leaderboard in Freerunner Championship, a competitive VR parkour game that will push your skills to the limit! With heart-pounding action across 5 levels, scale towering walls, navigate treacherous rooftops, and execute death-defying leaps. With high stakes and higher drops, it's not for the faint-hearted! Are you daring enough to dominate the urban jungle?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.maze-theory.com/legal/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Maze Theory Limited", "support_website_url": null, "website_url": "https://www.maze-theory.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9932927900115661"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3530331940559072"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1698767280, "status": "PUBLISHED", "id": "3530331
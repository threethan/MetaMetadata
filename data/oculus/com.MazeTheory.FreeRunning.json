6e7a0a&_nc_ohc=fJ8zMfOY5q4Q7kNvwFYl6mq&_nc_oc=AdoLRBCg1ZmsYVzJQ4PoAJFUd77Z_twmideT4VOtms5Ey4jTpRf5pKkb9078V__vqg8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFU_ax0g-YU8ftZhtXqybqHM7DmkXxsjOuLLc5eT30Rzg&oe=6A8C1201"}, "display_name": "Freerunner Championship", "keywords": [], "long_description": "Update 0.16 Released - Enhanced Movement for Better Vaulting and Scrambling, Plus New Leaderboard & Challenge Features\n\nFreerunner Championship is a parkour-inspired racing game where strategy and precision collide in an exhilarating race through challenging urban landscapes to achieve the fastest time!\n\nEvery move matters, with speed and accuracy being rewarded. Your mission is to find the quickest route to victory!\n\nCompete against international opponents - only one can top the global leaderboard!\n\nFreerunner Championship is a Maze Theory i-labs prototype. This project is under continuous development, and we greatly appreciate your feedback.", "short_description": "In Freerunner Championship, every move you make is a step towards perfection or failure. This is where precision and strategy collide, with the ultimate goal of reigning supreme on the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.maze-theory.com/legal/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Maze Theory Limited", "support_website_url": null, "website_url": "https://www.maze-theory.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [
ng", "id": "2827051337434670", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86621364_2827051340768003_4938074487533118892_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mtk0bPGYcRMQ7kNvwE02rCz&_nc_oc=Adp8Nz3w_mdj58DJgvF_kLjYg5KK-tC2PhiyNDJp473iL3yfC-5Pa4ehLXI-Buw-2eI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwFeLCpnBGkm4ZuvZufYKSZ9GG3CkQh8pU2k7hkPlpqA&oe=6A7D9D79"}, {"file_name": "Freerunner screen3.png", "id": "284612300742451", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982464_284612304075784_7343166333936488767_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3fyd8NlfXoQ7kNvwEMFB25&_nc_oc=AdoyVYqgxRDguNPcoSxuV1xJ5wIa-zUkaCB_nwoGY4MgOjvn-7io9bMegvNHV575css&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXoqyMD5IPQOau78yy6amU0zWyVpSfN-zdO9VgnNdNxQ&oe=6A7DC53F"}, {"file_name": "Freerunner screen5.png", "id": "362116186314082", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75495672_362116189647415_1663910052892429381_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yvh7fOnI2pYQ7kNvwF_B0P1&_nc_oc=AdpxVNnxuSScpbnZqKvxvjUjF_PBfm0GeT8wXgnAY6HARqCKMzyRDtfOjMhk6fvjhWU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7eEWxUTNxK58yPccNFP68n3vHEtnYWrGEhyN7KIJecA&oe=6A7DA3AB"}, {"file_name": "Freerunner screen2.png", "id": "370675732302704", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003242_370675735636037_1128515494385851125_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7TtVw69vmcQ7kNvwE-wclg&_nc_oc=AdrEQjTrX0gDGJs_QnQ2RKThUbxIf716dH02RBvgUyvknnJhNpcgyeMnQ97gGOoZfCA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGmyr4LCcg_O1datEDd_UCr5zIZGbLKqkEP0FQynIwnA&oe=6A7DA33B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FreeRunner Landscape.png", "id": "1019442932609668", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982548_1019442935943001_5378732379731031128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-eO3zFyTLsQ7kNvwHWtsON&_nc_oc=AdpiwI_JGB6SG3EecGEAPZqTBEy_sRlgYSexh81x9p3cQLl-kAzNWcFXxmqshvvTe6o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhlYKPeI8mqB8qDxCSYc2ZcZpDpbhX3YrItgpWmlr0XQ&oe=6A7DC9C1"}, "display_name": "Freerunner Championship", "keywords": [], "long_description": "Update 0.16 Released - Enhanced Movement for Better Vaulting and Scrambling, Plus New Leaderboard & Challenge Features\n\nFreerunner Championship is a parkour-inspired racing game where strategy and precision collide in an exhilarating race through challenging urban landscapes to achieve the fastest time!\n\nEvery move matters, with speed and accuracy being rewarded. Your mission is to find the quickest route to victory!\n\nCompete against international opponents - only one can top the global leaderboard!\n\nFreerunner Championship is a Maze Theory i-labs prototype. This project is under continuous development, and we greatly appreciate your feedback.", "short_description": "In Freerunner Championship, every move you make is a step towards perfection or failure. This is where precision and strategy collide, with the ultimate goal of reigning supreme on the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.maze-theory.com/legal/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Maze Theory Limited", "support_website_url": null, "website_url": "https://www.maze-theory.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
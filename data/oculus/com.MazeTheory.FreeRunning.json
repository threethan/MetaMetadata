ng", "id": "2827051337434670", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86621364_2827051340768003_4938074487533118892_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ml-p6RzaTgQ7kNvwF97hcP&_nc_oc=Adp4jfLQwMoZfZms6ZfanTmSwkYZ3lb16pMjtnrDQqoxIwNEmqyaza16BEcLiObJ76o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFix5c8gcDXXhoA1YjwoheNE7aqSOqh2GLkYVnyV-JiIA&oe=6A858679"}, {"file_name": "Freerunner screen3.png", "id": "284612300742451", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982464_284612304075784_7343166333936488767_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TL25_ZJ3AYQ7kNvwFXi_uu&_nc_oc=AdqZUGwMcEkpkbN4QFkAfs4o-HcS6ESq3oOCdeAlY_RygoJg3-TBE0BrlxLRSzDICjU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdIVpuTmxKmNlX-GIj-kPyyyaPVFT7Y5ofMbITyMxB_Q&oe=6A85AE3F"}, {"file_name": "Freerunner screen5.png", "id": "362116186314082", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75495672_362116189647415_1663910052892429381_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oP_9vr57gIcQ7kNvwFGoRjA&_nc_oc=AdphGRJgvPC0Izy5UBcudVLdfI5MxSLZPqYpseSQw-lzKqlw0zXaCp-drpoZI1w7z88&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYnxks_iosU7CuC_lYalCpiaISE03BAJxveWaPXwYbig&oe=6A858CAB"}, {"file_name": "Freerunner screen2.png", "id": "370675732302704", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003242_370675735636037_1128515494385851125_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qU9PCevy8lYQ7kNvwE9TZ8L&_nc_oc=AdoJTyX5KSCfdPxOYf_YRgpSVjlb_lysmKA2hpHBPX5xWRXoLtKiNVh9kfZ-6JeowWU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIPeedebsyP3Swo8qMuFdRWKowZ6tXU73VgI3yNRbZew&oe=6A858C3B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FreeRunner Landscape.png", "id": "1019442932609668", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982548_1019442935943001_5378732379731031128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VbFNr6rbA-YQ7kNvwF5ud4v&_nc_oc=AdrO9QnbKx9kGPijGMh3qdpAyDyHCg8RlMgR1bdip3krViV3W3iDj7mp2vEEmsWa0vs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRCxK8fbuOIkgGHVgB7HSZNy0sDP3HgS0YDiOO9TlWIQ&oe=6A857A81"}, "display_name": "Freerunner Championship", "keywords": [], "long_description": "Update 0.16 Released - Enhanced Movement for Better Vaulting and Scrambling, Plus New Leaderboard & Challenge Features\n\nFreerunner Championship is a parkour-inspired racing game where strategy and precision collide in an exhilarating race through challenging urban landscapes to achieve the fastest time!\n\nEvery move matters, with speed and accuracy being rewarded. Your mission is to find the quickest route to victory!\n\nCompete against international opponents - only one can top the global leaderboard!\n\nFreerunner Championship is a Maze Theory i-labs prototype. This project is under continuous development, and we greatly appreciate your feedback.", "short_description": "In Freerunner Championship, every move you make is a step towards perfection or failure. This is where precision and strategy collide, with the ultimate goal of reigning supreme on the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.maze-theory.com/legal/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Maze Theory Limited", "support_website_url": null, "website_url": "https://www.maze-theory.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
AnhFrPShbtODV7B8HYYmhI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IDmLB6Y35xELv98ivp-Hz3lyeumAdg4gg20GkXqywDg&oe=6A26D9AD"}, {"file_name": "Freerunner-screenshot-4.png", "id": "875563257541462", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974593_875563264208128_1340155476064611569_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ceiydfjwoxEQ7kNvwHaj43v&_nc_oc=AdrEUjfELcT-vDqlIdDyTiX_0X3-v3AqlOyJJdiczWv3JnjNxlQw12pDW4EEuec3aQY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vHVrY6R_1hL4tGRdTM4nybDeLxbfMo7xFzU-wcHhCiA&oe=6A26C33D"}, {"file_name": "Freerunner-screenshot-3.png", "id": "1480129506118048", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974800_1480129512784714_3456502508510626327_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVoQG3NoGggQ7kNvwGPBjsK&_nc_oc=Adq6ue_CLDqjHRISdEQKNqLa15fv1pqQxnmcoJJYl-J9oZf_QmqcYVnv2bXeNSGwl5c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H3lyXUx79NYZHiF4OdngN34Rp8MK8yzjSaN9zk7FXrw&oe=6A26BA20"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Freerunning-coverart.png", "id": "1383227005604287", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031462_1383227008937620_6178204217613389819_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EC2kHBTNoxIQ7kNvwFgVdHJ&_nc_oc=Adpc3RMtAv8vd4R_Qp2z11Aue2uKsBx2wqcx7mivFa4sUKxKyy4gssI9_GEAod5Edvw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dv4F_mUtYurgX7-CvAh2Xq8m_461AtULepdbatFNXSA&oe=6A26B823"}, "display_name": "Freerunner Championship", "keywords": [], "long_description": "Climb the leaderboard in Freerunner Championship, a competitive VR parkour game that will push your skills to the limit! With heart-pounding action across 5 levels, scale towering walls, navigate treacherous rooftops, and execute death-defying leaps. \n\nRACE TO THE TOP: Compete against global players to clinch the fastest time.\n\nEVERY MOVE COUNTS: From skyscrapers to narrow ledges, precision is paramount. Your route choice and strategy can make or break your record.\n\nURBAN MASTERY: Delve deep into parkour; ascend massive structures, manoeuvre across slim rooftops, evade barriers, and launch into fearless leaps.\n\n5 UNIQUE LEVELS: Traverse diverse settings, from towering rooftops to bustling streets, each offering distinct parkour hurdles.\n\nWith high stakes and higher drops, it's not for the faint-hearted! Are you daring enough to dominate the urban jungle?\n", "short_description": "Climb the leaderboard in Freerunner Championship, a competitive VR parkour game that will push your skills to the limit! With heart-pounding action across 5 levels, scale towering walls, navigate treacherous rooftops, and execute death-defying leaps. With high stakes and higher drops, it's not for the faint-hearted! Are you daring enough to dominate the urban jungle?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.maze-theory.com/legal/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Maze Theory Limited", "support_website_url": null, "website_url": "https://www.maze-theory.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9932927900115661"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3530331940559072"}]}, "baseline_offer": null, "i
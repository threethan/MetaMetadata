ng", "id": "2827051337434670", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86621364_2827051340768003_4938074487533118892_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nU2DKwVs_MQ7kNvwG3HOFt&_nc_oc=AdpaTJynpxXDW5E_6Q5Gi3rOfBVwLVGi76yeep9KDs-5h9fh3JO99NHxnBHng1kWRNA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPcLSAet1dq1jgCxZvutvgnEKKmsrdJebp7GB2K6Dbkg&oe=6AA41139"}, {"file_name": "Freerunner screen3.png", "id": "284612300742451", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982464_284612304075784_7343166333936488767_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biFLiXzvswMQ7kNvwH23-r-&_nc_oc=AdpOYjfq-fODj90f-6NHnwLGtsfTzf-cbn1mN0wReHJqKfcx3y6Pa7Uo6UUklU5HXIE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUvXm_CqgqPcrNptgkHCALXuOdu3fxewtP0kbcCQTM4g&oe=6AA400BF"}, {"file_name": "Freerunner screen5.png", "id": "362116186314082", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75495672_362116189647415_1663910052892429381_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t_PeO2jFqwQ7kNvwH9hI1u&_nc_oc=AdpA3W8iHA_RUxEy6HWfkhoBuG_SXx9_xBpKkgll6IPa8JfPi7IXJuFW7pKvUJJle-k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVND3HwQfwXJgnE_kmCMPZBxtBLbUNdzZODwNAVwdQFQ&oe=6AA4176B"}, {"file_name": "Freerunner screen2.png", "id": "370675732302704", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003242_370675735636037_1128515494385851125_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaPzMxCgkXAQ7kNvwHdTidK&_nc_oc=AdpaGUbs7GuHBiciYdZLO7HQRqeKUaK5tK_l70zS5HsR47eBrtlimA8NQCmbgGRYjxs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXmo1DHhWY9lhzu-JVpIoWfh57nXONopxGsisCpQfUGA&oe=6AA416FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FreeRunner Landscape.png", "id": "1019442932609668", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982548_1019442935943001_5378732379731031128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fm74_2uVSoQ7kNvwGCpmAz&_nc_oc=AdpX6cepwW1oCZHfqw2zNY5wg_cHQg-TVeD4DRUlx5W4wpJqIbB00wIeHpaqO9oAFvM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoVurUkzwCxUEaDTABHYZ4eYeJTY9OY--1p_-r-eZLzw&oe=6AA40541"}, "display_name": "Freerunner Championship", "keywords": [], "long_description": "Update 0.16 Released - Enhanced Movement for Better Vaulting and Scrambling, Plus New Leaderboard & Challenge Features\n\nFreerunner Championship is a parkour-inspired racing game where strategy and precision collide in an exhilarating race through challenging urban landscapes to achieve the fastest time!\n\nEvery move matters, with speed and accuracy being rewarded. Your mission is to find the quickest route to victory!\n\nCompete against international opponents - only one can top the global leaderboard!\n\nFreerunner Championship is a Maze Theory i-labs prototype. This project is under continuous development, and we greatly appreciate your feedback.", "short_description": "In Freerunner Championship, every move you make is a step towards perfection or failure. This is where precision and strategy collide, with the ultimate goal of reigning supreme on the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.maze-theory.com/legal/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Maze Theory Limited", "support_website_url": null, "website_url": "https://www.maze-theory.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
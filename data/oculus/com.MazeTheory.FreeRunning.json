ng", "id": "2827051337434670", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/86621364_2827051340768003_4938074487533118892_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uiADCRMmCoQ7kNvwFjBSv7&_nc_oc=AdrZu2H--nuS-AWnyDNSGt6ZpgG5GAVbRhcFZk9qdo0Pi4Yi4iTON2BsdkDtWaq8L6o&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVQBBXBBvZF4qcSitfqsEyfLxOGO1WNGex9wp96gjW6g&oe=6A8D6F79"}, {"file_name": "Freerunner screen3.png", "id": "284612300742451", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982464_284612304075784_7343166333936488767_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=64vb9CoEr3wQ7kNvwF0pNiV&_nc_oc=AdrDD47QubZtK18SfaJj-YtDxvwe_uUcDawzmyHkcICd_pMIAgS0Oq2NmmBf2DCG4WY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-u6KNXIGJ_dsawXg0PKiXvJisV69PtVi6cA-uIvD0pQ&oe=6A8D973F"}, {"file_name": "Freerunner screen5.png", "id": "362116186314082", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75495672_362116189647415_1663910052892429381_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zkV9YmLQq2UQ7kNvwGiql-4&_nc_oc=Adp01ToB6M8_hNHB__IMryy6LXo1705qnJngLexQ0qpaWyjDI3eG5-lgooaDNJSORlg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkR62dq0s--v4P5EnKrDFgHsAEkPtwKx4tAQFTSaZlcA&oe=6A8D75AB"}, {"file_name": "Freerunner screen2.png", "id": "370675732302704", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39003242_370675735636037_1128515494385851125_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yZiRteQojcQ7kNvwEaU88L&_nc_oc=AdoVCEvaEdpIu61h02ztnmkWFyaCR73NXbsTg_FonlVapT617MJ5E087JeNOiE7xHKU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzVxhBQETJdJR-HG8HgeW9348vdFdOyAH7ffQLqjV1fg&oe=6A8D753B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FreeRunner Landscape.png", "id": "1019442932609668", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982548_1019442935943001_5378732379731031128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhaek_EbJZgQ7kNvwE5wrUi&_nc_oc=AdpeeFV6oDuuy1kn5NBSGtDH_jEbBBDaLfjXQ_3Y8g6zoeJ2xqTG3hZxOi_hWHxqXjY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4DHrCWxKUTQIVe_fImBBlJMsaFYgEses5iPPMsIMMTg&oe=6A8D9BC1"}, "display_name": "Freerunner Championship", "keywords": [], "long_description": "Update 0.16 Released - Enhanced Movement for Better Vaulting and Scrambling, Plus New Leaderboard & Challenge Features\n\nFreerunner Championship is a parkour-inspired racing game where strategy and precision collide in an exhilarating race through challenging urban landscapes to achieve the fastest time!\n\nEvery move matters, with speed and accuracy being rewarded. Your mission is to find the quickest route to victory!\n\nCompete against international opponents - only one can top the global leaderboard!\n\nFreerunner Championship is a Maze Theory i-labs prototype. This project is under continuous development, and we greatly appreciate your feedback.", "short_description": "In Freerunner Championship, every move you make is a step towards perfection or failure. This is where precision and strategy collide, with the ultimate goal of reigning supreme on the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.maze-theory.com/legal/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Maze Theory Limited", "support_website_url": null, "website_url": "https://www.maze-theory.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
ng", "id": "2827051337434670", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86621364_2827051340768003_4938074487533118892_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6_RCpG2lbEQ7kNvwGaYPfA&_nc_oc=AdpwB5Kyv2xmlvxuenRo7YeSi1A7Ufk-rQz51NIgUamuwITGdJF23-yAyygBoCJTylA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGU3ex-hhl5Kn9WzDExcIvtYwOn8R3Du480I2vCL7BwQ&oe=6AAE9D39"}, {"file_name": "Freerunner screen3.png", "id": "284612300742451", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982464_284612304075784_7343166333936488767_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8TZ2Jz23ds4Q7kNvwEnc9BG&_nc_oc=Adprxfn7fHWyYvBeSu_60-_LbmYBawyic7R5rf7kvkleXkpcU8IpKxWYXXf7KE3uTjw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJYxeOKQXUBDGiZ_seveecOvyZo6JUK5BoW2WQXT4wBQ&oe=6AAE8CBF"}, {"file_name": "Freerunner screen5.png", "id": "362116186314082", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75495672_362116189647415_1663910052892429381_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCIGTeLwAYwQ7kNvwELGG9j&_nc_oc=Adpna4xhFJJwYsUhAKx5SpgeZLlSDFXS_6NPdGpViXR7gGjtBeRmwmBhOI8InjvYn_I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ7N4WYl9xslw4WvcMPU9v7_TPh9-CZcsBBbNrTbT2ag&oe=6AAEA36B"}, {"file_name": "Freerunner screen2.png", "id": "370675732302704", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003242_370675735636037_1128515494385851125_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBENxxlzWoIQ7kNvwGGXqKJ&_nc_oc=Adoq5zoVthJqZuwGBivxVGZK_y9PLHzIIEfkm8lXL0Z_5tqFHMdCeuUa-X6H_FkXLCg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS-tGUVrYhqKLcyR7EgscrbA1qMOV4KPDayxJPN51fVA&oe=6AAEA2FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FreeRunner Landscape.png", "id": "1019442932609668", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982548_1019442935943001_5378732379731031128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n67JknAk7cEQ7kNvwEOuUKp&_nc_oc=AdpYv-txFjH4D1n3U3Y-2830kD7oQPESwwWodnEPOHUrMgbRz7B2O17jVnemnGUPAN4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIccbRG-ckJfnatYTtVYGymg3XvZLLoaZFJb-Ye4XwtJA&oe=6AAE9141"}, "display_name": "Freerunner Championship", "keywords": [], "long_description": "Update 0.16 Released - Enhanced Movement for Better Vaulting and Scrambling, Plus New Leaderboard & Challenge Features\n\nFreerunner Championship is a parkour-inspired racing game where strategy and precision collide in an exhilarating race through challenging urban landscapes to achieve the fastest time!\n\nEvery move matters, with speed and accuracy being rewarded. Your mission is to find the quickest route to victory!\n\nCompete against international opponents - only one can top the global leaderboard!\n\nFreerunner Championship is a Maze Theory i-labs prototype. This project is under continuous development, and we greatly appreciate your feedback.", "short_description": "In Freerunner Championship, every move you make is a step towards perfection or failure. This is where precision and strategy collide, with the ultimate goal of reigning supreme on the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.maze-theory.com/legal/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Maze Theory Limited", "support_website_url": null, "website_url": "https://www.maze-theory.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
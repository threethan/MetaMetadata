ng", "id": "2827051337434670", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/86621364_2827051340768003_4938074487533118892_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8fggQnu6R8Q7kNvwEI0axz&_nc_oc=AdrF19BnHG4kXY5m3FkbACCehBGoXia1TCcXyZHisaslpwFevF1uPOeF0AKURvp7Zs8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJd792uwD4K6g0SbIyBgoMtG2OscYYH86UpGopprS4rlQ&oe=6AA95739"}, {"file_name": "Freerunner screen3.png", "id": "284612300742451", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982464_284612304075784_7343166333936488767_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oJrGwIVzvPIQ7kNvwFb-0cH&_nc_oc=AdrbvCK_h69D_-YqDhcxEnzaAinA5Na8NxLzm128spM9tu2h3pPATz3zQr7vF5PoqXI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtuMyHLFc1Ja4CnN3Fv8awRfcn8F_eXnTG56okhPO86A&oe=6AA946BF"}, {"file_name": "Freerunner screen5.png", "id": "362116186314082", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75495672_362116189647415_1663910052892429381_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCCGjTrt_d0Q7kNvwE7R5D7&_nc_oc=Adq6R05fFVkQFisgoUh2t0HqQ6gpSuqybzQEc8PokpnwbTB0xyc7U39vjAhCcOviJTs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJI_o_bOQkRvws0H7Vk6VqYjJh5DSZzCtdLBW5MBOOO2Q&oe=6AA95D6B"}, {"file_name": "Freerunner screen2.png", "id": "370675732302704", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39003242_370675735636037_1128515494385851125_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUH71YEuFnwQ7kNvwGOW_II&_nc_oc=AdpSNTh3VyqJUOy6K4ZIUqaMTGm5AkkKhMD_xW2jELl3xO-c0Iu7mSyffgivBkPnSRE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU4wBTATSV6RB1x3XUyIk97EoGoGPf6YlOTvpzO8FduA&oe=6AA95CFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FreeRunner Landscape.png", "id": "1019442932609668", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982548_1019442935943001_5378732379731031128_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IU5NuSC5J8Q7kNvwGNDMml&_nc_oc=AdqV-SJb4dQaCcmvWkbipO5XAiK4xwCTSZiqkKXab7bOqfAXwrQlSCe6JvMP-s3zof8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9pQ5NprCY32RnViKteLsbrQKPYXbPyk6wRgcZLftSfA&oe=6AA94B41"}, "display_name": "Freerunner Championship", "keywords": [], "long_description": "Update 0.16 Released - Enhanced Movement for Better Vaulting and Scrambling, Plus New Leaderboard & Challenge Features\n\nFreerunner Championship is a parkour-inspired racing game where strategy and precision collide in an exhilarating race through challenging urban landscapes to achieve the fastest time!\n\nEvery move matters, with speed and accuracy being rewarded. Your mission is to find the quickest route to victory!\n\nCompete against international opponents - only one can top the global leaderboard!\n\nFreerunner Championship is a Maze Theory i-labs prototype. This project is under continuous development, and we greatly appreciate your feedback.", "short_description": "In Freerunner Championship, every move you make is a step towards perfection or failure. This is where precision and strategy collide, with the ultimate goal of reigning supreme on the global leaderboard."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.maze-theory.com/legal/#privacy", "developer_terms_of_service_url": null, "publisher_name": "Maze Theory Limited", "support_website_url": null, "website_url": "https://www.maze-theory.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_d
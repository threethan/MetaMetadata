109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r64__MHu0jsQ7kNvwEQClGv&_nc_oc=AdnqRouUk1_ks5LAuxufR9GsO2sSmUJDUaTv_aowGU1IiZr4bbJcAeBB1Jo-SjAfdyI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft7dVtzkd9PgdmpAQLRxIqx2a-_CRGcS-ANftDRxTCMbw&oe=69A2CE63"}, {"file_name": "Camera 1.png", "id": "1137095870473226", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75363512_1137095873806559_4463999008969636486_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n40w9auQVcUQ7kNvwH2uFdr&_nc_oc=Adnw_-qgS585kVJGy12y0TtyrstmNc14pzp6YJ3WoY-Z0vWQdtFwtx3_J57iVzoWYGc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuGNzZMcn0sMaGM0rMx4a5P42NXuc_Ryhk_k51uyexN0Q&oe=69A2FBED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover trailer.png", "id": "684505925965749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035392_684505932632415_1577412906328315051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHuAKCBVicIQ7kNvwGdApYM&_nc_oc=AdlggMjDkZrvm7HvSHdatsuSe_IJHcA_su64qGnrkcM_exjkIPMFX6YJlKUe0K59SMA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuoL09abaNeC3Fnly1Pi0dKjN47WV4JG-CJf2Erjg6B3A&oe=69A2FC80"}, "display_name": "Deceptive Reality", "keywords": [], "long_description": "In Deceptive Reality, you step into the shoes of Declan, a hardworking American. Coming from a modest background, life wasn't fair but you wanted to make a difference \u2014 to have an impact on inequality. Your career had finally started to pay off and suddenly you were in the position to make a difference  \u2014  \"Was the American Dream still alive after all\" you pondered. Little did you know everything was built on lies. \n\nThe question is are you ready to face the music in order to uncover the truth? FIGHT, HACK and EXPLORE your way to uncover the truth behind the facades of the city of North Haven.\n\nLIMITED EARLY ACCESS 0.5 - Summer 2022: Includes a very limited part of the final game: Part of Alleyway level & Arcade Mode. We want to welcome you aboard as early as possible so you already can get the immersive feel of the game and have the chance to shape the future of the game.\n\nFULL EARLY ACCESS 1.0 - Fall 2022: Full early access will be released by the end of the year.\n\nFULL EP. 1: 2023", "short_description": "Deceptive Reality is a story-driven action-adventure game set in the Dystopian City of North Haven. \n\nThe question is are you ready to face the music in order to uncover the truth? FIGHT, HACK and EXPLORE your way to uncover the truth behind the facades of the city of North Haven.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deceptive-reality.com/privacy-policy-deceptive-reality", "developer_terms_of_service_url": null, "publisher_name": "Quarantine Studios VR", "support_website_url": null, "website_url": "https://deceptive-reality.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "457653445836593"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1169301754933580"}, {"status": "PUBLISHED", "id": "1314908236675130"}, {"status": "PUBLISHED", "id": "3739038899722819"}, {"status": "PUBLISHED", "id": "983449860526198"}, {"status": "PUBLISHED", "id": "709153788289815"}, {"status": "PUBLISHED", "id": "1827822914639558"}, {"status": "PUBLISHED", "id": "1519938122054647"}, {"
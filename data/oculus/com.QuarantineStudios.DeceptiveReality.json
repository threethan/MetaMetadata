109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccw4H-MJeJoQ7kNvwFyxK6V&_nc_oc=AdmPU_JgU5BC-fjtoqf5k_m06_0kROu7tkYUAr1g2B8ahMQsa9SWN8hYg0ZjsoNrly8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft5K3bo6T_nX3RYf1IaFeVfvylXdCLC7IKSgCdzOkbZLg&oe=69984263"}, {"file_name": "Camera 1.png", "id": "1137095870473226", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75363512_1137095873806559_4463999008969636486_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8X2VW26HR0kQ7kNvwG_Obf7&_nc_oc=AdlNFSg57DDSGerNjHvW3l6skTggWp24Kr4KLtIeQcpDkj_FrE6Q8Q3ACEMw-t4JA_M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs9_PXtHYB1O8aPQmWN-TVKXUrtziuySGCjSGfbL-AnGQ&oe=69986FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover trailer.png", "id": "684505925965749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035392_684505932632415_1577412906328315051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PCsLeVO3M2cQ7kNvwH8NFhL&_nc_oc=Adn0EzTT0HVRkSa9W9pLKOjT88tmYgvpi02ICth7Ncs3aTYpNwvvxZ2dMqdE5kdn2d0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsxZ-zwFR4z2GUHrR7rSbWDB1fLjsMym959vSuVyH09iw&oe=69987080"}, "display_name": "Deceptive Reality", "keywords": [], "long_description": "In Deceptive Reality, you step into the shoes of Declan, a hardworking American. Coming from a modest background, life wasn't fair but you wanted to make a difference \u2014 to have an impact on inequality. Your career had finally started to pay off and suddenly you were in the position to make a difference  \u2014  \"Was the American Dream still alive after all\" you pondered. Little did you know everything was built on lies. \n\nThe question is are you ready to face the music in order to uncover the truth? FIGHT, HACK and EXPLORE your way to uncover the truth behind the facades of the city of North Haven.\n\nLIMITED EARLY ACCESS 0.5 - Summer 2022: Includes a very limited part of the final game: Part of Alleyway level & Arcade Mode. We want to welcome you aboard as early as possible so you already can get the immersive feel of the game and have the chance to shape the future of the game.\n\nFULL EARLY ACCESS 1.0 - Fall 2022: Full early access will be released by the end of the year.\n\nFULL EP. 1: 2023", "short_description": "Deceptive Reality is a story-driven action-adventure game set in the Dystopian City of North Haven. \n\nThe question is are you ready to face the music in order to uncover the truth? FIGHT, HACK and EXPLORE your way to uncover the truth behind the facades of the city of North Haven.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deceptive-reality.com/privacy-policy-deceptive-reality", "developer_terms_of_service_url": null, "publisher_name": "Quarantine Studios VR", "support_website_url": null, "website_url": "https://deceptive-reality.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "457653445836593"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1169301754933580"}, {"status": "PUBLISHED", "id": "1314908236675130"}, {"status": "PUBLISHED", "id": "3739038899722819"}, {"status": "PUBLISHED", "id": "983449860526198"}, {"status": "PUBLISHED", "id": "709153788289815"}, {"status": "PUBLISHED", "id": "1827822914639558"}, {"status": "PUBLISHED", "id": "1519938122054647"}, {"
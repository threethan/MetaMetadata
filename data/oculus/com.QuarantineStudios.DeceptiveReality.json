109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r64__MHu0jsQ7kNvwFjOsHh&_nc_oc=AdnqkEjHEgenJ4Krp3UlwZRJZjI0nCkbL8q1Z8cC1FJOvrhlw-23S_sQYx-tvpsdNUY&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsnLnERsYpjOEXjvImUQyXZVjTwmPPQmYXSnjHrHIzZdQ&oe=69A17CE3"}, {"file_name": "Camera 1.png", "id": "1137095870473226", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75363512_1137095873806559_4463999008969636486_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n40w9auQVcUQ7kNvwFVNfpW&_nc_oc=AdmDjzZ5e-pa7JxatUC5ilaTeyxXjiyE-s_BtkXDPsJ3Bl4TZjBHn27u088RWXAC_4M&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuDSmN3qUflf7JhVLa7Ohs2lm-qDgTz6Mtq_ESKhbRi9A&oe=69A1AA6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover trailer.png", "id": "684505925965749", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39035392_684505932632415_1577412906328315051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdZm1DcvlvcQ7kNvwEeOKxB&_nc_oc=AdnOCVUOn35WMjRBsFFc0CWwoKK59PbAkoMkJyFFxLY6Qx3NwEdxAtOiPJrgzTy81Wg&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afv4u9sjYli17h7_g6N5pckWDg_3sDMCGGqPGyjNbv2H9A&oe=69A1AB00"}, "display_name": "Deceptive Reality", "keywords": [], "long_description": "In Deceptive Reality, you step into the shoes of Declan, a hardworking American. Coming from a modest background, life wasn't fair but you wanted to make a difference \u2014 to have an impact on inequality. Your career had finally started to pay off and suddenly you were in the position to make a difference  \u2014  \"Was the American Dream still alive after all\" you pondered. Little did you know everything was built on lies. \n\nThe question is are you ready to face the music in order to uncover the truth? FIGHT, HACK and EXPLORE your way to uncover the truth behind the facades of the city of North Haven.\n\nLIMITED EARLY ACCESS 0.5 - Summer 2022: Includes a very limited part of the final game: Part of Alleyway level & Arcade Mode. We want to welcome you aboard as early as possible so you already can get the immersive feel of the game and have the chance to shape the future of the game.\n\nFULL EARLY ACCESS 1.0 - Fall 2022: Full early access will be released by the end of the year.\n\nFULL EP. 1: 2023", "short_description": "Deceptive Reality is a story-driven action-adventure game set in the Dystopian City of North Haven. \n\nThe question is are you ready to face the music in order to uncover the truth? FIGHT, HACK and EXPLORE your way to uncover the truth behind the facades of the city of North Haven.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deceptive-reality.com/privacy-policy-deceptive-reality", "developer_terms_of_service_url": null, "publisher_name": "Quarantine Studios VR", "support_website_url": null, "website_url": "https://deceptive-reality.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "457653445836593"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "1169301754933580"}, {"status": "PUBLISHED", "id": "1314908236675130"}, {"status": "PUBLISHED", "id": "3739038899722819"}, {"status": "PUBLISHED", "id": "983449860526198"}, {"status": "PUBLISHED", "id": "709153788289815"}, {"status": "PUBLISHED", "id": "1827822914639558"}, {"status": "PUBLISHED", "id": "1519938122054647"}, {"
Q_EHEtQ2cFtYQBaDm1xrKTCotPlBuZdakKmt1wUt7PMlfV3xqMU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87aSFj7B0OssXDQIqUg94jtrE-9oE3SEwdQVnlCFjWzg&oe=6A355DE7"}, {"file_name": "Hack.png", "id": "1075000249894735", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75278190_1075000253228068_4210101614278258057_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RsYhmwwDdcQ7kNvwFnFPr5&_nc_oc=AdrAgL8Lx2WdgSxsipbBUoPyp456W4mwOHanKGE36aVshHWUwWV9gW1QvRHgP5zjRxA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7rlNJHILSRCtecbv_-jHWKU-9LR-a8un8aXnrYZsYKA&oe=6A355D23"}, {"file_name": "Camera 1.png", "id": "1137095870473226", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75363512_1137095873806559_4463999008969636486_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZzdspabIzcQ7kNvwEm5UwB&_nc_oc=Adp5ZHhrOVhoDdcEt6UbpAOHm60pBDnvqAXMjgcetXsoR5QBVL1F7XFrd2mdTLVfrC8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xiyAK6p-CEFPFHq9Sn3BwPt1IxUrH-gFymrUh4HtVFA&oe=6A35526D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover trailer.png", "id": "684505925965749", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035392_684505932632415_1577412906328315051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-Tm4jNKnRAQ7kNvwGcrglE&_nc_oc=AdqKdXbmE6N9KoXleiW2P1sz_1sSw6xyHqLx4o-W-8dCOC5DfsWmrM1s4rIjnD2sJZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-XOXJiV93YZNS9_udURRUj2gzILjrVYD3tId6SgOUtw&oe=6A355300"}, "display_name": "Deceptive Reality", "keywords": [], "long_description": "In Deceptive Reality, you step into the shoes of Declan, a hardworking American. Coming from a modest background, life wasn't fair but you wanted to make a difference \u2014 to have an impact on inequality. Your career had finally started to pay off and suddenly you were in the position to make a difference  \u2014  \"Was the American Dream still alive after all\" you pondered. Little did you know everything was built on lies. \n\nThe question is are you ready to face the music in order to uncover the truth? FIGHT, HACK and EXPLORE your way to uncover the truth behind the facades of the city of North Haven.\n\nLIMITED EARLY ACCESS 0.5 - Summer 2022: Includes a very limited part of the final game: Part of Alleyway level & Arcade Mode. We want to welcome you aboard as early as possible so you already can get the immersive feel of the game and have the chance to shape the future of the game.\n\nFULL EARLY ACCESS 1.0 - Fall 2022: Full early access will be released by the end of the year.\n\nFULL EP. 1: 2023", "short_description": "Deceptive Reality is a story-driven action-adventure game set in the Dystopian City of North Haven. \n\nThe question is are you ready to face the music in order to uncover the truth? FIGHT, HACK and EXPLORE your way to uncover the truth behind the facades of the city of North Haven.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deceptive-reality.com/privacy-policy-deceptive-reality", "developer_terms_of_service_url": null, "publisher_name": "Quarantine Studios VR", "support_website_url": null, "website_url": "https://deceptive-reality.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "457653445836593"}}]}, "scheduled_
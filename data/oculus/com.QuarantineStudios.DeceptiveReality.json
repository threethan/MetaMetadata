cdn.com/v/t64.5771-25/75363512_1137095873806559_4463999008969636486_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ci3eHDqMRXsQ7kNvwG-iFY7&_nc_oc=AdrdN8KcVIcBit-XGHrVIsiIBlmAfLv8_oyqNDf4jgcgr5lr92iCWKNbcLV5j8aTRD8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw9AhoGH08RzXknrJgJCdYoA5t6iBpoI40xNHvNqFJoA&oe=6AEF35ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover trailer.png", "id": "684505925965749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035392_684505932632415_1577412906328315051_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKC21UNDVyYQ7kNvwEepiZv&_nc_oc=Adq_0JPjw4zcAU8AF8HrzE-R0GIFVfP226QIFhDS4XQLpNN_Z9XIg_oR0IGFyIcV-kE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScfnBHjmPacHMg6uS7jAt2MNTtKyrZ8qChkAJMmcLqDQ&oe=6AEF3680"}, "display_name": "Deceptive Reality", "keywords": [], "long_description": "In Deceptive Reality, you step into the shoes of Declan, a hardworking American. Coming from a modest background, life wasn't fair but you wanted to make a difference \u2014 to have an impact on inequality. Your career had finally started to pay off and suddenly you were in the position to make a difference  \u2014  \"Was the American Dream still alive after all\" you pondered. Little did you know everything was built on lies. \n\nThe question is are you ready to face the music in order to uncover the truth? FIGHT, HACK and EXPLORE your way to uncover the truth behind the facades of the city of North Haven.\n\nLIMITED EARLY ACCESS 0.5 - Summer 2022: Includes a very limited part of the final game: Part of Alleyway level & Arcade Mode. We want to welcome you aboard as early as possible so you already can get the immersive feel of the game and have the chance to shape the future of the game.\n\nFULL EARLY ACCESS 1.0 - Fall 2022: Full early access will be released by the end of the year.\n\nFULL EP. 1: 2023", "short_description": "Deceptive Reality is a story-driven action-adventure game set in the Dystopian City of North Haven. \n\nThe question is are you ready to face the music in order to uncover the truth? FIGHT, HACK and EXPLORE your way to uncover the truth behind the facades of the city of North Haven.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.deceptive-reality.com/privacy-policy-deceptive-reality", "developer_terms_of_service_url": null, "publisher_name": "Quarantine Studios VR", "support_website_url": null, "website_url": "https://deceptive-reality.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "457653445836593"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33098277243151448", "version": "0.3.1.4"}, "id": "428123131776224", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4988840444521838", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "33098277243151448"}, "release_status": "RELEASED"}, "binary_release_channel
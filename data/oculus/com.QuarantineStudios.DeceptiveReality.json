scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974502_1225351028486321_6170554859770719299_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8UUX2RN7oEQ7kNvwGmA16u&_nc_oc=Adr7LbZ5zOW-WkqmQfFq8N6SLq29_rSn_Rh-XG_EpaaLCL8LcOZ-fqzinqKjSlTpeSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af25ZAEce-s3S2uXfNxfzxt3HlBH87DWC1xL4CpozOWzoQ&oe=69DF8893"}, {"file_name": "3.png", "id": "405242825910836", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003262_405242829244169_478413980981689238_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lmSbN3hbokoQ7kNvwHzld_W&_nc_oc=AdrEAYPYhH0-0G7uGVCSOhageH5fqTOmhfggD3smGaXvgUo91QH_AbQeXK0Y3Pi85lk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eKgbOBQhT8KK6jS9OKVzooO9Tqa8rwc78FnHprvgvAQ&oe=69DF78ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Cover-Landscape.png", "id": "544519058320509", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974688_544519061653842_1195430205029445690_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teRRxJw6g3UQ7kNvwEKecBE&_nc_oc=AdqG18e1P3o9Vs88EYDKc98T9HSpxaBm22ruNZLYc6Z1eol-Q-Ku2wMDPKz6Kloc_5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-ALyTq_ddPmYwk6z8XYaw9fI2cq-mY1KHA2l_ZrNALA&oe=69DF90E6"}, "display_name": "Deceptive Reality", "keywords": ["combat", "cyberpunk", "story", "openworld", "sandbox"], "long_description": "They erased her. Now you erase them.\n\n**\u201cAn instant cult classic.\u201d \u2013 XRGamer (9.5/10)**\n**\u201cRelentless gun-fu. Immersive hacking.\u201d \u2013 WickedVRGamer (9/10)**\n**\u201cA must-play in Cyberpunk VR.\u201d \u2013 BMFVR**\n\nCortex created the brain chip that makes superhumans.\nYour girlfriend exposed the truth. They erased her.\nYou were next \u2014 until a rogue hacker pulled you from the edge.\n\nNow you're trained. You're pissed.\nYou're heading back into the city to shut it all down.\n\nUPDATED SUMMER 2025 \u2013 Key Features\n\nA CYBERPUNK NOIR STORY\n\nA VR revenge thriller soaked in neon, betrayal, and bullets.\n{1034983661608790}\n\nCORTEX COMBAT ENGINE\u2122 2.0\n\nBullet-time melee. Tactical shootouts. Kill Rooms, Sandbox & Story modes.\n{1218529609186961}\n\nFREE ROAM OR FULL STORY\n\nFight bosses. Breach Cortex facilities. Discover hidden zones.\n\nYour path. Your war.\n\n{1185801476041957}\n\nPlay now. It\u2019s time for vengeance.", "short_description": "Deceptive Reality: Become The Cyberpunk Agent on Vengeance\n\nYou've been living the corporate dream, working for Cortex, the company behind the brain chips that control the masses. But when Cortex betrays you and kills your girlfriend, everything changes. Saved by a mysterious hacker, you become a cyberpunk agent on it for revenge. Navigate the neon-lit streets, uncover Cortex's dark secrets, and engage in intense, slow-motion bullet-time combat. The city is on the edge\u2014will you fight back?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://deceptivereality.wixsite.com/deceptivereality/privacy-policy-deceptive-reality", "developer_terms_of_service_url": null, "publisher_name": "Quarantine Studios VR", "support_website_url": null, "website_url": "https://deceptivereality.wixsite.com/deceptivereality/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tr
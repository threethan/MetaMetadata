video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design(5).png", "id": "3425025080964285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75207243_3425025084297618_3673281364146163332_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O_9i7eJfgLUQ7kNvwG2De4q&_nc_oc=AdqqZHHpy_8Ttx1317JJoLU5zkPKNul0kYiiIrAcvNev1JJsiui65bUWmAWLbJCyCZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRguhvimvhUJwWD3CIr9BXPQAmF77tZ9ohbrL2o1gj8Eg&oe=6AFDD8CE"}, "display_name": "Augmented Reality Basketball", "keywords": ["basketball"], "long_description": "A personalized augmented reality basketball coach tailored specifically for your needs.\n\nBall Handling \ud83c\udfc0\ud83c\udfc0\n\nLearn:\n\nThe Augmented Reality Basketball app is your gateway to mastering the essential skills of basketball. If you're unfamiliar with the fundamentals of dribbling, we're here to guide you every step of the way. This app is ideal for individuals who may not yet feel at ease training alongside other players or with a human coach.\n\nEnvironment Instructions For Augmented Reality Basketball Coach:\n\nEnsure that your Quest headset is not pointed directly at the sun. Ideal locations for your virtual coach include your garage, an indoor basketball gym, or your backyard, provided there are ample shaded areas.\n\n{618633160823588}", "short_description": "A personalized augmented reality basketball coach tailored specifically for your needs.\n\nBall Handling \ud83c\udfc0\ud83c\udfc0\n\nLearn:\n\nThe Augmented Reality Basketball app is your gateway to mastering the essential skills of basketball. If you're unfamiliar with the fundamentals of dribbling, we're here to guide you every step of the way. This app is ideal for individuals who may not yet feel at ease training alongside other players or with a human coach."}]}, "developer_name": null, "developer_privacy_policy_url": "https://drive.google.com/file/d/1UhWN7gUb18HYdQa2wLWWnQx4
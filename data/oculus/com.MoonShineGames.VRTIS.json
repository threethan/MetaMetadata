ntent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822668_1240557850951145_328997304520423180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KytF4UFCMt0Q7kNvwFJ_jvb&_nc_oc=Adp2aaokcSU8VFOUo0ph1_oIJ9zW2jigN581vQ1xXJxfYs2lEsLGn5AVkbjKl7QX_sM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Biu4Xz01m5EKRBihNOmGhyOy4LNjZ9P6upP4iNTcdEw&oe=69F3680B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover.png", "id": "726992409792732", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491819336_726992413126065_4443100019502810519_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ndaieTrNqcQ7kNvwFuM4Dr&_nc_oc=AdpEUO5DCkQnniPBIf01m6dUamKX8zpL5xnhD6qdq99boYkfNHDnPVCAELSrpUuv37M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0npO6y5lCYw0Z-OIGq5ujq2mJBMAhj9j4pc73r8u-cAA&oe=69F34DB3"}, "display_name": "VRTIS", "keywords": ["puzzle", "VRTIS", "blocks", "moonshine", "free"], "long_description": "Step into the immersive world of VRTIS, a fresh take on the beloved block-dropping genre designed exclusively for Meta Quest. Manipulate colorful blocks in 3D space using intuitive hand-tracking and controllers, Whether you're a puzzle enthusiast or a VR newbie, the game offers a relaxing yet engaging experience with beautiful visuals and smooth gameplay.  Perfect for solo play or short sessions, VRTIS combines classic mechanics with innovative VR twists. Download now and start building in your Virtual Room or in your own, with Mixed Reality. ", "short_description": "Immerse yourself in VRTIS, a captivating twist on classic block-dropping fun! Master the challenge in a Virtual Room or in your own, with Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShineGames", "support_website_url": null, "website_url": "https://markledson28.wixsite.com/moonshinegames", "ca
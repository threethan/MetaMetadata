792732", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819336_726992413126065_4443100019502810519_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O5xlZvgIPSwQ7kNvwEfR12f&_nc_oc=AdldBRB6P6Q9WMSKU342h1IwvgphRXM1AUdVoqoqn6qSqJZVNQiAouNXerWRZeJjplE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuQIvbgl-NtP659zL7B6O8_0zAbAWoxdpc2GtPT96Ek8w&oe=699EEDB3"}, "display_name": "VRTIS", "keywords": ["puzzle", "VRTIS", "blocks", "moonshine", "free"], "long_description": "Step into the immersive world of VRTIS, a fresh take on the beloved block-dropping genre designed exclusively for Meta Quest. Manipulate colorful blocks in 3D space using intuitive hand-tracking and controllers, Whether you're a puzzle enthusiast or a VR newbie, the game offers a relaxing yet engaging experience with beautiful visuals and smooth gameplay.  Perfect for solo play or short sessions, VRTIS combines classic mechanics with innovative VR twists. Download now and start building in your Virtual Room or in your own, with Mixed Reality. ", "short_description": "Immerse yourself in VRTIS, a captivating twist on classic block-dropping fun! Master the challenge in a Virtual Room or in your own, with Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShineGames", "support_website_url": null, "website_url": "https://markledson28.wixsite.com/moonshinegames", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null
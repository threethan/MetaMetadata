ntent-iad6-1.oculuscdn.com/v/t64.5771-25/491822668_1240557850951145_328997304520423180_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OqX5j4Uo_k8Q7kNvwG2l6vs&_nc_oc=Adrjb5K5MaUHm-GWOuJD-koGkQ7Ps4b4XzKcaXyvvj0yLChJ6PzekTcYIW5DmPOx8eY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ugeHEAEjILl0UgXw4WljejC1qky7ts8v3U5VZ_PqmMg&oe=69FCA28B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailercover.png", "id": "726992409792732", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819336_726992413126065_4443100019502810519_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1rBrmWsT1EQ7kNvwG03MUi&_nc_oc=AdrFvDveAFljPdbcYAkn-PKZ-9vpb2KFIAUa3lJEl5WCElQmf9KfLmytwl7TZCugYPE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J5o3ZZUqGEn9gZ3K-MAGrJ6I6wpvCkK57doAbT2g-sw&oe=69FC8833"}, "display_name": "VRTIS", "keywords": ["puzzle", "VRTIS", "blocks", "moonshine", "free"], "long_description": "Step into the immersive world of VRTIS, a fresh take on the beloved block-dropping genre designed exclusively for Meta Quest. Manipulate colorful blocks in 3D space using intuitive hand-tracking and controllers, Whether you're a puzzle enthusiast or a VR newbie, the game offers a relaxing yet engaging experience with beautiful visuals and smooth gameplay.  Perfect for solo play or short sessions, VRTIS combines classic mechanics with innovative VR twists. Download now and start building in your Virtual Room or in your own, with Mixed Reality. ", "short_description": "Immerse yourself in VRTIS, a captivating twist on classic block-dropping fun! Master the challenge in a Virtual Room or in your own, with Mixed Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://markledson28.wixsite.com/moonshinegames/copy-of-contact-details", "developer_terms_of_service_url": null, "publisher_name": "MoonShineGames", "support_website_url": null, "website_url": "https://markledson28.wixsite.com/moonshinegames", "ca
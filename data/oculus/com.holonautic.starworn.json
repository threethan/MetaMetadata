ttps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1580499796619771_6102578378280988186_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gq-IAsio4GYQ7kNvwHeZ47A&_nc_oc=Adpdnksv-f4thGFXuH8uFe3aykRBJOZCuOL3_89I695dN-zxn-Yg2K7XAGdo06NmGvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT69PI13PW1fO1F8SFkg7CHYmOypbaaGwL8ISuLDozp6w&oe=6B01CD57"}, {"file_name": "22-57-spider-boss.png", "id": "3645795802240077", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_3645795805573410_6622082375602625910_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFLPwB-NBEcQ7kNvwEQUQd9&_nc_oc=AdqIT-TAp40UwHPD99AUtMbr_PjRnZbm5CQAE7MfNCsc5OFmzRKESfmKAjUaVU-wjVw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCiphjT0hJOCrj1z3po9W_SHmreguJfcqUMs44p6oAZw&oe=6B01EC83"}, {"file_name": "26-trailer-bee-fight.png", "id": "2619500055141221", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_2619500061807887_7329612513965974128_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swQRdQPswXgQ7kNvwHfb67h&_nc_oc=Adpg2Ks8Bj_rEPHEVJ03HglqL2Ye2CPbvd7EQBDy95r1LqfD8LTgfULz4vAlW-r8jS8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQm91_YE61aS1AyRegE66PgzzIocLijB3d6bunLoomogQ&oe=6B01C05D"}, {"file_name": "25-trailer-blue-tunnel.png", "id": "2536225146855845", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823930_2536225150189178_2817632642999650210_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AooshlNFs-UQ7kNvwE8wcUH&_nc_oc=AdrlrwQGAgYD9cCIqtJzApuTLImKpyXW26baWqrnLFC2O1BXntWnaFjyqLo07SIW_iU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1wvEPEGGx4Jc3cmj-B2yWF-9pJkFqPu8N_ShC2faiEw&oe=6B01DC2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "starworn-release-trailer-cover-2560x1440.png", "id": "1087795250698932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1087795260698931_5252021567889472771_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rzalw8wkoRIQ7kNvwHzC5FE&_nc_oc=Adq9xDxFb3Ti5MURMqolMbRUGrdk_GBb7-W5riS6-TxIw5IuNtmYBmevfQsBC09C7oU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz5qQLIXuFvYICxM5hUKkAqWGn4FTE2_eiehsk_80o6g&oe=6B01DFEB"}, "display_name": "Starworn", "keywords": ["multiplayer", "crafting", "building", "voxel", "coop"], "long_description": "**Your planet is gone.**\n\nYour replicator regenerated you on an alien world. You\u2019re stranded.\n\nStarworn is a voxel survival adventure built for VR. Start with what you can find and build a base to call home. The wilderness won\u2019t make it easy.\n\n{2834768043546491}\n\n**Made by hand.**\n\nFell trees and mine the terrain. Saw logs into planks, smelt ore and forge your own blades. Each bench is worked by hand.\n\n{2403177630217480}\n\n{1398518511857019}\n\n{1375776144356240}\n\n**Around the campfire.**\n\nCook what you find and keep yourself fed.\n\n{1058073027057615}\n\n**Stand your ground.**\n\nSkeletons come in packs. Black knights hit back. Craft swords, bows, bombs, a blade that flies back to your hand and plasma weapons.\n\n{1639793914507855}\n\n{1976031123062268}\n\n**Beyond the surface.**\n\nOld ruins are guarded by skeletons, caves hide giant spiders, and a robot keep guards its vault. Invite friends and head underground together.\n\n{1773014517088275}\n\n{28064931916523023}\n\n**The world changes.**\n\nForests turn to autumn colours and snow. When night falls, bring a torch.\n\n{1416491647119063}\n\n**Early Access**\n\nThe first world is playable now, and we keep updating it. Future updates will expand the journey: your own spaceship, other worlds and the search for survivors, and whoever destroyed your planet.\n\nTell us what you want next. Your feedback helps decide what we build.\n\nJoin at a lower launch price. We plan to raise it after the first round of feedback and improvements, and again as the game grows. Early buyers receive all future base-game updates, including the full release, at no extra cost.\n\nExpect bugs and unfinished features. Some updates may require a new world. Buy for what\u2019s playable today.", "short_description": "Your planet is gone. Your replicator regenerated you on an alien world. You\u2019re stranded. Build a base by hand, fight off skeleton armies and black knights, and invite friends into your world. A voxel survival adventure for VR, out now in Early Access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starworn.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": "https://www.holonautic.com/", "website_url": "https://starworn.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "2071421323577963"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824328_1645465263743433_5873115195616395048_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XY6S52mJKI8Q7kNvwFfrtKq&_nc_oc=AdqLls6K-Cr-Y2dODsCuNZD1pov8wXQc3cEBb0BzJBoJiMczXxe2rHUadVSc3R09CjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjiM
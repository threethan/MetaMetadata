kNvwGtJCxT&_nc_oc=Adr18kEK6BUUvPkDnaqlo_mcBNOdk9EJ0kEaANdeaYYKDYVSHJP4ju9JNPqF-Yuh4fw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKwSsu_zXtkleRVe0yVnWdZsNqAKfOD7I37PRWpi6wsA&oe=6ADCCDEB"}, {"file_name": "03-anvil.png", "id": "1743751803347179", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825575_1743751806680512_7086347920327905545_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRyKKdCOMEAQ7kNvwEU-RN6&_nc_oc=AdrnRj8teWJeFRZaEyc4Qi-uBkUYawZzK1mr74SZI0fDS3oyj2-fflNh4XPsGk6DxYo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4Nw6jhQdaCo0W7SGIfy9vSYTaEfCyxAKEY71tuBKwBQ&oe=6ADCC3F6"}, {"file_name": "02-skewers-friends.png", "id": "1450016947006201", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828008_1450016957006200_6089253454472159458_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xs2Zv__yT9wQ7kNvwFFnY3X&_nc_oc=Adrq0_uYevOMNuObofXx0azY2E8EGyldivDe4IH6wlJELoxfdTBpKGkGqMF9wYLgaYo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFJviwcpO7Pn5PcTvsEEnmhRU_y8U6rZ_JcKxoCw9qig&oe=6ADCB0E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "starworn-cover-2560x1440.png", "id": "1025693103822343", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821704_1025693110489009_3995927389777223547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ayBB_7hqKdgQ7kNvwGBDXvj&_nc_oc=Adr8SyLZmi0wUkZpIBCKLwuB1v9tHmUQgjG7dEQojQOmSGzqu-z5I0cBbYjfUyrADYc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOV5yBne1a6VX0btUu4JhQrXoAKdnL_2zFLvnkJersmzQ&oe=6ADCC56B"}, "display_name": "Starworn", "keywords": [], "long_description": "**Your planet is gone.**\n\nYour replicator regenerated you on an alien world. You\u2019re stranded.\n\nStarworn is a voxel survival adventure built for VR. Start with what you can find and build a base to call home. The wilderness won\u2019t make it easy.\n\n{2834768043546491}\n\n**Made by hand.**\n\nFell trees and mine the terrain. Craft your tools at the workbench, then build your shelter piece by piece.\n\n{2403177630217480}\n\n{1398518511857019}\n\n**Around the campfire.**\n\nCook what you find and keep yourself fed.\n\n{1058073027057615}\n\n**Beyond the surface.**\n\nCaves hide strange creatures and new dangers. Invite friends into your world and head underground together.\n\n{28064931916523023}\n\n**The world changes.**\n\nForests turn to autumn colours and snow. When night falls, bring a torch.\n\n{1416491647119063}\n\n**Early Access**\n\nThe first world is playable now. Future updates will expand the journey: your own spaceship, other worlds and the search for survivors\u2014and whoever destroyed your planet.\n\nTell us what you want next. Your feedback helps decide what we build.\n\nJoin at a lower launch price. We plan to raise it after the first round of feedback and improvements, and again as the game grows. Early buyers receive all future base-game updates, including the full release, at no extra cost.\n\nExpect bugs and unfinished features. Some updates may require a new world. Buy for what\u2019s playable today.", "short_description": "Your planet is gone. Your replicator regenerated you on an alien world. You\u2019re stranded. Build a base by hand in a voxel survival adventure for VR. Invite friends into your world. Early Access begins with the first world, with more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starworn.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2028125241240905"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4550109638591045"}]}, "baseline_offer": {"id": "4550109638591045"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792080000, "status": "PUBLISHED", "id": "4550109638591045"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2044544649598964", "version": "0.3.15"}, "id": "1075480941908333", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2044544649598964"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "STARWORN 0.3.15\n\nNew since 0.3.14.\n\n- Joining a host whose world has grown large no longer drops the connection.\n- Other players see your plasma and venom hits in their colours.\n- Other players see a thrown plasma blade fly out and spin home, instead of lying on the ground and then jumping into your hand.\n- Walk over any tool lying on the ground to pick it up, whoever dropped it; a plasma blade flying home to its thrower stays theirs.\n- A painted dent shows its new coat.\n- A hut lit inside no longer lights up its outside walls at night.\n- Big hunters no longer stall behind a gap beside you.\n- Hollows climb back out of iron craters instead of getting stuck against the wall.\n- Cave creatures no longer sense you through solid rock, and none charges at what it can't see or feel.\n- Walls you could walk through after joining a host are solid again.\n- Bombs no longer freeze the game when they blow a crater.\n- A guest can no longer build a wall piece or block into a machine.\n- A crash from a bad mesh key received over the network is fixed.\n- Hollows no longer get stuck on the end of a wall when walking through a narrow gap.\n- Leaving a world no longer drops you through the ground at home.\n- Removed a small hitch at every autosave.\n- Doors and chest lids far from the world's start now open where they stand.\n- As a guest, a craft the host refuses flies back to the bench instead of into your pack.\n- Fixed rare crashes when carving and when loading bad mesh data.\n- Smoother night fights: Cinderfangs no longer stall the game searching for a roost.\n- Items picked up just before a guest leaves are no longer lost.\n- Smoother multiplayer: regrowing grass no longer makes guests' terrain rebuild.\n- Far from your landing site, aiming, digging and building now hit the block you point at.\n- The first look at a smelter and the first craft no longer freeze the game for seconds.\n- Walking out of a big base no longer stutters as the ground ahead loads.\n- Snowballs and other small round things no longer fall through the ground where blocks meet.\n- Fights draw lighter: loose cubes are no longer redrawn every frame.\n- Slightly smoother frames everywhere.\n- Bases with many machines run smoother.\n- Hive bees wake and fly again.\n- Kits can stand on a bench's flat top.\n- Lose a pack of hunters and one may be lying in wait by the nearest cave mouth or door.\n- Doors close without a gap and no longer show a dark band.\n- Swords pass through meadow flowers instead of catching on them.\n- Seasons: winter nights are longer and summer nights shorter, and the sun climbs low in winter and high in summer.\n- No more hitch when the first armed creature shows up.\n- Recycled and ground goods no longer come out smoking hot.\n- Black powder on the powder bench no longer flickers.\n- Walking out into new land runs smoother.\n- Loading into a world no longer pauses at its sound step.\n- After a world update, wild hives and nests are hung afresh instead of floating where the old land put them.\n- Your pack's lamps light up again inside dark huts.\n- Honing a sword glides smoothly along the hone and grindstone, without chipping them.\n- The recycler takes kits fed one after another, and its tray lays out what comes out neatly, every piece visible.\n- Birds no longer see you through a tree's crown.\n- When you're reprinted after death, you come back fresh: full health and fed.\n- In older worlds, dug tunnels are no longer lit up like daylight.\n- You can step right up to benches and machines now.\n- The Castellan holds its shield and glaive properly and fights you anywhere in its vault.\n- The Vaultmaw's front feet point the right way and reach the ground.\n- The 'has arrived' notice stays on your watch.\n- 0.3.15 starts you in a fresh world; your earlier worlds are still in the Worlds list.\n- Guests can move the respawn pod again; it no longer sticks to their hand.\n- The bow's arrow count includes venom arrows, wherever you carry them.\n- Signal soldiers and sentries aim at your body, so kneeling no longer ducks their fire.\n- The Vaultmaw and Riftstalker are far harder to bring down.\n- Laser fire now lights up the night around its beam.\n- A lit plasma blade now lights up everything around it, in your hand, in flight or lying where it fell, and it no longer sinks into walls, benches or rock or leaps out of them.\n- Felled trunks, debris and placed pieces are lit by your torch instead of staying black.", "created_date": 1792071364, "id": "2044544649598964", "version": "0.3.15", "version_code": 16777999, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2044544649598964"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "STARWORN 0.3.14\n\nFixes since 0.3.13.\n\n- Hammering a bench brings its materials out of the pack again.\n- A guest's plasma blade cuts creatures again (the host also needs 0.3.14).\n- A crater blown by a bomb is lit by your torch at once, not black for a while.\n- The Friends board lists only friends who play Starworn.", "created_date": 1792029443, "id": "2044054112981351", "version": "0.3.14", "version_code": 16777998, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2044544649598964"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792023341, "id": "2043997446320351", "version": "0.3.13", "version_code": 16777997, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2044544649598964"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792012449, "id": "2043908646329231", "version": "0.3.12", "version_code": 16777996, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2044544649598964"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792006959, "id": "2043853546334741", "version": "0.3.11", "version_code": 16777995, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
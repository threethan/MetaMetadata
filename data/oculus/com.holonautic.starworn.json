5/491823310_1108240945002703_5321937716498977301_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9DtBh1AuREEQ7kNvwFfmvf9&_nc_oc=Ado9DUZ14sz4WrMPG0SYuMWxAiXTkck1oOrOKasjYw3Iz7ILyLhzrvrMCuUbUFepITk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR69tLNV66rbRi5yymvKoig7LNOe6dy6upyfLCPXFC_w&oe=6AF5DA6B"}, {"file_name": "03-anvil.png", "id": "1743751803347179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_1743751806680512_7086347920327905545_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqfqDSneERUQ7kNvwEvBllQ&_nc_oc=AdqAwrn2xDdwMsh1mWjtK2OUHAidWhR_8IOmAjK06NEQmIdBdVd_W3ZFqeudNWGLZIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXQTNbhO64mitXnSqNQjXnwJ2CYGrDMuHj15Rq0peqwQ&oe=6AF5D076"}, {"file_name": "02-skewers-friends.png", "id": "1450016947006201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828008_1450016957006200_6089253454472159458_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHAjnvQAY4QQ7kNvwEW4Vkf&_nc_oc=AdpMPuH5CyQIwq4IDd6yjLLQQKKJgjBlRK54pK2eJkLfuc1ckF2i-PU4ZqhNrsd0zBQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc4WFwdWtjI6pyLOcFlzp2pMOfAaOkdvynmBbkcHYiCg&oe=6AF5F5A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "starworn-cover-2560x1440.png", "id": "1025693103822343", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1025693110489009_3995927389777223547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXDMQfJCG6kQ7kNvwFuL4L7&_nc_oc=AdrEU1oGJwhZktl8DEjGsv9id9bsgmr5by1KDlCiARSIi6d8gqv00y8GhUk13QrQqLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFcclS0vijjnpcMe_1FH6XxS6NrA34lvm3-VFS9-adBQ&oe=6AF5D1EB"}, "display_name": "Starworn", "keywords": [], "long_description": "**Your planet is gone.**\n\nYour replicator regenerated you on an alien world. You\u2019re stranded.\n\nStarworn is a voxel survival adventure built for VR. Start with what you can find and build a base to call home. The wilderness won\u2019t make it easy.\n\n{2834768043546491}\n\n**Made by hand.**\n\nFell trees and mine the terrain. Craft your tools at the workbench, then build your shelter piece by piece.\n\n{2403177630217480}\n\n{1398518511857019}\n\n**Around the campfire.**\n\nCook what you find and keep yourself fed.\n\n{1058073027057615}\n\n**Beyond the surface.**\n\nCaves hide strange creatures and new dangers. Invite friends into your world and head underground together.\n\n{28064931916523023}\n\n**The world changes.**\n\nForests turn to autumn colours and snow. When night falls, bring a torch.\n\n{1416491647119063}\n\n**Early Access**\n\nThe first world is playable now. Future updates will expand the journey: your own spaceship, other worlds and the search for survivors\u2014and whoever destroyed your planet.\n\nTell us what you want next. Your feedback helps decide what we build.\n\nJoin at a lower launch price. We plan to raise it after the first round of feedback and improvements, and again as the game grows. Early buyers receive all future base-game updates, including the full release, at no extra cost.\n\nExpect bugs and unfinished features. Some updates may require a new world. Buy for what\u2019s playable today.", "short_description": "Your planet is gone. Your replicator regenerated you on an alien world. You\u2019re stranded. Build a base by hand in a voxel survival adventure for VR. Invite friends into your world. Early Access begins with the first world, with more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starworn.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2028125241240905"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4550109638591045"}]}, "baseline_offer": {"id": "4550109638591045"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792080000, "status": "PUBLISHED", "id": "4550109638591045"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2065838400802922", "version": "0.4.27"}, "id": "1075480941908333", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2065838400802922"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": null, "created_date": 1794053890, "id": "2065838400802922", "version": "0.4.27", "version_code": 16778267, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2065838400802922"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "STARWORN 0.4.26\n\nNew since 0.4.23. Mostly smoother play for hosts and guests, plus a good many fixes.\n\nSMOOTHER PLAY\n\n- Hosting a big world on a Quest 3 or 3S stalls far less when you walk into new ground: the ground ahead of you is built first and on threads of its own, so the fog comes in without the hitches. Ground outside the fog stays kept for the walk back.\n- Rooms, torches and lights in a big base cost less every frame, and a base coming into view loads without a hitch. Standing in a big base with many players no longer eats memory: the ground kept for a guest stays within a limit.\n- On a headset that is already struggling, the view stops growing outward and comes back a ring instead of piling on more ground. A lit base over a lit cave base keeps its light on both.\n- The far land, respawn pods and placed things you walk up to cost less, which helps Quest 2 most.\n- Cave dwellers, hunters and castle fights cost the host far less, so a full world with eight players runs steadier.\n- Fixed flickering torch light in big bases: patches of ground no longer switch between lit and dark as you walk away from them.\n- Hands, tools and other players beside a torch no longer draw flat black when a chest or wall stands in the way.\n- Switching worlds no longer saves the world you leave 1.5 km out of place from its chests and dug ground.\n\nCAVES AND CREATURES\n\n- Torches, lamps and fires no longer keep cave creatures away. A cave you lit is still a cave.\n- Creatures and hunters follow a route round a corner instead of getting stuck under it, and a creature going round a flame no longer turns on the spot.\n- Cave dwellers no longer wake in a lit room while a player is looking at them.\n- Bats fly in caves far from where you began, instead of hanging still.\n- A Hollow or a bird you kill lies on the floor as it fell: no more bodies half in the ground, twisted legs, or corpses that stir.\n- A creature flung by the blast hammer comes down clean instead of sinking into the floor and snapping back up.\n- Walkers run with both feet off the ground between steps, and the Castellan keeps its feet still through its blows. The Pouncer stands on the ground, not just above it.\n- Signal Soldiers aim their gun, not their body, at what they shoot, and a placed thing in the way now stops their shot.\n- Only a creature that is burning as it falls dies burnt. Kills by plasma, shotgun or bullet fall as ordinary deaths again.\n- A sword brought round a Hollow to your hand strikes again on the next swing.\n\nHANDS AND TOOLS\n\n- A pick swung hard across a worn wall keeps striking it: before, a slow touch could spend the swing and break nothing.\n- Shotgun shells are caught when they come near the mouth of the barrel, so reloading on the move is more forgiving.\n- A riding hand's trigger brakes a skyhook line again, as the second hand does.\n- Pulling yourself up a zip line now tires your hand; gliding down costs nothing. Flying into a wall hurts a little at speed.\n- Recipes give what their name says, and their descriptions no longer repeat the count.\n- On the desktop, other players no longer see your hand go bare and back for a moment while you hold something.\n- Sweat runs down your view, not up it.\n- Windows no longer asks about the firewall when you play alone or start a world.\n- The multiplayer list's invite row now says JOIN and your friend's name, not INVITE, so it reads as what it does.", "created_date": 1793981135, "id": "2065083484211747", "version": "0.4.26", "version_code": 16778266, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2065838400802922"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793910935, "id": "2064329227620506", "version": "0.4.24", "version_code": 16778264, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2065838400802922"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "The Quest 2 runs smoother: no white glitter at the edges of the view, less memory, and arriving at a big base no longer stutters. Chests keep what's in them when they're knocked open and mended. The Castellan wakes up and defends his Keep, and Hollows keep their weapons out of your huts. Joining a friend no longer freezes the host. And no more strange whoosh sounds.", "created_date": 1793731216, "id": "2062368511149911", "version": "0.4.23", "version_code": 16778263, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2065838400802922"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "Halloween fixes. Pi\u00f1ata candy is taken up by hand, and a pi\u00f1ata has a grip. A stuck blast bolt hisses and lights. Another player's lit plasma blade no longer flickers. No more skeletons in your camp. Headsets cancel their echo in voice chat. Swimmers and wild animals are hurt like any body; creature blows throw by weight. The Recorder says why it films nothing. Everyone needs 0.4.22.", "created_date": 1793480125, "id": "2059617804758315", "version": "0.4.22", "version_code": 16778262, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
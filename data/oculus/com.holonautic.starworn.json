5/491823310_1108240945002703_5321937716498977301_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1T7b90BelVQQ7kNvwG30eum&_nc_oc=Ado55eWUtxApnA9XutvKGeXUcnjTafZUpF_IkQvE_zMOCrWUBFBM207pbLDrO3IiW1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj4EZeNxx0jPsADe_6ZCnT5TnHJIruHxcLgWdmXBb1ig&oe=6AF1E5EB"}, {"file_name": "03-anvil.png", "id": "1743751803347179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_1743751806680512_7086347920327905545_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMPzvnWFPLUQ7kNvwGm_MX7&_nc_oc=AdqHQ-pNTuNHBsAmRTxQGyq8MGTZN6J8FMV5eHTy94rBrQFTIdMknglIC0t2265XirM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBQVxZSsA9SpOK7vf4vK4Udf8KY4txy4bMWX1MzAvUvw&oe=6AF1DBF6"}, {"file_name": "02-skewers-friends.png", "id": "1450016947006201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828008_1450016957006200_6089253454472159458_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VC3NjekpHToQ7kNvwFulkMB&_nc_oc=AdqDpGCxhTO0cFNiGNBz0_BOLsWRaga1k1sxTYYIvuF4XZA18M26mhYm-W6KtoNgxko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6ccxO4F1VX45fNEufkNhDqrlB9tPosqXKWiaWYPadbQ&oe=6AF20121"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "starworn-cover-2560x1440.png", "id": "1025693103822343", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1025693110489009_3995927389777223547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlCdHaYpKp4Q7kNvwFhEBV4&_nc_oc=Adr4cjMxFmiR3cAmhAs7zN56B3kMRVxBJowigzMaaKVsYgTPr1YeEZHIIgB5_YRTg04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4mivwcXxHXYhy3bRJa1TjakeQtb29xgtlLeCwTbOr_g&oe=6AF1DD6B"}, "display_name": "Starworn", "keywords": [], "long_description": "**Your planet is gone.**\n\nYour replicator regenerated you on an alien world. You\u2019re stranded.\n\nStarworn is a voxel survival adventure built for VR. Start with what you can find and build a base to call home. The wilderness won\u2019t make it easy.\n\n{2834768043546491}\n\n**Made by hand.**\n\nFell trees and mine the terrain. Craft your tools at the workbench, then build your shelter piece by piece.\n\n{2403177630217480}\n\n{1398518511857019}\n\n**Around the campfire.**\n\nCook what you find and keep yourself fed.\n\n{1058073027057615}\n\n**Beyond the surface.**\n\nCaves hide strange creatures and new dangers. Invite friends into your world and head underground together.\n\n{28064931916523023}\n\n**The world changes.**\n\nForests turn to autumn colours and snow. When night falls, bring a torch.\n\n{1416491647119063}\n\n**Early Access**\n\nThe first world is playable now. Future updates will expand the journey: your own spaceship, other worlds and the search for survivors\u2014and whoever destroyed your planet.\n\nTell us what you want next. Your feedback helps decide what we build.\n\nJoin at a lower launch price. We plan to raise it after the first round of feedback and improvements, and again as the game grows. Early buyers receive all future base-game updates, including the full release, at no extra cost.\n\nExpect bugs and unfinished features. Some updates may require a new world. Buy for what\u2019s playable today.", "short_description": "Your planet is gone. Your replicator regenerated you on an alien world. You\u2019re stranded. Build a base by hand in a voxel survival adventure for VR. Invite friends into your world. Early Access begins with the first world, with more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starworn.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2028125241240905"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4550109638591045"}]}, "baseline_offer": {"id": "4550109638591045"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792080000, "status": "PUBLISHED", "id": "4550109638591045"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2062368511149911", "version": "0.4.23"}, "id": "1075480941908333", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2062368511149911"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "The Quest 2 runs smoother: no white glitter at the edges of the view, less memory, and arriving at a big base no longer stutters. Chests keep what's in them when they're knocked open and mended. The Castellan wakes up and defends his Keep, and Hollows keep their weapons out of your huts. Joining a friend no longer freezes the host. And no more strange whoosh sounds.", "created_date": 1793731216, "id": "2062368511149911", "version": "0.4.23", "version_code": 16778263, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2062368511149911"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "Halloween fixes. Pi\u00f1ata candy is taken up by hand, and a pi\u00f1ata has a grip. A stuck blast bolt hisses and lights. Another player's lit plasma blade no longer flickers. No more skeletons in your camp. Headsets cancel their echo in voice chat. Swimmers and wild animals are hurt like any body; creature blows throw by weight. The Recorder says why it films nothing. Everyone needs 0.4.22.", "created_date": 1793480125, "id": "2059617804758315", "version": "0.4.22", "version_code": 16778262, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2062368511149911"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793469864, "id": "2059508634769232", "version": "0.4.21", "version_code": 16778261, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2062368511149911"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "Quest 2: fixed black wedges and doubled hands (spider eyes); it runs its 5-chunk view. Graphics are Recommended or Custom; everyone starts on Recommended. The pack draws with half the triangles. Creatures out of sight cost nothing. Hostiles come to a base in parties. Distant land blends in. Smoother snow melt. Settings has a BUG REPORT page. The sleep watch says why the night won't pass. Cave loot weathers like loot outside. Laser-pistol robots drop no bows. Everyone needs 0.4.20.", "created_date": 1793215909, "id": "2056667005053395", "version": "0.4.20", "version_code": 16778260, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2062368511149911"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793152652, "id": "2055939071792855", "version": "0.4.18", "version_code": 16778258, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
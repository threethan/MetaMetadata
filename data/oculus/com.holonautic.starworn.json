qxJatDfqX-nH18DAWSBndqtz3HXMrqXMfYFAbcqdg5c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUTWldkfV6njBHXX-FJF5zEzET4XcQkw-HAfZHKZ_nHQ&oe=6AE49417"}, {"file_name": "22-57-spider-boss.png", "id": "3645795802240077", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_3645795805573410_6622082375602625910_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVkPw3CoVoYQ7kNvwENWy2Y&_nc_oc=Adp-AhW8KtS185g7RE8qzT06ghug3xyEi18e95UH8O7TkuYqcrEQ8b8jsZNBXtBbefc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfxBmZ-pMcbKzZrfwBy8FbgO5lc5ynvLBzUsQ3IeIfug&oe=6AE4B343"}, {"file_name": "26-trailer-bee-fight.png", "id": "2619500055141221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_2619500061807887_7329612513965974128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twXLRZ-RCAYQ7kNvwGRZrvI&_nc_oc=Adovz70z1a7LqxMIptfCsrrN5gyVGMgy8MpcXXxu5ItYlNDbbVVue5dY43nOlfyFuHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5cHAHrs8jruPqDfPETNCcQD0X6Fn0ZOQEv3pT_2R2iQ&oe=6AE4BF5D"}, {"file_name": "25-trailer-blue-tunnel.png", "id": "2536225146855845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_2536225150189178_2817632642999650210_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CBFxuTSTCegQ7kNvwG5pHOo&_nc_oc=Adozpk5lljwXKf0Hwy0cTK93YS7VDxqwdGCPSl-kkvI1ygCnClYK9kijuv4fmshfUEQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmVTuwIcpfHeVSFtvVfY34SXvt_g5tRICgg696UH4BUQ&oe=6AE4A2ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "starworn-release-trailer-cover-2560x1440.png", "id": "1087795250698932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1087795260698931_5252021567889472771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53EKkCDtrpIQ7kNvwEWCe81&_nc_oc=Adqeew-PZHIwlBPQXfRm9OHH9X_YrhGudBxnfXB8521NMRhOGpwQYZaJZ5RHX9w1RsQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmrCZVVDMKh8RslGrbJnAWcf5RsaOt2wP8hWxDltgGVw&oe=6AE4A6AB"}, "display_name": "Starworn", "keywords": ["multiplayer", "crafting", "building", "voxel", "coop"], "long_description": "**Your planet is gone.**\n\nYour replicator regenerated you on an alien world. You\u2019re stranded.\n\nStarworn is a voxel survival adventure built for VR. Start with what you can find and build a base to call home. The wilderness won\u2019t make it easy.\n\n{2834768043546491}\n\n**Made by hand.**\n\nFell trees and mine the terrain. Saw logs into planks, smelt ore and forge your own blades. Each bench is worked by hand.\n\n{2403177630217480}\n\n{1398518511857019}\n\n{1375776144356240}\n\n**Around the campfire.**\n\nCook what you find and keep yourself fed.\n\n{1058073027057615}\n\n**Stand your ground.**\n\nSkeletons come in packs. Black knights hit back. Craft swords, bows, bombs, a blade that flies back to your hand and plasma weapons.\n\n{1639793914507855}\n\n{1976031123062268}\n\n**Beyond the surface.**\n\nOld ruins are guarded by skeletons, caves hide giant spiders, and a robot keep guards its vault. Invite friends and head underground together.\n\n{1773014517088275}\n\n{28064931916523023}\n\n**The world changes.**\n\nForests turn to autumn colours and snow. When night falls, bring a torch.\n\n{1416491647119063}\n\n**Early Access**\n\nThe first world is playable now, and we keep updating it. Future updates will expand the journey: your own spaceship, other worlds and the search for survivors, and whoever destroyed your planet.\n\nTell us what you want next. Your feedback helps decide what we build.\n\nJoin at a lower launch price. We plan to raise it after the first round of feedback and improvements, and again as the game grows. Early buyers receive all future base-game updates, including the full release, at no extra cost.\n\nExpect bugs and unfinished features. Some updates may require a new world. Buy for what\u2019s playable today.", "short_description": "Your planet is gone. Your replicator regenerated you on an alien world. You\u2019re stranded. Build a base by hand, fight off skeleton armies and black knights, and invite friends into your world. A voxel survival adventure for VR, out now in Early Access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starworn.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": "https://www.holonautic.com/", "website_url": "https://starworn.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER", "MULTI_USER"], "id": "2050391579014271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_3701695849981336_8813589630872871589_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFurzGXSNjMQ7kNvwF85vK2&_nc_oc=Adq5fH-ESfS7-FI1dS_leXxvTzJrI3bKr6whtCwEv_h8qKkZdhVYT3d4f3TdwB0jlUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzHsaw-Me_6xAyMRiTXAM-mPnHUP6WoC10Z7fHaT4llw&oe=6AE4B36E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Starworn", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox",
5/491823310_1108240945002703_5321937716498977301_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NayCA19rUjYQ7kNvwEctYcx&_nc_oc=Ado5ux7d-nSNVxxYn_UZ4g-l_7w4269aCS324N095Qe0_uip395MlYnYs7tGHQb8dXY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKpfX93zfe1_A0O2zrBlJ6bXxNEyw0igRw3wmTiqzYwA&oe=6AE4B6EB"}, {"file_name": "03-anvil.png", "id": "1743751803347179", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825575_1743751806680512_7086347920327905545_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3UcPfBM220Q7kNvwE8z27m&_nc_oc=AdpYai52CygU8Rssv2vMHWTm0QbYKe4pr0SaksKUPaWJZG3uDui11anMfqD2Od16iRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhP_wwmuX__twVlltvCOIBRHn5cTh5kPf2alZMEqu1cA&oe=6AE4ACF6"}, {"file_name": "02-skewers-friends.png", "id": "1450016947006201", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828008_1450016957006200_6089253454472159458_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHIrFl8CdzoQ7kNvwEgzkeW&_nc_oc=AdoR8cw-5nGIisPQ4nW6GwHCwFGGXGYfYdsZrrn-wzo646irQUh6sLVG8zQRZL9OKko&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAgYC4KKBMC5iRVnabTeUdaHfW-Akk6UF9OER2L-xQIA&oe=6AE499E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "starworn-cover-2560x1440.png", "id": "1025693103822343", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1025693110489009_3995927389777223547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rbf91rCNVeoQ7kNvwHB9eyb&_nc_oc=AdqCeU-Ub2L0X9kwpihpX1ZC7_n7W_dVR12kQNrIc21C0mCBR8WIUOZ98YmaO6SqWKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpiM1Bv5Q25S6Zj1W7iq9VMtEY5s9ULCNGXTPIyENg9w&oe=6AE4AE6B"}, "display_name": "Starworn", "keywords": [], "long_description": "**Your planet is gone.**\n\nYour replicator regenerated you on an alien world. You\u2019re stranded.\n\nStarworn is a voxel survival adventure built for VR. Start with what you can find and build a base to call home. The wilderness won\u2019t make it easy.\n\n{2834768043546491}\n\n**Made by hand.**\n\nFell trees and mine the terrain. Craft your tools at the workbench, then build your shelter piece by piece.\n\n{2403177630217480}\n\n{1398518511857019}\n\n**Around the campfire.**\n\nCook what you find and keep yourself fed.\n\n{1058073027057615}\n\n**Beyond the surface.**\n\nCaves hide strange creatures and new dangers. Invite friends into your world and head underground together.\n\n{28064931916523023}\n\n**The world changes.**\n\nForests turn to autumn colours and snow. When night falls, bring a torch.\n\n{1416491647119063}\n\n**Early Access**\n\nThe first world is playable now. Future updates will expand the journey: your own spaceship, other worlds and the search for survivors\u2014and whoever destroyed your planet.\n\nTell us what you want next. Your feedback helps decide what we build.\n\nJoin at a lower launch price. We plan to raise it after the first round of feedback and improvements, and again as the game grows. Early buyers receive all future base-game updates, including the full release, at no extra cost.\n\nExpect bugs and unfinished features. Some updates may require a new world. Buy for what\u2019s playable today.", "short_description": "Your planet is gone. Your replicator regenerated you on an alien world. You\u2019re stranded. Build a base by hand in a voxel survival adventure for VR. Invite friends into your world. Early Access begins with the first world, with more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starworn.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}, {"id": "644354873106712"}]
Pk79M2yT7IYtkS0uq-KhT8X5O0aKS7tLE15EI8KpSCY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWllY_MIdCFt4p80FImj6Nxh5Zog-vUo7gDuvNGmx8Ng&oe=6AF5EFD7"}, {"file_name": "22-57-spider-boss.png", "id": "3645795802240077", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_3645795805573410_6622082375602625910_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_omFWP4HTwQ7kNvwEXEcVl&_nc_oc=Ado2w7j2omaXpv2hy4qSxq1HdzDEKxiJ_ThopPbCPuXLGW3FG1kIb_nP7MJ8lagnCMQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQg6qCuJUIszuKGFHxdiO0LTZdovnGpr3MBsDbv8VmiBg&oe=6AF5D6C3"}, {"file_name": "26-trailer-bee-fight.png", "id": "2619500055141221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_2619500061807887_7329612513965974128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWwCf7WDFHwQ7kNvwGKtLBz&_nc_oc=AdoCYMkygO9jiQEbvPZmdW2EinkdeZPoN77JheBjo0TonNxmxrzon7LGFuwDEoXAlrg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfCumqRM27EpIAFjCAx-E1KKZe-12zdYdfYGJjB8iMBw&oe=6AF5E2DD"}, {"file_name": "25-trailer-blue-tunnel.png", "id": "2536225146855845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_2536225150189178_2817632642999650210_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WssYmSxPUPIQ7kNvwHRFWsv&_nc_oc=Ado5qox3mGYVKB9yTVP2A1c4HHEV64xill8xPFtmOiTLkaGJYhplRxH1bdLRyjzwC0s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgjncBgQhib7l6SZVob-PeuW3eD8c087MixB-katbs4Q&oe=6AF5C66D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "starworn-release-trailer-cover-2560x1440.png", "id": "1087795250698932", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_1087795260698931_5252021567889472771_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpk4LbskprAQ7kNvwGGskUN&_nc_oc=Adqv1FOrrr-rW3m3vaGji3KlhDB7Hruzz9ne2Fnke6rGv2mhMGXgZ4UfkoJRdp_KNtc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWSKHS0ksjejUSzYq2DyhBldt7ZAsFq6eZZ_RYQ5ZwUQ&oe=6AF5CA2B"}, "display_name": "Starworn", "keywords": ["multiplayer", "crafting", "building", "voxel", "coop"], "long_description": "**Your planet is gone.**\n\nYour replicator regenerated you on an alien world. You\u2019re stranded.\n\nStarworn is a voxel survival adventure built for VR. Start with what you can find and build a base to call home. The wilderness won\u2019t make it easy.\n\n{2834768043546491}\n\n**Made by hand.**\n\nFell trees and mine the terrain. Saw logs into planks, smelt ore and forge your own blades. Each bench is worked by hand.\n\n{2403177630217480}\n\n{1398518511857019}\n\n{1375776144356240}\n\n**Around the campfire.**\n\nCook what you find and keep yourself fed.\n\n{1058073027057615}\n\n**Stand your ground.**\n\nSkeletons come in packs. Black knights hit back. Craft swords, bows, bombs, a blade that flies back to your hand and plasma weapons.\n\n{1639793914507855}\n\n{1976031123062268}\n\n**Beyond the surface.**\n\nOld ruins are guarded by skeletons, caves hide giant spiders, and a robot keep guards its vault. Invite friends and head underground together.\n\n{1773014517088275}\n\n{28064931916523023}\n\n**The world changes.**\n\nForests turn to autumn colours and snow. When night falls, bring a torch.\n\n{1416491647119063}\n\n**Early Access**\n\nThe first world is playable now, and we keep updating it. Future updates will expand the journey: your own spaceship, other worlds and the search for survivors, and whoever destroyed your planet.\n\nTell us what you want next. Your feedback helps decide what we build.\n\nJoin at a lower launch price. We plan to raise it after the first round of feedback and improvements, and again as the game grows. Early buyers receive all future base-game updates, including the full release, at no extra cost.\n\nExpect bugs and unfinished features. Some updates may require a new world. Buy for what\u2019s playable today.", "short_description": "Your planet is gone. Your replicator regenerated you on an alien world. You\u2019re stranded. Build a base by hand, fight off skeleton armies and black knights, and invite friends into your world. A voxel survival adventure for VR, out now in Early Access."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starworn.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": "https://www.holonautic.com/", "website_url": "https://starworn.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER", "MULTI_USER"], "id": "2050391579014271"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824328_1645465263743433_5873115195616395048_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMBm-UFV_XcQ7kNvwGbmvDu&_nc_oc=AdqFUfuuwI4ZLuSEI0EQ_KuVTofZkp4NsQv953qVIeMbx0rrNnT1KXLuvbGX7CYa7NI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbz5kvZD-ChBV3uOrObclDAdz7h69X9PAqJD1ZQ5-7YQ&oe=6AF5C482"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Starworn", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox",
5/491823310_1108240945002703_5321937716498977301_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7_R8sFrF7UQ7kNvwGI8ZGC&_nc_oc=AdoHZFZ7koLBt2c1CyHu7kTllNaYl0CPgLLg15PAvfdGTUzsm14yMyLEkCVDY4ySXY8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMfDlUfZDiDxbaWWkIJl1OwmZtYZI0mfcA6TLpeRrA8g&oe=6AE213EB"}, {"file_name": "03-anvil.png", "id": "1743751803347179", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825575_1743751806680512_7086347920327905545_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dE5tMhq5ZGoQ7kNvwHhdec3&_nc_oc=AdqqLITC4l9L7VL5YB5xXLc29MivvCRhdZx5jXSJUGJvKDepGl1BBvqQ3Rx9jblgJOQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkpME8d4cznI7rmTVZAxDnKdZ7znEaTp-2Mvb_-ruw9Q&oe=6AE209F6"}, {"file_name": "02-skewers-friends.png", "id": "1450016947006201", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828008_1450016957006200_6089253454472159458_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=io2Rxci6SBAQ7kNvwGqU0CH&_nc_oc=Adq-SJRe8p_muTB8BjXrH1AUDoF2XBMJ47ArMFBCdGn99WSQjPVDdrlzSkI5sHGwxx4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEs6Luny6dM05M991mgP2Nw0lT-JyVaDvRScCHqwUDMA&oe=6AE1F6E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "starworn-cover-2560x1440.png", "id": "1025693103822343", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821704_1025693110489009_3995927389777223547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rbf91rCNVeoQ7kNvwE2hbjX&_nc_oc=AdqEuiCMioq-awKObCBSwW5Q91zBBTvVO3MdEdemkWbl_PvZykw8bAxEiG1HiwU6IW8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiLg6zXtI5gsA-K5BkUkZzUQpO8Ne2L301GuTX2-lKzQ&oe=6AE20B6B"}, "display_name": "Starworn", "keywords": [], "long_description": "**Your planet is gone.**\n\nYour replicator regenerated you on an alien world. You\u2019re stranded.\n\nStarworn is a voxel survival adventure built for VR. Start with what you can find and build a base to call home. The wilderness won\u2019t make it easy.\n\n{2834768043546491}\n\n**Made by hand.**\n\nFell trees and mine the terrain. Craft your tools at the workbench, then build your shelter piece by piece.\n\n{2403177630217480}\n\n{1398518511857019}\n\n**Around the campfire.**\n\nCook what you find and keep yourself fed.\n\n{1058073027057615}\n\n**Beyond the surface.**\n\nCaves hide strange creatures and new dangers. Invite friends into your world and head underground together.\n\n{28064931916523023}\n\n**The world changes.**\n\nForests turn to autumn colours and snow. When night falls, bring a torch.\n\n{1416491647119063}\n\n**Early Access**\n\nThe first world is playable now. Future updates will expand the journey: your own spaceship, other worlds and the search for survivors\u2014and whoever destroyed your planet.\n\nTell us what you want next. Your feedback helps decide what we build.\n\nJoin at a lower launch price. We plan to raise it after the first round of feedback and improvements, and again as the game grows. Early buyers receive all future base-game updates, including the full release, at no extra cost.\n\nExpect bugs and unfinished features. Some updates may require a new world. Buy for what\u2019s playable today.", "short_description": "Your planet is gone. Your replicator regenerated you on an alien world. You\u2019re stranded. Build a base by hand in a voxel survival adventure for VR. Invite friends into your world. Early Access begins with the first world, with more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starworn.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2028125241240905"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4550109638591045"}]}, "baseline_offer": {"id": "4550109638591045"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792080000, "status": "PUBLISHED", "id": "4550109638591045"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2052201678833261", "version": "0.4.6"}, "id": "1075480941908333", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2052201678833261"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "STARWORN 0.4.6\n\nNew since 0.4.5.\n\nFIXES\n\n- The game no longer crashes when a machine that is both rusted and damaged comes into view. Big machines such as the forge, left out in the weather and knocked about, could crash the game as you arrived near them.", "created_date": 1792803586, "id": "2052201678833261", "version": "0.4.6", "version_code": 16778246, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2052201678833261"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "STARWORN 0.4.5\n\nNew since 0.4.4.\n\nPERFORMANCE\n\n- Big, built-up worlds no longer stall every few seconds: the game stopped regrowing every tree each time it looked at the ground around you.\n- A swarm of attacking bees no longer drags the frame rate down, and neither does shooting them with shotgun shells.\n- Joining a friend's world full of torches and building no longer stalls the guest.\n- Dying in a big, built-up world no longer causes a hitch a few seconds later.\n- Hosting a world with many machines costs far less every frame: worn and cut machines are no longer compared again each frame.\n- Snow footprints are switched off for now: keeping them up to date stalled some Quest 3s.\n\nCLIMBING AND ZIPLINES\n\n- You keep your grip on a cord, ladder or ledge when the game hitches, and while the ground around you is still loading, instead of letting go and falling.\n\nBUILDING\n\n- The sloped roof is the timber roof again, and the shingled roof is gone. A sloped roof now starts at your hand and faces away from you. Shingled roofs already built turn into timber planks where they stand.\n- Doors swing open ahead of you: they no longer hit you in the face or hold you in the doorway. A latched door stops you, and a window you let go of stays put.\n\nTHE POD\n\n- Moving your pod into or through a house no longer destroys walls, roofs, paintings or machines on the way.\n- A pod shut in under a roof no longer gets stuck searching for ground; with nowhere below, it lands on the nearest roof.\n- Your own body no longer blocks placing the pod: it only flies in later.\n\nTHE WORLD\n\n- Tiny white specks of sky no longer flicker through the ground on Quest 2.\n- Bees no longer come back once their hive is gone.\n- Bellroot is just a plant now: it no longer sways and chimes when creatures come near.\n- Tree crowns next to a lamp are lit instead of drawing black.\n- Storm clouds no longer flicker overhead.\n- Ropes and machines hanging over open air or standing in buried ground near you no longer go missing.", "created_date": 1792792458, "id": "2052107208842708", "version": "0.4.5", "version_code": 16778245, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2052201678833261"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "STARWORN 0.4.4\n\nNew since 0.4.3.\n\nGETTING UNSTUCK\n\n- I'M STUCK now really frees you: it puts you on open ground well clear of whatever held you, with room around you and a way to walk off. Press it again and it takes you further.\n\nREPAIR KIT\n\n- The tinker's repair kit is now a tote: a wire brush and a tin of rivets, held naturally in the hand. Scrubbing a machine clean takes real work, and the brush wears and breaks apart from the tin.\n- Craft a fresh rivet tin on its own from scrap at the tinker, and drop a loose brush or tin into the tote's empty slot to refill it.\n\nWALKIE-TALKIE\n\n- A call stays on for as long as you hold the button: turning, recentering or reaching near your pack no longer cuts it off.\n- Everything you say while holding the button goes out, however quietly you speak.\n- With your microphone off or not allowed, the walkie clicks dead and your watch says why, instead of seeming to transmit.\n- Holding the talk button when you die no longer leaves that channel silent after you respawn.\n\nTHE HOLO MAP\n\n- On the map table, players' heads are smaller and have no rings; point at one and it grows and shows its name.\n- On the map disc in your hand, a player's ring and name show only while you point at them.\n- Players standing in the same spot stack their heads one on top of the other instead of flickering into each other.\n\nTHE WORLD\n\n- A beehive you destroy stays gone, even if you fell its tree: no fresh hive and no new bees pop up in its place.\n- Fallen players lie without flickering.\n- An arrow in your hand is the same size as the arrow you shoot.\n\nPERFORMANCE\n\n- Quest 2 and Quest 3S: the game's worker threads now wait for their own cores, removing long stalls during play.\n- Distant trees cost less to draw.\n- Bombs and blasts that carve big craters cause smaller hitches on Quest 2.\n\nSANDBOX\n\n- The sandbox resource chest lists each resource under one tab only.\n\nLOOKS\n\n- The Ironclad outfit's legs and boots are rebuilt: layered thigh plates, knee caps, shin guards and low, broad boots.", "created_date": 1792762313, "id": "2051766152210147", "version": "0.4.4", "version_code": 16778244, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2052201678833261"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792753208, "id": "2051658332220929", "version": "0.4.3", "version_code": 16778243, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2052201678833261"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1792714261, "id": "2051266022260160", "version": "0.4.2", "version_code": 16778242, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
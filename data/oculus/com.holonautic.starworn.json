content-lga3-3.oculuscdn.com/v/t64.5771-25/491823812_1437492938480719_5333136018440499492_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgKJB673FOgQ7kNvwFGnD2X&_nc_oc=AdpFpCg_ouuwhW9gG1TCmeyeKkqSjV-r3A_y1emPAc7i6P01Kv0yfHx0nya1_rOCukw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6q57aNXYuEl3MaoTcEYHZUVRNFIxdSeg0Dz04z2iPXw&oe=6AFB39E5"}, {"file_name": "01-brackenback-dunesail.png", "id": "1108240935002704", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823310_1108240945002703_5321937716498977301_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAb1xn2pY-gQ7kNvwH4tTsU&_nc_oc=AdpTGYiHz7H33pF_DkD6kKwj38V8uFsF7vcvZmw_H94GyRQph_bUrVA95hnxLLkXucM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ0lsuFEobsmWjUTsgOqrmlGW9G-KCdPRx82xeCo7K7w&oe=6AFB206B"}, {"file_name": "03-anvil.png", "id": "1743751803347179", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825575_1743751806680512_7086347920327905545_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59ijjJkwLfUQ7kNvwHPyXZd&_nc_oc=AdodfpQMNPGhTxND9TNPbaVKcN3beJNqS_Kk5nI6SzWhj2C4r6u271itiRvq-_51ug0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3nBHSv32fZN47XE9ggDoU9JIdupBWXhubyu0ovEWpUA&oe=6AFB1676"}, {"file_name": "02-skewers-friends.png", "id": "1450016947006201", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828008_1450016957006200_6089253454472159458_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m9tz8wZLWPkQ7kNvwGmDgty&_nc_oc=Adoc7zVl0LJYcE7a00EUjO7ncVnk45zNiVij9mj48MtLDscuJcPT1BkXEglKV3yRzME&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU5Rw7XyH2pSaHH2xMBZ-twFI1dDxQrhb9rySitftiBA&oe=6AFB3BA1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "starworn-cover-2560x1440.png", "id": "1025693103822343", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491821704_1025693110489009_3995927389777223547_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AlIOWRfbjRMQ7kNvwHkyXm-&_nc_oc=Ado2mXAyZOVpzZDJ9NM01Qs5dGNCTc9K_TfdDeySmzXoJUYuMV1ZI4amfWBwCXe8bnM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbstC0C6OcGbZNIZd7rpaLVGpbqvsQ_3Nq79zhZvZhGg&oe=6AFB17EB"}, "display_name": "Starworn", "keywords": [], "long_description": "**Your planet is gone.**\n\nYour replicator regenerated you on an alien world. You\u2019re stranded.\n\nStarworn is a voxel survival adventure built for VR. Start with what you can find and build a base to call home. The wilderness won\u2019t make it easy.\n\n{2834768043546491}\n\n**Made by hand.**\n\nFell trees and mine the terrain. Craft your tools at the workbench, then build your shelter piece by piece.\n\n{2403177630217480}\n\n{1398518511857019}\n\n**Around the campfire.**\n\nCook what you find and keep yourself fed.\n\n{1058073027057615}\n\n**Beyond the surface.**\n\nCaves hide strange creatures and new dangers. Invite friends into your world and head underground together.\n\n{28064931916523023}\n\n**The world changes.**\n\nForests turn to autumn colours and snow. When night falls, bring a torch.\n\n{1416491647119063}\n\n**Early Access**\n\nThe first world is playable now. Future updates will expand the journey: your own spaceship, other worlds and the search for survivors\u2014and whoever destroyed your planet.\n\nTell us what you want next. Your feedback helps decide what we build.\n\nJoin at a lower launch price. We plan to raise it after the first round of feedback and improvements, and again as the game grows. Early buyers receive all future base-game updates, including the full release, at no extra cost.\n\nExpect bugs and unfinished features. Some updates may require a new world. Buy for what\u2019s playable today.", "short_description": "Your planet is gone. Your replicator regenerated you on an alien world. You\u2019re stranded. Build a base by hand in a voxel survival adventure for VR. Invite friends into your world. Early Access begins with the first world, with more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starworn.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2028125241240905"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4550109638591045"}]}, "baseline_offer": {"id": "4550109638591045"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792080000, "status": "PUBLISHED", "id": "4550109638591045"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2070267943693301", "version": "0.4.33"}, "id": "1075480941908333", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2070267943693301"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "The Gunslinger Update\n\nDual wielding pistols\n- Hold a pistol in each hand and reload both without a free hand: push an empty pistol into a holster with magazines and a fresh one flies into the grip.\n- Chamber a round the physical way: push the slide against your other pistol, a wall or a table edge and it racks.\n- A locked-open slide slams home when you press it against something.\n- Your pistols go back to their own holster.\n- Rifle, pistols and the blast bolt hit twice as hard.\n\nBrutal deaths\n- The shotgun tears skeletons apart where it hits.\n- Plasma kills burn: shockwaves, burnt holes and smoke from the wound.\n\nMultiplayer\n- Friends who could not join now get in, through our own relay when their network blocks the usual way.\n- Hosting is smoother: a friend joining no longer makes your frame stutter, and your view no longer widens while your headset is already working hard.\n- Join codes show in two groups, and the multiplayer page shows your game version.\n\nPerformance\n- Big skeletons near torches cost far less to draw.\n- The freeze a few seconds after opening a world is gone, and big worlds load sooner.\n- Bases with lots of torches run lighter.\n\nFixes\n- Tables can be repaired again with a log.\n- You can place walls and roofs where nothing stands.\n- Footprints, smoke and spilled items no longer glow at night.\n- Swimming feels like water.\n- Held signs show their drawing to other players.\n- The Bramblemaw has half the health.\n- Fewer flickering creatures, no ghost tools on the robot page, no far lamps hanging in the dark.\n\nKnown issues\n- With 8 players the Proving Grounds is too small and some pods hover instead of landing; a bigger room with pod bays is coming.", "created_date": 1794436546, "id": "2070267943693301", "version": "0.4.33", "version_code": 16778273, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2070267943693301"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": null, "created_date": 1794330482, "id": "2069012947152134", "version": "0.4.32", "version_code": 16778272, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2070267943693301"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794247599, "id": "2068066953913400", "version": "0.4.31", "version_code": 16778271, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2070267943693301"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794189667, "id": "2067384857314943", "version": "0.4.30", "version_code": 16778270, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}
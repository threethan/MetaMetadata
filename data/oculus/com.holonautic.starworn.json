5/491823310_1108240945002703_5321937716498977301_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q0a4by_bV3EQ7kNvwEuh82n&_nc_oc=AdpHTXIxsinuQWX4lciqFkwtIoccqdppp3lHfTsTVHs-B7zTf60-UtivTVv6yZBlPcY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgLBfaJ006oaR9n6jSU0-nWj0-JfX4Zj6UljgjezMXog&oe=6AE8AB6B"}, {"file_name": "03-anvil.png", "id": "1743751803347179", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825575_1743751806680512_7086347920327905545_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEZwr_HQPjsQ7kNvwFY8zzT&_nc_oc=AdpADjkWE5aSsEwACtZvZEmmy3tRv2JbGQHyo2AuO0USVOMU9XdhkR_LyLs7IFuOI4k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBUPFqfPnWrMqycNPlD9QiRhj9_tVyvn-FYlmzT6mTEA&oe=6AE8A176"}, {"file_name": "02-skewers-friends.png", "id": "1450016947006201", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491828008_1450016957006200_6089253454472159458_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TP314mCmabUQ7kNvwEOhmvC&_nc_oc=Adqb6k5990OwuXNzYx4j5OhG-vQqTU9ggptCVYcb5MTOG7ZodB1IgYbeUb90TTNXwpM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtsElLQ4wN0NShTcBra0_uV66MTrQ68F_EUyWxTmtYcw&oe=6AE88E61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "starworn-cover-2560x1440.png", "id": "1025693103822343", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821704_1025693110489009_3995927389777223547_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XYxhVPkoPMQ7kNvwHdovOe&_nc_oc=AdoZOeNHMxGQgSXhonSyLsNzqkz91yCSHs3PpE2JaBpAqu_c64p2G3cjHN3-SZCaJAA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYPjKx4ULjLPfr2s5RGs2H_Q4Kqq7L0QgXMgrl1tExNA&oe=6AE8A2EB"}, "display_name": "Starworn", "keywords": [], "long_description": "**Your planet is gone.**\n\nYour replicator regenerated you on an alien world. You\u2019re stranded.\n\nStarworn is a voxel survival adventure built for VR. Start with what you can find and build a base to call home. The wilderness won\u2019t make it easy.\n\n{2834768043546491}\n\n**Made by hand.**\n\nFell trees and mine the terrain. Craft your tools at the workbench, then build your shelter piece by piece.\n\n{2403177630217480}\n\n{1398518511857019}\n\n**Around the campfire.**\n\nCook what you find and keep yourself fed.\n\n{1058073027057615}\n\n**Beyond the surface.**\n\nCaves hide strange creatures and new dangers. Invite friends into your world and head underground together.\n\n{28064931916523023}\n\n**The world changes.**\n\nForests turn to autumn colours and snow. When night falls, bring a torch.\n\n{1416491647119063}\n\n**Early Access**\n\nThe first world is playable now. Future updates will expand the journey: your own spaceship, other worlds and the search for survivors\u2014and whoever destroyed your planet.\n\nTell us what you want next. Your feedback helps decide what we build.\n\nJoin at a lower launch price. We plan to raise it after the first round of feedback and improvements, and again as the game grows. Early buyers receive all future base-game updates, including the full release, at no extra cost.\n\nExpect bugs and unfinished features. Some updates may require a new world. Buy for what\u2019s playable today.", "short_description": "Your planet is gone. Your replicator regenerated you on an alien world. You\u2019re stranded. Build a base by hand in a voxel survival adventure for VR. Invite friends into your world. Early Access begins with the first world, with more to come."}]}, "developer_name": null, "developer_privacy_policy_url": "https://starworn.net/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Holonautic", "support_website_url": null, "website_url": "https://www.holonautic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2028125241240905"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4550109638591045"}]}, "baseline_offer": {"id": "4550109638591045"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792080000, "status": "PUBLISHED", "id": "4550109638591045"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2056667005053395", "version": "0.4.20"}, "id": "1075480941908333", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2056667005053395"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "Quest 2: fixed black wedges and doubled hands (spider eyes); it runs its 5-chunk view. Graphics are Recommended or Custom; everyone starts on Recommended. The pack draws with half the triangles. Creatures out of sight cost nothing. Hostiles come to a base in parties. Distant land blends in. Smoother snow melt. Settings has a BUG REPORT page. The sleep watch says why the night won't pass. Cave loot weathers like loot outside. Laser-pistol robots drop no bows. Everyone needs 0.4.20.", "created_date": 1793215909, "id": "2056667005053395", "version": "0.4.20", "version_code": 16778260, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2056667005053395"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1793152652, "id": "2055939071792855", "version": "0.4.18", "version_code": 16778258, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2028125237907572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2056667005053395"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1075480941908333"}]}, "change_log": "Big speed-ups, less memory, no hosting hitches. Smoother frames with SpaceWarp. Climbing grip tires on ropes and ladders; rest on a rope with both hands. Move your pod by its beacon. B or Y on a walkie beeps. Neck cuts kill. Guests can scrub rust, all hear it. Ladders no longer go black. Repair kits refill. Crossbows look right. Thrown items are the catcher's. Flames and burning show. Caves keep their enemies as you explore. Bomb craters appear at once. Crashes fixed. Everyone needs 0.4.17.", "created_date": 1793134707, "id": "2055747235145372", "version": "0.4.17", "version_code": 16778257, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_f
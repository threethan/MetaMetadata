ore_art_ggp_screenshot3.png", "id": "734411288586238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001670_734411291919571_3088972122069262667_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1wwkr61JA8Q7kNvwGZ3oae&_nc_oc=Adq5VXvg8MtbmDtJfTV6Bgd39kwP9_JaA93auOfTDrl5RpOSGPKL_qVosgV5lpltzFM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2rtO9aoGG-RSMJYJWMbGx28Ob16J70GYLfU8pYzyrhKA&oe=69F4A573"}, {"file_name": "store_art_ggp_screenshot4.png", "id": "194145350441702", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974893_194145353775035_6888814130813287519_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcuJ_xKCH9IQ7kNvwGgzI-y&_nc_oc=AdqQryTOjxKtb8ChvyduDuAde52fr58XdX7_Kor9BdrBsiH4D5jenI6JrNQrpzQW7k0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vHw8AhZx4L6EgsxpwHROIT3xD3KetdxMBxNvx-cwVkg&oe=69F4B6F1"}, {"file_name": "store_art_ggp_screenshot1.png", "id": "1395217758060028", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75507165_1395217761393361_4721445420427429208_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjAI3F-ZylQQ7kNvwGxWm8R&_nc_oc=AdqzIJX_FssACthWcqSF-bzWJAdpQVX8ydlwowKfiMmo1aNQEuNVyKJodaMoAfiJ5t8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1TnBVLIBBOyEfDOUELOTv-EVnmnlSJrIybU_diYKyYwA&oe=69F4B257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "store_art_ggp_screenshot4.png", "id": "352113654090292", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031462_352113657423625_7192351234712908151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RYkEQNAfP8Q7kNvwEsIDzA&_nc_oc=Ado-1NgXm83GngbMC0FVYxnXDZ4zc4neFOt6IMysJdavpZnpMiwqAP4Qm_SX1yOienY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EiBOMb6umFcgWm4P3_Y3LTnvJlVDuEvTaWxJcwv-wMQ&oe=69F4A86B"}, "display_name": "Gedrag: (G)een Probleem - Extended", "keywords": [], "long_description": "Deze ervaring is ontworpen als een trainingsinstrument voor professionals in ouderenzorg om een dieper begrip te krijgen van gedragssymptomen bij pati\u00ebnten met dementie. De ervaring ondersteunt bij de ontwikkeling van empathie en het verbeteren van communicatievaardigheden.\n\nOntwikkeld door het voormalige Leiden University Centre for Innovation in samenwerking met opleidingsprogramma\u2019s aan het Leids Universitair Medisch Centrum (LUMC), biedt de app \"Gedrag: (G)een Probleem\" een reis in de wereld van pati\u00ebnten met dementie. \n\nDe nieuwste versie van de app is verrijkt en uitgebreid door het Leiden Learning and Innovation Centre in samenwerking met Zorg4Effect dankzij de genereuze subsidie en (financi\u00eble) bijdragen van diverse organisaties en fondsen. Deze ontwikkeling werd mogelijk gemaakt door:\n\nGemeente Leiden\nJo Visser fonds\nPleindoneren Stichting Else\nProject SIVIL ZonMW\nTransitiegelden van zorgkantoor Zorg en Zekerheid en Zorg4Effect", "short_description": "Deze ervaring is ontworpen als een trainingsinstrument voor professionals in ouderenzorg om een dieper begrip te krijgen van gedragssymptomen bij pati\u00ebnten met dementie. De ervaring ondersteunt bij de ontwikkeling van empathie en het verbeteren van communicatievaardigheden."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.leidenlearninginnovation.org/about/privacy-policy-gedrag-geen-probleem-extended/", "developer_terms_of_service_url": null, "publisher_name": "Leiden University", "support_website_url": null, "website_url": "https://www.leidenlearninginnovation.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
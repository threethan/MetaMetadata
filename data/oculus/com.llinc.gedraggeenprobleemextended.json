ore_art_ggp_screenshot3.png", "id": "734411288586238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001670_734411291919571_3088972122069262667_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srXe3YX0CHsQ7kNvwHKmZ14&_nc_oc=AdrzUVKLYzxqzMJrzLtMZaGk9jbe13pxHvJ1O8W0l_BWFjAADYkqptkHLEc1PHewrrM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_T6Ht8TLNfZVkN9wzceRVt7iFf0YPOSnPQGPCTuwWYoA&oe=6A296173"}, {"file_name": "store_art_ggp_screenshot4.png", "id": "194145350441702", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974893_194145353775035_6888814130813287519_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sAAJ0vFFWwQ7kNvwEI5HC2&_nc_oc=Adp1aI1tZ-ue-qoInkNW3DtcuUsD2Y2JQEOW0p4MQIO3e2aQc_dn_utnmBpjQqCIYdM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XNbolU5_z7CCfGgW4pyY51ElXfeTmc8K2_kYRGZ2CSQ&oe=6A2972F1"}, {"file_name": "store_art_ggp_screenshot1.png", "id": "1395217758060028", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75507165_1395217761393361_4721445420427429208_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APicYiZ12VQQ7kNvwEZ69HR&_nc_oc=AdotWo2vFQkixLdsfVFw0ZU8ayLHDBxE2RHXYosi5Fc7N-zx-PzhMJG4vlB_fetBOV4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0KPTzzNzvyOjCse10h9pIUD8OOeSQb9xmO4NildHGtA&oe=6A296E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "store_art_ggp_screenshot4.png", "id": "352113654090292", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031462_352113657423625_7192351234712908151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SW_gx-oYFpMQ7kNvwHSxW3H&_nc_oc=AdpK4KyZrz8ylNgT78FnxfKvtgEdJ8SnjWPIt5hLhjFiQFsw5ICoswOicAxd1DScamU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5GRksXnsu_RF5nZ0G3AwC7Dr6wc1z17Qb9asbq-V70A&oe=6A29646B"}, "display_name": "Gedrag: (G)een Probleem - Extended", "keywords": [], "long_description": "Deze ervaring is ontworpen als een trainingsinstrument voor professionals in ouderenzorg om een dieper begrip te krijgen van gedragssymptomen bij pati\u00ebnten met dementie. De ervaring ondersteunt bij de ontwikkeling van empathie en het verbeteren van communicatievaardigheden.\n\nOntwikkeld door het voormalige Leiden University Centre for Innovation in samenwerking met opleidingsprogramma\u2019s aan het Leids Universitair Medisch Centrum (LUMC), biedt de app \"Gedrag: (G)een Probleem\" een reis in de wereld van pati\u00ebnten met dementie. \n\nDe nieuwste versie van de app is verrijkt en uitgebreid door het Leiden Learning and Innovation Centre in samenwerking met Zorg4Effect dankzij de genereuze subsidie en (financi\u00eble) bijdragen van diverse organisaties en fondsen. Deze ontwikkeling werd mogelijk gemaakt door:\n\nGemeente Leiden\nJo Visser fonds\nPleindoneren Stichting Else\nProject SIVIL ZonMW\nTransitiegelden van zorgkantoor Zorg en Zekerheid en Zorg4Effect", "short_description": "Deze ervaring is ontworpen als een trainingsinstrument voor professionals in ouderenzorg om een dieper begrip te krijgen van gedragssymptomen bij pati\u00ebnten met dementie. De ervaring ondersteunt bij de ontwikkeling van empathie en het verbeteren van communicatievaardigheden."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.leidenlearninginnovation.org/about/privacy-policy-gedrag-geen-probleem-extended/", "developer_terms_of_service_url": null, "publisher_name": "Leiden University", "support_website_url": null, "website_url": "https://www.leidenlearninginnovation.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
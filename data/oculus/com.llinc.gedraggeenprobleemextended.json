001670_734411291919571_3088972122069262667_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cB2MzJY0-LEQ7kNvwF3bWV7&_nc_oc=AdkCarjyULemczOKagnoW6qoGImcd7ofr4mseKLONykLNLkbKwPUiENcOdrVDS2xCS8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftTHo5AxmCZn8Bw-j1J0t76dcYi-5pRe4H1s28EHT_vlw&oe=69A2E873"}, {"file_name": "store_art_ggp_screenshot4.png", "id": "194145350441702", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974893_194145353775035_6888814130813287519_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvEfqPWccasQ7kNvwHqXxUL&_nc_oc=AdmJjZcgtiuLOEBUkO78ieyC-tif3G3NcmDx_NMTX3gwLZG73vzRYffLelKU7Xkycuk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftnaUCOlg0H9WbyyS20jnhnwXCG_71t_lGJp2SjMR_zoQ&oe=69A2F9F1"}, {"file_name": "store_art_ggp_screenshot1.png", "id": "1395217758060028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75507165_1395217761393361_4721445420427429208_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nONfNYARqD8Q7kNvwHUaydZ&_nc_oc=AdkZll1zyoixpuyMr4enZ43y-PyJ_RI24QqaENUQM80b-y9zKk3V30VdhOrpl8VpAoo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaOxSqfY7YXpv-19zbeYFEWO2F6K1Ssy7UjLsieGBSjw&oe=69A2F557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "store_art_ggp_screenshot4.png", "id": "352113654090292", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031462_352113657423625_7192351234712908151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHU-Yg4hSdoQ7kNvwElMSne&_nc_oc=AdnLJ40VCoRSidV_w7k4uRKYdAqWbhS4Rho7O5PvI91PQTmMg50QgjvJJvDjjLmaQg4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftXMAR7I7ZlcemX9Spz28TOdKWNPNonbeNocsOt-2Lg7w&oe=69A2EB6B"}, "display_name": "Gedrag: (G)een Probleem - Extended", "keywords": [], "long_description": "Deze ervaring is ontworpen als een trainingsinstrument voor professionals in ouderenzorg om een dieper begrip te krijgen van gedragssymptomen bij pati\u00ebnten met dementie. De ervaring ondersteunt bij de ontwikkeling van empathie en het verbeteren van communicatievaardigheden.\n\nOntwikkeld door het voormalige Leiden University Centre for Innovation in samenwerking met opleidingsprogramma\u2019s aan het Leids Universitair Medisch Centrum (LUMC), biedt de app \"Gedrag: (G)een Probleem\" een reis in de wereld van pati\u00ebnten met dementie. \n\nDe nieuwste versie van de app is verrijkt en uitgebreid door het Leiden Learning and Innovation Centre in samenwerking met Zorg4Effect dankzij de genereuze subsidie en (financi\u00eble) bijdragen van diverse organisaties en fondsen. Deze ontwikkeling werd mogelijk gemaakt door:\n\nGemeente Leiden\nJo Visser fonds\nPleindoneren Stichting Else\nProject SIVIL ZonMW\nTransitiegelden van zorgkantoor Zorg en Zekerheid en Zorg4Effect", "short_description": "Deze ervaring is ontworpen als een trainingsinstrument voor professionals in ouderenzorg om een dieper begrip te krijgen van gedragssymptomen bij pati\u00ebnten met dementie. De ervaring ondersteunt bij de ontwikkeling van empathie en het verbeteren van communicatievaardigheden."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.leidenlearninginnovation.org/about/privacy-policy-gedrag-geen-probleem-extended/", "developer_terms_of_service_url": null, "publisher_name": "Leiden University", "support_website_url": null, "website_url": "https://www.leidenlearninginnovation.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["nl"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [
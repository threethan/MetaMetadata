ore_art_ggp_screenshot3.png", "id": "734411288586238", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001670_734411291919571_3088972122069262667_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gazQ-fY_waoQ7kNvwF1E7ok&_nc_oc=AdoRSiTz0h4U5v8xbIx7eisT34Ibk-JV3qzIVXTzF9m_ZN-mu_pOe6U5NEoCu4MSIjs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IJh-td8rFV-gscUss1hnkH8l5YSXhWhRdJTqtLv-b9w&oe=6A1D83F3"}, {"file_name": "store_art_ggp_screenshot4.png", "id": "194145350441702", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974893_194145353775035_6888814130813287519_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=phkqzbD35ZcQ7kNvwH6X68q&_nc_oc=AdoLhY5atKxPELkrEmSwIfyohlVieT-Smutqrqf7H9n94GWXK1jW4q4BR1kL2wRIWPo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xFd8x7JG8LuFGChQbM8nbioxlYv1e_NZy2huv5FBzTw&oe=6A1D9571"}, {"file_name": "store_art_ggp_screenshot1.png", "id": "1395217758060028", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75507165_1395217761393361_4721445420427429208_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPjFIYm7mEoQ7kNvwFBo4Nk&_nc_oc=Adrjxqzp-WKX1qTTSPx4Lrbx1dENL7qnmaYMWShDTgPeXfDWwnd56bSNvxHHx7cW8Sc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RnrKWBXBkO3AxjPMXeNzkHfidu39jmWpG41XoY_e8cw&oe=6A1D90D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "store_art_ggp_screenshot4.png", "id": "352113654090292", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031462_352113657423625_7192351234712908151_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4pKY94zWGoQ7kNvwGj7t8c&_nc_oc=AdoMutZxXLNmKvSqH8AkzI838cnCSEzYgGDezNJn9PVZkhv9yHSmvWCpoFNKKJHj2Zg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eatn9pvJdAdeNVA7cPf9nnOGJiRch7GH-O4EFwDtAtA&oe=6A1D86EB"}, "display_name": "Gedrag: (G)een Probleem - Extended", "keywords": [], "long_description": "Deze ervaring is ontworpen als een trainingsinstrument voor professionals in ouderenzorg om een dieper begrip te krijgen van gedragssymptomen bij pati\u00ebnten met dementie. De ervaring ondersteunt bij de ontwikkeling van empathie en het verbeteren van communicatievaardigheden.\n\nOntwikkeld door het voormalige Leiden University Centre for Innovation in samenwerking met opleidingsprogramma\u2019s aan het Leids Universitair Medisch Centrum (LUMC), biedt de app \"Gedrag: (G)een Probleem\" een reis in de wereld van pati\u00ebnten met dementie. \n\nDe nieuwste versie van de app is verrijkt en uitgebreid door het Leiden Learning and Innovation Centre in samenwerking met Zorg4Effect dankzij de genereuze subsidie en (financi\u00eble) bijdragen van diverse organisaties en fondsen. Deze ontwikkeling werd mogelijk gemaakt door:\n\nGemeente Leiden\nJo Visser fonds\nPleindoneren Stichting Else\nProject SIVIL ZonMW\nTransitiegelden van zorgkantoor Zorg en Zekerheid en Zorg4Effect", "short_description": "Deze ervaring is ontworpen als een trainingsinstrument voor professionals in ouderenzorg om een dieper begrip te krijgen van gedragssymptomen bij pati\u00ebnten met dementie. De ervaring ondersteunt bij de ontwikkeling van empathie en het verbeteren van communicatievaardigheden."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.leidenlearninginnovation.org/about/privacy-policy-gedrag-geen-probleem-extended/", "developer_terms_of_service_url": null, "publisher_name": "Leiden University", "support_website_url": null, "website_url": "https://www.leidenlearninginnovation.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "27362927396627898"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "support
LO7z-R1Cf1dTEt6_xybQCA8U4cvJ-xPM-v73ncAk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQKJWrpNywsfdRYc0H39lAdEc3ZiG44O9VenwGs0GM9g&oe=69A2D91B"}, {"file_name": "Meta_Quest_Images_Loto (2) (1).png", "id": "1679126249472749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_1679126252806082_6824214294050728443_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbMAx6SobJIQ7kNvwGNPV9a&_nc_oc=AdkdDJXEGUhf7GftLhFJaXhM5ykmXy4ceGyk2OfpKeUSDfGIJgQDPYkLqTUoiOnSmps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfspQvL_x35yw8kVNYI3vAR_SCikk2F1XNN4vjuf4AUx4Q&oe=69A2E1A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atom", "keywords": [], "long_description": "Imaginate's Atom platform enables geographically dispersed teams to collaborate securely over contextual 2D/3D data. \n\nEquipped with the ability to visualize, interact and converse using this data like never before, teams can now quickly and confidently finalize designs, train, sell and generally interact better. \n\nSo, get set and come on board for a new era of enterprise collaboration!\n\nNOTE: PLEASE NOTE THAT YOU WILL NOT BE ABLE TO SIGN IN UNLESS YOU HAVE AN ACTIVE LICENSE AND REGISTERED USERS WITH US. PLEASE GET IN TOUCH WITH US AT info@imaginate.in FOR ANY QUERIES.", "short_description": "Atom is a multi-user platform (for VR and AR, both) where geographically dispersed teams can collaborate for training sessions, meetings, design reviews, assisted sales and a lot more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.imaginate.in/Privacy-Policy-5b2d0e402c314cb8bba29201847c197e", "developer_terms_of_service_url": null, "publisher_name": "Imaginate Software Labs Pvt. Ltd.", "support_website_url": null, "website_url": "https://imaginate.in/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "106
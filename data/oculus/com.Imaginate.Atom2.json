cQwMMXl-8RU9rh5Un2R84YC0MEI7HQ604-IsXovOTw&oe=6B09BE9E"}, {"file_name": "Meta_Quest_Images_Indus (1) (1).png", "id": "1853506105510496", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_1853506112177162_8065152674391810187_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK2w3H2HNmoQ7kNvwGgs7ff&_nc_oc=Adqq89WeF--lN--3BTcRY5N03afL6_3RE5mV-grcZ_ZDz6hvwu-3BnZ91DZ31V2VH0M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWfdwwcb6Yi5tkmXHQPaGAyQRmB6RPfTYhdop8gKDl2A&oe=6B09A95B"}, {"file_name": "Meta_Quest_Images_Loto (2) (1).png", "id": "1679126249472749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618440_1679126252806082_6824214294050728443_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GawF8-kHwsQ7kNvwE_jqgO&_nc_oc=AdqBuaTNmAntVwz22PSsBmM3X2Fg3OoEBfgaSYMd4al1aIi3lJeTVrMg-5tZ7WjRx1Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6JWkZYCRiOFoP4UoJhZni1PiCMVFWjQkrvRdHHozUJw&oe=6B09B1E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atom", "keywords": [], "long_description": "Imaginate's Atom platform enables geographically dispersed teams to collaborate securely over contextual 2D/3D data. \n\nEquipped with the ability to visualize, interact and converse using this data like never before, teams can now quickly and confidently finalize designs, train, sell and generally interact better. \n\nSo, get set and come on board for a new era of enterprise collaboration!\n\nNOTE: PLEASE NOTE THAT YOU WILL NOT BE ABLE TO SIGN IN UNLESS YOU HAVE AN ACTIVE LICENSE AND REGISTERED USERS WITH US. PLEASE GET IN TOUCH WITH US AT info@imaginate.in FOR ANY QUERIES.", "short_description": "Atom is a multi-user platform (for VR and AR, both) where geographically dispersed teams can collaborate for training sessions, meetings, design reviews, assisted sales and a lot more."}]}, "developer_name": null, "developer_privacy_policy_url":
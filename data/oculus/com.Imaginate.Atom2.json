qQbqUKY99a2obNF3E1VfnlLHKw3e004znxIeEd5AVw&oe=6B03271E"}, {"file_name": "Meta_Quest_Images_Indus (1) (1).png", "id": "1853506105510496", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622285_1853506112177162_8065152674391810187_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jPR7ihpwekQ7kNvwHHrp4c&_nc_oc=AdpNZWaoEWPs5yn3aiPbWnflr2Ft1foKGlZxZwpwj7CJAnHJ2h4AVIJdQd5TIF9BGlQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVXFfOLNlIXjGQGl9qf0viGOr5hL6YX7pBk9bZ9lg1oA&oe=6B0311DB"}, {"file_name": "Meta_Quest_Images_Loto (2) (1).png", "id": "1679126249472749", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618440_1679126252806082_6824214294050728443_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=siC0Git8sAEQ7kNvwFYSGJH&_nc_oc=Adr1uBsqnLVOwNKGH8hG9iwZgfwF_IHToZSMmVn39PWioQZpKMhAUKOf-pjxOmfvwKk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqdjUX7JrcnlbMs6TSrlUFn-Vnmj1Z_SztfB6ToXMOqw&oe=6B031A62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atom", "keywords": [], "long_description": "Imaginate's Atom platform enables geographically dispersed teams to collaborate securely over contextual 2D/3D data. \n\nEquipped with the ability to visualize, interact and converse using this data like never before, teams can now quickly and confidently finalize designs, train, sell and generally interact better. \n\nSo, get set and come on board for a new era of enterprise collaboration!\n\nNOTE: PLEASE NOTE THAT YOU WILL NOT BE ABLE TO SIGN IN UNLESS YOU HAVE AN ACTIVE LICENSE AND REGISTERED USERS WITH US. PLEASE GET IN TOUCH WITH US AT info@imaginate.in FOR ANY QUERIES.", "short_description": "Atom is a multi-user platform (for VR and AR, both) where geographically dispersed teams can collaborate for training sessions, meetings, design reviews, assisted sales and a lot more."}]}, "developer_name": null, "developer_privacy_policy_url":
M3J-1qXgGUJ_pLAm_wt1xiW3_RwvvwfTjEWpwDcR-g&oe=6B0C619E"}, {"file_name": "Meta_Quest_Images_Indus (1) (1).png", "id": "1853506105510496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622285_1853506112177162_8065152674391810187_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK2w3H2HNmoQ7kNvwHNVuJ2&_nc_oc=AdqSD3s5ZSVpTHpyVIiffWoB_rONih6eYOmTjgbmzGJlEprVP9uRMnZl1Juxo1XKy9o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrtqjGLsVkPLJrh0Vh0f3mGzDGgnJSeIa1y0u74IPzbg&oe=6B0C849B"}, {"file_name": "Meta_Quest_Images_Loto (2) (1).png", "id": "1679126249472749", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618440_1679126252806082_6824214294050728443_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GawF8-kHwsQ7kNvwGJkLM9&_nc_oc=Ado6JRCcGPrU4rocMnhxpB6E_DHmQmaHN1C0yzdWpkY3ZQpd7ioANsqL-1KgQ5ma6Hs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQARzyqAYLEwSCYZoTplNWNdb7teIwhxpiPx4LBAcTT5A&oe=6B0C54E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atom", "keywords": [], "long_description": "Imaginate's Atom platform enables geographically dispersed teams to collaborate securely over contextual 2D/3D data. \n\nEquipped with the ability to visualize, interact and converse using this data like never before, teams can now quickly and confidently finalize designs, train, sell and generally interact better. \n\nSo, get set and come on board for a new era of enterprise collaboration!\n\nNOTE: PLEASE NOTE THAT YOU WILL NOT BE ABLE TO SIGN IN UNLESS YOU HAVE AN ACTIVE LICENSE AND REGISTERED USERS WITH US. PLEASE GET IN TOUCH WITH US AT info@imaginate.in FOR ANY QUERIES.", "short_description": "Atom is a multi-user platform (for VR and AR, both) where geographically dispersed teams can collaborate for training sessions, meetings, design reviews, assisted sales and a lot more."}]}, "developer_name": null, "developer_privacy_policy_url":
5152674391810187_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbKCmL2tuC0Q7kNvwE4mxLz&_nc_oc=AdrrgLK2bzztz1MdXHe49YLSGHiPD66oGz9R6tfcmTRy-x6zt0SlIBHT40T0DVE81_E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DrP9QFEAunqIaP5jhpY-1QVRxEwSFP2G-BZGOhlBnZg&oe=6A395C5B"}, {"file_name": "Meta_Quest_Images_Loto (2) (1).png", "id": "1679126249472749", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499618440_1679126252806082_6824214294050728443_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lM_QnJ1yl_sQ7kNvwFtPri0&_nc_oc=AdoN-j4SBnpwZuRwfk1vVDnmGa6yfNl_eB9loLHFRy4CLCYq-R4Dj1metlCzcheyHiU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SKjn6BZe6scdTYgCdJjl8SLTJuEo-MSOxskr8DRuSVA&oe=6A392CA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atom", "keywords": [], "long_description": "Imaginate's Atom platform enables geographically dispersed teams to collaborate securely over contextual 2D/3D data. \n\nEquipped with the ability to visualize, interact and converse using this data like never before, teams can now quickly and confidently finalize designs, train, sell and generally interact better. \n\nSo, get set and come on board for a new era of enterprise collaboration!\n\nNOTE: PLEASE NOTE THAT YOU WILL NOT BE ABLE TO SIGN IN UNLESS YOU HAVE AN ACTIVE LICENSE AND REGISTERED USERS WITH US. PLEASE GET IN TOUCH WITH US AT info@imaginate.in FOR ANY QUERIES.", "short_description": "Atom is a multi-user platform (for VR and AR, both) where geographically dispersed teams can collaborate for training sessions, meetings, design reviews, assisted sales and a lot more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.imaginate.in/Privacy-Policy-5b2d0e402c314cb8bba29201847c197e", "developer_terms_of_service_url": null, "publisher_name": "Imaginate Software Labs Pvt. Ltd.", "support_website_url": null, "website_url": "https://imaginate.in/", "category": "APPS", "comfort_ratin
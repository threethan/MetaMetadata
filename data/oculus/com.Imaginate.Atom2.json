W1XRpiQk0vk1hpWWMm2fvSH_CSrR1GDt2VhAG142Wg&oe=6AFDE11E"}, {"file_name": "Meta_Quest_Images_Indus (1) (1).png", "id": "1853506105510496", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622285_1853506112177162_8065152674391810187_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5U_6sS0amwQ7kNvwE7cgUu&_nc_oc=Adr7pZ7jizRJf3AuEz0MEIANMKVthcicbP_mxrIRmdy6wWrudI45OyIcQz4XZGaQqoI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6ZQZweMcmbNxsAY2GAUndH4vmjnDtXG6pmcBNJ0If7A&oe=6AFDCBDB"}, {"file_name": "Meta_Quest_Images_Loto (2) (1).png", "id": "1679126249472749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618440_1679126252806082_6824214294050728443_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lvTL62TaK0Q7kNvwF7b9SN&_nc_oc=AdoAfgubPbkgUh31bPF6p6X6AE7CxbjClXldRqaeF6z5EilgRvB46nCnlFAtxHk4ZYE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR76rkxn6Ekt87H8GADVM15ax3Ay3YTOX5OWOmwRNXmyQ&oe=6AFDD462"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atom", "keywords": [], "long_description": "Imaginate's Atom platform enables geographically dispersed teams to collaborate securely over contextual 2D/3D data. \n\nEquipped with the ability to visualize, interact and converse using this data like never before, teams can now quickly and confidently finalize designs, train, sell and generally interact better. \n\nSo, get set and come on board for a new era of enterprise collaboration!\n\nNOTE: PLEASE NOTE THAT YOU WILL NOT BE ABLE TO SIGN IN UNLESS YOU HAVE AN ACTIVE LICENSE AND REGISTERED USERS WITH US. PLEASE GET IN TOUCH WITH US AT info@imaginate.in FOR ANY QUERIES.", "short_description": "Atom is a multi-user platform (for VR and AR, both) where geographically dispersed teams can collaborate for training sessions, meetings, design reviews, assisted sales and a lot more."}]}, "developer_name": null, "developer_privacy_policy_url":
_nc_sid=6e7a0a&_nc_ohc=GYd3OtNe07IQ7kNvwF0UF6E&_nc_oc=AdkftXBBBrLpzT6gPz5D5-O6sf9I7nF71OkxN4dfo4gF7amStiGktCID0PLjfnGElJo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsym51UbUadf7a8_-imlRCMQeCdMfQI_QEMAerXR6BjPA&oe=69A81F1B"}, {"file_name": "Meta_Quest_Images_Loto (2) (1).png", "id": "1679126249472749", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618440_1679126252806082_6824214294050728443_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcLjPZSMqbwQ7kNvwFXYtm9&_nc_oc=AdnBU6qdWQeF1xXqL04ARnfaE-zTbNX1Sfbxxd0xBDovuB1HmwEhVmIJ__RMve1oyQs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuCjAoifQ4w6JYEesqq4w2tyuKRglqi25aiMAw6Zdf1ZQ&oe=69A827A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Atom", "keywords": [], "long_description": "Imaginate's Atom platform enables geographically dispersed teams to collaborate securely over contextual 2D/3D data. \n\nEquipped with the ability to visualize, interact and converse using this data like never before, teams can now quickly and confidently finalize designs, train, sell and generally interact better. \n\nSo, get set and come on board for a new era of enterprise collaboration!\n\nNOTE: PLEASE NOTE THAT YOU WILL NOT BE ABLE TO SIGN IN UNLESS YOU HAVE AN ACTIVE LICENSE AND REGISTERED USERS WITH US. PLEASE GET IN TOUCH WITH US AT info@imaginate.in FOR ANY QUERIES.", "short_description": "Atom is a multi-user platform (for VR and AR, both) where geographically dispersed teams can collaborate for training sessions, meetings, design reviews, assisted sales and a lot more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.imaginate.in/Privacy-Policy-5b2d0e402c314cb8bba29201847c197e", "developer_terms_of_service_url": null, "publisher_name": "Imaginate Software Labs Pvt. Ltd.", "support_website_url": null, "website_url": "https://imaginate.in/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "conte
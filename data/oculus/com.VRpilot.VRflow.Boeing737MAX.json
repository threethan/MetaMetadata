dII6Zq3CQzi8xE7UsEdRy_A&oe=6AF5DAB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-09-28-16h08m43s021.png", "id": "1226519034858948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_1226519041525614_8918552452878481947_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owsh9eIoDDUQ7kNvwFzZeAX&_nc_oc=AdqT0I-HA8ntUEaollCh_vHeIJr0UYKPnMUMwAmHPs6gK-2HqHFZfWwmpSSF7d-zIQQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-OdAXnMT5dN4qqdOWoOC9q01RXFE8s8utZPn3j8wlJA&oe=6AF5E89F"}, "display_name": "VRflow B737MAX", "keywords": [], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow B737MAX is the interactive cockpit procedure trainer for pilots. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for type ratings. Train with or without visual help, track your errors, see your training time, train with an automatic crewmember and much more.\n\n14 normal procedures and 3 emergency/abonormal procedures are included with dynamic checklists, step by step explanations and task sharing with the automatic crew member.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow B737MAX is the interactive cockpit procedure trainer for pilots, used by airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their initial or recurring type rating training.\n\nThe individual/student version does not include multi-crew functionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/pr
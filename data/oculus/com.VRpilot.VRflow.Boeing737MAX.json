-1.oculuscdn.com/v/t64.5771-25/39036604_406408761483675_8005089195908243510_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUmB5eg7r9sQ7kNvwHk_JUm&_nc_oc=Adr_mHrwldCZQOktBVOqPduNXBMqxhQnclwFDSCGPiOmeVdonvERXlWwQ5FoghKuWdI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtF_rrG_WzBp49PCm6mMpgNT9xBOKnmU4xDx0uXH6rjA&oe=6AFC7230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-09-28-16h08m43s021.png", "id": "1226519034858948", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974699_1226519041525614_8918552452878481947_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6dWid8YgwsQ7kNvwHIbVgA&_nc_oc=AdqrXqVljc79T4zDqlDdNgMTv7oBjCKC5h0KkLHD4_gHavq4azWFatz8lhbURZlcIVU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm6NnNDr9tBYWBrq2HVIZ94jEcVjZAZqTaT_V5t0O4gQ&oe=6AFC801F"}, "display_name": "VRflow B737MAX", "keywords": [], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow B737MAX is the interactive cockpit procedure trainer for pilots. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for type ratings. Train with or without visual help, track your errors, see your training time, train with an automatic crewmember and much more.\n\n14 normal procedures and 3 emergency/abonormal procedures are included with dynamic checklists, step by step explanations and task sharing with the automatic crew member.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow B737MAX is the interactive cockpit procedure trainer for pilots, used by airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their initial or recurring type rating training.\n\nThe individual/student version does not include multi-crew functionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FLYING", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2174237116090898"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "807104040551657"}]}, "baseline_offer": {"id": "807104040551657"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1667422200, "status": "PUBLISHED", "id": "807104040551657"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26318460194500007", "version": "1.06"}, "id": "804821160645443", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5093585460747455", "is_concept": false, "latest_released_binary": {"__typenam
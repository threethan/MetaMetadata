-1.oculuscdn.com/v/t64.5771-25/39036604_406408761483675_8005089195908243510_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0s5TDtURmQQ7kNvwEG7uJu&_nc_oc=Ado1Z4ko8V1PtJyUqoeshFoPqE4nn53OyXkUn60TKR4u7g_jhB33OfQNxyz37ymF-i0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXGJtVPj5FM_xHxfTHcE6VSnmSYN_z2lx_MHMq_zQJR5Q&oe=6B0F1F70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "vlcsnap-2022-09-28-16h08m43s021.png", "id": "1226519034858948", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974699_1226519041525614_8918552452878481947_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXBp2_3AOWoQ7kNvwEIuUzX&_nc_oc=Adqg8shzbqUkQbKdK88Y9zGO1LdC7s9YFGMDDFdKn9XtXavF-PyjQ5RgrretEszrs0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWLuZAMIVPVp972BgBDOLGykeyyHYfPF0A-0_a1moR-pA&oe=6B0EF51F"}, "display_name": "VRflow B737MAX", "keywords": [], "long_description": "- This is the individual/student version of VRflow -\n\nVRflow B737MAX is the interactive cockpit procedure trainer for pilots. Train procedures in training scenarios that incorporate detailed aircraft behavior including sounds, instruments and cockpit layout.\n\nVRflow incorporates numerous features for efficient learning and aircraft familiarization, ideal for type ratings. Train with or without visual help, track your errors, see your training time, train with an automatic crewmember and much more.\n\n14 normal procedures and 3 emergency/abonormal procedures are included with dynamic checklists, step by step explanations and task sharing with the automatic crew member.\n\nVRflow also contains Explore Mode, where you can explore the cockpit and learn about systems.\n\nThe individual/student version does not include multi-crew functionality.", "short_description": "- This is the individual/student version of VRflow -\n\nVRflow B737MAX is the interactive cockpit procedure trainer for pilots, used by airlines worldwide. The app incorporates advanced VR learning technologies, making it an extremely efficient learning and training tool for pilots doing their initial or recurring type rating training.\n\nThe individual/student version does not include multi-crew functionality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrpilot.aero/privacy", "developer_terms_of_service_url": "https://vrpilot.aero/terms-of-service/", "publisher_name": "VRpilot", "support_website_url": null, "website_url": "https://vrpilot.aero/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "FLYING", "UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2174237116090898"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "807104040551657"}]}, "baseline_offer": {"id": "807104040551657"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1667422200, "status": "PUBLISHED", "id": "807104040551657"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26318460194500007", "version": "1.06"}, "id": "804821160645443", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5093585460747455", "is_concept": false, "latest_released_binary": {"__typenam
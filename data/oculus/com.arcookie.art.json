4_628861989672906361_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMiS7Grm2dwQ7kNvwHCq_qy&_nc_oc=AdoYfMLU8wefGNXHz-LltculXoj-9LDPCQlqXuTUdY1xNlN8KqDmt4KcObP1CsfO64o&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwsHKOFfAawL1yaGdfMgyKrlyB5A0LzMXD-mgprDK1Wg&oe=6A9184A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "arcookie", "keywords": ["3Dcontent", "ARart", "virtualExhibition", "immersiveArt", "artViewer"], "long_description": "ARCOOKIE Viewer is a free Meta Quest app for experiencing AR art exhibitions and immersive 3D content.\n\nWith ARCOOKIE Viewer, users can explore selected AR artworks and 3D scenes prepared through the ARCOOKIE platform. After launching the app, users can move through the space and approach visual nodes to load and view AR art content in an immersive environment.\n\nThis version is designed as a viewer app for AR art and 3D content experiences. It does not include paid features, in-app purchases, advertising, or user-generated content submission.\n\nA Wi-Fi connection is required. For the best experience, we recommend using the app in a clear, obstacle-free indoor area with a supported Meta Quest device.", "short_description": "A free Meta Quest viewer for experiencing AR art exhibitions and immersive 3D content created with ARCOOKIE."}]}, "developer_name": "Youngcheol Seo", "developer_privacy_policy_url": "https://arcookie.com/en/%ea%b0%9c%ec%9d%b8%ec%a0%95%eb%b3%b4%ec%b2%98%eb%a6%ac%eb%b0%a9%ec%b9%a8-2/", "developer_terms_of_service_url": null, "publisher_name": "Youngcheol Seo", "support_website_url": "https://arcookie.com/en/contact-2/", "website_url": "https://arcookie.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NO
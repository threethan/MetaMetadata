6_4234215296519903571_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=blZ1o4T6x8oQ7kNvwGM9qv3&_nc_oc=Adrff9DtYKLFZ7wedZr2-w5rJkCFWqjtLsYuFlFRgFVmecrJjFuO4WJu-AcVuOVDJew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64MqE6ctnmY3T6AZvqcaU5jweMZNi_W6cQYYJnLZKNBA&oe=6A033995"}, {"file_name": "0004.png", "id": "1712521283282359", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_1712521286615692_5090021113885887629_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=doBbc0jRCpcQ7kNvwEEHNd-&_nc_oc=AdoYIzQr4E6uxMjHh1CmAEYXv7Es2OEdwE4zRConNaTX12k5apKufUoEC_1ORQAeTaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eWl4OoS19R4pBvLw9Xlcla3-OH5SUZwKYuAyXb8Il_Q&oe=6A034B2B"}, {"file_name": "0005.png", "id": "951297754282321", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499297170_951297757615654_628861989672906361_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO_dKQMQwEcQ7kNvwEU9VTM&_nc_oc=AdrA87duhZ7uj-8oWWBOqtuAiRkZSVlRSk8mH1GHfPboe27H-9HuT-u8HSeDagAg6qQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UqI77XdfKaBOjyBmHo_NlgiRdJn6mS0NfTx1oztOKOg&oe=6A0322A9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ARCOOKIE Viewer", "keywords": ["3Dcontent", "ARart", "virtualExhibition", "immersiveArt", "artViewer"], "long_description": "ARCOOKIE Viewer is a free Meta Quest app for experiencing AR art exhibitions and immersive 3D content.\n\nWith ARCOOKIE Viewer, users can explore selected AR artworks and 3D scenes prepared through the ARCOOKIE platform. After launching the app, users can move through the space and approach visual nodes to load and view AR art content in an immersive environment.\n\nThis version is designed as a viewer app for AR art and 3D content experiences. It does not include paid features, in-app purchases, advertising, or user-generated content submission.\n\nA Wi-Fi connection is required. For the best experience, we recommend using the app in a clear, obstacle-free indoor area with a supported Meta Quest device.", "short_description": "A free Meta Quest viewer for experiencing AR art exhibitions and immersive 3D content created with ARCOOKIE."}]}, "developer_name": "Youngcheol Seo", "developer_privacy_policy_url": "https://arcookie.com/en/%ea%b0%9c%ec%9d%b8%ec%a0%95%eb%b3%b4%ec%b2%98%eb%a6%ac%eb%b0%a9%ec%b9%a8-2/", "developer_terms_of_service_url": null, "publisher_name": "Youngcheol Seo", "support_website_url": "https://arcookie.com/en/contact-2/", "website_url": "https://arcookie.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26489304950708153"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1296223185369364"}]}, "baseline_offer": {"id": "1296223185369364"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778109660, "status": "PUBLISHED", "id": "1296223185369364"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26615719164733397", "version": "1.0.1"}, "id": "1620052505960983", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26489304927374822", "is_concept": false, "
Q7kNvwE87sD_&_nc_oc=Adr1O3SrEp8E01t5MmNfDjloL5k5OIIxiBlAtxb22XwKmXSonh2FCwz3be2bfQX0VMg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj9sXQGcbOgQTBv2DXNhP0iWc96pgrMIjxT8W2FKmI6w&oe=6A7DBE29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "arcookie", "keywords": ["3Dcontent", "ARart", "virtualExhibition", "immersiveArt", "artViewer"], "long_description": "ARCOOKIE Viewer is a free Meta Quest app for experiencing AR art exhibitions and immersive 3D content.\n\nWith ARCOOKIE Viewer, users can explore selected AR artworks and 3D scenes prepared through the ARCOOKIE platform. After launching the app, users can move through the space and approach visual nodes to load and view AR art content in an immersive environment.\n\nThis version is designed as a viewer app for AR art and 3D content experiences. It does not include paid features, in-app purchases, advertising, or user-generated content submission.\n\nA Wi-Fi connection is required. For the best experience, we recommend using the app in a clear, obstacle-free indoor area with a supported Meta Quest device.", "short_description": "A free Meta Quest viewer for experiencing AR art exhibitions and immersive 3D content created with ARCOOKIE."}]}, "developer_name": "Youngcheol Seo", "developer_privacy_policy_url": "https://arcookie.com/en/%ea%b0%9c%ec%9d%b8%ec%a0%95%eb%b3%b4%ec%b2%98%eb%a6%ac%eb%b0%a9%ec%b9%a8-2/", "developer_terms_of_service_url": null, "publisher_name": "Youngcheol Seo", "support_website_url": "https://arcookie.com/en/contact-2/", "website_url": "https://arcookie.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_mem
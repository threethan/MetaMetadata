6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXjtf-2rx4Le39NZ4-zCgVlGgkWDiBvKBCgekvF7bSeVg&oe=6B0EEBAB"}, {"file_name": "0005.png", "id": "951297754282321", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297170_951297757615654_628861989672906361_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19JZoOHDUoUQ7kNvwEOpH_x&_nc_oc=AdoapocvnMSuji8Zm3TLjBjFstdmlI75em2YBDRqljMkLaVPzLjN8irTr0cdEyVbkE4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUf_VDrRiqEzrC3pe1pb6LeBfp7i24_9SzVTSbT325D1Q&oe=6B0EFB69"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "arcookie", "keywords": ["3Dcontent", "ARart", "virtualExhibition", "immersiveArt", "artViewer"], "long_description": "ARCOOKIE Viewer is a free Meta Quest app for experiencing AR art exhibitions and immersive 3D content.\n\nWith ARCOOKIE Viewer, users can explore selected AR artworks and 3D scenes prepared through the ARCOOKIE platform. After launching the app, users can move through the space and approach visual nodes to load and view AR art content in an immersive environment.\n\nThis version is designed as a viewer app for AR art and 3D content experiences. It does not include paid features, in-app purchases, advertising, or user-generated content submission.\n\nA Wi-Fi connection is required. For the best experience, we recommend using the app in a clear, obstacle-free indoor area with a supported Meta Quest device.", "short_description": "A free Meta Quest viewer for experiencing AR art exhibitions and immersive 3D content created with ARCOOKIE."}]}, "developer_name": "Youngcheol Seo", "developer_privacy_policy_url": "https://arcookie.com/en/%ea%b0%9c%ec%9d%b8%ec%a0%95%eb%b3%b4%ec%b2%98%eb%a6%ac%eb%b0%a9%ec%b9%a8-2/", "developer_terms_of_service_url": null, "publisher_name": "Youngcheol Seo", "support_website_url": "https://arcookie.com/en/contact-2/", "website_url": "https://arcookie.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR
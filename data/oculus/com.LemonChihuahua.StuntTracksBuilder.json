ILhmnst9PNvjvqtzwfJ5tf6s-3JqXf0u6WxtnGnzw3Rptbod6mUYrkugr_y_rk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwNTgHVDJlDCNdSLvxQSwpbnTeo1dVpVR2r4k0hIyybuQ&oe=69BBDE67"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlQk0R0R-9MQ7kNvwE4Ti3Y&_nc_oc=Adn508hWMe3_aKvVUGqIpDbBrXBT52lQQoI7fWA6XluabF4-ScAH7fw_eQD-o0H7lLY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxP-_vnKg3m3eLAmXfPRKv9OhdcBnRM6QXKVK4RK4qTMw&oe=69BBDB4B"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSJa2ILKe9gQ7kNvwHFKE3r&_nc_oc=AdlKtt-MeTGAM3o_ZYXyR6RVcNr7QHdkiJ7qdRUpK702ILGF8amko69NdrwIcNDZ9kI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyddSOQ5D0VwVClFM7nCxufMXH1B4QOZHp-TtEWJQNUnQ&oe=69BBF9D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpZ5WFSQqmYQ7kNvwHT2yap&_nc_oc=Adl1wt9rClCR9FxDjO8V7zpX_-ZtSFRyOuSmR_fJ7jVmWRIGNE84yr-eUT6CM3bgAJU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzHf7_noi46rx_1ZL1RwPPe1WeWLbIP8JCnAiqvFZVjzA&oe=69BBEB40"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46sgT3PkaGMQ7kNvwH8NF_D&_nc_oc=AdklwWodjMD92p9TEhz4tHbRH4hbY8AARzta1TAYiEgqEU_qC-6XMyDHchOhD1GVi9w&_nc_zt=3&_nc_ht=sc
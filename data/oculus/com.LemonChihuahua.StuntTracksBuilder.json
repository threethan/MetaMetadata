m4Ojb9TWgxY5xLVX6hBaeKBP7_ZQjfqFzQMwpT_dh3c3rNKDD_jHm1RMEjJP8A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy1t-QPyMniO_-7i6aD9U2PzW6JsZsxoPZWKy2soKY1ew&oe=69BD2FE7"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlQk0R0R-9MQ7kNvwFpnWMS&_nc_oc=Adm8MXFQtht0_74HulWdlsP-oAI4c4xdfRm7-xnQVFUlr1BqavrkA12jxBlaHzrQyiI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTJgxykxDf1iSlqDj1UU4knhlgDx9Wp3J1R7lkUtwXmA&oe=69BD2CCB"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSJa2ILKe9gQ7kNvwGJzBh1&_nc_oc=AdnTtOFS5EpjY8V-nk5KVprH4Lgf4PkR3VudegWtFezadjHsialBdJEmE6kOkGJhPZQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSvSo513lCRFRNyYcNA607N4bF7vilxsZsziCdRhI_qg&oe=69BD4B54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpZ5WFSQqmYQ7kNvwGEeTsv&_nc_oc=AdnIt_Ouvy1Pw3jXWtJrPhXXfVxai57ObhyMLfeJ_Peb0OnN4Dl4H8eZmXZ2IU7RY_0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzsUw6Hix9YVHaIJoeLs1yecxySV-cn22D6W8Qz94ydeQ&oe=69BD3CC0"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46sgT3PkaGMQ7kNvwGq78Pv&_nc_oc=Adlx8n4cuP4vNQ_c0ZxDEDnECGi2mEWIdjZ5hkHMTjtzZqrSUExGf-eN_sY4x4THGxE&_nc_zt=3&_nc_ht=sc
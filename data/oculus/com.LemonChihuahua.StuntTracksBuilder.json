BKPi5OBsqBkQ7kNvwFDVmK0&_nc_oc=Adq5IVMf3Q_9DuRLuFWwvN9hCVaT-NMu95t1omLyfiv2sIcKABXGTguGR6Dat3cQgwI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEp1zXRurPdBaB6YMfNPYKxkBkP4k_Wym58BjsgXWzng&oe=69C275E7"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vbxOqRq56MQ7kNvwHbySVq&_nc_oc=AdogGgC410mhqSEehf31IsqnTEvKLh3FSzdQBGRXhAYh26x2yJsDODOYbpLZCfvfVIg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3JGDu4S2Y8heFjBbJHuIlM14UFGCCfhb7AOPbBPi1ZA&oe=69C272CB"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOWa3t52PVUQ7kNvwFxmHqB&_nc_oc=Adp8ZGaXQFhVbnsLdNtJ3S48q5LuotbuqKgha6ZeHXg1OrxeVypiyxAA4pjk6pBJA0k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyN8dkqg0ynMFm5RDSrTEOq1kGpkmaDNGU1zAyrKTQulQ&oe=69C29154"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MbDagAxxD9QQ7kNvwHILlX9&_nc_oc=AdoDsLvP1AGZJHwZMYryId7UXrH7iBACQlvn3z2kBZmjddllBAVW9Faqt5Xdb_iqTog&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPW3DCh-guff7u1L5bfRE_VqbFDfU5ZstSAyiJVpy0Kg&oe=69C282C0"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSQz-oD1S8EQ7kNvwFLbO-9&_nc_oc=AdrhaxU0sU3hmitagvBjTK3xmRbQvbOdTf
ontent-iad3-1.oculuscdn.com&oh=00_Af2KOvezpyTBOumGT_IDQudrZcjg9Mqzig9_PDnymYVClw&oe=69F09A67"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiCF0w2ynQoQ7kNvwH8Fg_Z&_nc_oc=AdqIEcK-GsvKHJLiLaLJfcwMu3NdwpqBJe7T89Xe6xzOX-BkEN7PmNhZGJW3wz8SPNo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0o9Xr90aFxlRBIx-vsVkt4Qdq3quRxxAr1XRtK_TbG9w&oe=69F0CF8B"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVoGig4sZJcQ7kNvwH16zed&_nc_oc=AdoUwkK6DA08IgrBZzXaPYK6zV-EKd2XkOeK1WGRIFg6Oamr-toivx64Q-m9W8j-kKs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1oM8mXxcmI_ryzMTrx3Ob4fJmPkvqOBLspcdn9yT04tA&oe=69F0B5D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASQTmwDMXO0Q7kNvwHVnoYR&_nc_oc=AdoBplTGfVpcIdQXWE0rrjt7vutrkgur5S6Ru2CXBxijFNbRGZVfPxyddeCqrJzCv8o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1vad84nJHGxuGQc-_kJS1J0Rk9Py1xPrXCifbBCeEpgw&oe=69F0A740"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efEeRD30GJsQ7kNvwEO4zkN&_nc_oc=Adq14jFotWBDp1tjd_7n0KwPVXWLBZicdslj93DQ1UvikgrI90E7dQEbCqV3Xc6ZSok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3ARQ04dXQaxWKv0k-RtHW8V-8F79DiqcqZlQ14L2CAFg&oe=69F09A0D"}, "is_concept": false, 
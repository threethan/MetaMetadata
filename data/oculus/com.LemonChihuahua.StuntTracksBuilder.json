ontent-ord5-3.oculuscdn.com&oh=00_Afsc_mTxmx068q_hOmMjVw37Cn0JTddOXjhrehhSwLOFjg&oe=699AE8E7"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r93fkvfKLsAQ7kNvwHUPtc5&_nc_oc=AdnVmWu30sqhApIUeGlwdRYtJq27C-WIZbVSfzH9ec5M0yaC8L1CKmrU6ncoUZmrjtI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu48772Z9mO7o4p26FwHO-2V4KtmN_jYIg4aTuXnBE44Q&oe=699AE5CB"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P26wSWuS79sQ7kNvwGHLQ12&_nc_oc=AdkzWwDNzNojEHcJ1Vdc88PgFXsdzI0_zRK7btvYZPZoP3QmZ6poZxBMFVL012dU80Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftQHprLtLiaRINpPJv9_hGtEiT9qBfcpDilSZSfWrN6hA&oe=699B0454"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2k2aK1aOPcQ7kNvwFSjojX&_nc_oc=AdmAFMk7oUWtgNNMmUBdmdjuNBJtFmHNYCk3CBHXanHQ7Cp3gpNH_wrjBexsru3-X0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvhjnI1bsRkT0RkuWL0cc2t1khlCF6as09AMRY1-ac0TQ&oe=699AF5C0"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT0jwmhUSHIQ7kNvwEGVa_g&_nc_oc=Adm-ao4etXVmKjsKh12XLc3vcWrJ18AL1G5J-WcnGYD9GgWmGFOdhwK4SanwC72S2UU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsriqHwRAlz4RVgT07nF7Wpebh-wySoiImwJJA7-66Bmg&oe=699AE88D"}, "is_concept": false, 
ontent-iad3-1.oculuscdn.com&oh=00_AfsfdYea2gWl2SZF6BIDjj5CQU1TPh0TbCXTchERiYnzog&oe=69A02EE7"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmlviGPNU8wQ7kNvwFEaHy2&_nc_oc=AdnJ2Mm3A4zqFU-ZS2G4uFhMJHerMMOFTSMzApXtpsdiknMF6dtvf7bNYQugACpI9zA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfunljEFsXB5_xYYiY6vYa4qtaUPKO2cF5ABYBDqYE0UgA&oe=69A02BCB"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHzQqIPrz60Q7kNvwEUZBG1&_nc_oc=Adkri1QGtH2D303wYit34NrNfYMw2bLy0IQjAdRxDEKVjD8IaLuO2LsJolbu-Utt65I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftlQs6M1qi7ySUn1Ehd9Mc8KZa76t6_qYTgfMETwl0jtg&oe=69A04A54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPifeZmqIJwQ7kNvwGVExo7&_nc_oc=AdlrIFVZwN_0UE4MyF3DKxv6c2lg3yBlDOC4NYIsw6M9OrFxDaBjWELoJaFfngg6ayA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvUvbQ_9xP1pMKrxDJJJffmOxy9sYc8yUdfDmpc5V5Tww&oe=69A03BC0"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQM-LPD_QpUQ7kNvwE859b5&_nc_oc=Adn55DriPcQ5lPLwy-b7qAaWO1gBOZKEvgM6mz0O7n1VWWmVYqkd8sMH6GC1fSdrnr0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuUOJ3PIBlXzZQNA5ObaCglSxkbTxN51Ss5xDsBo0A2xw&oe=69A02E8D"}, "is_concept": false, 
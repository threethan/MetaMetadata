=Adm9WI7KWSQrXgErqV_7DDysOwCauDTey0FYVdpgT_oTAS5QeuJen-BU4jhI9LI9VPY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxuIMAqIAKPKgMYvXPHhLisWWMWCnmQ89Y3mHUSrE6Zmw&oe=69AABAE7"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqZYrpYOdPgQ7kNvwEmUzJJ&_nc_oc=AdmxB_2H_jYaaOdqANuHVC4SxeWJNjQMQ9X56Qsyum564so_3qT3YYHU422eHrKwvOs&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afw0UmHkp-EqJXyl_UPtbD0qBAz-_JS-I2TPsA-Iwmki-Q&oe=69AAB7CB"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6PVlgF8-ywQ7kNvwEE9ooU&_nc_oc=Adn_O72g1vp1hFENr7ADOFnPquQkt10I04oAu_tN2-VJPLBIh5IkJoKlGTSHE0GNU6Y&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afxe7ud87upsBFw5aCOYgeUn5aOdiEPz9ChWs7s3v0QNkQ&oe=69AAD654"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m44q6thN4xMQ7kNvwHlAApp&_nc_oc=AdmeVFoGXwKktV7OJIDDGArBpFE4SeMc1WE1rgH0sodaXPneBx6Z599RqL62cvlXQ6E&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxyygJggbuPr7dRH2rtTW343_ksmikyjaIdH8U_99sSwA&oe=69AAC7C0"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akh2b2svOGMQ7kNvwFIAT0P&_nc_oc=Adm_RaRh99NkGzbKhZuPopGvH1oKUKG8Z8SC9kn9O_Wvw_k7r82MWEcY6rTElxjMHXY&_nc_zt=3&_n
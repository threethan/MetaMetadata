dR-9O2PbgnoQ7kNvwHUGZME&_nc_oc=AdpeQdC_kkeSBnBaMwhQCvf4T0Lf9nZ08s0VQmnW1MdonwlwUUbvUAUuGM6ppHj1ZHU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RdeEwqH3z2JsQo3gxyNwpYL64bsgGP9JKic_XvNSRww&oe=69F8BBA7"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kGQ_Y_9dpYQ7kNvwGah683&_nc_oc=AdpJpn8F4q1pCgSb_ssC9RMXMQZaWzUB5YkBazImgRGelbsvyutfSSM5-mkQq33iwI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2V03nsGNZaVgwORn73v0o310Zi9AiI29gepyyRrNYpFQ&oe=69F8B88B"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=manw9T2bDnoQ7kNvwGVAb9p&_nc_oc=AdqeQw_91kfBfSwWmrYNJPs7-mRKZdAAPVUZyd71iA5Eoj9fkUsq4qqx78w-Lz8wXMw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3T3ISGZlBKHaJyUOh2WD5dloHA8eq6QikgU9YBOBctTw&oe=69F89ED4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfQKIpNl9wEQ7kNvwEDYnlB&_nc_oc=AdruD0eS6vxVfAqpXypg8SwCqT2g5ZAmllDHmYs5QVvgCAsOtczN4yCWMHxfrRsuius&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0b3ObWTu1bYO_UqlF9YFb2vLVTPUAcbc023JZsC95IKg&oe=69F89040"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcM0EEgMigYQ7kNvwHX6siR&_nc_oc=Adpe543Wan3S2vXcRWBaVEHTAfjakuYKGD
Bv2u_HO79OwQ7kNvwG-ziMd&_nc_oc=AdoQbqI6qKooBWFsDHvbZJDQii0rP81w1ByTC2OxAooEs7XD27hSQaBgEhGeDjCRm60&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFLQ-yjfPIS6feQRK17sMNH1PSRkrgz8xf1rpFm-wAZw&oe=6AB693A7"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ohgqEUjmNUQ7kNvwFh_93o&_nc_oc=Ado05_h5ddkgR21qUARpZt7W-lbLzw23PzXIbLHeWJakq2Ee6SffXPbr8eoUy8WBrVA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2QaWm-K97WMc6lVSIJP_7xV6ilavg2bb2wgHUoJ72yQ&oe=6AB6908B"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30iEsro5tiIQ7kNvwFSz39i&_nc_oc=AdpT7js0gzJrK3WEdhBIPYazMxlK_Kh1t5nbCSjqq87AL7ljKrhvKtPuvUgnn_nIpSo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU4mPqIHHByb7vjTg7c-bzDfjcDQ_cUbI55Ln5AJUHaA&oe=6AB676D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZsBV-LSEHkQ7kNvwE9e2_S&_nc_oc=Adr3m2zjvZzJ7Qz89Yhh9EFZstDGizPP58qUTr1qoMqhITFu-ZzBgOd0vvydgfuGniA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgJlH2B8TuZb2Kv9yakAUqpHLP60y8CkFRjkRoWR1d_g&oe=6AB66840"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqNHWbNvEMQQ7kNvwH-Z86w&_nc_oc=AdqBuDnkzqm75CKosAWlnqDf7uduUWhiDk
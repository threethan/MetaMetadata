ontent-ams2-1.oculuscdn.com&oh=00_AfvMUBnqAnVBkJMDvzYz-LzCgK7ie_kZpy7akylRocy2Bg&oe=699EDD67"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmlviGPNU8wQ7kNvwHiYMtj&_nc_oc=AdmpwAaRm6tNdldyP6uSVRS-Z0uv9gKt_U1NgCqhw3cXg6As--PeAO9j1pfolfSSOeM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft-ryWHidSIfDDUltNIQ97RWrP4zXBf8MAmN35VpsIovg&oe=699EDA4B"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NggcWMcT8kQQ7kNvwEVgDwc&_nc_oc=Adkf44bOP9XEcsjP-cX-tk2KYWn8TDmDR4g5AkxQvAMfrdR0bM0U4l4PaK1tj68UtuM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu1f9J392xnTki0cSSYKJhANbZgA6StvEF8V-b-bZIEpQ&oe=699EF8D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4SgaNZIt08Q7kNvwFjpiqr&_nc_oc=AdlaZ9867zLb7PJTRrCmZbK0hZPHoOiOie1xa4J5RsYV776PD1dIIAHri2dlWPsLigM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvm-gAby-uowP_P_ZnwXqU6JmsnpAJvwo_cIsG9A00dXw&oe=699EEA40"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQM-LPD_QpUQ7kNvwFC-PM9&_nc_oc=Adl2gsgIn2nCqYHU8clw8Fvd02HqlazkCROxyAJf-yt37GoFbjmgrEzjHLWNPzcEhb8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afua5Ijz-91eYXhAxE3vp5kLhS-VfPEPYapT2wtnCTUEtQ&oe=699EDD0D"}, "is_concept": false, 
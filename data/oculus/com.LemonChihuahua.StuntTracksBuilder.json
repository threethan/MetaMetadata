ontent-hkg4-1.oculuscdn.com&oh=00_AfspNLud8yPx48uCmW0dej1ZLuyiiVLNeSCpINX0JGJKpg&oe=69A18067"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MmlviGPNU8wQ7kNvwGLd0ir&_nc_oc=Adl-3iauH-Rp-km7ninFDHqKfDxOIi-De0GnV4I6Mmj1iyTzbiqRaratsRwuiVJl6sI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfupPq08kctCb67bRfHC9tHiVqAs6NsI0dWe6QVhjj2C1Q&oe=69A17D4B"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHzQqIPrz60Q7kNvwFUF-1e&_nc_oc=Adldw3n3V1Rg1CiAfB5daT8pKcgRb57cJMHBWyrbAUzf1e26rKdy6pt-wqP8h1iHR58&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsmZBrN_kNovYwaSXDH4ZVm4UaQt3ITQ8OzMippfbsu5Q&oe=69A19BD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPifeZmqIJwQ7kNvwFdvGVp&_nc_oc=AdkiTvj0i1hR9ozrtHffNna40OcFD0cEDYnVDFX_FmqUGYy58fRu0R7klZHf68ihykA&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsFML_YPB_wMr-0VY_FkRnQrIxsUhz9uWP2dn4TXLXpCA&oe=69A18D40"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQM-LPD_QpUQ7kNvwG7TiC7&_nc_oc=AdkyUE5nKrVUOvhBUE5dXyTwityLUDAzIzrZrb6vLae9r3YRQnVlVdg9NsogMtedS-o&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftKZbuCGt3mrVJXC_-QvkHzzZKovCGWKG8ZLljsVzUgpw&oe=69A1800D"}, "is_concept": false, 
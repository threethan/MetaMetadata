q_t2aaZEPp0Q7kNvwFs527a&_nc_oc=Ado-Clr7tZ17rwOx-PRr74dqcItGQXfeutPsSEZm0u8Tb5jeOaRCH1VA9Av34Xw-OYg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A8lp_RiDiro8egXqV8d4MpAJXioZsK-MNncIlIfS6Yg&oe=6A301AA7"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5yVd7pqvA0Q7kNvwHlxlWs&_nc_oc=AdpTGBUoUEhuvTtk-RrysKHqqS2EyFqP-z4uoHD9TMdSpNgWtCFejw3bOXlysk9e4SQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Qah6z3QJLwb07h6WLZ21CLNvuw9mPvq2CHRHZTlUwzA&oe=6A30178B"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n92wJAdyGVgQ7kNvwGnpVVz&_nc_oc=AdrcO-3js7b-knSEPOiJmsk0eajUPeSJInGj7law8ajEtQqrA6SCeotKuJaS3xU5Aw8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-78mQMp0GI3EUURQk0-s3qP2Haqaf2M3Ii3ATlRf3wRA&oe=6A2FFDD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msevj6UHsDEQ7kNvwGT74Q4&_nc_oc=AdpjD0UsVThsIp9n1EIVEoAbt-MwMCjp31Lz0TtYv57xCGHFr8qIeFRxGrXWyWCTrnw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83qmQiX908qR8RfSJWW_fBRAKGreyrmJTinGFhvNH-6g&oe=6A302780"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtHJDwJY0a0Q7kNvwGe9FZt&_nc_oc=AdrYVLVZcDLM36aRkNhkEXmdM98F-URZyr
ajz4410MBNcQ7kNvwE4UhYu&_nc_oc=Adrxc3DFRyb7dJsqJegSyqwTsxiEVmN7mM156HNjQGbMGEUqEshaJV0sBythwi_6QYs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92eYg6-PHB_LbspuhUD4Z1JX6LMkgbSzkQgPrsmn1qpA&oe=6A3E9B27"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktekskP_szwQ7kNvwFSfNCr&_nc_oc=AdpTLqp0SfffqZ1LFS3_9JpamthA6aVm2TlqXXq_-F10AF9H9UFMhWQhwBF5iJS5V8E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uJse6GYyr9SPeF9Za1x1pzHVKw85srB18ZnDaxu_1CQ&oe=6A3E980B"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIDb9bnFIlwQ7kNvwFKVZe_&_nc_oc=AdpLXLSc1Af_xkXgjq2dXv0QiPiLhIXTfViTIImNjYMJ52AIP5EQ3E8bNLDLkXpjFPo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HcA757pR11wVD34jd94Ow8uLi8dTR5jJcMZlAvz6wgg&oe=6A3E7E54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCKYtgay38QQ7kNvwFI6jz9&_nc_oc=AdoFMUyT0NT90nOKsGx1tAbyNSrYyQLkqLQ5JKGCG6akroRAIqXUoRjdUi4krWGYHFM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bbEJh9rROCkOiB9Z6i9Jz3RhM-I6oxTqpeB6xt7Lg8w&oe=6A3EA800"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SshCUP6Bf9AQ7kNvwGK2_JH&_nc_oc=AdpC_aKOEuKlfdfAZH6PacvZKuI4n_ZdLc
ljerktV2MvHlDSnH8MTn3Muyc8DUw_I51dvTje5_LsM0DXLpaVZjW-PLWyzFIo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfysZvW5lTxBtBXt-8yjHw_E8Cf29EkIXrG4ThRYi5VFwg&oe=69AEAF67"}, {"file_name": "4.png", "id": "363628795893601", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75617327_363628799226934_2693397631707652118_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2gZiaiFa3EgQ7kNvwFS7MgK&_nc_oc=AdmiM35JESGoAyOugTGhX3wt0cyS5DtU3mdQtTyczZx2xVm5dRKmBGbDHik2yztcx2k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4MTP_rJyXyAjfxE3dldcwGdB0R1ucfO6AbOTf3wJ2Rw&oe=69AEAC4B"}, {"file_name": "5.png", "id": "1369381496920773", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003230_1369381503587439_7205025514845836087_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbgyi8w3WmwQ7kNvwHiKlzT&_nc_oc=AdnzeDTcqep0G2rGxbl_bvhKkoV1UPAHRFJnsI-sWx_TwcdjJo8LNftc4NqXjqIRlKA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjY-9mfdAtAX7W37HVWtvFJTNa2DI8eaAwmCAujD2T3A&oe=69AECAD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover-landscape.png", "id": "594914785674151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_594914792340817_4685969561363204624_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mq3ASfU_FM8Q7kNvwF8ll2w&_nc_oc=AdlHCx4k7z_RXqRenhVGB4bLYZlpYlHLO_7QEyIZ4gAji7r0JL-3DvymFf8O4XgMTv0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_84VntmQ6QS2Xsy0IvNkXVADJ4sfTJ8_ul8306FIdsA&oe=69AEBC40"}, "display_name": "Stunt track builder", "keywords": [], "long_description": "A mixed-reality physic-simulation game about building giant stunt tracks in your home and collecting all the super looking toy cars. Build the stunt tracks of your dream, in VR, or in your own room.\n\nFeatures:\n+ Stunt track buildings, including turn, slope, curve, loop and wall riding (for cars).\n+ Toy-car physics.\n+ Cars and tracks collection.\n+ Mixed reality mode: play in your own room.\n+ Virtual home-like environment such as bedroom, kitchen, living room, garage\n+ Roller-coaster mode. Jump on your toy cars and cruise around the tracks you have builds.\n+ Laser toy guns: shoot the cars! It's fun.\n+ Community levels. Create and share your builds with the community.\n+ Explore over hundreds and growing number of community builds, ranging from driving test, high-speed crash test, to moon jumping.\n\n", "short_description": "A mixed-reality physic-simulation game about building your own over-the-top stunt tracks with realistic toy-car physics. Build the stunt tracks of your dream, in VR or in your own room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trackbuilder.github.io/privacy/", "developer_terms_of_service_url": null, "publisher_name": "LemonChihuahua", "support_website_url": null, "website_url": "https://trackbuilder.github.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "RACING", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD_VIA_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7340871765941550"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974469_584685126055985_8936669020604298598_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bvaX-NmtphgQ7kNvwFRal8X&_nc_oc=Adlvmf3YleqKtk-1PzHGiURO86AvUov7_AaknVTPhSRl29NRDsh2JXYVS4GJ5CZk-SA&_nc_zt=3&_nc_ht=sc
-2.oculuscdn.com&_nc_ss=8&oh=00_AfzpNXtGx8ehHIVufyvsb4ujNF4OIbxxWmfLOguhobJx2Q&oe=69BD3D96"}, {"file_name": "migrated_image.png", "id": "285063182473093", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162689_1091083417615612_610968156_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DT4QtyhqBDUQ7kNvwFZpqym&_nc_oc=Adl6OclBc3fjD8N5QV4PSluDJasUC2zTQxv4T7MCx89SoC-OmOVeUMr3YfHTdXhouXI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkBlRlQosgivehxcQeqKCfMvGv-lZX_d6poVjuCjphoA&oe=69BD39DD"}, {"file_name": "migrated_image.png", "id": "214919716285503", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12427506_1140611379293364_112220918_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0bNKFnf3OkQ7kNvwGuBS9z&_nc_oc=AdkyIIKa_Px1IyKXW1oxPhVvBWFrmLnzWl4Sq9Br-pDaiPdJCbs9hN1zVxjwXywtXc0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4lFr_ys82ntbi6FmsxD3fUsEDTjO73I8RS7gPpUwz6Q&oe=69BD528B"}, {"file_name": "migrated_image.png", "id": "209440756796198", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427735_238744656501950_69055206_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfYuVa68Z3gQ7kNvwFDvEM-&_nc_oc=AdnQgr1aRTqKiyO2_x8jxh1L8EkNQ_ugFIXg6b2Y6GlaYnyHQsh54BHjoYFnOb_LTkY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqH-FXV3YOG_g4ynvbdIQ8jJ3ANJ7ZPKpe-WdZJdVvCw&oe=69BD31BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Needle", "keywords": ["Seattle", "Panogs", "Tourism", "Travel", "SpaceNeedle"], "long_description": "If you see one thing, see it all \u2013 literally, and virtually!\n\nNothing says Seattle like the Space Needle. Famous for its iconic perch on the Seattle skyline, the 605-foot tower has been a symbol of the Age of Space and what\u2019s possible since it opened for 1962 World's Fair. And now, you can take the views to go!\n\nSpace Needle 360\u00ba is a GearVR app that lets you have an immersive visual experience like no other.", "short_de
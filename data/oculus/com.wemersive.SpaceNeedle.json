-1.oculuscdn.com&_nc_ss=8&oh=00_Aftl-hECnMkOpycpB5dVgST4m-AUd1EeAnZKhpmxzwGxyw&oe=69A82596"}, {"file_name": "migrated_image.png", "id": "285063182473093", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162689_1091083417615612_610968156_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8p_Q9pf04gQ7kNvwHSxSPF&_nc_oc=AdkQHttrAtvS3H4oDYvM_3BDGDioNnJvsOE81KmfOLwDHBeTmUh97Y0j-g9D2apgthg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsoZtEcbgdxpy6bj_hx2we5MDgyXvvUS9kBW1D8TQ9oTg&oe=69A821DD"}, {"file_name": "migrated_image.png", "id": "214919716285503", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427506_1140611379293364_112220918_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtX0gnD9jE0Q7kNvwFK-iq7&_nc_oc=AdnSDs279YizJL6RN-HQlENpzz2YxRWLi_GOOQF_2uWN1CUUc6Puh9ShZLqXbfNj2EA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftpYZrtB0OFNrGWFFTNXhyAxz0ogVkJ9eZpDNYeR3v-og&oe=69A83A8B"}, {"file_name": "migrated_image.png", "id": "209440756796198", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427735_238744656501950_69055206_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGXKsVlWVF4Q7kNvwFnN-AT&_nc_oc=Adn7EmOguDGeYTItY8mwfmyM9bkVVw2Oatw_NG3sVvTF5kXNWrCukjmN0aqmwDVop9o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuScNSCWXO_8oWJ30snxQPS2R_2I2beFlv4WbZJQ0kk1Q&oe=69A819BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Needle", "keywords": ["Seattle", "Panogs", "Tourism", "Travel", "SpaceNeedle"], "long_description": "If you see one thing, see it all \u2013 literally, and virtually!\n\nNothing says Seattle like the Space Needle. Famous for its iconic perch on the Seattle skyline, the 605-foot tower has been a symbol of the Age of Space and what\u2019s possible since it opened for 1962 World's Fair. And now, you can take the views to go!\n\nSpace Needle 360\u00ba is a GearVR app that lets you have an immersive visual experience like no other.", "short_de
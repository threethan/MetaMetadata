-3.oculuscdn.com&_nc_ss=8&oh=00_AfwomLg3DLtfcVQUtRGsPhNqylU5dZuxkqGCwu7StD8Yhg&oe=69B94916"}, {"file_name": "migrated_image.png", "id": "285063182473093", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162689_1091083417615612_610968156_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IU3W2qQ800Q7kNvwFwUPup&_nc_oc=AdmyxxFaMrRzwLmmscboURfP965o1QdbhdV6iXLH7-Fap9JMHuNX9JypxEkI3ASEF-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxzKM8cf2bFH-uUWHo1QWaE1wru9lluwjwYqtzrU_dAOw&oe=69B9455D"}, {"file_name": "migrated_image.png", "id": "214919716285503", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427506_1140611379293364_112220918_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AV8rdOqqj-gQ7kNvwHzPMiW&_nc_oc=AdmXz17G_-x8aR13wEQ8ypbzP8WxTnLo61U5TYklOCcdBJeKWUjcmrUPXJk5IDyZG54&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxniAxXT73P4Fn1EcAF94svgFg_TiavvnqDSfWoUOKXIQ&oe=69B95E0B"}, {"file_name": "migrated_image.png", "id": "209440756796198", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427735_238744656501950_69055206_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IHcTmiKx-mwQ7kNvwEfob1S&_nc_oc=AdkAV6siG6y4A040hf8nnSLm97lwUT01gqTB7EwAwIIsuqcvwgvMgbr_EOw2yTlZwKc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwb9RLCrYUU7S6pRec7LuNSHIVimCZn1GISZ_9oS_9o0w&oe=69B93D3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Space Needle", "keywords": ["Seattle", "Panogs", "Tourism", "Travel", "SpaceNeedle"], "long_description": "If you see one thing, see it all \u2013 literally, and virtually!\n\nNothing says Seattle like the Space Needle. Famous for its iconic perch on the Seattle skyline, the 605-foot tower has been a symbol of the Age of Space and what\u2019s possible since it opened for 1962 World's Fair. And now, you can take the views to go!\n\nSpace Needle 360\u00ba is a GearVR app that lets you have an immersive visual experience like no other.", "short_de
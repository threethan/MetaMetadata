ive visual experience like no other.", "short_description": "Nothing says Seattle like the Space Needle. Experience it in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spaceneedle.com/privacy/", "developer_terms_of_service_url": "https://www.spaceneedle.com/", "publisher_name": "Wemersive", "support_website_url": null, "website_url": "http://www.spaceneedle.com/vr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "267232745484287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427573_283263835347737_1748553726_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01S8QJV4mX8Q7kNvwHOUMN2&_nc_oc=Adr0UpiVJevaacmwDIgnwXqAWQEp-6nZbH1Bh42Fz00_DFiuM6jIRg8VRLJ3kSU3lNk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUuCFkEKWF7CdXT6DzzUPBcoaSJe4bNtWxP9ak_UCl7A&oe=6AEC8D0B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Needle", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1477551600, "lastRevision": {"nodes": [{"id": "1002464409846696", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "814352192025674", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"
eattle like the Space Needle. Famous for its iconic perch on the Seattle skyline, the 605-foot tower has been a symbol of the Age of Space and what\u2019s possible since it opened for 1962 World's Fair. And now, you can take the views to go!\n\nSpace Needle 360\u00ba is a GearVR app that lets you have an immersive visual experience like no other.", "short_description": "Nothing says Seattle like the Space Needle. Experience it in VR!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.spaceneedle.com/privacy/", "developer_terms_of_service_url": "https://www.spaceneedle.com/", "publisher_name": "Wemersive", "support_website_url": null, "website_url": "http://www.spaceneedle.com/vr/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "267232745484287"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427573_283263835347737_1748553726_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTrhKJeS2bUQ7kNvwE1Jbkt&_nc_oc=Adrb9Yu0ulRYerzFn4w-M5Q1_oXk4f5pUlsWmTJ4svZhBwStPuAcduTAPH4MNHml4B4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROc287izSrrYvAazuXU1cJyQshey50qrUs2Wha1AwPtw&oe=6AFB45CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Space Needle", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1477551600, "lastRevision": {"nodes": [{"id": "10
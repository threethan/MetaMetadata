7&_nc_sid=6e7a0a&_nc_ohc=bCf-C9rGgagQ7kNvwE81H0l&_nc_oc=AdrfnrreAwRZEQGnsot9fvdJFifDIoSQUepTXRGfd_KZVBHIDJS87W-K7_M-OjqU7f0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe_zg_AHNrmWl0jP_HFVrrVkw3mMM7ct1d5-y8_eaqzQ&oe=6A7DCE5A"}, {"file_name": "Capillary Collection.00_00_26_24.Still004.png", "id": "2466954450470469", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499626699_2466954453803802_1655667139416207682_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gepakbhr1LgQ7kNvwE1A5kD&_nc_oc=AdpHaFafAc7jKY71QTEkw4guoEKrWLDbcaVG9dHCbceRMLZBF3QOZx2NYdPrbXa_e3c&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_iynMIqhF69vwj8fZuQrzOk94YRpYDQrgsjkgZf3FCA&oe=6A7DCE91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phlebotomy", "keywords": ["VR", "Medvr", "Phlebotomy", "education", "medical"], "long_description": "Phlebotomy is an interactive VR simulation designed to train healthcare learners in blood collection procedures through realistic, hands-on practice. The application includes four comprehensive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set (Butterfly Needle), and Capillary Blood Collection. Learners are guided through patient identification, equipment preparation, site selection, specimen collection, labeling, and post-procedure care while following infection prevention and patient safety standards. The immersive virtual environment enables repeated practice without patient risk, helping users develop confidence, accuracy, and procedural competency. Ideal for healthcare students and professionals seeking effective, skills-based phlebotomy training.", "short_description": "Phlebotomy is an immersive VR training simulation that teaches essential blood collection skills through four interactive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set, and Capillary Blood Collection. Practice safe, accurate specimen collection in a realistic clinical environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "753846217818652"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619836_866403119224962_4975066649143718900_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ibxZ2Kd-kMsQ7kNvwGcwaWl&_nc_oc=Ado0XvR5v2PfBxkK0nXruf3X1EBBK3Tw83i-60LFuEcJPuAAHfH6tG8eGHCju-AyhAg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlKfLR-zcqIQxOkBOT7bfh8-6OFO6OBfWk-_oiR-_Oeg&oe=6A7DB63B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Phlebotomy", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 17
43911214824338134_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvXhK3pPGCoQ7kNvwE6NPkg&_nc_oc=AdqPaPyDnZNl3DvSUDpJSEBYR-CtaqFrBsTlkC34g1wbVjTRULwcn7-Re43Oyhfzzug&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8xYdQpQ9Ub7qsYN3IrIpuS2oMKxkVX8kcKHjQee_1zA&oe=6A6F2ACF"}, {"file_name": "Capillary Collection.00_00_46_01.Still003.png", "id": "1226358586155308", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619808_1226358592821974_7020756353057296147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86WaCQJ5fL4Q7kNvwFYDmID&_nc_oc=AdpN84IOyAnkyySaj7wqMhFz5mJzVAxYaxPfId4gFQTH5IIsT6NrFaKB6rdnvd_gXmY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9OJiVYASu0-kBQQx9fAfvqI3i07vhmfYNc2EpOx9JIw&oe=6A6F349C"}, {"file_name": "Capillary Collection.00_00_30_25.Still006.png", "id": "950929394446211", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308166_950929397779544_7262244210563112923_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_MNN8qZDvBsQ7kNvwESOsfk&_nc_oc=Ado2swS0P0gF3ezSaOUOCCG2fd1nHrcfqcnWY4-0qD8sfVmWJNsVU9dgrtAq8Oiq2Q8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM4qZD1FOnyd7hVHtNcp-b1nxq874VIKRfgX4BkoHrVg&oe=6A6F4DDA"}, {"file_name": "Capillary Collection.00_00_26_24.Still004.png", "id": "2466954450470469", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499626699_2466954453803802_1655667139416207682_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1xw3bBUmm0Q7kNvwGwJur-&_nc_oc=Adr6QpWQ9GU9pGr8T3vXxQPwShKQs-yc2YoVo2YwF-4JlX4yehvHbKwDxdxTP-GQxBE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8IbG5i7Kx0JUQsH0DnCQ1dQmYT3GyefPo16M4MpaJng&oe=6A6F4E11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phlebotomy", "keywords": ["VR", "Medvr", "Phlebotomy", "education", "medical"], "long_description": "Phlebotomy is an interactive VR simulation designed to train healthcare learners in blood collection procedures through realistic, hands-on practice. The application includes four comprehensive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set (Butterfly Needle), and Capillary Blood Collection. Learners are guided through patient identification, equipment preparation, site selection, specimen collection, labeling, and post-procedure care while following infection prevention and patient safety standards. The immersive virtual environment enables repeated practice without patient risk, helping users develop confidence, accuracy, and procedural competency. Ideal for healthcare students and professionals seeking effective, skills-based phlebotomy training.", "short_description": "Phlebotomy is an immersive VR training simulation that teaches essential blood collection skills through four interactive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set, and Capillary Blood Collection. Practice safe, accurate specimen collection in a realistic clinical environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCAL
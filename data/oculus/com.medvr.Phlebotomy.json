43911214824338134_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6bJVBr8hNQQ7kNvwF1gcFg&_nc_oc=AdpaStm7pXHj8xy_ApuE6d6HxnSKnTtCeJCBfYx_ON5cvJZbVUrr-BdPWFbclGRfLW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEutmEXUW3VJGodzJe8ima4Mgati7UPqc5SLFiHT-lCwA&oe=6A8C2BCF"}, {"file_name": "Capillary Collection.00_00_46_01.Still003.png", "id": "1226358586155308", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619808_1226358592821974_7020756353057296147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfxGM7-J6e0Q7kNvwFbTP5c&_nc_oc=Ado1gPoIAm9sOLG84Aq6bmQ8bFuNt2_OVL8W2e8gWbzoQMEISxFs2I2qtsV3KvFNWzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEDotFHes2RmRpjzAG5iH0wH0-4x2NrG-CCYXwHD9odg&oe=6A8C359C"}, {"file_name": "Capillary Collection.00_00_30_25.Still006.png", "id": "950929394446211", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308166_950929397779544_7262244210563112923_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jor7gJnl_8wQ7kNvwEIfgz0&_nc_oc=AdrAOwkzUJxXKNiSrhLGYyyFpNj2sh7U0X6b_Nz-VVo6K_3rrsT236np26zG-4eCa1E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQQulecMEp9w8tPSkUG-cb9t16HYyxitwyG_xI4_gLLQ&oe=6A8C169A"}, {"file_name": "Capillary Collection.00_00_26_24.Still004.png", "id": "2466954450470469", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499626699_2466954453803802_1655667139416207682_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDmw0IxWgCsQ7kNvwEBT38L&_nc_oc=Adr-6eMn13a8mOgg07RYss2PSyOzKo4Xo6p3lCWHtRiNpsMgYg1VflHdaHce0N3AFjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETZQXl4_zDUrPIrNcKL9OjU1ROrdKE_vzE3OTJoXnNdQ&oe=6A8C16D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phlebotomy", "keywords": ["VR", "Medvr", "Phlebotomy", "education", "medical"], "long_description": "Phlebotomy is an interactive VR simulation designed to train healthcare learners in blood collection procedures through realistic, hands-on practice. The application includes four comprehensive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set (Butterfly Needle), and Capillary Blood Collection. Learners are guided through patient identification, equipment preparation, site selection, specimen collection, labeling, and post-procedure care while following infection prevention and patient safety standards. The immersive virtual environment enables repeated practice without patient risk, helping users develop confidence, accuracy, and procedural competency. Ideal for healthcare students and professionals seeking effective, skills-based phlebotomy training.", "short_description": "Phlebotomy is an immersive VR training simulation that teaches essential blood collection skills through four interactive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set, and Capillary Blood Collection. Practice safe, accurate specimen collection in a realistic clinical environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCAL
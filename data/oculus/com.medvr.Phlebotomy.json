d=6e7a0a&_nc_ohc=jIPFoEvPftoQ7kNvwFDd17d&_nc_oc=AdpHZ9uy37jwD9Y3kaa9olaed7YMj7XX6HdIm0rI6uYlJ_Q4C9hv_GlDxhybrTPH9Yg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBRFUC0ukvH0dg9IxkUs8CBnCc7irhezjVT2jz5FfK8Q&oe=6AE351DA"}, {"file_name": "Capillary Collection.00_00_26_24.Still004.png", "id": "2466954450470469", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499626699_2466954453803802_1655667139416207682_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WssG7P-ReOAQ7kNvwEaOKRc&_nc_oc=AdogAFwwu3LUgQq6dGRsk0WIka08sWCf07nQ4zl1nY_TyRaEiyZvRenegDvJ8p_5gT8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-7iuICAWtUDK-LA7xTglCXayFjE2dyGf_PXAP9Hx-Nw&oe=6AE35211"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phlebotomy", "keywords": ["VR", "Medvr", "Phlebotomy", "education", "medical"], "long_description": "Phlebotomy is an interactive VR simulation designed to train healthcare learners in blood collection procedures through realistic, hands-on practice. The application includes four comprehensive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set (Butterfly Needle), and Capillary Blood Collection. Learners are guided through patient identification, equipment preparation, site selection, specimen collection, labeling, and post-procedure care while following infection prevention and patient safety standards. The immersive virtual environment enables repeated practice without patient risk, helping users develop confidence, accuracy, and procedural competency. Ideal for healthcare students and professionals seeking effective, skills-based phlebotomy training.", "short_description": "Phlebotomy is an immersive VR training simulation that teaches essential blood collection skills through four interactive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Us
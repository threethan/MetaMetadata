6358586155308", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619808_1226358592821974_7020756353057296147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSOWoYmJrl0Q7kNvwFs6Usa&_nc_oc=AdrMTKiN4bsCjlSORonk6AglmGfKO6-PzQC4KkWDcDoYFyMyxovgmeKrLwvLkCnaHEo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTw0-tJJDGIlG5OW234daI31-pEqvF1BHXUStsfL0d1Wg&oe=6AEA085C"}, {"file_name": "Capillary Collection.00_00_30_25.Still006.png", "id": "950929394446211", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308166_950929397779544_7262244210563112923_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EEti1yreQoQ7kNvwFh9I2K&_nc_oc=AdpQLevOW4zfSCpVr0BKavb9ALcRS0HkrTMhUgLpCOnivRZADUYVeiVGVWH82_Uj5bU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTERIUC7lMaEleGsVkmS5chhPSRj77Q1mvqnys7Nbo5-A&oe=6AE9E95A"}, {"file_name": "Capillary Collection.00_00_26_24.Still004.png", "id": "2466954450470469", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499626699_2466954453803802_1655667139416207682_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcNB1l522P8Q7kNvwEDxmr9&_nc_oc=Adpm22oKZP4ZW0Don_KrJGFR-69D9WUUXsTWDggT7C4EBdLUtqUMNo_787RhsajtAow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl9GqkbT23tiP-moKw2VGiq7MeBVIKUdLXd0G6evMGGA&oe=6AE9E991"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phlebotomy", "keywords": ["VR", "Medvr", "Phlebotomy", "education", "medical"], "long_description": "Phlebotomy is an interactive VR simulation designed to train healthcare learners in blood collection procedures through realistic, hands-on practice. The application includes four comprehensive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set (Butterfly Needle), and Capillary Blood Collection. Learners are guided through patient identification, equipment preparation, site selection, specimen collection, labeling, and post-procedure care while following infection prevention and patient safety standards. The immersive virtual environment enables repeated practice without patient risk, helping users develop confidence, accuracy, and procedural competency. Ideal for healthcare students and professionals seeking effective, skills-based phlebotomy training.", "short_description": "Phlebotomy is an immersive VR training simulation that teaches essential blood collection skills through four interactive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set, and Capillary Blood Collection. Practice safe, accurate specimen collection in a realistic clinical environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "753846217818652"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1487401719963244"}, {"status": "PUBLISHED", "id": "3422782187879500"}]}, "baseline_offer": {"id": "1487401719963244"}, "is_approved": true, "firstOffer": {"nodes": [{"st
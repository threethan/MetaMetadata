d=6e7a0a&_nc_ohc=JAcAZSr_S-YQ7kNvwEvAq6i&_nc_oc=AdpwNl-_gFtwgCFqGNtU0YNDtQf4APtYmJfp3Lszxg14n0Ve6jqFEAp29-YbD8S7SJE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWqlAHR0OhcIwNWRq-oELt11T2JwzAPoAKJpbxNiIyJw&oe=6AA166DA"}, {"file_name": "Capillary Collection.00_00_26_24.Still004.png", "id": "2466954450470469", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499626699_2466954453803802_1655667139416207682_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sep0CBlavWIQ7kNvwHNYRa_&_nc_oc=AdpvNWEwiRbw7DEwDNKiirxe4OArQSZAA2Iq_ONhajhV4D2z315NVBeGDYiZlO4RtN8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_Dlmw_xN1u2Hzq7ax0vXY98FsP0G6jY-e9aUQbVKiCA&oe=6AA16711"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phlebotomy", "keywords": ["VR", "Medvr", "Phlebotomy", "education", "medical"], "long_description": "Phlebotomy is an interactive VR simulation designed to train healthcare learners in blood collection procedures through realistic, hands-on practice. The application includes four comprehensive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set (Butterfly Needle), and Capillary Blood Collection. Learners are guided through patient identification, equipment preparation, site selection, specimen collection, labeling, and post-procedure care while following infection prevention and patient safety standards. The immersive virtual environment enables repeated practice without patient risk, helping users develop confidence, accuracy, and procedural competency. Ideal for healthcare students and professionals seeking effective, skills-based phlebotomy training.", "short_description": "Phlebotomy is an immersive VR training simulation that teaches essential blood collection skills through four interactive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Us
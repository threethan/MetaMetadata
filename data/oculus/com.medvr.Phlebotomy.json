d=6e7a0a&_nc_ohc=ul90X8NFsIMQ7kNvwGzNAAt&_nc_oc=Adqs-k1w7vzojdGBtmUr2ZFWQ4xTtHtg_ZOWZjwAHsCBBKKG7C4KzRvK0vgPY5dKvOM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHMXrKJH1TGmjgy5NnVvWCG3GmyRHiCRtwR4NQH7W9_A&oe=6ABA735A"}, {"file_name": "Capillary Collection.00_00_26_24.Still004.png", "id": "2466954450470469", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626699_2466954453803802_1655667139416207682_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HK7OdHpYOwEQ7kNvwGAgS_7&_nc_oc=AdpfM5g0u3lQUPRXh_4I3-8gaL6VXge0WlHoiPwWIVB3nQ-5AGu-aCNSxGBPicL6-JY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuJePTof7TvnG9goqE9OjsVPOX0TyA35SbgJ95Pwj8xA&oe=6ABA7391"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phlebotomy", "keywords": ["VR", "Medvr", "Phlebotomy", "education", "medical"], "long_description": "Phlebotomy is an interactive VR simulation designed to train healthcare learners in blood collection procedures through realistic, hands-on practice. The application includes four comprehensive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set (Butterfly Needle), and Capillary Blood Collection. Learners are guided through patient identification, equipment preparation, site selection, specimen collection, labeling, and post-procedure care while following infection prevention and patient safety standards. The immersive virtual environment enables repeated practice without patient risk, helping users develop confidence, accuracy, and procedural competency. Ideal for healthcare students and professionals seeking effective, skills-based phlebotomy training.", "short_description": "Phlebotomy is an immersive VR training simulation that teaches essential blood collection skills through four interactive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Us
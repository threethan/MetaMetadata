43911214824338134_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00KvPW3JLJYQ7kNvwF1fd5e&_nc_oc=AdqzKgQ0OXIjzdu3EWK-u7BEQsrt3GEC9WDXcLd8WUjSrmU_QiwRUsvOsXEBm2ELNE4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZ47hxci4YNi5LNlCQGzV1KuIpzPGHlwlKXBRxNxdWXw&oe=6AE3670F"}, {"file_name": "Capillary Collection.00_00_46_01.Still003.png", "id": "1226358586155308", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619808_1226358592821974_7020756353057296147_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRd8EXu0QoQQ7kNvwGyJH2R&_nc_oc=AdplOX1a6h2oKfrp_p3DqDBmn7j9YmcNhdZh9qW4QbK-DjZd7qk6O3ChUD-5XOSVSAo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpF3pOzMDzrRXMdUtZn9g-S8g3AhSfDKUaW2mV64UhzA&oe=6AE3389C"}, {"file_name": "Capillary Collection.00_00_30_25.Still006.png", "id": "950929394446211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308166_950929397779544_7262244210563112923_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jIPFoEvPftoQ7kNvwFDd17d&_nc_oc=AdpHZ9uy37jwD9Y3kaa9olaed7YMj7XX6HdIm0rI6uYlJ_Q4C9hv_GlDxhybrTPH9Yg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBRFUC0ukvH0dg9IxkUs8CBnCc7irhezjVT2jz5FfK8Q&oe=6AE351DA"}, {"file_name": "Capillary Collection.00_00_26_24.Still004.png", "id": "2466954450470469", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499626699_2466954453803802_1655667139416207682_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WssG7P-ReOAQ7kNvwEaOKRc&_nc_oc=AdogAFwwu3LUgQq6dGRsk0WIka08sWCf07nQ4zl1nY_TyRaEiyZvRenegDvJ8p_5gT8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-7iuICAWtUDK-LA7xTglCXayFjE2dyGf_PXAP9Hx-Nw&oe=6AE35211"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Phlebotomy", "keywords": ["VR", "Medvr", "Phlebotomy", "education", "medical"], "long_description": "Phlebotomy is an interactive VR simulation designed to train healthcare learners in blood collection procedures through realistic, hands-on practice. The application includes four comprehensive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set (Butterfly Needle), and Capillary Blood Collection. Learners are guided through patient identification, equipment preparation, site selection, specimen collection, labeling, and post-procedure care while following infection prevention and patient safety standards. The immersive virtual environment enables repeated practice without patient risk, helping users develop confidence, accuracy, and procedural competency. Ideal for healthcare students and professionals seeking effective, skills-based phlebotomy training.", "short_description": "Phlebotomy is an immersive VR training simulation that teaches essential blood collection skills through four interactive modules: Routine Venipuncture Using a Syringe, Venipuncture Using an Evacuated Tube System (ETS), Venipuncture Using a Winged Infusion Set, and Capillary Blood Collection. Practice safe, accurate specimen collection in a realistic clinical environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.nbme.org/privacy", "developer_terms_of_service_url": null, "publisher_name": "MedVR Education", "support_website_url": null, "website_url": "https://medvr.education/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCAL
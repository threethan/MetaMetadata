=Adr5unMxWgCUmHPcEor1FiTAGFr5Qd_R2LIH71Bt0rGmdvmrLkOxf5TrB8VddfJiXJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPeUcBY4miYLOewq-V_K1kmscCQW4OnPtqR3w3ZXTIm2A&oe=6ACFB65B"}, {"file_name": "11449.png", "id": "952402013984560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824203_952402017317893_7100640402226579120_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8xwTYzZfkAQ7kNvwFmQRrd&_nc_oc=AdoAeYK9UbuCf50aQOS0MMa3uflntsiAfafKw2Afn7pIDjNh0DUFmDYc8R5qfOb_eiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNftZVn_U64Fa8L7t1xQMA97ozTap4hEEy6T9GlYx8_ug&oe=6ACFAC66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cosmicnauts", "keywords": ["cubic", "cube", "cosmicnauts", "novalight", "entities"], "long_description": "Cosmicnauts is a cosmic exploration and survival game set in the mysterious Cosmic Space beyond the known universe. In the beginning, you are created by the powerful Cubics, ancient beings from the Cubic Verse who designed you to explore what lies outside their realm. After your creation, they launch you into space as a Cosmicnaut, giving you one important mission: explore the unknown, learn about the universe, and survive whatever exists within it.\n{1960984648143843}\nAs you travel through the endless cosmic environment, you will discover different gamemodes, explore strange locations, and unlock new possibilities. Along the way you can visit the shop to obtain items, upgrades, and tools that help you survive longer and explore further.\nHowever, the universe is not empty. Hidden in the darkness of space are mysterious entities that roam the cosmos. Some may simply observe you, while others will actively hunt you. Surviving these encounters becomes an important part of your journey as you continue learning more about the strange universe around you.\n{1269758605098396}\nHowever, the universe is not empty. Hidden in the darkness of space are mysterious entities that roam the cosmos. Some may simply observe you, while others will actively hunt you. Surviving these encounters becomes an important part of your journey as you continue learning more about the strange universe around you.\n\n{1291748866212093}\n\nCosmicnauts is inspired by Cubic Verse, NovaLight, and Cube Runners", "short_description": "Cosmicnauts is a space exploration game where you play as a being created by the Cubics in the Cubic Verse. They send you into the vast Cosmic Space with one mission: discover and learn everything about the universe. As you travel through space, you unlock gamemodes, explore new areas, visit the shop, and try to survive against mysterious entities hiding in the cosmos.\nThe game is inspired by Cubic Verse, NovaLight, and Cube Runners. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://kahlemich-production.jimdosite.com/privacy-poiicy/", "developer_terms_of_service_url": null, "publisher_name": "Kahlemich Production ", "support_website_url": null, "website_url": "https://kahlemich-production.jimdosite.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26428679096745001"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3072567869609780"}]}, "baseline_offer": {"id": "3072567869609780"}, "is_approved": true, "f
9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBJ7CM-eEbgQ7kNvwHO_Mxo&_nc_oc=Ado0Y_DdCURTxxYXgcqJg1IOVPyQsW38Qr3SbEdpVmfMArmIs0Tj-DO4lARbZL-lBcw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZv91zPNbxsrBcKUN17fZIJNzr3XXFp3F8oD-mEgL1ew&oe=6AA1562B"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nna7-W3h50sQ7kNvwGAfmav&_nc_oc=AdppT1v-uIumF4OG3oefFQsvEIOKXK7LbH1UPzvEXEm7IK76rPy-Vd60a_QGu0WiLRU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj-AYC3v56e4YgPRBjUhUZefCWg8KyXF7Vy2FRVyzQIA&oe=6AA15D0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
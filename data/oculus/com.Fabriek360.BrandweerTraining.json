9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtVOAygwZVsQ7kNvwGILUyw&_nc_oc=Adp62We0j9QXuWfFXqUdl1UJXk7YxxDlEGaEgIXG_SSlXOPkXFKwqyXcFKHhF6JVVh0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vm6geN_eKt42FrCKgTJ7iUqcrOtGJ3SUVYh8KWR8_kA&oe=69E772AB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ut9EXmSWI7sQ7kNvwEh3NR4&_nc_oc=AdrWuKMlJuEsgHXMvMHjy86jHIHFl8f_NKkaoya4Re-ZC165SJ5Lq8oTq15187tIFcw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dVA0VlDQIkxvwDPaqgM0canK-_A4WE1u36KCDOp9KRg&oe=69E7798E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
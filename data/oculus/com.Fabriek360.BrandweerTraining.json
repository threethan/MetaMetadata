9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FalUZSKwxwQ7kNvwG04omQ&_nc_oc=AdrwbPFo8fXENwpHqss-FYtIAU8cLehxBeNFZaQRoZm3I0IfGyo6gGgBRkI30ccY2SQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lrYk6Lw8Ls30lbJo1jwxupWBL1lHV1klK8niR8Qoc7w&oe=6A26BAAB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGVObAigVtkQ7kNvwHyqg8v&_nc_oc=AdoE4DwkJXmW1h7QDw5iSVBzGWVyAXe31DdEp-w7BXy5kIPFxAuqhz63wGaUoAp1v2Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9C3EZQhNaYslqTaEwvR7EppSkZC2R7jz3SnZuKNJntIg&oe=6A26C18E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
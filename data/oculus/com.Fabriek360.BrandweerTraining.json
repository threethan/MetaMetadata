9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7Lgfwop-WkQ7kNvwFgX3xq&_nc_oc=AdroroAoCF4J3UzrE-O2tR_cjnl2k7-5kjePd7vxjegR1q8Dz9v8Dd2LB9XpzrEnrGM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIfOZBhbvtQWRfzRdiSDpDLF6D679hZHdUwLv2TyXJlw&oe=6ACA6CEB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AMyPg-aIJoQ7kNvwH3EdkR&_nc_oc=AdrBqRF5fJ5p8m38eykboixZDwh0P5VKH9iAKF1RjpXRj76RCdtp7-e8zR-m0HsO48k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMaPPAvQ-2PplXH1tA4KUcmV6MFOgvn1V03_ghBVK0voQ&oe=6ACA73CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
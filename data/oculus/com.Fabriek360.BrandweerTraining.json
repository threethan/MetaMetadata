9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MC1fyxAoaDsQ7kNvwFU3ZWw&_nc_oc=AdoPgQm4qk1ug1vSnR9RsGj7DQIWZqHDTaYyRnKXrZ7sfKT9Kvk-y0D5Soe_7yvwOm0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RquM_a2-tbVbYmycqgU9ZH1y6tM2BT9QfafmH8wljAw&oe=69F744AB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46X-6hZ014AQ7kNvwGt4fDe&_nc_oc=AdosHt3qljXsArvgmI9lANESE_XDpcHm2P3J8UxMBHGnaOcUrNXDn1zaIwz1KGrjwxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2AlUTrIzVZDSnKmAekulSy5gr1UOQyNqwurd7TC01Ivg&oe=69F74B8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X3CQHJS_wRcQ7kNvwGolWM1&_nc_oc=AdqGO-JKCnzH5zS57FilC2Cj3G_B0siVEzYwiaqNlNRT1EW19nlMy4v8gVu40-dRbao&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SVogaJD-Z8zeNQtaAzdIOxUbQf4SiZWwi6VhRa9RqLw&oe=6A198BAB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWuMB1PBjP4Q7kNvwEiTdSb&_nc_oc=AdpK0ncfNPUZINTzpQOnRN_T32v5rq1tCyGrWlAwNjznuJ17J_51ro64l0cc6AwQ4aQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R8jRD4mNa3lCH3yPU6GBN9Dxeh2gf1PDvToqNtil46g&oe=6A19928E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
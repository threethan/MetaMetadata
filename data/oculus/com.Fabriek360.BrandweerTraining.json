9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l5meXuo6-NAQ7kNvwFG-VvE&_nc_oc=AdowTbKiEe5Ic9LYqLE43G7IuI82UJm1lNG1XTEiwh1W9n4cII-H6w4wOg3SMZ3Qc8w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZlI-stBotfBiH0O8eDHMLHVoLG3lQJfhkn1EXTclvGg&oe=69D25AAB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFQPXN3rsjYQ7kNvwEmm_nn&_nc_oc=Adq7hsLizLuvfGCb1CeP6fyV62fbgJfhw7rRBh0FBpMvvor9v_vvgkIp1qEMqPCY2mw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3mfSIFwdmgbSbGlM5MZIIt3aymiTnfvjq6subrG-ycyQ&oe=69D2618E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXegeUjK-qUQ7kNvwHg_yOc&_nc_oc=Adod9qg8x-3bbLQ39ptY7LfQvEvZAwDT3S6hLIW9KCc-jHMdBFVPWo57OC2vb2GhmLM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MFto5wDkEKq-Wqs1SSQ3gObEigoF8ZqrkR_4L8nlW6w&oe=69EB672B"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVDI26vkAa8Q7kNvwF3z-ML&_nc_oc=AdpjXdziGNO9_Dz5qJ2M4d7fv7YC74QjZGDDHZMCDnwJ2Psrz1CzmNy62wxBSaQZXs8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OM3-oqy7beVgaATZFbYKcrMTX2N6St7hhjLr6EL9qew&oe=69EB6E0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
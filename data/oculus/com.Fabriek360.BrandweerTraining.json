9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyA7Ncn9oPkQ7kNvwGkgQg0&_nc_oc=AdowWZXv6aoSeC66-_logOKX8M2_SnUfJMIpiVwBOGbmoFqB0hw9mQI33pGnmfYyi0c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2ly0vFDSkcShZTPKODCkcg6gCwNHMUDHlPLrn7FQJew&oe=6A6C9A2B"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54QQBwU3LmkQ7kNvwGyE1nW&_nc_oc=AdrPDkaFhqKZIAu1Ndg_4oPa4wT2hF7CGcs5LDSvM-3FoWLkztWhtrEW_RgGm6wAY1s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPaXQx3Q4iXjoQWlyVlTGZksjcbYLBVVuGf0xURczz9g&oe=6A6CA10E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
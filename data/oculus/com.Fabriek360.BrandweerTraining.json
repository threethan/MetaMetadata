9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7WKrIOnLO4Q7kNvwEmsZgE&_nc_oc=AdqIKcy3eJPWcLAHUqtu0TLZ09MpqxChCFiuitB1D1nYqo21cN_nglUka7a3trdETUA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KyFhEkaUnAYB5Nsz0Gf72DYPWe5jYJsOJxUJIOgal3g&oe=6A4118AB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaD2sPRsE1cQ7kNvwEYiYfk&_nc_oc=Ado1Rf6oU7ylXWG374qEGGJjyDMSHnhXKisS0-YRkSQH-9U5V3OFTzUOQ0BBDaqRVdA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wO5Xc22nc9QRaYlYj8DMQ-FruwWylaE37bldl4fKuWw&oe=6A411F8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
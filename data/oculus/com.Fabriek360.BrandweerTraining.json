268618_1364621797799931090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1GpaOQAi7wQ7kNvwEkluek&_nc_oc=Adm8LDzaNyperRsbGrMDQ-9XvIDdK7zESypLE0Hh2NORCwox-rx2l3SR-HE69D-GDoQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw7FgdblqDyXFGOMUbFN9YvZ51AvvHhGkp9VrxFl6dCSA&oe=69B56DDA"}, {"file_name": "output-onlinepngtools (3).png", "id": "657572276324679", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036639_657572279658012_1303427984154632485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2M91QsTk_3wQ7kNvwG4g-tS&_nc_oc=AdkZpCaEe9_PD-mNbQypCmUr5wETtqBD0l4XZwOW6Vdx7C91qv3Url8KNZQc9OaxR84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7I7M5LYUEAjLV7firnUxsLMLODEtVQuKTSWZSah6axA&oe=69B53CCC"}, {"file_name": "output-onlinepngtools (1).png", "id": "294928059850612", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001660_294928063183945_7385450336746089819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKAALweY8QwQ7kNvwFYoktI&_nc_oc=AdlLrH1kBIXXwSS5JVLDqT-cI69PumubLqpumnqi-mC3gO6Vii_BSDFykl2CokUZnsY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx86jZsYo-j0Kpv3BkuPoKxKy0rQ3HPM3RLJqUNvStxgQ&oe=69B559AB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNIc1GDIE3UQ7kNvwH6Xs5Y&_nc_oc=Adm2fVgJCRR14u2EclVpBwhtWU4HJwiNHeRSLRULqjQT2sQfQuTdk6XdR_-8VGgOmgE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5PSgK5ovENVD-gBABaKbupfccyn7zlhDjsgGxOEPSVQ&oe=69B5608E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "360Fabriek", "support_website_url": null, "website_url": "https://360fabriek.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2254023488125737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75422395_834104061508721_4330100440292118006_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJwH1O2ShmcQ7kNvwEoSiV7&_nc_oc=Adn5T8YBVY5EKwZFr-xM
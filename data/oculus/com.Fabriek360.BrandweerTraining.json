9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oHr2cSWj1oQ7kNvwHFNpdT&_nc_oc=AdoA98gHLx67cpPlR_yqr72n6mXvDgtSychfFhw3I-DDPcU5xY3OSePAN5M19Q3XfB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQZt5KxXVS-dey2KDIltip0OxhEEDoKvgcwczce01PJQ&oe=6AAA90AB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WR7axlcRBj0Q7kNvwEX63ZE&_nc_oc=Adq_Q6YlHKfxad1C26-87U4c_tVsm0wUBW0kU_FN7LICySeqv46EoaEeey1fWB3LuwA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJL7X58RlInMblxmzaC8ERg0BTcqLkPpRounLM8yjINiQ&oe=6AAA978E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
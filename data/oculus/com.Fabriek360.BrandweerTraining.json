9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2b_46d95yo8Q7kNvwEoFjJ9&_nc_oc=Adof1Pf3Nzj18QidWyxqQ6xMJJ4GEUS2SwWPdqPVe5gZLW6JbFc8quvcc393R4TZaR8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzsUyhj8uhtpWwZEDtsM1d-d5DO-p1w3vRkycJHLsqxA&oe=6A5B76AB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=078KVqAl7gYQ7kNvwFfxAvi&_nc_oc=AdoFbYONz4yUv2V72t-T_JRid_yxqs_FjaxlZOtIPss-XtAjHIcABDqt9Hkh05r5qIk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACmATtzjWC9J-l0Xok7U44YPXx_UUUCH6iC1HQ6sQfDQ&oe=6A5B7D8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
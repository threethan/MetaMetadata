9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84zQJ37YL_IQ7kNvwE5Em67&_nc_oc=Adp4xQ3TQip_BcUXc9QDpeZAwytCLCizs9NEnu9VOqVY9_0sM70tUsn6XDUYRy1Fkn8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrUCU7tCU7z2XzUdDmPMaUsLyrzFhU9G2nRjD1wP5a0Q&oe=6A86F82B"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6weey29rQ0Q7kNvwEKWyee&_nc_oc=AdrMcEgphOsW2WtBoHRYxABOESAdda6GSUfNSbSaih9boZpC6HvIioZU9q1d_sTTOZA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbKfjy0v9vd_ddv1890rxcTnO_5JBAiCtH7-Iq9a_BbQ&oe=6A86FF0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
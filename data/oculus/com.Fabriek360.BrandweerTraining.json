9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_F4g2umhtEYQ7kNvwH96brt&_nc_oc=AdpfArx6myZyouttIAn_60aGPFtngfiFtMZsWuOZ_IVz8mA-TS8QnuWO7y0niSoFTpw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjCpEnP6ij0Xs2Tpi62jp_8bB-3t7JphPhfbTdWQF6Ig&oe=6AA54AAB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OvYdahcpkdEQ7kNvwG8APDG&_nc_oc=Adp7YYkyUjsRUP3mwydvR9-pt-oBFrRQnAnlEsUXF6nWd6gblV6RC2TEyQ7qxVExSHE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPcckSR1qQIfaK8yJlFQ3WiCYQ6rp08e1AaMxnwoWn1A&oe=6AA5518E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
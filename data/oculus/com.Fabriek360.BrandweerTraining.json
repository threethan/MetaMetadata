9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTfbDe8HbToQ7kNvwH4YUy2&_nc_oc=Adr7jLVTLbO7ZrtiDkr6k06ewhlhIGP7a6msBvcErN95GqDWMXHhk7lKwHy6vW9-Iug&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xeqSyYC-JefUHUXVXTI3YIs2nvHLjtXx1QBSnoq67Eg&oe=6A3D5C6B"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBsujIhrbAIQ7kNvwHQdaQr&_nc_oc=AdpaActW4TldtFlqpDiRfIe94axNCCT5wgVycWzoBVp3eqZWNCFX7J42LIrINM-7vsM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Bzp00D2wu9kt3sCZcz7-ZIV1exQcu4WxCxb7LpR4blg&oe=6A3D2B0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
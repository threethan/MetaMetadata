": "353671456990590", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inU-is9XTkAQ7kNvwFjpk1l&_nc_oc=AdnhO6RBtjwPT8dJ5Y9v7hbbdOSvxFg_ZVCgjje6GgtC0cfxLfKbNcNiYjOSSIMLs3s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfseKwQquv2j1NtSJoeWqqRsjzxZey-ndr9xjbOnaL5bOg&oe=69A58E8E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "360Fabriek", "support_website_url": null, "website_url": "https://360fabriek.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "ext
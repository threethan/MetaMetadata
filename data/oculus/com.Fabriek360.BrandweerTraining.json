9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFvUfgKXpSAQ7kNvwFgKUpz&_nc_oc=Adp7C5L4sJifGrXQVpK2RuOVR1rlD2bPbF4SAXj8-_2dAKJbxHzmR0fMh3kUfgxaddo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nGLIwjTGn15w-wsZrLrsWyagS3Z5lGDD3D__W-Gtq6g&oe=6A1ADD2B"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWuMB1PBjP4Q7kNvwE6VlYp&_nc_oc=AdqUj2UkimhV_YrXdPyqAYs5Xytm1HJHDQZIQASee78trpjNyQ3aQB-fI-0yynD4iW4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XKtuU8A2x56Yd8TqAffhPzKdYlWcltCsHWMDA7cEvcw&oe=6A1AE40E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
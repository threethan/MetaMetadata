9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rgBQSjjADGwQ7kNvwHs5YFX&_nc_oc=AdqJBHv3HBV7ostT4LW9hOxeofwnkwCcssgJ8r9QK8lv6ZQjYTnMM8QUk2xjf0Ee-r4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQfiiHLnjbAibOr_6pzr8VSAGONzLB4WZk8_M2tIyiBA&oe=6AF9E2EB"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5tOSfqxUrgQ7kNvwH59v-6&_nc_oc=Adr0woBDhL7xANdZLYQFJhL_S5bnOzxRPAcG6hfjVwGdPyFAqQNCWMh3W0nKpMNGExk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRqbcEn6A_GadwDa9P6KG_6Jtj_5-ePZawd9OjpGo1Ig&oe=6AF9E9CE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
cdn.com/v/t64.5771-25/38974800_720034573268618_1364621797799931090_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zFHf_a2ZKqcQ7kNvwEYZvcH&_nc_oc=AdogBQTNErJICYgWX8FsWvLl-ZfW_lg9kqfnQJls13F91KTzE3CwM5vKP6m5p8QLSFg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KP0frUWt7HcqGGTbhn-3fvsE5fA-6YJPRIGc3KBhOXg&oe=6A22DA5A"}, {"file_name": "output-onlinepngtools (3).png", "id": "657572276324679", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036639_657572279658012_1303427984154632485_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEduSYSLuXcQ7kNvwHTAdyw&_nc_oc=Adq5Z2SOC1XlbtStHp9Fh_qTuj5KjhqOfDC8oBs2v5zWYzA5TW28M5aXfhJXkPAM8F4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NNgO_zADe-DDGpHwmYpTtP7-jMRTbUYqsXbkmKReL3Q&oe=6A22E18C"}, {"file_name": "output-onlinepngtools (1).png", "id": "294928059850612", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39001660_294928063183945_7385450336746089819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrLO-virpxUQ7kNvwFtKrk0&_nc_oc=AdpkwowK1IqKFji5ZkiOiR7ZH2iMjDKvRtXO6HXl4SU_haP39Q45FNVBU9asrsha5CE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Bm_eLoOrVzWsXOl9cW8Ll-O8GERJrym8OYI0g-je7BA&oe=6A22FE6B"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1CkA3qoeigQ7kNvwFiPCmW&_nc_oc=Adr6sOQ-qfDUr13AGveLpp5djdcXybHuRl31ub94bky-UgTPgC8uQgcVfzG03vr3kbQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UFXE-e_IL8Y5mlC5UaBgwgT8xXpfpypnwRIkZWui85w&oe=6A22CD0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_terms_of_service_url": null, "publisher_name": "360Fabriek", "support_website_url": null, "website_url": "https://360fabriek.nl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2254023488125737"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/75422395_834104061508721_4330100440292118006_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&
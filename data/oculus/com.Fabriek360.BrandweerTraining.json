9819_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=752ur5Fvax0Q7kNvwEMceyG&_nc_oc=AdoFel57llQw76i7O7egBArIs7ZM8biQSTk33LJk6woayyMLllbewRYR4m8qNr8Urvc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEszRBwoot3RRCpFJyJfH9n8zJO_bNY57-H78VFRaQq0g&oe=6A77262B"}, {"file_name": "Output2.png", "id": "353671456990590", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031591_353671463657256_5555128654169097250_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OP3jdFMUTq4Q7kNvwFV0nPj&_nc_oc=AdrPCfn3k-qiPd034W3qmlCLJ6Eel2jL84e7H3Mc3sOUU_n7dDqyhVVNr5vLCEEcziU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGAunExiBYIe0Wh-2k_Z2yt9Aw7AmeAKIFONM_VGwb-8A&oe=6A772D0E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brandweer Training", "keywords": [], "long_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals.\nIn total the application holds around 25 training scenario\u2019s mainly focussed on learning how the pump works. There are several types of pumps, training scenario\u2019s and error scenario\u2019s created for it. Also it holds scenario\u2019s on how to use the light poles and equipment racks.\nThe application will be in constant development.", "short_description": "This is a Virtual Reality training application made to be able to train on Dutch firefighting equipment. Several firefighting (pump) trucks are completely digitized and lot\u2019s of training scenario\u2019s are added to learn how they work. Primarily interesting for firefighting enthusiasts or Dutch firefighting professionals."}]}, "developer_name": null, "developer_privacy_policy_url": "https://360fabriek.nl/privacypolicy/policy.pdf", "developer_t
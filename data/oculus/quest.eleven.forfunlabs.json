inary": {"__typename": "AndroidBinary", "id": "29130138686628678"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2108450385907495"}]}, "change_log": "0.444.2", "created_date": 1795666055, "id": "29130138686628678", "version": "0.444.2_2026.11.26.4.2.8.582", "version_code": 217828928, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1995434190525828", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29130138686628678"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795661968, "id": "29129594946683052", "version": "0.444.1_2026.11.26.2.54.8.986", "version_code": 217824848, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1995434190525828", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29130138686628678"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795643580, "id": "29127388896903657", "version": "0.444.0_2026.11.25.21.47.20.771", "version_code": 217806440, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1995434190525828", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29130138686628678"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2108450385907495"}]}, "change_log": "0.444.0\nMixed Reality and Portal lighting: Switched gameplay lighting to directional, using Studio\u2019s shadow settings and a 2\u00b0 tilt toward +X. Removes the spotlight cone that could leave high balls dark.\nLobby filters: Fixed the right-panel Filters button being inaccessible when no players matched the filters.\nMatch length: Fixed incorrect best-of button wiring and opponent-selection indicators that could lead to unintended best-of-one matches.\nMatch preferences: Accepting an opponent\u2019s configuration no longer overwrites your saved preferences.\nBest-of-one restrictions: Saved preferences are corrected when the server disallows best-of-one.\nAvatar initialization failure: Tracking, outgoing pose information, and replay recording continue even when the local Meta avatar SDK fails.\nAvatar failure reporting: Retained the server event and notification, but disabled automatic full-log uploads.\nStartup timeout: Limited the server-status request to 10 seconds.\nBundled content: Reuse shipped catalogs when their version equals the cloud version, avoiding an unnecessary catalog download.\nVersion handling: Trim whitespace from version strings to prevent invalid archive names and upload paths.", "created_date": 1795626814, "id": "29125067380469142", "version": "0.444.0_2026.11.25.17.8.3.749", "version_code": 217789683, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
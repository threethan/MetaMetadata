d_binary": {"__typename": "AndroidBinary", "id": "26190003560642220"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2108450385907495"}]}, "change_log": "0.404.15", "created_date": 1775161793, "id": "26190003560642220", "version": "0.404.15_2026.4.2.20.20.11.490", "version_code": 197324411, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1995434190525828", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26190003560642220"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2108450385907495"}]}, "change_log": "0.404.14\n-updated some game login functionality", "created_date": 1775098612, "id": "26181414458167797", "version": "0.404.14_2026.4.2.2.38.17.866", "version_code": 197260697, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1995434190525828", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26190003560642220"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2108450385907495"}]}, "change_log": "0.404.0\nupdates:\nlighting/shadow update in environment in prep for table swapping. The table will appear a bit different because the top isn't baked lighting any more. So no more distracting shadows on top - especially in the studio.\nball motion blur finally in the game, it only took 2 years \ud83d\ude10 \u2060improvement-ideas\u2060 . There is a new menu called 'visual' in the ball menu. There is also a little demo panel showing the ball appear at different rotation rates and it allows you to play with the rate and logo boosting.\nvarious improvement or staging for replay analysis\nstaged  table tennis rule fix: currently the center of the ball is being used to calculate table boundary rules but it should be the edge.\nadded @proman77 's Telegram tournament bot external linking tool to the external links page\nadded render latency display on graphics page\nfixed bundle loading bug that would cause users with no wifi to not be able to start the game (in the  previous preview branch...maybe in live..not sure)\nexternalized a lot of assets to help facilite mini upates.\nadded special new rendering mode (no news stories use it yet though)\nadded an easter egg. Don't ask me, I won't tell. (but i will say it is not something that should be accessible during a match or online)\nfixed fresh-start rubber selection error\nsignificantly improved log viewer\nfixed some file sharing tool stability issues\nadded mini loading screen (you might see a frame of it, or a bit more depending on your internet connection)\nadded a stress test tool so we can test things before we push them out to users\nadded a network diagnostics tool. If anyone in russia is having an issue, reach out to me. I am curious what this tool now shows. It allows you to test multiple destinations in parallel...so you can see if the issue is you or your opponent...and see other things.\n\n\nstill in process:\navatars: we will be pushing a version to some preview location (but not connected to the main server) so people can test. We are still honing in on the IK but we are getting close. We haven't done a full performance test on it yet.\ntable swapping functionality: most of the work is there, so next patch will likely have it\nreplay tools: some cool stuff on the way\nmenu ui/ux improvement on the way (i wonder if this is what the easter egg is about)\n\nmoderation:\nwe've started banning or restricting more and more people. Remember everyone - replays capture toxic behavior and toxic behavior isn't acceptable in this community. More moderation tools will be coming soon. \n\nadditions\nadded relay probe ping count to help with connectivity. In some places (russia for example), the ISPs seem to be blocking connections to some relays (and server). This confirms that you have connectivity to a relay beyond the first few packets before confirming it with the server\nadded environment sound slider. This is only useful in Tokyo but you can now change the ambient sound level there\nmore work staging future nice replay analysis features\n\n-fixed  multi person spectating breaking score reporting when the host is a non player (thanks for the logs @JeffG01 )\n-added externalized server ip system (will be moving to a different AWS region once everyone is on)\n", "created_date": 1775016570, "id": "26169920985983811", "version": "0.404.0_2026.4.1.3.40.22.809", "version_code": 197178022, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1995434190525828", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26190003560642220"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774620713, "id": "26122128800763030", "version": "0.403.12_2026.3.27.14.6.2.899", "version_code": 196783562, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1995434190525828", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26190003560642220"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1774558417, "id": "26114396521536258", "version": "0.403.11_2026.3.26.20.8.29.99", "version_code": 196718909, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
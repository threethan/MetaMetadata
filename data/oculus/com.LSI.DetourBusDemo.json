&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvumNd5TTBlDjhDwiRwKBlRlFDXnNyySZ7NhswBuVCQqg&oe=69A586CD"}, {"file_name": "DetourBus_MaxVelocity_169.png", "id": "674612656986098", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575358_674612660319431_7744869453757794187_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPON0p7FKYIQ7kNvwFmjcP0&_nc_oc=AdkTsWS7TAriFP2j7zCZG4Jy3CLWHYuKPbqdc5XVlvk4suQuUxoYr1LDJCYEOvzxUlk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftCLeCofr8UxqZirgsYFpuhOmGc71emg7kP5ip9KXwZxg&oe=69A56887"}, {"file_name": "DBBusmore.png", "id": "378079580544541", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_378079583877874_3988563265796264783_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gXLD0cFDoIQ7kNvwEtBayg&_nc_oc=Adn7oeAqHsyfVm-muDDx2c6xRvgMv-y4DIKoKhJVV8om3D6-3Xh_VcB0H_fI9anzaqc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftICiJUoghL2OS7_6W46ax9MNnPrUPB3Zmz8Ltc887AdQ&oe=69A59FDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "509747380621677", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031591_509747383955010_7293900799620714682_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-XcCKuFm6IQ7kNvwHx4rmM&_nc_oc=AdmbfPyVfchiVzmuhS1EFSx69v8bBq4KRBErJ6ii-vxjpno83YdEY55mRFZB9j-JCDE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvG5HxeLvXB8-rfjiH_58vhL6gJbnzC_vy8m8XosRqqmg&oe=69A572BF"}, "display_name": "Detour Bus Demo", "keywords": [], "long_description": "ARRIVING SUMMER 2022\nTHIS DEMO INCLUDES THE FIRST LEVEL OF DETOUR BUS\n\nDetour Bus is a VR construction-comedy adventure, where you build ridiculous winding highways, to take the dysfunctional Flowers family on a road trip across Post-Infrastructure America. Nostalgia junkie Daddy Flowers aims to revive his family's bonds before the end of summer vacation, but stuck together in a restored microbus, workaholic Momma, communist-in-training Junior, and social-media-baby Goldie have a lot more to fight about than unite over. Meanwhile, the open road is under threat; you'll have to get in the construction groove to take on corrupt Senator Joseph McCarthief\u2019s attempts to turn all freeways into pay-to-drive tunnels and reclaim your right to transportation.\n\nAccessibility Considerations:\none-button controls\ncaptioning\ndyslexia friendly fonts\nartificial locomotion incl. snap turning, smooth moving\nheight calibration\none-controller mode\nno-reach 3DoF mode\nbuttons-only mode\nfull button remapping", "short_description": "Snap together inconvenient road pieces to build ridiculously convoluted highways, and guide the dysfunctional Flowers family on a psychedelic road trip across post-infrastructure America."}]}, "developer_name": null, "developer_privacy_policy_url": "https://latestageinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Late Stage Interactive", "support_website_url": null, "website_url": "https://detourbus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "787528972229383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39036630_2907597736147795_8878741350611974607_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5Ye9gRBBtYQ7kNvwGP66n5&
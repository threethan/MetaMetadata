0&_nc_ohc=v2WXoYDdiEcQ7kNvwGJkjd_&_nc_oc=Adr2QQXs5Xf_xuG1DptDS0e9XCiTopHXL6GdpAHBLHNOKORrMig0FskmtXHCnrENBaQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vVxNTK3BffAyFbGD8l_bPRFwTTf5FCTinyWGbPotHDw&oe=6A0DAD4D"}, {"file_name": "DetourBus_MaxVelocity_169.png", "id": "674612656986098", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575358_674612660319431_7744869453757794187_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTWWYLD2occQ7kNvwGnOlqt&_nc_oc=Adr0a7rad9Z9DVs9K2lKy_v9iEjbsdDgVklQK0fuF8MSBuMcWKnbbdIsBBX1HaKrhtY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BkKewfHX4KZOxoHGhWNs-XYvq8UWWuV0_AUg5Cd49bA&oe=6A0DC747"}, {"file_name": "DBBusmore.png", "id": "378079580544541", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_378079583877874_3988563265796264783_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eq7pfOElUU8Q7kNvwFYOR0C&_nc_oc=AdrURnu4v_r9OQRVCvM3jXAAkiGZhwbuGm237R1edg59F6_vMTTzHFsGSgj8VG3wx80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6g_YWu8EP1qJ-qX4YWVgre0qCoG1p0EpKAXPTOL679CA&oe=6A0DC65D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "509747380621677", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031591_509747383955010_7293900799620714682_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQcn_yntuFUQ7kNvwEH6YmU&_nc_oc=AdrIMJFgXXqze1-5vwUhkVS7SXpxZ0ZcEh3Bjr-KFFpcAhB6qSsYYRSwRpwntpvrNUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QTFbnceRgyZEEM-nYrIRUZEx-r87lCQaw7XZm8pa0PQ&oe=6A0DD17F"}, "display_name": "Detour Bus Demo", "keywords": [], "long_description": "ARRIVING SUMMER 2022\nTHIS DEMO INCLUDES THE FIRST LEVEL OF DETOUR BUS\n\nDetour Bus is a VR construction-comedy adventure, where you build ridiculous winding highways, to take the dysfunctional Flowers family on a road trip across Post-Infrastructure America. Nostalgia junkie Daddy Flowers aims to revive his family's bonds before the end of summer vacation, but stuck together in a restored microbus, workaholic Momma, communist-in-training Junior, and social-media-baby Goldie have a lot more to fight about than unite over. Meanwhile, the open road is under threat; you'll have to get in the construction groove to take on corrupt Senator Joseph McCarthief\u2019s attempts to turn all freeways into pay-to-drive tunnels and reclaim your right to transportation.\n\nAccessibility Considerations:\none-button controls\ncaptioning\ndyslexia friendly fonts\nartificial locomotion incl. snap turning, smooth moving\nheight calibration\none-controller mode\nno-reach 3DoF mode\nbuttons-only mode\nfull button remapping", "short_description": "Snap together inconvenient road pieces to build ridiculously convoluted highways, and guide the dysfunctional Flowers family on a psychedelic road trip across post-infrastructure America."}]}, "developer_name": null, "developer_privacy_policy_url": "https://latestageinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Late Stage Interactive", "support_website_url": null, "website_url": "https://detourbus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "787528972229383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2
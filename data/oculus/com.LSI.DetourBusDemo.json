4_3988563265796264783_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eq7pfOElUU8Q7kNvwEtA_dd&_nc_oc=AdromzQM7MTT4Ktbcvkl4HB7oDYzOk7kr96TI8LPwOLNdy5-HfQ9rfqCD8G7R3O1Wv4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RiOO_Shpb5flOCAfjs2jQSmB-pr_KR5600i9jWqy-CQ&oe=6A10695D"}, {"file_name": "DBAnimals.png", "id": "189157726641530", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974797_189157729974863_5292858727758345177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KN9l3YvOEicQ7kNvwElvot_&_nc_oc=AdogA5AQG07OZuKL62c6lJOALvP9vnaA43csCHa00J5Twwc7hL7QxVuZ956bJV9Bbuo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62OWFekHFLwyIyMralSa7mANjR3KOKcX4YVG1i9-WIxg&oe=6A106F86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DBCoverImage.png", "id": "1068790687282975", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036661_1068790690616308_7779510658910897506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fogANy0ASbUQ7kNvwEM4sVh&_nc_oc=AdoCOb8yJesI8vFH8HfQB-z1rO9rn73HLUC0_-Rg3-vUTRvH6GA5IFDtuuKWD-hCVus&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZfYZLqN2l5bVgkbvsxYSbiTctgRUMMH768G4_S_kKdA&oe=6A104AA8"}, "display_name": "Detour Bus Demo", "keywords": [], "long_description": "ARRIVING SUMMER 2021!\nTHIS DEMO INCLUDES THE FIRST LEVEL OF DETOUR BUS\n\nDetour Bus is a VR construction-comedy adventure, where you build ridiculous winding highways, to take the dysfunctional Flowers family on a journey across Post-Infrastructure America. Nostalgia junkie Daddy Flowers aims to revive his family's bonds before the end of Summer vacation, by taking them on a good old-fashioned road trip, but stuck together in a restored microbus, workaholic Momma, communist-in-training Junior, and social-media-baby Goldie have a lot more to fight about than unite over. Meanwhile, the open road is under threat; you'll have to get in the construction groove to take on corrupt Senator Joseph McCarthief\u2019s attempts to turn all freeways into pay-to-drive tunnels and reclaim your right to transportation.", "short_description": "Snap together inconvenient road pieces to build ridiculously convoluted highways, and guide the dysfunctional Flowers family on a psychedelic road trip across post-infrastructure America."}]}, "developer_name": null, "developer_privacy_policy_url": "https://latestageinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Late Stage Interactive", "support_website_url": null, "website_url": "https://www.detourbus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2444995855643306"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5309029565826348", "version": "0.029"}, "id": "1181848715653580", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4380393272023320", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5309029565826348"}, "releas
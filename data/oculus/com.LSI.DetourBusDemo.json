4_3988563265796264783_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug9MtxhjGycQ7kNvwGiFdtd&_nc_oc=Adp4tF7bmLvgdUJX6-7uf1JvZNbbbir1pFhWKS31sTfOcGStu5OT4cuJa5Bwtrmnjgw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIy0BhlAOMymR16KVdnI7fW1_jgIXtjruNQF8BsMsZ9XQ&oe=6A9D79DD"}, {"file_name": "DBAnimals.png", "id": "189157726641530", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974797_189157729974863_5292858727758345177_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8B4f3EQS9wQ7kNvwFz1QLK&_nc_oc=AdoL4a8AlhpCK4GK7vQsg0P5Ca6xbTdSBb4Oh34yFGeGHFRTREomXZywm1cD3EqFoxU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLd6HK86OzCl5xRuN9H0FAl2d69JM3azO4hcwwnEJzLCw&oe=6A9D8006"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DBCoverImage.png", "id": "1068790687282975", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39036661_1068790690616308_7779510658910897506_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01y7FoZjgf8Q7kNvwHWsPAt&_nc_oc=AdriNzsfb90GP5CBBztGIJWFibpprZm9mBHMVmzZF7V-bnlaSk-07myzUu2E-sGshOs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8QonP9tNixg2se5Sqco71cGMXtdtdH3V13VWMdNrcYQ&oe=6A9D5B28"}, "display_name": "Detour Bus Demo", "keywords": [], "long_description": "ARRIVING SUMMER 2021!\nTHIS DEMO INCLUDES THE FIRST LEVEL OF DETOUR BUS\n\nDetour Bus is a VR construction-comedy adventure, where you build ridiculous winding highways, to take the dysfunctional Flowers family on a journey across Post-Infrastructure America. Nostalgia junkie Daddy Flowers aims to revive his family's bonds before the end of Summer vacation, by taking them on a good old-fashioned road trip, but stuck together in a restored microbus, workaholic Momma, communist-in-training Junior, and social-media-baby Goldie have a lot more to fight about than unite over. Meanwhile, the open road is under threat; you'll have to get in the construction groove to take on corrupt Senator Joseph McCarthief\u2019s attempts to turn all freeways into pay-to-drive tunnels and reclaim your right to transportation.", "short_description": "Snap together inconvenient road pieces to build ridiculously convoluted highways, and guide the dysfunctional Flowers family on a psychedelic road trip across post-infrastructure America."}]}, "developer_name": null, "developer_privacy_policy_url": "https://latestageinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Late Stage Interactive", "support_website_url": null, "website_url": "https://www.detourbus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2444995855643306"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5309029565826348", "version": "0.029"}, "id": "1181848715653580", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4380393272023320", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5309029565826348"}, "releas
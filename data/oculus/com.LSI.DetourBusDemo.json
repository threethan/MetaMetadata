WkyCnstw&oe=6AFB386D"}, {"file_name": "DBStorm.png", "id": "1287665691667265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031562_1287665695000598_3589077205279925176_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=Thn6oHouXFAQ7kNvwH_p02U&_nc_oc=AdoygdvRRFyXLECkTTefVOz1Yy-JpKcHh3zAf4XfXv3LXBUjnN0bhWedYucJtX7RLn8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9zFWgpe1YPJQiPoyW9OSmSA1nlIUoxCi0WQmqorSS9w&oe=6AFB338D"}, {"file_name": "DetourBus_MaxVelocity_169.png", "id": "674612656986098", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575358_674612660319431_7744869453757794187_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otSvs70ICSsQ7kNvwFOWoKi&_nc_oc=AdoGUrPaCOUrZ6gpNpJgw5683mnE9P-QhZNdMnOAzr4b5WloORO7Z4MAtrxynGmS1_A&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLsa8wXilSOz5itgZBqN6I4vWdS4qqgK1w0MtiUJUrZg&oe=6AFB1547"}, {"file_name": "DBBusmore.png", "id": "378079580544541", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982720_378079583877874_3988563265796264783_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRdJN-4Oj0IQ7kNvwGytvLe&_nc_oc=Adq2TsdrZK6muCPjERwilSJkKlrwRsG23wTWj6ecyRluJHwoVGUkqbA49UxfjNMZ214&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS68zoj5CG_eCV1wAwgWbl0evx41vCOGWOKR6_B-PlwcA&oe=6AFB4C9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "509747380621677", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031591_509747383955010_7293900799620714682_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7TWKGgkMnkQ7kNvwGOn9uV&_nc_oc=Adp12uWh8XTG-GcmYbIO3Zz6DyPO8mLOHKvuPSXZOeYunNulYmoJk4sHZ8UkkzyGgII&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBhU1isqHVXJsg5bNmGL1Lnik3lFSvU7LZTUuYBxiXDQ&oe=6AFB1F7F"}, "display_name": "Detour Bus Demo", "keywords": [], "long_description": "ARRIVING SUMMER 2022\nTHIS DEMO INCLUDES THE FIRST LEVEL OF DETOUR BUS\n\nDetour Bus is a VR construction-comedy adventure, where you build ridiculous winding highways, to take the dysfunctional Flowers family on a road trip across Post-Infrastructure America. Nostalgia junkie Daddy Flowers aims to revive his family's bonds before the end of summer vacation, but stuck together in a restored microbus, workaholic Momma, communist-in-training Junior, and social-media-baby Goldie have a lot more to fight about than unite over. Meanwhile, the open road is under threat; you'll have to get in the construction groove to take on corrupt Senator Joseph McCarthief\u2019s attempts to turn all freeways into pay-to-drive tunnels and reclaim your right to transportation.\n\nAccessibility Considerations:\none-button controls\ncaptioning\ndyslexia friendly fonts\nartificial locomotion incl. snap turning, smooth moving\nheight calibration\none-controller mode\nno-reach 3DoF mode\nbuttons-only mode\nfull button remapping", "short_description": "Snap together inconvenient road pieces to build ridiculously convoluted highways, and guide the dysfunctional Flowers family on a psychedelic road trip across post-infrastructure America."}]}, "developer_name": null, "developer_privacy_policy_url": "https://latestageinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Late Stage Interactive", "support_website_url": null, "website_url": "https://detourbus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor
0&_nc_ohc=0K8clluBWckQ7kNvwHkEScX&_nc_oc=AdrF5O76sNdwax31JC-Jj7Zfth7nHCdscUZcd9sWKiaD-NkvZVS8V6--kH1nWKAKQpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9B0RHvHTMWUpEL8grEEfm6Qjj-c0PK_WtYTNPlWpxtyw&oe=6A25A08D"}, {"file_name": "DetourBus_MaxVelocity_169.png", "id": "674612656986098", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575358_674612660319431_7744869453757794187_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eq6MOiTx8QYQ7kNvwFGKRZi&_nc_oc=AdqHSyV3l4h4ipQEGSnRjJakbpj5SocGvtoPTD_JV73cj55NR3-hFbXhAz967_ZEIsA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ph3Gjs7qsay2iHIUlzC4J85Xl30bOJ5D7AHR3M7aQjw&oe=6A258247"}, {"file_name": "DBBusmore.png", "id": "378079580544541", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982720_378079583877874_3988563265796264783_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vG5iT5eQ3BsQ7kNvwFK9RLK&_nc_oc=Adohm3EwOEJ-1sTro6v3gBpKj1doHTrC0Qs_VK2UuEZXZohhxOiGJihfnT-KVUXIlDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sAektTv9pIaKy-2428-hKWtxoxxwSwti8HYbt00g2fQ&oe=6A25815D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "509747380621677", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031591_509747383955010_7293900799620714682_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9-xKEVfGHgQ7kNvwFbDPfo&_nc_oc=AdpFkOlffWILsp-cEoTrU6lzBayejd7zBv5FRKofo8PFBGucxydZrJ887o1S1Av1MoI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PqMnPjn7v4Q-h54PsIokTCXgMMwza9wuBGuxYPDOOKw&oe=6A258C7F"}, "display_name": "Detour Bus Demo", "keywords": [], "long_description": "ARRIVING SUMMER 2022\nTHIS DEMO INCLUDES THE FIRST LEVEL OF DETOUR BUS\n\nDetour Bus is a VR construction-comedy adventure, where you build ridiculous winding highways, to take the dysfunctional Flowers family on a road trip across Post-Infrastructure America. Nostalgia junkie Daddy Flowers aims to revive his family's bonds before the end of summer vacation, but stuck together in a restored microbus, workaholic Momma, communist-in-training Junior, and social-media-baby Goldie have a lot more to fight about than unite over. Meanwhile, the open road is under threat; you'll have to get in the construction groove to take on corrupt Senator Joseph McCarthief\u2019s attempts to turn all freeways into pay-to-drive tunnels and reclaim your right to transportation.\n\nAccessibility Considerations:\none-button controls\ncaptioning\ndyslexia friendly fonts\nartificial locomotion incl. snap turning, smooth moving\nheight calibration\none-controller mode\nno-reach 3DoF mode\nbuttons-only mode\nfull button remapping", "short_description": "Snap together inconvenient road pieces to build ridiculously convoluted highways, and guide the dysfunctional Flowers family on a psychedelic road trip across post-infrastructure America."}]}, "developer_name": null, "developer_privacy_policy_url": "https://latestageinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Late Stage Interactive", "support_website_url": null, "website_url": "https://detourbus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "787528972229383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1
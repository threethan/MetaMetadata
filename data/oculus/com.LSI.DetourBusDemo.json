=6B0472ED"}, {"file_name": "DBStorm.png", "id": "1287665691667265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031562_1287665695000598_3589077205279925176_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=w1PXb0yYVMYQ7kNvwH3sNJn&_nc_oc=AdqF0leETsAu748wG0VGjSMA9O9SjM2K3b-tb9iXrIEpwPDo3G2qh57K4oth1_F1iYk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8Fuz33zZt5DHxlvfxATBVysDRg8UwFKhKU31jMAZfRw&oe=6B046E0D"}, {"file_name": "DBBusmore.png", "id": "378079580544541", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982720_378079583877874_3988563265796264783_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RimpgGN7kAQQ7kNvwEKgzJi&_nc_oc=AdrNbZOontyntMB1Yn16flD8-uGjeLAC2LL-fwxYc_fikrKGbFZ7l7gVKqsBIeTjh1M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQttg5sGFp5lKzmU8VkcI6Lq38KuVrfAf9TerSl99BKFg&oe=6B04871D"}, {"file_name": "DBAnimals.png", "id": "189157726641530", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974797_189157729974863_5292858727758345177_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPCnjchvqWQQ7kNvwEySCH9&_nc_oc=Adrpx53u99AbFiAC-602g48OE2XO8SJnd3Kf61_BX8F7rxMmZYv9lhghEBbdLMWrI6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxxfgH6SxEdzrp7Yvb-ojnBuMgslEnf4nu2pELYKAO8A&oe=6B045506"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DBCoverImage.png", "id": "1068790687282975", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036661_1068790690616308_7779510658910897506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nFyy0-xTvcQ7kNvwEJ1lb9&_nc_oc=AdpAlt_gANaaGwrQZSXEhXa-CJ5vo_mktMIkII-4lYYUDDT-HGCIsmqOSi-Cn2KYiiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSqqk_FBGyQqOB7ufAS2JiWZYtqxdC-MNOwcSEVckeKg&oe=6B046868"}, "display_name": "Detour Bus Demo", "keywords": [], "long_description": "ARRIVING SUMMER 2021!\nTHIS DEMO INCLUDES THE FIRST LEVEL OF DETOUR BUS\n\nDetour Bus is a VR construction-comedy adventure, where you build ridiculous winding highways, to take the dysfunctional Flowers family on a journey across Post-Infrastructure America. Nostalgia junkie Daddy Flowers aims to revive his family's bonds before the end of Summer vacation, by taking them on a good old-fashioned road trip, but stuck together in a restored microbus, workaholic Momma, communist-in-training Junior, and social-media-baby Goldie have a lot more to fight about than unite over. Meanwhile, the open road is under threat; you'll have to get in the construction groove to take on corrupt Senator Joseph McCarthief\u2019s attempts to turn all freeways into pay-to-drive tunnels and reclaim your right to transportation.", "short_description": "Snap together inconvenient road pieces to build ridiculously convoluted highways, and guide the dysfunctional Flowers family on a psychedelic road trip across post-infrastructure America."}]}, "developer_name": null, "developer_privacy_policy_url": "https://latestageinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Late Stage Interactive", "support_website_url": null, "website_url": "https://www.detourbus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USE
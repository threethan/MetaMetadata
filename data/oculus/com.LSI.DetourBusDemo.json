=6B0DAD6D"}, {"file_name": "DBStorm.png", "id": "1287665691667265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031562_1287665695000598_3589077205279925176_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=BP7cZ7Iu0JoQ7kNvwEtHfDn&_nc_oc=AdpqjKOPDjVMVb1lutnf6uzqIT5ivURLSXz_DGc9-74oVR1Gi9VKp_fbEa7Hat3F-rA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPP65cPYD30Sbm_u7G4nIIgkivR5mSriD3gOdPFql0lA&oe=6B0DA88D"}, {"file_name": "DBBusmore.png", "id": "378079580544541", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982720_378079583877874_3988563265796264783_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFK05YHHRU0Q7kNvwHEYoDg&_nc_oc=AdpE_XBZj6XRPMkegLvlvIH6P9kkapDFgsGhph44rEHMu2zHHgbj3YFqK1E5fsQGx_c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1NylMDeNSS-bGJnukEMcBzLvTTJzc8mYc4Qq4c2U0tQ&oe=6B0DC19D"}, {"file_name": "DBAnimals.png", "id": "189157726641530", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974797_189157729974863_5292858727758345177_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyKz9c3qoK0Q7kNvwF0oUcI&_nc_oc=AdpeaSr8uhGJy0uw8yzHjeyKm1dDIy2BnUxhMltx40dW1-3jX8hAl-rshNZVNws70yg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQyEmYX2ophtl8TonLR9i1eSP2x2ts5U6ii3Dbqoq2q3Q&oe=6B0DC7C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DBCoverImage.png", "id": "1068790687282975", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036661_1068790690616308_7779510658910897506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1h_XEo1YBLoQ7kNvwGLUTTp&_nc_oc=Ado3syDYxP19xTnQWQzC2n161IPq0uAaYlqyv9wMF-n6obEOPI6XVEa1ZiN4whaOSqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShDtk5wPh7QTuUoOS85t2sHMztc3-AfK1lfrm4UC_HuA&oe=6B0DA2E8"}, "display_name": "Detour Bus Demo", "keywords": [], "long_description": "ARRIVING SUMMER 2021!\nTHIS DEMO INCLUDES THE FIRST LEVEL OF DETOUR BUS\n\nDetour Bus is a VR construction-comedy adventure, where you build ridiculous winding highways, to take the dysfunctional Flowers family on a journey across Post-Infrastructure America. Nostalgia junkie Daddy Flowers aims to revive his family's bonds before the end of Summer vacation, by taking them on a good old-fashioned road trip, but stuck together in a restored microbus, workaholic Momma, communist-in-training Junior, and social-media-baby Goldie have a lot more to fight about than unite over. Meanwhile, the open road is under threat; you'll have to get in the construction groove to take on corrupt Senator Joseph McCarthief\u2019s attempts to turn all freeways into pay-to-drive tunnels and reclaim your right to transportation.", "short_description": "Snap together inconvenient road pieces to build ridiculously convoluted highways, and guide the dysfunctional Flowers family on a psychedelic road trip across post-infrastructure America."}]}, "developer_name": null, "developer_privacy_policy_url": "https://latestageinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Late Stage Interactive", "support_website_url": null, "website_url": "https://www.detourbus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USE
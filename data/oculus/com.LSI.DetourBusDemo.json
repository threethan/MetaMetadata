0&_nc_ohc=qAM1QIk044kQ7kNvwGkTgLO&_nc_oc=Adp1b28_rT4P7c6TwSaXSXKL_h7vL8Qpr324ZvOy7z7UyzAsgwTAJBbqdq2043L1ceg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b3OwsihbxIkjB-C-gu5HEF7GFISLndYL1zoK27ZVDnw&oe=69FB384D"}, {"file_name": "DetourBus_MaxVelocity_169.png", "id": "674612656986098", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575358_674612660319431_7744869453757794187_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8ZMrmLuSzwQ7kNvwFsYdo1&_nc_oc=AdoawgvL-HD4MAqHE1fV2CnKc4QciGmYVn7cvQk669qzUhV5dPvShFO4xMw1v3hAkGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C922X5k2b3ZdDlpIS6FKznBFoqTHWAp2h4j065JvTSA&oe=69FB5247"}, {"file_name": "DBBusmore.png", "id": "378079580544541", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982720_378079583877874_3988563265796264783_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGykkt4DgzMQ7kNvwEfavEM&_nc_oc=AdomSsp1Mi99FNkLNa_DhZjhBCbX9O1gDs2yN74sesJTagvz7zMvRIsOOOWM2YXVE5s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jihmN18ikKeKyreGOUTsVR01WRcPcxpjD0Q-D7NvcMQ&oe=69FB515D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "509747380621677", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031591_509747383955010_7293900799620714682_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7L_7uYnbcFoQ7kNvwFU7pI8&_nc_oc=AdrERsoAjlhDT8AlJdarMJujEQI9Lpk6laMaMtnqHT6ihY4fez8ukS7uqK5JNjAD6gA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TyXCB8LahYgmb3WMYU0V07c9T5X7WQm1XLr_36B0-nA&oe=69FB5C7F"}, "display_name": "Detour Bus Demo", "keywords": [], "long_description": "ARRIVING SUMMER 2022\nTHIS DEMO INCLUDES THE FIRST LEVEL OF DETOUR BUS\n\nDetour Bus is a VR construction-comedy adventure, where you build ridiculous winding highways, to take the dysfunctional Flowers family on a road trip across Post-Infrastructure America. Nostalgia junkie Daddy Flowers aims to revive his family's bonds before the end of summer vacation, but stuck together in a restored microbus, workaholic Momma, communist-in-training Junior, and social-media-baby Goldie have a lot more to fight about than unite over. Meanwhile, the open road is under threat; you'll have to get in the construction groove to take on corrupt Senator Joseph McCarthief\u2019s attempts to turn all freeways into pay-to-drive tunnels and reclaim your right to transportation.\n\nAccessibility Considerations:\none-button controls\ncaptioning\ndyslexia friendly fonts\nartificial locomotion incl. snap turning, smooth moving\nheight calibration\none-controller mode\nno-reach 3DoF mode\nbuttons-only mode\nfull button remapping", "short_description": "Snap together inconvenient road pieces to build ridiculously convoluted highways, and guide the dysfunctional Flowers family on a psychedelic road trip across post-infrastructure America."}]}, "developer_name": null, "developer_privacy_policy_url": "https://latestageinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Late Stage Interactive", "support_website_url": null, "website_url": "https://detourbus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "787528972229383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1
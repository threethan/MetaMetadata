eU8pyMlA&oe=6B0B42AD"}, {"file_name": "DBStorm.png", "id": "1287665691667265", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031562_1287665695000598_3589077205279925176_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=IL6ajPeoVt0Q7kNvwFkgNRs&_nc_oc=AdpWrZgknGBTSXGOPCvUsPzV3XiuGMn8bZ-oDzQUNKxKGwJm1QTWjFKIdPghfHIDujo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTAdOZmnFVcHFeHT2IwkiXUz3BfyQqEQKYjHX41_hIn-Q&oe=6B0B3DCD"}, {"file_name": "DetourBus_MaxVelocity_169.png", "id": "674612656986098", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57575358_674612660319431_7744869453757794187_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwixly0y2V0Q7kNvwFvrySi&_nc_oc=AdoVP9o8XfC-puN3x6VEMESMpQYnkY5sZ_XcKoQcJZI88-eC_HRko6V02lFmC4xQFSs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSGPquXtJGPGyMxkPUOdXlUOw2y-ZJMAhQdHRWEEKSgMg&oe=6B0B1F87"}, {"file_name": "DBBusmore.png", "id": "378079580544541", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982720_378079583877874_3988563265796264783_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFK05YHHRU0Q7kNvwFs9r0t&_nc_oc=Ado1Ar1jhSyvb7A3hAJxN2cHkiZ_oSwt5QS-C4ByKC4j0i9hq06eng4uTposAvX2fG4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR9iC-LfnfcfCRPGKFth4MBiQouIffmgC3bQH7s_n7UFw&oe=6B0B1E9D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "509747380621677", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031591_509747383955010_7293900799620714682_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bjwgCzAsIwQ7kNvwGW-Fgp&_nc_oc=AdpNslBXRsTE5IpKYUssTlcK0CKeFs3Xh6EjOe8wUNxPLu38tu8Ha088vPsMmu0w-oo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ8kgjCEaCeP2HHTuZqYLGtcdB6YAg5XJSu9a043D0e_g&oe=6B0B29BF"}, "display_name": "Detour Bus Demo", "keywords": [], "long_description": "ARRIVING SUMMER 2022\nTHIS DEMO INCLUDES THE FIRST LEVEL OF DETOUR BUS\n\nDetour Bus is a VR construction-comedy adventure, where you build ridiculous winding highways, to take the dysfunctional Flowers family on a road trip across Post-Infrastructure America. Nostalgia junkie Daddy Flowers aims to revive his family's bonds before the end of summer vacation, but stuck together in a restored microbus, workaholic Momma, communist-in-training Junior, and social-media-baby Goldie have a lot more to fight about than unite over. Meanwhile, the open road is under threat; you'll have to get in the construction groove to take on corrupt Senator Joseph McCarthief\u2019s attempts to turn all freeways into pay-to-drive tunnels and reclaim your right to transportation.\n\nAccessibility Considerations:\none-button controls\ncaptioning\ndyslexia friendly fonts\nartificial locomotion incl. snap turning, smooth moving\nheight calibration\none-controller mode\nno-reach 3DoF mode\nbuttons-only mode\nfull button remapping", "short_description": "Snap together inconvenient road pieces to build ridiculously convoluted highways, and guide the dysfunctional Flowers family on a psychedelic road trip across post-infrastructure America."}]}, "developer_name": null, "developer_privacy_policy_url": "https://latestageinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Late Stage Interactive", "support_website_url": null, "website_url": "https://detourbus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor
=6AFB386D"}, {"file_name": "DBStorm.png", "id": "1287665691667265", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031562_1287665695000598_3589077205279925176_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_aid=0&_nc_ohc=Thn6oHouXFAQ7kNvwH_p02U&_nc_oc=AdoygdvRRFyXLECkTTefVOz1Yy-JpKcHh3zAf4XfXv3LXBUjnN0bhWedYucJtX7RLn8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9zFWgpe1YPJQiPoyW9OSmSA1nlIUoxCi0WQmqorSS9w&oe=6AFB338D"}, {"file_name": "DBBusmore.png", "id": "378079580544541", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982720_378079583877874_3988563265796264783_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YRdJN-4Oj0IQ7kNvwGytvLe&_nc_oc=Adq2TsdrZK6muCPjERwilSJkKlrwRsG23wTWj6ecyRluJHwoVGUkqbA49UxfjNMZ214&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS68zoj5CG_eCV1wAwgWbl0evx41vCOGWOKR6_B-PlwcA&oe=6AFB4C9D"}, {"file_name": "DBAnimals.png", "id": "189157726641530", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974797_189157729974863_5292858727758345177_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HfTWxwjJigQ7kNvwEz28ow&_nc_oc=AdqieUfrqcnSESnRJInryUEcQe3sQOFOsjvHnIb4Q75TestVmGFDcT_qGFaEwe11IXQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcPC3fno3YVUicvi6mWPOta3QwhegY0Eu9Q7TrnKGU_g&oe=6AFB1A86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DBCoverImage.png", "id": "1068790687282975", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39036661_1068790690616308_7779510658910897506_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toX-Z_Ky-pwQ7kNvwEnpStv&_nc_oc=Adq_m-7ydaY24OvG-ltyaAH10u7z2UW1Apx4CYBg734c1JgccZi1zo_WRn9uQIrqkS4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ43QwrWpADN9ov5M3c-B205Er6TkN206WDl7rlvZqAQ&oe=6AFB2DE8"}, "display_name": "Detour Bus Demo", "keywords": [], "long_description": "ARRIVING SUMMER 2021!\nTHIS DEMO INCLUDES THE FIRST LEVEL OF DETOUR BUS\n\nDetour Bus is a VR construction-comedy adventure, where you build ridiculous winding highways, to take the dysfunctional Flowers family on a journey across Post-Infrastructure America. Nostalgia junkie Daddy Flowers aims to revive his family's bonds before the end of Summer vacation, by taking them on a good old-fashioned road trip, but stuck together in a restored microbus, workaholic Momma, communist-in-training Junior, and social-media-baby Goldie have a lot more to fight about than unite over. Meanwhile, the open road is under threat; you'll have to get in the construction groove to take on corrupt Senator Joseph McCarthief\u2019s attempts to turn all freeways into pay-to-drive tunnels and reclaim your right to transportation.", "short_description": "Snap together inconvenient road pieces to build ridiculously convoluted highways, and guide the dysfunctional Flowers family on a psychedelic road trip across post-infrastructure America."}]}, "developer_name": null, "developer_privacy_policy_url": "https://latestageinteractive.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Late Stage Interactive", "support_website_url": null, "website_url": "https://www.detourbus.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "PUZZLE", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USE
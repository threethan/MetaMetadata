e=6B0725A7"}, {"file_name": "screenshot (4).png", "id": "674131045305968", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820942_674131048639301_4626934581300845320_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmlS-z8ilVAQ7kNvwFnpIBy&_nc_oc=AdpMPHOUHKts3VePzFRG-6PzaxkXL2sDD-b32f6Cb7OrCKNUeHJjTlNBbaUJch53B3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTES6lZyDbvbHV9lry1FmmPo9oW2qKTyHM2hIi1gi2SUQ&oe=6B071EEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage2.png", "id": "1208129954280516", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473402264_1208129957613849_821264925354298513_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qP4tTkxSaAcQ7kNvwF7vJKe&_nc_oc=AdqxmUtG9C6SqEjAfjY8o4YF4hRyCz1OnNAbOecr7D_iYvXTNnvWGyQg5FHSnkUjC-k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKrjnnIJynX8E38S9BBEbIbo3slRy_71os5lHmW3-hLw&oe=6B072337"}, "display_name": "MiniGolf Odyssey", "keywords": ["minigolf", "golfgame", "vrgolf", "golf"], "long_description": "MiniGolf Odyssey offers a fun and immersive mini golf experience with realistic ball physics and carefully designed courses. Master each hole across simple slopes and creative obstacles. Pick the perfect club for your height and aim for the win!\nWith online tournaments launching soon, challenge players from around the world and climb the leaderboard. Whether solo or with friends, your mini golf journey starts here!", "short_description": "MiniGolf Odyssey takes mini golf fun to the next level with creative courses and realistic physics. Choose the club that fits your height and show your skills. Online tournaments coming soon!\n\nAfter the initial test and practice courses, we will complete the testing of the remaining stages and release them as a future update. Stay tuned!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.com/private.pdf", "develo
lt2xJbwZ7cgwpWpgNAql3AjtaIkL7071IX5B6E_O6Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nwd6s5nVVu2jzj62wV3H_Rv6Kc2qXUL4Hbglit0-Ilg&oe=6A0C69AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage2.png", "id": "1208129954280516", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473402264_1208129957613849_821264925354298513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghRHqREfAvEQ7kNvwHEnduK&_nc_oc=AdqoM2yeDum5S5bumkAi1KihILHRPmTWfx80n8k0kaL-bTT_vtz6Ihaif7JeB3xn9XE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aNUlNfbch8yp5t41gVPXdq8lz8mapXcVv7ONLHb6-6g&oe=6A0C6DF7"}, "display_name": "MiniGolf Odyssey", "keywords": ["minigolf", "golfgame", "vrgolf", "golf"], "long_description": "MiniGolf Odyssey offers a fun and immersive mini golf experience with realistic ball physics and carefully designed courses. Master each hole across simple slopes and creative obstacles. Pick the perfect club for your height and aim for the win!\nWith online tournaments launching soon, challenge players from around the world and climb the leaderboard. Whether solo or with friends, your mini golf journey starts here!", "short_description": "MiniGolf Odyssey takes mini golf fun to the next level with creative courses and realistic physics. Choose the club that fits your height and show your skills. Online tournaments coming soon!\n\nAfter the initial test and practice courses, we will complete the testing of the remaining stages and release them as a future update. Stay tuned!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.com/private.pdf", "developer_terms_of_service_url": null, "publisher_name": "Blazith Games", "support_website_url": null, "website_url": "http://blazith.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"},
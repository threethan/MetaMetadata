YxAPUrj_DWtiJ2X0Wrq-j0vIbw8EkywusN6KlmBNCI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3d2XsfQOatZt-hp64foU8t7_aD3SvbxLWs-v-QaEJHUg&oe=69D267AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage2.png", "id": "1208129954280516", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473402264_1208129957613849_821264925354298513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVT-CgBSGlIQ7kNvwEnTE0M&_nc_oc=AdrzC_tN4KQN6EZXLbzb0wr31W08Hz-ioddbS-DTli-FrYP_fAVrLn9ngB-WRrH5UPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fiaKkd5dVryt78f7T3QGFzy2G6EPkapiZ0iLoBBxBsg&oe=69D26BF7"}, "display_name": "MiniGolf Odyssey", "keywords": ["minigolf", "golfgame", "vrgolf", "golf"], "long_description": "MiniGolf Odyssey offers a fun and immersive mini golf experience with realistic ball physics and carefully designed courses. Master each hole across simple slopes and creative obstacles. Pick the perfect club for your height and aim for the win!\nWith online tournaments launching soon, challenge players from around the world and climb the leaderboard. Whether solo or with friends, your mini golf journey starts here!", "short_description": "MiniGolf Odyssey takes mini golf fun to the next level with creative courses and realistic physics. Choose the club that fits your height and show your skills. Online tournaments coming soon!\n\nAfter the initial test and practice courses, we will complete the testing of the remaining stages and release them as a future update. Stay tuned!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://blazith.com/private.pdf", "developer_terms_of_service_url": null, "publisher_name": "Blazith Games", "support_website_url": null, "website_url": "http://blazith.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"},
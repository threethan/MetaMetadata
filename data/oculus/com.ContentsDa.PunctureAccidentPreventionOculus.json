nside the box to their normal state.\n9. Grab the utility knife and cut the tape starting from the end of the box.\n10. Grab the broom and dustpan.\n11. Glass shards appear with the sound of breaking glass at a random location.\n12. Use the broom and dustpan to clean up as many glass shards as possible within the time limit.", "short_description": "This VR program trains participants to safely handle sharp tools and office supplies through quizzes and hands-on practice. By simulating scenarios like using staple removers and cleaning broken glass, users repeatedly reinforce essential habits to prevent puncture and cut injuries."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDA Inc.", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26441697688761175"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2170229997080189"}]}, "baseline_offer": {"id": "2170229997080189"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772023560, "status": "PUBLISHED", "id": "2170229997080189"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"_
3Y-jU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe_pLfMy7zvy5Y4k4ZNlDyTlud-7P5d0zos3KFQLaM0w&oe=6AFDCA82"}, {"file_name": "2560px x 1440px.png", "id": "3725012581141808", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825050_3725012584475141_8287219692187371184_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kprM7UENqdgQ7kNvwHxOjWI&_nc_oc=AdqN4acem-2LCKHUfDdc6LSA6zoGuzBJUtfUiUrpTQdsj22fe96BdvIAnHqiXL8xAks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDzMVy6nVFXrBsN43QfWuUjKixVZJ_C9uXO5xWEXdmZw&oe=6AFDDBBE"}, {"file_name": "2560px x 1440px (5).png", "id": "1119176736388089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617728_1119176739721422_2461797642791045091_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sv4QL1RSJk4Q7kNvwGmHl9G&_nc_oc=AdryY-w5AuWtwUHRp-nrmof4RKIPYVknYrbhT_j6wLFVkMaIZP0KDR6nXwh0LFfkmsU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDLHGfzFbdjTVxBpKyKD6H-6_z3Hih8HvgQPXmddZtFw&oe=6AFDAC5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Ascent", "keywords": ["Horror", "Parkour", "Multiplayer", "Funny"], "long_description": "\nApe Ascent is a fun game,\nIt lets you play Horror or only up!\nIn Horror you get to be chased by Monsters through Long Narrow Metal Corridors.\nIn Only up you get to jump from prop to prop, hoping you dont fall off. But when you reach the top, you get to jump off!\nAlso its Multiplayer! You get to play with 9 others! Sounds fun. I think.\n\nApe Ascent is a VR Climbing game with Horror in it. Its like an Only Up VR where the goal is to get to the top. But if you get bored, theres always Horror and a new Floor Is Lava Game Mode!\nVery Fun!\nIf you like VR Horror, Only Up VR or Floor is Lava in VR get this amazing game!\n\nThis game is Early Access. Features will be added or removed as time goes on. Why not join the fun now? I think you should get the game. Please. This was Developed by 1 guy by the way. please don't judge.\n\n\n", "short_description": "Run around as Apes in either onlyup  or a scary Horror game mode with many Monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ape-labs-ape-ascent/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ape Labs", "support_website_url": null, "website_url": "https://sites.google.com/view/ape-labs-ape-ascent", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25406168525641546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300910_576899988751970_5674292771980099633_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiEqBqLSbfgQ7kNvwELO8NT&_nc_oc=AdrVl983J6x7JK6fhSKO8aEObMmIdx_BU7wXnEVjI60h3j93l6lmmkvMXWr9D5NOwjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGFVQKplBeZttwsZVpCKNZAg8L60OzQHWpOF_OzC6UMQ&oe=6AFDC7A2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ape Ascent", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1757372400, "lastRevision": {"nodes": [{"id": "251
get the game. Please. This was Developed by 1 guy by the way. please don't judge.\n\n\n", "short_description": "Run around as Apes in either onlyup  or a scary Horror game mode with many Monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ape-labs-ape-ascent/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ape Labs", "support_website_url": null, "website_url": "https://sites.google.com/view/ape-labs-ape-ascent", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25406168525641546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300910_576899988751970_5674292771980099633_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pK__rqiFFgQ7kNvwE_M9bt&_nc_oc=AdqfS07edY7x05ZLzMTN9A1aZhaPJ0T8qUHOYG0OxfgfzHXX-FLmxKVd40A3ilquNoE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQM2fDQ7oRBkG9aY8dDP2d6e4_jRhGNacF0Uu8XX_PFAw&oe=6B0B2EE2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ape Ascent", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1757372400, "lastRevision": {"nodes": [{"id": "251
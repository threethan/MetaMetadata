=I-5dJDSSQv0Q7kNvwEPBN6X&_nc_oc=Admtb2dws_7L2q9pazyWT7qOwYz3qjGBKzinDguDNtQgKfXq9S2HHYqXZfZHRvvc8g4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsAxsHVPJ456Er-0mHO7OCN3QhbXrM-jmmdSSS2HNDxKA&oe=69A6DD7E"}, {"file_name": "2560px x 1440px (5).png", "id": "1119176736388089", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617728_1119176739721422_2461797642791045091_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FHEGjJ-qSgQ7kNvwGAF-2S&_nc_oc=AdmGGvGfA2_1E8CaXovZVahu0RRe4r86ixCEt5GrtkC1HFUqnmbWCHpVT_7XtYH6mHA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftiPs0wfjckNeE0BPzX-l-j3-KRGBDc8by5V5r-lGjgfw&oe=69A6E65D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Ascent", "keywords": ["Horror", "Parkour", "Multiplayer", "Funny"], "long_description": "\nApe Ascent is a fun game,\nIt lets you play Horror or only up!\nIn Horror you get to be chased by Monsters through Long Narrow Metal Corridors.\nIn Only up you get to jump from prop to prop, hoping you dont fall off. But when you reach the top, you get to jump off!\nAlso its Multiplayer! You get to play with 9 others! Sounds fun. I think.\n\nApe Ascent is a VR Climbing game with Horror in it. Its like an Only Up VR where the goal is to get to the top. But if you get bored, theres always Horror and a new Floor Is Lava Game Mode!\nVery Fun!\nIf you like VR Horror, Only Up VR or Floor is Lava in VR get this amazing game!\n\nThis game is Early Access. Features will be added or removed as time goes on. Why not join the fun now? I think you should get the game. Please. This was Developed by 1 guy by the way. please don't judge.\n\n\n", "short_description": "Run around as Apes in either onlyup  or a scary Horror game mode with many Monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ape-labs-ape-ascent/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ape Labs", "support_website_url": null, "web
amnwc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqAktrFeWbM-uh6KrQaaBgVTk9MscVqqobO57LDvxrCg&oe=6B085682"}, {"file_name": "2560px x 1440px.png", "id": "3725012581141808", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491825050_3725012584475141_8287219692187371184_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_E3XrHkxJwkQ7kNvwEWgdK3&_nc_oc=Adox7YplZTrwTNGoCNja1jspvp9rUfS3_zHT7B9hpQv32I9NADc3vgGQ4-sVs11QJIo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3zXbRh-3MR2VkeRbwjw22qZZMHv80NPaQWUB7CLcuoA&oe=6B0867BE"}, {"file_name": "2560px x 1440px (5).png", "id": "1119176736388089", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617728_1119176739721422_2461797642791045091_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iD__ayF9V54Q7kNvwGklh8c&_nc_oc=Adr31EribgTItu_i71cWEzQ0Tht7hP4_jCMAQrYCyuooSzWOleAlT-AAEurTPQ36X5M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTi5jgRz91_xdLhR5zcW0C4vgalUcg49p1iVwFN65b9sA&oe=6B08709D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Ascent", "keywords": ["Horror", "Parkour", "Multiplayer", "Funny"], "long_description": "\nApe Ascent is a fun game,\nIt lets you play Horror or only up!\nIn Horror you get to be chased by Monsters through Long Narrow Metal Corridors.\nIn Only up you get to jump from prop to prop, hoping you dont fall off. But when you reach the top, you get to jump off!\nAlso its Multiplayer! You get to play with 9 others! Sounds fun. I think.\n\nApe Ascent is a VR Climbing game with Horror in it. Its like an Only Up VR where the goal is to get to the top. But if you get bored, theres always Horror and a new Floor Is Lava Game Mode!\nVery Fun!\nIf you like VR Horror, Only Up VR or Floor is Lava in VR get this amazing game!\n\nThis game is Early Access. Features will be added or removed as time goes on. Why not join the fun now? I think you should get the game. Please. This was Developed by 1 guy by the way. please don't judge.\n\n\n", "short_description": "Run around as Apes in either onlyup  or a scary Horror game mode with many Monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/ape-labs-ape-ascent/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Ape Labs", "support_website_url": null, "website_url": "https://sites.google.com/view/ape-labs-ape-ascent", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25406168525641546"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499300910_576899988751970_5674292771980099633_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRvbZWYjhzIQ7kNvwHcx_kq&_nc_oc=Ado2G_gG_tcsvzn8lfzuimf1tgfWHmq5Zm0Kr8-PccLwKev-tdcxJG3Umy2zv9ZsjdQ&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfVhXx3lD6l4C5s5kRcLt3J9DBy9AvdBbzpjIfymAM7A&oe=6B0853A2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ape Ascent", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1757372400, "lastRevision": {"nodes": [{"id": "251
scdn.com/v/t64.5771-25/491823837_2947127558805293_8902146795513635963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svmhT3vS8S8Q7kNvwHLcjjq&_nc_oc=AdpW1t2apQfMeG-IZguemLiyiZZN9bgN3LeoeYHyFyyRc2gYg8n3ejdhYjcywxJMtIY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-msW7gDCnxh9kYS5PobORM_-eQCD6u2TSb3CcmHbsGg&oe=6A1C2CDB"}, {"file_name": "screen_2560x1440_2025-11-18_17-00-34.png", "id": "1178936106916606", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823341_1178936110249939_5433104084324276362_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iRMpsOdmawQ7kNvwHEq4va&_nc_oc=Adr0M2vHJ_0tgxH3GpwsZzu4_OhhMWVqsKqowMyRRiRiT_-xHTgJT4Zj-vFhKGqov-o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jnfpJ2EKjXFmymrRRQRxCRbi4SIUwVdApJui0rTvosA&oe=6A1C2DB1"}, {"file_name": "screen_2560x1440_2025-11-18_17-01-03.png", "id": "1512391463325091", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491825503_1512391466658424_847438906073014752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4Ey15I81dAQ7kNvwECJ-Bf&_nc_oc=AdqLJBinQEbam20aUSNKq7VuSM5OPaucUYy0zgm033bOGlzS0suxy5n9lJs8XdYSAZQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54655McMmyeUjHlybp0uTZDVBZEO48OPrNkUAS7Sb2Sw&oe=6A1C5A95"}, {"file_name": "screen_2560x1440_2025-11-18_17-01-42.png", "id": "1818445175465334", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491824322_1818445182132000_8886032581655626469_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGcLzn0f4bYQ7kNvwHqkyjf&_nc_oc=AdrHKnCJUcNrpK8MNtkzmkOPMAqsVIOwQ7CjtulGnNDcHFdojgpYwHyCOEhnn_XlkLk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HUPcKUsZvBNK6uckZrPocmssGalVAqsmiBiIJeeIyDA&oe=6A1C2A32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2025-11-18_17-03-06.png", "id": "1216434846968803", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491825503_1216434850302136_5904685493237907565_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuQGh_jey1QQ7kNvwH831lX&_nc_oc=Adphvj1t8KGOltnabZ5MXE8WyjavYV3P_XG1tdnpz8D9B6MyzJHU9RzUFlsT2-gBESA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7An4lhnE2KKoq7LGnR7oesO8NuawxL7fMXKk9Ufyup8A&oe=6A1C3FFC"}, "display_name": "Mole a Hole", "keywords": ["digging", "stylized", "casual", "adventure", "loot"], "long_description": "### Overview\n\nDig straight into trouble as a determined mole with two turbo digging paws and a backyard that definitely isn't ready for what's coming.\n\nTunnel downward, collect shiny (and occasionally suspicious) treasures, sell your findings, and upgrade your gear in your trusty van-workshop.\n{1179787653480272}\nBuild out your **figurine collection** - completely useless, entirely cosmetic, and obviously the most important part of the game.\n\nThe deeper you go, the stranger things become. Pipes, rocks, odd artifacts... and rumors of something valuable hidden far below.\n{1505100940740108}\nIs the treasure real? Is it worth it? Hard to say. But you're a mole - and digging is kind of your whole thing.\n\n### Features\n\n- \ud83d\udd73\ufe0f **Satisfying digging gameplay** - carve your way through layers of dirt using your trusty mole paws\n- \ud83d\udc8e **Find shiny stuff** - minerals, odd objects, and underground surprises\n- \ud83d\ude90 **Upgrade your gear** in your mobile van-shop\n- \ud83c\udfc6 **Collect figurines** - completely useless, but extremely adorable\n- \u26a1 **Manage your energy** and plan your trips back to the surface\n- \ud83e\uddf1 **Avoid obstacles** like rocks and pipes that definitely shouldn't be there\n- \u2753 **Uncover a mystery** waiting deep below your garden\n\nDig smart. Dig deep. And try not to think about how much dirt you're wearing at this point.\n{1362817818840778}", "short_description": "Play as a mole digging through a backyard full of treasures, odd finds, and obstacles. Sell loot, upgrade your gear in your van, collect cute figurines, and uncover what waits deeper underground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24239002899107568"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2033676500557666"}, {"status": "PUBLISHED", "id": "2241201113352872"}, {"status": "PUBLISHED", "id": "809407312207101"}, {"status": "PUBLISHED", "id": "1297934288760121"}]}, "baseline_offer": {"id": "1297934288760121"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "2033676500557666"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24966058283068689", "version": "1.0.34"}, "id": "1353014739890173", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24239002882440903", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24966058283068689"}, "release_statu
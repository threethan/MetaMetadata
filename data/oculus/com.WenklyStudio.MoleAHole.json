scdn.com/v/t64.5771-25/491823837_2947127558805293_8902146795513635963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDel2fO4qKgQ7kNvwFAdva6&_nc_oc=AdomPWMwlGUrNkex1J9ErJWPZQ0cldBhO2qcg5HD9paAAE19ag47c3r5kTIv-zGIGUk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89h-vd-66z_LxzpdNwCStLFwst9yvP7e7y7R99V9NUWA&oe=6A3EAC1B"}, {"file_name": "screen_2560x1440_2025-11-18_17-00-34.png", "id": "1178936106916606", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823341_1178936110249939_5433104084324276362_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qpy-IqAmX8Q7kNvwGEkEBi&_nc_oc=AdrdGapkAVi8F2qiCmUyfUNRtVCy3Jr-lg-8i5oqso9kK2a5McRM00Q_loWvefWiwLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VIoe_0Qq-jVEwqrbirPmO7KfuxregsWg_TxBHCFMNHA&oe=6A3EACF1"}, {"file_name": "screen_2560x1440_2025-11-18_17-01-03.png", "id": "1512391463325091", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825503_1512391466658424_847438906073014752_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMFHY6Gzk2IQ7kNvwFVlva_&_nc_oc=Ado04kFqt1fzxwnjoGTiikQlLO4beq6oKpFfnuepZH_lIsjqqxQh0TmAemPvpiR5kc8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HDlqGgkXZWxmJEb_wCLGUhfwzUUop889tR5uOsWd9ew&oe=6A3EA195"}, {"file_name": "screen_2560x1440_2025-11-18_17-01-42.png", "id": "1818445175465334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824322_1818445182132000_8886032581655626469_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYpuIk9M0vEQ7kNvwEOvp2P&_nc_oc=AdrIYVJ04L6IFDjaKDvFigP5Alv1fXnrDjJC_8hRUQOgS8bwRXCfcLYxQrl0CQr3cUU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kX5TpIWtjOCj0XcjDPsPEJyCV5V5LmgD01YhlQEwntw&oe=6A3EA972"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2025-11-18_17-03-06.png", "id": "1216434846968803", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825503_1216434850302136_5904685493237907565_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5QAdIwAAjdcQ7kNvwGDyx8_&_nc_oc=AdrUsj0C6exC31ICs-OkyK2fXZxeIEZ5msmAgUNjkBM93A4ImND8Jod9eYr15iPKADU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kzHoGcTkDK_b17rx146YGBG86XtdtcqMY_YlrM7M5Pw&oe=6A3E86FC"}, "display_name": "Mole a Hole", "keywords": ["digging", "stylized", "casual", "adventure", "loot"], "long_description": "### Overview\n\nDig straight into trouble as a determined mole with two turbo digging paws and a backyard that definitely isn't ready for what's coming.\n\nTunnel downward, collect shiny (and occasionally suspicious) treasures, sell your findings, and upgrade your gear in your trusty van-workshop.\n{1179787653480272}\nBuild out your **figurine collection** - completely useless, entirely cosmetic, and obviously the most important part of the game.\n\nThe deeper you go, the stranger things become. Pipes, rocks, odd artifacts... and rumors of something valuable hidden far below.\n{1505100940740108}\nIs the treasure real? Is it worth it? Hard to say. But you're a mole - and digging is kind of your whole thing.\n\n### Features\n\n- \ud83d\udd73\ufe0f **Satisfying digging gameplay** - carve your way through layers of dirt using your trusty mole paws\n- \ud83d\udc8e **Find shiny stuff** - minerals, odd objects, and underground surprises\n- \ud83d\ude90 **Upgrade your gear** in your mobile van-shop\n- \ud83c\udfc6 **Collect figurines** - completely useless, but extremely adorable\n- \u26a1 **Manage your energy** and plan your trips back to the surface\n- \ud83e\uddf1 **Avoid obstacles** like rocks and pipes that definitely shouldn't be there\n- \u2753 **Uncover a mystery** waiting deep below your garden\n\nDig smart. Dig deep. And try not to think about how much dirt you're wearing at this point.\n{1362817818840778}", "short_description": "Play as a mole digging through a backyard full of treasures, odd finds, and obstacles. Sell loot, upgrade your gear in your van, collect cute figurines, and uncover what waits deeper underground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24239002899107568"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "2033676500557666"}, {"status": "PUBLISHED", "id": "2241201113352872"}, {"status": "PUBLISHED", "id": "809407312207101"}, {"status": "PUBLISHED", "id": "1297934288760121"}]}, "baseline_offer": {"id": "1297934288760121"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "2033676500557666"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24966058283068689", "version": "1.0.34"}, "id": "1353014739890173", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24239002882440903", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24966058283068689"}, "release_statu
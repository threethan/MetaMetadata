wGlcrh-&_nc_oc=AdrFexp3juj0gUriO2391BQhMs9YGa0nfc40vEyPfd_DY8xraVW4Vh3BrtTbRpIDaJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgsjhAqdp0qsFw_804Zsy7iio5o5d-XrrrWBbY8oE5Zw&oe=6B0C83F5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2025-11-18_17-03-06.png", "id": "1216434846968803", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1216434850302136_5904685493237907565_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWNHx8mi-OkQ7kNvwE8nxY4&_nc_oc=AdovIc_a3Ic1OW5VOe3QQKHH24FUW_LBlrRr3g9wk3wysQ_E_DGvrwVTdFi_QDJsZIA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR3mR9-h7YNbUcm4q0LZxEps8x6qNoe8vb5_QyG3AgcMg&oe=6B0C693C"}, "display_name": "Mole a Hole", "keywords": ["digging", "stylized", "casual", "adventure", "loot"], "long_description": "### Overview\n\nDig straight into trouble as a determined mole with two turbo digging paws and a backyard that definitely isn't ready for what's coming.\n\nTunnel downward, collect shiny (and occasionally suspicious) treasures, sell your findings, and upgrade your gear in your trusty van-workshop.\n{1179787653480272}\nBuild out your **figurine collection** - completely useless, entirely cosmetic, and obviously the most important part of the game.\n\nThe deeper you go, the stranger things become. Pipes, rocks, odd artifacts... and rumors of something valuable hidden far below.\n{1505100940740108}\nIs the treasure real? Is it worth it? Hard to say. But you're a mole - and digging is kind of your whole thing.\n\n### Features\n\n- \ud83d\udd73\ufe0f **Satisfying digging gameplay** - carve your way through layers of dirt using your trusty mole paws\n- \ud83d\udc8e **Find shiny stuff** - minerals, odd objects, and underground surprises\n- \ud83d\ude90 **Upgrade your gear** in your mobile van-shop\n- \ud83c\udfc6 **Collect figurines** - completely useless, but extremely adorable\n- \u26a1 **Manage your energy** and plan your trips back to the surface\n- \ud83e\uddf1 **Avoid obstacles** like rocks and pipes that definitely shouldn't be there\n- \u2753 **Uncover a mystery** waiting deep below your garden\n\nDig smart. Dig deep. And try not to think about how much dirt you're wearing at this point.\n{1362817818840778}", "short_description": "Play as a mole digging through a backyard full of treasures, odd finds, and obstacles. Sell loot, upgrade your gear in your van, collect cute figurines, and uncover what waits deeper underground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24966396119701572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819281_825891017163327_78240855128220130_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5wvRCom8VMQQ7kNvwGsCz5x&_nc_oc=AdoMyNen1YMQv-4xt4GlU_CLVpG7xKWlL2RpBRCI-bYC17fWLVHNO21LQ6F_GZVMN2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRjdGdhDT89lo8nSFJEI5PvAu0cMbuIy1m0ANLZbNJtPw&oe=6B0C59B8"}, "is_concep
iseiAC_cx9TW_daUKQDb4H3eyjPdlQ&oe=6A562C32"}, {"file_name": "screen_2560x1440_2026-01-06_17-18-15 (1).png", "id": "1929617857627979", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821702_1929617864294645_8812214811454648353_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B4ER37Ui_9QQ7kNvwFBQLNt&_nc_oc=Adr_bV7ZoCslZzdaf5d8jEgkWb0iwPulJNtuVMD0npTzRVfVV01UZBcZwn8Y34Ti5wc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDy8MsYqxhF6ncPA5uonjyOM7UbTNPvNZfgMUxXvu4IqQ&oe=6A562E54"}, {"file_name": "screen_2560x1440_2026-01-06_15-22-44 (1).png", "id": "1400255505095487", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819239_1400255508428820_8919741490745843174_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUawB7vNH-MQ7kNvwErfy67&_nc_oc=Adr5YHWceT44E22DCv6luXTIYhJEyGB41rhWRpDoeSKHf6-JCe7zHlDNmrqoGsjoyVI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd8Q0Y1WUzS9kzayF8uNnTFX3DL8mrIKGmH2YGkjA35Q&oe=6A564B97"}, {"file_name": "screen_2560x1440_2025-11-19_09-46-45.png", "id": "2947127555471960", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823837_2947127558805293_8902146795513635963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oy7Sze3AxCMQ7kNvwGubl41&_nc_oc=AdrSm0Zm9evezlKm6yXchHkRDauGol-sVWm2cYERm69-5UQ9nIYlH50CLv5pZtaGDtI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAxdVRkcL3cLQrR3m2n04l2IzNBsqR5XzhVj4kuvkGFg&oe=6A562EDB"}, {"file_name": "screen_2560x1440_2026-01-07_18-42-02 (1).png", "id": "25635639449390913", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491827646_25635639456057579_8055309320619537246_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tDqQGP-3PkQ7kNvwGW_ffC&_nc_oc=AdqKLlwwdwo3SZb0UGX67Yr-8zpaE8mmTSz8y5skaoaTdGSfVU1R2Lh9Q6NGZDwWebA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9ulRvhIT0x0dl2jQ_DTO9kwqnSHqL0QA6YNJTPvvi4g&oe=6A562475"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2025-11-18_17-03-06.png", "id": "1216434846968803", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491825503_1216434850302136_5904685493237907565_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBH06iA30qYQ7kNvwG5IXIt&_nc_oc=AdpvCHi-tiFpvsZTurXajyowcRslx2ePYonsjcILkbLO-SAFLzxxgvXXtlWUPu2fWkc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWmdQjTv8AqFJ4026b7pNvu7pgoKHL95154WNJpHOcEQ&oe=6A5641FC"}, "display_name": "Mole a Hole", "keywords": ["digging", "stylized", "casual", "adventure", "loot"], "long_description": "### Overview\n\nDig straight into trouble as a determined mole with two turbo digging paws and a backyard that definitely isn't ready for what's coming.\n\nTunnel downward, collect shiny (and occasionally suspicious) treasures, sell your findings, and upgrade your gear in your trusty van-workshop.\n{1179787653480272}\nBuild out your **figurine collection** - completely useless, entirely cosmetic, and obviously the most important part of the game.\n\nThe deeper you go, the stranger things become. Pipes, rocks, odd artifacts... and rumors of something valuable hidden far below.\n{1505100940740108}\nIs the treasure real? Is it worth it? Hard to say. But you're a mole - and digging is kind of your whole thing.\n\n### Features\n\n- \ud83d\udd73\ufe0f **Satisfying digging gameplay** - carve your way through layers of dirt using your trusty mole paws\n- \ud83d\udc8e **Find shiny stuff** - minerals, odd objects, and underground surprises\n- \ud83d\ude90 **Upgrade your gear** in your mobile van-shop\n- \ud83c\udfc6 **Collect figurines** - completely useless, but extremely adorable\n- \u26a1 **Manage your energy** and plan your trips back to the surface\n- \ud83e\uddf1 **Avoid obstacles** like rocks and pipes that definitely shouldn't be there\n- \u2753 **Uncover a mystery** waiting deep below your garden\n\nDig smart. Dig deep. And try not to think about how much dirt you're wearing at this point.\n{1362817818840778}", "short_description": "Play as a mole digging through a backyard full of treasures, odd finds, and obstacles. Sell loot, upgrade your gear in your van, collect cute figurines, and uncover what waits deeper underground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24966396119701572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819281_825891017163327_78240855128220130_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQHWhGWOnQIQ7kNvwH49M0O&_nc_oc=Adoo2AbabT5uFxxTnfixWbJnWTlzqQqPI_Gs7sUy4k72XGQUMTujmSzuajFyxU-oFc4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDe6VqV46BgwdnIc0hEzIQb7JP_vMBA6c0heFVuppYFiw&oe=6A563278"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mole a Hole", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": 
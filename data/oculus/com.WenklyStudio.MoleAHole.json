AHe-1eEruEnEERmds2UgSFtOL7-a4A&oe=6A259CF2"}, {"file_name": "screen_2560x1440_2026-01-06_17-18-15 (1).png", "id": "1929617857627979", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821702_1929617864294645_8812214811454648353_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wra-J71i94sQ7kNvwEdoSiv&_nc_oc=Adp4At63cU2jgjuEB_eH5m438fNykSUuRBELltaoqJOYje_xiMn5VhJh8EYKOjmVugQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KPFuZ46ZOp0--eVI3I4W7siLErdY5LIeZuSZSQ9lDpQ&oe=6A259F14"}, {"file_name": "screen_2560x1440_2026-01-06_15-22-44 (1).png", "id": "1400255505095487", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1400255508428820_8919741490745843174_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fud7vi53kD0Q7kNvwGqpQUl&_nc_oc=AdpFjnqd6_bXU3TBDHUVy9PzNUqGkdwK7Yy1tugfI7bdNNJL_lJv5TQ0Ykuc8mXEFwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-E-H2j9IYXH0fLvZYM0V_-SfYhlvEOtfV7PEry-ovJuA&oe=6A258417"}, {"file_name": "screen_2560x1440_2025-11-19_09-46-45.png", "id": "2947127555471960", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823837_2947127558805293_8902146795513635963_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atu9OHgFUK0Q7kNvwHMFcgJ&_nc_oc=Adrm0DcsGWgq5qwKe8Kb71ZzHrc3xPsOKhM27wpeFt4ToE_PVMgU_rjnD-a0WUn8KOs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hamAQacsuVQW3m9KpPwljliEBuW74PUa77ryA5tN5Gg&oe=6A259F9B"}, {"file_name": "screen_2560x1440_2026-01-07_18-42-02 (1).png", "id": "25635639449390913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_25635639456057579_8055309320619537246_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CbDiKatS1yIQ7kNvwFNKveL&_nc_oc=Adpz0FujjgxlGezZVLmNOmfJWaLieq_qEkIqSUw6VUG6Pnqz3ZMXvuUrdk4YbE9Er24&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9nFSSRCLmt4qmWzlVFCpiXwotbcLuPFyqywDzdOCv-g&oe=6A259535"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen_2560x1440_2025-11-18_17-03-06.png", "id": "1216434846968803", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825503_1216434850302136_5904685493237907565_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCUhsQP9LnoQ7kNvwHokjS5&_nc_oc=AdrGxexMWZ2UxlLixODzED5ZYgK7Ydf3trhnSmvHh7TDo5vjQRoe9YX4Jyw2lMtfozw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IjMAO9-HgY04uK2WrUOZLAO62hTkltHVEEYblCElLEQ&oe=6A257A7C"}, "display_name": "Mole a Hole", "keywords": ["digging", "stylized", "casual", "adventure", "loot"], "long_description": "### Overview\n\nDig straight into trouble as a determined mole with two turbo digging paws and a backyard that definitely isn't ready for what's coming.\n\nTunnel downward, collect shiny (and occasionally suspicious) treasures, sell your findings, and upgrade your gear in your trusty van-workshop.\n{1179787653480272}\nBuild out your **figurine collection** - completely useless, entirely cosmetic, and obviously the most important part of the game.\n\nThe deeper you go, the stranger things become. Pipes, rocks, odd artifacts... and rumors of something valuable hidden far below.\n{1505100940740108}\nIs the treasure real? Is it worth it? Hard to say. But you're a mole - and digging is kind of your whole thing.\n\n### Features\n\n- \ud83d\udd73\ufe0f **Satisfying digging gameplay** - carve your way through layers of dirt using your trusty mole paws\n- \ud83d\udc8e **Find shiny stuff** - minerals, odd objects, and underground surprises\n- \ud83d\ude90 **Upgrade your gear** in your mobile van-shop\n- \ud83c\udfc6 **Collect figurines** - completely useless, but extremely adorable\n- \u26a1 **Manage your energy** and plan your trips back to the surface\n- \ud83e\uddf1 **Avoid obstacles** like rocks and pipes that definitely shouldn't be there\n- \u2753 **Uncover a mystery** waiting deep below your garden\n\nDig smart. Dig deep. And try not to think about how much dirt you're wearing at this point.\n{1362817818840778}", "short_description": "Play as a mole digging through a backyard full of treasures, odd finds, and obstacles. Sell loot, upgrade your gear in your van, collect cute figurines, and uncover what waits deeper underground."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wenklystudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Wenkly Studio Sp. z o.o.", "support_website_url": null, "website_url": "https://www.wenklystudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24966396119701572"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819281_825891017163327_78240855128220130_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEsPwa4S7PgQ7kNvwFZQ8xb&_nc_oc=AdrpqEIq8CFH-ozbsNl7K_TtWPERO9Po2SJRoaKgQMzL6zp-AWWiRRoioXpCId1g1jg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_U7V00NzWthYZn2unl2QnDrXgtKTiSNThZc0_dt8HI5A&oe=6A256AF8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mole a Hole", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": 
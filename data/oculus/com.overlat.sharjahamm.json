aznw8Fi6av0mRNdHB3LKLI8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXAwfMfbzgiuw6BgrXO_KMZ7nCwGAfHijXodh8zi3HOg&oe=6A623304"}, {"file_name": "Sharjah_Screenshots_03.png", "id": "869617755071667", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75324644_869617761738333_4323955932530907644_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oneUWrf4NK8Q7kNvwE50XM8&_nc_oc=AdrDU2KIJjHgKQRHxm_SRcAyC3P85DVoUdActE0xIYA4apU36stgIETTk6srn0QUADU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN72g1KkkkGMo5aXC_mLNov53kotsWjC2k0N8rh_tZ5w&oe=6A620DC7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_2560x1440.png", "id": "1031079204583294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75361346_1031079207916627_695724529664383837_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiykMgRWnOwQ7kNvwHpi6fI&_nc_oc=AdqY-MxAv4xYJdP1gJ_3L-bErfWZIaBpYJzYh40OkdJW3-0BlLtu2t9zjmNqH-j0-n0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtXdeAJUHaL8XkkqEgkWJYeN_386koP_GzsH0Rh4X49g&oe=6A61FCFA"}, "display_name": "Sharjah Archaeology Metaverse Museum", "keywords": [], "long_description": "# Unleash the Archaeologist Within\n\nEmbark on an extraordinary virtual journey through Sharjah's ancient past. Immerse yourself in a world of wonder as you explore a vast collection of 3D artifacts, each a piece of the region's captivating history.\n\n- **Explore Sharjah's Heritage Up Close:** Uncover hidden details of historic cultural heritage pieces with our captivating 3D carousel.\n\n- **Become a Time Traveler:** Step into the shoes of an archaeologist and relive the creation of the iconic Tomb of Amud. Witness its construction firsthand, from the distant past to the present day.\n- **Discover Hidden Treasures:** Join an archaeological expedition to Mleiha and help unearth its long-lost secrets. Every shovelful brings you closer to uncovering the region's hidden riches.\n- **Wander Through Prehistory:** Surround yourself with the enigmatic beauty of Sharjah's ancient petroglyphs. Explore these prehistoric masterpieces up close, deciphering the stories etched into the stone.\n\nPrepare to be captivated as you uncover the mysteries of Sharjah's archaeological heritage.", "short_description": "Embark on an immersive journey through Sharjah's ancient wonders."}]}, "developer_name": "Overlat", "developer_privacy_policy_url": "https://saavr.shj.ae/pages/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Sharjah Archaeology Authority", "support_website_url": null, "website_url": "https://saa.shj.ae/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8784594821609241"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "452913307583706"}]}, "baseline_offer": {"id": "452913307583706"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1732779900, "status": "PUBLISHED", "id": "452913307583706"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "8779089168826473", "version": "1.09"}, "id": "2215199935494236", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id
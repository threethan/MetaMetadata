ntent-iad3-2.oculuscdn.com/v/t64.5771-25/39031586_812681597657709_1896360666850632235_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Edb_3UpzXwYQ7kNvwEsYmB1&_nc_oc=Adoi7L6shGHP30jIJag7nDpYud0bNbmLn1rF3TZkBu_T1kSMxWFBIBFsOW3Pc9CW12c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH-eNPR8eCrdnB54tgHLXnf-i0fiioSRYXaQtBYdS4Pw&oe=6A5E0644"}, {"file_name": "Sharjah_Screenshots_03.png", "id": "869617755071667", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75324644_869617761738333_4323955932530907644_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kM1wTrBOBjsQ7kNvwG6Ma0V&_nc_oc=AdriYLiqvO1WsuxzjHUEPYloHOC733y9qX66ask43JO4XgKim483EIuWyle2d-g5g0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcDU9j_CZQHmPNDVnIlWil0EKvYVUHofk-cg_WI03mMw&oe=6A5E1947"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440.png", "id": "1721090565291527", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003228_1721090568624860_6387517744975147554_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFXV4UMqccYQ7kNvwHNF_nc&_nc_oc=AdqS4qxJEosqPF5tMyxoMVl8lafcEGhcF6rLLIBhsdtMVvYD6bA2-Qo91CMSCjzMAqQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPgzFXheU0arRpPi__mJ1vIrkrhpjWXNFQrrjl_xvxiA&oe=6A5E2598"}, "display_name": "Sharjah Archaeology Metaverse Center", "keywords": ["sharjah", "archaeology", "SAA", "center", "metaverse"], "long_description": "\n# Unleash the Archaeologist Within\n\nSharjah Archaeology Authority presents an extraordinary virtual journey through Sharjah's ancient past. Immerse yourself in a world of wonder as you explore a vast collection of 3D artifacts, each a piece of the region's captivating history.\n\n- **Explore Sharjah's Heritage Up Close:** Uncover hidden details of historic cultural heritage pieces with our captivating 3D carousel.\n\n- **Become a Time Traveler:** Step into the shoes of an archaeologist and relive the creation of the iconic Tomb of Amud. Witness its construction firsthand, from the distant past to the present day.\n- **Discover Hidden Treasures:** Join an archaeological expedition to Mleiha and help unearth its long-lost secrets. Every shovelful brings you closer to uncovering the region's hidden riches.\n- **Wander Through Prehistory:** Surround yourself with the enigmatic beauty of Sharjah's ancient petroglyphs. Explore these prehistoric masterpieces up close, deciphering the stories etched into the stone.\n\nPrepare to be captivated as you uncover the mysteries of Sharjah's archaeological heritage.\n", "short_description": "Sharjah Archaeology Authority presents an immersive journey through Sharjah's ancient wonders."}]}, "developer_name": "Overlat / 3D Stoa / Global Digital Heritage", "developer_privacy_policy_url": "https://saavr.shj.ae/pages/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Sharjah Archaeology Authority", "support_website_url": null, "website_url": "https://saa.shj.ae/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8888364921232230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036641_974971307786291_7841638312316913020_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_l3j3DDmYtAQ7kNvwE_ik3t&_nc_oc=Adoc2Hw4lR-l5K1LaaFJw5EphzL5I5kGi2tjphMVaGxuGqlljvNDX_0
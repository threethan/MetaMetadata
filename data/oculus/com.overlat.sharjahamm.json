gR1zF-3kE7H23tbA-tTUclr4h9IwNDg6e5BzYOtXkIUQq4SWnfz9VohPeyHEqclk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aft10UOUclmTLFxy3xENPNvGR3JduSTi5nnkT2x0E6rmYA&oe=69A422C4"}, {"file_name": "Sharjah_Screenshots_03.png", "id": "869617755071667", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75324644_869617761738333_4323955932530907644_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5GSROEAyjEQ7kNvwH64RGr&_nc_oc=AdmTNjQBIEbYmCIZEPNQWoAAsyPPbQRA7khQx8KnIZrxgrPh-30hiGmQk2FraDc4WC0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afum0NDGgfDZzjo6ITXy3eNFBl-wHIAJW0NFyNYgMRQSfQ&oe=69A435C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440.png", "id": "1721090565291527", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39003228_1721090568624860_6387517744975147554_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsYB6C24BN8Q7kNvwF3LBbk&_nc_oc=AdltAMSKTE6QN7kOgSQPjuFPCEJ0yoNkqEPoU-hyAuXw9TKUXM5DVVm42B_7Eg9xb9Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs-lez0flKLA2i0_wqG414hkSckeSJbuoDX5qvSfakW-A&oe=69A44218"}, "display_name": "Sharjah Archaeology Metaverse Center", "keywords": ["sharjah", "archaeology", "SAA", "center", "metaverse"], "long_description": "\n# Unleash the Archaeologist Within\n\nSharjah Archaeology Authority presents an extraordinary virtual journey through Sharjah's ancient past. Immerse yourself in a world of wonder as you explore a vast collection of 3D artifacts, each a piece of the region's captivating history.\n\n- **Explore Sharjah's Heritage Up Close:** Uncover hidden details of historic cultural heritage pieces with our captivating 3D carousel.\n\n- **Become a Time Traveler:** Step into the shoes of an archaeologist and relive the creation of the iconic Tomb of Amud. Witness its construction firsthand, from the distant past to the present day.\n- **Discover Hidden Treasures:** Join an archaeological expedition to Mleiha and help unearth its long-lost secrets. Every shovelful brings you closer to uncovering the region's hidden riches.\n- **Wander Through Prehistory:** Surround yourself with the enigmatic beauty of Sharjah's ancient petroglyphs. Explore these prehistoric masterpieces up close, deciphering the stories etched into the stone.\n\nPrepare to be captivated as you uncover the mysteries of Sharjah's archaeological heritage.\n", "short_description": "Sharjah Archaeology Authority presents an immersive journey through Sharjah's ancient wonders."}]}, "developer_name": "Overlat / 3D Stoa / Global Digital Heritage", "developer_privacy_policy_url": "https://saavr.shj.ae/pages/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Sharjah Archaeology Authority", "support_website_url": null, "website_url": "https://saa.shj.ae/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8888364921232230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39036641_974971307786291_7841638312316913020_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pDTeWJLDKMQ7kNvwHzW9R_&_nc_oc=AdmDwefjmijA8E3Lnq0MY4W11Xr1aPRX7Pj4vmLUO4Jh08jQuHdOfM1KRmF88G9Jz3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuvxfNB60MeGp5trfQFLwXFaB9CuRZ1dVOLRci4YBBwYQ&oe=69A44292"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
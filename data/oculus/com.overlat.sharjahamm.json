xP0vuK1KRnmFKanXidkaF07WC6RH4QW5s0L1ini92PPvl-RWB2QdPykqgPGbwgoI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsEEIQuifx0Q5ohqe42UWiw0CnbuvFVux0JjwCceOk6og&oe=69A57444"}, {"file_name": "Sharjah_Screenshots_03.png", "id": "869617755071667", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75324644_869617761738333_4323955932530907644_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5GSROEAyjEQ7kNvwEOjw6j&_nc_oc=AdnKouFwTkSnnJz5UI0v-__Rf4gCFq1AyezMj9NZHwyCejmQRjpRbJzixw3YE9WcwnE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfvyZIlgCpQVeApWTLWB9GKEssDRDoy-KBJXIpV5lmW9AA&oe=69A58747"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape_2560x1440.png", "id": "1721090565291527", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003228_1721090568624860_6387517744975147554_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsYB6C24BN8Q7kNvwFAifJV&_nc_oc=AdmHY4DM85fQI3gpEdfeT0KbXJm9qRBXiATk401ZZ74iY2HUo9kFgmPJhRiPp6THSdM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftsQX3ZzdX87Dl9ll5OSbnewqScakX1qvoy0C2rIcn7fA&oe=69A59398"}, "display_name": "Sharjah Archaeology Metaverse Center", "keywords": ["sharjah", "archaeology", "SAA", "center", "metaverse"], "long_description": "\n# Unleash the Archaeologist Within\n\nSharjah Archaeology Authority presents an extraordinary virtual journey through Sharjah's ancient past. Immerse yourself in a world of wonder as you explore a vast collection of 3D artifacts, each a piece of the region's captivating history.\n\n- **Explore Sharjah's Heritage Up Close:** Uncover hidden details of historic cultural heritage pieces with our captivating 3D carousel.\n\n- **Become a Time Traveler:** Step into the shoes of an archaeologist and relive the creation of the iconic Tomb of Amud. Witness its construction firsthand, from the distant past to the present day.\n- **Discover Hidden Treasures:** Join an archaeological expedition to Mleiha and help unearth its long-lost secrets. Every shovelful brings you closer to uncovering the region's hidden riches.\n- **Wander Through Prehistory:** Surround yourself with the enigmatic beauty of Sharjah's ancient petroglyphs. Explore these prehistoric masterpieces up close, deciphering the stories etched into the stone.\n\nPrepare to be captivated as you uncover the mysteries of Sharjah's archaeological heritage.\n", "short_description": "Sharjah Archaeology Authority presents an immersive journey through Sharjah's ancient wonders."}]}, "developer_name": "Overlat / 3D Stoa / Global Digital Heritage", "developer_privacy_policy_url": "https://saavr.shj.ae/pages/privacypolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Sharjah Archaeology Authority", "support_website_url": null, "website_url": "https://saa.shj.ae/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8888364921232230"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036641_974971307786291_7841638312316913020_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pDTeWJLDKMQ7kNvwH7fy4d&_nc_oc=AdniDreIZ6s5DX3Xeg34OI0W0kEdvEIxT9Ruj9B-nGDlIBgYZXo0Zho2VsOZSErDRTE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftW6vImnvYPm0M1QwUaeiIYfFwa5ARfYtA307hQTiY_FQ&oe=69A59412"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_na
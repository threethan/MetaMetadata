2X2fOQEJDN7yGYydr0MoXvXrXjFe0Duq7e2pOFAkwi7KjUvdEIOnTOrGCM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrwQwbc9KAD_f3_Wxev2IHC2q2flmSbkEvF1t5QlbNaQ&oe=6AFDE4F4"}, {"file_name": "image (3).png", "id": "1016138719771360", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035455_1016138723104693_841052125582355932_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xbaSPsxS_cQ7kNvwHoQEkf&_nc_oc=AdrSpQb9GZ5qHYkNrFUSYf7hzbgOPKlu2w8ZDMoAwPegh1yukaS24OXtqWSJGc6fS14&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJeQl_1E5Aryl_Dv-tza4_Dbu9UQ5ENTfVjIpKo7MloA&oe=6AFDCC66"}, {"file_name": "image (5).png", "id": "115885694791570", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035357_115885698124903_7417904670662466120_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iO0wyxXIRSwQ7kNvwGZv22s&_nc_oc=AdoMVEtKG3mI6pIXWnMjwErE970b-afKWHcIwu0uQ4gAfEbx-k7YOZc5bLLDpj9m1eU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTc-UI4TQYw-U-AQSRgP4ylsa52VhHUHO9PfHpiNr0c-A&oe=6AFDD60D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DownhillBikeLandscape.png", "id": "947940119680763", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974727_947940126347429_8874924691088065496_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUPWQ-6mm2UQ7kNvwGpkCok&_nc_oc=Adpri9kQdRygg1CoX6ldcHVceyd3snRWOSC0Rcn1solE-pirUe_Zr6FeCnFaCAJWYf0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR184Dblc5EvxX46FspIF2AARYbyCL4vdKQnNIotkZ1ZA&oe=6AFDD578"}, "display_name": "Downhill Bike", "keywords": [], "long_description": "Demo Version\n\nExperience the thrill of downhill mountain biking like never before in Downhill Bike, the latest VR game from Nomad Monkey. Get ready to ride through scenic landscapes, tackle challenging terrain, and feel the rush of adrenaline as you race against the clock to reach the finish line. With intuitive controls and immersive graphics, Downhill Bike lets you fully immerse yourself in the world of mountain biking. Take on steep descents, sharp turns, and jumps as you navigate through each level. With multiple levels to unlock and explore, there's always a new challenge waiting for you. Whether you're a seasoned biker or new to the sport, Downhill Bike offers an exciting and realistic experience that will keep you coming back for more. So what are you waiting for? Grab your headset, hop on your virtual bike, and start your ride today!\n\nPlease comment and give us feedback so we can improve the game and implement new worlds for the full version release.", "short_description": "Mountain bike simulation game inside beautiful landscapes and city parkours."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.joygamemobile.com/privacy-policy-vr/", "developer_terms_of_service_url": "https://www.joygamemobile.com/tos/", "publisher_name": "Joygame Oyun ve Teknoloji", "support_website_url": null, "website_url": "https://www.joygame.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "258329783237538"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_re
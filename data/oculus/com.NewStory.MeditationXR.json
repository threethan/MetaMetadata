=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEivAT_h7CRGoYdnbCO8VGux9Beh-mtI9TXid8QbKRFtw&oe=6A7B077C"}, {"file_name": "9.png", "id": "3008511039340491", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620921_3008511042673824_3618723761199456981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vgFnk6omxzUQ7kNvwEX6TG8&_nc_oc=AdqkVFK1SJrc9JHVgBENCilV6Y8K_2hEjqwWabmPGAhhZuDkV_v6cYvNAhuFiDTHKoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGujK9UZuPl_R0TdLvwNWEJtqUUG4-eJvXLCxKcHk9jyA&oe=6A7B285A"}, {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011Mindfula\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8.png", "id": "924207480273465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_924207483606798_8584646791511714785_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzF2ATul8NQQ7kNvwG9btO2&_nc_oc=Adr4_QQrWkPbZf0kgctkEuZNSbothheAwKU1xhO4oc6J5Ng2BkKcu_cu7glDlZCNieQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUkO5Da5qgqOn6omUwjxQDY_MOh76nV-KY0AUDhHcjLw&oe=6A7B1E23"}, {"file_name": "7.png", "id": "943406664877852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619681_943406668211185_3775301792945929841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VL4mXveSkQQ7kNvwH_rKW8&_nc_oc=AdoazeOugnoHKRG0BKMeX_9QshOAGiVz2X_hefjCc1X5NJwonGPw4aw2SmnuH1TIx_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXneVCuXpMWytRhL_mZ1pZbRPmLT3IJF92jxq_m8EIag&oe=6A7B1D51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30e9\u30f3\u30c9\u30b9\u30b1\u30fc\u30d7.png", "id": "915105457741501", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619450_915105461074834_7104290130619930993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfTzRBFL_S0Q7kNvwHritsy&_nc_oc=AdqjcjKjiyqgJBECpAKYe8vP8pdZ9OvqhtrtwLRK2ppgLZSzVNKk0ynhXTeV3w-41tI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWnTpaQMM3DY4u5JwEDPqtV9Hn1ZgB34rVnsMfJX5Idw&oe=6A7B3B6C"}, "display_name": "Mindfula :Relaxation Meditation Cosmic", "keywords": ["Relaxation", "Meditation", "\uff2dindfulness", "Anxiety", "Flow"], "long_description": "\n\n**Find Your Flow. Free Your Mind.**\n\n\nMindfula is a visually immersive VR meditation experience designed to guide your mind into a state of flow.\n\n\nInstead of sitting still, you gently move forward through evolving tunnel-like environments \u2014vast nature landscapes, cosmic spaces, kaleidoscopic patterns, and geometric light formations \u2014 synchronized with calming ambient soundscapes.\n\n\nThis continuous motion creates a sense of floating and deep presence, helping quiet mental noise and support relaxation, mindfulness, and focus.\n\n\n### Mindfula is ideal for:\n- Stress relief and mental reset  \n- Mindfulness and relaxation sessions  \n- Visual meditation and flow states  \n- Late-night wind-down or quiet focus time  \n\n\n### Key Features:\n- Automatic forward movement for effortless immersion  \n- Multiple abstract, cosmic, and nature environments\n- High-quality ambient and healing audio  \n\n\n", "short_description": "A flow-based VR meditation experience using gentle motion and evolving visuals to quiet the mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "suppo
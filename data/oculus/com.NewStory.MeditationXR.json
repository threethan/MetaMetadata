9jM8-9vt4_FMi2JXEEwEmHVWZLIw&oe=6AC6653C"}, {"file_name": "9.png", "id": "3008511039340491", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620921_3008511042673824_3618723761199456981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoptgnCNHLMQ7kNvwHfR0Ve&_nc_oc=Adr8i96hthnMJl_cnQu5BFw-jAH-eY-lVhCZlwkyxJEMJyoAw_G0fWTQpZvSFp3YO8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9BhFZqiqJT8oRUCgEwKzlSYcMSk6ulpJtn23vav5z9Q&oe=6AC64DDA"}, {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011Mindfula\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8.png", "id": "924207480273465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_924207483606798_8584646791511714785_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKC4tS4pQfQQ7kNvwEkdUV4&_nc_oc=AdqW2I2skRG219iMGsOO7T8Wcm-qr8J_rKmY0CQLrjrAauG1vN-lezpzdMFHWBw27KQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB7CtvcWWgIGpxgOmSzkXcYF1ZeBnp_zm2QF0bgVvaFQ&oe=6AC643A3"}, {"file_name": "7.png", "id": "943406664877852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619681_943406668211185_3775301792945929841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBeR2VZmeAYQ7kNvwHE3XjX&_nc_oc=AdphihS_TiLtMeSE9fpeuunUfygk_hoYmAwCX4OGdwcXBYtgtPaRB6VGRN1CH-bxxpE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM8SvhLhFgu5HJmqv1OPvRygwSPGnvCetvlBVTlII7pg&oe=6AC642D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V1.png", "id": "1044575915088746", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499624395_1044575918422079_2577823135340829495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XplMkNQ0MX8Q7kNvwEMEdPr&_nc_oc=AdqcHSeMEyu6Lr9qsAC3XQkhjqKg6l67hELkfxxh6Z0qFTaKUK3HRoKkWCvS4un8pdQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxhOrVSd92gwfSSUHoCK2OlTbvbnTAWwf8r2gu_kH6zA&oe=6AC642EC"}, "display_name": "Mindfula :Relaxation Meditation Cosmic", "keywords": ["Relaxation", "Meditation", "\uff2dindfulness", "Anxiety", "Flow"], "long_description": "\n\n**Find Your Flow. Free Your Mind.**\n\n\nMindfula is a visually immersive VR meditation experience designed to guide your mind into a state of flow.\n\n\nInstead of sitting still, you gently move forward through evolving tunnel-like environments \u2014vast nature landscapes, cosmic spaces, kaleidoscopic patterns, and geometric light formations \u2014 synchronized with calming ambient soundscapes.\n\n\nThis continuous motion creates a sense of floating and deep presence, helping quiet mental noise and support relaxation, mindfulness, and focus.\n\n\n### Mindfula is ideal for:\n- Stress relief and mental reset  \n- Mindfulness and relaxation sessions  \n- Visual meditation and flow states  \n- Late-night wind-down or quiet focus time  \n\n\n### Key Features:\n- Automatic forward movement for effortless immersion  \n- Multiple abstract, cosmic, and nature environments\n- High-quality ambient and healing audio  \n\n\n", "short_description": "A flow-based VR meditation experience using gentle motion and evolving visuals to quiet the mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "s
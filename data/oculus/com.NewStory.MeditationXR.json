f1MXNyKRW_uT6epNDb_kqYes6nNDhWxaOhhmDGBXoNZmA&oe=69D3AFA3"}, {"file_name": "7.png", "id": "943406664877852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619681_943406668211185_3775301792945929841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ8YvwvN57oQ7kNvwEtDvAb&_nc_oc=AdozXLiWkhK_IUWrLh3uuNIHgVlS3oVWV74OHDSd3Ujj_AGzJFslehR1BMEF1v8U7Vk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3qNSnKxyzN_SnnRZtaAuQ3_wdee9Yb9Uo3HtR5WlOwJQ&oe=69D3AED1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30e9\u30f3\u30c9\u30b9\u30b1\u30fc\u30d7.png", "id": "915105457741501", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619450_915105461074834_7104290130619930993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=59Sn71HFLaEQ7kNvwG0ZpSz&_nc_oc=AdrO6IyyvUOBTfCvp5RNO-6Xb7b1TJfiQk4egEaLXrS5mczRRz7heFsWurI7epRGRDY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k16Hj22LqsyVc2R56KVWzmFLOTmX7CKF-sK9zMw71pQ&oe=69D394AC"}, "display_name": "Mindfula :Relaxation Meditation Cosmic", "keywords": ["Relaxation", "Meditation", "\uff2dindfulness", "Anxiety", "Flow"], "long_description": "\n\n**Find Your Flow. Free Your Mind.**\n\n\nMindfula is a visually immersive VR meditation experience designed to guide your mind into a state of flow.\n\n\nInstead of sitting still, you gently move forward through evolving tunnel-like environments \u2014vast nature landscapes, cosmic spaces, kaleidoscopic patterns, and geometric light formations \u2014 synchronized with calming ambient soundscapes.\n\n\nThis continuous motion creates a sense of floating and deep presence, helping quiet mental noise and support relaxation, mindfulness, and focus.\n\n\n### Mindfula is ideal for:\n- Stress relief and mental reset  \n- Mindfulness and relaxation sessions  \n- Visual meditation and flow states  \n- Late-night wind-down or quiet focus time  \n\n\n### Key Features:\n- Automatic forward movement for effortless immersion  \n- Multiple abstract, cosmic, and nature environments\n- High-quality ambient and healing audio  \n\n\n", "short_description": "A flow-based VR meditation experience using gentle motion and evolving visuals to quiet the mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24856380104035715"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618512_1471606024381410_6230247131169451795_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_adfrA--vbAQ7kNvwGH2rmK&_nc_oc=AdpC-ckqeXuTyk1WOxEmoHi2MO5f1sgtiQ9xL4UnhzrReXf52NvqoaSXDW2g6moA2ZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2SCe36COCLU_AVyR9FYA7FM1iF8pKoslDMylCNz5AHDA&oe=69D392A5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindfula :Relaxation Meditation Cosmic", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Travel & Exploration
OC41JwiHkVdvZ60G3GBXlKw&oe=6A563E5A"}, {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011Mindfula\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8.png", "id": "924207480273465", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618093_924207483606798_8584646791511714785_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEayXaMAkVoQ7kNvwFkYMzi&_nc_oc=Adp4ccJXhQuYvCSFrOmJqB3lcAZdom4kwaB0MkfWPC_GnKsymFiSfXVitM3V4goGpQw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5revPfivOoeu-lbQAwH7aOPiD7hKfNrje8X8ax9pZHQ&oe=6A563423"}, {"file_name": "7.png", "id": "943406664877852", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619681_943406668211185_3775301792945929841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBs1fJ0nYJwQ7kNvwEWRuSY&_nc_oc=Adp1HEJlkDG5LkIhUDFMQSmInQGgD03qymPOlsATd_pk5rivclcE5Sx695_8XNCzS0I&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFC8CY9Iw6eT3Jt3Ao8_oBTbO8XFzZs-wq7I8UWsLwLw&oe=6A563351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30e9\u30f3\u30c9\u30b9\u30b1\u30fc\u30d7.png", "id": "915105457741501", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619450_915105461074834_7104290130619930993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLcKM6yMWJYQ7kNvwEQhRqB&_nc_oc=AdoY8Gd3VC8c6zjeutvCUs2afyiGazaBWMkuBzBUBAxYHt4ScEG7TI2pIbSBWM0NVs0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHmdwS4O8_uu5Zm-u80C-EKi9jysImM4CEARa8PcL-gA&oe=6A56516C"}, "display_name": "Mindfula :Relaxation Meditation Cosmic", "keywords": ["Relaxation", "Meditation", "\uff2dindfulness", "Anxiety", "Flow"], "long_description": "\n\n**Find Your Flow. Free Your Mind.**\n\n\nMindfula is a visually immersive VR meditation experience designed to guide your mind into a state of flow.\n\n\nInstead of sitting still, you gently move forward through evolving tunnel-like environments \u2014vast nature landscapes, cosmic spaces, kaleidoscopic patterns, and geometric light formations \u2014 synchronized with calming ambient soundscapes.\n\n\nThis continuous motion creates a sense of floating and deep presence, helping quiet mental noise and support relaxation, mindfulness, and focus.\n\n\n### Mindfula is ideal for:\n- Stress relief and mental reset  \n- Mindfulness and relaxation sessions  \n- Visual meditation and flow states  \n- Late-night wind-down or quiet focus time  \n\n\n### Key Features:\n- Automatic forward movement for effortless immersion  \n- Multiple abstract, cosmic, and nature environments\n- High-quality ambient and healing audio  \n\n\n", "short_description": "A flow-based VR meditation experience using gentle motion and evolving visuals to quiet the mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24856380104035715"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618512_1471606024381410_6230247131169451795_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmzlmAgGyPwQ7kNvwFJHNRS&_nc_oc=Adq2zon1NKPJH6D1EJwbo01ezg4kepY2T550-ttf
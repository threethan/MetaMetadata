F7oBMa690tIqccDqgUJ_5LaaybGA&oe=6AD3943C"}, {"file_name": "9.png", "id": "3008511039340491", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620921_3008511042673824_3618723761199456981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tx1zq4a1HqAQ7kNvwGR5wTX&_nc_oc=Ado5s5TTt7RSn2QBgbbtbjdcz2LWnhnS164PjvPvWv2MHRGaPiQeIJRLA-YQprYrycI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxpJklqTFzW56wMD5TBNCBBymIG6ETGsRGH_ayo66zDg&oe=6AD3B51A"}, {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011Mindfula\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8.png", "id": "924207480273465", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618093_924207483606798_8584646791511714785_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQQ3U_LfPV8Q7kNvwEhOt8D&_nc_oc=Adqj_ZPoHXd0CuWKW0x6bRBAFgSSoaGaOaLxOleBBacRDB9pDpVvaJOyj8y6C2TX2N8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpxGvZBp-I5NhTuobfwM7MlHrcqBi9KtsSGn37nX-xzA&oe=6AD3AAE3"}, {"file_name": "7.png", "id": "943406664877852", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619681_943406668211185_3775301792945929841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wisqBT6-wFYQ7kNvwGJXdpp&_nc_oc=AdoLa0sLfPEilgkoSQsoI2K28MRe1Hq3gn5J_t0ECR_1W1PK3NdNvN-BF8OWfa3ctMM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjbZ6nS_3J-8MS24hV99NyK6oHL2gNUnjO_7WIIwompA&oe=6AD3AA11"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V1.png", "id": "1044575915088746", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499624395_1044575918422079_2577823135340829495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jEDDCOdVzqgQ7kNvwEeAUI5&_nc_oc=AdrsoChTN3qOr7KvKo7X5MBtDs_bbo_w2A2SeY3za8MY3AytsRaui_JBgOIUE1Bt6so&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQ7e7Mp0U506VkikS_0pQlU8P5frMvyWQgAYFQHhoPsg&oe=6AD3AA2C"}, "display_name": "Mindfula :Relaxation Meditation Cosmic", "keywords": ["Relaxation", "Meditation", "\uff2dindfulness", "Anxiety", "Flow"], "long_description": "\n\n**Find Your Flow. Free Your Mind.**\n\n\nMindfula is a visually immersive VR meditation experience designed to guide your mind into a state of flow.\n\n\nInstead of sitting still, you gently move forward through evolving tunnel-like environments \u2014vast nature landscapes, cosmic spaces, kaleidoscopic patterns, and geometric light formations \u2014 synchronized with calming ambient soundscapes.\n\n\nThis continuous motion creates a sense of floating and deep presence, helping quiet mental noise and support relaxation, mindfulness, and focus.\n\n\n### Mindfula is ideal for:\n- Stress relief and mental reset  \n- Mindfulness and relaxation sessions  \n- Visual meditation and flow states  \n- Late-night wind-down or quiet focus time  \n\n\n### Key Features:\n- Automatic forward movement for effortless immersion  \n- Multiple abstract, cosmic, and nature environments\n- High-quality ambient and healing audio  \n\n\n", "short_description": "A flow-based VR meditation experience using gentle motion and evolving visuals to quiet the mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "s
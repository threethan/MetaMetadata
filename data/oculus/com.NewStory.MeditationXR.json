content-ord5-2.oculuscdn.com/v/t64.5771-25/499618293_1629319314741163_866276197331653863_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3tuVCxd2hMwQ7kNvwGFGjuE&_nc_oc=Ado_sgar1OQMGlbvb6-Yyajao4cMKLVQnGGCkrLK2klT4GQWvLQ7o-YHn0naaWUmbeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFK_8yYqi50uu6yMcRuv7yyU7G40Jl4IxEQUFQTF6IDw&oe=6A99923C"}, {"file_name": "9.png", "id": "3008511039340491", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620921_3008511042673824_3618723761199456981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QicIYO_2kMQ7kNvwHX57MX&_nc_oc=AdpZhhO3SuujzxkRuPrziakBEnxrFut4icrQFjroFDGg8aJgIjwxQE_HHu3aucc5op4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFptu1cpacRmvHbMEHOH7U1sqIx58mGPjud6hB2cjSXw&oe=6A997ADA"}, {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011Mindfula\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8.png", "id": "924207480273465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618093_924207483606798_8584646791511714785_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8Ktt-G8_QoQ7kNvwF464Ys&_nc_oc=AdqHNMqyCAQfCXiXvRU5T11aqs4-OAOxnghTBmKyFc74TC-e9qsDDsJIKuay5SDPDqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp3j83eotD4RzeN4FwtAsWXOoQlen5X8EqznxvW8_LLw&oe=6A9970A3"}, {"file_name": "7.png", "id": "943406664877852", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619681_943406668211185_3775301792945929841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubz4Y6juuvoQ7kNvwFoOX3h&_nc_oc=Adobx14N4dcMfYLSltkiC5BSAXN3N0e0wd43P3x1qNXaC_0vVLdfqJ4uKKa5VexhmSs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNMqIsyMH4HCwjPOrxNVXASeum4X_0Di2_uZP_ZeUlFA&oe=6A996FD1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30e9\u30f3\u30c9\u30b9\u30b1\u30fc\u30d7.png", "id": "915105457741501", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619450_915105461074834_7104290130619930993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RilVPbNfsPEQ7kNvwHbZWus&_nc_oc=AdpCDk4Knbg7jHwFRkcIQ2ry6iUk7V6SruVRfxqq8b8X4SpOlQiGxK105zTt-y6kfhw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpq2Qq8mF8Z3-6dsmlDWwSj_HD1KzpHukwh1y72GqQzQ&oe=6A998DEC"}, "display_name": "Mindfula :Relaxation Meditation Cosmic", "keywords": ["Relaxation", "Meditation", "\uff2dindfulness", "Anxiety", "Flow"], "long_description": "\n\n**Find Your Flow. Free Your Mind.**\n\n\nMindfula is a visually immersive VR meditation experience designed to guide your mind into a state of flow.\n\n\nInstead of sitting still, you gently move forward through evolving tunnel-like environments \u2014vast nature landscapes, cosmic spaces, kaleidoscopic patterns, and geometric light formations \u2014 synchronized with calming ambient soundscapes.\n\n\nThis continuous motion creates a sense of floating and deep presence, helping quiet mental noise and support relaxation, mindfulness, and focus.\n\n\n### Mindfula is ideal for:\n- Stress relief and mental reset  \n- Mindfulness and relaxation sessions  \n- Visual meditation and flow states  \n- Late-night wind-down or quiet focus time  \n\n\n### Key Features:\n- Automatic forward movement for effortless immersion  \n- Multiple abstract, cosmic, and nature environments\n- High-quality ambient and healing audio  \n\n\n", "short_description": "A flow-based VR meditation experience using gentle motion and evolving visuals to quiet the mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_
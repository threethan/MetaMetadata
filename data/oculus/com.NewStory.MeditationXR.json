7_WNYaLRFim4v_uJZjwFeHNZH1Bw&oe=6AC270BC"}, {"file_name": "9.png", "id": "3008511039340491", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_3008511042673824_3618723761199456981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mquu_PqipEQ7kNvwE_qHF_&_nc_oc=AdpXPPxZeMDkdAqvSyrQOYr_CliY7DtCv1keByePqy3q13PsnAkf3pfLuZEfFCx1En8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrJD2hGYlWVCDXQsmSQ6nu12rGhR1PP2QvHqtRBI4wXw&oe=6AC2595A"}, {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011Mindfula\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8.png", "id": "924207480273465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_924207483606798_8584646791511714785_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38T5t7iYGGMQ7kNvwGjfr7k&_nc_oc=AdqF4Kj5tCi0sBo-iVclbNpfOTiEaXuA5083_jiWZufHWFOUxss55cZED4YAvH__YUE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzjKXKDH1rjvjSAMzn1cCn_lfVd3DDsegiFhSLzBS00A&oe=6AC24F23"}, {"file_name": "7.png", "id": "943406664877852", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619681_943406668211185_3775301792945929841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BOjePwPucwQ7kNvwEngYoz&_nc_oc=Adoben_sJhzRqrd9udkTyPl73pnhcBTHgpbJgZfH2K6GXduh-mWvck7iI4-iV3TWLC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPemTaO3vAGGRsa2t-Qm57TdcWKiNswqh20HyBscrl4PQ&oe=6AC28691"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V1.png", "id": "1044575915088746", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499624395_1044575918422079_2577823135340829495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwuSE6a2rCkQ7kNvwED5O6Q&_nc_oc=AdpZ0U3wDHa8VhlO1QwB3Go0v3SHh8_0g0tz8Vh68Z8Pl0cPKzodg1V5xdQwQav2lw4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU7F1WN3wmgxO1U3y7ChPrLLbWBDaFvZuL859QDQUbXQ&oe=6AC286AC"}, "display_name": "Mindfula :Relaxation Meditation Cosmic", "keywords": ["Relaxation", "Meditation", "\uff2dindfulness", "Anxiety", "Flow"], "long_description": "\n\n**Find Your Flow. Free Your Mind.**\n\n\nMindfula is a visually immersive VR meditation experience designed to guide your mind into a state of flow.\n\n\nInstead of sitting still, you gently move forward through evolving tunnel-like environments \u2014vast nature landscapes, cosmic spaces, kaleidoscopic patterns, and geometric light formations \u2014 synchronized with calming ambient soundscapes.\n\n\nThis continuous motion creates a sense of floating and deep presence, helping quiet mental noise and support relaxation, mindfulness, and focus.\n\n\n### Mindfula is ideal for:\n- Stress relief and mental reset  \n- Mindfulness and relaxation sessions  \n- Visual meditation and flow states  \n- Late-night wind-down or quiet focus time  \n\n\n### Key Features:\n- Automatic forward movement for effortless immersion  \n- Multiple abstract, cosmic, and nature environments\n- High-quality ambient and healing audio  \n\n\n", "short_description": "A flow-based VR meditation experience using gentle motion and evolving visuals to quiet the mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "s
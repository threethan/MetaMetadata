c1rk8OTtvBr24dR0otVLY0zuN0lQ&oe=6AC513BC"}, {"file_name": "9.png", "id": "3008511039340491", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620921_3008511042673824_3618723761199456981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoptgnCNHLMQ7kNvwFH1QLl&_nc_oc=AdoZfB6YLHDymNvSP3JBa_s3qe0XXM-NcuYT3-g7udSXSgrtn8syqWFJ0tEpHEk5hmE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNakYnGnDrsETObbaG2nGJfr8tzBYuuOsFw_rHEbs-5MQ&oe=6AC4FC5A"}, {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011Mindfula\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8.png", "id": "924207480273465", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618093_924207483606798_8584646791511714785_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKC4tS4pQfQQ7kNvwE_GtI7&_nc_oc=AdozpUyHsmG00IsDfWHv1zWkO58_CrvesT-UgzygEsYXQIc-IEw-ZFvqVYcnTiXIKRA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1dickv-xeK7qU2o66ALZUe1SedtRkxVMPQuvsDK4PyA&oe=6AC4F223"}, {"file_name": "7.png", "id": "943406664877852", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619681_943406668211185_3775301792945929841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gBeR2VZmeAYQ7kNvwGaIngF&_nc_oc=Adqim9eSwbcxJk-Cz4tivoPE-JWBAtYZvJz-IhJhTQLgnsUZOLryYttquCoRFYeRIDw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6Hz9CjOEKnWZ8Y8gpeB5_6r2GRKK4BflEIJvoEB7l_w&oe=6AC52991"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V1.png", "id": "1044575915088746", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499624395_1044575918422079_2577823135340829495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwuSE6a2rCkQ7kNvwGM8mJv&_nc_oc=AdrjcT4dW4xej29P2vmpQhPhq9r3V4zcu5vorRo4yUYYpWzmNG6UJQKkcJOoIp7xGpM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKenJjNWeVN2ZySzKXGRLPGTksOwAVHImogAZS4KfyaA&oe=6AC529AC"}, "display_name": "Mindfula :Relaxation Meditation Cosmic", "keywords": ["Relaxation", "Meditation", "\uff2dindfulness", "Anxiety", "Flow"], "long_description": "\n\n**Find Your Flow. Free Your Mind.**\n\n\nMindfula is a visually immersive VR meditation experience designed to guide your mind into a state of flow.\n\n\nInstead of sitting still, you gently move forward through evolving tunnel-like environments \u2014vast nature landscapes, cosmic spaces, kaleidoscopic patterns, and geometric light formations \u2014 synchronized with calming ambient soundscapes.\n\n\nThis continuous motion creates a sense of floating and deep presence, helping quiet mental noise and support relaxation, mindfulness, and focus.\n\n\n### Mindfula is ideal for:\n- Stress relief and mental reset  \n- Mindfulness and relaxation sessions  \n- Visual meditation and flow states  \n- Late-night wind-down or quiet focus time  \n\n\n### Key Features:\n- Automatic forward movement for effortless immersion  \n- Multiple abstract, cosmic, and nature environments\n- High-quality ambient and healing audio  \n\n\n", "short_description": "A flow-based VR meditation experience using gentle motion and evolving visuals to quiet the mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "s
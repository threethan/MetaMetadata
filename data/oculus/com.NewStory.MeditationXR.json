sYDvU_ZC4A1iVhyoJa3H4hdglj6Q&oe=6AE214BC"}, {"file_name": "9.png", "id": "3008511039340491", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620921_3008511042673824_3618723761199456981_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KQV8ayhcFQQ7kNvwHPYYca&_nc_oc=Adqm_1TWgU9EtN_5cgBxp_ElCIXDuVJuILqGph1cRzxmRYVO3piw3qZxEG-6krfvC7s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjWVRo4UcC4uGhzWjCP373fB8wl9L11kIhxZfDHmxcWA&oe=6AE1FD5A"}, {"file_name": "\u3010\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3011Mindfula\u30b9\u30c8\u30a2\u30a2\u30bb\u30c3\u30c8.png", "id": "924207480273465", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618093_924207483606798_8584646791511714785_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0B0BHrYQ4k0Q7kNvwEj4apR&_nc_oc=AdqvTkId0XDod-Ln88PD45D4ron4kt8Dk_8W5dTS19gNDnz72bgHe1a1kxX825bB_jE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMRRxO50N7RANRoK-nCPjvfMgW21406GZE0WPvYdk0hw&oe=6AE1F323"}, {"file_name": "7.png", "id": "943406664877852", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619681_943406668211185_3775301792945929841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pD8j7EOetQQ7kNvwENPD5E&_nc_oc=AdrRs0STk1r6-v4GGqW8rgTRQQEqgzo5FZPJFpRLLTtcmyrZslpl6uz7Yd_v5RmmgVg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPe2jB3Cn_-UfZc0VQZW5L2JZu3WPAV23Kq8x0qb-MFwQ&oe=6AE1F251"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V1.png", "id": "1044575915088746", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624395_1044575918422079_2577823135340829495_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_803BGtlftoQ7kNvwEsUuo-&_nc_oc=Adq6fxUd30t_2e2j_0neyRukSwB1ph1H-Km_UqY8nbi3Kpy9x3BE_CigPx0q3JT6yv8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgr0_oYMauQuvXDjxs1kxe8CtFCv1w6C7E1TooMICs3w&oe=6AE1F26C"}, "display_name": "Mindfula :Relaxation Meditation Cosmic", "keywords": ["Relaxation", "Meditation", "\uff2dindfulness", "Anxiety", "Flow"], "long_description": "\n\n**Find Your Flow. Free Your Mind.**\n\n\nMindfula is a visually immersive VR meditation experience designed to guide your mind into a state of flow.\n\n\nInstead of sitting still, you gently move forward through evolving tunnel-like environments \u2014vast nature landscapes, cosmic spaces, kaleidoscopic patterns, and geometric light formations \u2014 synchronized with calming ambient soundscapes.\n\n\nThis continuous motion creates a sense of floating and deep presence, helping quiet mental noise and support relaxation, mindfulness, and focus.\n\n\n### Mindfula is ideal for:\n- Stress relief and mental reset  \n- Mindfulness and relaxation sessions  \n- Visual meditation and flow states  \n- Late-night wind-down or quiet focus time  \n\n\n### Key Features:\n- Automatic forward movement for effortless immersion  \n- Multiple abstract, cosmic, and nature environments\n- High-quality ambient and healing audio  \n\n\n", "short_description": "A flow-based VR meditation experience using gentle motion and evolving visuals to quiet the mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "s
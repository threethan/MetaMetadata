3_924207483606798_8584646791511714785_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mquyV0UFDSgQ7kNvwHzrgf0&_nc_oc=Adp8vePu-IAw24-avUpApZvSyDngyGRLVBw3qfV25k0nwDoxIOxDxom-B5P5lrmdA1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-U-EASseGztreyUm1vqybjKkzEjD4HOUnNZ4u1_UJDkA&oe=6A3E7923"}, {"file_name": "7.png", "id": "943406664877852", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619681_943406668211185_3775301792945929841_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T80GJtA97JYQ7kNvwEgx7kk&_nc_oc=Adoi0pl_nar_rTuR6uR-T8GRCzdW1XY4OjqFSImliD3X7EPKkr_iRxNkj8wxG7b7TcQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZAJOqhcm2K_OpXAiUe2PJA97Nc-g2TrHhp8o83NcxcQ&oe=6A3E7851"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u30e9\u30f3\u30c9\u30b9\u30b1\u30fc\u30d7.png", "id": "915105457741501", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619450_915105461074834_7104290130619930993_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwBa9EsxqVwQ7kNvwHNv6HO&_nc_oc=AdobQv8qpcoYpgIqvw-_6XFsqi2BTE-Tc7QN1mLcJjj_msnZgsctcI7LkxeA_j57kAA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0cCOAxeZCrPNFGqcRNdxX8ugCu-zvqQKXJuu0L-e5IQ&oe=6A3E966C"}, "display_name": "Mindfula :Relaxation Meditation Cosmic", "keywords": ["Relaxation", "Meditation", "\uff2dindfulness", "Anxiety", "Flow"], "long_description": "\n\n**Find Your Flow. Free Your Mind.**\n\n\nMindfula is a visually immersive VR meditation experience designed to guide your mind into a state of flow.\n\n\nInstead of sitting still, you gently move forward through evolving tunnel-like environments \u2014vast nature landscapes, cosmic spaces, kaleidoscopic patterns, and geometric light formations \u2014 synchronized with calming ambient soundscapes.\n\n\nThis continuous motion creates a sense of floating and deep presence, helping quiet mental noise and support relaxation, mindfulness, and focus.\n\n\n### Mindfula is ideal for:\n- Stress relief and mental reset  \n- Mindfulness and relaxation sessions  \n- Visual meditation and flow states  \n- Late-night wind-down or quiet focus time  \n\n\n### Key Features:\n- Automatic forward movement for effortless immersion  \n- Multiple abstract, cosmic, and nature environments\n- High-quality ambient and healing audio  \n\n\n", "short_description": "A flow-based VR meditation experience using gentle motion and evolving visuals to quiet the mind."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24856380104035715"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618512_1471606024381410_6230247131169451795_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aYrdg0WkQ34Q7kNvwEfatsu&_nc_oc=AdpAlhnwtqzFkQHKpvH7juyu5gvNodDKN7o5T2b-fL1JpsZ0smxqWFOIEhRJ3mcBVqs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YSwgxsrRxm89PZ5WIscinL-UErjsr1PfSGPfwyYWFCw&oe=6A3E9465"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mindfula :
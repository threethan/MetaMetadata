0vSYYtcLFgNkbs9o-z-KQ4CYEqwgLL0CO68s0zE4GEYQ&oe=69E0FDFA"}, {"file_name": "Screenshot_2025-06-30_20-33-40.png", "id": "1387851875811643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307470_1387851879144976_1548526543084512513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imUak3NdDOwQ7kNvwETQ_2N&_nc_oc=Adru1AvjpPzhNHI9x9CUC0gS4YvGNYDDbd3ikHMr_ZxzyYJ1k2qpfRc1jRCh9hTusn0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af286eJ76HXqlxcq3AwMZMgjPEpp8tuIe_1lhCdOyANJ_w&oe=69E0EF7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 7.png", "id": "1058733142907540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491831000_1058733146240873_245551274170199525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26W53tteSKAQ7kNvwE4it3W&_nc_oc=AdogN5fcSXFGWSRcy18puKaA1X4opy1Y0jb4lgLUSA3SRz6LJJL8eqDvQy7DhimpYG8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10nZUKVUw7J6DrxmwNmY1nemV2mZfwErAbkhOMxcpeGw&oe=69E0DA60"}, "display_name": "QR Scanner", "keywords": ["QR", "Scanner", "Code", "BarCode", "QRScanner"], "long_description": "# QR Scanner\n## **JOIN OUR DISCORD COMMUNITY\ud83d\udd17**\nhttps://discord.gg/wDVr6SZgUw\n\nEasily scan QR codes and barcodes without removing your headset.  \nJust look at a QR code, and you're good to go!\n\n## Features\n\n- **Instant Scanning**: Look at a QR code to scan it immediately.  \n- **Copy Text**: Quickly copy scanned text to your clipboard.  \n- **Open URLs**: Detect URLs in QR codes\u2014open directly in-browser or copy to clipboard.  \n- **Barcode Decoding**: Supports common 1D/2D barcodes alongside QR codes.  \n- **History**: All decoded QR codes and barcodes are saved.  \n  - View past scans.  \n  - Delete individual entries or clear all history.  \n\n", "short_description": "QR Scanner: Scan QR codes and barcodes on Quest 3/3s! Copy content or open URLs, simple & easy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.goog
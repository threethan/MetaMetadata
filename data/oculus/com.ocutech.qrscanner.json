: null, "video_trailer_thumbnail": {"file_name": "Group 7.png", "id": "1058733142907540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831000_1058733146240873_245551274170199525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xb_096HvwtcQ7kNvwEOxNp8&_nc_oc=AdrMVDbzr9qc1Rsg_h_LD6-MJl5iqitUaIDi22Mj40zrle7fauH450Ivi69MYdoGh6Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrdhmi-NiDBOjs1xQnaYihSjWqj-2Mz0SnfDFcSU1pAQ&oe=6AE34060"}, "display_name": "QR Scanner", "keywords": ["QR", "Scanner", "Code", "BarCode", "QRScanner"], "long_description": "# QR Scanner\n## **JOIN OUR DISCORD COMMUNITY\ud83d\udd17**\nhttps://discord.gg/wDVr6SZgUw\n\nEasily scan QR codes and barcodes without removing your headset.  \nJust look at a QR code, and you're good to go!\n\n## Features\n\n- **Instant Scanning**: Look at a QR code to scan it immediately.  \n- **Copy Text**: Quickly copy scanned text to your clipboard.  \n- **Open URLs**: Detect URLs in QR codes\u2014open directly in-browser or copy to clipboard.  \n- **Barcode Decoding**: Supports common 1D/2D barcodes alongside QR codes.  \n- **History**: All decoded QR codes and barcodes are saved.  \n  - View past scans.  \n  - Delete individual entries or clear all history.  \n\n", "short_description": "QR Scanner: Scan QR codes and barcodes on Quest 3/3s! Copy content or open URLs, simple & easy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1SSyo2fD27d0-sxY_GhZ5litxL6qy1p8kfO6hma3GU7U/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OcuTech LLC", "support_website_url": "https://discord.gg/wDVr6SZgUw", "website_url": "https://ocutech.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, 
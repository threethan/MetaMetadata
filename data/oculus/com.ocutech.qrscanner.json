 "1387851875811643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_1387851879144976_1548526543084512513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjctYV9QiHwQ7kNvwFz81wH&_nc_oc=AdmqqquKUMYPmLJPpEafvd-iIM7nSEJmQjwpzuUbw1vnZnQ5EU2IQa_6UYZ5YwBlpzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0RsNZAFhmrDNhmHDl1TiF7cm3Tn0wW9IBY4FPYkWeKA&oe=69A2F8FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 7.png", "id": "1058733142907540", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831000_1058733146240873_245551274170199525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Qhfr7_gftEQ7kNvwEfOk20&_nc_oc=AdnEdY5YKyp60QQnvDGcziq4AnDZL5QNcrm4NuEidGFQsUNjB0yMIsqBtpx8KP5KwLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvJ0AtVd0QjMnzX60kEmN-SxSnehd37TdT-Gog66NFkFQ&oe=69A2E3E0"}, "display_name": "QR Scanner", "keywords": ["QR", "Scanner", "Code", "BarCode", "QRScanner"], "long_description": "# QR Scanner\n## **JOIN OUR DISCORD COMMUNITY\ud83d\udd17**\nhttps://discord.gg/wDVr6SZgUw\n\nEasily scan QR codes and barcodes without removing your headset.  \nJust look at a QR code, and you're good to go!\n\n## Features\n\n- **Instant Scanning**: Look at a QR code to scan it immediately.  \n- **Copy Text**: Quickly copy scanned text to your clipboard.  \n- **Open URLs**: Detect URLs in QR codes\u2014open directly in-browser or copy to clipboard.  \n- **Barcode Decoding**: Supports common 1D/2D barcodes alongside QR codes.  \n- **History**: All decoded QR codes and barcodes are saved.  \n  - View past scans.  \n  - Delete individual entries or clear all history.  \n\n", "short_description": "QR Scanner: Scan QR codes and barcodes on Quest 3/3s! Copy content or open URLs, simple & easy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1SSyo2fD27d0-sxY_GhZ5litxL6qy1p8kfO6hma3GU7U/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "OcuTech LLC", "support_website_url": "https://discord.gg/wDVr6SZgUw", "website_url": "https://ocutech.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26143107011944777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824318_1305427320894156_2219552977259293103_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUe_A-5IHTMQ7kNvwHXuapz&_nc_oc=AdkRbaEBgxdXCygO9dlEtDcmapjBPOMYKOHKcAV3-i3aHSZKid0pVkjK83Jf8gwIzaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEA--V3F8iTxDcLnQcT2CySP8JYBmxMjc-75b6r9ryCQ&oe=69A2D834"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "QR Scanner", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1751477340, "lastRevision": {"nodes": [{"id": "24677807941808032", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24677807858474707", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "4057755747886094"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [
3aHckWOHV3AiCr4165JDK0vd599Se0d96eIsw8Q_FPDQ&oe=69EF7E7A"}, {"file_name": "Screenshot_2025-06-30_20-33-40.png", "id": "1387851875811643", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307470_1387851879144976_1548526543084512513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ooFdwsoFksUQ7kNvwGeCYhe&_nc_oc=AdozVSZo1l7xL8kho5pGAsIxnusDcgtvMbkeFK40HvBvmvQv9b8JPqrzAZdY5fsYgJg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1J4zQUjj8kbbIzP30ppuEnnYAZjxb-NoePagB51WIYZQ&oe=69EF6FFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 7.png", "id": "1058733142907540", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491831000_1058733146240873_245551274170199525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfTgHMwi9RQQ7kNvwEQlCiB&_nc_oc=AdrN6D-FMrW-Z5xN3hloP9BGJVAdKR8Y2KkskLeuVly4-50i7W_RWIU5cvL71vUckkE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2OAM0Z4e-AvpmOnGM7xntfMof6J8sIMvbVbtXD6J8Cwg&oe=69EF5AE0"}, "display_name": "QR Scanner", "keywords": ["QR", "Scanner", "Code", "BarCode", "QRScanner"], "long_description": "# QR Scanner\n## **JOIN OUR DISCORD COMMUNITY\ud83d\udd17**\nhttps://discord.gg/wDVr6SZgUw\n\nEasily scan QR codes and barcodes without removing your headset.  \nJust look at a QR code, and you're good to go!\n\n## Features\n\n- **Instant Scanning**: Look at a QR code to scan it immediately.  \n- **Copy Text**: Quickly copy scanned text to your clipboard.  \n- **Open URLs**: Detect URLs in QR codes\u2014open directly in-browser or copy to clipboard.  \n- **Barcode Decoding**: Supports common 1D/2D barcodes alongside QR codes.  \n- **History**: All decoded QR codes and barcodes are saved.  \n  - View past scans.  \n  - Delete individual entries or clear all history.  \n\n", "short_description": "QR Scanner: Scan QR codes and barcodes on Quest 3/3s! Copy content or open URLs, simple & easy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.goog
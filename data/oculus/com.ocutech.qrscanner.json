-XE0sxqQ&oe=69B2A13A"}, {"file_name": "Screenshot_2025-06-30_20-33-40.png", "id": "1387851875811643", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_1387851879144976_1548526543084512513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcC9-7jJkcMQ7kNvwHT6TEL&_nc_oc=AdmyzUZCATda-FO2Zn6PT_2uQSqRFnvNJoDOKE6acvAEXJdvgSDcY0MFDeoMzUxbZYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyU-A2d2zb9-IM2zrgXs6iLs5pmzMwSPbN3Dw9tDIUdnA&oe=69B2CAFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Group 7.png", "id": "1058733142907540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831000_1058733146240873_245551274170199525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbJc8tHrjjgQ7kNvwEhjA9j&_nc_oc=Adkmhj3JwUGwLXTCPu_zPSyJuC4k33NOATDTP2-ygtZu27RGUJIKbquoXOGusXlWnyQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwDOuY7nA5_6NZEJIZCaV29tnzIIpfmEoARkSDPdAHjyQ&oe=69B2B5E0"}, "display_name": "QR Scanner", "keywords": ["QR", "Scanner", "Code", "BarCode", "QRScanner"], "long_description": "# QR Scanner\n## **JOIN OUR DISCORD COMMUNITY\ud83d\udd17**\nhttps://discord.gg/wDVr6SZgUw\n\nEasily scan QR codes and barcodes without removing your headset.  \nJust look at a QR code, and you're good to go!\n\n## Features\n\n- **Instant Scanning**: Look at a QR code to scan it immediately.  \n- **Copy Text**: Quickly copy scanned text to your clipboard.  \n- **Open URLs**: Detect URLs in QR codes\u2014open directly in-browser or copy to clipboard.  \n- **Barcode Decoding**: Supports common 1D/2D barcodes alongside QR codes.  \n- **History**: All decoded QR codes and barcodes are saved.  \n  - View past scans.  \n  - Delete individual entries or clear all history.  \n\n", "short_description": "QR Scanner: Scan QR codes and barcodes on Quest 3/3s! Copy content or open URLs, simple & easy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1SSyo2fD27d0-sxY_GhZ5litxL
179968076136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAp-c8vQKNwQ7kNvwEtyBtF&_nc_oc=AdohtyDS9SoDed8BUlTvqyO0XAvQayC28i4dpsI5If5BI7O-_0yVCNQ-fXXwe76fglE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0K-znelca6U0hWkXSqTO25l9yDayzALivtjltDvmam9A&oe=69F0CFFA"}, {"file_name": "Screenshot_2025-06-30_20-33-40.png", "id": "1387851875811643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_1387851879144976_1548526543084512513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32DMvQEJcfEQ7kNvwEvBZau&_nc_oc=AdqlozWX4PNWcdV18fed2RtCCBYEii4sQ0Yfvme70ot-_Avj0xU8DI-ajM5K_6FBIlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0mBR9KmfCxlp8_F9GbC8D8QOpI6iZhoI89cRkitOguUA&oe=69F0C17B"}, {"file_name": "Screenshot_2025-06-30_20-22-33.png", "id": "2578358299223139", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308131_2578358302556472_7325138227328606476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HJVU4ipZVYQ7kNvwEba81H&_nc_oc=AdpQ7HBl0kmDCD2nkLMhLCjPf2cNhG-OdPffyi60omrP1VJxTctMRztjuizWIMIqXKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1Mtme2AQije6fSFH8Tnd3ZQ4TbJ2NEeVmD1QbBNPrhiw&oe=69F0B274"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QR Scanner", "keywords": ["QR", "Scanner", "Code", "BarCode", "QRScanner"], "long_description": "# QR Scanner\n\nEasily scan QR codes without removing your headset.  \nJust look at a QR code, and you're good to go!\n\n## Features\n\n- **Instant Scanning**: Look at a QR code to scan it immediately.\n- **Copy Text**: Quickly copy scanned text to your clipboard.\n- **Open URLs**: Detect URLs in QR codes\u2014open directly in-browser or copy to clipboard.\n\n**Simple. Fast. Lightweight.**", "short_description": "QR Scanner: Scan QR codes on Quest 3/3s! Copy content or open URLs, simple & easy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1SSyo2fD27d0-sxY_GhZ5litxL6qy1p8kfO6hma3GU7U/edit?usp=sharing",
19_3251186988368111_536402179968076136_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAp-c8vQKNwQ7kNvwE2ZcfI&_nc_oc=AdrlqDuBxfkoyFTxcd7jL_VGYs0f-Ca3tgKgXhRQOLRN2Hh_FS6pxJncIMLkXehAWes&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0egoVpSLaBNVQztyZ3p5Nh9TvpY7qKOOfoS_A3VtOKDg&oe=69F1E93A"}, {"file_name": "Screenshot_2025-06-30_20-33-40.png", "id": "1387851875811643", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307470_1387851879144976_1548526543084512513_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32DMvQEJcfEQ7kNvwHXHD3m&_nc_oc=AdrJcIEXbJR-yBVF7mx93yXUrTyQTumbOynkJWtnZIlqPiSo9HtZ9LyBnu9WWQWk3zU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0_v5gt35yniJAhhLyikBHmMSnNpsQ4B-BJl4zuPey73A&oe=69F212FB"}, {"file_name": "Screenshot_2025-06-30_20-22-33.png", "id": "2578358299223139", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308131_2578358302556472_7325138227328606476_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8HJVU4ipZVYQ7kNvwEcTrkr&_nc_oc=Adp1gLYbJUoVWD6utMroEMUGEmlsczKy9yCsYFW1uZ02c8IHOwrLuEH2HH8N37dhNJ4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Ik2jAU8jCVuoYCJx7SNq9JU69hWDnsRQ4duRa4waNPQ&oe=69F203F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "QR Scanner", "keywords": ["QR", "Scanner", "Code", "BarCode", "QRScanner"], "long_description": "# QR Scanner\n\nEasily scan QR codes without removing your headset.  \nJust look at a QR code, and you're good to go!\n\n## Features\n\n- **Instant Scanning**: Look at a QR code to scan it immediately.\n- **Copy Text**: Quickly copy scanned text to your clipboard.\n- **Open URLs**: Detect URLs in QR codes\u2014open directly in-browser or copy to clipboard.\n\n**Simple. Fast. Lightweight.**", "short_description": "QR Scanner: Scan QR codes on Quest 3/3s! Copy content or open URLs, simple & easy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1SSyo2fD27d0-sxY_GhZ5lit
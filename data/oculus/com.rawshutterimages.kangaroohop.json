eiLVINe06iIDvZcwfKc6j5bCxOfK2DCtEdJLDlsjp2Co04xS-V9uc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT_UR-rKQk6t6IXONX9CwW8DrxOzsYjhWKt4SiNUCXRHQ&oe=6B0DC2E5"}, {"file_name": "5-fever.png", "id": "4267634113381053", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619369_4267634120047719_3870433013384027901_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oJYs_UTmMMQ7kNvwGdrbWS&_nc_oc=AdonnsZV8knMkOj640Y3NRjO9unljMbDF0tYE_nPzETpa3NX36wBUyPq3ydPDXvNL5Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWDWagYqGBAb5rLk8GxRVvDEt0VPXM_myNZ5LOZoe5Iw&oe=6B0DC8AC"}, {"file_name": "1-sydney.png", "id": "1102627735921858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593727470_1102627739255191_4271072439876775504_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiqbS3l5euYQ7kNvwERpUlS&_nc_oc=AdpmLRjHMarZWOBhMrJbpn5wAVlEZUi4lxJzpLA489o3YfG3O-L5n7j-r7FMjWJWxMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhgcd0GqYbzev_xl89vVD2y_yVH9UvJqrbOlpGqewXuw&oe=6B0DC40B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-2560x1440.png", "id": "1155125600446442", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623585_1155125607113108_4743255046922087128_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lIZFUm3Lh4Q7kNvwH9rbIX&_nc_oc=AdqynoUbj3v4newXVCqTYVZZq4Ij3QXqTkgpAGnOzPM-jgfmqiRZy4V7G2krdhY1C-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0rwRxet1XFlXzlFlmv-QC3OnkOCG5ynpjLAJwyDQGsQ&oe=6B0DA32C"}, "display_name": "Kangaroo Hop Adventure", "keywords": [], "long_description": "Hop around the world with Roo the kangaroo!\n\nKangaroo Hop Adventure is a bright, bouncy arcade runner on a big screen in front of you. Start in the Australian Outback, then hop, duck and fly through 60 hand-painted cities, from Sydney and Tokyo to Paris, New York and Rio, all the way to the grand World Tour finale.\n\nSIMPLE CONTROLS\nPoint at the game and pull the trigger to hop (hold for a bigger hop). Thumbstick down to duck, up for a super jump. B pauses.\n\nEVERY CITY IS DIFFERENT\nLeap the Barong in Bali, dodge scooters in Hanoi and duck under the New York subway. Each city has its own skyline, hazards, music and a boss to beat.\n\nTREATS, POWER-UPS AND FEVER\nGrab each city's treat to sprout wings and soar. Snap up skateboards, rockets and magnets, and chain perfect dodges to fill Fever and smash through everything.\n\nCOLLECT THE WORLD\nStamp your passport, find a hidden souvenir in every city, earn stars and dress Roo in hats and outfits.\n\nTWO WAYS TO PLAY\nNormal has three hearts. Expert is full speed with one life. Finish the tour and the laps get faster.\n\nMADE FOR FAMILIES\nEvery city included. No ads, no in-app purchases, no accounts, no data collected. Plays fully offline.\n", "short_description": "Hop, duck and fly with Roo the kangaroo through 60 hand-painted world cities. Beat a boss in every city, grab local treats, collect souvenirs and dress up Roo. No ads, no in-app purchases."}]}, "developer_name": null, "developer_privacy_policy_url": "https://phillipmakusha-ops.github.io/kangaroohop-legal/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "rawshutterimages", "support_website_url": "https://phillipmakusha-ops.github.io/kangaroohop-legal/", "website_url": "https://phillipmakusha-ops.github.io/kangaroohop-legal/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
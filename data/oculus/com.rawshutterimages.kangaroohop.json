nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiqbS3l5euYQ7kNvwERpUlS&_nc_oc=AdpmLRjHMarZWOBhMrJbpn5wAVlEZUi4lxJzpLA489o3YfG3O-L5n7j-r7FMjWJWxMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhgcd0GqYbzev_xl89vVD2y_yVH9UvJqrbOlpGqewXuw&oe=6B0DC40B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape-2560x1440.png", "id": "1155125600446442", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623585_1155125607113108_4743255046922087128_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lIZFUm3Lh4Q7kNvwH9rbIX&_nc_oc=AdqynoUbj3v4newXVCqTYVZZq4Ij3QXqTkgpAGnOzPM-jgfmqiRZy4V7G2krdhY1C-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0rwRxet1XFlXzlFlmv-QC3OnkOCG5ynpjLAJwyDQGsQ&oe=6B0DA32C"}, "display_name": "Kangaroo Hop Adventure", "keywords": [], "long_description": "Hop around the world with Roo the kangaroo!\n\nKangaroo Hop Adventure is a bright, bouncy arcade runner on a big screen in front of you. Start in the Australian Outback, then hop, duck and fly through 60 hand-painted cities, from Sydney and Tokyo to Paris, New York and Rio, all the way to the grand World Tour finale.\n\nSIMPLE CONTROLS\nPoint at the game and pull the trigger to hop (hold for a bigger hop). Thumbstick down to duck, up for a super jump. B pauses.\n\nEVERY CITY IS DIFFERENT\nLeap the Barong in Bali, dodge scooters in Hanoi and duck under the New York subway. Each city has its own skyline, hazards, music and a boss to beat.\n\nTREATS, POWER-UPS AND FEVER\nGrab each city's treat to sprout wings and soar. Snap up skateboards, rockets and magnets, and chain perfect dodges to fill Fever and smash through everything.\n\nCOLLECT THE WORLD\nStamp your passport, find a hidden souvenir in every city, earn stars and dress Roo in hats and outfits.\n\nTWO WAYS TO PLAY\nNormal has three hearts. Expert is full speed with one life. Finish the tour and the laps get faster.\n\nMADE FOR FAMILIES\nEvery city included. No ads, no in-app purchases, no accounts, no data collected. Plays fully offline.\n", "short_description": "Hop, duck and fly with Roo the kangaroo through 60 hand-painted world cities. Beat a boss in every city, grab local treats, collect souvenirs and dress up Roo. No ads, no in-app purchases."}]}, "developer_name": "Wingpost studio", "developer_privacy_policy_url": "https://wingpostvr.com/kangaroohop/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wingpost studio", "support_website_url": "https://wingpostvr.com/kangaroohop/", "website_url": "https://wingpostvr.com/kangaroohop/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1498340976689098"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499628449_1111118511522212_1917606543865510325_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R90j9Rj3LugQ7kNvwEYAj5o&_nc_oc=Adq-EHDVxKytjIUdefux_BhEvWBFlnEqEMnbXnIk45OFP_DfPnCOOdkCRT6hdIlrCos&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRWmBKqG3-UEQPsXilSf_xIQE7b_LNU1jQx_ZBHm0ORKQ&oe=6B0DB9CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Kangaroo Hop Adventure", "platform": "ANDROID_6DOF", "context_category": {"context_category"
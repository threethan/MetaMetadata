QpJyFzz-73wFZXgiOgGd75VG10&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7OSz-TT2auMV4CWZAFM9LnbyayG6a4msCnWT50uvhIA&oe=6A3412BA"}, {"file_name": "S1.png", "id": "1404963497232995", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619098_1404963500566328_1291174608547411037_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Fi8we5TVgQQ7kNvwFzp_rT&_nc_oc=AdpNKRWcpTJZ964aD9GWnc-I-R81zIG8sLL0zqf9Xqk0sKvnNifmZ5uIlY2eqI7Yq7o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_ahpCqgOui9uejtaCAyD0UQcRmB1LTTyLgjFHN5Z0aQ&oe=6A33F0B1"}, {"file_name": "S5.png", "id": "1234279628385991", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617762_1234279631719324_927706559217690674_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQxA8xL-N6IQ7kNvwEaRFqF&_nc_oc=AdogLoEPeQ5neeK55LI0-9QPIanFpAYGI0MjDlDNdvTe18zFturH_MNb5CMXVcgadx4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rfvRJNebfV4cWcsRzxjtYWxSYosTUohTSsOuQMNjG6A&oe=6A33EB34"}, {"file_name": "S3.png", "id": "980314034222214", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619704_980314037555547_1689005782037784097_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nx0C-4roFh8Q7kNvwFRABrM&_nc_oc=AdqiNdVelXxU9PXO2o4zeIU9xB1DCPaon20leVxKt-INb-3wgvyjd0JmQf4bdMY1bgs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8OHVszEOgfy38od8J5ANJgg8Cbv7sV6ZsBViq9H4nbQ&oe=6A342177"}, {"file_name": "S2.png", "id": "1095101286078309", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619098_1095101289411642_1431036154553106634_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3VS7E9pWbwQ7kNvwGfoEM2&_nc_oc=AdrUNzdztjqzCSpJz6o7w0RXbCpwvWc7YP5fYvWqf4yEzavbVxAe0AlJUkMaisRW_c8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9DvD7FrbwP00A4sSlF8rlsfistFPhh4-9K8h3j056Tg&oe=6A340E3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta_\u6a2a\u5411\u5c01\u9762_E.png", "id": "1534368744600462", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619485_1534368747933795_8278526335618083188_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ch3aXNt_NrQQ7kNvwFHAQiz&_nc_oc=AdoR5cpWlZcSYVhGfUgK9KnSozErnWonA5WcqA9XX-iTo4QUlhPpTfaETdCNXbwmCrw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9aTN5a8KZepGgnceOp2uEiZGFeNC3YRRUoDzYoS9SGg&oe=6A3416B4"}, "display_name": "Tactical Archer", "keywords": ["3D", "archery", "strategy", "TowerDefense"], "long_description": "An inexplicable portal has appeared, devouring nearby plants and trees. Countless infected skeletons and monsters pour out, targeting the island\u2019s \"Guardian Stone Tablet\"\u2014if destroyed, the whole island will be fully shrouded in plague.\nSo far, the plague has eroded several islands and is still spreading. Now, a border village sends a distress signal: the plague portal has opened, and infected creatures may invade anytime. Its Guardian Stone Tablet needs your protection.\nYou\u2019ll play as an island magic tower defender, using a bow and arrow and a magical sand table to fend off enemies.\n\n# Magical Sand Table: Virtual-Real Intertwine\n\nControl a strategic sand table\u2014your layouts/deductions map real-time to the game world. Place defense towers on it (1:1 with in-game map); same towers rise in real scenes to block enemies.\n{4242375882675877}\n\n# Dual-Front Combat: Stirring Strategy\nYou need to plan overall and arrange arrow towers/fortifications, and can also draw a bow to shoot precisely. Enjoy the dual fun of strategic layout and action.\n\n{2555274818165374}\n\n# Free Shooting Range: Do as You Wish\n\nIt\u2019s a training camp to hone archery and test new weapons, plus a safe space for free movement, exploration and surprise discovery\u2014offering relaxation amid intense battles.\n{1099136968998865}\n\n# Player Command Room: Strategy Hub\n\nUnlocked in-game trophies are displayed too, recording your gaming journey.\n{1845971946325468}", "short_description": "Mysterious island portals unleash plague monsters targeting \"Guardian Monuments\"\u2014their destruction dooms the island. As defender, use a bow (break armor/hit weak points) and a magic sandtable: place towers, real ones rise to block. Game has VR/desktop versions and map editing for custom levels."}, {"images": {"nodes": [{"file_name": "meta_\u56fe\u6807.png", "id": "2294385824332326", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619071_2294385827665659_6198233002582548204_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUU3GRU3NfAQ7kNvwGLmqPQ&_nc_oc=AdoZoPXbAywRSStOPvCOpCoLK7XLp_BWIx03ZKCiHMzMi-A_9FdWu_hhTtOebuIIDeI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-juaEVrZRsssB9nMi9VxGEXlQxkvlftC-KEHqRjPoE7g&oe=6A341933"}, {"file_name": "meta_\u7eb5\u5411\u5c01\u9762_C.png", "id": "1441082273822714", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618367_1441082277156047_2843036638687882267_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbVr4BPbeZ0Q7kNvwFHPM-F&_nc_oc=AdqJlxRrUo_BtZYAu9Xw6O2F0WV6YFrynQPpFlpbooVnjBJZPbmSqz7Yj_Zf461k9QA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OJQdlkRqKfG9jlJRrR1ketlsCflRVP449v3ne1lHgWA&oe=6A341686"}, {"file_name": "steam_\u5e93\u5fbd\u6807_C.png", "id": "787538233819579", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619601_787538237152912_1306075008674910665_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLRtYH4sEjwQ7kNvwGFI_Ue&_nc_oc=AdoZIGFIQeLKzZvbd1yU6bdT1ETH1Avzjonq-K1xL4JkzUudUMxzXV-dG_j87D4dOQM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GSRGrVtvmoTUbOcQucDv3j0pPpMVecjvAHeWdTaJY6w&oe=6A341E7D"}, {"file_name": "meta_\u4e3b\u5c01\u9762_C.png", "id": "780787958250605", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619404_780787964917271_7219342975902499969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSho-Dzf1bkQ7kNvwFMIiTM&_nc_oc=Adq2LCXGFJIn4h1diaCY41M4CUjZOuXkxPWYrmIR_Ko2s5ByLtvZhLkipW7j_KKRWpc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tfGrmM7c8tiPCLloetd6xgvF3eAs5R7hezkm9vCNRUQ&oe=6A33EB62"}, {"file_name": "meta_\u65b9\u5f62\u5c01\u9762_C.png", "id": "758906873615910", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827786_758906876949243_6993018265604807637_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bZfZSqfBkIQ7kNvwEFOfie&_nc_oc=Adps6nwQhq_DnG9y9SIs75r6854esy7-XOyI7l8Iel9YvW90zJbsePp9ow_3EYu6vas&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MMyZh35uoNj0bhtYm0Yuu7R5lTZpQ2HQ75VfPbkuVpw&oe=6A33F879"}, {"file_name": "meta_\u6a2a\u5411\u5c01\u9762_C.png", "id": "682135017612412", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499295992_682135020945745_1151816253067288969_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnfSFhvAKnMQ7kNvwEtOhrh&_nc_oc=AdqVfY364XDP3jf1ui_bTBZZrzjHy_HcbEevUYJjrO3-ZlgG3CAovQeZvp4SrxrMyas&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_58RbAQdLhdvWuFnq42MPBmLwLUAdIs03kmq2jtgC2xg&oe=6A33ED74"}]}, "id": "778019701644454", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u795e\u7bad\u624b\u5854\u9632", "keywords": ["\u5854\u9632", "\u7b56\u7565", "3D", "\u5c04\u7bad"], "long_description": "\u83ab\u540d\u51fa\u73b0\u7684\u4f20\u9001\u95e8\uff0c\u541e\u566c\u4e86\u5468\u8fb9\u7684\u8349\u6728\uff0c\u4ece\u95e8\u4e2d\u6d8c\u51fa\u8bb8\u591a\u88ab\u611f\u67d3\u7684\u9ab7\u9ac5\u548c\u602a\u7269\uff0c\u5b83\u4eec\u653b\u51fb\u7684\u76ee\u6807\u662f\u5c9b\u5c7f\u4e0a\u7684\u201c\u5b88\u62a4\u77f3\u7891\u201d\uff0c\u4e00\u65e6\u77f3\u7891\u88ab\u6467\u6bc1\uff0c\u5c9b\u5c7f\u5c06\u5b8c\u5168\u88ab\u761f\u75ab\u7b3c\u7f69\u3002\n\n       \u761f\u75ab\u8fc4\u4eca\u4e3a\u6b62\u5df2\u7ecf\u4fb5\u8680\u4e86\u6570\u5ea7\u5c9b\u5c7f\uff0c\u800c\u4e14\u8fd8\u5728\u4e0d\u65ad\u5411\u5916\u6269\u5f20\u3002\u6b64\u65f6\u8fb9\u5883\u6751\u5e84\u7a7f\u6765\u6c42\u6551\u4fe1\u53f7\uff0c\u761f\u75ab\u4f20\u9001\u95e8\u5df2\u7ecf\u6253\u5f00\uff0c\u968f\u65f6\u53ef\u80fd\u6709\u611f\u67d3\u8005\u5165\u4fb5\uff0c\u6751\u5e84\u5185\u7684\u5b88\u62a4\u4e4b\u7891\u9700\u8981\u4f60\u7684\u5b88\u62a4\u3002\n\n       \u4f60\u5c06\u626e\u6f14\u5c9b\u4e0a\u7684\u9b54\u5854\u9632\u5fa1\u8005\uff0c\u4f7f\u7528\u5f13\u7bad\u548c\u9b54\u6cd5\u6c99\u76d8\u62b5\u5fa1\u654c\u4eba\u7684\u5165\u4fb5\u3002\n\n# \u9b54\u6cd5\u6c99\u76d8\uff0c\u865a\u5b9e\u4ea4\u7ec7\n\n       \u638c\u63a7\u4e00\u9762\u795e\u79d8\u7684\u6218\u7565\u6c99\u76d8\uff0c\u4f60\u5728\u6b64\u5904\u7684\u6bcf\u4e00\u6b21\u5e03\u5c40\u548c\u63a8\u6f14\uff0c\u90fd\u80fd\u5b9e\u65f6\u6620\u5c04\u5e76\u5f71\u54cd\u524d\u65b9\u7684\u6e38\u620f\u4e16\u754c\uff0c\u4eff\u4f5b\u62e5\u6709\u64cd\u63a7\u73b0\u5b9e\u7684\u9b54\u529b\u3002\u73a9\u5bb6\u53ef\u4ee5\u5728\u4e0e\u5730\u56fe\u4e00\u6bd4\u4e00\u5bf9\u5e94\u7684\u9b54\u6cd5\u6c99\u76d8\u4e0a\u653e\u7f6e\u9632\u5fa1\u5854\uff0c\u6b64\u65f6\u5bf9\u5e94\u6c99\u76d8\u4e0a\u7684\u73b0\u5b9e\u4e16\u754c\u5c31\u4f1a\u5347\u8d77\u540c\u6837\u7684\u9632\u5fa1\u5854\uff0c\u4f7f\u7528\u5404\u79cd\u9632\u5fa1\u5854\u963b\u6321\u654c\u4eba\u7684\u8fdb\u653b\u3002\n{2350161342083883}\n\n# \u53cc\u7ebf\u4f5c\u6218\uff0c\u7b56\u7565\u6fc0\u8361\u200b\u200b \n\n       \u4e0d\u4ec5\u9700\u8981\u8fd0\u7b79\u5e37\u5e44\uff0c\u7cbe\u5fc3\u5e03\u9632\u5404\u5f0f\u7bad\u5854\u4e0e\u5de5\u4e8b\uff1b\u66f4\u80fd\u4eb2\u81ea\u633d\u5f13\u642d\u7bad\uff0c\u4ee5\u7cbe\u51c6\u7684\u5c04\u51fb\u5316\u89e3\u5371\u673a\uff0c\u4eab\u53d7\u7b56\u7565\u5e03\u5c40\u4e0e\u52a8\u4f5c\u64cd\u4f5c\u7684\u53cc\u91cd\u4e50\u8da3\u3002\n{3190629341088323}\n\n# \u81ea\u7531\u9776\u573a\uff0c\u968f\u5fc3\u6240\u6b32\u200b\u200b\n\n       \u9776\u573a\u4e0d\u4ec5\u662f\u78e8\u783a\u7bad\u672f\u3001\u8bd5\u70bc\u65b0\u6b66\u5668\u7684\u8bad\u7ec3\u8425\uff0c\u66f4\u662f\u4e00\u4e2a\u53ef\u4ee5\u81ea\u7531\u79fb\u52a8\u3001\u63a2\u7d22\u548c\u53d1\u73b0\u60ca\u559c\u7684\u5b89\u5168\u7a7a\u95f4\uff0c\u4e3a\u7d27\u5f20\u7684\u6218\u4e8b\u63d0\u4f9b\u4e00\u7247\u653e\u677e\u4e4b\u5730\u3002\n{1450058262711852}\n\n# \u73a9\u5bb6\u6307\u6325\u5ba4\uff0c\u8fd0\u7b79\u5e37\u5e44\u200b\u200b \n\n       \u8fd9\u91cc\u662f\u4f60\u7684\u6218\u7565\u6838\u5fc3\uff01\u4e0d\u4ec5\u53ef\u4ee5\u914d\u7f6e\u5347\u7ea7\u88c5\u5907\u6b66\u5668\u3001\u8d2d\u4e70\u7a00\u7f3a\u8d44\u6e90\uff0c\u66f4\u80fd\u81ea\u7531\u6d3b\u52a8\u3002\u6e38\u620f\u4e2d\u89e3\u9501\u7684\u6210\u5c31\u5956\u676f\u5c06\u5728\u6b64\u5904\u9648\u5217\uff0c\u8bb0\u5f55\u7740\u4f60\u7684\u6e38\u620f\u751f\u6daf\u3002\n\n\n{1872464480034375}", "short_description": "\u795e\u79d8\u4f20\u9001\u95e8\u7a81\u5140\u964d\u4e34\uff0c\u4e3a\u5c9b\u5c7f\u5e26\u6765\u88ab\u761f\u75ab\u611f\u67d3\u7684\u602a\u7269\u3002\u5b83\u4eec\u5984\u56fe\u6467\u6bc1 \u201c\u5b88\u62a4\u77f3\u7891\u201d\uff0c\u4e00\u65e6\u5f97\u901e\uff0c\u5c9b\u5c7f\u5c06\u88ab\u761f\u75ab\u5168\u9762\u7b3c\u7f69\u3002\u73a9\u5bb6\u9700\u626e\u6f14\u5c9b\u4e0a\u9632\u5fa1\u8005\uff0c\u501f\u52a9\u5f13\u7bad\u8f85\u52a9\u653b\u51fb\uff0c\u5229\u7528\u9b54\u6cd5\u6c99\u76d8\u653e\u7f6e\u9632\u5fa1\u5854\uff0c\u963b\u6321\u602a\u7269\u8fdb\u653b\u3002"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dejevis.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Developer Dashboard, OVR Metrics Tool", "support_website_url": null, "website_url": "https://www.dejevis.com/sjsyxjs", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24036401626019235"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1380573240096087"}, {"status": "PUBLISHED", "id": "747354331468516"}]}, "baseline_offer": {"id": "747354331468516"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1765821600, "status": "PUBLISHED", "id": "1380573240096087"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24728167343509323", "version": "0.0.29"}, "id": "690412057133487", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24036401589352572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24728167343509323"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "690412057133487"}]}, "change_log": "Dear Meta Review Team,\n\nWe have addressed the issues related to crystal quantity, achievements, and menu interface in the old version of the game, and have completed updates and fixes for 4-5 bugs.\n\nWe kindly request your prompt review and approval.\n\nThank you for your time and effort!\n\nSincerely,\n\nDejevis", "created_date": 1758122572, "id": "24728167343509323", "version": "0.0.29", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24036401589352572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24728167343509323"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "690412057133487"}]}, "change_log": "The six core highlights of Divine Archer Tower Defense will take you into a fantasy world where strategy and action intertwine:\n\n1. Magical Sand Table: Intertwining Virtual and Real\nTake control of a mysterious strategic sand table. Every layout and deduction you make here can be mapped in real time and affect the in-game world ahead, as if you possess the magic to manipulate reality. Players can place defense towers on the magical sand table, which corresponds to the in-game map on a 1:1 scale. At the same time, identical defense towers will rise in the real-world scene corresponding to the sand table, and you can use various defense towers to block the enemy's attack.\n\n2. Dual-Front Combat: Stirring Strategy\nYou not only need to make overall plans and carefully arrange various arrow towers and fortifications; you can also personally draw the bow and shoot arrows, resolving crises with precise shots, and enjoying the dual fun of strategic layout and action operations.\n\n3. Power of Creation: Crafted by You\nFrom editing the map with every blade of grass and every tree to designing the level events wave by wave, powerful creation tools are in your hands. Create a unique battlefield and invite friends to challenge your masterpiece. The desktop version of the game allows players to customize maps and levels, letting you build a battlefield of your own.\n\n4. Multi-Platform Immersion: Seamless Cross-Border Gameplay\nThe game supports two gameplay modes: traditional PC desktop and VR. This allows you to either make strategies in a comfortable setting or step into the battlefield as if you were really there, fully experiencing the thrill of defending and drawing the bow to shoot arrows.\n\n5. Free Shooting Range: Do as You Wish\nThe shooting range is not only a training camp for honing your archery skills and testing new weapons, but also a safe space where you can move freely, explore, and discover surprises\u2014providing a place to relax amid the intense battles.\n\n6. Player Command Room: Masterminding Strategies\nThis is your strategic core! Here, you can not only configure and upgrade equipment and weapons, and purchase scarce resources, but also move freely. The achievement trophies unlocked in the game will be displayed here, recording your gaming career.", "created_date": 1758017145, "id": "24718339541158770", "version": "0.0.28", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24036401589352572", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24728167343509323"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "690412057133487"}]}, "change_log": "The six core highlights of Divine Archer Tower Defense will take you into a fantasy world where strategy and action intertwine:\n\n1. Magical Sand Table: Intertwining Virtual and Real\nTake control of a mysterious strategic sand table. Every layout and deduction you make here can be mapped in real time and affect the in-game world ahead, as if you possess the magic to manipulate reality. Players can place defense towers on the magical sand table, which corresponds to the in-game map on a 1:1 scale. At the same time, identical defense towers will rise in the real-world scene corresponding to the sand table, and you can use various defense towers to block the enemy's attack.\n\n2. Dual-Front Combat: Stirring Strategy\nYou not only need to make overall plans and carefully arrange various arrow towers and fortifications; you can also personally draw the bow and shoot arrows, resolving crises with precise shots, and enjoying the dual fun of strategic layout and action operations.\n\n3. Power of Creation: Crafted by You\nFrom editing the map with every blade of grass and every tree to designing the level events wave by wave, powerful creation tools are in your hands. Create a unique battlefield and invite friends to challenge your masterpiece. The desktop version of the game allows players to customize maps and levels, letting you build a battlefield of your own.\n\n4. Multi-Platform Immersion: Seamless Cross-Border Gameplay\nThe game supports two gameplay modes: traditional PC desktop and VR. This allows you to either make strategies in a comfortable setting or step into the battlefield as if you were really there, fully experiencing the thrill of defending and drawing the bow to shoot arrows.\n\n5. Free Shooting Range: Do as You Wish\nThe shooting range is not only a training camp for honing your archery skills and testing new weapons, but also a safe space where you can move freely, explore, and discover surprises\u2014providing a place to relax amid the intense battles.\n\n6. Player Command Room: Masterminding Strategies\nThis is your strategic core! Here, you can not only configure and upgrade equipment and weapons, and purchase scarce resources, but also move freely. The achievement trophies unlocked in the game will be displayed here, recording your gaming career.", "created_date": 1757703901, "id": "24690312267294831", "version": "0.0.1", "version_code": 1, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
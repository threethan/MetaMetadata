railer_thumbnail": {"file_name": "meta_\u6a2a\u5411\u5c01\u9762_E.png", "id": "1534368744600462", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619485_1534368747933795_8278526335618083188_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ch3aXNt_NrQQ7kNvwFHAQiz&_nc_oc=AdoR5cpWlZcSYVhGfUgK9KnSozErnWonA5WcqA9XX-iTo4QUlhPpTfaETdCNXbwmCrw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9aTN5a8KZepGgnceOp2uEiZGFeNC3YRRUoDzYoS9SGg&oe=6A3416B4"}, "display_name": "Tactical Archer", "keywords": ["3D", "archery", "strategy", "TowerDefense"], "long_description": "An inexplicable portal has appeared, devouring nearby plants and trees. Countless infected skeletons and monsters pour out, targeting the island\u2019s \"Guardian Stone Tablet\"\u2014if destroyed, the whole island will be fully shrouded in plague.\nSo far, the plague has eroded several islands and is still spreading. Now, a border village sends a distress signal: the plague portal has opened, and infected creatures may invade anytime. Its Guardian Stone Tablet needs your protection.\nYou\u2019ll play as an island magic tower defender, using a bow and arrow and a magical sand table to fend off enemies.\n\n# Magical Sand Table: Virtual-Real Intertwine\n\nControl a strategic sand table\u2014your layouts/deductions map real-time to the game world. Place defense towers on it (1:1 with in-game map); same towers rise in real scenes to block enemies.\n{4242375882675877}\n\n# Dual-Front Combat: Stirring Strategy\nYou need to plan overall and arrange arrow towers/fortifications, and can also draw a bow to shoot precisely. Enjoy the dual fun of strategic layout and action.\n\n{2555274818165374}\n\n# Free Shooting Range: Do as You Wish\n\nIt\u2019s a training camp to hone archery and test new weapons, plus a safe space for free movement, exploration and surprise discovery\u2014offering relaxation amid intense battles.\n{1099136968998865}\n\n# Player Command Room: Strategy Hub\n\nUnlocked in-game trophies are displayed too, recording your gaming journey.\n{1845971946325468}", "short_description": "Mysterious island portals unleash plague monsters targeting \"Guardian Monuments\"\u2014their destruction dooms the island. As defender, use a bow (break armor/hit weak points) and a magic sandtable: place towers, real ones rise to block. Game has VR/desktop versions and map editing for custom levels."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dejevis.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Dejevis", "support_website_url": null, "website_url": "https://www.dejevis.com/sjsyxjs", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24896304906695565"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618928_1356826902627600_9155690089421592359_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIk2aPX4O7wQ7kNvwFn7sDI&_nc_oc=AdofU9ikJofQyiw9dHvWGiaHgaL7VLfXxP8FKKCq2Zu1kNKtlfcc8YSPuNo6IuI_pME&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hqB0WRYyh3LCrGd-8gk55fAYqhYsJbyUQN8e2vklEfA&oe=6A3413E1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tactical Archer", "platform": "ANDROID_6DOF", "context
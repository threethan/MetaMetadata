d3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkVubgk890LYcuwTK1uGobRws6k8FsmgYZ94DkS-UXxQ&oe=6AF5E202"}, {"file_name": "meta_c_4.png", "id": "1539871124824485", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593790560_1539871128157818_2123462542132219230_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20GOZPu1xVQQ7kNvwHRNy8Z&_nc_oc=AdpcLxh0UTWFRTtTuJF64kT9FJILFWk6WHL8T6BxuwNN1Cw6GbT2jBW9QmdUYF1lEeI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYFWLr_JSsiBdlCVfLaoTXAiJ0t5Eu69XCJVOp3iEBlw&oe=6AF5BF0A"}, {"file_name": "meta_c_3.png", "id": "1630291265407287", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623179_1630291268740620_123816304284871934_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fABDvPG7jiAQ7kNvwGt4GYZ&_nc_oc=AdqPezzozE_IzXAH7R9Ir5VZiXAP9t0uTk6E5ar4x4zMZfzT8e0vGicv5XoAezZgzJU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZkDcVNiUo6jpTKA34kP3FL_tVy5iXzfI1NrvtGUZOHw&oe=6AF5EC8A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "meta_1.png", "id": "1414917734182855", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628449_1414917740849521_2127947345155189751_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcr-VSwx-gEQ7kNvwFqsjMW&_nc_oc=AdpBYUpW9DCV1Z4pz7u5uWB3MMofS_iLAJb_G2l6ySAcaSqYJsTQUPl6cNnr4mKivx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGP6Ty7B_WCFGmzz9qqvrAWpDNBJDNf7NLhevKz6jANw&oe=6AF5F293"}, "display_name": "Tactical Archer2.0", "keywords": ["3D", "archery", "strategy", "TowerDefense"], "long_description": "**Sharpshooter Tower Defense 2.0 is here!**\n\nVersion 2.0 introduces new Autumn and Winter environments, two new defensive towers.\n\nMysterious portals are opening across the island.\n\n## Deploy on the Tabletop, Defend in Real Time\n{1121679127032582}\nStudy enemy routes and place towers on the magical tabletop. Every tower you deploy appears on the battlefield in real time. Plan your defenses, reinforce weak points, and stop enemies before they break through.\n\n## Two New Defensive Towers\n{1975108683445552}\n- **Barracks:** Deploy soldiers to block advancing enemies, giving towers and players more time to attack.\n- **Prism Tower:** Unleash chain lightning that jumps between enemies, dealing damage to groups of attackers.\n\nCombine different towers and adapt your strategy to enemy types and battlefield layouts.\n\n\nAll-New Mixed Reality Mode \u2014 Bring the Battlefield into Your World!\n\nBring the fantasy battlefield into the real world \u2014 your room becomes your command center!\n\nSharpshooter Tower Defense now supports Mixed Reality (MR) Mode! Put on your headset and watch the magical tabletop battlefield come to life in your own surroundings. Experience a fantasy tower defense adventure right in your room.", "short_description": "Tactical Archer returns with the major 2.0 update! Plan defenses on a magical sand table and take aim yourself. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dejevis.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Dejevis", "support_website_url": "https://www.dejevis.com/filedownload/2968558", "website_url": "https://www.dejevis.com/sjsyxjs", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28897354333257249"}, 
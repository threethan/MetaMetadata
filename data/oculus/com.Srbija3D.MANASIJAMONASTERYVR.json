o_trailer_thumbnail": {"file_name": "Screenshot_VRManasija_1.png", "id": "539799958235613", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75234364_539799964902279_4585660321663858672_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YVDb6PKX4XgQ7kNvwFEoGJV&_nc_oc=Adoopci5heCL8-bRrQaETNRPI6eiXG0HIpOc2LMhukodFIqV9puZEoPLSRIwBgJeJ_s&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBKUjRWuHo2sSwA1VJnPEdsTb61313qPafS3ClJoPONA&oe=6AFC907E"}, "display_name": "MANASIJA MONASTERY VR", "keywords": [], "long_description": "Manasija monastery was built as an endowment and a mausoleum of despot Stefan Lazarevic, a knight of the Order of the Dragon, enlightener and patron of arts and culture. In medieval sources it is referred to as Resava, and the name Manasija was adopted only in recent times.\n\nIt belongs to the Eparchy of Brani\u010devo of the Serbian Orthodox church.\n\nThis project was supported by the Ministry of culture, sector of digital research infrastructure development in the areas of arts and culture.", "short_description": "MANASIJA MONASTERY VR\nIs the result of the project \u201cPlatform for 3D digitization of immovable cultural treasure of Serbia\u201d that was realized by the University of Ni\u0161, Faculty of Electronic Engineering, with the support of the Ministry of culture of the Republic of Serbia"}]}, "developer_name": "University of Ni\u0161, Faculty of Electronic Engineering", "developer_privacy_policy_url": "https://www.srbija3d.rs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Srbija3D", "support_website_url": null, "website_url": "https://www.srbija3d.rs/EN/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads
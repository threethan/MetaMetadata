name": "MANASIJA MONASTERY VR", "keywords": [], "long_description": "Manasija monastery was built as an endowment and a mausoleum of despot Stefan Lazarevic, a knight of the Order of the Dragon, enlightener and patron of arts and culture. In medieval sources it is referred to as Resava, and the name Manasija was adopted only in recent times.\n\nIt belongs to the Eparchy of Brani\u010devo of the Serbian Orthodox church.\n\nThis project was supported by the Ministry of culture, sector of digital research infrastructure development in the areas of arts and culture.", "short_description": "MANASIJA MONASTERY VR\nIs the result of the project \u201cPlatform for 3D digitization of immovable cultural treasure of Serbia\u201d that was realized by the University of Ni\u0161, Faculty of Electronic Engineering, with the support of the Ministry of culture of the Republic of Serbia"}]}, "developer_name": "University of Ni\u0161, Faculty of Electronic Engineering", "developer_privacy_policy_url": "https://www.srbija3d.rs/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Srbija3D", "support_website_url": null, "website_url": "https://www.srbija3d.rs/EN/index.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "sr"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "913302739794104"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258663_103727297381075
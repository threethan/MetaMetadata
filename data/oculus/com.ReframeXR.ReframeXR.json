g", "id": "1176567197157204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393663_1176567200490537_910746393171300347_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQuG7l_JeIIQ7kNvwHDxisT&_nc_oc=AdrB-5AMLf4RW6JmJO_npo9hHGLRpbBNIzopiaTlVB7Zs4_WOg4Wk9pYbqo7t0CLi4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93Te3kIV9HsHB9j55U-lpbyEEUk4FXNJHN3Mj5l0ziVQ&oe=6A2829C7"}, "display_name": "Reframe", "keywords": ["education", "learning", "reframe", "reframeXR", "classroom"], "long_description": "ReframeXR is an immersive learning platform built for everyday classrooms.\n\nIt helps teachers design, facilitate, and observe small-group, spatial learning experiences that make complex ideas easier to understand.\n\nEducators use ReframeXR to create immersive lessons that integrate directly into their physical classroom. Teachers place interactive learning stations in the room, guide students through hands-on exploration, and lead discussion in real time. Students collaborate through shared spatial experiences that support discourse, problem-solving, and deeper understanding across subject areas.\n\nReframeXR keeps teachers at the center of instruction. Lessons are teacher-led, classroom-based, and aligned to existing instructional models such as station rotation and small-group learning. The platform supports clarity and structure while giving students new ways to experience abstract concepts through spatial exploration.\n\nKey features:\nImmersive lesson creation with spatial learning activities\nTeacher-led facilitation and real-time classroom control\nShared, collaborative learning experiences for small groups\nLive observation of student progress and engagement\nFlexible use across subjects and grade levels\n\nDesigned for:\nTeachers who want immersive learning without losing instructional control\nSchools looking to support collaboration, engagement, and spatial reasoning\nDistricts seeking classroom-ready immersive tools that scale with instruction", "short_description": "Transform any classroom into mixed reality"}]}, "developer_name": "ReframeXR", "developer_privacy_policy_url": "https://docs.reframexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ReframeXR", "support_website_url": null, "website_url": "http://www.reframexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "7022916894495817"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "581806144556783"}]}, "baseline_offer": {"id": "581806144556783"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772116920, "status": "PUBLISHED", "id": "581806144556783"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26162268003467419", "version": "1.0"}, "id": "1676243802783555", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7022916874495819", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26162268003467419"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1780561875, "id": "26882
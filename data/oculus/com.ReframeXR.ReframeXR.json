om/v/t64.5771-25/473391865_508117025664663_253932552401098002_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBM2vhmi4u4Q7kNvwFfzMsi&_nc_oc=AdqjwhfCUMVb0cjX7iHPMDgfBUgDkIw0rMjMuHf59IaYMRx_Puk9CjrFPGAnQdaBPa4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N6R860llkm039_oni1chS_Do1qdDp3rLtLVRo74RAoQ&oe=6A282830"}, {"file_name": "Screenshot 2025-02-25 at 11.15.3.png", "id": "3930761220477636", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473394301_3930761223810969_5573774502442359218_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q4X2CeaB4oAQ7kNvwHbDSdF&_nc_oc=Adq8suDJNiNk_CEWx_8prXSE_KjM_Rn3GzP6jNTlUrCjRUl1hiL8jljxaG9FZxO31rs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uzWz38xG1fYgLv2Eelbsma42SQLDoNSKMQE1F73qSyQ&oe=6A2826CE"}, {"file_name": "Screenshot 2025-02-25 at 11.12.2.png", "id": "1141811730499696", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473397628_1141811733833029_4283287686512832247_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EPq_DtFG78oQ7kNvwHnWXmO&_nc_oc=Adr8nJT0JtlN07C4NfuA0L5L37HnWcPUwD2OAN1EV1cm67fmUsmzQ1zBBf8KO50YOxc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4CY-Rr8k0BfVmzkpKgaOtUMIj2cvY9SQcz9u2pOeyJg&oe=6A2832DE"}, {"file_name": "Screenshot 2025-02-25 at 11.11.0.png", "id": "926985389516510", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393663_926985392849843_1922714290840929712_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aI77_XbWM-8Q7kNvwG57Z48&_nc_oc=AdpcboL-1So_YBxSNbCZF6_Bh7iUL_z8yB9AoBY_rRaZX_dFArTaj-Nz3W8fBT_eW8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pZxUQ3eg6Rn3i4PzckkvRdsCdogK4P2SAHHfgbqFH7Q&oe=6A2823BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape 2560x1440px.png", "id": "1176567197157204", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393663_1176567200490537_910746393171300347_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQuG7l_JeIIQ7kNvwHDxisT&_nc_oc=AdrB-5AMLf4RW6JmJO_npo9hHGLRpbBNIzopiaTlVB7Zs4_WOg4Wk9pYbqo7t0CLi4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93Te3kIV9HsHB9j55U-lpbyEEUk4FXNJHN3Mj5l0ziVQ&oe=6A2829C7"}, "display_name": "Reframe", "keywords": ["education", "learning", "reframe", "reframeXR", "classroom"], "long_description": "ReframeXR is an immersive learning platform built for everyday classrooms.\n\nIt helps teachers design, facilitate, and observe small-group, spatial learning experiences that make complex ideas easier to understand.\n\nEducators use ReframeXR to create immersive lessons that integrate directly into their physical classroom. Teachers place interactive learning stations in the room, guide students through hands-on exploration, and lead discussion in real time. Students collaborate through shared spatial experiences that support discourse, problem-solving, and deeper understanding across subject areas.\n\nReframeXR keeps teachers at the center of instruction. Lessons are teacher-led, classroom-based, and aligned to existing instructional models such as station rotation and small-group learning. The platform supports clarity and structure while giving students new ways to experience abstract concepts through spatial exploration.\n\nKey features:\nImmersive lesson creation with spatial learning activities\nTeacher-led facilitation and real-time classroom control\nShared, collaborative learning experiences for small groups\nLive observation of student progress and engagement\nFlexible use across subjects and grade levels\n\nDesigned for:\nTeachers who want immersive learning without losing instructional control\nSchools looking to support collaboration, engagement, and spatial reasoning\nDistricts seeking classroom-ready immersive tools that scale with instruction", "short_description": "Transform any classroom into mixed reality"}]}, "developer_name": "ReframeXR", "developer_privacy_policy_url": "https://docs.reframexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "ReframeXR", "support_website_url": null, "website_url": "http://www.reframexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "7022916894495817"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_1145503537302991_4409404621761209864_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3OdQvwIumEQ7kNvwFaj0rq&_nc_oc=AdpOW-bANYhYcVtm3p_-_w_r8ftbAYLTNyo-ISVXra9m3yhEKgTSAPfKggXG0xazgUo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LT60CZs_4hYmeYjCLDMzZnpxvAYBWYAJWbEz8GsvgdQ&oe=6A281A5A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Reframe", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1772116920, "lastRevision": {"nodes": [{"id": "7022916911162482", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7022916874495819", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, 
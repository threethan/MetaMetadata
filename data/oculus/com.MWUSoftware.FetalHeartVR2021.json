a0a&_nc_ohc=uZUiPWlwfmcQ7kNvwHUzBP7&_nc_oc=AdoNlEXVL_DzsrTBlM2svI7Ou6AQnA7sDJMZ8ADZat4sucM8C0GEWHy6uuWfZHLKZ2M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkrvofe94D3Rss7Ta5ltotfPHfHQUAId1pED7hCY7tiw&oe=6AFC7685"}, {"file_name": "scrshts_0003_Layer-2.png", "id": "777617422887584", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hy1PxqxvNoYQ7kNvwFUX9iG&_nc_oc=AdqkPQtKAFzvTdX9jNCSihYrwqEJ9IAzoLuzc6IO3W1JXTT6SNRosT5_unmE4G3NJd0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWOA_1QEo8T2z6BPX-rnJYT1kfd4cp5FqsvDVx4KcpkA&oe=6AFC7C81"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6j9l7t8O_EQ7kNvwHxprgR&_nc_oc=AdpJNUTP37AARd06GjBf8iwqpxUCvQPj4gT046qBfDswTyxSRnsTQJ4Gg0gBGxVvYdk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_ClS4-4akQ8KasbbFWFuSkkdADZ8sNFvgSI3SywN4FQ&oe=6AFC6E26"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o1h61Qor8IQ7kNvwGMzyYD&_nc_oc=Adr4fbQ39zvi3b1d749C3mIIxL8BQupkL9IHHWGfxsbZM9W3QTDzZqYysvzwf4RkBbY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6Vc1m9ZQQX2RH5JSu8PoO8TdBsT8I75QahStaax-icA&oe=6AFC8446"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duct1.png", "id": "1397415597298549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974721_1397415600631882_7348845150561262811_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8H23JoHZfNoQ7kNvwEJr-0g&_nc_oc=Adq6xDSSHxpk8Ju7ZSXoVxK7DuMSgmxDwoo4CchW-WnvLIB92k4SewxjU6zyvaYcoM0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS45DeiTqD1HLWHv9XJ5l2beBXvnDMcnfZj7JxMNHJwrg&oe=6AFC6B8D"}, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwusoftware.com/privacy-policy/", "developer_terms_of_service_url": "https://mwusoftware.com/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "websit
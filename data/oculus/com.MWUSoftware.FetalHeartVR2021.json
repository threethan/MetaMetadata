a0a&_nc_ohc=Gxkd2H6iCbkQ7kNvwHxzePf&_nc_oc=AdoiGLWPu2am4snMwokjH4u38abOjM9MvEv5_X8OOzV2k4Q_K8NQnwJ_LCRf854A0Ew&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBbBiE_hYMQ0ujTA0RV-WEJqJeEOFUGS5f6RjLTetxUA&oe=6AFF1985"}, {"file_name": "scrshts_0003_Layer-2.png", "id": "777617422887584", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsyYsG3v7ioQ7kNvwGwQljL&_nc_oc=Adqh8JTG9jWA3Ddew4Hqz469xFLK_KAc6WWnnWYSoLboswWk9at1W6e3p6Fxpfc3b74&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV2CtPgRWdjL9BqQDE6onzJHjOozbj90ZT-TNBm24P6g&oe=6AFF1F81"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjL9MuY5itkQ7kNvwEuiAoT&_nc_oc=AdpIBlTfWOW1H7afbsZKIDuTfTPJbs-Jg6eqjKo2INr09kDa6QkCA84B4JWiheU8W0o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOGTZSHHEuZ8IfT6wk70Rb5HAjvl8X2nArdrsR7W5YXQ&oe=6AFF1126"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3o1h61Qor8IQ7kNvwHox5YM&_nc_oc=AdrA-eftRNQLvHNDNbyy4MoBV6iom_cuI4rPg9Fv7mIy_ec_i9HaJeo3LF545avdzy8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6PIqJk1W9dh2SoPQ5XniVAMTPq9FvwVVAFf4bTkoXmg&oe=6AFF2746"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duct1.png", "id": "1397415597298549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974721_1397415600631882_7348845150561262811_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8H23JoHZfNoQ7kNvwEIRqKy&_nc_oc=Adr0rM_mc6xfLGcgzRir7MEy56QBCJXs_0GxE-gL5Uyh7JRWGgyMUipz9FLAoH4Rj0E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR01197P-mqOirDWjAdbj46Oa71BXAGbit6aKuuinIqrA&oe=6AFF0E8D"}, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwusoftware.com/privacy-policy/", "developer_terms_of_service_url": "https://mwusoftware.com/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "websit
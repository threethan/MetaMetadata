r-2.png", "id": "777617422887584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLD7jly1bRYQ7kNvwG_5MBO&_nc_oc=AdmVcOdCAvVQU00CBuK8P5qxCq5BCO-eziVJZxD1I7FkBvBmsBFEGHQatBGsbaSXtvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwB_c3cj8lc2S-gD8z0WnCIN9pzBPUgsZTvA8GquMHTPQ&oe=69AEB8C1"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elhd80R-6RQQ7kNvwGlN8g7&_nc_oc=AdmiHzLFZE1uxHW5hWUBEukD0pHsqVAAjlYyy28dKy2KN0uzEgB6NrcocUFyX5LazKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfziwPoOjfunE0-sMQ25zVO9IAtESLtMjwZKipsUJVW-BA&oe=69AEAA66"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Eo-HWpMBUMQ7kNvwHCkWVZ&_nc_oc=AdmbKKgrU7sp1umLOZObRr-rjmMtNQPcEYbmVVC1G_3muxectYY2EeyTvS7a0Jn6qzI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEP13RidaTCaq84ZfuEMXV5sqnYnbACr13NVNebc2AKg&oe=69AEC086"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duct1.png", "id": "1397415597298549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_1397415600631882_7348845150561262811_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNzFgZIn-FwQ7kNvwF4BnCL&_nc_oc=AdllxuUs1aAk3Wj0m3qDYGz_L8oNqLiIWyGtIjtVl-NSoL03wWvjwGHRAe_yqVlkWeA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNUNdzL76METchGs9ICtmCLcpHxxSKOli-r39R_L4JeQ&oe=69AEA7CD"}, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwusoftware.com/privacy-policy/", "developer_terms_of_service_url": "https://mwusoftware.com/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "website_url": "https://mwusoftware.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDICINE", "SIMULATION", "EDUCATIONAL"], "has_in
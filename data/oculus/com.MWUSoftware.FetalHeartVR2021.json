a0a&_nc_ohc=8yNrYp3tYz8Q7kNvwFesmYy&_nc_oc=Adqi88oEeqknjGs8-GZ09_MS-_7zaYEnMoVIOTGvRAbCk-JnG97rMoTPmgO35KMhmhU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxQXIfCaXw7MvVQd0G8hc3_tSROnJgy-aYGDTJWG9bDw&oe=6B09A585"}, {"file_name": "scrshts_0003_Layer-2.png", "id": "777617422887584", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgKgFYgHg2cQ7kNvwH8L9I-&_nc_oc=AdrR61vTta3cLWenezqCvrcyLvX_h9fEwR0SQekcvWNIKePB1H-2NrQ00HkQQFzYjX0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5QH-Am4i3EONWIDD9EVfl1bJ_9UWxmbVAxh15Bxxhug&oe=6B09AB81"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqiesoZoa08Q7kNvwEkv3D4&_nc_oc=Adq1U-DFvRE6rmX4SQeWQf9RaSwHweBbBd_xRawlL4gfsQjPsbOXNj12p7js-cit9aw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKZhoLkH0-BAXSwl792nn6RBAlwnUJ5BICeBOSU3jYAA&oe=6B099D26"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GclmS5PhNRsQ7kNvwFOp9nu&_nc_oc=Adr2XnYbx0ahdZRQNWz-TXIVGZes4NlSOSro5JOl4kGKEHHIHEiAQfmVM_9Gf5ewLMY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8qeh7J99jV7qVb6jkBFYozPUp32RwX-zfzgZbEsJX9w&oe=6B09B346"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duct1.png", "id": "1397415597298549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974721_1397415600631882_7348845150561262811_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_fdFIVqD0kQ7kNvwHsZ9hY&_nc_oc=AdoY5j_7_mR22090bOLESE87JDCc1mf8EqcF3FVdnwpfr1ttSWv0SUSWy3bYlvBfUdU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIqn2xpAZmkwlH1gnKHoSy2zQ3hT_wkpZJ5vUJ6PpIag&oe=6B099A8D"}, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwusoftware.com/privacy-policy/", "developer_terms_of_service_url": "https://mwusoftware.com/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "websit
a0a&_nc_ohc=g0kBt8nsH7IQ7kNvwH7LQhk&_nc_oc=AdpBwUdDympkPKHzV2ksVo7C1nbHxvBYJla9nsFEtPsQUguHi_LkHHAvdsrv4CFG3ac&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3Wz1MTt_tTRRiXUHQyW8c3185EFDAWq6L17sdPmUAXg&oe=6B05B105"}, {"file_name": "scrshts_0003_Layer-2.png", "id": "777617422887584", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s2Jg8bOngysQ7kNvwG8i1WJ&_nc_oc=AdrY9WhPi_jMN6szrpdWDEPIvVfmiqnaNoem8wXGAX2o4jJ9_MoepUKrEG3hgaYg8cQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMbrqy9uNMUHZuZPZ_jyD4gWLf9iY1vZv46zYPPjzD-Q&oe=6B05B701"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIXQp2x4QBYQ7kNvwFvzopy&_nc_oc=Adrrbo-DqaAgf2v47AeVIIxDxdytvM709KTpVQdM9-w0vWE3cMfN1QPDIu4L-G7TidA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQamE6jvDHyLBeUpcGW5HXwh2PaY1pF2jJPdTS7FN3vgA&oe=6B05A8A6"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdmpmJtFyMEQ7kNvwHRcG5c&_nc_oc=AdpZMX_wZ0i6Ta4IN6EzCdZAt4TAPLX3T8cCW8gzb0dMuK5d6jx6Cfvctt4aZoNA5uo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSyesOMSUnxveYKAqgLKSmJpLq2C4dxRKwxM7be9lBNg&oe=6B05BEC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duct1.png", "id": "1397415597298549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_1397415600631882_7348845150561262811_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3IFWfB-rTcQ7kNvwH9ywUe&_nc_oc=AdqMWVGrgbuhWVj4mcyCTcxAdcybkltFVJ6x8AQaMO0vAcWQ_91mgnFvh-uctFetZfg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfIaIZBF3goGexdr6C0u3vbp3FxY17TjsjHuxaw8ViFg&oe=6B05A60D"}, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwusoftware.com/privacy-policy/", "developer_terms_of_service_url": "https://mwusoftware.com/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "websit
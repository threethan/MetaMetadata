c_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcPPeXAkQx-CE_69Ent-KmTV7pSRMQ7_Wmql-vXdYUAQ&oe=6AD24685"}, {"file_name": "scrshts_0003_Layer-2.png", "id": "777617422887584", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkp677cQwX0Q7kNvwHDm9o6&_nc_oc=Adrbm2euGKmPpDJP_F9BBQKfYGQDDgHr3ILAiUcHfyd4u9nbMhO9MNhs_UJGQ5sbwiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7B8JTxvxduG6LloIbE4UlUZlGlwPk2k-vzhFKa9TZbQ&oe=6AD24C81"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xMLFU0RzXQYQ7kNvwHo7RAH&_nc_oc=Adqfrf1QbWZhHar_fysdyFf1czY4FP4JLcO1A-_3mNQw2g-LRWiZpiDLTQGW9FGCMs0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlFkVPCszWH2Od5fWXL-dVAX-zxVTSW9EvRjm5C9JflA&oe=6AD23E26"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BpmNk2MRg2cQ7kNvwEGFpsA&_nc_oc=AdoQjw6TNRmX7XrsB96vIqJ5sDg2OAyDBq0Mzp97Gm8d97q61kfEToyyERbo9phtCLI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNA8X30W7XA7fQLY28REtzUJeMbQHnr70b2x73khyOkGQ&oe=6AD25446"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwu.gridproducts.pl/privacy-policy/", "developer_terms_of_service_url": "https://mwu.gridproducts.pl/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "website_url": "https://mwu.gridproducts.pl/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MEDICINE", "SIMULATION", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "979002403045325"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "287570766387005"}]}, "baseline_offer": {"id": "287570766387005"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1624292280, "status": "PUBLISHED", "id": "287570766387005"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3822305317879282", "version": "2.04"}, "id": "802061334078040", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3672461322863683", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3822305317879282"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "802061334078040"}]}, "change_log": "Fetal Heart VR version:2.0.4. \n------ \n\nThis is an initial release of our Fetal Heart VR app prepared for Oculus Quest and Quest 2, and a major upgrade from the Oculus Go version. \n\nWHAT'S NEW: \n- In the Quest version you are able to completely reproduce all the movements done with the echo probe during the examination, \n- The design of the Quest platform allowed us to improve the interface significantly. \n- This version covers a completely new model of the Normal Heart, that includes much more anatomical detail of the Heart and nearby cardiovascular structures. \n- In this version, we start to introduce Quizzes - a way to challenge yourself with recognizing different Congenital Heart Defects. \n- Freeze and CINE options are now available \n- for Normal Heart, recommended views from ISUOG, AIUM, and ASE guidelines can be detected \n- you can turn on the natural movements of the fetus that occur during any echo examination. \n\nSUPPORT & QUESTIONS\nAre you having problems? Do you have a suggestion for a new feature? Please, write to us: \ninfo@mwusoftware.com \n\nHave a great day! \nPiotr from MWU Software", "created_date": 1623096733, "id": "3822305317879282", "version": "2.04", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3672461322863683", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3822305317879282"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1623093053, "id": "3822180487891765", "version": "2.04", "version_code": 12, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3672461322863683", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3822305317879282"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1623091965, "id": "3822145597895254", "version": "2.04", "version_code": 11, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "367246132286
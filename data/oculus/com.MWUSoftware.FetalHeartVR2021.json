a0a&_nc_ohc=mwfouHRLLWsQ7kNvwGWfegb&_nc_oc=Adr_rhRgXs7lZG1LxAAVPyYq-rZZAuOo8EQ0H2Bkud2yFoUMmsKaDGQhla9xU5PQMVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9wz7FMzCwhPtIwdru08OuRXRFb7ScRzu1hr4IhgjDwg&oe=6B0F23C5"}, {"file_name": "scrshts_0003_Layer-2.png", "id": "777617422887584", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuvDzJBgLbcQ7kNvwFB4j2F&_nc_oc=AdryWqdKnC-aJlLnXzW2hu8vC95HtKKwHklmtHkZRWl1QSEYMOny_VEJJtyUzdMWdBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWfWbGdhpMmaR1rGhF5_XzonQG7henIgHXw4VvXnfVgOA&oe=6B0EF181"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZOg-O3s12sQ7kNvwE_aZHg&_nc_oc=Ado6BUJ-bondJ0Axbae6S-t2HxP2dXIY9cZxyVdSFnxt-pGDy_6g6WPEMHkt_w93s5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWKtE955VDN2-_HoxjtPFvMgoXvNwYN5y7gP0G_DCsIBA&oe=6B0F1B66"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hpm9gXytcK8Q7kNvwHgKmKV&_nc_oc=AdqqPeqAeMysG5CVuQYHiiZ4yZZFmBdsoMtm1ndeMzGXOZXl7g36eINQupoGorhcrsc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWk1jCJ191o90oPIu8FFtOa4j_tMY_HJx2nA9-CNJ4Tzw&oe=6B0EF946"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duct1.png", "id": "1397415597298549", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974721_1397415600631882_7348845150561262811_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlL-rnbz_W8Q7kNvwFs4NcU&_nc_oc=AdrDAzpFeM3H5xg8_DEejnRd5MZfOMSc4zBLgUvoujGZMka8m7LXXvOPNXlcS6giLNI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWD_tfjw7LVxAs2l4Es6ekOE0Xpc8d7IjDHSp6HyVYMnw&oe=6B0F18CD"}, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwusoftware.com/privacy-policy/", "developer_terms_of_service_url": "https://mwusoftware.com/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "websit
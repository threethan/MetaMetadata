a0a&_nc_ohc=mwfouHRLLWsQ7kNvwElaOKZ&_nc_oc=AdpvXMOTPecJ1ilAnE4qHjgH7uDZonJw2_ZEvBZ6kSgLbWd5tZECQ7Wf1ZM2AyPATwk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRZ5yIUvOdSCJrZZ8xXdAuEVkmgvorH1tx5HCVAZggKYw&oe=6B0D9A05"}, {"file_name": "scrshts_0003_Layer-2.png", "id": "777617422887584", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuvDzJBgLbcQ7kNvwHQfo3D&_nc_oc=AdoP1NXSRwgyPDrBs9bfrbDJhF9yXd2a5ad3Az635O3ZvldTn390En8J8xLrpT_6PeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSV-mumJY1DEzfs5Km6iU2v01RhL_FDitz0L__ay0GsmQ&oe=6B0DA001"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3GUY_E6PQkQ7kNvwFZgwDv&_nc_oc=AdpuuF8vFLEawGy4KsMIwGwNd74l5sMWCmCNuKETREvcB3_SmSRNYb5vMKtqke8JudA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRygr3oVbz5YCahzNb4Op8Mc5bYW4G2dGqtfThwWmo0hg&oe=6B0DC9E6"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hpm9gXytcK8Q7kNvwF00Q_Y&_nc_oc=AdoBXOlr3VGqotz-Q2YRm3FEk5Ok05QS2HGTmKyk9oGtgq1SRQgYutU1xKcSn-zDg4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSZhH6NuW7-ne-oxc671s5uBO3JLu6OYhYcfuKagJT62w&oe=6B0DA7C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duct1.png", "id": "1397415597298549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974721_1397415600631882_7348845150561262811_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlL-rnbz_W8Q7kNvwEukcuN&_nc_oc=AdokdNR7sLV57-KAJXI9tTFvSLNp-a3hGSflJd7SM5Mfuig5u73TMqMHselpqmlM2PY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5zzcRd3jViPwMT1Bprrg_bM0OYbx5DzQX06aqUl40jw&oe=6B0DC74D"}, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwusoftware.com/privacy-policy/", "developer_terms_of_service_url": "https://mwusoftware.com/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "websit
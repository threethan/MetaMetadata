a0a&_nc_ohc=xXvl6yDnYJkQ7kNvwHGj2CA&_nc_oc=AdrVEg6bTVcTaLyVCSYOE_AzVu7SefnfeFgEp9zUlGtoDXeTjdgvUvlbY0hToUNwfMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLVNyOkvCEP46AVhF6h-xyVKmjDOP50PADNwevNKyQJQ&oe=6B030E05"}, {"file_name": "scrshts_0003_Layer-2.png", "id": "777617422887584", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toxyQbguiqsQ7kNvwEPb9GZ&_nc_oc=AdobhxolYByTMKlDax-PiPKevN-rAgR1eILQyDb0fdTFw4aO4kgEMZcKd_oci_jXb54&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVhc3j6iA_UCzoPu1eNR0tN3W_R2zF1Jl5zj2KHV3y7g&oe=6B031401"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIXQp2x4QBYQ7kNvwGAnD9g&_nc_oc=Ador-cGmbIAIlHakHRmHFsCRj_yu3LQynq8JxnjTJdm4rTVj_AiTVsFNBl7V7F3xubU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeUdSsg8bzsY-MEw-hfze_02nqx5Y6vHhhpzPPyTxmKA&oe=6B0305A6"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLWdypfviS0Q7kNvwENJ7ak&_nc_oc=AdrUlkAL4rudH1Wr-IvNk7YAfmHo_tTB1xnv8_zlULw8Jfc4OIehDGsDEzD2_v1r2UA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgTYMfFJKm8x7NH9NfqZpJpe1fj31-QHxOCwJb0lN6Qg&oe=6B031BC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duct1.png", "id": "1397415597298549", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974721_1397415600631882_7348845150561262811_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CUoapARLjSoQ7kNvwFTnSeW&_nc_oc=AdqoRsCO1nWVlWtEUQjhXU1Lwg0xcd32xpoQwGrGS58VbU0WtLD6Kc-acdH5SpgYsw4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7RPC35KM_hvRzSui83-m-RV8pg5VJ7A5UpiXqsFdYPw&oe=6B03030D"}, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwusoftware.com/privacy-policy/", "developer_terms_of_service_url": "https://mwusoftware.com/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "websit
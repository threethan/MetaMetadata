"}, {"file_name": "scrshts_0003_Layer-2.png", "id": "777617422887584", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzDT98A4mQMQ7kNvwHQrJMe&_nc_oc=AdrTHTFc3K0FLFywGJNAfxi2R_008Q-cUSIFQa5YYYZaYiO0tXBydsR-ExwYTcEqGQ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOtFG2OKIuhatl-I4_b2BxGryHnu_MVcklJjjpMAdscg&oe=6A511981"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oog3zyawtZAQ7kNvwEoY0o4&_nc_oc=AdrIdEpYsNs_L45DLyzACNmriAv09QdAwgdgxmsUA2_dITwzT925wDk4SWWs9WKAbQU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcEpyttpDldkivrYpMuTUarUq2iH9I9v5_Aki-1m7KAA&oe=6A510B26"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8PQM7pA-QwQ7kNvwGLAgtS&_nc_oc=AdowEVz40hTzIJkSygj-ORzzf9RrNq3TqGfosuGKvECcp6IF8ZbUqUYNlBF6Ut1PP8U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkXWQh2gudrarkSm1Bsen8f1QPsqBd2AMc76BQns-5dg&oe=6A50E906"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duct1.png", "id": "1397415597298549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974721_1397415600631882_7348845150561262811_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7-PGJSFCesQ7kNvwHkyX3N&_nc_oc=Ado0k8dnwe9oW9dLY6wa3mnD3v19IM9abF3uNghjjBJVc3LeBT1vk2RSr45HXHmQD_I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtLXMLkQMxl_PC3U-uJOQesIHcUVRNMymopNbeqytFXQ&oe=6A51088D"}, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwusoftware.com/privacy-policy/", "developer_terms_of_service_url": "https://mwusoftware.com/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "website_url": "https://mwusoftware.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres"
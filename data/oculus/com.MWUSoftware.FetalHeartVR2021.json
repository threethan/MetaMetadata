"}, {"file_name": "scrshts_0003_Layer-2.png", "id": "777617422887584", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42-j-Ylo-CAQ7kNvwGWUzkl&_nc_oc=AdoT1Au2aqaxa0jPeMr7Hq0OrnvJUXIGPXwiIamodlST21FnGOxC8mfNT-eeTzx5gzw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35E_XHxB1vnBIr4bXZHOPeYcgQxarEaRGOv8dZng2qpQ&oe=69EA0C41"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=he_qWQWJWL0Q7kNvwFEaRoJ&_nc_oc=Adr7lGwaYGLZKnb5-v5mUaP481KUCbEO_jvGaXOzdImCppHXB9fOAM6VRWDWQ0AsXJ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af178In27FXzKwpcl0YS4WSpwEJ7kbxWzZp3fGVy-nUtOw&oe=69EA3626"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OllYmKelqbUQ7kNvwFQJ3wg&_nc_oc=Adov9-jyF6NqbzZfS0QyrMlMuGp3YzI6v3mYAS4FJhAbhmnCN5yC1haB_rdBeM1hB1k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Okq84sFkCiPAGkZ8GtDynAJY0LU9MuZO6PjoYIvV9uw&oe=69EA1406"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duct1.png", "id": "1397415597298549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974721_1397415600631882_7348845150561262811_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZ3aNpxpC5IQ7kNvwE9bAks&_nc_oc=AdqI8cKXkMY7TYKwmucSYzNuYLr7k1mM9jebqji99V-S3tkg0UFLhGurR-IYk0G2bU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iLFm7kUzNm0tJcuAedF1naPB5OgRy4UZDu-MOwcLKBw&oe=69EA338D"}, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwusoftware.com/privacy-policy/", "developer_terms_of_service_url": "https://mwusoftware.com/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "website_url": "https://mwusoftware.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres"
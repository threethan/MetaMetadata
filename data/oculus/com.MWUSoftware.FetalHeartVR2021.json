A42205"}, {"file_name": "scrshts_0003_Layer-2.png", "id": "777617422887584", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39001663_777617426220917_5046911845590742222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PuEUJdT7D4Q7kNvwECc6Am&_nc_oc=AdpfXKGURY9mA3EDKnObs51PIDDOCwvgLmbx-awYoxTTMQODB4AiQEgeq_Df9st9dv8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLhyvi37GRLhG6kpHq3auJQYTgPkNs11YgwHToqJZlfQ&oe=6AA3EFC1"}, {"file_name": "scrshts_0004_Layer-1.png", "id": "522467975409751", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974909_522467978743084_3999197066674584349_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBHT64PXFmEQ7kNvwHpjzvy&_nc_oc=Adr1pyj6ryVQurX7alz4IulJ4-KB2L2r6L9OevHNLknqOzIiwdOZZY47kYavb4N-HMo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9Y2sY82DQbkQBovLyWGZbuWmMWYP8bW7EqhYE4OPyJQ&oe=6AA419A6"}, {"file_name": "scrshts_0002_Layer-3.png", "id": "299838361722592", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982602_299838365055925_766843420144144362_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYVv_om-V9YQ7kNvwG-jzjZ&_nc_oc=AdrZ4mFedAi6yU3V6yeONbfyQF5wplvf8D9p2ak_gEgoYzxJGWWpRLyonEVslZbqSIw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqJ-FfRdV16NjRXwMukiEh0eRdUpvy5O-eqeYI3xYQoQ&oe=6AA3F786"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "duct1.png", "id": "1397415597298549", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974721_1397415600631882_7348845150561262811_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qIMq6iRxgJsQ7kNvwHU2dV5&_nc_oc=AdpzTBR8YWMiphpI_EMWhl4zLv2onyoGKr18vEJFy2FinD6dwLjAICkOlr1XFlSU_w0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1hUNbATJJmm5d3ep5RQneuxCuOnKziMnmr-loGmUG8Q&oe=6AA4170D"}, "display_name": "Fetal Heart VR", "keywords": [], "long_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\n\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical and geometrical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination\n\nWith the Fetal Heart VR, we hope to enable a more personal, affordable opportunity to learn how to perform ultrasound scans, available for all professionals involved in prenatal sonography.\n\nThis version includes a healthy fetal heart as well as 14 Congenital Heart Defects: tetralogy of Fallot (TOF), Transposition of the Great Arteries (dTGA, lTGA),  hypoplastic left heart syndrome (HLHS MS-AA, HLHS MAAA), Critical Aortic Stenosis (CritAS), Atrio-Ventricular Septal Defect (AVSD, uAVSD) Double Outlet Right Ventricle (DORV) and more.", "short_description": "Fetal Heart VR is a self-teaching tool to learn geometry, anatomy, and function of Congenital Heart Diseases.\nWith the app, you can make a virtual ultrasound scan of normal and abnormal heart models and learn specific anatomical features typical for Congenital Heart Diseases. The controller simulates the ultrasound probe - by moving it like an ultrasound probe you can obtain all recommended fetal cardiac views for prenatal examination."}]}, "developer_name": "MWU Software", "developer_privacy_policy_url": "https://mwusoftware.com/privacy-policy/", "developer_terms_of_service_url": "https://mwusoftware.com/terms-and-conditions/", "publisher_name": "MWU 3D Models z.o.o.", "support_website_url": "http://mwusoftware.com/", "website_url": "https://mwusoftware.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED"
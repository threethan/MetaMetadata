z_peFErdmBsXBNB1VptOeP8EMSWSqvD7_sCqxYkc7hDNTjSdyONF_BVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RHqYaS_wcMchkIkZ35Ng5ELudltHF5ruhgiY47Ag9Jw&oe=69E8ABEA"}, {"file_name": "3.png", "id": "389318003341239", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974676_389318006674572_4975684874678432404_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlhDamU6Q4YQ7kNvwGCyPXC&_nc_oc=AdonNbkDMBNmz16ciTHvJ3OLoCRJMOFOGfncPOAS0jHejRN6qIjSV2-GqjWdI_ukmos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JYtjeiGWvKypRxZzWXb1FqORWAPiStY5HhVTUaaNUmg&oe=69E8B660"}, {"file_name": "4.png", "id": "765723084463348", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035421_765723087796681_5395430997064860409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pbNlBAcLxUQ7kNvwEk-tjD&_nc_oc=AdoK5tGpOMfLg_ApxTogNpIon3y7HDwNnGnlOUmgCMQ7bpCc8ALLDmivyIoaBzxvrR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DyEy7HBcjtHQmpSrAXUo4rrN3nWmQa30Bjxchx64Yvw&oe=69E8B35B"}, {"file_name": "5.png", "id": "713609556367670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974844_713609559701003_1039717971429585349_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYQ6yWT9-EYQ7kNvwEghAWG&_nc_oc=AdoScUYvm34eB3Rec_dALWiMurw9V1vxUUzKN0vVRCUdEIjbyTr6K_pF6B1oYjrBJt4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GJnuTXbJu7x4HGxzMEJoWuyJOIQxAKPHZDardOxoNJw&oe=69E8DDC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u00d71440.png", "id": "596418372081994", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974924_596418375415327_6487005384461674980_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E39qu_8cj3YQ7kNvwHZ7U1K&_nc_oc=Adojtq5nCgoUCPmFIayvASbe_iXSuHahwdjd1iqMYVaS00XPATG5lTEWP-yrsUBL0ks&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vMHPjU0r-y64HK38AVpwmBCwJr21E0dZhuRjRTrw9Ig&oe=69E8DA59"}, "display_name": "ESCAPE SIGHT", "keywords": [], "long_description": "You who have escaped the horrors, What awaits you outside... \n\n\u25a1About the game \n\nESCAPE SIGHT is a VR horror game in which you escape from a eerie mansion. In addition to the action, there are simple riddles to solve. It is easy to play. The controls are easy to operate even for VR beginners. \n\n\u25a1Story \n\nWhen you wake up, you find yourself in an unfamiliar cold bathroom. Escape from the dangerous house by evading the attacking inhabitants. What is the scene that spread into the outside world when you succeed? If you make eye contact, It's over. \n\nSee for yourself.\n", "short_description": "You who have escaped the horrors, What awaits you outside... \n\n\u25a1About the game \n\nESCAPE SIGHT is a VR horror game in which you escape from a eerie mansion. The controls are easy to operate even for VR beginners. \n\n\u25a1Story \n\nWhen you wake up, you find yourself in an unfamiliar cold bathroom. Escape from the dangerous house by evading the attacking inhabitants. What is the scene that spread into the outside world when you succeed? If you make eye contact, It's over. \n\nSee for yourself.\n"}, {"images": {"nodes": []}, "id": "685225526141812", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE SIGHT", "keywords": [], "long_description": "\u5916\u306b\u51fa\u305f\u3042\u306a\u305f\u3092\u5f85\u3061\u53d7\u3051\u308b\u3082\u306e\u306f\u30fb\u30fb\u30fb\n\n\u25a1\u30b2\u30fc\u30e0\u306b\u3064\u3044\u3066\n\nESCAPE SIGHT\uff08\u30a8\u30b9\u30b1\u30fc\u30d7\u30b5\u30a4\u30c8\uff09\u306f\u4e0d\u6c17\u5473\u306a\u9928\u304b\u3089\u8131\u51fa\u3059\u308bVR\u30db\u30e9\u30fc\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\u30a2\u30af\u30b7\u30e7\u30f3\u306e\u4ed6\u306b\u3001\u7c21\u5358\u306a\u8b0e\u89e3\u304d\u3082\u3042\u308a\u307e\u3059\u3002\n\u5c11\u306a\u3044\u64cd\u4f5c\u3067\u904a\u3076\u3053\u3068\u304c\u3067\u304d\u308b\u306e\u3067VR\u521d\u5fc3\u8005\u306e\u65b9
c=AdoAnODyTJybPHMC76a970V6ZfnIjzeeWvBydM8F6ruQpWF9VAiQR5OiZ_Rc5gpSgkM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWnnaCe8DRB7gEU8sMw_y7OILafNhSJdXMvaBBdzQ02Q&oe=6A858E6A"}, {"file_name": "3.png", "id": "389318003341239", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974676_389318006674572_4975684874678432404_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=chrTdFcwsTUQ7kNvwEWHTBd&_nc_oc=AdqCmevq9UnZjQN3k18UW9BZPn_0kKzhe_njgt7xiap1HZv4auLwTUoAv5k4nG8Ozcc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQIMA0J8wb5V3oJAxaEkZ8NYDtUPhkgpuXdCw3TDsFfQ&oe=6A8598E0"}, {"file_name": "4.png", "id": "765723084463348", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39035421_765723087796681_5395430997064860409_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MM84Ocksbq4Q7kNvwGS7iRU&_nc_oc=Adod-6gF-3LplevFK-FIObjSVto10tAXPYElsQv0TTcys__xKQvRgADzqwITETx8DKg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn_maMd4zh61jx8lVrCNPRwmRheXB6XPjzewJE26d0MQ&oe=6A8595DB"}, {"file_name": "5.png", "id": "713609556367670", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974844_713609559701003_1039717971429585349_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGOVIn5q8SIQ7kNvwFFk4Kd&_nc_oc=Adoe8d5Q9bcbsCuDniVZRX2xuw5BpeU8qSftlc5Vb-0MstzQ-95CnsY9d-dCsisKvtI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBVusPOsfiFf1qLN8ksduP5keUzc3g3cIWluSu_rK4Cg&oe=6A858804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u00d71440.png", "id": "596418372081994", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974924_596418375415327_6487005384461674980_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGwYTqHV2e8Q7kNvwHvY6KR&_nc_oc=Adq0z93OS5B0zY7BJHc10178FMZPLcBk72OHnVS0TpLXqso0hrgDugpk7fwa6md56N8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2W27B9bo5WRG91zZgR9-Zcj34ry-kkaRvowHFvbxUGA&oe=6A858499"}, "display_name": "ESCAPE SIGHT", "keywords": [], "long_description": "You who have escaped the horrors, What awaits you outside... \n\n\u25a1About the game \n\nESCAPE SIGHT is a VR horror game in which you escape from a eerie mansion. In addition to the action, there are simple riddles to solve. It is easy to play. The controls are easy to operate even for VR beginners. \n\n\u25a1Story \n\nWhen you wake up, you find yourself in an unfamiliar cold bathroom. Escape from the dangerous house by evading the attacking inhabitants. What is the scene that spread into the outside world when you succeed? If you make eye contact, It's over. \n\nSee for yourself.\n", "short_description": "You who have escaped the horrors, What awaits you outside... \n\n\u25a1About the game \n\nESCAPE SIGHT is a VR horror game in which you escape from a eerie mansion. The controls are easy to operate even for VR beginners. \n\n\u25a1Story \n\nWhen you wake up, you find yourself in an unfamiliar cold bathroom. Escape from the dangerous house by evading the attacking inhabitants. What is the scene that spread into the outside world when you succeed? If you make eye contact, It's over. \n\nSee for yourself.\n"}, {"images": {"nodes": []}, "id": "685225526141812", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE SIGHT", "keywords": [], "long_description": "\u5916\u306b\u51fa\u305f\u3042\u306a\u305f\u3092\u5f85\u3061\u53d7\u3051\u308b\u3082\u306e\u306f\u30fb\u30fb\u30fb\n\n\u25a1\u30b2\u30fc\u30e0\u306b\u3064\u3044\u3066\n\nESCAPE SIGHT\uff08\u30a8\u30b9\u30b1\u30fc\u30d7\u30b5\u30a4\u30c8\uff09\u306f\u4e0d\u6c17\u5473\u306a\u9928\u304b\u3089\u8131\u51fa\u3059\u308bVR\u30db\u30e9\u30fc\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\u30a2\u30af\u30b7\u30e7\u30f3\u306e\u4ed6\u306b\u3001\u7c21\u5358\u306a\u8b0e\u89e3\u304d\u3082\u3042\u308a\u307e\u3059\u3002\n\u5c11\u306a\u3044\u64cd\u4f5c\u3067\u904a\u3076\u3053\u3068\u304c\u3067\u304d\u308b\u306e\u3067VR\u521d\u5fc3
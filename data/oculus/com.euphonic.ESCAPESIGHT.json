eG6qfY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgpRyKCtcFFcxW4GhNC77PVtDqRQ3gAKVqjvsRj8_i2A&oe=6B05AF9B"}, {"file_name": "5.png", "id": "713609556367670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974844_713609559701003_1039717971429585349_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-_E4PYwYukQ7kNvwGY2yX3&_nc_oc=AdrcFWdbl8Zs7Rk4H3T7f3v11SunbmGZO8LArgpZM38IHeYH2Li6EtvjyjzmEFk4iY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6R2WNZMDsRWN2ZxoJvAet8i8FQlXNxDen-D0I2fBBvQ&oe=6B05A1C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560\u00d71440.png", "id": "596418372081994", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974924_596418375415327_6487005384461674980_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsqtqtooVB0Q7kNvwGKhEc9&_nc_oc=AdpVoQWOvETWL-lqHY9aPveALMW56mkPJNciR3U5geSWk1QSc0k-bGpy3BsWadAM_70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI9VDHBFXUjtbeMCWP6IszSHAmBGPRK-0zUpC5V2ikUw&oe=6B05D699"}, "display_name": "ESCAPE SIGHT", "keywords": [], "long_description": "You who have escaped the horrors, What awaits you outside... \n\n\u25a1About the game \n\nESCAPE SIGHT is a VR horror game in which you escape from a eerie mansion. In addition to the action, there are simple riddles to solve. It is easy to play. The controls are easy to operate even for VR beginners. \n\n\u25a1Story \n\nWhen you wake up, you find yourself in an unfamiliar cold bathroom. Escape from the dangerous house by evading the attacking inhabitants. What is the scene that spread into the outside world when you succeed? If you make eye contact, It's over. \n\nSee for yourself.\n", "short_description": "You who have escaped the horrors, What awaits you outside... \n\n\u25a1About the game \n\nESCAPE SIGHT is a VR horror game in which you escape from a eerie mansion. The controls are easy to operate even for VR beginners. \n\n\u25a1Story \n\nWhen you wake up, you find yourself in an unfamiliar cold bathroom. Escape from the dangerous house by evading the attacking inhabitants. What is the scene that spread into the outside world when you succeed? If you make eye contact, It's over. \n\nSee for yourself.\n"}, {"images": {"nodes": []}, "id": "685225526141812", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ESCAPE SIGHT", "keywords": [], "long_description": "\u5916\u306b\u51fa\u305f\u3042\u306a\u305f\u3092\u5f85\u3061\u53d7\u3051\u308b\u3082\u306e\u306f\u30fb\u30fb\u30fb\n\n\u25a1\u30b2\u30fc\u30e0\u306b\u3064\u3044\u3066\n\nESCAPE SIGHT\uff08\u30a8\u30b9\u30b1\u30fc\u30d7\u30b5\u30a4\u30c8\uff09\u306f\u4e0d\u6c17\u5473\u306a\u9928\u304b\u3089\u8131\u51fa\u3059\u308bVR\u30db\u30e9\u30fc\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\u30a2\u30af\u30b7\u30e7\u30f3\u306e\u4ed6\u306b\u3001\u7c21\u5358\u306a\u8b0e\u89e3\u304d\u3082\u3042\u308a\u307e\u3059\u3002\n\u5c11\u306a\u3044\u64cd\u4f5c\u3067\u904a\u3076\u3053\u3068\u304c\u3067\u304d\u308b\u306e\u3067VR\u521d\u5fc3\u8005\u306e\u65b9\u3067\u3082\u30d7\u30ec\u30a4\u3057\u3084\u3059\u3044\u3067\u3059\u3002\n\n\u25a1\u30b9\u30c8\u30fc\u30ea\u30fc\n\n\u76ee\u304c\u899a\u3081\u308b\u3068\u305d\u3053\u306f\u898b\u899a\u3048\u306e\u306a\u3044\u51b7\u305f\u3044\u6d74\u5ba4\u3002\n\u8972\u3044\u304b\u304b\u308b\u4f4f\u4eba\u304b\u3089\u9003\u308c\u3001\u5371\u967a\u306a\u9928\u304b\u3089\u306e\u8131\u51fa\u3092\u8a66\u307f\u308b\u3002\n\u8fbf\u308a\u7740\u3044\u305f\u5916\u306e\u4e16\u754c\u306b\u5e83\u304c\u308b\u5149\u666f\u3068\u306f\u30fc\u30fc\u3002\n\u76ee\u3092\u5408\u308f\u305b\u305f\u3089\u6700\u5f8c\u3002\n\n\u3042\u306a\u305f\u306e\u76ee\u3067\u78ba\u304b\u3081\u3066\u304f\u3060\u3055\u3044\u3002", "short_description": "\u5916\u306b\u51fa\u305f\u3042\u306a\u305f\u3092\u5f85\u3061\u53d7\u3051\u308b\u3082\u306e\u306f\u30fb\u30fb\u30fb\n\n\u25a1\u30b2\u30fc\u30e0\u306b\u3
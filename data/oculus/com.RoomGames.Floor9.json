6482453", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828038_29498732683149118_7689361280561510667_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9asPZOr0GIQ7kNvwF442-H&_nc_oc=AdpnEsVZjKzIAO5zJn86jTJCIU6aj-WgVcQGkWIV6uzTblwGcmbH-GUY2fOs5WWJojA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRLiDVFGTFsiLLo-1VGhrp1AXBYJLKtcCnODh7ZtLoAAw&oe=6B0DAA2C"}, {"file_name": "Logo.png", "id": "4144941825635971", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_4144941828969304_7718832871686278916_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTT9875T1w4Q7kNvwHoqTCh&_nc_oc=AdpbO71icWuZS4E20tU29HwiY7UfrNHwa3bmc3JgrtbSnSGOWwskQFekfRsQoxBQmf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQs0_2NR_H1ieP_Vrv_SLXDluGNVENIHbeRzfU6c1gO7g&oe=6B0DC1D8"}, {"file_name": "Uzamsal kutucuk 180 - Arka plan.png", "id": "2611660462641278", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_2611660465974611_3828414714839958255_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzQzyyCkrksQ7kNvwEr-qvh&_nc_oc=AdqfVhVcmaa04kUkhTxQlgg9szL4vpxUZralF_SEZJslrJQkD5L3-AHYRV5AzmSYRYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQGOgfrFfKqSoxdyTupM__9MRgoPTzaBVXzGhTIF8DBdg&oe=6B0D9A0B"}, {"file_name": "Hero cover.png", "id": "1884009932760696", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823296_1884009936094029_2179702427912026061_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agCCkq1n23UQ7kNvwG0RFLL&_nc_oc=AdquBpWHHAfukz0Tgc42DgV4rscKmvciLeWElunmSt1-zHeMHJFRDL2LxdXB-gjuWHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQS32c2L1VCLCvIvI1X0oPxdeaNI1WD6dPeUQ_fa1xs7g&oe=6B0D9E7B"}, {"file_name":
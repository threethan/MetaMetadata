UMkVTz1ZPhqkZLa2Zn8EbzlQYDR0b9C8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gg01kxl3x7fumAwlsXG1knC6hjhVvfVSDej2xZNnisw&oe=6A01E0CF"}, {"file_name": "Screenshot03.png", "id": "814211018437054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313074_814211021770387_1322738847798077705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHcsfVzdLWgQ7kNvwFDxrGG&_nc_oc=AdrGhsa_eC0dkVcuKxEMAVAH6umUT4InFUAYuLhGUQRqrFeFKY2Qeg60gsRhyseNJcA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4X7x5plXlpIpSK8qQ3bVCZXY71qeeE7qwNakY1QFh8UQ&oe=6A01C335"}, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uYqdynSyTVQQ7kNvwEsRDm9&_nc_oc=Ado_cE1F6uXtAt_WGwyb2t8TI890oOkFnPHHmNg_yGDpf4o3w4YRfK6RQYuxueCxlU0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hJLYpr5YnB0xBcocWW9dfUJ_xxNye7oS1CwMZBNRvcA&oe=6A01C7DD"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4gGadKkAILcQ7kNvwEyiy4K&_nc_oc=AdofYVWbEU_TVnhIwubIlNL4h5hB6MUvFgliAQ-xiRXbRRUlU_-mLUnJRahrhaYzDVQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qiG0ryVptPXdXRVVjSqpXISp6HYV6Q4OmnpLO8ikiqQ&oe=6A01CFE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj2MBD2p-aQQ7kNvwG5kpaA&_nc_oc=AdrxblOxXft-hLhuQyMNeaIf7WABrbpohQJvPQFeKOQnBCZwgVIlDqHTMNYWlYUiZzc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58Pg2zSOpoUJEDEHgxTx6sw8AH9g85qnZpGNC4Fre39Q&oe=6A01DEE5"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
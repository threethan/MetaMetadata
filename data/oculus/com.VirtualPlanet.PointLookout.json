t-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVjWiZOWg60liTFmb6iNPbXAw4IFRdo4AnpruuV4m-lw&oe=6AFB2B9D"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piKzwtsX4noQ7kNvwGmBn22&_nc_oc=AdrTZR3pT4sk0GmgILlyXuW_FvAaVkSYaxc64kik0EaZydpcXmCrYl5TeNmB54bqpuw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFOmYu7ju573E7zkPPKpodKhRGkZZ2TLx5EplO2OnFCw&oe=6AFB33A1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSHZtKfR8QAQ7kNvwF7Iv6t&_nc_oc=AdrbhcyQ_qtK8PYSnRMeaDv_Fa7alE2GXaIJ6rBlawGZYz53X7-0a6vBqcNZeJx-5O4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8XuXaxN-ItpOxGj7B1FF2vt6lgWo9N5-AehBmieF1Zw&oe=6AFB42A5"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25670773419282685"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "974601768525216"}, {"status": "PUBLISHED", "id": "1447012926812127"}]}, "baseline_offer": {"id": "974601768525216"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780061520, "status": "PUBLISHED", "id": "974601768525216"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25782161491477210", "version": "0.4.0"}, "id": "1988100525420194", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Andr
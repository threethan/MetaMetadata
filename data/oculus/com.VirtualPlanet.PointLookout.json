XD1MvjQzMHsEC3tODrk7kNCYGwXZDps4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MtrXCeA-RQRhokLINn1GivPHXrCPRpJM3xiSmU4NbxA&oe=69DA53CF"}, {"file_name": "Screenshot03.png", "id": "814211018437054", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499313074_814211021770387_1322738847798077705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxA3PCuE6vYQ7kNvwGwEDn3&_nc_oc=AdqCFSCwY66HfdAuknmqr-Fo89C4Fa1cEVnppPkgh_Zv3xMhbDt0R4QYWFBqnL8lU-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1S8YqNHcw6LNY3oq3t06r_4DB60ZSwO5v3Z6vkh9JkJA&oe=69DA3635"}, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJILBpGrjYAQ7kNvwESjI38&_nc_oc=Adr9PjRXcd09J7TqzRkxLAA3BYkpU1vHveFq8esZLqttpS3DRHdFyOlPSiWdpcWcY4Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sK_tNjYnn85ZvNcd63L9lKAZ9CdQRP2lrPZnOioCfOQ&oe=69DA3ADD"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ4jnk79984Q7kNvwFwYZb6&_nc_oc=Adqe1FTv4gLdFxSXFLMQ_j-bcBfcbYflKRrccy2nq6FRHPc3YGNYmlDgLAJfH28MrRA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3clILT0F2fBdHhZCIkPx_0YLZ-dPwbCyqTTwlXGId9xw&oe=69DA42E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1u3a6Pn_VJgQ7kNvwF6tqn5&_nc_oc=Adryv1Wj_lX36RGJXX3tv5D2lshR1mSZAtfcWTALBLs3ZixjoAKx2rus47oPDUbmIZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vlBLXT7saxhz0O68KZ2oUU0_8x5kquAo1a_PTIk-sOg&oe=69DA51E5"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
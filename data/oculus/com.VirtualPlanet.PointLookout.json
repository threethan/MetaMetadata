GAm7HvEl8YT9l5cRAWOaKt-KBryzoRUg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62q_naCeOoti2AVPzeTeexh8joYncBiyVD5xD--3LBig&oe=6A199BCF"}, {"file_name": "Screenshot03.png", "id": "814211018437054", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313074_814211021770387_1322738847798077705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipzuukFrUTIQ7kNvwFepmQS&_nc_oc=Adpii-xm0qUHgR0DVGjobT2RwBRWMtLDyYPG9xNITfR88UvQD-ly9FdPOK61nfgOIm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PgFY7qU-D7O7oZ4zj3aPPWgy0mv8xJo_KXBA2aKc_qg&oe=6A19B675"}, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3cb75iZD6oQ7kNvwEsAXBF&_nc_oc=AdrMaiqIP97h2tar5j78J-H72RfhApv2ruxQzd2SyFJ9j1XQI22RQQ9fzixgsXMryeY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AuYAVb41hSpTjsqOtVjVdK-xf27Wv5n7t-oZfEODUCg&oe=6A19BB1D"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07SLkN2gtBMQ7kNvwGR14zy&_nc_oc=Adr7tfzqtcxK6nSEq_6wWSBJmKsI8GBkPvsjbyeRXTnNIRWIgZzj1fawazgtl0eDz3s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af405_mN2cnS9IqTrNKWFtZ6kX-dOEolTJV77FypvFE0-g&oe=6A198AE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpjmZusNnxQQ7kNvwGh85mt&_nc_oc=AdqimXDyngrkkVWodDK5a9R2sQFiE0ypACdrMEnOpR8FhWQ8U9w9XAWwYNeJ_4LiVpA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5d923MOAlMaerUPJOfGlXvU0RujFHxDEOly6Wclon6xw&oe=6A1999E5"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
kTsi3nlQqpm90V6EPJG9VPzXK_wNCYkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2va1t0zc3_Lr1H8YN3tpGNpsVxpJKXoFvd8MmKT3KAJw&oe=69EB774F"}, {"file_name": "Screenshot03.png", "id": "814211018437054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313074_814211021770387_1322738847798077705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNFPUXBHk6kQ7kNvwEcSOL-&_nc_oc=AdpD0aseLN0gQr7XjwawK0-08dDGrdgv4CnpySAMNOc_BCFaYPl9j7t606p8pTouvK0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0f-hfqTmlIYfwFEIisfexeuRzpkN5RLjAJILa0bmnfhQ&oe=69EB59B5"}, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edzP_epU8MEQ7kNvwGdxUsZ&_nc_oc=AdoL3Grd-UX2kG4VRWAjmOP2pbcnfkw-h5r_vW5wqS71mG3n-UP2WF2YTOh3J0YSoQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1AjGNH6Y71fCR_QLD1P_F5Pan_Li8QMDRG5ll5PGybDQ&oe=69EB5E5D"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_8A4_IhXV8Q7kNvwGafI_G&_nc_oc=AdquQ52BYQfUnl53kh7kjgqU5uLk-LgrUH2R1f4C5qAwuEuC-sc6YaSSJBIrFB4aKd8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eyITiYJiuv2WjEjorO2ALaTKMZyI7Ei03vJC2EMPLcw&oe=69EB6661"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQmlpO_d7FoQ7kNvwHo6T9g&_nc_oc=Adp1lhGSy8NVWAI22T6r6S2W3TXE2c_BmGHPBEkAtNihcf56ddYmskTRKY22cfAy-1g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RcERGYyZnPKVe8H2W2LI5GGz_ZBdWrw7hF8uAsdGUiw&oe=69EB7565"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
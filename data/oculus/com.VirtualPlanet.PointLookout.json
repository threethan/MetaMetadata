Z6jWDDPXOyv64UTwMGH6E9HJbq6xGlVg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BuBfMIPti9d97BoJFqHpEh6qbIJUPa2U8NwP2g7ABqg&oe=69D50DCF"}, {"file_name": "Screenshot03.png", "id": "814211018437054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313074_814211021770387_1322738847798077705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlEW4zPMnTYQ7kNvwGf3nFK&_nc_oc=AdoaMwSTxyfqipHjojY2zOY_Y3Q3o59avhJipmPATvXT3Lg3gqpNZewgX4v9tZXq-JU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01gBd1ApRAhomM8NcCod_BngSZQkohSVhgEOwwG_n3jQ&oe=69D4F035"}, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mG4RwK1EsM4Q7kNvwGzmYGq&_nc_oc=AdqElIcbL57xED9PRF4YAsYGDRAUiKpsQm8TYiUeKOHX6USHxNJOBMdPVOIPsJUJ0is&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01WNbTXUhpr0wNTmiRdKXETbcLWZeBf8AcmYPQFE9rjA&oe=69D4F4DD"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsIYz31UiB0Q7kNvwGbeztf&_nc_oc=AdpAXsBjuy-Pg7_T5dcl3QWIfuspJWbVxr5uLWqd_p7im1l5F6W2u4TRx_kANPHfo20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3J2pm-pDiapz_mmKZmf92kIH1-3s-opR7hQi02jMv67g&oe=69D4FCE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKFI246R0xMQ7kNvwHtmSH8&_nc_oc=AdpwiFYpjz27zxlPWuT72xcyngittMyW76uqLObwJLkoUcLyK-3B45yXSOPPH_C9XJ4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZLjAqSgugKhzSmJTwrOiOBRwnxjw0p_F4LkI_dEnMRA&oe=69D50BE5"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
ENP2UgsspB6beb9acbd_OlY4cAjU2ElE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx5loNQYitIPnIWpmeM81zksleZrHOvGIvapE-CSmXV6Q&oe=69CD24CF"}, {"file_name": "Screenshot03.png", "id": "814211018437054", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_814211021770387_1322738847798077705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFpi7WH4mmUQ7kNvwGIN484&_nc_oc=AdrZoS2rCl7M1ZeeLY9O4XOgBbI6BW6ZGfrD3nw85_Lph41sQOeFh-51jMIXrSheJpM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyqsd2VVvnRRoLF8FY1vREFpZxxcxjBOo314EsRimqPvg&oe=69CD0735"}, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Efl3ArpDqBAQ7kNvwFfuU3W&_nc_oc=AdrMurXTcSfMe6tlk8bd3cpWAvWdoVnmL_XVloscmmaOKLnGP2BFntujAdD35_LZLzI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMv0lO1Xnhn4N-0RxnWfsiVC10PvUWkJ_kT8-OawyyuA&oe=69CD0BDD"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBseQro75SMQ7kNvwGDBzKd&_nc_oc=AdoemkRvfqtNnEUDCPJyOSeh-InJjxwtPSwWFJskg0pTjvdjw4C8a6S7P4V5etT9z0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwztCtBrdbR8StQPKoeaHhA3KL_qpgxFZG6fkJjbl_DLw&oe=69CD13E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-RHtNHWNsoQ7kNvwGmBCeN&_nc_oc=AdpVlKff8wk8Acx-6zCHau1GN6O3LqiKMEdqMqeQaRcV5TgKIg7jNJ2LI47-Zo6tROQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz252XylC64Un46TBPUDN-1g9zLoPuUSSZesbysJeZTQw&oe=69CD22E5"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRE90nqWwVYQ7kNvwGTQx2K&_nc_oc=AdpW0yKsNqYMZCHlqGNz523WWY0wjncB8bm0NLzVo5J7e3K2P5oQZh-smHOnxPz0LmA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0isB5AfGLsHge2ujzcc7caTzAxmmp6aWK6svOE1bhFOg&oe=69F498DD"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lipEbb-8ssMQ7kNvwHcKX3x&_nc_oc=Ado6J8fzxcXA8YUGz4FahPYEux5CVw65cdL9TKPjkDjE7nWicgAOfG9LVR3OoyPgekA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2How-c_yl9LVGX4ZWm0c6FjfCQuWWdFlZElSR8x3Fwmw&oe=69F4A0E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mjy0L_J579sQ7kNvwFKZy1b&_nc_oc=AdplVThgYSmWuTKbTqwDH6VFU7U_JPUBu6kkGJ7mF07fk4ETco6RwZLSpvz0lv3MexI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3vo9ftEzJp263mEn50eiyXbrRL7VrS42LpTvGNLTPlkw&oe=69F4AFE5"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25670773419282685"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1447012926812127"}]}, "baseline_offer": {"id": "1447012926812127"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771953240, "status": "PUBLISHED", "id": "1447012926812127"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "And
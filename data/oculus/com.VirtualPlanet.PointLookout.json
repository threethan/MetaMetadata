URKsISQx4_4NEXng_psdrLeXFU0bgwYI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ioh86Fak4oe5J8lOqxwKz1ZDgOhdjzIK9WceI71PZNQ&oe=69E782CF"}, {"file_name": "Screenshot03.png", "id": "814211018437054", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499313074_814211021770387_1322738847798077705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRmiaY14E1YQ7kNvwFZfsZm&_nc_oc=Adp3wq4rY3UijhKsVJqtc3M6bh3SFRhfs6GOXPkpdEPgjML-5cXCqW6bRllUEATgdU0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FySKnSwXcbRJxEocfABwkxI82WONi_6uQJ_YmUn-CxA&oe=69E76535"}, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AHOFdQ6-YKkQ7kNvwExwN3z&_nc_oc=AdrnE2CEhGVpRo_pd7UC39UyYVa0-Wl_K548a2GvsYbkoyJCo9yv2u3dY0RUOXz6SdY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PhOqa25NEC95trTMu4CvUNjYYADDKlqTpkbf6FiIIqA&oe=69E769DD"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYIHvUm7WycQ7kNvwEL---L&_nc_oc=Ado3W3PLLE_IIvxIDgiXHP6rme9BFnWBG0PnHdXTGf-pdsXSZiC-fkMmahIJnA4rV18&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hef-Q9a2_uPGM9e_oEZWRSFUAkYYYB2bKQc-GDj7bBQ&oe=69E771E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1fkCgza3Xc8Q7kNvwHw-DYJ&_nc_oc=Adqsm7pDKojomayClRfGyjUudogUznjUGQ3MoBBj7DX0X0i6lum8dQQ8PAvorqZWYbo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zG6LosEDe9XXLmN9fyEFS9ZR4nJba5o1WfmJHp6K_nw&oe=69E780E5"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
K1HGkcPsPd7XAMkhaGmeDF6-GqDOJRUg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75ZcUyMXsW_8e5B0MtAKNajygyAGACsEjBJSL6R0SbLg&oe=6A1C3ECF"}, {"file_name": "Screenshot03.png", "id": "814211018437054", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499313074_814211021770387_1322738847798077705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipzuukFrUTIQ7kNvwFpLXc-&_nc_oc=Adoaj42sDL-51EN2tWt9jU0Nj62bqtYMtKaDX4L2dd1zfQ3pvv7QO7pN7XsBEWNpAUo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z2TYOr97VcCKLWFkO7S2WiyO46HQDQfAnwtES3QLWgA&oe=6A1C5975"}, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXZ9zR-eHIcQ7kNvwE4LVWU&_nc_oc=AdqHP87EXkfEMHsUEIvLlY9RdiD_wR7hOSSD6ESyJ75DwyjvwDSsXY4hDExYjGJAme8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iecdcAdvvUTbfeOioPTnxadxZvyPSVRWKLWc2_6BRpQ&oe=6A1C5E1D"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rOmmA5N2JJwQ7kNvwHk2P2Z&_nc_oc=AdqxZhvzuPPut4qxFU_F7SM-zLG_758h9zNJ8Kdq1CEj7mLRGtcUH14mOk5wG4uFQYk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yXO2ILJtHabVS7O0fPB3frTxq6YuHK7ViDcYrUR__Gw&oe=6A1C2DE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpjmZusNnxQQ7kNvwGizZvL&_nc_oc=AdpZ7bpVeHWCdZNkvfWolaSY27vSYr05jCytdBh2XwwHW_faU7IFNukqSQ19JXoOGB4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66Z_S5o-Rk4s8XA6mwJo9A1IZGny3Q74R3pPB26y5EDg&oe=6A1C3CE5"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
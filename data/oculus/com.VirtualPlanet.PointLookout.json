YhaNFWL7QUl1Ie9oiq1z91W7Y1R0d9iWrKNkYQqQ&oe=69A4464F"}, {"file_name": "Screenshot03.png", "id": "814211018437054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313074_814211021770387_1322738847798077705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBewp7WMekMQ7kNvwGNwewq&_nc_oc=AdmkY0pJr72mb-qiOLaHL-gsO7o2hWZIBR67BanLQQR8CzgqycQZGeUc-Ti-RpxDITg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvtLiIuHrgdyl_O2ntjMoyz5NbVn_Q4eUDgTOYM8akNKA&oe=69A428B5"}, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVWddIM548YQ7kNvwHZEljQ&_nc_oc=AdmkSZG3IrUWZiyEMbdI3FYtizGTFlkzo4oPWMAbMFLR-Okxne3b6n8_DSD8IDQPLP8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftqLFl7J2hDpuvSUGcxOTsWGa616Tv_5S6YpPehaXyaOg&oe=69A42D5D"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TXJhNYGsh7AQ7kNvwFp7urh&_nc_oc=AdmgQJOdwmkQGz0GTIQxhDTH4EKeIgotpKw34toJ825ftMsASo0By2sZF9p978B2TZk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv5XBI-Qa6r3cfdKVHGyysFURoeis9K2kuswcIzqKr8nQ&oe=69A43561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YY618R6ls3AQ7kNvwFf2HRc&_nc_oc=AdnBIYlB5QBazt0Na4dMiJmjzeeZD8RS3NKOQsMHBfnlECdfBhV_WxGI6cch8GdNdcg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvMfqyP8qaQxSxwYMaeXRxWTwhah8YKwbXA-UfueHW5Iw&oe=69A44465"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "sup
8sD3bQnkohPGNwQnkZQfwQLXXce4O3kk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPsvCk1TEukH9op5dhZl3ASOMZ-wDPG4hhC1kZKPHlnA&oe=69CE764F"}, {"file_name": "Screenshot03.png", "id": "814211018437054", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313074_814211021770387_1322738847798077705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OigfXRm7jwwQ7kNvwEOWEvx&_nc_oc=Adp3f6OeoZNF5Kn1AO8LaAsv9CToMiYxjQym7lyvgw_hvkxTl8YPKNDClplHgs1A3iA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8n4YCZIshZdQ8W00b_KKq1GIB8jOZ6RgwbdbTWqeatQ&oe=69CE58B5"}, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Efl3ArpDqBAQ7kNvwGYqxB_&_nc_oc=AdqvAtt1UNaf-79q4zqCSzxM1LhHob3Mw3_kzqBHwD88Q0xH6PYm-g-obMoMyVu5gWs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afws8kh7Mz5aSnC5nKVkE4iidIM3aFmXIprX1vfHq1b1vw&oe=69CE5D5D"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBseQro75SMQ7kNvwHxguag&_nc_oc=AdqPoR3r1Atq9BmjpVIynUAinSyqlsc3-BFSAgvzrN9pFI9bI9DPimUx2SXqMejOdK0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzS0FBs1jzyq1SNPv47B1NB5hjkD8pYENmY1Ux4DGknxg&oe=69CE6561"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR6fPybymLAQ7kNvwH156bl&_nc_oc=Adpe1Pvwr894yEeCNMPZOk2gPfkZXapT0__w-Oj89MCNbjAMRkinMsfRzfrwgjofXaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOlDzqqaYmSAEiMjZ3f8vliGafY_hQwswIHM4L2nnQ0A&oe=69CE7465"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
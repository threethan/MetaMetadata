72_RRaqZm-EtrS29C9dOBnJII1KcyNZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zyzI6dEOmMiNd9jYa-IOdz61ANBAQrxhP_AbWlnlEwA&oe=69DBA54F"}, {"file_name": "Screenshot03.png", "id": "814211018437054", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313074_814211021770387_1322738847798077705_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxA3PCuE6vYQ7kNvwGMjdqE&_nc_oc=AdqCtyExGyBbFFAhtOZ0u6sMDeBtSbtx4GDnovWSRporST9we95Lgti3LlSH7b8o5MQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xrkxzz4Je0YJzF1bR2H7sGQ_khNtAqx5voimGxu27wQ&oe=69DB87B5"}, {"file_name": "Screenshot04.png", "id": "891036110206465", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298930_891036113539798_566061206665205478_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yxINi6Wb2ecQ7kNvwGTlNLV&_nc_oc=AdoT2xriNm8zvM2fgdcdRkGl10VDGMFWpTSULrMnEOcYHeWgdUvm5eDpKs9T4Smle_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09sEu_YmfoikmuKQQmBG0IpdR1N-H80_pmGCD0i68VFg&oe=69DB8C5D"}, {"file_name": "Screenshot05.png", "id": "1950196305531868", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299891_1950196308865201_3979820298032774370_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZ4jnk79984Q7kNvwFnknRD&_nc_oc=AdowRX-N3feU1yGSwj5Umutj658q5hgDt1cKIBEMZfMt5RLOzn1sOX1GX55enq3o8Ew&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3U1-M6OFXKP_Z1aUrAsbDGvo4ufc3F5IFhllIU0hv1Fg&oe=69DB9461"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_PointLookout.png", "id": "884501107671984", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300738_884501111005317_4116624426097535501_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1u3a6Pn_VJgQ7kNvwET5W-3&_nc_oc=AdqOLonFrdjKwFYcE2LKhfdUOo8iKFhvhSkmNEYej7LGYuzjV5XtpAi4sLpZjriCun0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oWBQxoZwR6xa_t1Sv3tNMB2AK3uhc_X5ocifE4e6KrA&oe=69DBA365"}, "display_name": "Sea Level Rise Explorer: Point Lookout", "keywords": [], "long_description": "Sea Level Rise Explorer: Point Lookout brings you into Point Lookout State Park through an immersive VR experience built with 360-degree video, aerial drone footage, and interactive 3D models.\n\nFrom above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient planning.\n\nDesigned as both an educational tool and a platform for public engagement, the experience invites you to explore, interact, and better understand how today\u2019s choices can shape the future of coastal places.", "short_description": "Experience Point Lookout State Park through in immersive VR built with 360-degree video, aerial drone footage, and interactive 3D models. From above the tree line to ground-level views of campgrounds and shorelines, you can see how sea level rise is already transforming the park, and explore nature-based solutions such as marsh restoration, oyster reefs, and climate-resilient infrastructure planning."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.virtualplanet.tech/privacy-policy-app", "developer_terms_of_service_url": "https://www.virtualplanet.tech/eula", "publisher_name": "Virtual Planet Technologies", "support_website_url": null, "website_url": "https://virtualplanet.tech/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "726368587961803"}, {"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
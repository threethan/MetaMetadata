_nc_oc=AdqnSI6azql2-TT0Up5hH_rx419r5c1Clj0hsqtFKc3bCaJiH65w6jQ6eTaEKuroPUU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEAcT3MMOqZG09xqMOuTUwg-q2056KsNrVgxRnprxZJA&oe=6ACFA7FD"}, {"file_name": "Augmented Exposure Vertical 1008x1440.png", "id": "1330705625836860", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1330705629170193_4911776923941575076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q50SpyMkcj8Q7kNvwFhhwQb&_nc_oc=Adq2HLCJmdywEYN3Vdgn6j8dxrZsDuOUhxDKBgAv7QMkl2uPzdCgJMN866uPWqyjACo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgg87U2xrUWmAkSKaa21vsP9Ljz-HH02wEpDmXMu_UWg&oe=6ACF84A8"}, {"file_name": "Augmented Exposure Logo Horizontal 3000x900.png", "id": "829189503364976", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823812_829189510031642_2062351260531429347_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krwY09GtlsQQ7kNvwFwFWWH&_nc_oc=Adr8hqZ4UhkyDXsj74z0I-81aQsy2sP2y_VMUhAq_MqawbOuxSeHLqkPMlrl4txk1Og&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm9SvyzVzFY9aOqWPozDGJKLTFZ8jLbPnCY88yGjY_xw&oe=6ACFB1B6"}]}, "id": "986779797279824", "locale": "en_US", "screenshots": [{"file_name": "AE - Screen1.png", "id": "1663194584725777", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1663194588059110_7992086915542030885_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfNUWL1FGbIQ7kNvwF8ZWEj&_nc_oc=Ado9_XS8FbKXYJOfbNX8FG-qFcOYwEI5ot8dC6X0u-zbsmRVYdHUoSoMx4JJDo2wSLI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6bPMF1vXHZmhrFbKZtgxDybjnxw5BYU7EE1aVJX7Grw&oe=6ACFACE4"}, {"file_name": "AE - Screen4.png", "id": "4958064591086782", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823949_4958064597753448_3290245114242405275_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvwNDJ0xHisQ7kNvwHwrtHA&_nc_oc=AdqvllQLnLKC5y3ThTY5K0GFTV0to_i40KwO-6KjB7-kvyMsF6TpcRpeT4F_FNpyNqU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMtBgiWKupxfB86nY0oHmbQeOAADu5KbzCfvR8S0i5Qw&oe=6ACF982D"}, {"file_name": "AE - Screen3.png", "id": "1888892938450425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823341_1888892941783758_7068082051355384596_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNFdbG3M0oEQ7kNvwFgY0l4&_nc_oc=Adp9YZ3-tyXGu1Qw3SwF3FBRronHK6q_BfqFV7IXwdH3muYbCx-mTfjGPPpQrbUvjXs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmdui2XdMCQFKKr9mDBLUQyBhffPivm8quH_Hiv7w5mA&oe=6ACF962B"}, {"file_name": "AE - Screen2.png", "id": "27101805872808496", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491828028_27101805886141828_3378958454428197628_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRBtWd_G2JQQ7kNvwHXUAA8&_nc_oc=Adr0WqvrNPLS6YJvnjDiIqOAGqi0slsyyUt6fozIyhXESJBT5uNhxL74G8c8tyjPv80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2tBxT7eCBS7t4ZSLAGIrelwz8vHeFAi5VI58qkffe3w&oe=6ACFB4C3"}, {"file_name": "AE - Screen5.png", "id": "1990972148211572", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823901_1990972151544905_985980133833764872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bojvqy7gjXgQ7kNvwGJ4nMf&_nc_oc=Adq0UK5ijuP7vKKTHR35dxvxn5k8Iw4aorZj39bNQSXJc7O7XeJS69YOBDcQTNQWDW8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFB9kmiYnd_pvl5G2_cyMbJP3bWQHRPDmqv6mMrgRy7g&oe=6ACF8D56"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Augmented Exposure", "keywords": ["psychology", "psychotherapy", "eatingdisorders", "addictions", "bodyimage"], "long_description": "This app allows mental health professionals to measure negative emotional responses associated with emotional eating, body image disturbances and addiction-related cues. In eating disorders such as bulimia nervosa and binge eating disorder, emotional eating may contribute to binge episodes and loss of control. The application provides exposure to different virtual foods within two immersive environments, allowing patients to interact using hand tracking or controllers. Patients initially rate their craving and emotional activation in response to virtual foods, creating an individualized hierarchy in which the most activating stimuli are selected. Across different sessions, professionals progressively expose patients to these stimuli, from the least to the most activating, while monitoring emotional responses through a 5-point Likert scale. The app can also support interventions targeting body misperception through virtual body representations and may be used to assess craving and cue-reactivity in substance use disorders through controlled exposure to alcohol, tobacco and other substance-related stimuli.", "short_description": "This app is intended for mental health professionals working with eating disorders, body image disturbances and behavioral addictions. It enables patients to be exposed to food-related, body-related or addiction-related triggers within immersive virtual environments, interacting with them through hand tracking or controllers. The system supports the assessment of anxiety, craving, emotional eating, body misperception and loss-of-control responses using standardized self-report measures."}, {"images": {"nodes": [{"file_name": "Augmented Exposure Logo Horizontal 2560x1440.png", "id": "1955948475039628", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821796_1955948478372961_3344928454355478389_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1VRMqf5UvIQ7kNvwGy8mHW&_nc_oc=AdqiNZAWMbuw_-MiG8y6e7z3b_LeAq-2J8_ANt_t9tPEbXCL5V9XXTiS7_obfoxMQbg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAPgf-504-PkBguFn2wJwWQC44Kemo8AZ29b7zplTnjw&oe=6ACFB545"}, {"file_name": "Augmented Exposure Logo Horizontal 3000x900.png", "id": "1872863510049704", "image_type": "APP_IMG_HERO", "uri": "htt
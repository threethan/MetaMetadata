63871_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X__t3k2Q-3cQ7kNvwFlOo4n&_nc_oc=Adqw0SbQ4mShDPB_nfGRBd2LtYjm9nGiGWmdm-AOr5LKIEhSBWqadVzA4u1KKGVVdGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOuMsVZPwNzZbmTviA1VOSOnarVtmZ5W2UqXI5TpuAzw&oe=6ACFA16A"}, {"file_name": "AE - Screen4.png", "id": "2878156682526236", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825345_2878156685859569_2419249403599120731_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xrSXiDgvDFIQ7kNvwEoVZ_g&_nc_oc=Adp02sOw7t9FkJMWVMMyolYrCooslQa-z3JVyTGlaneFCVOZo_YXt22WPjfOjN9xdiM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqqU0VtSLgjgah0QzhlPsy1ioJ1AXnYemIElCmjCdtnA&oe=6ACF896F"}, {"file_name": "AE - Screen3.png", "id": "867643562504536", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823905_867643565837869_4334511095370440558_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NZe9toV53gQ7kNvwEF6fXz&_nc_oc=AdpmKFcPFue0wwfQBXWE6L4UCvJ6Y-R4axK4Fn22x2vGTcQ6TBJDCGbqbxQL4S5ng8w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_IKLbDnC-nf4wsiQzXhE9v8oZi8etqKjV1_7GRRa00g&oe=6ACFB3F0"}, {"file_name": "AE - Screen2.png", "id": "1019108027358100", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828038_1019108030691433_4408098326210901552_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jGAzKPfVN0Q7kNvwEm1Z0j&_nc_oc=AdqavDvzJtYtnp-QjEOnPTEfznKMv4RNkwGGS-yXmCWjQeGdMgBSjSG-eJTHdfERbRM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhGRD0TYFLHBnIdxUeArw0BjRrZWv8fj1ZRUheAfdpDQ&oe=6ACF873B"}, {"file_name": "AE - Screen5.png", "id": "1774968230538380", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823351_1774968233871713_3497468031684492828_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKd9ZjrT0jsQ7kNvwEKZLHv&_nc_oc=AdrMnltYw5UsPivpjSdgPvemyJwin2AeRmTM55B_d5zSrf9iJBZRfx_bgURzWvf3Yv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN12OYYEeeksFzGuG7hGloko4wYusi7BekACksrgyQlyg&oe=6ACF9A29"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Augmented Exposure", "keywords": ["psicologia", "psicoterapia", "disturbialimentari", "dipendenze", "immaginecorporea"], "long_description": "Questa app consente ai professionisti della salute mentale di valutare le risposte emotive negative associate all\u2019alimentazione emotiva, alle alterazioni dell\u2019immagine corporea e agli stimoli correlati alle dipendenze. Nei disturbi dell\u2019alimentazione e della nutrizione, come la bulimia nervosa e il disturbo da alimentazione incontrollata (Binge Eating Disorder), l\u2019alimentazione emotiva pu\u00f2 contribuire all\u2019insorgenza di episodi di abbuffata e alla perdita di controllo. L\u2019app offre l\u2019esposizione a differenti alimenti virtuali all\u2019interno di due ambienti immersivi, consentendo al paziente di interagire mediante le mani virtuali o il controller. In una fase iniziale, il paziente valuta il livello di craving e di attivazione emotiva associato agli alimenti virtuali, permettendo la costruzione di una gerarchia individualizzata degli stimoli maggiormente attivanti. Nel corso delle successive sessioni, il professionista procede con un\u2019esposizione graduale agli stimoli, dai meno ai pi\u00f9 attivanti, monitorando le risposte emotive attraverso una scala Likert a 5 punti. L\u2019applicazione pu\u00f2 inoltre supportare interventi rivolti alla dispercezione corporea mediante rappresentazioni virtuali del corpo e pu\u00f2 essere utilizzata per la valutazione del craving e della cue-reactivity nei disturbi da uso di sostanze attraverso l\u2019esposizione controllata a stimoli associati ad alcol, tabacco e altre sostanze psicoattive.", "short_description": "Questa app \u00e8 destinata ai professionisti della salute mentale che operano nell\u2019ambito dei disturbi dell\u2019alimentazione e della nutrizione, delle alterazioni dell\u2019immagine corporea e delle dipendenze da sostanze. Consente ai pazienti di essere esposti, all\u2019interno di ambienti virtuali immersivi, a stimoli associati al cibo, al corpo o a specifiche sostanze, interagendo tramite mani virtuali o controller. Il sistema supporta la valutazione di ansia soggettiva."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.discoverbecome.com/privacy-policy", "developer_terms_of_service_url": "https://www.discoverbecome.com/eula", "publisher_name": "Unreal", "support_website_url": "https://www.discoverbecome.com/contattaci", "website_url": "https://www.discoverbecome.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it", "fr", "es", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "GAMEPAD"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1696069788188055"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1916942982555647"}]}, "baseline_offer": {"id": "1916942982555647"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782753420, "status": "PUBLISHED", "id": "1916942982555647"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1789238352204531", "version": "3.5"}, "id": "1235003628597434", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1696069774854723", "i
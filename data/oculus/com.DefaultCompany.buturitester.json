2.oculuscdn.com/v/t64.5771-25/473391955_923924389759753_7281956737288893017_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lpBcQs8ZRUQQ7kNvwHKux7E&_nc_oc=Adk_XeJbKKcIxnVha5yw7pzdYA2h8V3JFvZJl07-UH_BA_KvWkzmGFNnvMyAz_JbBbs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afst6ogdemuA6hxyejYrbEeyvGgT7zXUN4V1n4WgbtJjLA&oe=699D8268"}, "display_name": "lingua\u00b3", "keywords": ["\u30d1\u30ba\u30eb", "\u8a00\u8a9e", "\u5b66\u7fd2", "\u52c9\u5f37"], "long_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe player enters the protagonist's head one week before the test and helps him study.\nGet an A or above in the final stage test to pass the test!\n\nThe protagonist will memorize words by connecting word blocks.\nGrab the word blocks that fall and connect them.\nConnecting more related word blocks will give you a higher score.\nAim for the highest score (S+, 500,000 points).", "short_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe goal of the game is to fill the blocks efficiently and get a high score.\nYou can naturally learn Japanese, English, and Chinese vocabulary while playing."}, {"images": {"nodes": [{"file_name": "yokonaga.png", "id": "2123805354790864", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393544_2123805358124197_8899666820814610576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GJCPzLxXHPcQ7kNvwFEBUAq&_nc_oc=AdlNjcqdYY4vWO9K33zvaenusUTLQqVuy81NqIBIIkrm1Ssi_KyPVhIcwaJ8S0GrpVk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv_s3C0undF7NY3jtA3gNFK9CXZjNqw8BpT-fLrxbUN1g&oe=699D9B69"}, {"file_name": "seihou.png", "id": "1788020891932915", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392060_1788020895266248_419517641821013333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rh311LVxhDgQ7kNvwH0htMB&_nc_oc=Adm8l1NhLjRSaNA8vJEo-BjhDiAoiV19kj2HY8_XkvFh8RQwXip3zjL1e7dyGAPrT
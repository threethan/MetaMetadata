2.oculuscdn.com/v/t64.5771-25/473391955_923924389759753_7281956737288893017_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u8sBn7aGrBIQ7kNvwG8G3qN&_nc_oc=AdmalEP9uS8PKvo1ULOL840JkiPsMlBP2QcwumD1NYQIWZQ4xiUa2YY1YJpTkazw5Qc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvRuvAZFfG3nbD4oA5H-tuZaWoF5p-u7acbdGLHUIeQxw&oe=69A56B68"}, "display_name": "lingua\u00b3", "keywords": ["\u30d1\u30ba\u30eb", "\u8a00\u8a9e", "\u5b66\u7fd2", "\u52c9\u5f37"], "long_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe player enters the protagonist's head one week before the test and helps him study.\nGet an A or above in the final stage test to pass the test!\n\nThe protagonist will memorize words by connecting word blocks.\nGrab the word blocks that fall and connect them.\nConnecting more related word blocks will give you a higher score.\nAim for the highest score (S+, 500,000 points).", "short_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe goal of the game is to fill the blocks efficiently and get a high score.\nYou can naturally learn Japanese, English, and Chinese vocabulary while playing."}, {"images": {"nodes": [{"file_name": "yokonaga.png", "id": "2123805354790864", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393544_2123805358124197_8899666820814610576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9OJeWZ9WzFgQ7kNvwFlK9dU&_nc_oc=AdmG4BE3AjIObNJUnqG3qMd1yMn0bWym-MxgP0qk3Qj7ehYB5r2Lvy7jGGFqgY-S5jM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afve5QyHj_ZfKrYjBSeXCLkbMmC99NEq6jBUXbxqDUHUFg&oe=69A58469"}, {"file_name": "seihou.png", "id": "1788020891932915", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392060_1788020895266248_419517641821013333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Kot8G0T0QEQ7kNvwG4w7Ob&_nc_oc=AdkhRIZfvgsj3Pg8SBlB5Fcc2m6rYBMBOfsUjutrz614q3I7ocQhhigGgrHnpBnd6
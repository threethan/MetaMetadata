bNz5bpmBTrQrcnqiA&oe=69C7BB03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "yokonaga.png", "id": "923924386426420", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/473391955_923924389759753_7281956737288893017_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W52rAw0_QNsQ7kNvwEhr_Xb&_nc_oc=AdoXYhPNsFvVLxRKp8mvqEM5CM8GViSdVu0bAyQukmK8M87kJxfFI2gQaS1AfFzYbeg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQGdZFOYhwIuSeKBGCHmT-EmM9bIh7CvcX2T4zonXXyg&oe=69C7B268"}, "display_name": "lingua\u00b3", "keywords": ["\u30d1\u30ba\u30eb", "\u8a00\u8a9e", "\u5b66\u7fd2", "\u52c9\u5f37"], "long_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe player enters the protagonist's head one week before the test and helps him study.\nGet an A or above in the final stage test to pass the test!\n\nThe protagonist will memorize words by connecting word blocks.\nGrab the word blocks that fall and connect them.\nConnecting more related word blocks will give you a higher score.\nAim for the highest score (S+, 500,000 points).", "short_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe goal of the game is to fill the blocks efficiently and get a high score.\nYou can naturally learn Japanese, English, and Chinese vocabulary while playing."}, {"images": {"nodes": [{"file_name": "yokonaga.png", "id": "2123805354790864", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473393544_2123805358124197_8899666820814610576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_RXL-7jd_sQ7kNvwFzEg4j&_nc_oc=Adq2AfS8koDChU-0rtZcWht93btyhPKrWe0fhCQAkLIaZvI0Ec_XCk4M6eYR8Q8NFac&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxh_jEvuQRRr__G6szr10Y2keIoCS-85BA43rXAz9yULw&oe=69C7CB69"}, {"file_name": "seihou.png", "id": "1788020891932915", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771
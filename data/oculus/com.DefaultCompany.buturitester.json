1.oculuscdn.com/v/t64.5771-25/473391955_923924389759753_7281956737288893017_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eVbsTlavz7kQ7kNvwEAMkLC&_nc_oc=Adn9pRoQrpr9zv7h9owuNmnQGk180Llzf4tL4gz--sHSHrDVf-yyd-cPzYjU0NFg9Y4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv35wamrlrjBWqTtwiLcpxv9s36fWM6ZtMRM9OB0GnKxA&oe=69983C68"}, "display_name": "lingua\u00b3", "keywords": ["\u30d1\u30ba\u30eb", "\u8a00\u8a9e", "\u5b66\u7fd2", "\u52c9\u5f37"], "long_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe player enters the protagonist's head one week before the test and helps him study.\nGet an A or above in the final stage test to pass the test!\n\nThe protagonist will memorize words by connecting word blocks.\nGrab the word blocks that fall and connect them.\nConnecting more related word blocks will give you a higher score.\nAim for the highest score (S+, 500,000 points).", "short_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe goal of the game is to fill the blocks efficiently and get a high score.\nYou can naturally learn Japanese, English, and Chinese vocabulary while playing."}, {"images": {"nodes": [{"file_name": "yokonaga.png", "id": "2123805354790864", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393544_2123805358124197_8899666820814610576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jR2hhBDGUuEQ7kNvwEKvOG9&_nc_oc=AdnYcUdtlGVWfmGyS_ju0QzE6NPGB1g8Mp-nFDnZNBqu_eWHCdGxSWTLS8KU8BFYjbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu-NJvdiBa__KeQsVnodJJ5qYnW_ezoHoiP8-ZTpYHffw&oe=69985569"}, {"file_name": "seihou.png", "id": "1788020891932915", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392060_1788020895266248_419517641821013333_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_nKXCK4b8jgQ7kNvwHpiDb1&_nc_oc=AdmIy-YZOvLp4KSfGJcy3Kt-TuLypDA1ar094zs4Q9Q2oJZQK653_eYfmemecvz7v
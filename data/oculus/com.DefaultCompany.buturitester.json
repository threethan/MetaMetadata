5RSrVO2umLN3VAsxQ&oe=6AC51343"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "yokonaga.png", "id": "923924386426420", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391955_923924389759753_7281956737288893017_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQn6oCUAkNsQ7kNvwGvJzSP&_nc_oc=AdpsS4ySfMhzgXpgJwUcbKX6aQEbf5H9Vvqz6kJ2AOVl1UWWrh8z4cR3Q8OU-DUxPeY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiPFcd5BKDE2go6qwym4BL74wLqFmbHURWWjDRIp_oXg&oe=6AC50AA8"}, "display_name": "lingua\u00b3", "keywords": ["\u30d1\u30ba\u30eb", "\u8a00\u8a9e", "\u5b66\u7fd2", "\u52c9\u5f37"], "long_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe player enters the protagonist's head one week before the test and helps him study.\nGet an A or above in the final stage test to pass the test!\n\nThe protagonist will memorize words by connecting word blocks.\nGrab the word blocks that fall and connect them.\nConnecting more related word blocks will give you a higher score.\nAim for the highest score (S+, 500,000 points).", "short_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe goal of the game is to fill the blocks efficiently and get a high score.\nYou can naturally learn Japanese, English, and Chinese vocabulary while playing."}, {"images": {"nodes": [{"file_name": "yokonaga.png", "id": "2123805354790864", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473393544_2123805358124197_8899666820814610576_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ST9B0dmFRc4Q7kNvwEyb7St&_nc_oc=AdrnoAgghpvTghbzHIbfURsRbsYP2We8la65pSfxGtPH4QR_rtb_LJLIAA0cvlUYyug&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmfb-oba_wtVPbBxIbFpnOncDKWLYSIAm0sDgVJw_-Cg&oe=6AC523A9"}, {"file_name": "seihou.png", "id": "1788020891932915", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771
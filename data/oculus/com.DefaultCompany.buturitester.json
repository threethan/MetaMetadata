scdn.com/v/t64.5771-25/473391961_1144771403449187_1589560097410510304_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMmxOSTTFDMQ7kNvwFFTFD8&_nc_oc=Adqs1JUiGGik5dNUqSdtfIaP33EqcOTwoxETPDOhb6bsFq6PAXIecLLbOjSRakfjYCA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCAzZ2v-UF1FN0JFdXSnGryCahOybR98jFALvD8SnEvg&oe=6B06FE43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "yokonaga.png", "id": "923924386426420", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391955_923924389759753_7281956737288893017_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JpTdbqnITHEQ7kNvwE5nE_E&_nc_oc=AdrBRPnt2Z77K-0WJrGHQw0aI7vaBj240qOA1n8RigLcu_sOVo6WzS-7_36My62wbwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQyNUxrEWxHAT7t-A6WA-OUxdk7qlG61Jh5H53Jx-2YA&oe=6B06F5A8"}, "display_name": "lingua\u00b3", "keywords": ["\u30d1\u30ba\u30eb", "\u8a00\u8a9e", "\u5b66\u7fd2", "\u52c9\u5f37"], "long_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe player enters the protagonist's head one week before the test and helps him study.\nGet an A or above in the final stage test to pass the test!\n\nThe protagonist will memorize words by connecting word blocks.\nGrab the word blocks that fall and connect them.\nConnecting more related word blocks will give you a higher score.\nAim for the highest score (S+, 500,000 points).", "short_description": "lingua\u00b3-lingua cube is a single-player block puzzle game.\nThe goal of the game is to fill the blocks efficiently and get a high score.\nYou can naturally learn Japanese, English, and Chinese vocabulary while playing."}, {"images": {"nodes": [{"file_name": "yokonaga.png", "id": "2123805354790864", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393544_2123805358124197_8899666820814610576_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid
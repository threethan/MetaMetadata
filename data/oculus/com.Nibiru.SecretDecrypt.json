85173910084517888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFWWxY_jzdEQ7kNvwFFQ-Si&_nc_oc=AdpzRMJPlx2GkckM9K2V9k4btdBQOHNmp1R9FLh-dJmQIRxd5xjKjpEOe8JBWQ9a-N4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_QxXOS7XmtcOJ5LauMZcJqJ5xRD_aO0mzJYTJOhNcwg&oe=6A43D7BA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wolf Chamber VR", "keywords": ["game", "VR", "wolf"], "long_description": "During the summer,Nanjun and his girlfriend went to the house in outskirts. Due to his physical discomfort, Nanjun slept early at the first night. When he woke up in the morning, Nanjun found that his girlfriend appeared andhis phone lostsignal. All he had were the message from his girlfriend seeking for help and the frightening wolf howl. Nanjun wanted to go out but found he got stuck in the chamber. Only through racing with the time, breaking down the challenge, could heunlock the magic organs and dig the mystery in the chamber.", "short_description": "This is a room escaping game, and players can click to move and pick up props, break the secret mechanismthrough various clues in order to escape the chamber in the shortest time."}]}, "developer_name": "Box VR", "developer_privacy_policy_url": "https://twitter.com/BoxVRGame", "developer_terms_of_service_url": "https://twitter.com/BoxVRGame", "publisher_name": "Box VR Studio", "support_website_url": null, "website_url": "https://twitter.com/BoxVRGame", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EXPLORATION", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [],
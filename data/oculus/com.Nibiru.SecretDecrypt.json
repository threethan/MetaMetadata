85173910084517888_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ErMKu3iwUQQ7kNvwGT1OZ6&_nc_oc=AdqiEJh9RR9oLRNSUAhW0LF6z1Gdd1_AXb1Kr9N37-fGV-F4d7TUiDwYUyJ1sZqAlcs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HT05L-bZESDu0PXsjP8zyvJ0R1_O2OnbNeeCqiMJ3LQ&oe=6A1AF93A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wolf Chamber VR", "keywords": ["game", "VR", "wolf"], "long_description": "During the summer,Nanjun and his girlfriend went to the house in outskirts. Due to his physical discomfort, Nanjun slept early at the first night. When he woke up in the morning, Nanjun found that his girlfriend appeared andhis phone lostsignal. All he had were the message from his girlfriend seeking for help and the frightening wolf howl. Nanjun wanted to go out but found he got stuck in the chamber. Only through racing with the time, breaking down the challenge, could heunlock the magic organs and dig the mystery in the chamber.", "short_description": "This is a room escaping game, and players can click to move and pick up props, break the secret mechanismthrough various clues in order to escape the chamber in the shortest time."}]}, "developer_name": "Box VR", "developer_privacy_policy_url": "https://twitter.com/BoxVRGame", "developer_terms_of_service_url": "https://twitter.com/BoxVRGame", "publisher_name": "Box VR Studio", "support_website_url": null, "website_url": "https://twitter.com/BoxVRGame", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EXPLORATION", "RACING", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [],
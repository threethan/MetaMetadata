irrel Monkeys", "keywords": [], "long_description": "Imagine a virtual reality game where you see absurdity and chaos from other people across the world, disguised as cute, silly, and sometimes horrifying legless squirrel monkeys.\n\nSay hello to Squirrel Monkeys!\n\nExplore this land with others as you flail and twist amongst the grass in a beautiful scene with quality of life features that immerse you in this beautifully chaotic world! Of course, take a break if it gets a little too immersive for you. You may get dizzy trying to push yourself along the ground...", "short_description": "Squirrel Monkeys is a game about, you guessed it, Squirrel Monkeys.\n\nTraverse your newfound grounds as a legless squirrel monkey in this massively-multiplayer-based game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lumicoremedia/squirrel-monkeys/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lumicore Media", "support_website_url": null, "website_url": "https://sites.google.com/view/lumicoremedia/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "176582198532211"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "220320347569732"}]}, "baseline_offer": {"id": "220320347569732"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1690904186, "status": "PUBLIS
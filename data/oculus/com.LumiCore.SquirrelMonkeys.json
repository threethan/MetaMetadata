 push yourself along the ground...", "short_description": "Squirrel Monkeys is a game about, you guessed it, Squirrel Monkeys.\n\nTraverse your newfound grounds as a legless squirrel monkey in this massively-multiplayer-based game."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lumicoremedia/squirrel-monkeys/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Lumicore Media", "support_website_url": null, "website_url": "https://sites.google.com/view/lumicoremedia/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "176582198532211"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982542_1687538198345328_4715579533037457269_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osOdVZEwas4Q7kNvwGnT8Lx&_nc_oc=AdlOz7aspQxCHpmmmX-Jk5fa1vuJqnby1nPOfSKMJ4FoN50Y4-mCOvgU5XuyCi_9aq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afut9lE9z1ru9kmyS8MwU6jfOVNLG88kLeD3jH-eyiJU0w&oe=69A6E2CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Squirrel Monkeys", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "269189016446046
dOVimIQVvgp10jHYgWp9LjS09c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUqbbT4diXBNqPz1_HKaPU1-LwM-8blZwbJu7tM6MT3Q&oe=6B05CBE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MIBMostWanted_TrailerCover.png", "id": "814717538147771", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818849_814717544814437_5585544745323779361_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpmE1fSQplIQ7kNvwE98GZ6&_nc_oc=Adq37PQm0kgG8ORD2PEOuQVHFra9zEmgg3PCcuLaL8cpHlmUq61z5kvDwvnfuPv_4Sw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN_LywRQkd5M0iChEOjpPYIOfjLYZr19EaQb7GnMM8Zg&oe=6B05BC63"}, "display_name": "MIB - Men in Black: Most Wanted", "keywords": ["MIB", "MenInBlack", "WillSmith", "Agents", "Aliens"], "long_description": "# New York, 1995.\n\nYou are Agent I of the Men In Black. A race of shapeshifting aliens has infiltrated every corner of the city, wiped your memory and made an attempt on your life.\n\nFrankly, it\u2019s embarrassing.\n\nPartnered with the enigmatic Agent L, you are charged with repelling this new threat while confronting the most dangerous aliens on the planet: MIB\u2019s Most Wanted.\n\n{1320416742693416}\n\n**ORIGINAL STORY**\n\nSet in the early 1990s, uncover a new chapter in the MIB universe with new characters and classic cameos.\n\n**HIDE IN PLAIN SIGHT**\n\nComplete your paranormal investigations under the public\u2019s nose. But keep your gadgets hidden.\n\n**STEALTH AND ACTION**\n\nBattle the Cylathian menace through streets, labs, skyscrapers and more using classic MIB weapons and gadgets built for VR.\n\n**SOLO AND CO OP PLAY**\n\nPlay through the story in single-player, or co-operate with another Agent in Invasion mode.\n\n{629215843514601}", "short_description": "You are Agent I of the Men In Black. A race of shapeshifting aliens has infiltrated every corner of the city, wiped your memory and made an attempt on your life.\n"}]}, "developer_na
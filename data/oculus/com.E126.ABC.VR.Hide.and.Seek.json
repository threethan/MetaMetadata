.\nDefeat as many moles as possible within the limited time while avoiding their interference and tricks.\nAlso, beware of the rabbits you thought were your allies, as they will deceive and hinder you. Achieve the highest score by avoiding interference and tricks.\n\nLastly, a piece of advice: sometimes, it's important to look back.", "short_description": "VR single-player-based whack-a-mole game"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.126e.co.kr/policy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "126 EAST", "support_website_url": null, "website_url": "https://www.126e.co.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8144859002279703"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031607_488578407272247_2885658708857789454_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fuw1aRtvWO8Q7kNvwG3DE2M&_nc_oc=Adk_bUtJM30H3eeKpcLfxuYQpboEOMkeDnOzhjQWLSlv37EbJFBE_h4Oan4cI8xJdHk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6b1Xmv_IDsE1Byp1rRFmYWs3tweflPBhwSP0V37-YuQ&oe=69BA905C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Hide and Seek", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035
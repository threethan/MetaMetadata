929.png", "id": "1670651491056972", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97hocbrYZ_EQ7kNvwEdReEs&_nc_oc=AdpvDuJ77GoOtaHwIdDr0Hfp36kJIGwRvxF8WWdT1m_4l2bfDVDCGRCMIG9z8oSlcrk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P4lnx_p4Z-23085_AtoBuMZYzWISyRw0OJZ5cm81FUQ&oe=6A09C4AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiZ035YYa_oQ7kNvwFTRhjI&_nc_oc=AdpaLpIjBLCCbGqo1ueWd4k3Z7Mv5EBaDdwjhDv41eeXCmm3AN49iXNJyE__GD1HIK4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af799rxPMlpFUrjdU4NffLn2zP6vnED73jhLHm-0gHg_rw&oe=6A09BC97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JM0yhlBjZwEQ7kNvwHmSNm0&_nc_oc=AdoEUTbBWobPnOA_0t2QF-l58qMH96pmFtWrA1XMHdUcYhSNj-uPukDSE0oboBJ93Y4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JohoWIn1cJ4UUOvKgXmXRvrDIApIIcdA9y8BUC1W_4A&oe=6A09CB13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teObGauVrSkQ7kNvwEs4-cP&_nc_oc=AdpJVYraX5cgSZBKJ62PJwIvKhHMFVe8vmVEiGRVSS8sG-4MIvq5QyTHhXV1jESDdzo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NVN81npsyRkrkZ0w8yE4oCQuJ7EH-xKiUNLPvB4IlVA&oe=6A09E070"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsaZ7InvSU4Q7kNvwGDYHr_&_nc_oc=AdplecGRdZz0lg7uwkku5cR-jQDGp9RoUTp-78xbzAb6eMQWZ3hk3cpiQz3L3mP2cdE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KgfvBJp9nZtrdLo
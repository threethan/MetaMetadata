.com&_nc_ss=7f20f&oh=00_Af_ER4T9HkU0gu3gKHJc2LZzMbM0fkDp26xq3giWVTJupA&oe=6A301B30"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Io0nj0xwIPkQ7kNvwEY6e5o&_nc_oc=AdqmCLyHDMKpSiAv4zoPVsgoSWHAkxtVGvLZAZaaPLU3jwdCyi-FPj3R3D8g6WYCmmQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iPyaEeA0kjEvJOgT-XTxfrzkLOqZG3xLCaSpyVrlmcA&oe=6A30002A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpvoybvui-wQ7kNvwFhzAWY&_nc_oc=AdpbdKQblkfLEM_NmoozI69_7-2_lFZVxfzQvM14SRKnGkvxppwNauKu2mC23uVRiU0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gBOP4dAgJO3n7uxxBl0UPP_K3Uoeh_yTObM6wFIZUgA&oe=6A2FF817"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwu0Zd_7pBoQ7kNvwGtPo4B&_nc_oc=AdqahcspRObMczmGBtUXJ3Nj9cd5GUJmxn3amM42JbSIaqPk0dcnCfsJMGxd0AA9dKU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cBEEP5yN2bcq13EG5EBx2c2SwmMZg3jkpe5aXviEC_g&oe=6A300693"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xX6ElS_xh0Q7kNvwEC_EF9&_nc_oc=Adqb2yDlxQ4aLl0McDxsZcQlMBDGA22PzK3QcJk52Lh0OBfUkKa5vvk4CbBcFE_AXjM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92USK6kP9qN-Gr4SFV0PzX8rCDNcroUwK5hGeJYYFahw&oe=6A301BF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JR_VKHW2gyQQ7kNvwGDBK_L&_nc_oc=Adqh2ttOUj8RfqSHoM821uQoM
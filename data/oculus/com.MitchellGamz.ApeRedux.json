929.png", "id": "1670651491056972", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVs15-23aGEQ7kNvwFWylhE&_nc_oc=AdooKq7MnO9OqvqP4AwjM2eMkdv6qgSHbqOPkJIcnzEyyNaCwosLpuRRH7OH2MxPU6I&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bpi15o5SLcL-r4GtLidESxSRNsnNoWldn2a5T09KHng&oe=69E237AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6GYBk0YpfYQ7kNvwF5Eij_&_nc_oc=Adqc7zVhEwD_3T_8PYtsLAZzdEleOGJa5NJ_g3b51zBLZ4XE7ikcW5bcF8mci4OViyA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0F35_LiFNyh3zmTuStTAqUPjTwEnenOYtYA4CuDoHF_g&oe=69E22F97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzjvXY2FPd8Q7kNvwFgQehD&_nc_oc=AdoUiOJAvEjvgV5NaeP3z7GSvGqvtUFOD1BAaoKJkwqMf2UQ9WMLdZnLkTXc0rO71SU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P3aFpHB4NKUAvJG0bJ1xgmJ3J6TuuYcsPNM09Bl01jA&oe=69E23E13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLpKnGOlYiAQ7kNvwEnH1Cj&_nc_oc=AdoWIHcLmJDSAy3kbWe-kkxDQRk2aIc8KR0i1CZb48YsnzS1Xj0ukBwtFpSj3Vqnc0o&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Q7rD1Iza3D9UtA8KDvH_tgQUfi4gu80kgxzwhCmsFng&oe=69E21B30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op0nkIYB8XEQ7kNvwGi31lm&_nc_oc=AdpzfD0a4MgOzyZp46gDm0wk_VoiL19sZnjto3IvXGEyNCGTDqElTTqlXfHEMCIyLgI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JTxuPDh6uNJOeJ2
vwGqg41n&_nc_oc=AdppUYmpCu1XyOXl5eEgStB_DiWGOiDZC4Z2STeyATvbFluLYpfKSpfQ2IArwGa4fp8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPV-N2ZxNfybMdxHjq5ccUcV_lA2tPU8dFZbQo3w9dQMQ&oe=6AD39530"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSQwgYv4KGgQ7kNvwEq1ShK&_nc_oc=AdpSfxcsjFo7L02flgCYAb0xEPnWOPcv0eqNgbD_7nKj_kJpOPUIggVNWq6cIjzwhEw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSaF8VkYRnpZ97tB9674mse3nEdjESAameWvcKn6aLhg&oe=6AD3B26A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BqELV9g_XE0Q7kNvwEj3VSF&_nc_oc=AdrEOGDuYY6f3Q7MzrQ70s1IHjSmD4ZLDYtCvozB0guEqRTrP4WetgJR8yEqJLZmw6s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIicVNywIANlmQyYzjsQNBLgpEn3FfdrjYoHL0bNMtow&oe=6AD3AA57"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fMndmQcRlTIQ7kNvwHBWBO-&_nc_oc=AdrMnZRyCeVMB_Jgcn6PSrblNeYJlN9AOs0MavD5ha75g1lq0mJ3o6lqXEJ4C0-nvgU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhn_hFO8Cy_pHakw4R3y7vdhQsNjlALhESzS-n8fBebw&oe=6AD3B8D3"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8i6dddhFqkQ7kNvwFBvIv8&_nc_oc=AdoAYZAe_v5Yth5pev3VrKjvjLrK-yyhCi_T2FuOdFfD2xwo-AAJxN8NnMGxEPjmuUo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdgog2geP5PjSn_k4I7Jh74YSQYdsujUeIqHd7PMN1ig&oe=6AD395F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
vwG9duB8&_nc_oc=Adqr-eNpj6aVVXFia4LzSAJDX1Qs3DeEjnQs160HsFqSLN70GHZN5eUePVTuhmn0o_M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXe0v4ltK_EzKjNB_LdJdXec0Evs__1qdzG821CLtLfw&oe=6AA570B0"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydCHWvWOxeUQ7kNvwGHbd5k&_nc_oc=AdoZcAJGMZOFC3RgKvfnkDVPi6urv3QmmsIp-2uCeVK_lqGS2gA0lYD3z4swUZu1lCQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxvG4ZLf5KIqOlBbbC2vJNNOKfDPdNWNqgH7KJN6duIA&oe=6AA555AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPxR8pTFdDYQ7kNvwEuL62g&_nc_oc=AdpfbJ45ZFFDMuw2Ny3czdH6yxPFq2hIPan_sEYiwcCCCcrYJ4nA7FPVf6PqX7qLtUk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZS05BzIdARVXWL-3DSPOmk21lNAtn5D-38X0MR_CDyA&oe=6AA54D97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNMieJ07og4Q7kNvwGT-R4p&_nc_oc=Adpue99O2RYy_Gfa1-umWGUBoL5WQdF8KfydrkqnKRneMTKGLOG8TjD9_J10MdgHuSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTx-DynZXqCTZiuq3d30XrMZHo42g5Mk5PBjIyN10Scg&oe=6AA55C13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJFvhPM0GY8Q7kNvwGqrBd7&_nc_oc=Adq-0Udw19A0bB9X5fCqMoOXiCfx9RnfFMnU_XV0ISx-ZbmCwAc1AQN6aD-HQNYXCSU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLda7jojLsR7OF1XXIl3-xFe7o5eZ47nZ7klQvUQa_BcQ&oe=6AA57170"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
3_1314353743715129_8004439157581483533_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eo33iyROCuIQ7kNvwFHJdUr&_nc_oc=AdksbS9EFGIdKtaE8iRO2uKqTVrVZ8_m-M6ahNta731QoLHaXTSXLiz9NhBtJXYu4bw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvQWmILbsKg1qs4sXSMBWTXB3em80tjA0pRhfQnc98YiA&oe=699D8554"}, {"file_name": "Screenshot 2025-10-08 004135.png", "id": "592059723919052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297447_592059727252385_205619874998128580_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsfH0Md-AywQ7kNvwHC0v1S&_nc_oc=AdlEBPWj_NBmL9JDeF02DNmrXdHgCtgoARQEQWoIQwa9fIQVNIBxtQuusbVVh1rhTYs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvBuBH7ZxgwC7zqVqr4uNoEXI8d0ZhDAnyOpGjnFzknjQ&oe=699DAEA9"}, {"file_name": "Screenshot 2025-10-08 003810.png", "id": "820136310495576", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299789_820136313828909_5017308108936956818_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-ppt6pLcSwQ7kNvwETU9g9&_nc_oc=Adn3wbHNZm-LvH-nM4XqBX5K2rBNPZn7u3x4vTTIAyDiWVN1a2Jg86ESxhc1HDV1oXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsIYQNa9cKFeaMuQEdQVAFQPK-8FAxbOZ3gjp6NeLpc0w&oe=699DB732"}, {"file_name": "Screenshot 2025-10-08 003900.png", "id": "789229133822793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297170_789229137156126_6641609663185335581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GcM7BKJV5d0Q7kNvwHB1BgS&_nc_oc=Admui13DdrmsjFY7aCyKZG5UouUEmrjkZWN8TcI_F8DVaAYNTz2YwJHGKT_IiCyvkZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afusbx-Zpu3SDcB5dsQDyPuA-M28MudfHGEgxVYhykFn6w&oe=699D96F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24909758682017984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sT6IPgTKCUQ7kNvwF6OZmN&_nc_oc=AdnnFwOvc0-eso3FoHjKalfWjhOMR7zuU2Kph1X6eydBVeH3LCALcqRLWEyNiunfbPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuk1G8PWk1RRIhItANARwg4Nmm_wzsGOaMQdofMXsvV6g&oe=699D88A1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ape Redux", "platform": "ANDROID_6DOF", "cont
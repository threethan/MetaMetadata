vwF4AhEM&_nc_oc=Adq4YJG4vMfrYhi5gugegLQGp03M7aPlUlqK7XNf4yyFu6W4Ve4g7l70VR4hVdZZvDY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxjy_cYNfT1U4rj7FQULMVjd70HQK4ZG5dmeT3z1FnpA&oe=6AA17C30"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6c2IqOI8RrYQ7kNvwFdze-e&_nc_oc=Adpz5iu24qwE46Tl9ZkdXEHiSsxuVwweQtStxgrDQgmWU-YIkAce5lR04Yhh4CYxPaA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZrwl9tO4f6srHospiDjjZfijYm921VkvC19kmC7tI0g&oe=6AA1612A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cfRy-Af2vjsQ7kNvwFDfvPO&_nc_oc=AdoCJejlONQB7mhy2ZfUFVxCprY0J0-ibnV6diQP4T2gDdqK_Zk3ksPqc4YsXvliQmk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzXUjaGPVkUlL5H2WZm-9HJLlY0fqGlqsPP1VZG1F6Qg&oe=6AA15917"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUT6C60HWWUQ7kNvwGXQycx&_nc_oc=AdrfJaGSZTHunwRcmeKnA2Gcvqy-cUTORA7518Nqnu72fxtDvgodyC2M5JTZr7_Ffh4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxZgmMQuPWdEi8qBa-6Ia9cksi5hnahEZ5HxdSe2yM7w&oe=6AA16793"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yNKxoTcgYQQ7kNvwFGXol4&_nc_oc=AdqICJ0Fec2f9rOsZdxGcRL98iOacziSvp-Ztg1x8C0iXTH6KXUGvzIZiTTTWXa3vC0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFGOjSZNpqQGEAVHwHaN6nUB7Zw_RX0myybnnf4Czc8g&oe=6AA17CF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
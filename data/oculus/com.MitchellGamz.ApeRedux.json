929.png", "id": "1670651491056972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSk_3ck3WI0Q7kNvwGhX_sa&_nc_oc=AdpVPz6RaV58cYolNc2WjVjrGw3Av24u5_mKo0BZGOa4ajpy2RxCx2IrQJjavrSk9Xs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31cB0BMBxRfZMYkl7y14srMpj1_p9JNL_qDYSR_WhpIQ&oe=69DE432A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8l16mdd83kEQ7kNvwGyicQw&_nc_oc=AdqKEoqtd-ZQ5ffnqO0vWaDxFyrtloXhGVgxvJOFz98QjN22AP8n_B3l9NbEXfemtCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EOUtfJhheb5-ybz6sYCcNk_K3gxIm2kYsL7hiJh7hag&oe=69DE3B17"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPGsz-mX76oQ7kNvwGuZdML&_nc_oc=Adqb0rLgiBIn2Upk5WdXlvUblNmgLLKW1YrNGXiv7olSRMezhboE1_cS-tInUw_N8Lw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1GbNC3Vc79WDCFSSmFYkjF3y9Pj3niObP9kRcKeo-GmQ&oe=69DE4993"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSOyn8qKAcoQ7kNvwG4qUU3&_nc_oc=AdokpvJhgk3xojznT76byreIyMaLioT-odCUWZYhIKymAOncd8KJKnEFh7UU6C-KFBU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3w7DllPgrHwZgzEGJyZh6Zs8U5NXuLuiWxC1t8q5qKng&oe=69DE26B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1imvGBsjrswQ7kNvwFqMpQc&_nc_oc=AdqZbHs2pt5ITv-CkW1-gsR6JIMWKJNy9IOyL2zPHoctw5BeD8EOZprNRn_yX1uEKCg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wYGTwxWWaqYVkrQ
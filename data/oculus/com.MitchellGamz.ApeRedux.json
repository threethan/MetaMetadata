.com&_nc_ss=7f20f&oh=00_Af8luqsGu9lo261PcwEZVqODVdpZcy4gqRtuS731i8K5OQ&oe=6A340FB0"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyNrZLEi8egQ7kNvwGe-A0g&_nc_oc=AdqxupdHtlF-VsPgGeKntD3Lyf34nJhiRitVO1qcVjw0Si9Wxrp-FpKHaZaVIKsH-PQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mxEj86OkIc82zdW0HQsqMX-YLe9ZsP6XvKwDFYgWgyg&oe=6A33F4AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAcp1E3GeaYQ7kNvwFaDsNn&_nc_oc=AdqCIie5M3kCwT3n_MtdT6e9eW6EX47RuqFo8GE4u1vgishhO-WdCXirq9bc3-lPkmo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sarxUXCd161hF-WHLhkFxVydV8g4e67G5wyIVafS8VA&oe=6A33EC97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8jyWUFQ3TQQ7kNvwEygVSJ&_nc_oc=Adpk4EUC_jcqhsKeh1Rco22CnouwXhqIsFOgp_7-ryLkjtfojsPpSFZZ9qiHYsC_IfE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lxtg2gCrFTBXQ1uvP2yI6URZ_dg0saXlntYhw8324Eg&oe=6A33FB13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1oEBwDCb_gQ7kNvwFDy3o3&_nc_oc=AdrHGgFcQehzFfF1x1hacj8AZTNi1Aq3yMmDp2Epn2_AL1wOXBqzmNXcn5DejBtmHp4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dmjB0zF_Y7TVHPeJ_fjpMzIfUj29ZvdIfecJnLlWFJQ&oe=6A341070"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AaCgB3G0UYQ7kNvwEAYd1R&_nc_oc=AdoI3Mj2g3oOm_g4zdhtJfPe5
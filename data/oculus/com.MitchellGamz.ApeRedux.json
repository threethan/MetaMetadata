56972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTx1lerZiiAQ7kNvwF3OF5R&_nc_oc=Adl29vPps1dZPnT-SUWTf1dBox7iZMlWPivfOUDlMweB3JGgmIPDGD4aUZ_ZuQiPV8Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMfNDb8fO-HTj8wFPedFxgIEnVWTk27_B3gYKDPCRtZA&oe=69B564AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68KDlYGEIBsQ7kNvwEUZugB&_nc_oc=AdkA5VDlmvdZVb8YOoE9fOoZ-wia3yy6i37gyNz4TL7RmpV6vaTZTOUBls7z8BOG4CE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8NCqOwIbA5HuhiYMBAftfYiQwW4TVC6aT8mxA56qzVg&oe=69B55C97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXwrNemsN-QQ7kNvwFB9mxv&_nc_oc=AdnHGCUbdRw4asfjcxJ3T-VZEv8KySIReAgU9aiGs3FN1bbsR-sJ0RI4_EJcUxKzYZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRR7VeRuO6X_2w_XNl26TLmjfKK7TkyWaWj0SXiHiBDQ&oe=69B56B13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tgmiZUEao4Q7kNvwHcEmdX&_nc_oc=AdkZ_-hGIgbruCDC7aRjk0q9Lnj6RnYbdD7jDB5VPM4-dFckbtR-yL0SOjTip2MRK_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwB37gTx1QNHVgJPiPAevNNJY8CiHj5yM8xUOCDVrTF3Q&oe=69B54830"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxtrF_bBYkIQ7kNvwGB3nHq&_nc_oc=AdmH7woFnObn43jCNF2ev1GXFCle-ZpDpmzjVZNPBByau4JR1-p6H7KBN56ntUXI2HA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzH9_lJJu2XP9Q7gMdADcNWR72lwV7YX5F28wUC9D6Oig&oe=69B543A1"}, "is_
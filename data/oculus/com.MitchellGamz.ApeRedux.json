vwF7FH_i&_nc_oc=Adp9qRrbEwuldAfRWCsU-B6RrpNHiQvpfvoTc6YIzF81-30kBz1KZ45vgipw2t97fdw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEGfnsy2vdPReb1no-i1zabChGsLTn3sYt8pHMV52fQA&oe=6AB14E30"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81wvgX4WsC8Q7kNvwHiymf5&_nc_oc=AdoI-9PANt0SCz3d3-T_xKpgDHPVURoUGdG_6ki_krLsPh5oUB2fNluzy6Q6SuMJ3MA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI_wELMklknG2MaQfH-MyzmGxEF_0tp1DYdE4JTLcZeQ&oe=6AB1332A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAYe5_QGhgoQ7kNvwHtHVOY&_nc_oc=AdoZ4DOWTiPelo8gNDzuwK-Id0LJINplAJK5wt7cq4inX3anpTYoQG1zbm3v514Vi5E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrXi3R1jJh61vt5_uArKXjsnaXyvmsWGewbkPvKRo6qA&oe=6AB12B17"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-Ci9tFtgJAQ7kNvwEZbWJP&_nc_oc=AdqINdfr0limhGrSd4emA-tW4LsVEr01kB5Ac0qBU8JTsroF5RskXbCEOjAA9SMdUqU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbpz9VzWB_1vLqIqg_3yT1WpobEXGtX7brrGOUoSTOMQ&oe=6AB13993"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvvz7h_IcxAQ7kNvwG_VROV&_nc_oc=AdoLQ17_fNOTcOzuP_mSRqB0-RfQHm_komn4-NAQnaH93NgfcsGRaOU8RlaWqyKQTxo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyi7XfoZOLNu4ZgJ6oOTiWXYG3E4uoC0Es-cezk34bqQ&oe=6AB14EF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
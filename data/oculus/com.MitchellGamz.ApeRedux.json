3_1314353743715129_8004439157581483533_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Hxx3PHe3VcQ7kNvwFnyCo1&_nc_oc=AdlF8KP7K-nxKVh7voX7UMLH82aTbjrTdl7cQ6pX4Mb3BIsj-mDCrabc5xSHe2aoXRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuCDA-3PkNXtMr1PQj77AQzivQGtr2JOMY0ptlcjGDDcw&oe=69A2CB54"}, {"file_name": "Screenshot 2025-10-08 004135.png", "id": "592059723919052", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297447_592059727252385_205619874998128580_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGf6HUBfEV4Q7kNvwG1c9Hj&_nc_oc=Adl6HXKXtqnRuQJ07G3bX9uOPr9o2Pz6kp2vhmtgG7NcvD5ISodoVeHAUW6q8nd_Vmg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuaStAD9vlpSVj2CTcCKE9TEWPQukcAmAijL7fgVcr8UQ&oe=69A2F4A9"}, {"file_name": "Screenshot 2025-10-08 003810.png", "id": "820136310495576", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499299789_820136313828909_5017308108936956818_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXxRBvPd-0gQ7kNvwFGLPOO&_nc_oc=AdlmylifjDwHIAQuYZq_7y-M9p-Uag9CfGR4Kuagtc6iMyylkYhGJDZDG251uC_grjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsyhfU_uH7veZ_iJBKdzjR1OEkz0Nmh6G9xsauOpR_0Ow&oe=69A2FD32"}, {"file_name": "Screenshot 2025-10-08 003900.png", "id": "789229133822793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499297170_789229137156126_6641609663185335581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1FSQw9__FUQ7kNvwEK5Lr5&_nc_oc=AdnLBZ2vIpDnkI4WXG6ms8nBjtFCLuVfRRhIcvFmegu1aNZWcZK8nOuUcrBcd15ADO8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftrrAyXi4j0C01-ZfN-FyGCzRCIqROaNYMapxfZr-id8Q&oe=69A2DCF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24909758682017984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqORWu6mAUcQ7kNvwEa7soQ&_nc_oc=AdlmL5qFybzkZRHn7mXg26GV_sBvJhcnS0VynPkOO-5nhFl2_1VrqIXbhOa164Ha5sw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu013OjuWb4S8uBqlY1AhYNP4dWIJ9chvyWmSQTR5oJjg&oe=69A2CEA1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ape Redux", "platform": "ANDROID_6DOF", "cont
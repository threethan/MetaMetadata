.com&_nc_ss=7f20f&oh=00_Af8Zr7N8p33jS_6mJM42qGJRvaMrKFBcQkHWo_9ncW9U-Q&oe=6A3E9BB0"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxfRUBaQTTwQ7kNvwEJJjPM&_nc_oc=AdqksS58yB7m9BZnw3YooB7Vr1rRYOHVWBm9H_JMoisSXY5CeKkUy7VfP8LVhHeLhKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I-YYk8lT9HhQs4z68d6Jv5RIx0GUX_uu3KwfZW0NQSw&oe=6A3E80AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vlouC_LMGYQ7kNvwEGBcOk&_nc_oc=AdqKuI762Yi-6X8kVhlO0pmgJsjjfHvOKlkPc0e6ewCa0X_s66HvXnbKovo4ShcPVFc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oWIobA9RHBA3kSd7xrrvDckO9IJyFtk45ijFbE69opw&oe=6A3E7897"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgiCpOySGLUQ7kNvwHbM9hZ&_nc_oc=Adp2ZCTHpSltj4JMiY-s0ER-pq9wMJ8q6woQy_nDfeI2loFTk3tGY63k3afdfM9g2Ho&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oYB2ncYNf2ECZpZRVWaJ0eL6sldoKhUOsLAmXkXmyUw&oe=6A3E8713"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7BxJbq94nEQ7kNvwG_c8EX&_nc_oc=AdpLWx1GQxmsSiSqR7Vd_Kew96DYkUwTtSy2OKcygNOG6cRZ_XJXyBiTWyHiyTb9Euw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97_LR1IQ8lUQtXk_FQ9fGUIkAPhkDQ8_a2_0hRqlApMQ&oe=6A3E9C70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s6QrKtgtZIQ7kNvwFFpSMV&_nc_oc=AdqFe_p16REUTat21nunK27Mx
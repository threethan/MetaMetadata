.com&_nc_ss=7f20f&oh=00_Af_h-I2upBcw54En45x0XA9ttSz3GogbkJuC107uAxKD7Q&oe=6A3D4A30"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxfRUBaQTTwQ7kNvwESnCCo&_nc_oc=AdoY3jydvo7ufkj2he8tyYglHI9ADAf8TPE3v996MpIPcTPojLUNcmVLvhWwhSN0_eE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QCZjCnsKOTfJ8tZKIiJ8q0M33V0aPcHc3etCd3ay8YA&oe=6A3D2F2A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vlouC_LMGYQ7kNvwGQJPe7&_nc_oc=AdpbysmdFf9zKydcqy2D8IQ6b8tg7zogbC5oy5YGSYGXyDYdNqLDUAxPOMVusuwG-xo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80Y_ZGrz9tEFvIi7K1vSrKEvog8Ir9Nrh34Mt3wDjN0A&oe=6A3D2717"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgiCpOySGLUQ7kNvwHIr1Ye&_nc_oc=AdoJ4tKMhhPdM3uCk0ZAHhSeJU2lQlJLk_5pFKrTc3pf9K6Fad5IwShBk8QYAJa6t5w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97zoSoQPzRdjkG2hj5ae__agaXj0KpINyFE37yO0YBzw&oe=6A3D3593"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXNJmE93QAQQ7kNvwGJfN5U&_nc_oc=AdqhU-u9u85fwsfq6Ly5sJYmAydsn4vgzD4BOBs-FeTAQktnNbMVO3hxQNYPaQkro7M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TpNt3YCJVJthyNfFXyj6fqVg3BE2ChcuEegjJU43kzA&oe=6A3D4AF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-s6QrKtgtZIQ7kNvwFUyoVZ&_nc_oc=AdorZXnVnl1MGZwX-1FUUtPWX
929.png", "id": "1670651491056972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uH5ev3LGHbcQ7kNvwH8pmnV&_nc_oc=Adrjy6HqHIkg64WBwdM_HFfw2pFJ89Mjibe_wMqlwUrRPm38QoCWr_1b0mRS7njA5-g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lSqNjNv5AiwdFgNVi-JtmEDRmbxbyErgu_kAAS_YMVw&oe=69DA4EAA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3oAoWGUYX4Q7kNvwFe6-DJ&_nc_oc=AdqWiB-fUEBNQgkX8A1cSszopCA16DagdLPcJz7jRjtn1R5X04EntNXGpsiB5zUDRZo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14WdYQTGgy1uR3cCmhAibF7ErEPk0Da_YR2o4Vlm3kEQ&oe=69DA4697"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylQ0rPiZWLoQ7kNvwHkQ645&_nc_oc=AdpcaGw1GFpOLCIs-gn4E5HEhHC2_XvycUsbjeXaJPd9Mg2NnCKf5PvkMEtu44zs8Ps&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CzD_ja50xolOwvdClVQww3u_msKeY9NL1R8gwtRoC7g&oe=69DA5513"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rK0oFbeBWPQQ7kNvwG-rOQZ&_nc_oc=AdqYnx7_ctinolpeGl7T5zdbSf4dLHVs3_miPA4dsrWzBKv5Ko0fXr82JlMwLljhXfg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20fnSvnoJz9wbmNUgOuZNYbQKOkOw5o90KsFRSHtyULw&oe=69DA3230"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QX8z34KOtqMQ7kNvwFuDQ85&_nc_oc=AdpPhT-2RYAVfVRi52X2QHuJyBWzu0BqYhvwT-fSnSdSPzAlc4nWwXillc3nKxEk39M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2m0I_8-YrduQ58HO
vwHbs5r_&_nc_oc=AdqTTGw5WD3pL-vn21GrlPLmSJ_P0IxMrm5eCI45RyBQyBK3lexsvnOFvDeE2Cl-BvU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhJ308GVsRB8juaTIExzN_KzwW76ksRYgS8XlSduVtAw&oe=6AC514B0"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HEHCoozpygQ7kNvwH4ILlD&_nc_oc=AdpR5Km6zygj8oQl99F6NK0EdBlHV13oMZCk8eLNqwegosd7oWMmdK1-Tc89N4Fz4Io&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoGkFUDkg2BBpojTcK9pWqF2OsCqwNZzv8riVOZZl-KQ&oe=6AC4F9AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWXyy3l8m7cQ7kNvwHUd1D5&_nc_oc=AdpT_slkgzhnaGqbmmIKFKCGIKoOK7EIM0P1c-37x9ddPmPUPM7q18YB9jKyXL5h-6I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_GAgsjLDlPUCh1UD36MdK4Ajo06tNBJpozYtH7XBwDg&oe=6AC4F197"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P_k-1ZHL_gQ7kNvwGkLBXx&_nc_oc=Adq27b_3s7T8W33ekvbI4lRtkm4JxnhDN4sejl_xNq_HSmNnYadglFhdfsTsrMZ0ZKw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1-LKxNx7TnVwTpac4E4-0MEfLgosUcDNP6dJUVEsueA&oe=6AC50013"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpnSTJGdkZcQ7kNvwHCPb54&_nc_oc=AdqsmA5l6kN-JlH0vhB9QweSqdCB-3Sk_vVQv_J8DYO1ZH5nEgdPpzdViRtlvAsj6uA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOymEIaTfe5aRUmBRy9WQ9QGR_hEP1xCOir3bHGpy1aSA&oe=6AC51570"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
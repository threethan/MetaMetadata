vwH33aRB&_nc_oc=AdrzUcvh0HNig5vMAuCIEqfYAAT78kpi6TmRzKkfBD8O37pQwG_6GS7_6zcfPTuZ5Ko&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMGoqQKfI5_w-OgU7X_oXKNYAwzvt980J79x4aLWNurw&oe=6AD0F230"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_b7kKo8VEQQ7kNvwEuR-25&_nc_oc=AdohfKbJcW2Fg6luPVvF7W9UqnDwNlokqtf7QFOP4K7SYri3lMO6StMP2rtY4Nn6EkU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHwxdwWERT_DNZO32WMMQuarpnF0hYGoXJ-bCasEvu1g&oe=6AD0D72A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfDbaSIcIUYQ7kNvwEDFDSf&_nc_oc=AdpmyRSLcuD_l--RjeO4MJTmndh59Z556yLlr-yAoKP_iK1nyIZyPgPJCA5TD3OpM2s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSYXywqqgWec5d9kBoJCMHkB6RXwf0DCdCcElBVg6pCg&oe=6AD10757"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3re4WY-UMwQQ7kNvwHHE_HP&_nc_oc=AdoQykkgrGtVCEOx8f4PqTp_ODN27_HvlWPthf0p4yVUD-aOyNuyGPQHYGm9jUJ08UE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPoozvDgipTuhC-76N04-f4Xq_-F7plFjj2PQ4VHZSgA&oe=6AD0DD93"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8i6dddhFqkQ7kNvwGt1OiG&_nc_oc=AdqK_Qg8RDa3c2DosDId73IirAP6ZeFjO9M4JWLUz43zaMqw8TD9ufgcDS_iIYBquG4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4JyJUViuBfh5bTR-T5YraO57d2haC9qEXIHmiSb_3Pw&oe=6AD0F2F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
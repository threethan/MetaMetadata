.com&_nc_ss=7f20f&oh=00_AQFoL80CSu8eF6vtHtZ9tsBnkGSbYRtD6w-r6PUsbRWeJw&oe=6A883770"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q-hGyCHsAfYQ7kNvwHC4hd3&_nc_oc=AdolcDjhfr28baJbfchKdxg7q4m5e_YAxZo5EDK3Ja-QrHl5_iTwKBkAZdy4ib5ws0w&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2YSWPa6HqJhxBL6G4Nz9jsveK9h4zynA2ZmWEj8hMEg&oe=6A881C6A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDTzmK0buO8Q7kNvwGiApH7&_nc_oc=Adr8N_mNUWAjC8ipM-lA21jwg0ZoE-ykxdIOFjytalqKRsMnXAgr6MVxkqWXFjfDiPM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe5v2_eCD3tF_cWXzBuk5T7e1Tw-N84noaYz4cej_Hug&oe=6A884C97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8cXtS-TImkQ7kNvwFfmOup&_nc_oc=AdoSqA-2WJfUWEV0pmi6bbzySTeyMXKUp_J22e2vhVt2319EpvTBfQnUh1xny-hYD94&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhRVfQ5Qr-f48nr-ELPdjf_ok_qg5eTspktsds8jRa8w&oe=6A8822D3"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xjz5serJNngQ7kNvwH9O_uQ&_nc_oc=AdrdlonbTeqM17LaGt9N3ti50ly5LEggIUqOulK11VQQGiB8jW1VCqkIpgoG-MFTKvM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpQmSI1lHoBS1qnB9a0Y6uYHy_UgOuNAL2JtjtEQP9oA&oe=6A883830"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-feNm9l7igQ7kNvwENAkQy&_nc_oc=Adp5edi52Tjqf1imaviBgnkZV
56972", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9aJEz3w6ocQ7kNvwElS606&_nc_oc=AdmCmccJ9Y6w-zIIy3py2-dATT6uwqZVpYiIlktlXK_1UJlJI_o-vy_rImY-6mjFv3Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwxO9BeRY5AdnMlR9tc6WL5yd180YQo66IaiSSTn1fa5w&oe=69BBFC2A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCgO8_zlTBQQ7kNvwHIWD7n&_nc_oc=Adlu-HFHE4SNOLwAGVIDkwSS7N7o45W84tN_O5bTHvt3TJMAfuN2v4AdvA9bie961zc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwp8RggC6TkdM6ivb9RJhPB37s-fItglhUUeSbri5xxUg&oe=69BBF417"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugtUE7IhVYwQ7kNvwHganHS&_nc_oc=AdnNHexOLH1xSt_wXd8rLeCQLniAoNKtOSPJMOEMX4WI8_LvMGDHQGzzDZHAI0lGSYQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzqivbWydt_iXqR_ThNoKjiYuDSDsvWD6Ac8u18OQTLIw&oe=69BC0293"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTEsDgNNlcUQ7kNvwG9WGGv&_nc_oc=Adm-UMT4XN3L-atUFOQo5tawCJ0kseEdRBVFUAOkyhXosTm9AZFk9Loht9OZOubBSS4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyH-wIebKQaw4P1D0yXsP9xGT5FJcZ_caOGqsl8C4mNyw&oe=69BBDFB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9iUHskrrSEQ7kNvwG-MDFQ&_nc_oc=AdkLIpnkAeYp1VRXxJihFSIQJQGG0sq5oISjV0nyk1owLdPeXriynPP2jPI-PDE9qY0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYvSdPJQH7_yFMzqEBU194ziQUBqW2TMBnSNGooSUoNQ&oe=69BBDB21"}, "is_
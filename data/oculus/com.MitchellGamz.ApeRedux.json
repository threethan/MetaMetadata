56972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmyECbjqTOgQ7kNvwGKxBMG&_nc_oc=Adk-WVGgAEPVPM30_YeNNP5pK7wYeM7Hg-AHixzmb4P7KZMMXfQx21GvVejjy0RtbBA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvLSaKU1QnftY6_SoZOhAelkS3sZhzTX_8LgfSmXZnF1w&oe=69A9872A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXxAhTOKaw4Q7kNvwEgxaxC&_nc_oc=Adl1zCLOetgcfy0IRbAY0qcqvFPlHWAE1ghchPSd_tJfAXFrp_1HaTtcq7r5qVmKEmE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afs2fNw9AcfEpBAEHrgRNi6S9RiX4NdCKwnRWs9fwQAUKw&oe=69A97F17"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m4-3UKaEDzAQ7kNvwEJx3G7&_nc_oc=AdnMAiN7-D0BSZccfzC-QwlFDJ6XtXwkjiEZqL5WYi5SiHOnwjiW1A1K9jKAxlJ1NaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs_KH8naqkqx0LHxdpnDJWzQNrvYCH7OGW_EbsFRV11Iw&oe=69A98D93"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7nrnD6Ot5kQ7kNvwGcEj-E&_nc_oc=AdkvrfRvetZLx3ik3jNSXphmBkLwIjnyLS80unP5avRQnxmedFDGCuqGXf4IVyFWpWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu-eUqeWDIUUT5Ffos2lGD2EGiSEZ_TOrlkJS2TRXSZZQ&oe=69A96AB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTKUwJO7tmEQ7kNvwG6y55H&_nc_oc=Adne8nX0OTbSz-davvPRmEMuNbshx1eF7ExCM-MDvbyeyjqhaZOH5ceaT9xe_nV6fAE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvOy2DK6ZjDuOGA1dZgCWHQZtNI6R1gSmlWjJHz6c5XLw&oe=69A96621"}, "is_
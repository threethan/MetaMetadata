3_1314353743715129_8004439157581483533_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Hxx3PHe3VcQ7kNvwEQF64z&_nc_oc=AdmWxxPa2RpmbNoR6kc4fZekBP-7BKUGKljgRfoISteYQYfLlmImV80mA_21oE-lDqQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afv8xER2__6aWcW_DPVU-ltyfopCF8rprUH7Nuey3zQrNA&oe=69A179D4"}, {"file_name": "Screenshot 2025-10-08 004135.png", "id": "592059723919052", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499297447_592059727252385_205619874998128580_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGf6HUBfEV4Q7kNvwFgF3g6&_nc_oc=Adk6ha1jlymuXaxO0uF6_eTRJgJcLWlnh0HeaX2_uNQlZarWXxieAh_PYZB1XkPL5XM&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afsvnmh9I5PP9KfsVDUi7rFeiuksk2TfEgarfJfBPpvceQ&oe=69A1A329"}, {"file_name": "Screenshot 2025-10-08 003810.png", "id": "820136310495576", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499299789_820136313828909_5017308108936956818_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXxRBvPd-0gQ7kNvwG-kehR&_nc_oc=AdnUKMixVTthFQ-FDWbeZDJrCDDvIrB-mGnjicxBl2jES_kHeWrSn_2WM1oUaK9WJTU&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsSWvENmw09tNmVRiKA7ruQjHmZRMWMuOerK8Du4kTbuw&oe=69A1ABB2"}, {"file_name": "Screenshot 2025-10-08 003900.png", "id": "789229133822793", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499297170_789229137156126_6641609663185335581_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1FSQw9__FUQ7kNvwEzoEE5&_nc_oc=Adl8fGQJynxdyxPae0qLgifewGZnMC_h82NR_peHSsiWiANSgAb5RWZ_om2XpZQyzdE&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvsK8JYf0IpAECwZv_c1TPQY61Eo683j9YT--gybLXXUg&oe=69A18B70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24909758682017984"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqORWu6mAUcQ7kNvwE4vesY&_nc_oc=Admwt91y07jC2y28KOhYwVP81l2B6p40KpuWaNnFM7zixMNwa4FjyHyv2bZeXjV7znQ&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afs6cq9LcOvAPR2mOm-v2fpOlI0qUkw00OhDXRfDi67sNA&oe=69A17D21"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ape Redux", "platform": "ANDROID_6DOF", "cont
22 151929.png", "id": "1670651491056972", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An17RHf_QrcQ7kNvwFDBC4N&_nc_oc=AdpKyZuv2r7R_3X5nUQYVj3rHLwYjX7H7uoWpAxbGu4Y79IrpRoMRdGiD0sUuf7fP1w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af728edeo7J5V3h2_zKVHdt5enu6AVhgE2BV8ENgYdL-AQ&oe=6A11ADAA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jU6yEKJviZ0Q7kNvwEyQqXp&_nc_oc=AdrHzK4ws5AHEyApssTfcy78m_B3HCbLUVBgcSBUifKra8BjXYBR1eY1jQeJYhoy4LI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l1dxp4vIpO1cuDsr9Q8bqnZrn0LKSrB3qW39QXJYjSg&oe=6A11A597"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A47Os1lJsmMQ7kNvwHm6ulq&_nc_oc=AdroGxFXJt24plQnOO_jeWkfhCxru3uF6kxU22y6EdGA7xCQ0fnMuBT3vaP4587xgCc&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79fAYMk8MLBgJGRBqJW7lD42wHY0ccmGXikRlq8LjC9Q&oe=6A11B413"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-Fs-jR26Y4Q7kNvwEYWWc1&_nc_oc=AdqaTqaN-oplDjjK4bV07Y--6ZABQdQyscRZ7Qv7fO2ix9PRLvx5DfJ_-r5hztZ-_pw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s9jtdgxZdRDcz82uUE6Tzt6u1RWl-pIZmDvuvwNw8Rg&oe=6A11C970"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sX2pTsWzstAQ7kNvwE-tqEI&_nc_oc=AdoGJlI2fJeFLZx41Ogrj0mj0AiQOChFuUYqEwgUmB2oFIMD0YekUc6nTt8Tl3n6vIc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FUljJUTD-
vwEG78yU&_nc_oc=Adpi8V1D1d6CldFwMtp9ObFks-j7k19AAydyLxijir_xGFdfMVJLy1XXhl2Wr8aj4nM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtfxlwKlioHrnVwZ4ghOLZ-4i7IZzxwYEeDRxuBZhIdA&oe=6AAD59B0"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jiq6AiuswBQQ7kNvwF087ah&_nc_oc=AdoWVuicuQ047DZfcC3N-k6pWlmtYy7j78wyt7kFjP_MLRK6P4WiY6HyKiqQjOm9-Lc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKxlQ_21itvO4yd3uv1jS-0POIGBUmCRdKlS4UbDL9JA&oe=6AAD3EAA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REUdMuqnEDAQ7kNvwHQB6Sr&_nc_oc=AdpQgV0bw2k8glqLgMZ42g1_pWEjcgd2xk70KBKxQ_-QdryXq0V_FzaHkpMPB4gnWiI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1vLu3L0zX4gcVpX5UDZTjiZn0kLIQMJ7cj_valDrVTw&oe=6AAD3697"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_qwOCsbvIoQ7kNvwG1bMk-&_nc_oc=AdpIg_EN7KiYqDBK-1-unHP_QQ9hPgQSu-O1FlRHCiq8J4MfmOz9yKzkIC6_SDOMvhU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL44-b_hfGoAEeKWf1bya9pOvbyV67v1cAKZtIWFzrtgg&oe=6AAD4513"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWmGngecinwQ7kNvwEGTwTJ&_nc_oc=Adp6wCh7FMGL53vknw833PGf4wCxfYyLyD-khLjjqSzwlI3GsYZhjl-pNbSeoSnbCxY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi0CMGoGogDZ-HLQzVaNBFx0U8V9zA64gid0P8t5CvBA&oe=6AAD5A70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
vwGdX2Sh&_nc_oc=AdroUBH2XSyazbmQ9CcOTGAuWZfjd6U3XioSo-CYDsInEGT1Ab_P5v8rlYyGDWFiLQ4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE9HKUPE3e38tpEEzrN5z2yVS-eKL0iLc1GjGmAcdExhQ&oe=6A972870"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OhIbnNR8Z0Q7kNvwGFcQUC&_nc_oc=AdrNEod68pB57C7Jje8pYp81HsBuqZuZEC92ydmQoWpo3yVDtisVjNZoWfm91EYRxv8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnHzc-QfCee5rLlchd-WdjpL9xc9iC0XODGrvHvsNY2Q&oe=6A9745AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A6otkPsaiHMQ7kNvwGPdGk5&_nc_oc=AdrLW_F0llzQtL08BMGUY_IXyC-jg3p0mycP-iH9meVcg7G5DoiOome-w9CAcJ1vK64&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUnPSaCvbNS1_waWI42Gw09HzXRflIg3DbJVdFlKvJXg&oe=6A973D97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdihnGOGIdUQ7kNvwExlljF&_nc_oc=Ado03mZEDLN_T-YjB6DGiHTStKmnT6AK5lJeS3qnjUn6mG3Kr9d1QTN10Yvc5UhVu5s&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ6wGmxVGzMgagei1-5LhOY6QREpVN0My4iQzZGw8xHg&oe=6A974C13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoWBqWUfFdsQ7kNvwEa5LVQ&_nc_oc=AdqoosBN8ivO9GhNOYx6nGKTcOuS-dIuPebFRjsE1VUQdt-gJpPVdakvH51zFevbwno&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpPchTlHCZlQlad9KDSYOmWJy9Ri62V5Ay9hP8hAaYHg&oe=6A972930"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
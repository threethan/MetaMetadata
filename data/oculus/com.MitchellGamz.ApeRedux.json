_name": "1000017124.png", "id": "708191828482199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831000_708191831815532_1619391336481175031_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rN7hyTLV8cAQ7kNvwGOpcRa&_nc_oc=Adp2NUx96pc7CkJ560d-FWWrVu4vhHj_K6dhsFCU0Zr9Lvy8ix7lT-r4GrJ4hi2Dq8U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzeo_0O_qmRJmQxQR6hHNJM1KUbxYT0L6nggNjnY5GTg&oe=6B0C5E94"}, {"file_name": "1000017125.png", "id": "24080985751542501", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831056_24080985754875834_1799151365263793052_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLg_JrFnTzUQ7kNvwGPwFAE&_nc_oc=AdoCrI82BJAXthWiUejll9mEHoGJP0gqgsiYSWKj-P-YUIdFzB72xSDkAbeBqdu-UHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-8uYrWzEn8GB2CCBjLN7GEdgixt6xH_RM_6tmC0Uoxw&oe=6B0C5F71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23881833214810541"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "728492016205781"}]}, "baseline_offer": {"id": "728492016205781"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751925660, "status": "PUBLISHED", "id": "728492016205781"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26711568841836950", "version": "1.55"}, "id": "1853150875247453", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23881833201477209", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26711568841836950"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1853150875247453"}]}, "change_log": null, "created_date": 1778045109, "id": "26711568841836950", "version": "1.55", "version_code": 54, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary"
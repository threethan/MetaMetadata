56972", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyptsLtDe38Q7kNvwFOZDI1&_nc_oc=AdlvvEl9fCJGMb7JMfyuYKTUmy_jBaFGdlnkMp1a7VVMLNubhizZ2hnag-N1Pxc7T0Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9Hz89ox58UWbsycIpL963MIhp5LdLpLEbGuFaXqZO7A&oe=69B1702A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z-j1_qRkGAQ7kNvwEKSpRv&_nc_oc=Adk6mluqbPcTQDWWDQ1NGaL6prLJvTSLIRroG-BqkkaBZ4Eu0PrM81D1AeB0grsmqA8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRmh269MBS_QVGPrRtyjfouhby1NObbguIgp-1bcaVkQ&oe=69B16817"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSgpZbVxk1oQ7kNvwHV2kwi&_nc_oc=Adn5QeNBCZ2UfcdeVVSKBpNi0iOmmofKf3Z7AuQO_EGzd5ISo1U7B65oc7VaVyOCoFU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyGurqBW7OtCFOrqyyiGXVWhhrlJXOAtqhl7-EGwoX4Vw&oe=69B17693"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L24OnNWiUYcQ7kNvwExxbhz&_nc_oc=Adn6iCh9itynKn68LL08nKNZ9qH1Q6mb3auKDV2KQSeIzkW7nnyYQH3cSg5TvfLaLFA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1KvhCnbj6BTuiThYzvr_d4bgVjYBvfSaTsHP0-_tjzg&oe=69B153B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylMkAmY0_0cQ7kNvwEj_GBL&_nc_oc=AdnoW5SHLKBXnux6WszxtYd2Th9Ie3TADsm3xg8CjC8XkHRYfru42JPFwCzPb9cRSWg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwm_aCSZtzhO2tqFj_nOMW829rNLxymYyRmo21R4MLsbQ&oe=69B14F21"}, "is_
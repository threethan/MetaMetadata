929.png", "id": "1670651491056972", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ew6yS3W2-f4Q7kNvwFoxau1&_nc_oc=AdqpxhQkHxKIzTDUf3W-yf7AfbDl_l1Kg6FiAJfn1NHcmcU6rQyuslaj86xk6GZ7E3s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjuBwyRSoaPY4bOU67KiYKRcMcsSs_gOHuRi3T9Su0xw&oe=69C536AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apMNh-_uakQQ7kNvwH2q-Q7&_nc_oc=Adq5A1zTiGevEjXucSYRnhyxkCW6fCumuFtvrvcdobx5Ipw2E7nAI4MYIe7ohe-i98s&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKox1JVT13AbHqHj8fhAkPzb0GLwn4_sw01PiEwWkYDg&oe=69C52E97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zOP3iQhJiYQ7kNvwFE_tQa&_nc_oc=AdoouZmz1aRd8mVQhzFTe0GuuFvO1N-9IEKk_Begmk_cCdXN7_OwNp-nI7Vr27kG9TA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwXpsuPNL3k9CT4l7kcQMmIQDs2P60z9d38OIXU5w6mjQ&oe=69C53D13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG0CmJT7pwcQ7kNvwHdlHif&_nc_oc=Adp4R7FpbJn8YBk_WB3-6OPwZC_dW6vhH0ICosxFo84Ty9WuoENzXXsrR-eUAh5g17Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9gSJkl75NPUEdmhI8O4y0F9pS2Nty0NQJI00cJz-PIg&oe=69C51A30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iAmnGh22LQQ7kNvwEvMXLv&_nc_oc=AdqENFWAaCiY3Pjj1G-bqiyZ3kTEJZTx7kHTrH2hi_H3fm5BQ3WRMgUbJRVz7kdVqwY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHZDe_yoqMLXXaVE
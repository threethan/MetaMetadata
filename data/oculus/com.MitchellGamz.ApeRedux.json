_name": "1000017124.png", "id": "708191828482199", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491831000_708191831815532_1619391336481175031_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1ul40QOTNYQ7kNvwFJhy1A&_nc_oc=AdqdtPIre39HfKXDl2TkpPV-oF50y9M-I4HYstPXI7Q64pcCWTBRzlbAGRpeOL0n9DE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0uSngNnrI-xoeyXGIl8w3MnpAdMJc7RQzN3ru7KzuHw&oe=6B09BB94"}, {"file_name": "1000017125.png", "id": "24080985751542501", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831056_24080985754875834_1799151365263793052_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzmUBrsYfa8Q7kNvwH7lbaZ&_nc_oc=AdrsY32wV-DNWlr1hw34MDSPN2khQSWurbDkr_QZXEgPtA9WHms1YWV4FyC_qXyK3hE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb30gZXBa6AyQM6rc9zXLuYKXJ61zdGgl-mxFh9tOL3A&oe=6B09BC71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/ape
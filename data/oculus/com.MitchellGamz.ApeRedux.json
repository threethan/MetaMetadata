.com&_nc_ss=7f20f&oh=00_Af_rey1pLWpqgJRzMrV8luTCErAEXi9oSQFdwXwHiBHj5A&oe=6A380430"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6HJcGOv2bUQ7kNvwGjvgAs&_nc_oc=AdrWG34sR1AoI8ImCXSM8OPRW7xZSMeCD_X4WtU2hrv5amoy48KJlFc6xS7R8FpmVi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AHeJFMXt-fFENIFnFd-Js6MPTsRiJBPeyGZToI9jAVA&oe=6A37E92A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHersLHHdVsQ7kNvwGvT41T&_nc_oc=AdpGlWhtpDGRNJoT5C71CJd4qsamGx1gdBilweiShtMS8D2MsA4HtWURDGsqjguB9w4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e7P3_yS7MgHkC3vNVnX3Si5jSKj-kRilvCyXvrOIXDw&oe=6A37E117"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_MyZduEHJYQ7kNvwGVj4DQ&_nc_oc=AdqjuoiJyyAfBuNp9l6JmBKOk6E6xJ9X5V7SA0VG5HmG1Bwl2XrfV2k0ISS51c0qTFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HvVwPBcEB4MdQhJU0ebIuII1sdP27fvghhlnjXYe-Jw&oe=6A37EF93"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsh_kyEB3foQ7kNvwFWPyGZ&_nc_oc=AdrSsSjQmgqAB7ZgtU5wDh3Y6epoB9Tz39O8mzEtlePL-b1FJQTreoFCdnV15j7eJUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-kAOoURfwNyP3r3Gwe-sZY9dlC40egyPfq-IqIwZxkQ&oe=6A3804F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGPHRUlxixwQ7kNvwEWPccZ&_nc_oc=AdrrWdDXJ1E0O14CyXRHY_tBA
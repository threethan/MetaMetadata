vwFFQWYm&_nc_oc=AdpbL2B4_eFxJCYr24I1sLr3h_7XlsMc1Lox26saqd3-gAirpZxMzNo2Gp65J19FS3s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO60YE9kWmmNKn7x6XdMH-iFVAJL26AQM10SL686Wv10g&oe=6AE215B0"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUpN-tyejhAQ7kNvwFKN21e&_nc_oc=AdpEt-mOVEBSjVnsZ9JqhghZx1oBDvwu8xk41OKXMpI4Zd3hIcN77Ph4NFpE7wWbej0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0O8EWwFryq9uxBUGyKJQyv4xZTtQm5K7RSkWbspddxQ&oe=6AE1FAAA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyQkrQ445foQ7kNvwG5lvA3&_nc_oc=AdrIdUuOHw4YZznOijJ_zGtf-zZI-hx5ULw3rDjAJWoZyTi0xIZEHUL1GmLbPKB7NRQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvlQQNGRt3wXMjt_DJPZaaxn33sxW6SE-rtnQOnsmafg&oe=6AE1F297"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWPhAWBR7ssQ7kNvwFUtJCS&_nc_oc=Adqz23AY_Gz45LzOKAuuVwmVkwa8N_mxIqp4TXIdx12Ti3nwViBZiTA4Xd4IrEUoWBE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVJU56ZV2AKzFDVoZHeDRKqCPdNRQliAMZac96UpjBKw&oe=6AE20113"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbT2Wz7IpngQ7kNvwFJy2jg&_nc_oc=AdqwjMAl5hRRMoqeofcd9_pGmVTycOcc8MzVSaBufKavsh4qgJgIEc-VaOKC_Oqd8Sg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr8YgxfgbMabkD-tHN9XoW0HOqofJUidgF79FHedlGSQ&oe=6AE21670"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
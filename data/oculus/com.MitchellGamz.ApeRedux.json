QYQ7kNvwECHUj7&_nc_oc=AdpJsz5_HYTXIp3to_HCMiDYrMHfpDniGEHd6ysKTAyb_H6q9xszSZmcZRrCOP7-ijQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI92jd902s3Sfl37UI1giH1CwrZBZFxSAdFwnNFvD5-Vw&oe=6AAEAB30"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81wvgX4WsC8Q7kNvwGG1bji&_nc_oc=AdqddSGpfvZbS7EFahyFOQuZ9_N2B6ooe0cBQ-PZEh3UDA2dd6UK41u_Pf1jheljmNQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdGrD69USpqohIXkBYZtOUa0pIFiazfGlnFeNLaUqKOQ&oe=6AAE902A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAYe5_QGhgoQ7kNvwG3xs4g&_nc_oc=Adq6akQKxV1-tUthg3oePaAp0iPtGrhAhUOOBZbQELMy9sEV7FCXkbD4XIRM7S2CsN4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGnV7uyB0TXm0ZWVNiXtrgA_Qr6GQJQitJaEHsERfrpw&oe=6AAE8817"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-Ci9tFtgJAQ7kNvwEgtY0m&_nc_oc=AdpQ2lZA25uZfB589Xgdc65dtYjVTRlcw3Tx_mBpO1YtjweYuedPTHe1NkuwsXArOgM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjxkVUeWaA0vOudHAojeJon6HpxbFLq9uNft60W-eatw&oe=6AAE9693"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWmGngecinwQ7kNvwH_Gl4M&_nc_oc=Adp_kw8-bkzxbCNX-Wl9kOWGTkB4fJGwpegTPvtn-OCEp2kZ8SAw0bRvdB93l8rc1HY&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVaj9SY4_r9sownygQPiuC5vz_Kb6k6eZ9K1tpR9FEFA&oe=6AAEABF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_813285856930006
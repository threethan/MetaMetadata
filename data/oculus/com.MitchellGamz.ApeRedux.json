91831815532_1619391336481175031_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xnHe7FNAMRUQ7kNvwGk8vS0&_nc_oc=AdqjH_XS-WpbarC6rn9QmdC67_izcAZzLxySikJreZvzQ0mStD9Opvx6c2i1T0El-I0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-8cKzIza-qx6XaGHKknjxqgenjgT9Iyr_aj20oEOb4g&oe=6AFB3B14"}, {"file_name": "1000017125.png", "id": "24080985751542501", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831056_24080985754875834_1799151365263793052_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mo1442VYlNoQ7kNvwE5XOsB&_nc_oc=AdocbQa1L9-H0Idf-GIIBWVapSc6LIKDAbu9z0AFgG-1Tp7kqKXSIbsap5TMA7KVsn4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTG2XAwQkk40lbnKf3-QkYCr0Gs-ztvJwiQmiUPZtVGBg&oe=6AFB3BF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "274332603
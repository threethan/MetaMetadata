_name": "1000017124.png", "id": "708191828482199", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831000_708191831815532_1619391336481175031_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rN7hyTLV8cAQ7kNvwFEG9BY&_nc_oc=AdrS5Kb5M6n7CWKHxncoo97gST-hG_8xa43OoFVKhQ7tq9hUVIOy3RWYfFf9LIsElQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqJd1o7SM4CrzPB3rPA2C6IzS2awwkxMYEog_BsTN3Fw&oe=6B0DB014"}, {"file_name": "1000017125.png", "id": "24080985751542501", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831056_24080985754875834_1799151365263793052_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kLg_JrFnTzUQ7kNvwHf8UlK&_nc_oc=AdpVYBOc1UfOhXlSvvTIhK9kiC4XtU3cR0YlTC31bJvpVfrhbqEVb0PdBF0BjerWZz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSZrGDAhH7D2vUbfblQASa_9-FtS3kSx0WHO4ngUIZVqg&oe=6B0DB0F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/ape
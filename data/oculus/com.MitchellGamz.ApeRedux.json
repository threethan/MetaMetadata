vwGifCFL&_nc_oc=AdoMsUO1hawQq4CdSK_1-QRBe6MjIhttTBNL3BmhUUmLFLLD6KUdJa8Ps1fTQ_ygrTE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbzZKOtERFFTB590aKDG4PSNYdc9S7C1rBn3BdXgDflg&oe=6AF9D0B0"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuVPV0GIa_YQ7kNvwFFXbJn&_nc_oc=AdqL3vl0DpWbVKZWoYs1jOhrRIJSeRUNs6vIF73XfooJRtKYlollWKtYKn5WSMuJz7E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLE_BJhmttY1HYnaYZa9bhTy4zPgA4haGqiXyfR1pczA&oe=6AF9B5AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTAOY6g8SbEQ7kNvwHZuIjd&_nc_oc=AdoCkfUWO1GySBYZdMSLpRo6v6X2h90mXg0LKHHDuD7sf_amoI-m_EiSpsLLWlhU6S8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe7HIe2z_hLcKZzgPATL8Lvz-R0MUj6MmmZcIomgnk5A&oe=6AF9E5D7"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJqK0eVcTeYQ7kNvwElegM0&_nc_oc=AdpbiQOPurwgweadTVVVQBmaDMAVGzj92XUTue2zIKcYPnQyUrDcaBco76gSqGF0LQA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQeUNJgp3FuaAgZvwcx2b4k5h-QeXnrUh6ExOz5rHQyNw&oe=6AF9BC13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=raIclwycuN4Q7kNvwHlD2jE&_nc_oc=Adr1457iPfXu08pzkvvDbCzOzjCAYC6EOoJlybzZEXFTBeiB9k4LS960Ei06dY0Iu5U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8kFlUKn3UfFKMkNGGh-3kCFNol0wKhY7h7bD_7neKpQ&oe=6AF9D170"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
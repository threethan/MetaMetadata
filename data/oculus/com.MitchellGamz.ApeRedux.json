w8Q7kNvwE3QjQs&_nc_oc=AdoidNo08b3Hegi4_EI_YckNLgvglVCTcBro4ukx0j3DJdQ4ZfHXpRCFR_U-ux3nruE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-zP_X_P3J75J0i5Px_jZWVEtZlBwGAxV3WcsGTcUfAQ&oe=6AA96530"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JfSOuYDLWa0Q7kNvwFq8oSd&_nc_oc=Adqm5N8uDL3aH09wpMzipRA2uq2ziVx7YzjwYdgU7VCM9UYw3nQmBjMVA9t6MML0Wec&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ225KMLpFAEIy_3UWgeG12oRYWLxPCKgVDJhhTh8aXxQ&oe=6AA94A2A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWL21cXgDg8Q7kNvwEzb3h2&_nc_oc=Adr2WomkO0MXs8Alc08pQp4tH5jmLPzVe72RPmA0r3_ORdHEL0AChCSxkMsT_FyWdHw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJN8tNXTqOjCyN6S8n2Puska4L3ZpblneiBqBPjeRpTDQ&oe=6AA94217"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCl8C60c7TgQ7kNvwEgxbs3&_nc_oc=Ador_bOkHWrESGPIgiJfWMO_yw9-aLvGLxvMeumTVmRkzKWC8dqKoTkTUKv5zsZRjHA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJizvJfMH34p1xwZLOOK-h86OAaDoUNw50Lfbzm1WNvcQ&oe=6AA95093"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndn0gWaUoOgQ7kNvwHlG1sd&_nc_oc=Adoguomz7DRwKkxL1rxTS3cbrZFxfU1ufSUGHlo5QToJLyOrjRUSK_465xv_-VJa0Uo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIirFsHzLCPeXXdGRyNTXEKU73JwM_ypSFmlIUVwqO1IA&oe=6AA965F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_813285856930006
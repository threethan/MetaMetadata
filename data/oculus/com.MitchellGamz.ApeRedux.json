62OstrKm5gZlvoK_UeJg&oe=6999B0D4"}, {"file_name": "1000017125.png", "id": "24080985751542501", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831056_24080985754875834_1799151365263793052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pzQ6kFlBz0Q7kNvwGcldfC&_nc_oc=Adkry28h_HI-aue-AMlisLpdE4bJHhEcxYnmkWJC_hXNzAlikQjaA6133E2xGUxC5TE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvud0-P50ex87BaUlOG3BF67dB2qmYdcsOsPwUt-hbCVA&oe=6999B1B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported
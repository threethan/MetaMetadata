.com&_nc_ss=7f20f&oh=00_AQA5648nJsy-7w5pgXXqLmWyi0DGB7qGhI2Pbl2DubKdLQ&oe=6A5E0770"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o00Y2roeNpIQ7kNvwG4fu3J&_nc_oc=AdoH15fdSVrkuwBAw_OJfV5shls4t_ly2DAFtA6f9iNmKPzikwYnHnWgnFMQCEycUKc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsS1RFTkJK6JC1eSqkYxqIHzRGszeWZcvh4pr6Y1Xo3w&oe=6A5E24AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oxf5ZsU-DNkQ7kNvwG8nkfN&_nc_oc=AdpZmoTTRDPngP2ozSfeOy3gDvGY1QFWKc8Fb42kTBijYJhCZEJr9_F5bBuj4UZFj8E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDroRMrv_3L4JBO3Vja_vsKJNRj8CH2IiCIxqkoYJdl3g&oe=6A5E1C97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipB5exUfua8Q7kNvwGDIHh0&_nc_oc=Adq5hfVpIWfe3LlkTAeZn7BjLOnmKgZyqg08Gm8VSwGHsQrrVJJkhAGcQWQZ907ScoA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCiVNvd2B5pXnXPjCA4tF53-kBFhfJ1eS8lhPHaDje2lw&oe=6A5E2B13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUr2sJnlpXEQ7kNvwGT8CTn&_nc_oc=AdqgcLtPwUI_LAxd49-yD28a6o0eRbSGfHkTYXg5O4DYGx586XBSmHpJrEiL0abrSoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7KQnj67-Ggb3kaLKyL0NBUG9pBvK6rwwZmVYdzsWhTQ&oe=6A5E0830"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uxd8vmqGvjwQ7kNvwGPU8ri&_nc_oc=Ado0y-NwPVojyy-Bdsbk_P6Cr
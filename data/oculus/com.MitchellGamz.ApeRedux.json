vwHRPtYs&_nc_oc=AdqdybQX08RgOrjsOg5tDeKdRBPtunypaLSwdwBTx7LgzdRa5Vx4nQND6QCKo9ddp_U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNg7UkutjdJIiXMW3C4D7NEizUZa5CrULWbUGiOLW0RXw&oe=6ADE2130"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8-WOF9I0cAQ7kNvwHti1z1&_nc_oc=AdoPVyVuCCjrjW6YllYNyrrdr4a0g5NCyq9y9yEcngSjKIMFRNEwfQbM76NA4Vqy81I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEvyjHJD4Lyi4O3uTa-aptogOd80m99dCZUmXL_uIhQw&oe=6ADE062A"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7xOzNHbAcf0Q7kNvwG9lGK_&_nc_oc=AdoBUkwxSTDr2aHLwT9_SNhKQeOtsPoVQHMb83AtUxdmPDv2nY6I3rnIK4gf62NnzkI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3mFFRjIs3RVF7WdAkX-3L5ZfObtUH7bscmp3CcGFl4g&oe=6ADDFE17"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_4wSTpn1D8Q7kNvwF3Iryz&_nc_oc=Ado6OxZftkMjfntZF53bf6YXta-4ZtAHerNDyFb0P_FMd_svatyTd73P1BPujIfhnpE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6edZ0fiC8Er6FirkIEj-faJ0Uc8WRHTgA9fH33pooUQ&oe=6ADE0C93"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-V73QHy-vEQ7kNvwHP7JAy&_nc_oc=AdoFsxSlr0PMujzYUP5Y3Y5UNp4AB4rZmZ3f4oswr0Wh4GIVEJbIwJ3RaWY81QBwIto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2Eh7ipYhXMm1KVfGRB_oInxc7TvQ7UuBfymbmm2HxBw&oe=6ADE21F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
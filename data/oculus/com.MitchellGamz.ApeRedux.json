": "1670651491056972", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YhKNEwZ3w7gQ7kNvwFxR8YR&_nc_oc=AdoGr8CrdEOYNdbpflBtikjbdQICIu5eJ4dvsM1fXAvajAyk3j5KiY0MIqLCL-C4tr8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2nHBGCRhEgndG8a18nUeHkqcAizULh1Lix-RIOUuHmKA&oe=69F209AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1rgqsNFY2sQ7kNvwFUknqH&_nc_oc=AdpwFp7OwC43KFokgI16PMVvzSugU-rBQStBvpPA4GBX2AqDYsktbAIAMGNaoMRin78&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0N909N94Rr9ATVMUSaTti1hkgjiQZjVUAz9oPbxCG4Xg&oe=69F20197"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SPJXBW1EiEQ7kNvwHBkM3U&_nc_oc=AdrZ19Es5pLOTFRHRFymBcadNe-GvVyeAcj46ftQCTjA_JOkzVeSCx_cDcpkUkFsDr4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3X5J76zIoGhLnZbE7kA_EhICiPta6h2fyVA3OHz7WRcg&oe=69F21013"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qppu9QhurxUQ7kNvwESYOcn&_nc_oc=AdpWWtgHSgK7GlYPg_8-JI5yHAh1dPgP2Hxxy7CDUm_Y35sQUazhoia5In_iGQgeRX8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0eJ3gQgde6lb-FRJe8mME6SLCCsIilOE8b7T6LzkQ8Lg&oe=69F1ED30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL8x4V6NAJQQ7kNvwG9gw7a&_nc_oc=AdqDGClVv-HWSeJUHPrFrElHMofPcipP6zWzwNT2W3Zj7jgyQD3vtkjsDzCp-eEYsyw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1aS7pVRPTZjUqX6Qr00mbTz0oMjMhnwRh-V0bU6d4FiQ&oe=69F1E8A
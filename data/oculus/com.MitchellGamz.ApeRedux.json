vwGoMV0I&_nc_oc=AdqL3L31m1OFz-gQNPO2utCMj3v16I3iHsOLIdAfoPT2lMg_ZSLP48N0Ghvq4kXlMEY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbjJ3Nef7jqhTDkQk1sAy8DRXgQi71qvKi70lXNhnFFA&oe=6A9AE4B0"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmYkezNXQysQ7kNvwF6yYat&_nc_oc=Adr4Q7grelMIAJ43cd4DamNftr109n20t-2jFof3elVkE_vAiRFUNHCVECynpmQisSE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUK3040TtL86epmFPCchyNbH9rc8GfhR4RrVWtaZm0dg&oe=6A9AC9AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=He6Emes8DtoQ7kNvwEV_fWU&_nc_oc=AdpQN23uh8lQt1UOG4yyR2CdcnIhovZb_9MJB3h_AsCRHchHN3AN-VB3TaM1MNS4-iU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOBTDOeEvo2DSgUMp8vcPpGNNoAqRcMuVR_PguC_8Zdw&oe=6A9AC197"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUKq39SeZKcQ7kNvwGU9N-o&_nc_oc=Adqh0yzKNfTsBlpvHzkEXCs0rAMsPyHbhhc27UGn0XKNn4bb5NjKCU5xQxeVyR8-O1w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYnDwSi_3inGKKsZr37PHLXc9rmMHglZKy1oePzF1-Sw&oe=6A9AD013"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4b2KX86ynAQ7kNvwG5LEFV&_nc_oc=Adr3_dD_rDcBA5kJzyrM4pBkWB0HPTxnagG0hhl2S1K4-7Ez1-Px5CO57ksbQCJehzo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICcN0Za2vXbaL5R2RjDvRvpSMqDqoRW0gHMsi1U_Gshw&oe=6A9AE570"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
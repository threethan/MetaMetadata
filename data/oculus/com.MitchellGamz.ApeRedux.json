.com&_nc_ss=7f20f&oh=00_AQALBDBukhVcFUB77lO42YDwgYZy_vRDY87-P9Q_fFBKJA&oe=6A5656B0"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=udNnZ1vT2OYQ7kNvwFPSfEI&_nc_oc=AdoFrQnH0zTuNPqUZpfYN55_ycG4XAiBtp6Y6z1wyyQMnAd2QfXERvC-2PMY1KJTr1M&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVZbZSCwTjqXC5zp6UybdBXjwUmyldciEkARC_qJjyaA&oe=6A563BAA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMM_dY64Y70Q7kNvwHkiHf_&_nc_oc=AdrpgXmh5REThWXHrg3H7bci_gnVg7Gvgw0PrFITDuZzzC_YZzusitOa-J7NtEouh1k&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9WGQ11dXVAR19DXo3m5UidNk70m9yxZmGXu3gkX4w4w&oe=6A563397"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYb0M3vnhyAQ7kNvwE3HkmF&_nc_oc=AdrXYkGR_-cLUZOMRFVWvrdffKFtwYyoppczeJ31LjRH0J8LAaQgDKy15eu0AGQz4vQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAkoE1xD9mG1lf67yA2WirK3Qe-sNJWhhfnWPwj-8j5A&oe=6A564213"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1JA_RgCNZgQ7kNvwFiwyVT&_nc_oc=Adrm5rZCmlj4kmDckcB_QCmQ9nlX-ccmn9K-vJkpyEmi4UcIDtgd1bBCD4QHdIrW2hU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA30j7vFoGENFul5dh2n4X5ukVqprOM-taCYvNGK9r7_Q&oe=6A565770"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqCB0AOzJx8Q7kNvwGQ2gn5&_nc_oc=AdrhrvgaANAXOpXQGgSaPyUcD
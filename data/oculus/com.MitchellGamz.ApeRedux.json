56972", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OTx1lerZiiAQ7kNvwHwnG3I&_nc_oc=AdmMVHE_vGYesG9kThRXchdr9cas_BC_WAwH56bosGnzLIiBasbAWxvgRrlY2LPAjnk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfydIQn5O6ErMc3be-qnvAaW6X3TL8S7QYSOg8Tmd_G9zg&oe=69B807AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68KDlYGEIBsQ7kNvwHA6Hm3&_nc_oc=Adkg71p7FCIGQobHX3t1pjD_4wi-dOLlmOQI62c2qCrhxtYGoKeK4ERzjVtofW7IP8A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxZkjCSaLmfukJmX3h8owIYIcynoZY_ot49NeaH4MH9gQ&oe=69B7FF97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nXwrNemsN-QQ7kNvwFJKiAz&_nc_oc=AdkNYw9lJduQZ51mY70D6DNkIAwLzEFYYxFkoofOvtmYN7qwd-IYENvfFVTmOctBUro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzeXZEw6BCQkJe90DsqMo3G1x0wu5HzGGRtkYJkmtb_Dw&oe=69B80E13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJTmU3Cl2P4Q7kNvwGifzuq&_nc_oc=AdnD2gd90kXvc8r_sjSkJXj6IyeF-m0_kWrnX_2nAkKgkzWSTcG_UCMvrSjsEPfftN8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy9Lz2uE0YjLI6HoE1l0TPpnqo0BX3rqtlH4Ciu8G93oA&oe=69B7EB30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxtrF_bBYkIQ7kNvwEM_ryd&_nc_oc=AdntUYVuBHvo1_-4TivlBBWXdlpbfXBpW9tJRcArDnE5rCvsf22xxC52Uh8RP_fsVVw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxbGjFBX4Pe5Q6okIUFoiHvXOgM7enjno128vQp9Gd4lg&oe=69B7E6A1"}, "is_
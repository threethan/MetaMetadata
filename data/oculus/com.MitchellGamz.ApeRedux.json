56972", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKaoTQl3a10Q7kNvwHlL4E-&_nc_oc=AdkWjWz_TtcZcFuJKJMXkMMA3E2RyoDk12ZM_gUm_X1vrK11XXPIffEbtSpQD08uI54&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxLgdyu1Fb-9EOiZG7A1Kr7ri2-ucH97axD1X2R6ySYwQ&oe=69BD4DAA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NelsznXT0uYQ7kNvwHJLLXh&_nc_oc=AdkSxcpz8Sdr_no0E2XglwHV0_V9qxe_yk_nPmdVpNg1tdXCbMnFTFP6tXBRcJECqss&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyJWCgHO5ZVepv7foRMZbqc-ENVqqheNr6_zHEoRVhevg&oe=69BD4597"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1c_o41XlBMQ7kNvwFz5dKe&_nc_oc=Adm5g4XnluPR6XtXcmV0F8zQkpUS4jutkY8rDXndGEw7Y1i_sWK95lIpaizjW00S6s8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwzKLlwGkcG5lgfDreRkT9OmCg16vv7UNBTbBjvFCdwDQ&oe=69BD5413"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTEsDgNNlcUQ7kNvwHjhytl&_nc_oc=AdkAhqvaAqTI4nJQXVGvElSgVO2_1zMG3XEhYkUs3uX4mSpZu6NyjFNUdCRI4NqBj1A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxYr4Mb9fMiCDGUVla0CFdi3VbWBWgtwKF9nhW5quj_Mg&oe=69BD3130"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h2-jj_655DoQ7kNvwHGD39h&_nc_oc=AdnhIr-85nVX7zWXqHixVvZhH_ukTp2rFB7ehik2oj50cE6bSZVrRKoIfLkd8NIesW0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1jgOgAN00S2v9zx5BuLf2AnaxUIW7oz4GZc-J7PN0dg&oe=69BD2CA1"}, "is_
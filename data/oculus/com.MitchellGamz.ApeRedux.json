me": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cMqBmVpo0csQ7kNvwFzs3Iv&_nc_oc=AdoNOu4nuh
vwHmkVY3&_nc_oc=AdrX3NO2nLClivCQa4dfHa6VYgTTBg_IyAO4XCVigedZaPlC-lC3h4GgcDQkZSPtVWU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSn9HLGO43Yn8Ah_pQFNn8QgOz5NRYKfddzxN_wMxISw&oe=6ADCCFB0"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f51L60RQLm8Q7kNvwEfxJR-&_nc_oc=Adp5-IoOCBN-WLbPUcSaqydKlrC6aHMAYz7wnuaOfiHTTuVtgW9UxZE9cQFPetJnm8k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjJYeMyP7D7HaU6BV5WcjIHEosEp0c8Ip5tLIvTQjt8Q&oe=6ADCB4AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU89idJMLhcQ7kNvwH9BZdu&_nc_oc=AdptC9Yxd3HA3jQG8f_16PiSzrDXQ4qhQR2UBdZSwE7T6fr5saSEEOXXOF7rOIZ66IE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOx8iRF6xahwy-n8Jm9VxEO19CdCzsMFnUrCaApd2yoVw&oe=6ADCAC97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-lRQ025-VwQ7kNvwENbClx&_nc_oc=AdrvWYjA1THbgXqZ6YXnfY40EBYHp2tX5sYkCa6-0cxGvaWLeGsefy_R4BbXWeyPYfM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVtk3XQt-mvWEd2QnGgX5xpDejqmSXT_OoB_MR40IjGw&oe=6ADCBB13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-V73QHy-vEQ7kNvwFNsNF9&_nc_oc=AdqPQA2RH_A2rlloQFxGa7RQWtwBjCwchwMiPN5s74EW3JZPUESvAJpSXSlWoebes50&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_MgFH53OJIjyPeZFoVEBH4eZ-fF8pLxTLG1nAmOycTg&oe=6ADCD070"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n
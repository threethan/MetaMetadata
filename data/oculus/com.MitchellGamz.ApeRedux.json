.com&_nc_ss=7f20f&oh=00_Af-bbc6RXDOQOE11HjAMOj0zxrD61RLjcjoWSXyzgzOiFg&oe=6A43E1B0"}, {"file_name": "Screenshot 2026-02-22 151929.png", "id": "1670651491056972", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EcaZzLdGsoQ7kNvwEqxviK&_nc_oc=AdqjHjUb9stDo404rApe8a85X0jNZwm9p8PEyUOG1auPrrUGi-L_fMUshnKXBQ0cSUY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H-UaHOcYGCr8UtQCj8d98amPBSB2chm5mqdu2PUwsWg&oe=6A43C6AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PnzWZl_Wa0Q7kNvwGqWpvE&_nc_oc=Adpx_-8jvoQzmIS8JMrTI_3BthPSX9mZ0-2WHnA9zysTp6zQ9ibATXGvt3qhd4C1llk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-92muZn32tsjoiVTX3GjkcxtnPqBP2xr4gcU33_EhgMA&oe=6A43BE97"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFeISTqz4B8Q7kNvwHUqSaB&_nc_oc=Adq0N0_ehdZjzXbyvVhaKj_Ryeog5DmJMv-18kRHvaktXQQ4IwZGIexAadczzGlvckI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hpWdHPrfFNKbj8srHQgUiDoqE3Z2TGxry-bGyTVrh8Q&oe=6A43CD13"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiNoGPpksUIQ7kNvwF6_01q&_nc_oc=AdqcdsjNb0Pc7E1WsY3THu9oFK5Yb-VYTumkoaorsWmTZbR3281EErwW89qb5uynBAU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VzjLn2pofQT2oIC-jrJfip0_h-3ayItFTAQQg_KjSpQ&oe=6A43E270"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YRP5L69_5EQ7kNvwG35tn9&_nc_oc=AdpOieJTwphSjsiik2v9fYWQf
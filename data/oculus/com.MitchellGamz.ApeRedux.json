56972", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619159_1670651494390305_4793452385570240485_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WyptsLtDe38Q7kNvwHnl4pO&_nc_oc=AdnYAA36WVZx3yWV8CpXEJ4z2Mk3xvyoEU7Frqnw10hC8ht30DN5cg82YgesqxU00Zc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEcJW5ZMRkJPqN3WPuFGRzo6Mvxdxw0UdqXmV5Tnw_YA&oe=69B2C1AA"}, {"file_name": "Screenshot 2026-02-22 152024.png", "id": "3839633179501229", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619646_3839633182834562_6775722930833622714_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6z-j1_qRkGAQ7kNvwHz66Zt&_nc_oc=AdlQ0-OuBD74M9CZFT2c_h4DRifvgpKTWIyAkCqn6E5Tu4qFeR_01Awoyhxs8WtEDgQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy-D_TSTBISDiaJdKXqmG06C0zVUtL0VyQf6Xr-zc6aIA&oe=69B2B997"}, {"file_name": "Screenshot 2026-02-22 152011.png", "id": "1347499317417357", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620860_1347499320750690_7813299137499363980_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSgpZbVxk1oQ7kNvwEHMiuq&_nc_oc=Adn1M4nUx6uoWJzFkYHnskdKsYLyTdLKIhdoHaN3pmGXdua1SYklPB8vyFdZ9WXq34Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyiOX8wMbOKD1KoOnjUD104Bx3knHQXfx2r2BWyXbYmxQ&oe=69B2C813"}, {"file_name": "Screenshot 2026-02-22 151939.png", "id": "3429613540539823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619174_3429613547206489_1913068315039258094_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L24OnNWiUYcQ7kNvwFppa1x&_nc_oc=Adm5_2LI1AK7Ef8hy6tV6Y4w1yNWkxnpKaco8hLndBQawq6S4x7Vhd_ZgDRRm0wEIvM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHZlgXV1ZeB-G1kECPgC_t2Zl9mSo4VfRl4Xj1Z9JZVQ&oe=69B2A530"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Redux", "keywords": [], "long_description": "Ape Redux takes cues from Lethal Ape and Starving Apes, building on their chaotic energy and tone.\nIt\u2019s a tribute to the absurd, intense worlds those games created.\n\nBig and grand environments with realistic audio force you into immersion, most objects are intractable. Giving you freedom in your experience.\n{1281249643344863}\n\nWild physics and bizarre AI behavior lead to moments that are as hilarious as they are horrifying.\nEven in the chaos, it\u2019s hard not to laugh.\n{2146649969144637}", "short_description": "Ape Redux is a two level VR game inspired by titles such as Lethal Ape, Lethal Ape Redux, and Starving Apes, delivering a horrifying yet absurdly funny experience."}]}, "developer_name": "MitchellGamz", "developer_privacy_policy_url": "https://sites.google.com/view/aperedux", "developer_terms_of_service_url": null, "publisher_name": "MitchellGamz", "support_website_url": null, "website_url": "https://sites.google.com/view/aperedux", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25963617213298787"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307418_704529395543552_8132858569300069111_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ylMkAmY0_0cQ7kNvwFr2iZ7&_nc_oc=AdnKM3ZpGMCGi2E4ACBLK3M9vhrrYhcBy3ozPmMGSuU3w7mK2yV-fSGo6tntN0IY2kM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyq1Jo_ZUdP1EtjrtPDRx-IZtp1sfLSY0EYKpG_z-9SSA&oe=69B2A0A1"}, "is_
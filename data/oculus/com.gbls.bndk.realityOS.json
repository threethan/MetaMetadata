&_nc_ohc=KwS5xOBkjS4Q7kNvwFk1V3x&_nc_oc=AdpxyA2swoL_vfcZGYMU7z1vRzXBgIpCWvx_yl0Ua9NFXWNN2-QPPoH0ucMS3P1j0qA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOoxKSm-qC4G-r9Eu01u4LldvgfJcSHGK50eIUVxrcLcQ&oe=6ACA6841"}, {"file_name": "Multitasking.png", "id": "578980975009283", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391776_578980978342616_2628125508637055265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o3rPRfzntqUQ7kNvwHkosO9&_nc_oc=AdpX2oota2gyk0BuNkuILOtVO6JVbP0oyrwjT--ycGNT4uJmKHzABUZjMW41FcumBtM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOpHzO1W98oy-N9lSY29iwPjnyx-Y8UBrJ2N9_k0yO8CA&oe=6ACA4453"}, {"file_name": "Environments.png", "id": "959572546166189", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391845_959572549499522_1912975437178358874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2yGKtOp_nAQ7kNvwHPlvqg&_nc_oc=AdrnFHMXZwfxjZAJ4myHKBygOnNxPlow3__IIN7sN4uUipxmY76n8PwzdFMoptA0iNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYBn4Iw3tz_O8jUnQi4ZzUTuf7TBiOFfaeMFPHNiCiug&oe=6ACA69C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1235182248245326", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499328676_1235182251578659_179686033054008922_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yitP2YUJ9d4Q7kNvwHrdVRA&_nc_oc=AdqnGtT2scXDer63fwB2KS2njhKhL2AdhWlGgIIvm_L70yPr2_4BZmNsFNTDxxOziXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8emd2eCxabDY7BS9_aPasqVXBmNL9iFtNdb1o1-gnug&oe=6ACA629B"}, "display_name": "The Spatial App", "keywords": ["Productivity", "Cinema", "Spatial", "Computing"], "long_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\u200e\n# **Infinite canvas**\n\nBrowse from our vast library of apps and place them wherever you want. You can also make your own custom app and use them as well.\n{1619285508954396}\n\n\n\u200e \n# **Cinema mode**\n\nOur immersive ambient lighting makes revisiting your favorite movies even more special.\n\nWe support Disney+, MAX, Apple TV+, Prime Video, Plex, Youtube, and other services like Hulu or Paramount+ as custom apps made by you.\n{1168371881663725}\n*Netflix is not supported on third party Meta Quest browsers, including The Spatial App\n\n\u200e \n# **Productivity**\n\nCast your computer to a large virtual monitor. Place our Widgets like a timer, sticky note, calculator, or a simple clock next to it for full productivity.\n{575417312208587}\n\n\n\u200e \n# **Environments**\n\nCancel out distractions with our stunning environments. Go to the Stratosphere, Deep space, or chill in an ambient void.\n{1148492843725258}\n\n\n\u200e \n# **Polished UI**\n\nWe have the best look and feel among all third party browsers on the Meta Quest store.\n{1183342316489244}\n\n\n\u200e \n# **Intuitive UX**\n\nYou can use The Spatial App with either controller or your hands, form up close, or from a far. You can turn off tracking when interacting with the real world.\n{683133417383739}", "short_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\nSome of our most loved features include Multitasking, Immersive cinema mode, Widgets... and our attention to detail unlike any other VR browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thespatial.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Spatial Company", "support_website_url": null, "website_url": "https://www.thespatial.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "10635849107667
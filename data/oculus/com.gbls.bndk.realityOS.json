SGiULJu_5VHKw&oe=6B0724E9"}, {"file_name": "Cinema mode.png", "id": "1235714004183096", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391713_1235714007516429_6995113886859378751_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E25pgcLLuI8Q7kNvwFWNYBw&_nc_oc=AdqcjQpuVoDBWDaY7zfjiKD-XQ3jBHoQRcM7mScyoWeBdpWCqkJTh1eeR_AHcSXapts&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIaAxapeIHH6xYQkILli4GeYVXQem9HJcDXXKMBkTaig&oe=6B070D41"}, {"file_name": "Multitasking.png", "id": "578980975009283", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391776_578980978342616_2628125508637055265_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkL7yRykgAUQ7kNvwGXahxr&_nc_oc=AdoBaS7959-Jfn8RK4DCVwz62aRllMoc2FcGPq9Tge9PqdO8keDlS-s1qx8Ii9rZIF0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSDLQX8deoxmlN7ney6UaMrAzU7kRWFQwb-OUGtqymMg&oe=6B072193"}, {"file_name": "Environments.png", "id": "959572546166189", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391845_959572549499522_1912975437178358874_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBPAj0sCJxgQ7kNvwHlbm1g&_nc_oc=AdoGnW6lolLUCsmAjKOqp85RbCdiPdDVriW_fcJkqw1DESwJxxv7KtBBCR9hTp_fLz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTupeDMZKIbAv_NSsmKECKuSDpN_wj4Ld9-iSzeIGKJ1Q&oe=6B070EC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1235182248245326", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499328676_1235182251578659_179686033054008922_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFTQr6bBoXIQ7kNvwFRZ_fT&_nc_oc=AdrHJ2cD3wmU7ZA7_gCCoBGZUQumIQ1Z-rz09MjSx574dprhuUWiL_80CFhyCdER6ys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVbqeV2LAH3tcTTFJ3lrovkhgBES0pHQJUS99phTjcbg&oe=6B07079B"}, "display_name": "The Spatial App", "keywords": ["Productivity", "Cinema", "Spatial", "Computing"], "long_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\u200e\n# **Infinite canvas**\n\nBrowse from our vast library of apps and place them wherever you want. You can also make your own custom app and use them as well.\n{1619285508954396}\n\n\n\u200e \n# **Cinema mode**\n\nOur immersive ambient lighting makes revisiting your favorite movies even more special.\n\nWe support Disney+, MAX, Apple TV+, Prime Video, Plex, Youtube, and other services like Hulu or Paramount+ as custom apps made by you.\n{1168371881663725}\n*Netflix is not supported on third party Meta Quest browsers, including The Spatial App\n\n\u200e \n# **Productivity**\n\nCast your computer to a large virtual monitor. Place our Widgets like a timer, sticky note, calculator, or a simple clock next to it for full productivity.\n{575417312208587}\n\n\n\u200e \n# **Environments**\n\nCancel out distractions with our stunning environments. Go to the Stratosphere, Deep space, or chill in an ambient void.\n{1148492843725258}\n\n\n\u200e \n# **Polished UI**\n\nWe have the best look and feel among all third party browsers on the Meta Quest store.\n{1183342316489244}\n\n\n\u200e \n# **Intuitive UX**\n\nYou can use The Spatial App with either controller or your hands, form up close, or from a far. You can turn off tracking when interacting with the real world.\n{683133417383739}", "short_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\nSome of our most loved features include Multitasking, Immersive cinema mode, Widgets... and our attention to detail unlike any other VR browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thespatial.app/privacy-policy", "developer_te
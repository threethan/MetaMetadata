&_nc_ohc=XrFLQrno34IQ7kNvwHUn_bz&_nc_oc=AdppSzz_USJHZDcMPgrS6g7v5dwlgp6o1JwXFwvKAtzTe5WmBsUXuGgLb66zYu__arU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdGz3AlQ1nelp3atkWHL-W1SYzBp9KIZKxlAVA2YVcAw&oe=6A58CF01"}, {"file_name": "Multitasking.png", "id": "578980975009283", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/473391776_578980978342616_2628125508637055265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEMN-oeQK7IQ7kNvwGsz8aA&_nc_oc=AdqyTt8Fssbh488ltexfcQRHv6nNZM_iwTjGQidjCv7AHMnGSSq2TqgCvS0t59WeBSA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZXPxVDt-AzGN_6HbFMeg6nZ1uhCUqPLo_D9YVPYxsKA&oe=6A58E353"}, {"file_name": "Environments.png", "id": "959572546166189", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391845_959572549499522_1912975437178358874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DuNSV0iIlsQ7kNvwGmwi2v&_nc_oc=AdqOggftBFX5tLg5tWlvAUlWPF4X-PfzSMql1bm6m41vRneLCj0TlUp2XUa3Mo_rmIY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjXgDyCrJ0cKgZXaIjNPPv676sPjPPbHzaciMfs88Zvw&oe=6A58D084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1235182248245326", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499328676_1235182251578659_179686033054008922_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQ8eiP_zN8sQ7kNvwEQyoE8&_nc_oc=Adrr_P9sJRpd9G63PxIDrnxc9n9uKrrSjDGOttv0BaH57b1gWqvtc68LEGiW_2OZPas&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgPS7D7C0qeVybVWDlAoiXiNNSko_w0efpyb7g4MK-9Q&oe=6A58C95B"}, "display_name": "The Spatial App", "keywords": ["Productivity", "Cinema", "Spatial", "Computing"], "long_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\u200e\n# **Infinite canvas**\n\nBrowse from our vast library of apps and place them wherever you want. You can also make your own custom app and use them as well.\n{1619285508954396}\n\n\n\u200e \n# **Cinema mode**\n\nOur immersive ambient lighting makes revisiting your favorite movies even more special.\n\nWe support Disney+, MAX, Apple TV+, Prime Video, Plex, Youtube, and other services like Hulu or Paramount+ as custom apps made by you.\n{1168371881663725}\n*Netflix is not supported on third party Meta Quest browsers, including The Spatial App\n\n\u200e \n# **Productivity**\n\nCast your computer to a large virtual monitor. Place our Widgets like a timer, sticky note, calculator, or a simple clock next to it for full productivity.\n{575417312208587}\n\n\n\u200e \n# **Environments**\n\nCancel out distractions with our stunning environments. Go to the Stratosphere, Deep space, or chill in an ambient void.\n{1148492843725258}\n\n\n\u200e \n# **Polished UI**\n\nWe have the best look and feel among all third party browsers on the Meta Quest store.\n{1183342316489244}\n\n\n\u200e \n# **Intuitive UX**\n\nYou can use The Spatial App with either controller or your hands, form up close, or from a far. You can turn off tracking when interacting with the real world.\n{683133417383739}", "short_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\nSome of our most loved features include Multitasking, Immersive cinema mode, Widgets... and our attention to detail unlike any other VR browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thespatial.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Spatial Company", "support_website_url": null, "website_url": "https://www.thespatial.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "10635849107667
&_nc_ohc=5dNiqOeROAgQ7kNvwHyNd2y&_nc_oc=Adp7tnrLYLtvfM3ip1mWlsHjTEFrV2O2S17nLHScNkU4Oi03IJEBKti5JOHSC-UFjbo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxgx9jxCcCEL2ZuJ3MGY-8u94shpn2BheHPmHaagbsfQ&oe=6AE617C1"}, {"file_name": "Multitasking.png", "id": "578980975009283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391776_578980978342616_2628125508637055265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XddgZAN6lbcQ7kNvwGJu5Az&_nc_oc=Ado_Bh0Y5tI_RNEBXlQFopuqfQeI3v7XtvC7hRK6k5WIMzJftUbHu3ZmVxdWG4mycWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMY2eDHQWgKZeTDqK81ZsH-ZpzxTyawf-8FTBIMOGpYsA&oe=6AE5F3D3"}, {"file_name": "Environments.png", "id": "959572546166189", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391845_959572549499522_1912975437178358874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DcueBj8PwwgQ7kNvwE2-tXE&_nc_oc=Adrd0tJ0kJ-LJf1Lyw86AX92W3GtXKHj6J7VEIcWLdaxQY_BKjnGFhULJCVAecTAjT0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODmE_eMdjVJxA99PgBpwbBbVwNXIxvza6FTU9VcNaIrg&oe=6AE5E104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1235182248245326", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499328676_1235182251578659_179686033054008922_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iA-L-F3YaLkQ7kNvwH7Iyy-&_nc_oc=AdrvnLSNGqUVUVEWajt4SmRiDuxYvX1CB61Y_BSxR36kLfPQR0AAfUs_AdbxsoEoGCs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPakYUwWT5iK-Uwbm0wWJ-X3ZK42Wwm15HFrsTRVkqBpQ&oe=6AE6121B"}, "display_name": "The Spatial App", "keywords": ["Productivity", "Cinema", "Spatial", "Computing"], "long_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\u200e\n# **Infinite canvas**\n\nBrowse from our vast library of apps and place them wherever you want. You can also make your own custom app and use them as well.\n{1619285508954396}\n\n\n\u200e \n# **Cinema mode**\n\nOur immersive ambient lighting makes revisiting your favorite movies even more special.\n\nWe support Disney+, MAX, Apple TV+, Prime Video, Plex, Youtube, and other services like Hulu or Paramount+ as custom apps made by you.\n{1168371881663725}\n*Netflix is not supported on third party Meta Quest browsers, including The Spatial App\n\n\u200e \n# **Productivity**\n\nCast your computer to a large virtual monitor. Place our Widgets like a timer, sticky note, calculator, or a simple clock next to it for full productivity.\n{575417312208587}\n\n\n\u200e \n# **Environments**\n\nCancel out distractions with our stunning environments. Go to the Stratosphere, Deep space, or chill in an ambient void.\n{1148492843725258}\n\n\n\u200e \n# **Polished UI**\n\nWe have the best look and feel among all third party browsers on the Meta Quest store.\n{1183342316489244}\n\n\n\u200e \n# **Intuitive UX**\n\nYou can use The Spatial App with either controller or your hands, form up close, or from a far. You can turn off tracking when interacting with the real world.\n{683133417383739}", "short_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\nSome of our most loved features include Multitasking, Immersive cinema mode, Widgets... and our attention to detail unlike any other VR browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thespatial.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Spatial Company", "support_website_url": null, "website_url": "https://www.thespatial.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "10635849107667
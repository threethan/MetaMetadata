ZUi-I5uBogk3A&oe=6B0481E9"}, {"file_name": "Cinema mode.png", "id": "1235714004183096", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391713_1235714007516429_6995113886859378751_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E25pgcLLuI8Q7kNvwHjhS9s&_nc_oc=Adp-XH-fiQQtltaqXz5NK1kFwWj87SyzSpdP6j0vdsXw6isRdozNwvV1WyWh3PumZD0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjL6er4OTafZ2Kq19-WrVoISN2pdtaO-au6hDE2pntjQ&oe=6B046A41"}, {"file_name": "Multitasking.png", "id": "578980975009283", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391776_578980978342616_2628125508637055265_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OkL7yRykgAUQ7kNvwG_105Y&_nc_oc=AdqFJmn-3jHFPGXusd8wHFQM8FZW3aVo-M9QbmFbthjwCilwTbnzZjp6TQab9vnGCsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaDMigZjtutRwGSmK_jXzlaeFbAmh3_dt-iKmWCS3wiA&oe=6B047E93"}, {"file_name": "Environments.png", "id": "959572546166189", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391845_959572549499522_1912975437178358874_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCc8sj188bAQ7kNvwHRNWkd&_nc_oc=AdpMKTQSeUb8dVbKpIW2jjKb2bUtWxURVX9oWHOxzds7KzpogPYyHp-5vBLhU_VNmVc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8UHvzfwg6F-i0oS0DNQB56VadF20e-GewNo4CZsn7NA&oe=6B046BC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1235182248245326", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499328676_1235182251578659_179686033054008922_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eaj1_SIrCKAQ7kNvwFDSYeu&_nc_oc=AdrQB9c9ui8eoIIJwjQDl3vRMuIaLR1DGExZ2XVlQcBPDCA2ZC340x5-SNP5mNeqCro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJ1PcsyNiIJjseKB5mjOXfptJjlJE8E0nUWOK9l-HmwQ&oe=6B04649B"}, "display_name": "The Spatial App", "keywords": ["Productivity", "Cinema", "Spatial", "Computing"], "long_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\u200e\n# **Infinite canvas**\n\nBrowse from our vast library of apps and place them wherever you want. You can also make your own custom app and use them as well.\n{1619285508954396}\n\n\n\u200e \n# **Cinema mode**\n\nOur immersive ambient lighting makes revisiting your favorite movies even more special.\n\nWe support Disney+, MAX, Apple TV+, Prime Video, Plex, Youtube, and other services like Hulu or Paramount+ as custom apps made by you.\n{1168371881663725}\n*Netflix is not supported on third party Meta Quest browsers, including The Spatial App\n\n\u200e \n# **Productivity**\n\nCast your computer to a large virtual monitor. Place our Widgets like a timer, sticky note, calculator, or a simple clock next to it for full productivity.\n{575417312208587}\n\n\n\u200e \n# **Environments**\n\nCancel out distractions with our stunning environments. Go to the Stratosphere, Deep space, or chill in an ambient void.\n{1148492843725258}\n\n\n\u200e \n# **Polished UI**\n\nWe have the best look and feel among all third party browsers on the Meta Quest store.\n{1183342316489244}\n\n\n\u200e \n# **Intuitive UX**\n\nYou can use The Spatial App with either controller or your hands, form up close, or from a far. You can turn off tracking when interacting with the real world.\n{683133417383739}", "short_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\nSome of our most loved features include Multitasking, Immersive cinema mode, Widgets... and our attention to detail unlike any other VR browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thespatial.app/privacy-policy", "developer_te
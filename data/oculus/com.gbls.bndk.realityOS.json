jDzJXNpdVsxjg&oe=6AFC60A9"}, {"file_name": "Cinema mode.png", "id": "1235714004183096", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391713_1235714007516429_6995113886859378751_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDKBENcKTLcQ7kNvwFPEPsr&_nc_oc=AdrVBzrvv2fHifli9K2S0myx06eI1J11KmQ06lmmLHvZpQPLamTuKpkv3N5YJ3lqa1A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgmsraUoNrkQIHfvv06XA4jZzRw_g1rcfGJnu1hWEe1w&oe=6AFC8141"}, {"file_name": "Multitasking.png", "id": "578980975009283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391776_578980978342616_2628125508637055265_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZ_d6Dn6CBoQ7kNvwHjFUFl&_nc_oc=Adp-VwVRRFzJ-7JeFknE_eT8X4R3GjWHRPYIt09mMrdIoc0ahbhrKUnEgm8wLx0C0cI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm0qZ6-qfJVr6_bzG0A5ZO5ZY9d1R89M6Qfbtg55mcAw&oe=6AFC9593"}, {"file_name": "Environments.png", "id": "959572546166189", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391845_959572549499522_1912975437178358874_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Isg3kfBDQ1kQ7kNvwF0gi94&_nc_oc=Adq-hy1lM79M-4u6c4avc4j5XeJ-aomRlkXv7RYHv72JlHkP9fezf8y3Qe2zJkMyFUg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1LwQavDyjCnK4oY_nMcy0A_P8JJY3gLbTytZ6t8TkRg&oe=6AFC82C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1235182248245326", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499328676_1235182251578659_179686033054008922_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQSwmbsep_IQ7kNvwGG83Rk&_nc_oc=Adr_nZVWZOjTWcsmzOoPhKwT4-hQz5eYz9LtT5LuhmkW89c1gBHvO0fkaRbFR3bDUAw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaPaislg7YCop1g0Q6yKCFmN1PE332arIGVhjoql2DLw&oe=6AFC7B9B"}, "display_name": "The Spatial App", "keywords": ["Productivity", "Cinema", "Spatial", "Computing"], "long_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\u200e\n# **Infinite canvas**\n\nBrowse from our vast library of apps and place them wherever you want. You can also make your own custom app and use them as well.\n{1619285508954396}\n\n\n\u200e \n# **Cinema mode**\n\nOur immersive ambient lighting makes revisiting your favorite movies even more special.\n\nWe support Disney+, MAX, Apple TV+, Prime Video, Plex, Youtube, and other services like Hulu or Paramount+ as custom apps made by you.\n{1168371881663725}\n*Netflix is not supported on third party Meta Quest browsers, including The Spatial App\n\n\u200e \n# **Productivity**\n\nCast your computer to a large virtual monitor. Place our Widgets like a timer, sticky note, calculator, or a simple clock next to it for full productivity.\n{575417312208587}\n\n\n\u200e \n# **Environments**\n\nCancel out distractions with our stunning environments. Go to the Stratosphere, Deep space, or chill in an ambient void.\n{1148492843725258}\n\n\n\u200e \n# **Polished UI**\n\nWe have the best look and feel among all third party browsers on the Meta Quest store.\n{1183342316489244}\n\n\n\u200e \n# **Intuitive UX**\n\nYou can use The Spatial App with either controller or your hands, form up close, or from a far. You can turn off tracking when interacting with the real world.\n{683133417383739}", "short_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\nSome of our most loved features include Multitasking, Immersive cinema mode, Widgets... and our attention to detail unlike any other VR browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thespatial.app/privacy-policy", "developer_te
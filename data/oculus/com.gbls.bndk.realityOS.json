Pfzl5mUTJ6_hA&oe=6B09C7E9"}, {"file_name": "Cinema mode.png", "id": "1235714004183096", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/473391713_1235714007516429_6995113886859378751_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9u7GVzDC6QkQ7kNvwHF06Wn&_nc_oc=Adr3Hq5FJ9YciOVt4G54zjqGGg3MLBcHLFsrD7gjHIh0Oekq0jZZ5xI1J7lW1fzITcQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCoLiysqGWnXBUKPdi4OBa-kvxVSQoWUarqEibVL7_-w&oe=6B09B041"}, {"file_name": "Multitasking.png", "id": "578980975009283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391776_578980978342616_2628125508637055265_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d__BMsB7A9oQ7kNvwEmtdtW&_nc_oc=AdryqfkEalEuw94Z1cdnI8949IvxeqNs_qtAD8TEeOM05fdH-O-md6DnYgpi6ZymN-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5uOL98RE5UASFfJt17xY3q3pL3wfw6soZgb4eRcAsjg&oe=6B09C493"}, {"file_name": "Environments.png", "id": "959572546166189", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391845_959572549499522_1912975437178358874_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBPAj0sCJxgQ7kNvwELdy7i&_nc_oc=Adq4EE1L0ol0JYRRcVmq4e5rQqIeSWb-15zarejgBnWvOCVVdliWggkIKy3rbszgLfw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3tpvthQtb9lCtF9jyRqoRAuE96KMYMvlU5zA5mBj4Qg&oe=6B09B1C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1235182248245326", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499328676_1235182251578659_179686033054008922_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bow-CnToTMQQ7kNvwHIjIsv&_nc_oc=AdrcSsTKbMLX9Wd5_AEsRdrGu3wAB3VCq0kCf_EUac1Cf2-fZoN5vc5rEuscDV6RnDQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuM3HBLDgYvWw7sX3IbepDZZZGGp-2QwKN0eOoj05yjg&oe=6B09AA9B"}, "display_name": "The Spatial App", "keywords": ["Productivity", "Cinema", "Spatial", "Computing"], "long_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\u200e\n# **Infinite canvas**\n\nBrowse from our vast library of apps and place them wherever you want. You can also make your own custom app and use them as well.\n{1619285508954396}\n\n\n\u200e \n# **Cinema mode**\n\nOur immersive ambient lighting makes revisiting your favorite movies even more special.\n\nWe support Disney+, MAX, Apple TV+, Prime Video, Plex, Youtube, and other services like Hulu or Paramount+ as custom apps made by you.\n{1168371881663725}\n*Netflix is not supported on third party Meta Quest browsers, including The Spatial App\n\n\u200e \n# **Productivity**\n\nCast your computer to a large virtual monitor. Place our Widgets like a timer, sticky note, calculator, or a simple clock next to it for full productivity.\n{575417312208587}\n\n\n\u200e \n# **Environments**\n\nCancel out distractions with our stunning environments. Go to the Stratosphere, Deep space, or chill in an ambient void.\n{1148492843725258}\n\n\n\u200e \n# **Polished UI**\n\nWe have the best look and feel among all third party browsers on the Meta Quest store.\n{1183342316489244}\n\n\n\u200e \n# **Intuitive UX**\n\nYou can use The Spatial App with either controller or your hands, form up close, or from a far. You can turn off tracking when interacting with the real world.\n{683133417383739}", "short_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\nSome of our most loved features include Multitasking, Immersive cinema mode, Widgets... and our attention to detail unlike any other VR browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thespatial.app/privacy-policy", "developer_te
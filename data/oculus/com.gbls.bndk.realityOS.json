&_nc_ohc=0qOEo-4GRv8Q7kNvwHsa6WF&_nc_oc=Adqo2M5FQAG7dfh9nOqDaKVZpt6v6FPkyIKRoFHqZV73lRX5T-uibbR5wH90RjERyIo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzri0FRu28Ltsl9lI47B29IMyN1waapyXFDsTWZtxAdg&oe=6A973601"}, {"file_name": "Multitasking.png", "id": "578980975009283", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391776_578980978342616_2628125508637055265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEuDgN-jv48Q7kNvwFCojvN&_nc_oc=AdomcT6zqKuMzEUNjrwAoxe8MpTb9CPqE-4rAkdZ4UgiE3yhNXJAVtzTdlxChUmLvGw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk6EvTxSd26jxJr9uEW8QE0mlHijOCoigj_8F-62RNNA&oe=6A974A53"}, {"file_name": "Environments.png", "id": "959572546166189", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391845_959572549499522_1912975437178358874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WkG-i9KjnsQ7kNvwHf6I33&_nc_oc=Adocd4tFB1IPenPEsSBBsfgM_RIttL-Sy-S6mTtlhQQRHi3ky57irxQ5wMot3JByaVI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtKCg3f2LJMVaEQy9SAwb6qw2hNZhhLIDXmf-JimufgQ&oe=6A973784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1235182248245326", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499328676_1235182251578659_179686033054008922_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu88LQdb934Q7kNvwFXRUvu&_nc_oc=AdoMDMNQZ126zlC03aXo4zSsS-exz8-xHsWrsbnuNxLM2zDghSO_PkyDOWl0s27bino&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH27O6PFvjRxlApQKng37MPAQRjkbD9TOEfwxuuTcFI6w&oe=6A97305B"}, "display_name": "The Spatial App", "keywords": ["Productivity", "Cinema", "Spatial", "Computing"], "long_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\u200e\n# **Infinite canvas**\n\nBrowse from our vast library of apps and place them wherever you want. You can also make your own custom app and use them as well.\n{1619285508954396}\n\n\n\u200e \n# **Cinema mode**\n\nOur immersive ambient lighting makes revisiting your favorite movies even more special.\n\nWe support Disney+, MAX, Apple TV+, Prime Video, Plex, Youtube, and other services like Hulu or Paramount+ as custom apps made by you.\n{1168371881663725}\n*Netflix is not supported on third party Meta Quest browsers, including The Spatial App\n\n\u200e \n# **Productivity**\n\nCast your computer to a large virtual monitor. Place our Widgets like a timer, sticky note, calculator, or a simple clock next to it for full productivity.\n{575417312208587}\n\n\n\u200e \n# **Environments**\n\nCancel out distractions with our stunning environments. Go to the Stratosphere, Deep space, or chill in an ambient void.\n{1148492843725258}\n\n\n\u200e \n# **Polished UI**\n\nWe have the best look and feel among all third party browsers on the Meta Quest store.\n{1183342316489244}\n\n\n\u200e \n# **Intuitive UX**\n\nYou can use The Spatial App with either controller or your hands, form up close, or from a far. You can turn off tracking when interacting with the real world.\n{683133417383739}", "short_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\nSome of our most loved features include Multitasking, Immersive cinema mode, Widgets... and our attention to detail unlike any other VR browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thespatial.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Spatial Company", "support_website_url": null, "website_url": "https://www.thespatial.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "10635849107667
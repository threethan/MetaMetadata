&_nc_ohc=jMqBhXurD4YQ7kNvwF3CbKO&_nc_oc=AdqYHpN6ddHBmpUVmwQCGtiAlAvOuYWmTVcO5sDpgAQGAO1Aim9z0dtTLaEw9NLNgFY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FlqZ3WOnrNjy16uPGYVOFkhpgl9CQpeDlWCr3HJxxaQ&oe=6A09B501"}, {"file_name": "Multitasking.png", "id": "578980975009283", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/473391776_578980978342616_2628125508637055265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0RmelvAlTAQ7kNvwHBguOr&_nc_oc=Adrn2oldja8xEUloUYmd3tpdbSjylKfmLX32luxYLhVNrkIs2FCEZR0ZxxYCgH8Gytk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aeP2I5j4a0PZwIbJNXzboCvSDohH0IT8MC9BTUM2PSg&oe=6A09C953"}, {"file_name": "Environments.png", "id": "959572546166189", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391845_959572549499522_1912975437178358874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4N0A13HJFCwQ7kNvwHOpqcf&_nc_oc=Adpkq87-jUICLmBb55YBY3Kd1xBpyqrjz_bxZ-z2H-g-JX9myRTmV3g8E7poqwUf29w&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eCd17TwidVEhCARBo_BUuy6Ipg_JQyrI0H-4po0GjxA&oe=6A09B684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1235182248245326", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499328676_1235182251578659_179686033054008922_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZmwnrOBXHIQ7kNvwGESj2z&_nc_oc=AdpnKJLauKW6e4DxxTaXc3rKyZbWcgcaCJ7geG501m4zOStTsaZJvLCD_69faUJm6tE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7janzDw98YOC0yD50hkLkj2eywwWuNWJ-3ibD8BptmnQ&oe=6A09AF5B"}, "display_name": "The Spatial App", "keywords": ["Productivity", "Cinema", "Spatial", "Computing"], "long_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\u200e\n# **Infinite canvas**\n\nBrowse from our vast library of apps and place them wherever you want. You can also make your own custom app and use them as well.\n{1619285508954396}\n\n\n\u200e \n# **Cinema mode**\n\nOur immersive ambient lighting makes revisiting your favorite movies even more special.\n\nWe support Disney+, MAX, Apple TV+, Prime Video, Plex, Youtube, and other services like Hulu or Paramount+ as custom apps made by you.\n{1168371881663725}\n*Netflix is not supported on third party Meta Quest browsers, including The Spatial App\n\n\u200e \n# **Productivity**\n\nCast your computer to a large virtual monitor. Place our Widgets like a timer, sticky note, calculator, or a simple clock next to it for full productivity.\n{575417312208587}\n\n\n\u200e \n# **Environments**\n\nCancel out distractions with our stunning environments. Go to the Stratosphere, Deep space, or chill in an ambient void.\n{1148492843725258}\n\n\n\u200e \n# **Polished UI**\n\nWe have the best look and feel among all third party browsers on the Meta Quest store.\n{1183342316489244}\n\n\n\u200e \n# **Intuitive UX**\n\nYou can use The Spatial App with either controller or your hands, form up close, or from a far. You can turn off tracking when interacting with the real world.\n{683133417383739}", "short_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\nSome of our most loved features include Multitasking, Immersive cinema mode, Widgets... and our attention to detail unlike any other VR browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thespatial.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Spatial Company", "support_website_url": null, "website_url": "https://www.thespatial.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "10635849107667
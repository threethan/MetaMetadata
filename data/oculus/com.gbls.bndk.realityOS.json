_oc=Adn2vnuxjCrTt-APJm_vhSviLmDnwkkGnjkm5-cILaYNcIVUikzGu4n1nh-j4Pfs3Jo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnzBNphKaxwLZh_tH02OP9wkjJwuhjClT7ZmD8OZoWsA&oe=69B16081"}, {"file_name": "Multitasking.png", "id": "578980975009283", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391776_578980978342616_2628125508637055265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lHiHX4eZXeQQ7kNvwH0gDIP&_nc_oc=AdkNnDguY-v8DRULaOHMjZWaNQ22ULCcsRnMteg5PauxJ4fr8faU4ylg0UHLTAxEYQc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEjVwzaXGabX1y4rWnuMjOjnHEsezgLmzoaHIu8gHHfA&oe=69B174D3"}, {"file_name": "Environments.png", "id": "959572546166189", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391845_959572549499522_1912975437178358874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4859gz3DHHAQ7kNvwGU6o5Q&_nc_oc=AdnnUo2HTtEbZq-R9KLCmCFFCoxQcmzVJMX-Gm5zXe78Cz9IINB6XqpYq9x61HEkPA0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXL5nCQVrTuPSkvn5eI9nsXWCjE5Md5LUBuCZSmTCs-w&oe=69B16204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1235182248245326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499328676_1235182251578659_179686033054008922_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zNP7y5lHTwAQ7kNvwGyv_HE&_nc_oc=AdmbB7sFFARfEHFxV_u8pQwwYp8UQR8kWkJ3HBPHOtmGFqbb6vifcF0VyGuJcFMDe60&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0ZUjwr85-YrIU2i5VhRUbVnool9T6pBzDSdP189Mrjw&oe=69B15ADB"}, "display_name": "The Spatial App", "keywords": ["Productivity", "Cinema", "Spatial", "Computing"], "long_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\u200e\n# **Infinite canvas**\n\nBrowse from our vast library of apps and place them wherever you want. You can also make your own custom app and use them as well.\n{1619285508954396}\n\n\n\u200e \n# **Cinema mode**\n\nOur immersive ambient lighting makes revisiting your favorite movies even more special.\n\nWe support Disney+, MAX, Apple TV+, Prime Video, Plex, Youtube, and other services like Hulu or Paramount+ as custom apps made by you.\n{1168371881663725}\n*Netflix is not supported on third party Meta Quest browsers, including The Spatial App\n\n\u200e \n# **Productivity**\n\nCast your computer to a large virtual monitor. Place our Widgets like a timer, sticky note, calculator, or a simple clock next to it for full productivity.\n{575417312208587}\n\n\n\u200e \n# **Environments**\n\nCancel out distractions with our stunning environments. Go to the Stratosphere, Deep space, or chill in an ambient void.\n{1148492843725258}\n\n\n\u200e \n# **Polished UI**\n\nWe have the best look and feel among all third party browsers on the Meta Quest store.\n{1183342316489244}\n\n\n\u200e \n# **Intuitive UX**\n\nYou can use The Spatial App with either controller or your hands, form up close, or from a far. You can turn off tracking when interacting with the real world.\n{683133417383739}", "short_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\nSome of our most loved features include Multitasking, Immersive cinema mode, Widgets... and our attention to detail unlike any other VR browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thespatial.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Spatial Company", "support_website_url": null, "website_url": "https://www.thespatial.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "434961926215971"}, {"id": "39322247850
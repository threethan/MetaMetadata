&_nc_ohc=zJxbR50knu4Q7kNvwG038Cz&_nc_oc=Adrl3h-R0HVtZuZ39bNbEL-aD6mn8_cWPe4IrsSZYT-0AZ6t7MzHxptIPlxgiby2ek8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zUD0Pnxn8nDuDwEt_XshWSzCrlgTiAgZFAGKxAx8EHQ&oe=6A341D41"}, {"file_name": "Multitasking.png", "id": "578980975009283", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391776_578980978342616_2628125508637055265_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUeFKj49nKYQ7kNvwGsx4Us&_nc_oc=Adob7TntenZCXX5dnu1itH83qa-S0LW_pMRwGPmgrRrG72PMQj6yzArYprbDzFt5zA0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2c5FI5UWvlvk5O8AY1B4vdJqDeWXNrir5L1ORSAlb7g&oe=6A33F953"}, {"file_name": "Environments.png", "id": "959572546166189", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391845_959572549499522_1912975437178358874_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tn5LTeLnmC0Q7kNvwG4cQOp&_nc_oc=AdrQRoYpi28fA9-iJ7IY0G8zuhFs24UgcsaN6or49w7BSzlJub1W9JBYo5zXFu67OHQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u8aR3MTq7zVWzMsWm5R9LQFu-MRL3P7hGS-Ovs1oWmA&oe=6A341EC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1235182248245326", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499328676_1235182251578659_179686033054008922_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Los8o_4qw4Q7kNvwGWgI54&_nc_oc=AdpM5mkBxOIlEsj1e4JYRIRyB7STtV_b_XRfMkk6UUb5wRHaqQqhHiIPFCv5tbPNEOM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IE7RGmc2pPmAHCXIPMOfVj0qlw9zoiljfr7r5PhEkcQ&oe=6A34179B"}, "display_name": "The Spatial App", "keywords": ["Productivity", "Cinema", "Spatial", "Computing"], "long_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\u200e\n# **Infinite canvas**\n\nBrowse from our vast library of apps and place them wherever you want. You can also make your own custom app and use them as well.\n{1619285508954396}\n\n\n\u200e \n# **Cinema mode**\n\nOur immersive ambient lighting makes revisiting your favorite movies even more special.\n\nWe support Disney+, MAX, Apple TV+, Prime Video, Plex, Youtube, and other services like Hulu or Paramount+ as custom apps made by you.\n{1168371881663725}\n*Netflix is not supported on third party Meta Quest browsers, including The Spatial App\n\n\u200e \n# **Productivity**\n\nCast your computer to a large virtual monitor. Place our Widgets like a timer, sticky note, calculator, or a simple clock next to it for full productivity.\n{575417312208587}\n\n\n\u200e \n# **Environments**\n\nCancel out distractions with our stunning environments. Go to the Stratosphere, Deep space, or chill in an ambient void.\n{1148492843725258}\n\n\n\u200e \n# **Polished UI**\n\nWe have the best look and feel among all third party browsers on the Meta Quest store.\n{1183342316489244}\n\n\n\u200e \n# **Intuitive UX**\n\nYou can use The Spatial App with either controller or your hands, form up close, or from a far. You can turn off tracking when interacting with the real world.\n{683133417383739}", "short_description": "Turning your Meta Quest into a spatial computer by letting you place your web apps all around your space. You have an infinite canvas to browse, work, relax, or watch a movie.\n\nSome of our most loved features include Multitasking, Immersive cinema mode, Widgets... and our attention to detail unlike any other VR browser."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.thespatial.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "The Spatial Company", "support_website_url": null, "website_url": "https://www.thespatial.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "10635849107667
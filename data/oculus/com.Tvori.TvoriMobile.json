-7&_nc_sid=6e7a0a&_nc_ohc=BksLHtvZTdQQ7kNvwG8UW6M&_nc_oc=Ado4T1feTb0XbwP2UU_eWggsiqdSGXCFLdR0UofpXtGeQd_BbOIeudyxjzQZ2JxILv8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwNX3FCZu2TASLgXSis8wp2Y0OUyG1D-SYLKNQelPRRTQ&oe=69C53584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "216671373458668", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39001675_216671376792001_5001614293237078003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XAJdKFIW4GkQ7kNvwEzduKf&_nc_oc=AdpFRlfH5j0z7OyGZiY5PGBhmUA25O1FwUWZBVOYGlbXxvXDzvIKWGfddfGUisqsuoI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzudXp0VFGxf54hrTQiJdNDJPjSAClQALhwfLd7Ng1xbA&oe=69C51897"}, "display_name": "Tvori", "keywords": [], "long_description": "Tvori is a VR design tool for spatial experiences. With the term spatial experiences, we refer to VR and AR applications (from gaming and entertainment to productivity and training) as well as real-world products and services where space and user flows are crucial (e.g. the check-in process at the airport, design for smart home features, etc). Nowadays designers, product owners, and customers/users gather around the table to ideate and share a common vision by sketching storyboards, creating cardboards prototypes, and embodying the whole experience to come up with a vision and test hypothesis before developers or engineers resources are involved in the process. That is what Tvori is about\u2026 but without the limitations of the physical world.\nIn Tvori you can pick a premade scene as a canvas for your creation (a house, a shop floor, an autonomous car) or start from scratch and build the lobby of a VR fitness game. Designers can introduce and manipulate simple shapes at scale, change color", "short_description": "Tvori makes collaboration smooth & easy to prototype interfaces, products, and design amazing experiences for XR, and the real world"}]}, "developer_name": null, "devel
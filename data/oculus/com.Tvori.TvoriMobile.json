-7&_nc_sid=6e7a0a&_nc_ohc=SZggYsSJj68Q7kNvwHo50NO&_nc_oc=AdrrY5OAMcALQI62wcZ2BE6KPll_H0ZMvPFb-MHCvQ4jrvRRW3qSpE5bh5Y7ufs_hE0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz57EJFG0mRykj17qw9cX0i9M_qf-7cb73tDVyKgPmBnA&oe=69CFC184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "216671373458668", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001675_216671376792001_5001614293237078003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGE6fqsV1hwQ7kNvwGw-uH-&_nc_oc=Ado8u0U0Ej3xaSl1ZKGIC2b69iUDS4_2NhUkrFBpzfK7GsqqdCv6n8cI7vyktcg6YFQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQPyNs4k7p_Rz4CirqotmTxIUSV3jU-0UnIuH8zFF7hA&oe=69CFA497"}, "display_name": "Tvori", "keywords": [], "long_description": "Tvori is a VR design tool for spatial experiences. With the term spatial experiences, we refer to VR and AR applications (from gaming and entertainment to productivity and training) as well as real-world products and services where space and user flows are crucial (e.g. the check-in process at the airport, design for smart home features, etc). Nowadays designers, product owners, and customers/users gather around the table to ideate and share a common vision by sketching storyboards, creating cardboards prototypes, and embodying the whole experience to come up with a vision and test hypothesis before developers or engineers resources are involved in the process. That is what Tvori is about\u2026 but without the limitations of the physical world.\nIn Tvori you can pick a premade scene as a canvas for your creation (a house, a shop floor, an autonomous car) or start from scratch and build the lobby of a VR fitness game. Designers can introduce and manipulate simple shapes at scale, change color", "short_description": "Tvori makes collaboration smooth & easy to prototype interfaces, products, and design amazing experiences for XR, and the real world"}]}, "developer_name": null, "devel
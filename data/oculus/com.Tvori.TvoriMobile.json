-7&_nc_sid=6e7a0a&_nc_ohc=FnVjQEVbv-EQ7kNvwEp8iXi&_nc_oc=AdqtLrpiKkx8bXT1v0clJavP8e4OqRreVVJcS1u2RnyTLlH9nvdyQ43PlEhkiVk-GSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjQ1vSrhQJORTO2dtFg9xnkiXCB7sAQfSLMJUzP0nFbg&oe=69C92A04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "216671373458668", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001675_216671376792001_5001614293237078003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOHl_f6RQkkQ7kNvwGHUmJw&_nc_oc=AdpCQ9N0tT4DKUpGWBB5RsBoxtHMcX3ThxSt7k6PYikrsKy21S08ePnJVJE6vFjFcoY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzmZl48kCd4BdWLE-lOEUjEX3EA7nX56NxRBw3RGtXuQ&oe=69C90D17"}, "display_name": "Tvori", "keywords": [], "long_description": "Tvori is a VR design tool for spatial experiences. With the term spatial experiences, we refer to VR and AR applications (from gaming and entertainment to productivity and training) as well as real-world products and services where space and user flows are crucial (e.g. the check-in process at the airport, design for smart home features, etc). Nowadays designers, product owners, and customers/users gather around the table to ideate and share a common vision by sketching storyboards, creating cardboards prototypes, and embodying the whole experience to come up with a vision and test hypothesis before developers or engineers resources are involved in the process. That is what Tvori is about\u2026 but without the limitations of the physical world.\nIn Tvori you can pick a premade scene as a canvas for your creation (a house, a shop floor, an autonomous car) or start from scratch and build the lobby of a VR fitness game. Designers can introduce and manipulate simple shapes at scale, change color", "short_description": "Tvori makes collaboration smooth & easy to prototype interfaces, products, and design amazing experiences for XR, and the real world"}]}, "developer_name": null, "devel
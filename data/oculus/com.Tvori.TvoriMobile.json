-7&_nc_sid=6e7a0a&_nc_ohc=SZggYsSJj68Q7kNvwFLaIpu&_nc_oc=AdpoKazVqxN5LYu7dhEY4LTZSX5wUOIxMcbZ2IsFqM6eQvY35kEurkBZwFtutihVK6E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1x66Td-9PqUAVHPtrAqqjRxpUQ00ncdPggfjLw0nChyQ&oe=69D26484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "216671373458668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001675_216671376792001_5001614293237078003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGE6fqsV1hwQ7kNvwFilRYf&_nc_oc=AdpXErds9AO8Q54i0-k_hyhZw3u3JrptEpESYWpkkTDrCFqsHNtzcc7g-N21Kj0SHoE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oByIfjuqe6Wpax5c8b3KaO_Sw5j7C1_yrUbnGAUG2Dg&oe=69D24797"}, "display_name": "Tvori", "keywords": [], "long_description": "Tvori is a VR design tool for spatial experiences. With the term spatial experiences, we refer to VR and AR applications (from gaming and entertainment to productivity and training) as well as real-world products and services where space and user flows are crucial (e.g. the check-in process at the airport, design for smart home features, etc). Nowadays designers, product owners, and customers/users gather around the table to ideate and share a common vision by sketching storyboards, creating cardboards prototypes, and embodying the whole experience to come up with a vision and test hypothesis before developers or engineers resources are involved in the process. That is what Tvori is about\u2026 but without the limitations of the physical world.\nIn Tvori you can pick a premade scene as a canvas for your creation (a house, a shop floor, an autonomous car) or start from scratch and build the lobby of a VR fitness game. Designers can introduce and manipulate simple shapes at scale, change color", "short_description": "Tvori makes collaboration smooth & easy to prototype interfaces, products, and design amazing experiences for XR, and the real world"}]}, "developer_name": null, "devel
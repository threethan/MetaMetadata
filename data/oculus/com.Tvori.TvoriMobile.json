-7&_nc_sid=6e7a0a&_nc_ohc=FnVjQEVbv-EQ7kNvwFAeaa7&_nc_oc=Adpe--iOujsGlpJlUKkzBgI84kxyir5ZAfP67UyP2tW-FVsX4gMzWSYPf4AU1uDF2Ew&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyA9VGob2aRSulF7_eZxSVGQurFTSRUhFdIO6j-E5Ruaw&oe=69C7D884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "216671373458668", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39001675_216671376792001_5001614293237078003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOHl_f6RQkkQ7kNvwEu2hH8&_nc_oc=AdpW_x3kMIuyVEC_6Ne_1OG1LM3ykkmqT9rTZyn0SRPuJcFWbzUEiHu8UPDYGZo8raw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx81uizUAQrWvxQCohtxOWSwZ--vwa-N3RSXIFRD-bbtQ&oe=69C7BB97"}, "display_name": "Tvori", "keywords": [], "long_description": "Tvori is a VR design tool for spatial experiences. With the term spatial experiences, we refer to VR and AR applications (from gaming and entertainment to productivity and training) as well as real-world products and services where space and user flows are crucial (e.g. the check-in process at the airport, design for smart home features, etc). Nowadays designers, product owners, and customers/users gather around the table to ideate and share a common vision by sketching storyboards, creating cardboards prototypes, and embodying the whole experience to come up with a vision and test hypothesis before developers or engineers resources are involved in the process. That is what Tvori is about\u2026 but without the limitations of the physical world.\nIn Tvori you can pick a premade scene as a canvas for your creation (a house, a shop floor, an autonomous car) or start from scratch and build the lobby of a VR fitness game. Designers can introduce and manipulate simple shapes at scale, change color", "short_description": "Tvori makes collaboration smooth & easy to prototype interfaces, products, and design amazing experiences for XR, and the real world"}]}, "developer_name": null, "devel
-7&_nc_sid=6e7a0a&_nc_ohc=SZggYsSJj68Q7kNvwEVMONs&_nc_oc=AdrAe5uWUIm_oGi5-dEomKFnzbCAsR8DE3E-AuLjrw5VbYIuguPIzi-j8uLhVnQ9cf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdTAng0zsIvojl7enZOWZamN2lczkxmPGHxtKon2YzyQ&oe=69D11304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "216671373458668", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001675_216671376792001_5001614293237078003_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGE6fqsV1hwQ7kNvwGF7hs2&_nc_oc=AdoInPHfsu9FdIKMik_J0gozn3BZrVedWA5yx4k-pfY7dBDNC7o66GpldNSj2gY3toE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwqlb2hwk_-bf-YUgz3e3fK0yVj1BzlTmecGE3J49tEhw&oe=69D0F617"}, "display_name": "Tvori", "keywords": [], "long_description": "Tvori is a VR design tool for spatial experiences. With the term spatial experiences, we refer to VR and AR applications (from gaming and entertainment to productivity and training) as well as real-world products and services where space and user flows are crucial (e.g. the check-in process at the airport, design for smart home features, etc). Nowadays designers, product owners, and customers/users gather around the table to ideate and share a common vision by sketching storyboards, creating cardboards prototypes, and embodying the whole experience to come up with a vision and test hypothesis before developers or engineers resources are involved in the process. That is what Tvori is about\u2026 but without the limitations of the physical world.\nIn Tvori you can pick a premade scene as a canvas for your creation (a house, a shop floor, an autonomous car) or start from scratch and build the lobby of a VR fitness game. Designers can introduce and manipulate simple shapes at scale, change color", "short_description": "Tvori makes collaboration smooth & easy to prototype interfaces, products, and design amazing experiences for XR, and the real world"}]}, "developer_name": null, "devel
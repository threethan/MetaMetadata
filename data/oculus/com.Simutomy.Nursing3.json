_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFdrxFBvcnGELNr18jEV0JQsvvIQRCRK29lmCD_sLTbA&oe=6AB686E0"}, {"file_name": "Screenshot 4.png", "id": "28083505024578628", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312422_28083505027911961_7872041120703177994_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1Sjwt9m_VAQ7kNvwH2lJJH&_nc_oc=AdryMbWUmWQOyRz-Blq9kG1EAtbf3HwHa2T5yi3z-iR2JpuGmd6dz_ZmJK5Bltdqa0Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL191RhNMbgS4z1N1VrgfQN1y6nJbErwUXPMq-5IQb3QQ&oe=6AB68F90"}, {"file_name": "Screenshot 3.png", "id": "27872716052390076", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312470_27872716062390075_5644645472303705319_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rQFqJwqCPUQ7kNvwGIUirg&_nc_oc=AdqeL1EggB-dcURoNQwFV1ZIS6ajyLDT68KD6Y8_OTmXt38oPxazJIJ6TguiSVL-nic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLC0kDpdf1prT-VpKF7nOeGMwmGau3vxfwzObLKqHMog&oe=6AB66D93"}, {"file_name": "Screenshot 7.png", "id": "2361620574369519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312422_2361620577702852_521284108128104352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EK9NbPZxXvEQ7kNvwGilWrz&_nc_oc=AdoBj6m14TD-F7J26x_afoqgifgcKyedrFtCq9Xv_XYe7jYtmJzwEZL4OzALum-1rdU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN6t3Ji7lFAOneg5_D7O0MBy8ohL8ZvHrXgrl0hrPvww&oe=6AB67709"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Pack_III_trailer_thumbnail.png", "id": "807229169114794", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619485_807229172448127_6861353408139359112_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqzkV1HPiPAQ7kNvwGa19J5&_nc_oc=AdoKPsehSdSlTb2DlvKULGHdeidvu__1tUkBUbx18awKSr3VKI_PbMp-iO4PnW7kyTE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbKFYk7E41CZ1srQCkwapzxwWdvXHpR9zw1kQHAjq1Aw&oe=6AB688A2"}, "display_name": "Viscer Nursing III", "keywords": ["Nursing", "Simulation", "Medical", "Training", "Education"], "long_description": "VisceR Nursing III is an immersive VR clinical training experience designed for nursing students and healthcare learners. The pack focuses on Cardiology, Emergency Response, Advanced Nursing and IV & Injections, allowing learners to practice procedures in a safe, repeatable, risk-free virtual environment.\n\nEmergency Response\n\u2022 AED\n\u2022 Oxygen Mask\nIV & Injections\n\u2022 IV Cannulation\n\u2022 IV Setup & Infusion\n\u2022 IV Injection Administration\n\u2022 Intradermal Injection\n\u2022 Intramuscular Injection\n\u2022 Subcutaneous Injection\nAdvanced Nursing\n\u2022 Thyrotoxicosis ( Thyroid Storm)\nCardiology\n\u2022 15 cases\n\nThrough interactive VR simulations, learners can understand clinical procedures, follow appropriate steps, practice techniques, identify mistakes, and build confidence through repeated practice. The immersive environment complements classroom teaching, demonstrations, and conventional skills-lab training while providing learners with an opportunity to rehearse procedures without risk to patients.\n\nVisceR Nursing III is part of the wider VisceR healthcare education ecosystem. Additional VisceR packs cover other nursing departments, clinical skills, medical specialties, procedures, anatomy, diagnostics, and other areas of healthcare education.", "short_description": "VisceR Nursing III is an immersive VR clinical training experience for nursing students and healthcare learners. Practice essential procedures that include Cardiology, Emergency Response, Advanced Nursing and IV & Injections.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.viscer.co/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simutomy Medtech Pvt Ltd", "support_website_url": "https://www.viscer.co/contact", "website_url": "https://www.viscer.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfor
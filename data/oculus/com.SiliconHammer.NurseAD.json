culuscdn.com/v/t64.5771-25/604302364_3724680941028552_7412531991401434149_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_04T6Ml4mtcQ7kNvwGMifEw&_nc_oc=AdpDcqOsBqt06I60uSsYGLmH5qTENQ3VaLjBt1mEtgwhYm4VzU0RDDDARL1J0TMwavc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsFnDJDwero14k78mgkh2mjlzYxAJCyLrwtoLvXx5Oqw&oe=6A6F530B"}, {"file_name": "NurseAD_10.png", "id": "27575368638780474", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/604282317_27575368648780473_5552894718644248840_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PDnYZNVlTQQ7kNvwE_CgcD&_nc_oc=Adp51DO8niEZ2NW5fxl66GTAJFeYn8bJWES-tVGbM0b2OVA9m1ByheWG6kNN3QTlQL0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLUDht_6fptYSEx1B0KQw7mqjYRdmjpqFNNmVcjDJ7wQ&oe=6A6F2DBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\uc6d0\ubb34\uacfc VR", "keywords": ["\uac04\ud638", "\uc6d0\ubb34\uc5c5\ubb34", "\uad50\uc721", "\uccb4\ud5d8\ud615\ud559\uc2b5"], "long_description": "VR \ud658\uacbd\uc5d0\uc11c \uac04\ud638 \uc6d0\ubb34 \uc2e4\uc2b5\uc744 \uc218\ud589\ud558\uace0, \ubc18\ubcf5\ud559\uc2b5\uc744 \uc9c0\uc6d0\ud558\ub294 \uac04\ud638 \uad50\uc721 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc785\ub2c8\ub2e4. \n\n\uc0ac\uc6a9\uc790\ub294 \uc2e4\uc2b5\uc5d0\uc11c \uc81c\uacf5\ud558\ub294 \uc6d0\ubb34 \ud658\uc790 \uc2dc\ub098\ub9ac\uc624\ub97c \ud1b5\ud574, \uc6d0\ubb34 \uc2e4\uc2b5\uc744 VR \ud658\uacbd\uc5d0\uc11c \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n\n\uc2e4\uc2b5 \uacfc\uc815\uc740 \uc2dc\uc2a4\ud15c\uc744 \ud1b5\ud574, \uae30\ub85d \uc11c\ubc84\uc5d0 \uc790\ub3d9\uc73c\ub85c \uc800\uc7a5\ub418\uba70, \ub2f4\ub2f9 \uad50\uc218\uac00 \ud655\uc778\ud558\uc5ec \ud559\uc0dd\uc758 \uc2e4\ubb34\uc5ed\ub7c9 \ud5a5\uc0c1\uc5d0 \ud65c\uc6a9\ub429\ub2c8\ub2e4. \n\n\uc2e4\uc2b5\uc744 \ud1b5\ud574 \uac04\ud638 \uc6d0\ubb34 \uc808\ucc28\ub97c \uc219\ub2ec\ud558\uace0 \uc2e4\ubb34 \ub2a5\ub825\uc744 \ud5a5\uc0c1 \uc2dc\ud0ac\uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \n\n\uc8fc\uc694\uae30\ub2a5 \n\n* \uc815\ud574\uc9c4 \uc6d0\ubb34 \ud658\uc790 \uc2dc\ub098\ub9ac\uc624\ub97c \ud1b5\ud55c \uc2e4\uc2b5 \uc218\ud589 \n* \ubab0\uc785\uac10 \uc788\ub294 VR \uae30\ubc18 \uac04\ud638 \uc6d0\ubb34 \uad50\uc721 \ud658\uacbd \n* \uc2e4\uc2b5 \uacfc\uc815 \uc790\ub3d9 \uc800\uc7a5 \n* \ubc18\ubcf5 \ud559\uc2b5\uc744 \ud1b5\ud55c \uc2e4\ubb34 \uc5ed\ub7c9 \ud5a5\uc0c1  \n\n\ubcf8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc740 \uac04\ud638 \uad50\uc721\uae30\uad00 \ubc0f \uad50\uc721 \ud504\ub85c\uadf8\ub7a8 \ucc38\uc5ec\uc790\ub97c \uc704\ud55c VR \uad50\uc721\uc6a9 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc774\uba70, \n\ud559\uad50\ucf54\ub4dc \uc785\ub825 \ubc0f, \ud559\ubc88\uc744 \uc785\ub825\ud558\uc5ec \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. ", "short_description": "VR\uc744 \ud1b5\ud574 \uac04\ud638 \uc6d0\ubb34 \uc2e4\uc2b5\uc744 \uc218\ud589\ud558\uc5ec, \uc2e4\uc81c \uc5c5\ubb34 \uc5ed\ub7c9 \uc99d\uc9c4\uc744 \ub3c4\uc640\uc8fc\ub294 \uac04\ud638 \uad50\uc721 \uc560\ud50c\ub9ac\ucf00\uc774\uc158 \uc785\ub2c8\ub2e4. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.siliconhammer.com/privacy-policy/?q=YToxOntzOjEyOiJrZXl3b3JkX3R5cGUiO3M6MzoiYWxsIjt9&bmode=view&idx=172443901&t=board", "developer_terms_of_service_url": null, "publisher_name": "Silicon Hammer", "support_website_url": null, "website_url": "https://www.siliconhammer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["HAND_TRAC
fying the continent!", "short_description": "VR unique sense of operation; An immersive siege experience; Easy to understand gameplay; Stimulating brain-burning coping strategies;"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforcastlewars", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://www.daka-vr.com/en", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8912711772107559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974920_959129665826487_3466255500511711445_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6hOdC_ZpqsQ7kNvwFSOwpJ&_nc_oc=Adm_GKBGy5QFsS4rRpDT4PdTGUbuSG7OAwguTBF1tWWqqFZvo0xyyR5Bk5RCrYvCMi0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsfLZZckFY1TFQTbwoTlr2myuJOtAkSY83zfRtX9iVYLA&oe=69A97959"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CastleWars", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Strategy", "id": "275629210202852"}], "release_date": 1709241300, "lastRevision": {"nodes": [{"id": "7516040785108005", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata"
ame, in a parallel time in a mysterious planet, there are several continents in the boundless sea, each continent is inhabited by different races. Due to racial differences, battles often break out, and you, as the new king of mankind, are determined to unite the continents and rid the world of war. But only if you accept races from other continents. From then on began the journey of unifying the continent!", "short_description": "VR unique sense of operation; An immersive siege experience; Easy to understand gameplay; Stimulating brain-burning coping strategies;"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicyforcastlewars", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://www.daka-vr.com/en", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8912711772107559"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974920_959129665826487_3466255500511711445_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDHA32J63AkQ7kNvwEQo4D4&_nc_oc=AdpTPrpOuSl5rqM6bB4iPHPQ7jD2QRoCbNRBeuxQvyUwHleUwYvkRQ2L8P-hl2iFFSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDF61qz7eot_XUlP3_sSJCLSqD8U9dJArNNcNxK6eSuA&oe=6AFDD499"}, "is_concept": false,
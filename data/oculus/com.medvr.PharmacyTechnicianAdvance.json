.Still005.png", "id": "2169514193578456", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619672_2169514196911789_6277623100438776898_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q1i_e_JugkQ7kNvwEKQEIO&_nc_oc=AdqpAeuAw1GmkKJYACB9lTDG1IUKtF0DHnBNQ_4rPEyW2pmjOc12BoMySCW-x0GhIKs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8SjlyXmlBbp_fVKaytBUMI66T-_Mi_QkMIo8Wtyv3pmw&oe=6A47B46B"}, {"file_name": "com.medvr.PharmacyTechnician-20251031-160545-0.00_14_48_12.Still002.png", "id": "1237940858224481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619594_1237940861557814_5017355315404272681_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nyPVkW5-LWYQ7kNvwHTcEXR&_nc_oc=AdqrGyykXG5yP9DrRfRQ7TQFIeoDyNRMnFsL6eu0FMSGN4lTg1QQaq1s0WwsanX3fcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RPwarYHoKbIIuk_PPKg90xI5c2KuJMRY3LJDVACWSfg&oe=6A47BE09"}, {"file_name": "com.medvr.PharmacyTechnician-20251222-144212-0.00_00_22_35.Still006.png", "id": "1409267757237171", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623345_1409267767237170_2690174721271364027_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70QyChNsZxAQ7kNvwH3GGjZ&_nc_oc=AdqKt1Bb4AbXx3G_fci7WfYW1nZkW_RMtzLWhPnpn64S1PdiV0ZQ0_3Zd5W6k5dfkuA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-s0EqHmqLT5xdQwAoopbgLFq0epuccD6fPh2dPCzgKdw&oe=6A47CD23"}, {"file_name": "Pharmacy - Child CPR.00_00_06_06.Still001.png", "id": "1312838813861464", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620429_1312838817194797_6649633856142995503_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smMkitxd4MAQ7kNvwER2T9n&_nc_oc=Adob9qEJqJpOxRuiZPTx5COn6pq1Wu5-cOlagD8asFZ_ogcqgMCe0JZZRjOkT9J3Hmk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mqJjIdb942JVFVOxx11_oDRd12AxhnsFkuQEDT52MwA&oe=6A47B9FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pharmacy Technician Advance", "keywords": ["immerselearn", "vr", "immerse", "pharmacy", "advance"], "long_description": "Pharmacy Technician Advance is part of the Immerse Learn Pharmacy Technician Certification Program and is accessible only to students enrolled in the program. This immersive VR simulation is designed to replicate real-world pharmacy operations through hands-on, interactive training. Learners can practice essential tasks such as processing prescriptions, measuring and dispensing medications, managing inventory, handling recalls, and preventing common medication errors. Developed in alignment with industry standards, the app offers a safe, risk-free environment to build technical accuracy, workflow efficiency, and patient safety awareness. Pharmacy Technician Advance helps students gain practical experience and confidence before entering a real-world pharmacy setting. Access is restricted to enrolled students only.", "short_description": "Pharmacy Technician Advance is a VR training app developed as part of the Immerse Learn Pharmacy Technician Certification Program. Available exclusively to enrolled students, it provides hands-on practice in prescription processing, medication dispensing, inventory management, and error prevention in a realistic, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
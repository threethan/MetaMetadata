-7&_nc_sid=6e7a0a&_nc_ohc=RqDyAIWJCmAQ7kNvwH8OS2T&_nc_oc=AdqxiPHqt2WuzBegcfT24Exfj5orWqu196pZ6hvqhzFuhs39IP3n7ON6XNOG0KT-APk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3939-Ou82rvZ6N0rCUZK18zvxsh4CnakNF2GUlKwnZJQ&oe=69F2087C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pharmacy Technician Advance", "keywords": ["immerselearn", "vr", "immerse", "pharmacy", "advance"], "long_description": "Pharmacy Technician Advance is part of the Immerse Learn Pharmacy Technician Certification Program and is accessible only to students enrolled in the program. This immersive VR simulation is designed to replicate real-world pharmacy operations through hands-on, interactive training. Learners can practice essential tasks such as processing prescriptions, measuring and dispensing medications, managing inventory, handling recalls, and preventing common medication errors. Developed in alignment with industry standards, the app offers a safe, risk-free environment to build technical accuracy, workflow efficiency, and patient safety awareness. Pharmacy Technician Advance helps students gain practical experience and confidence before entering a real-world pharmacy setting. Access is restricted to enrolled students only.", "short_description": "Pharmacy Technician Advance is a VR training app developed as part of the Immerse Learn Pharmacy Technician Certification Program. Available exclusively to enrolled students, it provides hands-on practice in prescription processing, medication dispensing, inventory management, and error prevention in a realistic, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211
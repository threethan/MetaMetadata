_5017355315404272681_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zn0jFmkVoDoQ7kNvwHVU6yP&_nc_oc=AdoEuoyv1MMopoDEuri1Ny749b0basxr0tDD-uiseK-0kzFlFHsQJzSJC-KBMUmP8v4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9t8RMhJ8A_eW-LSQT8jalGYf8_0ZAIBdHuJqjBceT7Mw&oe=6A281A09"}, {"file_name": "com.medvr.PharmacyTechnician-20251222-144212-0.00_00_22_35.Still006.png", "id": "1409267757237171", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623345_1409267767237170_2690174721271364027_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZvTy8x9O0acQ7kNvwEH2DIl&_nc_oc=AdqpzF-rJOXGnDwN3I9KerqYJMLr3Fg6vOnL_Gokygt6ugAG3mSomqx3w09gz9XYYOc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pV8LcClMfS29JhXtdqq17fWqTtQn2RvN-zRR_Cf7xwQ&oe=6A282923"}, {"file_name": "Pharmacy - Child CPR.00_00_06_06.Still001.png", "id": "1312838813861464", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620429_1312838817194797_6649633856142995503_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIjAeyFAtdIQ7kNvwGNVPpG&_nc_oc=AdqQCxjwnR01m1-2TY8sRMQxJMGhF683lgFxAJN6F0v2O8qHmd4sFbCsj4zG_ngfV-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PXkg3iKvrgdiKA50NBFVfE2oSZBVerX0sY5KyZFHHHg&oe=6A2815FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pharmacy Technician Advance", "keywords": ["immerselearn", "vr", "immerse", "pharmacy", "advance"], "long_description": "Pharmacy Technician Advance is part of the Immerse Learn Pharmacy Technician Certification Program and is accessible only to students enrolled in the program. This immersive VR simulation is designed to replicate real-world pharmacy operations through hands-on, interactive training. Learners can practice essential tasks such as processing prescriptions, measuring and dispensing medications, managing inventory, handling recalls, and preventing common medication errors. Developed in alignment with industry standards, the app offers a safe, risk-free environment to build technical accuracy, workflow efficiency, and patient safety awareness. Pharmacy Technician Advance helps students gain practical experience and confidence before entering a real-world pharmacy setting. Access is restricted to enrolled students only.", "short_description": "Pharmacy Technician Advance is a VR training app developed as part of the Immerse Learn Pharmacy Technician Certification Program. Available exclusively to enrolled students, it provides hands-on practice in prescription processing, medication dispensing, inventory management, and error prevention in a realistic, interactive virtual environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26556223310633580"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618938_843238604983897_7166497908150824496_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0vGbw94DZYQ7kNvwE0YLCr&_nc_oc=Adpg7Lvk-GobMKknSUQw4DGVj-uEodyksG40Egb5G8t8bsU0TcfFTA3aOkjhFFqWf70&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YamBF73xrDuzVT9Aisy
_description": "Have you ever wanted to run your own crazy tavern?\n\nWell now you can! Cook meat, get drinks and serve them to hungry (possibly angry) npcs.\n\nThere are some surprises just like with any business, so be prepared!\n\nGame modes and features:\n\n\u2606 Has a tutorial and 2 days of story mode.\n\n\u2606 Endless mode where there are an infinite amount of customers until you close the tavern.\n\n\u25c7 Completed options menu.\n\n- Change height to play standing or sitting.\n\n- Put music on shuffle or play any particular song on loop.\n\n- Normal settings any other game would have.", "short_description": "Have you ever wanted to run your own crazy tavern?\n\nWell now you can! Cook meat, get drinks and serve them to hungry (possibly angry) npcs.\n\nThere are some surprises just like with any business, so be prepared!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://adventurehousestudio.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Adventure House Studio", "support_website_url": null, "website_url": "https://adventurehousestudio.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9138292339618875"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031630_608088827074234_580051607
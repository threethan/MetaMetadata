 game would have.", "short_description": "Have you ever wanted to run your own crazy tavern?\n\nWell now you can! Cook meat, get drinks and serve them to hungry (possibly angry) npcs.\n\nThere are some surprises just like with any business, so be prepared!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://adventurehousestudio.wordpress.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Adventure House Studio", "support_website_url": null, "website_url": "https://adventurehousestudio.wordpress.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2721826358122598"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "474826110902939"}]}, "baseline_offer": {"id": "474826110902939"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1642568400, "status": "PUBLISHED", "id": "474826110902939"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4737723426342477", "version": ".1"}, "id": "619976305682054", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4511574088957413", "is_concept": false, "latest_re
B28AD"}, {"file_name": "Untitled design (12).png", "id": "993994850150113", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307339_993994853483446_1187314442911025361_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R59wxd7DdcgQ7kNvwFGMuK2&_nc_oc=AdqAlA0y-7TFtroldyhLsWJKXJsQDt0bE9GlzanS9rlGD1wD-6UMUpK1MFd1hCuxJMo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQadYC5dUx2mQc20RFOU5eq75exJbfuEjBPswc15Xi1pw&oe=6AFB4AD9"}, {"file_name": "Untitled design (13).png", "id": "1185895656771360", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499300897_1185895660104693_1586407616411657046_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Sto1zhlnUoQ7kNvwFvk2Xy&_nc_oc=AdqnIpTZV6EYrA9YHNh2fUU3uwIFEimXbenbt81w8fHkxkk7i82assIuW-MPdrcf684&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-HQoh9esQL4vkhO4RmOEkCFvfDwAPjVVjruUlxhFE4g&oe=6AFB192E"}, {"file_name": "Untitled design (14).png", "id": "26507286155543160", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300678_26507286172209825_5695452597013670875_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbqsVx0CT8sQ7kNvwE9OAg4&_nc_oc=Adotw3QXIMqVuTRUOkU1zVCVTEf1Gn7EDLODHCxk1asr3dvULRxSO0oKLF03HqHp-yY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvsCehiogvq21PZwh7YvmQLrLPwK7VoxNcRi-aclI1kA&oe=6AFB2E35"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design (4).png", "id": "1344230044390345", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499307315_1344230051057011_9037583091754755675_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5BLrr-p4HZYQ7kNvwGXWGOH&_nc_oc=AdrcXcaWrDMT9eBOp_y6BXu2psfTdL5zmLe4nTf4TUJUEWia9VIWP30HPSnQemFN1Ms&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0ag6WnzJpU_DjhSXOfyzzbAO_Vr61BKyXDHOu9gfDHw&oe=6AFB47ED"}, "display_name": "canopyXchaos", "keywords": [], "long_description": ". Refined Locomotion & Physics\nThe \"feel\" of a Gtag-style game is everything. Even if your movement is solid, constant updates are needed to:\n\nSurface-Specific Friction: Adding \"slippery\" ice walls, \"sticky\" honey or mud, and high-bounce trampolines to change how players navigate.\n\nHaptic Feedback Calibration: Fine-tuning the rumble in the controllers so every \"slap\" and \"jump\" feels impactful and distinct.\n\nCollision Optimization: Fixing those pesky spots where players get their hands stuck in a wall or \"clip\" through the floor.\n\n\ud83e\udde5 2. The Cosmetic & Economy Loop\nIf you want players to keep coming back, they need a reason to \"show off.\"\n\nSeasonal Item Rotations: Introducing limited-time hats, badges, or handheld items tied to real-world holidays (Halloween, Winter, Summer) or in-game \"lore\" events.\n\nPlayer Tiers & Rarity: Implementing \"OG\" badges for early supporters or \"Veteran\" skins that can only be earned through playtime, not just currency.\n\nParticle Effects: Adding \"trails\" or \"glows\" to high-tier items to make them true status symbols in the lobby.\n\n\ud83d\uddfa\ufe0f 3. Map Expansion & \"Biome\" Variety\nDon't just add more space; add more variety to the gameplay.\n\nVerticality-Focused Maps: Creating a \"Canyon\" or \"Skyscraper\" map that rewards high-risk jumps and punishes players who fall.\n\nDynamic Environments: Adding moving platforms, rising lava, or water mechanics (swimming is a huge trend in Gtag-likes!) to keep the \"taggers\" on their toes.\n\nThe \"Hub\" Evolution: Constantly updatin", "short_description": "This is a Gtag fangame with some ongoing updates in the works.....always"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1DC1ngVpjsW-XYcvzW7hZn4LY2SLLMiDjrZ92qKT1OXM/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "RNG", "support_website_url": null, "website_url": "https://www.you
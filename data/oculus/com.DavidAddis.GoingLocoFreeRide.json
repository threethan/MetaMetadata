25-03-23-01h56m39s271.png", "id": "1057677622547032", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827038_1057677625880365_8603356803620624300_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XBaoiF_XqLAQ7kNvwHYS86Q&_nc_oc=AdqFUFHPL67MIe__wPefiz_vdv3a7dD09HZIV_DLV4kg1xrf5Kkd9Y8V38unXNQNFCA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPN1hft6BnzzAwcMYC4xY0QwhRwmHVOgfzXzd5mw8BDcA&oe=6AE36C90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 _3.png", "id": "1200353241889292", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491830776_1200353245222625_6354199779862898781_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZrkn7O2DFEQ7kNvwGuzr1Y&_nc_oc=AdrP9riu-5Cna9Py4r0sRlhNOgNt5c3w1bdmwfF3qQs20OzeiY3paRNOw78xxj8CxkA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO53oFQeCy5oQCkkplM_B9-BqWSe2yLrIkKMF2cLofVig&oe=6AE36593"}, "display_name": "Going Loco: FREE RIDE!", "keywords": [], "long_description": "In Going Loco: Free Ride, you step into the shoes of a slightly underqualified city planner, armed with just enough tiles to cobble together your own miniature transport network. Using spare bits of road, rail, and runway, you\u2019ll build your own low-poly worlds \u2014 and then share them with others.\n\nExperiment with wacky routes, test ridiculous vehicle combinations, and discover what happens when creativity collides with traffic control. Creator Mode is fully unlocked, so you can craft levels, upload them online, and explore player-made content \u2014 all without paying a penny.\n\nWhether you\u2019re just learning the ropes or planning your magnum opus, Free Ride gives you all the tools you need to get started. And when you're ready to unlock the full campaign, extra vehicles, and official challenges, the full version is waiting at the next station.\n\nBuild it. Break it. Share it. FREE.", "short_description": "Test your planning skills for free! Build your own chaotic transport networks in this sandbox spin-off of Going Loco. Place tiles, dodge disaster, and share your creations with the world \u2014 no ticket required."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.davidaddis.com/?page_id=61616", "developer_terms_of_service_url": null, "publisher_name": "David Addis", "support_website_url": null, "website_url": "http://www.davidaddis.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24514022461523218"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "735133758905721"}]}, "baseline_offer": {"id": "735133758905721"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750878420, "status": "PUBLISHED", "id": "735133758905721"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26996885393236900", "version": "1.2.4"}, "id": "3935855779986873", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24491630060429125", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26996885393236900"}, "release_status": "RELEASED"}, "binary_release_c
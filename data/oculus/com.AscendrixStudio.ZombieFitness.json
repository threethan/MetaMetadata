050_1869944813907608_4829131170188338773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zrvFwQ92rrgQ7kNvwFRzHQk&_nc_oc=AdqLACn5RQZXpaZ-Uy0ecjxPP4YcHRx9O8-rvEpnKikamd9KuisN5Zy_YmwD9RSD1_8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtHmn902hAQCL6M_b7z79Olc8PuTBoUUeSLBCjO0dSYw&oe=6A80524C"}, {"file_name": "2560x1440-screenshot (12).png", "id": "1704156606969351", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300619_1704156610302684_1394289637422547189_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOqVqEXjt2MQ7kNvwEdrMrq&_nc_oc=Adp4oC6Dq0bXFbhnjvADxmb6Upp6F-6QIfti8vrLqOHET6kyu7xpNPBZhAVzMxsTSio&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuV6oeWFadXCoagma9ujwGyoNbtliI_w7NiKixp7AL1w&oe=6A8041F3"}, {"file_name": "2560x1440-screenshot (1).png", "id": "797468885993446", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499300910_797468889326779_1321438616784314114_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhQ3qNGXaKMQ7kNvwGHfWTw&_nc_oc=Adp2hYoRzTTsNLRTIxWLOSRsIo8cNGVb-HRiex5_QVerNN2ZqHhg7flvODoJXpCXoYQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIV3mRUfTbb0JxHNrMvixPw2mqXTvMyI3DTvD7hfwHhQ&oe=6A80616C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2268877973545345", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819980_2268877976878678_2596672540452692170_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFJz2VTNciEQ7kNvwExCR8E&_nc_oc=Adqt_kRbNl99E49FSjGXRn_TN1I6J1Pi3UW8jLwP8gtp6saAiGFC3a2m57T4Fa3fhDo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5M3Gj8KzDfaKVoATplAHkGTqEpXyljiJTQoktQvBvsQ&oe=6A8042B8"}, "display_name": "Zombie Fitness", "keywords": ["Fitness", "Shooting", "Horror", "Zombie", "Cardio"], "long_description": "Zombie Fitness: \n\nTired of the gym? Get ripped in a pulse-pounding fight for survival. Zombie Fitness is the revolutionary VR fitness game that transforms your squats and leans into life-or-death movements. Dodge arrows, smash zombies, and burn calories in the most exciting workout you'll ever experience.\n\n\ud83c\udfcb\ufe0f Key Features\n\n\u2022 The Ultimate VR Workout: Engage in a full-body cardio blast. Real squats dodge arrows, dynamic leans evade zombies. Feel the burn in your quads, glutes, and core.\n\u2022 5 Stunning Maps: Battle through diverse apocalypses, from hyper-realistic urban decay to a vibrant, glowing neon nightmare.\n\u2022 Realistic Zombie Horde: Face a variety of terrifying undead, from shambling walkers to sprinting runners and massive, screen-filling boss zombies.\n\u2022 Two Gripping Modes:\n\u2022 Story Mode: Conquer 10 levels of intense, progressive action and unravel the mystery.\n\u2022 Endless Mode: Test your limits against infinite waves. compete for high scores on global leaderboards.\n\u2022 Functional Fitness: Improve your real-world agility, reflexes, and strength with every play session.\n\n\ud83c\udfaf Modes of Play\n\n\u2022 Story Campaign: Embark on a guided fitness journey through a structured and challenging narrative.\n\u2022 Endless Survival: Enjoy a perfect, pick-up-and-play roguelite experience designed for quick, addictive workout sessions.\n\nZombie Fitness makes you forget you're working out. The adrenaline-pumping action is the perfect distraction,  more effective cardio and strength-training sessions.\n", "short_description": "Zombie Fitness: \n\nGet ready for the most thrilling fitness experience in VR! Zombie Fitness transforms your workout into a heart-pounding survival adventure. Duck and dodge arrows with real squats, then lean left and right to smash through hordes of realistic zombies.\n\nBattle through 5 incredible maps with unique visual styles, from dark realism to vibrant neon worlds. Face massive boss zombies that will test your strength and reflexes to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/zombiefitness/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/zombiefitness/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24549806211374730"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PUBLISHED", "id": "1039322969082645"}, {"status": "PUBLISHED", "id": "2072846850277282"}, {"status": "PUBLISHED", "id": "966781446220639"}, {"status": "PUBLISHED", "id": "693336147176464"}, {"status": "PUBLISHED", "id": "1269499351776024"}, {"status": "PUBLISHED", "id": "3793005550994136"}, {"status": "PUBLISHED", "id": "895699339684217"}, {"status": "PUBLISHED", "id": "867035472391787"}, {"status": "CANCELLED", "id": "1332360511910940"}, {"status": "PUBLISHED", "id": "2596163797443491"}, {"status": "PUBLISHED", "id": "1373352581177130"}, {"status": "CANCELLED", "id": "1122662900034960"}, {"status": "PUBLISHED", "id": "1936225557234611"}, {"status": "PUBLISHED", "id": "1433028361097478"}, {"status": "CANCELLED", "id": "652632177574097"}, {"status": "PUBLISHED", "id": "1373255714515646"}, {"status": "PUBLISHED", "id": "753145890679806"}]}, "baseline_offer": {"id": "1373352581177130"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 178
=00_Af36S9fXoAd6u2i2J0U2wyN1Q5ywEMpXScXmpG_gs1RESA&oe=69D640CC"}, {"file_name": "2560x1440-screenshot (12).png", "id": "1704156606969351", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499300619_1704156610302684_1394289637422547189_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4IO7jq7lEIQ7kNvwGiwNSA&_nc_oc=AdqBdUKJpPzYEYgLvou0vrhkruQFkTDhon_RLZ1gr39aViw8ye68HjnwUDw6PtvDqV8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PFWG2fmQ9obEJJwxI3C1fs_503ByVyjWA7plKSUaZow&oe=69D63073"}, {"file_name": "2560x1440-screenshot (1).png", "id": "797468885993446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300910_797468889326779_1321438616784314114_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5MmaiiDKTcQ7kNvwELXpiS&_nc_oc=AdpZqw0Q82h4LQ9PVsoJZuQTn29xz_AqgY9ITR0gx7tZQtdDPrp6k1b3eLjx69WXymM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32n111hGdJK9HDe4-QswqSbZ-H7LDxcEF87jnpSwttnQ&oe=69D64FEC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2268877973545345", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819980_2268877976878678_2596672540452692170_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcdYC94enmUQ7kNvwE72Rk-&_nc_oc=AdowUFTLcr8AIx8Kio_Zbv1D3TYjjcJjJcuBTXDQBq5K1Nc2GPgLEIVzs_qwMxvqCaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bbt0GwmWNyRNuSAWxoao1V-pi5rP9OOki00bid1dOow&oe=69D63138"}, "display_name": "Zombie Fitness", "keywords": ["Fitness", "Shooting", "Horror", "Zombie", "Cardio"], "long_description": "Zombie Fitness: \n\nTired of the gym? Get ripped in a pulse-pounding fight for survival. Zombie Fitness is the revolutionary VR fitness game that transforms your squats and leans into life-or-death movements. Dodge arrows, smash zombies, and burn calories in the most exciting workout you'll ever experience.\n\n\ud83c\udfcb\ufe0f Key Features\n\n\u2022 The Ultimate VR Workout: Engage in a full-body cardio blast. Real squats dodge arrows, dynamic leans evade zombies. Feel the burn in your quads, glutes, and core.\n\u2022 5 Stunning Maps: Battle through diverse apocalypses, from hyper-realistic urban decay to a vibrant, glowing neon nightmare.\n\u2022 Realistic Zombie Horde: Face a variety of terrifying undead, from shambling walkers to sprinting runners and massive, screen-filling boss zombies.\n\u2022 Two Gripping Modes:\n\u2022 Story Mode: Conquer 10 levels of intense, progressive action and unravel the mystery.\n\u2022 Endless Mode: Test your limits against infinite waves. compete for high scores on global leaderboards.\n\u2022 Functional Fitness: Improve your real-world agility, reflexes, and strength with every play session.\n\n\ud83c\udfaf Modes of Play\n\n\u2022 Story Campaign: Embark on a guided fitness journey through a structured and challenging narrative.\n\u2022 Endless Survival: Enjoy a perfect, pick-up-and-play roguelite experience designed for quick, addictive workout sessions.\n\nZombie Fitness makes you forget you're working out. The adrenaline-pumping action is the perfect distraction,  more effective cardio and strength-training sessions.\n", "short_description": "Zombie Fitness: \n\nGet ready for the most thrilling fitness experience in VR! Zombie Fitness transforms your workout into a heart-pounding survival adventure. Duck and dodge arrows with real squats, then lean left and right to smash through hordes of realistic zombies.\n\nBattle through 5 incredible maps with unique visual styles, from dark realism to vibrant neon worlds. Face massive boss zombies that will test your strength and reflexes to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/zombiefitness/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/zombiefitness/", "category": null, "comfo
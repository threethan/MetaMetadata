t-hkg4-1.oculuscdn.com/v/t64.5771-25/491820496_25153544654312827_3606902093978631387_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WWghvJ97KgQ7kNvwH6bH6K&_nc_oc=Adle1XESKPtQtUqFK6648lG17snP73h-3LuLqus-b9H1UQDirm0RHLZPca1ts5i1p-Y&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftBflPz2whDb-qpPQfgEbHm3OKPFk65vrFkCR7_52K01Q&oe=69A18492"}, {"file_name": "2560x1440-screenshot (29).png", "id": "3776070896021450", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823270_3776070899354783_1245596548630707618_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MV3l0Qhss1sQ7kNvwH-gWrZ&_nc_oc=Adn0nzFlSpd9g5HliTtIZUtLodJ05FPfbCrGET8KRw1DpTP1-dJ19i0be0-neqtd_Cw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuFEK_Vayjn5dK9gdYYzndvHZZp3Tetwxbslvv_HUuagg&oe=69A19B65"}, {"file_name": "2560x1440-screenshot (27).png", "id": "1189608243068025", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/491819323_1189608246401358_2671903566523338991_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFSalKuRE98Q7kNvwGwuS5A&_nc_oc=Adn78fsAfcgT8SnYGrzq0jWx99BLmNRewov35bYzXgVWBuA8TiIhSbssXgoOfctnNLs&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_Afv1sK40vCj7hbKSdlzXSJCyzlWmx5fLN0trxgPauHzgfw&oe=69A194D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 3.png", "id": "831700102786383", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491823296_831700106119716_1961501613371539496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5sR4Zc_VyAkQ7kNvwFdGHUv&_nc_oc=AdkKfBikpRkYNUzAoUhau6PKssAmurnxDT3sSRlhr6Ol9qQ6cd2iw5tp8qxGQUXbnv4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu493m3wU-FKmvh4TLa8dPBWR0ptI52qY6o63MSbltJAw&oe=69A1808A"}, "display_name": "Zombie Fitness", "keywords": ["ZombieShooting", "HorrorShooting", "HorrorGame", "Fitness", "VRShooting"], "long_description": "Zombie Fitness \ud83d\udd2b\ud83d\udc80\nYOUR ULTIMATE INTENSE VR ZOMBIE APOCALYPSE SIMULATOR!\n\n\ud83e\udddf FACE 5 ZOMBIE TYPES from shambling Walkers to massive Boss monsters! Survive 10 STORY MISSIONS + INFINITE HORDE MODE across 5 MASSIVE MAPS:\n\u2705 Urban Decay: Blast through hyper-realistic city chaos!\n\u2705 Neon Nightmare: Light up glowing zombies in a vibrant cyberpunk wasteland!\n\u2705 Frozen Outpost: Survive the icy terror and snowy silence!\n\u2705 Abandoned Asylum: Close-quarters horror around every corner!\n\u2705 Radioactive Ruins: Mutated threats in a toxic environment!\n\n\ud83d\udd25 KEY FEATURES:\n\ud83e\udddf THRILLING RUN-&-GUN GAMEPLAY: Intense action from start to finish! Smash through hordes, dodge lethal projectile attacks, and execute perfect headshots for massive damage!\n\ud83c\udfae IMMERSIVE VR MECHANICS: Realistic physics-based weapon handling, dynamic weather effects, and a complete day/night cycle that changes the zombies' behavior and aggression!\n\ud83c\udf0d OPEN-ARENA COMBAT: Roam freely through ultra-detailed, explorable environments to find ammo, health packs, and strategic choke points!\n\ud83d\udca5 ADAPT OR DIE: Each zombie type requires a different strategy. Kite the Runners, focus-fire the Tanks, and always watch your back!\n\ud83d\udcaf ZERO PAYWALLS: All weapons, maps, and modes are 100% FREE & UNLOCKABLE through gameplay!\n\n\ud83c\udfc6 PERFECT FOR: #VRShooter fans \ud83c\udfae #MetaQuest explorers \ud83c\udf10 #ZombieGame addicts \ud83e\udddf\u200d\u2642\ufe0f #ActionGaming\n\n\ud83d\udc49 DOWNLOAD NOW!\nOnly on the Meta Horizon Store\nSearch: \ud83d\udd0e \"Zombie Fitness\"\n\nQuest 2/3/Pro ", "short_description": "Zombie Fitness \ud83d\udd2b\ud83d\udc80\nULTIMATE VR ZOMBIE SHOOTER! Wield 5 weapons & survive 10 story missions + endless hordes across 5 massive maps! Realistic physics, dynamic weather & total exploration. 100% FREE content!\n\n#VRShooter #MetaQuest\n\nDOWNLOAD NOW!\nMeta Horizon Store"}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/zombiefitness/", "developer_terms_of_service
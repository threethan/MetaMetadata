JnhZH7_ORBk1jTBmg&oe=69A57AEB"}, {"file_name": "2560x1440-screenshot (11).png", "id": "1869944810574275", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308050_1869944813907608_4829131170188338773_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXn8kQkHYacQ7kNvwGx4f_Y&_nc_oc=AdkKacZnCIE1dOlrYLgLN62_wQqgSK_LjnenYfa9wkwYQJr1_aWnj8ijvmauiKOXEwY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft4r398QbRiT9GAlqQ9ojmfpoXDzfDP07enLt90pEFCig&oe=69A5794C"}, {"file_name": "2560x1440-screenshot (12).png", "id": "1704156606969351", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300619_1704156610302684_1394289637422547189_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfW1LEduzUsQ7kNvwEWcQRe&_nc_oc=AdlWqkJkCWQRP0OXn1bBwxeaiRjpH5JiKMdhuw93zQJM6CbXQhULXEJeFGa1wSdYm6U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfstXGGZ8aAZdDmSu1YlfFkqw21KU4oPOX_S_0Xw6DgSZA&oe=69A5A133"}, {"file_name": "2560x1440-screenshot (1).png", "id": "797468885993446", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499300910_797468889326779_1321438616784314114_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9u1E4qOKYUQ7kNvwEPwWI6&_nc_oc=AdmmdgcDd7eAblinkLrYSv8GO8n6VsbxLxTpZcImEqUdAjT2M8KmkgFGf0RujIurWTg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftDK9qJP0SrkxpPEXo1ZtBlHIqScJSMm-K6Sj0MRvstCw&oe=69A5886C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2268877973545345", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819980_2268877976878678_2596672540452692170_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrjRFWARlSYQ7kNvwHHqqIh&_nc_oc=AdnyYVtaU0nXOpZJHC2M6KZgt_7baGFffuyckP9FusE2m3BfG37HWPiRFr7eU8iOEuA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsfO6O1SmFSTCozSVNPBsTBC5BjboeOTLGDBIJmlWBqmg&oe=69A569B8"}, "display_name": "Zombie Fitness", "keywords": ["Fitness", "Shooting", "Horror", "Zombie", "Cardio"], "long_description": "Zombie Fitness: \n\nTired of the gym? Get ripped in a pulse-pounding fight for survival. Zombie Fitness is the revolutionary VR fitness game that transforms your squats and leans into life-or-death movements. Dodge arrows, smash zombies, and burn calories in the most exciting workout you'll ever experience.\n\n\ud83c\udfcb\ufe0f Key Features\n\n\u2022 The Ultimate VR Workout: Engage in a full-body cardio blast. Real squats dodge arrows, dynamic leans evade zombies. Feel the burn in your quads, glutes, and core.\n\u2022 5 Stunning Maps: Battle through diverse apocalypses, from hyper-realistic urban decay to a vibrant, glowing neon nightmare.\n\u2022 Realistic Zombie Horde: Face a variety of terrifying undead, from shambling walkers to sprinting runners and massive, screen-filling boss zombies.\n\u2022 Two Gripping Modes:\n\u2022 Story Mode: Conquer 10 levels of intense, progressive action and unravel the mystery.\n\u2022 Endless Mode: Test your limits against infinite waves. compete for high scores on global leaderboards.\n\u2022 Functional Fitness: Improve your real-world agility, reflexes, and strength with every play session.\n\n\ud83c\udfaf Modes of Play\n\n\u2022 Story Campaign: Embark on a guided fitness journey through a structured and challenging narrative.\n\u2022 Endless Survival: Enjoy a perfect, pick-up-and-play roguelite experience designed for quick, addictive workout sessions.\n\nZombie Fitness makes you forget you're working out. The adrenaline-pumping action is the perfect distraction,  more effective cardio and strength-training sessions.\n", "short_description": "Zombie Fitness: \n\nGet ready for the most thrilling fitness experience in VR! Zombie Fitness transforms your workout into a heart-pounding survival adventure. Duck and dodge arrows with real squats, then lean left and right to smash through hordes of realistic zombies.\n\nBattle through 5 incredible maps with unique visual styles, from dark realism to vibrant neon worlds. Face massive boss zombies that will test your strength and reflexes to the limit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/zombiefitness/", "developer_terms_of_service_url": null, "publisher_name": "Ascendrix Studio", "support_website_url": null, "website_url": "https://abdurrehmanmma12327.github.io/privacy-policy/zombiefitness/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2776542286000603"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24549806211374730"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1269499351776024"}, {"status": "PUBLISHED", "id": "3793005550994136"}, {"status": "PUBLISHED", "id": "895699339684217"}, {"status": "PUBLISHED", "id": "867035472391787"}, {"status": "CANCELLED", "id": "1332360511910940"}, {"status": "PUBLISHED", "id": "2596163797443491"}, {"status": "PUBLISHED", "id": "1373352581177130"}, {"status": "CANCELLED", "id": "1122662900034960"}, {"status": "PUBLISHED", "id": "1936225557234611"}, {"status": "PUBLISHED", "id": "1433028361097478"}, {"status": "CANCELLED", "id": "652632177574097"}, {"status": "PUBLISHED", "id": "1373255714515646"}, {"status": "PUBLISHED", "id": "753145890679806"}]}, "baseline_offer": {"id": "1373352581177130"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776452400, "status": "PUBLISHED", "id": "1269499351776024"}]}, "liveChannel": {"node
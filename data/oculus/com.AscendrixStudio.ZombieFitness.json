t-ord5-3.oculuscdn.com/v/t64.5771-25/491820496_25153544654312827_3606902093978631387_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovjfYQZ8OWEQ7kNvwHS3o1-&_nc_oc=AdmfOLeupnI2d3k5O5qcFuC2ywde6NYVNNAcbsTbSKRN1ui_qeZYYn21Qem8yJzojFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftP6c-MEs8v78eFtFqmq29NqaH-N3l2gat1ZEljuuwHVg&oe=69A42792"}, {"file_name": "2560x1440-screenshot (29).png", "id": "3776070896021450", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823270_3776070899354783_1245596548630707618_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MV3l0Qhss1sQ7kNvwGKmQOi&_nc_oc=Admn-bSwBCoIfliZwop4YestPvjYfshiwe12fGH-uKI_Bphpy2UMpOiDaN-fEYK9_RI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs6oG-38x31ByJ3MZVgQEAfFRXYjIUM46V4dbOVeicwqQ&oe=69A43E65"}, {"file_name": "2560x1440-screenshot (27).png", "id": "1189608243068025", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819323_1189608246401358_2671903566523338991_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHweLXn83asQ7kNvwH87SsF&_nc_oc=Adkg7wlvoTmhtmpLjhw4LGip_Geu-icYLwn8QgBj4HMDJTKiTIgSStkv3EME2hjbCIw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afvo4IJDpbcHZf6efx013W8un6QkjTzGNDwTb7TxvsGtNA&oe=69A437D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 3.png", "id": "831700102786383", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823296_831700106119716_1961501613371539496_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdBAPTk26s4Q7kNvwE6NJn-&_nc_oc=AdlIKyFCBsve1u9_eeY3mwP9_wZsYscN38L9QOxg6a0YX0RUFPeIulyP3a4SE3PQEPU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsll-szzYAf_XjVaSrjIHnG67Xl7OnELmIbHDaXSDFSuQ&oe=69A4238A"}, "display_name": "Zombie Fitness", "keywords": ["ZombieShooting", "HorrorShooting", "HorrorGame", "Fitness", "VRShooting"], "long_description": "Zombie Fitness \ud83d\udd2b\ud83d\udc80\nYOUR ULTIMATE INTENSE VR ZOMBIE APOCALYPSE SIMULATOR!\n\n\ud83e\udddf FACE 5 ZOMBIE TYPES from shambling Walkers to massive Boss monsters! Survive 10 STORY MISSIONS + INFINITE HORDE MODE across 5 MASSIVE MAPS:\n\u2705 Urban Decay: Blast through hyper-realistic city chaos!\n\u2705 Neon Nightmare: Light up glowing zombies in a vibrant cyberpunk wasteland!\n\u2705 Frozen Outpost: Survive the icy terror and snowy silence!\n\u2705 Abandoned Asylum: Close-quarters horror around every corner!\n\u2705 Radioactive Ruins: Mutated threats in a toxic environment!\n\n\ud83d\udd25 KEY FEATURES:\n\ud83e\udddf THRILLING RUN-&-GUN GAMEPLAY: Intense action from start to finish! Smash through hordes, dodge lethal projectile attacks, and execute perfect headshots for massive damage!\n\ud83c\udfae IMMERSIVE VR MECHANICS: Realistic physics-based weapon handling, dynamic weather effects, and a complete day/night cycle that changes the zombies' behavior and aggression!\n\ud83c\udf0d OPEN-ARENA COMBAT: Roam freely through ultra-detailed, explorable environments to find ammo, health packs, and strategic choke points!\n\ud83d\udca5 ADAPT OR DIE: Each zombie type requires a different strategy. Kite the Runners, focus-fire the Tanks, and always watch your back!\n\ud83d\udcaf ZERO PAYWALLS: All weapons, maps, and modes are 100% FREE & UNLOCKABLE through gameplay!\n\n\ud83c\udfc6 PERFECT FOR: #VRShooter fans \ud83c\udfae #MetaQuest explorers \ud83c\udf10 #ZombieGame addicts \ud83e\udddf\u200d\u2642\ufe0f #ActionGaming\n\n\ud83d\udc49 DOWNLOAD NOW!\nOnly on the Meta Horizon Store\nSearch: \ud83d\udd0e \"Zombie Fitness\"\n\nQuest 2/3/Pro ", "short_description": "Zombie Fitness \ud83d\udd2b\ud83d\udc80\nULTIMATE VR ZOMBIE SHOOTER! Wield 5 weapons & survive 10 story missions + endless hordes across 5 massive maps! Realistic physics, dynamic weather & total exploration. 100% FREE content!\n\n#VRShooter #MetaQuest\n\nDOWNLOAD NOW!\nMeta Horizon Store"}]}, "developer_name": null, "developer_privacy_policy_url": "https://abdurrehmanmma12327.github.io/privacy-policy/zombiefitness/", "developer_terms_of_service
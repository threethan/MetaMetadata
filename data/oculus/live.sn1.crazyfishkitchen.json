31102_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ln7Dt4u0Nx8Q7kNvwELhoup&_nc_oc=Adr2uAM0blK7gGDRai3QTxZmT9GD07kLiwn-h4ELkac0yt0yg4iaKGXFx7TBXzAC-w0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5_y1pL0m6iWRFfOJt3DGfBtES8ezLNISQFj2-dwbPSw&oe=6A5F7089"}, {"file_name": "meta-cf-kitchen-5.png", "id": "742664701973559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622290_742664708640225_6956521530622514009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yuhbJrGIi8Q7kNvwG7LhxE&_nc_oc=AdoCCrzri3owF7jd_Y7nRLx_7uv0atyIXX31ufuXaShN3X7ZSUhQLX8Gyck08DZNjMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCICSd0QtBSZnNKOwHRydEpRVsGtY4V1A6iEsc4NkF5jw&oe=6A5F64C7"}, {"file_name": "meta-cf-kitchen-6.png", "id": "1830294280966710", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303391_1830294284300043_5466639759460132324_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlaxdTeCp2oQ7kNvwFq9CNZ&_nc_oc=AdoWxo-PrH4Myp7IQOms-thzT9XZVMZ9Tr4ho6hBcz5DYGYVbL1rSKtXR0MUL_k6lpI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCApLf5gAlGZIc5_Bfqhf5lnnJwFrOvFfczWQstLhgpOQ&oe=6A5F7925"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "new-meta-landscape-cf.png", "id": "958406516571528", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307602_958406519904861_8357505864776864042_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sFy2yUIsAcQ7kNvwEA70W-&_nc_oc=AdrV5eD42nGVoHLHk-qqNbYiWENz6unrrF63aokNRaWBrcvyBDbgoIGilYsOdt8_QA4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOnlCJ7_mH3sAG55k5iEHqFQZvR4VVz5bdx0BqmzKwng&oe=6A5F8B4C"}, "display_name": "CrazyFish Chapter 6: Into the Kitchen", "keywords": ["crazyfish", "kitchen", "cooking", "multiplayer"], "long_description": "# Can you survive the chaos of the **CRAZYFISH KITCHEN**?\n- **Fast paced meal creation** - Chop, stir, bake, and serve before time runs out!\n- **Quirky grab mechanics** - No thumbs? No problem! Stretch, fling, and snatch your way to culinary glory.\n- **Ever-changing challenges** - Each level brings new recipes, obstacles, and kitchen madness.\n\n**Single player not enough? Team up with a friend and take multiplayer mayhem to the next level!**\n\nEarn stars as you cook and use them to customize your chef! Unlock wacky new heads or stylish hats!\n\nFrom chopping crisp lettuce to baking golden bread, you\u2019ll tackle a variety of recipes. But don\u2019t get too careless\u2026 one wrong move and the kitchen might just go up in flames!\n# GRAB NOW, EVOLVE LATER\n\nNo thumbs? No problem! Snatch, scoop, and secure ingredients using just your controllers; who needs thumbs anyway?\n{1297706162446129}\n# REACH BEYOND REASON\n\nDropped an item? Fear not! Launch items straight into your hands with a trigger pull and embrace your inner noodle-armed hero.\n{1300452858606902}\n# CUTTING EDGE CUISINE\n\nGrab a knife, chop those ingredients down to size, and try not to turn dinner into a disaster.\n{2098688720927149}\n# FROM CEREAL TO CULINARY HERO\n\nIf cereal counts as cooking, this game is your redemption arc. Chop, add, cook, and serve. Just be careful about the fire...\n{1998662781029560}\n# BAKING GONE WILD\n\nMix, bake... survive! Prep your ingredients, toss them in, and hope your creation doesn\u2019t turn the stove into a bonfire. From sweet treats to savory experiments, only the brave, or lucky, will serve up perfection.\n{1205030691701750}", "short_description": "Chop, cook, and serve meals in the CrazyFish Kitchen! Explore a new VR cooking challenge with never-before-seen item grabbing mechanics! Collect stars to unlock new levels and (coming soon) items!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crazyfish.io/#privacy", "developer_terms_of_service_url": "https://crazyfish.io/#terms", "publisher_name": "SN1 LLC", "support_website_url": null, "website_url": "https://crazyfish.io/", "category": null, "comfort_rating": "COM
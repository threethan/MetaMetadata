31102_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7hLk9xXEqAQ7kNvwHtYVoA&_nc_oc=Adp_cMsIEew20OEIr1gviB4QeLooVVGe8GoU38zHh3SxtyRqQCZVjScH2GMwmncN0B8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XMgMuNiR02P4rKCm_J0NHHShjE2hnnh_4oB6TuuPyHw&oe=69DF8F09"}, {"file_name": "meta-cf-kitchen-5.png", "id": "742664701973559", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622290_742664708640225_6956521530622514009_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTRKKiYxl0gQ7kNvwF4wCxl&_nc_oc=AdoxAI6t3Crk_Tc70OmG0RMlOYZJ7wtzYC1f3ergOxsi0iPEwTu-1KdTPK0R0n0Z4rw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0l11sFuXrhszAoea6YQcmemuMfUSPftPBaeTks5ivZGg&oe=69DF8347"}, {"file_name": "meta-cf-kitchen-6.png", "id": "1830294280966710", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303391_1830294284300043_5466639759460132324_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhnFFv0eMC4Q7kNvwEPWBhB&_nc_oc=AdpoWhlOulT36ymBR6bqnSEx6nAzoad5yt3sIENneAo-MR_MRzmbTrn9NecDwvCHU1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aI8VhoF7kXRmoCYyK1pFYThXgAOKHqp7qYQozYD-MFQ&oe=69DF97A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "new-meta-landscape-cf.png", "id": "958406516571528", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307602_958406519904861_8357505864776864042_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNDqYkIneBkQ7kNvwGB5tt8&_nc_oc=Adrk1zkpyXNMF7XqtC2w-U0B-l1_y7e8QzMg1ck9w9zwx89iFlBvxJKEFI1MnExpI3A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HCYV-avKo6qw2Btqu9KwD0j6aFYOhLq4KpdT4KzHluA&oe=69DF718C"}, "display_name": "CrazyFish Chapter 6: Into the Kitchen", "keywords": ["crazyfish", "kitchen", "cooking", "multiplayer"], "long_description": "# Can you survive the chaos of the **CRAZYFISH KITCHEN**?\n- **Fast paced meal creation** - Chop, stir, bake, and serve before time runs out!\n- **Quirky grab mechanics** - No thumbs? No problem! Stretch, fling, and snatch your way to culinary glory.\n- **Ever-changing challenges** - Each level brings new recipes, obstacles, and kitchen madness.\n\n**Single player not enough? Team up with a friend and take multiplayer mayhem to the next level!**\n\nEarn stars as you cook and use them to customize your chef! Unlock wacky new heads or stylish hats!\n\nFrom chopping crisp lettuce to baking golden bread, you\u2019ll tackle a variety of recipes. But don\u2019t get too careless\u2026 one wrong move and the kitchen might just go up in flames!\n# GRAB NOW, EVOLVE LATER\n\nNo thumbs? No problem! Snatch, scoop, and secure ingredients using just your controllers; who needs thumbs anyway?\n{1297706162446129}\n# REACH BEYOND REASON\n\nDropped an item? Fear not! Launch items straight into your hands with a trigger pull and embrace your inner noodle-armed hero.\n{1300452858606902}\n# CUTTING EDGE CUISINE\n\nGrab a knife, chop those ingredients down to size, and try not to turn dinner into a disaster.\n{2098688720927149}\n# FROM CEREAL TO CULINARY HERO\n\nIf cereal counts as cooking, this game is your redemption arc. Chop, add, cook, and serve. Just be careful about the fire...\n{1998662781029560}\n# BAKING GONE WILD\n\nMix, bake... survive! Prep your ingredients, toss them in, and hope your creation doesn\u2019t turn the stove into a bonfire. From sweet treats to savory experiments, only the brave, or lucky, will serve up perfection.\n{1205030691701750}", "short_description": "Chop, cook, and serve meals in the CrazyFish Kitchen! Explore a new VR cooking challenge with never-before-seen item grabbing mechanics! Collect stars to unlock new levels and (coming soon) items!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crazyfish.io/#privacy", "developer_terms_of_service_url": "https://crazyfish.io/#terms", "publisher_name": "SN1 LLC", "support_website_url": null, "website_url": "https://crazyfish.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "26044749581888383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499300897_1633866601264339_4279874377359047663_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbob9JWSfVIQ7kNvwHI53VK&_nc_oc=AdrC52PhOt4vMaSGVSeXU51K-DISAmTyAtab-LaKTFEXwklJxZQFM5-xs78aC0JTXV4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yidSrAZqzR4rA_UXSt6aomBy2wzvbjEiTUk8eQlVSuw&oe=69DF7AB9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CrazyFish Chapter 6: Into the Kitchen", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1774195200, "lastRevision": {"nodes": [{"id": "25078925048470846", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25078924971804187", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1443499563857507"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes":
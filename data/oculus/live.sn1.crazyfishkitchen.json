vKIpSldJUlNd5S-2OM7-8WMmSg&oe=6B0863F8"}, {"file_name": "meta-cf-kitchen-4.png", "id": "4390983687853584", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499305050_4390983694520250_6486791717460031102_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2CRIF-tBqsQ7kNvwEy31of&_nc_oc=Ado7EAlJoyRRZrbhveljJa5JG3Q6MEaIRWUHW0CuBjfkHhMlJshHme410kpT3AhfFUQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhA3OWfiHa_L0mTkybjSWNQPKrGlmQUNEl87uMUPH1_w&oe=6B0868C9"}, {"file_name": "meta-cf-kitchen-5.png", "id": "742664701973559", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499622290_742664708640225_6956521530622514009_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmAWpjXOltwQ7kNvwGHLcqS&_nc_oc=Adr7vgNHZkeNzijkVTqujD7F6He9y8XjnoJQrBe6mMZYmsZdAapwCkDtsSsZWNMCW4U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrfzpYQ1uuveEPycD7-jaMoEHsGy0-TXVAQIgB22BWMg&oe=6B085D07"}, {"file_name": "meta-cf-kitchen-6.png", "id": "1830294280966710", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499303391_1830294284300043_5466639759460132324_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uf9cKTzR2NcQ7kNvwGN1U-7&_nc_oc=Ado_JRxn7K0OA5022IDx-XS4T9dfzKUUnCHS-UMyw5EJGXWjsWrjoHU2KYjI4eFyZ4A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-SY_CrDvEOfrJL6lLKzL1V1yIrWO7v-O_6lECkG2C2Q&oe=6B087165"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "new-meta-landscape-cf.png", "id": "958406516571528", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499307602_958406519904861_8357505864776864042_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nr_077bRQTIQ7kNvwHLkTr7&_nc_oc=AdqY5LpeU1Gq9ZfGli-hGJyfJzZgrEAzWPWu9felyebOzjRyZpw8yEnSo-H8RSJNdUw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM6GuAav55OPw4Lwk2cA2oWB8z_mpf04fZ8FfyiAvGWg&oe=6B084B4C"}, "display_name": "CrazyFish Chapter 6: Into the Kitchen", "keywords": ["crazyfish", "kitchen", "cooking", "multiplayer"], "long_description": "# Can you survive the chaos of the **CRAZYFISH KITCHEN**?\n- **Fast paced meal creation** - Chop, stir, bake, and serve before time runs out!\n- **Quirky grab mechanics** - No thumbs? No problem! Stretch, fling, and snatch your way to culinary glory.\n- **Ever-changing challenges** - Each level brings new recipes, obstacles, and kitchen madness.\n\n**Single player not enough? Team up with a friend and take multiplayer mayhem to the next level!**\n\nEarn stars as you cook and use them to customize your chef! Unlock wacky new heads or stylish hats!\n\nFrom chopping crisp lettuce to baking golden bread, you\u2019ll tackle a variety of recipes. But don\u2019t get too careless\u2026 one wrong move and the kitchen might just go up in flames!\n# GRAB NOW, EVOLVE LATER\n\nNo thumbs? No problem! Snatch, scoop, and secure ingredients using just your controllers; who needs thumbs anyway?\n{1297706162446129}\n# REACH BEYOND REASON\n\nDropped an item? Fear not! Launch items straight into your hands with a trigger pull and embrace your inner noodle-armed hero.\n{1300452858606902}\n# CUTTING EDGE CUISINE\n\nGrab a knife, chop those ingredients down to size, and try not to turn dinner into a disaster.\n{2098688720927149}\n# FROM CEREAL TO CULINARY HERO\n\nIf cereal counts as cooking, this game is your redemption arc. Chop, add, cook, and serve. Just be careful about the fire...\n{1998662781029560}\n# BAKING GONE WILD\n\nMix, bake... survive! Prep your ingredients, toss them in, and hope your creation doesn\u2019t turn the stove into a bonfire. From sweet treats to savory experiments, only the brave, or lucky, will serve up perfection.\n{1205030691701750}", "short_description": "Chop, cook, and serve meals in the CrazyFish Kitchen! Explore a new VR cooking challenge with never-before-seen item grabbing mechanics! Collect stars to unlock new levels and (coming soon) items!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://crazyfish.io/#privacy", "developer_terms_of_service_url": "https://crazyfish.io/#terms", "publisher_name": "SN1 LLC", "support_website_url": null, "website_url": "https://crazyfish.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "26044749581888383"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499300897_1633866601264339_4279874377359047663_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01buf8BLbyEQ7kNvwH751kg&_nc_oc=Adrxgy_46S-ALPZ1C-GsNt9ocAwZqgThgncacGPT2Ns0QvjzZ9TIf69f3KjsIezuv-I&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA1XaipjMqBtEZVduzBusz3KeauY-I2VBhf4gHJJw7Rg&oe=6B085479"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CrazyFish Chapter 6: Into the Kitchen", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1774195200, "lastRevision": {"nodes": [{"id": "25078925048470846", "release_type": "SCHEDULED", "administrat
U4Q7kNvwEj4XyG&_nc_oc=AdonOZacbTTquTVuqX9cT0icTlTfCvmaQN9-SaR_mJJppCKbHgT6fV0tdZsGAmohzTE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsdsXwvBi0n76iKV7S1Mo6N257zifVq7rF1IjLDwVCYA&oe=6AECB536"}, "display_name": "Disembodied", "keywords": ["Hands", "Climb", "editor", "hand", "platformer"], "long_description": "# Hands Only\nDisembodied is a mixed reality platformer that turns your real hand movements into precise, physics-driven gameplay, taking hand tracking to a whole new level.\n\n# Gameplay\nGuide the hands through a range of different challenges, including platform, stealth, and puzzle solving levels. Play seated or standing.\n\n# Physics\nInteract with the environment in a natural way. A lot of time has gone into experimenting with physics, and gameplay mechanics, to make the hands feel responsive and intuitive.\n\n# Power-Ups\nCollect Power-Ups, then make hand gestures to activate them. It\u2019s extremely satisfying punching through brick walls and shooting your hand gun (especially at your cat).\n\n# Level Editor\nYou'll be able to create levels using hand tracking, test them instantly, and upload for the community to enjoy.", "short_description": "Disembodied is a mixed reality platformer that turns your real hand movements into precise, physics-driven gameplay, taking hand tracking to a whole new level."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Gku00KOhlmUTbC5j4SSnQnJNBVu-cxJTQaRYjY6vb7Q/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Middle Man Games", "support_website_url": "https://discord.gg/UucU2CtKba", "website_url": "https://www.middlemangames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUI
RMrGuhezy4Awrz49BV2_MnWwakA&oe=6AE9EA66"}, {"file_name": "Advanced Level 1.png", "id": "1586613786533401", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1586613789866734_843181411707874901_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3gD5HSQadmAQ7kNvwEjWOce&_nc_oc=AdocgI7NZs6FvGWkQ3EQmZO1GgdvPXJuWYv5wRaZWHZn8s6tQTbt84Dlo9Y4udUB_KE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOZzACttT-T8_StZCrnOCK3rCCVAtHnxghAYKioYj2sQ&oe=6AE9F04B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "2133731050831894", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823910_2133731054165227_3920193009895138606_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyLcY-JScl4Q7kNvwFGyA4i&_nc_oc=AdofCWvPwt3FbGedCLcyAMTPPe8hkhgdv4u65Oph-xeEi8PCvTi3fFMsBiHBeLcX1gg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2mgGKUJOIzINbju0zLtacVje8F6_qNKYbf36yi8OQBA&oe=6AE9EB03"}, "display_name": "Disembodied", "keywords": ["Hands", "editor", "obby", "fingers", "laser"], "long_description": "# Disembodied is... It's kind of like... It's sort of... Well it's a bit different.\nYou won't need your controllers here.\n# Hands Only\nControl a pair of disembodied hands, that will magically copy what your real hands do.\n{1519756372988303}\n\n# Gameplay\nPlay **seated** or **standing**. Manoeuvre the hands through **175 levels**, featuring a wide range of mechanics. From pure climbing courses, to precision laser challenges, to chilled puzzle levels, to fast pace chaos.\n\n{1360094156019779}\n\n# Physics\nFind your own style with precise, physics-driven movement.\n{1072159745163057}\n\n# Power-Ups\nCollect Power-Ups, then make hand gestures to activate them.\n{1047441641299010}\n\n# Level Editor\nCreate your own levels and test them instantly using the advanced level editor.\n{1347237033579391}\n\n# Mixed Reality\nGet fully immersed with advanced light settings and full occlusion (see real things in front of virtual things).\n*The Quest 2/Pro version doesn't have some Mixed Reality features, and the real world will be in black and white on Quest 2.\n{1568924741473517}\n\n# Early Access\nThe game will launch with a full single player campaign of 175 levels, and an experimental Level Editor. During the Early Access period I aim to refine the experience, and add more content, based on player feedback, so join the Discord to get involved.", "short_description": "Disembodied is... It's kind of like... It's sort of... Well it's a bit different.\n\nControl a pair of disembodied hands, that will magically copy what your real hands do.\n\nDisembodied is a mixed reality platformer with precise, physics-driven gameplay, taking hand tracking to a whole new level."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Gku00KOhlmUTbC5j4SSnQnJNBVu-cxJTQaRYjY6vb7Q/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Middle Man Games", "support_website_url": "https://discord.gg/UucU2CtKba", "website_url": "https://www.middlemangames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28170732812608943"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830576_180025007777704
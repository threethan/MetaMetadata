t them instantly, and upload for the community to enjoy.", "short_description": "Disembodied is a mixed reality platformer that turns your real hand movements into precise, physics-driven gameplay, taking hand tracking to a whole new level."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Gku00KOhlmUTbC5j4SSnQnJNBVu-cxJTQaRYjY6vb7Q/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Middle Man Games", "support_website_url": "https://discord.gg/UucU2CtKba", "website_url": "https://www.middlemangames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26085962071086038"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1103411818901848"}, {"status": "PUBLISHED", "id": "1118144907571324"}]}, "baseline_offer": {"id": "1103411818901848"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792083600, "status": "PUBLISHED", "id": "1103411818901848"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28384897491192473", "version": "0.10.21"}, "id": "1356928723122781", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Andro
tl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AK6hjIoaAOQZKS0F8JrbYnUp1qnvgsAEJVXdu_bT1wA&oe=6A3D5087"}, {"file_name": "screenshot_3.png", "id": "1227766012816966", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491831299_1227766016150299_7861574302426110873_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mc0ZhrRtepYQ7kNvwEWF7Sc&_nc_oc=AdqfxwwKuTbgNiX8RZ1jxOHQ8kkE_tGscOKPTbM3lhLUjHdldMT3I3XkYOFPh2_22X8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_JV78NdhNYd7nNkCDGUL6kikZTuM27H2Ewx0-AbOIbw&oe=6A3D34AC"}, {"file_name": "screenshot_4.png", "id": "2328660864311262", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828849_2328660867644595_1982552527014350799_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I22Jx04K4ecQ7kNvwEq3qaN&_nc_oc=AdqDO22GRHuGq4vFuGZsfJC3EnzSu_9ES1LTjrb2j1KkRSzDtkXtmVjLsFLa48wrGdU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QhnTb9cpBy2eJeScjlcnMaHRdsl_GGhnNQAh2BYUEYQ&oe=6A3D4B73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "1429383275234877", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618440_1429383281901543_4572824070173038999_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0L9_Jo7J7C4Q7kNvwHOjpTA&_nc_oc=AdqIlb_rNuNPsW5w_bEvWoN2MadMtKXKXSvmvdA2Th0Kem1Q8t8KOd0Ljbni1aqtalY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I4JykSPb29UbYUkcZLiVSeUGgCDJhtw2179jXshvsLg&oe=6A3D5190"}, "display_name": "Stringscape", "keywords": ["music", "handtracking", "interactivesound", "creativity", "immersive"], "long_description": "Stringscape is a musical VR experience where sound lives between your hands.\n\n[ Shape Sound in Mid-Air ]\nIn Stringscape, a glowing virtual string appears between your hands.\n - Bring your hands closer \u2192 the pitch rises \n - Move them apart \u2192 the pitch lowers \n - Hold the triggers or pinch with both hands \u2192 the string comes alive\nIt feels natural. Immediate. Playful.\n\n[ Full Controller & Hand Tracking Support ]\n- Controller Mode\nHold both triggers to generate sound.\nUse buttons to place static strings in your world and build layered soundscapes.\n\n- Hand Tracking Mode\nPinch with both hands to create sound.\nUse natural gestures to place and interact with strings \u2014 no controllers required.\n\nSwitch seamlessly between modes and play the way that feels right.\n\n[ Build Your Own Sonic Space ]\nBeyond the live string, you can:\n- Place static strings in the world\n- Pluck them to replay stored pitches\n- Layer tones to create ambient harmonies\n- Sculpt evolving sound textures around you\nTransform empty space into a glowing musical landscape.\n\nStep into the space between your hands.\nStretch the string.\nDiscover your sound.", "short_description": "Create music with your hands in VR.\nStretch a glowing string between your hands and shape pitch through movement \u2014 intuitive, expressive, and beautifully immersive."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/stringscape-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "LefthandDeveloper", "support_website_url": null, "website_url": "https://sites.google.com/view/stringscape/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25827426316878904"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618093_1532014407882845_9012696513336858615_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X2KwhTgrOI0Q7kNvwH_Xy3p&_nc_oc=AdpxzK1FwPyDkOehtKiOlQoGSLUGEbH3iKP96XANc1jNmxWzv-0-XACQ_4TFmycWpxw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NGQUQ9m_Lo_XWEkMP45WjfaIEkP8_j3Ym8CmE8_Z3ew&oe=6A3D54D8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Stringscape", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1771287720, "lastRevision": {"nodes": [{"id": "25671061732515364", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25671061682515369", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1870415880272437"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "CoverArt_1008x1440.png", "id": "2253360078528497", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823395_2253360081861830_3456584926765282176_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ms4jJUrGH9QQ7kNvwEe_fiw&_nc_oc=AdoPFJCDGBSYIYEyH7YkrKlcaVtbv1ccCVsuQfPmapyAh6qzuR6N-cG2I21OdkYrFBs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TSBv0gMgFVq3-urSr1EA7GcrmtTCJL2xaifweMqCa_Q&oe=6A3D4179"}, {"file_name": "CoverArt_1440x1440.png", "id": "1532014401216179", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618093_1532014407882845_9012696513336858615_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7
rtu\u00e1ln\u00ed realit\u011b! Na\u0161e unik\u00e1tn\u00ed aplikace v\u00e1m p\u0159in\u00e1\u0161\u00ed mo\u017enost poskl\u00e1dat t\u0159i ikonick\u00e9 modely: traktor, dvouplo\u0161n\u00edk a rypadlo. Prost\u0159ednictv\u00edm br\u00fdl\u00ed Oculus Quest m\u016f\u017eete ka\u017ed\u00fd \u0161roubek, ka\u017ed\u00fd d\u00edlek sestavit tak, jako byste dr\u017eeli skute\u010dnou stavebnici v rukou.\n\nSimulace sestavov\u00e1n\u00ed v\u00e1s pono\u0159\u00ed do \u00fapln\u011b nov\u00e9ho z\u00e1\u017eitku, kter\u00fd spojuje tradici s modern\u00ed technologi\u00ed. Stav\u011bjte, objevujte a u\u010dte se, jak skv\u011ble funguj\u00ed Merkur stavebnice!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.merkurtoys.cz/podminky-aplikace", "developer_terms_of_service_url": null, "publisher_name": "Merkurtoys", "support_website_url": null, "website_url": "https://www.merkurtoys.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30887891647492588"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974515_1327864954819982_314862086249660228_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y0J8RtNsa9cQ7kNvwEgoRF4&_nc_oc=AdpNW4LsTilOurqjFzaXnBCi1cMVeX1drAfon6g4uoZFbEI4yl6y1_NKLPCodKv0pI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f
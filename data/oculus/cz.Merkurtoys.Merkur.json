 Quest m\u016f\u017eete ka\u017ed\u00fd \u0161roubek, ka\u017ed\u00fd d\u00edlek sestavit tak, jako byste dr\u017eeli skute\u010dnou stavebnici v rukou.\n\nSimulace sestavov\u00e1n\u00ed v\u00e1s pono\u0159\u00ed do \u00fapln\u011b nov\u00e9ho z\u00e1\u017eitku, kter\u00fd spojuje tradici s modern\u00ed technologi\u00ed. Stav\u011bjte, objevujte a u\u010dte se, jak skv\u011ble funguj\u00ed Merkur stavebnice!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.merkurtoys.cz/index.php/vitejte/podminky-uzivani-aplikace", "developer_terms_of_service_url": null, "publisher_name": "Merkurtoys", "support_website_url": null, "website_url": "https://www.merkurtoys.cz/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1622195181523345"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "269897829080417"}]}, "baseline_offer": {"id": "269897829080417"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1692804233, "status": "PUBLISHED", "id": "269897829080417"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9736335119741548", "version": "1.1"}, "id": "321043603595335", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "bin
nick\u00e9 modely: traktor, dvouplo\u0161n\u00edk a rypadlo. Prost\u0159ednictv\u00edm br\u00fdl\u00ed Oculus Quest m\u016f\u017eete ka\u017ed\u00fd \u0161roubek, ka\u017ed\u00fd d\u00edlek sestavit tak, jako byste dr\u017eeli skute\u010dnou stavebnici v rukou.\n\nSimulace sestavov\u00e1n\u00ed v\u00e1s pono\u0159\u00ed do \u00fapln\u011b nov\u00e9ho z\u00e1\u017eitku, kter\u00fd spojuje tradici s modern\u00ed technologi\u00ed. Stav\u011bjte, objevujte a u\u010dte se, jak skv\u011ble funguj\u00ed Merkur stavebnice!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.merkurtoys.cz/podminky-aplikace", "developer_terms_of_service_url": null, "publisher_name": "Merkurtoys", "support_website_url": null, "website_url": "https://www.merkurtoys.cz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30887891647492588"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974515_1327864954819982_314862086249660228_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fy4DBksOxO4Q7kNvwGXxJBp&_nc_oc=AdlDF21wM5yAjCoK3oUtEFFBz2KXmb9DTABOToBiMfoTasCRYJpTu6gLF8GfOUnRYls&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftqRQK1FjntNgJM3W2EZkJON1b-TJMeaGY6D5BVe5lm5A&oe=69A6D7D6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Merk
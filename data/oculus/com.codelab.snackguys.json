331520368_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAUy5gN4X6QQ7kNvwEMMqHn&_nc_oc=AdqW71ywt283moKhc4u0TCzX-qBX5RfIir-j1NTinj_QfxGMhuKmQnNX1u5cs2474nU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVZ1FGox-cpMnTUkpMwUQY1mYI5pPokG9oSnK-k2StwA&oe=6A8D6655"}, {"file_name": "gameplay7.png", "id": "2092526777796282", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57566678_2092526781129615_1159087057712793516_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ilhv8oI13CsQ7kNvwHm2aQ-&_nc_oc=AdqmcQxyw4eOAYr1VbvjPeKGXl2cY5MEPdudjACvX8ja5_E8X_iT5OQFxraLIh5ACMc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-G8Oflypc4TyAmHmPzM2Jjfx5wsfvun1mBGPlMhiK1A&oe=6A8D9D2C"}, {"file_name": "gameplay6.png", "id": "1153900632285026", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75254871_1153900635618359_967611476036136599_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePNOnDnlYEoQ7kNvwElfKSj&_nc_oc=AdoNc_X95O_qV2RI7A9YkfVFDP4SYyejp6A_Dsz5Moqc6wDe5t3MSCNMFKAvbrEC-pQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFn7fqp6IZaWQCCvmmib356JJlGwJGtomp_2aavJtCD3Q&oe=6A8D67A0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 copy.png", "id": "525154846987742", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974465_525154850321075_6222509634223683072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fp2gC8AwOCcQ7kNvwHvJCdn&_nc_oc=Adrh_KntKNvex4KsUCIYeUakUBKQ5P31ZBu-95Z2cFJYtutDiF2WzusVAsp-JAWxgcA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG62SCr5W4_j8AZtyxCKAdzG0H4j0l9ThzBY8HYiurANg&oe=6A8D663E"}, "display_name": "Snack Guys", "keywords": [], "long_description": "Get ready to embark on an electrifying experience, entering competitions full of obstacles and furious enemies in an exciting virtual reality (VR) game. With a MULTIPLAYER mode and a variety of different courses, each player must reach the finish line as quickly as possible to save Snackland from the legion of intergalactic robots. But the fun doesn't stop there! Only a limited number of players can work together, and with each round, the game becomes more challenging with more enemies and increasingly difficult obstacles. Immerse yourself in a world of challenges and experiences shared with other players, testing your platforming skills to the fullest. Get ready for thrilling action and collaborative gameplay like never before!", "short_description": "Embark on exciting multiplayer virtual reality competitions. Save Snackland from angry intergalactic robots, racing against time on several challenging courses. Work as a team, overcome obstacles and constantly evolving enemies. Get ready for high-octane action and unparalleled collaborative fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-snack-guys", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "25518236521148164"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499304952_1940525550122330_8962949056219766580_n.png?stp=dst-p
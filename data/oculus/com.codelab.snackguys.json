R2R5hFI7b8TmS6DrAgen3WymTlKQ7LoSvBHU69Qb6agM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsTp58vJH0LEu45jCeumyhPE7SPNoTfYtR2a4-x1ZH6Qg&oe=69A6E815"}, {"file_name": "gameplay7.png", "id": "2092526777796282", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566678_2092526781129615_1159087057712793516_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ute7w5djCjkQ7kNvwHswj3X&_nc_oc=Adkb_nF5jEM4eIsjHyE4jimkD11xpSD42ctsZu3_zBMK4Lguyt8g0wsSIR7NxdBwetQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftFAauhHqlO0fEnRaWDXvxXNMdLL2KJI7rhBH_xjwXaHg&oe=69A6E6AC"}, {"file_name": "gameplay6.png", "id": "1153900632285026", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254871_1153900635618359_967611476036136599_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpsdJQJyJCgQ7kNvwHU90AI&_nc_oc=AdmlQmQ7YbDfmbVJG1atwkHiB6UDDSuXFpaMUO9Zr_URZ_lGVdqXWFF8nHdEbKYStpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmnmxJgvaIy7jFP2JPMZUXOWRX9JCzmSwCc7Jy2nsEYw&oe=69A6E960"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 copy.png", "id": "525154846987742", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974465_525154850321075_6222509634223683072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ok0cVbuDYu4Q7kNvwGbZFp9&_nc_oc=AdnMt8x0eTvEwwwbXF4CZVXPytlkzXxW2MSjWysF7DS9RFD9mYvedPcWOkTSMRikTN0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsutwzEjD2G96CVtwfincln1YdXhLLktg5EVAnwLo1ceA&oe=69A6E7FE"}, "display_name": "Snack Guys", "keywords": [], "long_description": "Get ready to embark on an electrifying experience, entering competitions full of obstacles and furious enemies in an exciting virtual reality (VR) game. With a MULTIPLAYER mode and a variety of different courses, each player must reach the finish line as quickly as possible to save Snackland from the legion of intergalactic robots. But the fun doesn't stop there! Only a limited number of players can work together, and with each round, the game becomes more challenging with more enemies and increasingly difficult obstacles. Immerse yourself in a world of challenges and experiences shared with other players, testing your platforming skills to the fullest. Get ready for thrilling action and collaborative gameplay like never before!", "short_description": "Embark on exciting multiplayer virtual reality competitions. Save Snackland from angry intergalactic robots, racing against time on several challenging courses. Work as a team, overcome obstacles and constantly evolving enemies. Get ready for high-octane action and unparalleled collaborative fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-snack-guys", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "25518236521148164"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304952_1940525550122330_8962949056219766580_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiczVaK8YPgQ7kNvwGSrbaZ&_nc_oc=AdmueeYcaa41O_tMAwq_RAxXSoH_Mh-Fcybu1KAi5yoebAn3ZHhmj4KIqkho5Y4Has4&_nc_zt=3&_nc_ht=s
OFfR415rrZSETIoShIHrnbn1Of8qPXfSnpCXJm9VE0PI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvEG-MQRM6T9LjikMBlTNE-5KfuRhVdA1ns4BJ36SHHxg&oe=699DAD95"}, {"file_name": "gameplay7.png", "id": "2092526777796282", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566678_2092526781129615_1159087057712793516_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3tpY4a911EQ7kNvwHqqBi8&_nc_oc=Adl4R7ordplo5-9CuPBhzcxkkYfQ1S1FMepObiI25iML5IIOzJadpKCsiwFeGL7oA-I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudJB4TjrV5PPMu59CLu9bSTU8ARq2rkqEw7NcX6hF8Eg&oe=699DAC2C"}, {"file_name": "gameplay6.png", "id": "1153900632285026", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254871_1153900635618359_967611476036136599_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5a2sFy98kcQ7kNvwESZQLr&_nc_oc=AdniOqK-pt0RimlGxT5X1pR2O1yLijs0GoS-wraPboNSNHP4tbDs8BQm5L70H-M61Fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftdrw4q2gZiOoqKwtajGMhyD93RKVi8EJRl-4ufe-e6Vw&oe=699DAEE0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 copy.png", "id": "525154846987742", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974465_525154850321075_6222509634223683072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOc_KCPUbywQ7kNvwH3THdA&_nc_oc=AdmgpCP3IuHxM5p2W4sq40TO-WxvYYhFH4f2RF4cZW7A1NyEFtlUDaCEcmEyqnNz7zw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsQtR_Qlgi2tg8d0Ov0i4LWm7YvxK8bP6iPKYgDI-lj8g&oe=699DAD7E"}, "display_name": "Snack Guys", "keywords": [], "long_description": "Get ready to embark on an electrifying experience, entering competitions full of obstacles and furious enemies in an exciting virtual reality (VR) game. With a MULTIPLAYER mode and a variety of different courses, each player must reach the finish line as quickly as possible to save Snackland from the legion of intergalactic robots. But the fun doesn't stop there! Only a limited number of players can work together, and with each round, the game becomes more challenging with more enemies and increasingly difficult obstacles. Immerse yourself in a world of challenges and experiences shared with other players, testing your platforming skills to the fullest. Get ready for thrilling action and collaborative gameplay like never before!", "short_description": "Embark on exciting multiplayer virtual reality competitions. Save Snackland from angry intergalactic robots, racing against time on several challenging courses. Work as a team, overcome obstacles and constantly evolving enemies. Get ready for high-octane action and unparalleled collaborative fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-snack-guys", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "25518236521148164"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304952_1940525550122330_8962949056219766580_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6MYSr82xPQQ7kNvwFK4haU&_nc_oc=AdlpyTkCAagLxzFLU0kwC4nBfC3xnE3i60sP9tdx5VCBZO3Jesl4mSjR2z_MXFI0cnM&_nc_zt=3&_nc_ht=s
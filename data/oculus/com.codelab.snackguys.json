06&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGFi8yvDoT0Q7kNvwEmaLfo&_nc_oc=Adro4XUVwf9WOX0QdUcrv-2KaKAUk6vBpSYYNT3IwoPsMlwEDHUpLQOq2oNaQqquZbA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mKOSVzJP6EYzXzHVE25bYyCMNiv_LfTzJu6_Exq3hSg&oe=6A466D95"}, {"file_name": "gameplay7.png", "id": "2092526777796282", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566678_2092526781129615_1159087057712793516_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GeYEnOzkXcQ7kNvwHsmONI&_nc_oc=AdreT9KVj2WwmgyB-93dlAkfGz8e5Mv06FgfVUt71IBde_KEQchjvDx1KxpwGEjuX_M&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_29lOpIRwRFjYlxx2CSJF71KSKx6oNVZTBDAFD08eHZg&oe=6A466C2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440-Cover Art2.png", "id": "3268532976783904", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75289720_3268532980117237_6702800773162894276_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFr7aaBsSTcQ7kNvwGK58n1&_nc_oc=Adq07qRfOf2ia8Tx7c9x1tcFXv4PV8hUzgZ2HjXvTTm7XFW1Fa0ly_4p7mD0R4-I6qA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_c5rgxjsjyzOfaLaTRQyAm4ZHxrQ_tlpsi9zvC47yLfg&oe=6A46810B"}, "display_name": "Snack Guys", "keywords": [], "long_description": "Get ready to embark on an electrifying experience, entering competitions full of obstacles and furious enemies in an exciting virtual reality (VR) game. With a MULTIPLAYER mode and a variety of different courses, each player must reach the finish line as quickly as possible to save Snackland from the legion of intergalactic robots. But the fun doesn't stop there! Only a limited number of players can work together, and with each round, the game becomes more challenging with more enemies and increasingly difficult obstacles. Immerse yourself in a world of challenges and experiences shared with other players, testing your platforming skills to the fullest. Get ready for thrilling action and collaborative gameplay like never before!", "short_description": "Embark on exciting multiplayer virtual reality competitions. Save Snackland from angry intergalactic robots, racing against time on several challenging courses. Work as a team, overcome obstacles and constantly evolving enemies. Get ready for high-octane action and unparalleled collaborative fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelab.megatextos.com.br/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelab.megatextos.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "7472332062831886"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PENDING", "id": "4422366474649504"}, {"status": "PUBLISHED", "id": "2196483534174130"}, {"status": "CANCELLED", "id": "1482125846353892"}, {"status": "PUBLISHED", "id": "804576672728431"}, {"status": "PUBLISHED", "id": "469597382621038"}, {"status": "PUBLISHED", "id": "738529105084643"}, {"status": "PUBLISHED", "id": "801893925134623"}]}, "baseline_offer": {"id": "2196483534174130"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "4422366474649504"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, 
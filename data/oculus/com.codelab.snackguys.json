331520368_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAUy5gN4X6QQ7kNvwFQBAPa&_nc_oc=AdqKp4dieu5HzkOGw_xWE6vyZecy-m8zt6k8eGYUoyFOpk5-Rxn_hB7ZqtBinXeTBes&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHB0vUr-oBQ8oTw0mqS9v1tWjl6Hm9h8MRVKXxWacBXDg&oe=6A8EF015"}, {"file_name": "gameplay7.png", "id": "2092526777796282", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57566678_2092526781129615_1159087057712793516_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ilhv8oI13CsQ7kNvwE6yh7D&_nc_oc=Adpll9fUx2g_xCfbMNaKBKw09FrapbJ9xX2-Ix6Feg2-H6W569xfPbreWEr4drt3OpY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-cPc1vg-OZ2YYdvpa4-rLzbcz0Wll_506uE7I0-RSzw&oe=6A8EEEAC"}, {"file_name": "gameplay6.png", "id": "1153900632285026", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75254871_1153900635618359_967611476036136599_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePNOnDnlYEoQ7kNvwHdnVb4&_nc_oc=AdpfucZTWp1RivsJdUJCQRnySdL6sduHcEdxc14CEm7sMHblSktkSVUhH8DaEmOzmnA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiwAZjZyFVeDQXjwKIZC25JFHoZ6DgIFxSFc9Gc_inTw&oe=6A8EF160"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 copy.png", "id": "525154846987742", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974465_525154850321075_6222509634223683072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVS4PzTudSIQ7kNvwGjJuLZ&_nc_oc=AdqWSgi56G1SxMS4MAy4Wolr6FTea2r9NtRG_WKiWqVqKDCzCwAoK9FizMdebx6wSDo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaj93u4MDjbBTpPlbpY18aCqpq2gb2gYhTpVg9U2Pklg&oe=6A8EEFFE"}, "display_name": "Snack Guys", "keywords": [], "long_description": "Get ready to embark on an electrifying experience, entering competitions full of obstacles and furious enemies in an exciting virtual reality (VR) game. With a MULTIPLAYER mode and a variety of different courses, each player must reach the finish line as quickly as possible to save Snackland from the legion of intergalactic robots. But the fun doesn't stop there! Only a limited number of players can work together, and with each round, the game becomes more challenging with more enemies and increasingly difficult obstacles. Immerse yourself in a world of challenges and experiences shared with other players, testing your platforming skills to the fullest. Get ready for thrilling action and collaborative gameplay like never before!", "short_description": "Embark on exciting multiplayer virtual reality competitions. Save Snackland from angry intergalactic robots, racing against time on several challenging courses. Work as a team, overcome obstacles and constantly evolving enemies. Get ready for high-octane action and unparalleled collaborative fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-snack-guys", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "25518236521148164"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499304952_1940525550122330_8962949056219766580_n.png?stp=dst-p
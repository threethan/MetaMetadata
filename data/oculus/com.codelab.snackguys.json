_description": "Embark on exciting multiplayer virtual reality competitions. Save Snackland from angry intergalactic robots, racing against time on several challenging courses. Work as a team, overcome obstacles and constantly evolving enemies. Get ready for high-octane action and unparalleled collaborative fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelab.megatextos.com.br/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelab.megatextos.com.br/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "7472332062831886"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PENDING", "id": "4422366474649504"}, {"status": "PUBLISHED", "id": "2196483534174130"}, {"status": "CANCELLED", "id": "1482125846353892"}, {"status": "PUBLISHED", "id": "804576672728431"}, {"status": "PUBLISHED", "id": "469597382621038"}, {"status": "PUBLISHED", "id": "738529105084643"}, {"status": "PUBLISHED", "id": "801893925134623"}]}, "baseline_offer": {"id": "2196483534174130"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "4422366474649504"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7551518
2zK0LURtzj2kHpmQZbvoxclG8G0nriCPKJt6wbKAkAYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft1JJGsV7VZZz6Km6m4lWYYa-C2BvmQGU4HnWzRgi2p2Q&oe=6999B915"}, {"file_name": "gameplay7.png", "id": "2092526777796282", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566678_2092526781129615_1159087057712793516_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ev9z58bNmC8Q7kNvwEe-pMB&_nc_oc=AdlaOvrHNeg2vKjY2b1iGeSaIg7zB0JJvdgelhlTxQW7CyOjsBcU6tyEf7-iuEDTuEM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuL5QXJJ3PEEnV0TjoVNimH-EwQOvtmDGBpBbcQ8sJ2aQ&oe=6999B7AC"}, {"file_name": "gameplay6.png", "id": "1153900632285026", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75254871_1153900635618359_967611476036136599_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4k55n3C8xUMQ7kNvwExwwCC&_nc_oc=AdkwwxB6otqODA2oKYObA8KP2nUlPjgF36emFdS2LYzlPiRw-Mb9JpQ4f8h9B0Rznb0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvUw81ZtjuU8ZFKf7zNiv51Tg2Ut-fNtQ8sat4yfibAnA&oe=6999BA60"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 - Capa and Cover Art - 2560 x 1440 copy.png", "id": "525154846987742", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974465_525154850321075_6222509634223683072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhWrVvcONbYQ7kNvwGjMEZp&_nc_oc=AdloWTt-ac0EsCZfpvOWZP8Aa2ayCWZnfbVlG-b_nznlNdkuZFG200GUsoawPEvNSBU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsZjvXw6bYc2tQOm4Ygh609DZMt4B9c-JD2Y5AD4oH1lA&oe=6999B8FE"}, "display_name": "Snack Guys", "keywords": [], "long_description": "Get ready to embark on an electrifying experience, entering competitions full of obstacles and furious enemies in an exciting virtual reality (VR) game. With a MULTIPLAYER mode and a variety of different courses, each player must reach the finish line as quickly as possible to save Snackland from the legion of intergalactic robots. But the fun doesn't stop there! Only a limited number of players can work together, and with each round, the game becomes more challenging with more enemies and increasingly difficult obstacles. Immerse yourself in a world of challenges and experiences shared with other players, testing your platforming skills to the fullest. Get ready for thrilling action and collaborative gameplay like never before!", "short_description": "Embark on exciting multiplayer virtual reality competitions. Save Snackland from angry intergalactic robots, racing against time on several challenging courses. Work as a team, overcome obstacles and constantly evolving enemies. Get ready for high-octane action and unparalleled collaborative fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://codelabplay.com/privacy-policy-snack-guys", "developer_terms_of_service_url": null, "publisher_name": "Fernando Dib Gon\u00e7alves", "support_website_url": null, "website_url": "https://codelabplay.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "25518236521148164"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499304952_1940525550122330_8962949056219766580_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnKY0I2DnRIQ7kNvwFYJufC&_nc_oc=AdlglOeBQFX-Bf9l2RCMFDAP_m6DmOqi5fDnP3xFMrxtVliU9f5WhY7zGcroSVaOraQ&_nc_zt=3&_nc_ht=s
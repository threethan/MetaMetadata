_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bxPyA4AIEIQ7kNvwFqntrh&_nc_oc=AdpZAZ90M9zQ2ss-PblQmiMTaq3UTwBK5FHxtBniEEAaDPKSWe_KA_drVQulwowY7Xk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6hkiEzwU0jC7XgHm9s2SGYm_Y2HYfHoLRK4_OHyUUQw&oe=6B0324A2"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1157589499939950", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499313072_1157589503273283_4206369418986967069_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4q6QuVhpb9AQ7kNvwFmvif-&_nc_oc=Ado-3pccCCEVfjjITFYHYTQXtgPXdpWXd2fsCegfYG46XvNfo3M2tA-R5f84reVS2ZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSVj-ZJRBqqQ9ac36nC_28ZCo-EjsGDNYTIPZQ80V_Ag&oe=6B03362D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumbnail-2560x1440-24bit.png", "id": "2068715797157119", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/756589809_2068715800490452_3484593451142848924_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAxONZE8yiUQ7kNvwHzt3FZ&_nc_oc=AdrSXory0MtJ4CbPuUS4BaZsxLJEDYY3CP3a2-ONiiCpzkeCu00Q_vI6t_ikCeP16jw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR-THjp_BZvV8U3xKdr0MLUpSjz6p9LSlyZByfc5ts4g&oe=6B031498"}, "display_name": "Steal a Sigmon", "keywords": ["steal", "tycoon", "multiplayer", "monke", "brainrot"], "long_description": "**Steal a Sigmon** is the stealing game built for VR. Buy Sigmons, stack up cash every second, then sneak into other players' bases and steal theirs with your own two hands!\n\nBuy Sigmons off the conveyor and carry them home to your base.\n\n{1650753986694227}\n\nSteal from other players, and lock your base before they steal from you!\n\n{2643066936164091}\n\nCollect 60+ Sigmons, from Commons to Sigmon Gods and Secrets, with 10 mutations worth up to 10x the money.\n\n{29026596616997429}\n\nTroll the lobby with 20+ weapons and prank items like black holes, poop grenades and giant hands.\n\n{1509388564348061}\n\nRebirth, fuse and trade your way to the top of the leaderboards.\n\n{1535379661950762}\n\nWatch out for Admin Abuse: live events that hit every lobby at once, from meteor showers to a burning sun!\n\n{1141907434996139}\n\nDress up with 90+ cosmetics and show off your base with skins, effects and rooftop wardens.\n\n{1627824125496734}\n\nWe update all the time with seasonal maps, events, quests and a Season Pass. It's Christmas in Steal a Sigmon right now!\n\nJoin our Discord for rewards and events: discord.gg/stealasigmon", "short_description": "The stealing game built for VR! Buy Sigmons, earn cash every second and steal from other players before they steal from you. Collect, rebirth, fuse, trade and troll the lobby."}]}, "developer_name": null, "developer_privacy_policy_url": "https://stealasigmonvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "KingKelley", "support_website_url": null, "website_url": "https://stealasigmonvr.com/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1474394592418099"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499312257_1669770658058524_2458273247383552193_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-XJrClidOgQ7kNvwGQY-v
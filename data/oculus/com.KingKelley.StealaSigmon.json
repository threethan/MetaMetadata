_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YqpeK0mU6YQ7kNvwGxX1YA&_nc_oc=Adq-m1DGpgHgEQz-qE8nHmaU2mKVLxl-cYCUAmYnJYZiwLw-zR0IMLv4dBugzP5ZjvY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgsq0QlMWuQVDhGBoLUh6aZHhhiMf5pKbEqRAWw80VKg&oe=6B0B0DA2"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1157589499939950", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499313072_1157589503273283_4206369418986967069_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZJ-DL1GyiQQ7kNvwHDXHps&_nc_oc=AdoKhbD8j9FIvh_uxeKjNAiItfx5X6ECmjqHI7k45ItdHjGqA7H_9njJQYrBdM9x2sk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTTdBPGWkbKqLNuH4SIGNApozJzxR1i4pMRNq7I9tml5Q&oe=6B0B1F2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumbnail-2560x1440-24bit.png", "id": "2068715797157119", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/756589809_2068715800490452_3484593451142848924_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpMV4ZtyJmMQ7kNvwGoCyH3&_nc_oc=Adr7vzP9HCWHz9R5KRRZ64peAuKQAp7oUwE2q_IUmUjJIcj8meriR71WJWQYtikZaag&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTVRJOEZpGe0KpRbOap8A9iYJiXF_nXHI63Lpm8FHy3Gg&oe=6B0B35D8"}, "display_name": "Steal a Sigmon", "keywords": ["steal", "tycoon", "multiplayer", "monke", "brainrot"], "long_description": "**Steal a Sigmon** is the stealing game built for VR. Buy Sigmons, stack up cash every second, then sneak into other players' bases and steal theirs with your own two hands!\n\nBuy Sigmons off the conveyor and carry them home to your base.\n\n{1650753986694227}\n\nSteal from other players, and lock your base before they steal from you!\n\n{2643066936164091}\n\nCollect 60+ Sigmons, from Commons to Sigmon Gods and Secrets, with 10 mutations worth up to 10x the money.\n\n{29026596616997429}\n\nTroll the lobby with 20+ weapons and prank items like black holes, poop grenades and giant hands.\n\n{1509388564348061}\n\nRebirth, fuse and trade your way to the top of the leaderboards.\n\n{1535379661950762}\n\nWatch out for Admin Abuse: live events that hit every lobby at once, from meteor showers to a burning sun!\n\n{1141907434996139}\n\nDress up with 90+ cosmetics and show off your base with skins, effects and rooftop wardens.\n\n{1627824125496734}\n\nWe update all the time with seasonal maps, events, quests and a Season Pass. It's Christmas in Steal a Sigmon right now!\n\nJoin our Discord for rewards and events: discord.gg/stealasigmon", "short_description": "The stealing game built for VR! Buy Sigmons, earn cash every second and steal from other players before they steal from you. Collect, rebirth, fuse, trade and troll the lobby."}]}, "developer_name": null, "developer_privacy_policy_url": "https://stealasigmonvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "KingKelley", "support_website_url": null, "website_url": "https://stealasigmonvr.com/privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1474394592418099"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499312257_1669770658058524_2458273247383552193_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVK-xvN-Gg0Q7kNvwE2Bnd
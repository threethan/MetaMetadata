 "1239305707551819", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302851_1239305710885152_2609911711325998234_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OBYG3tY7y_oQ7kNvwEnnKyi&_nc_oc=AdqZxJnVKxA5XfAXJc4LhCspT0XGFaIsgfa_IOplRFEqZzHyjKMQRzf42XRKqNw4DtY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af29mPMh_Rek0H68-PJ3ID82KffdYlBt3P6u5Ngh2s8BKA&oe=69EF5216"}]}, "id": "689483903821272", "locale": "en_US", "screenshots": [{"file_name": "using-fireball-v2.png", "id": "515282631609379", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_515282634942712_1322369885250837187_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cld-FJnOHRUQ7kNvwGJ421A&_nc_oc=AdqiVcEt87y6Wi28HswaTR9efJx2Osw8b-DRt6ue-b5ZVMJKTLiOcdsEPuaA374lZDg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32_TlFEsxSH8py4qTd-eg7jmkb68q5OyoGnGEQeFQvgA&oe=69EF7249"}, {"file_name": "swordsmen-combat-closeup.png", "id": "729650772773850", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303303_729650776107183_1915937562132450057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM6-VukT7aEQ7kNvwFcciMW&_nc_oc=AdpIR1BXBb0o552aBiob9EvAWjSsWjMcXqtzeUL5XpMdjYc9Um1Z5zW8fFLp_2NSa9Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03engpyByujps1U4bBdSEEQUW7TjzaU0wr-StYl-Q0yw&oe=69EF57FA"}, {"file_name": "holding-knights-card-in-snow.png", "id": "1385028846477721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303679_1385028849811054_7754420661288434319_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HI4DKk5lmoQ7kNvwGihhxc&_nc_oc=AdpQ_I_cOYJGntrILCAflYHeuF1fAoEh_3pZ1RevBhankwEnJWaKTXedBHnD0XLxmWo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3WiVTFFe9mLnovITuTDJ6IxhYfBzrCtPROljCKuWsajw&oe=69EF51CD"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlkUXKkTrkkQ7kNvwFhZW3Y&_nc_oc=AdrUyarPHblnfZBYkcd0TSaHGizkUwBZDnlallwiGM1D96rgtmaXMwvG3jrfCuI8EIk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dgTnJ3JYBqqMm59PAoP8DdYz1yOz2GgJ-vnkGaMf6Yw&oe=69EF7C7E"}, {"file_name": "placing-walls.png", "id": "1094315952563906", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304019_1094315955897239_4540012084928717467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_uNXaccT-EgQ7kNvwEDMiiz&_nc_oc=AdpwRfH_vxHmUknL67rsNU-Iq0TYNjKTTak7pQVtO8uYl7ObegoM5mk5WuFhXR7h-ak&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3_Hc7te2Mi2L3T6T1V6zMm2DEYMILGyKA_jLuNosqyqw&oe=69EF535D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1658896644792789", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314657_1658896648126122_3153118213457556376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6dttdbwv8EQ7kNvwH-Wet7&_nc_oc=AdotzVEysleP9-vrArpvcgpd2lOQgXUxFF_ienbGmZB8RmDwRWCBALzDo-d3CHrcnMI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ebe06dMzC0kQFgx54q_g3igtWUSo1DaZJ9WgrCODeZw&oe=69EF69C0"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# COMMAND YOUR TROOPS WITH A PINCH OF YOUR FINGERS\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR FORMATION\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers,** and **Knights**, and fortify your kingdom with **Towers, Walls,** and **Thorns** to prevent your **Castle** from falling.\n\n{1222996099313308}\n\n# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nWhether you're on the couch, out in the wild, or holding court on the porcelain throne, you can summon the tabletop and peer into battle. With the **magic of mixed reality**, you can command your armies anytime, anywhere!\n\n{1769379790372711}\n\n# FEATURING PROCEDURAL TERRAIN, WEATHER & MORE\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Block pathways with **Walls** to divert enemies, place **Towers** on high ground where they\u2019re hard to reach, and lay **Thorns** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# INTERESTED IN PLAYTESTING THE BETA VERSION?\n\nJoin the community and let us know: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
_Afy8BwLmqOYAOXpdYzx7LWDG6TuJIysjHUBIXaxdUBf6ZQ&oe=69CBD863"}, {"file_name": "Battle Closeup - Boss.png", "id": "1843309526588969", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303471_1843309529922302_8452086525846548513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvTrwd6JwnoQ7kNvwH99BDY&_nc_oc=AdoNZJxECasF8bvKr4eZ_fEN51uOanPaC3xdYP3AQeotNXufb_Gx6ZwIyfh_E6kzY_0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyh-HKLHb9ucMmrgvoJYqKLZKOZTRfZBIvv4i1dFbkFeQ&oe=69CBDC72"}, {"file_name": "_MR Tabletop Shop.png", "id": "1769178897069858", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491830032_1769178900403191_1649077227504575881_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0xIb7qBtNAQ7kNvwGpCQpv&_nc_oc=AdpQL8fSAWBCyNcRI8kWfdWmxrExxzAuBamZwjByTzXj1Ta8OZeBOH_L1KiVrpOWqoY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzu7xDPXTH7CZ77U9glA-LlzsiLwFSRcBqaJlLdwtJg1g&oe=69CBD973"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NxfNT4IsP0Q7kNvwHdHZ9H&_nc_oc=AdoXpF2-91OHtgYkcu5ecE1nqwQfks1f5jEo-5yecP5rwQ7nVek3dOetorc0GgV5rx8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3BkbduKVhSogaH35RqrY0GkfHaUO1VO2mksHydhHPzQ&oe=69CBABBE"}, {"file_name": "Battle Closeup - Autumn.png", "id": "1877319390337294", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823448_1877319393670627_3589631680260088480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQoHvo7fs9gQ7kNvwHsOcOO&_nc_oc=AdoaWtpX-U7Y1oUVEg4GWRDnUlomkQ4R8jJXpsZVM4DRlaZF-19GRv3mSr-0mAZBAsY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyPiSpRnh6fZqwNMrlnHMkbTaUe2G58lfFaqc6q0exVPg&oe=69CBAA70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_Dragon_NS.png", "id": "1590260878657997", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819281_1590260881991330_852921093389789099_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2l4SUMeYI_gQ7kNvwGrABb4&_nc_oc=AdpUvBemHA4IV1lum9jzs4-wKymRgkMZa1ke5muDe_ZBa4rhMoV7bKzDCykDooq0heM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx2nn61RlqpA_Goq-VQRCVW59vQwN7vusUj0lJMchY-iw&oe=69CBD0FE"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR KINGDOM\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers, Knights** and special **Heroes**, and fortify your kingdom with **Towers, Walls,** and other **Traps** to prevent your **Castle** from falling.\n\n{1769379790372711}\n\n# TAKE TACTICAL ADVANTAGE OF THE PROCEDURAL TERRAIN\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Divert enemy paths with **Walls**, place **Towers** and **Catapults** on high ground where they\u2019re hard to reach, and lay **Thorns** and **Minefields** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# DEFEAT BOSSES, GET UPGRADES & CONQUER THE LEADERBOARDS\n\nEach campaign world culminates in a climactic showdown against an imposing boss guarding the path forward. Battlefield **victories will earn you stars**, unlocking **upgrades for your troops, spells** & more!\n\n{721569157378194}\n\n# KEY FEATURES\n- Hand tracking & controller support\n- Procedural Levels & **Endless Campaign** with **Leaderboards**\n- **15 Playable Cards** & Specialization Tree with **37 Upgrades**\n- Epic **Boss Battles** & **13 Unique Enemy** types\n- And more to come with future updates!\n\nJoin the community: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/banners-and-bastions", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "CASUAL", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24136582599373493"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821674_2855624944627952_3964530967329034996_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lS9u4JNTQ0IQ7kNvwFDYfa4&_nc_oc=AdrE2ZUpCOt8s1cJY6lbxEhKEz1-YFlUC8Hli8d3RHPt8d6-dcZtSa_zMSncZV9eGho&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzrjhTx3g7nmYJcZLeCwM2k0LXZuytYnFE8MFPr7h4kg&oe=69CBD81D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "displa
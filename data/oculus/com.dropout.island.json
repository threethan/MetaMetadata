 "1239305707551819", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499302851_1239305710885152_2609911711325998234_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wc5ZYTLG1Y8Q7kNvwE3jooj&_nc_oc=AdoEY4OU00i_U16XSJ_C5Coz1M04H0Tm_hSzGFMM8vjgdFq5Ud8hPHNN6zyeB2JMm20&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sj9ttmRJY0_F8pAk6dFa_4vh6hxjiwPmbn-1pXor9Sg&oe=6A0EF616"}]}, "id": "689483903821272", "locale": "en_US", "screenshots": [{"file_name": "using-fireball-v2.png", "id": "515282631609379", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304019_515282634942712_1322369885250837187_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USsgO-aEAjsQ7kNvwGxwG7j&_nc_oc=AdrU-MrLnLluL-iUvgOJmmL-pLrutrNaQ410JkAh3DQK3FYmwvS0QmqLAk_3sjhxHzM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jpD3GlbNtJLHtTNdw8d8G3sG4ou-YONJcxBFj44Sf4g&oe=6A0F1649"}, {"file_name": "swordsmen-combat-closeup.png", "id": "729650772773850", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499303303_729650776107183_1915937562132450057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yeB66IFsKrEQ7kNvwHDiTlD&_nc_oc=Adqwihn6DJjsmbCpADjYfR-PTNJCBIoz_KaontMvRLr0mXwQ1y5PmK_veKBbawItCMk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tb0NWDmF1wO5k2BVnQUeJdS2TyU0wSzh3BhvDGYj-mA&oe=6A0EFBFA"}, {"file_name": "holding-knights-card-in-snow.png", "id": "1385028846477721", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303679_1385028849811054_7754420661288434319_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr4OmkcP9bwQ7kNvwGgjph5&_nc_oc=AdrQqsbGp-wpyNxloRReSvJEcv5_AwxoBWZEvq-cME4s7TXefNAjDeyGNMLzQjbGsUw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43sZgicltJkOo7Gu1aGlOHsOnNOpydgxAgYOc98maK5A&oe=6A0EF5CD"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKV1b-biqRoQ7kNvwFrJots&_nc_oc=AdqvFmvMeEKHZkkudFcmuk_D0sQK8r1qq0pxDHViL5ow-zH0Rzw3nw7YCSjlXk1N0gM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4s6-obs1vquYGVMSqwKgWz8P4YWNs2U8fhIj1ojgh3aQ&oe=6A0F207E"}, {"file_name": "placing-walls.png", "id": "1094315952563906", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304019_1094315955897239_4540012084928717467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkIKyuXr11gQ7kNvwGjjrK3&_nc_oc=Adq-wi_xhvJpHEdKx3C2UFjtgPkxrpV8S1fVPYxmgOtvf4H1OJUplnzyXHA8Yx68P1c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tv5M6rnwhWWxmLTSeNsTrDwUJaUDL6StLMBrezwY6Qw&oe=6A0EF75D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1658896644792789", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499314657_1658896648126122_3153118213457556376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zieZ9xBZeTYQ7kNvwGmawhv&_nc_oc=AdoQsgUMI3I94O9eG6mJoMWlkicR9qntYe0VwktzLkTfdEM4q0gcMRankW2INpiUJbk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VLpjrr6KBn1WlChnKAQolLtj-RqSI44PJor3uAB2-ww&oe=6A0F0DC0"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# COMMAND YOUR TROOPS WITH A PINCH OF YOUR FINGERS\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR FORMATION\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers,** and **Knights**, and fortify your kingdom with **Towers, Walls,** and **Thorns** to prevent your **Castle** from falling.\n\n{1222996099313308}\n\n# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nWhether you're on the couch, out in the wild, or holding court on the porcelain throne, you can summon the tabletop and peer into battle. With the **magic of mixed reality**, you can command your armies anytime, anywhere!\n\n{1769379790372711}\n\n# FEATURING PROCEDURAL TERRAIN, WEATHER & MORE\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Block pathways with **Walls** to divert enemies, place **Towers** on high ground where they\u2019re hard to reach, and lay **Thorns** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# INTERESTED IN PLAYTESTING THE BETA VERSION?\n\nJoin the community and let us know: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
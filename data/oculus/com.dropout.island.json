 "1239305707551819", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302851_1239305710885152_2609911711325998234_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxOa8fhGMiEQ7kNvwFpRqp8&_nc_oc=AdpaPDcZ2rkWu-hrafgIRW_5DQWqj0ERmzN1KJW8ldLdjaVtCnAm8CmXjWGdrV77Jp4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MIW5hcDE9CxitmZSIbm0osDjYyUovsWSrSJv9iI2zfA&oe=69E8BA96"}]}, "id": "689483903821272", "locale": "en_US", "screenshots": [{"file_name": "using-fireball-v2.png", "id": "515282631609379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304019_515282634942712_1322369885250837187_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVaX-9c8vLMQ7kNvwHRANbM&_nc_oc=AdoyaGwq6l6TiJdruTKfkYkl99cbPzHWXOraeZ51_nYt-Ug-YTlvGQw52wFK31JBGrs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-0tqR8Ue2PLkDf3e75sCpXQlJZuPmqwpj81pHIseyAg&oe=69E8DAC9"}, {"file_name": "swordsmen-combat-closeup.png", "id": "729650772773850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303303_729650776107183_1915937562132450057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rn1oEpxzpq0Q7kNvwELYkJT&_nc_oc=AdpRd6waR5-j4Q-McbBXl-NLT98_Pea0ffonxILkJ-rKEwm-98KHk6O9uWO64uyjBTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CCfce6jogkMjnocavag199AO8DsFmqkUzfdEEDMqNsw&oe=69E8C07A"}, {"file_name": "holding-knights-card-in-snow.png", "id": "1385028846477721", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303679_1385028849811054_7754420661288434319_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JK5ZIIE46uUQ7kNvwEo9scp&_nc_oc=AdpHI4cyNrUFPR7M9zUmgy-S7vVDjRimuBD0pZgY2bYoKXkCVBnoy24I4fWYMPs06bg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uPtN6cJQE0f2OiAiizaGdDP_b3H5f9syY-V4bv4Vb6g&oe=69E8BA4D"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-OIqgJjR3QQ7kNvwGOJ1ck&_nc_oc=AdoW9y2GyMa_OkUauJb-6lyJc0hHa_Mg3x7OyM6vMsGSt7EBCYQ7Oc1sp7w5LNP_5rM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YU2POE8MBftl9LUxKalY8fc633yRfVAMQLnrEWS9Lkg&oe=69E8ACBE"}, {"file_name": "placing-walls.png", "id": "1094315952563906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304019_1094315955897239_4540012084928717467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGj0Zv9diLIQ7kNvwGTjX6g&_nc_oc=Adqbi1CB7akbWeIeEa5D8BnL7Zp9LFazEkKzo0HCPbzASWF8a_pENaKkpL-beAWXPTk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22IL70ssIVZAdlboBF6O1XFt4Eq-zP51XqEw1-j9jZNg&oe=69E8BBDD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1658896644792789", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314657_1658896648126122_3153118213457556376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFz2A-Z-Ts8Q7kNvwE641lc&_nc_oc=Adpel26awX1V-jkXChZWKFb9d2HEpasPWY9eCh3acxQTNaYCFTAG87rYhCWnfolerBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cfwZuC8pz626erlkV-vMwO8jDIAck7KykuAFvnSLaDw&oe=69E8D240"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# COMMAND YOUR TROOPS WITH A PINCH OF YOUR FINGERS\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR FORMATION\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers,** and **Knights**, and fortify your kingdom with **Towers, Walls,** and **Thorns** to prevent your **Castle** from falling.\n\n{1222996099313308}\n\n# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nWhether you're on the couch, out in the wild, or holding court on the porcelain throne, you can summon the tabletop and peer into battle. With the **magic of mixed reality**, you can command your armies anytime, anywhere!\n\n{1769379790372711}\n\n# FEATURING PROCEDURAL TERRAIN, WEATHER & MORE\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Block pathways with **Walls** to divert enemies, place **Towers** on high ground where they\u2019re hard to reach, and lay **Thorns** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# INTERESTED IN PLAYTESTING THE BETA VERSION?\n\nJoin the community and let us know: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
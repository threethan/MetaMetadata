52086525846548513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhN4bF9kxCgQ7kNvwEOECeB&_nc_oc=Adm6tCFR2dzgp5IjuatiokkUdeEWsuWCG3hZ5lNiKYdOjR6F9rEmAx1PKsOQFrGXTZM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuAa2NOqZpaGNcN96MCp0G2_hpHsdSV_yfeC663eGIgkw&oe=699B14F2"}, {"file_name": "_MR Tabletop Shop.png", "id": "1769178897069858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830032_1769178900403191_1649077227504575881_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnSQHY4U7skQ7kNvwEVziFk&_nc_oc=AdlsI0auLlYlnkMS2FQn6NK6HGG-asiwz7ofErkqSwIB4PWHoYRprXiUr4UR5V_U35g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu0h_5uE20tPs10cl_ZjpYVhAjBKDeLPaqeDYxgPd403w&oe=699B11F3"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DxOIBMXB3kQ7kNvwEV7HAY&_nc_oc=AdkRERV60f3dsgbpkgtu4_sYiO_MK8VvQJIStSabsIk6jKw6z686b16YFDfjzvSC9OA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuDlNq2J__KxSjwudPYnKc374EdDszmcVDDOM72qnQa-A&oe=699AE43E"}, {"file_name": "Battle Closeup - Autumn.png", "id": "1877319390337294", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823448_1877319393670627_3589631680260088480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcotZ2icaJEQ7kNvwFC9tvJ&_nc_oc=AdkOk-EuEztgYMTizc0Z1LI6nq9dWM7FcZyYWk9tKYoqbv638Z8xK_vXJTbMg5l1Mbo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftgowV_pq42Qcpgp76dHVTxyjEyAE3VapVl4ElQ2rn1bQ&oe=699AE2F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_Dragon_NS.png", "id": "1590260878657997", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_1590260881991330_852921093389789099_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WITB4kXpxIIQ7kNvwFXqe1n&_nc_oc=Adm_SKf4ZBlW9ywcnytQxu12xEzHC0CKYIBSQF3aVT_L0_dDRHBesqBj-yfNZAKJJc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afshk12l90hckm3WJPSSiKvh7nI7uGkGW0ss2uRPdqEkhA&oe=699B097E"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR KINGDOM\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers, Knights** and special **Heroes**, and fortify your kingdom with **Towers, Walls,** and other **Traps** to prevent your **Castle** from falling.\n\n{1769379790372711}\n\n# TAKE TACTICAL ADVANTAGE OF THE PROCEDURAL TERRAIN\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Divert enemy paths with **Walls**, place **Towers** and **Catapults** on high ground where they\u2019re hard to reach, and lay **Thorns** and **Minefields** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# DEFEAT BOSSES, GET UPGRADES & CONQUER THE LEADERBOARDS\n\nEach campaign world culminates in a climactic showdown against an imposing boss guarding the path forward. Battlefield **victories will earn you stars**, unlocking **upgrades for your troops, spells** & more!\n\n{721569157378194}\n\n# KEY FEATURES\n- Hand tracking & controller support\n- Procedural Levels & **Endless Campaign** with **Leaderboards**\n- **15 Playable Cards** & Specialization Tree with **37 Upgrades**\n- Epic **Boss Battles** & **13 Unique Enemy** types\n- And more to come with future updates!\n\nJoin the community: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/banners-and-bastions", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "CASUAL", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24136582599373493"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821674_2855624944627952_3964530967329034996_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFLakJbbr9QQ7kNvwGqcA7U&_nc_oc=Adl6ZymN5R-Wnm64C-zkWuiVbKmURctEVlJN3NQ1vSmtq7ebWmNqKfNSZoPJMrpUMAs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv_w8n8MZiOVuV2SHl_mXEK-mL5xVlOzHRIbGxNGVPIHg&oe=699B109D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banners & Bastions", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Strategy", "id": "275629210202852"}], "release_date": 1756400400, "lastRev
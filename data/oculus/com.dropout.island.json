 "1239305707551819", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302851_1239305710885152_2609911711325998234_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aue6e3e7xjcQ7kNvwEw5z_z&_nc_oc=AdqNqyBNCyl1qsJpezOq5UrRyBnESdJzqtTwySs7DcSYeVE8wS_k1beIePThxVb5F-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yOnzuzXJI9BIyMKV6nnk9LTRMZDHWYpnqgABG8BR9lw&oe=69E0D196"}]}, "id": "689483903821272", "locale": "en_US", "screenshots": [{"file_name": "using-fireball-v2.png", "id": "515282631609379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_515282634942712_1322369885250837187_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfBunEKUmiIQ7kNvwE8P3WH&_nc_oc=AdqdKQPpCxv8YVLSJrGpgKSfMGC219P_ss2eh8NucRCjne_Owd9XATVPrP1QBzuPYBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QsvU_QT0b_tI_msXicuZnbaSo88TtduxJ2I7Z8bB0LQ&oe=69E0F1C9"}, {"file_name": "swordsmen-combat-closeup.png", "id": "729650772773850", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303303_729650776107183_1915937562132450057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYYd5PHHLwoQ7kNvwFHbSOv&_nc_oc=Adq8rjfhuJpiBrj0F34fr7ZvOFnCzb3mJcpHEbEkqI7TqYKds3UhC55r5tfSUUbiGpc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1f-Ji7nwUt6fzELZLHR3DYYudlh06Ng99HNG6h8SE2ZQ&oe=69E0D77A"}, {"file_name": "holding-knights-card-in-snow.png", "id": "1385028846477721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303679_1385028849811054_7754420661288434319_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwwiGRjqmtgQ7kNvwHoX_vn&_nc_oc=Adqis5z6Y_gT_I_Lv6amq5ZcXac5MM2wxM_HX__apiZZtijlghv-CJ6BkSPMgwRG9mU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bZfdFpSJ2UmWW2c6oib-1KMJXaeKJQPPOB5wnBi0lBg&oe=69E0D14D"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrP5SrxVTmgQ7kNvwG9Lqa9&_nc_oc=AdqSb7sWaMfiqrbVrPH-4V448UKyI_avewYe18N5axthLwxXyjlHsMXKaF3M0UPMbLE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3s3kZABD8dRt8py7GW3ee2EtsweDJc4SZkpH0cpjGzjw&oe=69E0FBFE"}, {"file_name": "placing-walls.png", "id": "1094315952563906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1094315955897239_4540012084928717467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vLy7nVzXDeoQ7kNvwHSWEgX&_nc_oc=Adp4-DUq-aVwsa_oKr1TyysFG7LeFp5CyGy2USbCHmbY_qlaO_nFmUdkhiprCN2f8aY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lI_HON8MWd9uxzHEaF2pIAzSJuTCfhwY1YMAwB8knvg&oe=69E0D2DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1658896644792789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314657_1658896648126122_3153118213457556376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nm66_AyERwcQ7kNvwGWFBHk&_nc_oc=AdoZpLT7l8kLqSYEoxd6ScbAEeinKoc1BrLW9IgAc9ZMY_sScbxkrjGLqeGpQS8H0cI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ovlaNO74NPE3DTj1aDkQUABNdKE7KW0UPLMpsZ6KRMA&oe=69E0E940"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# COMMAND YOUR TROOPS WITH A PINCH OF YOUR FINGERS\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR FORMATION\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers,** and **Knights**, and fortify your kingdom with **Towers, Walls,** and **Thorns** to prevent your **Castle** from falling.\n\n{1222996099313308}\n\n# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nWhether you're on the couch, out in the wild, or holding court on the porcelain throne, you can summon the tabletop and peer into battle. With the **magic of mixed reality**, you can command your armies anytime, anywhere!\n\n{1769379790372711}\n\n# FEATURING PROCEDURAL TERRAIN, WEATHER & MORE\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Block pathways with **Walls** to divert enemies, place **Towers** on high ground where they\u2019re hard to reach, and lay **Thorns** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# INTERESTED IN PLAYTESTING THE BETA VERSION?\n\nJoin the community and let us know: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
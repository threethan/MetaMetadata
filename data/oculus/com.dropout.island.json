 "1239305707551819", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499302851_1239305710885152_2609911711325998234_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0Vf2XwtWecQ7kNvwE5SrPK&_nc_oc=AdrNwo-vIAbB2cWzHj_jQWbRl6KF3to6ZqqahABtqI-oPEo972VaBO3SPQBZ910iGwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwOrpvgaJ6pw7POFHMvlUgBXpgZ6shbP0EkesHPiyV6uA&oe=69D0FF96"}]}, "id": "689483903821272", "locale": "en_US", "screenshots": [{"file_name": "using-fireball-v2.png", "id": "515282631609379", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_515282634942712_1322369885250837187_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xhAvMvzd3gQ7kNvwGSS0fr&_nc_oc=AdrBMzg46fTcXSKNk75SGSM-DTrGdyiJTHH3b9Rnut0GuDdxCUtNj9kJea74PD-J_94&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-YQOImUqZ9GdC_qOGuhauZ-f19vaLgdTcjw_TAXQjnQ&oe=69D11FC9"}, {"file_name": "swordsmen-combat-closeup.png", "id": "729650772773850", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303303_729650776107183_1915937562132450057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Zr8M3TMXyUQ7kNvwEwyZM3&_nc_oc=AdrJQG_tmXdNmh3QsuKlSTCL-hOOU9He3z3MmO4xFqkbNBl2zBidpD_nIwZxrTMUzes&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_V1ON8y6_4SE8v1VI5LK2yQFa9x3qqrhwLDOLLUbAsQ&oe=69D1057A"}, {"file_name": "holding-knights-card-in-snow.png", "id": "1385028846477721", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499303679_1385028849811054_7754420661288434319_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cf0MSTZHR68Q7kNvwHFbm29&_nc_oc=AdreV1V2lPNNs-xr4ZbQFt0WzlbudL4w4QrgQQn8Xit8EG5tVV3Cgz_oRij4H4C5oo0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ1pnMlJG9eabJD_h3KgjadbL2FO4lQPRGYfAfUsFaBQ&oe=69D0FF4D"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-BaTY8q97UQ7kNvwEg3s3Q&_nc_oc=AdofRhEsPD6Z_PsBO2QOiTMHwE-7xvbJpczQ1FNx5av1OEbcRKT6vO_Y8-WIMv6gdqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyR3vtErKtU7MTWx26FgF9TzTsH-dYCTZyyUw3_M0_AIw&oe=69D0F1BE"}, {"file_name": "placing-walls.png", "id": "1094315952563906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304019_1094315955897239_4540012084928717467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwUe5fHZzysQ7kNvwGPfdRe&_nc_oc=AdpQTXhalc3-kO2FQjW-mGbirPQKV8FO0TsTAOVgxPfOFcMIkuXxaSIqvwc_JXSzVmU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2Q6cix97AN5tY-_cU5ggHzA-kSwzjsHAo0ohy-prm3g&oe=69D100DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1658896644792789", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314657_1658896648126122_3153118213457556376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEblDRA1dv8Q7kNvwHM5ToG&_nc_oc=Adrq176l4ZOZoKxFfqgIchl843k8vts5gpJK9JZfzPKth7lsy91NWyRVeRd-xEZCu0A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJZoul0eX3fyFmF0mFej5LGd8yqZzPNZg4qx781abjFA&oe=69D11740"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# COMMAND YOUR TROOPS WITH A PINCH OF YOUR FINGERS\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR FORMATION\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers,** and **Knights**, and fortify your kingdom with **Towers, Walls,** and **Thorns** to prevent your **Castle** from falling.\n\n{1222996099313308}\n\n# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nWhether you're on the couch, out in the wild, or holding court on the porcelain throne, you can summon the tabletop and peer into battle. With the **magic of mixed reality**, you can command your armies anytime, anywhere!\n\n{1769379790372711}\n\n# FEATURING PROCEDURAL TERRAIN, WEATHER & MORE\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Block pathways with **Walls** to divert enemies, place **Towers** on high ground where they\u2019re hard to reach, and lay **Thorns** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# INTERESTED IN PLAYTESTING THE BETA VERSION?\n\nJoin the community and let us know: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
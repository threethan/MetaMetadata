 "1239305707551819", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499302851_1239305710885152_2609911711325998234_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wc5ZYTLG1Y8Q7kNvwHbKwHj&_nc_oc=Adp-PQIKV4aY3eIpY9LdOYxx4csnjB0anoWRpzhnENyzJ5BuPeKKlGZb61gT2PjKZvY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LkqxSDjr-cBGDtqOLu7wM691ythhECHsL0LXC0tDU7w&oe=6A107FD6"}]}, "id": "689483903821272", "locale": "en_US", "screenshots": [{"file_name": "using-fireball-v2.png", "id": "515282631609379", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499304019_515282634942712_1322369885250837187_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USsgO-aEAjsQ7kNvwErORoI&_nc_oc=AdrcIkxzBX7_rXBCBZzyZ7ekT9hGgG8XAsjvlxkwDmkXSw9dLfWVgI42Q1L_pA1kg2c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zhOozKKkoMzuy21PAPL-VuudMgS_kWUObfUquHfxVqw&oe=6A1067C9"}, {"file_name": "swordsmen-combat-closeup.png", "id": "729650772773850", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499303303_729650776107183_1915937562132450057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eBD3cn8_aYgQ7kNvwEfelPD&_nc_oc=Adr852LmYu2Tpp_UgwS4pFbEKfGU1hIFPHV6d5nh0-j_jpsKjAwczMcYgpEfgoxezjc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ITmGv_sPBlDi4rvkKRZO6Pkg9oNg3dIZMHLYFBl78UA&oe=6A104D7A"}, {"file_name": "holding-knights-card-in-snow.png", "id": "1385028846477721", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499303679_1385028849811054_7754420661288434319_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JLe4ZnbIuikQ7kNvwGcYiwK&_nc_oc=Adq3dDKxK9_jc3BdRIfE_Jk5GEC1vEQvAX00QOMBvBV8B_mzEMYeYBlFTCg1OMjAZPQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af693ZHo9ZHt2igosdytXuTDQnSsbJ4_SW2Pnfn-KewNMg&oe=6A107F8D"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuP2_nMp6y8Q7kNvwFQtEm5&_nc_oc=AdoIhQlb8UdXnjH3xjNf8Z0x0oGwFJWBhN8dGivOEeIpum0sMHuPdY1MTX7Gt-Nk7qY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sr7yDROCVKlwHPyi0TmQjAJb0FH1ewCeQwhpb_WpF5A&oe=6A1071FE"}, {"file_name": "placing-walls.png", "id": "1094315952563906", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499304019_1094315955897239_4540012084928717467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkIKyuXr11gQ7kNvwE0BIqB&_nc_oc=AdqELSjW-yklJQhZlP-KdeDg1Vdoh0mIJOmE0l_dcfvYZ7oXS4iifje0Ol0epGP8x7Y&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62UT3XhwVYG80dKwk9TxEjUS9N0_PErnr0KC8AgGHLgA&oe=6A10811D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1658896644792789", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499314657_1658896648126122_3153118213457556376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zieZ9xBZeTYQ7kNvwGGFSLp&_nc_oc=Adr8v_APvgPMiakRa5hk1H0F_Tum8bYz3rP-r_f2_acrFFmZb7iOhx4NVttQ31PhSAY&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_zlZESDmO0Lomcu1_HhrV9wgWPSa5AP2S1SVhwgCYUw&oe=6A105F40"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# COMMAND YOUR TROOPS WITH A PINCH OF YOUR FINGERS\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR FORMATION\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers,** and **Knights**, and fortify your kingdom with **Towers, Walls,** and **Thorns** to prevent your **Castle** from falling.\n\n{1222996099313308}\n\n# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nWhether you're on the couch, out in the wild, or holding court on the porcelain throne, you can summon the tabletop and peer into battle. With the **magic of mixed reality**, you can command your armies anytime, anywhere!\n\n{1769379790372711}\n\n# FEATURING PROCEDURAL TERRAIN, WEATHER & MORE\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Block pathways with **Walls** to divert enemies, place **Towers** on high ground where they\u2019re hard to reach, and lay **Thorns** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# INTERESTED IN PLAYTESTING THE BETA VERSION?\n\nJoin the community and let us know: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
e_name": "Battle Closeup - Boss.png", "id": "1843309526588969", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303471_1843309529922302_8452086525846548513_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20QHFnb3Bg4Q7kNvwFSPFZ0&_nc_oc=AdnQnVyZOJYG682gqeIKu7sKa3DM_BSQ3-zvR-eeHXBkzYDleoRvZ-Dsx-Ons_H4Kxo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyrFiiAy-ei7MDmfgjt7Vs8pwSEhfFTTweh78UtoOIFOA&oe=69BEAD72"}, {"file_name": "_MR Tabletop Shop.png", "id": "1769178897069858", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830032_1769178900403191_1649077227504575881_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmdpT178I68Q7kNvwHMParX&_nc_oc=Adn_NmF0qidL0voQeEOneGLdyCJQ9OSkJfE2vS7sds7jNDMNrgXFHtmqS5jIBeaV-8Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzX3ohaOmQy1B5ejcVNLmmVKbD56B25VlK0Q7atouEkxg&oe=69BEAA73"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8opm5AD-AgEQ7kNvwHiNuuT&_nc_oc=AdmOrTp3gpT4PJUm_aDpB-rt83mWacBvNYI1J8otn99bpx2-fB5uYbSlPealXkAWqO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVkWuQ2yXs_blOOyI0o4nRahVwmeJmAy3mol_eJJVmtA&oe=69BE7CBE"}, {"file_name": "Battle Closeup - Autumn.png", "id": "1877319390337294", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823448_1877319393670627_3589631680260088480_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMr06qaSVRIQ7kNvwF40Ufj&_nc_oc=AdnNd4AmYbV_I8xv9gTRwrJHhw4o2aBOr2hc6BIcsb8q73Xb40CCfs-35aPaznPasWM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwRdYfUL6gY7KY4jb-MeAEcPTSEAKE2t17FN5AE-nb3Nw&oe=69BE7B70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_Dragon_NS.png", "id": "1590260878657997", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_1590260881991330_852921093389789099_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wNJcdXyuWf0Q7kNvwFjZ47q&_nc_oc=AdlqXFjvN7IOPUjJDRtI7Akmo64o4Ikr6iU5vZj5fBU1w2C9JeDglLYAtKyrDFUS5Cw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzIZBKt2F6knLt0mIvC8fA-rNMlX8FhWckEKedymvTJbw&oe=69BEA1FE"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR KINGDOM\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers, Knights** and special **Heroes**, and fortify your kingdom with **Towers, Walls,** and other **Traps** to prevent your **Castle** from falling.\n\n{1769379790372711}\n\n# TAKE TACTICAL ADVANTAGE OF THE PROCEDURAL TERRAIN\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Divert enemy paths with **Walls**, place **Towers** and **Catapults** on high ground where they\u2019re hard to reach, and lay **Thorns** and **Minefields** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# DEFEAT BOSSES, GET UPGRADES & CONQUER THE LEADERBOARDS\n\nEach campaign world culminates in a climactic showdown against an imposing boss guarding the path forward. Battlefield **victories will earn you stars**, unlocking **upgrades for your troops, spells** & more!\n\n{721569157378194}\n\n# KEY FEATURES\n- Hand tracking & controller support\n- Procedural Levels & **Endless Campaign** with **Leaderboards**\n- **15 Playable Cards** & Specialization Tree with **37 Upgrades**\n- Epic **Boss Battles** & **13 Unique Enemy** types\n- And more to come with future updates!\n\nJoin the community: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/banners-and-bastions", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["STRATEGY", "CASUAL", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24136582599373493"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821674_2855624944627952_3964530967329034996_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3S1cvw0sl18Q7kNvwFCG7f8&_nc_oc=AdnLG1FEPP7AchXai1dX6hFeddhovEamTi9YFS8A_WF-UDCE-Vms9Ct05iUlCAt8q9A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoMMvXVfl7dATUoAJFNbz-yNCMdDue9lEz-Z2U36OL3Q&oe=69BEA91D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Banners & Bastions", "platform": "ANDROID_6DOF", "context_category": {"context_cat
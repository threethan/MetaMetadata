 "1239305707551819", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302851_1239305710885152_2609911711325998234_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r_UFxFO9C7AQ7kNvwH_rm2o&_nc_oc=AdoNf8S477xJYDNnTglrTeUsP2SnH27qXv4xW488FVsHAdleTd8Cb1OG6_254EjFAAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qt85y9Ay8MNTTVJBkmbs21xKXX2lo6w9n5VmCXyqkeQ&oe=6A147456"}]}, "id": "689483903821272", "locale": "en_US", "screenshots": [{"file_name": "using-fireball-v2.png", "id": "515282631609379", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304019_515282634942712_1322369885250837187_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCljKAw65fEQ7kNvwHLw7Wl&_nc_oc=AdoQg-0ZI324Tpi1YyjNfnWtlNYRu1OPUz5IkZ9GnQD9R2kMjaJb5pK9B6L0EbqDgW8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D0-lXAC0UtULlCRnwcyOc8Ml8SZ8vv1lB-Yx9NWVERQ&oe=6A145C49"}, {"file_name": "swordsmen-combat-closeup.png", "id": "729650772773850", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499303303_729650776107183_1915937562132450057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkGFC9ISgdAQ7kNvwEZrjke&_nc_oc=AdrwiRB5-p3X8ITRF4wUwtI2JCv51BPUay9n53oHNg7alk4inVZHkYh1IFs11gqws0I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eIx9jFtHwHFg2Xo54EIml6j9tiXh-GtnWmcdkc7QX7Q&oe=6A147A3A"}, {"file_name": "holding-knights-card-in-snow.png", "id": "1385028846477721", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303679_1385028849811054_7754420661288434319_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZqcGWddhbPQQ7kNvwEkp-iL&_nc_oc=Adr3MlkS7oMdibgCsW4eYtfd7h9_oEH0nmvSbOhkaEPBNMEEzoMBzz5b7EH-EFvNnzI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s-Tyjicof6uktSx3qfMkow7ib8Mbl69hVsF2hybwSOg&oe=6A14740D"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfiPAv1eyakQ7kNvwHCxI90&_nc_oc=AdormwgPBiMHprspvCjAk1LbaQ9vRfAfUVrHelEfj8tyEzv1dLX8gah12BzrA7av5nI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N_aDnTStEo1_ITrIw6cV_ImfGY7bjK0SQyT9Bn_5McA&oe=6A14667E"}, {"file_name": "placing-walls.png", "id": "1094315952563906", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499304019_1094315955897239_4540012084928717467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vh3WigYy5PYQ7kNvwFcBq2i&_nc_oc=AdrTu0DbQIA9OgUMz5W_ca-wk_SXUxPu3u9cajCsqKvDPMV6518syWbk7rDLrQuDkRc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58rUV6UVILZXts4VlwCG6LbnhL5SfINZsrh-B83L-qeQ&oe=6A14759D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1658896644792789", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314657_1658896648126122_3153118213457556376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSETK8bAWqwQ7kNvwFjqKZY&_nc_oc=AdrVuUf7HgIxVncLl_ojrPyBRIvXvplZ2dbEZMKMQdZAmaSkEJuGN0IPgpJ5X-zFqXg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63ZS3F7uRO4VPtffrF0Bid3H0EGd-wVHXX3WXtHOzXAQ&oe=6A1453C0"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# COMMAND YOUR TROOPS WITH A PINCH OF YOUR FINGERS\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR FORMATION\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers,** and **Knights**, and fortify your kingdom with **Towers, Walls,** and **Thorns** to prevent your **Castle** from falling.\n\n{1222996099313308}\n\n# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nWhether you're on the couch, out in the wild, or holding court on the porcelain throne, you can summon the tabletop and peer into battle. With the **magic of mixed reality**, you can command your armies anytime, anywhere!\n\n{1769379790372711}\n\n# FEATURING PROCEDURAL TERRAIN, WEATHER & MORE\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Block pathways with **Walls** to divert enemies, place **Towers** on high ground where they\u2019re hard to reach, and lay **Thorns** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# INTERESTED IN PLAYTESTING THE BETA VERSION?\n\nJoin the community and let us know: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
 "1239305707551819", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499302851_1239305710885152_2609911711325998234_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDb2M_IS_K8Q7kNvwFxD-UG&_nc_oc=Adpjc8CtaNXcKAF1mhhcEcTJv2ujeTuVrhqbZIMbSqonHlaBxewcRruAmr67mPVk9m8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HewEiO4_ZjSNRGXa8ITWN5CJcenMy1m-rdimVYA9Ejg&oe=6A1868D6"}]}, "id": "689483903821272", "locale": "en_US", "screenshots": [{"file_name": "using-fireball-v2.png", "id": "515282631609379", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304019_515282634942712_1322369885250837187_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4W0qvWg3MIQ7kNvwG21w-u&_nc_oc=AdoD8NIXhqWvvhwbmHFoiYwY_z3O3Rnsxim4Fe1-uNAzJfKaqhomFaxRPq8Mnkk72Xg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5siTwUxE6-Oknqtvf2-s2vTpyC0YDzmrLWAmW89zYh2A&oe=6A1850C9"}, {"file_name": "swordsmen-combat-closeup.png", "id": "729650772773850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303303_729650776107183_1915937562132450057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBIIRx_xXjoQ7kNvwGC4tzo&_nc_oc=Adr0MknwXNKIRoSc-aiA4LppTsremcGIdiRzjf5wZzacbN5yhHU5pPFPLOINgae3Ru4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KfiAHzMTbHU4zshJNE6r_5LXwecoSyN2csoJNQffB4w&oe=6A18367A"}, {"file_name": "holding-knights-card-in-snow.png", "id": "1385028846477721", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499303679_1385028849811054_7754420661288434319_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lt_gi2s6-2kQ7kNvwHPP5w9&_nc_oc=AdrUZwD0Qo12RltJyHZjfVlMAPMtefD0JHtEzfwA82XBvG8DkDf9Z8ajTsUCIskLASM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bPH484qUoFRjx6o4ZBR-PB313li2mntO2mP69XoFUuA&oe=6A18688D"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q9E6lMvtpAQ7kNvwHixjMs&_nc_oc=Adp17I5MBQRO815drpH7Y0j_sCU-u7CjyDMKJIh9uYlPXmCS--cTq3JBKV16YhNNE3Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aG69x8G_DsJqPjkglkdbM9gZgwpeS4TnossJYEXhSOQ&oe=6A185AFE"}, {"file_name": "placing-walls.png", "id": "1094315952563906", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304019_1094315955897239_4540012084928717467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x30n7JH2zgMQ7kNvwElCZSi&_nc_oc=AdomqZ8NpfO-WkQB6PKkHm435Zx9sYAG_g0omEbn_tBk8SZZnmayfkKjMP0ZL8xenGE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jV-mN_aG04rmPl_to0jj379w3g_xo3ZFxqdr_-zqvow&oe=6A186A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1658896644792789", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499314657_1658896648126122_3153118213457556376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6RR9k9mtVEYQ7kNvwFVAEv6&_nc_oc=Adr_y61lcNsjDp9Cnz3ve27k4pcbadYLd58oioEaAiXMs4r2P_jsifjp8pmdzi4QnwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7reDtZm5Bp6O2oveWeSDwCpMmYx6kBn4B3nUpY-h2dvA&oe=6A184840"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# COMMAND YOUR TROOPS WITH A PINCH OF YOUR FINGERS\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR FORMATION\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers,** and **Knights**, and fortify your kingdom with **Towers, Walls,** and **Thorns** to prevent your **Castle** from falling.\n\n{1222996099313308}\n\n# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nWhether you're on the couch, out in the wild, or holding court on the porcelain throne, you can summon the tabletop and peer into battle. With the **magic of mixed reality**, you can command your armies anytime, anywhere!\n\n{1769379790372711}\n\n# FEATURING PROCEDURAL TERRAIN, WEATHER & MORE\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Block pathways with **Walls** to divert enemies, place **Towers** on high ground where they\u2019re hard to reach, and lay **Thorns** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# INTERESTED IN PLAYTESTING THE BETA VERSION?\n\nJoin the community and let us know: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8
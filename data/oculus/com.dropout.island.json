le_name": "using-fireball-v2.png", "id": "515282631609379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304019_515282634942712_1322369885250837187_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-9SvDqWI30Q7kNvwFnSDW5&_nc_oc=AdlX4SSKfz563Dap2YQB0ESfWyxCtG3fWYTouz2xxbejH9kPiWk2dTJoezwGpiZ_fPA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvdxGzYt90qz63NTtl7ehOKAvcWc3t6EX_jptCR4Pc8fg&oe=69A2FB49"}, {"file_name": "swordsmen-combat-closeup.png", "id": "729650772773850", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303303_729650776107183_1915937562132450057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EV4y8uuY1esQ7kNvwGPEoSR&_nc_oc=AdmKzhHEC7upE1FGjxJqP_T3KtZGyD7P1Jha26U_8vmRIAS5CbdHf5DTonk8GjLhPPc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvrw3aD3pRqZi_G9PfjpWUZMVhuNFGrTx6w0A-MWAdStA&oe=69A2E0FA"}, {"file_name": "holding-knights-card-in-snow.png", "id": "1385028846477721", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303679_1385028849811054_7754420661288434319_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rGM0HKan1YQ7kNvwGNmvDl&_nc_oc=AdlKRpjLTF-7NUtsW3YjbZw8PlNZtughclyvwdiUtl9SsWveGBdFoizHssv-zb2zfiA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv-qUYU3G__JE8_m0mE17nw8maBuw0MCfehJzKZHUWeTA&oe=69A2DACD"}, {"file_name": "snow-battle-closeup.png", "id": "1120735219882793", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308045_1120735223216126_3509351957899354049_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAwE7Bq13xIQ7kNvwFFDYHU&_nc_oc=AdkYEDA5sAeI6ewbQg94duB3bpugd7UiYNitEYY-6qwDDaaRIK1b-_Mcl3cRffNAH-U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjxuuX8Qhb24br1MyCp_sxsoFontB0yK7F_Vwl5Nqabw&oe=69A2CD3E"}, {"file_name": "placing-walls.png", "id": "1094315952563906", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304019_1094315955897239_4540012084928717467_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTLcxDaq3fwQ7kNvwFV1Lt7&_nc_oc=AdmNUwSb1mE0OnngmcognGQHKckxxZGdJxu8DHg1P5emugCxRo7cdqAqAtawTcRWEUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuFBx2nnafYZgJ5rGgzxbiM7Q9b2AtnDo9ydNvx8JdvZA&oe=69A2DC5D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1658896644792789", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499314657_1658896648126122_3153118213457556376_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la4_eStN11kQ7kNvwEEkzo8&_nc_oc=Adk7r6FxfNqHxfj-yiYCRSzKzYNdyU53KRkCecDDMl6bVM-GMoq0zmTka7AHurOV6r0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afti0aW12XSm4auGOkGqBSju9dil5iZGKH7ygpNvi3aO-g&oe=69A2F2C0"}, "display_name": "Banners & Bastions", "keywords": ["tabletop", "tactics", "strategy", "roguelike", "defense"], "long_description": "# COMMAND YOUR TROOPS WITH A PINCH OF YOUR FINGERS\n\nThe enemy lurks in the woods, and your kingdom stands on the brink. **Repel the coming assault!** With each night, new threats emerge \u2014 tougher enemies, varied tactics, and mounting pressure that will test your every decision.\n\n{1037793301668062}\n\n# EXPAND YOUR ARMY AND FORTIFY YOUR FORMATION\n\nStrategize before nightfall. Invest in **Farms** to grow your economy, recruit **Archers, Swordsmen, Spearmen, Rangers,** and **Knights**, and fortify your kingdom with **Towers, Walls,** and **Thorns** to prevent your **Castle** from falling.\n\n{1222996099313308}\n\n# EPIC BATTLES AT YOUR FINGERTIPS IN MIXED REALITY\n\nWhether you're on the couch, out in the wild, or holding court on the porcelain throne, you can summon the tabletop and peer into battle. With the **magic of mixed reality**, you can command your armies anytime, anywhere!\n\n{1769379790372711}\n\n# FEATURING PROCEDURAL TERRAIN, WEATHER & MORE\n\nEvery map is procedurally generated. **Use the terrain to your advantage!** Block pathways with **Walls** to divert enemies, place **Towers** on high ground where they\u2019re hard to reach, and lay **Thorns** at choke points to slow the invaders.\n\n{1668504473804122}\n\n# INTERESTED IN PLAYTESTING THE BETA VERSION?\n\nJoin the community and let us know: **notsuspicious.biz/discord**", "short_description": "Banners & Bastions is a real-time tactics roguelite in tabletop mixed reality. Fortify your kingdom, command your troops to take full tactical advantage of the procedural terrain, and outmaneuver the enemy in dynamic, strategic and epic battles!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.notsuspicious.biz/privacy", "developer_terms_of_service_url": null, "publisher_name": "Not Suspicious", "support_website_url": "https://www.notsuspicious.biz/discord", "website_url": "https://www.notsuspicious.biz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8387152764743063"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "4184135931850991"}, {"status": "PUBLISHED", "id": "1116714640431640"}, {"status": "PUBLISHED", "id": "1553450985967899"}, {"status": "PUBLISHED", "id": "1100713758798602"}, {"status": "PUBLISHED", "id": "668525845617944"}, {"status": "PUBLISHED", "id": "2071324063396220"}]}, "baseline_offer": {"id": "2071324063396220"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "4184135931850991"}]}, "liveChannel": {"nodes": [{"latest_support
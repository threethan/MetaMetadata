ng", "id": "646026574804312", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392010_646026578137645_9023846448384584760_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfi-L8pUfisQ7kNvwEhZm5O&_nc_oc=AdrKZqBG4hXn49QZVdTp1Idvzebeidb4gPeBePO-JoyOmZP9xHu1NvmbJ_nMi_gGK0E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBvN1BVw_YD6JKxQzfiZX1SBOkYa3ikzxqyrVsunh3KA&oe=6AF5C9AA"}, {"file_name": "4.png", "id": "1400275601117059", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1400275604450392_6111570253860139230_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBMnQc6LtpYQ7kNvwH6Fld2&_nc_oc=Ado1BIe9bbzB8m6sBQFt_fiqMet97IwV2Z3fLVsCSGexShayUQbYltqat0SDz728hwc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbvuj_NojLZmGtrZ1ZFLuqrADOrEPsLadC7FO5g_FE0Q&oe=6AF5E4CD"}, {"file_name": "5.png", "id": "2455081078173099", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391888_2455081081506432_2090184349680392773_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j16c1kJAuWIQ7kNvwFoDmXP&_nc_oc=AdpodFeisqed0nkVc1GUwqBTLu5q6_LhRCc2hydoDWmO_NTLoIzJKjk_xbMEhxKnMUs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsz61Xx63R-DVG636YRDucVEI7epy66a9S1oTsKkJL9w&oe=6AF5F08D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "528339819997704", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_528339823331037_367341527598948289_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYV21W18VpQQ7kNvwFlqgXi&_nc_oc=AdqgWW3ys_XiqOJdquKp3r9u8GILllbdrWNcT4yisZ_cof0laPpmATIu7J6BLVmPSS4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjldOLfHucDSsJ-bfbL88-W57SfzvxZxdHBUVkipDiWg&oe=6AF5D652"}, "display_name": "Punch Beat Arena", "keywords": ["Game", "Rhythm", "Music", "Fitness", "Boxing"], "long_description": "\ud83e\udd4a Punch Beat Arena \ud83c\udfb6\n\nStep into Punch Beat Arena, a high-energy VR boxing game that blends rhythm-based gameplay with fierce action. Get ready to fight to the beat as you throw punches, dodge, and weave to the music in a world where your reflexes and rhythm define your success.\n\nKey Features:\n\nRhythm-Driven Boxing: Strike, block, and move in sync with the music. Every action you take is influenced by the beat, offering an exhilarating challenge that combines skill and timing.\n\nWide Selection of Tracks & Arenas: Pick from a diverse array of tracks across various genres. Each song brings its own set of challenges and arenas, tailored for both beginners and advanced players.\n\nFitness Meets Fun: Punching to the beat isn't just about fun\u2014it's a full-body workout! Sharpen your reflexes and burn calories while enjoying the excitement of the game.\n\nImmersive Experience: With stunning visuals and high-quality sound design, every round feels like you're truly in the ring, feeling the music pump you up as you fight.\n\nGear up, find your rhythm, and punch your way to victory in Punch Beat Arena, where every beat is a new challenge to conquer!", "short_description": "\ud83e\udd4a Punch Beat Arena \ud83c\udfb6\n\nExperience the ultimate VR rhythm boxing game where every punch and move is synced to the beat. Fight, dodge, and punch to a variety of tracks in immersive arenas. A fun, full-body workout that combines music, action, and fitness in one exciting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED"
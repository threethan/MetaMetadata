uscdn.com/v/t64.5771-25/473391888_2455081081506432_2090184349680392773_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gn6MyR4b0PIQ7kNvwHPdI6W&_nc_oc=Adr9cXsb-F1_sqOWiMnbLO98pA4hqEm6reFLIUGwU6pXC9GwcCE4kSFybZZxigC37Ag&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaVLxEIF-aK7G59bu2TR4XfoGQ1H7NzbLqjbjA0wX9RQ&oe=6A81B44D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "528339819997704", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473392309_528339823331037_367341527598948289_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1e_wnSyttcQ7kNvwFyUwP0&_nc_oc=Adq-lrtimpyxPbYDxMZyfwFmifWYFl4J5rqyNyQM_wQUX7HhcxrCmm6f_xgJl-NxBO0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGchO4QfSRf6S_HBBnIZJV6g3kvWUb93Weo1zOtzzEDFA&oe=6A819A12"}, "display_name": "Punch Beat Arena", "keywords": ["Game", "Rhythm", "Music", "Fitness", "Boxing"], "long_description": "\ud83e\udd4a Punch Beat Arena \ud83c\udfb6\n\nStep into Punch Beat Arena, a high-energy VR boxing game that blends rhythm-based gameplay with fierce action. Get ready to fight to the beat as you throw punches, dodge, and weave to the music in a world where your reflexes and rhythm define your success.\n\nKey Features:\n\nRhythm-Driven Boxing: Strike, block, and move in sync with the music. Every action you take is influenced by the beat, offering an exhilarating challenge that combines skill and timing.\n\nWide Selection of Tracks & Arenas: Pick from a diverse array of tracks across various genres. Each song brings its own set of challenges and arenas, tailored for both beginners and advanced players.\n\nFitness Meets Fun: Punching to the beat isn't just about fun\u2014it's a full-body workout! Sharpen your reflexes and burn calories while enjoying the excitement of the game.\n\nImmersive Experience: With stunning visuals and high-quality sound design, every round feels like you're truly in the ring, feeling the music pump you up as you fight.\n\nGear up, find your rhythm, and punch your way to victory in Punch Beat Arena, where every beat is a new challenge to conquer!", "short_description": "\ud83e\udd4a Punch Beat Arena \ud83c\udfb6\n\nExperience the ultimate VR rhythm boxing game where every punch and move is synced to the beat. Fight, dodge, and punch to a variety of tracks in immersive arenas. A fun, full-body workout that combines music, action, and fitness in one exciting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://totosgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "de", "de_CH", "gsw", "zh_CN", "zh_HK", "nl", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "es", "ru", "ja"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9694929803900225"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PENDING", "id": "996033283403596"}, {"status": "PUBLISHED", "id": "1231266195765624"}, {"status": "PUBLISHED", "id": "755404783690773"}, {"status": "PUBLISHED", "id": "1748722695803228"}, {"status": "PUBLISHED", "id": "4402348996664885"}, {"status": "PUBLISHED", "id": "1363905571323299"}, {"status": "PUBLISHED", "id": "2071578583369343"}, {"status": "PUBLISHED",
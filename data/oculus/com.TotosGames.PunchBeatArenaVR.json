rlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0vQfBEnsocQ7kNvwE2SrsG&_nc_oc=AdqRURuy5EWVtOcDUx_cihMqD-3dpbyBPhsWevyYHqIx9wvXKhbBvePbXMFQ1iBInuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV-8P0xo88TjZFeJ-bOZnRDXhZGdLqXmQoDwE59pByDXQ&oe=6B0EFD0D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "528339819997704", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392309_528339823331037_367341527598948289_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zrym7oGbAp4Q7kNvwGE8HR2&_nc_oc=AdplDw70obMLY19zmMWz-EgxKHXL18U_PQxtyr2pMUrMhhvBveEMl6T7i7WbFxB7B2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQOZW9dBWjzNFwQFccQ8aqoChx6p8-SMJvdnWu3e8XxQ&oe=6B0F1B12"}, "display_name": "Punch Beat Arena", "keywords": ["Rhythm", "Music", "Fitness", "Boxing", "Workout"], "long_description": "# **\ud83e\udd4a Punch Beat Arena \ud83c\udfb6**\n\nStep into Punch Beat Arena, a high-energy VR boxing game that blends rhythm-based gameplay with fierce action. Get ready to fight to the beat as you throw punches, dodge, and weave to the music in a world where your reflexes and rhythm define your success.\n\n{1070244414940312}\n\n# **Key Features:**\n\n- Rhythm-Driven Boxing: Strike, block, and move in sync with the music. Every action you take is influenced by the beat, offering an exhilarating challenge that combines skill and timing.\n\n- Wide Selection of Tracks & Arenas: Pick from a diverse array of tracks across various genres. Each song brings its own set of challenges and arenas, tailored for both beginners and advanced players.\n\n- Fitness Meets Fun: Punching to the beat isn't just about fun\u2014it's a full-body workout! Sharpen your reflexes and burn calories while enjoying the excitement of the game.\n\n- Immersive Experience: With stunning visuals and high-quality sound design, every round feels like you're truly in the ring, feeling the music pump you up as you fight.\n\n{1030845768901015}\n\nGear up, find your rhythm, and punch your way to victory in Punch Beat Arena, where every beat is a new challenge to conquer!", "short_description": "\ud83e\udd4a Punch Beat Arena \ud83c\udfb6\n\nExperience the ultimate VR rhythm boxing game where every punch and move is synced to the beat. Fight, dodge, and punch to a variety of tracks in immersive arenas. A fun, full-body workout that combines music, action, and fitness in one exciting experience!\nLet's Play !!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar", "de", "de_CH", "gsw", "zh_CN", "zh_HK", "nl", "en_US", "en_AU", "en_CA", "en_ZA", "en_GB", "es", "ru", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29496519706647941"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391890_1727355564479003_4058662260912513191_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-f338gtEV0Q7kNvwG1HFRb&_nc_oc=AdrEOAOnD9kf2t8bfFmyC6v4x7oS13AS7VYZX097_OhUgMp
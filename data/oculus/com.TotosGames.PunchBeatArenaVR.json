dn.com/v/t64.5771-25/473392025_570326435364252_1671269543686935979_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lW9TkdKmfxwQ7kNvwHGCefu&_nc_oc=AdrttLOmUnLUSEG0QLjU3zgQ7wN7tlRpaArCv8LDd-Vl0MIbjKCVPXArykOivpvUHnw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTm94HL7q1KlfFtzIE4UvBFHqTPN4vKpksaFeQ4iBn_YA&oe=6B0323D7"}, {"file_name": "2.png", "id": "646026574804312", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473392010_646026578137645_9023846448384584760_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ltzlu8HVNzoQ7kNvwEh7xa_&_nc_oc=AdpqeX2cRFpP0MV41gZMvAokkXqI8LH20hbNwvZ-AgwibJRA2_yQr4Zm9_wS222sumA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL_qsKDBND3iQPHAKwWERHmnmjSaRUa_akPQ9URdpeRA&oe=6B0330EA"}, {"file_name": "4.png", "id": "1400275601117059", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1400275604450392_6111570253860139230_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0XDZe4A1UPMQ7kNvwHCTK3t&_nc_oc=AdrPLq3UtixPSTfXpfZvwz9t8scgdgXrCK4N9TotLZ-Kn9tPKdHNAHlr_F8XFWMljNk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj_o2daC18-dMxpLecmrcvD1yS7IoBy3A2njs_gauuyQ&oe=6B0313CD"}, {"file_name": "5.png", "id": "2455081078173099", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391888_2455081081506432_2090184349680392773_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RZu6y0BFqwwQ7kNvwEO0kuS&_nc_oc=Ado8YFp090l_fDZPvBRL_dvHj-xYHRJ4JZqkGLVtnKhZtMWtgrQJfPJNV3JHvHOfwgM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO3RmDUBlq2x0Ud6XdsOTTRteEteadYv06a2VP_Ivv6w&oe=6B031F8D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "528339819997704", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392309_528339823331037_367341527598948289_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBum16Z7b2kQ7kNvwFityNy&_nc_oc=AdpUl0_cbjOTONFTkw5fMbtozSC85gNmU7w7okfHDdg4qLdvlAWPUccZwNUC6ETvkSc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXLKaYgF-Vl7ItGWHJBgIMFHanHzC3wDlsF-REyRMgJw&oe=6B030552"}, "display_name": "Punch Beat Arena", "keywords": ["Game", "Rhythm", "Music", "Fitness", "Boxing"], "long_description": "\ud83e\udd4a Punch Beat Arena \ud83c\udfb6\n\nStep into Punch Beat Arena, a high-energy VR boxing game that blends rhythm-based gameplay with fierce action. Get ready to fight to the beat as you throw punches, dodge, and weave to the music in a world where your reflexes and rhythm define your success.\n\nKey Features:\n\nRhythm-Driven Boxing: Strike, block, and move in sync with the music. Every action you take is influenced by the beat, offering an exhilarating challenge that combines skill and timing.\n\nWide Selection of Tracks & Arenas: Pick from a diverse array of tracks across various genres. Each song brings its own set of challenges and arenas, tailored for both beginners and advanced players.\n\nFitness Meets Fun: Punching to the beat isn't just about fun\u2014it's a full-body workout! Sharpen your reflexes and burn calories while enjoying the excitement of the game.\n\nImmersive Experience: With stunning visuals and high-quality sound design, every round feels like you're truly in the ring, feeling the music pump you up as you fight.\n\nGear up, find your rhythm, and punch your way to victory in Punch Beat Arena, where every beat is a new challenge to conquer!", "short_description": "\ud83e\udd4a Punch Beat Arena \ud83c\udfb6\n\nExperience the ultimate VR rhythm boxing game where every punch and move is synced to the beat. Fight, dodge, and punch to a variety of tracks in immersive arenas. A fun, full-body workout that combines music, action, and fitness in one exciting experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://totosgames.com/PrivacyPolicy.html", "develop
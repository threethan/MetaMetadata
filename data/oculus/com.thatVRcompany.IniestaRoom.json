6_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mp8T9DIZ1hwQ7kNvwG4ed1B&_nc_oc=AdnUk8N2-aI1rC8QfmMCt7Uy-zjo3faH-R7FQb-e7tTxVrFg0Po3nOSErfrfwgYj2ls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afvgahxl5UF9o-dyKoxp25l7ToNSQznedM4Kfrk6f12epQ&oe=699ED308"}, {"file_name": "migrated_image.png", "id": "207369243662320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162695_546909425498117_4555880426018701312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PheUXaKo6soQ7kNvwHpwJ8m&_nc_oc=AdmpyGF7Krv97SVoTa5VI9iLUwx2hANoBWdetJWjMjqCElk3YDPqntfZ1Dg4AuOFI4s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfubKm3wbDKVruZIEqBYCJV8edEiHgNYXs_kUmygCkrSrg&oe=699F00DA"}, {"file_name": "migrated_image.png", "id": "207130827218334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12602072_530200093839753_7208251562861264896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4q18F9TSLoQ7kNvwHP4Mqx&_nc_oc=AdlQZLmIG1oQm9E3TxXt1CS_THb7R8AKLmJVRWj3r2_A0_naKWKdhY7DyTPVW1xIQT0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftjKI55UInOTBh6iQ9s92CtLxyub-_VyF6_mVDva1CjyQ&oe=699EFF7C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Illusionist-Iniesta", "keywords": ["football", "iniesta", "illusionist", "soccer", "documentry"], "long_description": "The Illusionist-Iniesta will give you a fantastic virtual reality experience. Standing in Andr\u00e9s Iniesta\u2019s hall of fame, viewers can read about his glory and highlight moment by pointing at the trophies, jerseys and football shoes on the wall. What\u2019s more, viewers can enjoy a short documentary of Iniesta himself. In this documentary, We applied a set of new filming equipment to obtain perfectly stabilized images and this allows us to use multiple filming methods including aerial filming and vehicle based filming. Simple fixed position filming will be the most basic filming method in our film. So that viewers can enjoy the beautiful sightseeing of Spain while they look into Iniesta\u2019s life and thoughts.\nwe will take viewers to Barcelona, Albacete and Fuentealbilla, to the places where Iniesta grew and became a legendary football player. We will also show the world how great his mind is and how he inspire new generations of football player all over the world.", "short_description": "The Illusionist-Iniesta will create fantastic virtual reality experience. Standing in Andr\u00e9s Iniesta\u2019s hall of fame, viewers can read about his glory and highlight moment. What\u2019s more, viewers can enjoy a short documentary of Iniesta. We applied new filming equipments to obtain perfectly stabilized images and simple fixed position filming will be the most basic filming method in this. So that viewers can enjoy the beautiful sightseeing of Spain while they look into Iniesta\u2019s life and thoughts."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thatvrcompany.com/", "developer_terms_of_service_url": "http://thatvrcompany.com/", "publisher_name": "thatVRcompany", "support_website_url": null, "website_url": "http://thatvrcompany.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "SPORTS", "EDUCATIONAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "263827272553896"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12727971_1028762223894938_3509592763119173632_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s99vZ9Z2l_AQ7kNvwFOv9IP&_nc_oc=Admw3XIWII4498IJzQGorxinbVAm-2xKM3c5
20128095326", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12386357_193470504421105_3740649909016068096_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZnyfvLnOKUQ7kNvwGbzUTh&_nc_oc=Adqqrj7mfBf4-ZP3QcfL1B1wY5BsKFGpAjm6_5bpzpBZzGPDKb9DESxreKWHj3tr7uA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ogauy199rWNBuNSS29ZGuxV2Amq_jUXKnd3XpyDXAiQ&oe=6A26D5C8"}, {"file_name": "migrated_image.png", "id": "207369243662320", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162695_546909425498117_4555880426018701312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtPttaQJJ10Q7kNvwGPsPQr&_nc_oc=AdrNxjSqUutt_4nNN_45yhKoYTvzmPiHIAX431MtE2eZXHhckQmAYmCHsdPmKkZoujQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bKfIH_z95Z20sRD1bwkV4LGU96FAm7SzgSg2BBe6sqQ&oe=6A26CB5A"}, {"file_name": "migrated_image.png", "id": "207130827218334", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12602072_530200093839753_7208251562861264896_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMf9snS1ARUQ7kNvwEPInr4&_nc_oc=AdosS1UE0_fTG75URR3qUEP3QyLobT6E7Ad1xBPw00AiwnISE87aSqI67qF7g6DSpWw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_knEjuwsqPV02bH_3vfNyiRwLIxMD_lasKXenK4JEF_Q&oe=6A26C9FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Illusionist-Iniesta", "keywords": ["football", "iniesta", "illusionist", "soccer", "documentry"], "long_description": "The Illusionist-Iniesta will give you a fantastic virtual reality experience. Standing in Andr\u00e9s Iniesta\u2019s hall of fame, viewers can read about his glory and highlight moment by pointing at the trophies, jerseys and football shoes on the wall. What\u2019s more, viewers can enjoy a short documentary of Iniesta himself. In this documentary, We applied a set of new filming equipment to obtain perfectly stabilized images and this allows us to use multiple filming methods including aerial filming and vehicle based filming. Simple fixed position filming will be the most basic filming method in our film. So that viewers can enjoy the beautiful sightseeing of Spain while they look into Iniesta\u2019s life and thoughts.\nwe will take viewers to Barcelona, Albacete and Fuentealbilla, to the places where Iniesta grew and became a legendary football player. We will also show the world how great his mind is and how he inspire new generations of football player all over the world.", "short_description": "The Illusionist-Iniesta will create fantastic virtual reality experience. Standing in Andr\u00e9s Iniesta\u2019s hall of fame, viewers can read about his glory and highlight moment. What\u2019s more, viewers can enjoy a short documentary of Iniesta. We applied new filming equipments to obtain perfectly stabilized images and simple fixed position filming will be the most basic filming method in this. So that viewers can enjoy the beautiful sightseeing of Spain while they look into Iniesta\u2019s life and thoughts."}]}, "developer_name": null, "developer_privacy_policy_url": "http://thatvrcompany.com/", "developer_terms_of_service_url": "http://thatvrcompany.com/", "publisher_name": "thatVRcompany", "support_website_url": null, "website_url": "http://thatvrcompany.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["MOVIE", "SPORTS", "EDUCATIONAL", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "263827272553896"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12727971_1028762223894938_3
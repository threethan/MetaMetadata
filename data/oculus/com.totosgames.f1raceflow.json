tent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQTl7_hD25jhNmba0OphMxG-Lwd8jZ-rw7jzhoqko3K9w&oe=6B0DBDF6"}, {"file_name": "F1RaceFlow_Screenshot_02_Snow_Battle.png", "id": "1054317487570559", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828038_1054317490903892_471227002543013898_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=621Ftv-PAIYQ7kNvwGnT-i2&_nc_oc=AdrFH30cErl7RyXiCKJ5XQsrN3hh1hvPs6rRK8j0kT3VEcPldIOGzlIlahps48fjuSA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMSUDwJcdaLDihnt8Mg5tWBF4E8QXHdHXikKpuWwF2xw&oe=6B0D9C73"}, {"file_name": "F1RaceFlow_Screenshot_04_Forest_Cockpit.png", "id": "1091483343598862", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825481_1091483346932195_7709737363370291162_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGGCJ4UyKrEQ7kNvwH2ei88&_nc_oc=AdpV3tlc8QMxkQYFEPDzqRKiW_sHC11nIt7yGDVfhUmLWiRz2x_zSPR3gahgF2OTJ7s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ57oKWHfhI9_mVqgHdtlbuhZLbavsq-yJ-gHSztHCD2Q&oe=6B0DC90E"}, {"file_name": "F1RaceFlow_Screenshot_03_Rain_Cockpit.png", "id": "1071688099039893", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825575_1071688102373226_8445232760235598428_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SHvBcioA0hwQ7kNvwHHBuN7&_nc_oc=AdrjqhFwOnmYhBTVqgbbQF0ql5u9sS0ZhGQABnCLxuHoagJ--CjrXjoXjJgnuMlAAKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTF92jsB9jJF1Mmj7nxZyjBuaC-51iUNvMfJajWjmhS_A&oe=6B0DA015"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "F1RaceFlow_Trailer_Cover_2560x1440.png", "id": "1623432512521259", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830822_1623432515854592_265173518105044417_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeyITE-_bRkQ7kNvwHj8liu&_nc_oc=AdpBqrH3XxjBs9c17uL6NFL5Rbuub7LNPznviv2HnaoL0wonpkab02KGfvrVbzaBdW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgAjwGO1w2GNM58BPEJDAGaH5IIIEIy9ydr51bfG8V5g&oe=6B0DD0F8"}, "display_name": "RaceFlow F1", "keywords": ["Racing", "Driving", "Cars", "Formula", "Motorsport"], "long_description": "F1 Race Flow puts you in the cockpit of an open-wheel race car. Reach out, grab the wheel with both hands and turn it to steer. The right trigger is your throttle, the left trigger brakes, and the wheel vibrates in your hands when the tyres start to slide.\n\nRACE\n\u2022 Line up on a 10-car grid, watch the five red lights and launch when they go out\n\u2022 Battle nine AI rivals with live position, lap and delta timing\n\u2022 Fire the ERS boost on the straights and chase your personal best lap on every track\n\u2022 Take the chequered flag, then cool down while the classification comes in\n\nTRACKS AND CARS\n\u2022 Six circuits through forest, autumn, winter, snowfall and heavy rain\n\u2022 Two eras: modern hybrid-era cars and 1960s legends\n\u2022 Earn coins with podium finishes to unlock new tracks and cars\n\nBUILT FOR VR\n\u2022 Live steering-wheel display, shift lights and a holographic HUD in the cockpit\n\u2022 Corner arrows and on-track hints that help new drivers find their way\n\u2022 Steering assist, wheel ratio and vibration settings\n\u2022 Easy or Simulation difficulty\n\u2022 Seated play with one-button recentering\n\u2022 English, Turkish, German, Spanish and French", "short_description": "Take the wheel of an open-wheel race car in VR. Grab the steering wheel with both hands, launch off the grid when the lights go out and battle nine rivals through forest, autumn, snow and heavy rain. Drive modern hybrid-era cars or 1960s legends, win podiums to unlock new tracks and cars, and tune steering assist, wheel ratio and vibration to suit your driving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "
c_oc=AdrMmrCmpQNSkw5m8sHrbPLtiXK1p9411NLQEIMGA4PEGmFysaIU4Yu2Mm9UhaO2F0o&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvCL08ZJbpV5EDEx4CYD5yecpcJo0oz56sVkhvt3tsJQ&oe=6AFC6D4E"}, {"file_name": "F1RaceFlow_Screenshot_03_Rain_Cockpit.png", "id": "1071688099039893", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825575_1071688102373226_8445232760235598428_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNwofkFd4JgQ7kNvwEUe54T&_nc_oc=Adrff0B4aybJogQRIikkr0z1FXuOZ6sHE5ZdlYvcFS55nQUUKsAsDSxeu54NqzWi5Eo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrnKDYrIKfo8CVvYFzgW0zOGvPYf6xE05idy9it4nTXQ&oe=6AFC7C95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "F1RaceFlow_Trailer_Cover_2560x1440.png", "id": "1623432512521259", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_1623432515854592_265173518105044417_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nN2ZylETjPQQ7kNvwHAMnyY&_nc_oc=AdoCVpqO9hB5lGhjc8mdwzsjQFSZF2jkhOqktbDduike21O40p7PAMJanmzXA5cSl1A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvirCmvYqvPBQ9855bG8PqOsepISIAXl0XA97wEQLmbw&oe=6AFC7538"}, "display_name": "RaceFlow F1", "keywords": ["Racing", "Driving", "Cars", "Formula", "Motorsport"], "long_description": "F1 Race Flow puts you in the cockpit of an open-wheel race car. Reach out, grab the wheel with both hands and turn it to steer. The right trigger is your throttle, the left trigger brakes, and the wheel vibrates in your hands when the tyres start to slide.\n\nRACE\n\u2022 Line up on a 10-car grid, watch the five red lights and launch when they go out\n\u2022 Battle nine AI rivals with live position, lap and delta timing\n\u2022 Fire the ERS boost on the straights and chase your personal best lap on every track\n\u2022 Take the chequered flag, then cool down while the classification comes in\n\nTRACKS AND CARS\n\u2022 Six circuits through forest, autumn, winter, snowfall and heavy rain\n\u2022 Two eras: modern hybrid-era cars and 1960s legends\n\u2022 Earn coins with podium finishes to unlock new tracks and cars\n\nBUILT FOR VR\n\u2022 Live steering-wheel display, shift lights and a holographic HUD in the cockpit\n\u2022 Corner arrows and on-track hints that help new drivers find their way\n\u2022 Steering assist, wheel ratio and vibration settings\n\u2022 Easy or Simulation difficulty\n\u2022 Seated play with one-button recentering\n\u2022 English, Turkish, German, Spanish and French", "short_description": "Take the wheel of an open-wheel race car in VR. Grab the steering wheel with both hands, launch off the grid when the lights go out and battle nine rivals through forest, autumn, snow and heavy rain. Drive modern hybrid-era cars or 1960s legends, win podiums to unlock new tracks and cars, and tune steering assist, wheel ratio and vibration to suit your driving."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tolgakalaycioglu.com/totosgame/PrivacyPolicy.html", "developer_terms_of_service_url": null, "publisher_name": "Totos Games", "support_website_url": null, "website_url": "https://tolgakalaycioglu.com/totosgame/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "673385183287495"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "de_CH", "gsw", "tr", "fr_BE", "fr_CA", "fr", "ja", "zh_CN", "zh_HK", "zh_TW", "es_VE", "es", "es_PR", "es_PE", "es_MX", "es_CO", "es_CL", "es_AR"], "supported_input_devices"
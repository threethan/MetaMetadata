nt-ord5-2.oculuscdn.com&oh=00_Aful1ocrtt-SN1IdY4TEyRaBWf-AZrn4JSsqVvrS4T4Vgg&oe=699AE2A5"}, {"file_name": "screenshots_0007_Layer-28.png", "id": "992266811305974", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974459_992266814639307_8359957710819299270_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3yvJXcPn7AQ7kNvwFolr6j&_nc_oc=AdkOppAJ5tHR6xF4DRKaqAUlu-bRs8zlNnRJaCHQc-KzuAFVlghtbgJijuE9tT2O0k0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft12FCaQvSP3YyWCdPjshPAEl9Fo6q-wZ-BfA0A70bWow&oe=699B0A55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TwilightZoneVr_trailercxoverimage.png", "id": "5222380741138907", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035383_5222380747805573_5285048965061308735_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2wHRKnzD3UQ7kNvwG_4kIy&_nc_oc=Adk8Icdsv3smK7LWMcmBUkTVDwCzcQWd3CcAUyJVqZDY5d_TZ9cVVSMlwAV0zDCkl5Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Aft8-uYBSICymN_CpMCA8z687bb0Z3xNPBonNzYgBcsOvw&oe=699AEDAA"}, "display_name": "The Twilight Zone\u2122", "keywords": ["twilight", "horror", "puzzles", "shooter", "adventure"], "long_description": "We invite you to face your fears in a disturbing and mind-bending series of adventures... all taking place within The Twilight Zone\u2122. This game features elements of stealth, shooting, escape mechanics and eye-popping visuals.\n\nStory 1: CHARACTER BUILDING - A video game director discovers that workplace cruelty is a dangerous game.  \n\nStory 2: TERROR FIRMA - After an environmental apocalypse, one survivor must face mysterious phantoms as he searches the city ruins for a glimmer of Hope. \n\nStory 3: DEADLINE EARTH - The clock is ticking for a science fiction writer who finds himself captive on an insidious alien vessel.\n\n---------------------------------------\n\n\u00a9 2022 Software - Fun Train Media LLC\n\nTM & \u00a9 1959 CBS  TM & \u00a9 2022 A CBS Company. THE TWILIGHT ZONE and related marks and logos are trademarks of A CBS Company. All Rights Reserved. \n\n\u201cTwilight Zone\u201d (Main Title) Writer: Marius Constant\nUsed by Permission of Sony/ATV Music Publishing LLC. All Rights Reserved\n", "short_description": "You will be traveling through another dimension. A dimension not only of sight and sound but of the mind.  You are invited to enter\u2026 The Twilight Zone\u2122. \n\nThe producers that brought you the horror hit The Exorcist: Legion now present a new mind-bending anthology game featuring interwoven tales of science fiction, horror and mystery with game types including stealth, shooting and escape challenges.  "}]}, "developer_name": "Pocket Money Games", "developer_privacy_policy_url": "https://www.twilightzonevr.com/privacy-policy", "developer_terms_of_service_url": "https://www.twilightzonevr.com/eula", "publisher_name": "Fun Train", "support_website_url": "https://www.twilightzonevr.com/support", "website_url": "http://www.TwilightZoneVR.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "417936290127690"}}]}, "scheduled_offers": {"count": 23, "nodes": [{"status": "PUBLISHED", "id": "755993127566992"}, {"status": "PUBLISHED", "id": "1949795632415685"}, {"status": "PUBLISHED", "id": "702017886253945"}, {"status": "PUBLISHED", "id": "1119262143093179"}, {"status": "PUBLISHED", "id": "2804132609786703"}, {"status": "PUBLISHED
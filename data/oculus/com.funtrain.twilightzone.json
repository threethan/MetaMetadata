png", "id": "797917626158797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622334_797917629492130_7985838913981650381_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yXD9SeISA0Q7kNvwGzK73p&_nc_oc=Adr_JuQe3jLiMx5k2ou5o9OTe4hqgSBX1WIqwyuehPYvTWajYEvpltYioWlOBUk_QmM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17rF5wwnpp35LWZRlvBkUmdiIUBlu5IVjiLcSGwlrJMQ&oe=69DA3D78"}, {"file_name": "TWZ Ch3 Graphics Update-30.png", "id": "1834421597155482", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307435_1834421600488815_4356190897980171757_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=goM2cGKWGHUQ7kNvwHMNM1h&_nc_oc=Ado1pNMnnv0hYuh0HNbVcEyNP_aBCWZN_mRtUy7al3cVvdSSNRDayjy74GEmvRQ9CS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uVd6L1BLXWCtKdRZl-rrGVbdk6fm_DkdIVpcUpdKTOg&oe=69DA40F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TWZ Cover Landscape 2560x1440.png", "id": "1078415157773468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618102_1078415161106801_7794481446946948691_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHUBavI6_O4Q7kNvwGFVBc4&_nc_oc=AdryDaFXUu91t3awvdRs5uf9QiZri5immjyWqzbriCn3khPGL4UZ99d9c6guR45M57Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gbXqcAGmckMmFZc0d8dWi3QPQH4ADT2mNcO_3GSiQtQ&oe=69DA52B6"}, "display_name": "Tales from the Zone\u2122", "keywords": ["twilight", "horror", "puzzles", "shooter", "adventure"], "long_description": "We invite you to face your fears in a disturbing and mind-bending series of adventures... all taking place within Tales from the Zone\u2122. This game features elements of stealth, escape mechanics and narrative twists.  Unlock secrets to enable new modes!\n\n{740987448165854}\n\nStory 1: CHARACTER BUILDING - A video game director discovers that workplace cruelty is a dangerous game.  \n\nStory 2: TERROR FIRMA - After an environmental apocalypse, one survivor must fight mysterious phantoms as he searches the city ruins for a glimmer of Hope. \n\nStory 3: DEADLINE EARTH - The clock is ticking for a science fiction writer who finds himself captive on an insidious alien vessel.  What are their true intentions?\n\n{2896850753787574}\n---------------------------------------\n\n\u00a9 2026 Software - Fun Train Media LLC", "short_description": "You will be traveling through another dimension. Prepare your mind, body and soul.  You are invited to enter\u2026 Tales from the Zone\u2122. \n\nThe producers that brought you the horror hit Exorcism of the Legion (Last Rites) now present a new mind-bending anthology game featuring interwoven tales of science fiction, horror and mystery."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.funtrainvr.com/twilightzonevr-privacy-policy", "developer_terms_of_service_url": "https://www.funtrainvr.com/twilightzonevr-eula", "publisher_name": "Fun Train", "support_website_url": "https://www.funtrainvr.com/support", "website_url": "https://www.funtrainvr.com/the-twilight-zone", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26081855271445661"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499293201_908726558367721_8809732387310998175_n.png?stp=dst-png
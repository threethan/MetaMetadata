9602_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUkVm0dES_UQ7kNvwHaCE7_&_nc_oc=Adk5GYbTdrq7jjuynA4THUuSOXnU8h01yIOQy0lBYAjRDLhJp4otde1EaL08ZdAhiqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afukxy4oXV3J9SFSaKpKnAvO5nMizXngylqsdB1LJewyxQ&oe=6999A940"}, {"file_name": "TWZ Ch3 Graphics Update-09.png", "id": "797917626158797", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622334_797917629492130_7985838913981650381_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-RzD4tMUhkQ7kNvwEVUroK&_nc_oc=AdmRr7lG0FoALaKuBUNKM80da2OqggxmSlRlb6QJ0eV32U6GQw8qKqII2cRPMHd-hAs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft7k3lGVQszTHVnuVI0vlvcM4hD4YFujIw9O4X4avfE7A&oe=6999A3F8"}, {"file_name": "TWZ Ch3 Graphics Update-30.png", "id": "1834421597155482", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307435_1834421600488815_4356190897980171757_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_jV_iduCQEQ7kNvwFfs5Y9&_nc_oc=AdndU60gguWIeSmZ2TJmqT7i-6vYgY0IeiNZzdCboJbl4pOZpP2dQc1NGmkTuTB12uo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuyULcPfJjrOc7eIUedrPgPl53CFdY0ZpGxrbRrcekjWw&oe=6999A770"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TWZ-Quest-3-Update-Keyart-16x9-2560x1440.png", "id": "834036625659061", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499302651_834036628992394_1787498339209081810_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXgv-EuEVnUQ7kNvwGDlh-2&_nc_oc=AdmashXuLYFrmW2PtC7s_GcrY0YlSOeox8R4hrdwU2gb-i2TOl-6SrS_p4AHpvChTUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvzVV1Tp_XdnZlFrUroL8is0cyw6xkfhim5OHKi9GCmKA&oe=6999BC11"}, "display_name": "The Twilight Zone\u2122", "keywords": ["twilight", "horror", "puzzles", "shooter", "adventure"], "long_description": "We invite you to face your fears in a disturbing and mind-bending series of adventures... all taking place within The Twilight Zone\u2122. This game features elements of stealth, escape mechanics and narrative twists.  Unlock secrets to enable new modes inspired by the classic series.\n\n{740987448165854}\n\nStory 1: CHARACTER BUILDING - A video game director discovers that workplace cruelty is a dangerous game.  \n\n{1905987179870208}\n\nStory 2: TERROR FIRMA - After an environmental apocalypse, one survivor must fight mysterious phantoms as he searches the city ruins for a glimmer of Hope. \n\n{1047469276401164}\n\nStory 3: DEADLINE EARTH - The clock is ticking for a science fiction writer who finds himself captive on an insidious alien vessel.  What are their true intentions?\n\n{2896850753787574}\n---------------------------------------\n\n\u00a9 2025 Software - Fun Train Media LLC\n\nTM & \u00a9 1959 CBS  TM & \u00a9 2025 A CBS Company. THE TWILIGHT ZONE and related marks and logos are trademarks of A CBS Company. All Rights Reserved. \n\n\u201cTwilight Zone\u201d (Main Title) Writer: Marius Constant\nUsed by Permission of Sony/ATV Music Publishing LLC. All Rights Reserved", "short_description": "You will be traveling through another dimension. A dimension not only of sight and sound but of the mind.  You are invited to enter\u2026 The Twilight Zone\u2122. \n\nThe producers that brought you the horror hit The Exorcist: Legion now present a new mind-bending anthology game featuring interwoven tales of science fiction, horror and mystery."}]}, "developer_name": "Pocket Money Games", "developer_privacy_policy_url": "https://www.funtrainvr.com/twilightzonevr-privacy-policy", "developer_terms_of_service_url": "https://www.funtrainvr.com/twilightzonevr-eula", "publisher_name": "Fun Train", "support_website_url": "https://www.funtrainvr.com/support", "website_url": "https://www.funtrainvr.com/the-twilight-zone", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "
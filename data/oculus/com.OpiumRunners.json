dn.com/v/t64.5771-25/491818885_1378445934292455_7853234365859642954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JPcJoqDM4cQ7kNvwG9LOmN&_nc_oc=AdqYnt8UkD9j6eeXJzBKyRK2sbJYXkSDjRQ0rwCbZL9LjJZ3nHhw7xscRk3U5l4bEr0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ou_6S12p6GEZQBZIrNWagYzWaL5p7u1uscAzDM0BQ6g&oe=69DE3882"}, {"file_name": "Unti32444444444444444444444444tled.png", "id": "1052758666983866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_1052758670317199_239219709575609681_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhAzXRtOiQwQ7kNvwG0t8wP&_nc_oc=AdoleLemR6gEICPokTFXsOIiI6zHIFdtGf7qJtZjf2ukhOvvgpHqjvbffqCoNtQ6gxI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EjlLNTDZnNNtBibbj1lfdFyqL-KLdyjuwDuqXCtnAdA&oe=69DE23B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Runners", "keywords": ["Gorilla", "Monkey", "Taggers"], "long_description": "Opium Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium Runners is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes.\n"}]}, "developer_name": "Tuff Studios", "developer_privacy
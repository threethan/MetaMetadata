7a0a&_nc_ohc=mBGBmo6alLYQ7kNvwFmK80k&_nc_oc=AdoHyMadR_qapGL5c26EU0qKD_dESlM2YSMNfTKCwU4Qy7jGvUoKA7B-Xh66w8HcPk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3uoo-sdi970JQDibh0_PBCCHgg3HliZJgsJcUtldHhGQ&oe=69F0AD82"}, {"file_name": "Unti32444444444444444444444444tled.png", "id": "1052758666983866", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819281_1052758670317199_239219709575609681_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTp8R-U2XG0Q7kNvwGLDk64&_nc_oc=AdpN84Ldq7hLs_6j1rFEI1aqhsVJShQ9hRA3tlpGdxSSJg9XNpT4gnujLYqQDedsFpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1OfyFqOTMsy-fN-FsH1kpBF8Rb08yUSRhGOQoNZDyifQ&oe=69F0D0F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Runners", "keywords": ["Gorilla", "Monkey", "Taggers"], "long_description": "Opium Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium Runners is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes.\n"}]}, "developer_name": "Tuff Studios", "developer_privacy_policy_url": "https://docs.google.com/document/d/1g8xBmqwqP-Ax3lzsv0Dr0Jtps04VyBDLi1MzGac6lEk/edit?usp=sharing", "developer_terms
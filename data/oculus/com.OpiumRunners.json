dn.com/v/t64.5771-25/491818885_1378445934292455_7853234365859642954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mI6nQFSKPdcQ7kNvwHMfxpO&_nc_oc=AdoNfGN6KSeTsUot9J-SB9oX9IFdDLDSU_xrDKAEJswUwP_c8wiDMXCa5QAvnT6gn7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81cc_AcQkPG2fIpKyGtQjq-9KTWCXJikvoXnOuZlvIww&oe=6A43BC02"}, {"file_name": "Unti32444444444444444444444444tled.png", "id": "1052758666983866", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819281_1052758670317199_239219709575609681_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFoj8OCwAQQQ7kNvwHY907c&_nc_oc=AdqLR51RPf4wojjQIXMSvlaId7_y7K5MaEITwuQOz68QKkVmTEFkQs2pm5zPxhpYkKk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KUS8CXwqTqLxQNp-5l3bbJSU6vh5cyhz_ci6ZlNoieQ&oe=6A43DF74"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Runners", "keywords": ["Gorilla", "Monkey", "Taggers"], "long_description": "Opium Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium Runners is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes.\n"}]}, "developer_name": "Tuff Studios", "developer_privacy
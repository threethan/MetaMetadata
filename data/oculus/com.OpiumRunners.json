dn.com/v/t64.5771-25/491818885_1378445934292455_7853234365859642954_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjvuufXZ3oYQ7kNvwH5Kbrv&_nc_oc=AdrKbYe0PLPWewhG1HexqNdhS3VvHDY2M19CyGTQKxCCswNKqfxhxl3G5RSGqJZakhI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-R4hOwTIi-XMP1NCb0XLw3QWvL3xMJP24oKg8fRA4QaA&oe=6A3EAE42"}, {"file_name": "Unti32444444444444444444444444tled.png", "id": "1052758666983866", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819281_1052758670317199_239219709575609681_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5ZWjYaS4s4Q7kNvwF6PT5B&_nc_oc=AdrvP2q8pFu7SuxnDGuVMzqTPrrjmIA9gZGzAHNCXEiY9G9mRULErPs1cZAnhokx0lQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sOtDInEXCGM1Ui4gt9TkKUKVJ4Z6iyco18wz4EaWiRg&oe=6A3E9974"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Opium Runners", "keywords": ["Gorilla", "Monkey", "Taggers"], "long_description": "Opium Runners drops players into a flat, boxed-in forest where every tree is a platform and every branch is an opportunity. The environment is simple but vertical, letting you climb high, leap across gaps, and surprise opponents from above. Movement is fast and fluid, turning each chase into a creative parkour run through the trees. The open layout keeps the action constant, with clear visibility and plenty of routes to escape or ambush. It\u2019s a game of speed, strategy, and improvisation\u2014where the best taggers are the ones who master the forest\u2019s height and flow.\n", "short_description": "Opium Runners is a fast-paced tag game set in a flat, boxed-in forest. Tall, simple trees create a vertical playground you can climb and jump across. Players race through the woods, using height and movement to outsmart each other. The map is open, clean, and easy to read, keeping the focus on pure action. It\u2019s all about agility, creativity, and quick escapes.\n"}]}, "developer_name": "Tuff Studios", "developer_privacy
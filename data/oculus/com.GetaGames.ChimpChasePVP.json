", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036624_3727736297468474_9017855597551535999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poAnGXBMUAAQ7kNvwGVWgCg&_nc_oc=Adl0eYCBc62IoMCnwtUaGUeT_1YG-d9Yq7I4A-rZm8OIii3P0rHOJvePLof1TY63WGQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvcMgagQ5FMGl8yc0IB6sb7xK3nti8oaEs7_JVjp0uSPg&oe=69A80C68"}, {"file_name": "woods screenshot.png", "id": "473417915806898", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392005_473417919140231_8904242914082593251_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlfRVB9qZg0Q7kNvwGVaP1K&_nc_oc=AdnxrnIKXgHJpnTvJ8hek5o8NERU_yOoMVDDdQXW-KinMjYI911Ta3st1m_1KbNAa1Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aftuynbcnmem7Yoq01TqHpUe3P59NMH4TGDl-adAvA8QZw&oe=69A81172"}, {"file_name": "shop ss.png", "id": "1814159865655009", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391924_1814159868988342_1441349150669345766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhRhABqkGO4Q7kNvwGannGi&_nc_oc=AdntrTDQXYdbvDB0VhQpVuQ16SMKP_nm1jtu_WEBrf5doRQvt_0EkaXXBWMu8y8i3KM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs3uAVccTgQREsZm-DaHOuVZ_xZY7Osj-yZqzFb4WB7iw&oe=69A82ED4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39035341_210173948412680_4740011655580331961_n.png", "id": "808149744570534", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982626_808149747903867_5100784820136452062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PzHTBreYxGcQ7kNvwHBkp_e&_nc_oc=AdmP_gfWIDj43XUGL_EogoBcXraN0P1OPgBK2Uks0DEpLWX9H9qTWpQtjawmdg1VOQQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuETOcIcv5ujxRdTvj-k0wPtxZji9ZuEOVrzm5qGDzp-Q&oe=69A8171F"}, "display_name": "Chimp Chase PVP", "keywords": [], "long_description": "Chimp Chase is a thrilling PVP game that redefines the excitement of the Gorilla Locomotion movement system. Immerse yourself in a one of a kind experience as you choose from an arsenal of primary and secondary weapons. Then, dive straight into the battle zone for intense online PVP battles with other players.\n\nComplete quests to earn ores, which you can then use to purchase a wide variety of stylish cosmetics, allowing you to pimp your chimp's appearance and express yourself on the battlefield.\n\nEnter the world of Chimp Chase and take part in awesome battles that combine skill, style, and fun to provide the best possible experience.", "short_description": "Welcome to Chimp Chase, hop straight into the battle zone with your favorite weapons and compete against other players in some good old fashioned PVP!"}]}, "developer_name": "GetaGames Limited", "developer_privacy_policy_url": "https://www.termsfeed.com/live/ffb76398-19d9-4068-8752-7b21003b1274", "developer_terms_of_service_url": "https://getagamesbusiness.wixsite.com/chimp-chase-pvp/code-of-conduct", "publisher_name": "GetaGames Limited", "support_website_url": null, "website_url": "http://getagames.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24266976246248407"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499620513_1159971086162491_1087171174459102113_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4fYgzh2YPekQ7kNvwFJxfrr&_nc_oc=Adk3DV96l__LE2QmlsG5_8pjuVDhWPHwI
", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036624_3727736297468474_9017855597551535999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcDxFW04O9oQ7kNvwFYzyS9&_nc_oc=AdmHCtw2k2qGkMQfKc3M5T-2tKtfuSzf4uAEHZB9Wac7f0s2-6Rtf92EXbb3CPJ1rzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxk8sYhc-UMc6dvCQbmr2Dhi5Xb6lHoUUHW1LoQhyQHzg&oe=69B53B68"}, {"file_name": "woods screenshot.png", "id": "473417915806898", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392005_473417919140231_8904242914082593251_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9YQmVBuoukQ7kNvwH2WMUD&_nc_oc=Admy2yL_VziZH4kmilXnLY3DCfD6b7eOhdYORDm4ZItRzzM09igF5DtGhClhqXOnXhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyVJzxJ1NUBoUziAiTHbZJ43F4g1HokdGxUkAtkswySEg&oe=69B54072"}, {"file_name": "shop ss.png", "id": "1814159865655009", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391924_1814159868988342_1441349150669345766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0QJaZcr-EsQ7kNvwEwOjyb&_nc_oc=AdkhNJfPcq88FPThKDWiBl10hBsMTnqoirsqi5Wgpcott1ael949-bTY7zosjjhx6b8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwCn3RBStiZ0_y5znzwey6aq4ZhokCYDM-7pXH6ebARiA&oe=69B55DD4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39035341_210173948412680_4740011655580331961_n.png", "id": "808149744570534", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982626_808149747903867_5100784820136452062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6fZoOtjvVJAQ7kNvwFXoTuc&_nc_oc=AdkXoBIyo__3zBxH_ujzsTF4IyG2KGKcc_YFRenmd32iVG6cUQc74RpKUB-XSSPp320&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afysl-qMAlYsm5cp-y6jdZFei6hRpJgNigw3PKLpCRSjiQ&oe=69B5461F"}, "display_name": "Chimp Chase PVP", "keywords": [], "long_description": "Chimp Chase is a thrilling PVP game that redefines the excitement of the Gorilla Locomotion movement system. Immerse yourself in a one of a kind experience as you choose from an arsenal of primary and secondary weapons. Then, dive straight into the battle zone for intense online PVP battles with other players.\n\nComplete quests to earn ores, which you can then use to purchase a wide variety of stylish cosmetics, allowing you to pimp your chimp's appearance and express yourself on the battlefield.\n\nEnter the world of Chimp Chase and take part in awesome battles that combine skill, style, and fun to provide the best possible experience.", "short_description": "Welcome to Chimp Chase, hop straight into the battle zone with your favorite weapons and compete against other players in some good old fashioned PVP!"}]}, "developer_name": "GetaGames Limited", "developer_privacy_policy_url": "https://www.termsfeed.com/live/ffb76398-19d9-4068-8752-7b21003b1274", "developer_terms_of_service_url": "https://getagamesbusiness.wixsite.com/chimp-chase-pvp/code-of-conduct", "publisher_name": "GetaGames Limited", "support_website_url": null, "website_url": "http://getagames.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24266976246248407"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620513_1159971086162491_1087171174459102113_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykTaAvuvHtEQ7kNvwHplGOs&_nc_oc=AdkcbeTDG9gNwvuC4tTxR_lrXUgF0e_Sb
", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036624_3727736297468474_9017855597551535999_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnxUk-d2zX4Q7kNvwHErEMf&_nc_oc=AdooABmIwyu1eP9juRtHhTyRzIF2a-uLWWUXYN4siw2rmu6ei69wcq1PmVbI5NjkNYk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_Cqu2gEN5V07ZkIEIBLXVSgWsblTPEekCPvJqH2dgkQ&oe=69C15128"}, {"file_name": "woods screenshot.png", "id": "473417915806898", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392005_473417919140231_8904242914082593251_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCE8TKwFuGkQ7kNvwG5p6SY&_nc_oc=Adre31oxeQO4askcZNYghjVJiPf8PJBTvaTtOInPkjCz8sArqaApkmLIfgketQMXS_w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoUmZNJhhxjECyLmF4SIothwT5vuDNCG7dx91meCGy5w&oe=69C11DF2"}, {"file_name": "shop ss.png", "id": "1814159865655009", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391924_1814159868988342_1441349150669345766_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pO3pdH_6SpIQ7kNvwFKCEDa&_nc_oc=Ado3JtKspTd25DYrZ9fFmTO62Ook5hAmDNomA1rapchvUT3T5ZD1sNqLrOEvojsiKYU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUguogK5-63kgPymfwzg2PE5huMkFbArOo7eekCFkbeg&oe=69C13B54"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39035341_210173948412680_4740011655580331961_n.png", "id": "808149744570534", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982626_808149747903867_5100784820136452062_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9CDypEch2voQ7kNvwHVSOAN&_nc_oc=AdrZOJF0Jp9fYv9KzrMUJUWPpIFMt9YsvcQEJ3wutwBN-k0ELpA15OjkvwOU_vvEQ14&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBFqOL2ictjW7qZbbgmM8si2NswQdEhlA3YW-zq2tudQ&oe=69C1239F"}, "display_name": "Chimp Chase PVP", "keywords": [], "long_description": "Chimp Chase is a thrilling PVP game that redefines the excitement of the Gorilla Locomotion movement system. Immerse yourself in a one of a kind experience as you choose from an arsenal of primary and secondary weapons. Then, dive straight into the battle zone for intense online PVP battles with other players.\n\nComplete quests to earn ores, which you can then use to purchase a wide variety of stylish cosmetics, allowing you to pimp your chimp's appearance and express yourself on the battlefield.\n\nEnter the world of Chimp Chase and take part in awesome battles that combine skill, style, and fun to provide the best possible experience.", "short_description": "Welcome to Chimp Chase, hop straight into the battle zone with your favorite weapons and compete against other players in some good old fashioned PVP!"}]}, "developer_name": "GetaGames Limited", "developer_privacy_policy_url": "https://www.termsfeed.com/live/ffb76398-19d9-4068-8752-7b21003b1274", "developer_terms_of_service_url": "https://getagamesbusiness.wixsite.com/chimp-chase-pvp/code-of-conduct", "publisher_name": "GetaGames Limited", "support_website_url": null, "website_url": "http://getagames.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "24266976246248407"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620513_1159971086162491_1087171174459102113_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rHlcgKLX_sQ7kNvwFg1cad&_nc_oc=AdpWNmWcXQqePF2nDcw-okifPVFh_uAEF
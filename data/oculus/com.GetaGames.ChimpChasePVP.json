617221417276769_641807708425695272_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RbPJyMUBUa0Q7kNvwGxS41B&_nc_oc=Ado51WE66sT2DLtVPDpk9E2A3vkM7RCCo6gGX7LsiiWdSfaDtpOmdB8eCCOv_WxOO8k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK24eUr3zx0OVbCM-irKBBqqJDCX3wKIcJf686Ib76XEA&oe=6AA3FF48"}, {"file_name": "chimp chase shop.png", "id": "1115256343143928", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982576_1115256346477261_7940274428983720617_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-28-rQ-6Q6oQ7kNvwGwhFIb&_nc_oc=Adr_mnLQc89uGJU3dHw_DggcniBXspl05_dlE-RSETzNZN5DEr2BvDIaLKj1xIQt_Bs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIhUuCoqOIPcBgGighgYluISNO_iMgBUS-fdWu1rbuNQ&oe=6AA40066"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Chase PVP", "keywords": [], "long_description": "Welcome to Chimp Chase, a thrilling PvP VR gorilla locomoted game that puts you in the heart of intense battles across many maps, from calm forests to scorching deserts. Take control of powerful weaponry including the AK47, pistol, RPG, and sniper rifles as you compete for dominance in adrenaline-fueled matches. Previously owned by Henwy, Chimp Chase is now under the ownership of Edivence, promising a revamped experience filled with action, strategy, and heart-pounding excitement. Are you ready to unleash your primal instincts and conquer the competition?", "short_description": "\nStep into Chimp Chase, a PvP VR game with fierce gorilla battles in diverse landscapes. Arm yourself with AK47s, pistols, RPGs, and sniper rifles for adrenaline-fueled matches. Formerly Henwy's, now Edivence promises an action-packed, strategic experience. Ready to dominate?"}]}, "developer_name": "GetaGames", "developer_privacy_policy_url": "https://www.termsfeed.com/live/1b812005-5f34-4430-b5f9-16c9ae75121b", "developer_terms_of_service_url": null, "publisher_name": "GetaGames", "support_website_url": null, "website_url
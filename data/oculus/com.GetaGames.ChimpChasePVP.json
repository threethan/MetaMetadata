41807708425695272_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BoG6MNT9FBsQ7kNvwG2WuiK&_nc_oc=Ado27Z5aIngtPrDw_T_aSP598Ire7n8xTeYaJDwheWBpX_4uhTKKyOmPcNUWFoJc8JE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtyp35koyYceOiMzZOHdf8h7MkBZ2wo9ichY7jmAGesA&oe=6A5636C8"}, {"file_name": "chimp chase shop.png", "id": "1115256343143928", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982576_1115256346477261_7940274428983720617_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEWNgsbvqZoQ7kNvwEs5aJi&_nc_oc=AdoUHJGKSYoMVnt2tXipYLlT0fv4oIs_iPcZ-8Gj-FUrK-iL9EkBr7wiueWvNU70w0k&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA31rZ0_mM8Gj5238j5y1fVhy8l134ClJp3t_FJrwbPEA&oe=6A5637E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Chase PVP", "keywords": [], "long_description": "Welcome to Chimp Chase, a thrilling PvP VR gorilla locomoted game that puts you in the heart of intense battles across many maps, from calm forests to scorching deserts. Take control of powerful weaponry including the AK47, pistol, RPG, and sniper rifles as you compete for dominance in adrenaline-fueled matches. Previously owned by Henwy, Chimp Chase is now under the ownership of Edivence, promising a revamped experience filled with action, strategy, and heart-pounding excitement. Are you ready to unleash your primal instincts and conquer the competition?", "short_description": "\nStep into Chimp Chase, a PvP VR game with fierce gorilla battles in diverse landscapes. Arm yourself with AK47s, pistols, RPGs, and sniper rifles for adrenaline-fueled matches. Formerly Henwy's, now Edivence promises an action-packed, strategic experience. Ready to dominate?"}]}, "developer_name": "GetaGames", "developer_privacy_policy_url": "https://www.termsfeed.com/live/1b812005-5f34-4430-b5f9-16c9ae75121b", "developer_terms_of_service_url": null, "publisher_name": "GetaGames", "support_website_url": null, "website_url": "https://finx10
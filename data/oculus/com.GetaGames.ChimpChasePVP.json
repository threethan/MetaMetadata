41807708425695272_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGQSAgCXWysQ7kNvwGZjT89&_nc_oc=AdqdPV9Ht3iyh686_WcHiHOEEjo1-eiHvwQV8uXHpF6UvV2IBCoCptxhp0Z2doAg5zQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4Qh6_GLfYM0jDXR8ZRJuPSbAQXVBTP45JkqrNmVrWSw&oe=6A86FE48"}, {"file_name": "chimp chase shop.png", "id": "1115256343143928", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982576_1115256346477261_7940274428983720617_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6p9KcgcJbmoQ7kNvwFktz-1&_nc_oc=AdqBLpoW4h4padc_FSyO07eOCAeA359LBRVJuzklM79n3Z1E7HOIP4sEsuvwvFPbyjY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVllzXbG2AdJZwkixfbcKKPFtQiYhMIg9h6DqZpLIl0g&oe=6A86FF66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimp Chase PVP", "keywords": [], "long_description": "Welcome to Chimp Chase, a thrilling PvP VR gorilla locomoted game that puts you in the heart of intense battles across many maps, from calm forests to scorching deserts. Take control of powerful weaponry including the AK47, pistol, RPG, and sniper rifles as you compete for dominance in adrenaline-fueled matches. Previously owned by Henwy, Chimp Chase is now under the ownership of Edivence, promising a revamped experience filled with action, strategy, and heart-pounding excitement. Are you ready to unleash your primal instincts and conquer the competition?", "short_description": "\nStep into Chimp Chase, a PvP VR game with fierce gorilla battles in diverse landscapes. Arm yourself with AK47s, pistols, RPGs, and sniper rifles for adrenaline-fueled matches. Formerly Henwy's, now Edivence promises an action-packed, strategic experience. Ready to dominate?"}]}, "developer_name": "GetaGames", "developer_privacy_policy_url": "https://www.termsfeed.com/live/1b812005-5f34-4430-b5f9-16c9ae75121b", "developer_terms_of_service_url": null, "publisher_name": "GetaGames", "support_website_url": null, "website_url": "https://finx10
44_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rb5ECiaW3gkQ7kNvwHAtyIo&_nc_oc=Adkhru0uYaKDUGBwuFrJ9bDFUD-GBwaHX9wQ4sCHOA81HCKi1ZglS6P2PcCT0KvRRPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuNyqgTmZgIwfOVZjlKZtaED4V6N01p0i8ettDUXez7xA&oe=69A2F0F7"}, {"file_name": "migrated_image.png", "id": "876358949496294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984439_461714564410100_1817449028011425792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ce54Ps5oD2QQ7kNvwE2pQDj&_nc_oc=AdnD_74cWxrURBWImbhGm6i36ZQ8PBVjMO8vUAcFcDrIg1IN4qjLmZnvZ5ZvA8pjgEo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvoazlNB7M15BJz7SVGtCfNdelkCnbT6k33v7ExceucAQ&oe=69A2CA35"}, {"file_name": "migrated_image.png", "id": "208354473718574", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036637_717245782043791_3180097595317944320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6nZNvPzxbdcQ7kNvwE9N9WK&_nc_oc=Adlk63tLLpHo58nwNPK8Xqrz2c_nvsRIKVX8j3RBt3Y7jV_5f16kahJfU92ucoe23EE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs5Kmli5V0_9G5Z6opINXLB4PRsxjpejSCQDpzZMtGYfQ&oe=69A2E2DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (4).png", "id": "695583791329071", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982506_695583794662404_2842391773386089169_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bDvB4XJ8pC4Q7kNvwFOIebn&_nc_oc=Adkx1tO7ysjw5iGuap3fqtjKzpjrKJtYVzIwkHT0vmibDh4s1sn3GaztwU5Hal6PCy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZn_n1hpa_FXw1J1baCAN8kyrPfC7hWnQ9EvnJRakUfQ&oe=69A2C7D5"}, "display_name": "Track Burner 1987", "keywords": ["Cars", "Racing", "Racer", "Synthwave", "Car"], "long_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in mobile VR. Featuring original music and an art style inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and full 3D weather effects including VR rain, snow, and lightning. \nSpecial care has been taken to create road tracks with no elevation changes to help minimize VR nausea.", "short_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in Mobile VR. Inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and over 125 KM of unique tracks to burn up!"}]}, "developer_name": "XRA Games", "developer_privacy_policy_url": "http://www.xracademic.com/TBMPP.html", "developer_terms_of_service_url": "http://www.xracademic.com/TBEULA.html", "publisher_name": "XRA Games", "support_website_url": null, "website_url": "http://www.xracademic.com/TrackBurner1987.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "535349190916672"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031439_2060761477565485_8706566456147443712_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5aE0Aj3tLgQ7kNvwGHWnrn&_nc_oc=Adn_MVSIcsJHykysKevuQvMLDI04ieuW7RO5iodhu8VrjK_eDsVpk8_2Ka0DBfLi1Ks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftP4AzbOsVDdH-5VOMMHLJOcSfODnRM_0bjEsKUWTyTVg&oe=69A2C644"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Track Burner 1987", "pla
62752306787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569441_2480629315493586_4444652764600991744_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BG57itMlWywQ7kNvwFVNV4m&_nc_oc=AdpYfKBK_jl_4L43Ndv3f9BjUT_ADsasKUuKWuUWsqRu-UnAyF-2nSNSOyk0aRuNOM8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkJqCrXscBSK6APQ-Djmzd3HWgcZnfCVQig5-L60NptQ&oe=6A4BB0F7"}, {"file_name": "migrated_image.png", "id": "876358949496294", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984439_461714564410100_1817449028011425792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVZDf74M9uQQ7kNvwHN_AIj&_nc_oc=AdoCFApVkYb28eY6T-u8n6wlo0dKl8iCo8pXY12OF7cm834Qx65hK-t2CEtC4_bKVc0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCeYNqeLxv_ro2-z_Oa5B-Vg0exQneSlFbZxengpaPjIQ&oe=6A4BC275"}, {"file_name": "migrated_image.png", "id": "208354473718574", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39036637_717245782043791_3180097595317944320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PrA361WQ02QQ7kNvwE77zsl&_nc_oc=AdqN-5MQOzBx90zQcl57Yfu8JZIZ6qwEnBhoMVSP4psGbszsL2nFf3u_qIfAlfOHOdc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApwZOzwd1CR9f5A0UfAmJlckGaSPfs33osn_tGpBjK2w&oe=6A4BA2DD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (4).png", "id": "695583791329071", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982506_695583794662404_2842391773386089169_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Plx67cNm74Q7kNvwHqeo-c&_nc_oc=AdphMVUW4x4-32V7GJpN5yETW7OV5ymQwIm2ExESvBmDwcv2OFoJN9NkOrs_OpHsvTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG6F15vEuAxauJLZqmPoxblT5T1dvmFhCKlEpVnfFBWw&oe=6A4BC015"}, "display_name": "Track Burner 1987", "keywords": ["Cars", "Racing", "Racer", "Synthwave", "Car"], "long_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in mobile VR. Featuring original music and an art style inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and full 3D weather effects including VR rain, snow, and lightning. \nSpecial care has been taken to create road tracks with no elevation changes to help minimize VR nausea.", "short_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in Mobile VR. Inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and over 125 KM of unique tracks to burn up!"}]}, "developer_name": "XRA Games", "developer_privacy_policy_url": "http://www.xracademic.com/TBMPP.html", "developer_terms_of_service_url": "http://www.xracademic.com/TBEULA.html", "publisher_name": "XRA Games", "support_website_url": null, "website_url": "http://www.xracademic.com/TrackBurner1987.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "535349190916672"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031439_2060761477565485_8706566456147443712_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5LmTN8nEQUQ7kNvwH6ipVa&_nc_oc=AdrnWwFOO_REx2ghkGScmFdXd48Qg-6FdCdPBFi9_LKWkMiuss0R2D1UWKU405lCidA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f2
62752306787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569441_2480629315493586_4444652764600991744_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhEjeH5JOY4Q7kNvwGlFlYZ&_nc_oc=AdoOKaRsulLkq6elpf2OSbEFLBs8lQYNCiP7_iwJYlkFupJGtf0BCGeDK6E29a9rfdM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VpYSw0BMVKc0Bb5sgKbyx_uh4zHlxlUvbbLJ0_l6C4Q&oe=6A3FD377"}, {"file_name": "migrated_image.png", "id": "876358949496294", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984439_461714564410100_1817449028011425792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwtNE_6mxyEQ7kNvwGcY-Lg&_nc_oc=AdpJ7EtO7TESed1bhY5NxDvpPtlJruVoMtQocp3PcW-hTCiFoM9OiyH6HwXdYF8mB0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Q6GDW4CIH1cmFWqFpaq0W5ih1G-O2oG_pyAPTvDkq0A&oe=6A3FE4F5"}, {"file_name": "migrated_image.png", "id": "208354473718574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036637_717245782043791_3180097595317944320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aq8ii7Jb48AQ7kNvwGLRSEa&_nc_oc=AdpyQWGR7NGC3O2Qw4Bqyr1M1fdN3fHfom6tZSoLuIFaXVovhKZ7TBuCdhrs-JQUi38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gITz95X3DRV9fQ1o1kQe_6YVntrBmCwkqG-ncBy-OxA&oe=6A3FC55D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (4).png", "id": "695583791329071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982506_695583794662404_2842391773386089169_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2b9WfOL8Pv4Q7kNvwGOrj4d&_nc_oc=AdobN5no-3j3OGsOtdZqiYnWgb4Xaveev_rbETKOA-43WsmVS1fRS3R9ZTwS2ws5ePU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6j8jZPwWRCa1vIxWKVkmkye8GbEADf2nYVDd7ZBhKBQ&oe=6A3FE295"}, "display_name": "Track Burner 1987", "keywords": ["Cars", "Racing", "Racer", "Synthwave", "Car"], "long_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in mobile VR. Featuring original music and an art style inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and full 3D weather effects including VR rain, snow, and lightning. \nSpecial care has been taken to create road tracks with no elevation changes to help minimize VR nausea.", "short_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in Mobile VR. Inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and over 125 KM of unique tracks to burn up!"}]}, "developer_name": "XRA Games", "developer_privacy_policy_url": "http://www.xracademic.com/TBMPP.html", "developer_terms_of_service_url": "http://www.xracademic.com/TBEULA.html", "publisher_name": "XRA Games", "support_website_url": null, "website_url": "http://www.xracademic.com/TrackBurner1987.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "535349190916672"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031439_2060761477565485_8706566456147443712_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xcKEJp6qifkQ7kNvwHui5EM&_nc_oc=AdoY3n4DUxkip8LY5sk_M1YeQ4GDL9ICihaMM2wEJmpGMRtmOrkDSWWgbAAiZOz22pM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f2
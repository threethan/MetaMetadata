ent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMjbULsUq709rQp1BV8BBG2OkmpetiQZOIqIUhvHFDwA&oe=6B005D95"}, "display_name": "Track Burner 1987", "keywords": ["Cars", "Racing", "Racer", "Synthwave", "Car"], "long_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in mobile VR. Featuring original music and an art style inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and full 3D weather effects including VR rain, snow, and lightning. \nSpecial care has been taken to create road tracks with no elevation changes to help minimize VR nausea.", "short_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in Mobile VR. Inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and over 125 KM of unique tracks to burn up!"}]}, "developer_name": "XRA Games", "developer_privacy_policy_url": "http://www.xracademic.com/TBMPP.html", "developer_terms_of_service_url": "http://www.xracademic.com/TBEULA.html", "publisher_name": "XRA Games", "support_website_url": null, "website_url": "http://www.xracademic.com/TrackBurner1987.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "535349190916672"}, "review_messages": []}]}, "cover_square_im
62752306787", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57569441_2480629315493586_4444652764600991744_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTDGXGGDPLsQ7kNvwGq7aMD&_nc_oc=Adpy8XqI3KeCsEoU1U35Z-6V5HHpo0AjFodybtVaKt3e664IUJ_6p4A5mQpdOGhGML4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRpCirgoc5-DOG7TPJAD3g6bExeHNaDKQB7F1bX_mnqA&oe=6A95BD37"}, {"file_name": "migrated_image.png", "id": "876358949496294", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984439_461714564410100_1817449028011425792_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwAok_mQf3sQ7kNvwHID-Fw&_nc_oc=Ado8ruR2suDr0w-BYXzRLhpoKeQQUBxZ7KjI-uZ0SJzfOOi28-yt7TxGqeBrote4klM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXkWSP1iTbodFRpndQ9wXosTZUqRFbBaWYo2FogK3W1A&oe=6A95CEB5"}, {"file_name": "migrated_image.png", "id": "208354473718574", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036637_717245782043791_3180097595317944320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnb8LB-1Pb4Q7kNvwHvMFUM&_nc_oc=AdrF9vjxoEd_Et59J1lcQpKU1celQLwyMG6ouIT0CNsV8FiNoXQwNrDCiOVYC7dwz9c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyHpl-lYLDTVDMMUdPgLq9hTToPzb8LKXcXe4TBF8PZw&oe=6A95AF1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440 (4).png", "id": "695583791329071", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982506_695583794662404_2842391773386089169_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFgCCYasSYUQ7kNvwE8mg0a&_nc_oc=Adojppw6rTTOK0Qhc5TpT3_v35A--lXWwyrgyGkk86LSaJzyJh2hhFKsU7IVcen1qXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrs4ExRBpQnhe0gexcvOwh9S-HMKPiX6x6_XlJIGCT6Q&oe=6A95CC55"}, "display_name": "Track Burner 1987", "keywords": ["Cars", "Racing", "Racer", "Synthwave", "Car"], "long_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in mobile VR. Featuring original music and an art style inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and full 3D weather effects including VR rain, snow, and lightning. \nSpecial care has been taken to create road tracks with no elevation changes to help minimize VR nausea.", "short_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in Mobile VR. Inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and over 125 KM of unique tracks to burn up!"}]}, "developer_name": "XRA Games", "developer_privacy_policy_url": "http://www.xracademic.com/TBMPP.html", "developer_terms_of_service_url": "http://www.xracademic.com/TBEULA.html", "publisher_name": "XRA Games", "support_website_url": null, "website_url": "http://www.xracademic.com/TrackBurner1987.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "535349190916672"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031439_2060761477565485_8706566456147443712_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vL2vq9EGTgQ7kNvwG24K70&_nc_oc=Adr10Tc081y4vr1EwiFD_rsd4rOoqzwOCyvOtH2cDorJuOFjvFAm1OAlWIEbJ4Bbfog&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f2
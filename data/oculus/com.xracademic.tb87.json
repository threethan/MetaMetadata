771-25/39036637_717245782043791_3180097595317944320_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa6ZOrt9-sEQ7kNvwGH5Ne9&_nc_oc=Adoz9nkuv2yNRJMUvKe34JiTcH0TzPasyB0J2terRmcdrUI30hkPCCJobGNcejER4s4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Uv-tga1vmh4OdA-QSoY8iV0rZ0RaY7Nw8K7AcA8BX0w&oe=6A05C35D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Track Burner 1987", "keywords": ["Cars", "Racing", "Racer", "Synthwave", "Car"], "long_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in mobile VR. Featuring original music and an art style inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and full 3D weather effects including VR rain, snow, and lightning. \nSpecial care has been taken to create road tracks with no elevation changes to help minimize VR nausea.", "short_description": "Buckle up, and get ready to go fast as you push the limits of speed on wheels in Mobile VR. Inspired by vintage race games, this exhilarating in-car racer offers impressive simulated physics, tuned and ruthless AI racing opponents, smooth mobile VR performance, and over 125 KM of unique tracks to burn up!"}]}, "developer_name": "XRA Games", "developer_privacy_policy_url": "http://www.xracademic.com/TBMPP.html", "developer_terms_of_service_url": "http://www.xracademic.com/TBEULA.html", "publisher_name": "XRA Games", "support_website_url": null, "website_url": "http://www.xracademic.com/TrackBurner1987.html", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
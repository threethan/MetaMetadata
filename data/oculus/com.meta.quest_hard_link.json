016_4124899177110984964_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qhbn7CusCKgQ7kNvwH8hhBW&_nc_oc=AdqlZ8jY9xC0PjDcHcUH4D6ha8jLZvtogJbC3Q5HOSC3ASYr7CyyDufb86WnPCp1n5M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLRprLXn9hiP4f4nYTuRCqQmXwFQRtM1Uqlzzq2Qz_Og&oe=6AC91918"}, {"file_name": "Meta Quest Store Screenshot 5 (16_9).png", "id": "549002300804748", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75393559_549002307471414_5835389300277591103_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi_CEZUfacwQ7kNvwEwBpaP&_nc_oc=AdqeZ5lfS-5KTR000Q5SPKFylp-AmROhEH_kV5KGXTRh-jb3ZcfDPM6zRlXtIqP4o_U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDA4z4oBTQBFqMFrAZDXeVgsGKWyzhERq2hLQxj2Aw6Q&oe=6AC917FC"}, {"file_name": "Meta Quest Store Screenshot 4 (16_9).png", "id": "311447742057399", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974680_311447745390732_5485899381975960901_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dDneoU1Yk3AQ7kNvwGSsP4G&_nc_oc=Adq9HzCFQa4UjVzXhp8pDj9hewoEvuYrFj_vz5DJKPLwf76JFs_17ruwqPXt49F9IUA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtSuAebScJ86ff7SUivNvWmr4-hCYIkas4QfFbFji_BA&oe=6AC91C22"}, {"file_name": "Meta Quest Store Screenshot 1 (16_9).png", "id": "367915583040161", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974630_367915586373494_3526123354822059374_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSjOizBlRnAQ7kNvwFYe7pJ&_nc_oc=AdopcDw2PmvQ2rhj2LbN4w0vxRr2JUIbrYevXdO1dgfP3eLewcwprtlXOBGxoHYHnVw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxb6IiqQADV3my7NTHws7rBbKuRzPU9Qx_wNDH6y2--A&oe=6AC9056A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Quest HDMI Link", "keywords": [], "long_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more.\n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, please ensure that the capture card and other USB adapters and cables are rated for USB 3.0 SuperSpeed.\n\n# Features\n\n* Auto launch app when a USB card is detected.\n* Menu setting to control capture video format, frame resolution, and fps for each connected session.\n* The screen is freely resizable, within certain limits.\n* Toggle instant streaming stats by clicking anywhere on the screen.\n\n# FAQs\n\n**How do I troubleshoot a blank screen? Why can\u2019t I play movies from streaming services? I hear only audio?**\n\n* Capture cards do not display video if the HDMI signal has HDCP protection enabled.\n* Make sure you are using the correct input port if your capture card has multiple HDMI/DisplayPort ports. \n\n**How to troubleshoot low video frames rate?**\n\nEnsure the instant stats overlay in the streaming screen displays **SuperSpeed to confirm USB 3.0 speed, rather than Hi-Speed (USB 2.0 speed)**. \n* Not all USB-C cables are created equal. Some USB-C cables are rated for USB 2.0 speed.\n* Some USB-C cables operate at USB 3.0 or USB 2.0 depending on the orientation of the connector; flipping the USB-C cable upside down may resolve the low fps issue.\n* Change capture video frame format menu setting to match the fps offered by the capture card.", "short_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more. With HDMI Link, you can then display this 2D content in VR on a massive low-latency \u201cscreen\u201d.  \n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, ensure that the capture card and other USB adapters and cables are rated for USB 3.0 speed (SuperSpeed)."}]}, "developer_name": "Meta", "developer_privacy_policy_u
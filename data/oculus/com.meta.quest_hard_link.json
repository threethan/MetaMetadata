thFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7452106424824357", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "10000411896660451"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "767902112112095"}]}, "change_log": "Fixes and Improvements:\n* Revamped UI to allow users to select capture video frame format, resolution, and fps\n* Handled mic mute condition to address infinite USB permission dialog issue\n* Added menu setting to control capture video format, frame resolution, and fps for each connected session. This feature enables users to take advantage of high-end capture cards and choose a capture card setting to mitigate low fps streaming experience. Note that some USB-C cables operate at USB 3.0 or USB 2.0 depending on the orientation of the connector; flipping the USB-C cable upside down may resolve the low fps issue.\n* Users can now freely resize the screen within certain limits.\n* Show a degraded performance message when USB 2.0 speed or below is detected or when the user selects a low fps video format.\n* Streaming will now stop when the user takes off the headset and restart when the user puts it back on.", "created_date": 1725381677, "id": "8131624216872571", "version": "3.0.0.0.534", "version_code": 638375560, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
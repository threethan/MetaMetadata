04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8cnSHJKYdgQ7kNvwHPwpG1&_nc_oc=AdqDWWSk2QKIMUgcMibYLXBM4G9MEEmXwnLOfML8nMg4aTk43qhue4XlxiZYyzTzxu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPUKsT3fZ_TZivAuzEJqQtyXOfXWf_VmP3GQ-wECS2fA&oe=6A5F67BC"}, {"file_name": "Meta Quest Store Screenshot 4 (16_9).png", "id": "311447742057399", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974680_311447745390732_5485899381975960901_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXq-0NuNSjAQ7kNvwH2wq-y&_nc_oc=AdoKa3XZetSN4NCB2rJkC7LaQyG0AtdgfxJd86G8oUhEP61Jfjk_L-ySgwygtxv2B50&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOmwkx0OPEeSundSv35Jm5bjf1WocWcPoFEqsVHLIJBg&oe=6A5F6BE2"}, {"file_name": "Meta Quest Store Screenshot 1 (16_9).png", "id": "367915583040161", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974630_367915586373494_3526123354822059374_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nSJDK9vofTAQ7kNvwGLYu20&_nc_oc=Adp_yZJr2LCn5lON97u858pmK55f5_6lw_lF4Z0TDCUdGb1cfCoJLKTdJukA-55kqnY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB_WNDu1jAnJPMeCtww8wLkyr53HHNX145pS2gu8qUuw&oe=6A5F552A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Quest HDMI Link", "keywords": [], "long_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more.\n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, please ensure that the capture card and other USB adapters and cables are rated for USB 3.0 SuperSpeed.\n\n# Features\n\n* Auto launch app when a USB card is detected.\n* Menu setting to control capture video format, frame resolution, and fps for each connected session.\n* The screen is freely resizable, within certain limits.\n* Toggle instant streaming stats by clicking anywhere on the screen.\n\n# FAQs\n\n**How do I troubleshoot a blank screen? Why can\u2019t I play movies from streaming services? I hear only audio?**\n\n* Capture cards do not display video if the HDMI signal has HDCP protection enabled.\n* Make sure you are using the correct input port if your capture card has multiple HDMI/DisplayPort ports. \n\n**How to troubleshoot low video frames rate?**\n\nEnsure the instant stats overlay in the streaming screen displays **SuperSpeed to confirm USB 3.0 speed, rather than Hi-Speed (USB 2.0 speed)**. \n* Not all USB-C cables are created equal. Some USB-C cables are rated for USB 2.0 speed.\n* Some USB-C cables operate at USB 3.0 or USB 2.0 depending on the orientation of the connector; flipping the USB-C cable upside down may resolve the low fps issue.\n* Change capture video frame format menu setting to match the fps offered by the capture card.", "short_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more. With HDMI Link, you can then display this 2D content in VR on a massive low-latency \u201cscreen\u201d.  \n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, ensure that the capture card and other USB adapters and cables are rated for USB 3.0 speed (SuperSpeed)."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta Platforms, Inc.", "support_website_url": null, "website_url": "https://www.meta.com/quest/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTIL
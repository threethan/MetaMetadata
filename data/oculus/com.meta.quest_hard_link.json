FbQ9bVtDFbxDcMuhJuYvP7yk-Aq_WwF8aAs8IPESVFeAW7qTsr1uQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8KwMppAqa8D6oNw13JuLO3w29sN2-8q-VqGd8n0Ez9w&oe=6A8EDED8"}, {"file_name": "Meta Quest Store Screenshot 5 (16_9).png", "id": "549002300804748", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75393559_549002307471414_5835389300277591103_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=spz6moAAPIUQ7kNvwHBE55w&_nc_oc=AdqvZuhiyRNy-zE_a9vqmgw2-NU0oHnUICihpVnB3aAXvbpe3hirl94NWdRdzU-1DGQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi5B5LxW2Xc75ZYRGw4odnWVWYaqSRXOr2WiDsMB2o8w&oe=6A8EDDBC"}, {"file_name": "Meta Quest Store Screenshot 4 (16_9).png", "id": "311447742057399", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974680_311447745390732_5485899381975960901_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7G3qYE76EgQ7kNvwEVUKGO&_nc_oc=AdpN69M5ayO40bRiGRMAe1FtXHYTiVSZkcUuoqLshkfBLxnGKLdasxMhQIWV4EsWm5k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGiX5_m_Ea4bLUtJ0Jj9yzjaCACKjy1XAlML4kM_qb_Q&oe=6A8EE1E2"}, {"file_name": "Meta Quest Store Screenshot 1 (16_9).png", "id": "367915583040161", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974630_367915586373494_3526123354822059374_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-Mh-IojLsEQ7kNvwE-4mDm&_nc_oc=AdoOJv-Up__EEMj8Vapg53K9LGFGS5TShXL_SOmVoV5_nR6xmT8n4ubRq4W0XjwX4VM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkzRvS27wfxTZwvYU1I7fxLio7hMT1G2Y1t1_S_UXRmw&oe=6A8ECB2A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Quest HDMI Link", "keywords": [], "long_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more.\n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, please ensure that the capture card and other USB adapters and cables are rated for USB 3.0 SuperSpeed.\n\n# Features\n\n* Auto launch app when a USB card is detected.\n* Menu setting to control capture video format, frame resolution, and fps for each connected session.\n* The screen is freely resizable, within certain limits.\n* Toggle instant streaming stats by clicking anywhere on the screen.\n\n# FAQs\n\n**How do I troubleshoot a blank screen? Why can\u2019t I play movies from streaming services? I hear only audio?**\n\n* Capture cards do not display video if the HDMI signal has HDCP protection enabled.\n* Make sure you are using the correct input port if your capture card has multiple HDMI/DisplayPort ports. \n\n**How to troubleshoot low video frames rate?**\n\nEnsure the instant stats overlay in the streaming screen displays **SuperSpeed to confirm USB 3.0 speed, rather than Hi-Speed (USB 2.0 speed)**. \n* Not all USB-C cables are created equal. Some USB-C cables are rated for USB 2.0 speed.\n* Some USB-C cables operate at USB 3.0 or USB 2.0 depending on the orientation of the connector; flipping the USB-C cable upside down may resolve the low fps issue.\n* Change capture video frame format menu setting to match the fps offered by the capture card.", "short_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more. With HDMI Link, you can then display this 2D content in VR on a massive low-latency \u201cscreen\u201d.  \n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, ensure that the capture card and other USB adapters and cables are rated for USB 3.0 speed (SuperSpeed)."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta Platforms, Inc.", "support_website_url": null, "website_url": "https://www.meta.com/quest/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8179056588796000"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/57572929_752602280328276_1040671733638946463_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhy44ZvbDhYQ7kNvwGBcKlO&_nc_oc=AdoIkt2mbSLAg9FW1oFsFUW4WSAicsOtmLw4pkGJii49Gc_PkZsivim9KsAVsVzVDjs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjAPnZW5LmNTIpKbWOJQTgUj8TYxCpwTlH6Vw0cqAaPw&oe=6A8EC8CE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Meta Quest HDMI Link", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Computer Link", "id": "1055187466124150"}, {"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1723734000, "lastRevision": {"nodes": [{"id": "7452106441491022", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7452106424824357", "is_first_party": true, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": 
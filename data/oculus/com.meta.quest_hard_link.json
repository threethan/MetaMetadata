VlTUm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzpIw6XpV9bv0A49ls1U1iqSav45knRa288nAAzy8SJdg&oe=69CD113C"}, {"file_name": "Meta Quest Store Screenshot 4 (16_9).png", "id": "311447742057399", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974680_311447745390732_5485899381975960901_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iaukT2xy_cgQ7kNvwG6FKUu&_nc_oc=Adrw7nQeM78vh0o9M5m-w3BFVEt0Gu_ZDYXj0L5zEbcvOGvFFTaxxXSdKu7GwokvfJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqcJCZlitLiWs44lnhqY3v6rHwl1mbg-tA2Z1-hstCTQ&oe=69CD1562"}, {"file_name": "Meta Quest Store Screenshot 1 (16_9).png", "id": "367915583040161", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974630_367915586373494_3526123354822059374_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLrs4Ywi8tcQ7kNvwGzBS4S&_nc_oc=AdpqH6tQOPACTUNttws-bKn-58ATfIwc-Xu2slJ_MTuS5vPFzZBl5B4zuT0q0UbYxmA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw5CQHVrtw5rlr01I6maYWueLKnqepFMIiwCBHpXc23pw&oe=69CCFEAA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Quest HDMI Link", "keywords": [], "long_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more.\n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, please ensure that the capture card and other USB adapters and cables are rated for USB 3.0 SuperSpeed.\n\n# Features\n\n* Auto launch app when a USB card is detected.\n* Menu setting to control capture video format, frame resolution, and fps for each connected session.\n* The screen is freely resizable, within certain limits.\n* Toggle instant streaming stats by clicking anywhere on the screen.\n\n# FAQs\n\n**How do I troubleshoot a blank screen? Why can\u2019t I play movies from streaming services? I hear only audio?**\n\n* Capture cards do not display video if the HDMI signal has HDCP protection enabled.\n* Make sure you are using the correct input port if your capture card has multiple HDMI/DisplayPort ports. \n\n**How to troubleshoot low video frames rate?**\n\nEnsure the instant stats overlay in the streaming screen displays **SuperSpeed to confirm USB 3.0 speed, rather than Hi-Speed (USB 2.0 speed)**. \n* Not all USB-C cables are created equal. Some USB-C cables are rated for USB 2.0 speed.\n* Some USB-C cables operate at USB 3.0 or USB 2.0 depending on the orientation of the connector; flipping the USB-C cable upside down may resolve the low fps issue.\n* Change capture video frame format menu setting to match the fps offered by the capture card.", "short_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more. With HDMI Link, you can then display this 2D content in VR on a massive low-latency \u201cscreen\u201d.  \n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, ensure that the capture card and other USB adapters and cables are rated for USB 3.0 speed (SuperSpeed)."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta Platforms, Inc.", "support_website_url": null, "website_url": "https://www.meta.com/quest/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null
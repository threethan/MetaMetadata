016_4124899177110984964_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkBkUjZAOjsQ7kNvwGWM6rh&_nc_oc=Ado_tKq7tx8EM0cqJ8n40_qNC7a1XV0Y5MMLXXgmsOYaBkdykK3tkgkLxUlcNGJ-wFM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1_vb-L8n_Ml3rCJPOj8O_2WPLsLZqoMdrUHNM69YzfQ&oe=6AB125D8"}, {"file_name": "Meta Quest Store Screenshot 5 (16_9).png", "id": "549002300804748", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75393559_549002307471414_5835389300277591103_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXesTxI0_cMQ7kNvwE2_52P&_nc_oc=AdoyHXQhm-lmfyt8K0W6aTT6_7uoLmFLD2c7mwf6GlRIXMGeOMonJjh3qUuqDBAV0S4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyVTepkgeVt-GoIRcoJZaquXwii2YThkQb4Mo-iq7Okw&oe=6AB124BC"}, {"file_name": "Meta Quest Store Screenshot 4 (16_9).png", "id": "311447742057399", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974680_311447745390732_5485899381975960901_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIW9j6TKw7wQ7kNvwHZh4i5&_nc_oc=Adp0iaajx1S0qBGMz0Jv4ePtYfBTCAxizDXlovuYfhO_C0EVUpy1Tk5MmKDysaPB6uk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJndjQdWcSB8lUcaM91WhvcGTrGiU-B71ULITh7YpqvtQ&oe=6AB128E2"}, {"file_name": "Meta Quest Store Screenshot 1 (16_9).png", "id": "367915583040161", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974630_367915586373494_3526123354822059374_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVesaRvhMOgQ7kNvwFGKN0X&_nc_oc=AdpB8O_bZ7jdc_UxKd7ewPrc9-1stemALRgm_geVNr1Ej1LZ_UxbCq1QdLbe3DouCYM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTkxo0gZ2wWJn41K8Bu1wUvdkE2zz5-0B02WVAprxnpg&oe=6AB14A6A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Quest HDMI Link", "keywords": [], "long_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more.\n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, please ensure that the capture card and other USB adapters and cables are rated for USB 3.0 SuperSpeed.\n\n# Features\n\n* Auto launch app when a USB card is detected.\n* Menu setting to control capture video format, frame resolution, and fps for each connected session.\n* The screen is freely resizable, within certain limits.\n* Toggle instant streaming stats by clicking anywhere on the screen.\n\n# FAQs\n\n**How do I troubleshoot a blank screen? Why can\u2019t I play movies from streaming services? I hear only audio?**\n\n* Capture cards do not display video if the HDMI signal has HDCP protection enabled.\n* Make sure you are using the correct input port if your capture card has multiple HDMI/DisplayPort ports. \n\n**How to troubleshoot low video frames rate?**\n\nEnsure the instant stats overlay in the streaming screen displays **SuperSpeed to confirm USB 3.0 speed, rather than Hi-Speed (USB 2.0 speed)**. \n* Not all USB-C cables are created equal. Some USB-C cables are rated for USB 2.0 speed.\n* Some USB-C cables operate at USB 3.0 or USB 2.0 depending on the orientation of the connector; flipping the USB-C cable upside down may resolve the low fps issue.\n* Change capture video frame format menu setting to match the fps offered by the capture card.", "short_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more. With HDMI Link, you can then display this 2D content in VR on a massive low-latency \u201cscreen\u201d.  \n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, ensure that the capture card and other USB adapters and cables are rated for USB 3.0 speed (SuperSpeed)."}]}, "developer_name": "Meta", "developer_privacy_policy_u
_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTP5NSFyHZUQ7kNvwEXhSBX&_nc_oc=AdrVP5E97RaTbilCgZ1nDPRd45bRq0P7UQzRAPCP0xdhrK6LtG9ofw0FCsjEjzezFgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwmoL_-8GegN6GxZDk1PF8_A6uEE2OfibbjJrjhfAHFQ&oe=6B0327E1"}, {"file_name": "Meta Quest Store Screenshot 3 (16_9).png", "id": "981389280116683", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982486_981389283450016_4124899177110984964_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmVqekL3_V0Q7kNvwHrIGa1&_nc_oc=Adoggq_iC1RDekWzMj7EaBTXiozZHAXheyRBjngFAL7p8iQ1eRGBNxFvRD2QzM4Wg0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUmxE9fRKdhe7B9PXb75V6hr6k8kkBFy-IiIokIE3IRQ&oe=6B031B18"}, {"file_name": "Meta Quest Store Screenshot 5 (16_9).png", "id": "549002300804748", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75393559_549002307471414_5835389300277591103_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pW8iW4_8eVMQ7kNvwGq-HHH&_nc_oc=AdpaMhC8pGbiurJA3Rn090QzIyRaxjZsesLdSNY-b1vH6d5UCnEwdWcG-e4Mgu915mA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTN7Ldc8YrbmzpR4NeCfA7wxMIG_dEloCmtWsn1C3x9Q&oe=6B0319FC"}, {"file_name": "Meta Quest Store Screenshot 4 (16_9).png", "id": "311447742057399", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974680_311447745390732_5485899381975960901_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPTb8VHETdgQ7kNvwHxN3KL&_nc_oc=AdqlFkPGw0w-TAaZsTHzTgC67LOnmUPKZAnbcVGxUGbAKaC9mqKMj8mq76rBmws5VfE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyMPkNTj_-AWUKLMisVF3oTHzE-ZAnql6lcX833wM8cQ&oe=6B031E22"}, {"file_name": "Meta Quest Store Screenshot 1 (16_9).png", "id": "367915583040161", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974630_367915586373494_3526123354822059374_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDq3VawCfHYQ7kNvwHUcpLO&_nc_oc=AdoRn8tTh19QdsJCrqZTmZ4abhjgBZAJv6X7eFTbGJ1lEh2SsJQ5R_bsCx-QTksesbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGTUuIReESP6u26HuAzF6DXJBDlBciBu5rohb4Z2g7ZQ&oe=6B03076A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Meta Quest HDMI Link", "keywords": [], "long_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more.\n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, please ensure that the capture card and other USB adapters and cables are rated for USB 3.0 SuperSpeed.\n\n# Features\n\n* Auto launch app when a USB card is detected.\n* Menu setting to control capture video format, frame resolution, and fps for each connected session.\n* The screen is freely resizable, within certain limits.\n* Toggle instant streaming stats by clicking anywhere on the screen.\n\n# FAQs\n\n**How do I troubleshoot a blank screen? Why can\u2019t I play movies from streaming services? I hear only audio?**\n\n* Capture cards do not display video if the HDMI signal has HDCP protection enabled.\n* Make sure you are using the correct input port if your capture card has multiple HDMI/DisplayPort ports. \n\n**How to troubleshoot low video frames rate?**\n\nEnsure the instant stats overlay in the streaming screen displays **SuperSpeed to confirm USB 3.0 speed, rather than Hi-Speed (USB 2.0 speed)**. \n* Not all USB-C cables are created equal. Some USB-C cables are rated for USB 2.0 speed.\n* Some USB-C cables operate at USB 3.0 or USB 2.0 depending on the orientation of the connector; flipping the USB-C cable upside down may resolve the low fps issue.\n* Change capture video frame format menu setting to match the fps offered by the capture card.", "short_description": "Connect your Meta Quest headset to devices with an HDMI or DisplayPort output, including handheld PCs or consoles, laptops, and more. With HDMI Link, you can then display this 2D content in VR on a massive low-latency \u201cscreen\u201d.  \n\nThis app requires third-party hardware\u2014specifically, a UVC and UAC compatible USB capture card and any associated cables. For a high-quality streaming experience, ensure that the capture card and other USB adapters and cables are rated for USB 3.0 speed (SuperSpeed)."}]}, "developer_name": "Meta", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Meta Platforms, Inc.", "support_website_url": null, "website_url": "https://www.meta.com/quest/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["UTILITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8179056588796000"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572929_752602280328276_1040671733638946463_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fyNWTJO8PH0Q7kNvwFUODKY&_nc_oc=AdrkmVZEDYccJR6psrcVkUQ8C3zxnJKvU1Ob3g30MoRVT1Ecuh-a8J8nvv5LZ4Y4CyI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQSozTPc8KnbB-8gFNQE4gGzfWhMbbhcxP7Y3YjLwsDA&oe=6B03050E"}, "i
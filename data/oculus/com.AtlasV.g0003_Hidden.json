25/491827585_1543869050160532_889980671807948896_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOjyXUBvgmAQ7kNvwF64pLD&_nc_oc=AdngQvIkeOUoo2F-X5qGi5wbiqKcYbmMQX3Ea7DW4z7gsSpOHiK-aW0l1zHeTbyMYT8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftQYPNoE-IU9b0o_jKYnymabw0NuY9P_r5ul1mAb8UpbQ&oe=69A59C95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Behind Doors - Hidden Objects", "keywords": ["secret", "hidden", "strange", "horror", "find"], "long_description": "# Look Behind Doors but careful what you're looking for.\n\nYour task is simple: behind each doors is a **new decor**. In each decor, **hidden secrets** are to be found. Look for them, collect them and step out of the room as quick as you can.\n\nWho knows what happens when you stay there for too long? **Those who did are not there anymore to say**.", "short_description": "Look Behind Doors but careful what you're looking for.\n\nYour task is simple: behind each doors is a new decor. In each decor, hidden secrets are to be found. Look for them, collect them and step out of the room as quick as you can.\n\nWho knows what happens when you stay there for too long? Those who did are not there anymore to say."}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/18YB3Zj70I6HM5mlIs6pYwlamxpLKEodYVdjOZ6PBG00/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "AtLab 5", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
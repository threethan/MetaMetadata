ZA1ribUoQ7kNvwFnE4VZ&_nc_oc=AdrSf0KI_oGXqrVIPLEK4Y5Q1kpSvu63zyzt9Ame_6TSlU-iL-wrVPeoBZaIfTbn0Jc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVg-0nDya_xKsvaFF7oxAIC5Ll5Tb1o_zYmOFoB3liKgg&oe=6B0EFF4A"}, {"file_name": "SCREEN-3-breathing.png", "id": "2594848331029683", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627477_2594848334363016_7551166700856405508_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMDI-25vzt8Q7kNvwHAbdAI&_nc_oc=Adpfsxr_FfoktNN4QjDByNTItf8g7gpYQR0V2x_LyfUB3txL7feHAKUOJUy2Ik4DdLw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUV98sYgQk1NP-N8PIBJtG5p9oQqAkBAvS3o4etnoOixg&oe=6B0F1CF1"}, {"file_name": "SCREEN-2-heart-lab.png", "id": "1427948972879448", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624592_1427948979546114_3536999619222744692_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=heWIr3YLuTwQ7kNvwEWH4_9&_nc_oc=AdoEc4FxBKWUNulws8UNRt---3fmf3FIMlnE7rdO4nvVNEdLBq6QoH3shw2bwjCKn4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUOyn3mKahY40pcBIzUIgURc_qwFfEXa0aPZZ8fWQUIbA&oe=6B0F22A7"}, {"file_name": "SCREEN-5-brain-lab.png", "id": "1619908379123501", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499627527_1619908382456834_6170993995167008844_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCby_djZlL0Q7kNvwGajpfA&_nc_oc=AdqOhoWZEMjBjFlDUMkqxm-aOMqb-ZgnimlpoiaDZGISrj8hRskrhPeUeJYf_9cjqvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWgOodEUKecOXwHBGxWuq6gI3yREcatV0ETJHN7cQd5oA&oe=6B0F148E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "DUET Human Body 360", "keywords": ["biology", "anatomy", "science", "education"], "long_description": "DUET Human Body 360 is a life-size, see-through human body that students study in VR or in their own room.\n\n- Explore 2,400 parts: point at any bone, muscle, organ, vessel, nerve or gland to see its name and job, and hear a teacher explain how it works.\n- Organ Lab: large detailed models of the heart, eye, ear, brain, lungs, kidney, tooth and skin, with 61 guided steps: blood through the heart's chambers, light focusing in the eye, sound travelling through the ear and more.\n- Journeys: follow air from the nose to every cell, food from the mouth to energy and waste, and blood around the body, step by step.\n- Take apart: organs and bones float out of the body, labelled.\n- Put-back game: grab each organ or bone and return it to its place.\n- Teacher voice and text in English, Hindi and Hinglish.\n- Works offline after the first launch.\n\nFor schools: full access comes with a DUET STEM school subscription code. Without a code, a free 10-minute demo is available every day.", "short_description": "Step inside a see-through 3D human body: every bone, organ, vessel and nerve named and explained, with organs shown working, for school students in English, Hindi and Hinglish."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ashutoshduet.github.io/duet-lms-media/body/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "DUET Power", "support_website_url": null, "website_url": "https://ashutoshduet.github.io/duet-lms-media/body/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "hi"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "
VCvXiut3aI_yqJD3ewztEbwSQRpzh10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzpc75YH_kGFLuS3jX1M9BoYmGles4jP5lrZnkL67hz8Q&oe=69B7EF72"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1qSr-XCrEoQ7kNvwF7DpzO&_nc_oc=AdknVx6fUgC9paOL7bh6dHkkoZHat5F21NxkvkES6heo8GrB5yLW5R2J14joyJ1VAuk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWNOY6flo0cUIyOaKMf7DxPnn0KEV_h5fUi2FnLFSqVQ&oe=69B809D0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwUA39quaMwQ7kNvwEERMlp&_nc_oc=AdlNPspslmACPVa0IhFNA3jelIM9wX5TALoa6ihkiRGNIFJV6B9Dep5D_NZlynXwmZ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzyYBvANmrwi3fe6Z600ISRXolrG_p9PbLQ3cmDrQuC9g&oe=69B7DE60"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9t8BmlBQJHQQ7kNvwFAbHSo&_nc_oc=Admzm2l3ojwE6u5lOXO4f0Zno4F2bheoMgWma-d1wGyY5OjPThMQgSPRotsWD-F-L74&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyNjIp9IzOn0Sl3gRnn7FnK1lZZPnOdOz_Hz2V6SVxpog&oe=69B7E6F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCDFron9YgwQ7kNvwFiJZ6Z&_nc_oc=AdnmqeRHVL2mVkuQ1fWsLokorIus7TCM3XuHYq_s663mKXIlyH7oDeq8PtdqTpjAMXI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwNX4emBTmZ-w7crn9EZfbY2LzYcMPiwkZgZOs6rpl91w&oe=69B810E4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
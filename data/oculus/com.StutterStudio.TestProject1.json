3H8NrtWwUfxmbl5yEKk1CgZE5l7u5P1nNxjJkb7jkKnvW2NLShsajmk6uS4FD94&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCusGzvSMEagdumEVClAK5VT1ShMgZjaRRj1Csy8cLX5g&oe=6A5B6972"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0VFWhgXHQ0Q7kNvwEztDZo&_nc_oc=AdqAimT-u4XW0VzAloso2LCm0qOPT4k4mHjB8TRl_H1CHm5dVsAhZxtvP40i3CnWGAQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBv1zGfCftLJHApFY6YANIfhJ4hOwto0WEPJGu4XTV4nA&oe=6A5B83D0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEOHanT8MbwQ7kNvwHwpxTr&_nc_oc=AdodF10MY8C5RUNG1lBjQDxJXlb95uLlOdY2skfaz-ueWN9rDEmya9GkYAEYsbBVXz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmADSbbQknZit0_DqyLUCOoJn1oJ96CvS7jdg-Qgu7yg&oe=6A5B90A0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jboO6SnkTwQ7kNvwEd6cj5&_nc_oc=Adr-UFnzJ4owdeJVps2Y_6rFdIuycMMuf21DoEODdnG6zaSVYucdxpdarm12F-MvRnE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHH1AQ1R0r8fS6oI621HNwRUpOj3r7s32a_V0u7xdDIQ&oe=6A5B60F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paJfPSG5qqwQ7kNvwGFTZA8&_nc_oc=AdqNxVr6B4CUHPOxs3reLQJaHrDW2XVPmUZPGa-XqTNhhwpM6jsCGYIQ0wpSpBNDM9U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLuXhR7hvI6bx7lmJE829_MSpuhlK2_PYogn4aCHKleg&oe=6A5B8AE4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
QkW8_OnqLrtC1N54ZxdRQw67Bl7DDR6UYlWpG2nlUkOC4GaUD_QcN5rxLnBeMUs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bRlJ8F6i-5muNoiZoZ58R3EDncccGpEksDx9e4QPW6A&oe=6A32C332"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6IVn1Ld-XkQ7kNvwGmmuvo&_nc_oc=Ador_kNv_pxY0mJHmz6pZg-52ozI9xTi3Ik0LbNAR3jdJoiKif1P-WXenBSAMAkNljE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HmVenOkJxUmF3HtREIiKCPBaIj7MJuSivF0o3VpbYWg&oe=6A32A550"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7H9Opik1NwQ7kNvwHQ-_ZY&_nc_oc=AdomI5aCTiQFwRQXmB3NVOVRquPOK6iqnzcmEYJndMQ2j7rR5I6hTrhzSGmAojKxhQg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LRyhBcOdoYreT__uUCZsUwLAvuRB3aU6d6_YIPlT8ZA&oe=6A32B220"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eApHgYDuI80Q7kNvwGne6rU&_nc_oc=Adp0ifSLtKJq4r4WDBZpmZXRSn__mMU0m43--YC-v3YAzdNTm4CLeMbaBp_W7Hqn3T4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SDHDE_8LK4w5mWSxbEq0ifcPW5TFGMfD0on4UtjZ2EA&oe=6A32BAB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Gc9-yHS70MQ7kNvwGi8M_g&_nc_oc=AdqgvZZWj17kp9Ohn3TN88NlTLqUyopi3nHhaH5IE1u-ZoF0BZhWfXmmSSDLe2eCDDU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9foYE05bUoJ6d5G9cz-5fyh9QF0rs7anQ3YyDIOg-Rww&oe=6A32AC64"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
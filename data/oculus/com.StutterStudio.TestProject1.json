alD0VSE48uWngQDDwqrnSES0p4BL9gs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyc31oZ3GnYhyj-GgVh5xeT4JVed1-ITUKLuUf5xec7lg&oe=69BFD872"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0w5trk1pLN8Q7kNvwECGoOh&_nc_oc=AdlZorMluvNUEmw6847PmagePFuZ70MMEytUYzf_rhBjMEIa3jLvVBIJrnNH6dcVrhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjFKOh29ctFVFrYtoIil2lDiIvZJaUUC8OEHKBXl7-AQ&oe=69BFF2D0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfP32DdKyYUQ7kNvwGyrOEz&_nc_oc=Adm5Wi-qfy7ed5CJrCZ08fZQXP0X-alAOqdOKvWFiT1woxrkNkkGpuSQpiVmryukfY8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7e_uCay-tUXD34s4E8mpURW3a03Ibh4-j-bFoQJ8bQw&oe=69BFFFA0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiFz2OtTNkEQ7kNvwEnBv0j&_nc_oc=Adki9jOwkrl7yCe5EOYIQ_6eEqNXtHdi4XK-IWqMogyTMOEoEL0v2TeCcqW4dM9cMiI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNdJTH5XT-8OLqhO7c1Def6y5FUyTzxMXbQJ69TKvaOA&oe=69BFCFF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6chr2cFtiVQQ7kNvwHUaU3k&_nc_oc=Adm3E0CE-6cKqIK_2XeF_J54WnWZ_L4uoCARLeofd_A-8eFH8lHgS6vjUnTB7h9nCMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyDIFiqBqx9bOfNBYix0vp8CpQKF-rZ6Vu3YoCn2zy9ng&oe=69BFF9E4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
d6hDKKZWYT5yaoZHRYGH4N0X1_VxgH0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwYFY7l73Z67sQbZ7E3odzHKYlzlkQmWls7nmo_rEA82w&oe=69BD3572"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cydy4tLePIQ7kNvwFUCdwH&_nc_oc=AdkyDPEOLUOsEMD0KaDKvVZ4kk6HIBzSKTE9Ktg5a5U2iKRGs8E2CkfBSCrrboXhbsU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxtJJ9tz2khgJ2pvTdiDL7JcvI4W8VMoUXUuRV2d7R6RA&oe=69BD4FD0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IC7mmiCtRvIQ7kNvwHTbw_2&_nc_oc=AdkjpJYv7SWHpCAZjZrkOjlU5y7i63VPRjuUExNrpe-0YsRLa0GSy2X-YXPWmWhb2Pw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDy2cpEsrLg4XE09BS0cih9A0QrXspmmDwRa1eowKu8Q&oe=69BD5CA0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDqsFNy5T5MQ7kNvwFv0Bdz&_nc_oc=AdkrkSW5cHdS7l_Ci6qPhy-sj2HdTXHeyyClQFDLVFfFHgsEmQKtni0VU25QG8N6Nfc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxIFrtPay4Z7wA_pPdbZXVvP4Y6lJ81hU88vIXOho1BIg&oe=69BD2CF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMjyXZYpHA0Q7kNvwFSlvNP&_nc_oc=Adm64x8PqKVWXwmXJWuqc4OKsEICICyFpZJS1h6AmJfRmwl4NPEubGOo5aNd2cbX7FI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afy4bWOS2i0l-QdTKoIpZE8mn96_IbBjp0BDguyn8ia-Xw&oe=69BD56E4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
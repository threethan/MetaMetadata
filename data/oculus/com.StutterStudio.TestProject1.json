ib_3x-SCM6ptjuHKT6cuVHT_C-r1zJTaxeWCmb9GPuuzR95zbkf8IEb9kbQS8xQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMnpHegbYdpuu31Yb7qY7aOfyHgr7wTfAscfT3evSOCg&oe=6AB2A4B2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOwxVFiXxzkQ7kNvwFB1q3_&_nc_oc=AdpHSh5fgT7Q03Dx3gX8WTdfqYHaXfY5F2PbAsDJ4yi8TTufdK02EldUXGYoZcB28rM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSky3hcN76hExjRElOMhLObLIq41kS6IMYMPEsZS-rIA&oe=6AB286D0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pu3MuxhQ-3MQ7kNvwEE8vs6&_nc_oc=AdomULixCAqORclPCzA7kto556u9L7yvgiORy1gL0IBmQSkrgxwQK6pd3-5KHypLuWs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK71bVxPiCQKwWse96YiawsTZvdSxk2eAX2phiOShST7w&oe=6AB293A0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9rTumSpRV0Q7kNvwEwIy05&_nc_oc=AdrSTLYCjYF8SpzscxM-eyTiIEAi2s7r1P11TwRGfB4_-qr-3zQYPhfWdAoD_Zv5oY4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLApw0If-Hc-PVU0l7WVAXV4CVLp8-nGaDamDKJ-L42Jw&oe=6AB29C30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynfYAKF4VzUQ7kNvwEDa0YG&_nc_oc=Adr4D384NEKAQ8fO3nkjSBwQ-ctlM1yIWgNnFlVwPR-4SJUnDr9T_vzYvUSZykzy1JI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-1X-BFRZzb3F6otS9vLB8ov03O_VKe769gbOkOSUMRw&oe=6AB28DE4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
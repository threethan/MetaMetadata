QbxTdLZdbK2cTXnTjNxiC4h8gjFPu1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxu3RaIvTwHsoWR6ji9enrqnXhThhV0sr1-xSYR9Q-NgA&oe=69B54C72"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whNtzMSUOyIQ7kNvwH1MXNu&_nc_oc=Adn9U-PCycHqsnFQ8LU0QLz6flDjx-KBh0gz311e1zObcPjkYp52c44vyp8MSF6hyqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQz8mfLB7OXOgEDWzkno9blydlYuDkOTEpPR9BIw51ow&oe=69B566D0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGSnXNRNFpcQ7kNvwHXVJCw&_nc_oc=Adltnh7-q23deOZsqp_j_ERJf3GSutZakZPkhue7jxRpOnS9mU3Oqf0Dx0gIfWH3Syc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAuAXRwk5jPwC1KgB5-VbqMErrijS8gV9TUnDSTfAxFA&oe=69B53B60"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MLetOY7RXAQ7kNvwGO8nWf&_nc_oc=AdldzjwNRWJUILhDl1HQIvtOY69_VKzuOStE-hXP_lsb1Xd_0kCoUbgFkar37WkekaU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUVdPSlnRbppNiHZbdJyl5SQMA03lrCuiMxhQo2YtWww&oe=69B543F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VLqv0oMXgYQ7kNvwEhIxlg&_nc_oc=AdlgP2wMlI4W2DdFtrSo9taq5t4DAN-tOyh3M-oXlgsyjaS7zlfYR18FVVBI8dM41cQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBywx9pCy3ujq6Sthxz7jCChJ0TECBFKssXSxPhySO7g&oe=69B56DE4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
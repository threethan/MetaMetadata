c5ITEuGimDM0uYTQB4dAY0wBAGptuhU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQZy9-HF0wqgiUk81c6u7pZHGpTmQzMStzYtnT_nPwRQ&oe=69BE86F2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cydy4tLePIQ7kNvwEfkpz0&_nc_oc=Adk4VCUXaFYloLazPR6ymYwGrYe3XMSc7Zo-UE5gvwwE4lUQJnWzIfkLKwHrFPtFmuE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdapPw4lrKr6hl86ejmw76pxdw_gdfqOUyJL-zz9X25A&oe=69BEA150"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfP32DdKyYUQ7kNvwF3rUIo&_nc_oc=AdmHRKX08Ru1Skaa0i-ENSP82e6U219Hjr-mxvAQqAt_Zr7dHvMvyD4C9aKukDCN5VI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgCJzgLNhvLW5GefrY5X_qEQODVVlWy0iS9tFFt6JhyA&oe=69BE75E0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yiFz2OtTNkEQ7kNvwGCBV04&_nc_oc=AdnQeEwmIE2oNdvTsVA_2bypF_2k-Cp998Mg2BmLoqwLxq-fFw_15LwXbLrqskXE1jc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzPerHbqaes725w5G6IkPpp1s7yBu1-Vp_0gPZX5x1gBA&oe=69BE7E70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMjyXZYpHA0Q7kNvwFvdJSq&_nc_oc=AdmKuHJ_RueEXVz4DaszXV47Qt3Wrx-FpvHkTQcMq_0ATluhAK2fM1R1uhsmeAeiOrI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCzlfwLd2JwyPUhBG8y5D_V7EQ1qNZuXK5zx7jt94xCQ&oe=69BEA864"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
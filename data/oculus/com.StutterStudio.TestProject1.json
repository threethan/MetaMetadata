n.com&oh=00_AftpcgVGV184g8wwgfSF9p0b11fwHoes_vz80hbZ3Dn_6Q&oe=69A428F2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT9zfjHgcZsQ7kNvwFvE-sd&_nc_oc=AdmVani7sDkL-CvHgN8kU_TSi8hUhTztL36Bwx9te-c5x_mWuDK7J9jKiX9CV3c2v-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv0tHR_KGBI6PiC40oaSDElwDHOjW4SgYYDFYrY7PiUxQ&oe=69A44350"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmcwbAVV2aUQ7kNvwEgZ35b&_nc_oc=Adn5jl8002MuIWAwC0QCzdEnT6DJ2p3KWRFBmbsmnw6S-hLvxJtPtNW85Vwt2Hjq9eE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsx0rGKtzrLoABkT3MnBzttcXW1xinxLfN-h4Xq9UPCHA&oe=69A417E0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pqc1_ScPeBMQ7kNvwFtfbge&_nc_oc=AdnX0gPK1UXxbE5hWgAO9m9Nxq0YV3eM4faEKtFgtuqpO427gGRjaUnKgmw8i2mi2HA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuXyyFdFTra43CkLnElcRY0x_ZYs8gbo3JJmTsgsLVfsg&oe=69A42070"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eergUAbTygQ7kNvwFefETC&_nc_oc=Admz97PVd3n-BtRGMvmr_ZRBNHkpC_eGMuN-mvd7sUXw8yZACYDQJ5hdm1YxnAFAEFE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvi_pi6bTLvhsUlbAOsrbGR8t-44ZqStYY25KXKLWeVnQ&oe=69A44A64"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "490572
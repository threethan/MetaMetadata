MBADxJtmPi2ee-dkL8RqFxHUAyGShq0tvRhZ-CWjcbUSnSfI9MXG9SbaREJ98UE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nhzWwpI2qFEoT5U-S6MHltybG3icgqyH5lpHtiJ29TQ&oe=69DB87F2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q90O7YhBMAQ7kNvwGrFK_H&_nc_oc=AdrAtN2n_FG8d44lH02wC99VdvWEhI5ETwsljsDXivXa1IflC5ewpN5jl5ag3B8XbOE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2X6wVzMWrn-On2EEzyUL3-xm5Jt479PI-xBnVRQQWHRQ&oe=69DBA250"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdBZIPrcVRwQ7kNvwEOJ8qn&_nc_oc=AdpB5HwFmFQd0bc8VBF6J7fwGA_2lPqjmNoSj8I2Xt9I-iZn24CcKJvtQh1NA7xvcPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XGvkC2TR5MqlvAhFB2Y7aL6sYHxWWVFFzSp17qqfwkw&oe=69DBAF20"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BV0MitdSX28Q7kNvwEZSB71&_nc_oc=Adrlrmc2uBrAMk4y4Wf0pdF8_87YFvVKccQWu9bx2KetYGc71m6LEQ-6uIVxRu0-evo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mtrpU6ESiYxYHbUKkonFhxv46EOCO8F14CSPQ21UXew&oe=69DB7F70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VVTHXLc1g8EQ7kNvwG5-Ss_&_nc_oc=AdrSXxbRvQES-ZdHz5As0T5cVktrGHE7OXqRmMFgUO8vikHq1aOhmci1vfbBHDoLqNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HrP7pOibUh89TPlNZKzpvqnqE8SqThRPFeeGN91GrTQ&oe=69DBA964"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
astwGWw560Mw-nXmJOvfi_3MFBU0hhg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvMrY2KyjugBSfNiBd-2ehNkKdtMQqWMu0ZBEx-KO8JQg&oe=69A96EF2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k__DKg2-nnMQ7kNvwFuJnAg&_nc_oc=AdkchSZng6S9aYP4yzgKGn4GZFUP6DmKIOvHU8yrR27akQ_lhU2BHKgvq6yZjbZ-wgQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftUrY7pUcvLxLOZoSMGNTgBYGjYsXSkZ3kKdMRYjdZLkA&oe=69A98950"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7Jr0PmecDQQ7kNvwEK0kFI&_nc_oc=AdmZwB6AQ71xY4i7UrxnVOJTVOe4aBiWUH1t9Lkx1gQydF3i7lO5OTHqFuoRqEV_gVw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft3UmWOlSXxcJDwAfFNVCF70rvJcJI9aEM1J_qm6KRDjg&oe=69A99620"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbqVo1tusMYQ7kNvwEm74ZA&_nc_oc=AdmItvDlE3gS0ifP-T_vazisfrcnbLWGrSiB3k5X7Yhu-0WzmJl7Pw4wa1ap7OSH7BU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfukRVWGOUQZaw6rrOqYdnhIuTOJFVLDXgW575cKmqSP5w&oe=69A96670"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZrtCmZ8HVsQ7kNvwFtFKGo&_nc_oc=Adn61FmPCyBKaMl_sWSrc1kGGWSeYjVWnSYKacWirclvsVG80yVIIdfKkH3e6wtUEZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afsq-XgHJ42iaaR3_28Sf_86IL5gTuG1Z05F3jn8_KX0nQ&oe=69A99064"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
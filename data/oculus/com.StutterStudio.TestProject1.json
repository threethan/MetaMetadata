z6HJez7IkXt5nZtdWsPm7zcDNqkMwQqco3wBUrg4Fn8cOoNjnyu5ssmnQqFv2Xc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhq8Ggzu_I3z7HMaKyfHhqkjshYbi-6u_SM9pItg2cpA&oe=6ADCD4B2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COjP5bqKUYEQ7kNvwHKhzB7&_nc_oc=AdohWXZVPZEIiHmuoPJq7xIO50a7mYtdbkQCdPFKv5cNP67xHPLTBVZwyThZpnnG-AE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEDKbkREjnx6P09YamxwzEH9_ZsAIRP-fWyFZ9-TDkEQ&oe=6ADCB6D0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozlL0R4waIgQ7kNvwEV9JAK&_nc_oc=AdpJtgk-BWB4aVKjazNnnvxDDG42H-4WvrbKH4rULVH9-dH7g12XyR7mg-q3CZ_uvWY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2t57jp4wy4U-TVAE_QdCpeYL3qcB3L9R0raeFHb6gnQ&oe=6ADCC3A0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFOAq_uuHFcQ7kNvwE1ETzX&_nc_oc=AdoDhC0hxoRosij2tv2P9cBiJtvZ9EL84C4Zxsdb37CbqlpLI-gVwxmp2oOO3VAM9oY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGBsfpd0QGMuyP0Nr5q2qyyhq1yfGo3_dZNAlEDh_0Dg&oe=6ADCCC30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_NSv59J2_EQ7kNvwEufyEq&_nc_oc=Adp5tNAENogyWeEhkm8TwyZwl8Z1OweI3zBgYCF9IPnXvhyXCc63xRoD0q7IvrNV-9E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9VqNuOfj5v9fwl66mpAa9zDneJBuJqggS5pEl7myf_g&oe=6ADCBDE4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
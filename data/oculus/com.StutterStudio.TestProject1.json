FlhJ7-EJaw4T0BmPeZTE-Gsugq1j5EE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwSMLDgaG0bxuPpM71vRGTzZXqPXwGdjq9ldJW7UgPZMQ&oe=69B69DF2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whNtzMSUOyIQ7kNvwGg4MTE&_nc_oc=Adm4T9Vs5gyhQ3eiVg1nZZoS3B77MFKhQxuAmN6IJDPog_Hh70KgqLRS7eh-iFTlems&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtK4NMWfEpareojqqDQMTQoG4hd6P4KtQPJ-gXIPZOTQ&oe=69B6B850"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwUA39quaMwQ7kNvwEwEvoz&_nc_oc=Adk89F6bPcADFmUPOetu6qJ_wXPxAS-5CYYjAqkjO6d-7P57S-lZjtq78JrLfwMIxXc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUVcWbx2TVGmdH6XHT95VCs2r4arnXBUhIZGVZTolbmg&oe=69B68CE0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9t8BmlBQJHQQ7kNvwGRmfq_&_nc_oc=AdkWpYW_rUzd4PcvLMB_hTL1ahSUPpflYVVZJu3-5qgRhM9hrnnsNrGToiWRjSBPak4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwd9zlXQkjYZGo5OEZAEOfwYw1-QoarZ9Lmub4BFH236w&oe=69B69570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7VLqv0oMXgYQ7kNvwHP-hE8&_nc_oc=AdkF56hamyD-PXpmwhbmBpXzxnA_4O8bJ4G9R6Bd6Gy7CufaUuiQug7DBCBgb-PYEhE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzReOnT-u4v3ay5bLOIFEodMQOtL7Rr1u-gUbjbyjDoDQ&oe=69B6BF64"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
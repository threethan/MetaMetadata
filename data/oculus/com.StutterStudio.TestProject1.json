=00_AQR7hl8nmK7KtE_TX3qkNu6NSr-rwVqy7oWADNDafJHZig&oe=6AE742D0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gvpmkkgE42IQ7kNvwEqCgbg&_nc_oc=AdoaGcv3Kxa3w-XXWJ-bbicVYoobf6cxDuLc_tv0ZTU9-3VqPxCtfq-pjbtwZV_dyzE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaxFiKDz_LAi1_Mbsor-V_XzGZcbTEaqB_2LoOrGix4A&oe=6AE74FA0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWkeWYXbIMcQ7kNvwEcN6wB&_nc_oc=Adq2U95m6srrdg_vbHCb8oyXuFe-sZ3umJDUM2XdgEJFUhzI4ZL-NY2Jba6lU4Xwp2s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYt7KAHUKIPqpVRCfs_6a06Ls3IMhzT9APk1bGneUW2g&oe=6AE75830"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNKlocviTGoQ7kNvwFkPEog&_nc_oc=AdpwexUUsmNpFL85WBhT9H8c1qfEJtduQHpV_u2MZxS59Oehh5uXZx3jutbPSBLy20w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNyHFWvgTkEF8ho6M_9c3QmDoNf5jtFNwUavpwOzHrrA&oe=6AE749E4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "490572719140284"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1159756007846139"}]}, "baseline_offer": {"id": "1159756007846139"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1629325260, "status": "PUBLISHED", "id": "1159756007846139"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_resu
8E35XfFJ2nbmv9NhKLEVLoFu7tPJlSU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvdSxEajyIzCJsFdxLEQF4UTw-EcTcLoSmtl90UeZmRaw&oe=69A81D72"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k__DKg2-nnMQ7kNvwEJ2F6p&_nc_oc=AdncAVnXmStRizncui_AlaKALrsMUrjitqOqkAPlXH7zRiSo4ugM6YQ_NhlJhEhDfls&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afu7fNtCTUBZ1BMkBCMTE4bdTK17oiTgzMlprZq2uMoWZA&oe=69A837D0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7Jr0PmecDQQ7kNvwFpsj7E&_nc_oc=Adkt7H-2jwoD8vS9HcsJm_L_VGGXekQca4Q_8vJh8H8p9SjpIB8RooszBrxsyUIf-94&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsh0xFJqZTkoil2i0z8XuYeHlg8aaKdHTOlExSYm9tTUw&oe=69A80C60"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbqVo1tusMYQ7kNvwHV-F9-&_nc_oc=AdkIBuYJ25sS9P6axGS7ASoDESzSKbyLTK9CHzHp6vD3UQ1ErM_ggqpJ_wGiA4vESyY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuH96MWIyB4WUjsh9SLIGH_ubCjoDNfoqx8kC-zhU3Q_g&oe=69A814F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZrtCmZ8HVsQ7kNvwFk9RQp&_nc_oc=Adl5FcpM3MtuJELtjnI6ibH_AmwKtkwm0D7GPqiZ-YcTPoTeKEpGCqd3iFTf6srbCR8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuZwBppCIOg4Pn1iQUqcvlA-INLo-h7UHqBEj1NHhQ6xg&oe=69A83EE4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
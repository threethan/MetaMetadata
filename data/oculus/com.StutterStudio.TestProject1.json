ynJaXNqZGDnjtu9wXO70m3BjGoCdnMvg_8Ov4SVTs-rtUbY0u7BEo7RovJ-ICTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAubvce9nwq43LuKoqYXayDAmokYa1_X4BZ-1-y4L2wpg&oe=6A5F5DF2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBHj0JgjUSAQ7kNvwG1YX0c&_nc_oc=Adrfkid6vO4G6RkqikvZVhid9MpfsegV-Dh-9oN7u1GbToF4QtjbL5Tt7ONoSqWWIqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMHuuw821jAiTBBysnc3lbWFBSM5npWnIUW1-CeJTlxA&oe=6A5F7850"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vm9dFlNVnfYQ7kNvwFnlhQR&_nc_oc=AdouquTjpVgbETAv0vAbaQ3S1tTi-XEgnMlcY4PTbHT-dJoj54WEU2TcoAf0I-J7qlU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDM8q7FmgSIyfgYyW3dS4nW2jzcqwHU-n2aDWKuVlr8lQ&oe=6A5F8520"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UVIcVgNgVNoQ7kNvwEQAnBU&_nc_oc=AdoPfTD1rcQB32uqhc4JHGa_wbrmmRu2pjgbXHaoaNoVL6jdIF3FurEizkr59iSLDmI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgOEqj6-grQUM_xGFyK5aRi058EnKQ74vGg_ZeyTeBQg&oe=6A5F5570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ISZtgAi6Y1kQ7kNvwHxelco&_nc_oc=AdrJp5uQkFoi49SJ5CVCXf_h_O360WxrbaUlLq6HdQaYtmmE_HoSTORqLa8EYAUynlU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGq9hfDqfqlQ41x_WDo86QdQuIdIiRXGMUm-BAPdXqvg&oe=6A5F7F64"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
5k73Tv4RgjmiAuBs_U3SzHVNlSDrOmrZJaL3Az2rfuHYR02-MiQceP1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1QEFB_oPh3wC0LG1Myoq2iFlM5-JrZF7DPpLYIWWwGdA&oe=69F0C720"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNWdGtQx71MQ7kNvwHDawGf&_nc_oc=AdrnuFNi3LxBqpuknhKkizi-Upmlm5RxvRND41OZz670j9oagVkq_JXaOo0dzXubPMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2yyPeMNWi5zpCaIo-LlOW7cUh96spBEeZj2muO2zeu3w&oe=69F0CFB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-3USlsvBHUQ7kNvwGujmun&_nc_oc=AdogGw1AdHv_Iltr2Hlvn_Qe0K-Q-bpcRWU0-0Rfq1jsY56bm2kf-DL4tslqrWBzJcc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1s9KqOjV7fMroG-ytTtecBluK_tuf1_-Q1crXnjdDIoQ&oe=69F0C164"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "490572719140284"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1159756007846139"}]}, "baseline_offer": {"id": "1159756007846139"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1629325260, "status": "PUBLISHED", "id": "1159756007846139"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4205589822895376", "version": "1.0"}, "id": "4141163879296113", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4159850590802633", "is_concept": false, "l
wAXvUdAXnbcqTronrzsheWcmRV4c_OzzbtzsTDA6SOQbjr7T0mW_YSLe2wdNXxk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JVTbw-E_H3wPJvXCO0nYmCEi5UkqZvD499dByi6RqLA&oe=69F342F2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlsXbbE_MW0Q7kNvwFD4kZ7&_nc_oc=AdqYMJQmi0wVUKCgpaWJLMTdMwTPiA1q0FZZBq2UCVvOcePNaFGEdgDpFTp991XQ8Nk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JifkXCp_oBkOdmKeoK8Oht4eObeh2HJZB1HZb6hnDUQ&oe=69F35D50"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hrh3ny0wsYUQ7kNvwHCSZ5H&_nc_oc=AdrLaaBkUZBuoq87JaAUdwX8Cq4DxYKdn0BPtglwO_EnwWVcnFmlXGKiiLfZnUgp3xI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3b5I-CP2L773N_2HV7KB9Xm9enYWss8rxuz8XUjnQFaA&oe=69F36A20"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfCmGW1BA5sQ7kNvwGjqeDc&_nc_oc=Adp4d8lILfFIuVTOgM0_knd-3VxjyJcAqMhMB_HlfKgX-JJalENMJzJCcq9zpl3Fw6w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1l9NhEXpXvXMJZIsq8oNL-bFI59K7GOM6yPXS9Mn5cVQ&oe=69F372B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s__tyyrBBBIQ7kNvwFsfl7m&_nc_oc=AdrBNTKVLKNmMd9rWwKh4M4cb3gTeSWLGuLXt72z-mCHSP6_gFFfSYxdACKM8mlWXfw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fD_EiHmiePiOvsH_8YVePR47pwcZwUV2MV_uNrNmFDg&oe=69F36464"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
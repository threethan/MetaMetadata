W-97lT3f8s8fYkeV2hidgDdlAfos1jidlVs3y5kVoSvG8Js02TomN9pAgxPcKHE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCcBxD2GbDp2idPHHDzEW4rwpbGT0wcrsB1-qjwKlsaw&oe=6AC90E32"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFfmui1YTAcQ7kNvwHCeyI5&_nc_oc=Adq7lxmAqp3gJHB-1AzkkmoVA24PUcuVQ_59Rxz0mHMi0q_LbByPdpzhpllocqA5O-g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyO8IhmXnli4DH1s3p4YHt5vm2vBGRhldRvyrArA4j0g&oe=6AC8F050"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hg7_5NmEOJgQ7kNvwGpLGkh&_nc_oc=AdrEQoqKJU4hB4CExI5x1QJ64ErUUCMxokpkF4SjiPbDH-uR0bBrqiDr1p3rbFr0kRw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu49uMYzOhuvueYFAKRYqAvd5V_YVsiUgceVyxSnb_LQ&oe=6AC8FD20"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jq3y91nO-4QQ7kNvwForbYX&_nc_oc=AdptOBIktDkrIJjXUi3g27gFnY2rrM3nqPZCtn49epKEI5dHZx2eaAGSeh9stwABQ1I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8Onon-Ke_d3x01R65F-hppTEtfMr3niQgddCBQhbgJA&oe=6AC905B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YHOoWwRMb_wQ7kNvwGjPMpE&_nc_oc=AdrqzE3eADb7a5KzgfN7OA3Nn3PYBcraEqz4ywSuLRTGs-1g8YUIn7EpY0xKSgSyrIs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOehgav6OgRcT78mUTlC2vaGkMPz3VZPb8PSk2DEq3lGg&oe=6AC8F764"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
7v6Cmum3A-upDCsgqJA2d-BMytbNuvg-j-PddTMyB43I4ny9n3NNLENw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftOEZJwa9zvV-n0AXg9RfuCrAuac7D9lu4BK0SR8axU_Q&oe=699872A0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cn9O6MgT05AQ7kNvwHg1AHD&_nc_oc=AdnghIAS5MEFoE50vr6U6knDlBE2EgjlGhpjN-GsWN6yfnxNs0fFPLCcGDc0upxzj6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvVPCbd7iHQvqlEzXyt_POytX8pORW9iKK2nj6M1y_xSg&oe=699842F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4jFJnPKvy8Q7kNvwGSfFXc&_nc_oc=Adn3EJ4Io8vp51rEpWtGweOHqe2Ll-M5iksQPyZMz1ixwsPx7eojYZdsKRa7MNdDUT4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs4VUBJMDO8_J7qSIvfDFuivPb9_hvfryX8L4xf3fg6Sw&oe=69986CE4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter 
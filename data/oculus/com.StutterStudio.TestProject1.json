SAzAdOnxGld2MAwwGrq5jaSXMgxHeDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxbxfBsBxlB2FCvIGqKlSMM9pmeI0mtHuFWszP52aDPLw&oe=69AC11F2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CHHHK8CShoQ7kNvwFwGC8Y&_nc_oc=AdkNN10crzCizEEHcgAh-BUinXO9zQuqzZUtag6GCraBTCqB4uX4Hk1ZGZGrwRXQSnA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqhTM0KPTvmk_res705zWaM8E6Bt38uE1T8uXSqIqL-g&oe=69AC2C50"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKLSRMhal5EQ7kNvwEDAGKA&_nc_oc=AdnURYaCEwSmdbSoQGCvP4r-MxZiPks5L8WNsvzsQzMOjWza1HR6TQ1p4k8KHrjyXEs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzyPyuWyLGne99aYnMguFaHzg-YGES7alaG0dD-ogFeIg&oe=69AC00E0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bQjS20ZL7YQ7kNvwFsuF5Z&_nc_oc=Adl75WDq-PioDYoaqe2nxsHjCQ715Fx09AkEsV9i48K8uIK6BtjsRMJwJOKHhVIQY-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw_OWvaN_tXrH7tCzi7s8EjnGLnqLNEfi2GQYCBCv68Lw&oe=69AC0970"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6F3-cp3zhcQ7kNvwH7MUJm&_nc_oc=Adm1_lqctOUNGN1jSsCUl6QGayoktkfLf54geJMGpoL_0NCMJyl1SaTqG5D_ARnvBus&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzTanqePwJFhNGsR1xcMo6e3A8kk_Wo3Z7Roe6-NHJywg&oe=69AC3364"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
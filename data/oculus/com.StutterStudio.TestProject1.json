n.com&oh=00_Afvs3LIyHzXu3mz7VF2E8Pedkzbdql3SyPGdQ2L-sgOEDQ&oe=69984B72"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LNngWmlCA6gQ7kNvwFyVA03&_nc_oc=AdlT3VO32TpZUYwo_y4Lp0Od9JybRSLRiZvzvi1QQVLB4n6w_FJa4qgqioxf-tev5oA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfstA171qhwKpDiW5tW0yiUXRuJGNg_8uVdQq9JnZ3p_sA&oe=699865D0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p05MCcWzR60Q7kNvwFK7wTr&_nc_oc=AdljMWnSl_m7v6Cmum3A-upDCsgqJA2d-BMytbNuvg-j-PddTMyB43I4ny9n3NNLENw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftOEZJwa9zvV-n0AXg9RfuCrAuac7D9lu4BK0SR8axU_Q&oe=699872A0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cn9O6MgT05AQ7kNvwHg1AHD&_nc_oc=AdnghIAS5MEFoE50vr6U6knDlBE2EgjlGhpjN-GsWN6yfnxNs0fFPLCcGDc0upxzj6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvVPCbd7iHQvqlEzXyt_POytX8pORW9iKK2nj6M1y_xSg&oe=699842F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c4jFJnPKvy8Q7kNvwGSfFXc&_nc_oc=Adn3EJ4Io8vp51rEpWtGweOHqe2Ll-M5iksQPyZMz1ixwsPx7eojYZdsKRa7MNdDUT4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs4VUBJMDO8_J7qSIvfDFuivPb9_hvfryX8L4xf3fg6Sw&oe=69986CE4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "490572
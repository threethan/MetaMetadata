oUoGWzMsh_-EFWuQq9orDSMZttMfUFc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyoKraULrgAYnU4l7OkJNIBWSfbi8vI36OW1ALq39S2Mw&oe=69AEB4F2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CHHHK8CShoQ7kNvwG1Rmir&_nc_oc=AdlkNAr57b6BGCGStye74Ln7rbu1zvOyqPLhWU6MHmng3jhHt9RikO8mIZ1f2h8Ncfw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyolfZiUqzdf21pmu-agJQ31Z4OjJxcnslUMkrT64k01g&oe=69AECF50"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vl7s_xwC3IkQ7kNvwG-7U99&_nc_oc=AdnqPcvtu8pvTOvDWC8fBAl4wjrpIm4meY30SEg9osyYhc4KL9UU-ec5btmhkVuO8T4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGtWbFgEiOrVbJIjjWxdKxS4MUcInlkvTwr-fT-1bY4g&oe=69AEDC20"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQlUT-f5Yd0Q7kNvwHRSRsT&_nc_oc=AdkvUCkYor01A4kboYATle_8GBlUSOo_k7wvuRNnqX8Mgx8QjZ5ZI8n5bqphLgTI28o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGi9OfQ8hXRvIuweEEu1uohd0IIxvwoRQR56EFVxHO8w&oe=69AEAC70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6F3-cp3zhcQ7kNvwHb24QZ&_nc_oc=AdmEYU2Ve0TXLkWiJ7yf27hEnoypU_tVMDboAsMMsxQeNasQbizygGNfOUqkj4dgFeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzn5DtmE7WB64bWu5j1ERY5V7MYZHnpvsm42mesJcZzHA&oe=69AED664"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
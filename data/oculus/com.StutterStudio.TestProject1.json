D93JqNlWpitxjvpai0S0qf0cQEKQNgw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxIekcRqGyYhH20tdE3WaxtCeAEz6cGndgXEHl-2cEJSQ&oe=69B2A972"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Cfm40ENMOcQ7kNvwGW5T30&_nc_oc=AdmpS8m_M4QeqBnFYNiJ-syLMEEBUlxQH4-luU8GYjpCSN3QXfl8_b3AYIgufw38ul0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZHrgXlgaqf6AWDAPfBm756vK9dxsJpdcgplipMgE0mQ&oe=69B2C3D0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NGSnXNRNFpcQ7kNvwGWnPHN&_nc_oc=Adnk8V0oYKruJ5gg7M0ezqyqmOmG4GCe6BZnLXmUa-xgwodaq-W1YVKJYX3pUCAJe1Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw3N9GLZ9AQb8EoptRtIeol6kcfp6nNz0QOrglxDBOiZw&oe=69B2D0A0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6MLetOY7RXAQ7kNvwEPUaVb&_nc_oc=AdnW2v7ZEfWxdd3QQST8dKeZZJGp97LJmQvqKS1cdGgKK59AG_kVb63vOwgixCwG4a4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxMjT8pv77pfYSw4edPwNltbgohgjZmgRObh5lMNsJQfA&oe=69B2A0F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcGpJ781bhgQ7kNvwG6ikqE&_nc_oc=AdkO5dsF5qBWCOZEHf7ebDruXzcqQbe-9N1p855SuJiWaPRG52Vdg8PYMBYRslupnIA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzyol5LPDvjwZ85QxoV57c3h3bdAmEh5IEYJmG61_81Wg&oe=69B2CAE4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
6-I4JXvRRFITLk6Y3NpTP2znESzAmb_n1hbYlr3fDuA__wtmJ2Szqa0Jcf659Mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa6lck9kuw1FeKvrj5Vm9hfeL1wNolhKe1TndRoXQvzQ&oe=6AB3F632"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EOwxVFiXxzkQ7kNvwGG634_&_nc_oc=AdroQP8bnoUgXe_QIEuKtPoRYC2pOfr603N4POzfn79e06HJVxGevVb10g28uT4mWzU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlnNKEwVBaV3WRlYtAS--yaKlli0Xphk-aONonlmNERQ&oe=6AB3D850"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hY5YOtIDQMIQ7kNvwFICpic&_nc_oc=AdptEPehQWBzBazAekNJ0UJb9CO_n4NDhR-to2K3f8d1OWzBLgS-VzzQU994wuAVmR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYCNyJyFnaKFS_xtjJ41Jh4FuB__CdMyHA5dZdLryxWw&oe=6AB3E520"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sd4bN7FY44sQ7kNvwHgPfNN&_nc_oc=AdqQ0E7_gAv1XknI7QYD6yq6YV0Y73_dD93P0LXvJ4cZjUf27Xx1B377vARHs60udZM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnKddgH2veGAnm7_hhnPJZ-odgSI3xaecfM647XtcbaA&oe=6AB3EDB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynfYAKF4VzUQ7kNvwH1yogq&_nc_oc=AdrhYw4KUUmNuN81DkGgK50JkX0dw0rvr_ko0TbXwAAmyuhGEGkBKlBVallG2c_yAco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNrgXtU-Ts33cGlwTfwb_-ntXcQ2BwKOBLHkp1a8IpVQ&oe=6AB3DF64"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
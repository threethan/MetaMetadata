=00_Af-d7dY1pCu2asurUz41TCreS0rV-l8iuIV-DW6JmjtGsQ&oe=6A300250"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UN8193Bm6MEQ7kNvwFN6E8U&_nc_oc=AdpJArazFXl2eO0bJo1DqfDqjZ8A0ONRM14ei9C9swKkSqwBmInYb0klwgX2EhINtr0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AUNOLvjS70Afe6j0CqEUw93NhWI-17RjuemFROvFFhA&oe=6A300F20"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ct2vT2hgi5cQ7kNvwFUqEGz&_nc_oc=AdrMFNDrRokLLR28cuYdSmZFmrxnZMpBfBoMPO4gFhZ8cUdH_rjI_tyqUVqvaNVCOv4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ulKL7KLpmQtJRaAVlgEPjTZxMQSPTxOF2KwpEmQ7BLg&oe=6A3017B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=loZEf5hdIM8Q7kNvwFqBSZ2&_nc_oc=AdqziaF1CthV_GZXpbCxFK9DB8-nvIXkxu1eaCZDxNteBei7MtBkSkJwKebLqoBkvoI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84CNE1KfVJqPYMeyrBGsIxmuRuwA2ZuVXMC9MDWqC7ng&oe=6A300964"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "490572719140284"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1159756007846139"}]}, "baseline_offer": {"id": "1159756007846139"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1629325260, "status": "PUBLISHED", "id": "1159756007846139"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_resu
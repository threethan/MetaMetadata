f3jNivs-GP8DpEffu_dqr_1QoOQ5f7yWttok27knXbWwLzOZ-6Pw6rKmf-q6Awo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QTutqp7ROZm5Vkqltnnb8F1-lgRRWXOWKYYR1Tsxjtg&oe=6A2C2BB2"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIRlzFHAyuEQ7kNvwEoKi0N&_nc_oc=Adr2StmphuGIpO8qkQSFfvWiwk-Qp3n_dkSDRgNBvisvpr7HzVgAub8U2ciMGkL9fLk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8wSTEB6Rxp8S3eWVfUmuZDc2xr9FSAO_7GnBVrFcAdQ&oe=6A2C0DD0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K64FwbngjT0Q7kNvwG1Gjn6&_nc_oc=Adq2h6Ehn1jCtlCHN-MzsnowT7JT4CpTqH4oJnSP9bn7OgaA_RZ05K2WPDjuw2qfKKw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ra_0WEon5aNJgF2vIhrn0kcO9kp4-s41tpMI-22QUBg&oe=6A2C1AA0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G74bKPhSotsQ7kNvwF4YFrj&_nc_oc=Adp3VFTZ1egis3gU1EmxlWWRdABBu041WNW7tsBPCEeT26RqwaUWbvGRnrlMUEXt7wM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ckzjxuTz6uE1y8tMDguvUFx0JOAu8HPXbvrXzOlcEwQ&oe=6A2C2330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bukatSH8cV8Q7kNvwE-4cud&_nc_oc=Adru2fnLVxf3cMv9hsIdrlTceZvNKoLSUFUBDzafHAXQZEwq0nlgR6gdOzfYwvFqX-Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NAiJAze5CEUU_ytX6XVSPHed639rfrgWhzJ3B0nGEfw&oe=6A2C14E4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
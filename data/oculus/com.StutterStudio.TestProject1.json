n.com&oh=00_AfvAQDpboRVG8sInCzZvpttWPXbkp-tkUEbF8AiRKAX-Og&oe=69A03472"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUVqNwe5Gc0Q7kNvwEmV2O8&_nc_oc=AdkHnbo27Y_U134WSxD8Jcpyad432K_esIvo0Qrbq_bMwy_OE2GcpG3xAqdbiLpj_Jg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvBsfJwGOVRFERaBZZWMwUWMMJ8BytUbrupy618ey7gHA&oe=69A04ED0"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gGuolwaSHcQ7kNvwF5Dz5v&_nc_oc=AdlBHGe_MxBqSGIajZKhVPpM1Y_S_TcFfogKOkYZ__0hhD9bITHpSTlc9tXqIFlPUb4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvI5Yb1MN9QNGXIHlkXG29tHGo6S5hcCLEVZQfG7UghvA&oe=69A05BA0"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IYPrEHHbBQQ7kNvwGI6Pk_&_nc_oc=AdmWpKgO_uwdVOLf_4BTb_U2INhFkOep91sLPkM1kxWJhMu3W6dlVRPpYsacarRfk24&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhDzrbQXzD0wlZAPRe3gydsU_SWeGStbf23Jgog61w-w&oe=69A02BF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GI8jJVjbLzQQ7kNvwHQaVYX&_nc_oc=Adl1zJ9kQj41IRGJP83e_trZtCT4tEVsnVXWz1aglbPmddRAspvzUeL8zhzULeZDVHo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfufK82LTxiriZXzA32Jeyr8ig_xEbK-ij08lRUUmR6h3w&oe=69A055E4"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "490572
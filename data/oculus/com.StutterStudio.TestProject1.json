w_RYEixS_Uaox1YF2xEWDmUXEamYNfzeqEXVS2kT972GP3_lC614O9CUW1x-hCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDfcXndQBf1LWlplb3KLrF9rUM1tr33F6ZPq95JcHJ52g&oe=6A4FC432"}, {"file_name": "SS4.png", "id": "998769427561867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035360_998769430895200_6944497831195547691_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_9h6ZQUNvUQ7kNvwEOj87y&_nc_oc=AdofQ_Yc4ylnN11kjeiEnZ-sCdHIcGY-_o3mECfViggpzdhaCSUKnzRTXlpFK8Lnhmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArUjA5m-UJpdEYfW8Qo4BBvwqn0cLAWq5MYPbXZArEZg&oe=6A4FA650"}, {"file_name": "SS1.png", "id": "540232723686315", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035317_540232727019648_5347737063985417482_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VuWJg7yzJgQ7kNvwHDfAVQ&_nc_oc=Adqakn-vXiFgIhi2-zFUO-6J67Pw_lJv5zbQU27_cQf4kcZTD-2Kj3dFPXaeXGtH1dg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5LXvw7v-aMHDIhY5YZwN-UhBSvo9jyiwXJ_qn0B-gcQ&oe=6A4FB320"}, {"file_name": "SS5.png", "id": "128013399437797", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75222944_128013402771130_3189336535689550197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ye1O7oc1oRYQ7kNvwHCTZij&_nc_oc=AdrhNjprktvV7SiPfUltF0HlaFbK8DTK_3lkRv4TZRJaaYiH7sWOVpSbv4Ff3LZxSog&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIAHoCKtlZyQBlJjCbqWBfclcdIojRxWC0Hte82QA3bg&oe=6A4FBBB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "2865015350478071", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974864_2865015360478070_5431746936383429345_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNcqNMADiU4Q7kNvwEuMpbW&_nc_oc=Adq_7cnk9t40-sBhTaahbEAlHrFpW74VK2uKH28LzKkwhXm3eDvnqPToKnVDvX1ipRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKtK6_hfsJd3pWjRURl0uyeMWteqTzMxBeMyurt7Jh1w&oe=6A4FAD64"}, "display_name": "Stutter Speak", "keywords": [], "long_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound.\n\nKey Features:\n- 10 curated speeches to practice your stuttering\n- Long term data feedback to analyze and improve your speech\n- In game tutorial for even the most inexperienced VR users\n- Intuitive controls that make Stutter Speak extremely accessible\n- Upload and practice your own speeches", "short_description": "Stutter Speak is a public speaking simulator. Using Virtual Reality to put you in the moment of giving a speech, Stutter Speak can help prepare you for the real deal. It's not just a simulator though. When you use Stutter Speak over time, you will be able to see and track your progress in many different ways.. This provides you the opportunity to grow and improve your fluency as well as your comfort with the way you sound."}]}, "developer_name": "Stutter Speak Studio", "developer_privacy_policy_url": "https://stutterspeak.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Stutter Speak Studio", "support_website_url": null, "website_url": "https://stutterspeak.weebly.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
sid=6e7a0a&_nc_ohc=5Ql6Ne77va0Q7kNvwE1Rov5&_nc_oc=AdovgQ7X0qlg0QdPcqKTYUEeMojrSJwrfpzfV9FWM6PACvccPjFyjyRafw3AMAJqwFE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lyoGnCrUuGGV0Afa_tOD-7LBkZ8vBrQ28DuyZr8CZ9A&oe=6A45355F"}, {"file_name": "file (24).png", "id": "1622731945316713", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001662_1622731948650046_446425931297130046_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-ocFlMr9B4Q7kNvwHLjxnN&_nc_oc=AdpR_pXJK13S0BiaXpdwvaogb6-TW9iLOXgrQxOTnr50OifnBkWV6YcC_UZowHIo8L4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W_zRKbRPsLrc9w3mc9xee1LNy02Pp9b3HlJsZUKEsLQ&oe=6A4533CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FalloutCompany (1) (1).png", "id": "934020895331129", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982699_934020898664462_7369743272156524032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfws_ZWcfqkQ7kNvwGg_f5T&_nc_oc=AdpCIC6DNX6b2mq-RW9PfKISNbkVbBw3S9kELzbxUtxtAEzpqFaVGU6tX2hPftV3NoA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4gNHAQjPaAGZXgX4wEAVsUH_5S2WRYc6rPcie_664OQ&oe=6A452955"}, "display_name": "Fallout Company", "keywords": [], "long_description": "In \"Fallout Company,\" players embark on a thrilling adventure through eerie, post-apocalyptic environments where danger lurks around every corner. The game challenges players to navigate through abandoned buildings, dark forests, and desolate wastelands, all while scavenging for valuable loot. The tension rises as you delve deeper into these haunted territories, facing off against terrifying creatures and other unforeseen threats. Each location holds secrets and treasures that can either aid in your survival or lead to your doom. \"Fallout Company\" is not just about finding loot\u2014it's about overcoming fear, making strategic decisions, and ultimately surviving in a world where every step could be your last.", "short_description": "\"Fallout Company\" is a game where you venture into terrifying, desolate areas in search of valuable loot. As you explore these eerie environments, you'll face the constant threat of danger, whether from lurking creatures or hidden traps. The goal is to survive and collect as much loot as possible while navigating through dark, abandoned places that are filled with suspense and fear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privatepoilcy/home", "developer_terms_of_service_url": null, "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://sites.google.com/view/privatepoilcy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9126017174130291"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "933014303099794"}, {"status": "PUBLISHED", "id": "527060343042579"}]}, "baseline_offer": {"id": "933014303099794"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780621380, "status": "PUBLISHED", "id": "933014303099794"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24231066463198782", "version": "20.8"}, "id": "2730922740419171", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary
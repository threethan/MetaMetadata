: "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982526_9237048816334850_7076950713950590476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgmVzUwe4xwQ7kNvwHWqeiL&_nc_oc=AdqCMfvJ-KBRf-jknqG48Qi_Zyt5skQDGbkSCqlEVeYo_Wm9daWjl7Xf23wEhy6HK40&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IN5h1Safu0gpDv5xluEyVrEa3mZd6Cim9hNzwld-HsQ&oe=69D3B653"}, {"file_name": "file (23).png", "id": "1235453074413140", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001716_1235453077746473_28896472329125956_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STAW7PMBBYoQ7kNvwGdtPDU&_nc_oc=AdrBXjZoCX5H9cS9VFsMadTqS8eirjjVJMoze7EgkT3ygIKcyY1TmrsRzwbOp2bcJ_8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z9yu44QtsAAiYvWzBMCZ8m0pIAvVd19Fl3I4yEtd79w&oe=69D39C1F"}, {"file_name": "file (24).png", "id": "1622731945316713", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001662_1622731948650046_446425931297130046_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXn8quc7eTsQ7kNvwH2DWFi&_nc_oc=Adpz3TS0AiPYkmH6zO8hEw23qOtsMYg4b92qE8z53ZdRiCvHnCmKEEP_Ln7-7SFM978&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nEzhTNiVKda299Xj6tiG0FnXOSN2kQKau2FuiQzmnQg&oe=69D39A8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FalloutCompany (1) (1).png", "id": "934020895331129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_934020898664462_7369743272156524032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuCdl15ZU1IQ7kNvwF-i3LZ&_nc_oc=AdqdpQxhECHjicTxvQb6nl-XKxju1HzQdMM3m6M3Z9PQCt7Mmk649OOzI4gTW6In4cY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af36GhX5nCRU3x03PizSJtDIatz1msxJh26uL_bsDR7PxQ&oe=69D39015"}, "display_name": "Fallout Company", "keywords": [], "long_description": "In \"Fallout Company,\" players embark on a thrilling adventure through eerie, post-apocalyptic environments where danger lurks around every corner. The game challenges players to navigate through abandoned buildings, dark forests, and desolate wastelands, all while scavenging for valuable loot. The tension rises as you delve deeper into these haunted territories, facing off against terrifying creatures and other unforeseen threats. Each location holds secrets and treasures that can either aid in your survival or lead to your doom. \"Fallout Company\" is not just about finding loot\u2014it's about overcoming fear, making strategic decisions, and ultimately surviving in a world where every step could be your last.", "short_description": "\"Fallout Company\" is a game where you venture into terrifying, desolate areas in search of valuable loot. As you explore these eerie environments, you'll face the constant threat of danger, whether from lurking creatures or hidden traps. The goal is to survive and collect as much loot as possible while navigating through dark, abandoned places that are filled with suspense and fear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privatepoilcy/home", "developer_terms_of_service_url": null, "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://sites.google.com/view/privatepoilcy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9126017174130291"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "527060343042579"}]}, "bas
09&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKUoj-fmlV4Q7kNvwE0hhA6&_nc_oc=AdntLBla86VaGuhODoeCbn4-vwd1Rn7xczx983N5sba6G8NzkgADuU9JC4Rw45sgwK0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvL9quJbYj5uQ1gaUW3lKttwaz3zQ9J8YQm3nNQVC93KQ&oe=69A1A14F"}, {"file_name": "file (26).png", "id": "9237048806334851", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38982526_9237048816334850_7076950713950590476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bl4WU9W_GwIQ7kNvwGlup_M&_nc_oc=AdmTk1yTcax-t8Mu65f-JEnVqjZGumt2zJeepcxZLRd10Ws3F_2NgPpTKBaoP66gw3Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afs5MI9L4DAb0FrzDuY6La-qVLLUHG7-29xulc6VVK4anA&oe=69A19D53"}, {"file_name": "file (23).png", "id": "1235453074413140", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001716_1235453077746473_28896472329125956_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-n4NCzuBJYQ7kNvwGDMBSv&_nc_oc=AdkWsyOonIhxnQdK9HkOLQ62O4vN5FYFqHzwcCh7nRRk41Trts2TfNjGb5D3hSOdWi4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuPPRBcUW1bPo7cxLMZEbUPjazh4qiMpPieEAe3Io4GSw&oe=69A1831F"}, {"file_name": "file (24).png", "id": "1622731945316713", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001662_1622731948650046_446425931297130046_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sa3evxaUVcEQ7kNvwGRFFHR&_nc_oc=AdlCnlR9-7ME2O39PCHvp7Tuxrxfu5xN4IJeYAr0xN4xYIFH6ECWa0JbqhiYXtZ6jHM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsWQ4yXeLfnMI7MPvbemiOggMW-0jdGHNwk8IJPXKglqA&oe=69A1818B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FalloutCompany (1) (1).png", "id": "934020895331129", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982699_934020898664462_7369743272156524032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSWXRd-wUFwQ7kNvwGaxZsB&_nc_oc=AdnP8_RDNxiLD-nMNCc0JFEe_A652gArmoLbqrnMtiZ-euahW8pm7uKRNDWtb132-4U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsV0ySoWDWAh0C8FFO1sOrpRapv6YzkWpgRKskudoFEqQ&oe=69A17715"}, "display_name": "FalloutCompany", "keywords": [], "long_description": "In \"Fallout Company,\" players embark on a thrilling adventure through eerie, post-apocalyptic environments where danger lurks around every corner. The game challenges players to navigate through abandoned buildings, dark forests, and desolate wastelands, all while scavenging for valuable loot. The tension rises as you delve deeper into these haunted territories, facing off against terrifying creatures and other unforeseen threats. Each location holds secrets and treasures that can either aid in your survival or lead to your doom. \"Fallout Company\" is not just about finding loot\u2014it's about overcoming fear, making strategic decisions, and ultimately surviving in a world where every step could be your last.", "short_description": "\"Fallout Company\" is a game where you venture into terrifying, desolate areas in search of valuable loot. As you explore these eerie environments, you'll face the constant threat of danger, whether from lurking creatures or hidden traps. The goal is to survive and collect as much loot as possible while navigating through dark, abandoned places that are filled with suspense and fear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privatepoilcy/home", "developer_terms_of_service_url": null, "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://sites.google.com/view/privatepoilcy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCU
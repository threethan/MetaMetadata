09&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsqfsUg5t1sQ7kNvwFkrP_0&_nc_oc=Adke6ig0W4RqcvhXRhCT78ZRvPkuRAac1vFfkBqEPH_u1H0pttw4eaMRE1gAdIemYwU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsVRo8IUxZ0PUE7dPmTxzNOBoMVuFrlcUlJ-nYXO0bSDQ&oe=69A4444F"}, {"file_name": "file (26).png", "id": "9237048806334851", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982526_9237048816334850_7076950713950590476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bl4WU9W_GwIQ7kNvwEmhXTt&_nc_oc=AdkS3EuhBuvT5OVrFlffRUu5f6fQh-93Lus4r6xi6YZnuhzocCg__4GI9u2v7VKcFfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsiQPgxzbEvjUVikTNVEtMPgbY8WIDbLfW6K8jA2z18HQ&oe=69A44053"}, {"file_name": "file (23).png", "id": "1235453074413140", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001716_1235453077746473_28896472329125956_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxCV62GftVsQ7kNvwHL1Qmz&_nc_oc=AdkfWwlPFtnTS7lav7_jKcFS1C4ZW308aV5kAEm1dsLCTIEeeLdgvt0pT6Ws-5Rpunk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsMBtr_ono8THYaVNuxkANEENmkhKvFQp-B8SB8ZdiAOA&oe=69A4261F"}, {"file_name": "file (24).png", "id": "1622731945316713", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001662_1622731948650046_446425931297130046_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sa3evxaUVcEQ7kNvwHcjkvs&_nc_oc=AdkxwB5xWkvIjQBQreSGygxllAqxLjnAFSJ_oyAVmK4Y9VECM_2dZCxjUIEzjyJwzJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvwexlzw2FlJfQPQOT_PYfo5ISNufBnW2PDSFbfeGuGNw&oe=69A4248B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FalloutCompany (1) (1).png", "id": "934020895331129", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982699_934020898664462_7369743272156524032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRdGq46V3v0Q7kNvwFxV6Py&_nc_oc=Adn62Ymf83t5nZvuIJk-3bgtb2Bm1AKmyQRp1fGtM1ar319qE_KPlbhTsd85HLOx15s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftVia29ncqmXqEDUTOu_f-ReEz1YeOJvpybolJ-CrHcJQ&oe=69A41A15"}, "display_name": "FalloutCompany", "keywords": [], "long_description": "In \"Fallout Company,\" players embark on a thrilling adventure through eerie, post-apocalyptic environments where danger lurks around every corner. The game challenges players to navigate through abandoned buildings, dark forests, and desolate wastelands, all while scavenging for valuable loot. The tension rises as you delve deeper into these haunted territories, facing off against terrifying creatures and other unforeseen threats. Each location holds secrets and treasures that can either aid in your survival or lead to your doom. \"Fallout Company\" is not just about finding loot\u2014it's about overcoming fear, making strategic decisions, and ultimately surviving in a world where every step could be your last.", "short_description": "\"Fallout Company\" is a game where you venture into terrifying, desolate areas in search of valuable loot. As you explore these eerie environments, you'll face the constant threat of danger, whether from lurking creatures or hidden traps. The goal is to survive and collect as much loot as possible while navigating through dark, abandoned places that are filled with suspense and fear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privatepoilcy/home", "developer_terms_of_service_url": null, "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://sites.google.com/view/privatepoilcy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCU
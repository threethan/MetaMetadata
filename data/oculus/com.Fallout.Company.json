: "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982526_9237048816334850_7076950713950590476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MfVY5tlZNDEQ7kNvwEF5_eT&_nc_oc=Adqezz0YKdAhTaPBWQLCs2qZ0sLU5qfYFllTkI1EAP11hqAYDl054S05JZM3uy6M_C0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yGgfm_Od3H2o1stHzK_wLQmykCAQAv9AoOCsA-ZLHTg&oe=69E62B53"}, {"file_name": "file (23).png", "id": "1235453074413140", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001716_1235453077746473_28896472329125956_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yqlle84KdsQQ7kNvwGbRtLZ&_nc_oc=Adri7vgf-WKqZS4fyKPbHHfjDsSgq_4T1kM0D2iDv7nyEB8ReTUGF7tJo-QBgAHXfXk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VcMOLXMTu5HVibvUNz3zB7zeb8_10vRPfbwVTTIZvjQ&oe=69E6111F"}, {"file_name": "file (24).png", "id": "1622731945316713", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001662_1622731948650046_446425931297130046_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fsvPd0sCwtkQ7kNvwHFMD3H&_nc_oc=AdqQHHmyP5yBPM_I66ihv0TEnMW__wSnrQJ7gr5mBFvbIfzB54u88olxReiVKSWlW2c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3BniMNoCPV0VtRbaJraSpYUpnwoZpE0heQJ9I8DTigsg&oe=69E60F8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FalloutCompany (1) (1).png", "id": "934020895331129", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982699_934020898664462_7369743272156524032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6fIKzT5y2kQ7kNvwGEq6x3&_nc_oc=AdpB2HSxP7_SZLyarc4bZ6WWPY7CQV2-kuvahVkBX5re3mhZn8_V6kpAjACDg6P7vAs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3uxdgVe3_jJ5GbVabxKSaDwzLOlGCsrtRwRWnKj8uO2A&oe=69E63D55"}, "display_name": "Fallout Company", "keywords": [], "long_description": "In \"Fallout Company,\" players embark on a thrilling adventure through eerie, post-apocalyptic environments where danger lurks around every corner. The game challenges players to navigate through abandoned buildings, dark forests, and desolate wastelands, all while scavenging for valuable loot. The tension rises as you delve deeper into these haunted territories, facing off against terrifying creatures and other unforeseen threats. Each location holds secrets and treasures that can either aid in your survival or lead to your doom. \"Fallout Company\" is not just about finding loot\u2014it's about overcoming fear, making strategic decisions, and ultimately surviving in a world where every step could be your last.", "short_description": "\"Fallout Company\" is a game where you venture into terrifying, desolate areas in search of valuable loot. As you explore these eerie environments, you'll face the constant threat of danger, whether from lurking creatures or hidden traps. The goal is to survive and collect as much loot as possible while navigating through dark, abandoned places that are filled with suspense and fear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privatepoilcy/home", "developer_terms_of_service_url": null, "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://sites.google.com/view/privatepoilcy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9126017174130291"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "527060343042579"}]}, "bas
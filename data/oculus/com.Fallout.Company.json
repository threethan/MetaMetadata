: "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982526_9237048816334850_7076950713950590476_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAHwVDZQ3Z8Q7kNvwHtlRRQ&_nc_oc=AdpYrxfYqigzeJdRzqWNG8rHuSPtN4qnLrCgEb86SjoITOi4AGrcwAGXVNx5Chcn2d4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0mPd6HXwDzBOsZVQ9BT8wNyd_CPjUOony13IO2pB4r5Q&oe=69F35A53"}, {"file_name": "file (23).png", "id": "1235453074413140", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39001716_1235453077746473_28896472329125956_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubNU1ulhVH4Q7kNvwEUY0WN&_nc_oc=AdqNlajZnxdNnVevu6ZG7PiNUfjSe2iQGclTw5-UlSb5R563XWfEJ8pkW1dP7TPTruo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af282ZiGPK1bpC_QvoYGYdOU6FWL6Y9yJlyiOiv6LCJ-tw&oe=69F3401F"}, {"file_name": "file (24).png", "id": "1622731945316713", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001662_1622731948650046_446425931297130046_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA0MhZNIuT0Q7kNvwFIkbd8&_nc_oc=Adp7eA5x1ib4M7i-I57sWsA01fsKeI42eBcd0BhoDt8fkN4I8T26wwnOhDaPkhHBJeA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1XtnRY774J0KvEfNaSdwoESBi0ifx1XuUNTCP5liOMJw&oe=69F33E8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FalloutCompany (1) (1).png", "id": "934020895331129", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982699_934020898664462_7369743272156524032_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqqLn6KqPOkQ7kNvwG9-jSz&_nc_oc=AdoVWITVcVsTEbnt-rjIZmL8RBFtlE5F5tTqPaQUZgHbrqYaV03c-xbCUdlEV8A3eMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GxfaHUFlGqm_k02Ek8645o-TUPH3uoqbynwBKOJZ0ug&oe=69F36C55"}, "display_name": "Fallout Company", "keywords": [], "long_description": "In \"Fallout Company,\" players embark on a thrilling adventure through eerie, post-apocalyptic environments where danger lurks around every corner. The game challenges players to navigate through abandoned buildings, dark forests, and desolate wastelands, all while scavenging for valuable loot. The tension rises as you delve deeper into these haunted territories, facing off against terrifying creatures and other unforeseen threats. Each location holds secrets and treasures that can either aid in your survival or lead to your doom. \"Fallout Company\" is not just about finding loot\u2014it's about overcoming fear, making strategic decisions, and ultimately surviving in a world where every step could be your last.", "short_description": "\"Fallout Company\" is a game where you venture into terrifying, desolate areas in search of valuable loot. As you explore these eerie environments, you'll face the constant threat of danger, whether from lurking creatures or hidden traps. The goal is to survive and collect as much loot as possible while navigating through dark, abandoned places that are filled with suspense and fear."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/privatepoilcy/home", "developer_terms_of_service_url": null, "publisher_name": "Zuse", "support_website_url": null, "website_url": "https://sites.google.com/view/privatepoilcy/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9126017174130291"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "527060343042579"}]}, "bas
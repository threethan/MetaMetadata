n.com&_nc_ss=7f20f&oh=00_AQLcHjVCCPfyO33lQ8Od1uqPlD5XBL1zJGChH7YJcHWK3Q&oe=6AB282F4"}, {"file_name": "quest-home-cinema-island.png", "id": "1097347599339969", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_1097347602673302_7821188151393798613_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yNRXcmMRWRsQ7kNvwE8Pa7u&_nc_oc=AdpIUrZAPubZCocWui2u5iY81ixaZOGt2AVI9k6gFE4ydCBKKfNhDtlY9_fnyepl9ww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPatcOxww0Em3HNNiBiI5qiinAQeXOuMxzQHFJ5Fq_Iw&oe=6AB280FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CineVoid | VR Media Player", "keywords": ["mediaplayer", "plex", "virtualcinema", "jellyfin"], "long_description": "CineVoid turns your Meta Quest into a personal cinema for the media you already own.\n\nBrowse and stream movies and series from Plex, DLNA/UPnP media servers and Windows or NAS shares over SMB. Watch standard videos on a large adjustable screen, or switch to equirectangular 180\u00b0 and 360\u00b0 projection. Side-by-side and top-bottom stereoscopic video are also supported.\n\nQuest-friendly controls provide quick access to seeking, play and pause, screen positioning, projection modes, audio tracks and customizable subtitles. Continue Watching and Favorites help you quickly return to your media.\n\nCineVoid supports common video formats available on Meta Quest, with additional software audio decoding for formats including DTS, DTS-HD and Dolby TrueHD. It can also open supported unencrypted Blu-ray/DVD ISO or IMG images and non-password-protected RAR archives without extracting a second full copy.\n\nYour media streams directly between your own server and headset. CineVoid contains no advertising, analytics or developer-operated account service.\n\nCineVoid requires your own compatible media source. Commercially encrypted discs, original disc menus, password-protected RAR archives and Dolby Atmos/DTS:X object-audio rendering are not supported. Codec performance may depend on the Quest model, resolution, profile and bitrate.", "short_description": "Watch your own videos in a customizable VR cinema. Stream from Plex, DLNA and SMB, with support for flat, curved, 180\u00b0, 360\u00b0 and 3D video, selectable audio and subtitles, and supported Blu-ray/DVD images and RAR archives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baldandboldstudios.online/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Bald and Bold Studios", "support_website_url": "https://baldandboldstudios.online/support/", "website_url": "https://baldandboldstudios.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "de", "fr", "es", "it", "pt", "pl", "ru", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1199393983267429"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2188588715036867"}]}, "baseline_offer": {"id": "2188588715036867"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789583640, "status": "PUBLISHED", "id": "2188588715036867"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1222667130940114", "version": "0.11.40"}, "id": "1367495511767752", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1222667130940114"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1367495511767752"}]}, "change_log": "Hand tracking: browse, open files and control playback by pointing\n  and pinching, without controllers.\nPinching at empty space shows or hides the playback controls, so the\n  console is reachable with hands alone.\nThumb microgestures skip through a film and walk you towards the\n  cinema screen.\nPlayback resumes where you left off after closing the app or taking\n  the headset off.\nThe cloud storage tab is hidden until sign-in for a provider is\n  available.", "created_date": 1789640655, "id": "1222667130940114", "version": "0.11.40", "version_code": 195, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1222667130940114"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1367495511767752"}]}, "change_log": null, "created_date": 1789468738, "id": "1218856807987813", "version": "0.11.39", "version_code": 176, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": fal
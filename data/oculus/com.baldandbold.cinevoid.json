ntent-ord5-2.oculuscdn.com/v/t64.5771-25/491825546_1089609383613180_9132560401093879879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LUXDL3TFxUQ7kNvwEW5XIy&_nc_oc=Adq3O-WzunyQ8TjNzhk9MAgno1F7qkLWBqF6EvOeE1tJTcE3im3R7R0ul-k89F9BUqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbm86NQwrz4wPnEe719-uLcwU7cvlCuLvmYNkVTTvy_g&oe=6ABFB1F4"}, {"file_name": "quest-home-cinema-island.png", "id": "1097347599339969", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1097347602673302_7821188151393798613_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eYVo3pmAl8Q7kNvwGkSPYL&_nc_oc=Adq-0CEklQ2TvVYXzlao2v1utEQSiAXTiuHbaM5yOmVvO9zgfOhCVpGC-lKnI0ZRa7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxaj__wNJjrQe91gSfr07FLot1-w0wqBKEihEUH8ukHg&oe=6ABFAFFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CineVoid | VR Media Player", "keywords": ["media", "video", "3d", "vr", "player"], "long_description": "CineVoid turns your Meta Quest into a personal cinema for the media you already own.\n\nBrowse and stream movies and series from Plex, DLNA/UPnP media servers and Windows or NAS shares over SMB. Watch standard videos on a large adjustable screen, or switch to equirectangular 180\u00b0 and 360\u00b0 projection. Side-by-side and top-bottom stereoscopic video are also supported.\n\nQuest-friendly controls provide quick access to seeking, play and pause, screen positioning, projection modes, audio tracks and customizable subtitles. Continue Watching and Favorites help you quickly return to your media.\n\nCineVoid supports common video formats available on Meta Quest, with additional software audio decoding for formats including DTS, DTS-HD and Dolby TrueHD. It can also open supported unencrypted Blu-ray/DVD ISO or IMG images and non-password-protected RAR archives without extracting a second full copy.\n\nYour media streams directly between your own server and headset. CineVoid contains no advertising, analytics or developer-operated account service.\n\nCineVoid requires your own compatible media source. Commercially encrypted discs, original disc menus, password-protected RAR archives and Dolby Atmos/DTS:X object-audio rendering are not supported. Codec performance may depend on the Quest model, resolution, profile and bitrate.", "short_description": "Watch your own videos in a customizable VR cinema. Stream from Plex, DLNA and SMB, with support for flat, curved, 180\u00b0, 360\u00b0 and 3D video, selectable audio and subtitles, and supported Blu-ray/DVD images and RAR archives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baldandboldstudios.online/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Bald and Bold Studios", "support_website_url": "https://baldandboldstudios.online/support/", "website_url": "https://baldandboldstudios.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "de", "fr", "es", "it", "pt", "pl", "ru", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1232984953241665"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821704_1509953751148103_8370884374119975880_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00qqpnbuhiIQ7kNvwHXOM9B&_nc_oc=AdoiFLrx2NGxbja8F-JYsZMBXcfz4uhD4dMR7Az__KBRs2PmpJ0qByAZsTU8itYgfoM&_nc_zt=3&_nc_ht
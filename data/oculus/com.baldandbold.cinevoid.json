6AC254F4"}, {"file_name": "quest-home-cinema-island.png", "id": "1097347599339969", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_1097347602673302_7821188151393798613_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgyeeVT0epgQ7kNvwFK9QVF&_nc_oc=AdrzQfcNlDqKuH-2UYBMpJTZ146T7Y6nhMmpqr10-dTK7wSnegWdRopHrqBjhuuG5PE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdPetSF3aAPL63vfy2JAZjWZpF_ebJIxPQXH7cvW5YsA&oe=6AC252FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CineVoid | VR Media Player", "keywords": ["mediaplayer", "plex", "virtualcinema", "jellyfin"], "long_description": "CineVoid turns your Meta Quest into a personal cinema for the media you already own.\n\nBrowse and stream movies and series from Plex, DLNA/UPnP media servers and Windows or NAS shares over SMB. Watch standard videos on a large adjustable screen, or switch to equirectangular 180\u00b0 and 360\u00b0 projection. Side-by-side and top-bottom stereoscopic video are also supported.\n\nQuest-friendly controls provide quick access to seeking, play and pause, screen positioning, projection modes, audio tracks and customizable subtitles. Continue Watching and Favorites help you quickly return to your media.\n\nCineVoid supports common video formats available on Meta Quest, with additional software audio decoding for formats including DTS, DTS-HD and Dolby TrueHD. It can also open supported unencrypted Blu-ray/DVD ISO or IMG images and non-password-protected RAR archives without extracting a second full copy.\n\nYour media streams directly between your own server and headset. CineVoid contains no advertising, analytics or developer-operated account service.\n\nCineVoid requires your own compatible media source. Commercially encrypted discs, original disc menus, password-protected RAR archives and Dolby Atmos/DTS:X object-audio rendering are not supported. Codec performance may depend on the Quest model, resolution, profile and bitrate.", "short_description": "Watch your own videos in a customizable VR cinema. Stream from Plex, DLNA and SMB, with support for flat, curved, 180\u00b0, 360\u00b0 and 3D video, selectable audio and subtitles, and supported Blu-ray/DVD images and RAR archives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baldandboldstudios.online/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Bald and Bold Studios", "support_website_url": "https://baldandboldstudios.online/support/", "website_url": "https://baldandboldstudios.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "de", "fr", "es", "it", "pt", "pl", "ru", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1199393983267429"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2188588715036867"}]}, "baseline_offer": {"id": "2188588715036867"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789583640, "status": "PUBLISHED", "id": "2188588715036867"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1241848112355349", "version": "0.12.11"}, "id": "1367495511767752", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1241848112355349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1367495511767752"}]}, "change_log": "0.12.11\nBuilt-in browser\n- Added a browser with address/search, bookmarks, saved website sessions and fullscreen video.\n- Added YouTube, Prime Video and other website shortcuts, plus custom shortcuts you can add, edit and remove.\n- Added larger controls, a bottom navigation bar and accessible screen settings.\n- Added flat and curved screens with adjustable size, height, distance and text scaling.\n- Added grip-to-move, thumbstick scrolling, grip + thumbstick distance adjustment and B/Y back navigation.\n- Added Panorama, Home Cinema, Dark and Passthrough environments.\n- Browser playback in Home Cinema now uses the cinema\u2019s fixed flat screen, while keeping viewing-distance adjustment available.\n- Improved text clarity, curved-screen rendering and controller interaction with website menus.\n- Fixed missing pointers and interaction with distant screens.\n- Improved menu closing and scrolling.\n- Overlay buttons now hide after three seconds of inactivity and return when you interact.\n- Enabled protected-media permission automatically for HTTPS websites and added configurable third-party cookie support.\n- Switching between browser and native playback stops the previous source.\nPlayback and audio\n- Added a native Dolby Digital Plus Atmos audio route on compatible Quest decoders.\n- Added spatial surround output that preserves multichannel Dolby, DTS and TrueHD audio.\n- Fixed unstable surround orientation that could make dialogue jump between left and right.\n- Added separate source-codec and audio-output labels.\n- Removed unnecessary playback restarts when changing spatial audio, screen size, curvature, aspect ratio, ordinary stereo layouts and subtitle timing.\n- Improved DivX/XviD AVI playback and reduced stalls caused by history saving and repeated thumbnail attempts.\n- Fixed stale frames when switching files and improved cleanup after playback errors.\n- Added fallback thumbnails and resolution labels for AVI, FLV and MPEG-PS files.\n- Removed unsupported WMV/ASF files from the explorer.\nPlex and libraries\n- Added Plex Home profiles with avatars, PIN protection and switching without relinking.\n- Added optional profile selection whenever Plex opens, with separate local history and favorites per profile.\n- Fixed Next, Previous and automatic advancement to stay within the same Plex series, including across seasons.\n- Added Mark as watched / unwatched to Plex details.\n- Added draggable scrollbars to library grids and home/search results.\nScreens and positioning\n- Increased curved-screen sizing to 600%, with curvature scaling alongside screen size.\n- Free flat and curved screens now tilt toward your viewing position when moved, with subtitles following their orientation.\n- Fixed unwanted automatic recentering and unexpected startup repositioning.\n- Improved screen alignment from side seats and screen/menu positioning when reclining.\nmacOS SMB\n- Added support for complete SMB addresses and direct access to shared folders and subfolders.\n- Improved access when automatic share discovery fails.\n- Added clearer Mac setup guidance and connection feedback.", "created_date": 1790605699, "id": "1241848112355349", "version": "0.12.11", "version_code": 266, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1241848112355349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790533609, "id": "1240522349154592", "version": "0.11.96", "version_code": 251, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1241848112355349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790264963, "id": "1235268626346631", "version": "0.11.93", "version_code": 248, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1241848112355349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790175487, "id": "1233539356519558", "version": "0.11.91", "version_code": 246, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1241848112355349"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1367495511767752"}]}, "change_log": "Fixed Next, Previous and autoplay failures caused by rebuilding the video surface between files.\r\nAdded an integrated Headset file explorer, starting at shared storage and styled like the SMB browser.\r\nBrowse videos, ISO/IMG disc images, RAR releases and images without saved-folder entries or the system file picker.\r\nAdded improved AVI and WMV thumbnails and video resolution labels such as 1920 \u00d7 1080.\r\nAdded image support for JPG, PNG, WebP, BMP, GIF, HEIC/HEIF and AVIF, including previews and resolution information.\r\nImages open on a dedicated cinema panel with correct aspect ratio and EXIF orientation.\r\nPrevious and Next navigate between images in the same folder.\r\nReduced brief MVC 3D Blu-ray stutters at seamless clip boundaries by reusing the active decoder.\r\nAdded an optional, non-intrusive Meta Store review prompt after successful use.", "created_date": 1790017616, "id": "1230564123483748", "version": "0.11.88", "version_code": 243, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
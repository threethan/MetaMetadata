0ZRa7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxaj__wNJjrQe91gSfr07FLot1-w0wqBKEihEUH8ukHg&oe=6ABFAFFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CineVoid | VR Media Player", "keywords": ["mediaplayer", "plex", "virtualcinema", "jellyfin"], "long_description": "CineVoid turns your Meta Quest into a personal cinema for the media you already own.\n\nBrowse and stream movies and series from Plex, DLNA/UPnP media servers and Windows or NAS shares over SMB. Watch standard videos on a large adjustable screen, or switch to equirectangular 180\u00b0 and 360\u00b0 projection. Side-by-side and top-bottom stereoscopic video are also supported.\n\nQuest-friendly controls provide quick access to seeking, play and pause, screen positioning, projection modes, audio tracks and customizable subtitles. Continue Watching and Favorites help you quickly return to your media.\n\nCineVoid supports common video formats available on Meta Quest, with additional software audio decoding for formats including DTS, DTS-HD and Dolby TrueHD. It can also open supported unencrypted Blu-ray/DVD ISO or IMG images and non-password-protected RAR archives without extracting a second full copy.\n\nYour media streams directly between your own server and headset. CineVoid contains no advertising, analytics or developer-operated account service.\n\nCineVoid requires your own compatible media source. Commercially encrypted discs, original disc menus, password-protected RAR archives and Dolby Atmos/DTS:X object-audio rendering are not supported. Codec performance may depend on the Quest model, resolution, profile and bitrate.", "short_description": "Watch your own videos in a customizable VR cinema. Stream from Plex, DLNA and SMB, with support for flat, curved, 180\u00b0, 360\u00b0 and 3D video, selectable audio and subtitles, and supported Blu-ray/DVD images and RAR archives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baldandboldstudios.online/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Bald and Bold Studios", "support_website_url": "https://baldandboldstudios.online/support/", "website_url": "https://baldandboldstudios.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "de", "fr", "es", "it", "pt", "pl", "ru", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1199393983267429"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2188588715036867"}]}, "baseline_offer": {"id": "2188588715036867"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789583640, "status": "PUBLISHED", "id": "2188588715036867"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1230564123483748", "version": "0.11.88"}, "id": "1367495511767752", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1230564123483748"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790533609, "id": "1240522349154592", "version": "0.11.96", "version_code": 251, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1230564123483748"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790264963, "id": "1235268626346631", "version": "0.11.93", "version_code": 248, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1230564123483748"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790175487, "id": "1233539356519558", "version": "0.11.91", "version_code": 246, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1230564123483748"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1367495511767752"}]}, "change_log": "Fixed Next, Previous and autoplay failures caused by rebuilding the video surface between files.\r\nAdded an integrated Headset file explorer, starting at shared storage and styled like the SMB browser.\r\nBrowse videos, ISO/IMG disc images, RAR releases and images without saved-folder entries or the system file picker.\r\nAdded improved AVI and WMV thumbnails and video resolution labels such as 1920 \u00d7 1080.\r\nAdded image support for JPG, PNG, WebP, BMP, GIF, HEIC/HEIF and AVIF, including previews and resolution information.\r\nImages open on a dedicated cinema panel with correct aspect ratio and EXIF orientation.\r\nPrevious and Next navigate between images in the same folder.\r\nReduced brief MVC 3D Blu-ray stutters at seamless clip boundaries by reusing the active decoder.\r\nAdded an optional, non-intrusive Meta Store review prompt after successful use.", "created_date": 1790017616, "id": "1230564123483748", "version": "0.11.88", "version_code": 243, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1199393973267430", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1230564123483748"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1367495511767752"}]}, "change_log": "CineVoid 0.11.83 \u2013 Update Summary\n- Plex, Jellyfin, and Emby: Multipart movies now play sequentially, support manual part selection, and resume across all parts.\n- 3D Blu-ray/MVC: Improved real stereoscopic playback, seeking, chapters, resume, and audio/video synchronization.\n- MVC MKV: MakeMKV-style 3D MKV files now play in real MVC 3D.\n- Frame-Sequential 3D: Added FS3D playback, left/right ordering, seeking, and support for files without declared frame rates.\n- 3D subtitles: Paired SBS PGS subtitles are combined into one centered subtitle.\n- Stability: Fixed the hard crash caused by retained MVC buffers after repeatedly opening or restarting a movie.\n- Network playback: Improved SMB/RAR buffering and recovery from interrupted SMB connections.\n- Picture quality: Updated to Spatial SDK 0.14, enabled the highest compositor quality, four-tap supersampling, improved VR180 projection, and corrected Rec.709 output for SDR and tone-mapped HDR/Dolby Vision.\n- Live picture controls: Brightness, contrast, saturation, and hue now update without restarting playback.\n- Screen controls: Screens can be positioned from 0.55 to 20 metres away and scaled from 25% to 600%.\n- Lens controls: Lens Off restores the original projection, and obsolete 3D errors are cleared after switching modes.\n- Synchronized startup: Audio waits until the corresponding video frame is ready after starting, resuming, or seeking.\n- Blu-ray metadata: Audio and subtitle languages, movie titles, and chapter names are read from disc metadata when available.\n- Player controls: Every icon now shows its name on hover. Hands remain hidden while watching, and controller tracking recovers correctly.\n- Low-light use: CineVoid can launch without positional tracking, allowing use in dark rooms.\n- Headset files: Previously selected videos and disc images can be reopened directly through Saved files.\n", "created_date": 1789903498, "id": "1228183017055192", "version": "0.11.83", "version_code": 238, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
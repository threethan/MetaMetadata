ntent-iad6-1.oculuscdn.com/v/t64.5771-25/491825546_1089609383613180_9132560401093879879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LUXDL3TFxUQ7kNvwGVoWy7&_nc_oc=AdqhDY-JTfXw_ugD4twtgdup2DKjkFp2MvguaktzgMovG1iIcrqAiQGoMn550KlT2R0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzhgExEWcsT9MKIOX2uv3oI1fcZm5lei1UreJRwdSnFg&oe=6AC254F4"}, {"file_name": "quest-home-cinema-island.png", "id": "1097347599339969", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824307_1097347602673302_7821188151393798613_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bgyeeVT0epgQ7kNvwFK9QVF&_nc_oc=AdrzQfcNlDqKuH-2UYBMpJTZ146T7Y6nhMmpqr10-dTK7wSnegWdRopHrqBjhuuG5PE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdPetSF3aAPL63vfy2JAZjWZpF_ebJIxPQXH7cvW5YsA&oe=6AC252FB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CineVoid VR Media Player", "keywords": ["media", "video", "3d", "vr", "player"], "long_description": "# Your personal VR cinema\n\nEnjoy your movies, series and web video in CineVoid on Meta Quest.\n\n# Connect your media\n\nStream from **Plex, Jellyfin, Emby, DLNA/UPnP, SMB and WebDAV**, or play supported files from your headset and USB drives. **Continue Watching** and **Favorites** keep your media within reach.\n\n# Shape your experience\n\nChoose an adjustable **flat or curved screen**, explore **180\u00b0 and 360\u00b0 video**, or watch compatible **side-by-side and top-bottom 3D**.\n\n# Browse and watch\n\nUse the **built-in browser** to visit video websites, sign in and save shortcuts. Enjoy a flat or curved browser screen in your cinema environment.\n\nWebsite features, playback quality and compatibility vary by service. Subscriptions may be required.\n\n# Playback your way\n\n- Selectable audio tracks and customizable subtitles\n- Playback speed and audio/subtitle timing controls\n- Spatial surround for compatible multichannel tracks\n- Software decoding for **DTS, DTS-HD and Dolby TrueHD**\n- Supported **unencrypted Blu-ray/DVD ISO/IMG images and RAR archives**, without extracting a second full copy\n\n# Good to know\n\nCineVoid has no advertising SDK, analytics or account system of its own. Websites may display ads and follow their own privacy policies.\n\nNo content or subscriptions are included. Encrypted discs, original disc menus and password-protected RAR archives are unsupported. Playback depends on the media format and Quest model.", "short_description": "Turn your Meta Quest into a personal cinema for movies, series and web video. Stream from Plex, Jellyfin, Emby, DLNA, SMB and WebDAV, or play media from your headset and USB drives. Enjoy adjustable flat or curved screens, 180\u00b0/360\u00b0 and 3D video, spatial surround, selectable audio and customizable subtitles. Browse video websites with the built-in browser, and open supported unencrypted Blu-ray/DVD images and RAR archives.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://baldandboldstudios.online/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Bald and Bold Studios", "support_website_url": "https://baldandboldstudios.online/support/", "website_url": "https://baldandboldstudios.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "de", "fr", "es", "it", "pt", "pl", "ru", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1241751182365042"}, "revie
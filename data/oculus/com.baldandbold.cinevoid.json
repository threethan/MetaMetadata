3783_1408531988094483_17020399909920807_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZNdMoFIWZYQ7kNvwFUbvzq&_nc_oc=AdoaK0b1qd5D1fMqjsYfci_yo1pQhmZvGITKLYnXZR03b4MHR14M987QAKQbcnFlevs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4dFh6xoK9Z-iieupF5xmtuUuUcexQDvxtUsgGQeSMjw&oe=6AB68553"}, {"file_name": "quest-library.png", "id": "1089609376946514", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491825546_1089609383613180_9132560401093879879_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8e3c5Jf0YnYQ7kNvwF6T3j9&_nc_oc=Adr1crU1JPVG7Btmk22uBhg6m93o_p5a_R02hdpa1xoG_xdvFakunDBNYLmlC4uuKP0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyit3e8a2bSALa0kbpvCgLaA2xnLq6zQIXtQj07r5gCQ&oe=6AB67774"}, {"file_name": "quest-home-cinema-island.png", "id": "1097347599339969", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491824307_1097347602673302_7821188151393798613_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEhqbfCwrjwQ7kNvwHDU6BH&_nc_oc=AdoVfpZO6eBExQUUREsu9GD8cGVfhvX9CUekA8fcGJ_ZCBw9izS7TQvxHZ614F9-1rA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTB0vphcc3pfVEaPbVSfMJWdpqbA0G00s5a0Kq-vXoJg&oe=6AB6757B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CineVoid | VR Media Player", "keywords": ["mediaplayer", "plex", "virtualcinema", "jellyfin"], "long_description": "CineVoid turns your Meta Quest into a personal cinema for the media you already own.\n\nBrowse and stream movies and series from Plex, DLNA/UPnP media servers and Windows or NAS shares over SMB. Watch standard videos on a large adjustable screen, or switch to equirectangular 180\u00b0 and 360\u00b0 projection. Side-by-side and top-bottom stereoscopic video are also supported.\n\nQuest-friendly controls provide quick access to seeking, play and pause, screen positioning, projection modes, audio tracks and customizable subtitles. Continue Watching and Favorites help you quickly return to your media.\n\nCineVoid supports common video formats available on Meta Quest, with additional software audio decoding for formats including DTS, DTS-HD and Dolby TrueHD. It can also open supported unencrypted Blu-ray/DVD ISO or IMG images and non-password-protected RAR archives without extracting a second full copy.\n\nYour media streams directly between your own server and headset. CineVoid contains no advertising, analytics or developer-operated account service.\n\nCineVoid requires your own compatible media source. Commercially encrypted discs, original disc menus, password-protected RAR archives and Dolby Atmos/DTS:X object-audio rendering are not supported. Codec performance may depend on the Quest model, resolution, profile and bitrate.", "short_description": "Watch your own videos in a customizable VR cinema. Stream from Plex, DLNA and SMB, with support for flat, curved, 180\u00b0, 360\u00b0 and 3D video, selectable audio and subtitles, and supported Blu-ray/DVD images and RAR archives."}]}, "developer_name": null, "developer_privacy_policy_url": "https://baldandboldstudios.online/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Bald and Bold Studios", "support_website_url": "https://baldandboldstudios.online/support/", "website_url": "https://baldandboldstudios.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "nl", "de", "fr", "es", "it", "pt", "pl", "ru", "ja", "ko", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "us
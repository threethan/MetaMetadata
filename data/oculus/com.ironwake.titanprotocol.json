r_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1106638621943975", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307444_1106638628610641_3741984909631149463_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge5yUKUOdjsQ7kNvwEFEftu&_nc_oc=AdrXCxnIcqOKSBLYEMe243tDt1I6KYsR2w6I-juJCRCX00XRPs13poctPaa3hSakYys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4Uwd6XQakmObU_0YaCfdHLrscJCmCBP3Q7UPtaguKfw&oe=6AFDB882"}, "display_name": "Iron Wake Titan Protocol", "keywords": ["mech", "robot", "cockpit"], "long_description": "IRON WAKE: Titan Protocol puts you in the pilot seat of a battle-scarred combat mech. Everything happens from inside the cockpit: grab the control levers, watch your radar, track incoming fire and bring down machines many times your size.\n\nNINE-MISSION CAMPAIGN\nFight your way from the Iron Dawn industrial yard to the final Titan Protocol assault on the citadel. Each operation takes place in its own large battlefield: forest, canyon, city, snowfields, temple ruins, a power plant, a night harbor and a fortified citadel.\n\nMISSIONS WITH REAL OBJECTIVES\nDefend a relay through waves of attacks, recover energy cores in a blizzard, activate beacons in sequence under fire, and survive seven-wave sieges. Clear the sector, then reach the extraction platform to win.\n\nGIANT BOSSES\nEvery two missions a colossal enemy arrives: an iron T-Rex, a four-legged colossus, a six-legged steel spider and more. Bosses fire missile salvos that grow stronger as they take damage.\n\nA COCKPIT THAT FEELS LIKE A MACHINE\nDrive and turn with physical control levers or use the thumbsticks. Fire the autocannon, the railgun and rockets, boost out of danger, and shoot down incoming missiles before they hit. Your canopy glass cracks under fire and can be repaired in the field.\n\nUPGRADE YOUR MECH\nEarn points for every victory and spend them in the hangar on cannon, rocket, mobility and armor upgrades. Replay completed missions to beat your best times and earn more.\n\n", "short_description": "Pilot a heavy combat mech from inside its cockpit. Fight through nine missions across industrial yards, frozen wastes, burning cities and a night harbor, face colossal machine bosses, and upgrade your war machine between sorties."}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/EW3tmUyy8wxyg1N9hik7Wy", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/EW3tmUyy8wxyg1N9hik7Wy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1147063957759706"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313058_1872997440713509_8132293376801787999_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0HX3kGjLIoQ7kNvwEAyaOH&_nc_oc=AdpuOkoGlHl9wbSMdU4nE6ddVn9WE6unf2KxsPcb6C_zcn2IvqfgTjcbgk77ANHrqaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbSITBWwNdmABtDyhixDrqPPIPZ5F0MRdP7u3oECTBKg&oe=6AFDB89D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Iron Wake Titan Protocol", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES
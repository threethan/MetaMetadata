13846142810837209_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_jC3Bv5X-IQ7kNvwGImeh5&_nc_oc=Adrqur8iKL90tgil1K4uRFEUUqmxDAPj_zsbj5PNjJ3P4HyG31aWY9CbUmO_kPw8jPg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaML1qKpPm2_Y_OgEyir9-SSbRa5gkSHorJ8FAYzWvEQ&oe=6AFC7B73"}, {"file_name": "3.png", "id": "428945850034499", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031650_428945853367832_7503104716343309904_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srlVoGNNWxcQ7kNvwHmWixr&_nc_oc=AdohmBuzb4goojGop67cryFlPDBAOm3azwTbt8nE5CbXNlew9u_7wIjcZ5ZEHPWiwds&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtewsxaXqjXnUEmyqqhvcJYnpRXBL7Zm6x3XI7j6iGDQ&oe=6AFC7D52"}, {"file_name": "1.png", "id": "1084874436108566", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001662_1084874439441899_1847416636135791525_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcYHjw7v_pcQ7kNvwFTJ0Ck&_nc_oc=AdqvtEL45XmugjbXcgznHfAQTDyvadYroHX5L1HD-LgCY3XhidH0F0orG04piS6YRvI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlsYeivBVZ_ZtScZJoS2DNiYDEfuiG8GDuMcDqTGgihg&oe=6AFC8E7B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image Accelerate.png", "id": "596964202857057", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031551_596964206190390_8913572935597900513_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_Ak5vyg664Q7kNvwESlm8J&_nc_oc=Adru6acgutFqG8pX1FGZr1q5O4Z0kN1dTzPmbL9xTOo5xCLmL_sB7sXvMVXT4Hz-ECE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlk89r9pDu87Erkyy002JidS20h-757iasnPZf4HmvjQ&oe=6AFC6ECC"}, "display_name": "Accelerate", "keywords": ["Accelerate", "Laboratory", "Fourplus", "CellTherapy", "Bioscience"], "long_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  \n\nAccelerate gives learners the opportunity to experience industry-relevant settings, bioproduction laboratories and clean rooms. In addition, the spillage training applies context to cell and gene transplants within a healthcare facility.  \n\nRemove barriers to high-stakes training and increase workforce competency with Accelerate.  ", "short_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
/39031650_428945853367832_7503104716343309904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lAgaqIqZ2cQ7kNvwFh2x7d&_nc_oc=AdoDEny_U984V_BfBtou5Y41WkMXL1Cio2-nUhdnO0I6JzRVp-QQl_25YQxbGx-d0yg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSDNW6JckYenHt_58cPf1WAZLB8_Hils9DwStrUnPViw&oe=6AEA0852"}, {"file_name": "1.png", "id": "1084874436108566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001662_1084874439441899_1847416636135791525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c68duZE05N8Q7kNvwFE7isB&_nc_oc=Adp7iMgdCk_cAUMSPjxjt6P8sFlRwh5PwuJtk2bzWE7goaZXbu9-7PXuV7-REEpysG4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgLGUn0VSRJHev_sitSNxw4gky6s2wh-uXQc8fgPLygA&oe=6AE9E13B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnailforAccelerate_temp_2.png", "id": "1657469835145238", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982492_1657469838478571_4205052966596679185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ykdp6Pbh_YQ7kNvwHwtwlG&_nc_oc=AdplbAexhrz_SeVGlyzvD3zWygr4q1u5LDcTN1FJfXHZexaU_RfUiKw7utR4RmOsrn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfsQ69KIrAO8n_jWzVGPXlyuAlYPBFO_hZVmITKLCK6Q&oe=6AEA0ED2"}, "display_name": "Accelerate", "keywords": ["Accelerate", "Laboratory", "Fourplus", "CellTherapy", "Bioscience"], "long_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  \n\nAccelerate gives learners the opportunity to experience industry-relevant settings, bioproduction laboratories and clean rooms. In addition, the spillage training applies context to cell and gene transplants within a healthcare facility.  \n\nRemove barriers to high-stakes training and increase workforce competency with Accelerate.  ", "short_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/accelerate-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9188422801221850"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1330903001396213"}, {"status": "PUBLISHED", "id": "1462122827810414"}]}, "baseline_offer": {"id": "1330903001396213"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739368080, "status": "PUBLISHED", "id": "133090300
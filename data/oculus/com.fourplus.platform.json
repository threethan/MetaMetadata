13846142810837209_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_jC3Bv5X-IQ7kNvwEg8xQb&_nc_oc=Adop68_rKLN5KDPy10SwjAE5hACc3fAAlk0Q3OhDyTet19_89_BO6W3G3PI1nfAlPx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJo1Omi3Hd7jTLxXbcRkzXwfL0fa0fv8DYN3PbjrfZmg&oe=6AFDCCF3"}, {"file_name": "3.png", "id": "428945850034499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031650_428945853367832_7503104716343309904_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tT7MjKwRqAgQ7kNvwGgTeCv&_nc_oc=AdrXW0RRxxmHzYuOeDpECh5tOrTonoXkM8GoSxYNxYu5Hhsub0NjSOYraG7B7jKQwpM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXK6YJnW_KSnFqTEcWnDxxhiloJKtMORf2SDY4QYcb_Q&oe=6AFDCED2"}, {"file_name": "1.png", "id": "1084874436108566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001662_1084874439441899_1847416636135791525_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhZhfKuaf_oQ7kNvwGK9OTF&_nc_oc=AdrNF_bT4MbGE0zrSQB5wZj1zU-ygGH9FrcjFPo8m40JICE3zpRPGvXVILpFoOHFtsE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-xTgXeLeNA8ibaBL6-GtFs-1qWc3Y_XyC0c8U2tauEA&oe=6AFDDFFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image Accelerate.png", "id": "596964202857057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031551_596964206190390_8913572935597900513_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7qKwMGRWv0Q7kNvwH6AN2p&_nc_oc=AdrZKztxb8X3qS-y7K0Zxglmo2ffH3PwL3yeFHkBFC6j_Uel3l7asuhDjeJVxUBMyl0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2KImKNYx1SxOnOY3jdAcR5eFc8D8dKJCHSff8asrgBw&oe=6AFDC04C"}, "display_name": "Accelerate", "keywords": ["Accelerate", "Laboratory", "Fourplus", "CellTherapy", "Bioscience"], "long_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  \n\nAccelerate gives learners the opportunity to experience industry-relevant settings, bioproduction laboratories and clean rooms. In addition, the spillage training applies context to cell and gene transplants within a healthcare facility.  \n\nRemove barriers to high-stakes training and increase workforce competency with Accelerate.  ", "short_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_la
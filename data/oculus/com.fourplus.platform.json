99_1847416636135791525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mz-XofQO3wQ7kNvwEwAi3Z&_nc_oc=AdoOXD1sehZ3CwWzHb6MVM1VdEdCX9ANBS8kcYcU7-NVWH-jmhtQC7khm0WdO4TyZGo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgjm-xGKvFjtLqc5ObLn159XFsmpHMzHcLnS1yGkWo5g&oe=6A64B9BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoThumbnailforAccelerate_temp_2.png", "id": "1657469835145238", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982492_1657469838478571_4205052966596679185_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFLmGQwQsq8Q7kNvwEndw-x&_nc_oc=Ado-c17Talgrb73P4u2RrTiajCiaUpU7KjqLyzBSg0syFAGBYDHL8Ujvekfo4dY-b9s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSqD4A3cgnYPRbL1rPb96TfXl3-UC4cy-j57nyDBUwIQ&oe=6A64AF12"}, "display_name": "Accelerate", "keywords": ["Accelerate", "Laboratory", "Fourplus", "CellTherapy", "Bioscience"], "long_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  \n\nAccelerate gives learners the opportunity to experience industry-relevant settings, bioproduction laboratories and clean rooms. In addition, the spillage training applies context to cell and gene transplants within a healthcare facility.  \n\nRemove barriers to high-stakes training and increase workforce competency with Accelerate.  ", "short_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/accelerate-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9188422801221850"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1330903001396213"}, {"status": "PUBLISHED", "id": "1462122827810414"}]}, "baseline_offer": {"id": "1330903001396213"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739368080, "status": "PUBLISHED", "id": "1330903001396213"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26271333125837551", "version": "0.1.9"}, "id": "2034292766996142", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9188422791221851", "is_co
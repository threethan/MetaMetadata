com&_nc_ss=7f20f&oh=00_AQPrJpXoZ9zlf8-LWmdTCUz_uT6AJvhbTLANjWf5zxv4uA&oe=6ADF7A73"}, {"file_name": "3.png", "id": "428945850034499", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031650_428945853367832_7503104716343309904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQ9HxRz6GpsQ7kNvwHNe5y1&_nc_oc=Ado1uhmDDC1Qc_z_BFa-zoNGGdXRUaKgpRpinZSrzI-3n5ftG3dGDsFK7iR67XtYyq4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8nJQDlpkklwV-c0hMfpoigGgWGWFhS5PuWTmfTSVP5A&oe=6ADF4412"}, {"file_name": "1.png", "id": "1084874436108566", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001662_1084874439441899_1847416636135791525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjaUOgcics8Q7kNvwF7W-tF&_nc_oc=AdoFdllI7O5EwyZ2oHmn3TDSCM4AR1Hvehii8-OMmSV3M01qskv2nrcwVYhmVji1j68&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORG-6hgmyUwIAK8nT-8bqU8SDTVbj3WEA-OCoqyS7-pQ&oe=6ADF553B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image Accelerate.png", "id": "596964202857057", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031551_596964206190390_8913572935597900513_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDg8hCuZNS4Q7kNvwGwrcrE&_nc_oc=Adoajtx25BJw34hkZvmAh-nobgtqxWtok-KzHQ9ZcQrBugA_gkFXqT4sIcLuUnn2B_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWO7FNGxQFAIXm7FMV2Stdv-oJ3L7dsYwzchciTk8Sqg&oe=6ADF6DCC"}, "display_name": "Accelerate", "keywords": ["Accelerate", "Laboratory", "Fourplus", "CellTherapy", "Bioscience"], "long_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  \n\nAccelerate gives learners the opportunity to experience industry-relevant settings, bioproduction laboratories and clean rooms. In addition, the spillage training applies context to cell and gene transplants within a healthcare facility.  \n\nRemove barriers to high-stakes training and increase workforce competency with Accelerate.  ", "short_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29264350743202426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-
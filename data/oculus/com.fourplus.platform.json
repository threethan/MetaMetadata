com&_nc_ss=7f20f&oh=00_AQQE7q3YdN5wtFfa3efZY4vYegxGOoyrUHWzbPGNtN8smw&oe=6AF09DF3"}, {"file_name": "3.png", "id": "428945850034499", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031650_428945853367832_7503104716343309904_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3B2hdyNFDMQ7kNvwG-v0l-&_nc_oc=AdoMvtNUN-pIXfRUOb7UQfyXbbKRnQhcLEZyK6RLFE7y6oevXl8p_jCLFF7d6zvTBls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr0-91c3k9yjbVEgempt6VcKKjjDKIeRPwTHI4-iQH0g&oe=6AF09FD2"}, {"file_name": "1.png", "id": "1084874436108566", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001662_1084874439441899_1847416636135791525_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4KL1yjIV00UQ7kNvwETzkHP&_nc_oc=AdrAPMaaqw8p_pdTSXJONP0GoKvbfCvDn-_p3gUT8meeZ9dhGoaXqCGDz5ZoyM30New&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjJ9qrUDbtPtRQQBjg9J-1_sWLUX6QIegP2kzZOzlI0w&oe=6AF0B0FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image Accelerate.png", "id": "596964202857057", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031551_596964206190390_8913572935597900513_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBN1ShAm9SoQ7kNvwEs0JBZ&_nc_oc=AdpygYt75ebhozwZgjRbbEc3s-mcJjI0p11mJWKg4wl8WdCWrxs06fAcUVVb4IIRjQg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSq8PTlHoPC7W2wcSf97PRjEQKby5le6mfMUyXXM-tugA&oe=6AF0914C"}, "display_name": "Accelerate", "keywords": ["Accelerate", "Laboratory", "Fourplus", "CellTherapy", "Bioscience"], "long_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  \n\nAccelerate gives learners the opportunity to experience industry-relevant settings, bioproduction laboratories and clean rooms. In addition, the spillage training applies context to cell and gene transplants within a healthcare facility.  \n\nRemove barriers to high-stakes training and increase workforce competency with Accelerate.  ", "short_description": "Accelerate is a virtual reality training program for GMP operators, designed around Cell & Gene Therapy Catapult\u2019s manufacturing centre in Stevenage, UK. Accelerate navigates trainees through an immersive GMP compliant manufacturing facility, with standardized, modular content spanning: Cleaning, Gowning, Compliance and Health & Safety. The interactive laboratory walkthroughs and simulations provides exposure to a real-life facility, without the risks associated with in-person training.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://fourplus.co.uk/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "FourPlus Immersive", "support_website_url": null, "website_url": "https://fourplus.co.uk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29264350743202426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-
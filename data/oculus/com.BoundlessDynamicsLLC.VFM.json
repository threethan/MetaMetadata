&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZpI5QjRlmsQ7kNvwF0Grd_&_nc_oc=AdqQX2yDEhceELUg2mWosRAwA219tHWZ0n9zbSdrpLuRtX0oQyfBc3IKjlRfidkP0so&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUxsMFqgpDDvVtKA2RjAL6CgdDpuHYGxc3DGhpVzq-Mw&oe=69D0F087"}, {"file_name": "screenshot89.png", "id": "1367958514985397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499299093_1367958518318730_7652177360308678642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf4FzzEQzdgQ7kNvwGn1zzm&_nc_oc=AdqrAbcxkcepWYBguitXkE4G-qoFudE1kvGZDMJ_GZEdtYcpGUllK59tqievlP2ueCU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx-WsvzPBxirHyW-mnDNcjrTVZUqHEtqi3GQNFIVgoqKg&oe=69D117FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "4171923653128802", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499300619_4171923659795468_1379225394513236478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPzoRsfzNj4Q7kNvwFDrDiB&_nc_oc=AdpoCmU7sKmYH7lXoj0cDfh2E8EKCuvV9hemrZm5bM1sN5yke-nH6jxoGMuUa5qM-5Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwgSLMOF-SHpCWI5xpiC-Hrcv58YP85L-jodZVwdzLAoA&oe=69D0FE71"}, "display_name": "Virtual Fighter Maneuvers", "keywords": ["dogfight", "flight", "combat", "vtol", "jet"], "long_description": "**Virtual Fighter Maneuvers** is a combat flight simulator from the creator of VTOL VR. Focused on short-range air-to-air engagements, you can launch directly into the merge with bots or other players online. \n\nPilot advanced fighter jets in high intensity dogfights with realistic flight and weapon physics. Aircraft and missiles are simulated with realistic effects of air density, altitude, transonic drag, angle of attack, etc! \n\n# Choose from 3 unique aircraft:\n- **T-15 Excalibur**: With two high powered engines and cropped delta wings, this air superiority fighter boasts the highest thrust and top speed.\n- **T-16 Falchion**: This single-engine, lightweight fighter is the king of sustained turn rate, giving it an edge in two-circle fights.\n- **T-18 Cutlass**: Able to achieve an aggressive angle of attack, this naval multi-role jet dominates in lower speed one-circle fights.\n\nLearning the strengths and weaknesses of each aircraft is crucial to mastering the art of air combat.\n\n# Take Control\nInteract with the cockpit and fly the aircraft with the virtual controls or connect your wireless gamepad.\n\n# Fly At Your Own Pace\nPlay for fun in casual game modes or compete in global ranked dogfight matches.\n\n# Climb the Leaderboard\nEarn your rank and compete against players with similar skill levels.", "short_description": "Master the art of modern air combat. Pilot advanced fighter jets in high intensity dogfights with realistic flight and weapon physics. Duel against challenging AI opponents or compete with other players online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bdynamicsstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Boundless Dynamics, LLC", "support_website_url": null, "website_url": "https://virtualfightermaneuvers.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24480376238304900"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.57
1367958518318730_7652177360308678642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TIuCr1uiAgQ7kNvwFvx8pm&_nc_oc=AdqXqxVHnyC9vr36OGJy5_z_EV3a6yJx116YAcf20eb0RsEpCuGoE7bDSyyR6OKu1mw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYP4X1YpIVsqXO--pkPEAuzSNIERfFiwaf2cIHK6iO1w&oe=6A6DFA7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "4171923653128802", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499300619_4171923659795468_1379225394513236478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMzwNVErPNoQ7kNvwGqn26V&_nc_oc=AdoyP-NiXtNXdgmav94mWG4Sms3NVLxiBxsJfdzNH9TxgV-JWDNyfqbiQJhu5XJnZ-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqBzILaEaeQmGWjV7t5AW9MJ4-0fc6eQCf768lAtjPeg&oe=6A6DE0F1"}, "display_name": "Virtual Fighter Maneuvers", "keywords": ["dogfight", "flight", "combat", "vtol", "jet"], "long_description": "**Virtual Fighter Maneuvers** is a combat flight simulator from the creator of VTOL VR. Focused on short-range air-to-air engagements, you can launch directly into the merge with bots or other players online. \n\nPilot advanced fighter jets in high intensity dogfights with realistic flight and weapon physics. Aircraft and missiles are simulated with realistic effects of air density, altitude, transonic drag, angle of attack, etc! \n\n# Choose from 3 unique aircraft:\n- **T-15 Excalibur**: With two high powered engines and cropped delta wings, this air superiority fighter boasts the highest thrust and top speed.\n- **T-16 Falchion**: This single-engine, lightweight fighter is the king of sustained turn rate, giving it an edge in two-circle fights.\n- **T-18 Cutlass**: Able to achieve an aggressive angle of attack, this naval multi-role jet dominates in lower speed one-circle fights.\n\nLearning the strengths and weaknesses of each aircraft is crucial to mastering the art of air combat.\n\n# Take Control\nInteract with the cockpit and fly the aircraft with the virtual controls or connect your wireless gamepad.\n\n# Fly At Your Own Pace\nPlay for fun in casual game modes or compete in global ranked dogfight matches.\n\n# Climb the Leaderboard\nEarn your rank and compete against players with similar skill levels.", "short_description": "Master the art of modern air combat. Pilot advanced fighter jets in high intensity dogfights with realistic flight and weapon physics. Duel against challenging AI opponents or compete with other players online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bdynamicsstudio.com/misc-content/policies/privacy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Boundless Dynamics, LLC", "support_website_url": null, "website_url": "https://bdynamicsstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "10069112156524548"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "889801473589689"}, {"status": "PUBLISHED", "id": "2022630815275819"}, {"status": "PUBLISHED", "id": "1265353402184431"}, {"status": "PUBLISHED", "id": "749177508225080"}]}, "baseline_offer": {"id": "749177508225080"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784746800, "status": "PUBLISHED", "id": "889801473589689"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typen
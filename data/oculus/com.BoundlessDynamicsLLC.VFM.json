AdrbdLs4lUWcb8WwftbkI8MuTwsXLhDXCUQQUASvk62t1bZdpDn_5y9AmE-cHsFtLQI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17lmhwyiWmI9NkgzDFYCvkMamCe9_SlqtxuBwkkTD8YQ&oe=69F20D7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "4171923653128802", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300619_4171923659795468_1379225394513236478_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgwJDw_TLp4Q7kNvwF54gvU&_nc_oc=Adrg5qgXXbKgALc4OOcEbTcNRyoF_d1hdOgSyf8L8T0o4z4mIp9aUzePNQhVqxQGg4g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af16gartDBIZf6JKDHF_zy565XI8M6TqAlbtG9gFOEa7Eg&oe=69F1F3F1"}, "display_name": "Virtual Fighter Maneuvers", "keywords": ["dogfight", "flight", "combat", "vtol", "jet"], "long_description": "**Virtual Fighter Maneuvers** is a combat flight simulator from the creator of VTOL VR. Focused on short-range air-to-air engagements, you can launch directly into the merge with bots or other players online. \n\nPilot advanced fighter jets in high intensity dogfights with realistic flight and weapon physics. Aircraft and missiles are simulated with realistic effects of air density, altitude, transonic drag, angle of attack, etc! \n\n# Choose from 3 unique aircraft:\n- **T-15 Excalibur**: With two high powered engines and cropped delta wings, this air superiority fighter boasts the highest thrust and top speed.\n- **T-16 Falchion**: This single-engine, lightweight fighter is the king of sustained turn rate, giving it an edge in two-circle fights.\n- **T-18 Cutlass**: Able to achieve an aggressive angle of attack, this naval multi-role jet dominates in lower speed one-circle fights.\n\nLearning the strengths and weaknesses of each aircraft is crucial to mastering the art of air combat.\n\n# Take Control\nInteract with the cockpit and fly the aircraft with the virtual controls or connect your wireless gamepad.\n\n# Fly At Your Own Pace\nPlay for fun in casual game modes or compete in global ranked dogfight matches.\n\n# Climb the Leaderboard\nEarn your rank and compete against players with similar skill levels.", "short_description": "Master the art of modern air combat. Pilot advanced fighter jets in high intensity dogfights with realistic flight and weapon physics. Duel against challenging AI opponents or compete with other players online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bdynamicsstudio.com/misc-content/policies/privacy.pdf", "developer_terms_of_service_url": null, "publisher_name": "Boundless Dynamics, LLC", "support_website_url": null, "website_url": "https://bdynamicsstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "10069112156524548"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2022630815275819"}, {"status": "PUBLISHED", "id": "1265353402184431"}, {"status": "PUBLISHED", "id": "749177508225080"}]}, "baseline_offer": {"id": "749177508225080"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status": "PUBLISHED", "id": "2022630815275819"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25473031965705984", "version": "1.3.0"}, "id": "962019519131000", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7949932551775863", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25473031965705984"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "962019519131000"}]}, "change_log": "This update adds 3 new maps and a few fixes for the second ranked season. Also, to help reduce the amount of player harassment and abuse, a \"report player\" button has been added to the player stats display in lobbies and replay rooms, as well as a 7 day cooldown for changing pilot names.\n\nv1.3.0\nGeneral\n - Added Harbor Island Map\n - Added Desert Map\n - Added Lake Chaka Map\n - Added 7-day cooldown to changing pilot name\n - Fixed terrain mesh issues which may have caused raycasts to fail on certain areas\n - Disabled Merge Safety option when BVR is selected\nMultiplayer\n - Added Report button to player info display\n - Changed game setup in custom lobbies to not overwrite each client's settings\nRanked Matchmaking\n - Moved to different server host\n - Fixed various bugs with Elo award calculations\n - Reduced magnitude of Elo changes per match\n - Minimized elo change when ranked player plays against unranked player\n-  Changed time of day to random (excluding night)\n", "created_date": 1775755170, "id": "25473031965705984", "version": "1.3.0", "version_code": 106, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7949932551775863", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25473031965705984"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775740180, "id": "25471055055903675", "version": "1.3.0", "version_code": 105, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7949932551775863", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25473031965705984"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1775698185, "id": "25466379036371277", "version": "1.3.0", "version_code": 104, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7949932551775863", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25473031965705984"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "962019519131000"}]}, "change_log": "v1.2.9\nAcademy\n\t- Fixed: Gunsight tutorial didn't load properly\n", "created_date": 1772756383, "id": "25126054667070384", "version": "1.2.9", "version_code": 103, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7949932551775863", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25473031965705984"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "962019519131000"}]}, "change_log": "v1.2.8\nGeneral\n\t- Fixed: Host's afterburner would still appear lit when out of fuel\n\t- Fixed: Mic setting and chat volume would reset to off/zero after returning from replay viewer\n\t- Fixed: Virtual hand position was not locked properly to certain buttons while held\n\t- Fixed: recenter button could appear while interacting with virtual controls/buttons\n\t- Fixed: \"Fight's On\" audio played twice\n\t- Increased the unlocked gun funnel's wingspan to be more of an average between 3 planes (previously T-16 sized)\nMultiplayer\n\t- Reduce AoA desync in replays\nT-15\n\t- Fixed minor texture issue\nRanked Server\n\t- Fixed: Player's pilot name wouldn't update on leaderboard\nAcademy\n\t- Added Gunsight tutorial\n", "created_date": 1772730854, "id": "25123344514008066", "version": "1.2.8", "version_code": 102, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
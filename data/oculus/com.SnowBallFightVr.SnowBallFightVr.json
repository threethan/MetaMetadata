aIGKmIvyIcPGgiKxNvStl1o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Yj49A7P1hY06EVx_usmk1LgNXZ8vCAI7b3fXbvqkcbw&oe=6A034989"}, {"file_name": "Screenshot 2024-03-04 015652 (7).png", "id": "772084874998728", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221319_772084878332061_8283190104678222718_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8fLDlWpsJ_kQ7kNvwGzEzu5&_nc_oc=AdpuK6clYXi4SwMq-Wcp1FjrT8K6yz4CMnzDMK2IxfQv0qHvZZLphrQZ2bh1EZVGuAQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mhYWtrkuUvmnN8R35bqI-cOHlkISzoF_8ROfy9Mq-2g&oe=6A034A35"}, {"file_name": "Screenshot 2024-03-04 015652 (7).png", "id": "768451734870908", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982481_768451738204241_5980498698030824968_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qp4IXBRwz_kQ7kNvwGWJLnE&_nc_oc=Adp23JXxjthDbnVSABMtRamTv_kStIl1A6xgLGeXWrqK24btOJaKQsZL25iNWG0q3I4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56XAenvet2kO-xRdx7X3skSUaCQmfSShXeZPRVPqvp3w&oe=6A031778"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SnowBallFightVR", "keywords": [], "long_description": "Step into the frosty realm of Snowball fight VR, where the magic of virtual reality meets the whimsy of winter wonderlands! In this adrenaline-fueled adventure, you take on the role of a snowman endowed with the agility of a gorilla, ready to conquer the snowy landscapes with thrilling GORILLA TAG locomotive!!!!\n\nEmbark on an unforgettable journey through enchanting snowy maps, where every step becomes a playground. With intuitive controls and immersive gameplay, 'Snowball fight VR' invites you to glide, leap, and swing in this game and have the best time in virtual reality possible.\n\n'Snowball VR' promises endless hours of laughter and excitement for players of all ages.\n\nSo, grab your virtual snow gear and prepare to experience the ultimate thrill of being a snowman with gorilla-like locomotive abilities in 'Snowball fight VR.' It's time to dive headfirst into the snow-covered action and discover the joy of virtual winter adventures like never before!\n\nDon't forget the multiple maps that you can play in such as the hang out area with a TV mirror computer credit AND MORE there is also a space map and more to come soon!!!!!!!!!", "short_description": "Step into the frosty realm of Snowball fight VR, where the magic of virtual reality meets the whimsy of winter wonderlands! In this adrenaline-fueled adventure, you take on the role of a snowman endowed with the agility of a gorilla, ready to conquer the snowy landscapes with thrilling GORILLA TAG locomotive!!!!"}]}, "developer_name": "Jupiter", "developer_privacy_policy_url": "https://sites.google.com/view/snowballfightvr/home", "developer_terms_of_service_url": null, "publisher_name": "Jupiter", "support_website_url": null, "website_url": "https://sites.google.com/view/snowballfightvr/home", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7289450961135596"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1874493866322319"}]}, "baseline_offer": {"id": "1874493866322319"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1711055220, "status": "PUBLISHED", "id": "1874493866322319"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", 
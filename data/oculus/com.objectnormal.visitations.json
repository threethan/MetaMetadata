luscdn.com/v/t64.5771-25/38982447_779719432814156_6029904558920342406_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgeuSuyHr-cQ7kNvwEVpWNy&_nc_oc=AdkcYHPLDMnC-LBPAH0kU6po33TYnCeSKtqHJIPyelRmLdlW6wDOsP3THCuyu9KqA2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyh1I-R6yZYbSblpFPnubfTRhi2N8-25UJfeu7F6mbQTQ&oe=69AECB05"}, "display_name": "Visitations", "keywords": ["meditation", "therapeutic", "mindful"], "long_description": "Ancient shamans intuitively understood the power of the mind and their performances would conjure  the body\u2019s innate ability to heal. Modern medicine accomplishes a similar performance with lab coats and pills. We are beginning to understand that technology can be employed to similar ends.\n\nVisitations makes use of techniques such as binaural beats, strobing, form constants, and includes body scan meditation, dream induction, and music developed by artists skilled in the healing arts.\n\nThese techniques have been shown to directly alter the physiological state of the brain.\n\nUsers may customize experiences to their needs, which may include:\n\n\u00b7 Inner Journeys\n\u00b7 Relaxation/Focus\n\u00b7 Mood Modification\n\u00b7 Mini-Vacations\n\u00b7 Mindfulness\n\u00b7 Distraction Therapy\n\u00b7 Infusion Therapy\n\u00b7 Mental Reset\n\u00b7 Meditation Assistance", "short_description": "Visitations are experiments in therapeutic aesthetics which draw on lessons from neuroscience and psychology to induce relaxed and entranced mental states in the user."}]}, "developer_name": "Object Normal", "developer_privacy_policy_url": "http://visitationsvr.com/privacy.html", "developer_terms_of_service_url": "http://visitationsvr.com/eula.html", "publisher_name": "Light Clinic", "support_website_url": "http://visitationsvr.com/", "website_url": "http://visitationsvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1404800346651520"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031396_451897125757566_5508740563694341995_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2O9vOql97QQ7kNvwGDdaLy&_nc_oc=Adli-h2PBr6qcnsSK7oxfrp2-_1m58NctHF2Gvuc2WZ1zzVkDVV6CRIEd-9_60pJ6-E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwao9O3rxs5CQJBh8UqKy8GrunzEaIEUGXZRzJslddMRw&oe=69AED497"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Visitations", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1606068021, "lastRevision": {"nodes": [{"id": "3319327418134865", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4023694967657163", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "3949060271774186"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "VisitationsHeroArt3kx900.png", "id": "3643071002403635", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001723_3643071005736968_4246661825507814578_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajmre_VgnZcQ7kNvwEaBdlE&_nc_oc=Adl3JW2BaTU-zlT7oCTfXtCQB652oLk5_t8Xb7IJOUk6uADHj1J_rPZMKvI1o7XXjFo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbedyYVj74xJRTR2cBc62wILLOTzhwZbvg
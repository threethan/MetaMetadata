scdn.com/v/t64.5771-25/38982677_373623123653905_1785160587917777408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nx0f0edVbQQ7kNvwE6bfuA&_nc_oc=AdqmSpvgUZtg9EFoll-1VyXXfCXh5Yhz-R_2UYsJUc0H1_gyICggiBO2yuNOJ5YpZ-A&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O3jhcYQQ8Qmxghf-9Rk5TbPCDjMPisNCFb0AAmiJT1A&oe=6A11A20F"}, {"file_name": "download (26).png", "id": "345687459964102", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003269_345687463297435_752144126112800743_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZUBysGXeQQQ7kNvwHRpP7e&_nc_oc=Adpm0O0PLqRLNP88Pf1OLDIw4I90D2_UATb_tpahinNkRuk4YAg7MQGnAgCxy3WXlUs&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Wr9iUQkBBHc7VbdrFmFC7h9a3-OkJr4ZjVsG7ULh6Iw&oe=6A11A46E"}, {"file_name": "download (25).png", "id": "950220632166700", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031344_950220635500033_7792352926231781392_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF5g0LhqS2QQ7kNvwGaPP3r&_nc_oc=Adp9hEGWlhbF4EoptebotZjMH0aVkT3mf01ypRsLZcXhHH6VixH3hq2dKkLB7Cf5ziw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fJmV6AAJwa7va95wYACYhAqKTNixoz_1HgkYGLk7kAg&oe=6A11A86D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "779719429480823", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982447_779719432814156_6029904558920342406_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fc8OdfkF-hkQ7kNvwGuK7Tx&_nc_oc=AdqwrLg5MVLZK73weYZtuQkQ_UhivkoYQTeh4-jtVvu1MTiJNeOx2SHiAsaRLMvRgC0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-zJBrKV0Uj7-l6y6g-hYE2mV4XXwMa2SE_Z2-QgPEBQ&oe=6A11AB85"}, "display_name": "Visitations", "keywords": ["meditation", "therapeutic", "mindful"], "long_description": "Ancient shamans intuitively understood the power of the mind and their performances would conjure  the body\u2019s innate ability to heal. Modern medicine accomplishes a similar performance with lab coats and pills. We are beginning to understand that technology can be employed to similar ends.\n\nVisitations makes use of techniques such as binaural beats, strobing, form constants, and includes body scan meditation, dream induction, and music developed by artists skilled in the healing arts.\n\nThese techniques have been shown to directly alter the physiological state of the brain.\n\nUsers may customize experiences to their needs, which may include:\n\n\u00b7 Inner Journeys\n\u00b7 Relaxation/Focus\n\u00b7 Mood Modification\n\u00b7 Mini-Vacations\n\u00b7 Mindfulness\n\u00b7 Distraction Therapy\n\u00b7 Infusion Therapy\n\u00b7 Mental Reset\n\u00b7 Meditation Assistance", "short_description": "Visitations are experiments in therapeutic aesthetics which draw on lessons from neuroscience and psychology to induce relaxed and entranced mental states in the user."}]}, "developer_name": "Object Normal", "developer_privacy_policy_url": "http://visitationsvr.com/privacy.html", "developer_terms_of_service_url": "http://visitationsvr.com/eula.html", "publisher_name": "Light Clinic", "support_website_url": "http://visitationsvr.com/", "website_url": "http://visitationsvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2786641828305725"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_
 null, "video_trailer_thumbnail": {"file_name": "TrailerThumbnail.png", "id": "729611147925759", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001667_729611151259092_1383265694339009972_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwo-lubyRYUQ7kNvwHFYurK&_nc_oc=AdqIJCXVhBiIn3i7ogMNGcMnq5v_0Ajd1nDBuziLB2nf5FJnZmUe2GVj8zcHLAz6axw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vjytUdXUaROdpD06vA_qRMctjxYHdnwgdL1W6CsAXww&oe=6A38095B"}, "display_name": "Visitations", "keywords": [], "long_description": "Aesthetic experiences are brought into the therapeutic realm using lessons from neuroscience and psychology. Visitations makes use of techniques such as binaural beats, subtle strobing, form constants, and includes a guided meditation, a dream induction, and a soundtrack developed by a healer with experience leading traditionally inspired ceremonies. Visitations creates a set & setting which allow users to turn inwards and explore their own stories and mental states.", "short_description": "Visitations are experiments in therapeutic aesthetics which draw on lessons from neuroscience and psychology to induce relaxed and entranced mental states in the user."}]}, "developer_name": "Object Normal", "developer_privacy_policy_url": "https://visitationsvr.com/privacy", "developer_terms_of_service_url": "https://visitationsvr.com/eula", "publisher_name": "Light Clinic", "support_website_url": "https://visitationsvr.com/", "website_url": "https://visitationsvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "MEDICINE", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_pr
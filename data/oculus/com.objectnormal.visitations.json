rlU8M5u8H8eubwWBLtlAvx4JqjDEoTkavzJ9Vh4Isl41rYdwzNBaV7DYJpyP0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1IO_nihk0h5lnGqu_qxeD_CuIBIn575x8etgmzjmaZsQ&oe=69F1FE0F"}, {"file_name": "download (26).png", "id": "345687459964102", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39003269_345687463297435_752144126112800743_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDCRC1gu4B4Q7kNvwGHGjqf&_nc_oc=AdpGIDw6GScfHoXS5yjk28I24WNvySB8ii9xOjf04vWmKRHOgQsjcGbMQx5xfoLZLYw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af04md2OZzszIgTn5Qr_SAlobgP4QhQtu6sgBQfnbxDQ6w&oe=69F2006E"}, {"file_name": "download (25).png", "id": "950220632166700", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031344_950220635500033_7792352926231781392_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qfNQ9peL5lgQ7kNvwH2eH0i&_nc_oc=AdonKd4JnkoI2dvxshLJt6u5VRg5oyWd6EydZorCqAYV8VhMoZVOJRfRYLFL9yvhZ0w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3u4glU0ozKHOlDBv1FmJGnJ8R9aCdyLvczamE81n3CQA&oe=69F2046D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "779719429480823", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982447_779719432814156_6029904558920342406_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g9uKDCvWfDoQ7kNvwH9rDmM&_nc_oc=AdrQWe1El9_ecVFsS303MDjmjmyvfy-27cEoSsRQfj5Rli50PUNrVLORk99SVpcnnQ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2IkaMtMD8yP-MwcUHyXdjAEd96xb2-26XZYjySSLO0NA&oe=69F20785"}, "display_name": "Visitations", "keywords": ["meditation", "therapeutic", "mindful"], "long_description": "Ancient shamans intuitively understood the power of the mind and their performances would conjure  the body\u2019s innate ability to heal. Modern medicine accomplishes a similar performance with lab coats and pills. We are beginning to understand that technology can be employed to similar ends.\n\nVisitations makes use of techniques such as binaural beats, strobing, form constants, and includes body scan meditation, dream induction, and music developed by artists skilled in the healing arts.\n\nThese techniques have been shown to directly alter the physiological state of the brain.\n\nUsers may customize experiences to their needs, which may include:\n\n\u00b7 Inner Journeys\n\u00b7 Relaxation/Focus\n\u00b7 Mood Modification\n\u00b7 Mini-Vacations\n\u00b7 Mindfulness\n\u00b7 Distraction Therapy\n\u00b7 Infusion Therapy\n\u00b7 Mental Reset\n\u00b7 Meditation Assistance", "short_description": "Visitations are experiments in therapeutic aesthetics which draw on lessons from neuroscience and psychology to induce relaxed and entranced mental states in the user."}]}, "developer_name": "Object Normal", "developer_privacy_policy_url": "http://visitationsvr.com/privacy.html", "developer_terms_of_service_url": "http://visitationsvr.com/eula.html", "publisher_name": "Light Clinic", "support_website_url": "http://visitationsvr.com/", "website_url": "http://visitationsvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2786641828305725"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4301426283217362", "version": "1"}, "id": "723145874949195", "channel_name": "LIVE"}]}, "is_for_oculus_keys_onl
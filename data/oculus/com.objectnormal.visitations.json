t64.5771-25/38982677_373623123653905_1785160587917777408_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3ccHHO78LgQ7kNvwHVrwxB&_nc_oc=AdpvnqV1rwSeG-dTzdKlG9cbQBWONfahC93vNd5p2TYOnYCkw6DqghVnl0k18FhXaPA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpbK88bH65atoMpt0Ru36i-Fh0TVJUPePbspVaJXDAnw&oe=6A9C0F8F"}, {"file_name": "download (26).png", "id": "345687459964102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39003269_345687463297435_752144126112800743_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVBxfW9rw2AQ7kNvwGER71K&_nc_oc=AdomWh0MpuOPUE0_426UkHEwvA1a7TK2TirRdipjL81wjc1l752nv-sdh6Z8_p0NaBY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2uiziR1aE3n1_l5-k3fVlfYURD_VVTE7_KQJ3pQexuQ&oe=6A9C11EE"}, {"file_name": "download (25).png", "id": "950220632166700", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031344_950220635500033_7792352926231781392_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KyixZKicukIQ7kNvwHEETq9&_nc_oc=AdrpjNN8o76FFwf8VW2df9wFa2DAV14PfJ-k0AvhBQiNCe7EpX99VmG0JVFrHFgnBvA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLVquzzFXAAkFbsn07BlxHIIksPAWg12vyYBj01Xnnmg&oe=6A9C15ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "779719429480823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982447_779719432814156_6029904558920342406_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK7JgA65_UAQ7kNvwGHlbvU&_nc_oc=Adpmb7K93GPGZcvJRl47U1K9VmxWlJ5fbN6Ti5Q0D6HGY1VC3CNaEl3t_mWiOapXfnA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcZ87oD0awtB7cKngO47EKh_mhAT3F6FQsCfyi-gA43Q&oe=6A9C1905"}, "display_name": "Visitations", "keywords": ["meditation", "therapeutic", "mindful"], "long_description": "Ancient shamans intuitively understood the power of the mind and their performances would conjure  the body\u2019s innate ability to heal. Modern medicine accomplishes a similar performance with lab coats and pills. We are beginning to understand that technology can be employed to similar ends.\n\nVisitations makes use of techniques such as binaural beats, strobing, form constants, and includes body scan meditation, dream induction, and music developed by artists skilled in the healing arts.\n\nThese techniques have been shown to directly alter the physiological state of the brain.\n\nUsers may customize experiences to their needs, which may include:\n\n\u00b7 Inner Journeys\n\u00b7 Relaxation/Focus\n\u00b7 Mood Modification\n\u00b7 Mini-Vacations\n\u00b7 Mindfulness\n\u00b7 Distraction Therapy\n\u00b7 Infusion Therapy\n\u00b7 Mental Reset\n\u00b7 Meditation Assistance", "short_description": "Visitations are experiments in therapeutic aesthetics which draw on lessons from neuroscience and psychology to induce relaxed and entranced mental states in the user."}]}, "developer_name": "Object Normal", "developer_privacy_policy_url": "http://visitationsvr.com/privacy.html", "developer_terms_of_service_url": "http://visitationsvr.com/eula.html", "publisher_name": "Light Clinic", "support_website_url": "http://visitationsvr.com/", "website_url": "http://visitationsvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "CASUAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2786641828305725"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_bi
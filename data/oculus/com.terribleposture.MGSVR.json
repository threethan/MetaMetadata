//scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982500_967419330638217_3553758339983788388_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpazmp38_g0Q7kNvwFjzlfh&_nc_oc=AdqXPA1t9-eD0p_XgEKYqKmig7cQfePRs4_OYCiueyS4t0XYQl6_TTfXjwro9RVuCpg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkxdy9BBexOhZQmonCEWB8PPWUvXjz4j2UVYiUO2-vYA&oe=6AA7E1EC"}, {"file_name": "MGSF_Screenshot_4.png", "id": "393825129421908", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974854_393825132755241_8544364083218663314_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9DdjNq5MZEQ7kNvwGkjLfN&_nc_oc=AdoM13RWbz1Gr88zxIfDmyTzwVRNxr2C70lTKvvcb1I0E9TLPo5IbeXUBdf-2g0oOZU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ8d-TsmYZ2VM8EYhhoc-dh-TO1uSQlXGlIFFx-CrTzg&oe=6AA8155C"}, {"file_name": "MGSF_Screenshot_5.png", "id": "1462990964151667", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982698_1462990967485000_7827892727743399800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seNerSPFXRoQ7kNvwEzyJIo&_nc_oc=AdpGW4w74O2FRrWwLMZbKwVZQldrWlTOFJdqV-liFE1-kN-0hTs8oixf0wnA9eDZOSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-tMXmzQp38HuW2YwB92fYH4nDLRq5ZWKmo-M9YMV6EA&oe=6AA818D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MGSF_CoverLandscape.png", "id": "1043792509885878", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974472_1043792513219211_4253537742441327150_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GB5AsLDc_u8Q7kNvwGY9IUX&_nc_oc=Adrd93iWQ2cQghMibu2vVw96hRvSpnJzbCjmtFiO01pBrFewVykm-RCfZzswlsObvMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4iEMBchn5-FSN6bIHG74mhyJytgfJDRjPRwik4YR8nA&oe=6AA81413"}, "display_name": "MOTHERGUNSHIP: FORGE", "keywords": ["roguelite", "FPS", "crafting", "Mothergunship", "action"], "long_description": "MOTHERGUNSHIP: FORGE is a frantic VR FPS roguelite with one of the most intuitive and empowering crafting systems ever created. Now updated for Meta Quest 3 to look ever better!\n\nSurvive the MOTHERGUNSHIP\u2019s metal minions and earn gun parts to add to your weapon, easily snapping them into place in VR. \n\nChoose from hundreds of parts that influence not just you and your gun, but also change your enemies and the world around you. \n\nFace off through four biomes, each with a massive boss, and unlock tons of new gunparts and modes.\n\n\"Incredibly well-made... one of the best VR  shooters out there.\u201d \u2014Android Central\"\n\n\"One of the best VR bullet-hell games I\u2019ve experienced...\" \u2014cogconnected\"\n\nMeta Quest 3 Updates include: higher resolution, new post effects (including Bloom, HDR, and Tonemapper), sharper resolution textures, improved framerate, and dynamic resolution scaling for a higher --and steadier-- performance. \n\nQuest 2 and Quest 3 versions both include all free post launch content including full Co-Op Campaign, Terror, Iron Man, Sandbox, and Custom Modes, Meta Quest 3/ Meta Quest 2 cross play, hundreds of gun parts, seasonal events, new weapons, levels, bosses, and more!", "short_description": "Forge absurdly powerful guns and fight through the belly of a metal alien monstrosity in this VR FPS roguelite follow up to MOTHERGUNSHIP. Wanna build a rocket-firing-shotgun or a toxic spike-ball-launcher? Unleash your inner mad scientist, then take on the MOTHERGUNSHIP."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.terribleposture.com/privacy-policy/", "developer_terms_of_service_url": "https://www.terribleposture.com/terms-of-service/", "publisher_name": "Terrible Posture Games, Inc", "support_website_url": null, "website_url": "https://www.terribleposture.com/mothergunship-forge/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_ty
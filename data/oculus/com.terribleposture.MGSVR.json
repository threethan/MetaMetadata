-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GFdk_CxUvCAo1BOuME0Lo9oNg8ckIj87kLr4dtUbUog&oe=6A3A84F0"}, {"file_name": "MGSF_Screenshot_3.png", "id": "967419327304884", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982500_967419330638217_3553758339983788388_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BOEs9P0NpRcQ7kNvwFp_vMl&_nc_oc=AdoQZfYHybq1CmLr3A1Mx7xd5Jy5ZlC3HpPJwPBT3MxegR6PZ2z7m7aNm9f8SY9CZng&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DlmiI8r2B23J_rs0HXh0XHZcDSfKv9DNEb_UacOeJjQ&oe=6A3AADAC"}, {"file_name": "MGSF_Screenshot_4.png", "id": "393825129421908", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_393825132755241_8544364083218663314_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W7LVhs2m3AQ7kNvwFW0hdQ&_nc_oc=Adq9mtA9wJEACvPAAyCuzecIVKh15eo2kuG4WJ3Uqr-DcHZknxgQqfk6VsPgcnfviLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hijEOmpMJigFCU26tWSOt0Th-AYVX42K6i4oE2Q_GZQ&oe=6A3AA8DC"}, {"file_name": "MGSF_Screenshot_5.png", "id": "1462990964151667", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982698_1462990967485000_7827892727743399800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rdqke2adsXIQ7kNvwFJpqbi&_nc_oc=AdpmvUruBUeGDWFTXxOf0VETcY4dRxCpCiBmvtMRaXfBrTtnkFZuiqUcJ-f3qzAoZUM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87H-wl0PbGm_pvC2fQOMQVpCQFfJiKGep_uTUzrUeMEw&oe=6A3AAC51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MGSF_CoverLandscape.png", "id": "1043792509885878", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974472_1043792513219211_4253537742441327150_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUbDqa1JpNwQ7kNvwHC727V&_nc_oc=AdrWZ0Hlzp1MMeQiR_241M9PkO2BM9Lx92k9YW9zQ0iTn1IA0pOtHMKGftf1hraCwfE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OU5aYxmRpXNAcJMuE1GC52xgOKYP5WK0IBn_LZNns8Q&oe=6A3AA793"}, "display_name": "MOTHERGUNSHIP: FORGE", "keywords": ["roguelite", "FPS", "crafting", "Mothergunship", "action"], "long_description": "Welcome back recruit! MOTHERGUNSHIP: FORGE is a frantic VR FPS roguelite where players craft powerful hand-held weapons and struggle to survive\u2014er defeat\u2014the MOTHERGUNSHIP. Experience room scale movement*, dodging, limbo-ing and even relishing the satisfaction of literally punching through clouds of bullets, all while perfecting your weapon masterpiece. \n\nSurvive the MOTHERGUNSHIP\u2019s metal minions and earn gun parts to add to your weapon, easily picking them up and snapping them into place in VR. You\u2019ll choose from a wild array of distinct gun parts and upgrades like chainguns, railguns, and pizza launchers (yes, explosive pizzas) to forge hell-ish combinations. Design your weapon, then destroy the MOTHERGUNSHIP fleet as alien machines, explosive traps, metal pests, and deadly bosses do everything they can to blast you and your weapon back to square one. \n\n*MOTHERGUNSHIP: FORGE includes accessibility modes to support all players. Accessibility info can be found in the game's settings.", "short_description": "Craft. Shoot. Die. Repeat. \n\nForge absurdly powerful guns and fight through the belly of a metal alien monstrosity in this VR FPS roguelite follow up to MOTHERGUNSHIP. Wanna build a rocket-firing-shotgun or a toxic spike-ball-launcher? Unleash your inner mad scientist, then take on the MOTHERGUNSHIP."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.terribleposture.com/privacy-policy/", "developer_terms_of_service_url": "https://www.terribleposture.com/terms-of-service/", "publisher_name": "Terrible Posture Games, Inc", "support_website_url": null, "website_url": "https://www.terribleposture.com/mothergunship-forge/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_
-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0a9isymyfXXG90w583z6s0BDNnmdvWpaUnpEOmEX9EMQ&oe=69F353F0"}, {"file_name": "MGSF_Screenshot_3.png", "id": "967419327304884", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982500_967419330638217_3553758339983788388_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VHZU_eiB40gQ7kNvwGAyezN&_nc_oc=AdqMNgErs96xrds4WKoVGWKEe4wQi_YNwWldGoAjJz36MdRasiREJXyA03R4LDDO0Yw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3lNKMsKxf89IJuk6AsDDPbvaeElBjnajpbDD-wzTCGDA&oe=69F3446C"}, {"file_name": "MGSF_Screenshot_4.png", "id": "393825129421908", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974854_393825132755241_8544364083218663314_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKM84IyrJ-8Q7kNvwF21Crv&_nc_oc=Ado_FVmzqlGoYE_Tb8TWc9e6vQM9UR2pQiY2-5onXDfsVRWnOTgbNTkmKb_RwBi2qzE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ThPY_5jD7-rmK0BWmFUQSjd8t91Gqsx7z9ADll22ncw&oe=69F377DC"}, {"file_name": "MGSF_Screenshot_5.png", "id": "1462990964151667", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982698_1462990967485000_7827892727743399800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1PSHUkdJm4sQ7kNvwEW5Ki2&_nc_oc=AdpgSYDLEh6N4yCPWAdt5muZMvmFb2Mcz-1Epm3IbFkFWKlyCngl-K3VBknpWAyxsr0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13VcpOLfLDuG4fAI7vKocECfbXE4TjJb2N_WOHqIxOiQ&oe=69F34311"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MGSF_CoverLandscape.png", "id": "1043792509885878", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974472_1043792513219211_4253537742441327150_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0y5BRaf5tL4Q7kNvwHZaMwY&_nc_oc=AdpEtlSE6ogDMN9tMIzgt4k5jypPP8ipQ-RTU1eDmSXZ8JmuqSKIEpe75GJV2mbXduA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0X-T2BPcZ8YMyH8hGg2AxDTsKYr6v26Wrp_zWa558QVA&oe=69F37693"}, "display_name": "MOTHERGUNSHIP: FORGE", "keywords": ["roguelite", "FPS", "crafting", "Mothergunship", "action"], "long_description": "Welcome back recruit! MOTHERGUNSHIP: FORGE is a frantic VR FPS roguelite where players craft powerful hand-held weapons and struggle to survive\u2014er defeat\u2014the MOTHERGUNSHIP. Experience room scale movement*, dodging, limbo-ing and even relishing the satisfaction of literally punching through clouds of bullets, all while perfecting your weapon masterpiece. \n\nSurvive the MOTHERGUNSHIP\u2019s metal minions and earn gun parts to add to your weapon, easily picking them up and snapping them into place in VR. You\u2019ll choose from a wild array of distinct gun parts and upgrades like chainguns, railguns, and pizza launchers (yes, explosive pizzas) to forge hell-ish combinations. Design your weapon, then destroy the MOTHERGUNSHIP fleet as alien machines, explosive traps, metal pests, and deadly bosses do everything they can to blast you and your weapon back to square one. \n\n*MOTHERGUNSHIP: FORGE includes accessibility modes to support all players. Accessibility info can be found in the game's settings.", "short_description": "Craft. Shoot. Die. Repeat. \n\nForge absurdly powerful guns and fight through the belly of a metal alien monstrosity in this VR FPS roguelite follow up to MOTHERGUNSHIP. Wanna build a rocket-firing-shotgun or a toxic spike-ball-launcher? Unleash your inner mad scientist, then take on the MOTHERGUNSHIP."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.terribleposture.com/privacy-policy/", "developer_terms_of_service_url": "https://www.terribleposture.com/terms-of-service/", "publisher_name": "Terrible Posture Games, Inc", "support_website_url": null, "website_url": "https://www.terribleposture.com/mothergunship-forge/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_
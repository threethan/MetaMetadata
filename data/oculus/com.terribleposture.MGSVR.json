//scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982500_967419330638217_3553758339983788388_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZmWCha7AGsoQ7kNvwHIF__z&_nc_oc=Adovfzr87b0EyuMF0cF-LQrFQ1bp6niltdWOtiY0oARn-7dqqz7tRNhWvuz41WcZW6c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-ZKZHgvz8uuS0rGXWbcANtnFPI3EGQrxGSNEejbb26A&oe=6A3021AC"}, {"file_name": "MGSF_Screenshot_4.png", "id": "393825129421908", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974854_393825132755241_8544364083218663314_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMjmvN7iTNMQ7kNvwF2sXU9&_nc_oc=AdrMA-GGS5sxoAKafiDN8BdIT-MstvMCwle6Vux4C49_82dmS7mz8_qDOWeq73oRS00&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88SFftsH8M1HYk-MgDEVDtG_2hjv0V6zodmbvXwyMHeg&oe=6A301CDC"}, {"file_name": "MGSF_Screenshot_5.png", "id": "1462990964151667", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982698_1462990967485000_7827892727743399800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15hkG2M5cOEQ7kNvwF9zCxQ&_nc_oc=AdqQP963VF0EXsJaTkAKnM2THHe9y2DQpeVpEFf_Y32fH_-cBEzozkiZx7AM-wnkwbM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PTnG8OJ6JrfF9y7otzIzJ8sB7Nmq-wPjhIJp1kk15oA&oe=6A302051"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MGSF_CoverLandscape.png", "id": "1043792509885878", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974472_1043792513219211_4253537742441327150_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uBixvOBrxC0Q7kNvwHXW4Pn&_nc_oc=AdqxzUMyHKW15SE-oDqza0Y8zHU9UsXtmXvBbGJUMDWhWGU8-3nnkNQnrMm6rw37iGM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O_o0-KEul6AktvdRX_j8az5UxbD0CamxIiqGIa2_-Ow&oe=6A301B93"}, "display_name": "MOTHERGUNSHIP: FORGE", "keywords": ["roguelite", "FPS", "crafting", "Mothergunship", "action"], "long_description": "MOTHERGUNSHIP: FORGE is a frantic VR FPS roguelite with one of the most intuitive and empowering crafting systems ever created. Now updated for Meta Quest 3 to look ever better!\n\nSurvive the MOTHERGUNSHIP\u2019s metal minions and earn gun parts to add to your weapon, easily snapping them into place in VR. \n\nChoose from hundreds of parts that influence not just you and your gun, but also change your enemies and the world around you. \n\nFace off through four biomes, each with a massive boss, and unlock tons of new gunparts and modes.\n\n\"Incredibly well-made... one of the best VR  shooters out there.\u201d \u2014Android Central\"\n\n\"One of the best VR bullet-hell games I\u2019ve experienced...\" \u2014cogconnected\"\n\nMeta Quest 3 Updates include: higher resolution, new post effects (including Bloom, HDR, and Tonemapper), sharper resolution textures, improved framerate, and dynamic resolution scaling for a higher --and steadier-- performance. \n\nQuest 2 and Quest 3 versions both include all free post launch content including full Co-Op Campaign, Terror, Iron Man, Sandbox, and Custom Modes, Meta Quest 3/ Meta Quest 2 cross play, hundreds of gun parts, seasonal events, new weapons, levels, bosses, and more!", "short_description": "Forge absurdly powerful guns and fight through the belly of a metal alien monstrosity in this VR FPS roguelite follow up to MOTHERGUNSHIP. Wanna build a rocket-firing-shotgun or a toxic spike-ball-launcher? Unleash your inner mad scientist, then take on the MOTHERGUNSHIP."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.terribleposture.com/privacy-policy/", "developer_terms_of_service_url": "https://www.terribleposture.com/terms-of-service/", "publisher_name": "Terrible Posture Games, Inc", "support_website_url": null, "website_url": "https://www.terribleposture.com/mothergunship-forge/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_ty
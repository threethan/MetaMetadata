-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNxet6CD4okaRu_ZwNej1-SbSzfV84z-7Bry8ofPqrsw&oe=6ABBB7F0"}, {"file_name": "MGSF_Screenshot_3.png", "id": "967419327304884", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982500_967419330638217_3553758339983788388_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opGCXKie9TEQ7kNvwHN2KsZ&_nc_oc=AdpKVheS_mkkagc-zlfgtnbOrNP_hCj3fl_4xi3c0aGsUX21Yv_RT6hI5sKxTf7Mc3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbKz6xOi-jKZ1Ntvw9IDVtYudQCLS8UhxAbR142dxsSw&oe=6ABBE0AC"}, {"file_name": "MGSF_Screenshot_4.png", "id": "393825129421908", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974854_393825132755241_8544364083218663314_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YH-q1zYAR5cQ7kNvwGV0nHX&_nc_oc=AdovD5BbXJDQUTO3pxFsTrndDwP855dDfKBKfCH_fE0sPqgKSEPDTZ8wHl1XhHq_Svs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcDr_bYF7ZSh1iV6VOnTuyNJBrD7mXT_2IdQThHZUUdg&oe=6ABBDBDC"}, {"file_name": "MGSF_Screenshot_5.png", "id": "1462990964151667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982698_1462990967485000_7827892727743399800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFSTGDPbvToQ7kNvwEviYHQ&_nc_oc=AdpVuC-PpI3xOShm7Xm6gYoaKcUSjUEHNMMPslStdbQ7jx7cNrZO4rDfWK4fgyBUgNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMMY4MIu5Q2ZVbke5h3GvRF-bgoKo74NkwI_EQOyyksQ&oe=6ABBDF51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MGSF_CoverLandscape.png", "id": "1043792509885878", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974472_1043792513219211_4253537742441327150_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3_M31hHeRn0Q7kNvwG1U6gT&_nc_oc=AdrxBJC8EU4aw3Fm84Rr3C4Ui2Os4FdXbhy3dUM867GQ0Vl5J22yIIfU2FW9d6ZSttU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfeuxjp-TzdUxYDELT5dBWuXWDsKaAbQDtf-_cjZ_7TA&oe=6ABBDA93"}, "display_name": "MOTHERGUNSHIP: FORGE", "keywords": ["roguelite", "FPS", "crafting", "Mothergunship", "action"], "long_description": "Welcome back recruit! MOTHERGUNSHIP: FORGE is a frantic VR FPS roguelite where players craft powerful hand-held weapons and struggle to survive\u2014er defeat\u2014the MOTHERGUNSHIP. Experience room scale movement*, dodging, limbo-ing and even relishing the satisfaction of literally punching through clouds of bullets, all while perfecting your weapon masterpiece. \n\nSurvive the MOTHERGUNSHIP\u2019s metal minions and earn gun parts to add to your weapon, easily picking them up and snapping them into place in VR. You\u2019ll choose from a wild array of distinct gun parts and upgrades like chainguns, railguns, and pizza launchers (yes, explosive pizzas) to forge hell-ish combinations. Design your weapon, then destroy the MOTHERGUNSHIP fleet as alien machines, explosive traps, metal pests, and deadly bosses do everything they can to blast you and your weapon back to square one. \n\n*MOTHERGUNSHIP: FORGE includes accessibility modes to support all players. Accessibility info can be found in the game's settings.", "short_description": "Craft. Shoot. Die. Repeat. \n\nForge absurdly powerful guns and fight through the belly of a metal alien monstrosity in this VR FPS roguelite follow up to MOTHERGUNSHIP. Wanna build a rocket-firing-shotgun or a toxic spike-ball-launcher? Unleash your inner mad scientist, then take on the MOTHERGUNSHIP."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.terribleposture.com/privacy-policy/", "developer_terms_of_service_url": "https://www.terribleposture.com/terms-of-service/", "publisher_name": "Terrible Posture Games, Inc", "support_website_url": null, "website_url": "https://www.terribleposture.com/mothergunship-forge/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_
-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIw8SkKyEZzB7MpzcCv1grAo_HLMMf_jVa7EuPtDTCmg&oe=6A92D970"}, {"file_name": "MGSF_Screenshot_3.png", "id": "967419327304884", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982500_967419330638217_3553758339983788388_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9g7Qtwmsc4Q7kNvwEQB7tV&_nc_oc=AdoN6rIXker7JZyFnT-DeynVuOzqgFCl0dC8Tv__i6748Opf9AU0pUv3lVwywnkGBJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEko7gMv-q2VNWNcC8_jF5_GSyS4OXehuLrA-Ke9UO89g&oe=6A92C9EC"}, {"file_name": "MGSF_Screenshot_4.png", "id": "393825129421908", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974854_393825132755241_8544364083218663314_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wqxlQREnV9IQ7kNvwHIC-ob&_nc_oc=AdrG9ZIY8LdJSsKYiCiECcQL0rMoMWVmCISAscKuyfOT4I0gljfUCnag6cWBwzXVn6E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHRgQP1waYY1FyY5bK72JzV5FMr4Aw2NBj2a7IC3_RHpw&oe=6A92C51C"}, {"file_name": "MGSF_Screenshot_5.png", "id": "1462990964151667", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982698_1462990967485000_7827892727743399800_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nk8L8-VwD80Q7kNvwFbPJtZ&_nc_oc=AdqD_-0w5-BCjL7_eFBYVqXrMy33B_C3pOb97qtcni15Kk9wYOFIOpAgIAQUAvDTF-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIXKc_WiESG4xpcF6GAwwVjakxbX_bK6w_pKFuHgbq5Q&oe=6A92C891"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MGSF_CoverLandscape.png", "id": "1043792509885878", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974472_1043792513219211_4253537742441327150_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5VXFY3veqcQ7kNvwG5G8kC&_nc_oc=AdpoPANxVIQjwXhOWPKHU8N-Lm9hO_4ScDFJHpDgT5QlioRz4EFo5ScUNDMm71HejCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIko3PjQi6nC2C75e9oD_8zixmL4Nn_IpacAgMJqTCXQ&oe=6A92C3D3"}, "display_name": "MOTHERGUNSHIP: FORGE", "keywords": ["roguelite", "FPS", "crafting", "Mothergunship", "action"], "long_description": "Welcome back recruit! MOTHERGUNSHIP: FORGE is a frantic VR FPS roguelite where players craft powerful hand-held weapons and struggle to survive\u2014er defeat\u2014the MOTHERGUNSHIP. Experience room scale movement*, dodging, limbo-ing and even relishing the satisfaction of literally punching through clouds of bullets, all while perfecting your weapon masterpiece. \n\nSurvive the MOTHERGUNSHIP\u2019s metal minions and earn gun parts to add to your weapon, easily picking them up and snapping them into place in VR. You\u2019ll choose from a wild array of distinct gun parts and upgrades like chainguns, railguns, and pizza launchers (yes, explosive pizzas) to forge hell-ish combinations. Design your weapon, then destroy the MOTHERGUNSHIP fleet as alien machines, explosive traps, metal pests, and deadly bosses do everything they can to blast you and your weapon back to square one. \n\n*MOTHERGUNSHIP: FORGE includes accessibility modes to support all players. Accessibility info can be found in the game's settings.", "short_description": "Craft. Shoot. Die. Repeat. \n\nForge absurdly powerful guns and fight through the belly of a metal alien monstrosity in this VR FPS roguelite follow up to MOTHERGUNSHIP. Wanna build a rocket-firing-shotgun or a toxic spike-ball-launcher? Unleash your inner mad scientist, then take on the MOTHERGUNSHIP."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.terribleposture.com/privacy-policy/", "developer_terms_of_service_url": "https://www.terribleposture.com/terms-of-service/", "publisher_name": "Terrible Posture Games, Inc", "support_website_url": null, "website_url": "https://www.terribleposture.com/mothergunship-forge/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}], "external_subscription_
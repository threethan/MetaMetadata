ow91SknHkaQiy0W-77Eg&oe=6AFF0C0B"}, {"file_name": "bricktag4.png", "id": "1425640009403604", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_1425640012736937_4293257504910703247_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnHyWo9-LVsQ7kNvwGQ9nH6&_nc_oc=AdoVlid2qIlODwyfboM5wpHc7DWGDPxYiUlUfOR-BtTD0K0acNkz84GA0xEgpPmH8RY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpku8e6LjmfkvxuAWZwE5xG3DPIg7Gt-ND2csJ1KZ_3Q&oe=6AFF2A23"}, {"file_name": "bricktag5.png", "id": "1074171188277445", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491821796_1074171191610778_4712603200623703655_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L20GewE23YcQ7kNvwGDegEj&_nc_oc=AdoL2MpKcZXRbQtFq5g52DeVW2gEp9W3xEQrJE4C3nYEFOpuJCBUQBoBgGn1KbqAw4Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoFlG-0jWKIM45G0rFOFic3Js6EdB2MDCy_l2oTjefYg&oe=6AFF3315"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brick Tag\u3164\u3164", "keywords": ["bricktag", "bricktagvr", "BrickTag"], "long_description": "\ud83e\udda0 BUILT IN MODS \ud83e\udda0\nExplore the COOLEST mods that are easy to get. Rockets, Fly, No Clip, Speed Hacks, X Ray, Teleport, Laptop, and much more!\n\ud83d\udcf8 FREE CAMERA MOD: MOST ADVANCED CAMERA \ud83d\udcf8\nOur built-in camera mod lets you switch between first-person, third-person, and other exciting perspectives to enhance your gameplay experience.\n\ud83c\udfe0 GAME MODES\ud83c\udfe0\nHave fun and talk with other bricks in our casual mode or show your inner brick and jump into an infection lobby. More game modes soon to come..\n\u2757\ufe0f\u2757\ufe0fBIG UPDATES CONSTANTLY\u2757\ufe0f\u2757\ufe0f\nWe do our best to get out updates every week or every other week to best support our community. We built what the community wants!\n\ud83c\udfc0 SHOOT HOOPS LIKE NEVER BEFORE \ud83c\udfc0\nHit the basketball court for some epic trick shots. Whether you\u2019re a baller or just want hit some jumpers, the court is yours.\n\ud83d\udecd\ufe0f EXPLORE THE MALL AND GET COSMETICS \ud83d\udecd\ufe0f\nVisit our in-game mall and deck out your brick with an array of cosmetics. From funky outfits to stylish accessories, there\u2019s something for everyone.\n\ud83e\udd73 JOIN THE BRICK TAG NOW \ud83e\udd73\nReady to experience life as a brick? Join the Brick Tag now and embark on a tiny, yet massive adventure. Play for free and let the fun begin! Join our Discord to get support or find people to play with: https://discord.gg/3FV4u7xsbq", "short_description": "\ud83e\udd8d BRICK TAG: UNLEASH YOUR INNER BRICK \ud83e\udd8d\nShrink down to action figure size and explore an exciting room as a brick. With no legs and a lot of personality, you\u2019ll run on your hands through various fun-filled activities."}]}, "developer_name": "KingKelley", "developer_privacy_policy_url": "https://sites.google.com/view/bricktag", "developer_terms_of_service_url": null, "publisher_name": "KingKelley", "support_website_url": null, "website_url": "https://sites.google.com/view/bricktag", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1297262810130389"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491827601_1574541077710709_7
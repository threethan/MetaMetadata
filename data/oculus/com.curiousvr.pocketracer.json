n.com&_nc_ss=8&oh=00_Afx4lLtRBOwv1F3OgLCSLaO06Vj0VQoGOsqFAlb8pv2UuA&oe=69AAAF82"}, {"file_name": "p03.png", "id": "3070778193046892", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974868_3070778196380225_6643569268237598808_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BD79kkU1Vq4Q7kNvwHXhiQa&_nc_oc=AdkTFy9t5Kgy-9vJKH_Hxn9xLB6bmKjCTwY8zPMyt43GaENtaDX6-WY3yGJ0siSjRHM&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwfj_WDndmj0cM-woR1K3vxuNJ-c_T7rVDBHgzGGAlhEg&oe=69AABC31"}, {"file_name": "p04.png", "id": "347876463545665", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39003231_347876466878998_7836253675861589563_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvV90h2U0B4Q7kNvwFiZXfi&_nc_oc=AdmYq_AOnBeu-DGzZ4Y_uaVs6E-CzEV5iaPeUtNsyqfNZCcU2vPwyPmEqb2epnd4mcI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzL6xQBGBtO8F6isIEZZLRwhCItp7ukaFoLMEbb4A0EIA&oe=69AACDCA"}, {"file_name": "p05.png", "id": "999879650552861", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974910_999879653886194_4761283769623865543_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rX6d4dsRzRsQ7kNvwGSqqYg&_nc_oc=Adnd0GVsxEP2Tb-icriNU2V6bN5-Ns6wziFPdZf0pDutkuszZ6WzZPCJwTLB58jNwlQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWYv_vZzJ7HieWv7-VCLJ-Iuuna9JN-gVYfZK3cMts5g&oe=69AADD89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pocket Racer : Sandbox Engine", "keywords": [], "long_description": "This version is the Pocket Racer : Sandbox Edition. It allows you to create your own tracks, choose from all the different car options, scale time, race in first-person or miniature (micromachine scale, RC Car scale) as well as publish your own tracks online.\n\nA CREATIVE SANDBOX TO CREATE\n\nBuild whatever wild driving fantasy you want with a large selection of track pieces, ramps, half pipes, portals, speed boosters, ice tracks and more!  Experiment with your own creations using the 5 default save slots, and when you are ready, publish your track online to allow other racers to compete for the best time. You can watch the replays of all previous racers, and compete to be the king of your own creation!\n", "short_description": "Pocket Racer is a competitive online racing sim and track builder"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curiousvrlabs.wixsite.com/home/general-8", "developer_terms_of_service_url": null, "publisher_name": "Curious VR", "support_website_url": null, "website_url": "https://curiousvrlabs.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SIMULATION", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "4875516125862755"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "650468312630791"}, {"status": "PUBLISHED", "id": "434418654605589"}]}, "baseline_offer": {"id": "650468312630791"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1637343600, "status": "PUBLISHED", "id": "650468312630791"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4962141847153645", "version": "6"}, "id": "531070281299362", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "
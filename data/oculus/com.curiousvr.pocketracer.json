le_name": "racerNEWCOVER.png", "id": "1031612920966816", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031582_1031612924300149_4984822269060331165_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxwYeu6V08UQ7kNvwELoYDf&_nc_oc=AdrXDtGNwt06TY9gm35AHvHlu2gxrHq74gNVaMjYADbfSbUACQRyAzDc8vD-lUzLljw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6heE5poe-4avZSTlxNsiYeXrX41lze_4E_zgA3cP-v4g&oe=6A0DA972"}, "display_name": "Pocket Racer : Sandbox Engine", "keywords": [], "long_description": "A CREATIVE SANDBOX TO CREATE\n\nPocket Racer : Sandbox Edition give you the freedom to:\n\n- Create your own tracks from 100 prefab sections\n- Choose from 8 different vehicles, including monster trucks, indy cars and motorbikes\n- Race in first-person (grab the virtual wheel) or miniature (micromachine, Hot Wheel or RC Car scale) \n- Publish your own tracks online for others to race and compete for lap records\n- View replays of all other racers who have completed a race on your tracks.\n\n\nImagine your wildest driving fantasy... build whatever you want with a large selection of track pieces, ramps, half pipes, portals, speed boosters, ice tracks and more!  Experiment with your own creations using the 5 default save slots and when you are ready you can publish your track online. Invite other players and compete to be the king of your own creation!\n\nCuriousVR is a solo gamedev and this project is in active development. Feel free to reach out with feature request, comments and concerns.\n \n", "short_description": "Pocket Racer is a competitive online racing sim and track builder. Choose from 8 different vehicles, build your own tracks and race online against other players!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curiousvrlabs.wixsite.com/home/general-8", "developer_terms_of_service_url": null, "publisher_name": "Curious VR", "support_website_url": null, "website_url": "https://curiousvrlabs.wixsite.com/home", "category"
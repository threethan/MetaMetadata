t-iad6-1.oculuscdn.com/v/t64.5771-25/38974910_999879653886194_4761283769623865543_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbBoMsx7xagQ7kNvwFSBOst&_nc_oc=Adq0apkPaKAocU7lZ2Q7pSuk0wHF7wMCn2Gcc3A2y8APEsmmKOIwt2I12Xr-GLvKO6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUEnGgFuE_7V9kmcrr73PkcL4WFtdk-sMZkjzbr_3ON5Q&oe=6B0F0AC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "racerNEWCOVER.png", "id": "1031612920966816", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031582_1031612924300149_4984822269060331165_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3apa-RhoTU0Q7kNvwH5YUy9&_nc_oc=Adr9PSw8L5oez85mQ3xzXTadp5NkeW9vx_QFApXgjsV9P-eDc3qz30mSE1ikPOG-xCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX3UmligUfEXWn3i8cLkeVgNldNsNh52qoYDI4JuXYzXw&oe=6B0EF632"}, "display_name": "Pocket Racer : Sandbox Engine", "keywords": [], "long_description": "A CREATIVE SANDBOX TO CREATE\n\nPocket Racer : Sandbox Edition give you the freedom to:\n\n- Create your own tracks from 100 prefab sections\n- Choose from 8 different vehicles, including monster trucks, indy cars and motorbikes\n- Race in first-person (grab the virtual wheel) or miniature (micromachine, Hot Wheel or RC Car scale) \n- Publish your own tracks online for others to race and compete for lap records\n- View replays of all other racers who have completed a race on your tracks.\n\n\nImagine your wildest driving fantasy... build whatever you want with a large selection of track pieces, ramps, half pipes, portals, speed boosters, ice tracks and more!  Experiment with your own creations using the 5 default save slots and when you are ready you can publish your track online. Invite other players and compete to be the king of your own creation!\n\nCuriousVR is a solo gamedev and this project is in active development. Feel free to reach out with feature request, comments and concerns.\n \n", "short_description": "Pocket Racer is a competitive online racing sim and track builder. Choose from 8 different vehicles, build your own tracks and race online against other players!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curiousvrlabs.wixsite.com/home/general-8", "developer_terms_of_service_url": null, "publisher_name": "Curious VR", "support_website_url": null, "website_url": "https://curiousvrlabs.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SIMULATION", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1002383020680331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982629_374806870875122_4546442512612869829_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjIBgZIDUdEQ7kNvwF4FuYA&_nc_oc=AdpTT6TeUBU5-eO5-Ry-ewhmse4W0wdA_MAT8P_G5UyTSuAC1HRIWzuZEsAy7FZe95c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUa8Rcg87lRtLsu78oLErSQLP7zUstz0lbxgTwO-Ww0gw&oe=6B0F17C4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pocket Racer : Sandbox Engine", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}], "release_date": 1633507200
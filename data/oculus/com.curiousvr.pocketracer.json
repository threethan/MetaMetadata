tless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbc59UPwm9QQ7kNvwG0_ohk&_nc_oc=AdrqKUI0wPpYQDhmvB_15E-YTxBf_6xXJlMX0EYJVlkon8LFOBXLzAwWQ7rjLRrQ-D0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbfHOsywvkREqntrE8qAEO7l8bpYwO3ppZ0HjtJLJ2qw&oe=6B005209"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pocket Racer : Sandbox Engine", "keywords": [], "long_description": "This version is the Pocket Racer : Sandbox Edition. It allows you to create your own tracks, choose from all the different car options, scale time, race in first-person or miniature (micromachine scale, RC Car scale) as well as publish your own tracks online.\n\nA CREATIVE SANDBOX TO CREATE\n\nBuild whatever wild driving fantasy you want with a large selection of track pieces, ramps, half pipes, portals, speed boosters, ice tracks and more!  Experiment with your own creations using the 5 default save slots, and when you are ready, publish your track online to allow other racers to compete for the best time. You can watch the replays of all previous racers, and compete to be the king of your own creation!\n", "short_description": "Pocket Racer is a competitive online racing sim and track builder"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curiousvrlabs.wixsite.com/home/general-8", "developer_terms_of_service_url": null, "publisher_name": "Curious VR", "support_website_url": null, "website_url": "https://curiousvrlabs.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SIMULATION", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["
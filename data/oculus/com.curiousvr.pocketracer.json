t-sjc3-1.oculuscdn.com/v/t64.5771-25/38974910_999879653886194_4761283769623865543_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbc59UPwm9QQ7kNvwF1rdY3&_nc_oc=AdolLeOLbTWnsTWi1vdMUeHGSdvKXPDS3-Qgc-a0Ma7Q-Nhfj-RfQYPKv7VVDpwI564&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS1dHJ_B5WggWjC67pakxQue6oeQaWDrjdkvjJ_aZ2MA&oe=6B032D49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "racerNEWCOVER.png", "id": "1031612920966816", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031582_1031612924300149_4984822269060331165_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeWngajxYGUQ7kNvwH-OTMr&_nc_oc=AdpyCID6lOkSyB4eQcap_RfTZkxH8KdWbBA_NmggbSMY23AqHl311cxRoDvPO9IFFUk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR2bYyrVhm7WAuCDZhYWa9bHox5pBMewvxP_PDtnsSHw&oe=6B0318B2"}, "display_name": "Pocket Racer : Sandbox Engine", "keywords": [], "long_description": "A CREATIVE SANDBOX TO CREATE\n\nPocket Racer : Sandbox Edition give you the freedom to:\n\n- Create your own tracks from 100 prefab sections\n- Choose from 8 different vehicles, including monster trucks, indy cars and motorbikes\n- Race in first-person (grab the virtual wheel) or miniature (micromachine, Hot Wheel or RC Car scale) \n- Publish your own tracks online for others to race and compete for lap records\n- View replays of all other racers who have completed a race on your tracks.\n\n\nImagine your wildest driving fantasy... build whatever you want with a large selection of track pieces, ramps, half pipes, portals, speed boosters, ice tracks and more!  Experiment with your own creations using the 5 default save slots and when you are ready you can publish your track online. Invite other players and compete to be the king of your own creation!\n\nCuriousVR is a solo gamedev and this project is in active development. Feel free to reach out with feature request, comments and concerns.\n \n", "short_description": "Pocket Racer is a competitive online racing sim and track builder. Choose from 8 different vehicles, build your own tracks and race online against other players!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://curiousvrlabs.wixsite.com/home/general-8", "developer_terms_of_service_url": null, "publisher_name": "Curious VR", "support_website_url": null, "website_url": "https://curiousvrlabs.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING", "SIMULATION", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1002383020680331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982629_374806870875122_4546442512612869829_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY4-hQ5KL0kQ7kNvwHytQO_&_nc_oc=AdpQx9PLQEI_us8HTq_S7SGO8KoYL2xnb73FCrhL6_eq_6UL4pP_pZUUShHMAu_c7Dg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSi5lyDx2gzaqixA4zkEbwksMqBLV52F3Rn3AQC6b6Nrw&oe=6B030204"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Pocket Racer : Sandbox Engine", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Racing", "id": "673385183287495"}], "release_date": 1633507200
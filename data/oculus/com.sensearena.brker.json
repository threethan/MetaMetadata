G2cZqlEzhOuhxiEbb88AQJ2BYRWMg&oe=6A564CB8"}, {"file_name": "5 Outdoor court.png", "id": "1434031831807251", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823341_1434031838473917_2573411557216878358_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hHybRQ-wQwEQ7kNvwHHDMtT&_nc_oc=Adrtx4b9dZLC_sRHLHP7TOflerIozwUfLHdW8v5s060A6NMXMXGPt56QU_Ty_Uhf8Tk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBrMLEV46gByA4_DqtPLHzJfUh2AXT3Z_mF2xS_YTFvw&oe=6A5623AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Frame 1 (3).png", "id": "1271301798059646", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499619751_1271301801392979_5658282335358557074_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IirDlY7H-2gQ7kNvwG8vNs4&_nc_oc=Adq72N8p04c4Z_VqZlyXt9eFQ7SSYY_G8OW7xGuxs7YB-zTXpVTISsgtct0Dq-dKTv8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzrA88PAmqghoJjRheR5fKeb3mhu3vcsimsqTwA30m1w&oe=6A563E72"}, "display_name": "Brker", "keywords": ["basketball", "NBA", "MR", "gymclass", "hoops"], "long_description": "# BRKER is a free mixed reality basketball game where you dribble a real basketball inside fast-paced arcade-style worlds while learning to keep your eyes up and read the game.\n\nJump into the game anywhere\u2014your living room, hallway, bedroom, a basketball gym, or even outside in shaded areas\u2014and turn your space into a playable basketball court.\n\n{27163236266605794}\n\nDodge obstacles, unlock new levels, collect bonuses, and react in real time as the game builds your basketball control, awareness, and decision-making.\n\nFEATURES\n- FREE to download and play\n- Real basketball dribbling in mixed reality\n- Trains you to keep your eyes up and react faster\n- Play at home, in a gym, or outdoors in the shade\n- Fast arcade gameplay with levels, scores, and combos\n- Unlock new mechanics as you progress\n- Dynamic obstacles and interactive challenges\n- Compete for leaderboard rankings\n- Designed for quick sessions or long runs\n\nBRKER blends the feel of real basketball with the energy of modern gaming. Take the court with you, anywhere you choose to play.\n\n{1300164145630864}", "short_description": "Free basketball game using mixed reality. Dribble a real basketball and play fast-paced arcade challenges at home, in the gym, or outside in the shade. Dodge oncoming obstacles to earn points, enter new levels, and own the courts!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.brker.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sense Arena LLC", "support_website_url": null, "website_url": "https://www.brker.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26099491146384474"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "25358519653821354"}]}, "baseline_offer": {"id": "25358519653821354"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779258420, "status": "PUBLISHED", "id": "25358519653821354"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27355126307487612", "version": "1.0.39B"}, "id": "1264862159170761", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "Andro
t-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDssSHiCVGX5eb_HRdMfu9myhTvgp-Hb1BgscddyfLORA&oe=6A5622EE"}, {"file_name": "3 Playground Run.png", "id": "1558064732648390", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821796_1558064742648389_2687002079259222984_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7e7eAgu9ObIQ7kNvwF2ildw&_nc_oc=AdoNpMxpqsWe-Q2EVZwSZyWhAGzhbLItMGwrrbin_0jnMS1U1Zej3wMMb7rkY9OC5WE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIiE095MXvubGwEHcFMo5K7Vf1zgNEZsAo-8AbSlyl-A&oe=6A5631CF"}, {"file_name": "4 City court.png", "id": "1347563260566284", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819239_1347563263899617_4826669091242508733_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YkWVELTlCgQ7kNvwF8oZHH&_nc_oc=AdqX3mi8syWtEAnCB8CTF8f1RjeqSPIzs6lfbYpLtH-5VANT6fggXN8cylscXkJWgws&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-Tu_SKS8kH4AwPG2cZqlEzhOuhxiEbb88AQJ2BYRWMg&oe=6A564CB8"}, {"file_name": "5 Gym 1.png", "id": "2381945288959094", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491823296_2381945292292427_1651749459827870152_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA4fqdEjfREQ7kNvwH2V1QL&_nc_oc=AdqcDAeWy_iTC5sAc8rArSgpY4OKXADWO9C8zLod0zIwg5hc57qtC1z2CEp791UMBMU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBl5NiFKaciJrDy5kwcfO8SbZBtHov69Qtw03KMwTlXOA&oe=6A564214"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer thumbnail (1).png", "id": "27923226897279731", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619697_27923226923946395_6999107087125429570_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnOM2qMRvE8Q7kNvwGKjZNf&_nc_oc=AdoIYst4FHWhAYp203jUKzDyoenMccGnLb5UiQpjgCCV9eBggIDhO8xkGpfLfJbAAQg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdz2UppQWg69v0GDTSrRCyUUXLktklI-5nPUUOeYWetg&oe=6A5640AC"}, "display_name": "Brker Basketball", "keywords": ["basketball", "NBA", "gymclass", "hoops", "mixedreality"], "long_description": "# BRKER is a free mixed reality basketball experience for Meta Quest, bringing arcade action to your real-world court.\n\nPick up a REAL basketball, enable HAND tracking, and ROOM-scale boundary, and navigate through high-speed obstacle courses in your living room, the gym, or shaded outdoor spaces.\n\n{27163236266605794}\n\nForget about pressing buttons; this is authentic ball handling, physical movement, and real-time reactions driven by mixed reality.\n\n{2099949223911970}\n\nEvade obstacles, snag bonus items, and rack up points with dunks. Your movement speed is tied directly to your dribbling pace.\n\nBy merging the intensity of arcade play with genuine athletic motion, BRKER creates a unique environment for both athletes and gamers.\n\n{1699781108036227}\n\nDodge obstacles, unlock new levels, collect bonuses, and react in real time as the game builds your basketball control, awareness, and decision-making.\n\nFEATURES\n\n\ud83c\udfc0 Physical basketball required\nIntegrate your own ball for a truly tactile gameplay experience.\n\n\ud83d\udd90 Advanced hand tracking\nDitch the controllers and interact with the game using natural movements.\n\n\u26a1 High-energy arcade gameplay\nReact and score as you survive challenges that scale in difficulty.\n\n\ud83c\udfe0 Versatile play areas\nTransform any safe, shaded space\u2014from home to the gym\u2014into a playable arena.\n\n\ud83d\udcc8 Unlockable progression\nDiscover new interactive levels and sharpen your performance with every session.\n\n\ud83d\udd25 Skill-based training\nEnhance your agility, reaction time, and vision while playing through dynamic worlds.\n\n\n\n\n{1727720918218353}", "short_description": "Brker is a free mixed reality basketball arcade game. Grab a REAL basketball, switch to HAND tracking, and play in a ROOM-scale space at home, in the gym, or outdoors in shade. Catch bonus balls. Dodge obstacles. Dunk for points. The faster you dribble, the faster you move."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.brker.app/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sense Arena LLC", "support_website_url": null, "website_url": "https://www.brker.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27112277631772482"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/604275479_1793115078338787_4788485905310914234_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1t6Tz3EdX0Q7kNvwE6i2vU&_nc_oc=AdrBjGZU-IyrCDDOlh4nXsX0tTG0R8hoZAHAfU5WY5ayLyvE0eTIicEPNhCWANa0vZM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp-Bh-3wBOn8-rAu1KjrYUJ4mnjT2huQQoDTUBPsBPvA&oe=6A564D91"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brker Basketball", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1779258420, "lastRevision": {"nodes": [{"id": "26099491196384469", "release_type": "SCHEDULED", "administration_status": "APPRO
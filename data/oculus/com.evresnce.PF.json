A&oe=69B54F2B"}, {"file_name": "PopcornFrenzy_Screenshot_02.png", "id": "4141058232795793", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391714_4141058236129126_5940555616928770346_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8CX_AZ4Y7QQ7kNvwFhMyo4&_nc_oc=AdnQPUX00Obti3bpp5g0hYGQo9EDW8hJqSTut35lvJSPfipf5hc0a6LBtWJ61AeQT60&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz4oE1MCBBgif2Y0-0X660sYE5WzOiVnvyde1ap2db67A&oe=69B55C0E"}, {"file_name": "PopcornFrenzy_Screenshot_03.png", "id": "1239063567818231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391835_1239063571151564_6127348317385178373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HtAEXnmFyIQ7kNvwGD_7jR&_nc_oc=AdlaMf1nhR1AO0hQa3F-dRZbQNYqlmuoWJA5gZL4LQ1VNBXDArKX72lw-aqSGbxAfm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVSYzfXzXk0FFOX5TNtmtEQenvgOX_9LTvAEtZq5wt0g&oe=69B55A9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Popcorn Frenzy", "keywords": ["fun", "popcorn", "frenzy", "free", "game"], "long_description": "You\u2019ll come across a box of popcorn just sitting there, and the fun begins when you interact with it! Once you take action, giant popcorn will start popping out of the box at an incredible rate, quickly filling the entire room with fluffy kernels. The chaos of popcorn spilling everywhere makes for a light-hearted, immersive experience\u2014perfect for a quick laugh prank or a stress-free moment.\n\n\"Popcorn Frenzy\" is part of the Confort Games series, an original take on the concept of confort food: simple, pleasing and affordable!\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/popcornfrenzy-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Confort Games", "support_website_url": null, "website_url": "https://www.evresnce.com/popcornfrenzy", "category": null, "c
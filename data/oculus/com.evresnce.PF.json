714_4141058236129126_5940555616928770346_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04QR9oYgh_IQ7kNvwF4drkf&_nc_oc=Ado2ma2njDDN2uk1jUNN60-XKxGYLQ7LVzlGeNrLWLyBCgehk8H1gKioMhDFAR4kWUo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkiUFdKjMYFUV5Wms4UNCedXSVnspvbg7gbAvcaY7hmg&oe=6B007CCE"}, {"file_name": "PopcornFrenzy_Screenshot_03.png", "id": "1239063567818231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391835_1239063571151564_6127348317385178373_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEzI8H79Qq0Q7kNvwFx5Xi4&_nc_oc=Adpjsr0LHCZxIvFJ2_h8QO3JiaWJO4QG5RbzaSsitLdAOU-S3JkWFeaoqTHTpocHBrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrC__BBizRsKwMhiNHDX1WO2epHd2hGsb8uMsH5YPm8w&oe=6B007B5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Popcorn Frenzy", "keywords": ["fun", "popcorn", "frenzy", "free", "game"], "long_description": "You\u2019ll come across a box of popcorn just sitting there, and the fun begins when you interact with it! Once you take action, giant popcorn will start popping out of the box at an incredible rate, quickly filling the entire room with fluffy kernels. The chaos of popcorn spilling everywhere makes for a light-hearted, immersive experience\u2014perfect for a quick laugh prank or a stress-free moment.\n\n\"Popcorn Frenzy\" is part of the Confort Games series, an original take on the concept of confort food: simple, pleasing and affordable!\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/popcornfrenzy-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Confort Games", "support_website_url": null, "website_url": "https://www.evresnce.com/popcornfrenzy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035
f-Sqn3QzLteTJYn76ZDF71dhM0aOFwPnAn9coMgIASaLw&oe=6A29532B"}, {"file_name": "PopcornFrenzy_Screenshot_02.png", "id": "4141058232795793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391714_4141058236129126_5940555616928770346_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kTSQw9D-DMQ7kNvwHI8YYU&_nc_oc=Adq4i840b6vSwwprOHDEB7Gi2ScxuTN1ffTstGPw9nofA5uY288i3JLxbNRrS9mjRrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pH3JTEP9Zl-2-MnYcWibil-B66soQwri_H_7FyyFzYg&oe=6A29600E"}, {"file_name": "PopcornFrenzy_Screenshot_03.png", "id": "1239063567818231", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391835_1239063571151564_6127348317385178373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90brVq3yEGAQ7kNvwEhgEgM&_nc_oc=Adpwey_l9tL9zrwnHh1FdIL8yH4PFGT0DjJ6uBEUHNZeItYDIFhJp-YKt54Czr4-j9E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af926K_cF5Mqqb_eXSOgVDTBt7mR8JoSmfnPIm_M8J9Ieg&oe=6A295E9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Popcorn Frenzy", "keywords": ["fun", "popcorn", "frenzy", "free", "game"], "long_description": "You\u2019ll come across a box of popcorn just sitting there, and the fun begins when you interact with it! Once you take action, giant popcorn will start popping out of the box at an incredible rate, quickly filling the entire room with fluffy kernels. The chaos of popcorn spilling everywhere makes for a light-hearted, immersive experience\u2014perfect for a quick laugh prank or a stress-free moment.\n\n\"Popcorn Frenzy\" is part of the Confort Games series, an original take on the concept of confort food: simple, pleasing and affordable!\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/popcornfrenzy-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Confort Games", "support_website_url": null, "website_url": "https://w
f_YgkscBPQvi1TuQsFoIV-opAFOQxwlLZLQgbt4hSI3sw&oe=6A2596EB"}, {"file_name": "PopcornFrenzy_Screenshot_02.png", "id": "4141058232795793", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391714_4141058236129126_5940555616928770346_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2paSauneBPMQ7kNvwGI_dKw&_nc_oc=AdrFQMyWyTBIOyRpUWrkkX3NWp7BPYIKAI6pN9W6X_v1HM84UulN_tPi1FnNTgt1RIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RyyrKRbJZU-hO-0VhveF1aoWbotXLSDroXRF17agiCg&oe=6A25A3CE"}, {"file_name": "PopcornFrenzy_Screenshot_03.png", "id": "1239063567818231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391835_1239063571151564_6127348317385178373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYFaxuw6HkUQ7kNvwHy2kOu&_nc_oc=Adrdaz5LONf281vuHLIdfxXeD_Xx7mAQCgRR_cTRVMqh2_dyAFroN63b_Deh5F_wucU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RqAY5fIc7xOitRI8f1GcdrFJ2qtUjDdoewDVuNb4gNg&oe=6A25A25A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Popcorn Frenzy", "keywords": ["fun", "popcorn", "frenzy", "free", "game"], "long_description": "You\u2019ll come across a box of popcorn just sitting there, and the fun begins when you interact with it! Once you take action, giant popcorn will start popping out of the box at an incredible rate, quickly filling the entire room with fluffy kernels. The chaos of popcorn spilling everywhere makes for a light-hearted, immersive experience\u2014perfect for a quick laugh prank or a stress-free moment.\n\n\"Popcorn Frenzy\" is part of the Confort Games series, an original take on the concept of confort food: simple, pleasing and affordable!\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/popcornfrenzy-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Confort Games", "support_website_url": null, "website_url": "https://w
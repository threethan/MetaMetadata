fwKYRqAN_tE3aSniWvFAkhgxySaT9a4iwwuKrcrt8isXA&oe=69C27E2B"}, {"file_name": "PopcornFrenzy_Screenshot_02.png", "id": "4141058232795793", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391714_4141058236129126_5940555616928770346_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYfYTpaW5mcQ7kNvwHSTmDV&_nc_oc=AdpPkCcbgiv9WWzL3yGuhC9X_HO2KaRkUeGTNxISmLjNg61NVsgIqIb_10unIinFMC8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqYQOfkghA9mmrPcu6FfXpHD6qPyHAl7Vhi64cBTKOhQ&oe=69C28B0E"}, {"file_name": "PopcornFrenzy_Screenshot_03.png", "id": "1239063567818231", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391835_1239063571151564_6127348317385178373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=soAlfmjSkREQ7kNvwEc6WQ9&_nc_oc=Adr92vAN6SRO634EkZPu_Wjj_RcN2r7Xc2mX-ngttO9yQR5xe4HKmdpeMIyM_bA-g_c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyU9R1yayXfArUYLxB4_ILGp6W30uBYgqRrh7zYr_9g_w&oe=69C2899A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Popcorn Frenzy", "keywords": ["fun", "popcorn", "frenzy", "free", "game"], "long_description": "You\u2019ll come across a box of popcorn just sitting there, and the fun begins when you interact with it! Once you take action, giant popcorn will start popping out of the box at an incredible rate, quickly filling the entire room with fluffy kernels. The chaos of popcorn spilling everywhere makes for a light-hearted, immersive experience\u2014perfect for a quick laugh prank or a stress-free moment.\n\n\"Popcorn Frenzy\" is part of the Confort Games series, an original take on the concept of confort food: simple, pleasing and affordable!\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/popcornfrenzy-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Confort Games", "support_website_url": null, "website_url": "https://w
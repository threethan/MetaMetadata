f-gKOHjF258r6xbbq-FrgTiGG2GxJtWMLri-VJ6kgGzJw&oe=6A26E86B"}, {"file_name": "PopcornFrenzy_Screenshot_02.png", "id": "4141058232795793", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391714_4141058236129126_5940555616928770346_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2paSauneBPMQ7kNvwELHYC8&_nc_oc=Adqfs5SiTZnHoPaplUTDVZdNLIeDyj7UK_9Z5Eh8G7t2LLoBI56P-fexeIVNZjA3kT8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oiuXC90axsi4ls9tPzJSCjcilAEg3-G5U1vIMbBBQWg&oe=6A26BD0E"}, {"file_name": "PopcornFrenzy_Screenshot_03.png", "id": "1239063567818231", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/473391835_1239063571151564_6127348317385178373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=90brVq3yEGAQ7kNvwGuMOZR&_nc_oc=AdpQ7-D_FWDp3cijSI7Yj0xIlsCVMcUjT2_HH8U5y77LauSlFA8u-t3QbTYNgW7lGI4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86OY12YYsEqsYUd8Eolx9zUDhvdMdZsFFO55AA_KB5sQ&oe=6A26BB9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Popcorn Frenzy", "keywords": ["fun", "popcorn", "frenzy", "free", "game"], "long_description": "You\u2019ll come across a box of popcorn just sitting there, and the fun begins when you interact with it! Once you take action, giant popcorn will start popping out of the box at an incredible rate, quickly filling the entire room with fluffy kernels. The chaos of popcorn spilling everywhere makes for a light-hearted, immersive experience\u2014perfect for a quick laugh prank or a stress-free moment.\n\n\"Popcorn Frenzy\" is part of the Confort Games series, an original take on the concept of confort food: simple, pleasing and affordable!\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/popcornfrenzy-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Confort Games", "support_website_url": null, "website_url": "https://w
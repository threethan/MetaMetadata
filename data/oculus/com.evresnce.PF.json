le_name": "PopcornFrenzy_Screenshot_02.png", "id": "4141058232795793", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391714_4141058236129126_5940555616928770346_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAU-Bzpt4_cQ7kNvwE4H1H2&_nc_oc=AdqWq9_GG3d6bvoYT1ZYLHpZ1wKHWAeLMg1eRZI5Sdh4SnPyAPH0DnNHaf8Q-V6HzCk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af3j0T9iRBPV58LFk3JpjSEUnh0x-LHr3DnvDBBI0AxdpQ&oe=69F2010E"}, {"file_name": "PopcornFrenzy_Screenshot_03.png", "id": "1239063567818231", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391835_1239063571151564_6127348317385178373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=citKX-8iQz0Q7kNvwGOBrkg&_nc_oc=AdrF75WMie6EqHMrKRvdmAA4zRKQAEfc0ZmFGQ4spAICesbAdS9No3iWtKHrhGbKdi4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1cY2pQ7On5v1ZI8sz9YAEzSDH42HF7WqeWXAEoQmwa7w&oe=69F1FF9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Popcorn Frenzy", "keywords": ["fun", "popcorn", "frenzy", "free", "game"], "long_description": "You\u2019ll come across a box of popcorn just sitting there, and the fun begins when you interact with it! Once you take action, giant popcorn will start popping out of the box at an incredible rate, quickly filling the entire room with fluffy kernels. The chaos of popcorn spilling everywhere makes for a light-hearted, immersive experience\u2014perfect for a quick laugh prank or a stress-free moment.\n\n\"Popcorn Frenzy\" is part of the Confort Games series, an original take on the concept of confort food: simple, pleasing and affordable!\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/popcornfrenzy-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Confort Games", "support_website_url": null, "website_url": "https://www.evresnce.com/popcornfrenzy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST",
-free moment.\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": "Comfort Games", "developer_privacy_policy_url": "https://evresnce-games.com/popcornprank-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Comfort Games", "support_website_url": null, "website_url": "https://evresnce-games.com/popcornprank", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27940464085550331"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473391974_522100030917665_8983529292992068633_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jaLvwduq2oIQ7kNvwFSVk3v&_nc_oc=AdoiIlYsVsaak-XbC2cfX2Ylvj3XGX7uoul5xoRyH9p669S0E-mkqXNPe8btmch2KEo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr5WhB_lEo6z8F_F6oIPIRyjZoO6iIalYtrnNyJR7u_g&oe=6AA40FF4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Popcorn Prank", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 1738860840, "lastRevision": {"nodes": [{"id": "9304355172921171", "release_type": "SCHEDU
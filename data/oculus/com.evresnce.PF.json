f1mGe3EnoL2x0Y_yQ-zDqdjqvXAM5Hl-sh2lxmKgOnccg&oe=69E8B9AB"}, {"file_name": "PopcornFrenzy_Screenshot_02.png", "id": "4141058232795793", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391714_4141058236129126_5940555616928770346_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbwT-BktzwMQ7kNvwFttj8j&_nc_oc=AdpiGI6tl_DUTtYQlKDywvhKk8jRBVQXdrTeNnsS4qKLgONMrx27GZ92lRTzhN1x2es&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zUKqt0EXKdsJWzXWdopS3cVLeUBB7GeGeYtSoloUk3w&oe=69E8C68E"}, {"file_name": "PopcornFrenzy_Screenshot_03.png", "id": "1239063567818231", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391835_1239063571151564_6127348317385178373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xKAI3dC1F1sQ7kNvwGvhLHm&_nc_oc=AdoQkhwOlgEa5qNJgV9qNmLp_AGqLJeyv0xmqJIEbXtu-rEhQMaJu3l5PrEyMmvzUT0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PqzhwgXwUq0aF6v_3Yvz3YmupJO-Ak6owhmIgLck6jw&oe=69E8C51A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Popcorn Frenzy", "keywords": ["fun", "popcorn", "frenzy", "free", "game"], "long_description": "You\u2019ll come across a box of popcorn just sitting there, and the fun begins when you interact with it! Once you take action, giant popcorn will start popping out of the box at an incredible rate, quickly filling the entire room with fluffy kernels. The chaos of popcorn spilling everywhere makes for a light-hearted, immersive experience\u2014perfect for a quick laugh prank or a stress-free moment.\n\n\"Popcorn Frenzy\" is part of the Confort Games series, an original take on the concept of confort food: simple, pleasing and affordable!\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/popcornfrenzy-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Confort Games", "support_website_url": null, "website_url": "https://w
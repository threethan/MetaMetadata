f2vjcbN9VjP5EsAnbvTX1QurwgcO-pv3Ssg22r7xdIjJQ&oe=69DB8AAB"}, {"file_name": "PopcornFrenzy_Screenshot_02.png", "id": "4141058232795793", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391714_4141058236129126_5940555616928770346_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1bBRQDw3sgQ7kNvwFEMZ_4&_nc_oc=AdotOon_SzBIuNkpUL-asGhG0Jbb-oUSdECTS-E734JmDo1gXA0D8F6H_VkLXcPlDTA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05NT-jkOeqdfl_shUstrTveeZcuJiyd29lomTMTKyuYQ&oe=69DB978E"}, {"file_name": "PopcornFrenzy_Screenshot_03.png", "id": "1239063567818231", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391835_1239063571151564_6127348317385178373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Knxsc_xeVpsQ7kNvwFFJmV0&_nc_oc=Adoms6zsURKvq6K9q9W5q3AIorxYX7VWQ0BYRErWbwA07-pipcInkXDMf1QwmtCC03s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jIzIrVkwdXrwplhAV5DfhPzg-_BUYGwoEI8GdvYlDEA&oe=69DB961A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Popcorn Frenzy", "keywords": ["fun", "popcorn", "frenzy", "free", "game"], "long_description": "You\u2019ll come across a box of popcorn just sitting there, and the fun begins when you interact with it! Once you take action, giant popcorn will start popping out of the box at an incredible rate, quickly filling the entire room with fluffy kernels. The chaos of popcorn spilling everywhere makes for a light-hearted, immersive experience\u2014perfect for a quick laugh prank or a stress-free moment.\n\n\"Popcorn Frenzy\" is part of the Confort Games series, an original take on the concept of confort food: simple, pleasing and affordable!\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/popcornfrenzy-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Confort Games", "support_website_url": null, "website_url": "https://w
f59y_-D4cfgSVJwwUBjx-EOhbpalekZgR_seK8QCc3aJA&oe=6A09AF2B"}, {"file_name": "PopcornFrenzy_Screenshot_02.png", "id": "4141058232795793", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391714_4141058236129126_5940555616928770346_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7nIGx-gnE9gQ7kNvwGYnQRj&_nc_oc=AdrWzH_QD5WtazmJKIYTHdkm1DWCSYxm-AM7f_cbhlAp7g3YOpmf8hh3KQS_klb4-Ls&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C6B1DWi6YA6EyHojuCafSUSueoHvrxxVe3vz0eJLWlA&oe=6A09BC0E"}, {"file_name": "PopcornFrenzy_Screenshot_03.png", "id": "1239063567818231", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/473391835_1239063571151564_6127348317385178373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1M8_Bs-aX58Q7kNvwFFUQKM&_nc_oc=Adq9yKXe-3uLiPWGX-rBdPsDuM2sxN94AWZwaZqYZ4Izvj6uLMD5t1gVbP1F2cG431M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MpCaTSuaQz5ldc54z_USKX3cryMB21tkrcXD20KLlng&oe=6A09BA9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Popcorn Frenzy", "keywords": ["fun", "popcorn", "frenzy", "free", "game"], "long_description": "You\u2019ll come across a box of popcorn just sitting there, and the fun begins when you interact with it! Once you take action, giant popcorn will start popping out of the box at an incredible rate, quickly filling the entire room with fluffy kernels. The chaos of popcorn spilling everywhere makes for a light-hearted, immersive experience\u2014perfect for a quick laugh prank or a stress-free moment.\n\n\"Popcorn Frenzy\" is part of the Confort Games series, an original take on the concept of confort food: simple, pleasing and affordable!\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/popcornfrenzy-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Confort Games", "support_website_url": null, "website_url": "https://w
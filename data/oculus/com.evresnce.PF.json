f3MwSBUcwlTWulyahyMA0IKE86x-L_4pZRUV-trf_PUfA&oe=69D3A1AB"}, {"file_name": "PopcornFrenzy_Screenshot_02.png", "id": "4141058232795793", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391714_4141058236129126_5940555616928770346_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PY39EWzPQ54Q7kNvwFAnVFc&_nc_oc=AdobecAmSRglJaQ6QUaB1k1OeofY_ZsTo3elZFKXHrGQnyrJfHUbGePSwCBgs01OsHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-GYzgDc67Rs9tCnx_vj49kSiH-_j2JfVQGAYflPsPZg&oe=69D3AE8E"}, {"file_name": "PopcornFrenzy_Screenshot_03.png", "id": "1239063567818231", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391835_1239063571151564_6127348317385178373_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U75QxRgUYeMQ7kNvwGYS1B4&_nc_oc=AdrRvgZ2-MEcXhmA4hxgYXFGcH4K60iRRkIj712mXwDrXB3__M8VTHuFmCioZwXYdv8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wLvkC_euGJxmy9rARUiFaf5ZxYNHP3p7zxI_mlv9Xdg&oe=69D3AD1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Popcorn Frenzy", "keywords": ["fun", "popcorn", "frenzy", "free", "game"], "long_description": "You\u2019ll come across a box of popcorn just sitting there, and the fun begins when you interact with it! Once you take action, giant popcorn will start popping out of the box at an incredible rate, quickly filling the entire room with fluffy kernels. The chaos of popcorn spilling everywhere makes for a light-hearted, immersive experience\u2014perfect for a quick laugh prank or a stress-free moment.\n\n\"Popcorn Frenzy\" is part of the Confort Games series, an original take on the concept of confort food: simple, pleasing and affordable!\n\n", "short_description": "Fill the room with popcorn for fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.evresnce.com/popcornfrenzy-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Confort Games", "support_website_url": null, "website_url": "https://w
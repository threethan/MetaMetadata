e_name": "IMG_6796_2560x1497.png", "id": "1871183879933686", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982722_1871183883267019_6976346328672094065_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zm7UkCWGwfoQ7kNvwFWB0p4&_nc_oc=AdqSqCR0T-9yu7H-Yp3Uy5kzYkRFdQ1ka-bKo-BdPCV9ba0lGhOqtvrenDUAxIEIRU8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGWhAOs47ce5x9xN8tcuagNoXNWLzdlhAkZsuVh_w73g&oe=6ADCD1B6"}, {"file_name": "IMG_6795_2560x1440.png", "id": "1214755965869226", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982635_1214755969202559_703312917699238621_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM6Vm9umbu4Q7kNvwHCPi2i&_nc_oc=Adrivo8DOIDoLSdMXi6VUl5dsMLcrlq6mbFNFZwn9HysJwuoYd1NeArW70LDqWcm22Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJzyUbTOvcq-47z9RfZdQW_reOttVk29dLKNW4nlR1_A&oe=6ADCC0CB"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMLgYdDAax8Q7kNvwFI-qRw&_nc_oc=AdpuJ6homD5FED95UolmqV_1xUdpYXFBmVWBsfVMZnZQTrj0m7CMPsttgUs39OTt01g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-FxxQBtAtcmHZyYYeGsR3opdkWTsryhryqtVCRSeCUQ&oe=6ADCD648"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRz_-UjqF8UQ7kNvwGCwg28&_nc_oc=AdreiJ-St0GTkRi3KouHJwgy0NYDa2bt7cn1lp9wpx5Q6rGTLBd4O2H0eoE4lTAiEDU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONzt0QON0z4LN1PZ_K4P0P9Vb-GwHYQW_K0yLoRRd4lQ&oe=6ADCAA2F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TTiArxEcoYcQ7kNvwE6pLo5&_nc_oc=AdrYz-o2kyt5m8p7IA3YApLM4AVpfKDnFP74rnCKlDO7V85e5ciTGuHZ5LTttZ4EQnQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMRojUEt97WHUZKE3jdPvcLFQzqkkdTZlJYOT4alepF5Q&oe=6ADCAB85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
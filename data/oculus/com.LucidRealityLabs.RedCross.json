t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_raroU14zMEQ7kNvwF6wtbK&_nc_oc=AdmtvnE2UN1Bo2m8-mZ_roNPLqFFVkK2ivuq8ccLP7zIDDcdsYyNXGQswcQPmXb5CH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftmL6ufGp-fluWjoW3vlAJiH_t6xC4KMSlIKymZ0sIAPg&oe=69999E88"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHqp4dWBe_4Q7kNvwGobwMv&_nc_oc=Adn7WDe5Oo0ogCeW5YeUR0obTnVTK94oB4bcVyoSP0mflJspErUemXAmH9oih6F0KtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftI098oCV7E4qZx2-WVG83Zy2Uib_5h6mAaYoKy-BGnnA&oe=6999AAAF"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Ybti4bd2-IQ7kNvwFTQx-F&_nc_oc=AdmlXnwUlnBqDmzu7g6erMvkhCvJhUMjRh2W-Wdd5MGwj0F7QVTEcQvJQnEvEPNb28I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft2kj9wCsfHfGYsAK2mSAY8ub4dtRo3pYYQKJEsZWr7hQ&oe=6999AC05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-N58KWOxvTIQ7kNvwGxlCjt&_nc_oc=AdmMJS6PMfyHl247EKJjjIa__PJk3kjVw1JVpQM6OTJiuUpbKjm8m9Szy_V8Zj84W5o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftVcvdsIGydcnqxqHv1AIh1JcfEVPbEdZ6DyyWXDwXNnQ&oe=6999AD90"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lifeguard VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}], "release_date": 1707228000, "lastRevision": {"nodes": [{"id": "103276885663006", "release_type": "SCHEDULED", "administ
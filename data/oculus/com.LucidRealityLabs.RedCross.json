e_name": "IMG_6796_2560x1497.png", "id": "1871183879933686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982722_1871183883267019_6976346328672094065_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3k48tug8jQUQ7kNvwEEkC6_&_nc_oc=Adpu-qfDazSfIsyoo2QTPyuQOGxwRFZagwfjesnyiyFWPgGseLeiTbLOzhE25X30Mgw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD01LnEl91fEMHfGIfV6VMC0OxWCMmXHHxSo7sn5qMvg&oe=6AE75DB6"}, {"file_name": "IMG_6795_2560x1440.png", "id": "1214755965869226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982635_1214755969202559_703312917699238621_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3G2r_caez4Q7kNvwEaUypB&_nc_oc=AdoXgzplpOFeHEw86jkS5ZuiQRaixz40t0lM157E_D0yKgF1ny5vPblVp_4LkrK1C5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToe2HRhrE_m_WCQWj9pp4fuyfibIv7qAPYejQff0YYHA&oe=6AE74CCB"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTJcxEWxG-kQ7kNvwFP9Db9&_nc_oc=Adq970xWlGVyydUd6mh1M0oA0-imXNcyykDFc3NKWuuTMvVKYxGcL3k7r69c-wEZYtE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9MM6tHmkKGDvE6QyLCewhfmy42EOX7XiqOWVtCY2p2g&oe=6AE76248"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uI0hyNIcwegQ7kNvwEwdhaC&_nc_oc=AdrykpLVo2QU17GSEt0C7KmOGd-QdyFoza4GaQW_Jde_Ewd0g9gbxHQCi00LhKuPoNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu2OY2tnE9ijT7abpDRlCdkq3LVbWr2S3Z-zVxhUHIEQ&oe=6AE76E6F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGkOjGyTwsoQ7kNvwEGcuv5&_nc_oc=AdqEXzwfdi_fAULiw16_6C6TZRIFUUBW5kkFZMLqYo8JFG9cYMRTGu_RhWznATBlmuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1dYLjRchHAnUL2RObtfIKLIKWBHlUDh1ZZJSrKhKgjg&oe=6AE76FC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
a0a&_nc_ohc=xcDhpoa70MwQ7kNvwFddPGP&_nc_oc=Adqlex-lmiwwaP5RcWtz7xgFkKV_-NTPwiLuHLOXbgIveSJ8VyEnkus4vKSlIqXMi2A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp16kOWHJig-xDqzOrgd0mhBIfOaHo_UPEkwZe8J82nQ&oe=6B09CC0B"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WXFk0nf8OkQ7kNvwHBmmPM&_nc_oc=AdqFQfzIYL7W21FqqKF-oEoM7CAqT0Pmlt0FH9SLtbjFjz05q-6XIPOFTdK21JbqUa0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFfraPzdgbnabrRnNGQH-5yp39YzjwpDrILJpY1KChoQ&oe=6B09A948"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTrMspt5UhgQ7kNvwEZ-hjC&_nc_oc=Adr_wBJC4IyN2vK44SoE_ydTyQDSM3qIuhXKUegjhWJ-0z3vQyr74o4VRXDWJJ077EE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNdCbOwGQhPzH8FC4Jec_KkwSCz_lzmnrXDc2Za4d4Nw&oe=6B09B56F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqkt5IElOfwQ7kNvwHtTM1u&_nc_oc=AdrK1dvXNSWP7jihq_IRBa1_iXfCSCwhaXJjR-jApMylDHUjzbtj4mG1h2WxlYbNvSI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREB_1zh1kLxwFC69tcR3NQaxXKbbmPerD1HbM9zj5nTQ&oe=6B09B6C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cPBibcJZQIQ7kNvwHEuXOs&_nc_oc=AdqDv-6snUMJHpxNw43mMRuk_ktwjdphAi1oCVrTNZ7Y3sXv_sHRt48gXRtiwCWPhto&_nc_zt=3&_nc_ht=scontent-
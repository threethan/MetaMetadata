a0a&_nc_ohc=ssFnbcdOnToQ7kNvwHv_JVD&_nc_oc=AdrDWK5i4rcLW_XsrCyuT_U6QfSqJsmbKS58xG9pDWZ16XPHjQEOU1QsiSCf4mogjqU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSgUJ2_fER0cufF2EoaHiKq6N4-waPFy0ik3tOaSSnVzw&oe=6B0DC08B"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnpM5ho6OBoQ7kNvwEUmnuQ&_nc_oc=Adpzv-aNPFwwIwe7bu-J6deAo92dxU1deUXBV8xmXQlgPlRJ6cUB2wbrzxK4-jDx4HE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSTB4cUpQoWW7bKjDxpV-3AEMxgaZ1C4KwadIQ0tk0wHw&oe=6B0D9DC8"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x24b0zXswZkQ7kNvwGYm_Ia&_nc_oc=Adrc6LVmRi-g-ZDVFBS_mVWSEPWooO_2yX6jMywz0vf9FUs3bTQ4P16kOYFSh5ctU_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTSBhDbeT99-UVTp9Wm2H8mWL5Lk7AE1QAH-vk6yPkcEg&oe=6B0DA9EF"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l865bWv16e4Q7kNvwHN4v-C&_nc_oc=AdopKMTXtqxG2Ps195OaV666yy1-XS_Z7oR5tc4fth87R4OZdGAvHxcwInxpY0EMdxI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTBliFCGGpAJHSUmI3QbXnEw69AlLXyXKfSS9KD6g4AOg&oe=6B0DAB45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otx05phGNpcQ7kNvwG89dPl&_nc_oc=AdqQd9lcvTqcWnhKqfj3bY2taZCGPEC3TD-NrWqqGSJ4Sc6RA7EgrZitOfZ8stgk8lU&_nc_zt=3&_nc_ht=scontent-
a0a&_nc_ohc=DxT_szC7rgcQ7kNvwEb_DJR&_nc_oc=AdoqSwQHKWGCyRbrPB5pRVWJkkYgJEfXxCPaCpAw5BLKz8FF6TbZPaflGFNEoS3S9Ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWg79l-rFJZO-Kcn5tvvnkuIMp7kKvr2XY2MLlhmLBbUQ&oe=6B10638B"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9iZfsFx3SQQ7kNvwFpHKpQ&_nc_oc=Ado6Xd1FB7KHfcew9mR9m_wo_Nesl6h4iUrtT8xIhxIcfslBPi8uw7U0eXBq9cmKus4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVsbJ2_C2pOwH64ZLpR8-C9Dvy-Vk_EduH6vq_7w3SmCQ&oe=6B1040C8"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6oOE-rr3pEQ7kNvwFaNqBp&_nc_oc=AdopCYT2biznWnesfkSjZiL2hjWcc-7BiFCKl9_u3PtJRC1h7xmodbcfK9NYB0xL-0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXykDn2qEgbNmyovHomjEgMhtdEtM51C8zS766S0c4e2g&oe=6B104CEF"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfudL5I94xcQ7kNvwGrpPQn&_nc_oc=AdqR3kkJXeEMQtV_0f7vQLpc5aQPh7dieRbUxp3cROKo-bXcwD-mNdH6YnFLygmg_3Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU8_4yy0FSb1ezAJecRs9z5HeO5HVpVVC10F8IjqEs-sw&oe=6B104E45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_2X2raLuLwQ7kNvwFsP-Nt&_nc_oc=AdrCXNQj_uRHNegsOf1JosP6FYT7Xi1lbvHBYlxxSQ5yfMNHMA1iTqMOcesEYJ-tPRo&_nc_zt=3&_nc_ht=scontent-
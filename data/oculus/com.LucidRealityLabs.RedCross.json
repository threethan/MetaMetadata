e_name": "IMG_6796_2560x1497.png", "id": "1871183879933686", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982722_1871183883267019_6976346328672094065_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WilZZ0fkhB4Q7kNvwH8jBEe&_nc_oc=AdrQODzqRHysECmEpdbuJCDHpq5bv03t76tZ5jaBRFj2KvrHG8lqJUAFPFgBYKaIZvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMqVfr-ZWbrLo9bk99BkzqyfagbhR2JRlW92nb6_zWJPw&oe=6ACE5136"}, {"file_name": "IMG_6795_2560x1440.png", "id": "1214755965869226", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982635_1214755969202559_703312917699238621_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XN3Cc2sSLxYQ7kNvwH8qIB5&_nc_oc=AdoNmXIQ1EXFrc9PlaqK_-qIRrcJrda0eErwy4ukrAOUae3M1UkgGpDh6jRpD3r2Aiw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2qX0wdGIMR195MEUlNuwUhytWcWG-kbFzT-QegImtRw&oe=6ACE404B"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HjMhHjX4_48Q7kNvwFIXOep&_nc_oc=AdqK6LBOK6Zh-Rdawy-XYHW-fAY148YSZ0Rbm1muhEU7d7aQ7mdTNfCrMMQXe5VlPjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuR6072MdM0TRH8jDoGYUNkWg8cFbvlmxhDrRaObe2dg&oe=6ACE55C8"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xffRiOfitscQ7kNvwHeEIj4&_nc_oc=AdpOaeOGDHSIN-HmKyK8r3G3Uwb45xJ-d9UXDl5nH6GRKOqewENVSxV2YTWFU5bqs6A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4dP06UxwrKhF7fFym6JozixTLRctqsXAAiCFMAUpbLw&oe=6ACE61EF"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5x1C8nqY3UQ7kNvwEa_9SQ&_nc_oc=AdotMJwjblgh34fVbltxky1ZVm23OWQIF8pjB1fZLgdg6mxh-47iKF6w8bBOz5dTOVI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaNV7VUnluIxl3rIh2PZ5QC0unuz0uMOa1kOvroudlKg&oe=6ACE6345"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
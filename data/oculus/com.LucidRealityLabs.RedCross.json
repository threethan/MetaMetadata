a0a&_nc_ohc=xcDhpoa70MwQ7kNvwFESe_S&_nc_oc=Adqq14uj1NAJNlCZ5MQlv2KyMUtHy-Uq_Wd2-G0EEh2i8D41lOiNX-XAtWs7H5V5io0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7F-JPxzw5uxyBfbbf8NxqszXcR48cbTmnOLOtYyXMuw&oe=6B08424B"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WXFk0nf8OkQ7kNvwFhgX6-&_nc_oc=Adp_lKDfmnOlNy795NzdvXMpoP7Nj8lWsY1s2SQQqeSIo260Rt-I8k7G5hYRkmU-SBg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPHpEEj__DZcnPB2MvlDs8Jui-2uNv8Gg4XS-2TJYlOw&oe=6B0857C8"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTrMspt5UhgQ7kNvwHcSn4y&_nc_oc=AdoD-FzN0iZDDaOTEYdKSJxFlORFi3Eq5T6f6G7fInLVauj5j20lYHV7Uw5W4NC3wus&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvwiZ7l-08-MgyCBJp2Aj8nUVSs-CB5s5GjBbTVApunw&oe=6B0863EF"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqkt5IElOfwQ7kNvwHkOPLE&_nc_oc=AdrN8yeARjS20sGShZoEDDiUalwPncDnmjrOOkoQcZh8l2oD-la7xgrC6GPWQEgBWPY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgmNoc4LW-2d5rSUFf2gPJzwk5HOGxyXfeoGoUltX18w&oe=6B086545"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cPBibcJZQIQ7kNvwHPecsQ&_nc_oc=Adr5tnBZZZwDOHxFLmFtV9pjfw0x_bA5RJiPwQXTgnVkL-vn85B0PahosA4_lI_9Hh8&_nc_zt=3&_nc_ht=scontent-
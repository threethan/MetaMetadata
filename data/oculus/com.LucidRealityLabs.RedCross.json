e_name": "IMG_6796_2560x1497.png", "id": "1871183879933686", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982722_1871183883267019_6976346328672094065_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PYmp2LnEygQ7kNvwGoAuHP&_nc_oc=AdqqG6gFLfzNqG49av5drK0kImkuCXpu9-B4hExpu8PPsVQxxXEg2sOdFFUnz5AmBsw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTgyxNg2GD74Qrc6o9xBmwruCROgZIPWEZ-d0rB7f7UA&oe=6ACA5CB6"}, {"file_name": "IMG_6795_2560x1440.png", "id": "1214755965869226", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982635_1214755969202559_703312917699238621_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4XjQ894PzsQ7kNvwFm0A2k&_nc_oc=AdptaTmnCeJFNScrDo7K-7fsQrwmZ1h9EUQL0YtfFz5JQymI8ilUldj9S41UVZkoMiI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpMZN-JbI3fOkd2rWCg7Kp3q-qWeyYV7OPxd6dZfj9ZA&oe=6ACA4BCB"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbdE8J9K2hsQ7kNvwEgnbhp&_nc_oc=AdoYB9ZXt3gGymT2Bnfz1xq4dynTcqdggy_BbDUFE16lvvAXy6_BNxDX-Q14-qaMUGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPr-LmsRQ2DHbgTVxBTfZHEo506FIDnquxQJjxhuD1urg&oe=6ACA6148"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9W78gFXNbdAQ7kNvwG9BZpy&_nc_oc=Adqx7oBWY2WrGTqDr2dqWtsP6bdfQ734M1EToEKEcSFDdcnq0bNGcQKL2AAVwjScYRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCvGve4b2ElqNM1ozUQbvSZpcrQsZ5MjcdzO7R7ElKOQ&oe=6ACA6D6F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xVJRY8nVNcQ7kNvwHMKJOq&_nc_oc=AdpmiClxtJmZtldN0sAOkKjWQzsekazGPO7E0_zPuDbYdisffFMFpOcd7X7bcs9QB9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWHwEzpyqX0XQZK3hD68RQOPCQDDjT4-IDbzmqUOdwug&oe=6ACA6EC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
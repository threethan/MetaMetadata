a0a&_nc_ohc=DxT_szC7rgcQ7kNvwF6emKG&_nc_oc=Adqh35Y7BJXo-FhrP8HxZeyWxfmYRdmyHY_gJ14dlig9-Ono9A8nF_KRrzRZVWpA0zE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXOJCi2bvI2mwq9KaTblT9Ae-wLJaeNKTL5knXcBVTE_A&oe=6B0F120B"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9iZfsFx3SQQ7kNvwFnrRuc&_nc_oc=AdoZhUAhG-p3r5i_bQ8_ARssEQwGvP4wXkMDT4MZsP_rUzZYdyKAkNR5jo64Xa3w9iM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXDw3EWfoO91Y5m4smvCQCDHd1mLKFMbme-OcBS-iGGFg&oe=6B0EEF48"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6oOE-rr3pEQ7kNvwG_Zi5o&_nc_oc=AdqBaEwvniWsbgyvPonUvhkzYpUjDupvDfuH-R5MNqHYZ01JVdieXatUxBR_7w1tpQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWOYbrwE0Kg87VBBcADciZVPmrGujEb9X2JFFFdZcKwug&oe=6B0EFB6F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l865bWv16e4Q7kNvwHdLklN&_nc_oc=AdrX9QYk8WaUxJUhxIf7vJwsSpuLK7VBglfle6n4Rc7vWG65Yq9bQoMmgPvU-Gi4vUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXEu627thR0U_oABja3JYLVW2x6C_3FzyrDverQ7VCiWw&oe=6B0EFCC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_2X2raLuLwQ7kNvwE_eeyO&_nc_oc=AdpevukEbl0lOu0awqGo7Y42qYoF4L3BjYY_hnIhvCjx6QvTWpar2tyOXe8q51DCT2w&_nc_zt=3&_nc_ht=scontent-
e_name": "IMG_6796_2560x1497.png", "id": "1871183879933686", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982722_1871183883267019_6976346328672094065_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC2-FoQEAx8Q7kNvwFN52TG&_nc_oc=AdpPu2-UzxIXO9015-4m_uSpxiOLivBrNhZaPAofsAhkI5qjr4bri4PwaPGZT9QP5u0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLBJCi_HXCLDwEr235JwLrxNvg8pLYozRHjaU5-U4ylQ&oe=6AE217B6"}, {"file_name": "IMG_6795_2560x1440.png", "id": "1214755965869226", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982635_1214755969202559_703312917699238621_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ewh_ON1vY8Q7kNvwHD1eU8&_nc_oc=AdrxndrTQeXFNazKgbYodd63z2mBGd5IhHiKRoJRtNWPbYKtvYuhWNRwY9AbAEtzvfM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOj0oGKfkHKd_ZL0iZ_HkgEHswNHGxeZcSAf0wC78RIQ&oe=6AE206CB"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Y3LBCAmlCEQ7kNvwG6w6Aw&_nc_oc=AdpGUtya7KDXGfY8QkkWBdwPNbRznoS2PD-nVSqwEYrkulL03ceaY7ofUOixoMVa3uw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYhpvmbb7dVLNI8k1pORpWb0tSppUYiFyN3474cdI6bQ&oe=6AE1E408"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KuvDjKwUhQcQ7kNvwE0ZNKY&_nc_oc=Adr89VjMGH_2r2WH-8zNEBSbzWabpGoqQpS_H9Bd4EQbapGy_X22_y48Nl4Qy0P2gcE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMl_A6zaJnsIoMMi6xjZgkznY0juzx1tDKefuapJHpSVg&oe=6AE1F02F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NI27_RHUKsAQ7kNvwFNAzsa&_nc_oc=AdqXH7K3L6SUyprwDJNvMJfhPMxbnECgQSyPFNzLPgb1L5Y6O5NVeJrbIwQ8YoC5A6o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxsm1zPM0oh0747t8ubWle5BCkDfQaTUvbZ4UVBTrOOg&oe=6AE1F185"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
a0a&_nc_ohc=ssFnbcdOnToQ7kNvwHDBBF8&_nc_oc=Adrk-2t_hDU4J2jD_FNL9Cyy5AKfMi2Yjl3vKDh8noSNZBl3MAYzhfDrlzvia-WksSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQScqpYbToEFt7zFMr73ZU7KmIJIKa7YhOoRWP_uJ9jSzA&oe=6B0C6F0B"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnpM5ho6OBoQ7kNvwGaU0GV&_nc_oc=AdrMJKdH_pOSG9Go6Wj8sQNfzxlZnZpciwsM4JjccFxJ3-Mt1hr6yVDfrpomcOfuBAo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ14CQ8zRoha2ziNEQBFojKpRmMPCThS49G9iBzVeBxKA&oe=6B0C4C48"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x24b0zXswZkQ7kNvwFsxVdG&_nc_oc=AdpaCI9acl2OtdrJLDLVdc0JMvBAl_qV2sDNJ2mbTJ08GQ-xGvR-PS1LaFS10n7Qg60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSIuPwZuD53adz_Erd95RdKu9bux8RmL2Keg9KwFJmyGg&oe=6B0C586F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l865bWv16e4Q7kNvwEfrrbo&_nc_oc=Adob_hzQtcmTr57A7O-9vKF7hSICFdYOOEZb7lfmRAsAuLjOUTDMJPfVDGNjfnWeN5k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1AQjQL_z0CkGUqASyfRFETDSCUkyXEIWUMH8-N9iZGw&oe=6B0C59C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otx05phGNpcQ7kNvwHoVsvz&_nc_oc=AdqZrNcxg7eifBgARQ20nLta79slNmkmJ5Lg9_7D28tao1NUMYlnv0747CQJ_x3WWBk&_nc_zt=3&_nc_ht=scontent-
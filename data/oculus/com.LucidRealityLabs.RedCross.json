a0a&_nc_ohc=jbhnazMK20QQ7kNvwEV6Ktc&_nc_oc=AdrIxv9wmTR-eS072Cnsgu-OrBj53zsDEolVwBrSTLmCBU2b07qnRQm5enZGf1-Yo64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGBs3n6YMydOWOCEo0KD1749xGAmVw6c82mW-zEL0ziQ&oe=6B01E30B"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oov61J1YcqEQ7kNvwH-uyZi&_nc_oc=AdqeS9FFwTXx6F63D4OJwuOw4wAcFU-kftg3di13OkffL8KjQRQzERWQUnybXyObnIs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkpVIPs1CeqNaWu6KNfsE2bPCx-A6yOTSmPYqFLPdl0g&oe=6B01C048"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jk1-T1QrC3wQ7kNvwFdbYWg&_nc_oc=AdpWt8S-sQbgDwdk4_GjtSCFeAUdZMKsEiDcvSdWaMCSRshe0agZuxwkOeBkPd_y7SI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRCKXfsYxaPudY5FQ7OnbpV-WME4fs2_9Qw8Q-BEBkFg&oe=6B01CC6F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-TbXbpbfUEQ7kNvwGWmr6U&_nc_oc=AdrLnAO_9EhVtAxTexRzoD7_4dlb_GlaA5l1TwxiwvRAlljg1Uj0cgiiVsO93j02R2U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT26lrwn-wlGRr3MeVyu2PL0dEx5unheSy9XtcKmOukdw&oe=6B01CDC5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9lR_0Gc-OwQQ7kNvwF5u8xI&_nc_oc=AdqaopWPT2K6sUWr5MA9jPYR3eE-d7p8OQEW8VsEvacFhyZtz4gzwrrSndarBAGBIFM&_nc_zt=3&_nc_ht=scontent-
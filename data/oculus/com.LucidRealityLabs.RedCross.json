a0a&_nc_ohc=kBxD0zqEzVAQ7kNvwHlMSnN&_nc_oc=AdrcJYap_87n2O0Obm8PU0e9mPbDqZ_bjW2uRcVNH9Vd33ddUOPgLvSwpuTEdZGMmOg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cuf8OMGXUKYSo1K_KDI_YEZ89b4PwLTOiWt-4SM1Ksg&oe=69EB6905"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], 
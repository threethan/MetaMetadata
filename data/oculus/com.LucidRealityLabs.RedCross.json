a0a&_nc_ohc=BnVJqIC-IlQQ7kNvwGZ_WLI&_nc_oc=Adrme1VM-5jCut5dsgXKx43eQCsoPGuKThwn9fZPmT_SYYQ3zh5WbW5gjECzrrL2mBU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiXiumAzHHzDNN2-HUdNnbFIdoxv5Uo2Z7vSQy9-EbbQ&oe=6AFB4B8B"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_WINfGcOhgQ7kNvwHPfZqk&_nc_oc=AdoJMvpYA4kNYdzjjkG-6hA2Xyvqc25wwCn2GQFHUizqYQlmtVEQ6HCThy89GO54dMM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2n_1jxkemnrK8FLqPFPqfehbCNAv5KTg0lEUwega9SA&oe=6AFB28C8"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dIVOg4xc0YQ7kNvwHHkpVT&_nc_oc=Adodc3gHrDOXRYdOtsTNQkumsYNTSOQxM1jKHGI3OOV7zSYTcozE-Umsu3tjnaS6984&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAQbNnlpI8tfDBVcns0YkCHd51xMlLBUtnS4YtdeCnsg&oe=6AFB34EF"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmwdPy1mndAQ7kNvwEB3el1&_nc_oc=AdpsNR8eAsTqaFjDecGORCCs-UwDpBi_A8_HoJlqz3GI0l5Lm6kq-9ngodK4Z_DQ7dY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV2y9xXG1xJAd8OhjYJc4ZumAHpA_3SxFGbThpazC32A&oe=6AFB3645"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4aJsQyA-wMQ7kNvwGZi7yg&_nc_oc=AdrjJp_b0DR6BdUbzPrBd68MLftYFxvZ3xOGlwwx7mOoejNz15lxUJ1YFYvVDd7aGe4&_nc_zt=3&_nc_ht=scontent-
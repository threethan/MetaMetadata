}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XRMlTicOTsQ7kNvwFCphP0&_nc_oc=Adq-pzGUBlX7FN1bn_yUqrHDS1kjXwnP778t1_2Bm8EDD4MstnUVQf9IRilGGxiejL4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4lP_sEza1V96qhkcYNGhold-P42KY488ubXtx-d3Img&oe=6A21A148"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvOeVTfLnXIQ7kNvwFtNOPb&_nc_oc=Adqy2GwEUIFJz_LY1D7Uf8U_QlWIhGZjDKk5uVZy14LaIS46YJ9ZZaMPyeVv7HAltG4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Fo_aA4lqyVDUcD7JGCEqQrni4J5lXfOo8pGafp0_3cw&oe=6A21752F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLNkCSnsPwYQ7kNvwGBmu6D&_nc_oc=Adpmfywlz0Abd2G2Sgjhjcj29hrWTzBcrNemMfdCOdBg8x8o3saNvElkafp5ZuI8MTs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q749TdvWnRAZHs_6Eavdj6CEhoIsmmP9Rntci_HiGmA&oe=6A217685"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hZbPBLGynUEQ7kNvwFGO5GQ&_nc_oc=Adq4Zu6XkTXkP7V7fcpSpLoZ1HMg5RzKZnOEH8DwdUN9y6oQUQF14JMTKLur_vqHU80&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-IwPOy9EYjp_ecXCrpxfm_fbN7PuPGFaMMVDzD8kBlSA&oe=6A217810"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lifeguard VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name"
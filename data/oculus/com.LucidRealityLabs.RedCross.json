}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nctSsnaSMWgQ7kNvwHY1q4o&_nc_oc=AdpsLGHoMc89ectv7BBdzTw9u4ajL7dYFDfx35TmltjyLmPX56yAnXVGa50KMAYAQAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN6mNYmZUI4wy48IbonPBiezSp-7CHxOn-4bw5vs1lNg&oe=6A7B0F08"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAyIv3cx3aUQ7kNvwGX8E-d&_nc_oc=Adr2B7IavF5rxjcgW2E5mXjyqT3JZjEMyqsVA4fIlKT3C6bTmbmPA3QjQH1r-OnJMzI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGc6D-tZHnCZY_oMJHJ_EcP6ciAhImUn9LF_nXwcb8srA&oe=6A7B1B2F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yEmIBRe1B0oQ7kNvwEPGb16&_nc_oc=AdpFx5m8w54vPO1_9Un-SqXT7R_ffZPLbBO-KCZimBjGg2VoGu1guuADemn_3GfiPwc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErMctdo0ZWe2pWE6pfkW7T8l5-Gf8DK-oXUpuc8F_8YQ&oe=6A7B1C85"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyjxLag16wMQ7kNvwHEs29U&_nc_oc=Adqj5WKS0hqY6aRONfXVI2wXFCxIyt0MIZYtj-4ehXnfLXoZ7sPuZRx2if7XDBqoO0I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3bK61Ow7upDCpMHy_kwuXVIXfH8vKQsmCJqpce4uSbA&oe=6A7B1E10"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lifeguard VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name"
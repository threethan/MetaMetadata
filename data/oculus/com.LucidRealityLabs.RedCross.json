e_name": "IMG_6796_2560x1497.png", "id": "1871183879933686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982722_1871183883267019_6976346328672094065_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDpY0Ch352IQ7kNvwF9PPC2&_nc_oc=AdpN2ycoimkSqe8Wn_Sz31KSDMOabRwWIUvM8nv8avElw6RXVQ8f9Rl90iHRaRl50_c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK17TKChRuqrSZz0Kva0n11Zd6vFst_sOXgq6IdyspvyQ&oe=6AB7E7B6"}, {"file_name": "IMG_6795_2560x1440.png", "id": "1214755965869226", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982635_1214755969202559_703312917699238621_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rzj5KoGefMEQ7kNvwFF2bJ9&_nc_oc=AdpWXz6-FvGbFx1oOVVZ4K7gRRCXQs2IZ7yEvj-GCoPzrSgrgonDLhNHwI8FL33OXqE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItK6xji4qaNKavZNoJWMv-AvE1wpjb3YNBfGATjtwXLQ&oe=6AB7D6CB"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JD8Q2mKZvmUQ7kNvwEp-fmR&_nc_oc=AdpEon72ZLQdjhV7APpVSvNpmq-aMIdwXzuhbfHJlsvMru60mLwdjFhL-0FkfdKEU3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDlGqE1qyPPp1LhU-goRTBE-l43E090yVowDe8LXVVCw&oe=6AB7EC48"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gixZsw2hMLoQ7kNvwH4Y8sQ&_nc_oc=AdpjF-JietbZkBxbcnYEuq_nfz21wLwLCnjmn1lCRxzo3xH6VN-RcRMZpfGrxiJxdMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDckXK9anj3NAFn_GT7H2hNqA3K-IsTNaH58chbfv8Eg&oe=6AB7C02F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gutonFS6n2EQ7kNvwHda79c&_nc_oc=Adr5yrTzfr3b-MuTH4m-4IJvSzhW5pOLjYX7uAqpFvwQXo9HYZnIzTysnOrKLJt8SVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNjPZqpd8wrKliAptrmvBZOsEbzsqYhFiLbmm1M6UKwA&oe=6AB7C185"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
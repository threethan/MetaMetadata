a0a&_nc_ohc=ssFnbcdOnToQ7kNvwGzZYak&_nc_oc=AdonQaQioAXRDwLabS303FSlqnahPq8pu498kdWXnWYACUgoEfyWyVIqwCxe4wYtgQQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNoLU8aiRdOn0SSvYX2xTzlTGTgRiZi4BzujFd1EBTrw&oe=6B0B1D8B"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnpM5ho6OBoQ7kNvwHgrWIp&_nc_oc=AdpflSq_0J9QnlxdIznN2bcdVLVvqvDvvFF1BScnYIDkvPx5YNE45A-qISHCAWeNxWo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2kTizmrIhcsknC5YIgLf4muTrYONntQhs-AuY0v0QHg&oe=6B0B3308"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x24b0zXswZkQ7kNvwH5oxtC&_nc_oc=AdrS4WiA1Co9VOIJNtFSOS5eO5F6hh7EIDHUoEceFDOL2hmrZd7Z6GrJIiy9o2szssY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTGkA4HRH0N14RpvJ_nRoOrxWIcdE3kzCketrPauOyMaw&oe=6B0B3F2F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqkt5IElOfwQ7kNvwGGG_Jj&_nc_oc=AdrWv-jwjQ2iqEcCp8LxwsA3To9Hnshs2I_co6g3fdgBDcFuB7Mq6SH6v3jXgUT3E-s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxWzlVdBcUrP3COB8kUoJjODbQbzknMKnkHUGHv19e5Q&oe=6B0B4085"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otx05phGNpcQ7kNvwGIAkvl&_nc_oc=AdpzCB1hVkdIBlMIPOQ73fn6tnTeLA0fWJXtTRmsLt0lqN7bGv_QyhUK5oieKDVic1k&_nc_zt=3&_nc_ht=scontent-
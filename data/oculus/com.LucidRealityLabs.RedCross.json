a0a&_nc_ohc=BnVJqIC-IlQQ7kNvwEuYyPo&_nc_oc=AdrjT-ZSoNNAoabW5GADrQ422O8q6_VoZdSqHWjV6ItV7izX5c4z2GOYFRtdksg5DrE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdqViCv1ZUJcBjDZuRntU1W2tGIZa3Dtvc0znBzhjJwA&oe=6AFC64CB"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M_WINfGcOhgQ7kNvwGaDSGa&_nc_oc=AdoHqWiiLaWL7oXD3DBuZ7zW7fZSrmcHmCy2R8hnvnWbWOEif9SU7LQESEl1j4FlM5Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYw7ZUkWeeO-7VHqxoy6sZPx_A1qUbLx4w7LquwzxuDg&oe=6AFC7A48"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dIVOg4xc0YQ7kNvwEhDz7b&_nc_oc=AdpQUlY-1ft6A1-BxUz7H8MWDbmv5qbueVavTmFpbjNpLr43qceNat5d2-Eapnon76I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDRJmZBXGoRDZgURlRgTQyYAg5Mhfti8TJD_lpaOt7gg&oe=6AFC866F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRyUocVh_00Q7kNvwEccH6Z&_nc_oc=AdoCtlXilnWF3lf-nL2B_SFJtrg3OYwDeJTlSPFJx3pFKyl1_irTW1HB0CPVdaxWtmo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTuzmdCyYcaEcmdVvWknlz1gWu1r0LhJPvFvqFqx4jeA&oe=6AFC87C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8624889677592434"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974652_552883967394821_8315611085858578770_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d4aJsQyA-wMQ7kNvwHlYymc&_nc_oc=AdoyEA0Vb6yTGBw8AErB_jQLWfbU4IiWfEm7ILwlpMeVMckkH1K9AOV_ZfZX5LEVRHg&_nc_zt=3&_nc_ht=scontent-
e_name": "IMG_6796_2560x1497.png", "id": "1871183879933686", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982722_1871183883267019_6976346328672094065_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOs6_J7Jda0Q7kNvwEaguGz&_nc_oc=Adpc2OZluW8wNTLHouId-N_6U9lsHPjQZIvD-CgqlbENsReoZpchuWgmTvMyUPvtbIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVniBn99MqUqEuu4lfkn3hSQSdYGvDOAOCBGtqsLUrIA&oe=6AD245B6"}, {"file_name": "IMG_6795_2560x1440.png", "id": "1214755965869226", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982635_1214755969202559_703312917699238621_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlt1atz2pkcQ7kNvwH7sJFx&_nc_oc=Adry0DKT-6Du4x5oqcESeAzIJDQDhtCoPU88sl80snrB4EZq4xoBnWoM6QZiC-kgBgI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-KRQNtdtFD9HEErYr45IrgggfFvtjdMNUW34mntLH1w&oe=6AD234CB"}, {"file_name": "IMG_6793_2560x1440.png", "id": "1422894395160354", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974757_1422894398493687_6113433151886852161_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxwOjJExZpAQ7kNvwGBghHq&_nc_oc=AdoCZbPDs-2QXSrQ_es_yVlYkSBHxVBQKHnCo6RjvGeOPVQlBf1Y21-7bK5A6xJAPSM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxS42EbJ0bmXAVjPZHSWxZpq5bt531kIAkjYTK1g19hA&oe=6AD24A48"}, {"file_name": "cdf4d1fe80c81ed28ce5ca2951e198ba.png", "id": "668591601373714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38984448_668591604707047_2151042290361045954_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=djeu7Y6POgcQ7kNvwH37_FT&_nc_oc=AdrPn7Z1ENor2uOOtmQLWqVlXcz-Hjs9nBdF5YEv57BpYaRnVdEXAcByq3PXGnULbKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1LH_mOsgPwyW_1TA_zRGx4bZAblPS85sUP6u4cydYrA&oe=6AD2566F"}, {"file_name": "IMG_6792_2560x1440.png", "id": "590705416560911", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57575360_590705419894244_1790132388911216295_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgIUaWq1TUAQ7kNvwH5Qqxr&_nc_oc=Adpb3-ws9aqQ7ICoQ65D32QLoB89xcyAGR1GUz2d7Ijfv48LfuPd10onTV-6xHQBArQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwO6sbu6HjahMguZSmErOq9Nx5UnHvC2jTJmnzqzH66w&oe=6AD257C5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Lifeguard VR", "keywords": [], "long_description": "The American Red Cross offers lifeguard training courses year-round, working with local partners to provide science-based training that combines hands-on, classroom, and online instruction for lifeguards working in a pool and waterfront setting. A large component of lifeguarding involves cognitive skills such surveillance and visual scanning to identify distressed swimmers and drowning people. However, it is challenging to simulate the distractions and environmental factors necessary for this training in a classroom or online training environment. This virtual reality experience created by the ARC Innovation team aims to train future lifeguards in core cognitive skills such as drowning identification. ", "short_description": "Test and hone your lifeguard surveillance skills by identifying drowning people in American Red Cross's virtual reality lifeguard training experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.redcross.org/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "American Red Cross", "support_website_url": null, "website_url": "https://www.redcross.org/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
om&_nc_ss=7f20f&oh=00_Af3SqSG7FGR4CyUQIeoOencecfCuabdYFj_vcPbcYZQgOg&oe=69F35EED"}, {"file_name": "sc2.png", "id": "796724696194563", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821674_796724699527896_1708595419800218925_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3S4PHo8g7DsQ7kNvwEtQ7SA&_nc_oc=AdpXTMyNXY0qlK6pCmZNSVLDUntxDeNbs7SGBHdkBKlcbESBAPZVb0KEVCG45JoNStc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1p-pbQ0Ewx06hhVg1RuSAHWGTEy7sG2IGM700iVAv1Dg&oe=69F36841"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqM9-Fcyd8wQ7kNvwFL2jQH&_nc_oc=AdpbE9Slm0ScF07d9U5M6Vpa59OBU7ZAix2xNKBf0t0T88f-L5-D4rhM_43YcypnROg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pRDjTd4KAyalCqOi4017jg9pIL7cRYbHcq7UU5XT7WQ&oe=69F34016"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT1ePCHj5UkQ7kNvwFnTu1_&_nc_oc=AdqiMRzpwp8CZdQ3K7GgMA8pRF89Bn7OGlQoU0Gj_0FqyKo-8EeuKon5bfA84xkKRGs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IC9z33I_91vCSWPHJBSSfR0xVYbtE6NB8IR9uvA1vaQ&oe=69F36480"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xllhQSkby0Q7kNvwHGBQKd&_nc_oc=AdpAHEyTms8JpOppqmrBRvKFvhB1zwcbGGakNj5UP3VnyM-VeypVvSH0nT_9Vazgrmk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wkn91vqlhPShvQTs6dm0944Xx2KWFlUQVh4e6U2N6oA&oe=69F34BC8"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "gen
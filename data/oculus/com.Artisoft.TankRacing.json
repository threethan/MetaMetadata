s2IlsdxW--HLf0YmYHOUFjU8g&oe=6A2C2BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440AV.png", "id": "676717751589671", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491818885_676717754923004_5561180056169484183_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkO8x8PJqDEQ7kNvwGvdreu&_nc_oc=Adrb8zhgs_Vc8VkKsq2JGJ9BCTbZOmNxYGiL4fY7ggifU3iDhsny8OCSbj0CwwddB54&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_u-mDrQ1to7x3qrUgHL9AlXRU0f_qQ-YwVBzecg9wpSQ&oe=6A2C317A"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete in chaotic, action-packed races. No internet connection required.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 12 Unique Maps \u2013 Race across 6 long, scenic tracks packed with high-speed straights and strategic corners, and 6 short, intense circuits perfect for quick, action-filled sprints.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 12 maps with 17 unique tanks. No internet connection required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v2.html", "developer_terms_of_service_url"
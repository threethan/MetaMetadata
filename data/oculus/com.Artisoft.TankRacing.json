_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1L362WE9GBsQ7kNvwEEO8Nw&_nc_oc=AdmDfXdoVcNRRBfgm8l0iTkhZbOwQS-31W7_4gY2m9nu5sZxn4W824zJIWGwlMk1RxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsoA7-Jbd7d_uhoDzVpbZL_RJvzdztWuVWa8uwgHmpA3Q&oe=699AF43A"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete in chaotic, action-packed races. No internet connection required.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 12 Unique Maps \u2013 Race across 6 long, scenic tracks packed with high-speed straights and strategic corners, and 6 short, intense circuits perfect for quick, action-filled sprints.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 12 maps with 17 unique tanks. No internet connection required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v2.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534
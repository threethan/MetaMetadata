-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vI54f-J83Jud5zxVQjbZgcn4h5uJ89TeFSMjpm7_g8g&oe=6A393E6D"}, {"file_name": "sc2.png", "id": "796724696194563", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821674_796724699527896_1708595419800218925_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyIaL6IWDBAQ7kNvwHPdgw2&_nc_oc=AdpZKe_4iIZ0_rjBIO1K3gQSqqiSkV4ghFSE7DGATniij0gGXEAURCx36liaABUVG3g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Bx5RIGx360CAH1NcbpXmxUc8A-V7pIOUBnECTLw_s2w&oe=6A3947C1"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUhQNQM9ekIQ7kNvwEPOrar&_nc_oc=Adohy-kHEojNi-_3ZnuPrrNw0Mw_ghoVo8nM59Y3nAs1Aowa7bZYCMbw39a__mFY24M&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BASbHGDvs_wyOKIfnjeDcnMZ5evpi1IfXY9gwzICG0A&oe=6A3957D6"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMqql6JImoUQ7kNvwH-O1I1&_nc_oc=AdpxT_jGNywwxm3HmIoOrM4px_JWU3vNRDPH3ajm3fuk90GW7NRSVsVB1LVNtm-fcPo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9egefWL-K88BLgykk7MxiXpwHXiNe_2EeO5Reh9KOMyA&oe=6A394400"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsBBT3tKeeEQ7kNvwGNqfJa&_nc_oc=Ado5RyflDZ5_BaZeUBOPRJ_REmxTkGln_8LK5_PjTYTJzpyP8D1r3tpBZ8HRBiAltH8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MYqy9AJLD1NaIDVzMU6Q0al7MXz5sEbgfe2A9GMJ-GA&oe=6A392B48"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "N
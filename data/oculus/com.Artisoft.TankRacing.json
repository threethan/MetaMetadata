om&_nc_ss=7f20f&oh=00_Af9r67t_-9_VTW001wQDfV3DxIdqbPgdWmFUaveprgoouw&oe=6A21836D"}, {"file_name": "sc2.png", "id": "796724696194563", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821674_796724699527896_1708595419800218925_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fH7ShJIywKkQ7kNvwHYXsgS&_nc_oc=Ado3fzUpzdPUWgbEgyhxnx3Dm5wEJwD0OSBq29vseuNWl7YdtQKHDB4IKcCfpqPBxbc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HBwtOE_raPwJt2cpBGuqq5fSOVy6Ozdc4u-XMpvaHmQ&oe=6A218CC1"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gawhEXdODTMQ7kNvwF6VE-n&_nc_oc=Adpf6PiPw3HIzzLS8HajXPHpZMiuCHWqDlWqwCHYXvzEv8_WD-z8wP13Zya3TtCVpQg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9byK4FR3AKWjgvOiSXQWjVwE-uc27roCOf4_afqUd6SQ&oe=6A219CD6"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeIC4SViyuIQ7kNvwHIRni7&_nc_oc=Adr3JToR5aegIR8YAd27agY7Ys-mYvfmk8jAIYI7qCchCgKFiUpgi5X7GnWG89xgIu8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QM3S4S4eQKqKJrN9pfZCK7Qm_IxXMqHXHca7tB-Aj9g&oe=6A218900"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5brVGlO0qJ4Q7kNvwEog_PM&_nc_oc=AdoJQZF365_y7Yfn9adSgmmcENgOxtrnbph42awYbkIBryKit8Sj4vDD78Cx-_qXCAA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96vMnSSKNJTmLdu8VdijV7jRQuw_8N9YeFqx5MNCSAYw&oe=6A217048"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "gen
om&_nc_ss=7f20f&oh=00_Af-QqBL9CKSKDRGhsrUtRFpsPvA7M1p6bCg0DwXPVZNdbw&oe=6A3E846D"}, {"file_name": "sc2.png", "id": "796724696194563", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821674_796724699527896_1708595419800218925_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOCj8rYyfFEQ7kNvwGwyNJO&_nc_oc=AdoaYfw1MvzZiOjuLi0POJI-102Xb3qmaU87q9zm0Bq4nDymUeDt_eU_1sR_Tz-WB54&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_EKeN5prP8E5UwmTnizxHVXxQdsJ6HfQBnMpDiJrscSg&oe=6A3E8DC1"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0DfT_u6M9wQ7kNvwERrBFs&_nc_oc=AdqLgp6FuPu7mq2rgytE9UiFna1Kbyia5Ik4RwlCVaT7MA6ya8sAPCItQ831AtZWBoA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CMOJ0i3JH3ME73XCMpLX2aoiOdYKUG_WFUXjVDDXUVw&oe=6A3E9DD6"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGT5t-a7DQoQ7kNvwFS2nIA&_nc_oc=AdpqIgUdMqTXmUjV-2e5KSiOTAtm-HAnZAATHzjXi_5acOs0YR1Od49skIFBx0j9DV8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QxDqnb1JKJc42NX_9qrtGyNdO6cqhlXwLPWtZD1hFUA&oe=6A3E8A00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_mCqboTtKkUQ7kNvwGKcxZ5&_nc_oc=AdoxLlamyPVbRs3H5mXqB5R4oynksGi3n1bXJMz_OS0EjTx_2Hiw7makBvCdbI-MO4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9th1OIdVSoeRjofnxapd0QgASovpq_kUlD-I2vtfts8A&oe=6A3EA988"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "gen
dgWRGtI4mbEweA&oe=6A9D706D"}, {"file_name": "sc2.png", "id": "796724696194563", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821674_796724699527896_1708595419800218925_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVJU4e3hhRAQ7kNvwHVJZ1R&_nc_oc=AdrZwnys9yiV_SCPKQ5J2vmIU4fB_cwD4Gl--DetdUr-uzUSfzKCwV6lQz37eS2Pjts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdwIMhjqOfGioFViCh2xM42PCwop7lsmR1phHvGLXbZQ&oe=6A9D79C1"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAaIWtdmya8Q7kNvwFa9goq&_nc_oc=AdpELabypL5eFagmog2O3lGvIoG4kRD5dMD1miPlKSZbcjydXdXjoP_7lAzUpDjKrPE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfjGV46oExJIaFtXoX-hkoDMskm6DuQD-yVSSzQ9JBXQ&oe=6A9D89D6"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhUla5dPw_8Q7kNvwF8TB8d&_nc_oc=Ado_iHe1ogjGKsVPFWTOBjnjdpEr_7lfKZBa9YUUj8S-l6dg_pWhHbuFRzweFQM4LvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKNMRyxVo2OWRdHC3L-7RodHoAxSHM4ZwV_199KdFy6w&oe=6A9D7600"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45ObvKbSla0Q7kNvwHKP2QH&_nc_oc=AdrpAAVqGVHoHSitVc6ssXDWaJkZWFSsECUT0LgXIcMPIlbBe7J5Kvy04Em1N6n2WYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR8b_Efe4LVWFBHa4pTJXUMytGBro_sWMGsyLsbKPPMA&oe=6A9D5D48"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
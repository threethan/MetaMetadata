om&_nc_ss=7f20f&oh=00_Af6LbmT66774lgEltnYY__Dj_1n-rPYI_1rPe2eEPYPNew&oe=6A105FED"}, {"file_name": "sc2.png", "id": "796724696194563", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491821674_796724699527896_1708595419800218925_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBHg0w2M5zoQ7kNvwHnUXB6&_nc_oc=AdpKpz1KssTqU9y-DCJSVl5YB8ZHnvLo6AnXrt7B8HVaiZQrM8qrmfetTSc6ACagO-k&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44juphdToH1E1OF4KPzKmFNeC_2fOUyx2vcfSBR0QReQ&oe=6A106941"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovgt-tYoVb4Q7kNvwGm_RfX&_nc_oc=Adqa5z4npBtHAPE1XHjsRysUbZ-cDolxyM-T7jVLwSGa71TxTLkcL2p6ATLiL_iNGu4&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OQUEz04tq7y3ePkp7N2Gyq4GlnhkAudaUqIJ7N4kKlA&oe=6A107956"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=225iE8nCYxsQ7kNvwEkzhJm&_nc_oc=AdoJzR0Byu92fDqzkE5ANZSg23m0dzZ1dUjCnNjZJTEpn20TQ6PwUVU8eEVtzKDgQzE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65kQWL1YJjUOfzD1ZOA5yTQ7AHsc7M_zANlgK_ApINjA&oe=6A106580"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWgnXxLPQ6gQ7kNvwEiZNI1&_nc_oc=Adq0CAfEq06grEzcsBkawBB-aWmhTllaBbjKegOmieQ8PQZJKF7uCG2Cbej6fIAIkAM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69cuqp22JFes_P-uqwN8Fst8Edtvjjp0gLZTnGTu08VQ&oe=6A104CC8"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "gen
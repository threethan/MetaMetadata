om&_nc_ss=7f20f&oh=00_Af5wh9eqpnQnuGaxXlbG_m5PIi-ELwkeZ8AJqjtQN-b-UQ&oe=6A0330ED"}, {"file_name": "sc2.png", "id": "796724696194563", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821674_796724699527896_1708595419800218925_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FGqDSRMwDpUQ7kNvwHS3a2u&_nc_oc=Adp3NJfI0GDqxgHke5NPlpN_jt7Ia1FtmNJx-0af_uK_bZIrproXJ8qpiaVghZOss0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mc00k4fxhMWYQ82fYC_hZVUWLPlaLQX_UbfAF5ZeNwA&oe=6A033A41"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZUbNE7p15ioQ7kNvwGg1Nz2&_nc_oc=Adp_0NJocoXeNYCzuWlezOHiPkdfj73_uuvnoS-YUEkUEXuNFwLnBRELBgnwP5z0Mto&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ja-nzPVqeHsyldLFx1C_YMySgE0WWIVsxSYUgqu_mWw&oe=6A034A56"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22lm3ndcPLEQ7kNvwHUb6L9&_nc_oc=AdrpUQOisTEzIhrtnZiGZLi_1Ggt293hHT-6Wyf2NICfYe1PlW1Bj3CXP8zwhgeY56k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6JX-ueTUgHsv6lBBwWIXj1Hl1E_Gn5ANH1OMoIxYT_wQ&oe=6A033680"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI78JJ825IQQ7kNvwFCyZ4k&_nc_oc=AdoY_lAOGvMwdaauXm2PPPdT2UtfqMgXAl-DDQJ-OapawIAt33kcknHW2xX6WpQn7Ns&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KPq-vy17jsJGSdBBwuBgO2o1gN6PuuRRIUidyWhCRww&oe=6A031DC8"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "gen
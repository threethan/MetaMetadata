om&_nc_ss=7a30f&oh=00_Afxx88DMpldz1f9G7LjhmTVDuSXkJ2W_SrYsgxyzLwc5uw&oe=69CFC66D"}, {"file_name": "sc2.png", "id": "796724696194563", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821674_796724699527896_1708595419800218925_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76jZL2BPEOsQ7kNvwF3RhJr&_nc_oc=AdpmWy2nGDVIGZKiYFgntmEJYL18vlTFNT1ltFh7ceQaC3S_PQhQ4afUAq5x_VNjNu8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwsjTQhocEaK7JF7iQXaizYJeQCF2ukNEtc8gtWJYKOaA&oe=69CFCFC1"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ek4I7oM4r9cQ7kNvwHf6Stk&_nc_oc=AdpqU908NbRbLBeWgAyzZxtge5v6jOxFohE-w1HyBoChldAVWH_HJP48W6p7cpSwERA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwclGLrAobMpGmQAty63ALUP443KJJy5Zzrin2whKAXDQ&oe=69CFA796"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o4_sfdm1RgcQ7kNvwHaMmEs&_nc_oc=AdopKffRVAl1eMsDnCm6Frhzri3-sVTVoxYUYDM-1vsWvIcztnv8hQX3S-TY0DTKQuY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx0iPsli-CmiZ4blbemZLRV28g-Nse3ESNhUgxvA4Kk7w&oe=69CFCC00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ydI6GW_-m0Q7kNvwFaUCw5&_nc_oc=AdosiV0XNAWJSGoM9Y90jrNIU347jvA4g1e8dW4QmZP9mSwgSrpmsP8afy3Kl6898Pk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIxhAy-hokY0HlYYNlCIE7Ok-wSLzR3-jSBabkoGISeg&oe=69CFB348"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "gen
=6e7a0a&_nc_ohc=3S4PHo8g7DsQ7kNvwE-ChBW&_nc_oc=AdoVGhz_V0URUeVrLsGEWyRwGW5mCDVG3AsX5fBdexJ1wcdD6KhOQtxhWPmcgN7fGsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af3_QVh2Jd9rxV5tG0D2m4MU0_aFlR0O8fGvUl_6TAYpGQ&oe=69F0C541"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jssY8ILbe8Q7kNvwHVXnVk&_nc_oc=AdrzI2F6zl7nytGEsoRGSzFRshMBCN9f_w3vXRwgA9eH9Uq5MQgK_EDfsAXZn5VYcDE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af1NOMRvGSnuU7id2ayxncPt08UieB_dCZbdjEOQ-76ulw&oe=69F09D16"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiFfxZD_LJ4Q7kNvwEAvtNr&_nc_oc=Ado4j3AS5Ue1J1hAS2ezXTeZR43I3rGmuY5j1ywzw-1DrcwNwk43ZPWoyKjtoRPkxl4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2rO0BCF4X7sTcsHt95BLCQzMd5RaYE3EqawksfS4G6VQ&oe=69F0C180"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLwb-Hvy1_cQ7kNvwGHnVbk&_nc_oc=AdpB391D08TDjwvp9xuAljmQbR3oSvtsUaR0ebro_cSOJaIL-TZE1DStyYeH0gKqJVI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1vyWg6c3piZKyg51hZ8ME1P-HSOm7r4hr_DQnOJsXADA&oe=69F0A8C8"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "RO
_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWQRPmYrSPYQ7kNvwFXfr4F&_nc_oc=AdmIV1g5dUahJmnkJZdoUmxovl7lySaxvJxFR4Z2XyMzkJRWlNcBZCawZ8f-RUx2ssA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv7cYW8nS4xjEicBpWEB4bdRx7X1bsDQuxvJV_3GCh50A&oe=699EE8BA"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete in chaotic, action-packed races. No internet connection required.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 12 Unique Maps \u2013 Race across 6 long, scenic tracks packed with high-speed straights and strategic corners, and 6 short, intense circuits perfect for quick, action-filled sprints.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 12 maps with 17 unique tanks. No internet connection required."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v2.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534
NvwHXltzC&_nc_oc=AdrIWjZMzDk7UqMT-XDOa74e8k8l6sz-E98wfWDPJyssUheU9Bg5lNobpJAyITHB3N8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5maZGvhTPUNT2hMfK7DJ1pTxnmCHKp6m8kVkfwn1q9g&oe=6A70A6C1"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8cQGqXsXoYQ7kNvwH0hjt0&_nc_oc=Adp-6iKQ25jLIVGBqzvkXQGyITc64HcHScRYgFukG5tSt8zP4sdLkfjxT8it-gDTNWs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmWvYQgH4E9MUIQKPFp829dIy8_04a1cSN2opREValcg&oe=6A707E96"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsu7SjtbVR8Q7kNvwHgLzKD&_nc_oc=AdqjcUUci1_QUBluwTwL3NEIAtxUP9f3vfSGZqNSQMgLJcDMFNlSG3pSXWE7phaayBg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvZTJI32H3JUbyWIOug8kEvk8_JfikPfXnVx4Tf7U7Mg&oe=6A70A300"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v9wD3gBzs8Q7kNvwGhV5Ue&_nc_oc=AdpNKkzktBfvU7YUYk-VxHU5VNHm7paWrHt8GgpflxUEPpFnXfNEka7Ru-SkIhO6fxc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa2lVK8sg09nfnY8EkK_3EY69N01LDZ9nqOZ6a7HeQTQ&oe=6A708A48"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SIT
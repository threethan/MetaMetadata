68s-2UtPh9eBCg&oe=6AF9B96D"}, {"file_name": "sc2.png", "id": "796724696194563", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491821674_796724699527896_1708595419800218925_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeDiZcWp-20Q7kNvwHf9cda&_nc_oc=AdqXGLHvrYbbHioT9QS6m0b8yS0pfq3_R-6h2AtLxt7M_bXpZJ7Px54mpu-GmA4C65I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTpSjTbpwLyy9M_MLCxor0C0azeWTjpFB40qnGmcLcbw&oe=6AF9C2C1"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWoudIT5UcYQ7kNvwFTm8xQ&_nc_oc=AdrIBjgG_QtqbTkyt4NDoohU19u988WYHpRN2Spf7Qzo41dQBYCkfvLi9xyaARxnqwg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJfbiipVQYtPstDutErTwjKf4Oxl9vz12VYRLl0JyTkw&oe=6AF9D2D6"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLd75kU8CskQ7kNvwF5O6S8&_nc_oc=Adp8LCQY-vdhX_snV0U_9ZGeTJcb8iozK39FhrJrX_oJ42RHIHIiQ8HAk77EIzGjPaU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNWULQBfEW6W8mhnNN9GTSf8I34i4n7bF2udlLl1tvFw&oe=6AF9BF00"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfM3wCi7oDMQ7kNvwEvUPvR&_nc_oc=AdrsU0tS0qQwv_ExuW5lROajhtOUkeirHXJ-sKgl4mtr4Kma1Wp6pH4nTkUd5GEKdW0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQbZTJMxTgmebAagcbwzPnw2S6yO3LSYu-ikPOxa8vNg&oe=6AF9DE88"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
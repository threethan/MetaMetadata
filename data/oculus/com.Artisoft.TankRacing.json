etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDyssS8m7IYQ7kNvwHl55jI&_nc_oc=Adq6y6ScX_xf2ekX-FveZ8JR-V1wpdR3i1bgn2siIu6iSrbyOnuIDtTGf4Ybnq6J63I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1LkAcVJ3ajPgypvpsYk_J1jqHvg9zdK1sXIYFkpnYKQ&oe=6B01DAAD"}, {"file_name": "sc2.png", "id": "796724696194563", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821674_796724699527896_1708595419800218925_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aUabScISeHUQ7kNvwGlR3CO&_nc_oc=AdqGLQt525D1_XyHi0Dv8V1VyksNwj5cr1DM3G6HVjm2cTMJT0PDOq3iCb6Erg4GGXc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHtRC8kjaaBCN6WRY5j6dCuCGziuyhnGsCIaqt5QfOwg&oe=6B01E401"}, {"file_name": "sc5.png", "id": "3119759598184456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821696_3119759601517789_2479938563870286917_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwRSdYWSP1cQ7kNvwF86mos&_nc_oc=AdpXhjnxRcHNcnJICZFDisQDVcC-kto4-IiMC7vbpism7ptoQXcLYlkmQfU-cSAs508&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMnBXfSPirjJCVb5FllKXvqlkIxxKHIQ6PQBsbRAzEfA&oe=6B01BBD6"}, {"file_name": "sc4.png", "id": "1143246361048408", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823271_1143246364381741_2571020295688787736_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob47l34hepIQ7kNvwEjfM7c&_nc_oc=Adot1-eVC9V0kBcOUhMAYjsbwSJx3B-xnYdK5DmDRnNMtuWuSM_jWbE_BdLpt5TRsbc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxv80tgt3TsuGgkXpbSnXXnoNe4Ol_0MnyEdmhAQshDg&oe=6B01E040"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "tank2560x1440.png", "id": "1318316806344643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819323_1318316809677976_7137219351815714442_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fD-9PJQv57MQ7kNvwFNlhEG&_nc_oc=Adr88EHYhV4rjfLQuGsssuSuijK86Qh3nAp7YhfgFP6ZD_VZ4na-Agm7UaUKyrjGB0c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9wjJpNV_UOBnF1nu0QNjjpP0vtn5wZmnmWJxDfe3KTw&oe=6B01C788"}, "display_name": "Tank Racing", "keywords": ["racing", "tanks", "tank"], "long_description": "# Tank Racing \u2013 Explosive Multiplayer Mayhem!\n\nStrap in for a unique twist on racing in Tank Racing, the ultimate VR experience where speed meets heavy firepower! Compete against players worldwide or challenge smart bots offline in chaotic, action-packed races.\n\n# Key Features:\n\n\ud83d\ude80 Racing Meets Combat \u2013 Outrun and outgun your rivals with cannons, mines, speed boosts, and shields.\n\n\ud83d\uddfa\ufe0f 6 Unique Maps \u2013 Each track brings new challenges and strategies.\n\n\ud83d\udee1\ufe0f 17 Tanks to Master \u2013 Choose from a wide range of tanks, each with distinct style.\n\n\ud83c\udfa8 Custom Online Avatar \u2013 Design and personalize your in-game identity to stand out in the arena.\n\n\ud83e\udd16 Offline Mode with Bots \u2013 Hone your skills or enjoy racing anytime, even without internet.\n\n\u26a1 Comfort Options \u2013 Features like adjustable tunneling keep the action fun and comfortable for every player.\n\nExplosive battles, chaotic races, and tactical power-ups ensure no two matches are ever the same. Do you have what it takes to race, fight, and dominate the battlefield?", "short_description": "Tank Racing is a fast-paced multiplayer game where racing meets combat! Drive powerful tanks, blast rivals with cannons and mines, use speed boosts and shields, and battle across 6 maps with 17 unique tanks. Play online or against bots offline!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/tr_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": "https://tankracing.artisoft.pl/support.html", "website_url": "https://tankracing.artisoft.pl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "24504722432521963"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1687244076156252"}, {"status": "PUBLISHED", "id": "1374623898093054"}, {"status": "PUBLISHED", "id": "1550398986010675"}, {"status": "PUBLISHED", "id": "1761911234816405"}, {"status": "PUBLISHED", "id": "1740577077128648"}, {"status": "PUBLISHED", "id": "819784307841643"}, {"status": "PUBLISHED", "id": "1264857335486003"}, {"status": "PUBLISHED", "id": "1198234578519916"}, {"status": "PUBLISHED", "id": "1148820164024837"}, {"status": "PUBLISHED", "id": "762585736755934"}]}, "baseline_offer": {"id": "1550398986010675"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1687244076156252"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25616618711332324", "version": "0.44"}, "id": "780089894517489", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24504722419188631", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "256166187113323
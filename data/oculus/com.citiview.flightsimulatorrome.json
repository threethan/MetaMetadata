fH-SaX97QQ7kNvwECLL4h&_nc_oc=AdrgYHHTG-MYXo6NxyAGg_6sY0D5LQOTg7JKdVVbnYjssmYh-7gXTVCPTULym2jM1kI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSs1coJ5RBL3Des7DOGhoncnP_n4axd-7og8RTUIfunqQ&oe=6AFC7887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3397130277342117", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673645340_3397130280675450_6697352281133178155_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNBk0ggz1QsQ7kNvwFMLUyK&_nc_oc=AdqVtKPVQPC_r2tjbVa0TSf6vP2pkfjlpBeG_gidk-8guQ4x9Mi3nI3S8TNVG4kZYr8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEw4i8aNIfZ5kEifKW6ThLaw89c5pWxh7_OvZUK3y8Ew&oe=6AFC85A5"}, "display_name": "Flight Simulator Rome", "keywords": ["flight", "simulator", "rome", "italy", "jet"], "long_description": "Flight Simulator Rome puts you in the captain's seat over the real Eternal City. Menus in English and Italian.\n\nTHE REAL ROME\nReal satellite, elevation and map data: St Peter's Basilica and Michelangelo's dome, St Peter's Square, the Colosseum, the Forum, the Pantheon, the Vittoriano, Castel Sant'Angelo, the Spanish Steps, the Circus Maximus, the Baths of Caracalla, EUR's square Colosseum, the aqueducts and 40 Tiber bridges. Four airports: Fiumicino, Ciampino, Urbe and Pratica di Mare.\n\nA LIVING CITY\nThe Leonardo Express, the Roma-Lido, the regionals and a Frecciarossa on their real tracks, traffic on the roads, umbrella pines, yachts off Ostia. At night the domes, the bridges and the Colosseum light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances, departure, traffic calls, the ILS and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar on the Gianicolo, the domes of Rome out of the doors. Walk around, repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with walk-through cabins, a midsize jet and a twin-engine fighter.\n\nMISSIONS AND FREE FLIGHT\nEleven missions: Fiumicino and Ciampino approaches, a Tiber run, the Vatican pass over the dome, the Alban lakes, a fighter scramble, Rome by night and a Rome tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat is off until you turn it on.", "short_description": "Fly the real Rome, built from real satellite and map data: St Peter's dome, the Colosseum, the Pantheon, the Vittoriano, Castel Sant'Angelo, the Tiber's bridges, the Alban lakes and four airports. Start in your glass hangar on the Gianicolo, talk to air traffic control, fly private jets or a fighter. English and Italian menus. Fly solo or online."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatorrome/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatorrome/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "it"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1374437832419419"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1785297472763134"}]}, "baseline_offer": {"id": "1785297472763134"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791918780, "status": "PUBLISHED", "id": "1785297472763134"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary
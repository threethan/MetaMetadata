nc_sid=6e7a0a&_nc_ohc=sySHdj3B5ecQ7kNvwHTKLq_&_nc_oc=AdrT35K11CBrl6XVByivpkeEJaBi1OInKZ6LHJQuJ6365gh5bKZ4nPEBZY3Y_OeLe4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU6sx9Ayb4AYkjRt4PMRUATUWG6zFCLN60N9MmYe45qxg&oe=6B1041A1"}, {"file_name": "Untitled design (28).png", "id": "1526826451615397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304032_1526826454948730_1214110258266513684_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR6aDZDQvMwQ7kNvwEVu-l7&_nc_oc=AdrYZGRHlKv5vNhXt7baeJNv6BJY3xLV7PLOX_kcP3aY_D_eihApQl65BFg0ySYe0oI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdWZ8z_feCXfq_EEBxBlLsO4HXn3ICv3I0ejqK9ndNPg&oe=6B1034DA"}, {"file_name": "Untitled design (25).png", "id": "1734691430469139", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499323303_1734691433802472_6310416851830142012_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKycwI2-W2MQ7kNvwFfg6rY&_nc_oc=Adq1cn0-o1UYOMu8KwTx94PsoGeHIUvJXYu8CFT1_wXCJeTX5orD-KzrDX_henbPlAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWd_C0y8E_u5PYRzSG7mLL9WQqCNXnQ7uIY_WLZuTjhtw&oe=6B10543F"}, {"file_name": "Untitled design (26).png", "id": "1753151905599320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499331721_1753151908932653_1786943968694914724_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0KpEDZt7ZgQ7kNvwF3vnxX&_nc_oc=Adp7djcmD7UD3rLLw6m3MPhn1A01Oe-fZ9FZ0QjAM0v6PzYuiHGEFy4FYsETQisdCNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWUNyTxBE3WBalEC2GBFcJzZf0q7uixRcCne32SrzxR0A&oe=6B105814"}, {"file_name": "Untitled design (27).png", "id": "1223467682832964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307445_1223467686166297_1442245159012549246_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVkXvRThyVQQ7kNvwHTyDlb&_nc_oc=AdoBNl1QHnvK5eJXHkTZECuK8Fn71c2-XeLreP93-iaQxact5wVgTyfhMOHRodxo7kM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXB0jX6ytdnwuGpU5c7ijsiWnacrRGdDegBCISIKwrtYQ&oe=6B1047E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillack!", "keywords": [], "long_description": "Welcome to Gorillack\u2014a wild and energetic VR experience where movement is all in your hands\u2014literally. Spawn into a lively forest full of personality, complete with cozy tents and a slick in-game computer where you can customize your display name and choose your favorite color.\n\nFrom there, explore a wide variety of exciting maps, each offering new places to climb, jump, and swing around like a true primate. Show off your style with tons of unlockable cosmetics, and get ready for action in the intense Infection game mode, where players must outmaneuver each other to survive or spread the tag.\n\nWhether you\u2019re chilling at base camp or racing through treetops, Gorillack is packed with nonstop fun and creative movement.", "short_description": "Gorillack is a fun, fast-paced VR game inspired by Gorilla Tag, where you swing, climb, and leap through unique maps, customize your look, and dive into thrilling game modes like Infection\u2014all starting from a cozy forest hub."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vextexh.wixstudio.com/gorillack", "developer_terms_of_service_url": null, "publisher_name": "Pack", "support_website_url": null, "website_url": "https://vextexh.wixstudio.com/gorillack-website", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
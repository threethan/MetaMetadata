B761"}, {"file_name": "Untitled design (28).png", "id": "1526826451615397", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304032_1526826454948730_1214110258266513684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6k5DlJtbRKkQ7kNvwHgP_NZ&_nc_oc=Adl-0sY-Ma2J9TwWvtm3XxwWhbT-qTVZgZM9RrxqkHUyw2LbZeHLwuTVecUpteD2P-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx6VXquBTwBtXOqltHz4P7SEuA-midhTWniuw1Lzt24Og&oe=69AEAA9A"}, {"file_name": "Untitled design (25).png", "id": "1734691430469139", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499323303_1734691433802472_6310416851830142012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16FO8zlP2hwQ7kNvwG8ccsM&_nc_oc=AdliBoUV2hn9pPADOKrfMUjltUrTzs7iICb7FesmpPYnX-EnkSmNOr6FhwVINlQnBM0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzb0QKacfuSauEGH5cC682wNHvIohc05pQ7muGCxlUPmg&oe=69AEC9FF"}, {"file_name": "Untitled design (26).png", "id": "1753151905599320", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499331721_1753151908932653_1786943968694914724_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CNaTwLvSKEQ7kNvwGqptn7&_nc_oc=AdnJjQdZ0AQEhm0qXvYm0AYiVI6PbGd7LnZGnwIIoUf9MdOSX4Xz-kQGcQCV4CL8V00&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxHijfu3AS3sfHAhOAbtDTEjcDknO35tMMhE7Kda_46mQ&oe=69AECDD4"}, {"file_name": "Untitled design (27).png", "id": "1223467682832964", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307445_1223467686166297_1442245159012549246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0WZeR-366EQ7kNvwEBqCRE&_nc_oc=AdkmR8YaEFUoYAiG0nK1faS6u3Ddz3tV_KuMedaJoZWhOBcbvKFpucWrfqf9a1C4gOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfykxKwxyd9M2xb_dfRjitx18vRh_cC4pLYWlLT6ZYj3ww&oe=69AEBDA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillack!", "keywords": [], "long_description": "Welcome to Gorillack\u2014a wild and energetic VR experience where movement is all in your hands\u2014literally. Spawn into a lively forest full of personality, complete with cozy tents and a slick in-game computer where you can customize your display name and choose your favorite color.\n\nFrom there, explore a wide variety of exciting maps, each offering new places to climb, jump, and swing around like a true primate. Show off your style with tons of unlockable cosmetics, and get ready for action in the intense Infection game mode, where players must outmaneuver each other to survive or spread the tag.\n\nWhether you\u2019re chilling at base camp or racing through treetops, Gorillack is packed with nonstop fun and creative movement.", "short_description": "Gorillack is a fun, fast-paced VR game inspired by Gorilla Tag, where you swing, climb, and leap through unique maps, customize your look, and dive into thrilling game modes like Infection\u2014all starting from a cozy forest hub."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vextexh.wixstudio.com/gorillack", "developer_terms_of_service_url": null, "publisher_name": "Pack", "support_website_url": null, "website_url": "https://vextexh.wixstudio.com/gorillack-website", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9569516619813823"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304974_1400044457684689_6977700419067836816
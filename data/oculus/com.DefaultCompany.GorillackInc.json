ZRSdcTarlqLi5fzXV5QITRvw&oe=6AF49221"}, {"file_name": "Untitled design (28).png", "id": "1526826451615397", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304032_1526826454948730_1214110258266513684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_e9ojEr5KUQ7kNvwHsbHmi&_nc_oc=AdoBn6Yi37c4Xcvni7pK2nkMYbkrYH-MYLq0pROi6mXPScoX1BwhP0A6voOUdsJf39I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRI0NNuzUcRHnqydEsP5L07BLggBMEXLvrL_ZVjN7ZkjA&oe=6AF4855A"}, {"file_name": "Untitled design (25).png", "id": "1734691430469139", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499323303_1734691433802472_6310416851830142012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sgQMuUMxxA0Q7kNvwFJTWvj&_nc_oc=Adpv1vipHrHS10SerIRSUPN-ajO4qZVVQw1JCD4xCVeWdgJtipYctsQ6-hAnm3cew48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU0_PwJTJOFt7r4cks8phGsZVP3xIEc8gjPgt3lpTgFg&oe=6AF4A4BF"}, {"file_name": "Untitled design (26).png", "id": "1753151905599320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499331721_1753151908932653_1786943968694914724_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPmjZUsNVUIQ7kNvwHnu8I-&_nc_oc=AdqdLa2Q5t16MqavZzn3ANbErJ4VtWH8YtpUHScMTWW1dIwie8b6C0JpdnXarhaZqq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIYHzf9IPCozqMkK2yZSTXCedcP2mtnvzGzRNOFZ5RxQ&oe=6AF47054"}, {"file_name": "Untitled design (27).png", "id": "1223467682832964", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307445_1223467686166297_1442245159012549246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhaP8EBHhIQQ7kNvwGBKehh&_nc_oc=AdpS11hg8v9tc0sjFH8sTw5IIHmy_1lGQ9g64FVckJDkV9ARQj6oMHGPltFOLC9MW80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtvNEut0C3RWreONE0iyXabRnVroVYqBt_H-FI0gPwfg&oe=6AF49867"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillack!", "keywords": [], "long_description": "Welcome to Gorillack\u2014a wild and energetic VR experience where movement is all in your hands\u2014literally. Spawn into a lively forest full of personality, complete with cozy tents and a slick in-game computer where you can customize your display name and choose your favorite color.\n\nFrom there, explore a wide variety of exciting maps, each offering new places to climb, jump, and swing around like a true primate. Show off your style with tons of unlockable cosmetics, and get ready for action in the intense Infection game mode, where players must outmaneuver each other to survive or spread the tag.\n\nWhether you\u2019re chilling at base camp or racing through treetops, Gorillack is packed with nonstop fun and creative movement.", "short_description": "Gorillack is a fun, fast-paced VR game inspired by Gorilla Tag, where you swing, climb, and leap through unique maps, customize your look, and dive into thrilling game modes like Infection\u2014all starting from a cozy forest hub."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vextexh.wixstudio.com/gorillack", "developer_terms_of_service_url": null, "publisher_name": "Pack", "support_website_url": null, "website_url": "https://vextexh.wixstudio.com/gorillack-website", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9569516619813823"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-2
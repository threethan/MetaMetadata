zU-vOz-WQdJwXsZo6HfNyWXg&oe=6A95DE61"}, {"file_name": "Untitled design (28).png", "id": "1526826451615397", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304032_1526826454948730_1214110258266513684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixh26drwEDUQ7kNvwG1IpPV&_nc_oc=Adqi6j7P2SrxExLZW5I3vDswRMUzfCjJvYJs9zkt09dwsWNMdyIAtH5wN5pw4qUXzSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1RVvYUMz06xa7D8sELsmMEiMQeOehFeXEezwSp-PshA&oe=6A95D19A"}, {"file_name": "Untitled design (25).png", "id": "1734691430469139", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499323303_1734691433802472_6310416851830142012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxYixQ_mlxwQ7kNvwFdX-ue&_nc_oc=Adrdk7KruU7k_NoJOmLcsqwmZDNuH1IwcFQcuQHX-aCmwSb4kwyA6z-9DvwXNMA_sNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2tQJbrJzy5U2BxySdpeQe_2vGEI0AlG_JcZEutJ7H5w&oe=6A95B8BF"}, {"file_name": "Untitled design (26).png", "id": "1753151905599320", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499331721_1753151908932653_1786943968694914724_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_kJt2KyOIQQ7kNvwE8C3RF&_nc_oc=Adq4RrYX7dMb79U4fjpie1X19RbmHRnNLYYPaa3C3i1CFH78mI_d1_OSUtZ7OYu86-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEainU_C56vm5j2g8SRKRFuEjGjI2KQHjqB-cf_-AQ0lg&oe=6A95BC94"}, {"file_name": "Untitled design (27).png", "id": "1223467682832964", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307445_1223467686166297_1442245159012549246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPJV-peTqD8Q7kNvwH2DwDN&_nc_oc=AdpE4gv2_VrsaXyDQgHV5_UCU5WKu2m9aj4P0HVNP4oXYuSwNEc_ak8Vo3g3u9agNqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4qkyAqq-nDe5DEWRH-zRPQp5qAgAOKGA4GxZUmSuljQ&oe=6A95E4A7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillack!", "keywords": [], "long_description": "Welcome to Gorillack\u2014a wild and energetic VR experience where movement is all in your hands\u2014literally. Spawn into a lively forest full of personality, complete with cozy tents and a slick in-game computer where you can customize your display name and choose your favorite color.\n\nFrom there, explore a wide variety of exciting maps, each offering new places to climb, jump, and swing around like a true primate. Show off your style with tons of unlockable cosmetics, and get ready for action in the intense Infection game mode, where players must outmaneuver each other to survive or spread the tag.\n\nWhether you\u2019re chilling at base camp or racing through treetops, Gorillack is packed with nonstop fun and creative movement.", "short_description": "Gorillack is a fun, fast-paced VR game inspired by Gorilla Tag, where you swing, climb, and leap through unique maps, customize your look, and dive into thrilling game modes like Infection\u2014all starting from a cozy forest hub."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vextexh.wixstudio.com/gorillack", "developer_terms_of_service_url": null, "publisher_name": "Pack", "support_website_url": null, "website_url": "https://vextexh.wixstudio.com/gorillack-website", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9569516619813823"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-2
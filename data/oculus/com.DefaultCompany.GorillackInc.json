nc_sid=6e7a0a&_nc_ohc=kXblrdk4l2IQ7kNvwFqi7yH&_nc_oc=AdqTmimKNReXhZgWPQIU2Y-Y3umu4uARE-VjSaBjzpHeHwJr9Bb9y_QKKmi3KbEnYmU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFoCx-eG6MNA1cjAz9C7Jj0z8A9p7Y2kfBXv6l3K7sEg&oe=6AFB29A1"}, {"file_name": "Untitled design (28).png", "id": "1526826451615397", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499304032_1526826454948730_1214110258266513684_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ9cZoO5QHcQ7kNvwGpeUtl&_nc_oc=Adrn6pP9RRRxqAjqKlin056wbYy6S5tJPrIeDUW40F9NFoR0O4sfsWfWPr7MAe62zK8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7ZzCQLbaiiORDgvJDrFvfIK4N1bnXXKj8S_M4twCLTA&oe=6AFB1CDA"}, {"file_name": "Untitled design (25).png", "id": "1734691430469139", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499323303_1734691433802472_6310416851830142012_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBiux_QpLiwQ7kNvwHY7aVH&_nc_oc=Adp-V0uvUQ3nb2ogU8qYEUgJleQMfE_XL3W-4_-ZGz08_q-Dyg7YBxljXwJJPVIaQ68&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQa7IG-TmEyIyFD312t6NLMqKcJGzDCBLbLRdWvfS29Q&oe=6AFB3C3F"}, {"file_name": "Untitled design (26).png", "id": "1753151905599320", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499331721_1753151908932653_1786943968694914724_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_6PUtsEG_8Q7kNvwHt8N18&_nc_oc=AdqqvMPAApmKzxfFAqm2s6YMe5n0E_YBro6E9tl0fQ_oXqC0-u82pwnMbMLZ5f54Qlc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp7EodUEq8EYagegFKGqAPOZ60tk_eRHHZ90_hvsuwIw&oe=6AFB4014"}, {"file_name": "Untitled design (27).png", "id": "1223467682832964", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307445_1223467686166297_1442245159012549246_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJCExx2_zFwQ7kNvwHMP8Wc&_nc_oc=AdqLbZUDsie-3U5gOPxeOq74YHriFP_LaWX-eRpOcWJrHH9xwKUH5AFwFeB38YkvyW8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKKBtX0W3mR5N5Fb38AB__9pGbLbON-Qjc0qFzmuX4wA&oe=6AFB2FE7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillack!", "keywords": [], "long_description": "Welcome to Gorillack\u2014a wild and energetic VR experience where movement is all in your hands\u2014literally. Spawn into a lively forest full of personality, complete with cozy tents and a slick in-game computer where you can customize your display name and choose your favorite color.\n\nFrom there, explore a wide variety of exciting maps, each offering new places to climb, jump, and swing around like a true primate. Show off your style with tons of unlockable cosmetics, and get ready for action in the intense Infection game mode, where players must outmaneuver each other to survive or spread the tag.\n\nWhether you\u2019re chilling at base camp or racing through treetops, Gorillack is packed with nonstop fun and creative movement.", "short_description": "Gorillack is a fun, fast-paced VR game inspired by Gorilla Tag, where you swing, climb, and leap through unique maps, customize your look, and dive into thrilling game modes like Infection\u2014all starting from a cozy forest hub."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vextexh.wixstudio.com/gorillack", "developer_terms_of_service_url": null, "publisher_name": "Pack", "support_website_url": null, "website_url": "https://vextexh.wixstudio.com/gorillack-website", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
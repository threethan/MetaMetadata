n.com&_nc_ss=7f20f&oh=00_AQT94p7D45HE3BiouvsRawWTOl-pFNCmKihQim9jwiSZOA&oe=6B0305DA"}, {"file_name": "Untitled design (25).png", "id": "1734691430469139", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499323303_1734691433802472_6310416851830142012_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oc0_rHdO9RMQ7kNvwHLyLv0&_nc_oc=Adrdd87317kaH1zkzuoQF-GdcAm8v2xJ-xFw8c9dFjoKLQ0UhkYJL-hYCCpAoSdQ5qQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuJCIUpiRduwuWUbhW9urJsZx2C8q25qiwe1EFYSz_mg&oe=6B03253F"}, {"file_name": "Untitled design (26).png", "id": "1753151905599320", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499331721_1753151908932653_1786943968694914724_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_VREB7o4igQ7kNvwHeAEmD&_nc_oc=Adq9UmlprDZiwr19OLnjfUvLtdPiXgkuJGCX-bkKvOoS3NlMXwRz5nsErc523BHeLbU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz3ousPm-lZozL6KULd9AeZxHrb6wdiu0XpskWP0PyMQ&oe=6B032914"}, {"file_name": "Untitled design (27).png", "id": "1223467682832964", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499307445_1223467686166297_1442245159012549246_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Md2x_xPIHBsQ7kNvwG3OYMu&_nc_oc=Adq5uAfdgWnU6f1PLozzTEmBcxaZGK7DDabJ--PD7Iv5dERnNAvQeAnanedR3tnrLrg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUStN7Fo52Jhgf7u97MLtBoM8itqreYUp-TOP6_Xfh1g&oe=6B0318E7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillack!", "keywords": [], "long_description": "Welcome to Gorillack\u2014a wild and energetic VR experience where movement is all in your hands\u2014literally. Spawn into a lively forest full of personality, complete with cozy tents and a slick in-game computer where you can customize your display name and choose your favorite color.\n\nFrom there, explore a wide variety of exciting maps, each offering new places to climb, jump, and swing around like a true primate. Show off your style with tons of unlockable cosmetics, and get ready for action in the intense Infection game mode, where players must outmaneuver each other to survive or spread the tag.\n\nWhether you\u2019re chilling at base camp or racing through treetops, Gorillack is packed with nonstop fun and creative movement.", "short_description": "Gorillack is a fun, fast-paced VR game inspired by Gorilla Tag, where you swing, climb, and leap through unique maps, customize your look, and dive into thrilling game modes like Infection\u2014all starting from a cozy forest hub."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vextexh.wixstudio.com/gorillack", "developer_terms_of_service_url": null, "publisher_name": "Pack", "support_website_url": null, "website_url": "https://vextexh.wixstudio.com/gorillack-website", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9569516619813823"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1067272525275311"}]}, "baseline_offer": {"id": "1067272525275311"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1748367180, "status": "PUBLISHED", "id": "1067272525275311"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9614004335365051", "version": "
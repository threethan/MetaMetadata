nc_sid=6e7a0a&_nc_ohc=4yIIfdBWFxEQ7kNvwGQ8RZb&_nc_oc=AdoD_Ln7QhUS0CXk1FiotjkO3VfMxY_zLJ0b4-PnozB9Z5s2B_iQu6ZPEPfOhlMcIag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-yAIg10kG01U81SZETItC-f9_bjYGcI2s0mpPD3TMuA&oe=6B0EF021"}, {"file_name": "Untitled design (28).png", "id": "1526826451615397", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304032_1526826454948730_1214110258266513684_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qR6aDZDQvMwQ7kNvwFjOBj7&_nc_oc=AdrJm_MmS4yKOBsjsdokPUl7-ePPT15mFec0V3eghlArJkgQ4tUMbvf5BRzObki7KaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUtG8nJGURkt5kLuvDt-YTVrNhrXYhiZKHpt2btSFLfmA&oe=6B0F1B9A"}, {"file_name": "Untitled design (25).png", "id": "1734691430469139", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499323303_1734691433802472_6310416851830142012_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKycwI2-W2MQ7kNvwHvSMDv&_nc_oc=Adr5bI8cH4lrOo6unUB3Nlo-3gd3POpovexT5psYGm-2JZT06gEv-6UyQNV_nYmzpnM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQViD6pnzvSMr8xn3glnjYisWyoFX5ey3Tj1PzPsQbPoAQ&oe=6B0F02BF"}, {"file_name": "Untitled design (26).png", "id": "1753151905599320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499331721_1753151908932653_1786943968694914724_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3zNaMVxuIAQ7kNvwGQLA4E&_nc_oc=AdqzPn52OuYsPf0Ec5uU05cTzsG8TctN27tKUsjKfG8-F8XWncDj50LF6J4jh2Lhcqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXq-Mgtm9dEXUk4C_N9e9Q1QrGMS8e_rfjHwBeU44zdlg&oe=6B0F0694"}, {"file_name": "Untitled design (27).png", "id": "1223467682832964", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307445_1223467686166297_1442245159012549246_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVkXvRThyVQQ7kNvwGUYKhj&_nc_oc=AdpeIZQpWMKKN5vrZfPvcY2HqloQnpVzb8rt-RjRnRKEvAhx1pLTZ5CrH4VtHJsnhdg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVP90OebxITalmtgf4rsuH8RX3R7cdr-XJLRfp699yrBA&oe=6B0EF667"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillack!", "keywords": [], "long_description": "Welcome to Gorillack\u2014a wild and energetic VR experience where movement is all in your hands\u2014literally. Spawn into a lively forest full of personality, complete with cozy tents and a slick in-game computer where you can customize your display name and choose your favorite color.\n\nFrom there, explore a wide variety of exciting maps, each offering new places to climb, jump, and swing around like a true primate. Show off your style with tons of unlockable cosmetics, and get ready for action in the intense Infection game mode, where players must outmaneuver each other to survive or spread the tag.\n\nWhether you\u2019re chilling at base camp or racing through treetops, Gorillack is packed with nonstop fun and creative movement.", "short_description": "Gorillack is a fun, fast-paced VR game inspired by Gorilla Tag, where you swing, climb, and leap through unique maps, customize your look, and dive into thrilling game modes like Infection\u2014all starting from a cozy forest hub."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vextexh.wixstudio.com/gorillack", "developer_terms_of_service_url": null, "publisher_name": "Pack", "support_website_url": null, "website_url": "https://vextexh.wixstudio.com/gorillack-website", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_l
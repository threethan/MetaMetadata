k1u0hMRCPpguBN2rUsNuSL6Q&oe=6A9EA861"}, {"file_name": "Untitled design (28).png", "id": "1526826451615397", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304032_1526826454948730_1214110258266513684_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAZL6BSH0AoQ7kNvwH9scTi&_nc_oc=AdolTsKq68uIm7vBDogbQrxPGB-f6VssS3PTtGEYxCjnvsNNlt34JXrneWL-xvlZz6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdpttplAEVZUTiU9vlEw5tV4r3-yvw0JoNee0KzLzrkw&oe=6A9ED3DA"}, {"file_name": "Untitled design (25).png", "id": "1734691430469139", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499323303_1734691433802472_6310416851830142012_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kp6NPRxJ_WEQ7kNvwE5QXX7&_nc_oc=AdrBt6_19oeEw-BPW9NqAP7uZXPikMywMqI-wfGRBtw4E1zJQCnN49zVPrQpa_5jtG0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLevkItgjldW0wc32tok8o4l5kPx5KwQW9MgmQi2-9z-g&oe=6A9EBAFF"}, {"file_name": "Untitled design (26).png", "id": "1753151905599320", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499331721_1753151908932653_1786943968694914724_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH8hWGTSKnkQ7kNvwFVCVyS&_nc_oc=AdqvR8t_RTF0C-imaI0Judy0UF0nIQbReufQ5NEq4WPYS6myOmookWIF9J2LmM3Ck5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_rA3nnig3jHvGkzKNMX-_gpV4ySBfk5ulP4gTuHHnfg&oe=6A9EBED4"}, {"file_name": "Untitled design (27).png", "id": "1223467682832964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307445_1223467686166297_1442245159012549246_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIPhnkXn6_kQ7kNvwEwtAzI&_nc_oc=Adpu3Tp1ivXB_8uTNbstBBF0CgveQunOWciOdz7psCdXfNFLXs3sm5e0EhFyCsdUvOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgHZca5f_KJ6x7RR8U8FKCeXixV5PSNr0kyIDaPT4Yug&oe=6A9EAEA7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorillack!", "keywords": [], "long_description": "Welcome to Gorillack\u2014a wild and energetic VR experience where movement is all in your hands\u2014literally. Spawn into a lively forest full of personality, complete with cozy tents and a slick in-game computer where you can customize your display name and choose your favorite color.\n\nFrom there, explore a wide variety of exciting maps, each offering new places to climb, jump, and swing around like a true primate. Show off your style with tons of unlockable cosmetics, and get ready for action in the intense Infection game mode, where players must outmaneuver each other to survive or spread the tag.\n\nWhether you\u2019re chilling at base camp or racing through treetops, Gorillack is packed with nonstop fun and creative movement.", "short_description": "Gorillack is a fun, fast-paced VR game inspired by Gorilla Tag, where you swing, climb, and leap through unique maps, customize your look, and dive into thrilling game modes like Infection\u2014all starting from a cozy forest hub."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vextexh.wixstudio.com/gorillack", "developer_terms_of_service_url": null, "publisher_name": "Pack", "support_website_url": null, "website_url": "https://vextexh.wixstudio.com/gorillack-website", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9569516619813823"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-2
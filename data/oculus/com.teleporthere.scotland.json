-1.oculuscdn.com/v/t64.5771-25/57569473_186809873498794_315028153170012057_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JITFkMac5RgQ7kNvwH16l-2&_nc_oc=Adk0qyy3mDWrPsbxSE-zmsGkt0G1Veql1NHGrBAb5orMuiF9rQtLBEGv6P2eaZRL52Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYeTse_bvvZQqvzcqOXw2rYkpS4Y3SBCXgGmBPBNpNUg&oe=69AD7BE9"}, {"file_name": "screenshot_4.png", "id": "852691908987764", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75639802_852691918987763_561080443423146446_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d-aqm_BLNcQ7kNvwEC5MLY&_nc_oc=AdnS_63eL0d2fP3C60weguvx4tsyITPK-OI2OJ4-nSdb3cqHakfvUMCdBBTHVJ_XciE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7t2qpGwPChZZ9TG77Kh3_4h7hz3CjqV4_PT90Eo-KKg&oe=69AD5A8B"}, {"file_name": "screenshot_5.png", "id": "576366560406753", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974455_576366563740086_5511252532234218624_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryv1r_uIQK8Q7kNvwE8PRa-&_nc_oc=AdkylrH7Wg0VkNOwwdIAxcJM4R7x3qVQc1qW3fc9ojeanwrlwFjqgQRqtBMUyDXIdKg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtScWrnswiDeRF5l6tfLkPYC1VHMdlhLknD1v8-mo-iw&oe=69AD78EA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverimage.png", "id": "697964711038188", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75580063_697964714371521_5758079212491121195_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-16BnxqTU6oQ7kNvwH5AsTK&_nc_oc=AdmF3ZukUllYewdH83EKcF8TzihkiOoHx1JLs_L6lnMklXQ6ftFc8-RfOFOb0OFByYA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZ0q_5aHn1AsfqmMoub1IVQs2WGBHjmRUxNi0eQpPYsw&oe=69AD6901"}, "display_name": "Teleport Scotland", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. \nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n"}]}, "developer_name": "Departura", "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "964218017792485"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001701_187293506759562_354473675661389464_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbLeyQXcaOsQ7kNvwFGX67m&_nc_oc=AdmIoOYeaPVjOAc9V5407dBPMnfDhS8Qk5v-WwTnd9qdDVu5s3n4HyAwEEotw0hV1dc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPNlN2-P3YD3INwnS1bibSO2AFGHx9OaMtQTWlBsbWtg&oe=69AD7731"}, "is_concept": false, "is_test": false, "is_trial_o
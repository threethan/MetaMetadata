191_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2LwRKWpZ5IwQ7kNvwFBBwDr&_nc_oc=AdqPzbbNI9cI_QRE8b7vUn-R7k5oN05pY_be6Xo_d-kQ-5CAg-Ibgz47IJSfA-eVhxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9P6ht9YJwB8FrBuHOWnuimdGvNqX-yBGa4o9b7RYvXQ&oe=69CA5970"}, {"file_name": "ss 3.png", "id": "4047147332251835", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821725_4047147335585168_5658900480489608674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hS-umP49oSwQ7kNvwHYK-tC&_nc_oc=Ado_1lySqkc__bkDkOCQhf-IUuzBRgedhsaUlu5TxKoPAOyKcr-R6f6-M5MIkWybUjs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzt6pvf2ebcskgsNT8frtEY15J2JGTxZMdRhtFtffNIBA&oe=69CA5CAC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Anfal", "keywords": [], "long_description": "Experience the recitation of Surah Al-Anfal, the eighth chapter of the Holy Quran, in an immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience allows you to listen to and reflect on the verses of Surah Al-Anfal in a peaceful and distraction-free setting. The carefully designed virtual environment and high-quality audio help create a focused atmosphere for spiritual reflection and engagement with the Quran.\n\nSurah Al-Anfal discusses important lessons related to faith, unity, trust in Allah, and guidance for believers during times of challenge. It also reflects on the significance of sincerity, discipline, and reliance on Allah for success.", "short_description": "Surah Al-Anfal discusses important lessons related to faith, unity, trust in Allah, and guidance for believers during times of challenge. It also reflects on the significance of sincerity, discipline, and reliance on Allah for success."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "websit
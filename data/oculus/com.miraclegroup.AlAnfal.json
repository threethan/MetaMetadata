/v/t64.5771-25/491821725_4047147335585168_5658900480489608674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8UIbTEDsxgQ7kNvwGDurNw&_nc_oc=Adp2YazzFDCxOVSCfTKQngOnGBeVGmfzBmsP5vRUR5NvJJyj4SxsywgyvLFVfmEjczc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTfMRwujjoCoLqc6cWTbQb-tfF-e5jzJfOKxoMAN4-ow&oe=69C6682C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Anfal", "keywords": [], "long_description": "Experience the recitation of Surah Al-Anfal, the eighth chapter of the Holy Quran, in an immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience allows you to listen to and reflect on the verses of Surah Al-Anfal in a peaceful and distraction-free setting. The carefully designed virtual environment and high-quality audio help create a focused atmosphere for spiritual reflection and engagement with the Quran.\n\nSurah Al-Anfal discusses important lessons related to faith, unity, trust in Allah, and guidance for believers during times of challenge. It also reflects on the significance of sincerity, discipline, and reliance on Allah for success.", "short_description": "Surah Al-Anfal discusses important lessons related to faith, unity, trust in Allah, and guidance for believers during times of challenge. It also reflects on the significance of sincerity, discipline, and reliance on Allah for success."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
191_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyQ0K04e7EkQ7kNvwEjbp2-&_nc_oc=AdoPlqq6IMY-ZjT48zZgRiTyMxyD6Hq7eVHpN3NFb7lOz3uU1cUP_xXIo0QGT4pfBUw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyLTTo3uoUxVkP65Gb1TiR4aHI91fNfW38tP7LuBKVNQA&oe=69CF9F70"}, {"file_name": "ss 3.png", "id": "4047147332251835", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821725_4047147335585168_5658900480489608674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMfjO8HB-YgQ7kNvwHa-rOW&_nc_oc=AdolwQ1mlEIeauVVlrjwopQdJRECrSJnyUbcKi45pJB0Qn2GmYajcUIEk2xnexwjDrs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzk-UaGRj8YTWqZBwVlG8r0hfZuAfqreFMciLXTBGYehA&oe=69CFA2AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Anfal", "keywords": [], "long_description": "Experience the recitation of Surah Al-Anfal, the eighth chapter of the Holy Quran, in an immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience allows you to listen to and reflect on the verses of Surah Al-Anfal in a peaceful and distraction-free setting. The carefully designed virtual environment and high-quality audio help create a focused atmosphere for spiritual reflection and engagement with the Quran.\n\nSurah Al-Anfal discusses important lessons related to faith, unity, trust in Allah, and guidance for believers during times of challenge. It also reflects on the significance of sincerity, discipline, and reliance on Allah for success.", "short_description": "Surah Al-Anfal discusses important lessons related to faith, unity, trust in Allah, and guidance for believers during times of challenge. It also reflects on the significance of sincerity, discipline, and reliance on Allah for success."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "websit
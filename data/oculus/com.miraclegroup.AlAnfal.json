Al-Anfal", "keywords": [], "long_description": "Experience the recitation of Surah Al-Anfal, the eighth chapter of the Holy Quran, in an immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience allows you to listen to and reflect on the verses of Surah Al-Anfal in a peaceful and distraction-free setting. The carefully designed virtual environment and high-quality audio help create a focused atmosphere for spiritual reflection and engagement with the Quran.\n\nSurah Al-Anfal discusses important lessons related to faith, unity, trust in Allah, and guidance for believers during times of challenge. It also reflects on the significance of sincerity, discipline, and reliance on Allah for success.", "short_description": "Surah Al-Anfal discusses important lessons related to faith, unity, trust in Allah, and guidance for believers during times of challenge. It also reflects on the significance of sincerity, discipline, and reliance on Allah for success."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://www.miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26774836518768382"}, "review_messages": []}]}, "
191_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyQ0K04e7EkQ7kNvwEx-6bB&_nc_oc=Adpm3aFKiCiQyIMMQEqfcwJmMATDlW-uNe1mprMuCyqd419KcBBooPTSNr3iC20ag9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdT_TocwuWsNlJ9LaffGAg2PuM2zd8LKMQf8zqhKUgdQ&oe=69CE4DF0"}, {"file_name": "ss 3.png", "id": "4047147332251835", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821725_4047147335585168_5658900480489608674_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mH8HJcF-iOUQ7kNvwEmdt_s&_nc_oc=AdrOwcICML6e5eaVjBdQnqcZvLaSkxPBlo9r49fkxjTlS-o6kWQMpbCH0ZWiv3SfTi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh53JVID2KMNm2bnQzacfwuoBc5tWLJcem6V9ynHLsmg&oe=69CE512C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Al-Anfal", "keywords": [], "long_description": "Experience the recitation of Surah Al-Anfal, the eighth chapter of the Holy Quran, in an immersive virtual reality environment designed for Meta Quest.\n\nThis VR experience allows you to listen to and reflect on the verses of Surah Al-Anfal in a peaceful and distraction-free setting. The carefully designed virtual environment and high-quality audio help create a focused atmosphere for spiritual reflection and engagement with the Quran.\n\nSurah Al-Anfal discusses important lessons related to faith, unity, trust in Allah, and guidance for believers during times of challenge. It also reflects on the significance of sincerity, discipline, and reliance on Allah for success.", "short_description": "Surah Al-Anfal discusses important lessons related to faith, unity, trust in Allah, and guidance for believers during times of challenge. It also reflects on the significance of sincerity, discipline, and reliance on Allah for success."}]}, "developer_name": "Miracle Group", "developer_privacy_policy_url": "http://miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "websit
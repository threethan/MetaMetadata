4siPk4z9S2PNyI7UY-ZoBJuXCGEzR0PsXgw&oe=69F60CD9"}, {"file_name": "Screenshot 2026-01-14 172042_2560x1440.png", "id": "1239436481299849", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499314657_1239436484633182_7082063034771734694_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VEr9K3TDWXAQ7kNvwE0LDuC&_nc_oc=Ado3rZKI4tWQ7g4LQIS5OPGTpB6m_x5G3nAzlqBFMU3zMcJAb1kUO5N4NzPFpkSxQlA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fX5IL9ALKjPEZN8_dnVwh24xWTTlxmFNF8dptUQakRg&oe=69F61A5F"}, {"file_name": "Screenshot 2026-01-14 172034_2560x1440.png", "id": "794373720099124", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499619148_794373723432457_1398739759376831873_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgaTGticOywQ7kNvwGN-Ln6&_nc_oc=AdrgWZUeDnfZkGngSkAPkvqI-HdABjFOgTypLrGr3B1wfX8eF0BprI23Bks7F_VFw-Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qtYYWkxDKiNbc2QX8z_NEu3VzmTW76G_MPSbwVtFgwg&oe=69F61C36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "project horizon", "keywords": [], "long_description": "Project Horizon is a fast-paced virtual reality game inspired by the movement mechanics of Gorilla Tag, focusing on skill-based locomotion and player freedom. Instead of traditional controls, players use their arms to push, climb, and launch themselves through vibrant, futuristic environments. The game is set across a series of floating biomes, each with unique terrain, obstacles, and traversal challenges that encourage creativity and mastery of movement.\n\nPlayers can compete in multiplayer modes such as tag, infection, and custom parkour challenges, where precision and quick thinking are key to success. Project Horizon also introduces new mechanics like momentum boosts, wall gliding, and environmental interactions to deepen gameplay. With its emphasis on physical engagement, social interaction, and competitive fun, the game offers an exciting and dynamic VR experience that rewards practice and skill progression.\n", "short_description": "*Project Horizon* is a VR movement game inspired by Gorilla Tag where players use their arms to run, climb, and explore vibrant worlds. It features fast-paced multiplayer modes, skill-based movement, and immersive environments focused on speed and creativity.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1vvL2MOFGmV-80mGBnb0XMxd91eTjJma14YRG497_wl4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "logan.109523", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1oCI5-K004xUfK_jZtucjeR7lE7NVHTBDoW4cWe5Xtf4/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26161891130177582"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499618252_1470512701403395_2956139017869161384_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eH66Qfl2FlkQ7kNvwGusU3X&_nc_oc=AdpUmJnvu9jusUn-GqsGqHSBBiYXbSg-Yi3MKIROcYbBBNSOhsPJ54mA4j54wYMuJs0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0XRXdTY1IzOY4zA3udhkywAyxNERKGM7zwo2wWbWS-Aw&oe=69F601B7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "project horizon", "platform": "ANDROID_6DOF", "context_category": {"cont
5WeiUQDqa5GjR5El1JW1Hmg7owQqK2-FK7Ak&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jeqJGROFzTgFKz6JO5HfFi0oWI2vzrnBO_6_alrGzqQ&oe=6A1AF5CD"}, "display_name": "BlossomVR", "keywords": [], "long_description": "Relax in virtual reality through minigames and mindfulness with BlossomVR! Utilize a suite of minigames to let out you anger, explore your creativity, or just enjoy the view.\nBlossomVR currently features the following suite of minigames:\n--- Punch Bag: Let your anger out with a virtual punching bag, and knock down wooden blocks with rocks and lasers.\n--- Fishing: chill and enjoy a great view while catching fish\n--- Cooking: let your creativity (and stomach) guide you as you design your ideal pizza\n--- Sound Jam: Marvel as the world reacts to your voice and conduct songs on a missive set of chimes", "short_description": "Relax in virtual reality through minigames and mindfulness with BlossomVR! Utilize a suite of minigames to let out you anger, explore your creativity, or just enjoy the view."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blossomvrberkeley.wixsite.com/blossomvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BlossomVRBerkeley", "support_website_url": null, "website_url": "https://blossomvrberkeley.wixsite.com/blossomvr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "16926799
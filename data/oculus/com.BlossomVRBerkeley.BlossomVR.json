zza\n--- Sound Jam: Marvel as the world reacts to your voice and conduct songs on a missive set of chimes", "short_description": "Relax in virtual reality through minigames and mindfulness with BlossomVR! Utilize a suite of minigames to let out you anger, explore your creativity, or just enjoy the view."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blossomvrberkeley.wixsite.com/blossomvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BlossomVRBerkeley", "support_website_url": null, "website_url": "https://blossomvrberkeley.wixsite.com/blossomvr", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1692679944497209"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1208368493156403"}]}, "baseline_offer": {"id": "1208368493156403"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1690231493, "status": "PUBLISHED", "id": "1208368493156403"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9855296174540581", "version": "0.15"}, "id": "974353673565144", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9413401685396701", "is_concept": false,
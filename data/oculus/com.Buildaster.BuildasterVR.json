NvwGuHBO5&_nc_oc=Adolapz4UvbLbuQsqmgvQJH6qpKNuE_dE5cKBrQgaJUTcwdue6rQN-pOXDb0B0-QhD8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqwH_LaBp8cfIgZvGZJ3c97371xUI64ngVvaFdPnlIDQ&oe=6AEB41FB"}, {"file_name": "z-image-upscaled_00040_.png", "id": "27490072980631645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_27490072990631644_6719711273727962691_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dIFNVIBW4IQQ7kNvwFuizaQ&_nc_oc=AdpfEybPeR43dzknhR1PM271otq4os3xjW7YmadmuQVZ6X4fkZIDL1wHk3NVh0ovNX8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCq6INyi7TxpYfY9Sas09Zye8s9Bfw2XgdJ3ldkJ9iog&oe=6AEB34F5"}, {"file_name": "491824322_1504802857241455_6817624661162377304_n.png", "id": "882424724921442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_882424728254775_8770240525563956400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w9SeR5hIs7gQ7kNvwFKjsGE&_nc_oc=AdqRs2LmcSx9FG35vGFoUpfkLuj6CMOlQvpNjVQha2zc47ijD9GR4fOamOmie1UnSWw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpscoW7PoO0NPQzJyomAkOaeCZgt6QHTcv4fZf177VzQ&oe=6AEB3F51"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen2_upscaled.png", "id": "1495503202260496", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1495503212260495_8003661797505291533_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrY484PIW9IQ7kNvwGeJmoK&_nc_oc=AdqKoAPXQtGpH6_IUg95NNmn2c_RcF8AombMADAVQIRIXAk8A1mlSSH1vssfD8suzqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRs8pu7Gp6aUjHNPTIhAEP0vFtsQl7Ry4Iv7ma8cznoQw&oe=6AEB5EB4"}, "display_name": "Buildaster", "keywords": ["Builder", "Painting", "Cooperation", "Couple", "Party"], "long_description": "One player knows the plan. The other has to build it.\n\nBuildaster VR is an asymmetrical co-op game where communication is your most important tool. One player wears the VR headset while another follows the architect's blueprint on a phone or web browser. Every wall, window, piece of furniture, and decoration depends on how well you work together.\n\nComplete increasingly challenging construction projects, solve communication mistakes, and watch a miniature blueprint transform into a life-sized room around you. Whether you're playing with a friend, your partner, or your family, every project creates funny moments, unexpected mistakes, and satisfying teamwork.\n\nWhen construction is finished, switch gears in Workshop mode. Paint relaxing color-by-number artworks with natural VR brush controls, save your creations, and hang them as framed decorations inside your own houses.\n\nLooking for complete creative freedom? Free Build lets you design your own layouts, experiment with furniture, decorate without restrictions, and build spaces exactly the way you imagine them.\n\nWith multiple game modes, handcrafted challenges, customizable building projects, 16 supported languages, and one of the few VR experiences that only requires a single headset for co-op, Buildaster VR is designed to bring people together through creativity, communication, and a little bit of construction chaos.", "short_description": "One player has the blueprint. The other has the headset. Work together to build rooms, place furniture, and turn chaotic communication into successful construction. Relax in Workshop mode by painting beautiful artworks in VR, decorate your creations with your own framed pictures, or unleash your creativity in Free Build. One headset. Endless teamwork."}]}, "developer_name": "Orley74", "developer_privacy_policy_url": "https://builder-vr.com/pages/polityka-prywatnosci", "developer_terms_of_service_url": "https://builder-vr.com/pages/regulamin", "publisher_name": "Orley74", "support_website_url": null, "website_url": "https://builder-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_
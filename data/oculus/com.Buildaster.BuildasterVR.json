0"}, {"file_name": "491827585_1495198102795599_1220024697497716603_n.png", "id": "861259233402635", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491829120_861259240069301_4823961684991843294_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t_xTHtmYH7QQ7kNvwGLpWz9&_nc_oc=Adp5LOfXkvRorfOQUqj91GJ4vKckNEEyUC-3l8HeP3tx2txr7sEsZuEHr3oqd0nBzzA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPAQlnHc_gLCSWIpcMLAkIyIW0gNMR3Sn_hd4lnEG5pEg&oe=6AE0B5FB"}, {"file_name": "z-image-upscaled_00040_.png", "id": "27490072980631645", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824292_27490072990631644_6719711273727962691_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ql_jH_gRSkQ7kNvwEtngfK&_nc_oc=Adr6a4km6StA01tnNYIt8ih8EBzjTlsaI5l2xX1RkeTewrT9YVH_okmduRPGCYKnBbM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHBN27mia5mVI2tLfPipCSXA68Q-U8AMo7hHb0emIcgw&oe=6AE0A8F5"}, {"file_name": "491824322_1504802857241455_6817624661162377304_n.png", "id": "882424724921442", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_882424728254775_8770240525563956400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DuNjWwzfWgQ7kNvwHrUSpH&_nc_oc=Adr_4mMHSftHvJMGKOt0HhWPUCcY1fs1ChKyZArWt1vyn1NE7O5fEk_5Z_Fm0KfvB_U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMX5Z22ovtDCdZPwAi1QNaUrBhXm1gZTeqL40Cn1C-Htg&oe=6AE0B351"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen2_upscaled.png", "id": "1495503202260496", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825470_1495503212260495_8003661797505291533_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob52X4_fbGoQ7kNvwGgjI2m&_nc_oc=AdqBqTa_IMfTRXBASqXU53ci4nJSCgIBkvUWD8xWeeL0txMhetxpOV_LKOR8IJKKgu0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeln3xSpSfw6gbU8YkB9-W0I5HuyYwOzZeGj7ZqVmTFg&oe=6AE09A74"}, "display_name": "Buildaster", "keywords": ["Builder", "Painting", "Cooperation", "Couple", "Party"], "long_description": "One player knows the plan. The other has to build it.\n\nBuildaster VR is an asymmetrical co-op game where communication is your most important tool. One player wears the VR headset while another follows the architect's blueprint on a phone or web browser. Every wall, window, piece of furniture, and decoration depends on how well you work together.\n\nComplete increasingly challenging construction projects, solve communication mistakes, and watch a miniature blueprint transform into a life-sized room around you. Whether you're playing with a friend, your partner, or your family, every project creates funny moments, unexpected mistakes, and satisfying teamwork.\n\nWhen construction is finished, switch gears in Workshop mode. Paint relaxing color-by-number artworks with natural VR brush controls, save your creations, and hang them as framed decorations inside your own houses.\n\nLooking for complete creative freedom? Free Build lets you design your own layouts, experiment with furniture, decorate without restrictions, and build spaces exactly the way you imagine them.\n\nWith multiple game modes, handcrafted challenges, customizable building projects, 16 supported languages, and one of the few VR experiences that only requires a single headset for co-op, Buildaster VR is designed to bring people together through creativity, communication, and a little bit of construction chaos.", "short_description": "One player has the blueprint. The other has the headset. Work together to build rooms, place furniture, and turn chaotic communication into successful construction. Relax in Workshop mode by painting beautiful artworks in VR, decorate your creations with your own framed pictures, or unleash your creativity in Free Build. One headset. Endless teamwork."}]}, "developer_name": "Orley74", "developer_privacy_policy_url": "https://builder-vr.com/pages/polityka-prywatnosci", "developer_terms_of_service_url": "https://builder-vr.com/pages/regulamin", "publisher_name": "Orley74", "support_website_url": null, "website_url": "https://builder-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1725996564472128"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "hr", "nl", "da", "fr", "de", "de_CH", "hu", "id", "it", "nn", "pl", "pt", "sk", "es", "sv", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1138267219378297"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1781889453161759"}, {"status": "PUBLISHED", "id": "999155406426959"}, {"status": "PUBLISHED", "id": "2296527567753085"}, {"status": "CANCELLED", "id": "1556463992122189"}, {"status": "PUBLISHED", "id": "1729481914721908"}]}, "baseline_offer": {"id": "999155406426959"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790704800, "status": "PUBLISHED", "id": "1781889453161759"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1257560687448949", "version": "1.1.02"}, "id": "1040101641750580", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1131317743406578", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1257560687448949"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": 
491827585_1495198102795599_1220024697497716603_n.png", "id": "861259233402635", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491829120_861259240069301_4823961684991843294_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9jTa64YOuMQ7kNvwGnEdHe&_nc_oc=Adrj8wsHMUw5J_P7eFL-exPMPWUW3jMv1ntj2eIsvHf9Nw7TGVnM9sc-Z8PftaZmf0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyqt62TWXXsx37F_mVzS_GrjpPbycZjI9huUqyweWPHw&oe=6AB5347B"}, {"file_name": "z-image-upscaled_00040_.png", "id": "27490072980631645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_27490072990631644_6719711273727962691_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgJVPlil_lMQ7kNvwFO1y0L&_nc_oc=AdplPdTe3pjVTUJZXyNoAH3Ig312pPEbu52ZSm_E92p8wn5yNxJc4Bn-lAxghwnrzvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ4gxCyjnFK6IveCsolnk_VhCtsVBk0y_TmpxC3KQtxw&oe=6AB52775"}, {"file_name": "491824322_1504802857241455_6817624661162377304_n.png", "id": "882424724921442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_882424728254775_8770240525563956400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRM496bAzcYQ7kNvwE6kM_r&_nc_oc=AdrAhNbz-bycjWkkJjGg1SjN1_npHtkiBKjFPcsqBf9DtRDateHisxwZRm232XtDqcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXYdK24Y-MtDD98WgfIcm5Vfb7ooMOTeRu89gqvCQ6QQ&oe=6AB531D1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen2_upscaled.png", "id": "1495503202260496", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1495503212260495_8003661797505291533_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pmY3vbOShMQ7kNvwEBZmZZ&_nc_oc=Ado4sueh7YF26JZlZ9BxJj0QovIgqNkjNHkEBbg85qAZ2iU8uWMtyfAswBufVBv7ffs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvB0QqO6ZeMHbTbPzeNWBkhGZc64XUWm9fGVn4AH5sRQ&oe=6AB518F4"}, "display_name": "Buildaster", "keywords": ["Builder", "Painting", "Cooperation", "Couple", "Party"], "long_description": "One player knows the plan. The other has to build it.\n\nBuildaster VR is an asymmetrical co-op game where communication is your most important tool. One player wears the VR headset while another follows the architect's blueprint on a phone or web browser. Every wall, window, piece of furniture, and decoration depends on how well you work together.\n\nComplete increasingly challenging construction projects, solve communication mistakes, and watch a miniature blueprint transform into a life-sized room around you. Whether you're playing with a friend, your partner, or your family, every project creates funny moments, unexpected mistakes, and satisfying teamwork.\n\nWhen construction is finished, switch gears in Workshop mode. Paint relaxing color-by-number artworks with natural VR brush controls, save your creations, and hang them as framed decorations inside your own houses.\n\nLooking for complete creative freedom? Free Build lets you design your own layouts, experiment with furniture, decorate without restrictions, and build spaces exactly the way you imagine them.\n\nWith multiple game modes, handcrafted challenges, customizable building projects, 16 supported languages, and one of the few VR experiences that only requires a single headset for co-op, Buildaster VR is designed to bring people together through creativity, communication, and a little bit of construction chaos.", "short_description": "One player has the blueprint. The other has the headset. Work together to build rooms, place furniture, and turn chaotic communication into successful construction. Relax in Workshop mode by painting beautiful artworks in VR, decorate your creations with your own framed pictures, or unleash your creativity in Free Build. One headset. Endless teamwork."}]}, "developer_name": "Orley74", "developer_privacy_policy_url": "https://builder-vr.com/pages/polityka-prywatnosci", "developer_terms_of_service_url": "https://builder-vr.com/pages/regulamin", "publisher_name":
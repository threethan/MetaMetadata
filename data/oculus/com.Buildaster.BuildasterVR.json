3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJn9x4va6FinfHprmG2FblIam94MbLN2jsssyX21Visg&oe=6AABF9FB"}, {"file_name": "z-image-upscaled_00040_.png", "id": "27490072980631645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_27490072990631644_6719711273727962691_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxSZsfUTMHAQ7kNvwEHzNf9&_nc_oc=AdpOGBghNOBXHiEpqi86sr7d4pz7ZhKyXaQGYq_T2crs1y7-_JXgt2b1l1T3_pnyQvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKK_UKgnMhDOiy-eTe2iFtkv13iXSMsN3Zatr0k9aLfng&oe=6AABECF5"}, {"file_name": "491824322_1504802857241455_6817624661162377304_n.png", "id": "882424724921442", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_882424728254775_8770240525563956400_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBxnvTR3NiwQ7kNvwGz4JPK&_nc_oc=AdraJqEuy2Q0LrulPbcW1DeAVOJXkeqo44BwqBtHIKVZulYhE_iZvQmNTMwzv3Rxgxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQH1wzotBxLF44peRcw0rXVR2vppQjvmzsZ2LnTgQcJQ&oe=6AABF751"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "screen2_upscaled.png", "id": "1495503202260496", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825470_1495503212260495_8003661797505291533_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmBqGOTNrrIQ7kNvwHGAVit&_nc_oc=AdqBguXx_YoV-NYdyIamUMNt0QFbAeVjP5SCG5oRPDT10bhK9XLkyE7P5j-aj8cIctM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe_KbbMHXWOTRISfedE7f1N6mLW2RUyXmEfAEC_5PJ0A&oe=6AABDE74"}, "display_name": "Buildaster", "keywords": ["Builder", "Painting", "Cooperation", "Couple", "Party"], "long_description": "One player knows the plan. The other has to build it.\n\nBuildaster VR is an asymmetrical co-op game where communication is your most important tool. One player wears the VR headset while another follows the architect's blueprint on a phone or web browser. Every wall, window, piece of furniture, and decoration depends on how well you work together.\n\nComplete increasingly challenging construction projects, solve communication mistakes, and watch a miniature blueprint transform into a life-sized room around you. Whether you're playing with a friend, your partner, or your family, every project creates funny moments, unexpected mistakes, and satisfying teamwork.\n\nWhen construction is finished, switch gears in Workshop mode. Paint relaxing color-by-number artworks with natural VR brush controls, save your creations, and hang them as framed decorations inside your own houses.\n\nLooking for complete creative freedom? Free Build lets you design your own layouts, experiment with furniture, decorate without restrictions, and build spaces exactly the way you imagine them.\n\nWith multiple game modes, handcrafted challenges, customizable building projects, 16 supported languages, and one of the few VR experiences that only requires a single headset for co-op, Buildaster VR is designed to bring people together through creativity, communication, and a little bit of construction chaos.", "short_description": "One player has the blueprint. The other has the headset. Work together to build rooms, place furniture, and turn chaotic communication into successful construction. Relax in Workshop mode by painting beautiful artworks in VR, decorate your creations with your own framed pictures, or unleash your creativity in Free Build. One headset. Endless teamwork."}]}, "developer_name": "Orley74", "developer_privacy_policy_url": "https://builder-vr.com/pages/polityka-prywatnosci", "developer_terms_of_service_url": "https://builder-vr.com/pages/regulamin", "publisher_name": "Orley74", "support_website_url": null, "website_url": "https://builder-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}, {"id": "1725996564472128"}], "external_subscription_ty
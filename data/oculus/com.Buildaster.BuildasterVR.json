scdn.com/v/t64.5771-25/491823341_1498539422314453_4454007005460591634_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oqVJ2vX86iUQ7kNvwGbyEbZ&_nc_oc=AdqiFHKT0VjCkBsFRTfcB9winqG-uaKBbNh6DXhYJ8Shn4mpVdK7qbPmjCvKX_ohv6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvA7k7NpevznIafx-C9zOSxOSr7mO3M_5tbqEA6zk_3w&oe=6AAC070A"}, "display_name": "Buildaster", "keywords": ["House", "Building", "Construction", "Coop", "Simulator"], "long_description": "Buildaster VR puts a construction site right in front of you \u2014 just a little smaller than usual.\n\nTake on contracts, check the architect\u2019s plans and build each project piece by piece on an interactive miniature site. Put up walls, place floors, fit doors and windows, furnish the interior and try to keep the whole thing within budget and on schedule.\n\nSounds simple. Usually isn\u2019t.\n\nClients change their minds, workers create problems and random events can turn a perfectly normal job into complete chaos. Sometimes you\u2019ll be carefully following the plans. Sometimes you\u2019ll be trying to save the project before everything falls apart.\n\nWhen the work is done, you can leave the miniature behind and step inside your finished building at full scale to see what you actually created.\n\nBuildaster VR lets you take on different contracts, improve your results, unlock new content and build freely when you don\u2019t feel like worrying about deadlines. You can also team up with an Architect playing outside VR, mess around in the workshop, create your own scenarios and explore projects made by the community.\n\nBuild carefully, improvise when things go wrong and try not to bankrupt the whole construction site.\n\nPlan it small. Build it big.\n", "short_description": "Build houses, complete construction contracts, and manage the chaos in a hands-on VR building game. Play solo, create freely in sandbox mode, or team up in asymmetric co-op where one player builds in VR and the Architect joins from a phone or browser \u2014 only one headset is needed. Follow plans, beat budgets and deadlines, furnish your builds, and step inside your creations. You can also relax in the Workshop and paint."}]}, "developer_name": "Orley74", "developer_privacy_policy_url": "https://builder-vr.com/privacy-policy?lang=en", "developer_terms_of_service_url": "https://builder-vr.com/pages/regulamin", "publisher_name": "Orley74", "support_website_url": null, "website_url": "https://builder-vr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "cs", "hr", "nl", "da", "fr", "de", "de_CH", "hu", "id", "it", "nn", "pl", "pt", "sk", "es", "sv", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1238552002683151"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823259_1561960522373913_2686474725044565548_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVhmzThZDRcQ7kNvwHzm3Jy&_nc_oc=AdpbtS-9eBFfzAWr0e2UlcxOFpjCyOqpLaacKRPv_1bxssI_oUats9fl8YMUwaZ5wNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGykignpQ3LBOu4axCH6WM0cDC8KyDhOP4mn5xyjBpog&oe=6AABE83A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Buildaster", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": 
914155775848790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1914155779182123_3655574958931595895_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=66-CfSbSlN0Q7kNvwGwdHbt&_nc_oc=Adpw4G_jBeLig5BW_AkQphMslZm85ddgAUUUsOcNs6soTtg1K2cFEuJe76nqUg4890c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCq7PnlzntTSKpjnL2HuasFalmT279hL77WtWBlKKbq5A&oe=6A60B874"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chair Lift Ride: Mountain Cable Car", "keywords": ["ChairLift", "CableCar", "MountainRide", "ThrillRide", "AdventureGame"], "long_description": "Step into Chair Lift Ride: Mountain Cable Car Game, a relaxing VR experience that takes you high above beautiful mountain landscapes. Sit back, hold the safety bar, and enjoy a smooth and immersive first-person ride as your chair lift glides over snowy peaks, deep forests, waterfalls, and scenic valleys.\n\nThis VR experience is designed to make you feel the real height, movement, and peaceful atmosphere of an actual mountain chair lift. Every ride offers calm ambient sounds, gentle wind effects, realistic cable animations, and stunning views that make you feel like you\u2019re truly suspended in the air.\n\nChoose different routes, enjoy long peaceful trips, and explore various natural environments as you travel from station to station. Whether you want a relaxing break, a scenic adventure, or just a beautiful VR escape, this game delivers a soothing and immersive journey.\n\nPerfect for VR beginners, travel lovers, and anyone who enjoys peaceful VR experiences.\n\nSit back, relax, and enjoy the ride \u2014 your mountain adventure begins now.", "short_description": "Experience the thrill of soaring above mountains in a realistic VR chair lift adventure. Enjoy peaceful rides, stunning landscapes, smooth cable car mechanics, and immersive first-person views. Relax, explore, and feel the height as you travel across snowy peaks, forests, and valleys. A calming yet exciting VR ride experience for everyone."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25970121192576918"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825575_846561431314153_4923792112906805348_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mhbQ4LqIcgQ7kNvwFcQapX&_nc_oc=Ado2QkyXkE_kVAVCs6r_9VMBrOoFFMwQ0ZFycve0L1MKEXNbVXE5B1VaRKdQ79vJzyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuaMVudHpBXoKXmxFIpIjLZjY708r5sX_Cf3gkHFV2pQ&oe=6A60BF69"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Chair Lift Ride: Mountain Cable Car", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1764350520, "lastRevision": {"nodes": [{"id": "25970121219243582", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25970121175910253", "is_
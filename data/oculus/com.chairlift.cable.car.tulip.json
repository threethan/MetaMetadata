iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4F88_PhjUL5ynWOhzcaZO_lj8N05grkowgBHDeQfbM-g&oe=69FCA56D"}, {"file_name": "5.png", "id": "1213522057316604", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818890_1213522060649937_6177977425601293498_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4tYFXy1yBAQ7kNvwEbt1EQ&_nc_oc=AdoHz0klCNByO4DruQ1l7oDul7lE1huN_jk-hwoyJuoVDfwAgUc--o124zJ4C5Hvjss&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44ZoVpMY3rklp5XMInKeTPZCg1EylTBnsIwxclTOBxzg&oe=69FC7E99"}, {"file_name": "2.png", "id": "1145139854036446", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824292_1145139857369779_6456603756932075272_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AJGFV1AZJ68Q7kNvwGNXqKB&_nc_oc=AdoQswSMLz9HdRGkRk2PUuZu-A8qP0OSwviRPifz5rB_6uyttyabLlYro80MZCXheaM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KuXckhEPAMsQJqmMCS7xwcNzy0TK7PewW_kMbe0FcXg&oe=69FC9BE2"}, {"file_name": "1.png", "id": "1914155775848790", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823746_1914155779182123_3655574958931595895_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrXjGXEhYMQQ7kNvwFvLQKm&_nc_oc=AdrCqzqMrGDGEGSjfKtGFkGnr6pLi74jI-cjbqkXwlJ3enXXPjdlpae-uZAXFANbfdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YI5UeFWFLOmeVMpb9FR66NcloIMmVQiE7oKkkzkCwPw&oe=69FC8674"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chair Lift Ride: Mountain Cable Car", "keywords": ["ChairLift", "CableCar", "MountainRide", "ThrillRide", "AdventureGame"], "long_description": "Step into Chair Lift Ride: Mountain Cable Car Game, a relaxing VR experience that takes you high above beautiful mountain landscapes. Sit back, hold the safety bar, and enjoy a smooth and immersive first-person ride as your chair lift glides over snowy peaks, deep forests, waterfalls, and scenic valleys.\n\nThis VR experience is designed to make you feel the real height, movement, and peaceful atmosphere of an actual mountain chair lift. Every ride offers calm ambient sounds, gentle wind effects, realistic cable animations, and stunning views that make you feel like you\u2019re truly suspended in the air.\n\nChoose different routes, enjoy long peaceful trips, and explore various natural environments as you travel from station to station. Whether you want a relaxing break, a scenic adventure, or just a beautiful VR escape, this game delivers a soothing and immersive journey.\n\nPerfect for VR beginners, travel lovers, and anyone who enjoys peaceful VR experiences.\n\nSit back, relax, and enjoy the ride \u2014 your mountain adventure begins now.", "short_description": "Experience the thrill of soaring above mountains in a realistic VR chair lift adventure. Enjoy peaceful rides, stunning landscapes, smooth cable car mechanics, and immersive first-person views. Relax, explore, and feel the height as you travel across snowy peaks, forests, and valleys. A calming yet exciting VR ride experience for everyone."}]}, "developer_name": "Abstron Pvt Ltd", "developer_privacy_policy_url": "https://tulipapps.com/meta-quest-games-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tulip Apps", "support_website_url": null, "website_url": "https://www.tulipapps.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25970121192576918"}, "
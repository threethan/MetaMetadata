24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUdB0yBV-3wQ7kNvwHWFc2O&_nc_oc=AdqKFBMTqtFFu9KGfUK2OJYUzgGzLLuNyyo_gzqwN3ZNROGPE89CmfJ2q3ny4Nq8d-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERrAgFRuZpF7zWWmhHKMDqk__uSrFjoeHpiUGwCUSLbw&oe=6A92D01A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ixy4XwPozMcQ7kNvwGkDFC9&_nc_oc=Adp9qq7Il2bsSX3j6SnraUYpbT1cwVumtIwIMju8gGHrwVNTndK9qdBdqXqoXRuXS80&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGo98jfmCEQZH_pnJnHLlCIImR0Xa9fCSf2GEB-VxelBA&oe=6A92D5E5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gjp5pc45X2IQ7kNvwGJhf3r&_nc_oc=AdpG8E0yg1mCKyTZciHAJUgDqmfxk_vYQKf59a8DEQ_mc-OYNhR-7UvrIXw3-TmCAr8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOmuZX55dDxGGrx6XJQiDVEIkK2iMtYG1pFzh47B85eg&oe=6A92BD30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
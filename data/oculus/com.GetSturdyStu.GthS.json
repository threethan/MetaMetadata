24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NibYFFRG_DgQ7kNvwGBrDL-&_nc_oc=Adq53GggSjsQ0ji9Ld3KsPtmBnakgX7rO0-ksy50CafZ_fZZXVsi7VKCv4gqHC7o8z4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rgTSDSSSqp3QFKJEaDuZkrMzrEWtIzPowMH0dC6QJzQ&oe=6A201D9A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=An3EFmCeZmYQ7kNvwGXV5Ba&_nc_oc=AdqvUZKp9rn-go2eHsWsAddYF2OHsXvRF9VKjkbrrATf0tJAWzkdLovDearpU6dCEI0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70GB6J9TNEGpnv4PNqr-ddkusHbwBx9zN-ZCSEuv2Osg&oe=6A202365"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWsaawsBbjcQ7kNvwFkNkKW&_nc_oc=AdrHSztpowfD2t_ASPNYS2ZrR2enbKZMhDVhNqak4HTYf3vGjcoQbhg8F5i6fvc3wDs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68M4frmIiIZ510nYXpC3m_eEV23nnz3fFvvV72VftANg&oe=6A2042F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
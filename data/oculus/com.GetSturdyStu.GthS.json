24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hY4gSuqCfKIQ7kNvwG2uOIy&_nc_oc=AdqxYgQ0tuX0sO64fBsPg1MJJC3WmntgfT6jxnRodVQjtuuImq8CQ00UwgrkXVY762s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UJzssV2m-PGOjiubX9WA_NFq67FlWx4HCMgwQCdV9lQ&oe=6A18349A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndZM2pniKH0Q7kNvwH7L6mR&_nc_oc=AdqxOts52PdfRNXiMDv3ZsZiXGagotXMvQZKs0SdNjeKXwzY-dYSWYPZupiLC9-_29M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sw7Q6oPWOHNf3kaGIZYd6icnf5gz__r-gTKQREo6UBw&oe=6A183A65"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEJIGUIvvSoQ7kNvwFnT7CA&_nc_oc=AdqWDN8Gvnam331NnMQl7vcbVjLLQM0MZrRs60VGC8-8_BoM56IHACYJPE5w89SR5ZQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79eoFiyidBnquSrkfg9buR9f0hjW0oL11RLUO9xNO2vw&oe=6A1859F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
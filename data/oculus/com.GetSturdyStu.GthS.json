24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqj4-v66nmkQ7kNvwF8Z6Ge&_nc_oc=Ado4b3fG1t7tgDn2EqZcPB193SR65GPMUt-YaOM57-tMxnk2flKwwv0ER26_UNo63Q4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwc3k7Vr3mLRUOO-_9QmtCckhwtDa9laBVKA1hI9qrNA&oe=6A86F29A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAtHIFTphT4Q7kNvwHtBO1N&_nc_oc=AdoRDC9vCaNL-psndA96XmPP5SWYYoGvcINy6lFWrfk4viKeCEGZlyH8b_wi0SttIbg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNckAr0EoHwjRBWgAdf_VwDQqQ4vEIpZ7WfLRtPOEAjQ&oe=6A86F865"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEfBPMB-p0MQ7kNvwErC7Rd&_nc_oc=AdqxX6AKoEr-YWLji-ESj9nWCoQYLa3Impg2O6n8GqhgcFhtFhk-rAj24wnx8j3r3sQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG476W0nqLPkJYQCObhZoKkZWVNQ2n4XnC44rbGKgGPow&oe=6A86DFB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
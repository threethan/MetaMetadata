24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgwLXQVR3FUQ7kNvwHMJO03&_nc_oc=AdqevR1oJ0vSkFifA_KdNehJhkVEOmvHtCppQOtFMouh3-Qe1xeClNBzqcxu9_5qfTg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrrCr9Q5jLJpqV8_HSJ-lziP5-QXifrBjUNdiiKPrdbg&oe=6A917E9A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xoa0N6pvjIkQ7kNvwHKxq_O&_nc_oc=AdqBSbfTxEAS84wZvJwCGlfdbr078VElM4S9TUgj7uCVswzshvB-jvHqV4IIujAsqN4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsPe8-IGfWY5-IMqLETqyAD37NBScsPXPQHwmh5vVGRA&oe=6A918465"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gjp5pc45X2IQ7kNvwGZmvXv&_nc_oc=AdpdoQOmsyHpogIyBw-TsjDKaTvNA_Kkjelsce9qub1XdC0qTNF_sKQm1kDyovb9Mww&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUBc8OmDdEgYd68MdIGX-M3Myh1D80G21xNdB0IxR5mw&oe=6A916BB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
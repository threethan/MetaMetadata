24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JktAnDxcxZUQ7kNvwHb8Uqf&_nc_oc=AdobNOwtXq470Gc0skPt7eQsVtDnL-zj23yyLf8Ha-DenVSqhJvHpi9wBKvDIylYJC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzvXT2RpYzQOq1Ye-cCrapia9y8AoQA6Of59VmVQDvYw&oe=6AEA0B5A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIo73q8wgkkQ7kNvwFPeZpk&_nc_oc=AdpBo7LFHeUPgecojDO_oX5wanRCgVkeXKjjQH3ZXv48I5C1dzgOtcC7dSIZhocd0Mc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVZQkgCiYdwoSfa_DyKo-8IQ7wYKIAPi9mMQVM2QQrkA&oe=6AEA1125"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sno1dDgXXAwQ7kNvwHgrWPN&_nc_oc=AdqZbkGKHZGhD4tpUQVluTNxYxuBbxFGeRv01kIfQMMqhcvOE6mqgzZd8rfK2s6DPvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2NBwHLKUtu6ZqKQQDmJWSuIgnv1MMPHbtryn8CNlGUw&oe=6AE9F870"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2Y-yTZBi7QQ7kNvwHJkr-v&_nc_oc=AdrYlO-0U5R-6WoeGDFoM-fLMvXaY_J_My9Uuo5oQiV3nP5aL9lulnm1afCDa_blE2s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1U1hOgH3SMy68VR2853R5UOD12nQ6RWwiqlPudrGchQ&oe=6ADCA41A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGbMmaDmJq8Q7kNvwFwEhmi&_nc_oc=Adpwh2aPUT5SWkwmMLwkVZ__Io8DaerMaFXjJKqIElDoynTRfg6AxQEIrr6eYInP-Is&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOORQEXrKtjGmd1hXoGMoipbHPlKkLVkwth-hbuny6Fcw&oe=6ADCA9E5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcpe3OHErdMQ7kNvwGbT9Q9&_nc_oc=Adrb5eIBQq3wphoTbbYbN0tra1C6iDf-SwEBjqm88GvFIR_hMm2EEwibmDLSCURUdwo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvy1lu3GEPCkXXfAqKmU3UrFJenYcNzQnqXjhwKtVnPg&oe=6ADCC970"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
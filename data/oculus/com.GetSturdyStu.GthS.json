24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCbDQHbL15YQ7kNvwH2Ij0v&_nc_oc=AdolxcH5cTjndvYMX_bYq0sHG23XiP5AhNDf20TJ2pCiWJiS1AB3j84DJ6p04GCSKnI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOIm1xrGYcAQkcy2b_fgTzOCqG47gb9bcmE_ytXwMbfw&oe=6AECAE5A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIo73q8wgkkQ7kNvwEbXgKN&_nc_oc=AdoQoBsxK2nnLYPDCT1MOTtXnkFfeOvqOTT7emSD2XBoabs3q0jRPpWoVsmXIe4xBoo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6mADBRGiEXBEgU5zqzEn3CNi9L8ldtbuXm-2EQw7drA&oe=6AECB425"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhgvacVobd4Q7kNvwG1KEIm&_nc_oc=Adp8B0TujAg0JHD6lrceESz50PQtfHW8kDFHFNl4Mfa17n_sPFMajGeeqVEbK6hrzMg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuBP2i7DhD4WcQOnkLxYEuYONgqKqLPTUE8XRAiBkGQw&oe=6AEC9B70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
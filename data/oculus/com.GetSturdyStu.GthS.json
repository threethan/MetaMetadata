24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCmC8c4yxtwQ7kNvwEtdGTk&_nc_oc=AdoiVvbKp2GOLLujcFLhk2OggYKMeVaEv65y0esCV-V2kqijXOqCsmVdrYIqw7p2W00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4rUI22ic8CrmsX7VXIzsGMWR_wr8Rqfa765sY74kb3g&oe=6A259BDA"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGbqsUhUPggQ7kNvwEQyCtu&_nc_oc=AdryW02Y8iJJTVI93e_SK7LBoftYfC6HGol1Nffh1NaiOs24LsW6nJqaHMKQgL7z1-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gvSegzes8S-NKkheOTPwY_BsXWKHqThAmOvNpkx8cCw&oe=6A25A1A5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke5iE71KCMsQ7kNvwG8R-vg&_nc_oc=AdqEfKPfcrFtodLDmovUK-eLznQrUNijiuwepiqPct7SbfsPUmzaUZDXQkJpj_3OVr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bKTJyX3UvAeRnELUQ0RR-50PSDPtIC1s8YvZqB6zM-w&oe=6A2588F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
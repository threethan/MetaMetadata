24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DVhWXQKfKIQ7kNvwGG_hiu&_nc_oc=AdpBL6XwJdJS98FmPfkzsuN3W_sF_jtLMVFJmKgTtGss_334WyuhH9rVjvlpA-BEYgs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEsaNgg53bbxydEq_ce__AWMtPF43O9hvo8hP0N7ir3g&oe=6A60B71A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qu_Dl9sH5iYQ7kNvwGZz64u&_nc_oc=AdpJKHuatxL1rkKKcEj7hZPEzD2ZrTie4SKwkzuFsnOvPhmpnSPLsPbLkqLmqvD33AY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABHvdpNrONLa6EvvLuAppz4nvTdJRNeP-d7AIEz8BHfA&oe=6A60BCE5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wlMvB1aGdYQ7kNvwF9Ysdy&_nc_oc=AdrxJDLzHZIsWMT99c1ERG5tln4SutokIxIr5Ri3cRSeS35PA8zxC2pEP3hbmyKeQdQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKSYnckiv_p5EW-n4tlbZAsT4b77vfstwCUgjSMKQpew&oe=6A60A430"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
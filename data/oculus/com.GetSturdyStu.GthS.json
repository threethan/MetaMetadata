24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJrp83ESBa4Q7kNvwEszGZu&_nc_oc=Adqte3hAhAzLJqdY1rQC3Q0EB8NcPFQFb3jBGA6an15TFq1DiZ_kVX0GoxWpJkDsbps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGud7XGpReDANmvQw2763ilZ9LjFn7msV1ByrN22QTHXA&oe=6A70891A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q2vJaa_nFHkQ7kNvwH5gO7z&_nc_oc=AdoYV-PVsL6VGLg6mEnawSLl5XU-IfWMVT3Eo-hiLW1ELmeRQFR9NdBXGOVTP4qU8Oo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQLDzQVtdFatYjT-VF39YXcuwrVOXv5FFAEq9tMPWcew&oe=6A708EE5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGMSRNCZrA4Q7kNvwEYOKb1&_nc_oc=Adpoe2AAKjeLEjZ8XvQFfqnAMdwEdDAV86FbtZghEIKHK70DFmy_YFXCD28prnQKuOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8ABunliqKoiixm3OTuJ5jqhz9RqPDtiNbvoq5aCmCLQ&oe=6A707630"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJnvaDCKbyYQ7kNvwGZTxhH&_nc_oc=Adprjv-CJuh8NxaTp6K3NUoYMwQ8OFygym1jr8NC6autQDrB-1m-NAD6r1eoouJw22U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91yWys_7Cblrf7Z4ibq3dzar4YpCUJc6ShNZn8p78yQQ&oe=6A26ED5A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WGbqsUhUPggQ7kNvwH6MgbK&_nc_oc=AdpdYa-Yz8Ev5EUL-TLrsJabQAh9A-e3w6idx7vjJ2dBcjXet3gooDp1CaHjV1WJukI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sn4HH_hp9ogzxsXaX4H6xjil1jrnxHBqkpUHCmBjdEg&oe=6A26BAE5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke5iE71KCMsQ7kNvwFvhFAQ&_nc_oc=AdoskOKx7zBqac_88-gYmBzhmNi05QLO88G1LSC-2_UgRT0ejyjFrE3UXmdpsqRp7vY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ig5URDPVGtroea2BKQ3KO6RrzYSqrXoUFP3zTwChJqA&oe=6A26DA70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
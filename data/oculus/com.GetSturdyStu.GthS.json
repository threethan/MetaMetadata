24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nOn1Gul8xkQ7kNvwH-Mbe_&_nc_oc=AdqukRAtb3z-LmAolcd7EvsxOEYXkAq9bM4kgEaYAbdMK4GiAF_5O8hblgZ7YB7E40k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IUIfQh9Ck5I9RIHladCANcXBZA6FJDMGQcR10Pt88fQ&oe=6A41131A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBUxaKQl4QYQ7kNvwG094EO&_nc_oc=Adoc9i04X8wYDbXQw74sKNjHFYFmq6unjBO9FVX2XP4tXnpQg3aBhpWZ_4zXCrNlRJI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5mDC1bn-FQKojkNghr6_TecmbzvN6Hz-9z3acbxCNeA&oe=6A4118E5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B8K9n5q86YQ7kNvwGjzkGm&_nc_oc=AdruCFfT8i4De5MA_J97-CWsDgqaiebBxcLJ5Jot15cRburyacAT9gMN7GCdTAhYOYo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k6MDAomoHRInahCdvNiduo16BblJpRQQuGafLKbaAug&oe=6A413870"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
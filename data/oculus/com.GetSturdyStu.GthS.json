24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KojOv_1V-SsQ7kNvwHGpapu&_nc_oc=AdqjqhfK_RgBWlhLlbFANxHUoj_wZeLLBBQFu3NO3SG3SKqopEhJJ0_GY8HTZYDFAiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGPhSFsus8QXofXt0IjwBaU015eFIOiBc6Wd4TVbtHEbg&oe=6A79C39A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eGGSjwj6UAQ7kNvwHhkQ8k&_nc_oc=AdrpOh8nkBgLuQFl68lz_MltBl7ZEVCH0Xguntcg1-iogfIs5drVf26I4zoIBzbfj8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvy58DXvA1tqgeUnM2c8cazBzdLb-739IbzEGZ8zVHSg&oe=6A79C965"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6SRIxlwRWYQ7kNvwFQRDzv&_nc_oc=AdqduIAgREBEABUeeDjbNqARu_smjUdx14b_YT078fHT0tTX5CjxMB0VPb7ZSoG20WY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGnC9xlFP_8Ucrmb10w9mW8ZJx3Li0y0eAGfWmK5CXew&oe=6A79B0B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
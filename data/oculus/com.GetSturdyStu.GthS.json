24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cf3MyLe1NJQQ7kNvwEcB_wU&_nc_oc=Adr0gIhAloIH2KfoKs54h-21UKcJqyZRF910x2HjPmFH2Eb5kRzJHBF76-xueeWwGYs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9m6Q9Qrt05HBGSfhX8nwUbFVXuZOc94zTIMQmbFtY5lw&oe=6A356DDA"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DPMKr_m0EAQ7kNvwFMTJuh&_nc_oc=AdrDVKiMTq_qwj8i_Lxy6nn0wGRzzHbwIBi1MVCKA7Mgx-xYY8XzNKB3ucNHhDlDga8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0gcisy7cVwJGO7dB6TXIyzZLeGekKT_k4acOxUyWHVA&oe=6A3573A5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TcKsc0T1jnkQ7kNvwGtaZUT&_nc_oc=AdrKtgNEAUZeS7y-hqIMmYt6B_urIToXJp58QsGtApsD7dksj1NyZEuR5H7qAAQ_roc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94fAQ0-Bw6nqBoq1ajH2D5I55DoGskwj6ONMiCdis2NA&oe=6A355AF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnLGJBEfgq0Q7kNvwE1W_xn&_nc_oc=AdrNJv0bQkEa-lBFUPBnTbFqRalw0Gv-0Cax8qnv3LSekW1JxMSe2-0o1mxBUTGGl3s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjbFDAfek_bRx8ifRGo2d9jwhZgn8Ah1RhtDnoNjpJOA&oe=6A81AC9A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8z6FInK14UQ7kNvwGlVpgf&_nc_oc=Adpa9Q2DZnl9IZo2aumcuoPBb8hziJVRaLXopFP5epFqSAHoaWUITfcJkP9pkI_65Yw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6uA2SFVXipKgXhf3igkPFR9_vNYSMo1T2F7wRcA2J2g&oe=6A81B265"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zV2-XsCtFTQQ7kNvwEnNC_5&_nc_oc=AdqKdh73aDLhgi8L4gUtWaNPJphaV53YCUejUfcIksFivqNrUSvugSrd5BNKfZPlN4g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkOF5Ru5Fm8f2b0nglD74Z7Og-ql06I4rXG0dAuCNnuQ&oe=6A8199B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
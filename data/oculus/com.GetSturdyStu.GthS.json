24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSDuC4HyrJYQ7kNvwHpcWRj&_nc_oc=AdpBrAkwMCTAs47DdynhoR2thWaleWndykh9YIh4ih32yl_6JbWCYWYi7npLF3UKQS8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HabIcnzW7Ikv4rMGQ9gMTwjFUv5OmFdpEBg3UoGsGXg&oe=6A104B9A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rkovYDehFpEQ7kNvwG7fmEi&_nc_oc=AdoEbUCyYkAkUsZmRnKdkYz826ea-kQUYRabSjcsdolanjeOxHwba_Qwp0Eyuq0l9kE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BlGrLXt6bkRjpJeuLtNgLKKzfuW38tjJeHuTYou2csg&oe=6A105165"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPBgfOwbkNQQ7kNvwFH1OZF&_nc_oc=AdqKiblk3N5XF1kF6A5Lmkw2Ye_B3vdvv0m8CftO7PLcSDtGnykTKtt9Th1RmYeOcMg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Y1wkVPtE6c3lM8zccgBBtXQaubgiray1-lfp0qk7Z0Q&oe=6A1070F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
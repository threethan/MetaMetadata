24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqj4-v66nmkQ7kNvwEVcMv_&_nc_oc=AdqQkMMELHwItukLsVU5zuBJ9Kn3w3DnxHVKH73D73KisBPfjc93v5Grij1GonQUuIA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhBOeP-RwUkFk8MRneht5DPYNp6MV050pxckvPwQ4MmQ&oe=6A88441A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAtHIFTphT4Q7kNvwFvPIhC&_nc_oc=AdqFZ4GQbt_kBQFxvOEl0v82E6HUPP8W0EdhQ6nG7IHu_d6kaVQ7vRhOxasFowRIY-s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqHabV7Km1HIoWjAxET10i6zK6sc7AUPqLPNKanyX25w&oe=6A8849E5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiOD_xID7FEQ7kNvwHQbP-I&_nc_oc=AdohXO5dQB5qTQgyLkCQmi3a8h7qIH7KThrE3YydXhLNqv9Tr3li8YDgQnSr5anSMYE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERT8WekQwu-hYiOjkqWlg55hYdoHc1Yq2fYMQWhaR-bA&oe=6A883130"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Keep moving, stay focused, and don\u2019t let fear take over\u2014because once you lose control, it might already be too late."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gthshenanigans/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GetSturdyStu", "support_website_url": null, "website_url": "https://sites.google.com/view/gthshenanigans/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25841861795493265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499307466_2083827459205928_8584440608480207108_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cPOg1KUGWUQ7kNvwEZ_smz&_nc_oc=AdouF00p-DXexfeUVdWMu9a0GvapvLh1Ycx2KjivoF7K9oMXG69pVHWBTstQy7arCrs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH_mPM33yrByqhJN6vbgmYdZIv0RNh5dN3BgRoqpiomQ&oe=6A884BE4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GTH Shenanigans", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date":
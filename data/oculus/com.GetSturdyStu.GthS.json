24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtSGAa29UWwQ7kNvwFfS73P&_nc_oc=Adr6ZO1tENTVv40IYHVc2moUxnbsdLR-755a3XPsPsm2PyMxu8GneNaHjsqLVFlcRGI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQl03z_CHxJA8iTBZsBSGFwv_V1TxhrGalmy0ffHYOqzQ&oe=6AF345DA"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oij80nYN2BgQ7kNvwGsezEa&_nc_oc=AdpAXHttVwqI9pVxSsagkfNSAYEqB3k8bRpKC6ZvUmPHV9zo9yhW06Vdix8aMZMUfDU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2yLaq5PFFykBrDYOVz-m-W4kGUbzK85voATw5INZt9A&oe=6AF34BA5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=txFILeCJ0yoQ7kNvwHHsazW&_nc_oc=AdqgfSPlz58iZHia3baLTsuoT9pe7DKsm_HkB02UxLTgSNMI1SiSlHv5xKEOOd1tfhA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0z6iv0ZeUx7nrxCeDCjJJOAU4QgABc32HZpIdSxE05Q&oe=6AF332F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Keep moving, stay focused, and don\u2019t let fear take over\u2014because once you lose control, it might already be too late."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gthshenanigans/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GetSturdyStu", "support_website_url": null, "website_url": "https://sites.google.com/view/gthshenanigans/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25841861795493265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307466_2083827459205928_8584440608480207108_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEOvglaat28Q7kNvwFB6wxs&_nc_oc=Adrte0VG9P_3v6bI0aT01wa1-otEgL1CcOPk_ZhXua8N7D8XHAB1H0GDrvHr7FiGd2s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJRhT6CNensdJkOEnXEg-NoiYaAaHmLIpRTGYnNVccLQ&oe=6AF34DA4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GTH Shenanigans", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date":
24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fUdB0yBV-3wQ7kNvwE6JqaS&_nc_oc=AdoRmW5zcCeXr74-kKoKndW6dvaGAf86gJIs20ODXIntUekyqy8OPDBE_M2bmcXKcY4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmdbuNeeb0VVBY58UEUvjIJ01_ZVjPteijSStyx7SoVQ&oe=6A94219A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ixy4XwPozMcQ7kNvwExCz_D&_nc_oc=AdqIcbwGR87t86L7vkV_dZZQh1oNDICai2iwNy_JPlWu7LzpWR2hw3v4Nbgo3wFeCX4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdlm5cLEG3TQrA_Pe2xAnopdm0Ag-EiceBWLJQhUUNUg&oe=6A942765"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e__Omz8hx8gQ7kNvwEuy2hg&_nc_oc=AdpQHN4nEpS01OUGsAuy5E5qHfEMr948Elvjvb1Z1XWkEIuslACqnhjDfB_S7JDYPXw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJLjF9SSyxcvWv-Nuvl8Vb1dN69v1U_Ci-vy6vTe_XYA&oe=6A940EB0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
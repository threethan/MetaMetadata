24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-oFROy4oUysQ7kNvwGFDP50&_nc_oc=AdpAAaoHBPRuox-SPg_ZZ2_PP5GVrwrNE1iZ6wGEQQflvHxzrLZV07w-WhbjSCy6Zzo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ68FivXYso_MDy2mAaye8HLzPLHsFG0uFYFgnKepP_-A&oe=6AB2741A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3M4gmixNWh8Q7kNvwGd3OEQ&_nc_oc=AdqmMRT91lbF9yjJdFTdokhJo3NoT8M46Yxsacljk91Mefg1c6ai-Wr_LVXVwvbwuS4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdxjZHuw_3AgZk0E3TaYhHD1q4wVq23shrx_Ue6nPmfw&oe=6AB279E5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR0CAfilNcEQ7kNvwEaeDDm&_nc_oc=AdrwpFiQFI_j0epY7fmAQtTBgxoXiogdSlJGufhyHZdkTPT9JGpy91zY3WrX0Om7xv4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcPSqyDYN2gLQAB1jVdEnLJWDd88-QygwnuSaP88Vl4w&oe=6AB29970"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
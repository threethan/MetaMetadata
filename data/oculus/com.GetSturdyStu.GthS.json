24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nOn1Gul8xkQ7kNvwGmltnJ&_nc_oc=AdrVbDGZp4-UhO5SwpufgbBusAv2vHoe84TF2KlhAHXICOi1g9j__db6e1sVPrVuGjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M_Bph5bsXYM8KTIaW-S8zDHU_bosmRnLq78ei48IRvw&oe=6A3EA85A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y51tGssKHd4Q7kNvwEpj7Rk&_nc_oc=AdoSw2-7TRoeiZj6nyaPtuKcObOeSy5YuX2XuXKz-1f5nXoxkvhx9razUkXPJ0ZlZZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bBcXTjV88rEX3VCcR435pqBRTPcdin8302heYXPg14w&oe=6A3EAE25"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NzlwG2W6RsQ7kNvwHDCtMZ&_nc_oc=AdqJ2Z06Nhs8fQQlUj0QmVW4bxa2i7Q8OpaLHi8PehxozI-CWJp8OmRb6N0zVHRW7B0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gYP5s8mMFozVp7iqE0lTSpKWUpeIu1Yp7HRFxqzUYvA&oe=6A3E9570"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
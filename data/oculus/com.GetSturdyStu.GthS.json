24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cf3MyLe1NJQQ7kNvwGmUgca&_nc_oc=AdrrSxt41WQXs46YPWSXH9d3mAFLSyyGQl5yFRtJMsVR5XO2E0j5rJXZQFloWkcbGAg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_USy5Zw6NHbhdmLwkhGpRih5gmLXBYnqtsXCDc-EICHw&oe=6A341C5A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DPMKr_m0EAQ7kNvwEyMNDa&_nc_oc=AdqgBl7-Nzmd7oCCR7u8L3wx6L27CFl11dJlFsUC7uX47veJCHvqWUFWnUn5VnFISmo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vdnCWyWglSTHiwt6nY02p67UKbfqMgQgfKullqkpvvg&oe=6A33E9E5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPHdrlUfqTkQ7kNvwH_XsNv&_nc_oc=Adp6wv43CNJNzrqGOGKTGuvv4j5ykT36TJ_k3YoaqQw1fbIxyCYIDozN_YsInIMGXQc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OQTJqSdRB0DfD2uPl50i1VPEHtRq5JLW5m1w4rpuhWg&oe=6A340970"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hgwLXQVR3FUQ7kNvwFNOw4y&_nc_oc=Adqcs_VQMF8NSyfVMJ2ivJE2aGBnr1Ilr33ZX7qf8RD7Ll5Ht2iTwDi03ZFqJ2kIerQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFi-RcIgaPgLPupBwmvaeRPaSMyslNEsvqplE4xY-HUAQ&oe=6A902D1A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xoa0N6pvjIkQ7kNvwHmZi0V&_nc_oc=AdouYOsmffRUil1imBQEjvw4-UQABSJxKYW6WTqNYNxChFNzROHMakTl5QBAuBGrtlA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVrYv1uhmT3zu1_IEQ8_kPyFJO8INFTkjVbnkonGTZjA&oe=6A9032E5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gjp5pc45X2IQ7kNvwEtPUAM&_nc_oc=Adq2-OLxTk4qDg2InpHZ1Wag4JxMddz_ERL1nYQk0CpCWtPVk3CpDSBMgA0sKF5wkUk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGW4vbXMs2w_bJYZtgJj0_8VYLX5-cek-BQKaV_LjaVpw&oe=6A901A30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nh26ootmmPYQ7kNvwHseJ85&_nc_oc=Adpi4p5oh_C_l7tkZWTOfbukahEHO9M3DycklEzhp7PJAhtqDrPxxWcNY6VUzr1GKNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvTwJT9o4V8UauM-3Ztl-gHsfRj5d158gGWu3M1F3g7g&oe=6AABDC9A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=frE3lPCjx3IQ7kNvwGam22w&_nc_oc=AdrqPosIN7vW1JtL5rUwpypGjE613YskgpbQ4LeAXqU4xMU1RT61fkeY8hUu27kTymw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR9YMJ_grJg_AzioUYKW0peQXuPooEtyH-RjpYoM16sw&oe=6AABE265"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w01DbIZeLfYQ7kNvwGXTUtE&_nc_oc=AdpkK5p3XJDBrGAECMbcTBioQYWMpO-EOy3guzWUMRyEokkXvO5rCA2F4X19eQZebow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLOiDrMmK44SamHE7KhSysIqvsHzQDjC8chYihur82R-w&oe=6AAC01F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
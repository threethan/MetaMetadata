24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_DyF9ksDTgQ7kNvwGCUFXM&_nc_oc=AdqYccVM_wcUxVjj4doi6MBOT_-40gPZ9OoZ1bI1bz7RQuSckFTJSs4UjsV4BoPhEgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNO_NDdFsB86ejqwccBDq0f4SJus1EksVfAbLLcwrOohA&oe=6AC12CDA"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPwJmeRGSScQ7kNvwGyspQ6&_nc_oc=AdpyfTgwGAubeWmHwZ2Bx5QwLlw14Bj_Qdo6S_m58FewdVQovsxki8FiyMW36txsC_U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIp_F6WgsJCnFFl1WO7ZOTTIGr_lsI4nl4O1LBTEW55A&oe=6AC132A5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7stT45KmKwQ7kNvwGuigwH&_nc_oc=AdqcynkBmbHHeeH5nvFeASOudbjlOA5cL_XMax9YlcYkaKxQH-vTyZitSOYBJ-r0o2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRnhqIVeaD2ysqFycJ9nvy1vI2V-sD3Ik9MKsHRQoc-w&oe=6AC119F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
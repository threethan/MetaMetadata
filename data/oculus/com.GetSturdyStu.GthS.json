24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-dNjEntM1oQ7kNvwEGin9Q&_nc_oc=AdqAI8yNn6pGfI_Yo2ZywXYqJo-5R1U6CfMX8cqDEM03RJ6e1SUcCX7QdTmCYIFjK1g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dZPJ8Hwe8I-r7uuF0LGY_a84Yta4N8NlBpleGJSUniw&oe=6A3027DA"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMACbp2J_6oQ7kNvwF_p44b&_nc_oc=AdoT2Hc26mR5fg9_wEvJ3EWy9vzlvtcnAyNej_xb61dNBFMoCWLj3jXAsXLLlOPuSE4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6utCwtQKPcGYyQPOgAzpADZjm3I81_5cZhX7YOFCLnw&oe=6A2FF565"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oTkxtbv4d24Q7kNvwFEO-2_&_nc_oc=AdpTIDPt7GFsGoEtMAVJy6floo28LN78IfM8oZoyZW9DtGvwuV8hl6wdslnQ2EK4Z8Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88XM15a6gbnyM7Rg6DCbbkQNQ_cYeKI0sTnyNJqRHvyg&oe=6A3014F0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QF345uv7LfsQ7kNvwFQOsUv&_nc_oc=AdpXTmKUwryB5QXOAHAmTou278HczyWThpxmE2espN0FhDaBks-OYyx8c_s-crVGZ4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmBT-eurACnrzPXRlLPu5NL_0X731Hj2ZOGtVWvB1lfw&oe=6ABFDB5A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPwJmeRGSScQ7kNvwFbLNWC&_nc_oc=Adqma9wFGhcYTdcr_Lievyef1udJQBIzNa8aRaAUXVNHFfYvup70w8gYeaKrk4ty7n4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUmnDw4x9h61oJQ65Mj_c6ilGVPk_1ibRFWvbyPtmTVQ&oe=6ABFA8E5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z7stT45KmKwQ7kNvwGxyUDp&_nc_oc=AdqHnVybPxf2e4v8WGQQdtcWBGeyHrsIRR_driSuG6pREvuyKaU1RY-TyMcvikwW8Ao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMITHdOyY2NxbiZ3c-y0KmhtrrHYfuiGKW-SlJMvMXySw&oe=6ABFC870"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
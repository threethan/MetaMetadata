24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDAxCjOEg9AQ7kNvwGdgWGS&_nc_oc=Adq1K7LyvqZ3cmH-ZXQXhoQDwmhhqzAgYjFaA2OOKY0kCXX3ny6fekS3Wv_Y3NU5zKY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCag_uibRhxJFDW-ql0Jky5JS3Yiav9e4FRh_okorKOkQ&oe=6A635A1A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o0Yx8NfM4fQQ7kNvwGiZAYQ&_nc_oc=AdrDz3lp8RgIf4n-lgQ3Va6vOmkSbgRk_9bY_jYIpvzWPszK5R0MYb76qSoGFBSvajQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC8Mopvtf2R6FgeAsS7L5i2Nekz7P246l4RaRa_P09eQ&oe=6A635FE5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wlMvB1aGdYQ7kNvwFBGNhL&_nc_oc=AdrghEfybrwutEdpSZ24bjZvntfLmDuop0pUpZZ5uDf0hY-Mbsu61Llo6SX1b3b8ipc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANqY_hs36mdIB-visuLw4RaehzxieU9JhBmQD8w1FW1Q&oe=6A637F70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Keep moving, stay focused, and don\u2019t let fear take over\u2014because once you lose control, it might already be too late."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gthshenanigans/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GetSturdyStu", "support_website_url": null, "website_url": "https://sites.google.com/view/gthshenanigans/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25841861795493265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307466_2083827459205928_8584440608480207108_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FITHENx2-ncQ7kNvwHp14DK&_nc_oc=Adpx2rZ3kj5DQ4dEqVaG1GMyiJ-X4dMkJyrz9VfxPpmQh8CXjwv3EDNAyzALxP5iSA4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB44ORCBmmN4GEaL8AnsgzCXREmR13wiYQCTgb1wObfCA&oe=6A6361E4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GTH Shenanigans", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date":
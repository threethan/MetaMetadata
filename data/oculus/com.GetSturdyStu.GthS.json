24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrzkWJMMeFkQ7kNvwHEDFa5&_nc_oc=AdqmD3Ad81vpC_GIRmqH840kHLqxiJt8VkaQdej-OdFuImWwUF9p2vPi4_ijW16cEtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9Ikn-RpS_515u_YfYI7KNAUpKxjrriRl8A2yoGBdk6Q&oe=6AE0989A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKu4a1dTHokQ7kNvwEc0arC&_nc_oc=AdoqjgVEQhcXOsw0Y-QPah2ts7jnATlvTBr0oPiUS78MGFdUgQRMtzZHO1we0EbTqMo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDuCcHWSA6Wh1E8xNTd2LvCaH-Up05slnDqe5_2lv-rg&oe=6AE09E65"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqW9uNd4NEIQ7kNvwERsLzw&_nc_oc=AdpqyEyJ5xvskwufQRbITVWHBsYjhJZqbu8Yd3hxiYvUSfTyA7fZG-dcDESbddaz8pQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoXJmqnqLLX_4sTd1qOq70fcIKjltpR2C8zMhcHbWsMA&oe=6AE0BDF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
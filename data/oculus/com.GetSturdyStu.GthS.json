ZCsW13LepQw&oe=6B106480"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-00.png", "id": "4113644688780622", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298900_4113644692113955_4436955163524404624_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Utd_TMV1UEEQ7kNvwG7Cbmm&_nc_oc=AdoXkkHXcdyp56AhmhIR3FT7XL4tjyScluFNx2kpmMrX2-Pz2GcRE1GBOADC1523OUo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV6mZ69uj91ohOlEf6wbT8yHUjz-GLdEYMNPU5Y7IM9gQ&oe=6B1046DA"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuXFVZT15UkQ7kNvwFlzJqA&_nc_oc=AdqSjQAWWq92KoPpvryZzPsga2nGawtPN1LSvJgFuPKKsyeXgh5JOOpiocD26bXlbRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWSjgzOJVeqaoLPQuwpMGODPMFNpYqdW1rHU4Rdy5K_sw&oe=6B104CA5"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j73PljcUtgkQ7kNvwG4Y3VI&_nc_oc=AdotOvJ_ziSx8E_f5vP30Xaw07XyYbu4Hcmzuc9UniQkEj15DH79U_aU_0OpeONC35c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZgAqINZZBwBdu9MLg9r-oEKCJ-q8MgFsBLr1Xvf18yQ&oe=6B106C30"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Keep moving, stay focused, and don\u2019t let fear take over\u2014because once you lose control, it might already be too late."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gthshenanigans/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GetSturdyStu", "support_website_url": null, "website_url": "https://sites.google.com/view/gthshenanigans/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25841861795493265"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307466_2083827459205928_8584440608480207108_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFsPCj4glIgQ7kNvwFmY8Lv&_nc_oc=AdrCLu4HHJGc5drWcDQ6w8raAiZXR-WI0FTYHtPN9nXod5J7ZLaDK3hw5icGqhURO34&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-goHkTS_ZqYQEkDIlSQulG2kkG9zMc6xKqD9VR-pDZA&oe=6B104EA4"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "GTH She
24404624_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqj4-v66nmkQ7kNvwE-7Bhe&_nc_oc=AdoMcy17PKO6tSvbQvSoRV1wDnEfuDw6RBXMrgMBOxQpNx64k_Dg2KUMzqY176p3c70&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAzCoWEirV9k2kM60FZXndfB6XGY7z2FbG4Xs5F4ko1w&oe=6A89959A"}, {"file_name": "67scene67_1440p_12.04.2026_17-41-56.png", "id": "1749427896225531", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499308998_1749427899558864_5241723870089005310_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAtHIFTphT4Q7kNvwEiTZpW&_nc_oc=AdoWOBlu0uQ-xTrkHoq5rDUoHx1e-VqB0-ye3yRsUYnG7xgxymVW-1BHKIwPyXWsWs8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGvI64fi19GitY2Pv07bKhbcfN83POcadxxkXCbLtytBw&oe=6A899B65"}, {"file_name": "67scene67_1440p_12.04.2026_17-40-28.png", "id": "1641484377161570", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308063_1641484380494903_1217541009960327084_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiOD_xID7FEQ7kNvwFs6KCe&_nc_oc=Adr9v6Ah-OP5W1JhMdtfT3tOl_hEm92ooUqLgCbmHsYIwqWUBZ7XzIA2OS9lFxP7ayw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEszboSV40-QS5JC8Aal3Bm8bYuTDoLwE0lVcmR7z9RZw&oe=6A8982B0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "GTH Shenanigans", "keywords": ["Gth", "tag", "horror", "clouds", "gorilla"], "long_description": "GTH Shenanigans is a experience where your only goal is simple: don\u2019t panic. Thrown into unpredictable, eerie environments, players must constantly stay on the move, thinking quickly and reacting even faster. The maps themselves aren\u2019t just backdrops\u2014they\u2019re filled with unsettling moments, disorienting layouts designed to catch you off guard and push your nerves to the limit.", "short_description": "GTH Shenanigans is a game set in eerie, unsettling maps designed to keep you on edge. Navigate through dark environments, stay alert, and try not to panic as the tension builds around you. Ke
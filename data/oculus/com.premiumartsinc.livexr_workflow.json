B0C5D1B"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DX1JYXassIQ7kNvwGnrtO4&_nc_oc=AdoRENoIrSvwsenU47RE_Bat9a6bkbJ564ARa7OHvQ-XrGbwN0-tY0RVfxKDk48o1-Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTtQZYW74-Bru-dJ-NzqscwXcvwgsN4v-Dsc4ls0IRKoA&oe=6B0C6108"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx9cNeT5LOkQ7kNvwHuqsxQ&_nc_oc=AdratuHzrG0FeHXEW_OSD44CxdNrRcVpog-bTosBE3tj5eVgEkqmrlY3_-G0GYDNiBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTpKLpRQ010Mn2t8laEoZijY4JbD79MlkxU04WH_XmaRw&oe=6B0C548E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99DjdkX9zyIQ7kNvwGSrOs0&_nc_oc=AdoCDRx2n6J-04LIwxELGnGEiXjwmjXgLic5RLWqB4GxptwE4SGJlvuqMNlLJPZK4V8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSzSK7LxpKCXscidFcv9giZGs7PpNdmYITbkOHNA4Fflg&oe=6B0C65E4"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmWwsLqsAygQ7kNvwHHzuWN&_nc_oc=AdrZT-lELj9ZC_iwM3sqNZe5rQW002HRRSRx-hpokzbwhGUb--bi8QUcv7ORsEVy8nM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTJ1oJjwgdCbCvjiLqYF6FQqRFElBn3e1eQ63ivq0NfzA&oe=6B0C6FEF"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9HDDDjFKJ8Q7kNvwHsLHGf&_nc_oc=AdqauvgXTLNAPDg7R1O-HGXAzM7b1e9GSjDKBWSCArToPBC-3ApdjPW1mxi7me4-Zxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSyN41hdOMgSnYlAyNef1Utgo_STv40xTMlU3pEy7B4IA&oe=6B0C7808"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd9M2Ir7_qQQ7kNvwFAiZxC&_nc_oc=AdrQ-m_sobShUIh14e0OufGihp10fp14lGj4xYs2d5Vh20pEmbu2ikOBxmDSTSEdFyA&_nc_zt=
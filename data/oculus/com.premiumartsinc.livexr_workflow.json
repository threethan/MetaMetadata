B08689B"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYMLgFrvHVwQ7kNvwFNw23D&_nc_oc=AdpxebueGN23GDjd1q2o1JAjv63JEsA1widXfp6KMKGpAGYRfRVHuXbORkS1LMjK_ZQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNEDH9rfXJxlT-Sp94YxvYuw1hJBteottgdcEDb9BRvg&oe=6B086C88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX_elEMaIZEQ7kNvwEbXqLk&_nc_oc=Adqr5KsulYeLQmvD26WHFojwuLzjJaB93Ll30PjoLqIGODCRc35ipOA01YDtV6Gq8uQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmWYeSynMsc1x5uCu2SD5yerh0PtGMOVuOU370rkhUsQ&oe=6B08600E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NB7AyOJY80Q7kNvwGo_8-V&_nc_oc=AdqX9xc7aSmjtueqfy82-w1FJbakJcAEvI1I51MmIhZSJV4Ku6MDoStBGfqAAqzoJz4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBE8HOn67QFXHKqaJv0qljoXpcWXYVoeoyRLBHe9cfvA&oe=6B087164"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL8cJs6VEUIQ7kNvwFssa2X&_nc_oc=AdpbPdvUc2cjJan9Ec3x8pW1QPPiO1JLbFSGqhRmpV0E4V1F6s1L9KmJCw_htTgK6vk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU3i87SMkKsGx7I-aarfUzXfxvlCGaU1_8-zEfIQHByQ&oe=6B08432F"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWz9GwXvu5AQ7kNvwF7di9H&_nc_oc=AdqQ2yASwLuBnMe5LZTMGGTx5rPQ4aoQCirrwTHNBRP7cv4heGaDBkjJGIJYCCLG9eU&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLGtudMTaAcKSSFCq12mOVoxUAPUpTxHmty1T8wdqVBw&oe=6B084B48"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0YxevAgD0AQ7kNvwEa7Vqq&_nc_oc=AdpL3D2xeJbA00h7Vtl-Jv2WMpKX05BrvFOuwKGjldyt3gG8l-gqj4_1uQ28vEcDRh0&_nc_zt=
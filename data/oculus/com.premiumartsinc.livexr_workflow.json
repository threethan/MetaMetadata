ess&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_x_U4oni40IQ7kNvwFPnB1q&_nc_oc=AdoDYVYNiuW3PooEwQyXoOLsAxx24vuUZrFfheuEj9SO4zPqvotEVKkPWmCA1kWZAPA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdQ3yvkodKbkJvOz9mdeVw6w0hetxJGCm2ZTYOSgww2Q&oe=6AFC8E70"}, {"file_name": "Screenshot_05.png", "id": "3106151486251584", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619450_3106151489584917_3330107057557704904_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rqnu-hX-gREQ7kNvwG44qI_&_nc_oc=AdosQnfXdtxVwg6o6mreDyUipNcnJqkbRJcjqUHD9xf_PXrNBEMzkQqQSBufYSaj4Sg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5sLIqG_cOe1QZp9aAv6NZLAp9LcQKlIMOKlLsbSs0FA&oe=6AFC82BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlbttbGgJ6YQ7kNvwHW1NRX&_nc_oc=Adp-ShNUztTS4Y2K_osI8T4jxB92nf_DWqncAnzDUGtQzHnAQ6tMlnJdi4K5Yg6w_-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_4-aPhGRBjMti_ACkjRD9_INl4f6x4dRTXedyYECsmg&oe=6AFC828E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.premiumartsinc.com/%E3%83%97%E3%83%A9%E3%82%A4%E3%83%90%E3%82%B7%E3%83%BC%E3%83%9D%E3%83%AA%E3%82%B7%E3%83%BC/", "developer_terms_of_service_url": null, "publisher_name": "Premium ARTS Inc.", "support_website_url": null, "website_url": "https://www.premiumartsinc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1097658829612374"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1671261457483246"}]}, "baseline_offer": {"id": "1671261457483246"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784855280, "status": "PUBLISHED", "id": "1671261457483246"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1193669093344680", "version": "1.0.10"}, "id": "894077413723488", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": 
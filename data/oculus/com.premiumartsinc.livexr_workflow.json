B03229B"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lc30iaN51rgQ7kNvwGSg9RJ&_nc_oc=AdqqypgARKxNNOzbUVNSuhwrFqPWYl9DJYcp6MRzEcadhioJK4qRaoM7ZGuKT4i5szM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWUAf24vrSZuF8OGEqFj9GiyDqOSnLrZ96HveyhAlEiw&oe=6B032688"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omTLpGOYiUAQ7kNvwHJYgO7&_nc_oc=AdosTa3NcyGZTO98FjS-2hZoRYxwmX5S5qRVTF36yELtgAeuEzOu7-F82KHkdOZilN4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCCVUqihUjVAFiD9bLCXDBZrVThonI-Nb5XYTGjvO2LQ&oe=6B031A0E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3WJqoJtZfmEQ7kNvwFj8clw&_nc_oc=Adq7quTTuK7ekThR-I98TF-Uk5qDIq-fo18HlW2DcgXmZeyM0ISlVRnHLRlAYBZgPoM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRQJOXTWR5Spq_flfKMH-PJ_sAqbOmKfPMpZKVb72KOw&oe=6B032B64"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o8ASjB6l7I0Q7kNvwEg6W1N&_nc_oc=AdooNUoLfr7phsT8YPUlkU7Vbaa2M5zh90k03VOrrAi_PhS0_RRMweKxkrjkVMixQDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9ufg1I0to6iDGibaB8xjEZfrQ4J4n_HKtzUBf1oWOJw&oe=6B03356F"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hcsk-V8O-kEQ7kNvwFZpx-9&_nc_oc=AdqbGfJdGrP08za35yx5GLQ17zWoqQbXBBlDl6mEErPEqOQkvRNfqpbFtJ2Pd3okO5s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOjHz_TgyB9q6mKPq_mLYX_DaZlSqqjoTGK6owJuorhg&oe=6B030548"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5LUquxAVncQ7kNvwEo3TML&_nc_oc=AdqKjpnQwX5H6MD0PG98lC5Zfu3VJKhBIkKSlUvwaqlqu45lJvxYOKqbNdhMDCeluH4&_nc_zt=
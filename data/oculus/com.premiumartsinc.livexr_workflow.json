B0B43DB"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DX1JYXassIQ7kNvwFrCnUx&_nc_oc=Adrz6A8uxlygzvD3yStMW2KoCKfLwwjkFG53CThgoPhSZTeJ5r6D8zKLYP_MqD3ek98&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRTTexC14fUtDlCFUQ1Ru01E5tA4Qj7o2gXsHsQ56wsqA&oe=6B0B0F88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx9cNeT5LOkQ7kNvwEgVUTc&_nc_oc=Adrwq8yz3-4vnQySmXCN_YV94jx9w2ZQGTn6hnct3Z-lU5611KWf2AfxU1iPANy02kI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPHgwjQny1QbmCJli_FiCtrsQukrFijijaEq1_5EBjtQ&oe=6B0B3B4E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99DjdkX9zyIQ7kNvwGqdRFv&_nc_oc=AdoyyqKHmA4mwa92wTjtO1PUHMLaQ1st9B6YuP75uxD04o9-cfxeAcXGzvs5SFnz2TM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSlSUmRro1YM8nhzX3RwTNqKHP5OrHbwMycJ7wWgUXOYA&oe=6B0B1464"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmWwsLqsAygQ7kNvwGQUKCd&_nc_oc=Adp3p98HTT-j2OEBc8MoQzkIJpyiAE-8hW2t7uPwQiq5lLXZeacBidwzrvVyV69gxCQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRgjmQYfnKNc8qMHwRLBtds3Elkj28hUYRc8L-TIwjGBA&oe=6B0B1E6F"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9HDDDjFKJ8Q7kNvwE7DEAK&_nc_oc=AdqYp3ej6BOQ5moZg2IsiwN3Mky1EWv3lYaNUNO8rZPI52aaY2hKYsufAvXeaUo5mMY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTdnh3qjyyWd_qv8BBuRjRhfw4xd0ehCtdo20Wd5HX0-g&oe=6B0B2688"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd9M2Ir7_qQQ7kNvwGcxTP2&_nc_oc=AdoMI6CkqmlOyniy0tL7SAEmLDdPDM_e59HL4xZKnv-dxkphHOz4C5M96JOTlVfLKoc&_nc_zt=
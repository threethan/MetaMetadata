B09BA1B"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYMLgFrvHVwQ7kNvwFD9EFy&_nc_oc=AdrC0V8Mo70_hzFbRBjMHVnxF1tFDvT2mJVOBhpp0LZkbj4-laW4KljN-HR_eXy0iH8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNqTmqjePCgT6coN8JgJ5BgDmya1xozA4G8kwT4cd9OQ&oe=6B09BE08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yx9cNeT5LOkQ7kNvwEuZYye&_nc_oc=AdomZTcUL7ep7tFY-qvOZKDXD0tynYVyHF6fcQoHha2XZmcVGjLviSVQHjYZChLghbg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0vDYOOY-Kg9cSZtQjournCImbDvsESmLzzVx2wgDsqA&oe=6B09B18E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=99DjdkX9zyIQ7kNvwH9xy1V&_nc_oc=Adofy5qhX4NyqSwh7jmlMF78qYHihfMJkIXSuGhf-ydXZkBFrXMbHrbE2qYzCBwJR1w&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmk9qEkXMB8uvbSRi-KddTNVeYEf0PxiCi1UOPHJnEHw&oe=6B09C2E4"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmWwsLqsAygQ7kNvwGMOx85&_nc_oc=Adoz4AWE3qKDL55j5sxCEmbkc_38j7vWcxsmQyUREK4_gV1_ijCiDbepsH2qTdcLT2s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9sHpmXnh5lQyrckN2iNGv41Y8uXYNGhk4cvpiJElUkg&oe=6B09CCEF"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWz9GwXvu5AQ7kNvwFSHUey&_nc_oc=AdqhhSwhQc2IhUC45lBK4F82G-0haVdaI5dStrOKr0Lnay4NS4dPDojT76HJmTVQVYg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQH7rTV_nU1VEePymeUkfi0bFzA636B3VOAsUnvU23KKQ&oe=6B099CC8"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0YxevAgD0AQ7kNvwG_N1ms&_nc_oc=AdrONIoG8IwoQhF_zDCs_HmD-HdOSJLs1DJM_eHlnKu4WXFH8_lCibtP0uWv99rwiBc&_nc_zt=
AFC8B1B"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37e_GyekcVcQ7kNvwGdyDIq&_nc_oc=Ado0DGRS6poojSeAB9Rcyg05I4uNnHFcboCXiDANC-LddYFW05GRFAlxR5YnZLvlObc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHkB-_2lKDLhaLVjn0K4mPx4QC_0FhxreUDyTVvArVYg&oe=6AFC8F08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlbttbGgJ6YQ7kNvwHW1NRX&_nc_oc=Adp-ShNUztTS4Y2K_osI8T4jxB92nf_DWqncAnzDUGtQzHnAQ6tMlnJdi4K5Yg6w_-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_4-aPhGRBjMti_ACkjRD9_INl4f6x4dRTXedyYECsmg&oe=6AFC828E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDGO0MpgnnsQ7kNvwF7cq9u&_nc_oc=AdrLrkfC3eX0L14C85FtqzHB9ZPPiPD0gn-yb0Gl4w-4dMussslYcLmgbpDz3lo1mN0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOL4ynsNmRGu1yqCGVnnmQRSdAKczZKHT4vIapZ0891w&oe=6AFC93E4"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs816UwLAwsQ7kNvwH3bjty&_nc_oc=AdqivtWACbLNaS7zEEnCfOpSMeD0deEXtretBrQUgdSMuB0D11ki6P-kyEyjM55zxAk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSUgCdnGW9exMGzveQ6z574OGE-pkjROX4IxItk18URg&oe=6AFC65AF"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C-ReeOFCKkQ7kNvwFoTE3M&_nc_oc=Adqw6yMnK6Tg7A4sR8ybXznrNqoHFiZDCx2313eIulrXgPmmrdNwJmoZtC-kdN7xAqU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHEcy04OsPGPtplE8c9QWX-38m7f3pH0_4HA8QPWcAew&oe=6AFC6DC8"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrZiyR3v0bcQ7kNvwE15CNe&_nc_oc=Adqlzjv9xWkXmJ2_f2R5YoVL_pTHAL5YQkxXvDQn_shxOVRsh27Y823Ml8XAdltOrlo&_nc_zt=
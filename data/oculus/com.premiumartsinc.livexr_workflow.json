AFDDC9B"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37e_GyekcVcQ7kNvwF2mGpR&_nc_oc=AdpGP-V_edYZfWbYIidFz8pbmZLRKckpqOosf6tghD1LLqy65JeToKYTw6u3EBAFO3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6f9-w85qnngETM-3fGkayGwOVDqOjEjIzFV3-6EnWBg&oe=6AFDE088"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fc_skwWBuc0Q7kNvwHhGwbb&_nc_oc=Ado5XJJftfDZg_HsGUdQmHcqTNYGTnuIFAHVf0ezHPAVc6JSFKpdqTdZSZAhPOcH9Mg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSRWe5Mh-E-QDXfSkUd2rKdHMrOxjixxV1S7Cg9_8zqA&oe=6AFDD40E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6jjNESOcW8Q7kNvwECs-vd&_nc_oc=AdoRPFt0qmklebAKjvI1SzcXsSVFtXsVjJkyrCRLK8qBmzsj5A4LOqVYICG457YkH1g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRL6MXvx2sNMu2PBLycbKwQc3d6hLkD6ye0Wkuxc8Be2A&oe=6AFDAD24"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-lhTYj9HvsQ7kNvwH9zu8L&_nc_oc=Adr7s5rtBEIAExuwPAJp3Q4618CoLGKuBtGMb-9eqpRoU00GWne4ZUWU9_ohJeqNnyc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQdWYOo9C4AIGSijLHU2539zloALSWqSSIHrRoGJJGlQ&oe=6AFDB72F"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C-ReeOFCKkQ7kNvwF3-5bh&_nc_oc=AdoIhQ84CuUNGPc-TxNIKpLx14fj3XXFypJjo7Oxjw2l3n50vZirarRBI9s_AXrO5iQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEw71LDIXM4XZN-yKtXoz8_yRpNt-hpH0Z8EzorOpaUg&oe=6AFDBF48"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrZiyR3v0bcQ7kNvwF1SeLo&_nc_oc=AdrMnLcLPksqzqMsfpLLv1Ol01YLGUtuIQPCKedh41gtgT5MpXJZYNQNrpGbEw2qn7g&_nc_zt=
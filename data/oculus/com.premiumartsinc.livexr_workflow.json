DCWZUQ7kNvwFDwAEu&_nc_oc=Adrk_MHExK1X1ZywFW417LYjXbB5P5cFmfvfBtZb-gpbPQuXQJ30VYF7j_lqDyfiN_Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmNcsCvbFqRcUZi2S6k7ItFiwmK8_nqmZXv6SNP1MgYg&oe=6AE9E1C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVqZxT3R8wkQ7kNvwFvtwg5&_nc_oc=AdrLmk_2WCdl2T0C2ET0prSMaHfO-JH2AOR6nXx2_p7rIPLcWfBo_BeAuUVsvGHVAOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTMNSUGWI2jGedyQ4ohGW_KNDaJtIrG14sM5RWBurW1w&oe=6AEA0D8E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qikNiRsYrWUQ7kNvwFXIM5Z&_nc_oc=AdrX9n4T1LFZbr0uAxVN-IGao-EFIUEIqlDpShWlCJWBZXBdaaACk2pntfKTahT1PuI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZqchWZKHj70k-0M72W6xOAYzbybxRTIGlzumFDtg5kg&oe=6AE9E6A4"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_T9_7-o3R0Q7kNvwGRU30d&_nc_oc=AdoIxoERuMKrLhV3JZQwLenD_33uLIhv6JmTaL4QdwWcjg82TTfWCh_1sUapChfciOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNODE6drwH0VCzEOBogIVO6C7sKjqyWGN2Ytao_S0JuQ&oe=6AE9F0AF"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5AED8-uBIEQ7kNvwHAwWFW&_nc_oc=Adq2G5crX6pUz_dMjmf47bBncVDZylSkcIodQ4Lq3MxR8GzJs4t0KTlPtDJUj-Sf-08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTdWITSz_oQYz5jChbMnVlOqlvFxmjpDT24Gc5JR0Dqw&oe=6AE9F8C8"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sChl7C4fTXgQ7kNvwHwyYmW&_nc_oc=AdrIV9USQVaxw3QRbjJUmiVMK57RjmRvCBfQhftBOZ9r8l_MqfCWyHt026Wxaz8XjAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtVfnpT2w5dhMoBlAYe2i-6_KxG_K-WrJAL-pcTh4vQg&oe=6AE9E224"}, {"file_name": "CoverPortrait.png", "id": "909231588880870", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619680_909231592214203_3423422805574494547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUg0qB9CCagQ7kN
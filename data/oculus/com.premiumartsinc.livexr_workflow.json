B07171B"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYMLgFrvHVwQ7kNvwGMKyD8&_nc_oc=AdpuvwGOYFoVRTAxGAL5pVJlNc-NsPGmk38mVTAu01Loo6ZzRTA0XcVM0vuB_34lKWs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7U6cipkaQdQmGW9Y9tQvNFIfyq8Prq-gf8MtPb2wb4g&oe=6B071B08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX_elEMaIZEQ7kNvwHp-SvF&_nc_oc=AdruVe06a6fJP92yneD5SvwoYgYoZBrZYdqNDZ8zYwF_P3atbJN0juGpV_pnzKZZ68w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj01spTKnoRUEOV3QlXxKJQ4BuRgrIWgY_Mf3DOI1i0g&oe=6B070E8E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NB7AyOJY80Q7kNvwF64mbj&_nc_oc=AdqL_5qUgOny01uyzUQi3T4sb3Pef97acNSibl2RJFORnL5dt_GBaiZgKJLxegguyHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoSlipBy8jiSXH8gS13S9mlm2cTfH1Rze17XJXqimmTg&oe=6B071FE4"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL8cJs6VEUIQ7kNvwH5al2p&_nc_oc=AdrewXXbwHMw8HZ1xn4uq6vffSr3J9CTbH32AxiR97aJ5UtPyct3yOVM7p3yaQLvvo8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwM3Z5-29CwmqvrPIxSMiGFrwilH_80dXjAdJLuNKqoA&oe=6B06F1AF"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWz9GwXvu5AQ7kNvwE2SVC8&_nc_oc=AdpApk8_aPJLk9dhKHiKnxSqDvB51qAMSgeQXsRLtQt3_jovmt6qoF39l4HfNbmnnIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfegD-lXE478SM0W9nF4j7NZCal1wBGtu-HZccHqaH1w&oe=6B06F9C8"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOejPT2KmH0Q7kNvwGyZUzb&_nc_oc=Ado6trc5KcSw7EpNzVATjJSmDcYF9KoP3HbewisOGYanuOb5ItWcq2jgLKiYZj6p0sc&_nc_zt=
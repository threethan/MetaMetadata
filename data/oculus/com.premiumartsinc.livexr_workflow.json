B05C59B"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lc30iaN51rgQ7kNvwGfbo63&_nc_oc=Adp6zQhPnd61MkVGa13U8Bn74VYOIIAMwmRzRm9_LCtQN1NLcnI3zIbaLK9yGgbGawk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGbz8aiFl-O0rSkHkRflgYOUOEUvl7XSyhLt9gJbM0WA&oe=6B05C988"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tX_elEMaIZEQ7kNvwGn219e&_nc_oc=AdrM1CCZ2fyNM0ABe-XpxTF4VGyE6EgMM3DyhER9QRKvao2n14eOfz6J0m-mlQOlR3E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3mkFiB5xlS1txnOAEvlkMRUrEG61ubS_AxEut4WA14g&oe=6B05BD0E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0NB7AyOJY80Q7kNvwH8wE4E&_nc_oc=AdqPKZUTaY-6vnsxmjMukV1zC4cJd9of-SeixS0SxXL929vA7-vgoELJTWHTmwrlYWU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj08VvutN9mGTzfTlvAxgh6fE1g7VCQxiuKOtyWzfF-w&oe=6B05CE64"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AL8cJs6VEUIQ7kNvwE4Zw8A&_nc_oc=Adp4lf_YMmO73pydr6Q2115eSZznBBCsvs_53831RBfbwgv6SUh2bmuiJx37gg5Reps&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT138-X0TZwVBEZfKK4fGZTd8zYIl4PiGWbUAQG5b8JLg&oe=6B05D86F"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hcsk-V8O-kEQ7kNvwEzZVyu&_nc_oc=Adr4YMv51L2eNbXIROUHc6XhiGO5YqEv1YXD_i4cOD-CXv6l84_sLcAQphf-9J_WfTc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJIP5hCefoO05MapRecfoo_1ZarssTenBNigQSoS7QQQ&oe=6B05A848"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yOejPT2KmH0Q7kNvwE68c4p&_nc_oc=AdoA1oSq2ZbjeGcZ8wGwrv4SMZwlZDhfeAHP5VsjwUNePKGBmKDOibW7U0E6013Afj8&_nc_zt=
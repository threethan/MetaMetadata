AFB399B"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37e_GyekcVcQ7kNvwEW_CtE&_nc_oc=AdqsQlhtDjk7bNL_iraSxnEBdJ1VihqTNeHtA67sVUf8pVSk_kNcdDwLa9jstAVcA-s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuNHogVsuI1Drrw-oQpJFE8-unbDUSoLvCJ5eNdIm8dw&oe=6AFB3D88"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QlbttbGgJ6YQ7kNvwEOWQ_g&_nc_oc=Adq4ss1pcxJJOUWZObeQzmI2oN56qsxn_KMUUP4ekDXzk8qfaMbNdXOpvjaxjrRXQ38&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRd9I_SaySzwvjvZL8WcWh_RcE28TbT68kxH2fRgQNojw&oe=6AFB310E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDGO0MpgnnsQ7kNvwFVcLTT&_nc_oc=AdqxZqfRnDZkxqugujP7OCGVzbyKnfkdw1VYz-Jw6RjJtjCltIsPVQfVpaCoUEbgmfA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZr4hNk7ONmNVOa1uybmZst9AFFslUrnAbvcN3CMZ1_g&oe=6AFB4264"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qs816UwLAwsQ7kNvwFuAYgC&_nc_oc=Ado8vyk86mcbumzwZZ2Tp9FClC-re0aA_j9y2bvSFXU9TBUbwiDNrjJf6CAdR4MpOOI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWEqyCEwSIulPPvt4Eu7p3zWDLRfF8jyCUXqtVp4xuGQ&oe=6AFB4C6F"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3C-ReeOFCKkQ7kNvwGSMAWl&_nc_oc=Adpn25Erd_QBmqADDlRyLJFRQh9CSHQaz_jVztzwXoF275XFS7eS_HRr84qr7livsA0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvI_Zloftu4ta3xBOXvHsI-L--AD1QbGA-vfP-5uOLdw&oe=6AFB1C48"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4dT2Rd1F4kQ7kNvwHIftdO&_nc_oc=Adrg1HMe6Cve340bG5MWUujlUcGoDxKNf9tISOJwSnrofcokPgdsAI7jWbn4iXX0dCI&_nc_zt=
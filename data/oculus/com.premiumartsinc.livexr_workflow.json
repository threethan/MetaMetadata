AFF2E1B"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMo1ul-ahjgQ7kNvwF59mMQ&_nc_oc=AdrjOO2AsCwhGb0QGEbEg2NfuCmnlwCSfclfz4TTwcgdTLtUCTTcxDRm-n7IBMU7Fy4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3eYU7cd4poSd5KBetA0y-8A4_djwJHGeKRUvTOGesew&oe=6AFF3208"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fc_skwWBuc0Q7kNvwFIIZbW&_nc_oc=AdqMcGWymVuTuK1cufP-S1zytINSXLonu1Qra-gVwhX9nExk2biTFpug9WyB9UFqSfE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWYB0xbRw3z9sQMee9KSTmTgsP0e2cadlUbQu90iXA4g&oe=6AFF258E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6jjNESOcW8Q7kNvwHWjXle&_nc_oc=AdpSKRQopgDqhJvs-M5TQCS8yO3-3iYI3PpmJUov9vgqAV7p7U4lQbC6xPXn9ADwDi0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnTAEtoH1Nu_oIDA7EOQjWO-9MWA1bug6CptYBG2-ljg&oe=6AFEFEA4"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-lhTYj9HvsQ7kNvwHzKiOz&_nc_oc=AdqWwAubXfm5GAFOzn_qOWTC13PJCSoaM8-L63tz-KKizBpyHxultCUNqM5zGKyk-b8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdiUUgL9cWSDxe7GkqeqWJdmJguRMGN_FcGcWJonF73A&oe=6AFF08AF"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gXZqhbhgnAQ7kNvwGQQ0B7&_nc_oc=AdpGa3PanQLffNaWuLeeRTfSiUgwRO8w2MRny-mfZwzmJTfRlQj46LGiiQVsf3PiuCc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsxj5Kw2AlopBE_fiOKqNAA40AyLi1GrJqs2NzZjyi6A&oe=6AFF10C8"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrZiyR3v0bcQ7kNvwHzJt5y&_nc_oc=Ado8pcbTN00Zcdw7HhduRN9uvU4VtyBFs9uhFVI4tySJeS8qgKp2vl8wLiid_rqJmMU&_nc_zt=
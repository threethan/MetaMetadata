B0F001B"}, {"file_name": "Screenshot_05.png", "id": "1957517268134693", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593815290_1957517271468026_7566568638313611233_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FzLSZKiGy0cQ7kNvwEwQZ3E&_nc_oc=AdqMgLPnVsezkLlV3ctxgcwCQfYFCaFF602fWL4KpacuMqXIqN9JPqlAJh9WOmWrg1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9mO4kwqy0TyR9-eVYii8CYZ9K6-0i3aLvwXNm0f601Q&oe=6B0F0408"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerCoverImage.png", "id": "1307953604354318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619187_1307953607687651_415736046812000494_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3H9icb8Ip0Q7kNvwFzl9sl&_nc_oc=AdqVN2gURuTjq8gvsxl7ZKGtrN-YPPrDog5nBfQfQY07h7fpTO38DPt7SvnVmBG9NxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXHUXN1fdLQBkaqgOIlZu0L77OqUpLrLNvafgU-E3Woaw&oe=6B0EF78E"}, "display_name": "LiveXR Workflow", "keywords": ["Training", "Senario", "Enterprise", "Corporate", "Educational"], "long_description": "About \"LiveXR Workflow\"\n\"LiveXR Workflow\" is a service specialized in procedural and process-based training. It allows users to review formal procedures (the correct path) by replicating various real-world scenarios.\n\nKey Features:\n\nSkill-Based Modes: Offers Beginner and Expert modes to provide tailored training suited to the user's skill level.\n\nImmersive Hands-On Experience: Enables users to interact with objects (grab, move, rotate, etc.) and verify checklist steps within a VR environment.\n\nPerformance Tracking: Records the duration of each step, which can be utilized to measure training effectiveness and drive operational improvements.\n\nPre-Training Preparation: By allowing users to learn the working environment and operational methods in advance, it minimizes mistakes and confusion, supporting safe and efficient training.", "short_description": "A solution specialized in procedural and process-based training"}, {"images": {"nodes": [{"file_name": "LiveXR_Workflow_Icon.png", "id": "1598811945581411", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619485_1598811948914744_1213977764579826498_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbUwBcftxRYQ7kNvwEuwBuK&_nc_oc=Adp3ZQSxMuKkPrCg_-mLrEepIDPHjJ2Cc_RvkakrADd0xj8o7Uz9vL_ArViPn--9ojg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXgVvierkzs7K12ZTc3dYOWn1GA4v9AsLdNM8REXrHF_A&oe=6B0F08E4"}, {"file_name": "HeroCover.png", "id": "1339369154824880", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619677_1339369158158213_1318813242581904508_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JKceKkj3WEQ7kNvwEnpBew&_nc_oc=Adqkehw13eg9fe9oynVxo65zldAOnTio7HuuaRqjV-k7mqVXMhBSnr7VXfNMSPlk4cM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVcLQOZxtx6da3boORqXxMFjRrvO2CE3_9Uajf912xsHw&oe=6B0F12EF"}, {"file_name": "CoverSquare.png", "id": "1022915243544177", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619187_1022915246877510_7081347401376576142_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AM6jpWi6GcQ7kNvwErca_s&_nc_oc=Ado5ZzI3Yg5uv-hj_mIHac9xcwu8nFPlh3w3SUgXzxs2giB4LHboHvYua5wXIwfAlgo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX1TGKTUyewv3iTymnUOayWx4TQJQgtVe2AcUAaK5S0QQ&oe=6B0F1B08"}, {"file_name": "CoverLandscape.png", "id": "992663883547344", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619113_992663886880677_2021278599952064521_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jd9M2Ir7_qQQ7kNvwFbnInB&_nc_oc=AdroV5frI7E8FA7rcnNL-hvCKic_WTHk4E0gHeaqAvvC9TAErxy13kcwavJGusxUQDA&_nc_zt=
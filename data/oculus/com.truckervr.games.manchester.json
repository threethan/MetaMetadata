wEbgvx3&_nc_oc=AdoLpugdBLK2E7cR_AwMBp6Zgtq5JU_2yo1SX4Uht832JTbK-Ka48gFIlV2y7SZLzmg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lXXalJEo22VlSrMd0kwuCp8vSlz2GNxU_7FYOGYArIg&oe=6A46680A"}, {"file_name": "migrated_image.png", "id": "220849252615079", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/12482153_1660003154294763_7332784551925645312_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xowsw6Y14IMQ7kNvwFgnGV2&_nc_oc=Adr0pkHiWILSiBE400vnH11u4hL-dCU3ysrFcSuW5EKMYBwvgpTQB-yEkCxMfGQyV7U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zwYNjoFSh9CtYxjgRo8IIQg77bhXqjgzKxqkHxktJCg&oe=6A466A1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trucker VR: 5 Games Arcade Bundle", "keywords": ["Arcade", "1978", "Racing", "Video", "Machine"], "long_description": "GAMEPAD SUPPORTED!\n\nMANCHESTER is a \u201cracing game\u201d, where you have to switch lanes in order to pass obstacles and avoid getting hit by rockets. \n\nReach the center of the WHEEL IN THE SKY! Jump from ring to ring in a retro adventure. You're just a green dot in the skies, but  that's all you need to be!\n\nFUNNY ARCHITECT: Try to build the biggest tower. The motto is: the biggest, not the highest... The higher you build the easier your tower will collapse.\n\nBe honest! WHERE DO YOU SEE YOURSELF IN 5 YEARS? Still stuck in the real world or absorbed by the virtual world everybody is bragging about? Play this fun game and find out in no time :)\n\nSCR3W DR1VER: A VR Pixel game. Run into the void. Collect the nuggets you need.", "short_description": "GAMEPAD SUPPORTED!\n\nMANCHESTER is a \u201cracing game\u201d, where you have to switch lanes in order to pass obstacles and avoid getting hit by rockets. \n\nFUNNY ARCHITECT: Try to build the biggest tower. The motto is: the biggest, not the highest... The higher you build the easier your tower will collapse.\n\nplus \n-WHERE DO YOU SEE YOURSELF IN 5 YEARS?\n-SCR3W DR1VER\nand WHEEL IN THE SKY"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truckervr.com/oculus-privacy-policy", "developer_terms_of_service_url": "http://www.truckervr.com/terms-of-service.html", "publisher_name": "Trucker VR", "support_website_url": null, "website_url": "http://truckervr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3177603905857479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974908_418337322076831_848310063058649088_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kX2JXt-PaqEQ7kNvwH6An7w&_nc_oc=Adri6optCZuJHoHXp5U85ILKHP0CryDGht8L-MySoSfD-Sdc--A7oSbDSsy1ifa9_Es&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jkGR5KW8k72iC5tgjHakMKNGzhmnT46sPOeDkoSWY0w&oe=6A46723E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trucker VR: 5 Games Arcade Bundle", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1471417200, "lastRevision": {"nodes": [{"id": "500930130111479", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "972238829539957", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": null, "iarc_email": null, "msrp": null, "translations": {"nodes
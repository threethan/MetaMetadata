OGts7PQ&oe=6AFC5E53"}, {"file_name": "migrated_image.png", "id": "499092124102199", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12427564_194172601081116_8631063808711852032_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbMK7AXSycYQ7kNvwEW2Ll9&_nc_oc=AdqoHGKxCFSOl_BAjjwBhlMEAwiYMzgMaHhm0Suomaqy0rbIaR-a5piTO3O84vHezAA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQswm-TDRc2hudy2-VnSp01Ro-3C8v1qcEy6-SRTjlQ7Q&oe=6AFC8F4A"}, {"file_name": "migrated_image.png", "id": "220849252615079", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12482153_1660003154294763_7332784551925645312_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9C0Fo0GMMHcQ7kNvwENDRjN&_nc_oc=AdoyT8WRqDZoc817R_Lg7xJhSbNoCqEVTy9voYP0KQ8lwYXa_mcOvmRuwTaB8HQ7eSE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuig-0LEB3RFCCghqazUfTYAhulR9fYgbBOOzN3mVFbw&oe=6AFC915E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Trucker VR: 5 Games Arcade Bundle", "keywords": ["Arcade", "1978", "Racing", "Video", "Machine"], "long_description": "GAMEPAD SUPPORTED!\n\nMANCHESTER is a \u201cracing game\u201d, where you have to switch lanes in order to pass obstacles and avoid getting hit by rockets. \n\nReach the center of the WHEEL IN THE SKY! Jump from ring to ring in a retro adventure. You're just a green dot in the skies, but  that's all you need to be!\n\nFUNNY ARCHITECT: Try to build the biggest tower. The motto is: the biggest, not the highest... The higher you build the easier your tower will collapse.\n\nBe honest! WHERE DO YOU SEE YOURSELF IN 5 YEARS? Still stuck in the real world or absorbed by the virtual world everybody is bragging about? Play this fun game and find out in no time :)\n\nSCR3W DR1VER: A VR Pixel game. Run into the void. Collect the nuggets you need.", "short_description": "GAMEPAD SUPPORTED!\n\nMANCHESTER is a \u201cracing game\u201d, where you have to switch lanes in order to pass obstacles and avoid getting hit by rockets. \n\nFUNNY ARCHITECT: Try to build the biggest tower. The motto is: the biggest, not the highest... The higher you build the easier your tower will collapse.\n\nplus \n-WHERE DO YOU SEE YOURSELF IN 5 YEARS?\n-SCR3W DR1VER\nand WHEEL IN THE SKY"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.truckervr.com/oculus-privacy-policy", "developer_terms_of_service_url": "http://www.truckervr.com/terms-of-service.html", "publisher_name": "Trucker VR", "support_website_url": null, "website_url": "http://truckervr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3177603905857479"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974908_418337322076831_848310063058649088_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crNZfMqRBrMQ7kNvwGDujwa&_nc_oc=AdoHpdzUgj8SY5N-jf8MVm5YfZmd40d4svP9Mp12J2djdglhhJmzRsFWgUncuKwuRpQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwUrvbToM6Fj2zKlad-kwyux9KYmqFhBgeSnGIfRveEQ&oe=6AFC613E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Trucker VR: 5 Games Arcade Bundle", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1471417200, "lastRevision": {"nodes": [{"id": "50093013011147
_nc_sid=6e7a0a&_nc_ohc=I3XOYSi4gQgQ7kNvwHfbP9-&_nc_oc=AdoTuNgEnbKMLHoSikQuZY6U2vdAsKoDF4rcN5mderjSZyTzFa8UZoe1RBik45MScSE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdhneR7RCfd8mqgDCzRfPK4bf1LQW5OFMVIVFLgmeQ4g&oe=6AFDC640"}, {"file_name": "5.png", "id": "112212904450979", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031398_112212907784312_4212202898455492627_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r3CqzM9zCb8Q7kNvwFBjxd2&_nc_oc=AdoBXCvvaIcYKyjItpiOhGMKzFph_wXS9c49ojAp0Q5blWfzS6PovhmbmxFPVdfAqaQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmYUkqhcM0z0Y28ezXHfmuG-PUntl9_fyd6UOMR9a1GA&oe=6AFDC841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab\u7533\u8acb\u7528_\u6a2a\u9577\u30ab\u30d0\u30fc_2560x1440.png", "id": "1033889684028928", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031504_1033889687362261_6037341758526645169_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZ6BQjuLWS8Q7kNvwG3_zP8&_nc_oc=Ado0YfHgOSNb6j9iA_3VQXBbbohv4IkFb6zzZTOEnz5fAPycK9mfXwYDGJoBCTcZv3I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkZs32xsOBmcohjaKsdH3jOhzPPM62QAgGroJrnUOqvw&oe=6AFDDDEA"}, "display_name": "TOKYO GAME SHOW VR 2021 ", "keywords": [], "long_description": "This is the official VR application of TOKYO GAME SHOW VR 2021.\n\nCelebrating the 25th anniversary of TOKYO GAME SHOW (TGS), the first virtual exhibition site in the history of TGS is now open!\nSet in \u201cGAME FLOAT\u201d floating in the distant ocean somewhere in the real world, enjoy 20 exhibitors spaces, 2 official stores, 3 special video contents, and a theater where you can watch the official TGS2021 ONLINE program on a large screen!\n\nIn the unique virtual venue where famous characters welcome you, you\u2019ll find a wealth of information about games, from the latest news to the history of TGS.\nMoreover, visitors can enjoy communicating with each other through voice chat, text message display, replaceable avatar T-shirt, and a channel function that allows you to go around with your friends.\n\nIn addition, if everyone collects the \u201cFragments of Crystal\u201d hidden in the venue, the power of connection among game fans will be united...!\n\nEvent dates: September 30th (Thur.) - October 3rd (Sun.), 2021", "short_description": "This is the official VR application of TOKYO GAME SHOW VR 2021.\n\nCelebrating the 25th anniversary of TOKYO GAME SHOW (TGS), the first virtual exhibition site in the history of TGS is now open!\nSet in \u201cGAME FLOAT\u201d floating in the distant ocean somewhere in the real world, enjoy 20 exhibitors spaces, 2 official stores, 3 special video contents, and a theater where you can watch the official TGS2021 ONLINE program on a large screen!\n\nEvent dates: September 30th (Thur.) - October 3rd (Sun.), 2021"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tgsvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "TOKYO GAME SHOW Studios", "support_website_url": null, "website_url": "https://tgsvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "SOCIAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "2043580522482932"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.ocu
_nc_sid=6e7a0a&_nc_ohc=7WalGsxjNVIQ7kNvwH-Y2G1&_nc_oc=Adrj8qcuW6wOwz6kMw3DNgmQJVw5EZAUQ_12Tuprjq5zXZOovAr9-y3_2gJunMeEmRQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3aMoIB8xA2W9vZHYceeolHU1bVsBjgOEjODDcs0o5bA&oe=6B09A3C0"}, {"file_name": "5.png", "id": "112212904450979", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031398_112212907784312_4212202898455492627_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FYGPOjVKJG0Q7kNvwEgu327&_nc_oc=Adr1WUOmVVPvc--ZFRJIaecjhHiTfwfapI1JINPjY0SNiyAXxh5INF3g_smsd_CegAE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTughk8-reg3GH8nlrANpO62U6DmFlGKYf5uRogkmJSWQ&oe=6B09A5C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AppLab\u7533\u8acb\u7528_\u6a2a\u9577\u30ab\u30d0\u30fc_2560x1440.png", "id": "1033889684028928", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031504_1033889687362261_6037341758526645169_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M836dVgzkREQ7kNvwEORzeH&_nc_oc=AdqjgOGpdSUCeAKDaCh7A9kkp8XzOze2nt5eLKOV-CIzFqtCq9GTbIvoHYFJVkNX7Ic&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuclbVNm8s9x2M5T3ySzzb9b-E9doPOFVX_wIV-tLqGQ&oe=6B09BB6A"}, "display_name": "TOKYO GAME SHOW VR 2021 ", "keywords": [], "long_description": "This is the official VR application of TOKYO GAME SHOW VR 2021.\n\nCelebrating the 25th anniversary of TOKYO GAME SHOW (TGS), the first virtual exhibition site in the history of TGS is now open!\nSet in \u201cGAME FLOAT\u201d floating in the distant ocean somewhere in the real world, enjoy 20 exhibitors spaces, 2 official stores, 3 special video contents, and a theater where you can watch the official TGS2021 ONLINE program on a large screen!\n\nIn the unique virtual venue where famous characters welcome you, you\u2019ll find a wealth of information about games, from the latest news to the history of TGS.\nMoreover, visitors can enjoy communicating with each other through voice chat, text message display, replaceable avatar T-shirt, and a channel function that allows you to go around with your friends.\n\nIn addition, if everyone collects the \u201cFragments of Crystal\u201d hidden in the venue, the power of connection among game fans will be united...!\n\nEvent dates: September 30th (Thur.) - October 3rd (Sun.), 2021", "short_description": "This is the official VR application of TOKYO GAME SHOW VR 2021.\n\nCelebrating the 25th anniversary of TOKYO GAME SHOW (TGS), the first virtual exhibition site in the history of TGS is now open!\nSet in \u201cGAME FLOAT\u201d floating in the distant ocean somewhere in the real world, enjoy 20 exhibitors spaces, 2 official stores, 3 special video contents, and a theater where you can watch the official TGS2021 ONLINE program on a large screen!\n\nEvent dates: September 30th (Thur.) - October 3rd (Sun.), 2021"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tgsvr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "TOKYO GAME SHOW Studios", "support_website_url": null, "website_url": "https://tgsvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2687655338230691"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL", "SOCIAL", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "2043580522482932"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.ocu
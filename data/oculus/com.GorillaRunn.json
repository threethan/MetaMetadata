.com&_nc_ss=7f20f&oh=00_AQHU4XRdoh6lkOjKe7lwaGZ18u-hsJiyku3E0q4Ch12G3Q&oe=6A85925A"}, {"file_name": "Screenshot5.png", "id": "1323500028967345", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473396949_1323500035634011_7600368965164864374_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrQ0OJx-P48Q7kNvwGv23tY&_nc_oc=Ado7d2DIhanlJXSvvYywnLgbQ8hh3a0MxAQ0ynqPiUb6SCFXEnp--cXbNjw0tphAAXg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5wpsXXoHhowTwFs9gXJ4VbW_uHQszqLquL34tp0C8MA&oe=6A85A25F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Runn V2", "keywords": [], "long_description": "\"Gorilla Runn\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Gorilla Runn is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns.", "short_description": "Gorilla Runn, A Gorilla Tag inspried game using their locomotion"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/16WsAw-yKI1nQP1p_LVZygmGED_Z5IDR9OwfI_TL0Ob4", "developer_terms_of_service_url": null, "publisher_name": "Gorilla Runn", "support_website_url": null, "website_url": "https://html.cafe/xf99e4aa4", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_g
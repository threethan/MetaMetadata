ntrol, and immersion\n\n\ud83d\udc7d Will you detect them before it\u2019s too late?\nPut your instincts to the test in Find the Alien VR, where the fate of the world lies in your hands.", "short_description": "Scan, identify hidden aliens, and protect Earth in this thrilling VR shooter."}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30635236179424520"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828806_1033406238643831_5417655433906840609_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USjuu49TdH0Q7kNvwHQMLsm&_nc_oc=AdqtC_IWVScylADKiyeVKMiX4odgTx03ZhKF_TZ6elCoVyPkqmq6UbhnXFgCQ2-R1zk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi0k0_Jbcr3MRQkamtPlZkfnRj2QJUvmDnDAMoR6SGdw&oe=6A858056"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Find the Alien VR: Impostor Hunt", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topi
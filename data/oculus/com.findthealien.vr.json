vPX2smtz0oYMXPiW7p9r0yqQP0Y5eW7G9g6Q7s9EwA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjrxlVPnpUhTxx4Njh-QAAH-T9i1P1_I-X50HvhOvVpQ&oe=6A9FF94E"}, {"file_name": "2.png", "id": "3240546932753376", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499303386_3240546936086709_5019902105616277654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8HxsJbdNp4Q7kNvwFzA--V&_nc_oc=AdoPHGnf-SUITX6PB2XAOhubvzc5utxLbllmFybVNCgHWRYTs8KsKD7W-1GIYguZ8z0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1qbwyuSGAY73ZZwcdtnDgutShEiFWFGzUCkHkSc4Ghg&oe=6AA00ADA"}, {"file_name": "5.png", "id": "760110330512171", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305027_760110333845504_5173357598611347206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OooEi0woCQcQ7kNvwHxyFSz&_nc_oc=AdotC7cbfrDgn2B64YSCuHPsK9nwiBn_Ob_XJy2b1qg5dIk23dk7-fzrxazGU_ZbJDY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlOsxla5TU3Wv5hUb2ONaLvSgwSu9_MPEeFbUVAYRPjQ&oe=6AA02CD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Find the Alien VR: Impostor Hunt", "keywords": ["impostor", "find", "hunt", "alien", "findthealien"], "long_description": "Become Earth's last line of defense in Find the Alien VR!\nStep into a fully immersive virtual reality experience where nothing is what it seems. Use advanced alien-detection tech to scan suspicious beings, uncover impostors, and neutralize threats before it\u2019s too late.\n\n\ud83e\uddec Game Features:\n\n\ud83d\udd0e Alien Scanner \u2013 Use your VR scanner to detect disguised aliens in real-time\n\n\ud83c\udfaf Action Shooter Gameplay \u2013 Eliminate hostile invaders in smooth, intuitive VR combat\n\n\ud83e\udde0 Memory & Reflex Challenges \u2013 Don\u2019t trust your eyes; trust your scanner\n\n\ud83d\udcc8 Progressive Difficulty \u2013 Uncover deeper threats as you level up\n\n\ud83c\udfae Designed for Meta Quest \u2013 Optimized for comfort, control, and immersion\n\n\ud83d\udc7d Will you detect them before it\u2019s too late?\nPut your instincts to the test in Find the Alien VR, where the fate of the world lies in your hands.", "short_description": "Scan, identify hidden aliens, and protect Earth in this thrilling VR shooter."}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30635236179424520"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491828806_1033406238643831_5417655433906840609_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xT3NT8OhzoQ7kNvwGeeG5d&_nc_oc=Adp9aQTxClPIe6t6loLpWPH8RrNB78J3lgR0ZOkxTo7txKOtsK_lbOieZBq6jRsd0AQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzwZ3J3OEckdfFFcNd6e4C1YXJTa4TQlEYwL4u2x45ng&oe=6AA01696"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Find the Alien VR: Impostor Hunt", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topi
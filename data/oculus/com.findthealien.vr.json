4.5771-25/507828589_760913723589554_3926262875942970910_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhStyXRZXzcQ7kNvwGKsGlC&_nc_oc=AdqgnFj8TIFcMDXAkWpxPM8Zuwm6hH0OeEo41VMC6nsuwmpEf8sgjtbpzlTIyiN8nlg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvAK9Al68fQa-5IXgpq8T8Znwg9mVbQSi0MyajkuBhqA&oe=6ACA618E"}, {"file_name": "2.png", "id": "3240546932753376", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303386_3240546936086709_5019902105616277654_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szil1yaVvOcQ7kNvwE1KVUC&_nc_oc=Adp90eaouJToqU2rTT3wCZ8z_zNJ86gLIusrBjMxHLxQmVUqNcbP1AKU0_fQ1h1sVbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFwFoOKhyUkv4W9vJTdD6apYbgkecgU-Lx3ZA5pTy6Qg&oe=6ACA731A"}, {"file_name": "5.png", "id": "760110330512171", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499305027_760110333845504_5173357598611347206_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SI8KsL02-m4Q7kNvwFRNXCg&_nc_oc=AdpviSekLYYtCAJzQ4je4wBC1SapnepQNlugwQa3KG7Zv0tst4g4W7JH1xp6YLIhwQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7_lGj73cbl4VmbchtS8IaddrKuEcVQFYeIntxs3_6hg&oe=6ACA5CD2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Find the Alien VR: Impostor Hunt", "keywords": ["impostor", "find", "hunt", "alien", "findthealien"], "long_description": "Become Earth's last line of defense in Find the Alien VR!\nStep into a fully immersive virtual reality experience where nothing is what it seems. Use advanced alien-detection tech to scan suspicious beings, uncover impostors, and neutralize threats before it\u2019s too late.\n\n\ud83e\uddec Game Features:\n\n\ud83d\udd0e Alien Scanner \u2013 Use your VR scanner to detect disguised aliens in real-time\n\n\ud83c\udfaf Action Shooter Gameplay \u2013 Eliminate hostile invaders in smooth, intuitive VR combat\n\n\ud83e\udde0 Memory & Reflex Challenges \u2013 Don\u2019t trust your eyes; trust your scanner\n\n\ud83d\udcc8 Progressive Difficulty \u2013 Uncover deeper threats as you level up\n\n\ud83c\udfae Designed for Meta Quest \u2013 Optimized for comfort, control, and immersion\n\n\ud83d\udc7d Will you detect them before it\u2019s too late?\nPut your instincts to the test in Find the Alien VR, where the fate of the world lies in your hands.", "short_description": "Scan, identify hidden aliens, and protect Earth in this thrilling VR shooter."}]}, "developer_name": "Devtitanx", "developer_privacy_policy_url": "https://sites.google.com/view/devtitanx/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Devtitanx", "support_website_url": null, "website_url": "https://sites.google.com/view/devtitanx/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30635236179424520"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "731779166226624"}]}, "baseline_offer": {"id": "731779166226624"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754059080, "status": "PUBLISHED", "id": "731779166226624"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30638499419098196", "version": "1"}, "id": "707126722136562", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"
AdqF9KJ0OIO2kbThb-daD75Qv1H5fnvn7CuEkWZnHU0fFJwjSDFQ_ICnKm6dk5KQh4g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw8lvFIHvMdiqxwcVFBdtcq1A8Snyepsh068C6w7QHPQ&oe=6A68B637"}, {"file_name": "15.png", "id": "2400478383797607", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618277_2400478387130940_3378653507715409985_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FD-xKGdjzKEQ7kNvwEPxdtY&_nc_oc=AdrHrtgfcspNQIb2uK_HPRKhOanHqIL6cR7jsQjFrDoYcZV0Zc41LGzIvKRufZsUMZY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLx5q2F9cilUAjxSJe39N0FzPp0undEyBjEwX54unu8Q&oe=6A68A4DC"}, {"file_name": "26.png", "id": "936621145967432", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618064_936621149300765_3804787563474885841_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T86q0BgaD7cQ7kNvwH1UcFz&_nc_oc=Adr6MTCGumaI-B_NbJKDP3WNoQ6uzZOfvpoXml8SV1mJyB8ehejCxgVVI_zMHv_shD8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIb5PdCaYZA1rbBjQVM3Y03Mf-fd9F_hnmRoGfG4l6rg&oe=6A68A610"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blue", "keywords": ["Bollywood", "VRAdventure", "VRUnderwater", "ActionGame", "VREntertainment"], "long_description": "Built by Shemaroo Entertainment, one of India\u2019s largest media and entertainment companies, Blue: The VR Adventure immerses you in a gripping single-player underwater journey inspired by the Bollywood hit Blue.\nYou begin on a quiet beach, but a mysterious phone call shatters the calm: your brother\u2019s life is at stake, and the only way to save him is to recover a legendary treasure hidden in the sunken ship Lady Blue.\nYour journey unfolds in stages of escalating peril:\n- Find and navigate your boat through dangerous waters filled with obstacles.\n- Scuba dive into the deep ocean, where sharks and hostile creatures lurk.\n- Solve intricate puzzles to progress, escape nets, and manage your oxygen supply.\n- Level up and discover oxygen cylinders to survive longer in the abyss.\n- Face the colossal octopus guarding the treasure and defeat it in an epic battle.\n- Unlock the treasure chest aboard Lady Blue and bring your prize back to the surface.\n- Survive a final showdown against ruthless bandits who will stop at nothing to steal your treasure.\nEvery step tests your courage, skill, and survival instincts. From breathtaking underwater visuals to adrenaline-pumping combat and puzzle-solving, Blue: The VR Adventure delivers a cinematic, high-stakes experience where your choices determine whether you escape with the treasure\u2014or lose everything.\nYour brother\u2019s fate lies in your hands. Will you conquer the ocean\u2019s secrets and outwit its dangers?\n", "short_description": "Dive into the depths of danger in Blue: The VR Adventure, inspired by the Bollywood blockbuster. Navigate treacherous waters, battle sharks and sea creatures, solve puzzles, and confront a giant octopus in your quest to retrieve the treasure of the sunken ship Lady Blue\u2014all to save your brother\u2019s life.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shemarooverse.com/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ShemarooVerse Digital limited", "support_website_url": "https://www.shemarooverse.com/", "website_url": "https://www.shemarooverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35483887067869359"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619518_1271755231644399_6077781472465590114_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIEXhST6n2kQ7kNvwFx7Nkl&_nc_oc=AdqNqfzaNIamDz9lFS_vc8ZDA2gLvrrd1w60QK6HmatpHm7PV2VHAPE5wApMDSmmITc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeyXSDUbivBg6Ng3grnOf2x7gIGWf131xHiaNoLhvnzg&oe=6A68B47A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Blue", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}], "release_date": 1775223000, "lastRevision": {"nodes": [{"id": "35483887127869353", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "35483887024536030", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1636649254319654"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "poste1440x1008r.png", "id": "1271755228311066", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619518_1271755231644399_6077781472465590114_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eIEXhST6n2kQ7kNvwFx7Nkl&_nc_oc=AdqNqfzaNIamDz9lFS_vc8ZDA2gLvrrd1w60QK6HmatpHm7PV2VHAPE5wApMDSmmITc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcATnRPmGKr_Kab91mTH7NTtVmKt7hXovydsCqYoZjHw&oe=6A68B47A"}
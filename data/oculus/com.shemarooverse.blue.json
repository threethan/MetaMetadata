c_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIb5PdCaYZA1rbBjQVM3Y03Mf-fd9F_hnmRoGfG4l6rg&oe=6A68A610"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Blue", "keywords": ["Bollywood", "VRAdventure", "VRUnderwater", "ActionGame", "VREntertainment"], "long_description": "Built by Shemaroo Entertainment, one of India\u2019s largest media and entertainment companies, Blue: The VR Adventure immerses you in a gripping single-player underwater journey inspired by the Bollywood hit Blue.\nYou begin on a quiet beach, but a mysterious phone call shatters the calm: your brother\u2019s life is at stake, and the only way to save him is to recover a legendary treasure hidden in the sunken ship Lady Blue.\nYour journey unfolds in stages of escalating peril:\n- Find and navigate your boat through dangerous waters filled with obstacles.\n- Scuba dive into the deep ocean, where sharks and hostile creatures lurk.\n- Solve intricate puzzles to progress, escape nets, and manage your oxygen supply.\n- Level up and discover oxygen cylinders to survive longer in the abyss.\n- Face the colossal octopus guarding the treasure and defeat it in an epic battle.\n- Unlock the treasure chest aboard Lady Blue and bring your prize back to the surface.\n- Survive a final showdown against ruthless bandits who will stop at nothing to steal your treasure.\nEvery step tests your courage, skill, and survival instincts. From breathtaking underwater visuals to adrenaline-pumping combat and puzzle-solving, Blue: The VR Adventure delivers a cinematic, high-stakes experience where your choices determine whether you escape with the treasure\u2014or lose everything.\nYour brother\u2019s fate lies in your hands. Will you conquer the ocean\u2019s secrets and outwit its dangers?\n", "short_description": "Dive into the depths of danger in Blue: The VR Adventure, inspired by the Bollywood blockbuster. Navigate treacherous waters, battle sharks and sea creatures, solve puzzles, and confront a giant octopus in your quest to retrieve the treasure of the sunken ship Lady Blue\u2014all to save your brother\u2019s life.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.shemarooverse.com/en/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ShemarooVerse Digital limited", "support_website_url": "https://www.shemarooverse.com/", "website_url": "https://www.shemarooverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35483887067869359"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3178985482490560"}]}, "baseline_offer": {"id": "3178985482490560"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775223000, "status": "PUBLISHED", "id": "3178985482490560"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35483908727867193", "version": "1.0"}, "id": "2145445582943284", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35483887024536030", "is_concept": false, "latest_released_binary": {"__typena
c0f \uc218\ud589 \uae30\ub85d \uc11c\ubc84 \uc800\uc7a5 \n*  \ubc18\ubcf5 \ud559\uc2b5\uc744 \ud1b5\ud55c \uc2e4\ubb34 \uc5ed\ub7c9 \ud5a5\uc0c1 \n\n\ubcf8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc740 \uac04\ud638 \uad50\uc721\uae30\uad00 \ubc0f \uad50\uc721 \ud504\ub85c\uadf8\ub7a8 \ucc38\uc5ec\uc790\ub97c \uc704\ud55c VR \uad50\uc721\uc6a9 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc774\uba70, \uc9c0\uc815\ub41c \uacc4\uc815\uc744 \ud1b5\ud574 \ubaa8\ubc14\uc77c \uc571\uacfc \uc5f0\uacc4\ud558\uc5ec \ub85c\uadf8\uc778\ud558\uc5ec \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.  ", "short_description": "VR \uac04\ud638 \uc2e4\uc2b5\uc744 \uc218\ud589\ud558\uace0, \ud3c9\uac00 \uacb0\uacfc\ub97c \uae30\ub85d\ud558\uc5ec \ubc18\ubcf5 \ud559\uc2b5\uc744 \uc9c0\uc6d0\ud558\ub294 \uac04\ud638 \uad50\uc721 \uc560\ud50c\ub9ac\ucf00\uc774\uc158 \uc785\ub2c8\ub2e4.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.siliconhammer.com/privacy-policy/?q=YToxOntzOjEyOiJrZXl3b3JkX3R5cGUiO3M6MzoiYWxsIjt9&bmode=view&idx=172442433&t=board", "developer_terms_of_service_url": null, "publisher_name": "Silicon Hammer", "support_website_url": null, "website_url": "https://withcare.io.kr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ko"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1120300561177104"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "172189417
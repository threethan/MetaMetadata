f72.png", "id": "2125849201703885", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499299139_2125849205037218_3568006002706282507_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7UXTKMZQgMQ7kNvwGbaxaK&_nc_oc=AdrjkVQveO5Pzkhh4EM43tWiDaxrGz4K1vdJcIoyhS9LzAiLh9rI2FICtJezcYYRDW0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTRLWr4aiKK4ONW7OAGuSrNJQ7vgXbdZpPND0qzCUe0w&oe=6A6B5E14"}, {"file_name": "\uc2a4\ud06c\ub9b0\uc0f73.png", "id": "1213460947520924", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_1213460950854257_5523405811804085144_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDI77AaZJjsQ7kNvwF0i8q_&_nc_oc=AdoBzwfbUO1fwrUHkZPIm22SLPZAan161kwRXcC1X1O_y5Ba8DB3dqzpeOwRW_P1ApA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFpSY1599IT9mz4PJ-_Ou7aGyCCiIypCs3ga3Fu0Wyfw&oe=6A6B5139"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Withcare", "keywords": ["\uac04\ud638", "\uac10\uc5fc\ubcd1", "\uad50\uc721", "\uccb4\ud5d8\ud615\ud559\uc2b5"], "long_description": "\uc790\uc138\ud55c \uc124\uba85\n\nVR \ud658\uacbd\uc5d0\uc11c \uac04\ud638 \uc2e4\uc2b5\uc744 \uc218\ud589\ud558\uace0 \uac1d\uad00\uc801\uc778 \ud3c9\uac00\ub97c \ud1b5\ud574 \ubc18\ubcf5 \ud559\uc2b5\uc744 \uc9c0\uc6d0\ud558\ub294 \uac04\ud638 \uad50\uc721 \uc560\ud50c\ub9ac\ucf00\uc774\uc158 \uc785\ub2c8\ub2e4. \n\n\uc0ac\uc6a9\uc790\ub294 \uad50\uc721\uae30\uad00\uc5d0\uc11c \uc81c\uacf5\ud558\ub294 \uc2e4\uc2b5 \uc2dc\ub098\ub9ac\uc624\ub098, \uc0ac\uc6a9\uc790 \ubcf8\uc778\uc774 \ub9cc\ub4e0 \uc2dc\ub098\ub9ac\uc624\ub97c \uc120\ud0dd\ud558\uc5ec \uc2e4\uc81c \uac04\ud638 \uc808\ucc28\ub97c VR \ud658\uacbd\uc5d0\uc11c \uc218\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \n\n\uc2e4\uc2b5 \uacfc\uc815\uc740 \uc2dc\uc2a4\ud15c\uc758 \ud3c9\uac00 \ub85c\uc9c1\uc744 \ud1b5\ud574 \uc790\ub3d9\uc73c\ub85c \ubd84\uc11d\ub418\uba70, \ud3c9\uac00 \uacb0\uacfc\uc640 \uc218\ud589 \uae30\ub85d\uc740 \uc11c\ubc84\uc5d0 \uc800\uc7a5\ub418\uc5b4 \ud559\uc2b5 \uc131\uacfc\ub97c \ud655\uc778\ud558\uace0 \uc9c0\uc18d\uc801\uc778 \uc5ed\ub7c9 \ud5a5\uc0c1\uc5d0 \ud65c\uc6a9\ub429\ub2c8\ub2e4. \n\n\ubc18\ubcf5\uc801\uc778 \uc2e4\uc2b5\uacfc \ud53c\ub4dc\ubc31\uc744 \ud1b5\ud574 \uac04\ud638 \uc808\ucc28\ub97c \uc219\ub2ec\ud558\uace0 \uc2e4\ubb34 \ub2a5\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0ac \uc218 \uc788\ub3c4\ub85d \uc124\uacc4\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \n\n\uc8fc\uc694 \uae30\ub2a5 \n\n*  \uad50\uc721\uae30\uad00 \ubc0f \ubcf8\uc778\uc774 \uc0dd\uc131\ud55c \uac04\ud638 \uc2dc\ub098\ub9ac\uc624\ub97c \ud1b5\ud55c \uc2e4\uc2b5 \uc218\ud589\n*  \ubab0\uc785\uac10 \uc788\ub294 VR \uae30\ubc18 \uac04\ud638 \uad50\uc721 \ud658\uacbd\n*  \uc2e4\uc2b5 \uacfc\uc815 \uc790\ub3d9 \ud3c9\uac00  \n*  \ud3c9\uac00 \uacb0\uacfc \ubc0f \uc218\ud589 \uae30\ub85d \uc11c\ubc84 \uc800\uc7a5 \n*  \ubc18\ubcf5 \ud559\uc2b5\uc744 \ud1b5\ud55c \uc2e4\ubb34 \uc5ed\ub7c9 \ud5a5\uc0c1 \n\n\ubcf8 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc740 \uac04\ud638 \uad50\uc721\uae30\uad00 \ubc0f \uad50\uc721 \ud504\ub85c\uadf8\ub7a8 \ucc38\uc5ec\uc790\ub97c \uc704\ud55c VR \uad50\uc721\uc6a9 \uc560\ud50c\ub9ac\ucf00\uc774\uc158\uc774\uba70, \uc9c0\uc815\ub41c \uacc4\uc815\uc744 \ud1b5\ud574 \ubaa8\ubc14\uc77c \uc571\uacfc \uc5f0\uacc4\ud558\uc5ec \ub85c\uadf8\uc778\ud558\uc5ec \uc774\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.  ", "short_description": "VR \uac04\ud638 \uc2e4\uc2b5\uc744 \uc218\ud589\ud558\uace0, \ud3c9\uac00 \uacb0\uacfc\ub97c \uae30\ub85d\ud558\uc5ec \ubc18\ubcf5 \ud559\uc2b5\uc744 \uc9c0\uc6d0\ud558\ub294 \uac04\ud638 \uad50\uc721 \uc560\ud50c\ub9ac\ucf00\uc774\uc158 \uc785\ub2c8\ub2e4.  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.siliconhammer.com/privacy-policy/?q=YToxOntzOjEyOiJrZXl3b3JkX3R5cGUiO3M6MzoiYWxsIjt9&bmode=view&idx=172442433&t=board", "developer_terms_of_service_url": null, "publisher_name": "Silicon Hammer", "support_website_url": null, "website_url"
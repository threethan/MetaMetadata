uscdn.com/v/t64.5771-25/491820441_1207715031441435_3533139623398145378_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6j_ZOCwwgCwQ7kNvwHZKlP7&_nc_oc=AdrKfr5YGtb0ItU4UBf_UgkQDzH17abFnkCMgjbTrY75cr-YCCNTbtIv55E4p4TbRa0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1v1AkzHY_4S2Ptbw9KFqq3aUPLSGkfxA6DLwA8dQ4laA&oe=69D65D07"}, {"file_name": "com.casinovr.casinovrpoker-20260317-210310.png", "id": "2100607690500721", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821719_2100607693834054_1503705560958311482_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKlINC_HGVsQ7kNvwFMgiUD&_nc_oc=AdrmDwjSDrKK8mpgtZiMoQML8M69HVBL24To7Z9RhAewYubT7sIwe8omqtL2F-8wqUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32AEUdDXzkb7PRBL5yd5Jqxv9pO55Rfqq8muVVHZmQ8A&oe=69D64A76"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PokerVR_BlackJackThumbnail_v17.png", "id": "932296965869845", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824307_932296969203178_4450986488045713076_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0hV9ail_LUQ7kNvwGwJHks&_nc_oc=Adq0YUpP68Np2j2KmhWhEk6RoOIrwPaO-AuXK-de43Q65M_pnN_ko6r4i___YUh2oyk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q9e-OVzixyrjF6HIuyl_GE6EnTx41kaii1a_1JgF7Hw&oe=69D654CC"}, "display_name": "POKER VR w/ Blackjack!", "keywords": ["poker", "social", "free", "casino", "blackjack"], "long_description": "Pure, simple poker and blackjack in dynamic casinos. It's the most intuitive and real life like poker and blackjack experience in VR! Poker VR features multi table tournaments and cash games. Host your own table, customize everything from looks to its identity and everything in between. \n{2977794699085035}\n# Play poker like in real life, with both controllers and hand tracking\n{1106167781546790}\n# Play Multi Table Tournaments in Huge Casinos\n{2619021768484963}\n# Make your own table, show off to your friends \n{771172055665313}\n# Be who you wanna be, there are 1000s of cosmetics to unlock\n{1437460743988429}\n# Tables exist in the central Poker VR world", "short_description": "Pure, simple poker and blackjack in completely dynamic casino. Poker VR features multi table tournaments and cash games. It's the most intuitive and real life like poker and blackjack experience in VR! Host your own table, customize everything from looks to its identity. Play solo or take part in team events where every weekend 4 teams compete against each other for a different objective. "}]}, "developer_name": "Mega Particle, Inc.", "developer_privacy_policy_url": "https://www.poker-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.poker-vr.com/terms-of-service", "publisher_name": "Mega Particle, Inc.", "support_website_url": "https://www.discord.gg/pokervr", "website_url": "https://www.poker-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "1700921480735423"}, {"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "SOCIAL", "RELAXATION_MEDITATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26274730952146431"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821099_764195749841896_7364044045958480970_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xW860UNEqTMQ7kNvwFSPeTV&_nc_oc=Adp4jiDjLNCZPVtoN0we-A9p4vfDi2ILP5z6Rzhou4V7oFzI-i
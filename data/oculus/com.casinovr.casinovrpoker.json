/t64.5771-25/499311606_1444244017642388_5977836700852449973_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTmv_JymGgMQ7kNvwHVVTCH&_nc_oc=AdqJx7SUb-sAVPq7DG9IV14G7TrwCBkWCVP8azrbN0Goaigx41Eekj2_ftfhNi6nxAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnByasEaj5ZA-IpdV0ky_dtCdD77fkRrJMj5E8SENBxQ&oe=6AE0B57C"}, "display_name": "POKER VR w/ Roulette, Blackjack & Slots", "keywords": ["poker", "free", "casino", "blackjack", "slots"], "long_description": "Pure, simple poker, blackjack , slots and now ROULETTE in completely dynamic casino. It's the most intuitive and real life like casino experience in VR! Poker VR features multi table tournaments and cash games. Host your own table, customize everything from looks to its identity and everything in between. \n{1660526135058298}\n# Play casino games like in real life, with both controllers and hand tracking\n{1106167781546790}\n# Play Multi Table Tournaments in Huge Casinos\n{1501280231118886}\n# Make your own table, show off to your friends \n{771172055665313}\n# Be who you wanna be, there are 1000s of cosmetics to unlock\n{1437460743988429}\n# Tables exist in the central Poker VR world\n\n", "short_description": "Pure, simple poker, blackjack , slots and now ROULETTE in completely dynamic casino. Poker VR features multi table tournaments and cash games. It's the most intuitive and real life like poker, blackjack and slots experience in VR! Host your own table, customize everything from looks to its identity. Play solo take part in daily challenges with the whole community!"}]}, "developer_name": "Mega Particle, Inc.", "developer_privacy_policy_url": "https://www.poker-vr.com/privacy-policy", "developer_terms_of_service_url": "https://www.poker-vr.com/terms-of-service", "publisher_name": "Mega Particle, Inc.", "support_website_url": "https://www.discord.gg/pokervr", "website_url": "https://www.poker-vr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context
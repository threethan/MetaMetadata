1_1207715031441435_3533139623398145378_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jD9cICU37UMQ7kNvwGH-B-_&_nc_oc=Adq1rXkV8CbyyGUwncaUtcOHPPpR1USs7m0gUB36OVV7_7_Nk3U-eJj8JukPYHviuhw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zoCQCGneXt0oQ-B1kdU1NbbOqxn1D7QUOeSDNXzYZ4A&oe=6A22D407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "2052378659036388", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499304952_2052378662369721_7757755346259408624_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_BM9yY-7jcAQ7kNvwELKHXj&_nc_oc=AdpwqCgh8XO8dfN-gbooh8WTRKlD9yO70UkmKQV9qfRfizrJ8Rom9X96ZVEJ7rSE75U&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89wmXreRrmGbUNJ1QakRPPhzy4tWc2SlMhyJEzpqMJIQ&oe=6A22CD57"}, "display_name": "POKER VR w/ Slots and Blackjack!", "keywords": ["poker", "free", "casino", "blackjack", "slots"], "long_description": "Pure, simple poker and blackjack in dynamic casinos. It's the most intuitive and real life like poker and blackjack experience in VR! Poker VR features multi table tournaments and cash games. Host your own table, customize everything from looks to its identity and everything in between. \n{2977794699085035}\n# Play poker like in real life, with both controllers and hand tracking\n{1106167781546790}\n# Play Multi Table Tournaments in Huge Casinos\n{2619021768484963}\n# Make your own table, show off to your friends \n{771172055665313}\n# Be who you wanna be, there are 1000s of cosmetics to unlock\n{1437460743988429}\n# Tables exist in the central Poker VR world", "short_description": "Pure, simple poker and blackjack in completely dynamic casino. Poker VR features multi table tournaments and cash games. It's the most intuitive and real life like poker and blackjack experience in VR! Host your own table, customize everything from looks to its identity. Play solo or take part in team events where every weekend 4 teams com
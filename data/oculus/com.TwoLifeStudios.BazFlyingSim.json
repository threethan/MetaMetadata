-lga3-1.oculuscdn.com/v/t64.5771-25/499619485_1023235017091946_896754929132142963_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SdBMeX-4AoQ7kNvwHiD3jg&_nc_oc=Adqar8k-l0A3eUveN3Ufw_9JOV2eX4HNNGv4-e3EQ7zJh2IVpA4TmFXwkVmNuZlI38E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMtJTAvQ3pLTSUEBDEq2gRrPaqDruObrudjcITcFm3Pg&oe=6AFB1574"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BazFlyingSimLandscape.png", "id": "1076508848422176", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620497_1076508851755509_1889535716678257135_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jLfHXc04pAQ7kNvwHCBQGt&_nc_oc=AdoLl_YVRfm37QwZzSrQ0bZUFAbobR5RQzNDJovu6CTFyy9mVVprBz4Y_AiDyM5ln3s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIv3x2-TkFTLFy7OOv-HVogjstOscobmqthXTXs--SxQ&oe=6AFB2288"}, "display_name": "Baz Flying Sim", "keywords": ["fly", "hero", "speed", "power", "flight"], "long_description": "Hello I am Baz and this is my flying sim. This is a game where you can go **really** fast with no physics constraints. You can learn how to do barrel rolls, backflips, frontflips, and more. \n\nAt first you'll probably fly like a drunk superhero, but once you get the hang of it you'll be weaving between buildings and taking the riskiest paths.\n{2021849055872870}\n# There are several gamemodes available\nYou can fly in an infinite procedurally generated city, you can fly with random people in multiplayer, and you can even fly around the Earth.\n\n\n{27426045023730544}\nThis is me flying in New York City using Googles Photorealistic 3D Tiles, but you can enter your own coordinates and fly anywhere in the world.\n\n# But wait, theres more\nThere's destruction physics for every building. Fly too fast? Have fun going through 12 buildings.\n\n{1526962579125192}\n# Take revenge on the buildings\nYou have an arsenal of tools to help you, including this cool laser\n\n{864954782959611}\n\nThere's also like different powers and abilities and weapons, but yeah this is just the main stuff. That's all", "short_description": "Realistic hand propulsion flying simulator. Fly in an infinite city or through 3D scans of the Earth"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/two-life-studios/home", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://sites.google.com/view/two-life-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1272315199290886"}}]}, "scheduled_offers": {"count": 5, "nodes": [{"status": "PUBLISHED", "id": "1849759833124373"}, {"status": "PUBLISHED", "id": "1004731589289148"}, {"status": "PUBLISHED", "id": "1470775498253020"}, {"status": "PUBLISHED", "id": "3901695186803722"}, {"status": "PUBLISHED", "id": "971004352655650"}]}, "baseline_offer": {"id": "971004352655650"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793646000, "status": "PUBLISHED", "id": "1849759833124373"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1295213040334435", "version": "10"}, "id": "1000808972740183", "channel_name": "LIVE
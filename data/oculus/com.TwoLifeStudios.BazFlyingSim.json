0f&oh=00_AQGcQvO3y_CvfDiVtynGpcCUukkd8DtytVV9TFj0nWfS3Q&oe=6A9013B4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BazFlyingSimLandscape.png", "id": "1076508848422176", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620497_1076508851755509_1889535716678257135_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0qFE3oVTB0UQ7kNvwF0vcpq&_nc_oc=AdqvUa8qM4lBCcc0iHSb6hWmOZTX0PgiPQ4ZiY5YiAjD7Cs1FX0ZfIjPXu0tSJYGXZA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzPempcqPF75CEoThGPQmhBjd8vV5xSlYZrtQ6kSR_Ww&oe=6A9020C8"}, "display_name": "Baz Flying Sim", "keywords": ["fly", "hero", "speed", "power", "flight"], "long_description": "Hello I am Baz and this is my flying sim. This is a game where you can go **really** fast with no physics constraints. You can learn how to do barrel rolls, backflips, frontflips, and more. \n\nAt first you'll probably fly like a drunk superhero, but once you get the hang of it you'll be weaving between buildings and taking the riskiest paths.\n{2021849055872870}\n# There are several gamemodes available\nYou can fly in an infinite procedurally generated city, you can fly with random people in multiplayer, and you can even fly around the Earth.\n\n\n{27426045023730544}\nThis is me flying in New York City using Googles Photorealistic 3D Tiles, but you can enter your own coordinates and fly anywhere in the world.\n\n# But wait, theres more\nThere's destruction physics for every building. Fly too fast? Have fun going through 12 buildings.\n\n{1526962579125192}\n# Take revenge on the buildings\nYou have an arsenal of tools to help you, including this cool laser\n\n{864954782959611}\n\nThere's also like different powers and abilities and weapons, but yeah this is just the main stuff. That's all", "short_description": "Realistic hand propulsion flying simulator. Fly in an infinite city or through 3D scans of the Earth"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/two-life-studios/home", "developer_terms_of_service_url": null, "publisher_name": "Desmond Lorenzini", "support_website_url": null, "website_url": "https://sites.google.com/view/two-life-studios/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "1272315199290886"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1470775498253020"}, {"status": "PUBLISHED", "id": "3901695186803722"}, {"status": "PUBLISHED", "id": "971004352655650"}]}, "baseline_offer": {"id": "971004352655650"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1470775498253020"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1295213040334435", "version": "10"}, "id": "1000808972740183", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1272315192624220", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1295213040334435"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1000808972740183"}
nt-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-t8oH-AR0l3o0uMgGqCIcxc4LvyUvPUrr6kA6m98gSgQ&oe=6A242147"}, {"file_name": "migrated_image.png", "id": "2660998714027120", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974583_1037883043078509_6488434620512600064_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oVxvaSyuTGEQ7kNvwEKSo7f&_nc_oc=AdraaTSHe8VFm7Hlp0iRSz4dcqq7bt37dBxSmoktnJR0XeLJQadGjeBio1oAg0gtMtM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LASe4UyxZjk7dUZN3JGo6Vf11bpXnzn2R3h6dRti8eg&oe=6A2430F5"}, {"file_name": "migrated_image.png", "id": "2761288207320319", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982609_380490462539366_7895197015959666688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfRIL2WBeXMQ7kNvwFwXquB&_nc_oc=AdpYBy25HvxXwL6NoazslPzh2Pt2bwHY-3XBKki8-Mz8EZi1b2XI6ZBLJgEkqKpx_8U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dgHUXPeCVHrVwOiLdGmNGft9TI9ryENMZUROMLyatdA&oe=6A24333A"}, {"file_name": "migrated_image.png", "id": "257626281895818", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031324_2493746343971170_4875303925575581696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1XHmenF1J8Q7kNvwELeVVv&_nc_oc=Adoufo0gnFSRnWESnsVOe1Inx5aWVxH0aFf-dse3CLiUB6aEXBPnn7rlJ0wDuSXNGbk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9IrLhcPvtyNeEPSFHV9WgOumSdGeGJyzQn4GUtE6HA3w&oe=6A241DB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Zm9Dk8", "id": "2305335423068194", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982691_2305335426401527_4626089126830014464_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m85yozguZb0Q7kNvwFCXSax&_nc_oc=AdpVSgNy0-E9ToPEPTnNwve518PaWrvZmOv2Iy71DK1HZXpecl9_V_7hQ7CHWvJASXQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Dr6t6-pwV32UUtgUJNmZVHfHabgz2TjU5xPWH1R5_XA&oe=6A241BAD"}, "display_name": "Apex Construct", "keywords": ["apex", "apexconstruct", "action", "adventure", "single"], "long_description": "Apex Construct is a story-driven, single player VR action/adventure. Wield an upgradable bow & shield combination to battle enemy robots while exploring and solving mysteries in a shattered world.\n\nEXPLORE A WORLD RIPPED APART\nStep into a beautiful yet perilous post-apocalyptic setting, where two powerful AIs are locked in a drawn-out conflict. As the only living human, you will uncover its many secret areas and solve intriguing puzzles\n\nMASTER A FLUID BOW & SHIELD COMBINATION\nUse a flexible weapons system with unparalleled precision to engage a wide array of artificial lifeforms created by a mysterious entity called Mothr\n\nDELVE INTO A LASTING EXPERIENCE\nReplay any mission from your customizable home base to uncover paths still hidden & spend acquired resources to upgrade your weapons and equipment\n\nCONQUER THE \u201cCYGNIA CUP CHALLENGE\u201d\nHit the targets, keep the combo meter up and maximize your score in the pre-apocalyptic arena to dominate the global leaderboards", "short_description": "Apex Construct is a story-driven, single player action/adventure made exclusively for VR. Wield an upgradable cyber bow & shield combination to battle enemy robots while exploring a shattered world, to understand what led to the extinction of mankind. Also includes Cygnia Cup Challenge, a competitive game mode where you take out shooting targets and enemies in a pre-apocalypse arena to dominate the global leaderboards."}]}, "developer_name": "Fast Travel Games", "developer_privacy_policy_url": "https://www.fasttravelgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://www.fasttravelgames.com/apex-construct/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}],
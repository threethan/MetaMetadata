nt-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zImZor3Cq59X0RagaoRJLITtoj3bIXmx_bAsknlizqw&oe=6A217E47"}, {"file_name": "migrated_image.png", "id": "2660998714027120", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974583_1037883043078509_6488434620512600064_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P7KS-K26xwQ7kNvwF8o9fB&_nc_oc=AdpRNrLcLqafLi44Pms03XYsevTQ2-vu7HbxlwOUgDELEdKUBWksE2qUsMHqVotztvs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W7YGUXQrFi8ITS0Gk0xO4Gt47_CJI0zpuYzL98b5GCw&oe=6A218DF5"}, {"file_name": "migrated_image.png", "id": "2761288207320319", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982609_380490462539366_7895197015959666688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CfRIL2WBeXMQ7kNvwEZbeuy&_nc_oc=Adoae5voM3MeI39QjqkaCVEWh50JmDWD-L73RaTLGbTRn-_oWegcEeSH4fSIFcOtHbQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91VG-UbalBBgKni3gmF30uuCsJFUiVPnyFw11hYQDwNA&oe=6A21903A"}, {"file_name": "migrated_image.png", "id": "257626281895818", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031324_2493746343971170_4875303925575581696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGt64aByHgwQ7kNvwHvpnmg&_nc_oc=Ado_2bDGke7HSshiP-1XdCTDu_60mY36XuAjuHYkaUXv6d7Rhm2-h9sknND5PoEZp5U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_eF3AQFq2Gk-5ZIkOCROhkD94FRvhgiYYvn6PLYwu2qw&oe=6A217AB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Zm9Dk8", "id": "2305335423068194", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982691_2305335426401527_4626089126830014464_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m85yozguZb0Q7kNvwHVHqry&_nc_oc=Adq6chmWjxBeRP8j58WGeDKAFYzTj2NY5GxHLfPf__dwpJacA3oR8X7wGmOC9K1lOQ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Knznw6CbDpX14tH9lLH5ErH1oUt_NWOT-YMvqt_ECKg&oe=6A2178AD"}, "display_name": "Apex Construct", "keywords": ["apex", "apexconstruct", "action", "adventure", "single"], "long_description": "Apex Construct is a story-driven, single player VR action/adventure. Wield an upgradable bow & shield combination to battle enemy robots while exploring and solving mysteries in a shattered world.\n\nEXPLORE A WORLD RIPPED APART\nStep into a beautiful yet perilous post-apocalyptic setting, where two powerful AIs are locked in a drawn-out conflict. As the only living human, you will uncover its many secret areas and solve intriguing puzzles\n\nMASTER A FLUID BOW & SHIELD COMBINATION\nUse a flexible weapons system with unparalleled precision to engage a wide array of artificial lifeforms created by a mysterious entity called Mothr\n\nDELVE INTO A LASTING EXPERIENCE\nReplay any mission from your customizable home base to uncover paths still hidden & spend acquired resources to upgrade your weapons and equipment\n\nCONQUER THE \u201cCYGNIA CUP CHALLENGE\u201d\nHit the targets, keep the combo meter up and maximize your score in the pre-apocalyptic arena to dominate the global leaderboards", "short_description": "Apex Construct is a story-driven, single player action/adventure made exclusively for VR. Wield an upgradable cyber bow & shield combination to battle enemy robots while exploring a shattered world, to understand what led to the extinction of mankind. Also includes Cygnia Cup Challenge, a competitive game mode where you take out shooting targets and enemies in a pre-apocalypse arena to dominate the global leaderboards."}]}, "developer_name": "Fast Travel Games", "developer_privacy_policy_url": "https://www.fasttravelgames.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://www.fasttravelgames.com/apex-construct/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}],
content-lga3-3.oculuscdn.com/v/t64.5771-25/491820141_1372371301152584_8150621869230459429_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEk9d-ikRToQ7kNvwFDzqKA&_nc_oc=AdqeObXgEC0SfrfRLqGbfnDbQhpas4L_bRSapsplXa_v4rar7p22eKfBMUOOBrc8IkM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvP-oalwDW2i0Qw-FB_D7v-WrkxLu8sVPBZPEyNcjX9g&oe=6AD102B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (1).png", "id": "791738200340486", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823910_791738203673819_6757294699781778784_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXmVvTt7oioQ7kNvwFmeMIO&_nc_oc=Ado55pQi-YV0ublzJkFJltG2_wyQf4sFjw-IGXQsr_QG3k8T8jRzA2x2-CwdS7GJtck&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM83nSxpNK-QrjagvgVd2O1N7ICjuWT3kzHpd5-oZBakw&oe=6AD0FAEC"}, "display_name": "Riyadh Smart City", "keywords": ["Riyadh", "Vision2030", "SmartCity", "Sustainability", "RMG"], "long_description": "Smart Riyadh: The Vision 2030 Transformation\nDive into an unparalleled Extended Reality (XR) experience and witness the dramatic, data-driven story of Riyadh's evolution from a congested, developing city into one of the world's leading smart and sustainable metropolises. Designed specifically for the immersive capabilities of the Meta Quest platform, this application is your virtual passport to the achievements of Saudi Vision 2030.\n\nBefore the transformation, Riyadh struggled with severe challenges: over 90% of trips relied on private cars, leading to crippling traffic congestion. Air quality frequently dipped to unhealthy levels, with the AQI often exceeding 150, and vast desert areas were neglected.\n\nNow, see the reality of the shift. Explore the impact of multi-billion dollar smart infrastructure investments. Compare the past pollution levels (PM10 and PM2.5) with the current clean-air metrics. Walk through the giant Green Riyadh Project\u2014a testament to sustainability\u2014which boosted the city's green cover from a mere 1.5% to a projected 9%, significantly reducing dust and sandstorms.\n\nWitness the efficiency of the massive Riyadh Metro and Bus Network that has radically reshaped public mobility. Visit industrial zones to see the transition from fossil fuels to clean solar energy, resulting in a documented 20% cut in carbon emissions.\n", "short_description": "Embark on an immersive VR journey to witness the dramatic transformation of Riyadh, the Saudi capital, from past challenges to present triumphs under Vision 2030. This data-driven experience visually compares the city's severe issues\u2014such as chronic traffic and high pollution (AQI 150+)\u2014with today\u2019s sustainable reality. Explore mega-projects like the Riyadh Metro and the Green Riyadh initiative, noting the dramatic rise in green cover from 1.5% to 9% and the cut in carbon emissions through clean"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/164e173d-8527-41a9-8d8b-921b89c8e862", "developer_terms_of_service_url": null, "publisher_name": "RMG", "support_website_url": null, "website_url": "https://www.rmg-sa.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ar"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25891006083821315"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "670408425750209"}]}, "baseline_offer": {"id": "670408
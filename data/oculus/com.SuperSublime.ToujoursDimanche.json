RJNXAp12ChTDcjj4E8yu2oGFVkQ2NA&oe=6A394B62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ToujoursDimanche_SuperSublime_Trailer01Cover_22-12-01.png", "id": "759567802054587", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974871_759567805387920_1842196776566338613_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uw1_PknmqhcQ7kNvwGvaqO1&_nc_oc=AdrD8qk6Npyo42-p8fgb8GH6BZRErCZqKckL9gzZ8KSCP81RQVvE_HK_ixeOj7FXNLI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-seYuoyNRiX5nlGfvOYwKiHksNNpSReMBTLUjVTQAfIA&oe=6A3961CF"}, "display_name": "Toujours Dimanche", "keywords": [], "long_description": "Toujours Dimanche brings nature to those who can\u2019t access it.\nSplurge into sunsets, take a break by the sea, explore a mountain ridge, or listen to crickets... Enjoy the beauty of nature as you will.\n\nThis multiplayer VR experience is destined for audiences of all ages, on Oculus Quest. There are may ways to enjoy our app. Either browse the sites gallery, explore a world map, or engage in a guided meditation. You can also either enjoy a contemplative beat, or explore areas in a more adventurous way. \n\nWhile appealing to travel and nature enthusiasts, Toujours Dimanche was developped in collaboration with health-care partners. It is designed especially for nursing homes, retirement homes & pallaitive care. It's safe, confortable and accessible. We take pride at creating useful immersive tools for health care professionals.\n\nA non-VR versions for Mobile (iOS/Android) is also available and can be used to assist less-able, VR users. This way, anyone using a mobile device can become \"the guide\" and assist other users, for accessibility purpose.\n\nSuper Sublime is a non for profit organisation with a mission to alleviate pain and lift-up spirits through art & immersion. We created Toujours Dimanche with a goodwill intent. Becasue we think Nature is a basic need for anyone, no matter your priviledges of luck in life.", "short_description": "Toujours Dimanche brings nature to those who can\u2019t access it.\nSplurge into sunsets, take a break by the sea, explore a mountain ridge, or listen to crickets... Enjoy the beauty of nature as you will.\n\nDevelopped in collaboration with health-care partners, this app is designed especially for nursing homes, retirement homes & pallaitive care. It offers both relaxing and stimulating sessions. It's safe, confortable and accessible. Toujours Dimanche was made with a non for profit, goodwill intent."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.supersublime.org/toujours-dimanche-privacy-policy", "developer_terms_of_service_url": "https://www.supersublime.org/terms", "publisher_name": "Super Sublime", "support_website_url": null, "website_url": "https://www.supersublime.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr_CA"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "766444221756574"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "888802582209684"}]}, "baseline_offer": {"id": "888802582209684"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1680802200, "status": "PUBLISHED", "id": "888802582209684"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9516113155077231", "version": "0.2.30"}, "id": "728277308700782", "channel_name": "LIVE"}]}, "is
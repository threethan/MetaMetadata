_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwKvgDMUHDwQ7kNvwHuA_ez&_nc_oc=AdpZl3HErmU09Fjl1gdNXfzg_prIFaISvgGF6GtlGZNTqWi3dgU3uegucARgCiF7krA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VbOfr6s0ZZzlUqh9KDF2DhPHZQLtEt43W2Py1ytrFYQ&oe=6A369537"}, {"file_name": "6.png", "id": "936915815728488", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491822550_936915825728487_5143573190719823130_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OpqfzQER84cQ7kNvwHLlmVu&_nc_oc=AdqZ3yzzN8rI-EqET6G2YdD6jkFM2HuEwulEB8TK103f0yFLYjwILlT0whjNYO31Xsw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dXlgoZZYzb1OBbT1tHfb6dNUpykrFw9EWzbtW56EKjA&oe=6A36A549"}, {"file_name": "2.png", "id": "873901112366445", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491821081_873901115699778_1441679925769219714_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AB9daAG22WoQ7kNvwEjWUAw&_nc_oc=Adq018y2VYL9Ury9AIH5OqoGXDt5NnVgxH6qmrB2Nom-3UHD2aCHrFMWh-AAMOn3Uso&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FA6_52mFZE_pGjLMua56BRFxKjQ3VZdf8Zm8Gn3qA4g&oe=6A36ACB5"}, {"file_name": "8.png", "id": "943185255078176", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820855_943185268411508_4712073486129994565_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qc6IurbxeokQ7kNvwH5Bpvn&_nc_oc=Adre5PQjIjZKosCX5RgCuAzlbr52NoWvgrOOYUv7K1tlcSjy956xShHi1kMqNAMOp-I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WrBuULtDkIwzXf8GXNV9Sb4yKTny9-Wahdmm5aDGRyA&oe=6A368F6C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1.png", "id": "1421183055897822", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823949_1421183062564488_4958722369507528533_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DWuI895N1MQ7kNvwFvQT4W&_nc_oc=AdolDuHVoKpdi2gC-tZSYRAcMqivVodUjG__w7ny6BEMlb43JKKFCJiq2H0GvT8PbZM&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CIKZThHJo951yeUCoqjmVdOyqJbpReFxfplx4JYXN6g&oe=6A36B453"}, "display_name": "Chains Of Clues", "keywords": ["investigation", "crimes", "detective", "criminal", "forensic"], "long_description": "\ud83d\udd0e Chains Of Clues\n\nSolve crimes in VR. Reconstruct the truth with your own hands.\n\nStep into a fully immersive investigation experience where every detail matters and every decision counts. In Chains Of Clues, you are the detective\u2014tasked with analyzing crime scenes, collecting evidence, and connecting clues to uncover what really happened.\n\nNo markers. No hints.\nJust you\u2026 and the truth.\n\n\ud83e\udde0 INVESTIGATE REAL CRIME SCENES\n\nExplore carefully crafted environments where nothing is random and everything can be a clue.\n\nObserve, analyze, and question every detail. From subtle traces to critical evidence, each element can change your understanding of the case.\n\n\ud83d\udd90 HANDLE EVIDENCE WITH YOUR HANDS\n\nBuilt for virtual reality, every interaction is physical and intuitive:\n\nPick up and inspect objects from any angle\nUse forensic tools to reveal hidden details\nExamine surfaces for traces and clues\nTake photos of the scene and key evidence\n\nYou\u2019re not clicking through menus.\nYou\u2019re actively investigating.\n\n\ud83e\udde9 CONNECT THE DOTS IN YOUR OFFICE\n\nYour investigation doesn\u2019t end at the scene.\n\nReturn to your office and organize everything you\u2019ve discovered:\n\nPlace photos and evidence on your investigation board\nLink clues together with pins and connections\nReview forensic reports and case data\nBuild your own theory of what happened\n\nThe solution isn\u2019t given to you.\nYou create it.", "short_description": "Solve crimes in VR. Investigate crime scenes, collect evidence with your hands, and reconstruct the truth by connecting clues back at your office. Every case challenges your observation, logic, and deduction."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1YPnnjf-nNMmfopOlvVF91CoSu-bCUyyfg2IAyRMCEyg/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Chema Luque", "support_website_url": null, "website_url": "https://discord.gg/ztzAmBEanX", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26077414695255842"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1525255385928848"}, {"status": "PUBLISHED", "id": "945872561734345"}]}, "baseline_offer": {"id": "945872561734345"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779123600, "status": "PUBLISHED", "id": "1525255385928848"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26319467794383863", "version": "1.0"}, "id": "1264288009243471", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26077414655255846", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26319467794383863"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1264288009243471"}]}, "change_log": null, "created_date": 1776332516, "id
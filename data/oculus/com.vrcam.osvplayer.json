9Xdx4A1iof_SvElSDUybJ6jlJiNw&oe=6AFB42E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1751442152620495", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499620655_1751442155953828_7807634497302582929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yn74wY6Kgj8Q7kNvwE2QUKa&_nc_oc=AdpjE57Nje9DqJxgf7loVESKZUp-s_EOKo9X3V-RGnKyf7wSXnPQAKfNM8rIC9jrgwk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKks0ylV1qMxFnBv3ZlRBGowUKHmMkZWojUCWNjvxvwA&oe=6AFB2BB0"}, "display_name": "MemoVR Player", "keywords": ["player", "osmo", "fisheye", "q3u"], "long_description": "# MemoVR Player\n\n**Make VR a simpler way to record life**\n\n## Overview\n\n- Browse and manage standard SBS ERP VR180 MP4, JPG, and PNG files.\n- Open native VR-camera video and JPG/PNG photos with real-time stabilization\u2014no complex export step after shooting (currently DJI Osmo 360 modded and QooCam 3 Ultra modded; more cameras to follow).\n- Supports on-device storage, camera USB, and LAN SMB shares (read/write enables delete) for easier VR media management.\n\n## Supported formats\n-  `.osv`: Dual-fisheye (e.g. DJI), 190\u00b0 fisheye playback, real-time stab \n- QooCam 3 Ultra dual fisheye : Aspect ~1:2 \u2192 top/bottom fisheye (200\u00b0), real-time stab \nOther `.mp4` : Aspect ~2:1 \u2192 SBS ERP VR180; otherwise flat 2D \n- `.jpg` / `.jpeg` / `.png` :  Aspect ~2:1 \u2192 SBS ERP VR180; otherwise flat 2D \n\n## Author\n\n- Author: memovr\n- Email: memovr180@gmail.com\n", "short_description": "Make VR a simpler way to record life.\n\n1. Browse and manage standard SBS ERP VR180 MP4, JPG, and PNG files.\n2. Open native VR-camera video and JPG/PNG photos with real-time stabilization\u2014no complex export step after shooting (currently DJI Osmo 360 modded and QooCam 3 Ultra modded; more cameras to follow).\n3. Supports on-device storage, camera USB, and LAN SMB shares (read/write enables delete) for easier VR media management."}]}, "developer_name": "memovr", "developer_privacy_policy_url": "https://yuquant.github.io/memovr/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "memovr", "support_website_url": null, "website_url": "https://yuquant.github.io/memovr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1453076147883303"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1210096131341186"}]}, "baseline_offer": {"id": "1210096131341186"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794376440, "status": "PUBLISHED", "id": "1210096131341186"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1468403366350581", "version": "1.29.6-quest3"}, "id": "1382198667114392", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1453076141216637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1468403366350581"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1382198667114392"}]}, "change_log": "\u4f18\u5316\u5185\u5b58\u6cc4\u6f0fb
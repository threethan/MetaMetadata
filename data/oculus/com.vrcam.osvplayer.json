9&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAwjb7JMI9gQ7kNvwEM_toV&_nc_oc=Adq1mgVZ1sgznDPr-rMWozQ4zsiGh8kcucQUdjwJdn1dVS4i-9SCM68pajiEgcMTVFs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW7_ICC2wnKcg0uInkDNSy-1vQgB_hF9meCubSoY0yaDQ&oe=6B104857"}, {"file_name": "\u622a\u56fe4-smb.png", "id": "2157139261567635", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623111_2157139264900968_760709476706566408_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHILVm3arZIQ7kNvwFi6A2q&_nc_oc=AdojHNZcWfAadUC8V4IGSZ4nv4t4kh-vf55v2w5mOjR5RRD6NALt-indkRevszH3V-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXzGAXQclxvoGksIC2yCSAhOWDeBiFUQfvRtoeajdgQHg&oe=6B10682B"}, {"file_name": "\u622a\u56fe5-videos.png", "id": "1823001228840596", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619404_1823001232173929_2344172590870111051_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7jTsKJUvXFsQ7kNvwGs0Ks3&_nc_oc=Adrh1lowuGTDo-rKcYG6rxG0xOnOytncEYgewjKjEg3ruGvI3WpeFe-lHxrlA4yk6Rc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVNvUfuS_pcFPj3b7NPAP5JQqn4Q-LGuchfHeGWuQ5Fyg&oe=6B104061"}, {"file_name": "\u622a\u56fe3-favor.png", "id": "1110264864954406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623551_1110264868287739_9141166805763674216_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWQRyhQC2lcQ7kNvwFH1sp4&_nc_oc=Ado5_BGW5yY0cpCN4Y31n7qAMDl3oySJqHFOf9GJokuWxM9plqcmFPaVqdCl5UEUckE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXnkCQzA2MUPbqB-ylgfSWnZ2MBv6LaQWq6T73Io1rbvg&oe=6B105809"}, {"file_name": "\u622a\u56fe1.png", "id": "1658283682637899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593878539_1658283685971232_3799221318757258192_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UsxJMFNYdAQ7kNvwEIQ496&_nc_oc=Adqh0IswVCWieemekRzB168r5V-0rKChSpxlt4_uJPJYDyWeS2k--gkDLqHiHzv81to&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzGR_aMYch2DxZLdqGqS2qZGIbiyZ1YNr1IjdsdUWxWA&oe=6B105AE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1751442152620495", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620655_1751442155953828_7807634497302582929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtzMIc43W1wQ7kNvwEsLFvF&_nc_oc=AdoHOYwpseWgsE-gNynNVdFhNY5nP4iBHMMBCbT9BWU46KakcC2jEyTKkAlKZuqqWPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQcJf6rm6mqLvtbNBlVqR4Y3gwQ3n_sumhVaPYmWNWXw&oe=6B1043B0"}, "display_name": "MemoVR Player", "keywords": ["player", "osmo", "fisheye", "q3u"], "long_description": "# MemoVR Player\n\n**Make VR a simpler way to record life**\n\n## Overview\n\n- Browse and manage standard SBS ERP VR180 MP4, JPG, and PNG files.\n- Open native VR-camera video and JPG/PNG photos with real-time stabilization\u2014no complex export step after shooting (currently DJI Osmo 360 modded and QooCam 3 Ultra modded; more cameras to follow).\n- Supports on-device storage, camera USB, and LAN SMB shares (read/write enables delete) for easier VR media management.\n\n## Supported formats\n-  `.osv`: Dual-fisheye (e.g. DJI), 190\u00b0 fisheye playback, real-time stab \n- QooCam 3 Ultra dual fisheye : Aspect ~1:2 \u2192 top/bottom fisheye (200\u00b0), real-time stab \nOther `.mp4` : Aspect ~2:1 \u2192 SBS ERP VR180; otherwise flat 2D \n- `.jpg` / `.jpeg` / `.png` :  Aspect ~2:1 \u2192 SBS ERP VR180; otherwise flat 2D \n\n## Author\n\n- Author: memovr\n- Email: memovr180@gmail.com\n", "short_description": "Make VR a simpler way to record life.\n\n1. Browse and manage standard SBS ERP VR180 MP4, JPG, and PNG files.\n2. Open native VR-camera video and JPG/PNG photos with real-time stabilization\u2014no complex export step after shooting (currently DJI Osmo 360 modded and QooCam 3 Ultra modded; more cameras to follow).\n3. Supports on-device storage, camera USB, and LAN SMB shares (read/write enables delete) for easier VR media management."}]}, "developer_name": "memovr", "developer_privacy_policy_url": "https://yuquant.github.io/memovr/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "memovr", "support_website_url": null, "website_url": "https://yuquant.github.io/memovr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1453076147883303"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1210096131341186"}]}, "baseline_offer": {"id": "1210096131341186"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794376440, "status": "PUBLISHED", "id": "1210096131341186"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1468403366350581", "version": "1.29.6-quest3"}, "id": "1382198667114392", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1453076141216637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1468403366350581"}, "release_status": "RELEASED"}, "binary_rel
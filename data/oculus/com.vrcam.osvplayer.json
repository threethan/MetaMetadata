9&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=37bLGTk_-EUQ7kNvwFS-Bhl&_nc_oc=Adq9KZI8dIKPiJJ3eSIpxTLbrkPCZRgWm6w11NCVykkrsisrd8LOEJ2eEXFfPpgFqg4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyPjGqKXBpfyUNtDi2TL6ib_egD3gUGhc4EttY0H6JDA&oe=6B031957"}, {"file_name": "\u622a\u56fe4-smb.png", "id": "2157139261567635", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623111_2157139264900968_760709476706566408_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Fc9u58q1dQQ7kNvwENIb_a&_nc_oc=Adpwaa6Itn_qygcfh9CKk46JZFPnY7mmPkf19dSSePjmAeuNt_S8HkN9Ok-aVPKapQ4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiJKEWTGutnWZ-cnbwbZGUvD7nWwQwnIrXLff-kCZrhQ&oe=6B03392B"}, {"file_name": "\u622a\u56fe5-videos.png", "id": "1823001228840596", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619404_1823001232173929_2344172590870111051_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oPiy2uJTboQ7kNvwGFnZVW&_nc_oc=AdqMMYaGiuwIXySf0kz7bbkTUdiP0AroviKFUV7aK5pmqzHtnSuyuYVv3dEOvuWNDDo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQrKXUgmtIrUHoEGkU0dS182OVpGI-6M2jAlGjBi6LAg&oe=6B031161"}, {"file_name": "\u622a\u56fe3-favor.png", "id": "1110264864954406", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499623551_1110264868287739_9141166805763674216_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5qc7JZBUE7cQ7kNvwEnRZqX&_nc_oc=Adrt97eXugQn-cvIexMxwBeFtimEqDpSm23m8SqdlLq3jW_InBh0apGFpiMNbgbSHiY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFNnbElzfrGBv_WLe2t6f15HeUgGF4Yp3Jtg7UlySPLw&oe=6B032909"}, {"file_name": "\u622a\u56fe1.png", "id": "1658283682637899", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593878539_1658283685971232_3799221318757258192_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13V4GyvIaCUQ7kNvwFEvfNJ&_nc_oc=AdrzKMgPO_rSE8YTy2nycnwWpEhWVw4WC5WIMwmaVvxtKBa9Bde5fcTqTAdCb8Gq3Ek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1jrK58dF--HgR_kcQk6ezTpBes3CU3Gw6mg6aNuxgPA&oe=6B032BE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1751442152620495", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620655_1751442155953828_7807634497302582929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftiR4Ld1QMQQ7kNvwGsHNrW&_nc_oc=AdrQH5eNKyfuASRyoBY8hPcCQ9cCDxXhbd7c9fgG8awt-hv3xg3HhK4iiuRe0PG-E-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF-R1bMU0kIMvpLON2aYKk2-FhEvLqcMqAOjr9ntiGOQ&oe=6B0314B0"}, "display_name": "MemoVR Player", "keywords": ["player", "osmo", "fisheye", "q3u"], "long_description": "# MemoVR Player\n\n**Make VR a simpler way to record life**\n\n## Overview\n\n- Browse and manage standard SBS ERP VR180 MP4, JPG, and PNG files.\n- Open native VR-camera video and JPG/PNG photos with real-time stabilization\u2014no complex export step after shooting (currently DJI Osmo 360 modded and QooCam 3 Ultra modded; more cameras to follow).\n- Supports on-device storage, camera USB, and LAN SMB shares (read/write enables delete) for easier VR media management.\n\n## Supported formats\n-  `.osv`: Dual-fisheye (e.g. DJI), 190\u00b0 fisheye playback, real-time stab \n- QooCam 3 Ultra dual fisheye : Aspect ~1:2 \u2192 top/bottom fisheye (200\u00b0), real-time stab \nOther `.mp4` : Aspect ~2:1 \u2192 SBS ERP VR180; otherwise flat 2D \n- `.jpg` / `.jpeg` / `.png` :  Aspect ~2:1 \u2192 SBS ERP VR180; otherwise flat 2D \n\n## Author\n\n- Author: memovr\n- Email: memovr180@gmail.com\n", "short_description": "Make VR a simpler way to record life.\n\n1. Browse and manage standard SBS ERP VR180 MP4, JPG, and PNG files.\n2. Open native VR-camera video and JPG/PNG photos with real-time stabilization\u2014no complex export step after shooting (currently DJI Osmo 360 modded and QooCam 3 Ultra modded; more cameras to follow).\n3. Supports on-device storage, camera USB, and LAN SMB shares (read/write enables delete) for easier VR media management."}]}, "developer_name": "memovr", "developer_privacy_policy_url": "https://yuquant.github.io/memovr/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "memovr", "support_website_url": null, "website_url": "https://yuquant.github.io/memovr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1453076147883303"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1210096131341186"}]}, "baseline_offer": {"id": "1210096131341186"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794376440, "status": "PUBLISHED", "id": "1210096131341186"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1468403366350581", "version": "1.29.6-quest3"}, "id": "1382198667114392", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1453076141216637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1468403366350581"}, "release_status": "RELEASED"}, "binary_rel
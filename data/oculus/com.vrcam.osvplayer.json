9&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fosc2p7mozMQ7kNvwGqJfPW&_nc_oc=AdoLIPGaz-TNS6yG42colke86aBIv4M4rsVjNBrrSE0QYi0MwVmw1kfeFxwWOcf3RmQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSIN03QWBdGperoMj0kCAv6EBlaZDOQCwc8WtFnkCh4nQ&oe=6B0DA557"}, {"file_name": "\u622a\u56fe4-smb.png", "id": "2157139261567635", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623111_2157139264900968_760709476706566408_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbNFaMFlgP4Q7kNvwHFCVWr&_nc_oc=AdotoIvV9BOux_VGF4uMgo-wPsI546OaVJFGHvOhDBba-08MaOKkH48JP4sLpUgGHHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRMDKU2f8BklJnHs0YVpaFRhDi3R2E8m2SfYQO-0PPQA&oe=6B0DC52B"}, {"file_name": "\u622a\u56fe5-videos.png", "id": "1823001228840596", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619404_1823001232173929_2344172590870111051_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dO_MIZcdYuUQ7kNvwHNdUBv&_nc_oc=AdrPeGv-ePYooh03ARysuDa96a9CH-yku1lQYXJNj8nvx-Bsh5ULmTWf9kWYWrsG14M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzOzuh7HKcN8NhG-g8UW03wR8MV3nVJL668OWR3cC94Q&oe=6B0D9D61"}, {"file_name": "\u622a\u56fe3-favor.png", "id": "1110264864954406", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623551_1110264868287739_9141166805763674216_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tWQRyhQC2lcQ7kNvwHw0T4q&_nc_oc=Adp2_e0mnbcabuN3Wjn22dqzloBZIlk9YllZMLCN1Clf2Kviov8wewS3v4dRRbdUmBY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSuRdT2RSzci36fX5MfHzfOJuhUYrWf4pFdmePkl9ylkQ&oe=6B0DB509"}, {"file_name": "\u622a\u56fe1.png", "id": "1658283682637899", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593878539_1658283685971232_3799221318757258192_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UsxJMFNYdAQ7kNvwGeP0so&_nc_oc=Adq6uW7a5npdp7k4Wb1aVo8PJFx8sUpak7JPPY88_18ccSKeVY790OMN6A9TKTyAPcM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWfdXw63v73ETqquK5PO3ZC_ueV9sSFmJG_58xG5gIAg&oe=6B0DB7E7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1751442152620495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620655_1751442155953828_7807634497302582929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtzMIc43W1wQ7kNvwHtj3po&_nc_oc=AdonmH9sX1gAIBJn97kNLL-6mv5tFWuW9P5CkfCgvhYhfLVcUJyo_-Dh-lprmUmdZsA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWe38hQ3AQ31omlVL_L80mchQAvUNSJI2b9PMtENzr4g&oe=6B0DA0B0"}, "display_name": "MemoVR Player", "keywords": ["player", "osmo", "fisheye", "q3u"], "long_description": "# MemoVR Player\n\n**Make VR a simpler way to record life**\n\n## Overview\n\n- Browse and manage standard SBS ERP VR180 MP4, JPG, and PNG files.\n- Open native VR-camera video and JPG/PNG photos with real-time stabilization\u2014no complex export step after shooting (currently DJI Osmo 360 modded and QooCam 3 Ultra modded; more cameras to follow).\n- Supports on-device storage, camera USB, and LAN SMB shares (read/write enables delete) for easier VR media management.\n\n## Supported formats\n-  `.osv`: Dual-fisheye (e.g. DJI), 190\u00b0 fisheye playback, real-time stab \n- QooCam 3 Ultra dual fisheye : Aspect ~1:2 \u2192 top/bottom fisheye (200\u00b0), real-time stab \nOther `.mp4` : Aspect ~2:1 \u2192 SBS ERP VR180; otherwise flat 2D \n- `.jpg` / `.jpeg` / `.png` :  Aspect ~2:1 \u2192 SBS ERP VR180; otherwise flat 2D \n\n## Author\n\n- Author: memovr\n- Email: memovr180@gmail.com\n", "short_description": "Make VR a simpler way to record life.\n\n1. Browse and manage standard SBS ERP VR180 MP4, JPG, and PNG files.\n2. Open native VR-camera video and JPG/PNG photos with real-time stabilization\u2014no complex export step after shooting (currently DJI Osmo 360 modded and QooCam 3 Ultra modded; more cameras to follow).\n3. Supports on-device storage, camera USB, and LAN SMB shares (read/write enables delete) for easier VR media management."}]}, "developer_name": "memovr", "developer_privacy_policy_url": "https://yuquant.github.io/memovr/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "memovr", "support_website_url": null, "website_url": "https://yuquant.github.io/memovr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1453076147883303"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1210096131341186"}]}, "baseline_offer": {"id": "1210096131341186"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1794376440, "status": "PUBLISHED", "id": "1210096131341186"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1468403366350581", "version": "1.29.6-quest3"}, "id": "1382198667114392", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1453076141216637", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1468403366350581"}, "release_status": "RELEASED"}, "binary_rel
MBv6LaQWq6T73Io1rbvg&oe=6B105809"}, {"file_name": "\u622a\u56fe1.png", "id": "1658283682637899", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593878539_1658283685971232_3799221318757258192_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UsxJMFNYdAQ7kNvwEIQ496&_nc_oc=Adqh0IswVCWieemekRzB168r5V-0rKChSpxlt4_uJPJYDyWeS2k--gkDLqHiHzv81to&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUzGR_aMYch2DxZLdqGqS2qZGIbiyZ1YNr1IjdsdUWxWA&oe=6B105AE7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1751442152620495", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620655_1751442155953828_7807634497302582929_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qtzMIc43W1wQ7kNvwEsLFvF&_nc_oc=AdoHOYwpseWgsE-gNynNVdFhNY5nP4iBHMMBCbT9BWU46KakcC2jEyTKkAlKZuqqWPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVQcJf6rm6mqLvtbNBlVqR4Y3gwQ3n_sumhVaPYmWNWXw&oe=6B1043B0"}, "display_name": "MemoVR Player", "keywords": ["player", "osmo", "fisheye", "q3u", "memovr"], "long_description": "# MemoVR Player\n\n**Make VR a simpler way to record life**\n\n## Overview\n\n- Browse and manage standard SBS ERP VR180 MP4, JPG, and PNG files.\n- Open native VR-camera video and JPG/PNG photos with real-time stabilization\u2014no complex export step after shooting (currently DJI Osmo 360 modded and QooCam 3 Ultra modded; more cameras to follow).\n- Supports on-device storage, camera USB, and LAN SMB shares (read/write enables delete) for easier VR media management.\n\n## Supported formats\n-  `.osv`: Dual-fisheye (e.g. DJI), 190\u00b0 fisheye playback, real-time stab \n- QooCam 3 Ultra dual fisheye : Aspect ~1:2 \u2192 top/bottom fisheye (200\u00b0), real-time stab \nOther `.mp4` : Aspect ~2:1 \u2192 SBS ERP VR180; otherwise flat 2D \n- `.jpg` / `.jpeg` / `.png` :  Aspect ~2:1 \u2192 SBS ERP VR180; otherwise flat 2D \n\n## Author\n\n- Author: memovr\n- Email: memovr180@gmail.com\n", "short_description": " \u4e00\u4e2a\u53ef\u4ee5\u76f4\u63a5\u6253\u5f00VR180\u8fd0\u52a8\u76f8\u673a\u89c6\u9891\u7167\u7247\u7684\u64ad\u653e\u5668\u3002\n- \u652f\u6301\u5e38\u89c4SBS ERP VR180\u7684mp4\u3001jpg\u3001png\u6587\u4ef6\u6d4f\u89c8\u53ca\u7ba1\u7406\u3002\n- \u76f4\u63a5\u6253\u5f00\u591a\u79cd VR \u76f8\u673a\u539f\u7247\u7684\u89c6\u9891\u4e0e jpg/png \u7167\u7247\uff0c\u652f\u6301\u5b9e\u65f6\u9632\u6296\uff0c\u62cd\u6444\u540e\u4e0d\u9700\u8981\u7ecf\u8fc7\u590d\u6742\u7684\u5bfc\u51fa\u8fc7\u7a0b\uff0c\u76f4\u63a5\u5c31\u80fd\u89c2\u770b\uff08\u76ee\u524d\u652f\u6301 DJI Osmo 360 \u9b54\u6539\u7248\u3001QooCam 3 Ultra\u9b54\u6539\u7248\uff0c\u540e\u7eed\u5c06\u589e\u52a0\u66f4\u591a\u673a\u578b\uff09\u3002\n- \u652f\u6301\u672c\u673a\u5b58\u50a8\u3001\u76f8\u673a\u76f4\u8fde\u3001\u5c40\u57df\u7f51 SMB \u5171\u4eab\uff08\u5f00\u542f\u8bfb\u5199\u6743\u9650\u652f\u6301\u7d20\u6750\u5220\u9664\uff09\uff0cVR\u7d20\u6750\u7ba1\u7406\u66f4\u65b9\u4fbf\u3002"}]}, "developer_name": "memovr", "developer_privacy_policy_url": "https://yuquant.github.io/memovr/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "memovr", "support_website_url": null, "website_url": "https://yuquant.github.io/memovr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "146842767634815
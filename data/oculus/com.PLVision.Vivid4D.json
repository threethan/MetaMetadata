HIhbmoQ7kNvwFVl1bb&_nc_oc=AdobM0on-zYPUoHztmNmh4qddfQixONgYYbaHc0aqLcYCy5uqWpN9r1HdmXCR8qo3J4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPT-Iq6HQQrXd2_RW1OzfkUiZEeP05npw8DhA3xLVmzA&oe=6A649E75"}, {"file_name": "2.png", "id": "24957963173880459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_24957963177213792_5729283905419006059_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AG1ukSvYyEQ7kNvwEd9VJ-&_nc_oc=AdpUJxBlXoUp51drqA3rxjl9v0KSrVog8-wxz7J1nZBQBpRuj0U7C9Q5LfJQD5KgPNY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfC2t6rXl0WFSXQznIrZv884_w4hDs_2WRz_FSQSBqNQ&oe=6A64D352"}, {"file_name": "1.png", "id": "877152798465395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_877152801798728_6439813062953149866_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87pbsCC6sNIQ7kNvwEEHEAO&_nc_oc=Adp7jACz7-QRVrYY1y2zNdKHlfQS6KgdmHKJdcDxL4DKh2-uX_LkthyykDkgCz-Z40Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXnm_xrvc74iH_3q18NP0yzayjrPy3gu5U2aZbLgahuw&oe=6A64B629"}, {"file_name": "3.png", "id": "1593001388680966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619668_1593001392014299_6403491631827847043_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grRgM3EVtKYQ7kNvwGHdNMY&_nc_oc=AdqEWpmz0M1lFS4tzZiwRDAOHOQfbz2xYbmqLDHufzyYwJ97yGuKX_PJEhSXQldDk94&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgxQnfWBvROQIBk-GpfW9AhgplfI6v7emfBGyFYduiRw&oe=6A64B342"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vivid 4D", "keywords": ["Gaussian", "performance", "yoga"], "long_description": "Description:\n\nWitness the evolution of reality. Vivid 4D is a cutting-edge Mixed Reality (MR) platform powered by 4D Gaussian Splatting technology.\n\nForget flat screens and static 3D models. We bring dynamic, moving reality into your physical space with unprecedented fidelity.\n\nKey Features:\n\nPowered by 4D Gaussian Splatting: Experience the latest breakthrough in volumetric video. Our engine renders fluid motion, changing light, and intricate details in real-time. It\u2019s not just a 3D model; it\u2019s a captured moment of time, replayed in your room.\nTrue-to-Life Presence: Bring real actors and performers into your living room or bedroom at a 1:1 scale. The \"ghost in the shell\" is gone\u2014these are photorealistic humans that look and feel alive.\n6DoF Freedom: Walk around the action. Inspect the performance from any angle. Whether for entertainment or immersive learning, you are no longer a spectator\u2014you are part of the scene.\nEarly Access & PGC Platform:\nWe are building the ultimate destination for Professional Generated Content (PGC) in spatial video. During our Early Access launch, enjoy our curated library of premium 4D experiences completely FREE.\n\nDownload Vivid 4D today and step inside the video.", "short_description": "Experience photorealistic, moving humans in your room with Vivid 4D. Powered by 4D Gaussian Splatting, this free MR player lets you walk around life-sized performances in 6DoF."}]}, "developer_name": null, "developer_privacy_policy_url": "https://674312358-sudo.github.io/vivid-4d-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Prometheus ", "support_website_url": null, "website_url": "https://www.prometh.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supporte
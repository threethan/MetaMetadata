0_Af4VAUkcsKFax4TGbemxRVduahdAvUMRO10JnLjy0xHHBA&oe=6A106A29"}, {"file_name": "1.png", "id": "877152798465395", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499617847_877152801798728_6439813062953149866_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMYJXSgTycsQ7kNvwEzBgvT&_nc_oc=AdpOQQkPHCVgVx3UKDHv8Jfh3comrX_FwfY_dLd4OcClusQwBzNpLq-rVj_4RmO8iz8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fbFZwLl1hTyUuaNXvscBubmYvmrze6C_T-jR15wokzw&oe=6A105629"}, {"file_name": "7.png", "id": "1731304771165964", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618264_1731304774499297_1100583447365821378_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsmAbk77CJoQ7kNvwGCjUqa&_nc_oc=Adq4NNgUrtdaFMAPdvHgkcxiNYtBXrRqOmbbe4gBDqboFeDMG8-w3FdyUMd5YbYk_ok&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MjM-DADLpJbZ4wUKZZBnYoawheXdiHMBozasGKSlGdg&oe=6A104A1D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "857061003403889", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619685_857061006737222_418002076381847019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kv2v02P0JQQQ7kNvwEp_edz&_nc_oc=Adqe3X82OIqS9m5iEnjLVN2XV4WPTeLwnGRl34s51lrX-SZvo919kAVNykjJc7z86oE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-L0Se6dJj3_9NQSrDe8Bjy77USmYai3KMsPRZxTuW3w&oe=6A108055"}, "display_name": "Vivid 4D", "keywords": ["volumetric", "hologram", "performer", "immersive", "4DGS"], "long_description": "Imagine a performer stepping out of the screen and into your room \u2014 at full scale, in full motion, with every detail captured in stunning clarity. That's Vivid 4D.\n\nPowered by 4D Gaussian Splatting \u2014 the most advanced volumetric video technology available \u2014 Vivid 4D renders real humans with photorealistic skin, fluid movement, and dynamic lighting. This isn't animation. This isn't CGI. This is a real person, replayed in your space.\n\nWalk around them. Get close. Change your angle. With full 6DoF freedom, you're not watching a performance \u2014 you're sharing the room with it.\n\nKey Features:\n\nLife-Sized Performers in Your Room\nReal dancers and performers at 1:1 scale, standing right in front of you. Every movement, every detail \u2014 exactly as if they were there.\n\n4DGS Ultra-Realistic Quality\nPhotorealistic skin, hair, fabric, and motion captured and rendered in real-time. The clearest, most lifelike volumetric humans on any MR headset.\n\nWalk Around the Performance\n6DoF freedom means you move, they stay. Circle them, crouch down, lean in \u2014 every angle is yours to explore.\n\nFree During Early Access\nOur full library of premium 4D performances is completely free right now. Download before it changes.\n\nDownload Vivid 4D and step inside the performance.", "short_description": "Powered by 4D Gaussian Splatting, Vivid 4D puts life-sized photorealistic performers right in your room. Your private stage. Free to download"}]}, "developer_name": null, "developer_privacy_policy_url": "https://674312358-sudo.github.io/vivid-4d-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Prometheus ", "support_website_url": null, "website_url": "https://www.prometh.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35733494519597080"}, "review_messages": []}
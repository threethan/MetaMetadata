7kNvwGeaRc4&_nc_oc=Adr354aGpF9dWqAtnOQrQxmeUeW__TtJp4Z5RorUVDSZsDZvCI1H6Gy_LwErYW98Bfc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ihfftkDMc1rKN_EJoBlVvyVM-V6ql1_nVEUJ10RIT0g&oe=69DE2575"}, {"file_name": "2.png", "id": "24957963173880459", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618274_24957963177213792_5729283905419006059_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esktIwuFuXsQ7kNvwG1xQW9&_nc_oc=Adrhjmp2hKD2QGdVdDC6ct2vTilDWH9mulFkvBKlMK9JeVCFNQW0C1CMywAgxcOe66I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28CMNbnCyKS2WQp0Xfce0HOxHqPaAMROtvEgqetCiAxA&oe=69DE2212"}, {"file_name": "1.png", "id": "877152798465395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617847_877152801798728_6439813062953149866_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wcf9sLIF2mcQ7kNvwEuIpsW&_nc_oc=AdpmV7qTnXcrt72rZcw0qREOyE5gYw2XlVLyU7q3JgQgG0_mO6jTW0p8B7pFIduUv3w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tKe9lQ9udB-gYy16os2qUHTjbxluFpej3JaIz3t-1jA&oe=69DE3D29"}, {"file_name": "3.png", "id": "1593001388680966", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619668_1593001392014299_6403491631827847043_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z16Uon9jwDcQ7kNvwH4g1qP&_nc_oc=AdrULKYamPETH2Pzl_MZNmsQelVGpVPss5CIgou6cXlKwgTkFg8JmO3t9GRkTpI4Q3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3V1G3FBQ99Qnv-7FnikOF6D-mticzpGWhdAMTTL1AoQQ&oe=69DE3A42"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vivid 4D", "keywords": ["Gaussian", "performance", "yoga"], "long_description": "Description:\n\nWitness the evolution of reality. Vivid 4D is a cutting-edge Mixed Reality (MR) platform powered by 4D Gaussian Splatting technology.\n\nForget flat screens and static 3D models. We bring dynamic, moving reality into your physical space with unprecedented fidelity.\n\nKey Features:\n\nPowered by 4D Gaussian Splatting: Experience the latest breakthrough in volumetric video. Our engine renders fluid motion, changing light, and intricate details in real-time. It\u2019s not just a 3D model; it\u2019s a captured moment of time, replayed in your room.\nTrue-to-Life Presence: Bring real actors and performers into your living room or bedroom at a 1:1 scale. The \"ghost in the shell\" is gone\u2014these are photorealistic humans that look and feel alive.\n6DoF Freedom: Walk around the action. Inspect the performance from any angle. Whether for entertainment or immersive learning, you are no longer a spectator\u2014you are part of the scene.\nEarly Access & PGC Platform:\nWe are building the ultimate destination for Professional Generated Content (PGC) in spatial video. During our Early Access launch, enjoy our curated library of premium 4D experiences completely FREE.\n\nDownload Vivid 4D today and step inside the video.", "short_description": "Experience photorealistic, moving humans in your room with Vivid 4D. Powered by 4D Gaussian Splatting, this free MR player lets you walk around life-sized performances in 6DoF."}]}, "developer_name": null, "developer_privacy_policy_url": "https://674312358-sudo.github.io/vivid-4d-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Prometheus ", "support_website_url": null, "website_url": "https://www.prometh.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
n.com&_nc_ss=7f30f&oh=00_AQWREoHWJl7PuzwsLYIxtDvsG767exyWt7U_lo9if1SO_w&oe=6B104355"}, "display_name": "Vivid 4D: Dance in Mixed Reality", "keywords": ["dance", "MR", "hologram", "passthrough", "4D"], "long_description": "Watch real dancers perform in your own room.\n\nVivid 4D brings life-size dance performances into mixed reality. Real people, real movement, standing in your space.\n\nNEW PERFORMANCES, REGULARLY\n\u2022 Short dance performances, about 3\u20135 minutes each\n\u2022 New performances added on a regular schedule\n\u2022 Start with Latin dance, with more styles to come\n\nHOW IT WORKS\n\u2022 Download for free\n\u2022 Choose a performance and watch in mixed reality\n\u2022 Unlock more performances with a monthly subscription or individual purchase\n\nWHY VIVID 4D\n\u2022 Life-size performers in your room\n\u2022 Captured from real dancers, not animated characters\n\u2022 Simple controls, comfortable to watch seated or standing\n\nBuilt with 4D Gaussian Splatting technology.\n\nBest experienced in a room with some free space. Requires Meta Quest 3 or later.", "short_description": "A new life-size dance performance in your room, every Friday. Free to download."}]}, "developer_name": null, "developer_privacy_policy_url": "https://674312358-sudo.github.io/vivid-4d-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Prometheus ", "support_website_url": null, "website_url": "https://www.prometh.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "
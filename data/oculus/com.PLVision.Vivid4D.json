1OwImaDg6B2g&oe=6AB292A9"}, {"file_name": "12.png", "id": "1577787497010584", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619187_1577787500343917_7506768368927409637_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLF4qu-H_pUQ7kNvwFBvT0v&_nc_oc=AdqN695VCDBWYwbPeX0_xJb2qB5rfDxbCKoR5aJlOKyPFO88vUK8-neWoezIB_uPIxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY1FluZgkBWLusa2Vg1ZTmZ0mChVnct-wT78RCbbzJhw&oe=6AB2A5E0"}, {"file_name": "16.png", "id": "1676306980251085", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620432_1676306983584418_3509053670633977044_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPsopWQMWBkQ7kNvwFJDPIV&_nc_oc=AdpLPogmELyCS8oQ2VQpNljhFpv6A5iKDPe2pJcc1wBc3mXCN_766nPJeEymMPTKKvk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjo2vtiQSNv2Y-fV1fdQT1MNZOnxFRgmPhmBaQNo4Vsw&oe=6AB2838A"}, {"file_name": "15.png", "id": "901722799636431", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622276_901722802969764_1815211159376625177_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35qvpsMHEikQ7kNvwG6YEvI&_nc_oc=AdpUEzl7PwoM2k8I-_sYC2SVeics5wcP8bUuLntBZRze_PRvv8mX9Z1-s6hv25Xi5iM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKS8_LfKoQQCR8JlwTYFtZgdU_darArHmy-KkWm0R7sCw&oe=6AB2A502"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8.png", "id": "857061003403889", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619685_857061006737222_418002076381847019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uiDy61DZor8Q7kNvwGqw8bc&_nc_oc=AdqERCBRS5GRNWVTfTaXAOKG6W1smC_-xN-29ZG7caqmU9Euig2LK92X2_5CtenORQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXdaUKTzIHkYXRE8Kb6yd-NYpE3En4BoPYotKK1BheeQ&oe=6AB2A8D5"}, "display_name": "Vivid 4D hologram hub", "keywords": ["concert", "dance", "gaussian", "girls", "MR"], "long_description": "Volumetric video just made its biggest leap. Vivid 4D is here.\nForget everything you've seen in mixed reality. Vivid 4D uses 4D Gaussian Splatting \u2014 the world's most advanced volumetric rendering technology \u2014 to place real, life-sized humans inside your room with photorealistic accuracy. Real skin. Real motion. Real presence. Zero CGI.\nWith full 6DoF freedom, you don't watch the performance. You inhabit it. Walk around. Get close. See every detail from every angle \u2014 because this isn't a recording designed to be watched. It's a presence designed to be experienced.\nCore Technology, Real Results:\n4DGS Volumetric Rendering\nThe same breakthrough technology redefining spatial computing \u2014 now in your living room. Photorealistic humans rendered in real-time with unmatched clarity.\n1:1 Scale Human Presence\nNot a miniature. Not a projection. A full-scale human being, standing in your space, moving exactly as they did when captured.\nTrue 6DoF Exploration\nThe performance doesn't move. You do. Every angle, every distance, every moment \u2014 on your terms.\nFull Library. Free. Now.\nEvery premium performance is free during Early Access. This window won't stay open.\nVivid 4D. The new standard for human presence in mixed reality.", "short_description": "The world's most advanced volumetric performance platform \u2014 now in your living room.\nVivid 4D uses 4D Gaussian Splatting to deliver life-sized, photorealistic performers with unmatched realism. Free to download"}]}, "developer_name": null, "developer_privacy_policy_url": "https://674312358-sudo.github.io/vivid-4d-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Prometheus ", "support_website_url": null, "website_url": "https://www.prometh.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": nu
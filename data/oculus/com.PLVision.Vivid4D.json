7kNvwEC-krV&_nc_oc=Adq4eUb1gKSIp0SJuZ3x43_5IPsy3ooe3bF3HP0E8JCqswyermoNQU_A05fGetQgL3I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CoHl4qQBnf0HIEiDE6MElSVAgmHHiTZN1gb3fKWCdcQ&oe=69ECA5F5"}, {"file_name": "2.png", "id": "24957963173880459", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618274_24957963177213792_5729283905419006059_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45z-_PP_Q3QQ7kNvwEn6NI3&_nc_oc=AdpH9Chv9je8XG17Yg2tdnA3siVS5FdjxgHTismbFvCE189uW1mvNiohT_6Yp8qwhbc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34ie6kuHjVa30N3r8slWqIRd_KDFgRC87-wkEs-8vUdA&oe=69ECA292"}, {"file_name": "1.png", "id": "877152798465395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617847_877152801798728_6439813062953149866_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CysukEVlj8Q7kNvwFF6qHq&_nc_oc=AdqeydbhkEzGspen7KeEApGAkR1BHVl9Cc8OZzJLYJpl9MYsFZGxzMrtLDQ_riqV14I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BYRjdxheqoyfQiPAJLSvdfVCo-Az8r0st9_XaSrY3cQ&oe=69ECBDA9"}, {"file_name": "3.png", "id": "1593001388680966", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619668_1593001392014299_6403491631827847043_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bIXKD5fuG8Q7kNvwEb5USf&_nc_oc=AdrYfFXZpYPzID1YMXgwdhDggFaaNK4-wK3eeHa1y6ZAtPTY-qEwooht6VcN375EAH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2a0ncWA8L7_60385pmATaNlIiNCCrM0_t5nUTgxFecbA&oe=69ECBAC2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vivid 4D", "keywords": ["Gaussian", "performance", "yoga"], "long_description": "Description:\n\nWitness the evolution of reality. Vivid 4D is a cutting-edge Mixed Reality (MR) platform powered by 4D Gaussian Splatting technology.\n\nForget flat screens and static 3D models. We bring dynamic, moving reality into your physical space with unprecedented fidelity.\n\nKey Features:\n\nPowered by 4D Gaussian Splatting: Experience the latest breakthrough in volumetric video. Our engine renders fluid motion, changing light, and intricate details in real-time. It\u2019s not just a 3D model; it\u2019s a captured moment of time, replayed in your room.\nTrue-to-Life Presence: Bring real actors and performers into your living room or bedroom at a 1:1 scale. The \"ghost in the shell\" is gone\u2014these are photorealistic humans that look and feel alive.\n6DoF Freedom: Walk around the action. Inspect the performance from any angle. Whether for entertainment or immersive learning, you are no longer a spectator\u2014you are part of the scene.\nEarly Access & PGC Platform:\nWe are building the ultimate destination for Professional Generated Content (PGC) in spatial video. During our Early Access launch, enjoy our curated library of premium 4D experiences completely FREE.\n\nDownload Vivid 4D today and step inside the video.", "short_description": "Experience photorealistic, moving humans in your room with Vivid 4D. Powered by 4D Gaussian Splatting, this free MR player lets you walk around life-sized performances in 6DoF."}]}, "developer_name": null, "developer_privacy_policy_url": "https://674312358-sudo.github.io/vivid-4d-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Prometheus ", "support_website_url": null, "website_url": "https://www.prometh.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_track
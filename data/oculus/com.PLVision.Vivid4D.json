{"data": {"node": {"__typename": "Application", "id": "33931666079779942", "organization": {"id": "3396684753777645", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "33931666079779942"}]}, "id": "25817176304558710"}]}}, "firstRevision": {"nodes": [{"application": {"id": "33931666079779942", "release_date": 1773366120, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 1}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35357123503900852"}, "id": "1474119514332600"}]}}, "binary": null, "live_binary": null, "created_date": 1778293813, "id": "35733205502959315", "is_initial_release": false, "name_with_fallback": "v8", "pdp_metadata_with_fallback": {"version": 3, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "35733494519597080"}, "release_status": "RELEASED", "id": "33931666079779942"}, "id": "35733494519597080", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "33931666079779942", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "918564187277609"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1502841151302627", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vivid 4D", "keywords": [], "long_description": "\u60f3\u8c61\u4e00\u4e0b\uff1a\u4e00\u4f4d\u821e\u8005\u4ece\u5c4f\u5e55\u91cc\u8d70\u51fa\u6765\uff0c\u7ad9\u5728\u4f60\u7684\u623f\u95f4\u4e2d\u592e\uff0c1:1 \u771f\u5b9e\u6bd4\u4f8b\uff0c\u52a8\u4f5c\u6d41\u7545\uff0c\u76ae\u80a4\u8d28\u611f\u6e05\u6670\u53ef\u89c1\u3002\u8fd9\u4e0d\u662f\u5e7b\u60f3\uff0c\u8fd9\u662f Vivid 4D\u3002\n\n\u57fa\u4e8e\u76ee\u524d\u6700\u524d\u6cbf\u7684\u4f53\u79ef\u89c6\u9891\u6280\u672f 4D \u9ad8\u65af\u6cfc\u6e85\uff084DGS\uff09\uff0cVivid 4D \u4ee5\u7167\u7247\u7ea7\u771f\u5b9e\u611f\u6e32\u67d3\u771f\u5b9e\u4eba\u7269\u2014\u2014\u76ae\u80a4\u7eb9\u7406\u3001\u53d1\u4e1d\u98d8\u52a8\u3001\u8863\u7269\u7ec6\u8282\u3001\u52a8\u6001\u5149\u5f71\uff0c\u5168\u90e8\u5b9e\u65f6\u5448\u73b0\u3002\u8fd9\u4e0d\u662f CG\uff0c\u4e0d\u662f\u52a8\u753b\uff0c\u662f\u771f\u5b9e\u7684\u4eba\uff0c\u5728\u4f60\u7684\u7a7a\u95f4\u91cc\u91cd\u73b0\u3002\n\n\u4f60\u53ef\u4ee5\u7ed5\u7740\u5979\u8d70\uff0c\u9760\u8fd1\u770b\uff0c\u6362\u4e2a\u89d2\u5ea6\u6b23\u8d4f\u30026DoF \u81ea\u7531\u79fb\u52a8\u8ba9\u4f60\u4e0d\u518d\u662f\u89c2\u4f17\u2014\u2014\u4f60\u5c31\u5728\u73b0\u573a\u3002\n\n\u6838\u5fc3\u529f\u80fd\uff1a\n\n\u771f\u4eba\u6bd4\u4f8b\uff0c\u5c31\u5728\u4f60\u623f\u95f4\n\u771f\u5b9e\u821e\u8005\u4ee5 1:1 \u6bd4\u4f8b\u51fa\u73b0\u5728\u4f60\u7684\u5367\u5ba4\u3002\u5979\u5728\u52a8\uff0c\u4f60\u5728\u770b\uff0c\u8ddd\u79bb\u53ea\u6709\u4e00\u6b65\u3002\n\n4DGS \u8d85\u9ad8\u6e05\u753b\u8d28\n\u7167\u7247\u7ea7\u76ae\u80a4\u8d28\u611f\u3001\u6d41\u7545\u52a8\u4f5c\u6355\u6349\u3001\u52a8\u6001\u5149\u5f71\u53d8\u5316\u2014\u2014\u76ee\u524d MR \u8bbe\u5907\u4e0a\u6700\u6e05\u6670\u7684\u771f\u4eba\u4f53\u79ef\u89c6\u9891\u3002\n\n360\u00b0 \u81ea\u7531\u8d70\u52a8\u89c2\u770b\n6DoF \u81ea\u7531\u5ea6\uff0c\u7ed5\u5979\u4e00\u5708\uff0c\u4ece\u4efb\u610f\u89d2\u5ea6\u6b23\u8d4f\u8868\u6f14\u3002\u6bcf\u4e00\u4e2a\u7ec6\u8282\uff0c\u90fd\u7531\u4f60\u6765\u51b3\u5b9a\u600e\u4e48\u770b\u3002\n\n\u65e9\u671f\u8bbf\u95ee\u671f\u95f4\u5b8c\u5168\u514d\u8d39\n\u5168\u90e8\u9ad8\u54c1\u8d28 4D \u5185\u5bb9\u5e93\u73b0\u5728\u514d\u8d39\u7545\u4eab\u3002\u8d81\u8fd8\u6ca1\u6536\u8d39\uff0c\u5148\u4f53\u9a8c\u8d77\u6765\u3002\n\n\u4e0b\u8f7d Vivid 4D\uff0c\u8d70\u8fdb\u5c5e\u4e8e\u4f60\u7684\u79c1\u4eba\u821e\u53f0\u3002", "short_description": "\u57fa\u4e8e 4D \u9ad8\u65af\u6cfc\u6e85\u6280\u672f\uff0cVivid 4D \u5c06\u7167\u7247\u7ea7\u771f\u4eba\u821e\u8005\u5e26\u8fdb\u4f60\u7684\u623f\u95f4\u3002\u4f60\u7684\u4e13\u5c5e\u79c1\u4eba\u821e\u53f0\u2014\u2014\u73b0\u5728\u514d\u8d39\u4e0b\u8f7d"}, {"images": {"nodes": [{"file_name": "\u672a\u6807\u9898-1.png", "id": "1646639986613760", "image_type": "APP_IMG_ICON", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619704_1646639989947093_4102095842840503148_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=645GNTYTz_4Q7kNvwEa7yhr&_nc_oc=AdpVkbGiazgGyofjwHqRT15dadlm9AO-8EkExOJYIxzzfMsgASGZHvNoko4wm6v5f1c&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68H84KHNP5UGe2X91xlMAaj1VC4pFagx67wfWMJxrIsg&oe=6A106CB9"}, {"file_name": "3000-900.png", "id": "1589834972334786", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618274_1589834975668119_4021412113609770487_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvLgl_fv-KMQ7kNvwFruQq1&_nc_oc=Adq5-dv0lj-qsd01tRsvhMHsPMqN4Q_PhNKml0vxcU1_ZnFEwa7WbfY5Zjbmqf_yAtw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ytje2RkXyeWslRdvhkkr4zReb5ikkXfMLZ1_wqlsO2A&oe=6A106933"}, {"file_name": "1440-1440.png", "id": "1397766068501976", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499618512_1397766071835309_5251394947510934382_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GztFUrbWZhcQ7kNvwEXouw0&_nc_oc=Adovp3Q-unCupjKP7W29SyEml2pjV3wLDrncj_IdPX2LOVDI5olaMGbADPws8ZJ5OGQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70-xD0jHmYb8zSdJj00NcgD0LdCyGocoq9qr7lOpIVsA&oe=6A106B9F"}, {"file_name": "2560-1440.png", "id": "1397214095188725", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499619680_1397214098522058_8228051704456693644_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7KD4WbM-P4Q7kNvwFgpd0-&_nc_oc=Adpfu-fBSw3xSSFudbLXjlZQtBsd_2SgKP4YlQ1crwQEO2cbPKj2dheeFUxMGbQHoCI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUQNNOwSAOu53HtGjVuwUsqvjBfa955SBV1mMfypcRNA&oe=6A69DFBD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlBUrdmI2y0Q7kNvwGSOyCz&_nc_oc=AdqlFu71_yuMPxRJ2KQilRIBltHaPGYIAF-p5l_uTlNDd2qcMaikEznt33p6wv0qHAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIQjK-T51oIQcHxVn7inuLFKoGldmn0eLibq1Fa5tvGQ&oe=6A6A1698"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K42PdUrrzW0Q7kNvwHFza8l&_nc_oc=Adq91_oVazlLxDt69qvKYPpM9OcCWJbA22XVg0WypBRJPVkBSO_zlGQZbPWlhWN8-qo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK6boIhWNTjKg-brOGkRHN98QrwS-e8rEr3BSTEhvtSw&oe=6A6A1258"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
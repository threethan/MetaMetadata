081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puh7XzpDj7IQ7kNvwGX6e6j&_nc_oc=AdqdYyVQT_Mz0istyRPB05dhAzDpG44DDSX7xBIjGf3K4lcuf8jDmusMnBJybsgHoIc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af32TFP87UfxML2MCTQxin3ViN0Jg17f6HOX96G1wgnRfw&oe=69F613FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzXRZjb0x4MQ7kNvwFLdasp&_nc_oc=Adq0UbHMYMWlN1zwnflJRU6hcu7wkWk2CzDlo94tBogDtkr4OqAPk51ehKy_2fAAPqQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2yQEovOhzw1sWUxFOgIbd5VBrRhdT_OjQrw3J4B4CbuA&oe=69F61298"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaqEYS-H4vQQ7kNvwHoIvBC&_nc_oc=AdqmXah7BBM8ELGcDF91dauZgLZ4BiRTTB2vFjmQ6CIBo1hCxCvAJDA6qLKdDEmKfeU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27SUapVWZpPlkYb06dWgGMF39r8QCSw71DREBeF3sHCA&oe=69F60E58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
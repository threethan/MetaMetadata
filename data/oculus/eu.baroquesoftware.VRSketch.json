081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMylTDqmj0QQ7kNvwETTxDS&_nc_oc=Adq6_gYHyMXFHBpNdcLji0A0O8jcmvgGp6liDfn0PSkRk4986hQGGhyl1ycpHq-IY_M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsoMXf3DoCUobl9Ml4ABPjOLsBOdc65deItZQtrQo8iQ&oe=6AC50F7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kiO_bdRMA0Q7kNvwHmvsLp&_nc_oc=AdqXBn0DYqP_v2qa19WZOWMeUj2PnYfS4ui7-IMIXQoBLGYEXEx6zDXfHXIMzwza8f8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8d6wd6-tiGHWrUBP-4DbcTmehmChgK0sf4gRo5Gbpww&oe=6AC50E18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeKrfidYkkEQ7kNvwGm8szh&_nc_oc=Adp_S_77q1PxIkqLp2nIR26cp3YKoON4h6LnRYPpac8ainDYPQu9nAzjJlwSPziJkds&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJCqRgZFXGa0K5DvlowsH7R0LHyEW2mCSqIsnlURpOpg&oe=6AC509D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
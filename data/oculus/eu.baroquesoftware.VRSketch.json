081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0Pt72SfS64Q7kNvwFwPwKj&_nc_oc=AdowvZkiTxFMY1r9p9ht4YMhOIFLuR-1ZGjj0XQEbOF7INDRMCcGLfY7rXOzAvAfb1U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuF2YVMYg-I4Mdu5CE6R3EZGToKLRybPhn7L_2qobJ3A&oe=6A8983BD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGvrOnxFkeUQ7kNvwHUXudp&_nc_oc=AdoMf3mhuPyH3rz_GAhRzFfepG1G8puJ_Z8fAo9eA4D-PMGH_0DpVFHNCVdzhPD_IUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcUu8lzE8p2go_saebKpSWvSf3eDtR1UuRFTe5CdUL7A&oe=6A898258"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fYwI2EAZMkQ7kNvwHY4T-_&_nc_oc=Adq9UPdYe1lRy5IysMg-pwgFzF5nLonlDm20r1s6hn_R7aJQ1ArEzusvE-v92Qv4OWo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsMUEXpEhpWvM4Ad8yaCeWCd56IpuRsYdQ7S_j0ckmDw&oe=6A897E18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntKN8O0mmc4Q7kNvwEuBc-5&_nc_oc=Adp029iBPRqYwwI1E66MoP7fsydJ2OmvmMH5CxljNNkQcSoyA9xXuieZvYAlMI1pwRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlNtflU9eT5vFSFwurust2AaNraVyn3R9A6slXtruImw&oe=6AB7E07D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3tHTgu9M3wQ7kNvwHl-mBn&_nc_oc=AdoThXjluWnLfBCUzvqplLt88X_bF2OrTQPY7Uyp1ev1JDDlqXD_T151SkdbP7cgWyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnWU7ISU8LDH_hvLEYcWART4ZbSdgS1JCiGxVBrOI7LA&oe=6AB7DF18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C76ECTrDZLUQ7kNvwGSCeUo&_nc_oc=Adqhrctb8LeKovl_MwJ1-tFGOD41S8mzKdrH9klFQ4Wc1T4lUA5qQacN6yvDeQQ_aTA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrig5s4aH9Li0FLbN4ASIBVZi9qPBS1NRLv_bzsnSdAQ&oe=6AB7DAD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQEyCPZvb4oQ7kNvwFeDcik&_nc_oc=AdoOEevLKNqvl9jsLxj6Lnrg_GzSCbQ6ajpUOCETgrTRULHflKG8Nhb-5Ayg3ynGcNE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af852IGOQgHxxeNxrCiSmDoDuCdYGnV5lae_HCoqjSl00g&oe=6A21957D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3oJSYXP5s0Q7kNvwGaX9Cn&_nc_oc=AdqoOVvQO6fS_IHvBP6xMK0A9I9krgpV49lFgdXRI0yV98RxR7xj1nQQ1xOiFzlS4lw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TCUkZyU9Lj77Yg1Ffz2W14f_LpY-Xbqj5XQ7hrRz7Lg&oe=6A219418"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7HrQxhJE64Q7kNvwELElLh&_nc_oc=AdqtljuQQVMyftQyuQzsuEaMedDt06Fe1ZjRuQjFX8pvQsL28fQA5pqaxvN1-GMToHo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MM5PPvCUBzgE15qMbak4uoeLoJvwjMFUScXYHF7P3dw&oe=6A218FD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
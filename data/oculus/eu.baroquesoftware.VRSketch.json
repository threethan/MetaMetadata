081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMylTDqmj0QQ7kNvwGZIPiP&_nc_oc=Adp4MYMcVVgfoPPv_cyrI-o5Y-NDNItKBnhTAfF0mJprNDL8ecpzwyqQCGXV0LcxTlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbKN7yZOcfD1-z4VcE2oXY_sXXVuFhUJPB6JVRaBU_eA&oe=6AC26C7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJLsKyNvxvAQ7kNvwHAhN1V&_nc_oc=AdrjK6nQjH8G0P2_kFbPrUpgt_LxEcCTjscu0jcRSjp2zfEaE0OsZTUjY_uez43Fy0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFhOYS3NRNaktNPg8RjWTlcgyxyZV0w42QXap6RVKwjQ&oe=6AC26B18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIy_QYtdqBcQ7kNvwG9rzfw&_nc_oc=AdragO_brVg6sJLPRMBihl1a5wV8pHwLYhn52FySKblM6rKJ8-47wIGE3eV5OgRkx5A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxDHR3XfDGU93wjM281eFK_ZH6ea8dwdrKRRMBdTpXbw&oe=6AC266D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6R8f7B2v_gQ7kNvwFqD5BH&_nc_oc=AdrKXbz6KT-GvfsmMV62obq05jzmBAZ5qj-VUAihGBbqP2O6Rl-iz0-ztaXLgMzJGVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEl_jsN7tI7v7SxugjnCO9WTdkFQ6fNh9zPrYHamMrGA&oe=6A4A73FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhfUbxvDYHoQ7kNvwFQRVUd&_nc_oc=AdoX1DS-Rim3vGjS_U9k3Mg4md6yyze40YeZIgdf5pDdfyjFwG9NoiMKpRlET4FXQKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPwGpy129_iGgaFTfafuyYEVd2V-XoEmB3k7KyEVZ0zA&oe=6A4A7298"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3nnQaHxJmkQ7kNvwGPsA_O&_nc_oc=Adrbmwhzf9k9nXxaPRB6eUEEsrN0HIA--YaBQJg3aylfTqDV5In838vcAY48I_Fuag4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCAd1D7IQsXygHT3IcBIwYP2IugXZ8D_BMCb0_ydvb9w&oe=6A4A6E58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EX8sq-8dacoQ7kNvwGuFqYH&_nc_oc=AdpnAKeThRBZw31tJDAu6QSsfL8ADy0pNiSb4QFbnVdW2R1bLLY5QBfPRuEqUa_ymgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZZng3UVOqZkd-HznOHo4_IOY60Hqn-rSe38X72ZZE5g&oe=6A009FFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzQTvjdIzP0Q7kNvwGlZ6B5&_nc_oc=AdoW2cx2MgzAvKx4DtG6AwkSOsz-Ame85f-pnUryhitqcsP8prl5HfjKQhh1eiGgc80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vecim4CRBH11lOUroxXeiZW61aJOUoFJ4GmzrOoUlUA&oe=6A009E98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8DFxMNzq_MQ7kNvwHWfFKU&_nc_oc=AdqN12RUKV6rBB2FALNV0l40xSyockETud4G7bLVwLXZDJZIFOtcNzIaCuFV1JY_8kU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HqgJug5HZ9133mZORekW30Rdff45vnP6IJ24f4Y8zdQ&oe=6A009A58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
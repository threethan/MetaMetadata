081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1PYusDXuaUQ7kNvwG3OLOa&_nc_oc=AdrDd7F-BVUacq3843zKTxj0Isi86J4r_TMsggMlXCibrD-d4aXmh8hhtzK7C5wy9BM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMb66EGyFga3twUsyiw7zg5kjmMv1Oa0OUUFoRhNavcA&oe=6A7C54BD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-S7bbyxcvgQ7kNvwGz3n-G&_nc_oc=AdosLm047edkqHSwUf8ycTwUcXpS25lQ2U6VJOFWhvJ7JGdhHjKvsjsnSHKw3ZnDilM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmuC76B_85Izst0bQOmkQxPfK_Pylkax1ENeNTcbkqjQ&oe=6A7C5358"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVPfH0Jk-WIQ7kNvwHSFmC7&_nc_oc=AdpWeRvppIkAgEC8MQZ4yhVVMvtFThLndOA2HGhy4riw00BmWG-uO5rFI8KlPncfQVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5BVgeQZhPcrHQwGA471UrET2tLCXKTLe2soge4wgywA&oe=6A7C4F18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
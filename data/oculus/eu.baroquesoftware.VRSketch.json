081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHwZAmlD3SIQ7kNvwGWzKlf&_nc_oc=AdpQFYc9T5QSjo9CbSS-fmn1oONRqYdODxJTF-vIE4PNkfrp1NuX48sEAQqEchFPIjs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK9kAXBm-T3btXGEnUufY27L_898cRImPH-jGza4kFzg&oe=6A74A3FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZB63cYtK00Q7kNvwGj7_CG&_nc_oc=Adp-OoDEMLPuXecbxdwUe0ls3ToIYCyuS2kANU9IMa2FC1xE2i30YlF477mVni1lAB4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhUqJJhZPpxf5RtpNM4V6ji6OqY62MsxY1lPfsXsK0rg&oe=6A74A298"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2XaOwnBT7IQ7kNvwF1gety&_nc_oc=AdpOF7Kv-EaVpC0-ftcaYKDDuMDBxz4j6-j3ATOrPSSmdIoNu5_GKhmi03yP0sWoWOI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGN31lcgDxT_hkEfZJ36ZdQz8JzN1qQZXYkZPgYkKo1AQ&oe=6A749E58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
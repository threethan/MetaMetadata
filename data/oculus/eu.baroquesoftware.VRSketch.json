081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72x8RQ8VQ-MQ7kNvwHrKWOa&_nc_oc=Adp3ZoKPVhUdlSRnkwmtoAgdFtjkNXLPQQ_vjR2xJwKypzVdnqFy8XYi2E6ETC_nCNc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B9iSQis0XeOmxIFS7yo9BliBTScpm8BKy4MMI5gDddw&oe=6A31677D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8ZjhT8h0igQ7kNvwFMqmm2&_nc_oc=AdotTegn2TSL8V47ZbCUL0S5pX1RHwsK4tVDBsnFomfxnZTx5TvJ8uDWg9rGJHyeGsQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-74QOxh4RThJrmeVQjXpPK610M6XYUnnpNWbXWNzQncA&oe=6A316618"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQKF-a9usgEQ7kNvwEIZaus&_nc_oc=AdpXvRteXKmk6yuIgkc5Wm5eyrNXb9C3ficoaUOgDBHAg44Joto54boAsjWLak_rC-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_moYVx7R42c1bTxZuSma1rcUC6yNKcZiElVwEsDJA0pQ&oe=6A3161D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
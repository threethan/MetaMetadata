081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7KD4WbM-P4Q7kNvwFat6cF&_nc_oc=AdoUYhlh8VJhc8MRjFe-xA47KIIlgeGmUjXaf_d4rIU85u8UGt2Nqw69papv58Mo-TU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCZOjVtOBygGA20zogR3kfYbVW49xQ24_EcYgat82PkxA&oe=6A6774FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMAaXtRYJBcQ7kNvwHSMqrS&_nc_oc=Adr6vT_CXDL9LL358-EjpJgFoOHErzbfGVLTsTi4RLrYriKTpp0q1ZqdeHegnyY5O3E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTILWGDS1WIlegs2RG7yB6aSs5xekoqA-eJ278_a4tCw&oe=6A677398"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIZxj69Zoz8Q7kNvwGEqbJh&_nc_oc=Adr9TzjvKm8yytYXtrCz5IVZMdUx648Q-qIIvX-tHuEqmE1crV7MfI2r1tEeAqfaRwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2FxyCLId79aO-jPyB0Yoh-xzMtIc9lBRkBsoUNIf20g&oe=6A676F58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
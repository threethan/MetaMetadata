081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2m2OnoYlGrEQ7kNvwGXxQ9d&_nc_oc=AdqwEdGypFtV6DAWo1DFRpe8CmDiGbjKYtUwfB1Rf4s0IiyI02kQ8Kz132ck8tnNXnI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ktaWMBKmzPyRmhlrTsHRsqwgPw7DrfMw3emvEGyI2Zw&oe=6A355BFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8JavE5ECagQ7kNvwH2MLzV&_nc_oc=AdqoNDrvDcd8WuT4LSG53Gwdkz-3voAkxC_RMH29VACXKBLLXetMA9CbiTyLPIuGEyA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dmnngrFvGZ06GBwmAeBBVBZfsPEciOWgCyeOJbS3MyQ&oe=6A355A98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NSgDgMQWoMQ7kNvwHhSx6x&_nc_oc=Adrxl07Js1bbpPOherWeW8YXZ2xQOd1BBKEs-7u0OuIB3UeLw_Y6g-KvW8bO1ifXxFI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aW5PQe4zBUy5MswBo5AYNoPUSIY2hafEIhhrsA0zZVw&oe=6A355658"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdY1va-pi5gQ7kNvwHDBX7t&_nc_oc=AdqbTC6sgVo5vxltmo_Zm0SYRvKr9vU4HYw0jyUpiBWMPzzMVqBguW-LBYq724U5Mkg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAn9vLOyXKL6TfSIMDgapcAKnh3QsgNJ5eTeQKWnKm2Q&oe=6A70773D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NijhgMFZeUQ7kNvwHXIr8S&_nc_oc=AdpBfF0yORIJLbWDJjRvruoqXB311ycPlESG2hMLds-JzKbprYxIgq0sjz8wWRfy2Rk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMmdY5E57SzWUM1-aJAnpNub_ZhIXl62iDFiAW6ZowvQ&oe=6A7075D8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSKv9KcCWZ4Q7kNvwEe98hb&_nc_oc=Adqf9txclG1g6m4lpP7LCL9kJFP-k4NY_8itSYcKBcrJ2vCAoWI1zAuJuEilaQROZ7I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW2Kz95kGKRzb6G7xL3O3swGvKvsuiGsHYGFelNqotLw&oe=6A70A9D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
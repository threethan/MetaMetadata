081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpShCUVN81wQ7kNvwF3HfoT&_nc_oc=AdrK-Ce0s5XCzNgGbDTo2vi06JFHnZp1Jf3qJ8EQcTvqO2erpO20xdfqpvmNYWs1Ywo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90zedSTB8kmDUCMABwZcNWvW3HvZkgGv-KYztYWdsh8A&oe=6A2589FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q51C4GbFB0QQ7kNvwGxAgwR&_nc_oc=AdpB6vvXlhfittdRPAUPVHq8o9-VPjZ1mLyK_F9ddR-QKBbuMPFR1mcAicqWtSbuFPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zeI0lYZl_bgRqSpCKK2F_xv6tvVyGaR8S3Q92UChZCw&oe=6A258898"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cy27QT1ZZxEQ7kNvwHqdyyD&_nc_oc=AdodQVY--KWD4UJJ7VIl_w9Tw-y29I7W8UY-xs_UydoJ3JDTbiffSi6zz9jIdJjUWmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZGdD9qnb7jxrWc6I5GbsH3s56MIo9gqBYCnUc7YYC7A&oe=6A258458"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNkIhpaxIH4Q7kNvwGWSkdl&_nc_oc=Ado0HRrYkzlFKVYCtgOjWsOqtHSrOkdBWNQrv2jm4dgrOocZynJ_stHumMl1etXSBus&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa4_UhoJ-IqkeunULVERd77itdkbLoAVlKXhjg2ALWRA&oe=6AA2C87D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtElfD7V7GMQ7kNvwFYHYIZ&_nc_oc=AdrP0rlOtD6HP3ODoMradqfYRHxyJ3fgt-Y9hUPqDpnlNUfDilkwAnN3g5d2sN6fHU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTKIGBZob8OU7bEHpbQJkj70qyhKmNsRfcsQ6U-Cnr7w&oe=6AA2C718"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la-wUy29Pk4Q7kNvwFKay7-&_nc_oc=AdqgibQM9BR0L-PrgOasU4yj1GzvTczOodbg-djTUrPYLKZe2BCIgb3o2leFtSaXk84&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCX0S79JsDQnplE1343sXh3A3-Taxpy-JykrlsLZfEBg&oe=6AA2C2D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N1Dvq9vHOFAQ7kNvwFqTlJ0&_nc_oc=AdrbgD-mB-5-jtfEHftkpl5gBmvuz4kpRhjbQqRAjXldCo58aR9An0doebpyDSoEq1E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9dRDLnMOFOi1Rh9Jx_mS-opNU8FE3X2hP7U9rlnH8Ww&oe=6AC11AFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJLsKyNvxvAQ7kNvwH-VBoc&_nc_oc=AdpYIg-ZgwDH0T-gg1M4nXpXFHpSswVQEVs2s46s8IPR2fisTRFB2_0NXpgYPHU4ec4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQNsAxeb7TFwjYHi66i_Nc7OB7CyrwP3FuIdwVsQhOHg&oe=6AC11998"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIy_QYtdqBcQ7kNvwEX0kVD&_nc_oc=AdoTz-hB4DuzWdmYNYg7Z-oqTkvHdBJJhaB1hw7pEE1CytfqlbvNART_YQ78Q2sR37w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnBxxstwAMMfJjglCTqy14Bou9dQARYwj3xJicZorC2g&oe=6AC11558"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
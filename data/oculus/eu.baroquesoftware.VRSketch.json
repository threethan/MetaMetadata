081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOaKxCBlaoUQ7kNvwHj4uhm&_nc_oc=AdpRjNnazAg6lFLiIVapKSqLlAhZSM-eGbUQdLDVbHfordS5EsN5bYsU08hK2o9GzhQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MaeQZZEsxNNXKqK1W8XumBCRVHlCpsX_NgN7rADPwQg&oe=6A0B2BFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VC4pwg9G7CEQ7kNvwGJQBsT&_nc_oc=AdqdObQHIrtiLDsnC_E5tYmar7YGSyubYuUNfkkPKPd9NSX88QrWHuHclnd2FT1S8s4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SH8xrrTFicJlGfGUMo1-hOpRyHwNgc5-TUhpM9hUcEg&oe=6A0B2A98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DW29IKcaKuoQ7kNvwHE69BI&_nc_oc=Adpa0J4s6rUdfTG8n9aCLTNf8oJ4_CZmdOhBM0I0IcUrUWO78cjHR-7VrtJUp_H0V8Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75dseOvmdYCr7gKySLiBiFx47o0pLBMark11IYBGPXvg&oe=6A0B2658"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puh7XzpDj7IQ7kNvwFDg5Gp&_nc_oc=Adr7trIriMX0wiNodmUZj-p5ABrFP_lqVGGgfqaTkhrfa452B0PkEGQrYBKEfI7Fbe0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0RwOZW8RBjhnpjGIMXJVoZq1Jpo7BxZhROlx9H_kb-Bw&oe=69F7657D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pefQ5PE0heMQ7kNvwETD0ou&_nc_oc=Adq-VTOMVISkj-k4g6-Z__xWwCLrw03zW5sr4eQJY1H9EpPYS9CfMBcRWddgHrNTspw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3EX65reVrqPpzHMbnuFGaVXUo2Iekl43Pfwc9s3MOBZg&oe=69F76418"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaqEYS-H4vQQ7kNvwGU5Wrz&_nc_oc=AdpAmhFuhosoQxQwNxnQen_W1FzXUpdNE4Im5M8xWsnRuk1toLDnPWxZsrJ4BIvo22E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hfmqX5AL9QfLw_z4UJBJBewn5f1eK8Zh8MqwpVs_3Jw&oe=69F75FD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
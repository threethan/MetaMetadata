081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bz8dutFSSiMQ7kNvwF089pL&_nc_oc=AdoN2dSheQUrPqfHMtU15e4azDqNKZfsgqBAT5Gjzxu52_0buK03pdm-FWje1WVIZHc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F_bLc0nV03pYPXHVlYoDGNLYr_iMfM0PlgtjUfSeMNw&oe=6A19AC7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLhCwt50mgwQ7kNvwFpelPJ&_nc_oc=AdoS6FLJg-hPG4USKKMGqUwtPFP3GwLsPTdXpyDO_ywRIRgcx1zYSHm72CS0gyf65N8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MZTlqSunRXm89kubcx3SvmpD7E0Mn4liXwX-jBv155Q&oe=6A19AB18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohscIMgezp8Q7kNvwEoft04&_nc_oc=AdrEZnle3byAbC9uD8LkiszKLPAKMSA0KPNcpbhy3ZsiMmqsO6cJp9XIx5Pn8LyFNyg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af57bcSik3Go5z8LSi1bu3m7rBjPhwKz4r0-gMsu0LqpRA&oe=6A19A6D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEpHfbdbkYsQ7kNvwGM3nvP&_nc_oc=AdrLg3rsgBLnID35mcJzKDBLMHB4WsrxZnp9OXX-Ks7Hk3X40BvE7P21rJMfqvvqHmE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsepxlxr5pqtDFVLI6wsxPF6cg7vPvF4Uzpar8v95axw&oe=6AF333FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RihlyqtqiOAQ7kNvwE0-DsW&_nc_oc=AdprUyBUcN4NF_lUL5jamTGulvk9mXans3IxQw8UpiIFzeQJjPPWFjUj7jo4phgKFYk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNXEPmFy9R95Bvk3xxCiuztbTnMCcJet_z4l6ENyaZPg&oe=6AF33298"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrrGOlQuOdsQ7kNvwHU7oKT&_nc_oc=AdpdQMmOic2iHO9Pok67NBCLYQC5xyIwn672n0iPpUt4rq9TpH66tJJ5z244i-vdRFQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrIbBTp9LfgYFulvPHlcZEwxycNA8cRSzL8PBX4pnVMg&oe=6AF32E58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
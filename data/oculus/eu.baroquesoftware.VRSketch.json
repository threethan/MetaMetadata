081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8PyAZHEFeEQ7kNvwFquVml&_nc_oc=Adqp88DNTDfhv0cJaCaxMQ6mocmMfAAzNW8_fEV5AAbSC_-vj58Y-WG28nrJF-icJ5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pFi8xkyQr9ZZsg81rGajQDAheRHom6uOZ1DSkuuh70A&oe=69EB87FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWcMq6UaB8QQ7kNvwFUifpO&_nc_oc=Adqmt-cQjpZEB_s3WDa9-P1D7TKhS5q3t1jd-CmbFdFUmOEqhHjLoXq5-3XH8bUeFn8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08uOXd3zeIzFApzhU9OOO6f856seeHcm2o8N5MeT4jAg&oe=69EB8698"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKSPOosq6I4Q7kNvwGU0V9C&_nc_oc=AdrCaA_OuIAuu-p3Pcl8ImjzU0McAXhaWurVa5XeyiOtzj9tBrtY3Tsub4oyr1vzqYU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aJZ1EDlqMjb7tp-qSCMK-ZVxfIYryafK5q49NZDzH8w&oe=69EB8258"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
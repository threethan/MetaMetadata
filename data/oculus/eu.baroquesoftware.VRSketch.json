081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCOoHwsHuEEQ7kNvwHk1-Vf&_nc_oc=Adqo_eVyxHdVuUmcUfa4FL99Fk3I2KPujIC8ulAz4SkrYncRMgI3UEUwaeHt_WfW3ik&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRwjzCiQpHBltrpLkbHUqJ_GaxJHXCn5Mar8749TvCuQ&oe=6A54FFFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WaaVfdSOGwQ7kNvwEWiasK&_nc_oc=Adr4xVRqA3jPU1z3YbdYKMQDaUlFziKNnicrEUJciSw5Dc0CpgRS5rz1wSKnch081yk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcP4yO6OudgIqnZVQmrvLgTz6L2Oj5yhfkXVjBSp6Ghg&oe=6A54FE98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNYAIUCSYfcQ7kNvwGhRvTZ&_nc_oc=AdqeVBqliy0_ZYhArRXCCAr2oLeFSqlIDyq5A_y6WNXe57fVXF9jP0UVMOKddVGwosU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwjq6i1rexTrf89edhAdhoEijZM8TnP0Cf9odFU32odg&oe=6A54FA58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
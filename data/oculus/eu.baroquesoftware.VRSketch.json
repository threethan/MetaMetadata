3382418930592081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGk4LXHkkucQ7kNvwH09k1W&_nc_oc=Adps4_S4ExTWCr2erTuSnCJMnV300UGWNgc5Y09FjaguBBSsEAQpuy1KL4WmBnvkVww&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEglRXjTfu9kZ06OYcdLdybRgViXzo5jXAzG1xPYw8hyg&oe=6A8D783D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrITHGPIq7IQ7kNvwG7OxCJ&_nc_oc=AdrPbqT7qzIadZfFwSdcS8rRiGoC5SYyztpdx6u3DBLUt0qNf1uGSPA1jPVBNr9TVJM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBVOAPvTueKKxZr_xriNq-UTqLXS5PTcvtUfe0crTO8g&oe=6A8D76D8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W21QPQK7KOEQ7kNvwHdfiNW&_nc_oc=AdolKavWE5DgdBoyjll8c5EIRTlvEbkqDlaAqv_XKAV8lZyh4-EBgu8ipSJoZ1csd6M&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5JWphGcoUa_6dpj13jPIK0uG8XuX2wti_0hTaq-DYmA&oe=6A8D7298"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service
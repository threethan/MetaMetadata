081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEpHfbdbkYsQ7kNvwG4eGsr&_nc_oc=AdrP2fW1qkt-ndS2GHuEXMXUqcfgitUNdFQbavlMCgmNjTHKPcUr0H3IHTc8Mfc8BFU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6rkzttVJW1seNIVdRQRteB0Yp2X2U1Yb73IfKJYV12g&oe=6AF1E27D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RihlyqtqiOAQ7kNvwGGVRPa&_nc_oc=AdoLK-cA83ygNBMvkLhDRdNTeFkqnvUB-skk_WufKs5DA7r9uE4Jp537ExSgwtztAz8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRarTmcHORLrx6LxgLVe5kWr_D2i1JpcIzGKys53x8S4g&oe=6AF1E118"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5jDoZ8vfjAQ7kNvwE4dHbU&_nc_oc=Ado-p8wnUvZyH84aCTT7kIkLWqEcZqpn586sHRPTaicUsLFn1uQHePTADE8OLvXduHY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToykytDtq2n5tvgMbeBajGZfMT_-YAhNoGMkGCr8VgdA&oe=6AF1DCD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
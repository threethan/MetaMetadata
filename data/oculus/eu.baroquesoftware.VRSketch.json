081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8PyAZHEFeEQ7kNvwEglcDg&_nc_oc=AdrjqWYmcgj3rS_OA9h_elWwShVZTFre016TeanTvecEClsfRxtijH1Rhx1nf_AlO4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b3vNJwFN4Su_IDYPGHud1VJ7RYqCSv4NA7qnZhnYzMg&oe=69E8ACBD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSekGxfj9yQQ7kNvwGnelXP&_nc_oc=AdrWwwwWRzaqBzHjIfS1jQLb3PHRFoc5-aUsKcOzwjHen3nJPQl4iDVoDqzE7t84Xxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19OZHs6cZpxb1Y44Jwl-WnX2cffG8bZ4_zYA_a7ait_A&oe=69E8AB58"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My5LOV62Eb8Q7kNvwH96tSW&_nc_oc=Adr3nrYSBbYazKNxWs3ptgza3gaNNvF-7w3fS73Fc670TswZyGzo0yyZHRGIBGaYnRo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wclNzv_wBggsTZP0otu8DgK2DYoV1aJecHi9ZiEufnQ&oe=69E8DF58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
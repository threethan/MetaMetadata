081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSKjyr5A5s0Q7kNvwHTS8DY&_nc_oc=AdqNta3xvOwr0B7PZZRVVkHKm6lTm7YGIbCnhHeUzs6inKZe0ioXq7oD4VJJ6zdC1NM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzWI8P6V_G1p9NMDo8X-F4lzohrNMyGimbBpKAHfZLKg&oe=6AE4B37D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ko9auVnIwfsQ7kNvwEWqyhq&_nc_oc=Adpo90tW0AwC_JtHWddlCwyFF3kFvXVAQUouU43up_LS3C5KsL71dFBrYNMdTlPJUqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn3YMRX3aTPDi0OHoA2SX99KZkg0e0nAVGtJ3AnKZq6Q&oe=6AE4B218"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaFuBpCon10Q7kNvwGXIW-g&_nc_oc=AdrqqeE9NtZvg86Y73EKCGvL8V835S_maWm9br9UWqQHOSnSpriiBHYA1Qu7WID1d_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmNFv9YWZATB_hyJ4jXkxcW3c-QFRH6bFYICIp1nN6CQ&oe=6AE4ADD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
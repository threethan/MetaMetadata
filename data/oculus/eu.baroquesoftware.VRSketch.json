081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ar4ApSSnpsQ7kNvwFp2EV6&_nc_oc=Adr47z1qmKsmK4gKqtz-UBoLiE-rsqNsWruhgmxyQDuqmeRTjGjhpnGF3TRzxiAWsvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArnjjYtFDuUtZHQwkizVHy-s8AsoGM2Sle9O9VwER7dg&oe=6A64D1FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QS_bQQfj2IYQ7kNvwF0Ouwu&_nc_oc=Adoq7X9mmlDTPdGD_X9A8Xy8_vOuhlQ42amjOhL_486s3YIv2uHR1AIZxjlLe9GyCyc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzjNsazyKixd4qlB6t9IahU-ZRE7Y1UnNu9ChGOYDu6g&oe=6A64D098"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIZxj69Zoz8Q7kNvwFW3iLu&_nc_oc=AdpYHR7qROIisEL6yMDYBm73Krs6ZNpr5szCqAS45o5QduvCLol5AA5mN1r9D6t2Gfg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApn1ZZFmp-9x7H4PAz-UnV0-CJ1ckMI2UutWgxap-JOg&oe=6A64CC58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
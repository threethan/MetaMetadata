081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtfQgcNtT9cQ7kNvwFqh7Yk&_nc_oc=Adp1e6R9Sj6X2-xajTD3FK5knWeixsR4msNzVpE1xbVoxh6Sh4edz5lRlMm9w6W4d8Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnTs2_NFYPx468qxdDfzG12MpSYld5TwJSV82PNRkD1w&oe=6AA0257D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V94zAGTzchIQ7kNvwE8EjvW&_nc_oc=Adrp0EKUadt-bKLLhvAijlt5s8GMmxKCpURI-wZUKwqbyasTxlNLNSv9ie5yfx3rjKM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRmwo1_e5qZh0Ail2Pwn6e9r4Z3ZnYQFiPhTzQ1zvBAg&oe=6AA02418"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=la-wUy29Pk4Q7kNvwFbayVR&_nc_oc=AdrcvhDSmx9n0M_8EJyxkhC-FHptaTyQ37gpoW-zupOWdjPaGPLRxosAC6HUU35V2SU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDXgZMbNYgXAN5WMZTtQANz_Vbcu2pwyZ5VHuPm1yVOQ&oe=6AA01FD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
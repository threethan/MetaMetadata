081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYpTWtArnMYQ7kNvwH_-d3y&_nc_oc=Adq-hoADBm-co8EDs0bMZlBiqNUD_OO14POUoziuxCqX70MY4pAyUz1xKapngiKCEk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvbGI50JjOL8QQuCONs3BkSTiIk11wunMrvP4PLMXSSg&oe=6AA80E7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5U96_Hmqe8Q7kNvwF0ggvX&_nc_oc=AdoZ5SZFm4Sf2gUvjeC6cMv9Iu5wOPhsAR8OitI3HlNOu9bYW2q1Z38-icucyHsXiIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRrYPcFdRCjnf51d8pqUWqNBC3-eJVEa22VKb1qAM9ZA&oe=6AA80D18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INeUIDt74wgQ7kNvwEAR9Ek&_nc_oc=AdoGYviP8B8JhGUX3W4r133cqeULbHhTtNnbVQfTrhlIKUvPbe6pn9JhgD5QyOmMS0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUFouPQrQatgRll5cEMvUDh5a4ZSw8CN3pAHSNrsZ9TQ&oe=6AA808D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
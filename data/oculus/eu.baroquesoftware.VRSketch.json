081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCOoHwsHuEEQ7kNvwECw7PF&_nc_oc=AdqzJz26M2PC5O3o8_9e9ygZO-t9dNAGertynltb9Drl_R9N8XP8LyBuObGXcFqb6Kc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSAuyPJgmAoqVbpS4PDmDEpPb-_Tvg86Uje9RzIdJBog&oe=6A53AE7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-WaaVfdSOGwQ7kNvwHLYv8b&_nc_oc=AdpGrUW7sbcV_l1Z0Xn5LItL6bbpMIG83ieNOInx7UkUZn4aWIspmyUccd3uyjI-DMI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDopJZkZTUbU-Vky0i5ok6ST3JXRu2SWWXPvEohAwBIdg&oe=6A53AD18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgRrSn6sxtIQ7kNvwEsHYJp&_nc_oc=AdocsOmvwvGX0E1pjD-k8yVMX1ND1jsoQZFr02iaaMg66UPhojn6C-7GVngd8VXyWJs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1S_86i-LGezQee7i_wngUdeWfTArQ3QEPWYRyEoeJuw&oe=6A53A8D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
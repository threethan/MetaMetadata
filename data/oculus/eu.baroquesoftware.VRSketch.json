081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6R8f7B2v_gQ7kNvwEqU6KL&_nc_oc=AdrNXA4k3yZrt8DAVpNxnP0kviE1BwZ7fWv6hrE8RfQOY8mHJoONpCdHMjOi3SB6KQE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-unpjqxaOrlsmA4CcoLteqaspyJUgbQdJhL1fKub35ug&oe=6A47D0FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Tsj9hsLWsAQ7kNvwFIRvil&_nc_oc=AdrBKaoEaDDhIT5iKuPQX-sQtTzxp84gBr8EvfYXRnGaH4V0jWphZwXhO6uuMZ6nsOQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-C1AtywaKRPe8RGCq7rkbrOoarxizwWAfo6FgYRuP12w&oe=6A47CF98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6vZZR3F-1EQ7kNvwEyzlsn&_nc_oc=Adokbi0r40tl6Tb99-A4xgm0MTh_bEWgvpvlPkTHUvHh93Oue1eIp9lJfPML2FScSdU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V4jvRvaPmydbiYR9OBB5F4g8SpJAEMBettTWQxJ4IYA&oe=6A47CB58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEEjAfdcDFoQ7kNvwFo02pp&_nc_oc=AdrLeC-iGPDkXbAwpk3F9sxiacoAE9Tq08v0yjYc5AFlJGadeG3aOX69NYxKNj7ek7M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHtm3GEkVFqBzhYAtGRdiTBMja1IJ7h56BzMdFa4LP0A&oe=6A9ADF7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gYOA3qnck0Q7kNvwEfe4VZ&_nc_oc=AdoHaOdCcV8TPd9CSvuNieTeOOIP207aqJ_D1dwhyBPsCodBldJFjnSL2AA-f9KDcWQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyHMJebNDyEfeD6UI4r2jE9YPpB4-34uQNKuREDw0nDg&oe=6A9ADE18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P4ke7dKUQIQ7kNvwGquDJD&_nc_oc=Adr1IiXoZCbA7PpNkuvv0ki9Jytnt4cnrnjxE-BNAG-BCmsPBtJZK3-xJI48Lzr2_AU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwhsPOwvBR7_xjs8CiMEkTQEzOxHrV1w0wgPSoce8fXQ&oe=6A9AD9D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
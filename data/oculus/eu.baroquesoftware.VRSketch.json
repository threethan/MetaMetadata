081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUczeK1OqbcQ7kNvwHUK7ji&_nc_oc=AdpM8c4F4npun5zACgVYn5XTwequD08IamiBTuQm8Pu9i8ZGPIhzFZuZgMqdp3J0rmM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ik-uW0u6PMay8JkKfoChZ4vxUnYD5OB6E3dqK0LhW_w&oe=6A1071FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiC0hqKIQL4Q7kNvwHOCKn7&_nc_oc=AdqtmMaCS3plkL50dEoOPsPwe3HAoxmJ40F2H-sp6uB0MGud13-cYo0uEX5wV-6VGK8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6s3Ono_7mPq7nAH_1O3nQEcvHEFNjQY76_bHAWEZln9g&oe=6A107098"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0Wh2hw1VwAQ7kNvwGTOmx4&_nc_oc=AdpRify8HttXlNFN6GyybRC9BKSCQy_RmlKCddwR3W--R1r_hfdW3KteRO6qn4Agw58&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iNOgTQ-69zEfj9cvkLQldocNcye0JA8UWhakEEWt0wA&oe=6A106C58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
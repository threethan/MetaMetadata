081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GQOKkef0DEQ7kNvwGBYFha&_nc_oc=AdqeBTqf1em9KIhNav5shQGJxg6TIM9DYbuX-ETVDNTj7VlyzN4UgnlLNI5-080ETo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GGYJ5x2Yu1KZ_W5Qwdacg4LSDWnmNkSmC5dep7N37YA&oe=6A2D72FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hNXeOBVNSwQ7kNvwGlAOvr&_nc_oc=AdqLxJbIYKgHn8BtEcWln0rleyrDofd72_o6KIb_ZSw-ZiQAKaAeosvRrKK8nL1wy5o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AA_MDNm1Wi7i40Ys58-UG1YdClBqYCEZGl-j1Es0_JA&oe=6A2D7198"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqVXZ2AJGAcQ7kNvwEbBUeA&_nc_oc=Adqb6erHkI5y9SgwCGkJE7byAIjpvzqEuhNM0gsAMsRjUKB0PItG7YbPANO1SEmeZGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99kzfalgDVyNXW3aaW_cht2-pdrkUFVRTFxuFecVM5YA&oe=6A2D6D58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
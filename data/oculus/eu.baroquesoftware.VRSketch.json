081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXeBV1Gsm0MQ7kNvwGJlGpm&_nc_oc=AdrotFy19rug9aZgViOa0aElOhc0_nBYQAxfvxoeDp7jqyX2JmE2RzMMKlgS8mAka3Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xy_OVYKpZ0i_dgn9Xj0Hk3it9vQemnYlQnUnjL7IlcQ&oe=6A3AA1FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQeQ8bv9VLkQ7kNvwEVJT-c&_nc_oc=AdqbMzoDq0pWzroEHt7yE2uAydrwmA0JGRMhg_9bVDYvHAwV7xGWjg8SyfYOtu0Nt2k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wof8RxCqxh9uUF7LA6mZVXeQxTzAsAl0DgS6IKn5XWQ&oe=6A3AA098"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40jymWrinSUQ7kNvwGQE9r4&_nc_oc=AdoRC9ZXCBfiGcUr4SVd6LnftE6UOTZHHwdvMDkEe39atLnwBp2ZM-4pL_F1DIrjpjU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rXmSVSToxG47PARNiw9gUnRgxcGnkQRkC4BCjUkmFpw&oe=6A3A9C58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IGk4LXHkkucQ7kNvwHH918L&_nc_oc=AdpD0bQWDlebtM7zw4AfATmQiDRQfAdkusqv-3ZOjJhOxCDqkBtETYB1WOXeiBAdX4M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFm4tBtHzXQKjq6niDq_9dFlDaj2HD-Y8EvtwIr0fKthA&oe=6A8AD53D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGvrOnxFkeUQ7kNvwHpR9aw&_nc_oc=AdpOAzkJ2XcVuBEwvgBSktYlK0HBuVXe0EOryRpxzZIjfLhRvRoepHkS49Dur-nTnVw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUQ6P8ZkUdldXYWRmp5S52uTyOqbGQZTr9edSg_cGyJg&oe=6A8AD3D8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fYwI2EAZMkQ7kNvwHCoP_Q&_nc_oc=Adr6jxRX7TNnqJksWlw4L6mraHeyB4V0fiyCWGSgYDx44h_tFpph5o9NVe21E5i0RZA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6oRSvGMmrXAG5IemnsEV2S5NIe1CO-34ttBYYuQcNBg&oe=6A8ACF98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
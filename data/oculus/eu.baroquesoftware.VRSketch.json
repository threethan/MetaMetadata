081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ws77bYwI8uwQ7kNvwGlV4LO&_nc_oc=Adq42Mz1VBMP-u1AnYkFikpFBZkO58UhI9Zr4uqP2yoaSLdDh5iu0SNBaY6em-58zZ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmxKvLeuVuv9JN3zAKp62-tkoLY0ifdxabXA5zcJjkRA&oe=6A901B3D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrITHGPIq7IQ7kNvwG3APee&_nc_oc=AdqgQZYriHaFmCbgIsuEs6KbnBHnvA4M3UV7sPnT8CfPB4tMgPsszcinJMiFo9XaP8g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvOfKCPqXPfX_yZp77rYTMFHAU79HM-R0B_VzUw69mFQ&oe=6A9019D8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4FmUoP3iyMQ7kNvwFPYb2o&_nc_oc=AdpnIuBxKnhz1mlrSwI8Gj3p0AVdKR4K1BpbVTuS4y-v5Ttt696Z5hzvOhN7mQRpW5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZ8O90CTi3gu-y8739qX4jUNqUCrBsQRQj2aueoXzMvg&oe=6A901598"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
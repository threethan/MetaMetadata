081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNeg8_JsfXoQ7kNvwHB-9Hy&_nc_oc=Adobcq8YGVQKFG_iDNR_ES2yTslGE9t6iA9E7-umuyuLPKmKNqmOW9yBKZoAONryvTw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af17M-zH5GxqO70XquoRTzsoWmcWa2PebE-X_Ma-Q4iPVw&oe=69F8B6FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pefQ5PE0heMQ7kNvwFHca92&_nc_oc=AdoFe28pLMR81IehdiUEzX44o9Gi-HRBUqaB9JXh-2B_Xdx4aiMCHaNH7d_dr0ccITY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2ec_hRh5Z-l-NH4DNey2K5wpbHKPrmFv_v52XBzjk_Eg&oe=69F8B598"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaqEYS-H4vQQ7kNvwHvgJa9&_nc_oc=Adow2vEhrcV3xD8TxtO1NNAqiwU-0QgbQtwM3G6ekFar1CxYxaTJDre2divJYTnWxg0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2vfjzXzfWMLTraq9hd53eXyG2Uk8HAHl0pGXS82ERGtg&oe=69F8B158"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfdYY0OYMnYQ7kNvwEFTtDt&_nc_oc=AdoRcTIJCz5J82F7_l3E1VTdCabK7rOle7QdD9nsCADkoQAHWpwrfwW-VkJMetR0UOE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7bLxM5cC7eD4YrqOJisMS4vXtbixlhNDbOXSS3bc8NQ&oe=6A940FBD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuDsaVG8p4sQ7kNvwGtk2xZ&_nc_oc=Adrvfw37r0QV-pPikI5_V2w8sZtczFXHPP8XUW_g8rap9YS9U4pXAOJhH1cxrZB4LQg&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkvPZs8eOqf7kFtDmDktAWWQkdddsLa7EY1KGiS92-YA&oe=6A940E58"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSBliSO264IQ7kNvwGSZ_v8&_nc_oc=AdrzX7gpjceT7yZ7COwm8XF8BnuWG_aF1gy-irHBWF3uzPFlxrXhmwTgHxPR8ibcoXU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkGFsPYinzfb7VuQSRNT3TXUNtB_ZPDR2eTKy_AETnjw&oe=6A940A18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
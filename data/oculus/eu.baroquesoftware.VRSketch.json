081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbj9IThL59wQ7kNvwHIZIhd&_nc_oc=Adrd7-0zKGVQpoqJv45bc7nlHHW9xs8xGVJ7KaKEZHDSTruEwE0iWks_Zv9faVtkdzw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzhb08vozDD07Y1_OnItNfpqxt0AaKRRRvRWbxhDDlLw&oe=6AD23E7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpYgRWJbCAEQ7kNvwHYwYcs&_nc_oc=AdpZ9vwk_DfsJJOIFf9exWXzZGOKk1vvY81J6EFC4mqlIQvI8OfIfVV0b_dNeOJIqyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYhc4oRk3CW_Wy0F3aRxM10dyiJ2z7UfZ1KkFLXxSC0A&oe=6AD23D18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPSG26RMd9QQ7kNvwErdYxJ&_nc_oc=Adp5KN1820I1toYi2zeIf9-d7tupuikKGR8Qe8Dlyp3w9JR7RlDJNjZgdNFsegHHc1U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCexOkF30YpJ-GsJKoqAiWZj8p1FKHDgVVExTUuTGOAw&oe=6AD238D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz-b8l4vwHAQ7kNvwHoc_1x&_nc_oc=Adr25N_eTVlrkM-KAnongkyKzVKMDZiDxKO5_bSMkwSKS88GHG-1Zp3detd2rlUbfrA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZOEY1uvNlsyZZVo8agH8dtSKlxMEYacdeI3FxDpcx0g&oe=69DA2C3D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sANjccNgRG8Q7kNvwEQKTia&_nc_oc=AdozpTm0X3T6boxOnu6HrVkm4b_SWaNU2231y7TZjJCXOtVqoMNX6hyD-Ydf2Bks_Y0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Di2MdZW9-jTjBuRm_ttYsSFMhZDywYkpWPl5BPUyqsQ&oe=69DA2AD8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGDrBnPqiEIQ7kNvwGRuotp&_nc_oc=AdrUFHfAWBKbSARyRDDucT75wEaeEVxa1fBbEnoVdMcldXKikGtQNEvGCVT3p2UBT7g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ytgjd9WTnFUPOhj7y_wFqfoPi3m8q4mMKv1yVwTa9aQ&oe=69DA5ED8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
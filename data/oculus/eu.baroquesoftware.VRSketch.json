081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCOoHwsHuEEQ7kNvwGzQ0FT&_nc_oc=Adq7JqiZIl2Oe86fbCNaOfXoBALn3qHEC8mB7jciHLWNGMLE7DoRSfX887V4vLJCxb8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbbXMLdCWcWxxEh9vx_jiDD5FLIh8i4LtZBXbJ3yxV9A&oe=6A56517D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GPDqMIA2v9MQ7kNvwGa-9lX&_nc_oc=AdovdM86OK7rxQX9GGALLYChxaBiP2mFhmYRZMzSEY0A-XefmACuxbRO3JHAo5tg-rU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB_gYEGMoTTcYzGmdO6hJT_D5WSv03wIlE4T6vgxlqJmw&oe=6A565018"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNYAIUCSYfcQ7kNvwHAXGBo&_nc_oc=Adq_KD-HV9Z5Sox7niSE_G9NdabYbI2DdYERm5syTjNfUod4u-O3_ZTNOWxW6-wO1qQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIW8Gi0Puur1PMjAKzgha8W_cTWPV8GjdT6x-lgX723Q&oe=6A564BD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
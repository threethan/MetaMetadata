081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GDJMIHE_ZhMQ7kNvwED1hIi&_nc_oc=AdpZynggyjSNysy7QxKNw5PV5h091sd257CP6QS2AE1dDfZqLBGy8gVKiRwdi3wBUQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUqm1yJpYYCBmoxrX-X4vegj3ADXFsfcUC4lDVpmFNJA&oe=69C908BD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a47I6NbL8AMQ7kNvwG5Qzai&_nc_oc=AdqOeYo9-Fh3p0q3tJdpQzp2yLf4S_YEPaggYVbuyL6zXwwdFXV2lCJ2-jNMJ1TushQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCmGF0_Ws_AeIzNJNzKbOzepb2mmNIKoWSfdmJqf-sxg&oe=69C90758"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaJbuDqlItEQ7kNvwH8rIBp&_nc_oc=AdpxSzCWG2CLsiPmWcclHue4aDz7hcRpT9JX1Zsg8luE0cTIs3_-kF52-6hfcUN5m-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxJeABLA4oxb9pkp5QjSx-Y1jU74Jt3rII39vBzGfTpg&oe=69C90318"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEEjAfdcDFoQ7kNvwHB-VS1&_nc_oc=Adr93KURO1hyysOTw0j6oV0U-18RUq8hEHr1ecgdKOGtuqp6kRuq2kF-5dYERH8Q1vk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFQo_EtX4ytcdRNj7lcdY7WUDuv3LJ6hkDtRtvpkidZQ&oe=6A9C30FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gYOA3qnck0Q7kNvwE7pSmZ&_nc_oc=AdoMwixSc9sc7Sk7D4u1GGgQnJQHPR-G9BhQoK2PrQepQYi2kqdElM45f1Ndhj3AKwU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-mZDQjPK8lGrzBYXAr-VVoctLI0DtzlF4oP0kNfJW-A&oe=6A9C2F98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSTbbYKjnc4Q7kNvwFDYsPQ&_nc_oc=Adpx3JvYYI3eA3f7dDgnAbKnDgeJ77Mz5uVb0Npj3xYtiYWlaBbnKhSiAKp9A1navbk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9e5HoqAA15pGxBJm2v9yLD0RM7RZzlFBTDEl0vgcvBA&oe=6A9C2B58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
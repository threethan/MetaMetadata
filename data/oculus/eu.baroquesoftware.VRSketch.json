081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re69jN2zjjMQ7kNvwGFFzMD&_nc_oc=AdqAtP1s828ycNXoF0aFww0SVQo1LiEspavHAX8xlKbXgOiaxsJMieb9phV_hXi8Ozo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WOejHAe2PIgB4RgYhlNjgjc1J_415BMvaliqBPMD8cQ&oe=69DF723D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTUbZlqjNjcQ7kNvwEwuxli&_nc_oc=AdoL3Sg9k6elf8CiV_CbEnC5wY30OOKF1uKN2tpNJykP3gQtoWL9Xl0V48vwPCnD_hE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zAcWIN0OdMstnDaLb8bdYHWmZjVQUO4F7YFAJruk5Ug&oe=69DF70D8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS3f6SLxypUQ7kNvwGoMaum&_nc_oc=Adqqz8jsXYf8nFBFihmWoe6xFZyiVlcyI_pOhfMIAhxHmeQLZ_VqVaXDyou1Db_hyA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0oHLN0rXqLNFwcoSa298MnZIR4IXHtwZQ-JvkDJDLxQg&oe=69DFA4D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
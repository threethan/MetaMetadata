081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMMQ-0FGxGIQ7kNvwHmja2a&_nc_oc=Adq1Mkt7ltwJkV16Sp84W4-VaE0X1txJt7Rq4-ZkYLuBCSpdPpAajNIdW2SbL0VGGA8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAU53H3GO_NgcyGqtrmWa92ZIOxNnwbLErIRQG0U7FsjQ&oe=6A5F53BD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuarIypYIGwQ7kNvwErXQRd&_nc_oc=Adp4qeSjtNv8mdi6DW3aECodKZQlbvbYvlZJjVONcutuweZHrxqbM-wNVsqNKCPOkx4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKtX2ecikYqtCmtYVL-yZ0n64igP-ZDpI87riIBNPuTw&oe=6A5F8A98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uALZ_eMu9fwQ7kNvwHmo9-L&_nc_oc=Adp5EqnmUv5QUD-Pl2m42q5TdumqrmQIuvCyFEa1k5LN4dJsVHxDKpUuIPYV3yuNI5E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhb8phFXdKTu5aa6N_q2K6-LI84u-DLp-oDnCrlJidhQ&oe=6A5F8658"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
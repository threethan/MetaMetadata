081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaYaAMzGepkQ7kNvwHC6NZo&_nc_oc=AdpsX_BR6RBwSHqE4IHAZWGgtR-TRo2NaI1jrNCRSlFdI-a5JBVSboqeTlbKzfHlgNI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2RedvRxiaI4_ttJvMWrtKnhLXH2x1CwWF-lig-bEiUg&oe=69D0F1BD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DnrWXIwfJsQ7kNvwFrSxRu&_nc_oc=AdpGrCS1I45gEP7FOu2owT0f2-7sII0lBrjc70rjHdu_GpTXDzRhZTbwtBW3uWFmKcc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwfa8iOktWBK4L47CpPBzhQVsGdzK1Bdo7j4ObHIYbuUw&oe=69D0F058"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPqw9aU9zCoQ7kNvwGnlC37&_nc_oc=AdocFhiIjN93u7xytF66mOv4-Osu8sYghagRLT51HCBcpVg2uI_miigc8-TPUwqkUzM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyRrsSXzGSQP5L2bPdu6_eQKGVgKQeoQwBQL0eJv1Wk9A&oe=69D12458"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
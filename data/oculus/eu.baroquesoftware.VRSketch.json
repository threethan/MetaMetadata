081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5g6xxhUaT4Q7kNvwFcIA_n&_nc_oc=Adq0VAHuvUGmPK30Pt6D-4w4odMIUyFE73yP_zE_9PNHZDMjVu0EMM7IlvkeIpXefKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDYrDy8LKRo5zvSfEshEfq0AuYxZFmfQKTCL85QC038A&oe=6A983C7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QlrUr74ps0Q7kNvwHya84a&_nc_oc=AdpeZ2OAzAKb-BwKtHVjsxRQb2_9-Ez3wVBh11vslWYQZ50AGYST-YKsZ9QHZerLb1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBFN0n1HoqlBsE417cAsmpEzAv7ITUl56PSVf8OqPzpw&oe=6A983B18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P4ke7dKUQIQ7kNvwFY2smt&_nc_oc=AdrqlOFVrmOf6t12yd4XKOLGI6mNcj36qEj_iGZ4fSHDidmoM2pJWPSqikVzXQRic1I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3mwYrSrDnMJAE2OoYlIZSwDIbTL6ajhvQV-1iLieXQQ&oe=6A9836D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
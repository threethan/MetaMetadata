081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P2R669AiEdMQ7kNvwEY8lrO&_nc_oc=AdqYPnm6yIAs0MBeKdvlRTZFMW7MDE5tFlND1weeA7raIOySvAusIVbgStIJceZbVs8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTU2kcHFXinhFJ5g0PE254vtUTX0Llg7n1Q4zrnUlH3w&oe=6A6DD43D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NijhgMFZeUQ7kNvwEZgcq0&_nc_oc=Adp0y93yhVH-hctIhs_I7Lh82ZsCxh1DgjTVk5wHc7BGXnKX8jI2X8SxOnHKj9nluoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA9_XdPm7alJ3_uYSFRqdeBHPqE1sMbxqkQhNe8ZnvYQ&oe=6A6DD2D8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHWC9B98s9sQ7kNvwGXfYKw&_nc_oc=AdpMji_GENfjcKhmgdR-4x19nWavqySMsS6ZROhxundFAaDn-Eu60eHYWFpTbzNgFaY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuSkuHKAqYms3DTumP-ZuN7y6rKK1C-woG-GoTS68s5A&oe=6A6E06D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
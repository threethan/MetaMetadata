081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNkIhpaxIH4Q7kNvwF-yyxM&_nc_oc=Adp-iGVyV0a5vT8pjT5YhBs5PUIPmBfTRJ5F5DBlRojegDPYOSr0hHbUTApZLuzeRtw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa8RAxIZa6pOBXGssOch5l10wUux9TxV2XPuh7akfhvw&oe=6AA56B7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b5U96_Hmqe8Q7kNvwGNi3yf&_nc_oc=AdrXZ_BmmNEZ9Kwnzj8sDs-TMv1rmkXmHeeQRqQagX1WKUAj7XDm6Mpo7bQNbyC6Cx8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInM3lwbBIPTPXOZ3xr433to0UozK2g_MYBjI3d_dRWeQ&oe=6AA56A18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bz6OLgLXto8Q7kNvwGuctJa&_nc_oc=AdoGju5on_LTjDqNiOTrY-v6xd9KxQFTeUTPnDq91_wW3lkuquCWqi323R0greKY0Jk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMO_QL5Lc1A_UeqMvZ0QhFj1zKgRa4xKnZ6yqMkOMULA&oe=6AA565D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEpHfbdbkYsQ7kNvwHqn-4H&_nc_oc=Adqfm2LtAPfioGWtxRMLzfEJS9bDk6VOCGaLg-IKqCCcsmnIRI2bN1e8FbiZvd20g8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCcj9YF8qc_nPMrpKB04R4qnzbvdEc6kE8GXfq0nKNvw&oe=6AF4857D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vx5xdh11ONIQ7kNvwF7qZ5Y&_nc_oc=Ado2A1dggQDJr2VZgaJbTKaVjAte84d8w9sGtOajdgSYv8xmph0I01nhzhbezjaTC0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQya-zICKRu4-2QkdJno_C44OTaZgfwUR7hMvT6bpQY1Q&oe=6AF48418"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrrGOlQuOdsQ7kNvwHb9oLU&_nc_oc=AdorOe-gX_kKyJxrm93p7SK1WjI2HR5vu8cuveD1v_Te1JtMtGGcT0DibgD4-HTu5O0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3BF6NIbhTOIqAXW44ymCc0SMd5c46-EtX-qVt-udP9g&oe=6AF47FD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72x8RQ8VQ-MQ7kNvwGrW--P&_nc_oc=Adqbmu8ojOyMke4oeCfDJzDttu9sFikDuEmplE7NEZS38ntaEY_TWAkoK7huNseFsVc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9G20VVVlsoLbqB4vcIlY3ZDVmlUfpNil54PRg5CQudrg&oe=6A32B8FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8JavE5ECagQ7kNvwEh1C8d&_nc_oc=Adp4t7xJajJMSpGabwLbzJiGH4wGYW1nOHxxqOnOqEsVJnRn2irALWKJfcmUFqMB4-c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uE1tmz4N2jLtAzUlBrdL4xljwMOhf98ckJU8I6B7YPA&oe=6A32B798"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQKF-a9usgEQ7kNvwH8DEsc&_nc_oc=Adq1kBAbBayVP8a3K3KaXxxSj2ecnFbL78CGxn1FhnWniZPf5FdgoF_M8SGVCY33gQ0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QOvrjLNvDG9qxbhG0CgFosz3fLQ6vn-UBZ7P642xuIQ&oe=6A32B358"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
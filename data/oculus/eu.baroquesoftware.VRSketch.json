081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVr3tilodpQQ7kNvwFNpijj&_nc_oc=AdrORiH9gIRSmIFZJFqPXVVJYBcXxCJFtmVAVIUK2qYEJR2atYkHqODmRDOvuIXJvm0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1dWsWK8tcKbNyBxAHvTqqUDxRaaouPTlHu1_Tc-aFUoQ&oe=69F370FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzXRZjb0x4MQ7kNvwGyvIBa&_nc_oc=Adorew4IrIFj9fIp9U4tsN7c93GLw5aYffV4hZovXEUzamN1_nTvh6S3H_PESnt68zM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0a2CpWyRzhm2gRrFyYwYhsW8JLC3j3fGdZ8rme5fczpQ&oe=69F36F98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hv9jOGF8mScQ7kNvwGjGr02&_nc_oc=Adp_KGlVJ4EJS5nvjwti_Jr2dOsawAQgyFmuAQYDitCeMz-1VpU0yajNhBP8PoawliY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1q-UcLnIQtjQJ6xs5kD0DLxW1xxKbnpL_1HPmSxL3IWQ&oe=69F36B58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
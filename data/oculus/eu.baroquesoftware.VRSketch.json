081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EX8sq-8dacoQ7kNvwG9aaiL&_nc_oc=AdpzWp7R9qkELrLSeww42JI8d2tocQOZDIRdMUBepPc-onClzXhXqI1HwrlxbdhTvSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cAWOkVxWPYvnRqexOgtEJpo2uf9ZK4sw-Tb42OrYXnA&oe=6A0342FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OTlP1tzD-IQ7kNvwE7b-vq&_nc_oc=AdqyCmyFNJLAgQPMa_ZorehzjujJqrQ3Gh2xSy-HDGVs43fJ-O_w3SyvuoNkO6KjnG4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6soOoN0XpIyr0rAPKIGAqRepRYiN74mEls12X-nqyQEw&oe=6A034198"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKO4I47AzrQQ7kNvwFKkwVT&_nc_oc=AdqLioTXXQ93uRCKaMo1HeaIVlwnKalFEp4SNQC83Mk-bPw_GczJ8suILbIqhHDUJO4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41gOQYr3cKstp9Pllalf-N5RyZB5bH6EmE8A0kJSVO6g&oe=6A033D58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCB9ne9uX3UQ7kNvwHckLUU&_nc_oc=Ado1sBOgQZBdAvi5lz15kCxdCi46g_K2GK6PK8MT8ljfgDXmuCcBBPljquhcY5mZjgA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ1CTV-ZKjMPapUv6f_o53fqcjTLRp_nj1rnCazsqOAw&oe=6AE7567D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ko9auVnIwfsQ7kNvwFbgvHm&_nc_oc=AdrMa-avPZKkXVobxbPtgCYw55yqOctulSP7FlbBeornn0cJLi50BMMo6KL5SYV86fc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRz40Pn_0um6FiTyQ-8Z_pTzIGCxG7HGem_2ZHjaq8ZqA&oe=6AE75518"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnJJdt_gu-kQ7kNvwF8a67Q&_nc_oc=Adoc8-fYFbM4FnTMDVmRuNYDEed7xhvqnkcWpOTerdIQqNkRDt902ZkfF_jAKiWJIFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD72pLUqyY6vu7StNxx6Ij3CVu9ZU4nBlkMKqIPEOXKQ&oe=6AE750D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5YiUDNaOLgQ7kNvwG93sFb&_nc_oc=AdqIii-4__qkVWmPNFgIeqxaOtEpdzCzZLf7QY3092fdc7kE1GKoxfPrfVfryNKQxmw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgHHSqH9rfKOYmhvfCCTIydMPZLabOLCjmQCKzTOC3Hw&oe=6A4FB9FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngBP_2YXeuEQ7kNvwG_SI-8&_nc_oc=AdrBBbwQioJNmCZBa3K8Wiwdwec4UZ1g_RKYPwgnzi2_j0RT8zvdIGOAqr3CupbkOvk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUc25okctEzcZR5OnGHry_ZzCx9ws_7QAue0LSFAXl6Q&oe=6A4FB898"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqRPx4xl4YcQ7kNvwEwBsGn&_nc_oc=AdoZfvOB-ZF7QbSmx-42tXvuqgOk6Nq7eXXbTfP-PJaM0eVGGwk9LqPGo_hCsgRICX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbyfRskVHbpU7-m-XU-FKIlnWmhmGB4jc_4Ucri-4gxA&oe=6A4FB458"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
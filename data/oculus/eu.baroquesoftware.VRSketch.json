081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQEyCPZvb4oQ7kNvwHmc04n&_nc_oc=AdqqWIe72uxlo2VLTe0VN0uX7m2oDCldxnr1QOYCX76yQIWfDUKcAGW_hMeXzRfqMfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OWlPs1GsICp2tpcCtNo1dgyF1N_m9MBxoHQWxYn-acw&oe=6A2043FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3oJSYXP5s0Q7kNvwEL0IRs&_nc_oc=AdpQtCNi0tlZKk0rBL2KsscXuSVcjXflByoxPjfbRN6N-mhJGkGD8-e-pm-BjZ-A16I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64k0wLOP4boYEDGSowQzfJwNPLN96Pn7_utOVy7olU4Q&oe=6A204298"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4BNP2e_IZQQ7kNvwFFeyDT&_nc_oc=AdowUznepsOcJ72fYMBWUHtCBR8HhIginccblcxFPukzyEo3ulXKjWILwU8MYD1elHw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N0zzcOguKoSimPRtT6N87A5MRWsx9Gt1U-ax2eqjCcA&oe=6A203E58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
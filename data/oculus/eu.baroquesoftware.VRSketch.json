081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fl5STlsbTQMQ7kNvwEbCXTd&_nc_oc=AdouGQ2yNE6a_FQ6W1-AULiorLptamKrp8a7niEkzQNAMRzgWiNGIaXqNSfuic-god4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYLMoH3F4p0fymAAURv7ZHUo4wbu0BrPhaqeZ9obBdPQ&oe=6A79B1BD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-S7bbyxcvgQ7kNvwHcAdMR&_nc_oc=Adoh-8nTLtbiNC2RXmKjzP2ejHTEQKdIltNrKSumWIS5paq5SKgkaqjxf7cYMyxLEzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5P_5vc5hgWICxxTvSAEmPIV7MaLIqnrs55k_h0IPS5g&oe=6A79B058"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnJUKPcSHAYQ7kNvwE_J1Zr&_nc_oc=AdoWO5HcvBYkRZollpO51ChbxrOd0Nj8uFiNcDWieKLZYkd23hBruq-gMamEgz-1Y90&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdNANEWW8K-y7_QT8URRbhm48vsJkej77dj750kQlPPA&oe=6A79E458"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvcgyg_D4NUQ7kNvwEu2fK6&_nc_oc=AdrcVgHMs8f-yJap0Jq2p9fteuHnKFGbkEiNKUjpZMvrKpDSYAiJ_SmLlWPgpQHJRTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOFYJ7p9qnsxgCaPoqRjbUYpCOvwo5u20c25FIyk8XOHg&oe=6ADF6D7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBY7NCVQyX8Q7kNvwG5Welm&_nc_oc=AdqVRUFv6rABrIQhyQKMo8xZxCiZ4TFknyTUn8KHe18BTbYgiSH9s-0bLfmNeO08a0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpI0UA4RvbkuG0KtMVPVNpFZjvboxXT55_5_k8xsX-wg&oe=6ADF6C18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIHLRvzUcj0Q7kNvwGTYI-T&_nc_oc=AdoFyNoJ9HR21BppNsq3_RljwSuqvoXrZaTArMSms0Na_2AC551A6Jlz62kyU7pcwqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8Z44c_CKs6MflB61bF2ZQU0itj_0lJ0fIABI6mY20KQ&oe=6ADF67D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
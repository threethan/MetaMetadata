081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvx_UiVbmYkQ7kNvwECjCxk&_nc_oc=AdoFQ54gefBiso40qqPF1OemjQn4mKLFpZet7j2dbKaE5mXEvUMCZZ6MsYraCwkxdcw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwje8D4Y83ARsjumoZjEJrLFEnn_pXn9733C_CFkRCarQ&oe=69C5143D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMRrN6nRniwQ7kNvwGudhEd&_nc_oc=AdrFc2jemF2QtptGjglDO1j7sNgsLeQ8EJrVCpT8H3-AjB2u-D0F8-NNhElT-xp372E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZcx12y5LCQ_ZHk2YFACysjtQSvWftg3lRPGKkgC-OqA&oe=69C512D8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb7UyT1Fvn0Q7kNvwEwr8h9&_nc_oc=Adr850yogNhYNnBqjLm4jT7GRX_H19s7fpS6OdckZXUVhNz_dUwpoArIS04b382EwT8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbMqb-OB1Ju86D-4qoamVU6bchR3cfE8xRmsF19dCvLQ&oe=69C546D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOaKxCBlaoUQ7kNvwFN0OAM&_nc_oc=Adoxk7RkMKQoBaiWv1Q-ke3Q_VolEebn2ie5eFPJ2hpHewZ5Fd2QkLIawIqYYSQluWI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4St0vluaGat2C-di9ChiLUJQatGQ4IwwgnXh25bLdhiQ&oe=6A09DA7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcxWvsaVJcAQ7kNvwENixw6&_nc_oc=Adowh2BSOvbuPu-OMDczjHMyFWWuzTlRFBr_0kXiBuFZ6OiuZoFJ2uFZNghO0lshdrM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LfWrbI-dXn4Jh4YbhYap7GjcruWgjtYzScI_YuNHdYg&oe=6A09D918"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DW29IKcaKuoQ7kNvwEoKvgd&_nc_oc=Adro6U2j7UB_HhrQKH2nAU3h8I0o64V-CoLucTWDi26rKzKEfQjKEs_Ywvs6W0DGBLk&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uNkRYS0HaFi5VcOopSzBhrzfpsLr8-Ds6Vzzb0fLy8g&oe=6A09D4D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
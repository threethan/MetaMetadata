081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz-b8l4vwHAQ7kNvwGmkX8Z&_nc_oc=AdqKNYM7pywM4JJiVzYN6Iwn9LNeJ9Go4nWp3RudoG6whksv6M6Uyg2UZPlaqDwhjMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KkYgIcaBVlyamrEpZiNE9OtNlNu3fCDZC3c_rnk577g&oe=69DB7DBD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MENz2vKUxe4Q7kNvwGqSp9S&_nc_oc=Adp2V6kSHA9FCfE4LVUq07_QoEyS5kHeR0ZJUZXdrnmIvp26L0cJg38a31Cm-DChSXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OAS0cmnQEl9KKY0TRSybfM-zefxtiyM46g-lfVqqqIw&oe=69DB7C58"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGDrBnPqiEIQ7kNvwG8eAhn&_nc_oc=AdrlNkoa-UDg7SxW-x-oSf4_u1kYLQrFsRrYJJ0R4RCUn-XFZnBIJ3GZUMFGQ1-4vUQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02_2lwcGF2J5-4f0ZhmshgTDYox2Ng14ndOJCvxYawhQ&oe=69DBB058"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
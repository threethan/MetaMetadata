081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3GQOKkef0DEQ7kNvwEe5Hrb&_nc_oc=AdqG4gSjVHeiBhXssiLly9KmC3YlK67ctXgkiciYwXn4crQjouG7_qOWX9TjkU4GHyk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bDNQ6c2tqBrEM0fCK8hr6WN_OvvCSKlcvzVyc69ZCFQ&oe=6A2EC47D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8ZjhT8h0igQ7kNvwFGTqgS&_nc_oc=AdqPuehTCgmVozU_V8HAd-wugdwTxy7weBY5_pbeMVRBr200TGouXBWT9Q43iuLQcGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lNW1bYlfHnIRYkavA91RZvM5owQ8R7GN25Zjm3OiFSg&oe=6A2EC318"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EqVXZ2AJGAcQ7kNvwE9XTOZ&_nc_oc=Adr-5IZ6qvoa3qhmsCo5f49y0wNihooQu3nTP-6hJfMxtSeCek1DU_ciIPlaO3UkDyc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ViyNvTipSOMucpUN4qmMmorVx0oNHnFfUJ3muKaJf6A&oe=6A2EBED8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
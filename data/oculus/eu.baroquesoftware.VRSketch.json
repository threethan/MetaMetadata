081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re69jN2zjjMQ7kNvwFr93Zg&_nc_oc=AdoBW0c09RYrMB-p0ddiXbNoFmqBagsL7uj2fFERV3LmbXtYWdirhWXZd0pIrgAGOS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kqNo5oBT29XvFHVAA_0B5nCKVkqbd0JP1raYPg385xA&oe=69DCCF3D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MENz2vKUxe4Q7kNvwEUyxVy&_nc_oc=AdrLNsgHLsRcHdmk7-2ETv12H0MbN310guA5BvyZ351KskOnHHNl67HAwu4NNy0cUoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P_qbjnr4aHddrKHxwqFS709W6J6587JbLWPi6aZ00Fg&oe=69DCCDD8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGDrBnPqiEIQ7kNvwF1DMd9&_nc_oc=AdqTVp6mMt-OrX8urcX1jBdjiB8Js36KHxz8GUomzSOXviUeQ2up4fOkGPnyS2ycSaI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yl24Y7VevXKfxLAZ3W6EPzmi4Ym-DuxkQrYoJ6tn3Tg&oe=69DD01D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
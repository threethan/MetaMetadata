081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rmt106vSh4Q7kNvwHpapRv&_nc_oc=AdrL9TtnlGhwVHSAN6RH9tWbQ_lX8CrTSRvD-7N78Od86kRO_XlAbH7pGkbaKeVcXOs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoQL2byyiT4UZB3TN7fRAQiv2RIV8Q8tDQqFY1tcnxSQ&oe=6AB29A7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKcppJKqMgMQ7kNvwHJLCur&_nc_oc=AdonG54DupjaXMS7ziFNmVum6o1lv5u9lZqn_qXUvt0JGOhbR1fBIacxRuG98jZ8EL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9fV46eyhhrPGULYDJHBU2jxvKdIgKY6nrDRlVlllNPw&oe=6AB29918"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-FIti5-KiIQ7kNvwHIGQxY&_nc_oc=AdrYVz5VExKfYKu74uF1h0KCZDFxNauxmpdGPyo9MDqDOUJ4IhJYECX-qrCTv4WiZpU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcniM_U_dgLBxa8USRzfG8DgNlkfyaxe5IXNXAqEy2cA&oe=6AB294D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
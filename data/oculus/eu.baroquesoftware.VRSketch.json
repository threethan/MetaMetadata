081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wb7eSxbGkTQQ7kNvwFt-JXQ&_nc_oc=AdpCVEPZ7Ak1K6kRdEuJSjiTc5rwGR8t4bielRaO5Vm9L7aItnxE4Cr3REJskwPAK3Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jNXbsWixex5AKDc-qdAJp4_JCO-euf45zlo4L7wJmEA&oe=69EF7C7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoIGJJbcJuUQ7kNvwHlsHuJ&_nc_oc=AdqGEuJV1BMU-GBTOnwGcxcFxg5F03oOIMhO64AwUQ-0jMBpbhuUPFheSu018ejHZyc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af07GmOjZdEBCcqL_qLwK1biH-ugrkfJwEaxIYjFCXmPzg&oe=69EF7B18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T0tcOiCPddwQ7kNvwH-SAyr&_nc_oc=AdpiEgAvx-FCKJbUJm92xaPF3PBvlZ2cezyTkgffLcifQdxCbCpRaGFrRYAKOzqR-68&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3gkhtzgCsc2uiLRBMBSKOzAV9iT_33mcwFh15bLFo_UA&oe=69EF76D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
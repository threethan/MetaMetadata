081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puh7XzpDj7IQ7kNvwH88GVt&_nc_oc=AdoCVcPX5T2T5OZp9ynV2HybCcZB5gXboMPXa0MJkW93vsPurPy8-PV92clQX0mPERQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FIcOiwXXk-D_kP_FuvDZ1FAi0yYFxRb0MJNG-JSVSHg&oe=69F4C27D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzXRZjb0x4MQ7kNvwHXlnAc&_nc_oc=AdouYouRrs3NKEXQcUn85Z9041bJxkyQ1nDF0VPmpg5s-46ypifafXFA_51uHcmUxIU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af09Zm32PhJ0rgYt8dKmdsIJh44V-3MbCHTEXLHxOLb_uQ&oe=69F4C118"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hv9jOGF8mScQ7kNvwH8t_F0&_nc_oc=Adpxk_BDNKyjpmrVjPSLei4I8AN-_NnpEovFjls_oIpvXbrED5rKQxeMi--hezAXbRw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3aig5W0kopH8SLIQyUBDGkJIdVG4G1aNAGcdKcVoSSJQ&oe=69F4BCD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
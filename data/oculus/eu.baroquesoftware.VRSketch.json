081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rmt106vSh4Q7kNvwG3Rtus&_nc_oc=AdqwTFLR2iNyvt_z34u69lCXXosB6vJUwg7CMN4xieMeY_U55yhywhC9AcJpclkqiD4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-dZa6rmGyyLFsnm7BP2uRUof29IU9w0UWtuRY4CXJXg&oe=6AB53D7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3tHTgu9M3wQ7kNvwGjvF06&_nc_oc=Adqrjg1oSrvKO8JM5zyat1WrkVx5TaYdaialFHMaedpuZ_jsQzrwh82yPWcunzh4XPY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsf3ZYjPWzKirMm2d-ktAZ0BcxBl5yjEs-9CwIEZA0mA&oe=6AB53C18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4GynJJpr6MQ7kNvwERMwnL&_nc_oc=AdphwQIyMeWSF6D27oPVIXOaKNA0oFNOAtNJJZ7KymJy9Qll2eLtTooHijLji4AR9Ps&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqbYDk0HQpRig5upyL2HodnMHWHw7vTSpqkLoA6faUQw&oe=6AB537D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
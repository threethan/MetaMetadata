081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ORk9Fmjq3MQ7kNvwE-zobD&_nc_oc=AdptMRh28hFA2XCH3G_GAXqoxOPhfDdT9QdfhzZMRNve3LTIT8H3yoHGpk1fLmksqwQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Nhoq6brd85XrsdXyC3zzx7O6pXYjmvmKdEJdpcf6iCg&oe=69E0FBFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTUbZlqjNjcQ7kNvwFRU2O5&_nc_oc=AdoMbLCJQBMLgLQ7InwvshIFtCsvG7zR8sCoskq9-gHdpsmWL6fbnMcbmPju5LL3uiM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xP1SWmO60BQNqPq22pMkTMWGSnNiOnZxRZ2EgbQbOyw&oe=69E0FA98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bS3f6SLxypUQ7kNvwERE1qO&_nc_oc=AdqwlKbHcUUDPsgXxnw-z_wUyKFsrsZ2rq8AtrxKrFvtlIR_7ypDwV_uyyATv9q9Imc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G0Twe5q4axvb6hyA6CWWAkxL9C3p0CJ-FcCZB-7cyhw&oe=69E0F658"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
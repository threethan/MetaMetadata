081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaffKKrkZrsQ7kNvwFWec1t&_nc_oc=AdqqELgdrip6zvX5YbDjggf4PnQGBQrAY2f49QNbneOJB7XIDAsNG7MlZ49y40IliZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPoGazWduX6pg1k4IwkZj-5D8RiaEaCXXqJMZd1fXa5ZA&oe=6ACBA6FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oX2hq81ZbkQ7kNvwGwjkfF&_nc_oc=Adr-zdubJAacgVcgvc0QKtHo7-MDVA0ypR8F3wGqEIBxOt-uWFUzgJraPtNGN085QuU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEcBzgoGgRlbOfskzM8_v31TnDu5-J0h07ErP0qeiZDQ&oe=6ACBA598"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4wLng-es-EQ7kNvwE4ca9w&_nc_oc=Adrkr1c4thxkV3bL5bGqyDO15oblBPFfOhz_gH06ea7RfO8YOpdEyFsczy7Adf1Jezg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIp11k1cYW7iS1WblHqZQxwRVA_TlpoBinSUcWV21s6g&oe=6ACBA158"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
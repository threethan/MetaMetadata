081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94m2iQWl9I8Q7kNvwGT-tgC&_nc_oc=AdpJLx-NRwx1BtXrIsx6O6BicUg-8FZHIz69JB675lhuKVsi4LEwhI7bZ48gjP5nGXQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_JxY21VrzKeBccPjjbbL2iaotq9vDqOlwvBAmC9qQIg&oe=69C2713D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oW8qeRYo3kYQ7kNvwGTc_qP&_nc_oc=Adpbd6_BLvCW4dHFIXMVMSc_z480muXHZ2HltsUvnJHXbpnpGZLhLL1YvG993z_T-TI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzqHHmeHCAVscHGFeDpATX6QSUpcdFBYVl5TMxgiCz7og&oe=69C26FD8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb7UyT1Fvn0Q7kNvwHC3FTC&_nc_oc=AdrSsiTZeNWXXMBxsjHK31ofJItQUTIO8isy3JSU1ZJjyGdw15gPLdMcu24Uzns3RcY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzIsTm01w5GQab9herEKadkYq91_C1T7wq2eljlUs55-g&oe=69C26B98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
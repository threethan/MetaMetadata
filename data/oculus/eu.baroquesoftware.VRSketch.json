081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5g6xxhUaT4Q7kNvwHx6dMn&_nc_oc=AdpTH57WTXaSMmKBfCudWrrQEUlylQs-vqbmBvai15JRDEicd1a2O5W6w1g-QDhISoM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3EOEdYPYUygdmxhmpVAuKmAcOLLxbcBxlqJYlX6ecmA&oe=6A97233D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QlrUr74ps0Q7kNvwHRcDzK&_nc_oc=AdqPzBbqYdemYHuKiSx91aMpD5d7cFBXs_uPgwJsGW8HE4fs1HeFKstFGyDE49Jsnso&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1kT1qbF6eoppDYNg9-BX6hX78gyrW3SGCf7m-3295WA&oe=6A9721D8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSBliSO264IQ7kNvwF2QDlA&_nc_oc=AdpDrG7xBsvftDvWHOaucIwbRQ5zOqxmXTuXu2VJHANAo02awTIE40hHP9ffCeBXy1M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHjOZr5JGD5R4rcKDny0dOYfWTbSxNID5Ke6LfUzsvUFA&oe=6A971D98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
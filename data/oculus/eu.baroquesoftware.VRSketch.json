081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fl5STlsbTQMQ7kNvwEmWpWB&_nc_oc=AdphvyGyxMyhlsPxqEoubJfoRA7Sd_D4WrHoZFJ_hEwUSExWKKO48XXJsC0Pp4XhboU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuQFznrvGuvQMgTtHi1-I-1KJcPq4PT2_55t4FVt3ZvQ&oe=6A770EBD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u38Yuwg2rqwQ7kNvwFzfMhu&_nc_oc=AdrUZ7KxU25BixZbToOwFt9tqu5lotpeGXx-pKZ4s5tJ7HRcxhuWUFhVlFMq_VWqqSE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELiAYBbjPt9koRmFr255y6VaYdkmYUtSrLrnOjvnAjiA&oe=6A774598"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2XaOwnBT7IQ7kNvwFEGQQC&_nc_oc=AdrUAioBGDPJC-lOXIIjp-dTlmiXWwm4CiyTSGuA6oMelTlsOrbhGTTRpC68hhZpSHA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1iv56wfBFQWEFcunwYF3OHTjMMY5OGaS86SdH1J3kfA&oe=6A774158"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
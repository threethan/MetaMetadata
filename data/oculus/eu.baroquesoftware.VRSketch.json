081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5_cEQ2u0PIQ7kNvwFE7ZKc&_nc_oc=AdpAC-iqVk1BXszbU2oyZS1fkOZhJjA5b8b5rHChX8oBpX1vD0TGAKLeLiWgL43wEis&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YNS4Y1tp3mIAopovwJyMDLn64W8VsP9eWDrs8ky3E8Q&oe=6A452DFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OO8XGmX2jJkQ7kNvwHTQ0JE&_nc_oc=AdpThDRydWoYZ7NLpiR8iGTiKGK0x4lyAlU21uoza7QdOTazaYSQBvNx0A7d8KKZt_4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zuj9ZquC16qoVpc-SrTS-6_c4_JyPM3RlDNt72mmeQw&oe=6A452C98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6vZZR3F-1EQ7kNvwEQBjgr&_nc_oc=Adq7og8KHEST6x6JpIbfiJjDhOv1KNAWa_jEXLx8xhiozDOs5oCIbddC88iI1NmmiwQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b9a_h8RWLzEg0h20vKKMFvgiTQspymusJII0hrk1Y9g&oe=6A452858"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
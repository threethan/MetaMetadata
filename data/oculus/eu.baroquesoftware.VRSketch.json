081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OtfQgcNtT9cQ7kNvwEtiOwP&_nc_oc=AdpmIFKtmRLflNRWNRunJJQUyU3ArfV3LfUOgD0d5pkb1-JfmZjLF9e-Ahns9GImv60&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO5jgjQHUegKID1_qj9ulLQfmxbvTCtmiXWrZkeWuZSg&oe=6A9ED3FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V94zAGTzchIQ7kNvwHVP8mE&_nc_oc=AdreN_vPeh0nYhRPMjMSNCuvKj8UJW5I3E_4AiTNtTKOSbrgy2UlS2JOX2IsSymJaUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyMEMNcDr4Kr3wJXczIduzSBAqznFjlvjM_vZI_owqDg&oe=6A9ED298"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSTbbYKjnc4Q7kNvwHHbg3d&_nc_oc=AdofVCJzI_bRv7FT-hTX4ow8rhq0-srFxKqDHjc02X1dTmK2PUvhehle3epoJV3Jd8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4d2aUVd88RmS0TlWsFz3d7pg9XSkFsRcZ28FV1VSi9Q&oe=6A9ECE58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
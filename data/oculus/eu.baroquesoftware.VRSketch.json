081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jLJvenNR7sQ7kNvwFvhoOW&_nc_oc=AdrGp9v-SLiq7IuRWkw9lHQyMDseEDyylMc6-l6W6Ib3-q5d6Otz8wU6b_7K5CKw3u8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW_eh5Db6NwDTqoKhnO-aEvWxcMYKxjmg4vhOM9Mye6g&oe=6ABBD4FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXawYKmD1t8Q7kNvwGoIGoO&_nc_oc=AdojUJgb1mVuJ0Gvbr-fbINykHFmxlHmhCSLnLxRb-unWKVvFs4xmoTM8tR1rJWX4ZY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzi0bZPj_PCsljmNU1q5oFfqyCn2-kjoqub0Cm5bPqcw&oe=6ABBD398"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NejBk_dlfK0Q7kNvwHp30fH&_nc_oc=AdpX0u3l7evFmvF0GozpgZANOkzXoOS5yfrwLJoPsbY0i5v5JDlBq-UmHoO0JZWE00Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG0EIU-6uOT8ga4TiLOetr3t8Mc2vqihx_JuyihR6eqg&oe=6ABBCF58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
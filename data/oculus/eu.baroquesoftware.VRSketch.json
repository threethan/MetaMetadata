081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TZDfjKnNBIQ7kNvwEE7ftJ&_nc_oc=Adpd4HD_KNjGcw6EhMgVRSmw7HtsDxXrSF54JyPNtoOjFbGSfqZpo7K3LP4occu3Hbo&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHz2hHn7hlW_tQJjLd1DU3mP7Cr78mAIWVDuE-90aQ_g&oe=6A5A45FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGnw_BF1KogQ7kNvwFF_dqZ&_nc_oc=AdqQO7cLnomqBvGXEJPYOvY4c3lHmrInvId7l72KSt40RhS5xQZHa4dRfvslZm7yWBs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlMi7NyCa8nTA2IBIdKaMWAD4FbUcVE6PkBlWBW4X3ag&oe=6A5A4498"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HeLBERYNeYQ7kNvwEJbbtB&_nc_oc=AdpgcD6Kg6lLuqU0feoYuA5DHKkjOi3VGAV3aa4lvqRvAd9aojy8X3VKKtEK2EfrdQs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9cIJc0AdzdbYOpN0oDkUdfS-aAhBCvJhadYp0Wq1X3A&oe=6A5A4058"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
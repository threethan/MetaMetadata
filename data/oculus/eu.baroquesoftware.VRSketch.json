081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEdAVhRYFNkQ7kNvwFyV0YO&_nc_oc=AdqmXWLk1Dyd7mwylJR0dkNCRB-yCnyu2xMvH9k3S8xW0saDIrk8rnlQ42sMSwJygOI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc0nWm_7lpy2oMwf0l2ZrYkunTtf9lnY6ICIODBEsZ7w&oe=6AF090FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RihlyqtqiOAQ7kNvwEFpeZP&_nc_oc=AdoJvwSMic1A2Fl4YOkHuBQ3CdiOwhwFERKtA4ilTeYo9EwwwvZe-vkzrsCnUOrkIrw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_KwOns8D-PAVzCXD342WEJ3kal4yVMOJG9VAi335hrA&oe=6AF08F98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5jDoZ8vfjAQ7kNvwGBlAwI&_nc_oc=AdpmVfXYIlyteZZDnwqRjYQSOQKh7hZJ7vaN9hjgJ6yutVWIh41hC9SvYQ6AUBzNIdo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjutCu3p36kF_rWCwjubWs5-6gZd1XQ806qmuzrOPf5g&oe=6AF08B58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
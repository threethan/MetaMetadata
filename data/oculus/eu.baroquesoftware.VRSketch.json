081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TR2z3EEnLi8Q7kNvwGuSBkS&_nc_oc=AdpGbxz3W2igBiU5bFT-Q0nzQbFVO4xH2cnbhWSWZ07Lf21uJdp5L8aAqOilitE2Smc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBl-o4WYNfsM69jN6hZtm63I4LMtTJkNoylKw4FFCwjw&oe=6AEC9C7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsyxp874VDcQ7kNvwHizWk6&_nc_oc=AdrYIbKnkWwxctCkRUlKJj0v_gVHMeDbZ6RadeBi0pKXFRVf5xUeuDprxAq_iSfksSo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcqZPXhRulhS9xysWFu30fCF1TnzArlXNLVTisDStSNg&oe=6AEC9B18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eBDjpD-aKgQ7kNvwFdF9P9&_nc_oc=Adr-Y3G323LEAlTxEXo3-lByfygrfeAhIytmQRpjyc_-DOgPVu2W1pJ8x_S247BYmIw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRiSy1Wjt65hwStJO9rDVDFdo7qpv-d86JxX57gfE8ftw&oe=6AEC96D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
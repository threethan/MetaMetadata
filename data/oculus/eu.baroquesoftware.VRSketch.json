081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfrNRwwdqPsQ7kNvwFJZLfr&_nc_oc=AdpBczlT3_Z7CcqbcHbuMRZ1n2d88vMRLL2UYOXgzF4m1D6jSwuW6mUl5zpIm2LcH6o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzzr0TmjhAgV295-_v_eWdqkoP1BuIHbstH13DBJt0rw&oe=6AAFF77D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YY4iWCLiWf4Q7kNvwExDoqj&_nc_oc=Adpa3qhjD_SSkb5t1WSCvpqYtj-4Yr4oPor8k95PL75_vXNhpMOOeBFB6cN9vEhEAeA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL9s5_A6ej48INtTPBTXnfRADsHOVoGVXdH_t9PUFQuA&oe=6AAFF618"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-FIti5-KiIQ7kNvwFldywF&_nc_oc=AdoFRflabMPuxHsOYBYto-Msmf7Jawwxndktbdgc40F9rCKvpCZH3ME4XizeW_sTnnw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYh87wbso9d9d_KvUKoZ4N81YP-7MFeGmYZb1w0HcIlQ&oe=6AAFF1D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
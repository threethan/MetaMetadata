081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUczeK1OqbcQ7kNvwFFTQmn&_nc_oc=AdokICkR9aE5xuf9Qu3ZzUwFa8XpB67eWnD0C41GwVu97X2ApAfZUuFeQY5Kn8A23eQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lr6H83tLqvJbCkQlSMcTDZ3Riy4HnjcDTlfyTyt6G_g&oe=6A1314FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6_mqHClLfgQ7kNvwH4LMvo&_nc_oc=AdrJxhB5U_ARBEx8uQIPGegwHeQyFhyfl7ml9DprULKT_nSTzAqIIdKo-pCb4CLbK2A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sJ3XUIqM7N57Rjfo0Gu4OPudbgs5MUZxueEBhKAWoRw&oe=6A131398"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lF6d6f1H8ecQ7kNvwGYHZi0&_nc_oc=AdppBqKJMPLD1Zm1e-xKS_XMs2u_O2K-Q_op-3HCISdrlA2aT5zsuoGmYEmLYKg6FUk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t1koZ9dF80lYsb6ysfyOvbui1hZaRP2m6viKl-u41aQ&oe=6A130F58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
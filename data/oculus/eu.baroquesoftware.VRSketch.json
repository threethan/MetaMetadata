081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ORk9Fmjq3MQ7kNvwHCfiDx&_nc_oc=Adpz-tj2bNcVCk77lUKDcqKZQ5q_78WMQ-MY9oezN6EzAL2_gbswiggD6FQYsJBES7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_CMsD2G624zHuYcjK9pNWDMZCX_oGRlT9M9FWkhQMoA&oe=69E366BD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5-nqmRFhwsQ7kNvwGOY1vD&_nc_oc=Adrt9epMcUo4E2EREjOFLAGV16BMghetZ0FpZT1oPQnMNWuNmEZdRNqSOOWatrci9uk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MEyr4QDyCIYdvdCitopZYiCewIhjJXMqXtgWtbyL2Vg&oe=69E36558"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaGTpRHGpiEQ7kNvwFkQxKp&_nc_oc=AdqyMeudX42Mt0dmqVrCJC9F56-SkZP0LpKO44dAd_WBKvel3sXBPebnSPg1KrQVdAA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26b3MrdST8lThm7L6WOw5qltAa_lsI5TAgjyqjz0LBbQ&oe=69E39958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
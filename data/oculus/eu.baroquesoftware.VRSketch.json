081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9x4io4ArfoQ7kNvwGpR9be&_nc_oc=AdrRya4OmGLeXhtQ-0MqMmvNs92EjHv4gZkePf2jBAsSVI_qkAhY926jsp27CM3vXW0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kmiZS1rmk9rha7qIarQfqKhknibj6Zm5lFMvM0xcFxw&oe=6A0F207D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EiC0hqKIQL4Q7kNvwHqvW3j&_nc_oc=AdqGVCzH06fUpA_t55pIGfw7yizecP4XEmwG5_qS2Ge4ydq5Dfb_vEb_FzQK91RhbFU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af499f4FS6bgiG1K_6wQwf6TKU8n_Wwjbh3AZV7v0aA4Dg&oe=6A0F1F18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0Wh2hw1VwAQ7kNvwG36gNI&_nc_oc=AdqbDXMY_7JsscOFwuL2trM_jRCenoLvapqihMO22s2454WT1LvtpcPxW-JdO2hRB4c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Ybh_2ARDXeKXajEGIE3JKgDOzL2sekNup3Msl2nW16Q&oe=6A0F1AD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
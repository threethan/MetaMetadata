081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbj9IThL59wQ7kNvwHvkcso&_nc_oc=AdrKNreQD3fFveNgOfLOK2uteFeGkDOQQrzPTeh3gozcbUVHTTWSi4eI40goujmxhgQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzlCIy7W21ldqf60DRJ0dMiWP-79syDDMYt1VBxU9WTQ&oe=6AD38FFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpYgRWJbCAEQ7kNvwG9yJf-&_nc_oc=Adr8GnLmNqFjWX0_ED-TLBoVdbwiRAWYpxwp3y9q_23rvXpB1y-6WEyVrkLNokTj_7M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjeO-51AfkkfteOjZaJbRQ9I-lp7i3Kt67dUPd8fddFQ&oe=6AD38E98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7rLtf7MlyUQ7kNvwE0Tt-A&_nc_oc=AdrqEfCgNQCNtBk0_-KAh6id-ni0KK9mzxyZBRXFo2HNn99LfeeAj04vPUiZsPKJ-eQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwvPrTYnbmhvuv13CS8xhc7EDG7v6N3sgOxp3MG7eRaQ&oe=6AD38A58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
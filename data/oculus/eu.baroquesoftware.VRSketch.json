081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0G7r8Ns0-0Q7kNvwF8phlZ&_nc_oc=AdqkbLN6SMMJxAOTrEoH9ctHsw2aG1IWkkJTzgwe4xCZxzYGnyOqUL4cFhq4SFH8f7g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90quGg8q1M0n1t4UYyrGH6JZ-J41numL-W03-cqeiqSQ&oe=6A2ACFFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hNXeOBVNSwQ7kNvwGTZMkT&_nc_oc=Adq_jWaCdGGDJWRAkCHLkdw1SQ50gQKYma8XmGx8haCaHx8lsh-3EXYsYzhQ1otOYlg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FKXlQYzHA3PS9c_Yz8q1YkEXR5_EdUL3uyVFU6doE6g&oe=6A2ACE98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9ePhOFGVP0Q7kNvwH7LyTT&_nc_oc=Adr3aPRXV5oqkMHdOmggSfDxFwFI2BovAjZ6LubqX37jdg9tYVOMAKKZ4YCRhQneExw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_28I9z0-iATaCsYni8es-T-SPLn91uei063MXcRShZIA&oe=6A2ACA58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
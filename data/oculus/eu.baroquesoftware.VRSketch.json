081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bHLorwsYr1wQ7kNvwHQnOlv&_nc_oc=AdrYSUMGdHli0GrBr-OTibKKnUeHQ5U9PGnK5GnDgM8mORPp6x1yB_0vewI2ys-h96M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MtS3PCIf-Jeq98azUzfXAsJVEdqAiTyR4FfJk4AKQ2w&oe=6A05E5FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OTlP1tzD-IQ7kNvwFNfQUZ&_nc_oc=Adq3N4eWofIe01BgcZbpU5UD5Rz2dvRIsGkqcrXgFQNx1KIo0Q69lsIUq5a_rQn74tc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vGWZVAART1FR-5fYl8yfvtAIFRnWrdYKgfumI6_TUxQ&oe=6A05E498"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puMTnLsvK7UQ7kNvwEQJLCy&_nc_oc=Adr3G6KRZ4JHoY5oCo8oXnOoCJzktov3LkTW-dT2mdVadCIJsmhZBQlVYMJ6EEJUg0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LXYyV0tCwaijGOpsww6yKITzXP0lElQRPYnJgzAgXFw&oe=6A05E058"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfdYY0OYMnYQ7kNvwH40QRZ&_nc_oc=AdriIaKlTzHsq4Ic4N_9tfP6-VYjPLIAjsJK1e-cMSWGmGHI1T4kGpOb7-j_S1e4ZSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHKjEKviYd7kzjcEZC42F7Awfj49RGP7m115OsjgsEd5A&oe=6A95D1BD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QlrUr74ps0Q7kNvwF30mBJ&_nc_oc=AdrmzhNvspDZwQjRxinLdAM_9POK_3Mt8oBTQ82n5yYp-FWED0z_Pqp988uYPs4R8Wg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZPVmEfPLCCwaja9lVBmoAd-BscYl93pVawoxmqwjMUw&oe=6A95D058"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSBliSO264IQ7kNvwFxqWB1&_nc_oc=AdoaFLIbgmBN6KJkxQIsBRHNlfoXvzRbmMcZ-TKTumoznMWJLsyStTQVWb2-ReL8C3E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-pDe-058N_wym4lVVNLQKDabxmUhJTypF9Opzbs4zBw&oe=6A95CC18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akUsPZcagqQQ7kNvwHzOhyg&_nc_oc=AdpsfTQpq97RV_FtrJHs8ShW3vIdQt8ArPYhj3uh8H0avdM9ch9SRyNuCKfQRJR2QK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8S_P3ISRf8KpiYZLgDs9XQVxGmQIiMD-C5gp0K-Fkt0w&oe=6A3FE7FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yq1CNtPrg9QQ7kNvwGnDDHn&_nc_oc=AdrFqWZ7Ixp_UgenVLvRo0BBhstom6EMAVZlLy-2ImFxxI_dUzpLH9jSSUtt7yjskJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VdoiDp1hQJ-ZiceTJPQdeiUXclpxpKV9__T25Kc3-4A&oe=6A3FE698"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NG-VOBYEXwQ7kNvwG7-hpJ&_nc_oc=Adq8GEQ3Ge3Ik7UafFT53b7IqELHxkE-97WOcEUQ6G7EfdNyK6H7DtS8m_o5QAC7Ysk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bssnrZrK0_TAC7ZQnGqWGl34EPacBlGqzrNPeDBn11Q&oe=6A3FE258"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
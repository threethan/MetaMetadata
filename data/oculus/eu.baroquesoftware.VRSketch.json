081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvx_UiVbmYkQ7kNvwHvxrxt&_nc_oc=Adpb7VT1WOvCGTUrqazOYYzJBZRPy_SPHf0KzZ_NfoKnLZaPdxSM5GNzmztVyGehas4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyL1qG_OkMl9vA4WatiOmxqTxEUF3N9Ht6sRcYofFi5wg&oe=69C7B73D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a47I6NbL8AMQ7kNvwH0PunW&_nc_oc=AdoyKKjCSB_AAX1SWuIxxuRQ4DFjBl5WS95PainfWiyr7FlXvGf3-U0o-YSLIyYYsG4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwvf7O9CAuxUtM0m1tkFLSHcn4GBm5ueFkcN8pLq3vTyA&oe=69C7B5D8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaJbuDqlItEQ7kNvwEMQTyb&_nc_oc=AdppMirgPfNY1qAXyh85bFu8NUI4LnxXZQUT5es_8JWMlu_hfZ9-8KlrAMwrweW2mnw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-hJAS5R_WeA2-gQqQOKzh-hjI8VXi7NRs6MsPfRsDdg&oe=69C7B198"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
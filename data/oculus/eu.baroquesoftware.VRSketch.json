081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaffKKrkZrsQ7kNvwEjCN17&_nc_oc=AdqawEEVuoJttJu_0p01fitVpEcP-_rmrwD97YHRlqKUU-AQOqd92EwJSI4tDt9KwD4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMD_Q49-_ybs3nQ_JM3X6jRRZyQ1vSPQ1qEIhZukqZ2bQ&oe=6ACCF87D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erL99eNl09kQ7kNvwGXD5wT&_nc_oc=AdpOwIaVgiItqBdA6bZxndStYmd9lND0bGqpVqgdM7BpJIL-znZEQ02BHfrn4kUTLpc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNyT59EfmMoYnwcDuUgjkwC4_xEL5xekmbyD26oK5hquw&oe=6ACCF718"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4wLng-es-EQ7kNvwHtgNIu&_nc_oc=AdqUK7SoPrBrNaJOW7ppVDChg8xk0O4cEyP73O4CNHg3oy1FuggGLeRXGC7pzdfy1_s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMD1_BHGGssO_oYBtfPbEMvfY_bia9k-7GM5xfOZ2fAWA&oe=6ACCF2D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
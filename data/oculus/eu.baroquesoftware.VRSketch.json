081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hh7-3R87rNwQ7kNvwEc-F1e&_nc_oc=AdqKM3-8rokcuui8OqCN6Mo7VEShDsZ3VBuWCMr0_AWWY2LaQ_7ID6zXFthaKmGFHFo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAg6NG21RachGRYNPLCbSvVmWHEVY1oQeAOwbl1Lh2R7w&oe=6A5B5F3D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGnw_BF1KogQ7kNvwHdSrw3&_nc_oc=AdpHpM6bxCvTALIEVklTXAC55WnxER3UaTs-nlNuGWHQzq4EbqZZJHHF_XIkn1mgueU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDedhkDLsK6vfRBjHzRv2IcBGSEv4cXbxlri38q5k5pvw&oe=6A5B5DD8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HeLBERYNeYQ7kNvwEgdDC9&_nc_oc=AdrvCTnsBHSE1bcMg_e4W1kR3FQyMZ7xMFvzdYAwURXpoQI2AO3j4zuQ2lQ4huA8cbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPGEF3rlqcjpQO0tTQ9nr06I-pN8Ht3lEBjvqiIeZLFQ&oe=6A5B91D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
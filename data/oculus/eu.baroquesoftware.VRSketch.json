081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RypdCS-RX0AQ7kNvwGy_-RN&_nc_oc=AdqI4y1r9eyzabrCcSyKQrzVHPhIDzrK0Xdtaj8UJp9kSCm8mkaWMpFDZGpiAoKdGos&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QbSxDsKZ96nsEF3C3nnNcK8jUP-8JiCsolJe6iBHFpA&oe=6A3D44FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQeQ8bv9VLkQ7kNvwH2F4FZ&_nc_oc=AdpSH1jr8Gq2ZadEH4klNGhatqFlxdZ4I4hYClKfxQTkh9UL4zWd2zh--vMzoz5XT1M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nCW9dwjrCn8EaLLi8Vr2Cgiu9Hqm8FxZaykkf9JC9zQ&oe=6A3D4398"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NG-VOBYEXwQ7kNvwFCTOY6&_nc_oc=AdpGs-ZGUuEcd6ZVD_wc9Be8RtvB-fcKeLsMC57tpRTZZCr5pBQV1kM_Hb29cEAn1I8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wcesl2OP1xbqhIW7_SeZCyjh_i0vngJ4NwasJGkXy9g&oe=6A3D3F58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nkJz9Av83MQ7kNvwHRujnn&_nc_oc=Adr-5lkThqiNAJjrq8boTcnzsPPG7KAotNZlzDHCCzMVEwhYiZImuNbegSd51RCwZvI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bntZByAVq9l7zqW_PNVQgi_mX85teUj1xgEh_8rWRwA&oe=6A15B7FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6_mqHClLfgQ7kNvwFsmLix&_nc_oc=AdrLyNqmnuDB_G4kz6KRyM15RvAZ_UcH_ZqgxbNZ9cc_nKGqc2kahd6JYP3gAyYCYyk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78ePAsiYlRLRK7IAf70ITt16sP3dsqdcuqR2D1cqGbWg&oe=6A15B698"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emTAbHwnsf8Q7kNvwGjgDfH&_nc_oc=Adq97OSyX-r3UMgYulUGPv8LxdxfCAD_CrlyMDrYDPF3g89bk1NJ86omvVcS2okzT-I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6CxuJC9ZdovlfBCPN17AdklQWZIpsKi6kT0UGAOInCoA&oe=6A15B258"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
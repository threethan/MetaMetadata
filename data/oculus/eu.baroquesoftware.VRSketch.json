081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuQPJxy5ARsQ7kNvwEe2HAD&_nc_oc=AdphgJ5QooUaPsCyC7XQbQjUHT2bHXAjwONMURSgT8a0kf1-1525LTE5JAhIRjAXPlU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7trSOurHEpPWctaqi7T0oWzIloCj0L74jBOt_IbO0yWw&oe=6A1EF27D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3oJSYXP5s0Q7kNvwHjmnw4&_nc_oc=AdoP4Ev0TYnOTnoHdmkqUwk2EqSFcW65k6I3GusTxM_U5ZpVhiEWYqMQuvjHBvWu96M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wlbuC3BAyLupWcfgyss69kRys9J0MESPRqRRRK3gyEA&oe=6A1EF118"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P4BNP2e_IZQQ7kNvwEIpeaH&_nc_oc=Adp6qJW1sF7LGufkAX-WQXG3fo-VEB4jv6FnBHIKnMUZ3bJLXtOc3F2Dki5y6ZvsY6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_wSpUkJYne_bxMcKgzmRC4TavO4vGIUOYipEl9neEkA&oe=6A1EECD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
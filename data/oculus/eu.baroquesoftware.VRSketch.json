081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ni3dlEEoN7YQ7kNvwEUGYoS&_nc_oc=Adq64Cn1xgQNqjtya8B8XMwkDfeGD2q9rJMB0_KwjmDEJUn2JAsV1Xdl3I5_DfhWDKE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1InkQSOcwr1mLLdd6A2H3a25njTh8573otUtz30hQaDg&oe=69E641FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5-nqmRFhwsQ7kNvwEcXQSf&_nc_oc=Ado-t5jCpgwr9Lb1l3QzHDuuDHrz7z5bT7P-TKSOZ_OV2xWWWXHzBwR60RmOKPJTTLU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IvUW6bnxnbsQXYVu0Iw2WLUNgdwOX__QR0eN6GcJWMQ&oe=69E64098"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My5LOV62Eb8Q7kNvwFZYC8z&_nc_oc=AdoBF-ilFtnlYCPBZRjT-y13KmOIZHew0zZHNM--IU1kZ2CTKI-l7kqTnoDHcIUW_j0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P8uHDLovcIVRhs_w5iP4rDI2FiDXmyaHFxxW-CLafdQ&oe=69E63C58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
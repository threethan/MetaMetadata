081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFRNnuYHQKcQ7kNvwEyeH-U&_nc_oc=AdpD4W7CewQjgkqh96m_Ctg-c5DtAstA7TrtnslwFsRwzz0ADzSQ3uSdBWFD8cSc6Hk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwPWFcIxqn_o_E2DrocIQZeHO0A9_xhBs5TWEcqIB-Kw&oe=6ACF9B7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erL99eNl09kQ7kNvwFMz4wS&_nc_oc=AdpMLWyzJHRMc3aD8ky3iog028oZFbibPy02fOZdDrackIYxHMLetsxHp9-7CXXX69g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOtv_ZHhYpttHXrSZVqVbIP5PKIX2S-yNEsF1JWjSvoQ&oe=6ACF9A18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPSG26RMd9QQ7kNvwEHbCag&_nc_oc=AdpokYDtr2mKtuT863Y-16tTbfCXUXJX45PY5MLCrd1dHjnPRw2-9q6JFoONfI_hDlA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPUiSadTgRibkstLsDd8Uu1H4xJIVfOjGCpPEGYHfM2w&oe=6ACF95D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
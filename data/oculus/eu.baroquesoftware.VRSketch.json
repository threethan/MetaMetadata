081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpShCUVN81wQ7kNvwEAyaW7&_nc_oc=Ado7ejotpTVbycJinPGF7Kd92I3MnD5wZdyJ5MLCM0UAGSSPPFYTbA7-NLUh2skcMzY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Kb_9rKQ2RhR_hv6b5o9FqNzWO-Dd6gnLS_dej3UhmXA&oe=6A24387D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q51C4GbFB0QQ7kNvwF6uOsF&_nc_oc=Adqdqd7FdziU88hW7Vk6PUrInEBIrUdVD4PSyy6fqzzqxzT5NoiIPvSKIduLMzCm25k&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89prrSSBYp_aIHs1uGh5w1zOSXgJIv-LDvsmy_PyZfOg&oe=6A243718"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7HrQxhJE64Q7kNvwHt6b0J&_nc_oc=AdoL2bhndkKHkNw5qm1nS5dW-Y43mwjBHWQaYlgwkcyz3yTubQiFDClvbdAplW1G4K8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CjS11tEI-6znzRNTBn16DFEmLTrKGviLSdZLvrb3xhw&oe=6A2432D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
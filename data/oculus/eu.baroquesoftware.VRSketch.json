081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdpHBRFW6eQQ7kNvwFD-TaK&_nc_oc=Adq09wJMaXly4Mw7tGRSAAxhcRN5FZ3_g4CSo10JYt4oyvGELqP-gRgW-CqHqkcDuOQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRo1ih095RnFVownuXKrhM_ZkszQfGzerJiMBZN3s59A&oe=6AAC02FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3f6B8RIDPBIQ7kNvwHi_1He&_nc_oc=AdpgTLiZbAiwoXcRPHvFLliTCRAiS4V0s6ppPP2mCqcAmPaNKMwgZ6ekUORS3LakqN8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcapBnWsR1lDKkNK-LDKmOPJIbvvdRR-PkD4BAgRcycw&oe=6AAC0198"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZ3Rkn0aOiAQ7kNvwEvBy9x&_nc_oc=Adpz_h_2_rM7f4T8gPuOf_NW1LZy6hJ5p0ZENtRp_j44lZ6aj44pLbSTa3RYRr0o_J0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKuBVxb1U9t-bjGGeXLO2q-xLVFnvV9YilVZkmUAavl3w&oe=6AABFD58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
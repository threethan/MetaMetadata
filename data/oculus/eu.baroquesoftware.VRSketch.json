081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0G7r8Ns0-0Q7kNvwFXuFiE&_nc_oc=AdovqElEDETxI69LTYvc7kVAJyT5eGkosjKk_fXwwPGfjsoLmR26xGJxME67H6RYLDU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t9Ws1M5h6N_KaVPw1mPgyXVRRNZxNpj0LTEvag6WPDQ&oe=6A282CFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWN5gLFzsnUQ7kNvwF_qKYl&_nc_oc=AdqygeTIxUiTx-kgAbS8_MhEjsHTr7enNpmujip2QTIBLUaNPwFeaisnGgEoOyM3k4o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-x9D1rv85KSgeMz_2PgJGldJKu6Maju2xZr_s9nexY9A&oe=6A282B98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cy27QT1ZZxEQ7kNvwGaDPS7&_nc_oc=Adre09esCQMl0vAaVn7_G9YVOVC4ZZNTA2EbW0fM97oJLXGiuiBXHmcLhk2slkFajek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rCMELBTIWmJL2AG3j_BvCe-wexplYnzOM6Qvtqr4QPw&oe=6A282758"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
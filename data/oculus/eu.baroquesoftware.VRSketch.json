081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMylTDqmj0QQ7kNvwEuAejV&_nc_oc=AdrxwQbJrEIX9Fo5MQmv-wB24H9iORPbQmfMrNsW_L_IBw3f-Gc1JeY0yLHNEu2oGbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOXTotXoHKA9NHBjsq0JwCsNpVj_jfW1qo37ChrXGqBqg&oe=6AC3BDFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJLsKyNvxvAQ7kNvwH7SbrZ&_nc_oc=AdqB8D1GzL2bKz4kjQuCA8kctfzPplhy9ECiV58dPH8K9riZ85g1GeFEg-1DVzMQrY4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOus6FtU1GS0UoMWu7LaXYH772ylq6dCDG0xRClnEiaxA&oe=6AC3BC98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeKrfidYkkEQ7kNvwHWBBJ0&_nc_oc=AdrU5azRavcgAGScLJ9VXoCmYCXQ64SNVpgrQFNwePUyxlbvUNfDjiYVMJyVKyLOT6Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKQJWwnXJoEEgy-FHUmKDps0b1sv_U2gDCb-KYolvywg&oe=6AC3B858"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
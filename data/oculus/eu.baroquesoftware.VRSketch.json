081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6R8f7B2v_gQ7kNvwFLJibv&_nc_oc=AdpYlJQggnTFLS6pkokQXHuR7Mblshzy2ILIKXUqTQs5X-EwEQuChHCgvOH-VyONbwA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVwEHjSBpCgdX4s0mbW-2vkbdV4A0f_rSEth-WQG7_qw&oe=6A49227D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Tsj9hsLWsAQ7kNvwE2SvtC&_nc_oc=Adq-h2VmkHZ1gxOVCps4TCHk-RjeDpp9pXM2Lywqr-AZnMxsd6DSTzppVvUix_a6eJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_oCTXnL7MvRZq2ZhN-2ZSLyVxoX-ddBmN1cuvN5xfYw&oe=6A492118"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3nnQaHxJmkQ7kNvwG1Pg8U&_nc_oc=Adq2gb7D4nRvKgXgV7RUC_QDzZyIdbVT1NjAWyKt6YhqfBIrLgqmQGOkCtlvdeje76w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBh6DdqGTmQC8iKQ7-ZDS1jYfBHbavDagxOVshykS-Phw&oe=6A491CD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
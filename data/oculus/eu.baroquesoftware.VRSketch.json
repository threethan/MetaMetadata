081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akUsPZcagqQQ7kNvwG4MllH&_nc_oc=AdrYVDiHA3QEINZXA-gHN5MRtI7GILkq-wHidkUyAHs4qZP5XMWFw97KqA8KGvfR4Bo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2yPOjD1RgvxnG8HwalvL9MBTrFbK-N51xkgXrgrmFig&oe=6A41397D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yq1CNtPrg9QQ7kNvwEcBtRJ&_nc_oc=Adqb-Ua1dEv3Fe89IjeX13ibEqFbwem_NYUITPsFcMGSmuhQA0ePt2gupRsimBvuOwE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QOVd5CKYAEtA4kpV6ngvcTPyydq51C7sjjuYqRSNiIg&oe=6A413818"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRcPIWbpl2EQ7kNvwFBWG7j&_nc_oc=AdpWya1bIu9BGUWbKgzHW1afFNQgn1sz1vtV3_y1zu5TgKd5jQeN3pZq2zpYSfIXJqQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MeKuDgqC-gFHgEJGTiSXfvi3YSAY_A6K4B4dXaSOX6g&oe=6A4133D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
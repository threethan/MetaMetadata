081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9x4io4ArfoQ7kNvwEcAhHd&_nc_oc=AdqB6Jswrhy-U1AEeglxNDEDE2rutcn5qQVOzbQ_LsVnfXj_uf1m5FMkEE_Gc9buOkY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ga90Uj2D86VhsW8uYq0bb7xATlm2rutlJ81LGOenGhA&oe=6A0DCEFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VC4pwg9G7CEQ7kNvwHQ5MyY&_nc_oc=AdqG761yUlqF-MqBhFAtOSl9FWSOuCSCdUwkku9RFOFL-R81lu8VHKAvsEnUQ_Z6cTY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6slp3wCgK4hJL0L9HDUvqyDCSVGO58ECg8-isHhhgxPQ&oe=6A0DCD98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0Wh2hw1VwAQ7kNvwHtdIg1&_nc_oc=AdrGEX13_aEkMW_enHfjbG1qgl8QEmpWnv-4VBvXyk_Dvi2R8AIRqKyLEyYZTn7rGBY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EIvk3eUtcNFofjCIRnM7sbAVUdnrHkePbiE1HNvqy3w&oe=6A0DC958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
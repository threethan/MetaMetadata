081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOaKxCBlaoUQ7kNvwF8B7zH&_nc_oc=AdoT25EIqslzTBDH2L4bQTMADkCYbiYJSdNfPi2RxI6qNXwMcp1vjIPCQcQis0jZUhc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Rlw0LyVH8z0mEgGyfU12OaOOoZvcg0zGhuP22di6LXw&oe=6A0888FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bcxWvsaVJcAQ7kNvwHjc4ce&_nc_oc=AdpPO4U-3GwmZ83Q8givsuTlt4J64RZf4ZgtSIlD9n3kZdHFFMEg6nsK9614YQhDhKI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5veq4SEntW_Wcut9ZpMVUlqykqkqWI2th0gwn7JWy3XQ&oe=6A088798"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puMTnLsvK7UQ7kNvwHg2m4w&_nc_oc=AdrbJ7YfOSKWajclQVhTSAp_axRcdxlK_q1btuehJnyC-Y3ORuJrecLWHAe3PWuOdqM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7408wMvUoEIZeMWi0ZHzexis8V9JpO9XvesRBCJm_Emw&oe=6A088358"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
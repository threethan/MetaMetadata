081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bz8dutFSSiMQ7kNvwG9MOOs&_nc_oc=Ado4MckQXXLkAioeK2pJdAkg5ntcB6A_ri81jD3MGRh9Kl5W5cN5f7u2nkr9V0hwf5A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5u8bV58_UHBYYEAyCSYIhtyTbhN248Q1BbBXNmmplqtg&oe=6A1AFDFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsmvm8L514UQ7kNvwFS1XPV&_nc_oc=Adp9K54iDlRMOJcsLaugYkToKnCxpQvr6rtx5IYRJOGV5BfT2x5JKasbJwadBu5ibrc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZJp1KXW3PdJtPbCLaGKKeFxjXI_x9GDYN6Xk4bzy6fw&oe=6A1AFC98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohscIMgezp8Q7kNvwE4YEcT&_nc_oc=AdqVXTCXDnVDVBMKxkaTWOInyaxwaVodReL1OWT0BckG9jJBtzxnn_gpr2XpjDO6J40&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aI9DQBuo3reoVXVSZByoqpk-6mfXFnvq7oUq53eejSg&oe=6A1AF858"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
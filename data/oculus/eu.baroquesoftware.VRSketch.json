081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5g6xxhUaT4Q7kNvwECKpW3&_nc_oc=AdpsgqWYWjfoseaWFVaZQjS_CjAHGHN21rqTXjHeWJ2jDGVFy5pDOclbxUIdI391SHI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7pjvmpkcbQKi2LikDGzy7IZCp2cqq0rJeeGCIcTSbJg&oe=6A998DFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gYOA3qnck0Q7kNvwE333GO&_nc_oc=Adq7UTIcpwFHVDgzjIuY6-qq-EZr_FL6jmCVSzkH-9ObOHTHynAXUiExcxlAo8OuciY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlcNSbKInELoU_HBwWATdR9TwtOObI_C4k7pl98hXODg&oe=6A998C98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P4ke7dKUQIQ7kNvwGY_AcP&_nc_oc=Adr8ykmxWT80XoJPfoVZcYU1LjiNiroGTfrGD7C8NfTmtRi5Tsii47U7kr82o7Y_WAI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK84pz_2NxXxWo9erG4P4GIeaqLxtDevu0ZIIof218VhQ&oe=6A998858"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TR2z3EEnLi8Q7kNvwEHnHCf&_nc_oc=AdrMiPwAu_FtaG9wFYi1hD0VCmHGBfhC06doDjHZJsZ1hS4ne8u51C4NkBLAcHp1oC8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMxsD_NczNUANECA4Bh9TXfIPHrMG9Rb_9vsFKQt8SHw&oe=6AE9F97D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BzimMnaSSgsQ7kNvwFoAbnd&_nc_oc=AdrguL4HcvOKteEHtEaCBZgX-7013OkgE_KZn6puLS8lYLi5egBN1dj_vK71b5r_7nc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY-CrGnTz5WOScGCK1r7ZWCTDFH-xoe-33bF30Uv1wjw&oe=6AE9F818"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnJJdt_gu-kQ7kNvwG0Mfdx&_nc_oc=AdqWHwrDIM3mdj5OwdoZoLYKrkIhnt6cBLNaWhenIfcvRPkU_XzVA6DBBKrAwnWU6C8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPIPyZLVnmIUa3br0Hyh0Q6O17j5UmIe-DRrWGfIw2OQ&oe=6AE9F3D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
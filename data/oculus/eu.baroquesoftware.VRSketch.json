081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdpHBRFW6eQQ7kNvwH43Wjl&_nc_oc=AdpdR4BrWpXuRq8eymShcr5VIdlUFn0vAnFa39pA9ezPQ8ISUdmQ2BgRdyb9FO0mNeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdXEL1v_kITp168Ieyv1gm_JN_YsndC5rz1QDCjybQuw&oe=6AAAB17D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3f6B8RIDPBIQ7kNvwFI3QD9&_nc_oc=Adr4zlJcjD-mCW-ska5o_Fr1xNoQ_4cu42KlH84zt5foPIHDzJmPEh25_75slSTPYmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTL0WxyQbaALDUDMW_E2mRP6ehWDlGAgfZ4r_Q_pUPZA&oe=6AAAB018"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INeUIDt74wgQ7kNvwGLJpoO&_nc_oc=Adq94QoVlhlv0vOo_yBH5Vaz8ZWde8NBgCYpghkO7vT5utDIUbZj1GEn9Sl2wUSlMVE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkJIxkeCZ3TuhNnolAoARmB6I7mrE0t0APvLxePldNtA&oe=6AAAABD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nkJz9Av83MQ7kNvwEEUqK_&_nc_oc=Ado9EYMYW8XaD3taq5NKjnFcPsJfDMlXd2rjnOH_DoWx8YoHKVmMsHWqULxHI4S-MP0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yEedgTDad1gJlRfVbJlnC7q341Y4JaKgjJ_x01DMbZQ&oe=6A17097D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLhCwt50mgwQ7kNvwFfGpvt&_nc_oc=AdqcybNl5Cn8XQ5tEFj92RYLwkdZqDKWHsK5z8ey6opOzHaj0m3g511qH4ZxfDdXHZg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_8K00U5s-W_Zo2tYlJotYMnRihmUB3zGlelCozgBHsQ&oe=6A170818"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emTAbHwnsf8Q7kNvwHqumqP&_nc_oc=AdoN9Z_ujohr26rkAy-yfCIdO2LlvEipbBdNrEcyCHUlp60MdWfg_gHLrAmmtONSrM0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dARggr1wg3F-OsLDfg_iLDBU3RB8-4HZfht4eoSFGzg&oe=6A1703D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
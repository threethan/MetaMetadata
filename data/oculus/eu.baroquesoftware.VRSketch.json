081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdY1va-pi5gQ7kNvwGnBjAA&_nc_oc=AdpEhitxwsN3NKoUNzHNDMKdCwSLH5AHhx7wIvjNG9d0tP66waLJelyEF2C1Joiw63Y&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8IxBcjYQCkIn6yjdkRRxoWcdTIi1jTRzfuxegipZ_lw&oe=6A6F5DFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2NijhgMFZeUQ7kNvwETfIaF&_nc_oc=AdpK3TTTwsBrCK2Cel1DpQZJZvjI8UlI0TjDsADJqshNoK8HTLEWf5qNFZGufejOAkU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_Sd2lWd5jPvobQtrKd5IcpMuQbDsAlwM1mSSiwlhIEg&oe=6A6F5C98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHWC9B98s9sQ7kNvwFnnT1H&_nc_oc=AdprFpIWl20SyDqp9hz8mqyboMgbX91D1mntjf2q8NqPz1li688LkGvmYCGRKdEwiPg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAK1MXS-klMK2C2sGqQrhbojkbhoZhGwPyWRFSB87UtQ&oe=6A6F5858"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
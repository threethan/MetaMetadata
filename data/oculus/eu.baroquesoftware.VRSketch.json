081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXeBV1Gsm0MQ7kNvwESVqTI&_nc_oc=AdoqPorsUuhO0Ed4k3f5bYVW7qSLfzbah6a_PZc_Pp8aECl1HlUwyt8otvkmd-XzQPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pHOplFaEkLa5O9_94FBE1Ub5i-gzIJW3KAR57dnD2Qg&oe=6A37FEFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eg2IKYl7Wi0Q7kNvwFZO1yf&_nc_oc=AdqU5w2pUtMV-D7Y2fFO__mQllvrpCHZ4-QURxtUCmm4eaX5pbaPNq7IaBAiM1O8a0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nbY5n7uge4Ct3Se2bIGcfx4w8CdDtJko4fcvfbOHz-Q&oe=6A37FD98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NSgDgMQWoMQ7kNvwHOQYQx&_nc_oc=AdpXURimt0m5B9UwsP-YsP-2wiSx9cBM5WwVsFJU3qZgLfL8QI00-k3VCUr6X29_Ibk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8U7l8j_C0_toBc2lqnkP8i33YZziTZjXXLQASgiWRCg&oe=6A37F958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdd4CeD0_FgQ7kNvwGYZy6B&_nc_oc=AdqyxiWSnXKjgMzBlw8Ug2V_xaE7hQk95-pvuadTNmYOupAdKB9fGVpgRbc-ST9fK0Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTNtliVVAN9Y3s4GDfLy62piXuC6hXZHR5V1ZCJ9PWGQ&oe=6A4E687D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngBP_2YXeuEQ7kNvwGUtMYo&_nc_oc=AdoIMPgygzoDtsp3GaGqMz5bQzI9ih89mQPdwfYG2YwQz4V5M2xPKA12CN7R6__ANKQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTKzkrx3F9KeF1bUTF2jPy2_aimSDIcRW74CQ-jJM2Ww&oe=6A4E6718"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqRPx4xl4YcQ7kNvwF--Zrc&_nc_oc=AdogoJTcEtuzIJP9XvS75JykigcziZ44_-LxVa801LTkSD1c36Xpui_CXY4hNDh7t8o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj2lUn7xpWtLpGOAB4Nguui457phuWZGmqIbhYxejNdw&oe=6A4E62D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
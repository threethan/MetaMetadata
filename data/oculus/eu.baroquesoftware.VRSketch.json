081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ni3dlEEoN7YQ7kNvwFlgaVt&_nc_oc=AdrhMDLiWx8dfe-QCpNfR8om7UzQ-lhnj2QgQ0zdz2xIMLFJ-stjpGil0jlNrAPxWaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11jkoCtLNsmOPhMQ5z02C7NinrqZzlskuRx05JFdlCgA&oe=69E4B83D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5-nqmRFhwsQ7kNvwGgZ_sY&_nc_oc=Adqgs9-MFChnEE4aPC5Verp-OvJBdhNKmANlZZYH3aLzN1FC2kC8y0Y9WJ3jahpPlFw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af17_CVUgFojB8aSkxN3ElOFKbV3_b5DOYAfnQ7RhsgKkw&oe=69E4EF18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaGTpRHGpiEQ7kNvwHKuUwx&_nc_oc=AdooS6dlrh-7qQLg71P8_0cpM0GNGTCNcLb5lE9goRNYq9zedi4eSqhANT9q1o0s5OY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3o2uycv5rF02OpZZOtCu99712i6X9dFzDg4bmDEa-TAQ&oe=69E4EAD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
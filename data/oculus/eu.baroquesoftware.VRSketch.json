081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94m2iQWl9I8Q7kNvwEi4Fwo&_nc_oc=AdphdDmVR9T-qGgyG4hvG-fjlIqnYwmaEz1fAYb0hQp_0qg-CdLgTQPvLFnAIY0yhvw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKRBEuN_zzFbL5LYfRClVfBfg8vUEYMB09pDzb5UupDA&oe=69C3C2BD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMRrN6nRniwQ7kNvwHVvTEK&_nc_oc=AdoCYc0J5Qec9N04Qwj5vuplleB1f_1_Q_QNCm95RivY5Ky5vxeJI-kzGiYmTDUGmn0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwY9sOjCw9C5oWqzj7csnFEK8YW3Dose0qO9X_70rtNhQ&oe=69C3C158"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lb7UyT1Fvn0Q7kNvwEjY_ss&_nc_oc=AdoByBigT6_rhoM_3s_dNFIE2ptCKc1Xck_cCbAWvo92p2scCOBJ-Hrt2oi5vyqgGso&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_D4zb1GZYl8vt2NDebvDxCmVzDyH0lw4S19pBEg7J7w&oe=69C3BD18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
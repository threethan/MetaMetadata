081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHwZAmlD3SIQ7kNvwF737XN&_nc_oc=Adq033ujvYiVHsZFon-XIjmKvJywSI0MvML_nn5gmWH-cDgFUoeBv6lwuJz0SYqnux8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTn4iAy59jVRal92lCAt9yJ-RvKt_uuRfB0bI_TOXcAQ&oe=6A73527D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZB63cYtK00Q7kNvwHM6AmA&_nc_oc=AdorYAqUSaoL5meZAlISvVnvsSDC0cfznty4VsyVDs2H2dn_HKmWNj8anHVwniAhigM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFchAafeN8wJSNuy-mCH9yxt_9uwS-5U7r_4QpCKC79rw&oe=6A735118"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSKv9KcCWZ4Q7kNvwH_GqTg&_nc_oc=AdqoCal3wVdu7pyW1afTLmlVAI4Ivk1PdyiKaCk3JmzPTAiC5Aeost-3pMZXSFdPRQA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpy4PwRcFy9KE3Fl_es4R38umsCwHY0846KZtU4JB7ww&oe=6A734CD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1PYusDXuaUQ7kNvwHFTqDs&_nc_oc=Adp7bIZ7OgUsZExD_VjMjsnZohqkPeFgse0sFR3NpluVUaw9xnoTTTRLrHhPutru8s4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEBAyI_9T59HnsvZ5C-bdOoDABAfZa5RgY_PjPmIZdGIw&oe=6A7B033D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-S7bbyxcvgQ7kNvwEkgkw8&_nc_oc=Adp5Vm7qqii0qd1QHQFtrUPHXt4TIuDc1b30Y3KyxABiewVZZm_ozxsB0NUvZCgMiko&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBUQkLhmPGFfmSO_w-fAPexmiStnqeLTxtua7CuKtVzA&oe=6A7B01D8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EnJUKPcSHAYQ7kNvwE1jpT6&_nc_oc=AdrzS8lj2q-ygWiuwPfvyNINYMXlXWjp6bCHGEiFXVU9x0691uc3EUaCr3jzpjJy5YI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-LUw0HhA2pbm793_7wHwNqnuq6EaqO939ioq_FIaEIw&oe=6A7B35D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
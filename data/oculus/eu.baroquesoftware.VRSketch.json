081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0Pt72SfS64Q7kNvwGrHf2x&_nc_oc=AdoNtkPRirt434dp16aITc4WdiRHHZzzdPogt693oqUXY8wGOAsnn9b3yDUmi10JhwQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwYVa_YSpNrVxDQmDmJ3sqMBYyIaGFnKeH_zPJ_FPTxg&oe=6A86E0BD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dilcBZLJ3FQQ7kNvwEejzDJ&_nc_oc=AdpFKVSJkfTfSoA4XT1O07PnQMSffGPu0xal7bzndzAQmkS-XjDMDtfzarXtwveD0iE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfzWlB3sFjFIsFKzL6WadGxJVtlqNMm9qPSdMIzc3UEA&oe=6A86DF58"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jp2qDCAaDAQ7kNvwG8KvRM&_nc_oc=AdovPSQ0lTlhk5KM1zdhOlhInCITde-OeRbDXmSRuB8Wlq7mSHRwOulrOfS7OI-1mQA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbV_rG0LbKKbWoD04D6LxiXO0B4t1GsdQRAqJ-Ml910g&oe=6A86DB18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvcgyg_D4NUQ7kNvwGHchQB&_nc_oc=Ado_JL2Hpqe7QoL7M6yjh2W6yz0vfEgdOIaGCDwzZmMRwIifqcnKFeHCkgebZGZ4haQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMpqNJYCE8SjfNrmbJltCbQoyt7mUKi7GeM1snJOPuUxg&oe=6AE0BEFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ1LF4VP-20Q7kNvwFSwtC1&_nc_oc=AdrZIXXTSfhIMK-v1LyZVHF7uH5yE7bleErbVlv5b9VDUNCIFpRfk_hS225aNGUBnhE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNF5Oy1M03DCFR5Zbnk5qo2-bSD33iHgFMHwPD55aGCYg&oe=6AE0BD98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIHLRvzUcj0Q7kNvwG7ef2j&_nc_oc=AdqahpgAdHATeSZ4ySp50yQ-xgnMRz2EjB4k_r9CZlrsXw4QTkjqoQSBY6N4_b0f9MI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-ge-A1CgMAFdLZkUCg2VMw5qnR3oYscDgLGwaKZC4FQ&oe=6AE0B958"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
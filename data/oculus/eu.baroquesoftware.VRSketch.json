081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8PyAZHEFeEQ7kNvwG270Yi&_nc_oc=Ado6G0JFsP3JXnn2mBKhv3YS9mmx3sa8X_usHG14SQfWb7khkGFVpEvOF12d0nqVgp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0pPZpZP0dunlkCnURGKuBd90xuw-nK3fPZ682YGrY28A&oe=69EA367D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSekGxfj9yQQ7kNvwHAX_XK&_nc_oc=AdqREcNwtxRdBklKqFdLUSDWxRrMKLuTBwt6kCxkHHtKWGp-nP9Hy57xN0v7Am5MrFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Tcgf5ClyJ6jFummoE0_ta7qLlger1KixcBv8DdcURxQ&oe=69EA3518"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKSPOosq6I4Q7kNvwHX_uwA&_nc_oc=AdqEp1RJKBf_mOr5K4FykSo9me1JNdToBUSL1-TcNapA_YRAqiNkTGhqIm8XuXH_vfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af027VjY4FXXTZv6kowILFpGdt03mKaM6o4YgJtxOqk_Rw&oe=69EA30D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
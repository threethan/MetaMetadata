081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0G7r8Ns0-0Q7kNvwG8m7_8&_nc_oc=AdqnLv_aw27RmCEzqjSXdxZ92o467DLtn7ZSe2Jx2vEBo-RarCgzCiVylN3nBKNrKIY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9RIp4E1V6f0rC21anYznNJZo4W7cX2ORnnBk4gGeDR9A&oe=6A297E7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWN5gLFzsnUQ7kNvwHYMGCl&_nc_oc=AdqaowmovESeP9DFTVdmaIlTttzog-Rc2Ke7sc3sJuJ3st-rSx5SmCAjzXIL4drwoUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-G6WNyZ1xCLSrz4-ZzRoa0lULkho8vX094sAUcQ9X-hA&oe=6A297D18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9ePhOFGVP0Q7kNvwGvH4Un&_nc_oc=Adre5MELCDcGiczUJFxAgyh-MXBXtUHrHxU4bw8sjXa5BWm2cuaRPOOB7PMSXThhqng&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UQKvxypOfz3xtENgg1_rDI4aKuu4OjA24fjEc6yDtLQ&oe=6A2978D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAXh0wc8UawQ7kNvwFROiEC&_nc_oc=AdpyW_B-0K0BjKWI0O_7pVy_1puAPDRfNO0em665uE8Y8HzRnrcdFxneTYCaNoPAKSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54BnxHK7P79kcKo-Zm3lGrM7sZe0hefPHN3Yam4a6UVw&oe=69FF4E7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mzQTvjdIzP0Q7kNvwHTXimT&_nc_oc=Adrm7KRcrW_tc0tpcdH9shYzDV6vblVQ191_lTnMWL660jpse6ElThbXGJH9yYWuHz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5E5gjLGEz_CV3iexWVriDAz5c-DKB8Mfi5unjivv7Eog&oe=69FF4D18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8DFxMNzq_MQ7kNvwE0CinF&_nc_oc=AdqNKLxoY7OUICByXvz6wciFYtAzaFvItYz_Auw6oQF6Ys2YWS2X2Wb_mlhRGGp9q18&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VBquNuehitAaQ2AxZpwxpbbHzOIxCA_9KLWo7JNHA2Q&oe=69FF48D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
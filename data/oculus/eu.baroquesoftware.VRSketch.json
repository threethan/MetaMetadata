081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFRNnuYHQKcQ7kNvwFs2eQH&_nc_oc=Adrx_h4fIKr57bd2NBL7zDiV7AFBwtpDMNDJ8c-QIL_Hv51QhWGD8wR3k7lO0nxtoLU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBLLjs0Vq-sp-TYmckKAkcWvtpxIi8DCtL4mjXKzfHXQ&oe=6AD0ECFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpYgRWJbCAEQ7kNvwEGXFFC&_nc_oc=AdpwTsb8ccEu-kbCqhl0mSHIu9COQdR0hmoi8nBkhr93PcKxhbEcXS8inRLA9WQ7bMw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-NWniKWGDJT6XHL2LS2MFp7FRPF3K-A2CepqKKKVflQ&oe=6AD0EB98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bPSG26RMd9QQ7kNvwEfGj0H&_nc_oc=Adp888xojMMCFfT_HV5yNOuYO4iYsMADKFkKCvyGjEmqi5R2Z27NBKb7bojmcfmG76U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODjMhxQFMstgigLDQJ-efmS81IRH92pF2T4VWWwIpyYQ&oe=6AD0E758"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
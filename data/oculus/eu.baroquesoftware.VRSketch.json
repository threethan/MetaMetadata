081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zz-b8l4vwHAQ7kNvwFUi1wy&_nc_oc=AdpYipgA1IYU6Q339ottS9ZtUYYsoMlZANNpA1Pj4iAubCwUaTkK8EEjpmMVfnuPNN4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13NldXPcKRvQafD7TpdFukfxxwVsPvnwpljDQFXFQYew&oe=69D8DABD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sANjccNgRG8Q7kNvwFXnEPi&_nc_oc=AdrOHCdXe80fgMfysPPljqXReWaU1H1VJZ0HSA6SPO2qOWJcctftyZUvNmwemY9gh5k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0_N07boRFZ6ySa2ZOiYXa3W8kDHoS0Iib2VIt8BD7Vng&oe=69D8D958"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8Dtv8bV4AcQ7kNvwFciVSf&_nc_oc=AdoZV0smzahCFHTyi4lhePt8ASoA_uZv5lAxHx69FEhZQEqkm8AxN7sriquYR3BG5g0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20FaUnw3mtvYTVUq14RPn7z5CbRa76Kv5LX5i14ixwtw&oe=69D90D58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
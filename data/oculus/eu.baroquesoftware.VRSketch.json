930592081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXeBV1Gsm0MQ7kNvwE3kTgp&_nc_oc=AdoOAcosd_BUzMb2JxirAUuHcJlGA_gdbLQ0eKtRpenwSahqN-Os2pTmni8tuqgQ8uM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tTWxGw8zIgQfvduO7K3uzaoP-u3vp2QlFSo1qplUxgA&oe=6A39507D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eg2IKYl7Wi0Q7kNvwHxg-9h&_nc_oc=AdrgAxobNZxjf90hDQRH3NU9UqYs7Dx9-rdawPHlWwaxLreAyZ7rl6oFZj7MBm52T70&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CfIHGcxh-n5jpeoJmP9kUtZNBKtmvawIbJJ5g1JQ_KQ&oe=6A394F18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=40jymWrinSUQ7kNvwHCY7fm&_nc_oc=Adq1Y0I1nJvYaWlQINv0NNVTuhVAX22EEKFz11KRq7kEot74DDvt2gFD933ZpBhroWU&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GEGcPQBS3pZ5rH-4HT-3djV7olokyYoqRa3rUaoDOrA&oe=6A394AD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": n
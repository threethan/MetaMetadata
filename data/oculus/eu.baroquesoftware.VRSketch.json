081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAXh0wc8UawQ7kNvwG_gCyi&_nc_oc=AdrgjKD-SZw2K1oGVNj_vXQz3jiuB659xHAtjr2lbI9VVlAWkU55M68CTh8H_GSO2Jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nh_3g_GkE0ByDKA6bEGoXUDQFgtQ1xZpFjO3I-75JAg&oe=69FCAB7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nD1fEZB3ANsQ7kNvwFum3jJ&_nc_oc=AdrIutCik1t86byYvFAAIJrr92hV4YI7zEBeWe5IXWGPjesniV7kU3-O6jl6bFA96jw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HO9BrD1jV61vF4ftsf_AXlwT2lU_ftQyGd_OZ7PudZg&oe=69FCAA18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTMUKPFFTVgQ7kNvwFrHY2U&_nc_oc=AdqnXDjPiXYzTqPvj3fknrLCeXlco0bFYAWoWdpuVr_PZeCCRJkmcCHEtLZfRQBvVys&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74NtrEvZLYoOjHb5Lq63iXu_Z9uAdN8nvTwd0CjdBFSg&oe=69FCA5D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
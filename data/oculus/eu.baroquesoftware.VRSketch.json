081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVMYzhABkzkQ7kNvwH6BBlx&_nc_oc=AdqVJkWt-70nS3qtTpIFsAboR5_fHr5wx0KRqp03pzlg4vxkB1N2oJrc0LAISQBdxkQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPULii63XDcdeO8MSWBlSYC3NxR5aUSsLrHaXigH0-qg&oe=6AF7287D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vx5xdh11ONIQ7kNvwHM3_I9&_nc_oc=Adrl6rzOvt2aC2WCj6bWe6k_bUBgQgcky53NG5fUhyhZQK0tv0NYosATpVLI2QoPg_w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3jADfnhgHDuWg6Mj_pZ6kOVLvDEEMx8iGklj0E91uLA&oe=6AF72718"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWxWqA6Upv0Q7kNvwE9XU75&_nc_oc=AdoYv1_-EOszq4dyICX7YDOkqLZsvfQGoDJ1wm67KQeIVZCyXIh04vVrXG9AZbjp5vg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbGnr3c9WRiHt70AoufGtl_tR4h7749q1Bl27Kv37O7w&oe=6AF722D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
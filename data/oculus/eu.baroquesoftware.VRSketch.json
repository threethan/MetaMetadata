081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NAPUlnw41fEQ7kNvwFP8_pE&_nc_oc=Adpgj3awov-YP-poWJ6vf8cxcGl3WpbG1rnP4ffXraNLX5hTc1fDAxKZQf135RSBowM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCHE3bR1kCE-hsYqgLBhuLCMyo9Yh1QyTaw4gKL6fwYQ&oe=6AC903FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oX2hq81ZbkQ7kNvwGY2oEw&_nc_oc=AdpK7yJcqQdNMW7F4q6O-4pMcJ4tBkLjiSMgAlZTzYiYGbtkJEcTnASqRiZFdDRWDAw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPS8BAmrt6x9QQztJfZkb4DcIHvbUb7aBLMaOpnZAApMA&oe=6AC90298"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-LEXpoYQwrgQ7kNvwEHIm0n&_nc_oc=AdpglokIZPSNlDvsWcGlrEMrgS_EQ0m2hA4cJFKwTRL7qAVTRIWX3K2bFs-yG734Y4U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCqskkwabIscR9-BUsFccSowHaHgfv2WmJRJ06twIMEg&oe=6AC8FE58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
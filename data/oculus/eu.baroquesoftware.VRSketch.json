081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQTL0y4i4rQQ7kNvwHpRLbS&_nc_oc=AdpMpmdppGXh88exg8C43oMV8RVWJRrfl7rqf6YlJTLQCM8nI45FQLIodAoCpPBKZFY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYwBDaohaQi9ekCZgK2HSeXNieUwcfrYzD33XPnyUhoA&oe=6A819ABD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0dddKC4upwQ7kNvwFzJMJN&_nc_oc=AdrUhBpYJJ6ngqETQDLNY_E7sxNDxe6PghDIGrZa8UJ17J5c7qqQAp0W3iVazgpa18I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvNZa-q1uLIScDJZCitFca-XNQ_Zfvl9bIu-FDe95-_A&oe=6A819958"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfXKWeGC4QwQ7kNvwFWH-Zz&_nc_oc=AdompFdcOloMXBBfrJ6WPImVl5IOPiHyNywl7_DFnfFbSVpXChtAzFqwWoZI9aYQ4fc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGj7FBEcd-E6kDDP52gnbvyjmZ-d6--nUJzkXoFU-eFnQ&oe=6A819518"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
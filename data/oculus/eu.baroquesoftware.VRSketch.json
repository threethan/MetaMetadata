081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvcgyg_D4NUQ7kNvwGoVzJe&_nc_oc=AdqGcbQII4u958ZEJlbWJqc5ZERYn1ukXsTvzKNitEyG4G4OoFI6MyQdvVudMqWF_5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmOCl1ANqKcirZPK-oOtm3YK6PCcaDwEPIjpXKtDki-w&oe=6ADE1BFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zBY7NCVQyX8Q7kNvwGXjrJg&_nc_oc=AdrPFfPX5EqxO3xl0TXfE9KoxgymnNrAabErUUiDbt7DBZ-0kR9yfXytkzbGCkTivGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm3FPzl0SgzW9LboeNE26r_165p6JxA3GhgkxjjFAVPw&oe=6ADE1A98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF4MZyF0gWsQ7kNvwFfKRsB&_nc_oc=AdpsW721EHG-_sMIvBHBR76M0KK9WO_l9XQ9dibAD71mI4iACcXSTsc8njmQ7qZjjMI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMamjVLR8ymTo_HdmXsENREBsL1ppmVdKgcpHu3rpqlCw&oe=6ADE1658"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
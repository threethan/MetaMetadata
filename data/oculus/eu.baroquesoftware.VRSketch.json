081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNeg8_JsfXoQ7kNvwEM194N&_nc_oc=Adq_VpsCZofGn5AmLZqL7elZiZ4oTuk_UEk1Hm8soSfFXPNHq80ZVveZlOOStt3E8iY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7q6VPt0S4yGS1NJL6lhn2Cs2Y0fGw2UkEQ-O7_SNiDNw&oe=69FB59FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nD1fEZB3ANsQ7kNvwFk0K-M&_nc_oc=Adqam1lJ0BL7P6Ydo4WToW1rJhUs4hTlucaiSymVb08dHeL8q_VEJlZBLVMlUjhbcqc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hkMZo6y-7WmS5_KvVZPy4Ok3Nufg30cvv9wu5E29SCw&oe=69FB5898"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTMUKPFFTVgQ7kNvwFIXgc6&_nc_oc=Adpk71WO94yA1xZi5iVSZODar1jyoKR0tD3BYjc9Ocq7GGA9_Lu6ERZ_M18yf62lWBQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WyDj8ZBNUDPqcLW2Hu_4nXpCkHd0lAYGA8ZJ0srMBOw&oe=69FB5458"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=akUsPZcagqQQ7kNvwHDhSU-&_nc_oc=AdpkpK5Sa2qNFydqxJ3X_equ0zfqE648GReKY0x1zdmhAXvIQ6XmLguVDqY4G2tE1rI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84f2ACVlqXJtSI_F-7zyuPR8PrFYRf3TXkjPwWwhYXmQ&oe=6A428AFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OO8XGmX2jJkQ7kNvwFAQX7M&_nc_oc=Adp6S1EOHBRRgU5biMS7yBdJgfsbWVKrr0v436PWutHew2Ayx9gN76rSi9hsGpiEGhM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Eye77O0RI9KDGnYQxNSIiWkCiuS1MdkX5iuY8GkqhAw&oe=6A428998"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sRcPIWbpl2EQ7kNvwGN5pe9&_nc_oc=Adp7PLLvnl95gYKYv9GT0w0Gahj322NGKUWWjvFTnW_wbkRPfZ0JWcmL_sivl6_pn58&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-3F_gifEvcellEuhU7fQhQzpN11-G8xC8DEF-nkULHLg&oe=6A428558"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
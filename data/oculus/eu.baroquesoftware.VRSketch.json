081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFMAtCjEUZYQ7kNvwGQVfsy&_nc_oc=Adoem5XWuBw5pye4RgCEDYiPQxNbd32TDtSw5KKbmSdGHWhOCrBfwWzFBbDD6RUtv-o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8dz09tnXPQyZyWcxkGdmJ8RgztH8yyLlFZKk0RUfLsA&oe=6A82EC3D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0dddKC4upwQ7kNvwHOZrMq&_nc_oc=Adp2dwOtU2UWAkU2NJxuBBBQHuixy0pHg_Px4p5SiLbGfjTqUKoxq5uJi5fD7PjHMKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpZlhtxdS6JALDUq_BnsxHwWLHbR3DShsLODsTvCmLtQ&oe=6A82EAD8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfXKWeGC4QwQ7kNvwE6PclX&_nc_oc=Adp3iDTbJCs1SiXsMWnNMFllTm-hhA7jVcMdOMgiGr6fqgf7TaU6A6aMoSl-oLiU3ts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErWHkVBLqKb8DAPCVSIw2C5iZS0GuK4oJzJRLS85h3ZA&oe=6A82E698"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
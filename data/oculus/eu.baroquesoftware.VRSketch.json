081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdd4CeD0_FgQ7kNvwEeRfEQ&_nc_oc=Ado5E7o5h36_fA9HHOSZPKnwo0LhJ_FWTjRUwpZ-65mWxX3djDOHvQV_P_up7325uFM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHWQi_2e2hfy_Pl2FtBAnbrJZjhAr8WU8N7-txeynhlA&oe=6A4D16FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhfUbxvDYHoQ7kNvwGE_0Bx&_nc_oc=Adrm8cvIpE8wCiYb4bzcb5TuBMtqVq-eEOqoc7iwKcMfG2AE9c1Zw0vQ6lfAFpVx6CE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb57ojzWMnht-nwINxSuJhvTgwkFxIF5MRftO1SDKtkw&oe=6A4D1598"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqRPx4xl4YcQ7kNvwHX8RZv&_nc_oc=AdqIm2ZDw3eTbORyFOgxDVdaoVn-lzKOEVdTGYv7DM28nvAs-PIkdrhsk2FOn1GaZ20&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAqveUMnCrL4ymC0zqx9q16GVi_-eiVPP2qba4i43QQUg&oe=6A4D1158"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ar4ApSSnpsQ7kNvwHnkmra&_nc_oc=Adqg0_BrU4gq59SyYiKux4qaM45efMCTtyLN_k9f3uNrx9TeV-hmIJ8YQkW_0r09GvY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvNLy82kS9xSQCOnlUryE_jxI3EFC5kFXDQklapRDnIA&oe=6A66237D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMAaXtRYJBcQ7kNvwFbppP2&_nc_oc=AdqFioXMIz2Bddgexj1rNQ9vSA14nZIKmS9ThH6bDbr91SfjJLkezBRb46CE1dr1D-Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB62HB0JcMJFAicgjY0w7kSnS4TQGlLH9de7qpPxioFBQ&oe=6A662218"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIZxj69Zoz8Q7kNvwFM3KZk&_nc_oc=AdqFemF5YJa8G9Pl-6B58W4LeE3UmtN7GJ8xl4QvazQ1sGoePw-q802vZuAbdm56exw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-VbJUMnh2Mc4lWvWVcPXouXmxNcG4dwOilupsjyx2yg&oe=6A661DD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
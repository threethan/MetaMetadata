081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jLJvenNR7sQ7kNvwGEYqeW&_nc_oc=AdqM3e76E--ivQX_3vC8Im0TRkfoWXpfMc8KAOhGyAFJ6CJgbCQUNwYNS9ZJVcruzNE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyN2q_82u1jJvSA5dB0HqKDsp00Cksp7jwFfNSRs9G5w&oe=6ABA837D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXawYKmD1t8Q7kNvwEKPKil&_nc_oc=AdqogSJoXOCGlJcbso95nz9XaN494xR9Ellb7JNvWwqetUFXDaruTOKx1gIx_emjGy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwiIZhB42VrnJeH4T-FO2PXWP28XPuh3QyNwIYqTLjjQ&oe=6ABA8218"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C76ECTrDZLUQ7kNvwHhOBvW&_nc_oc=AdpqYosmZ-n89w8SRFj7AXcTS8jAt1Kdv-YikcjtJXBFrgx44W0VmXq8goiLe6QAxb0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiL8qUL4HsdEEFqUSL6XGs6vqR9DTQruXbmXXz_aqPOQ&oe=6ABA7DD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
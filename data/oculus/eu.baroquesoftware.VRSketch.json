081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfrNRwwdqPsQ7kNvwE5EdL0&_nc_oc=Adqfk3LPnLVv-HikefHCvV9VH_iExTJSpddkKZzm75Syun0pkxVVOWyXeMXrwlHHmZY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlmZVofCIFzd0SKdzlojXmtK0_W5JljCmkfFKSNhTzWw&oe=6AB148FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKcppJKqMgMQ7kNvwG_FvTQ&_nc_oc=AdqJ8NRGxMjpuKNPiDazcliXzWtGcinbQbsvT9nZqhjV1e_2IY7ls50t_OomjV_kEE4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIws4HF6OvChVDDHTXqzvtqoV7rCVy4b1wm7j6oVSLLg&oe=6AB14798"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-FIti5-KiIQ7kNvwGR7JPa&_nc_oc=AdqBwO7Aul8Rc30yRmggf_kQa1bheBIELUSdLJOIf9hf3c3a9EzVLlF4F4xNo6TeL0M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoI-PU8qLdrEinIZfyyCI6roIdI6Dptp4gbJu37qvuDw&oe=6AB14358"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHwZAmlD3SIQ7kNvwEc1cns&_nc_oc=Adp5OqfvmVS8DNIpYbIIMcDwhg_QBfIU1khZLBFBFf4TyViFVTbn5EsUL71SnHiWWUI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-2qAY60lZkFo_3m12BIXOolpqfeNjcZoxwGuxQ2lMBg&oe=6A75F57D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u38Yuwg2rqwQ7kNvwG0weKY&_nc_oc=AdqSrzQ0LeVMxAgYpmQrr3-189U38PHsjvUHDCuhoackSjMQokQ-wHs--gOc3IU6qd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMsIz02xSFNJZJfhzf4dJd-bD8wLC4gL30HFDLOIKUrg&oe=6A75F418"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2XaOwnBT7IQ7kNvwFZsKbx&_nc_oc=AdrwjmRv-SYtHKYkmLyyQS1GaxNllQp-b89aC8sVA6lR9arTqJ5mb2fPFHYLsx2cM4g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcjirOvymm1nQB9OgDDsy2AJUpB1aKeEYLPbg8u_9qzw&oe=6A75EFD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
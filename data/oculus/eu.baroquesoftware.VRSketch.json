081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEdAVhRYFNkQ7kNvwGu9NR8&_nc_oc=AdrBEWXKoLUocbsY0RfvJ7pt7e-EAw4DgT22EWT_Ul_Md9T4tfZkLxapoqKXlL3jwNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2A73hT6OjK8HJ1fjnvBRretBBBSHjLIK21URaggPZRg&oe=6AEDEDFD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vsyxp874VDcQ7kNvwEsi6T4&_nc_oc=AdrLupwDz9XAl8CD2H3cpvs-l603JjYZuaL4vIBMUjW0E3JHYqxqUG0fPoSG322meHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxombETklsiSFEG-ETp2bB_VtYhn7Pwm-g4ipF7Hh1Dw&oe=6AEDEC98"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eBDjpD-aKgQ7kNvwGLb61X&_nc_oc=AdrguQH02sh0ASJIPrlysr9BLIfHzBZ5GlwqLekmCwkTQTQ8NbYjdOPwW345eCgbXcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTszY6MMl5MsFvf_q9OGk5wwkQkKnpUUv3P8Rw7B-io7Q&oe=6AEDE858"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
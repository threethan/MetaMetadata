3382418930592081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFMAtCjEUZYQ7kNvwGar7_B&_nc_oc=AdqX0GzG44GYfjaTQTMYHUygg0rLNWWwgw5g0A-F8nWLhuPsrMm0anYtQ7xBu6dISto&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKyNKegc6Ll2n8PLMfLCGwTTvRzfL-nuo7_SyxqCA62A&oe=6A858F3D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dilcBZLJ3FQQ7kNvwHOMDrJ&_nc_oc=AdoLSQNRHxZuCWbV_1MaFMNX_CBhgyM9QFhE4g_Ab1iGWW7a6RuqdA4Hq1_mzbYkkaE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4Tcvq4UXV3JPq74FA5cXLt1vIyGzM6lQ4tERigCdV1w&oe=6A858DD8"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jp2qDCAaDAQ7kNvwHK8Lsj&_nc_oc=AdqFDveYxQvIiZ41ocC2jTGaFV3cfCpePsd2SKNv1TX7QHmbyS-ZhrFcs_75BswYjpw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8PWqgO9TFFFlZxf-9NEjKVFPDo9wXS4gaBIwjiLIN0w&oe=6A858998"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service
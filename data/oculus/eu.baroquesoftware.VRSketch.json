081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVMYzhABkzkQ7kNvwFUuoH1&_nc_oc=AdqzWNP_qXoNQ1RRE_cgNPsxtLJXMmJc2Sa-3h0bzB7sEGMmSDvf5Bc-8RUuSFCMDWU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8SE8wGtinikAguXLABgMlXfJhBDseyd0TObbrSgp_vw&oe=6AF5D6FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vx5xdh11ONIQ7kNvwEDcg3T&_nc_oc=Adoa-M7m-qslYgZBllXKA-tw2aQ58RI5OlMzaikAidkvpoX1EJJSDa7c85SegJGKDjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRd3h1Cb-tqFr9EU8kwslB6CV47Gx3HHo_MTcQnK9GUg&oe=6AF5D598"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrrGOlQuOdsQ7kNvwH1l--B&_nc_oc=Adr5770bVpQfzwEVfOzk5AgW8gPSUSqGKo29v2eBvGkBiU6uDKu6kWqx7sVfUzmSVV8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf2Qo9GDb7m6259h6b3k7ZfBtc27fSzQFzGqtb8zRuzw&oe=6AF5D158"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSKjyr5A5s0Q7kNvwHFnvdi&_nc_oc=Adq72x9OqknvCi_G5t-uOTZANjeoNVmFJiF7n4pyfeOhnK_Qg_z19qimxNemFHd8N5Q&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4eW5a2P2GMKKw9yT1BZKGw8h1ZgmvgwSzRD5fdW5B2g&oe=6AE361FD"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ1LF4VP-20Q7kNvwFyViN3&_nc_oc=AdpQIoTraGeB_2KZQoa6sfxf5NEE81lOk-wCy6dAY5hD_WWdjp0AO4lACtm6bpU-irE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqhTXHwlqSWKcYa0m-FnVF5No5dLlWOULm4k5tShuQVw&oe=6AE36098"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaFuBpCon10Q7kNvwG3uwjG&_nc_oc=AdqTf80I42z-W8KWFXXNVbO47iV2mVR_dHrrkpWE142n_pmxLqgW5mA9L4qlcvxPM9M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOENseSWRprvF_YV1gRugdxmLCZVCnXAmA2IKLsfViYA&oe=6AE35C58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
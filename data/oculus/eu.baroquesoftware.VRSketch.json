081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e9x4io4ArfoQ7kNvwH7h3q8&_nc_oc=Adp4xyNZUiEnrBT41Jr8-Cy02Wb7sLycf3NEwScMJyyzvU8_EgazjaiSSptXsmXtZ3U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af566JvR9DK6hVbRvR3jyap-iGXRbZWrZNWFVyBRwukYFg&oe=6A0C7D7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VC4pwg9G7CEQ7kNvwEsg0_y&_nc_oc=Adra1VDqyrsfxN5nLWVN22-z1MsLptJAQV8Neg4tecnNCGQw5LPZ7nS5mTKiBu4bHiA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X5-Rwh8PCxDyUfbySDuEIJOstjlIETPuGxdhzuHdbpg&oe=6A0C7C18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DW29IKcaKuoQ7kNvwEPTLck&_nc_oc=Adpq-moMfRxUe-N4pg2m3Jwmf0fhShwgZpBz5kI_zjv45skTtXFEKlfJqZpeIWM9K-4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cZXusnUQT8PfsFx1Nl5NIsnaFf1n6qe7etMERDtRwBA&oe=6A0C77D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
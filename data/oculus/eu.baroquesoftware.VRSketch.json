081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KSKjyr5A5s0Q7kNvwEjazWZ&_nc_oc=Adp-VWiBfnOyhNvC4SpyZIoVVkCP6n3kafyAZXseAyz-1Z_au8CgUzs3nZCIeECLwJs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAtmDpQh1AW9mFdAGzfLsQ9lrNJm2QpVeOby1LTim3Nw&oe=6AE2107D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ1LF4VP-20Q7kNvwGXsvMw&_nc_oc=Adqa3lS7Ntn5j4Ud3SDyQkT3rgwbs2VgVMQW8gyCJhirc3rYkSJ_VjYdN9mtNtzW3jk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuXtILujGBsDkHW7cmQ8vWaO3FgrL5xdGxo-pOpQFZOw&oe=6AE20F18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIHLRvzUcj0Q7kNvwEyZOs8&_nc_oc=Adq1r20Gyr-bLUuxLKwGhO9LR9QTD2loPFBU9oHmkY9wYkW0DGfjMjNAPofQG_lOTUk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgVDZy0R5AvZnfcI2cfrnvuG7qmDXdWDuZcqB9YYbOvQ&oe=6AE20AD8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
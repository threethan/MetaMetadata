081_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5YiUDNaOLgQ7kNvwHaQpBh&_nc_oc=AdpZ-18S_vvHFzY6vppbBudY8lr5R_qp-A7L0h1PWAHKflXWBBh95Q909kQWa-TKP_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiigk3POhMr9XoRZzQQFAllI2zhI9fOB-F8-fztlsdPA&oe=6A510B7D"}, {"file_name": "screenshot-4.png", "id": "2868966416755211", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_2868966420088544_6565023791691245566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngBP_2YXeuEQ7kNvwFHSCUQ&_nc_oc=Adp-GrvJMRdD30869M4RSc2bjt9pS4v3-08o8CkRGhfw_vBOJmxP7eEnRV8Ja35SjkY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiG49dEw2rK85qNWrbLAOU6TUCcp8pc0jDR56hB8kOtQ&oe=6A510A18"}, {"file_name": "screenshot-5.png", "id": "326402515506880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982515_326402518840213_7065189224335395834_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OgRrSn6sxtIQ7kNvwGoqZ1Q&_nc_oc=AdpFXCgOoDkTV8IkN-NKtkNESPF162NhBvCSB8ZjjPJKKVdMyg2JC85gPOIrFuy2qfM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnBiQvhqRkYSB1zY22Utd4sNvKu3Clj_RMJU6RhrEfKA&oe=6A5105D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sketch", "keywords": [], "long_description": "VR Sketch is a tool for editing and visualizing architectural models from SketchUp in virtual reality. See https://vrsketch.eu/documentation.html for details\n\nThe present version does not aim for photo realism and instead focuses on having a cartoonish but well performing mode that lets you edit SketchUp files 100s of megabytes in size.\n\nYou can also share your models with others and view them together!\n\nFor more information on how to use it, please see https://vrsketch.eu", "short_description": "VR Sketch is a Virtual Reality based CAD that links to sketchup."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsketch.eu/docs-privacy.html", "developer_terms_of_service_url": null, "pu
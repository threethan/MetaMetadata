nary", "id": "26472625155713216"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Patched to address Unity vulnerability.\n- Some particle effects have been tweaked for more consistent color and lighting.", "created_date": 1759862535, "id": "24873673398941741", "version": "1.16", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26472625155713216"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Dynamic Resolution has been implemented. The app runs above default resolution most of the time.\n- Level geometry and lighting has been reworked for performance and visual improvements.\n- Speech bubbles scale up at a distance to maintain readability, rather than switching to subtitles.", "created_date": 1754672772, "id": "24345452928430460", "version": "1.15", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
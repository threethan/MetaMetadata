035407_366801312546870_8959311711188834903_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxT8AfjLafQQ7kNvwHsNE1A&_nc_oc=AdrhEl2cl89habdvy_2qJhaf6EPeBfgpDz9PYpk1C4wboXK6PLl04GZuQuzKQF2g04A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSHUpAvC1fwZnGdSGX9Aes2fG7-34pvrC6nF4DH3YVlQ&oe=6AE34AF6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Cyclops Island Demo", "keywords": [], "long_description": "Adventure Awaits! Can you unravel the mysteries and survive the perils of Cyclops Island? \n\nEmbark on a compelling single-player adventure, exploring a strange and mysterious island. What is this place? How did you get here? Why are you taking orders from a talking beaver? Discover the answers to these pressing questions and more, as you venture forth into the unknown!", "short_description": "Adventure Awaits! Can you unravel the mysteries and survive the perils of Cyclops Island?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://playstupidgames.ca/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Play Stupid Games", "support_website_url": null, "website_url": "https://playstupidgames.ca/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6983921991676823"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1191032879360061"}, {"status": "PUBLISHED", "id": "7178674558849911"}]}, "baseline_offer": {"id": "1191032879360061"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740416100, "status": "PUBLISHED", "id": "1191032879360061"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28719852567657119", "version": "1.19"}, "id": "291378316592543", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28719852567657119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Default movement mode for new players has been changed to smooth move LH and teleport RH, rather than teleport only. \n- Tutorials have been updated to reflect the new default movement mode. \n- Audio and haptic cues have been added to indicate addition and completion of objectives. \n- Various under-the-hood optimizations and fixes.", "created_date": 1790966262, "id": "28719852567657119", "version": "1.19", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28719852567657119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Hotfix 1.18.1: Fixed bug that could cause erratic movement of an object thrown at a creature's head.\n- Update 1.18:\n- Player head, hands, and body physically interact with more of the world. \n- NPC eyes react to environmental (and some dynamic) lights with pupil dilation. \n- Player can take damage from dynamic object collisions. \n- Slightly reduced maximum dynamic resolution to lessen battery drain. \n- Various under-the-hood optimizations and fixes.", "created_date": 1774972741, "id": "26472625155713216", "version": "1.18.1", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28719852567657119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Player head, hands, and body physically interact with more of the world.\n- NPC eyes react to environmental (and some dynamic) lights with pupil dilation.\n- Player can take damage from dynamic object collisions.\n- Slightly reduced maximum dynamic resolution to lessen battery drain.\n- Various under-the-hood optimizations and fixes.", "created_date": 1774377710, "id": "26398249276484138", "version": "1.18", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28719852567657119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Inventory menu is now visible through walls and obstacles, similar to the Pause menu.\n- Head collision with overhead objects now has smooth push-back, like other player collisions.\n- Appearance of 'splatter' particle effects has been improved for all lighting conditions.\n- Gate now has better physics interaction with dynamic objects when it opens.", "created_date": 1763494378, "id": "25277835468525530", "version": "1.17", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28719852567657119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Patched to address Unity vulnerability.\n- Some particle effects have been tweaked for more consistent color and lighting.", "created_date": 1759862535, "id": "24873673398941741", "version": "1.16", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
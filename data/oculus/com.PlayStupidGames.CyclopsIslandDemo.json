": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25277835468525530"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Dynamic Resolution has been implemented. The app runs above default resolution most of the time.\n- Level geometry and lighting has been reworked for performance and visual improvements.\n- Speech bubbles scale up at a distance to maintain readability, rather than switching to subtitles.", "created_date": 1754672772, "id": "24345452928430460", "version": "1.15", "version_code": 17, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25277835468525530"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Hotfix 1.14.1: Fixed head collision push-back (broken by room-scale height update).\n- Update 1.14:\n- Fixed directional issue with creatures' head bounce.\n- Fixed an issue that makes hand contact with creatures more reliable.\n- NPC head bounce from hand contact now reacts based on hit speed.\n- The beaver now has a little head bounce. Try patting him on the head!\n- Impact sounds are now more accurately located.\n- Haptics intensity has more variation based on contact force.\n- Terrain-based footstep sounds added for player and NPCs.\n- Player's step height has been increased for easier navigation over rubble.\n- Improved player collider height accuracy during room-scale movement.\n- NPC navigation is smoother over rough terrain.\n- Improved NPCs' ability to track player during temporary loss of sight.", "created_date": 1746585192, "id": "9858204840915176", "version": "1.14.1", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25277835468525530"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Fixed directional issue with creatures' head bounce.\n- Fixed an issue that makes hand contact with creatures more reliable.\n- NPC head bounce from hand contact now reacts based on hit speed.\n- The beaver now has a little head bounce. Try patting him on the head!\n- Impact sounds are now more accurately located.\n- Haptics intensity has more variation based on contact force.\n- Terrain-based footstep sounds added for player and NPCs.\n- Player's step height has been increased for easier navigation over rubble.\n- Improved player collider height accuracy during room-scale movement.\n- NPC navigation is smoother over rough terrain.\n- Improved NPCs' ability to track player during temporary loss of sight.", "created_date": 1746198096, "id": "9822109581191369", "version": "1.14", "version_code": 15, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, 
061"}, {"status": "PUBLISHED", "id": "7178674558849911"}]}, "baseline_offer": {"id": "1191032879360061"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740416100, "status": "PUBLISHED", "id": "1191032879360061"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28719852567657119", "version": "1.19"}, "id": "291378316592543", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28719852567657119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Default movement mode for new players has been changed to smooth move LH and teleport RH, rather than teleport only. \n- Tutorials have been updated to reflect the new default movement mode. \n- Audio and haptic cues have been added to indicate addition and completion of objectives. \n- Various under-the-hood optimizations and fixes.", "created_date": 1790966262, "id": "28719852567657119", "version": "1.19", "version_code": 22, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28719852567657119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Hotfix 1.18.1: Fixed bug that could cause erratic movement of an object thrown at a creature's head.\n- Update 1.18:\n- Player head, hands, and body physically interact with more of the world. \n- NPC eyes react to environmental (and some dynamic) lights with pupil dilation. \n- Player can take damage from dynamic object collisions. \n- Slightly reduced maximum dynamic resolution to lessen battery drain. \n- Various under-the-hood optimizations and fixes.", "created_date": 1774972741, "id": "26472625155713216", "version": "1.18.1", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28719852567657119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Player head, hands, and body physically interact with more of the world.\n- NPC eyes react to environmental (and some dynamic) lights with pupil dilation.\n- Player can take damage from dynamic object collisions.\n- Slightly reduced maximum dynamic resolution to lessen battery drain.\n- Various under-the-hood optimizations and fixes.", "created_date": 1774377710, "id": "26398249276484138", "version": "1.18", "version_code": 20, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28719852567657119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Inventory menu is now visible through walls and obstacles, similar to the Pause menu.\n- Head collision with overhead objects now has smooth push-back, like other player collisions.\n- Appearance of 'splatter' particle effects has been improved for all lighting conditions.\n- Gate now has better physics interaction with dynamic objects when it opens.", "created_date": 1763494378, "id": "25277835468525530", "version": "1.17", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28719852567657119"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Patched to address Unity vulnerability.\n- Some particle effects have been tweaked for more consistent color and lighting.", "created_date": 1759862535, "id": "24873673398941741", "version": "1.16", "version_code": 18, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
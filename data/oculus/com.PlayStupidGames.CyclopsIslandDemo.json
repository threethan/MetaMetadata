ISHED", "id": "1191032879360061"}, {"status": "PUBLISHED", "id": "7178674558849911"}]}, "baseline_offer": {"id": "1191032879360061"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1740416100, "status": "PUBLISHED", "id": "1191032879360061"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26472625155713216", "version": "1.18.1"}, "id": "291378316592543", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26472625155713216"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "291378316592543"}]}, "change_log": "- Hotfix 1.18.1: Fixed bug that could cause erratic movement of an object thrown at a creature's head.\n- Update 1.18:\n- Player head, hands, and body physically interact with more of the world. \n- NPC eyes react to environmental (and some dynamic) lights with pupil dilation. \n- Player can take damage from dynamic object collisions. \n- Slightly reduced maximum dynamic resolution to lessen battery drain. \n- Various under-the-hood optimizations and fixes.", "created_date": 1774972741, "id": "26472625155713216", "version": "1.18.1", "version_code": 21, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6983921981676824", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26472625155713216"}, "release_status": "RELEASED"}, "bi
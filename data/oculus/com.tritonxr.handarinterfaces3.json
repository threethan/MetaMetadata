le_name": "screenshot_4_H11_seeds.png", "id": "1773358067113773", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491828028_1773358073780439_5340294439243301233_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syMuYNsyxPEQ7kNvwHXACYm&_nc_oc=Ado91EdWR9iVeD6Hn6-Ha7xD60FofbteEkzmqQgWCSYHSae_RqqZscQ8f3bk7LHPt8A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTz67XS9XHuYe4bQJX8T0oOMtARb6kycTEivJRt_Lhig&oe=6AFB22DE"}, {"file_name": "screenshot_3_H40_book.png", "id": "1701392028166068", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823949_1701392034832734_8260944463000077686_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaZUJiI8XyMQ7kNvwErQCk5&_nc_oc=Ado4u3rm8CpmYK0vIyXLgYNR_Fm6D3WBv-tPZMc6Kiv6_dLpjpxWWNXdAwX5pN5t8G0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaIY_OsXwPXbdGeis6Zpl0L2fV8mKkhkxte3HG12NnEg&oe=6AFB4BC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1667443914888756", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825470_1667443934888754_5943134861579125004_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-y1-0IDUUcQ7kNvwEBG7dS&_nc_oc=AdoUZWfS8QNulId3dwHC1Cg2Ooe8mL3ENzzuX1cFwShOGZ-7LO0FTxoKCKPGJVaDZAU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRhVkxxGkOALvKG5aWj2_apMyBN9qj9Y3LoLYzFcS7rA&oe=6AFB3CEA"}, "display_name": "Hand AR Interfaces 3", "keywords": ["AR", "Hand", "Interfaces", "Passthrough", "Fingers"], "long_description": "Your hands become the starting point for a collection of spatial interface experiments. Browse the catalogue, choose an interface and explore how different gestures can control objects and information in mixed reality.\n\nTry fingertip faders, explore a miniature space, turn the pages of a book, draw and experiment with other hand-centred interactions. Use the in-app guidance and catalog
=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWODLyhRsnCWF888C4tDXSz6rECK3E9R7G-TH-6VwyXg&oe=6B03051D"}, {"file_name": "screenshot_4_H11_seeds.png", "id": "1773358067113773", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828028_1773358073780439_5340294439243301233_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wUWKQrxQcboQ7kNvwGT_RlF&_nc_oc=AdoFYhpp_SNkEI6Qhv9Huz0lkjKOdDxDDDDInIyY_l-jP0cyIzH22cgz6RBAt8px1sI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRovKV0fCBI59-F382u-z7zbnJShtuGNfG9xkm8_sDfrA&oe=6B030BDE"}, {"file_name": "screenshot_3_H40_book.png", "id": "1701392028166068", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823949_1701392034832734_8260944463000077686_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMbYLACPDe4Q7kNvwESqCDC&_nc_oc=Adod4aVY_dgl1isYaM6xYve2Hd9QdcEBelBneJfq1HOQ18ihj_OD94yW2C1ugRHETUM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj1qqxUDnKG5FaHoOt4H7c6UgLdj41OywDJtALeUQKpg&oe=6B0334C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1667443914888756", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825470_1667443934888754_5943134861579125004_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lKCInI8Kxt0Q7kNvwEUPfv0&_nc_oc=AdoyB3aBr0qBFh1cZjE9oXWwzqIuM9kL2hzdWcDRcc5Ej7LSRE9nq5vnR2VpJP5UZDQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAQ8gM6AdZk70-gx70NOMx8JLWhMhvaviXdCt4DGTu1g&oe=6B0325EA"}, "display_name": "Hand AR Interfaces 3", "keywords": ["AR", "Hand", "Interfaces", "Passthrough", "Fingers"], "long_description": "Your hands become the starting point for a collection of spatial interface experiments. Browse the catalogue, choose an interface and explore how different gestures can control objects and information in mixed reality.\n\nTry fingertip faders, explore a miniature s
NvwG_uuy8&_nc_oc=AdrRksur_a7iTJvcLOkxcOI30RZ6CMkrBBauBBgSGV9RpsVc4EI6n3Q1qL1sA3eIoTo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQddGhvwJZ96OocaNvhOONv11R2jr2jNlkq8nUuHD_-fw&oe=6AF32A89"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1667443914888756", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825470_1667443934888754_5943134861579125004_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVZvTGw_bw0Q7kNvwHDI7Tx&_nc_oc=AdosE8pd8IV8fi1Qtdl8DQF_KQh73aDeo5Z1w7WSl0o9jyqG6qqfwPFPoqmIDraVSXs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfGANSeFGjl2fw-b5lStUUeoJBL0m_MXlSNPte6JTIog&oe=6AF353EA"}, "display_name": "Hand AR Interfaces 3", "keywords": ["AR", "Hand", "Interfaces", "Passthrough", "Fingers"], "long_description": "Your hands become the starting point for a collection of spatial interface experiments. Browse the catalogue, choose an interface and explore how different gestures can control objects and information in mixed reality.\n\nTry fingertip faders, explore a miniature space, turn the pages of a book, draw and experiment with other hand-centred interactions. Use the in-app guidance and catalogue to move between experiences.\n\nDesigned for hand tracking in Meta Quest passthrough. Different interfaces use different gestures and optional device permissions. The app stores some of your interactions locally. Review the privacy information for details.\n\n", "short_description": "Explore mixed-reality interfaces on your hands, from fingertip controls and drawing to a miniature room and a book.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/terms.html", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/support.html", "website_url": "http
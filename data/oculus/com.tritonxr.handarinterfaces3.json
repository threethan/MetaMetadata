le_name": "screenshot_4_H11_seeds.png", "id": "1773358067113773", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828028_1773358073780439_5340294439243301233_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syMuYNsyxPEQ7kNvwHHbPo0&_nc_oc=Adof6KHxwJydnX8YL4xr4IR1zDvvVsrueoJVuYmP3fSYoJD6c7TNZImf_2SQRXUx8lo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXZxHrEV8hwm4oiH8hPV2z-wFWnZj3nCme5CXT3qRTgg&oe=6AFC745E"}, {"file_name": "screenshot_3_H40_book.png", "id": "1701392028166068", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823949_1701392034832734_8260944463000077686_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaZUJiI8XyMQ7kNvwFWTl93&_nc_oc=Adr3GLhcyqwm24Y1197C2OSoEcAigJgCNRaqIjpem4wzfdbZSZoLiZ2i_rAgBdef0Nk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScr4uS6HFE3zOCy4vtgj-kEw-L9bsB5GoNqRTtI63QUw&oe=6AFC6509"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1667443914888756", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491825470_1667443934888754_5943134861579125004_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-y1-0IDUUcQ7kNvwFVy6Pq&_nc_oc=Ado25pQhSZWQb-Tz8lhq9Iak3XOTMM3KAQoj5YQtq1BOQW5mCu1rqi2Em4fos8CFRlg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR98eitB4XU3fglnnYu7WAMFlUtcS6loz9Vk91kqYM2Zw&oe=6AFC8E6A"}, "display_name": "Hand AR Interfaces 3", "keywords": ["AR", "Hand", "Interfaces", "Passthrough", "Fingers"], "long_description": "Your hands become the starting point for a collection of spatial interface experiments. Browse the catalogue, choose an interface and explore how different gestures can control objects and information in mixed reality.\n\nTry fingertip faders, explore a miniature space, turn the pages of a book, draw and experiment with other hand-centred interactions. Use the in-app guidance and catalogue to move between experiences.\n\nDesigned for hand tracking in Meta Quest passthrough. Different interfaces use different gestures and optional device permissions. The app stores some of your interactions locally. Review the privacy information for details.\n\n", "short_description": "Explore mixed-reality interfaces on your hands, from fingertip controls and drawing to a miniature room and a book.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/terms.html", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/support.html", "website_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1394134400449246"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827960_2090027884980029_5657496579267358145_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLq3qu3yjbkQ7kNvwHfGewN&_nc_oc=AdqpQih5GtKn4_w9UHQe8zgpylZL7IbR6xcgeFv3tZFLcD0ZIHbL2GWxsAH0IYwgcXc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQGREGGQNimzHkNTJfdLV43gxbrpmlPCvBEzDb-m10pBQ&oe=6AFC7C73"}, "is_concept":
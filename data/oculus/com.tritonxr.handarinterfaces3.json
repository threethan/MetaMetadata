ature room and a book.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/terms.html", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/support.html", "website_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1394134400449246"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4533803650234006"}]}, "baseline_offer": {"id": "4533803650234006"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793651220, "status": "PUBLISHED", "id": "4533803650234006"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1413425018520184", "version": "0.5.33"}, "id": "2908607542841891", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1394134390449247", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1413425018520184"}, "release_status": "RELEASED"}, "binary_release_channels": {"no
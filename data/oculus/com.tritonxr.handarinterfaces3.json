0nONe0v4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6ioTt_IlEEJuDaPKMmVlKRaFXeBa0MNvydlWVOJhCzQ&oe=6AF87FDE"}, {"file_name": "screenshot_3_H40_book.png", "id": "1701392028166068", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_1701392034832734_8260944463000077686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ze-lrikmFcYQ7kNvwEwtn4f&_nc_oc=Adq5Djm96Z1RuJk-CEZui3_omwv-H09HdSJ2FGdX_497GQRykj7-bDD8pMqDk-PCdec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVVbtLcRQUvLXgGfIx4bUzZOomV7tC8h2rp_LtCg6ZVQ&oe=6AF8A8C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1667443914888756", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1667443934888754_5943134861579125004_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLYx9d7O7okQ7kNvwHOKN9x&_nc_oc=AdpWZijO8fnxY2jHGKg86fB4_bmEX5KXp7zsxYUv3CUOeoa2hUIbAnHm30wGRV5tRIM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdcV3EWBdq4n5RmDvUva1iFX2WFTkUiOIGFHNqTuoPPw&oe=6AF899EA"}, "display_name": "Hand AR Interfaces 3", "keywords": ["AR", "Hand", "Interfaces", "Passthrough", "Fingers"], "long_description": "Your hands become the starting point for a collection of spatial interface experiments. Browse the catalogue, choose an interface and explore how different gestures can control objects and information in mixed reality.\n\nTry fingertip faders, explore a miniature space, turn the pages of a book, draw and experiment with other hand-centred interactions. Use the in-app guidance and catalogue to move between experiences.\n\nDesigned for hand tracking in Meta Quest passthrough. Different interfaces use different gestures and optional device permissions. The app stores some of your interactions locally. Review the privacy information for details.\n\n", "short_description": "Explore mixed-reality interfaces on your hands, from fingertip controls and drawing to a miniature roo
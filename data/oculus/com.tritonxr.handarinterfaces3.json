scdn.com/v/t64.5771-25/491823757_1408106597971063_5490551084480372827_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIIXDMamYrQQ7kNvwErTPMQ&_nc_oc=Adq_KK-hqtaYQE3gXGjIek9EcAKJBm9f4cFlXunpmbTyEg9UR0kVt0V1T4Kr1-IH_8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRNFNDk-OOtVnmjj7Gnyu9tJaQ423uwL07Iugei4DLww&oe=6B06F99D"}, {"file_name": "screenshot_4_H11_seeds.png", "id": "1773358067113773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828028_1773358073780439_5340294439243301233_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4AbrWtmbegQ7kNvwFSoV7I&_nc_oc=Adqj_SMYMWoWMjZj8kmdNjY7mZJPF005vEH3GXlOCY-4bX6-uHTuWdoOMOwb8m1wp7g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRH9Ob6IEUcmGpXy17OplvZT2sv8-s2wYb8wNmc04gZ8g&oe=6B07005E"}, {"file_name": "screenshot_3_H40_book.png", "id": "1701392028166068", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823949_1701392034832734_8260944463000077686_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DouN6-j25wYQ7kNvwH33mvi&_nc_oc=AdqijBbL7QMdaFq95Dw41RxLkNEoNx9Rpc9AcbxgAgVMSl-wd_QjhJYHJDHEwHMEEgk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRW2PEYGpf1EOXoOzLsFDWOxaIEEd9qDhcZs-OLeVgE_A&oe=6B072949"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1667443914888756", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825470_1667443934888754_5943134861579125004_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QT7AMsFG_cwQ7kNvwH3QkNs&_nc_oc=AdoehHeCc_9l_tcAW_1qJIoagqMJBd_sSaACoNttLApvGnp3PKDHJf1uApXTkGatOp4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdJqDS2bOf2yak7Vjd8EjDbhXAoofZU5lNKc_ZO39CFQ&oe=6B071A6A"}, "display_name": "Hand AR Interfaces 3", "keywords": ["AR", "Hand", "Interfaces", "Passthrough", "Fingers"], "long_description": "Your hands become the starting point for a collection of spatial interface experiments. Browse the catalogue, choose an interface and explore how different gestures can control objects and information in mixed reality.\n\nTry fingertip faders, explore a miniature space, turn the pages of a book, draw and experiment with other hand-centred interactions. Use the in-app guidance and catalogue to move between experiences.\n\nDesigned for hand tracking in Meta Quest passthrough. Different interfaces use different gestures and optional device permissions. The app stores some of your interactions locally. Review the privacy information for details.\n\n", "short_description": "Explore mixed-reality interfaces on your hands, from fingertip controls and drawing to a miniature room and a book.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/terms.html", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/support.html", "website_url": "https://nebulytic.com/apps/hand-ar-interfaces-3/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1394134400449246"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/4918279
MiY9KTVk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQj8BpYVt06cuo2plzKJs_alk_3N8VlXuZ7itU8SEB-iA&oe=6AF9D15E"}, {"file_name": "screenshot_3_H40_book.png", "id": "1701392028166068", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823949_1701392034832734_8260944463000077686_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaZUJiI8XyMQ7kNvwEqBndB&_nc_oc=AdpnqTWv7NTaEP9RdVuVt-szDHhRL4o2hHNonJbVlfBiO5oFNlCUyowXcExERcOrDYQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlK9YqfRxuVwssJWaylEaIlXmGPyrl-Xy3GdZ_9ZQanQ&oe=6AF9C209"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1667443914888756", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491825470_1667443934888754_5943134861579125004_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-y1-0IDUUcQ7kNvwECHnVC&_nc_oc=Adq6DgQ1DHxYyGEf8UDg5kV54VaeTrEoC7FfEDrcpKLG0eQQzT_5h9bOhudzeNbiR2I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_Yz7gPUYBixjsyPB1gK62awil0nSV0SDWD6uj3iMzcQ&oe=6AF9EB6A"}, "display_name": "Hand AR Interfaces 3", "keywords": ["AR", "Hand", "Interfaces", "Passthrough", "Fingers"], "long_description": "Your hands become the starting point for a collection of spatial interface experiments. Browse the catalogue, choose an interface and explore how different gestures can control objects and information in mixed reality.\n\nTry fingertip faders, explore a miniature space, turn the pages of a book, draw and experiment with other hand-centred interactions. Use the in-app guidance and catalogue to move between experiences.\n\nDesigned for hand tracking in Meta Quest passthrough. Different interfaces use different gestures and optional device permissions. The app stores some of your interactions locally. Review the privacy information for details.\n\n", "short_description": "Explore mixed-reality interfaces on your hands, from fingertip controls and drawing to a miniature roo
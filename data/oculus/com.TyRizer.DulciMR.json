_description": "Play and learn the hammered dulcimer, one of the world's most ancient instruments, wherever you go!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tyrizer.com/dulcimrprivacy/", "developer_terms_of_service_url": null, "publisher_name": "Ty Rizer", "support_website_url": null, "website_url": "http://tyrizer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36393587713620741"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312236_3764190583720022_6727271544900618832_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8N59RoeC-9cQ7kNvwEZOJmP&_nc_oc=AdogECF-F-Uj16KUn9PTFRj-EM29nwEKixGy3YhB7jmbc_M9zv7j05NxLqvExtI_xa4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU_bQYn36gFTwFI0KZjmnn-9Njf0mK5-OXv047fpUqRA&oe=6A8D79D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "DulciMR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1770130800, "lastRevision":
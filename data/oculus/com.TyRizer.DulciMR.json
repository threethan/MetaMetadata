1875228501012", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820923_1431875231834345_7990300306514254616_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=msNPaXVOSDMQ7kNvwF2TY7E&_nc_oc=AdrF8Hjbp8RG5Fu-mqgHy_p2e-djrqx-17U_KsRWAcuMud6dGJQBzUqYqKlwy-IEZCM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ooDeYGMjeS6H9oqbRhvCDIDSqrd2LwbmrEBC_QwkW1Q&oe=69D7BC20"}, "display_name": "DulciMR", "keywords": ["music", "dulcimer", "learning", "culture", "world"], "long_description": "# Learn to play one of the world's most ancient instruments!\n- **DulciMR** brings the magic of the hammered dulcimer, played around the world for more than a millennium, to **YOU** for **free**. \n\n# Features\n- A **fully interactive 9/8 diatonic hammered dulcimer** for users to play freely on\n- A **song tutor** system featuring **75+** songs from **12** genres\n- Full hand control and touch controller support\n- **Mixed reality and virtual reality support** with two immersive VR environments\n\n", "short_description": "Play and learn the hammered dulcimer, one of the world's most ancient instruments, wherever you go!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tyrizer.com/dulcimrprivacy/", "developer_terms_of_service_url": null, "publisher_name": "Ty Rizer", "support_website_url": null, "website_url": "http://tyrizer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TO
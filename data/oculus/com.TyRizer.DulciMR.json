 than a millennium, to **YOU** for **free**. \n\n# Features\n- A **fully interactive 9/8 diatonic hammered dulcimer** for users to play freely on\n- A **song tutor** system featuring **75+** songs from **12** genres\n- Full hand control and touch controller support\n- **Mixed reality and virtual reality support** with two immersive VR environments\n\n", "short_description": "Play and learn the hammered dulcimer, one of the world's most ancient instruments, wherever you go!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tyrizer.com/dulcimrprivacy/", "developer_terms_of_service_url": null, "publisher_name": "Ty Rizer", "support_website_url": null, "website_url": "http://tyrizer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}, {"id": "434961926215971"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33582676634711877"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819473_1708435839834978_9045374369028370590_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiQ3ykla1FsQ7kNvwFHB_7Z&_nc_oc=Adp-PaqyHgVZylS2i3chZYFq075NWxRdKMIdN_ME2GPnaC_1cw7QblWr5aqQnZB9ICQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_j4AeSFxQs_Q1e8atIPq-qrsFS1IiJdoBSLS2DcJt98Q&oe=6A393FF5"}, "is_concept": false, "is_test": false, "is_trial
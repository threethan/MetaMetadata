1Lcju9lOCTc5SNrub6z0VWqBIneVZBWjqvQIxOwEIG6BI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfscpOwmbFZioG145BnGS4woJ7j_HQodeQ0Wa3B7_y3wKQ&oe=69983B32"}, {"file_name": "Screenshots_12.png", "id": "1034567285241716", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393826_1034567288575049_6723467147878770863_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOdlwMQsxZ8Q7kNvwHlqF4_&_nc_oc=Adn06wz32wce-4wcUtSWmTpcAsstxsAYRmF_dLKg5YZQwZ8vY0hRt4gvKPpUTUbQNaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvzhyIWS0_mXBukFsY-1nyRGABWg1MTZmhvUgWk47t4Xw&oe=69986C6D"}, {"file_name": "Screenshots_11.png", "id": "2495512970780301", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391890_2495512974113634_1541585814501434894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l9S3s_xuQoQ7kNvwFOJSNC&_nc_oc=AdkoIivQK2wRwv0QU4FFu6XV54teV5tDJtRdGVZ0cbMbQwTOab_QceiWoysTGpUABuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvceDOuCeT_kjfctH6M8A7j9rv_-mZwcWaMu52NO9f9qQ&oe=699852E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_Landscape.png", "id": "1420687409127373", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391924_1420687412460706_7967300138598923141_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YE63MkoVpKIQ7kNvwGaQOu1&_nc_oc=AdmGIOyFuxF5K3BmR0rxMiiJeMcnpEXUDQdUDtorGUfIp-jt4a5qLekKNuHHhywi8rE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuORX9SfSCpWfzid4zfgtC15FjVXxoEw6I-RHT2lIWERg&oe=69986B8A"}, "display_name": "CloserLook VR: Oldways | Demo", "keywords": ["Story", "Adventure", "puzzles", "mystery", "Conspiracy"], "long_description": "You play as Tessy, a final-year microbiology student trapped in a university administrative building. As you search for a way out, you uncover a grand conspiracy and the sinister plans of a mysterious organization. Designed specifically for VR, CloserLook VR lets you fully inhabit its world, piece together a gripping narrative, and solve engaging, story-driven puzzles.\n\nFrom waking up in a school library to navigating ancient temples, each action brings you closer to escaping this beautifully rendered West African setting.\n\nKey Features:\nRich Narrative: A deep story with themes of corruption, exploitation, and unexpected twists. Question motives and assumptions as you uncover unsettling truths.\n\nEngaging Puzzles: Solve puzzles integrated into the story using tools and items to escape a building designed to trap you.\n\nUnique VR Experience: With stunning attention to detail, CloserLook VR pushes the boundaries of VR immersion with its custom-built world and narrative.\n\nStep into a meticulously crafted world set in modern West Africa with CloserLook VR: Oldways, an immersive story-driven adventure designed for VR. Built entirely from custom assets by a solo developer, this game offers an unparalleled level of detail and immersion in the VR medium", "short_description": "CLoserLook: Old Ways, a captivating interactive story VR adventure game set in modern day west Africa. Awakening in a locked university administrative building, you'll need to solve a series of intricate puzzles to find your way out. As you navigate through the game, explore secret locations and uncover a gripping narrative that delves into themes of exploitation, corruption, and betrayal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/closerlook-vr-oldways-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "eMEDIA Interactive", "support_website_url": null, "website_url": "https://www.emediainteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": 
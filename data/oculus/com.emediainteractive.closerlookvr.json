h3_jLfgbgt1mJdmTwX7npBop53Nd6ZvlBAYMxibEGRIv-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsDmGhBOEwt6DFL8XLWKYxS5HxLyCB15-ef4ACjRGA5Dg&oe=699C4764"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_Landscape.png", "id": "1420687409127373", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391924_1420687412460706_7967300138598923141_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0dTjtTHEcAQ7kNvwEXcEqg&_nc_oc=AdkJsgYkID82453AJ3uHRKK5UuQFI8JhMahsTHFQfnGWCguV1PATfdojKOGYWAI97dc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu7jlIebZ9BtnllsS-muJ3xfILA-hLeoi9DblJ2gW7J7g&oe=699C600A"}, "display_name": "CloserLook VR: Oldways | Demo", "keywords": ["Story", "Adventure", "puzzles", "mystery", "Conspiracy"], "long_description": "Step into a meticulously crafted world set in modern West Africa with CloserLook VR: Oldways, an immersive story-driven adventure designed for the Quest 3. Built entirely from custom assets by a solo developer, this game offers an unparalleled level of detail and immersion.\n\nYou play as Tessy, a final-year microbiology student trapped in a university administrative building. As you search for a way out, you uncover a grand conspiracy and the sinister plans of a mysterious organization. Designed specifically for VR, CloserLook VR lets you fully inhabit its world, piece together a gripping narrative, and solve engaging, story-driven puzzles.\n\nFrom waking up in a school library to navigating ancient temples, each action brings you closer to escaping this beautifully rendered West African setting.\n\nKey Features:\nRich Narrative: A deep story with themes of corruption, exploitation, and unexpected twists. Question motives and assumptions as you uncover unsettling truths.\n\nEngaging Puzzles: Solve puzzles integrated into the story using tools and items to escape a building designed to trap you.\n\nUnique VR Experience: With stunning attention to detail, CloserLook VR pushes the boundaries of VR immersion with its custom-built world and narrative.", "short_description": "CLoserLook: Old Ways, a captivating interactive story VR adventure game set in modern day west Africa. Awakening in a locked university administrative building, you'll need to solve a series of intricate puzzles to find your way out. As you navigate through the game, explore secret locations and uncover a gripping narrative that delves into themes of exploitation, corruption, and betrayal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/closerlook-vr-oldways-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "eMEDIA Interactive", "support_website_url": null, "website_url": "https://www.emediainteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9365319856920042"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "920252796728150"}]}, "baseline_offer": {"id": "920252796728150"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1744051440, "status": "PUBLISHED", "id": "920252796728150"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9865731410212215", "version": "1.0"}, "id": "1186406939015817", "channel_name": "LIVE"}
91934_3811275635869399_416047035203187071_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T1z0ZermMYQ7kNvwGRniB_&_nc_oc=AdnGYD8FPsu_gWm1A4IMuOiM7lwCKNhSLmPxLf55n_rsaZwYWSEC3dEEKF705W0ZRjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsCePj6HXBfTWNd-ZXFcSW68mFi5iwJpNbyJ6con6mxkA&oe=69998CB2"}, {"file_name": "Screenshots_12.png", "id": "1034567285241716", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393826_1034567288575049_6723467147878770863_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9FglLiDxDcQ7kNvwHi0zOV&_nc_oc=Adlux4ibsjOt4rAy1ibdOXM8zZQPn5r2Hui3IY16Z31dRa-Zf0xt2IqCVmdngKIo4BY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrdVBk-5NubhjE7UP1CueUOv3oUuJwFzaWQYWnOGTakg&oe=6999BDED"}, {"file_name": "Screenshots_11.png", "id": "2495512970780301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473391890_2495512974113634_1541585814501434894_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l9S3s_xuQoQ7kNvwHaEgXQ&_nc_oc=AdkDIeHC2uD04uKiUn2HVzzYw8OL51VRmXqGq3t_ZM0B7wUTAiwYx9csdfAXA6nFCuc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv9EFCRKkKfVCbWvYTaAypXGZ-Jptgxg3z2xCkOgfN3iQ&oe=6999A464"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverart_Landscape.png", "id": "1420687409127373", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391924_1420687412460706_7967300138598923141_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YE63MkoVpKIQ7kNvwHqNhf4&_nc_oc=AdksF4_Xz7-GeH3zaIZywUjB6_xmag59NO5ZUxyKdYMdRVj1kPofrKXU7pN9WTiNmMI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsDYNvqdBcimktkjEBOVWjJFq6fhovO99AW6cqM2erXOA&oe=6999BD0A"}, "display_name": "CloserLook VR: Oldways | Demo", "keywords": ["Story", "Adventure", "puzzles", "mystery", "Conspiracy"], "long_description": "Step into a meticulously crafted world set in modern West Africa with CloserLook VR: Oldways, an immersive story-driven adventure designed for the Quest 3. Built entirely from custom assets by a solo developer, this game offers an unparalleled level of detail and immersion.\n\nYou play as Tessy, a final-year microbiology student trapped in a university administrative building. As you search for a way out, you uncover a grand conspiracy and the sinister plans of a mysterious organization. Designed specifically for VR, CloserLook VR lets you fully inhabit its world, piece together a gripping narrative, and solve engaging, story-driven puzzles.\n\nFrom waking up in a school library to navigating ancient temples, each action brings you closer to escaping this beautifully rendered West African setting.\n\nKey Features:\nRich Narrative: A deep story with themes of corruption, exploitation, and unexpected twists. Question motives and assumptions as you uncover unsettling truths.\n\nEngaging Puzzles: Solve puzzles integrated into the story using tools and items to escape a building designed to trap you.\n\nUnique VR Experience: With stunning attention to detail, CloserLook VR pushes the boundaries of VR immersion with its custom-built world and narrative.", "short_description": "CLoserLook: Old Ways, a captivating interactive story VR adventure game set in modern day west Africa. Awakening in a locked university administrative building, you'll need to solve a series of intricate puzzles to find your way out. As you navigate through the game, explore secret locations and uncover a gripping narrative that delves into themes of exploitation, corruption, and betrayal."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/closerlook-vr-oldways-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "eMEDIA Interactive", "support_website_url": null, "website_url": "https://www.emediainteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}
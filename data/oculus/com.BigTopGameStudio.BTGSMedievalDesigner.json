3_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghqqJOAgmSkQ7kNvwHswgX_&_nc_oc=AdkmoI-bZUU0tuyCiweW_CtFEFqVcFPk1LbaNujMwqyNL11f59HJJUetVc05jc_iaLQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsYWy0jC0wt55xS-wa_u7ZyRKwjow5OxojERlK_x3TzvA&oe=69A6C85B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72gQ3TZiWyYQ7kNvwE-MN9z&_nc_oc=Adl-R2u_CYreH062bk3YPtM53_pLolsppZDb1Sm92rKK2Xt9nMKg_yr9okI9oJJWQMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJKydnlZPKVQm3SnzNPo8Iz82mjv60K43vhPeHpPOKQw&oe=69A6BD16"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuDqjF0uJwkQ7kNvwF7syqK&_nc_oc=AdmK7Up2L8Nf29JT-udF8feUSCwR-qbXu2j2SYS6xNetmc8Rf6GSDFqCBGp4n78RlFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs6bFSKTkXXTthdsPzPMbbcyB-NW-y4RvMWrseJ3Zf1pA&oe=69A6CC1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms
3_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7trRy3O26oQ7kNvwEqxx13&_nc_oc=AdnXd1igXq9H7MGRCTjldrL9GKp09LrpJhn4jRYlc6ZcPzk7QTiq90DJ1ObuFaEETe0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsePuj1bZ8PCMdvuQ7QRXGfsdgTdG5P9SBEaoMp5yRe1A&oe=6999995B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnfjXrFHWLkQ7kNvwG6qC6u&_nc_oc=Admr-obiI9UaeVZfN-xHO4kplPf7EK1io6p4RZMY8_634vxf7PiZ39lW_-t9lKf5CNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuDgPC4jgTAWBQmnUI8ZLEooiS5-z4nQOzioA1spKqgRQ&oe=69998E16"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSRW_LsQSkMQ7kNvwGYMGOd&_nc_oc=AdlGLspIXbM3rFTkVVQj_uo-IjAQvaYwtvmf1NUh1pXR46IWcplnUWae84AqUbwoXFc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftA5mBSPRcZYmhe1dwf--j6BYwJHDC7x3Rxrc2qnza2SA&oe=69999D1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms
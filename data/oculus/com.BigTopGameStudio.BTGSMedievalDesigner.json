3_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghqqJOAgmSkQ7kNvwEARjM-&_nc_oc=AdkOfKgI8hyeeaqLQ3o-QpZfqPj4Dg7PWaqMixIf4PlbdX-STa81Jh4ccwHYscxZ_yI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftesyIiSWJnLpHBFpM2iN-mlIDDcW1O08PUrkI8IR6r8A&oe=69A576DB"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72gQ3TZiWyYQ7kNvwHXXqDW&_nc_oc=AdnDpA38Hur3IBe5ii2N1o_JLOJim-A4rNYVXCa_37XaMwqOKDFHSDLGnSOe9bR6g3I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsEjR6vgAxC51YskgWSJllM4a94zv5ypIt56V3hbXbw8Q&oe=69A56B96"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QuDqjF0uJwkQ7kNvwG5K1Tq&_nc_oc=AdlLjEFrIHpyygdle4tzMbRqQwF8IDaf3nhY0ifVbEjQWP6Zq84ey3MvevXyG0FGpGc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsUqiHjWbNF8jz6pQ_zfogreT_rUkYrNhuwDVA2bLJNaA&oe=69A57A9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms
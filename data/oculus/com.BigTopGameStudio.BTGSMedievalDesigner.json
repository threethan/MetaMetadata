R&_nc_oc=Adqv2LMpI192YtqAJFzdLpONpU6EtUDIrRKHa1ezAuU_2hyW9WZUuD1S_Bx6v1zkPnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX76ThY0R2qHFQZxd0uUuBrNyteB5r7sCUNWI2C6p6pVA&oe=6B0EF620"}, {"file_name": "Screenshot4Resize.png", "id": "319733562907880", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxG9qlNN1g8Q7kNvwHiTq6j&_nc_oc=AdrNw_-SMatOYR_p6mfSpRjUXnKsDKd_KDndHJnrgM49KxOpWfciJY8d_pX58Ko9vLQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUDpSwFFLGeY9xFUaOjv2nv7RnAhVeyUzvEukdhHX8vHg&oe=6B0F225B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55sy3yjQ_msQ7kNvwE7Skpz&_nc_oc=Adq61CMhlT9EjQ6eTfwvBpG2NYBvPBjGGWUapWmhdcG5NrTKbh-JYWyOeg5hcaTvwm4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVKOWPCsZjChuQBP4ub7nwOq41IY5g5zoeMGSaUYzzFPA&oe=6B0F1716"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nKWTEaimTUQ7kNvwHJwF_E&_nc_oc=Adr5iRUC9tW-__oMs0SrsNxJUObmvAVG4Nsl5Bd7gkYczUn2WDTQOTqAgUtdzPGdWFo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVheQyKk0rkdf-hwHt2JNq85ROk2fJJH03yNNKkXfKwbg&oe=6B0EEDDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Big Top Game Studio", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "369181571227050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974831_792980618262620_7571099379093158697_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOU79IjE1fMQ7kNvwGUFSMr&_nc_oc=AdpTx8tgzon83bdvIC-3VDXF095wi202ZcXy8mQHM2ktydqpqUnqEfp9c0FLbxRz5cc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUeHrpZYulsRWNEFYDwL0BCcnQRCQpefR_RMllytJY0Bw&oe=6B0F1AAD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medieval Designer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362
ri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCfyDiLxWA8Q7kNvwFPcRnR&_nc_oc=Adn1DibZ1RdkcjnpnSleNFwu_oq_UbuKhCinJfeH6wjMw1oj03_MYwTMw18iKoSuuqM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk4e_Lcpc3-F7n-_JuOv29AgCTyBwR-jlVDQxJrAW_bg&oe=69AD5FDB"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEBjjbk8l-oQ7kNvwHJ289R&_nc_oc=AdmaN71vrg0mdjOP8kKxn2g7dUt4Zo6NozknjdIp68W4oO95fRKk3vy0y6kE3Ovpp7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCCUWS2OuP4LMH1e2wlxpuwRTeeSBz3a19OyYurM8mrg&oe=69AD5496"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIfzNFTW1YEQ7kNvwGqRx_B&_nc_oc=AdkNmHU85j0WNte-MzcltozSrjSyqaY_kkkGZYOQYdaXZQssg_PWr0baza7UCPda3Xg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjJM24uNlSRHTgQZ3xVu-_f_ca2YKGjdWCQWFv87Y9IA&oe=69AD639C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_nam
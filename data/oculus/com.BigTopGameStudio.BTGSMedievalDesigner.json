A&_nc_oc=AdokjjHCS0D8q5zeVcLWgrJiIwZY4WLenOByCAFfP4TBaXlkK5uwDh9O-6I-P22F2wg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMC3u0DK-dOpJhVNpRf1_w1Rs29iJGZeve24wjl0NG3A&oe=6AFC8120"}, {"file_name": "Screenshot4Resize.png", "id": "319733562907880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTuBBSXQLg0Q7kNvwFLXC-Q&_nc_oc=Adqyps2rVmurvsbAcotJeq8M4WtPTix7Pa8n5p6UhEFUuiwJQ4QIJnmBZsMCiv2RRnw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9cmoXtta7rOO_A64-cqIx6JjwIk_27khZ2aviWbT0Jg&oe=6AFC751B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wZo3b-IdR5sQ7kNvwFx2DN8&_nc_oc=AdqHqverHxZiokON0Ad1h2kxxtcTU73USnjyq1buoH-1GmQ6huAFahaJb-o1Rp1fROw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXW7xGNPra2rWchjc8bZwT_fUiwNFvVEJdzh3N7G9NEg&oe=6AFC69D6"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRPsi03O1FQQ7kNvwEtMugZ&_nc_oc=AdqxWH8Kz_wqBl4fOp5b9DeUZYzUjM3iYQ3cw-av09R4kGvmXLlKmJ370_d1D6Jmo58&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFnkYkI3C9KILRKm2_r_fYcLfvY5yt8WaRPiR04BQsPA&oe=6AFC78DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Big Top Game Studio", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "369181571227050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974831_792980618262620_7571099379093158697_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IECeRDcUXvYQ7kNvwEjNoZU&_nc_oc=AdqmrUh0_XXFjWOm12qcKGJQ-nRAXpft2l6WwIGDs-gq4SelLn3Vm9knS-6gI8gngc4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsCaqRbuDgHQC7b41UvEZoXOiD1zRc1oY2e1zOqhyL2Q&oe=6AFC6D6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medieval Designer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362
ze.png", "id": "319733562907880", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7UN29G7Q1DMQ7kNvwEFra2t&_nc_oc=Ado92VUzT17rM-HRz5WYfW9uMfkHDLhw9nlRDEw2i3E49ezGPF04PovZFcj5R_nWbd4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxcCdRMeTR7IxYTbo8Rjzu0QOUFIssfNyxt5oO7LbNnOQ&oe=69C7BDDB"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z_NXv0YjPOQQ7kNvwHFqKTJ&_nc_oc=AdqwKD_7IlAsH90k41Sdigt5zp5PckeNhvqhPFfqqWqkBFhp4M0PdpERAfzw6pA5NW8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjE0KCKxE8d3JSlD94yv9pQuczl1UyEmpseB5j5GhAoA&oe=69C7B296"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WOMb4XIAiUQ7kNvwFBsagR&_nc_oc=AdrQLYtgZMOIyk3E4JUbdgrBKDXY_9q8xuJ3uak0G2wKbmpN40H3cDraxOgtQBrQPwk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyu1nXF1-41zpJ2Bh505T0P2F0LK6Mz_mryVEIoghl7MQ&oe=69C7C19C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Big Top Game Studio", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "369181571227050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974831_792980618262620_7571099379093158697_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ww0E0Qy5YIQ7kNvwFJaAsA&_nc_oc=Adoh6C3sr_ycpB5OorelSQh8GzqJZatoe6jrrRG562rlrCD6rfofvUa1M_OcB1boHtc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwUs0FupWDfkNoHf0DipQgB_88p8Iw6VTg2GgP1j80dGA&oe=69C7B62D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medieval Designer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1623267959, "lastRevision": {"nodes": [{"id": "237310621194200", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4022787477734360", "is_first_par
0", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZdxJCADrzMQ7kNvwE1-Qlt&_nc_oc=Adk5X6sCzMCW9NrcGVGRYSUn0LK8zzGZsJCUMjfdykpxkcV5VhM_2uKkNa1wIlWLOqU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzIpcGsqWGr0sSRnEiplOLAS6Nc3ntdPAMy-c3OPthyVg&oe=69AABCDB"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-uhQXQkaT68Q7kNvwGJK3YF&_nc_oc=AdkUj2yQ2L2flPWK6SfYu8nhQSnJz7uvhkhNMrWIFvYTevF97akeNKy9OpZ-ll5BjU0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxsWg7t26n48renyIGdGgYVEN3Y0CfPLWViagBTBq_99g&oe=69AAB196"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wHDJN_f_3sMQ7kNvwEyzVzL&_nc_oc=Adn5My0XmP42LZnrNUoeghpfPLbbK-4ML-iMuRrJ9Z9_Co9U5oS7VXMTNoT-wjxJJN0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1xE6Xn3CjSCgtsVgjJOPmmgDRT96Y18781g6j222sEA&oe=69AAC09C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "dev
ze.png", "id": "319733562907880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VeBP9bHj0gQ7kNvwEyu-ss&_nc_oc=AdoYxBXdxXP2zR649sBbYJzi2tixbti8OBay6EW564eo47KCItDRRpqLNQiTHo3WO6M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mhAt7NayXa5ipNrYKXEceuB_-lUTYoG3k-pTihcbmGw&oe=6A38059B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ke-4doRC2nYQ7kNvwGYGJ1E&_nc_oc=Adq8_nPioFHgx1FLvT3XYZwtSBgCsUFHqkxUiXjhnJT3IbAvYOxN2yQfbS8u2edwHQk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DQUSL73k7BfdLvzC3GnMQhgN6nNe5QGTVjxiOe_2E9w&oe=6A37FA56"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbNA6q9sIaAQ7kNvwEReJiL&_nc_oc=AdrgMBPQ6MY4VzNmiGdYjOY276tTzLBZ_FTH-j1cx4cbjId8Q5NaCjmU2WH9hu6PxCM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85Qj_pIRsaWKyL33qaKZ9qqgR7-g8H7pSCOzzFJdW-EQ&oe=6A38095C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Big Top Game Studio", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "369181571227050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974831_792980618262620_7571099379093158697_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvGu2bSOeDQQ7kNvwE3skjZ&_nc_oc=Adp-mMNqiSiO5nFSzrLBx-04lRKk7zg40X-jfCnAw_nbpcpV4FxMsY42H5o_MM8q_8I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9iPfQSkwML5cYlUZd9KPG5oUR-fsmFKhnIvIWxbSa-A&oe=6A37FDED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medieval Designer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1623267959, "lastRevision": {"nodes": [{"id": "237310621194200", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4022787477734360", "is_first_par
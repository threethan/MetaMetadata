0&_nc_oc=AdptGwN7WDl20ygHM4SrBhH5cvfV1j7EvqbRkNoMV4YpG3JB05SQV62lSyA3UK8Fg88&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBrv7jzdjPIUIv_5C16HwlAgyj1KyP0QeVku_kAWbFkQ&oe=6B0075A0"}, {"file_name": "Screenshot4Resize.png", "id": "319733562907880", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbohCb4h8o0Q7kNvwFL5UeZ&_nc_oc=Adr-sjZJ6s1jY69BclEn5YJqIuyoWA8kA9EvtYCxJyYFd8jiHj8KPN3Y_06j6KjbclQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9qGbzmIShxffTF4b3mwVMNqhB-lDLrBsH6WuPxcgLiw&oe=6B00699B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHmfh8zLTeMQ7kNvwGzVuCX&_nc_oc=Ado_VFJbcVw27fgjioHtiNtyDtIJRFXJSsBFpyA5oyONP0I1MSnyejDMcCzxiUyS9qk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRaxIyIn39tk2CNWZp2VcJdb1CsptIEnFlQEHrJt-ACuQ&oe=6B005E56"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFPu3gisjZsQ7kNvwElWC1x&_nc_oc=Adrfhv7gaVWNRf1FAmRZu3dj9H5WMzV-aVFZ9RzJGDrDqN2a0KYJIqcA2giuTBS8SLY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWexBjjdCe477sEQNyxd_uwusALSNBxjBMPCMvQ89m7g&oe=6B006D5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Big Top Game Studio", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "369181571227050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974831_792980618262620_7571099379093158697_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRHScxDGRUEQ7kNvwFbxV4N&_nc_oc=AdpITqPRoEX5lp4GP7ZiGjabyGUi_hT6gT2cci8LbECfh_w_HR65nStpFK4_yMiFDq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLXEEyOPvZjzAP4ZbyzJHv-ZALz-7nNPKzpfy0m55FeQ&oe=6B0061ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medieval Designer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362
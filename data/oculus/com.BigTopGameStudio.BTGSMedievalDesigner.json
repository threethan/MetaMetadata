ri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaOWPzX_3PMQ7kNvwFsk5qw&_nc_oc=AdkEGNvV0IfAxRF6HJubHitu6QfxlRiMg-iq8TwxnfAz90KOQjVuGATG9dJwNELUlhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLDlRjAntPnr4f0QnUkhNMOVLywdOsAKlhADuwh5niPw&oe=69B69A5B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG1nKtzIU1EQ7kNvwFX2FeD&_nc_oc=Adka9DhoemR6IOhakXuJ51lk9aHseIDnAPSYBV9oiHHPYuu1lHic9UYHmXLv17XONsk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxNcZIA1pr37vIgiAS4pyQv5I6itLX_gFkWh8R9IUwkFA&oe=69B68F16"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfzN-IgM6oMQ7kNvwFGAo_I&_nc_oc=AdmZPxnCvc_ZCfg69uqKEwo3iVPFQbfo1DLVDd2iglGgZ96F5dh2zqQXq0hUjHl3mvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxx1haTQwvcTmzuwZ4UUIFENNWo3L60xSWk1xzMGtKNqA&oe=69B69E1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_nam
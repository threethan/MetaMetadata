ze.png", "id": "319733562907880", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGEb7OIXMwMQ7kNvwHBIUzl&_nc_oc=Adqe3imUXcKqIcGs3X2Zg9pZk4TBANzTSHmnF12LqaDe1ehRmoSnoRv71PieIF4leCQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1q1jQhV7VqZVksKcrGTwrBtNUwulDjxxeQfHt7kxdS7w&oe=69E761DB"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xgn52_c4V5YQ7kNvwGKolvu&_nc_oc=AdpEjDyWzJSQherG3zqtWQ1DQJ_K8BqkA2FksHCj0gN1oFcCT6MbIv9j2VCNdNpTow4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1UrT0yWkFmJDVzND3oMzUpf0E8DZFWanU8k1WkRhQmGQ&oe=69E78ED6"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USQ6hDMjz1MQ7kNvwF9c58e&_nc_oc=AdrjxWStjFKieFQuMFkWD8slILfsM1SyxpOs2ppQFLmTnFSQ3ErXoxf7zG86J3UqI_I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wPltfuMiaLjaA1ehYCGt-_nac-ObL_YtAylE2D96wAw&oe=69E7659C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Big Top Game Studio", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "369181571227050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974831_792980618262620_7571099379093158697_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=teRPCx8L-tcQ7kNvwFUiJGM&_nc_oc=AdoYVGNfe-053luOUFzwP5qlHfbIxFz6X-sHigRCvQZwyTtYuC9rhNRxgCB0VhxKJl0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JRUrnYRO2ySehUOjIYi2Kt_IGm5T-nmBwOJxlBgC6yw&oe=69E75A2D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medieval Designer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1623267959, "lastRevision": {"nodes": [{"id": "237310621194200", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4022787477734360", "is_first_par
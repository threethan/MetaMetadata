6&_nc_oc=AdquE-S62h7RpOq7TfWse_83UNAWQ4UHOyz6u839-040uMgFbYzbdyqo1Oq223efxng&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTfylHe2HaXGc_1KtS9G5pmyNGgnzeU4uLM622Ri8oyMg&oe=6B0C5320"}, {"file_name": "Screenshot4Resize.png", "id": "319733562907880", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vyrlARNf5UQ7kNvwHFGzX_&_nc_oc=AdqkhXL5F_FyIywTfQlvL-Osp2wtCv9huiaqLa3oavh5MB_a6Ag9QAf3_861ttFJRho&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhXVw7TKh7iagfe-0a3PnJU6yLfTBVUc0W04K4GI3bgA&oe=6B0C7F5B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=55sy3yjQ_msQ7kNvwEv7aBJ&_nc_oc=Adq60UodrfCd17hKZAG-mvLJRznFUsttCfC-DcuDhNYOAGuanwtFe-KeK7TReJQSPBQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0NF3FQ-YcOZgcLfJmSsuUu827HttI32cNHzmToQ7DFA&oe=6B0C7416"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nKWTEaimTUQ7kNvwHFFpFn&_nc_oc=AdrmpcDKqZwGbCj0aoB7Hm21sORlz2USBsI2VstT4zkgXdgU-XAkeDTDR1l_HXjjyeA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQPWok_qGlcwOtJfpgHMM_INeOBu4ozU-Wv5UDA9mDbDQ&oe=6B0C4ADC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Big Top Game Studio", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "369181571227050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974831_792980618262620_7571099379093158697_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bm3O2EaBcCYQ7kNvwFvrL9H&_nc_oc=AdpINNRHgBhE-YBwdI9IZobDKN-PadU0Gk_aLVQZ54VSsojjYoGARWFdKc-4jA9uWiI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcmsJed2A3-umdTyjBVwqTUzQsCe6AtfIBHOXVenrD3Q&oe=6B0C77AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medieval Designer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362
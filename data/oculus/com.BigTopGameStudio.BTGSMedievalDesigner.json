3_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNbKBfaUG3MQ7kNvwE0kemA&_nc_oc=AdlKZ3HvHNAepC1_V6zcBpN50qxgbarsYs5X9h88yjGp7CFrUkrlZWpHFqclUtV8SJY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftM8ApgyDelOWEsagJROPS2hhRfwfDU5uyyEmwsy5MG_w&oe=699C3C5B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QuZLPTTABsQ7kNvwEFQgqp&_nc_oc=Adna8fKAN4MBBOjo8KAFtjtkhjwIXgxAP9vNQxibCGFFtD3Wl_YLzcxDi3hB0hEzQy4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afua6FW4WX1qKzOydvZZq4llMPZnDE_llHXOx1XCxLKMBQ&oe=699C3116"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL1xXzbnvT0Q7kNvwHWyJch&_nc_oc=AdnLrWyLsMhfhL937e97FGAmuf7uobrSGR05O7fJmjAeFkmzSSJznmFES_r7TSKEsw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuoMfsbkKBVWxWv2ReXD5pL8yd0yQ8Zr73Y5LhVknP4eQ&oe=699C401C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms
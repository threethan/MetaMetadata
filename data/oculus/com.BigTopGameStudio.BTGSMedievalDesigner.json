ze.png", "id": "319733562907880", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXUyfDe7074Q7kNvwHRCXOj&_nc_oc=AdoXQXHuMiGLpk7TSYdCeAK7P_9Qg4QaEgYiC6Yap3_Ouro3_-Bs157Os1c1HCjyGSQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KtKfX5Q3Zql1t06CNVBW05kZbQ4F_j3Myoe8r3hFBHw&oe=6A3E9D1B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-42VZFHkNAQ7kNvwH0Aqmo&_nc_oc=AdotFBNa946CNfdhBFTymQb9hUnCm2OHh47SO6j42obxsqwCL4l76JkEBWq_fL5axyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qBsBcn4XRQGqVntv6AHTfrDqndwsz5Py7mKlTYlsbEA&oe=6A3E91D6"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wER1Q40b9KkQ7kNvwHLjSw3&_nc_oc=AdoDh3CRxhBNZjUJkElwVaCXRHV21X-T8kzxIjsS019YamIDamRZw0L5VuhpzRsLnRE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VI04VOctMtaarxJ1MaL_tS7XfGsfuisrEcwpzK6THpQ&oe=6A3EA0DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Big Top Game Studio", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "369181571227050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974831_792980618262620_7571099379093158697_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8-EhDshWoYQ7kNvwGKy_M1&_nc_oc=AdqpHQjDsZt97Y5RABwkG-5Z9DSIcaOP0QGvj7C5tMAZKmDMBVBXrvyHbttebmb_7rw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_r0jQkWvIFpNGmAbFLbkOgeq-vsMKsZS339oSiKpbeoA&oe=6A3E956D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medieval Designer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1623267959, "lastRevision": {"nodes": [{"id": "237310621194200", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4022787477734360", "is_first_par
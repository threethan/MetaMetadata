ri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZCfyDiLxWA8Q7kNvwEosotO&_nc_oc=AdnGoY7bOW-JoboeK0PwQRlY4SkRQQ-WR5blmSZkvYXU_5WIrdMmWRIH7IAq0uUSvzU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNNJVL3HSCz8LusZ7jK3JFQKia-m-TabgK4NfG8rpAwA&oe=69AEB15B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AEBjjbk8l-oQ7kNvwFrrjym&_nc_oc=AdlUtHt4S99Augd_6HCn4CClXi_RvwycCkCZCh2QcluMh2WviSyctZcyZ5tfeyniYDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQYuH6HH3fCyDohy85rtehmTy56JepQe1XA9QWiBs1JA&oe=69AEA616"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIfzNFTW1YEQ7kNvwGHvXmt&_nc_oc=AdkzraMD5ljGxAKwQmA7uP_G08-W3FQyHgEEihHMPBSpW9i2dK1Vwj4l5brRTExYWGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfylQEJfUSQSQ9vj2YMiY52JQZOw44O7gTWD9gnWsKEMYA&oe=69AEB51C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_nam
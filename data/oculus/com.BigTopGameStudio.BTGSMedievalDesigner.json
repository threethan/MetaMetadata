3_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IlHqZG8cX4kQ7kNvwHQ-REq&_nc_oc=AdlhYHn56Bp_skApsMMu1AAgg7Si806KDTAgb0RXYof7zfAtiBHJyUqkeFTucJE9tA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuYAN6YNshXH9yAnBgC-51AiUEwTleQ9Y4RmCdv81NFzg&oe=69A2D3DB"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hOUNRtuunbYQ7kNvwHNlO85&_nc_oc=Adl6a03FXgIXfzE6WNt0BfCSgI8BbXaGbVZIk8UMeiu9GC6M8G08qZN0Iml-5sAqcnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv-r64zgxYgQKtA_xlun97xAlpIQKlBP2GxwwnXEDrV1w&oe=69A2C896"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cIO_JPM1eAQ7kNvwFTw1Ay&_nc_oc=AdlGavtR6xUpnVeMt2UTcUBLBuiXQX7MuDpzyqdcYoFso_veSIH3zhDjp3ioBulblOI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvk72gzpYjI6l26tsOahO5_I1rPA4wMvenp-n1lwWLxkA&oe=69A2D79C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms
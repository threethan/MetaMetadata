ze.png", "id": "319733562907880", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mo2vT3k_-CEQ7kNvwGONfPs&_nc_oc=AdoDlPALFNo2a3UpDgyBqthK2IseaYO0KO0j-sCuqnSTjYlC93FKv3k2SY7j6j106Hw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBBzmq2jVfR_3eXPMDXQIve1jvhW1-Fnmw94uhMj_6lQ&oe=6AF5DD9B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7Qbs0krtqgQ7kNvwFj2T63&_nc_oc=AdptuCpyaxVZY-wnFX3m4zqh2DFb2gidDUo2Q6cucDaHyS5C06ztFW9XNzAiMSaiw_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBUZXcfGv-Como-gPu2nNuSZl8_B6AzSsA0hN3JBfnIA&oe=6AF5D256"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7LqKTO-lVQQ7kNvwFoazjv&_nc_oc=Adrv8rRS4Oylb6h9Xja04AfOABVf0_Fqiea4oWjzaV1p_jqUjzpecmTuR9CrqTSTq0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM_3JXMBoisiHOxKSZM-WKqJ2hIxNzM0hijfwFKy8dcw&oe=6AF5E15C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Big Top Game Studio", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "369181571227050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974831_792980618262620_7571099379093158697_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLCRD_d1WlcQ7kNvwGd2RhM&_nc_oc=AdoHkmjXxsgYKTo9_vE12QoIuO0IQqSeEPNQrD10k5RjdZMRlTqaZgsMLjoB_gxZ8Ns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ02aSgBQd71Covdgzc3PhApbISXdQad96S8AhGGXY0Xg&oe=6AF5D5ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medieval Designer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1623267959, "lastRevision": {"nodes": [{"id": "237310621194200", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "4022787477734360", "is_first_par
ri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MaOWPzX_3PMQ7kNvwF2mnYB&_nc_oc=AdnZfw8nhJMOXzpVcgZRiGKl_uo3nzgXu5w3ACgPU_7624kK7TeAMakBk1vzA1Ylbgk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJ4FEnl7YR1UIVzyGcQu1wT5xMQRbOXCRTa06o-cMOSQ&oe=69B548DB"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QG1nKtzIU1EQ7kNvwGg3FSE&_nc_oc=AdnL5cdus6WFE4u72-0Fi-h1reWo3FdKI9yDjTY9kye8Ek7BG1tNS1EHsuZHG85sATo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyxfK4tKGlTTKLeduXWu-5HS8ndCbPjJN8M6_zh3pp_sg&oe=69B53D96"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfzN-IgM6oMQ7kNvwH62636&_nc_oc=Adnj5VMxq4aMfGbag5lLc5qDp_Q04qcCi-Apeo2W_WQL9kn8kWE5asHyzURIqgpROlE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyJYM2JyRENruVevy508eWdKMk-Olwerkgfj6PWQezU1w&oe=69B54C9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_nam
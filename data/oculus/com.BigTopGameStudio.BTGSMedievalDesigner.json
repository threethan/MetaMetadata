o&_nc_oc=Adpsxl-mO9NuBtJxPc93o2Cuflps1uJkb9Duh3Q-H_NBVMxbr5MPoN9IC-s7wdC-ADg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcwpIIBTJoaDUCDMr_kFQg7CPHL8FizYHKNMjBnLVtQQ&oe=6B09B020"}, {"file_name": "Screenshot4Resize.png", "id": "319733562907880", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974653_319733566241213_8850807994778473779_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RYiJ4GX3ZCAQ7kNvwGA0f1U&_nc_oc=AdoWIJl4nJ-AvGCzTHX_y6axzrRm4JNt8bkG62DKAfZjgPTqCtz6UExS2AGVvtmlhhw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkdRvL8N-ZQ-EmwVBft4SsFoRtzyYb8Hni3sn-mpxqRQ&oe=6B09A41B"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB__dR8LfAUQ7kNvwH8p_Ul&_nc_oc=Adqp-Vy_39H8UpNUI5s8NcPW_q2lqOCEgOsyIGtAx2ezxlxAQFaa6UVit-tN82SbSlk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2fPZ0bwanK6wrytaa9zkaStIMqHfLPhx_6aVT98GEtw&oe=6B09D116"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2eImRZUAPfwQ7kNvwFRZwpZ&_nc_oc=AdqENL2gqoPmE0g81TABRO3MLRVStvQCL87siz99wYBmw965CfW6-M58zCzBdgVkji8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPi8mDMF8BzyYZ2c8bx4ZXRLg-NnLgaMzw_-bdAxfI2A&oe=6B09A7DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Big Top Game Studio", "support_website_url": null, "website_url": "https://www.bigtopgamestudio.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "ART_CREATIVITY", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "369181571227050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974831_792980618262620_7571099379093158697_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c53nWF-MTa4Q7kNvwEDhmX4&_nc_oc=Ado5cbxUY_egU8rcLPRvqOzn9FfD2PF6R_zY8XDH7atu72CSDsowL3H7kmTrjRAaz7Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1sR4CltoWaJF83pxO1Zj40u-8mobzDqRarbGkU9q43w&oe=6B099C6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medieval Designer", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362
3_8850807994778473779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7trRy3O26oQ7kNvwGpa92o&_nc_oc=AdmJYvp24RB_II9qJlE7IjEeCEt50dyNerlc4HKj2BponulBfrcZbJCVhIqx6PhF5FQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu0uvk9rmZ5PwXoYmFgD0Mr6aCwnLYgNISM1gyKyMYFvA&oe=699AEADB"}, {"file_name": "Screenshot5Resize.png", "id": "286252636414913", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974879_286252639748246_1447475321737256065_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dnfjXrFHWLkQ7kNvwESAviZ&_nc_oc=AdnkB77yfKqCG-vrlMaWhIDUkpVduE9IlTYalMDwaDqYcwW2iU-GAJf1YcXAK5ao7G8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftuO4LXp28OyqAMx3dOhw3_xx68V4XlAo7uYvJAGvQIhQ&oe=699ADF96"}, {"file_name": "Screenshot3Resize.png", "id": "470765427494953", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031410_470765430828286_5495200283801338887_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSRW_LsQSkMQ7kNvwGlqRQW&_nc_oc=AdmN0PfzFoq-1mQoGYXoke3c6rWsG-Koq60Z-WBye5blT3LBxVHDERAGK6xejBRo3NA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsNnaVhms0GgBNMn14r2_QvNQe5HsnaFK2Ipi8q4tp7vg&oe=699AEE9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medieval Designer", "keywords": [], "long_description": "Welcome to the town of Robark. \n\nUnlike some other Medieval based games there are no monsters to fight, no characters to talk to, no boring quests to complete. Here your only objective is to decorate these 75 interior spaces any way you want using nearly 2000 items including:\n\n- Furniture\n\n- Kitchenware\n\n- Containers \n\n- Bottles \n\n- Food\n\n- Books \n\n- Shelves \n\n- Armor\n\n- Weapons\n\n- Pottery \n\n- Rugs\n\n- Tables\n\n- Bar\n\n- Wall hangings \n\n- Miscellaneous\n\nThis is Medieval Designer.", "short_description": "Decorate medieval houses in VR with nearly 2000 items. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bigtopgamestudio.com/privacypolicy", "developer_terms
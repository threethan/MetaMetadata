391936689802485_8513451465301685519_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izh0kUiBhzIQ7kNvwE0G3qs&_nc_oc=AdpZUBl53GJXDlaPCmgtNgYEi6UohxE-gyrJhyZNeDCbCi0uATMSP1GTiemUQdZDYt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR956dhd7V49rg1L-ylwLacI1QnGg4nA703acyM-UaCXw&oe=6B01C785"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Boxtrix Promo.png", "id": "1152993308936111", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974504_1152993315602777_9081280687449064609_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyIctmBlfMAQ7kNvwFmZ9oE&_nc_oc=AdomEAfPHiBT8wev6DgRTWNwyFrzHga2V-U9O7KHkUB5_MzBB0TcHjYSXgn02PrSX4c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkCzyTdmXdiK_ZtjRS77Tz--kmH2B_de_prWcZVxPuqQ&oe=6B01E02E"}, "display_name": "Boxtrix", "keywords": [], "long_description": "Are you lonely? \nBored?\nDo you want something cutting edge, but also just chill and sit down in your living room? \nWe got the solution!\n\nBoxtrix is a competitive puzzle game in your own living room!\nSit down and challenge your wits!\nGet your name on the leaderboard and show everyone that you are much smarter then them.\nOr just chill and play casually.\nTime to enjoy some cool cubes!\n\nBoxtrix has three modes, Timed, Time Limit and Creative. \n\nIn Timed mode, each turn has a ticking timer, so you better place your next cube before it runs out!\n\nIn Time Limit, each game has a fixed length, so you can take however long you want before placing each block. \nThis mode is all about planning your build, and figuring out a way to get those really high scores by scoring combos!\n\nAnd finally Creative mode - no time limits here! \nJust you, and your cubes. \nHope you have a good time together! ;)\n\nThe base game is completely free!", "short_description": "Boxtrix is a competitive puzzle game in your own living room!\nSit down and challenge your wits!\nGet your name on the leaderboard and show everyone that you are much smarter then them.\nOr just chill and play casually.\nTime to enjoy some cool cubes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Ln5VJfm5PCd2tC3hGoZvvDratRWwUN1-9SMwSQjU3qA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "KampaiRaptor", "support_website_url": "https://kampairaptor.com/", "website_url": "https://kampairaptor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ART_CREATIVITY", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "479004593977278"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75530714_854114635998153_4422057113776048670_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtJ_U8gYi2cQ7kNvwGnSmC9&_nc_oc=AdrLGMiZOtc7p4XTw2qUsY4PFL8B9yZ_fDprZ3LLYNv2IyJqzhhaYRMJ195pGtATdIM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3kZiIUTtUk3hVg1tVBq-L_t-6Aoo_j5PaSQKGQ6NgmA&oe=6B01D6FE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Boxtrix", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1669665600, "lastRevision": 
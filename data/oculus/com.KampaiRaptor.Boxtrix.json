39m51s984(5).png", "id": "391936686469152", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75340707_391936689802485_8513451465301685519_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9Fp56j_ZZ8Q7kNvwFx0vJV&_nc_oc=AdqRPBmJ9JbKK4NmU3kWXSTxJOQeAwbILUUwLNKVxSaqAHtcy88156NRsdY78-R6EpM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD3_xoLgOwvWZArTWGeizNl3XeCgAnt6UuyNw76FwURg&oe=6AFB3005"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Boxtrix Promo.png", "id": "1152993308936111", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974504_1152993315602777_9081280687449064609_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ln85eoDGe4Q7kNvwEgBZTf&_nc_oc=AdrAbfrGbtoqDgNwdTnDNmOfUGgYpZZNTaAqOPEN5r6Pml9KYQVCXm6t9S77ZS7EVTw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTocufJ-NOKJK0-lX5pMvBGcc_A05OpWT4_LNO2nIOqA&oe=6AFB48AE"}, "display_name": "Boxtrix", "keywords": [], "long_description": "Are you lonely? \nBored?\nDo you want something cutting edge, but also just chill and sit down in your living room? \nWe got the solution!\n\nBoxtrix is a competitive puzzle game in your own living room!\nSit down and challenge your wits!\nGet your name on the leaderboard and show everyone that you are much smarter then them.\nOr just chill and play casually.\nTime to enjoy some cool cubes!\n\nBoxtrix has three modes, Timed, Time Limit and Creative. \n\nIn Timed mode, each turn has a ticking timer, so you better place your next cube before it runs out!\n\nIn Time Limit, each game has a fixed length, so you can take however long you want before placing each block. \nThis mode is all about planning your build, and figuring out a way to get those really high scores by scoring combos!\n\nAnd finally Creative mode - no time limits here! \nJust you, and your cubes. \nHope you have a good time together! ;)\n\nThe base game is completely free!", "short_description": "Boxtrix is a competitive puzzle game in your own living room!\nSit down and challenge your wits!\nGet your name on the leaderboard and show everyone that you are much smarter then them.\nOr just chill and play casually.\nTime to enjoy some cool cubes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Ln5VJfm5PCd2tC3hGoZvvDratRWwUN1-9SMwSQjU3qA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "KampaiRaptor", "support_website_url": "https://kampairaptor.com/", "website_url": "https://kampairaptor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ART_CREATIVITY", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "479004593977278"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5789587097804781", "version": "1.0"}, "id": "677758513778431", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5450245638405597", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5789587097804781"}, "release_status": "R
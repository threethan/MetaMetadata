nt-sjc3-1.oculuscdn.com&oh=00_AfuZVyPF-R8v4AJXLI_eMGP5MCSJ1WjXb35WlfTmwabXgg&oe=6998516C"}, {"file_name": "vlcsnap-2022-10-17-20h39m51s984(2).png", "id": "421040649999052", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001671_421040653332385_8378246913739635789_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5iFoHpcQjQQ7kNvwGnVXwo&_nc_oc=Adm4OU495bdWpBvu-Yli9mJGjEDDeL_kF3FuDiX-IY607RN1NUzO9LA6ORLGoW5oQ4U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuNQnnW-zDy0-DD4Gtt-zrHXZdSuBMtHIhvxopivNTjRw&oe=69985792"}, {"file_name": "vlcsnap-2022-10-17-20h39m51s984(3).png", "id": "837544530712734", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575358_837544534046067_8812328900976624178_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4immgRuvJAQ7kNvwFxfXUJ&_nc_oc=AdlTLUvSurvH3XAQwr5YnAlE8S55H9KBB8PIhHdyYkLMFI7LZV6idfRdcg3JOF00Lw8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Aft_WOzU-viuXQcSbCh2MOIq8Mv3zLvGEGkvybm5tYJK8Q&oe=69985EE5"}, {"file_name": "vlcsnap-2022-10-17-20h39m51s984(5).png", "id": "391936686469152", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75340707_391936689802485_8513451465301685519_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-4MV5bU4jsQ7kNvwHs2h2j&_nc_oc=Adk8H03nK7asWTISi4J1vhYvl9P5Oxv9l9CGlnHhRzON8Bc5jZes1gp8Wkq4JXbV_QM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvZXUnghvczQfeWxjieQjBDo0bKEIFzCeloPrB_J7TVDA&oe=69985445"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Boxtrix Promo.png", "id": "1152993308936111", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974504_1152993315602777_9081280687449064609_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQJlzT-v74wQ7kNvwFi90qi&_nc_oc=AdktpsP87D0gvNgCWwHlOz12qvxvVd8y9o2R2GL38r9t-aEEsboXBnKBwNQp1c5kJt4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvkN0IDdHS-FSUNKfH_GSo4HBNTRXsGMD6d7YswPihZIA&oe=69986CEE"}, "display_name": "Boxtrix", "keywords": [], "long_description": "Are you lonely? \nBored?\nDo you want something cutting edge, but also just chill and sit down in your living room? \nWe got the solution!\n\nBoxtrix is a competitive puzzle game in your own living room!\nSit down and challenge your wits!\nGet your name on the leaderboard and show everyone that you are much smarter then them.\nOr just chill and play casually.\nTime to enjoy some cool cubes!\n\nBoxtrix has three modes, Timed, Time Limit and Creative. \n\nIn Timed mode, each turn has a ticking timer, so you better place your next cube before it runs out!\n\nIn Time Limit, each game has a fixed length, so you can take however long you want before placing each block. \nThis mode is all about planning your build, and figuring out a way to get those really high scores by scoring combos!\n\nAnd finally Creative mode - no time limits here! \nJust you, and your cubes. \nHope you have a good time together! ;)\n\nThe base game is completely free!", "short_description": "Boxtrix is a competitive puzzle game in your own living room!\nSit down and challenge your wits!\nGet your name on the leaderboard and show everyone that you are much smarter then them.\nOr just chill and play casually.\nTime to enjoy some cool cubes!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1Ln5VJfm5PCd2tC3hGoZvvDratRWwUN1-9SMwSQjU3qA/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "KampaiRaptor", "support_website_url": "https://kampairaptor.com/", "website_url": "https://kampairaptor.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ART_CREATIVITY", "ARCADE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_
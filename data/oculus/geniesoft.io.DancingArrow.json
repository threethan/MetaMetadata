oe=6AF746BE"}, {"file_name": "\uc2a4\uc0f74.png", "id": "387111202764218", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031467_387111206097551_6135204221268582504_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtBFJzpGR4UQ7kNvwFYUO_g&_nc_oc=AdpC2qHrMOYKmVCjhMtrXmquUmZkqfXF_NKYFIBGTeGX9oW0GIPsnFE2IlXDvj1iGWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAw_y0Faomk_Gq7RK1k75WI8uwnsuQSb_dqbpiUv2GoA&oe=6AF73609"}, {"file_name": "\uc2a4\uc0f72.png", "id": "567895897555019", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982486_567895900888352_7787595902512532766_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vr7QPIDK58EQ7kNvwG2ANDR&_nc_oc=AdrBO9NnWnWhKg0L2iTVD9k3_0yowz-uNc9-NOWbEpLKzG9y7rdgKz6H1jBrI6mnAHA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUoG4opCBQPeEDljm0CisxGhGzduDGKO9TD0ktVcSVCQ&oe=6AF733EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\uc81c\ubaa9-\uc5c6\uc74c-1.png", "id": "811892373005891", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036682_811892376339224_4096970328336759118_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgktFJ67874Q7kNvwEA0OEU&_nc_oc=AdoPB4bfvNyB97Qq_kfEGauk5yhBlvS1HwhDKU_MBwO6DvTc1DltseogJqeMweoR3dg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgXiotQRHmyjSkK6LIhUHM8OA2UUV4jX76vXlnu0VDEw&oe=6AF71C62"}, "display_name": "Dancing Arrow : K-pop Challenge", "keywords": ["Rhythm", "KPOP", "DANCE", "IDOL", "Esport"], "long_description": "DancingArrow is a VR rhythm action game that lets you dance to the electrifying beats of K-POP and enjoy the rhythm with your whole body!\nExperience the joy of dancing and realistic action that goes beyond just a rhythm game.\nWhen you dance, the beat is complete!\n\n\ud83d\udd25 Game features\n\ud83c\udfb5 1. A collection of K-POP's biggest hits!\nPlay popular songs by K-POP stars that have captivated the world!\n* Over 30 different tracks\n* New K-POP songs updated every 9 weeks!\n\n\ud83c\udff9 2. Perfect blend of rhythm and action!\nGet in the flow of the music as you accurately hit the flying arrows in time to the beat.\n* Colorful visual effects and the feeling of hitting\n* Performance effects that depend on your rhythm and timing\n\n\ud83d\udc83 3. VR performance that moves like you're dancing!\nBy applying key points of real-life choreography, your dance will come naturally as you play the game.\n* Fantastic collaboration between game and dance\n* After playing, you are already a star on stage!\n\n\ud83c\udfae 4. Intuitive gameplay for everyone to enjoy\n* Multiple difficulty levels to choose from: EASY, NORMAL, HARD\n* Simple and intuitive controls that even VR beginners can easily enjoy\n\n\ud83c\udf0d 5. Global leaderboards and endless challenges\n* Compete your score with users around the world\n* Become the best rhythm master and conquer the global rankings!", "short_description": "Dancing Arrow is a VR game that lets you enjoy music rhythm games with K-POP."}, {"images": {"nodes": []}, "id": "1789211578460540", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\ub304\uc2f1\uc5d0\ub85c\uc6b0 : K-pop Challenge", "keywords": ["\ub9ac\ub4ec", "\ub304\uc2a4", "\uc774\uc2a4\ud3ec\uce20", "\ucf00\uc774\ud31d", "\uc544\uc774\ub3cc"], "long_description": "\ub304\uc2f1\uc5d0\ub85c\uc6b0\ub294 K-POP\uc758 \uc9dc\ub9bf\ud55c \ube44\ud2b8\uc640 \ud568\uaed8 \ucda4\uc744 \ucd94\uace0, \uc628\ubab8\uc73c\ub85c \ub9ac\ub4ec\uc744 \uc990\uae30\ub294 VR \ub9ac\ub4ec \uc561\uc158 \uac8c\uc784\uc785\ub2c8\ub2e4!\n\ub2e8\uc21c\ud55c \ub9ac\ub4ec \uac8c\uc784\uc744 \ub118\uc5b4\uc120 \ub304\uc2f1\uc758 \uc990\uac70\uc6c0\uacfc \uc2e4\uac10 \ub098\ub294 \uc561\uc158\uc744 \uacbd\ud5d8\ud574\ubcf4\uc138\uc694.\n\ub2f9\uc2e0\uc774 \ucda4\uc744 \ucd9c \ub54c, \ube44\ud2b8\ub3c4 \ud568\uaed8 \uc644\uc131\ub429\ub2c8\ub2e4!\n\n\ud83d\udd25 \uac8c\uc784\uc758 \ub9e4\ub825 \ud3ec\uc778\ud2b8\n\ud83c\udfb5 1. K-POP \ucd5c\uace0\uc758 \ud788\ud2b8\uace1 \ucd1d\uc9d1\ud569!\n\uc138\uacc4\ub97c \uc0ac\ub85c\uc7a1\uc740 K-POP \uc2a4\ud0c0\ub4e4\uc758 \uc778\uae30 \uace1\uc744 \ub9ac\ub4ec\uc5d0 \ub9de\ucdb0 \ud50c\ub808\uc774\ud558\uc138\uc694!\n* 30\uc5ec\uace1\uc758 \ub2e4\uc591\ud55c \ud2b8\ub799 \uc218\ub85d\n* 9\uc8fc\ub9c8\ub2e4 \uc0c8\ub86d\uac8c \uc5c5\ub370\uc774\ud2b8 \ub418\ub294 K-POP!\n\n\ud83c\udff9 2. \ub9ac\ub4ec\uacfc \uc561\uc158\uc758 \uc644\ubcbd\ud55c \uc870\ud654!\n\ube44\ud2b8\uc5d0 \ub9de\ucdb0 \ub0a0\uc544\uc624\ub294 \ud654\uc0b4\uc744 \uc815\ud655\ud558\uac8c \ud0c0\uaca9\ud558\uba70 \uc74c\uc545\uc758 \ud750\ub984\uc5d0 \ubab8\uc744 \ub9e1\uae30\uc138\uc694.\n* \ud654\ub824\ud55c \ube44\uc8fc\uc5bc \uc774\ud399\ud2b8\uc640 \ud0c0\uaca9\uac10\n* \ub9ac\ub4ec\uacfc \ud0c0\uc774\ubc0d\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9c0\ub294 \ud37c\ud3ec\uba3c\uc2a4 \ud6a8\uacfc\n\n\ud83d\udc83 3. \ucda4\uc744 \ucd94\ub4ef \uc6c0\uc9c1\uc774\ub294 VR \ud37c\ud3ec\uba3c\uc2a4!\n\uc2e4\uc81c \uc548\ubb34\uc758 \ud575\uc2ec \ud3ec\uc778\ud2b8\ub97c \uc801\uc6a9\ud558\uc5ec, \uac8c\uc784\uc744 \ud558\uba74\uc11c \uc790\uc5f0\uc2a4\ub7fd\uac8c \ucda4\uc774 \uc644\uc131\ub429\ub2c8\ub2e4.\n* \uac8c\uc784\uacfc \ub304\uc2a4\uc758 \ud658\uc0c1\uc801\uc778 \ucf5c\ub77c\ubcf4\ub808\uc774\uc158\n* \ud50c\ub808\uc774 \ud6c4, \ub2f9\uc2e0\uc740 \uc774\ubbf8 \ubb34\ub300 \uc704 \uc8fc\uc778\uacf5!\n\n\ud83c\udfae 4. \ub204\uad6c\ub098 \uc990\uae38 \uc218 \uc788\ub294 \uc9c1\uad00\uc801\uc778 \uac8c\uc784\ud50c\ub808\uc774\n* EASY, NORMAL, HARD \ub2e4\uc591\ud55c \ub09c\uc774\ub3c4 \uc120\ud0dd\n* VR \uc785\ubb38\uc790\ub3c4 \uc27d\uac8c \uc990\uae38 \uc218 \uc788\ub294 \uac04\ub2e8\ud558\uace0 \uc9c1\uad00\uc801\uc778 \uc870\uc791\n\n\ud83c\udf0d 5. \uae00\ub85c\ubc8c \ub9ac\ub354\ubcf4\ub4dc\uc640 \ub05d\uc5c6\ub294 \ub3c4\uc804\n* \uc804 \uc138\uacc4 \uc720\uc800\ub4e4\uacfc \uc2a4\ucf54\uc5b4 \uacbd\uc7c1\n* \ucd5c\uace0\uc758 \ub9ac\ub4ec \ub9c8\uc2a4\ud130\uac00 \ub418\uc5b4 \uae00\ub85c\ubc8c \ub7ad\ud0b9\uc744 \uc815\ubcf5\ud558\uc138\uc694!", "short_description": "\ub304\uc2f1 \uc5d0\ub85c\uc6b0\ub294 \uc74c\uc545 \ub9ac\ub4ec\uac8c\uc784\uc744 K-POP\uc73c\ub85c \uc990\uae38 \uc218 \uc788\ub294 VR \uac8c\uc784\uc785\ub2c8\ub2e4.\n\ub0a0\uc544\uc624\ub294 \ud654\uc0b4\ud45c\ub97c \uceec\ub7ec\uc5d0 \ub9de\uac8c \ud0c0\uaca9\ud558\uc5ec \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc73c\uba70, \ucda4 \ub3d9\uc791\uc744 \ud45c\ud604\ud558\uc5ec \uac8c\uc784\uc744 \uc990\uae38 \uc218 \uc788\uc5b4 \ub354\uc6b1 \uc7ac\ubbf8\uc788\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.geniesoft.io/privacy", "developer_terms_of_service_url": "https://www.geniesoft.io/terms", "publisher_name": "Geniesoft Inc", "support_website_url": null, "website_url": "https://www.geniesoft.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC", "ACTION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25708162995487882"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035412_1914317275646812_1350569248386285776_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUqitpCBVpAQ7kNvwHlya3D&_nc_oc=Adpu-FghQaaOMm1zZGqhjM0L0-kXYZF2ru01lPK384fWWJ8VKJ1r0GvwqT88hoZHL5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oc
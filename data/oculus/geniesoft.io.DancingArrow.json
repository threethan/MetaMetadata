D\n      - \ub2e4\uc591\ud55c \uc0ac\uc6b4\ub4dc \ud2b8\ub799 \uc81c\uacf5\n\n \u25a0  \uc2e4\uc81c \ucda4 \ub3d9\uc791 \uc548\ubb34\ub97c \uac8c\uc784\uc5d0 \uc801\uc6a9\n      - \ud0a4 \ud3ec\uc778\ud2b8\uac00 \ub418\ub294 \uc548\ubb34 \uc801\uc6a9\n\n \u25a0  \uc26c\uc6b4 UI \uad6c\uc131\uacfc \uc9c1\uad00\uc801\uc778 \ud45c\ud604\n      - \ud55c\ub208\uc5d0 \uc54c\uc544\ubcf4\uae30 \uc26c\uc6b4 \ud3b8\uc548\ud55c \ub514\uc790\uc778\n\n \u25a0  \ub9e4\uc6d4 5\uace1 \uc774\uc0c1 \uc0c8\ub85c\uc6b4 \uc74c\uc545 \uc5c5\ub370\uc774\ud2b8 \uc81c\uacf5\n      - \uc0c8\ub85c\uc6b4 \uc74c\uc545\uc744 \uc6d0\ud558\uc138\uc694? \ucee4\ubba4\ub2c8\ud2f0\ub97c \ud1b5\ud574 \uc2e0\uccad\ud574\ubcf4\uc138\uc694! \n\n \u25a0  \uae00\ub85c\ubc8c \ub9ac\ub354\ubcf4\ub4dc\n      - \uae00\ub85c\ubc8c \ub7ad\ud0b9\uc5d0 \ub3c4\uc804\ud558\uc138\uc694!", "short_description": "\ub304\uc2f1 \uc5d0\ub85c\uc6b0\ub294 \uc74c\uc545 \ub9ac\ub4ec\uac8c\uc784\uc744 K-POP\uc73c\ub85c \uc990\uae38 \uc218 \uc788\ub294 VR \uac8c\uc784\uc785\ub2c8\ub2e4.\n\ub0a0\uc544\uc624\ub294 \ud654\uc0b4\ud45c\ub97c \uceec\ub7ec\uc5d0 \ub9de\uac8c \ud0c0\uaca9\ud558\uc5ec \uc810\uc218\ub97c \uc5bb\uc744 \uc218 \uc788\uc73c\uba70, \ucda4 \ub3d9\uc791\uc744 \ud45c\ud604\ud558\uc5ec \uac8c\uc784\uc744 \uc990\uae38 \uc218 \uc788\uc5b4 \ub354\uc6b1 \uc7ac\ubbf8\uc788\uac8c \uc990\uae38 \uc218 \uc788\uc2b5\ub2c8\ub2e4."}]}, "developer_name": null, "developer_privacy_policy_url": "https://geniesoft.io/pages/portfolio/dancing_arrow/privacy_policy.php", "developer_terms_of_service_url": "https://geniesoft.io/pages/portfolio/dancing_arrow/terms_of_use.php", "publisher_name": "Geniesoft Inc", "support_website_url": null, "website_url": "https://www.geniesoft.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["MUSIC
_sid=6e7a0a&_nc_ohc=ejqNGdZyQTgQ7kNvwHYs92y&_nc_oc=AdqAaTRB-X3UMrhTOgO1figGwfrJCvvkewRV1KMzCrVsmmPVg7qG6Bdl6WryencFhRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPER-z9h0iGh7dDo0YBjYoYURe07fDypRglk6UZfowhg&oe=6AE7544D"}, {"file_name": "HighresScreenshot00000 1.png", "id": "2746155995741781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619704_2746155999075114_1759526867854965619_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XILFh9WpTeEQ7kNvwEaGpoj&_nc_oc=AdqIB4VTUcAfPNLAKWQ9CKuagfBI_3B3y2Alp1sI0e4y9tzNJXHRvwc4VyY8Awqg6sc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpi1sFHTMxYCTeRVgbCYK--RmxHSwvD6kLYc5FDceRrw&oe=6AE73A66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Nursing Assistant", "keywords": ["Nursing", "assistant", "immerselearn", "vr"], "long_description": "Certified Nursing Assistant is an immersive virtual reality training application developed to enhance hands-on clinical skills through realistic healthcare simulations. Learners engage in interactive patient care scenarios designed to build confidence, improve decision-making, and reinforce essential nursing assistant competencies in a safe, controlled environment.\n\nThis application is part of the Immerse Learn Nursing Assistant Certification Program. Access is strictly limited to students officially enrolled in the certification program. The app is intended solely for educational and hands-on training purposes as part of the structured curriculum.\n\nThrough guided simulations and skill-based practice modules, students gain practical experience aligned with real-world healthcare standards, helping bridge the gap between classroom learning and clinical performance.", "short_description": "Certified Nursing Assistant is an immersive VR training application designed for hands-on clinical skill development. This app is part of the Immerse Learn Nursing Assistant Certification Program and is exclusiv
-25/491820001_4396683627266067_2158780035514390865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyTfo3LF2QEQ7kNvwG_skP8&_nc_oc=AdrjmghfjPqVC-kzJRzdASYpVYi0Lxe-mgtaitWX2BcnQythJ1d4f81ljxqS6AqZ6HM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WTw3g9V7rm2Sju3eLVTP8NC1hD7sRjuAJbEx-1DNYDQ&oe=6A0335D9"}, {"file_name": "com.medvr.NursingAssistant-20260227-193754.png", "id": "1245901614337915", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618288_1245901617671248_7194128733168171291_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LGhxMGtgYpQQ7kNvwHJOyjf&_nc_oc=Ado4d893hhib1U6cx-fG2UbtVi1Q02RLfLtq0VZ3gSW5fhu4mbVY6PXShOWdYiopjK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fYsEB-CsR3Y078SXaKDHk2iWBcWZKhT7SigNXNE3_ng&oe=6A031CE0"}, {"file_name": "com.medvr.NursingAssistant-20260227-193936.png", "id": "1890217671663133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618293_1890217674996466_1732082378522575694_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydgib9h9vrEQ7kNvwE9CePp&_nc_oc=AdrHE22Z2MK449mHO5tIeEqRVKdzsxdH7mE_Gqd4H1LInf4HiJuu_6R1VfQv8QfQH34&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tnOMpGVYBeBiHJiXN--NMt4rl-wBmKa5EaUHkjtd85A&oe=6A032CA4"}, {"file_name": "com.medvr.NursingAssistant-20260227-194023.png", "id": "2061210521122545", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617831_2061210524455878_1083814505354315283_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WC_iuIgXCdQQ7kNvwEAAs_B&_nc_oc=Adqopp3s8tAKPL8GYKK-98ciRVcdxzcpYbIxN0HfCUIqZYs8jVMS837Xuu5fj8au8G8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w1TT-7Ki3Dd5P2wyoApyHoMhCLxkGfOGoRQpqNOHrcg&oe=6A0340CD"}, {"file_name": "HighresScreenshot00000 1.png", "id": "2746155995741781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619704_2746155999075114_1759526867854965619_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wyOiJWytKxMQ7kNvwFxlE-E&_nc_oc=Adrwx1ecA3ygU6LdfphrTc1Ek3QHW2xlA4yntvFwzjKHDkhsw7UGL7VsBXKy86uMQWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fbN8xVlaPcFBKNOZm1UJ1IBCyZEveZ8Pywiqq4hTojQ&oe=6A0326E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Nursing Assistant", "keywords": ["Nursing", "assistant", "immerselearn", "vr"], "long_description": "Certified Nursing Assistant is an immersive virtual reality training application developed to enhance hands-on clinical skills through realistic healthcare simulations. Learners engage in interactive patient care scenarios designed to build confidence, improve decision-making, and reinforce essential nursing assistant competencies in a safe, controlled environment.\n\nThis application is part of the Immerse Learn Nursing Assistant Certification Program. Access is strictly limited to students officially enrolled in the certification program. The app is intended solely for educational and hands-on training purposes as part of the structured curriculum.\n\nThrough guided simulations and skill-based practice modules, students gain practical experience aligned with real-world healthcare standards, helping bridge the gap between classroom learning and clinical performance.", "short_description": "Certified Nursing Assistant is an immersive VR training application designed for hands-on clinical skill development. This app is part of the Immerse Learn Nursing Assistant Certification Program and is exclusively accessible to students enrolled in the program for practical training purposes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topi
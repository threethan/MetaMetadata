90217671663133", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618293_1890217674996466_1732082378522575694_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oukuPEIFWjkQ7kNvwGQnKNl&_nc_oc=AdpNTNH2Iu4Od9IyiPzyaVG1qXnhUddl_TghCciySsh7yK-zdN07Fcmn3ntyJTqU4QU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JFTg-SU_4N-AjMfUvCbJKvDgM8Juq12Ttv3OGdk8NWQ&oe=6A2D5CA4"}, {"file_name": "com.medvr.NursingAssistant-20260227-194023.png", "id": "2061210521122545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_2061210524455878_1083814505354315283_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku8ol21dN0AQ7kNvwGdz0J6&_nc_oc=Adq29aoE438q4a-sLl21tGa_XeplzMGR12rDFrZgRJn1dTGzxYjbWGX2JzMP1VF2cIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vw0UF3zLKoFtOPKAHT2FJdmqB0F6FncaDnwgAl-8Nig&oe=6A2D70CD"}, {"file_name": "HighresScreenshot00000 1.png", "id": "2746155995741781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619704_2746155999075114_1759526867854965619_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o51UDQCROfgQ7kNvwE7pE8p&_nc_oc=AdrMzEs4D4roDREfO3oyJZ3F_DB22Pqc0Tx1vlSdhTS9Uk6obWeTZOiPMLGXQAbt2Ek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Tif3gbk6pd4_Dag5gpvGnLpqBTJFer9KQK2C3vg3dkg&oe=6A2D56E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Nursing Assistant", "keywords": ["Nursing", "assistant", "immerselearn", "vr"], "long_description": "Certified Nursing Assistant is an immersive virtual reality training application developed to enhance hands-on clinical skills through realistic healthcare simulations. Learners engage in interactive patient care scenarios designed to build confidence, improve decision-making, and reinforce essential nursing assistant competencies in a safe, controlled environment.\n\nThis application is part of the Immerse Learn Nursing Assistant Certification Program. Access is strictly limited to st
-25/491820001_4396683627266067_2158780035514390865_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0Q8XwGjgdsQ7kNvwGDD6-B&_nc_oc=AdrAxD82D9efdern0DQA2udgG7YPGZ024U-h6fb-FYwBOeEC5nanqSyX-_RKt98_tic&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Bj4ixuqrCd5QG985q_f2Pz-AlyXJ5IMVAzl5BtfpgHQ&oe=6A072A59"}, {"file_name": "com.medvr.NursingAssistant-20260227-193754.png", "id": "1245901614337915", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618288_1245901617671248_7194128733168171291_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xkptey0P73sQ7kNvwFuMYjp&_nc_oc=AdoQDAz5aiXaGLKwn7fXNF6nJ73wFspwKv_nhCyp8-IVLf37FemHYWl3hywTXVyc2uk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60xbGvb2lCOPB-_3Hl46k55nT-9qDlYpRG8pfmaRlMcQ&oe=6A071160"}, {"file_name": "com.medvr.NursingAssistant-20260227-193936.png", "id": "1890217671663133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618293_1890217674996466_1732082378522575694_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x3qVbF5NJPEQ7kNvwFX2qpc&_nc_oc=AdrRfBw3vAkld2IqZOWL8dLR05_aizGVnzuny-elzQYEweCGicddrTOXY25FGKa0mv4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vteOcvpkwQuUG73JiCz7u8FearJhbyF7jcW3kc9XgfA&oe=6A072124"}, {"file_name": "com.medvr.NursingAssistant-20260227-194023.png", "id": "2061210521122545", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617831_2061210524455878_1083814505354315283_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uocmcqwk_k4Q7kNvwFJMUCh&_nc_oc=AdofSaq8Stmy1R5HQvSvzfadfkQ9APeJqDuSW68pkUlPzQbS2sbeoo3XBR-AoTNU7-0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67sRoHbXQR7C7QM2pz1Ez1E2GG_qZ4y3j5CV-NGA4wjA&oe=6A07354D"}, {"file_name": "HighresScreenshot00000 1.png", "id": "2746155995741781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619704_2746155999075114_1759526867854965619_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItgEEs94kkYQ7kNvwFGIf5x&_nc_oc=AdodF7NdGGK2EI5_QgolyXVAqSAjqWqzgTXZqPWMmU3kVFM0vH_3udqMkfbvaLz1R1U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4a41v-og9F7OvUMNw0MDLu-c6g6qU3au4EU3eEMussyw&oe=6A071B66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Nursing Assistant", "keywords": ["Nursing", "assistant", "immerselearn", "vr"], "long_description": "Certified Nursing Assistant is an immersive virtual reality training application developed to enhance hands-on clinical skills through realistic healthcare simulations. Learners engage in interactive patient care scenarios designed to build confidence, improve decision-making, and reinforce essential nursing assistant competencies in a safe, controlled environment.\n\nThis application is part of the Immerse Learn Nursing Assistant Certification Program. Access is strictly limited to students officially enrolled in the certification program. The app is intended solely for educational and hands-on training purposes as part of the structured curriculum.\n\nThrough guided simulations and skill-based practice modules, students gain practical experience aligned with real-world healthcare standards, helping bridge the gap between classroom learning and clinical performance.", "short_description": "Certified Nursing Assistant is an immersive VR training application designed for hands-on clinical skill development. This app is part of the Immerse Learn Nursing Assistant Certification Program and is exclusively accessible to students enrolled in the program for practical training purposes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topi
_sid=6e7a0a&_nc_ohc=wmEKm3-aB6QQ7kNvwE58XaI&_nc_oc=Adp689FY-hn7Z03pJ0Hg_matBrNB06iHglr2L0JQr2xEnj3_u60YTJ85i9MhC6IbxXs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5TGm7q6H3nQZ2CvrJdXgP3f3CGNTntC5TPdVGBzp5uQ&oe=6AE20E4D"}, {"file_name": "HighresScreenshot00000 1.png", "id": "2746155995741781", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619704_2746155999075114_1759526867854965619_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGIFDzI9hd0Q7kNvwEdPTzF&_nc_oc=Adq2r_S6tySoxJI3Lk6cj2NZkuLN34Tbl03aJZRDHu20LjBzqqtDDqPeAyLwNUfMlng&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJLi_PImF_bAkfB3LoLqC86IwOXOzOCGJV3mV7xO59QA&oe=6AE1F466"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Nursing Assistant", "keywords": ["Nursing", "assistant", "immerselearn", "vr"], "long_description": "Certified Nursing Assistant is an immersive virtual reality training application developed to enhance hands-on clinical skills through realistic healthcare simulations. Learners engage in interactive patient care scenarios designed to build confidence, improve decision-making, and reinforce essential nursing assistant competencies in a safe, controlled environment.\n\nThis application is part of the Immerse Learn Nursing Assistant Certification Program. Access is strictly limited to students officially enrolled in the certification program. The app is intended solely for educational and hands-on training purposes as part of the structured curriculum.\n\nThrough guided simulations and skill-based practice modules, students gain practical experience aligned with real-world healthcare standards, helping bridge the gap between classroom learning and clinical performance.", "short_description": "Certified Nursing Assistant is an immersive VR training application designed for hands-on clinical skill development. This app is part of the Immerse Learn Nursing Assistant Certification Program and is exclusiv
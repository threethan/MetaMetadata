90217671663133", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618293_1890217674996466_1732082378522575694_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DfE2BDAxjwQ7kNvwELbvOu&_nc_oc=Adpxwl3k5EMACEPgwvgnA6JB5vQSszxbuSd1F8j7737zUgvWfQSak_ztySfk77NFNqY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FGvscJAAGABTaMx0te59evvnjMFcNIe_9K3wQosW5Qg&oe=6A315124"}, {"file_name": "com.medvr.NursingAssistant-20260227-194023.png", "id": "2061210521122545", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_2061210524455878_1083814505354315283_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnAmgjPRgIYQ7kNvwEnhyCZ&_nc_oc=AdpDaQNGinffboQ4ocevWTrMl2GBldoG8OxiP5dRcJdyhZ8cSrOk1-Laz1mqN5kUZIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tbvU-HhB5hhys0dp3tBh46pjw0PXRNS3CypY8wXNVoA&oe=6A31654D"}, {"file_name": "HighresScreenshot00000 1.png", "id": "2746155995741781", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619704_2746155999075114_1759526867854965619_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v-NMvg2UTQEQ7kNvwFBnOCf&_nc_oc=AdqgxWcC0Pnd12qj6W8xALzA0PcwdIZwYGf9JdDoPX2A4k1_scHHGaUPU8cmZN8Lkqs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TGpyIskaxZKWKc7GG_M4moqOhJ0YliTUyfMO6kHYX-A&oe=6A314B66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Nursing Assistant", "keywords": ["Nursing", "assistant", "immerselearn", "vr"], "long_description": "Certified Nursing Assistant is an immersive virtual reality training application developed to enhance hands-on clinical skills through realistic healthcare simulations. Learners engage in interactive patient care scenarios designed to build confidence, improve decision-making, and reinforce essential nursing assistant competencies in a safe, controlled environment.\n\nThis application is part of the Immerse Learn Nursing Assistant Certification Program. Access is strictly limited to st
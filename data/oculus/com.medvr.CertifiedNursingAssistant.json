7-193936.png", "id": "1890217671663133", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618293_1890217674996466_1732082378522575694_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xveYTSAoq9sQ7kNvwH5qKOq&_nc_oc=AdpcRTaRt-jCH8961GVY9f-lPkAQlfDkySdQnaNl8ye3-N6t4uzBgb27LJYotsBolAc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44HUieyaQLZmhLh4hB9sdcmiu5Q0g848BFfgDICYKbow&oe=6A1844A4"}, {"file_name": "com.medvr.NursingAssistant-20260227-194023.png", "id": "2061210521122545", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617831_2061210524455878_1083814505354315283_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=irf2t1-TeYUQ7kNvwHFJFh9&_nc_oc=AdrDdr_B7jDgxmqDqezwK9mMCS1z-5B7L1B0el-LBKQh85ZejYcI2Pp0ltX4eTLJPE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K-ypzFacJ30fjee-_En2gnhFAbSJCGHG72XiP_5zL6A&oe=6A1858CD"}, {"file_name": "HighresScreenshot00000 1.png", "id": "2746155995741781", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619704_2746155999075114_1759526867854965619_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6Panmi24_QQ7kNvwG87eLp&_nc_oc=AdqB2XilkaY5DbfskCu40TcX0Pj5_mGHO1KkrhUbanybydUhHSYkfiHDBI3lw6IBdzw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ippJ96xzj1qVW2qjr8lYT8J4yZ6nakBF8e4FWcxNDAA&oe=6A183EE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Nursing Assistant", "keywords": ["Nursing", "assistant", "immerselearn", "vr"], "long_description": "Certified Nursing Assistant is an immersive virtual reality training application developed to enhance hands-on clinical skills through realistic healthcare simulations. Learners engage in interactive patient care scenarios designed to build confidence, improve decision-making, and reinforce essential nursing assistant competencies in a safe, controlled environment.\n\nThis application is part of the Immerse Learn Nursing Assistant Certification Program. Access is strictly limited to students officially enrolled in the certification program. The app is intended solely for educational and hands-on training purposes as part of the structured curriculum.\n\nThrough guided simulations and skill-based practice modules, students gain practical experience aligned with real-world healthcare standards, helping bridge the gap between classroom learning and clinical performance.", "short_description": "Certified Nursing Assistant is an immersive VR training application designed for hands-on clinical skill development. This app is part of the Immerse Learn Nursing Assistant Certification Program and is exclusively accessible to students enrolled in the program for practical training purposes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34309058015376318"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2075387729972752"}]}, "baseline_offer": {"id": "2075387729972752"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773312120, "status": "PUBLISHED", "id": "2075387729972752"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typena
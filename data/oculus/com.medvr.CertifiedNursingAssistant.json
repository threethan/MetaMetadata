3133", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618293_1890217674996466_1732082378522575694_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qaeNB5EvD_kQ7kNvwE5N64r&_nc_oc=AdqFbiRBRp5Yp3YkuWamoVZV_s8Wa1qjY9CTp3Epdhtial74MXw1GjYaNfN_QDGPyCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N_y0vyLzR1Y84AMXbXUylncYz5fXD-NA-M9csnOA2AQ&oe=69D50824"}, {"file_name": "com.medvr.NursingAssistant-20260227-194023.png", "id": "2061210521122545", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617831_2061210524455878_1083814505354315283_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLDEbff-_OgQ7kNvwHbsejq&_nc_oc=AdqunOvXULWb7-cZbiiW3EZJJTAQvtCDu5FXkW3anoBOoWwPS1GAmcTp6YZ7rZyO9W8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3j4ekBX9EHf31fwMuJ2m-SAzfyV51FYyG0eonr1Y8pLQ&oe=69D4E40D"}, {"file_name": "HighresScreenshot00000 1.png", "id": "2746155995741781", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619704_2746155999075114_1759526867854965619_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5uLdU1b3RDYQ7kNvwGiMFHI&_nc_oc=AdrqHFS9yb6iZQr9aTzLzOqF81t43oVmbrsV_ES82eJZ4oVWgk_JukfitB06dnIwkP4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-nbA4HYWkwdN2X1QQzajBVeVQ3tm4q0Lh-gbd3ZlTNw&oe=69D50266"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Nursing Assistant", "keywords": ["Nursing", "assistant", "immerselearn", "vr"], "long_description": "Certified Nursing Assistant is an immersive virtual reality training application developed to enhance hands-on clinical skills through realistic healthcare simulations. Learners engage in interactive patient care scenarios designed to build confidence, improve decision-making, and reinforce essential nursing assistant competencies in a safe, controlled environment.\n\nThis application is part of the Immerse Learn Nursing Assistant Certification Program. Access is strictly limited to students officially enrolled in the certification program. The app is intended solely for educational and hands-on training purposes as part of the structured curriculum.\n\nThrough guided simulations and skill-based practice modules, students gain practical experience aligned with real-world healthcare standards, helping bridge the gap between classroom learning and clinical performance.", "short_description": "Certified Nursing Assistant is an immersive VR training application designed for hands-on clinical skill development. This app is part of the Immerse Learn Nursing Assistant Certification Program and is exclusively accessible to students enrolled in the program for practical training purposes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34309058015376318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619465_1259012056178124_2996354194744746744_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d1JCl-IzQMQ7kNvwGNwiWQ&_nc_oc=AdobzU05yNWwZwih1JajNwnXp9mTzIXSDT3-_EYzDy4ClPMP9gl9p1V6_hEWJnJsKNk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.c
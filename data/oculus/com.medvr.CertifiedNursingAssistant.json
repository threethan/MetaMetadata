lH0J5Nk7mxbL9iq-JUKNw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vFI5eRrPARQG7W-5f_uQXr2nJVBydPKFl4j7I0sz72Q&oe=6A2573A4"}, {"file_name": "com.medvr.NursingAssistant-20260227-194023.png", "id": "2061210521122545", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617831_2061210524455878_1083814505354315283_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QIOt650g464Q7kNvwFm7nDY&_nc_oc=Adq0HQ-gVCQaJM2QcxsA0uDhGfYe3AYMSuiAdHyx1GNOeY9iwPKqra-e1nzwSY1YAQk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PBSUm0fiEiSN-LrqOx6JQ5UDQNzX2IlLcMkrAPearbw&oe=6A2587CD"}, {"file_name": "HighresScreenshot00000 1.png", "id": "2746155995741781", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619704_2746155999075114_1759526867854965619_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sja4rrJNs34Q7kNvwFO2wmp&_nc_oc=Adp08f-kxVmtz3bQsmttcJYlCmSvavwFCd1wBbjW7rcs3PnsRM6zgVSlGtgRW8uxWG4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tobuHTKel0kxAR0SDCTSBFI7rBHPUKdsoDsNkxgOcpg&oe=6A256DE6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Certified Nursing Assistant", "keywords": ["Nursing", "assistant", "immerselearn", "vr"], "long_description": "Certified Nursing Assistant is an immersive virtual reality training application developed to enhance hands-on clinical skills through realistic healthcare simulations. Learners engage in interactive patient care scenarios designed to build confidence, improve decision-making, and reinforce essential nursing assistant competencies in a safe, controlled environment.\n\nThis application is part of the Immerse Learn Nursing Assistant Certification Program. Access is strictly limited to students officially enrolled in the certification program. The app is intended solely for educational and hands-on training purposes as part of the structured curriculum.\n\nThrough guided simulations and skill-based practice modules, students gain practical experience aligned with real-world healthcare standards, helping bridge the gap between classroom learning and clinical performance.", "short_description": "Certified Nursing Assistant is an immersive VR training application designed for hands-on clinical skill development. This app is part of the Immerse Learn Nursing Assistant Certification Program and is exclusively accessible to students enrolled in the program for practical training purposes."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34309058015376318"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619465_1259012056178124_2996354194744746744_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LIVHG2MArkUQ7kNvwG--9D6&_nc_oc=Adplvq-7eZduP84kCQEPBbwJKOLbG-Ca8dsQotfH8tzvvQP17abHg20Y79oixPwwmMk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yv-ITIWj9AEMRtpe6Kc-Qvu_btWZGIRWcm7fer3jfSw&oe=6A258A5D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Certified Nursing Assistant", "platform": "ANDROID_6DOF", "context_ca
jc6-1.oculuscdn.com/v/t64.5771-25/499625099_988342887279083_66120480364012564_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIaBq20PH6AQ7kNvwHWFx7T&_nc_oc=Adq3JOkDxAW6L8-M22mMH5DjAS4cQ8mD1HK4uSwoeXiTbjyD6Ej496nLw4kabpoj9L8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFFZD-Oh7wE5MQHTAOSgaauIbHLqDo-K-fR_M0w8m7MQ&oe=6A6CB953"}, {"file_name": "1 (1).png", "id": "766305689837695", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620856_766305693171028_3870059368073511367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x24BiJoFRq4Q7kNvwEmfTWo&_nc_oc=AdqcqLHXdMx5ndX6iBMGG4AZ_YU47SsnTmJckq0wO37aHOOm0NmVTJbyF1Bo0xMKgwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiqBAXa8JwKo6HHmOZq4YQ_edI4tn9kje28Jeq8EdBHg&oe=6A6C8F2F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Portada WCT.png", "id": "1450490246835382", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620856_1450490250168715_3338833510793708824_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vjt5sP1IF-kQ7kNvwF1GXrN&_nc_oc=AdqRLp-3LgbUpJ9mHecSy60-Yxa2POagEE3hnak4E3cHzxlq2FdEeDhWfoHpmndHQpg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVK1mqMjOXwPMHhLL9yfjykShQj3_5GoVOS9swiZY7dw&oe=6A6C9CC0"}, "display_name": "WORLD CUP TRIVIA", "keywords": [], "long_description": "Welcome to the ultimate casual football experience in Virtual Reality. Step onto our stylized low-poly stadium and immerse yourself in the beautiful game like never before.\n\nKey Features:\n\nInteractive Exploration: Wander freely through our digital stadium environment, designed for full immersion.\n\nMeta Avatars Integration: Fully embrace the social experience by using your personalized Meta Avatars to interact within the virtual space.\n\nFlexible Movement: Choose your preferred playstyle; whether you prefer to sit or stand, our system supports both, featuring smooth teleportation movement for effortless navigation.\n\nGoal-Scoring Challenge: Put your reflexes to the test in our casual mini-game where you can grab balls and aim for the goal.\n\nDynamic Trivia: Stay engaged with our webview-integrated trivia system, ensuring fresh content and challenges every time you play.\n\nDesigned for accessibility and fun, this application offers a perfect blend of exploration, casual gaming, and interactive content. Join the match today and experience football in a whole new dimension.", "short_description": "Step into a low-poly virtual reality stadium and experience the ultimate football atmosphere. Explore the pitch, test your skills in a casual goal-scoring mini-game, and challenge yourself with dynamic trivia content delivered directly through our webview integration. Whether you're here to play or to test your knowledge, it's the perfect casual football experience for VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalexperience.cl/triviamundial2026/politicasdeprivacidad/Politicas_De_Privacidad_WORLD_CUP_TRIVIA.pdf", "developer_terms_of_service_url": null, "publisher_name": "DE SpA", "support_website_url": "https://digitalexperience.cl/", "website_url": "https://digitalexperience.cl/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": [], "id": "1547328406760842"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/
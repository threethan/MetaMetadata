?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPYJg7nWbccQ7kNvwGrckut&_nc_oc=AdrQGTLNZwJdj2aSq2d6E4AQhtaxm2JIXPjjlHQgZJC_RWnO4pQniPdmlSw_aSNGVp0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SeZAlrS8Yb8GPHXrikKaH5ahDKimAqIFjSvbOWdB6bA&oe=69FA12C5"}, {"file_name": "\u5c04\u51fb\u622a\u56fe_\u526f\u672c.png", "id": "4366259500275940", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830003_4366259506942606_8941422019369579407_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3hooxkqg74Q7kNvwHiJ3DS&_nc_oc=Adq7aT0rkYzYNI3WFV8FUBmkAQXHpoMMnUYIZrHjmA11qjHSQtQoBYvIEi2QJD0JGyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z9TrCRGwAUmsM2MLFaBtYYLAZiD2-yuN5eEmjpU_mUA&oe=69F9ED39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "25601440.png", "id": "2344339739374302", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499299876_2344339742707635_5353843978093137728_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPDlL3ZeeZQQ7kNvwFdzRW5&_nc_oc=AdqLvay0BaYQLiga-c22mD2ONMO_8wCPYp3TNXa384hdn-BEnSukDPmK6qoEyNs_Nrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yxBTISGc8hLZodHcdpALH4nOz3HWqsA5JznAaFDom8g&oe=69F9F456"}, "display_name": "I Am Panda", "keywords": ["Panda", "iam", "simulator", "animal", "sandbox"], "long_description": "**What happens when you stop acting human \u2014 and start acting like a panda?**\n\nIn I Am Panda, your instincts shape everything.\nEat, break, tease, or cause chaos \u2014 NPCs remember, react, and sometimes fight back.\n\n\ud83c\udf8b **Eat Like a Panda \u2014 Be Loved**\n\nEat bamboo piece by piece.\nPick up food with your mouth.\nEnjoy the simple joy of eating.\nNPCs notice what you eat.\nKind behavior can make them like you more \u2014\nsometimes enough that they can\u2019t stop watching.\n{1096871039177275}\n\n\n\ud83d\ude08 **Cause Trouble \u2014 Face the Consequences**\n\nGrab, smash, stab, shock, or drag. Turn simple actions into full chaos.\nMake a mess like a real panda would.\n{748464168310814}\nBreak the wrong things, and NPCs will get angry, chase you down, and try to stop you.\nA certain clown might even step in to deal with your chaos.\n{1447432027055957}\n\ud83d\udc3e **Live Inside a Panda Body**\nWalk using your panda arms.\nClimb, push, and move with your own weight.Feel clumsy, heavy, and alive.\n{25805219409074552}\n", "short_description": "Eat to enjoy life. Smash to cause chaos.\nIn I Am Panda, your instincts shape how the world reacts to you.\nA growing VR panda life simulator where every action matters,\nwith monthly updates adding new ways to live like a panda."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.cosmicflow.club/", "developer_terms_of_service_url": null, "publisher_name": "CosmicFlow", "support_website_url": null, "website_url": "https://www.cosmicflow.club/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24225857420444753"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618069_855013254217192_1907995912898231194_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcNP_B6exbMQ7kNvwHQkZeF&_nc_oc=AdrzF76GzQtz5ExguPjYdiZleVQ9T-oGUAgT159xql
mgAoQ7kNvwGqTTn-&_nc_oc=AdmPUSNCMrXOXf7CBAY1-O3bbzqDOGpCSeUB6rhFfCl_T2fqEYCSuDKJJXg5HSVMxwk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzjPuO-_euh3xEdR_aCX_M0FBvOHpsZBrJmIrQov7Z5w&oe=69B015D8"}, {"file_name": "screenshot1.png", "id": "879961051402096", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_879961058068762_3663360351782784449_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7wDf3_jdpnMQ7kNvwFIF4c9&_nc_oc=AdmsvgfKWy2EI38fJy8ma9YUoVsiadeJkLgx8UI2LUH2lAyCuFsq2ofOOOwMB9Z5luA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNrjgHtVFDLRs8u5YL3NwPMtDILrw1OgNmzar-hWk2ag&oe=69B00685"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440_\u526f\u672c.png", "id": "2114949025987477", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619174_2114949029320810_123381322373459709_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bTWCFnR2VYQ7kNvwHLWrwV&_nc_oc=AdkLK6QdmHARX9meIccLTNy5vYEu5t9KbUWITNVLKreth6NraqDLWqKLuc8rubdaE30&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxpVPhHKNVttosWM1_txF7n0tVFVzY8WO6BtxRRpRQD0g&oe=69B0285E"}, "display_name": "I Am Panda", "keywords": ["Panda", "iam", "simulator", "animal", "sandbox"], "long_description": "**What happens when you stop acting human \u2014 and start acting like a panda?**\n\nIn I Am Panda, your instincts shape everything.\nEat, break, tease, or cause chaos \u2014 NPCs remember, react, and sometimes fight back.\n\n\ud83c\udf8b **Eat Like a Panda \u2014 Be Loved**\n\nEat bamboo piece by piece.\nPick up food with your mouth.\nEnjoy the simple joy of eating.\nNPCs notice what you eat.\nKind behavior can make them like you more \u2014\nsometimes enough that they can\u2019t stop watching.\n{1096871039177275}\n\n\n\ud83d\ude08 **Cause Trouble \u2014 Face the Consequences**\n\nGrab. Smash. Throw.\nMake a mess like a real panda would.\n{748464168310814}\nBreak the wrong things, and NPCs will get angry, chase you down, and try to stop you.\nA certain clown might even step in to deal with your chaos.\n{1447432027055957}\n\ud83d\udc3e **Live Inside a Panda Body**\nWalk using your panda arms.\nClimb, push, and move with your own weight.Feel clumsy, heavy, and alive.\n{25805219409074552}\n", "short_description": "Eat to enjoy life. Smash to cause chaos.\nIn I Am Panda, your instincts shape how the world reacts to you.\nA growing VR panda life simulator where every action matters,\nwith monthly updates adding new ways to live like a panda."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.cosmicflow.club/", "developer_terms_of_service_url": null, "publisher_name": "CosmicFlow", "support_website_url": null, "website_url": "https://www.cosmicflow.club/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24071233249240505"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307413_793689573306204_361677693118132910_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tvawOHjWc0UQ7kNvwH8axGP&_nc_oc=Adk211GgnbnOo_7B5kTc_WrqGYhKGMaipnHno0c2-WpTEnv-lAZSzJuA0ncNi778yMQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcNgD3OBcjv3HqpP_2lWeaRaXmqKd6JoXqNIDIFICS
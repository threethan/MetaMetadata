luscdn.com/v/t64.5771-25/499617831_1305562268074628_4364433244877772074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v9agcSa32cQ7kNvwHx_puN&_nc_oc=AdrjsuCy_BSoXojizFXxt6SgdlrmU-rYj4N-SCWLr5sLmBCdKLh4NOojIBQoIIVaJJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8g7LGPQr3Bvp6tfKP-b_zq8JbTwkn6GDJSx5bR8aV8Pw&oe=6A280B1A"}, {"file_name": "screenshot1.png", "id": "879961051402096", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617831_879961058068762_3663360351782784449_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WhlEi_Y51IQ7kNvwGQPOmm&_nc_oc=Adr52snhUnEhTUOZ05jdwEruJ9DOUUQS1ElNYN4GokqrrbqvNLg6_itLkqfz0_QEfug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XLWn_5HqKOOmu9ZAEQXAqSM1y0fU1PbDbZ7unT5KfOQ&oe=6A283745"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16\u6bd49\u718a\u732b\u4eba.png", "id": "2125026374946904", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620497_2125026378280237_5791397661638690148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fxFyyTGlf_IQ7kNvwGS0t04&_nc_oc=AdqICrboW9AL7bppCpFWVqia6-MJ71oBU0ghmOe8rArZHC3sDS9MaZNanDaiLfShTq4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8F_HaxcaTj9lk4xvSUvPSwAJ5IwgrWLM9irw7u5_d6vw&oe=6A28183A"}, "display_name": "I Am Panda", "keywords": ["Panda", "iam", "simulator", "animal", "sandbox"], "long_description": "What happens when you stop acting human \u2014 and start acting like a panda?\n\nIn I Am Panda, your instincts shape everything. Eat, smash, bite, climb, or cause chaos in a fully physical world where NPCs react, remember, and sometimes fight back.\n{838843782611270}\n\n# \ud83c\udf8b Eat Like a Panda \u2014 Be Loved\n\nEat bamboo piece by piece.\nPick up food with your mouth.\nEnjoy the simple joy of being a panda.\n\nNPCs notice how you behave.\nSometimes they like you a little too much.\n{1303650734518345}\n\n# \ud83d\ude08 Cause Trouble \u2014 Face the Consequences\n\nGrab, smash, stab, shock, drag, or bite.\nTurn simple interactions into full chaos.\n\nNPCs panic, cry, chase you down, and fight back.\nA certain clown might even step in to stop you.\n\n\n{1534798598168142}\n# \ud83e\udd4a Enter the Arena\n\nSmash, bash, and crush your way through physics-based combat encounters.\n\nHeavy hits create bigger reactions, harder knockdowns, and even more chaos.\n\n\n\n\n**So what are you waiting for? Eat some bamboo. Cause some problems.\nLet's GO! Be the panda.**\n", "short_description": "Eat to enjoy life. Smash to cause chaos.\nIn I Am Panda, your instincts shape how the world reacts to you.\nA growing VR panda life simulator where every action matters,\nwith monthly updates adding new ways to live like a panda."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.cosmicflow.club/", "developer_terms_of_service_url": null, "publisher_name": "CosmicFlow", "support_website_url": null, "website_url": "https://www.cosmicflow.club/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24791199770577179"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619697_1305034608396803_2010259501686890426_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_
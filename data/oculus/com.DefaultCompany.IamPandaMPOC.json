dbSKXX-UDO8Yvbg&oe=6AE495C4"}, {"file_name": "screenshot3.png", "id": "1305562261407962", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1305562268074628_4364433244877772074_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_rajsVZtM3UQ7kNvwFJo_zV&_nc_oc=AdqmOA9Rn9wsPDv09epNRhkPP1TksM32qLzRQ0MIRAVpkE65wBHM9zRRMbrEsZ4O-ag&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU021mAkPBuDmQXG9nBaJX5BLgjrwY57Pct7G-qM7Zxw&oe=6AE4919A"}, {"file_name": "screenshot1.png", "id": "879961051402096", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_879961058068762_3663360351782784449_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlfsK3DRWO4Q7kNvwGSEIA7&_nc_oc=AdqEZQRSv1x_OoaZ2Y8PoZFnV1obdVcmVx9flNiyHyFU2zl1RkQwjpoY4gUvyBSu3ec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMIQ8uZOjtZa5VLvNyoAbgTRbpz2biYdZUfgc8mwSsQQ&oe=6AE4BDC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16\u6bd49\u718a\u732b\u4eba.png", "id": "2125026374946904", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620497_2125026378280237_5791397661638690148_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Ln63meb_QIQ7kNvwG2ZKoS&_nc_oc=AdqJKlj02xUxtOvBnggR4aiAIK0jSUu-pEwL3UTR3tmxHx6bV-0TwVsHq59SjUjhTkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiW-oZ1pRLCEzktq2dbBfym-TGmP1shxjfAvdyH3--Kg&oe=6AE49EBA"}, "display_name": "I Am Panda", "keywords": ["Panda", "iam", "simulator", "animal", "sandbox"], "long_description": "What happens when you stop acting human \u2014 and start acting like a panda?\n\nIn I Am Panda, your instincts shape everything. Eat, smash, bite, climb, or cause chaos in a fully physical world where NPCs react, remember, and sometimes fight back.\n{838843782611270}\n\n# \ud83c\udf8b Eat Like a Panda \u2014 Be Loved\n\nEat bamboo piece by piece.\nPick up food with your mouth.\nEnjoy the simple joy of being a panda.\n\nNPCs notice how you behave.\nSometimes they like you a little too much.\n{1303650734518345}\n\n# \ud83d\ude08 Cause Trouble \u2014 Face the Consequences\n\nGrab, smash, stab, shock, drag, or bite.\nTurn simple interactions into full chaos.\n\nNPCs panic, cry, chase you down, and fight back.\nA certain clown might even step in to stop you.\n\n\n{1534798598168142}\n# \ud83e\udd4a Enter the Arena\n\nSmash, bash, and crush your way through physics-based combat encounters.\n\nHeavy hits create bigger reactions, harder knockdowns, and even more chaos.\n\n\n\n\n**So what are you waiting for? Eat some bamboo. Cause some problems.\nLet's GO! Be the panda.**\n", "short_description": "Eat to enjoy life. Smash to cause chaos.\nIn I Am Panda, your instincts shape how the world reacts to you.\nA growing VR panda life simulator where every action matters,\nwith monthly updates adding new ways to live like a panda."}]}, "developer_name": null, "developer_privacy_policy_url": "https://iamrobot.world/iampanda/privacy", "developer_terms_of_service_url": null, "publisher_name": "CosmicFlow", "support_website_url": null, "website_url": "https://iamrobot.world/iampanda", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25997335089963635"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scon
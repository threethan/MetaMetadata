-iad3-2.oculuscdn.com&oh=00_AftrZaLEm8pL2chdroiZT1duCoSLEIb-sesa3NFA90gytA&oe=69999D05"}, {"file_name": "screenshot5.png", "id": "1564208511489867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619465_1564208514823200_9213792343833820098_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HFAsXQGa1xIQ7kNvwEcTUf8&_nc_oc=AdnitYyIr7e59xVpV3Sb98DVYd6ZxsPdRcVit6gRAq6fSSshGTIWqznGLlJGtKR-3Gw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHRLvUY0xTUeEqlVCw9jbQJwf-3J0Tu800YmHC9U-GZw&oe=6999A973"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16\u6bd49 2560x1440.png", "id": "817067284432971", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_817067287766304_519182407492036228_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2n83bAw6XEQ7kNvwGUELD-&_nc_oc=Adlasso0zolFzZDle9a7mj_4QH34BqVJntScA-m1QmSjkqD9jlFpUhUSLJn0oqmq-xw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsPmAns6lhPFBm2EzcAxFP_bj7MMafiybH7jP3VObjfIQ&oe=6999950D"}, "display_name": "I Am Panda", "keywords": ["Panda", "iam", "simulator", "animal", "sandbox"], "long_description": "**What happens when you stop acting human \u2014 and start acting like a panda?**\n\nIn I Am Panda, your instincts shape everything.\nWhat you eat, what you break, and how you move\nall change how people react to you.\n\n\ud83c\udf8b **Eat Like a Panda \u2014 Be Loved**\n\nEat bamboo piece by piece.\nPick up food with your mouth.\nEnjoy the simple joy of eating.\nNPCs notice what you eat.\nGood behavior can make them like you more \u2014\nsometimes enough that they can\u2019t take their eyes off you.\n{1096871039177275}\n\n\n\ud83d\ude08 **Cause Trouble \u2014 Face the Consequences**\n\nGrab. Smash. Throw.\nMake a mess like a real panda would.\n{748464168310814}\nBreak the wrong things, and NPCs will get angry, chase you down, and try to stop you. Fight back. Don\u2019t let them succeed.\n{1194078982413126}\n\ud83d\udc3e **Live Inside a Panda Body**\nWalk using your panda arms.\nClimb, push, and move with your own weight.Feel clumsy, heavy, and alive.\n{25805219409074552}\n\nIf you\u2019re curious about the vision, want to give feedback, or just want to share silly panda memes \u2014 come hang out in the community: \ud83d\udc49 Join the Discord https://discord.gg/2upDZSU2\n\n\n\n", "short_description": "Eat to enjoy life. Smash to cause chaos.\nIn I Am Panda, your instincts shape how the world reacts to you.\nA growing VR panda life simulator where every action matters,\nwith monthly updates adding new ways to live like a panda."}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.cosmicflow.club/", "developer_terms_of_service_url": null, "publisher_name": "CosmicFlow", "support_website_url": null, "website_url": "https://www.cosmicflow.club/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9954345511355849"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307413_793689573306204_361677693118132910_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgYA5Iig01MQ7kNvwF6maCJ&_nc_oc=AdluxBcR4dydtfE4J5entr3-7SBBLPBnN9oghDHA_C8YZ2MbLaMfoJWYRGTicmHKU-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsFV
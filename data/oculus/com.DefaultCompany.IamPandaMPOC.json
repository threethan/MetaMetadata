rR3x4XfA1SPW8LIYKnL6D02i00&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxCcNiG25ifcnCrDXJgx5__oV_Frj-C6Nq8JJSKj8czw&oe=6AFB447B"}, {"file_name": "20250905-150620.png", "id": "783147030885205", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499298291_783147034218538_5439850083816623172_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kNHJIhbR7cAQ7kNvwF4VRBF&_nc_oc=Ado3wHRX6z3-7LULSOTwkTFxubN1om_syYghCs4JuU_O4OTLZ38wUGrwemwz45U-Raw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEBN36AsUXsqjHIW0ujFC2gCHOHqAF2ETz9PuKB7INJg&oe=6AFB451D"}, {"file_name": "20250905-150623.png", "id": "758918500393056", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499308575_758918503726389_8975063375094497390_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtLmaeuuWDQQ7kNvwFcCvaZ&_nc_oc=Adq0QmS4JL8qN7Tto3YNLhb-PsFFSt0vb_Z18iohr29v9XQFVW0EAgnBvv0d17cQEjA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3Ei55ogFxcH_NPBR-EZ4lEJNB91ID1qZff3bJjEka2Q&oe=6AFB3855"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Panda", "keywords": ["Panda", "iam", "simulator", "animal", "sandbox"], "long_description": "This will be shown throughout the platform, including the store.\nHave you ever looked at a panda and thought, \"I want that life\"? Now you can! I Am Panda is a charming and hilarious first-person VR sandbox that answers the delightful question: What happens when you become a giant panda?\n1. Become a Real Panda\nMunch on bamboo, poop green dumplings, and train in kung fu like a true panda.\n2. Explore and Escape\nRoam freely through the zoo, uncover secrets, and find your chance to break out.\n3. Chaos and Chase\nCause mayhem everywhere, but beware of the zookeeper on your tail!\nCombining the charm of a beloved cultural icon with the boundless freedom of a VR physics sandbox, I Am Panda is a unique experience for anyone looking to relieve stress, spark creativity, and just have a ridiculously fun time.", "short_description": "Ever wondered what it's like to be a panda? Embrace your inner fluffball in this chaotic VR physics sandbox! Wreak adorable havoc in a fully interactive environment, master the complete panda metabolism cycle (eat, digest, and... leave your mark!), and cleverly outwit your human keeper. Your ultimate goal: escape back to the wild!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.cosmicflow.club/", "developer_terms_of_service_url": null, "publisher_name": "CosmicFlow", "support_website_url": null, "website_url": "https://www.cosmicflow.club/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "528142316460358"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8659699827487097"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "843224981879178"}, {"status": "PUBLISHED", "id": "770078352821243"}, {"status": "PENDING", "id": "874842598437606"}, {"status": "PENDING", "id": "1839887819987262"}, {"status": "PENDING", "id": "1588343839260862"}, {"status": "PENDING", "id": "3748536588781990"}, {"status": "PUBLISHED", "id": "824968033733067"}, {"status": "PUBLISHED", "id": "1327560259168491"}, {"status": "PUBLISHED", "id": "1322378842789161"}]}, "baseline_offer":
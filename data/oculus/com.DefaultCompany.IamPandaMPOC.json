R3EU3R2sQ&oe=6AF323DD"}, {"file_name": "20250905-150623.png", "id": "758918500393056", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499308575_758918503726389_8975063375094497390_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWW6LyWljhIQ7kNvwGNONUO&_nc_oc=Ado5T5Ayx5lxckM1Rbfm2YFMIztbgY0Py5IDdsErcu5fNSfXMa22-_TdICyb3jrCnRY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnunYOMeJi9eEm1n6xj-Sct4zV-v_tFecmAmBMLSJMMg&oe=6AF34F55"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "I Am Panda", "keywords": ["Panda", "iam", "simulator", "animal", "sandbox"], "long_description": "This will be shown throughout the platform, including the store.\nHave you ever looked at a panda and thought, \"I want that life\"? Now you can! I Am Panda is a charming and hilarious first-person VR sandbox that answers the delightful question: What happens when you become a giant panda?\n1. Become a Real Panda\nMunch on bamboo, poop green dumplings, and train in kung fu like a true panda.\n2. Explore and Escape\nRoam freely through the zoo, uncover secrets, and find your chance to break out.\n3. Chaos and Chase\nCause mayhem everywhere, but beware of the zookeeper on your tail!\nCombining the charm of a beloved cultural icon with the boundless freedom of a VR physics sandbox, I Am Panda is a unique experience for anyone looking to relieve stress, spark creativity, and just have a ridiculously fun time.", "short_description": "Ever wondered what it's like to be a panda? Embrace your inner fluffball in this chaotic VR physics sandbox! Wreak adorable havoc in a fully interactive environment, master the complete panda metabolism cycle (eat, digest, and... leave your mark!), and cleverly outwit your human keeper. Your ultimate goal: escape back to the wild!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://privacy.cosmicflow.club/", "developer_terms_of_service_url": null, "publisher_name": "CosmicFlow", "support_website_
m&_nc_ss=7f20f&oh=00_AQGgGTCP7WNpxQTnDlh5c-_4qXCD71JVqAFGFgXFoOKggg&oe=6A90364E"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Nw4Q7ognGwQ7kNvwFDYB_X&_nc_oc=AdqzPk0EvBF3jpgd-FR2EvwYYYF_7t0bwJQpuDVTJnVs2EW6APSAJCJx-n8McRzlZ_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-1Ul20tlbwUCm7LTPcGBlHPRs5qCE5YS4zusB0kpoOQ&oe=6A9025C2"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dxi0Ow-TYsQQ7kNvwHRYucZ&_nc_oc=Adq58AsA_FMy9t1QdNtYaG1vqNVm06iejIK6hCgtrMY5ckkcFuUsiv2cE-j3ADrX3mE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqs_qTONgQrQPh3OsdOnbDKmwySa5DIvMDVVajHYfCGA&oe=6A901E0C"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QpVL7kGl0ooQ7kNvwHFApbp&_nc_oc=AdqhCtz6dqsfZ_VKxC4CZfuzP2-eYwaFFVGgzCUxFYBNiovySC5R_up8HxRTTEq8WUw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg9ZmTMvRy_jruTKeHqGXuSB6DJyiVbca9-nmfX3wmUg&oe=6A9007BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o436OyA0qwQ7kNvwHMPUx7&_nc_oc=AdoqC0b_c-2SUhk0fnkjEahRhHwfqdQdRBRmt4zQWlHtTNBcQRA0_Q4kiN9FZVqVboU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-38jFxv4HJ7f_6v6YI5h9HgKu6AkL2TUKd3i5wJA4bA&oe=6A902DE2"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPOR
m&_nc_ss=7f20f&oh=00_AQPoJoj8cO0RQZvC-xDjSCD3XSNnpuX7XrmQn2Fwf2pZag&oe=6AC7CD8E"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXcxKjkSXR8Q7kNvwGI_x8V&_nc_oc=AdqN_k4U1aX6INpxGqMPXkyMFh2oRykanchekWxXOcSc41cRIDCym3emRsnMzGXq4KQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz0eN9rhQMGf3BrkMxVA2BSx4gTwbOZCgtLzvO07CD0Q&oe=6AC7BD02"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDheIfEVU64Q7kNvwExnIrm&_nc_oc=AdpRHjyRZQyHut9Hx_fR1wJMevUEC1NpqF4oeHGshsiyTTVR2Crbi1WbDubyszEZfc4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgPeLAFE4L_iltiS2E5mWZ6wmH5HvLR9Z63y0QXAeLrQ&oe=6AC7B54C"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5VpOwFFXXMIQ7kNvwGanRgb&_nc_oc=AdqAjcPg9L2pgnHZ96THnSl4sbycEdPIfbKHaBX-v1TRZ0K2nlyFV7T13j-GonBry9s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO02audtzf-ZftJy3bL7Y4mz412lQd__PglTmQdEI485w&oe=6AC79EFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbkfdR1DGGoQ7kNvwEdNr-F&_nc_oc=Adrx5lD0eLMxX17r52nZYP6t4kefvODT4d08gFxIINJl7-Qumi9fASE2BXyl4l3fNOU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP11XdJ1USUqWaWF0CEjTuzqu7wFEGtgpDmJQYk0q8rkQ&oe=6AC7C522"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPOR
ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_332281825050932_6862210339066437649_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krtQD-5qL9sQ7kNvwFU2jcN&_nc_oc=AdlUhfWLK388fuHDWT9Ccp9SV4PlzGTICCrvc3uqT9kkJ0aKezvRH4j4Goc1vAd9M5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfseBkwz3wBrgkO1F3TLKKNM_MtYhtjQ0r0oKGVMlkSXWA&oe=69A42F00"}, {"file_name": "vrg_e003_tate.png", "id": "168787401887930", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_168787405221263_6597416494033411179_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6mYp6iqGuAQ7kNvwF_Bgwa&_nc_oc=AdnjIPojgvnBUcv5rOIH7W6vwzQmCs1sKnIRiwJvNqHd4y00QRUk2uIgh5ILgAfr-KU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsakrDEZp8s6GDWmjxCacZhVkfFJij7qMvc_bpNp-zZ6g&oe=69A42862"}]}, "id": "385370113356277", "locale": "en_US", "screenshots": [{"file_name": "\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9.png", "id": "337450018307162", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54823267_337450021640495_3421216820890922316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjFqXlsPplQQ7kNvwFNuA3h&_nc_oc=Adk_22kqs1stQNdBmn8dDVPn2_vDG_ilXkboiJzoNzM34le2bclSDb8CQpFKuUzuppg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsTIeqlCKdHObe-HncbDboDtsHn4EIPt979jOQvmdeEPQ&oe=69A43E95"}, {"file_name": "top2.png", "id": "653313305979998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_653313309313331_5159525296416930311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g_Q3HnpO4KcQ7kNvwFr_dsD&_nc_oc=AdmDOIQA5V6hmWjspjjOZEsej5AWGC9wPqUgznoXrrkYHWqIWXRpeF0WjigOxtynNbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftabAc_zLWmEqQcZd0INKwgsRQvqHbdamI7oepKaG-VMA&oe=69A439CE"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hzqVab9cQiMQ7kNvwFco7MR&_nc_oc=AdkIWiWWhUMWe1rhsjnbukMyqZrqGS99OpRyCW5Lt-4wM0ioRDT4pxA1Qp57JA97CFY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvQTEF5rKo4YLfiQF_au6hL6uTmGguLnkBHBoW9Ig6FiQ&oe=69A42942"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhKPTGisQIIQ7kNvwGxUA9l&_nc_oc=Adl2DgDW1iidUdrAuwly6xZEFa60uX-btTAyN_99f88GpnDDN4Z1RX7IqkhaLugTLFA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afu7SWTgSYi0FoVpXcV0mKxg1G-bXHof9uzlgdXCahDvbw&oe=69A4218C"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8RIhpUVFW0Q7kNvwFeNqtB&_nc_oc=AdlLX1RwgX3sRb9LKmqB9TSCku8aDPFdIP4jJP6Try6bMyCkLg3q8GEiN6eiU8vhEB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftk4GQnCoEGtpIGcH3I01dfoqWoN-d-0tExHfctvzPBMg&oe=69A4437A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7mNNDB9K6GwQ7kNvwFHYKcT&_nc_oc=AdlNXggBfXj4HMcOz-J0tqhHyYSRiLlw5W60OBm-XvH57shrYuoLhbuAZGI7BWHf5FA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsrwcYhbwLqeRu0Z7TTZljMf-ilMPx5ivxNwDyEGfdrqA&oe=69A43162"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"],
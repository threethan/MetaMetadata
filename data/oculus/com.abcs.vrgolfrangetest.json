t-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RvRTFbL0U92hP4ZVZutbJWs9-V2U42lEVjo9j5cRTng&oe=6A46624E"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9IiosPmjo8Q7kNvwHl2U-s&_nc_oc=AdqMacmlDpoKbge44hV6D_-sXWLkvhdaY-mRmPVmym--jgglmgImFTc8kWkdaYPBut4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6LYtrD-ud_nXA6JKTOYitdXYlb1tCPZfG_tVMW5kIIQ&oe=6A468A02"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLKrTpD3OrcQ7kNvwGL9mu2&_nc_oc=Adr-JQHoUnqbP5RjCSoR5zSSHuyQgYF4ipULT2D82-RbeucfGpVnkqYVDS_T3Aslrnk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EcL7YumtYylyZd5ocT0y4ktp3zB1VaglgRIpSxSHZOg&oe=6A46824C"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXWptZtIs8YQ7kNvwFRP4Hi&_nc_oc=AdprklSECxJeVDl58_MmuvLhG4vU98KNAcmMjlLYijhkT_tO5Vgt5vxNIDR_hspYVks&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Te_xbPne95FunYiU7jaZmoOTJSimgUvpfUr4sj0rK_Q&oe=6A466BFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBEjq0BxIkQQ7kNvwG8l2wE&_nc_oc=AdpKACgC5UP1Cgg8intUk3RTSbK5aytgADcfWu8At_5N1EucdWFaKE5AthvIdo0UXg4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yv87IjqIlLLAumcPfJ8xKYIY1jp8ObfKZq1NMvwzREQ&oe=6A4659E2"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT
ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001731_332281825050932_6862210339066437649_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et2uUsGDyIIQ7kNvwHPck7L&_nc_oc=AdlVMaa4bdghxB2OA1tJ8tRUSKu0od_c2BgWImxefr7PGpKHDw5g4zTMNzk_iwXIjSw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuhuEePafYJsUpVzkUKJYmN6Ip0nO3p6lLfgfrDBCQgew&oe=69985180"}, {"file_name": "vrg_e003_tate.png", "id": "168787401887930", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_168787405221263_6597416494033411179_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VY9WYw6e8xoQ7kNvwH0am1D&_nc_oc=Adk03J7ByZi8qKqV1hNcNziCwYvYjzukXlDe0mtRhR4xHv0-6gka4H9XtKkIR3xV7VE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuzhqrsZyZszXVo-ShliEPOloPcd037wAviaxmxvCBdSw&oe=69984AE2"}]}, "id": "385370113356277", "locale": "en_US", "screenshots": [{"file_name": "\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9.png", "id": "337450018307162", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/54823267_337450021640495_3421216820890922316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3rM0ZpJHSUQ7kNvwEqThbS&_nc_oc=Adk0kJqIf3_cawgksMCBR4uvKw2ypNTJOw40ajyIwhamXcTwODQwkE_OcehLUglDCEs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftpTYJbd8JJpPpfmDWE9LawoqWiUYxISp-uUzroZI2q_Q&oe=69986115"}, {"file_name": "top2.png", "id": "653313305979998", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_653313309313331_5159525296416930311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8lxqe9KSdkQ7kNvwFwlHaB&_nc_oc=AdldHijJYN8aJRzeHthvwqh6GTFdWmTByn_8QvgfeeHp_EiXHyhl7_U9AEmOHwiG01c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afu51SUyQnVySc6yh9_xdVEC1dSW3nPzqUsdF9lFG2fLDA&oe=69985C4E"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGnEADjXdvgQ7kNvwG7DTfS&_nc_oc=AdmSFjijENZLR4yQQf0fWJdCUxO8ThpU-p3WbaWyVCLPH7982aPeMmQRuiTnD5RMzcY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftqanuHg9YjSnUxMxx4vxqLWYRpgS9cs86FOjf4p202Lw&oe=69984BC2"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Uj5kd6NoRsQ7kNvwGvVcSy&_nc_oc=AdmdjPjCQ5K0-oP1tZI0sSVJHopffZ4tB7nl7eaav068YYbdpybyuaavdzxfam85m4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuF7xwJf4n1aeCD1TE1DGpkaTocSdmIavEcEZGC689ESw&oe=6998440C"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec_0v0PG4CsQ7kNvwGUAgr2&_nc_oc=AdmyiUVHGMu9MleItv8ymOjBrEI8u3Jm7q93TchK2Hj8I6jvOtwDWTSw3ZvrrBJUzAU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Aft1RFb_QULFD1w9B7ndneSPF4_hbOfQppXZ84zBVaIDfw&oe=699865FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b6ItsTpQ5JoQ7kNvwFszVmU&_nc_oc=AdlZNKHSgx5OH7PTLPRCfkzw9xKwhG7CpVIU0nceSPKm65AA8g5sF8WLSlRswLG4EyE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfvjUPxmUPQZ38EQxeBMM-qegaIQdHSkw6UJiptUvSPLbQ&oe=699853E2"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"],
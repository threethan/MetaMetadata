m&_nc_ss=7f20f&oh=00_AQBbD3-m-hkO0jjhoWHKQhj1brCbSapBko8cFuqIb4IDPw&oe=6A5A28CE"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTREY4ZeCt8Q7kNvwEGmvna&_nc_oc=AdrcK5Dvwr4f92DqrXIUaHXmDAqdoX3Mhenldnj3kBToMz_r1tugeIeMQv40ywfovZY&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdmQ4TcYtHqnxdoUiP4L66PNsdegljEiDF0ZEoN5Vfnw&oe=6A5A1842"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUPurXkQKrQQ7kNvwFCR0wy&_nc_oc=AdqbPrcQzXr5iGjM6rj4rxbL-3Jc-UCt9jMBglQlZvTKl0d1ZXsRDLEhz89wGfpE97s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAulOxCb-203BkKVdHoF8Q4GvnUnKSLP7XopPwApTxlbQ&oe=6A5A48CC"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uvEzljSW6lMQ7kNvwHkReTK&_nc_oc=AdpYC6T0uhx358E6QmFECKM2xgRXsjEgOZWskMwK4s00hOrGsWZkaS_LA3UDwd9a17M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfQtBJLFnp6y1uSUSRWYp1IUrVcbm9KOIe8GKzOqM0Lw&oe=6A5A327A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmW3McTAg5sQ7kNvwGtrrX-&_nc_oc=AdqmTtvMzqPYCs-S52rpvtGXsTeizt9cTuUaFkKOuyOzeiBcEMRGlRqnWlz0YmAB6os&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6cOpkwPYkVXt5WKa9cYg1WNtE615cMOEBkNMvtRmeFw&oe=6A5A2062"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPOR
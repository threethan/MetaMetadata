m&_nc_ss=7f20f&oh=00_AQJBfKzdxIgrClvdB85UUe_deI3pIh-ODdabuOKe3gfYgA&oe=6A9C13CE"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYqw9VFixp0Q7kNvwHnVkI3&_nc_oc=AdqKHOOYaBFbD_aM391vtri41AWZ1Q9qEij2oKjQ9omK9vvOBOy6zYkK9dkdezT6EVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1JX72Ie8PypDTsFTWCxj3BeVpJTG6So9hIbDE45nhSA&oe=6A9C3B82"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yR03b8bzhu8Q7kNvwHEuGu7&_nc_oc=AdqaIszIFQet3HJUqkRSVOEA9mOcWq43xlT52sMrvm3mSldd7G8LD3GeewE5pQFk6dI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgnA8j_OsZC4JS7HO5Fyc9FnnemUTbyv3i_pQo5zAkLg&oe=6A9C33CC"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PZ9Qxe4u8kQ7kNvwGoxqys&_nc_oc=Adrs9WNFFwnN0Zr5KX_4cm34FBxqz4VSishxwwzpEwJsPJdWyoeS8cADrZF6OM9ljHs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5oXfNUM0RXolI6IBn0PzlMuF0zbKUmtNfwOH7nCIL5w&oe=6A9C1D7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_2sE5FgiCEQ7kNvwFa_wOf&_nc_oc=AdrHM1p83VoKAXmDzE4BRLonpl1iKEceZozoVn57yAVpcepqNn6QBWvGit5YT-j5HQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI41JaTByoElem1qq_6nt84eiayp7vsJZDhZTWBDS1fyg&oe=6A9C43A2"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPOR
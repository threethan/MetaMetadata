t-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MVHwN9TXDy4H4uzBGAWK2fb5RisSipmQoSUb_rT5pRg&oe=6A39334E"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLRCVD0p9cwQ7kNvwEc3J_O&_nc_oc=Adpl5v6WRhSyj-Jswq9KWW9llvjFU56e47Xd5HgoT9Db4ysOriuRFuKveKPGrxylMb4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zk2nUDp-11r3vuV3pOBkHcr2mICb2-e-TBqSLMD0fLg&oe=6A395B02"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pB8pCeqWroQ7kNvwGwb7UZ&_nc_oc=Adr7nEKfBsIlJgYu_Es1Vc0-Vn_cmsDg24MK72JnAatcOwergwR2Zbf3GjPcceb-FQ8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--zCf1V6bq77rbGDwc6ats6ohMbPcDS859qclaAeofUA&oe=6A39534C"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1GRa0QLy7s0Q7kNvwFlDQJF&_nc_oc=AdoRHkZ5Pqa7QE2I62ye4y3tkeY-GLzZLTNqinfXeIIzrigmOVyqmf-806PWeaRj9_g&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-t2DRMp36OcOGVoxO4zu8dVvtqeDrkcvn5xlSOXkaNXA&oe=6A393CFA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQiZOi7hO0sQ7kNvwFY3g5u&_nc_oc=Ado6U2nDM0H_w6M_8XXSzMmE5i7SMr-VAuCL7oq2qXE_llCJXfZpctNL7RoT-itjUWg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BfmXCOAWSqJSAvYUHO35mlpPr8T3jHYDMim7h3BoINQ&oe=6A392AE2"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT
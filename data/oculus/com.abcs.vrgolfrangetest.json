ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001731_332281825050932_6862210339066437649_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krtQD-5qL9sQ7kNvwFndv12&_nc_oc=AdnVcDmCtV3DnyTNg5SqacwQklkHkBMF-HKkoq7Prgxvt1glR8sdwDA43NKmbYsdgds&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvp9ZoRG4-jOYDHFrGw-i2UdxLEk5cYGVc9Zhq6F14dKA&oe=69A6D200"}, {"file_name": "vrg_e003_tate.png", "id": "168787401887930", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982674_168787405221263_6597416494033411179_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAJP219RdpoQ7kNvwHWr6VO&_nc_oc=AdlJFo_q1sUskjBom5RYEPyXGnGcH3BgP02Yzxc06XW_fRKTgVZe-_gTaCIYZTxuLME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afsp0udFNlqrRVwmVrMY8pdRHUCax639f8Ugs7_7pkCqxg&oe=69A6CB62"}]}, "id": "385370113356277", "locale": "en_US", "screenshots": [{"file_name": "\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9.png", "id": "337450018307162", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/54823267_337450021640495_3421216820890922316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjFqXlsPplQQ7kNvwEQsm97&_nc_oc=AdnEnvdCwJFBQiE70KkJ1Fe11Fm3YxNZ6fQqZg4aO75Npz7V1CNNve_AvzPhXuONKK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsrAba9BcCroKG6lTmPkGyTSYaoDU9U03LVz54Qhucefw&oe=69A6E195"}, {"file_name": "top2.png", "id": "653313305979998", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_653313309313331_5159525296416930311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSuQWSbEPNYQ7kNvwESOtfm&_nc_oc=AdnYRoxg2UH9Cru1oCqPRzj1uZM4uQc1-NIE0ll59dONFvtS1xFpUAX26bdMg0604lw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft0AQBWOeOSeEomkFpv5yd4xKM4poh2ceeA3nllKd3Ocw&oe=69A6DCCE"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNa4yBv0BccQ7kNvwEvXLgK&_nc_oc=AdlIJ6HNiv_NTHPVJgxq7m22xjPHUEEdmXdaqqJgT7MvcFZKNMWAI9zsTpmJJsD_sJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftKJtU_SbUfAcnZfZz-8hfhv1y71vHRqN-U_Wg9fycECQ&oe=69A6CC42"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6lpLLs56cgQ7kNvwHDE7jL&_nc_oc=AdleErjL-Tu3QNMOe-j-2A34AgFNnyvsNCRk3Cp77t8HE6pVAmzjMJzO2kdeUHnTl5g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftT1GIXIGvqsZHu1gYGhIEZ0OkUpG5RxuWysm43pF6Rlg&oe=69A6C48C"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNCHyXfID6wQ7kNvwG_lOQq&_nc_oc=AdmOI0Qh_r0wktd9UMgMBEGtZjySNxTeL7qvFj_eh-yWHoBSxlOvPAQu6noRmdZ6QoE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfttMfbhypezihbojPNJ7EzQ_zXkxDqZzzjtPKRG0dCMeg&oe=69A6E67A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qH26vmm3ZuUQ7kNvwHvmoCU&_nc_oc=AdlAtg96lcQaJLna234FWQ4o5PZyykoouHPnjeqGjcBtgMwUe22tl7XqNFDbVKD32LA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv0G87U1pb4Zho1yKOD5DMfJOoqbFUpJwUPek9vpmMnyw&oe=69A6D462"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"],
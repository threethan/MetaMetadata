m&_nc_ss=7f20f&oh=00_Af_7cxxYsSSmSyP1Rkbq-C5GxMBwABwXR_gO-C3o4QT7WA&oe=6A4510CE"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T9IiosPmjo8Q7kNvwH1KwoV&_nc_oc=Adpbg9JnLLCJqeHgbjDPMALjkFvAAjmc-IJajp7ATE48T57RrBy7ulD032F6OAw_E-A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c1SLgtCc7h9Wqy7_3ctBN5QqiElImWC17r1hUN9EcNg&oe=6A453882"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLKrTpD3OrcQ7kNvwE0O92K&_nc_oc=AdoQvxMBM6tvkcmP4O_qhthot-CSL-gclDLoYM_npgDQYkS5Dpld6ThKWEy4sL-e-zE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Zln4pfmDmumbhVbMLdxUgn7y5C-ysrX8LP2wy6ykXHw&oe=6A4530CC"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVvywfq0IRsQ7kNvwGceRUV&_nc_oc=AdqWTJcVpT-8MAsvPyW8XzQeSpvzMj95wj6rpk8n7Gr6NLaAb3kjf1AcxRrUAMVskDM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cf_1Zgt_jMrlOtCBLIUjZ8vrJ4Jp1SLkWw3wsnaNqnA&oe=6A451A7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBEjq0BxIkQQ7kNvwHjreZu&_nc_oc=AdoH4LRA7VZQ4zHTSna4OvjTACyHCBo0FH1PPF-gnT_RgKCOeElz0p8f0h5ADQqmwNg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-srcEpIn2c6qJw8DexapkFg6I_62hqcpDmxY_uavjbIQ&oe=6A450862"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPOR
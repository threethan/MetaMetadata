ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39001731_332281825050932_6862210339066437649_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbZ_ouvt_SIQ7kNvwHiDbKa&_nc_oc=AdnruR_uTXGEjT4OsWndaXMLvlfw5OEKYvXYBRi-_IlmhJGWBtn4Z3LmikV32vUidRw&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afs81IjHMsPvsdG23UE0Y5X1rUjakWStrhAWPhypzAdQBg&oe=69A18C00"}, {"file_name": "vrg_e003_tate.png", "id": "168787401887930", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/38982674_168787405221263_6597416494033411179_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syAzosYqfuUQ7kNvwEupVdO&_nc_oc=Adl66cblV1dD37lqpvlQfYRYpBWFVmVRU9HMvS_1DiKgh0zYvjTaq8SOitxeURh-kls&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&oh=00_AfvK5FBWEK_ILsg3lEFf-1g-3JgqOD8da6MV61gAwtpKsQ&oe=69A18562"}]}, "id": "385370113356277", "locale": "en_US", "screenshots": [{"file_name": "\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9.png", "id": "337450018307162", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/54823267_337450021640495_3421216820890922316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQynRpg-_AoQ7kNvwHqho0J&_nc_oc=AdkIEuEHSUkQbqk9Dm5S-seiuEkOpEqGDmB1IsmL9k_jAH8rX0KaCGv7NPN6nej0AzU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvUytfjeMguxjdH4bG_SQ2vSWwXLM8uPrKsbooo0wI2DQ&oe=69A19B95"}, {"file_name": "top2.png", "id": "653313305979998", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974671_653313309313331_5159525296416930311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghW2tf9a7DwQ7kNvwHY_6Cu&_nc_oc=AdncW_KByOqVLn2f3XZNXv3fbojRkmdS2C1ly4CEJIX_D5B6k8h56Vb3mG8y0BVCGyQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftK_zdaWu78QtP-DPI87qJN4DQT5MvXv1yJDOOsICqjmA&oe=69A196CE"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hK8DOVWxHS4Q7kNvwEz2TYW&_nc_oc=AdkFxsHVxahirWz6BO9yfrtP1yIxNurfile5XG1mElVbTDpQSRu_xUW6sBxupSBvKxw&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsD6Z55yxJgppN939FhuTrgrXTYmhybiZ0MTbjKqlI2-g&oe=69A18642"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPFVGWtxpq4Q7kNvwGYYLcO&_nc_oc=AdlwrmfxFEjcnIcosOUMt3wDJXQQK9LEQ-zVC5_i7PYceZhMnC2iIzDbcIcwESZKjus&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Aftp0bUSwsbr6rLWQea2cIfWI1YegivSMEU49rQ5JTwcSQ&oe=69A17E8C"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z8RIhpUVFW0Q7kNvwG6PO4C&_nc_oc=AdlJUBn9ImVhFXcXUDQOnjMpZeK4YzL8lPpnr-2hNLtzMhuazrAZNda4_DkHjB1bpz4&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftO7pKnOcYlT-vgKzqzg_MmQDAi7qUltRJLxxVYxwsHhg&oe=69A1A07A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42KqZQQ_VgkQ7kNvwHHB7kH&_nc_oc=AdnqtLhs7V0L3asBfqB6RWXiA0fw_eT3b2w1yy31Kb30i7z6vV-V1Rr-zIuMhLvkqTc&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftnqO0_c38DgbsQFvPoLl4zn0hVgjmUxDxsNlpyamoDkw&oe=69A18E62"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"],
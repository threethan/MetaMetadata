ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001731_332281825050932_6862210339066437649_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUPHpMqZZzMQ7kNvwGxf0gN&_nc_oc=AdlSqihtJ5KJbE8sP_hwtNTLZPjfRgh3-A0GhHjXWZMtrU92IWrFVdJBCLIBea1kLgw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft4Xd9GGCmUUuOF-RdpzBttKzyBc7bOeTdEAdZRWDDwaw&oe=699EE900"}, {"file_name": "vrg_e003_tate.png", "id": "168787401887930", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982674_168787405221263_6597416494033411179_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syAzosYqfuUQ7kNvwGr6H4b&_nc_oc=AdnhUVSeltzInbvld7gERGY8DmpWl5fTzgQwQn9Y55qxnspmMYN24CN3BN0oEvAW_V8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfujZ_fc23YUZftAFKV6rWF5F4fmMVjJ3gjvNdJ4D1quhA&oe=699EE262"}]}, "id": "385370113356277", "locale": "en_US", "screenshots": [{"file_name": "\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9.png", "id": "337450018307162", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/54823267_337450021640495_3421216820890922316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NqehoV-iKcQ7kNvwFvhd2g&_nc_oc=AdnZHup5IYf1wAqZmOtjLVd7T0x99soFbCDFYvdXk6jUjBZh-d1F9g74ZJMNeEFNodo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftLOBg2I42t5-x78N6ZkshESiQPSyqDDudk9p6WQoQzaw&oe=699EF895"}, {"file_name": "top2.png", "id": "653313305979998", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_653313309313331_5159525296416930311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ghW2tf9a7DwQ7kNvwHUFtTj&_nc_oc=AdmWVt3xcDnjiAUy0k92GV1qSLhSjrWu0kg45-KRZt0oIskkUOdeeMOE6WXzbdOwLNQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftvE-wruK21S-fM3eqS0mrKLtPpfg4XyJzbBZ4q9wpcbQ&oe=699EF3CE"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hK8DOVWxHS4Q7kNvwGcznX4&_nc_oc=AdnXwNlmD9Sb09S5RC_NkqQD-AeRcW1_XNIEhfsNus8-Vjd7K1uGywLbPnnLu1xheXM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuLnzE_ZCGgdBM9QwWdG-rYjx3xDLy46kqht__caGTvjg&oe=699EE342"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oPFVGWtxpq4Q7kNvwH3W8Z0&_nc_oc=AdmA74sPobkVxlXjMHmOZal9BewqG_mA5jsTVvAS1hvfuKd7ho9DcFiv7viL5OsKCsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsAKneoqtjroI8bLXY1ENCjArIS8MkHnzIuZtGmlOMm8w&oe=699EDB8C"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCYRoCv6xSgQ7kNvwEw12A7&_nc_oc=AdkYlbpP0YBhrVCQ7oFAxuSL2HIBZ-IqQh9B1w8XjygcHqdc4ijWwLwJ4fzBGlfJm_A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvPv1spQ5iq530kH6pA-8i5Cclw72wyWomB-d8nZhiXeg&oe=699EFD7A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42KqZQQ_VgkQ7kNvwEU8kiJ&_nc_oc=Adk0d7ykwPpN-nmZKoImCEcM3-IZa_jmbU3Jdvb4EGwvDfivGgswiBkvjUB3-gBtobE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftKNsDSJHqyf7nh82FiviCyAq8oHCHNtepP_xyV9AQHsw&oe=699EEB62"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"],
m&_nc_ss=7a30f&oh=00_Af0AYuy3wYwLE2TFyoA0ggDeWbb6WXpvJ_6VaaFw36aMdw&oe=69E2304E"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hk42wSNiFK0Q7kNvwGZ44dC&_nc_oc=AdrQ9NtC9xHnWkrsjKSMALPWdAuntRq0ZL3xD1Yvk87WWO64s6hNey-JkJ9aqVOdZ6A&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19yb93z2vty53psyifZK7vrcV5LSJbz6omPEKIq4B8zg&oe=69E21FC2"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gf8PpE0wxvwQ7kNvwHbT_y5&_nc_oc=AdoJP07i33sqrWKR0l_8OvSHDpgcYyCOXVgjOd6sB42lZ9X0MXUqEYOBIPdR3PCec44&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SjbpgF82rFKoJQc2ElcDwU3bbEBb2FTTIqppMNHC6ew&oe=69E2504C"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R5sJabMlYJUQ7kNvwFF2HCl&_nc_oc=AdqRQjuNZNRqdOTBOjv6pUMV5bBfLgoAIi18tPeY9qDhxtrjhWaSbRw5f3GXTEBdmh4&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sbpix9GwoxGRubHpLi1hv22Eze_3Hgjz6FFEeIL4lCA&oe=69E239FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad-3lhbx1i0Q7kNvwGCe6Xv&_nc_oc=AdqZSpw4mI7zUZnp9ilyS_oxgD6TJT7BfcjJqCMK1txjTojoQjmEF4vnwpECG3gjZts&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IDW81hcNND76eN-YNBb98oeFosJ4WiflE_8kWHQ7LRA&oe=69E227E2"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPOR
ype": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001731_332281825050932_6862210339066437649_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=et2uUsGDyIIQ7kNvwGBNK2q&_nc_oc=AdmSQyZjgWSEMp3zySpDiyphR-qscHjEdgym_lqUDA5Pw1Vumet0ktaGFzhAqEIxhLA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsbX23VfNEkb4fQp48WzLQDT9HtBwyn7F1MPEmsF7bQig&oe=699AF480"}, {"file_name": "vrg_e003_tate.png", "id": "168787401887930", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982674_168787405221263_6597416494033411179_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wGen6KQSMQQ7kNvwE67-vL&_nc_oc=Adk7cEEI6kRsn-C9Nj3eGHGqN2GmCGuVviTBeTAnYqFt4EsmsA1-pHogTfXRCEFhIwU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs3uZLI-qON1BnHdKMBzInntbL9UqSpK6BF4f0i9etaTg&oe=699AEDE2"}]}, "id": "385370113356277", "locale": "en_US", "screenshots": [{"file_name": "\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9.png", "id": "337450018307162", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/54823267_337450021640495_3421216820890922316_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3rM0ZpJHSUQ7kNvwFcs1zV&_nc_oc=AdkAe2kg19213mKfLr_dnaKajlsA-Ka9jwr-7f2Oso45D-ox3t4ZPCk6M_nmZ744IPQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuRVQNGMEEr3rrmJdSZqGxYuh5RAgPrq35zVCjf_UCjpw&oe=699B0415"}, {"file_name": "top2.png", "id": "653313305979998", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_653313309313331_5159525296416930311_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paPtKzgxPJ0Q7kNvwFpTV3a&_nc_oc=AdkRZLg248k1YO4f15Z8LU048MNvwPCoDkkz2q11Gjn9T88FtdW5t5_z7yTyCdjzDZw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuY4jgX5bVYvbXhNSUQ0sj_e40uKpfyVC_qLh_69tGdLA&oe=699AFF4E"}, {"file_name": "shot02.png", "id": "816011279058305", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75356792_816011282391638_4118689224638883293_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKJ1PWysskoQ7kNvwG8UIm0&_nc_oc=Adl1SFdm81vSBqendh0hsyrDuV0Kerp8XQuKYXNr4M7jsHHGgcG8mPRMCqU-vdJhH0A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftC23H9Qg8u7a4DkWCOvOd61yHDJAuYLaN8KNUWWkUHYQ&oe=699AEEC2"}, {"file_name": "Dracon_aset.png", "id": "287024699869917", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57566696_287024703203250_4400771700967467009_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=797PdfJZGw0Q7kNvwHNgdJD&_nc_oc=AdkpV-kik_0n-j4buXOzxRBNyWTEGwNgb7eZAu_Ic7sVCU0gN110nQOO7ppBdcI1yPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv7_2ifGJjJMGatTo6JA4T-MYntid2IfceSfKwN8T7gQQ&oe=699AE70C"}, {"file_name": "cosmo.png", "id": "763958354442334", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974671_763958361109000_1666867587057029197_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ODDgWJsxxcQ7kNvwH0cggJ&_nc_oc=AdkBFlryY-14HHzlSFjRkcuzQ5_FrdFLV6yF2MdXHcSy3SSebHtIlcqWM04UbUWrkhA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afu_e1FfWXr3YoJoW7sQVk0hYwRK8VMq05nxJbgFUyJMzA&oe=699B08FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Aset_yoko.png", "id": "454948119300156", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_454948122633489_7144318561306895112_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aceNrjkSgUcQ7kNvwGApNuU&_nc_oc=AdlsuPw6EhK6jwG0RRDlP6fKwL4BuO95k_eVmLc8QsC4Xr5YDoMt28iJJfIORAqdPUs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsIVkNJAF4daRrtJv-hwzP2Y3rD6Uocc-Y4jqLQh69wyQ&oe=699AF6E2"}, "display_name": "VRGolfRangebeta", "keywords": [], "long_description": "It is a application that allows you to experience the driving range of golf at home. You can check your swing on VR by holding the controller instead of the golf club and swinging. You can also set the controller on a golf club for practice and swing. In that case, use the position adjustment function of the controller.\n\nCurrently installed functions\n\n1. Tutorial\n2. Range mode\n\u30fbSwing data display\n\u30fbSwing record\n\u30fbSwing playback\n\u30fbSetting change\n3. Game mode\n\u30fbBalloon split\n\u30fbBuilding target\n\u30fbDriving contest\n\u30fbClosest to the pin\n\u30fbplay 1 Hole\n4. Lesson mode\n\u30fbSlice correction 01\n\u30fbSlice correction 02\n\u30fbHand floats\n5. Round Play Mode\n\u30fbGDO Chigasaki Golf Links\n6. Optional\n\u30fbVibration setting\n\u30fbClub position adjustment\n\u30fbBall\uff06Ballistic color change\n7.Language change\n\u30fbEnglish\n\u30fbJapanese\n\nPlease note that everything is under development.", "short_description": "This is a golf practice app that you can use at home to objectively check your swing by hitting golf balls in VR space. This product is a beta version for testing.\n\nIn the game mode, you can play a round of golf using data from real golf courses in Japan (one hole only), and also enjoy driving contests and greenies.\n\nPlease note that since this application is a beta version, fine-tuning of swing and ballistic behavior has not yet been completed."}]}, "developer_name": "Abic System Corp.", "developer_privacy_policy_url": "https://www.vrgolfrange.abcs.co.jp/privacypolicy", "developer_terms_of_service_url": "https://www.vrgolfrange.abcs.co.jp/termsofservice", "publisher_name": "Abic System Corp.", "support_website_url": null, "website_url": "https://www.vrgolfrange.abcs.co.jp/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "CASUAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"],
281820317244096_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXF8lsfKdogQ7kNvwFuk8WB&_nc_oc=AdosPCd442Lcg27ufpt_w_HB5VZVYtsg2X0kJHTTx_HUVPfhQN6PzX_AYd7DSYvnXGc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZazFzcgb7QgFHPxBK9uIWMmW0PZccAKaYvpbEFjluqw&oe=6ADF4B2F"}, {"file_name": "white.png", "id": "1613429313647956", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824741_1613429316981289_7666047844453632381_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6mYWyqMVWsQ7kNvwGjKb8F&_nc_oc=AdrBPl_yMw2TXT6QOSoPxuonN6Zmxj_eTIivq7LGGt3e1p66byM93X9jUqsFfHe4Tqw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7RMSRIFgmZAek2ebhevOgZ02RkpPkslZ9Zhuub2F71Q&oe=6ADF4DF5"}, {"file_name": "black.png", "id": "3276544062540328", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827601_3276544065873661_5117233569141589867_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQu7FSrwcbkQ7kNvwGZugwd&_nc_oc=Adr4nYLrQdsqYj_Q_yRoUHSkdPnLLddmwRvej5AdOdQOvQx2wRm6-YAZvtqEAnN5ZR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_Ye2lVmQ_cDQwFmKzcRa5Lkvex5JVxb_okKmHt9sGVw&oe=6ADF6B1A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TraceAR", "keywords": [], "long_description": "Bring your next drawing into your space with TraceAR.\n\nChoose a reference from the built-in library or import a PNG or JPG from your headset. Place it over your paper, canvas or wall, adjust its size and opacity, then lock it in place while you draw with your own materials.\n\nMAKE IT FIT\nMove and rotate references, resize from the corners or stretch individual edges. Use flat, cylinder, sphere and corner surface modes to shape your reference. Work with multiple images and switch between centimetres and inches.\n\nDRAW YOUR WAY\nKeep the controls close with a controller-mounted menu. Lock your reference while drawing, or briefly hide it to check your progress. Try original colours, black-and-white or inverted-white image modes.\n\nSTART FREE, GO BIGGER WITH PRO\nAll drawing tools, image import and the library are included free. Each reference fits within A4 (21 x 29.7 cm / 8.27 x 11.69 in). An optional one-time Pro purchase expands the limit to 3 metres (118.11 in) per side. No subscription.\n\nTraceAR provides virtual reference images; you draw on real surfaces with your own materials. Imported images remain in local app storage. Reference placements are not saved between sessions. Touch controllers required.", "short_description": "Turn images into mixed-reality drawing guides on Meta Quest. Import your own PNG or JPG, or choose from the built-in library. Place, resize, rotate and adjust opacity for tracing on paper or walls. All tools are free within A4 size; Pro unlocks images up to 3 metres per side with a one-time purchase."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Proabid/TraceARpolicy/blob/main/privacy.md", "developer_terms_of_service_url": null, "publisher_name": "Toti Studio", "support_website_url": "https://discord.gg/nHNFw3A35j", "website_url": "https://discord.gg/nHNFw3A35j", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1319753421223238"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "977301342080710"}]}, "baseline_offer": {"id": "977301342080710"}, "is_approved": true,
c=Adr4nYLrQdsqYj_Q_yRoUHSkdPnLLddmwRvej5AdOdQOvQx2wRm6-YAZvtqEAnN5ZR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_Ye2lVmQ_cDQwFmKzcRa5Lkvex5JVxb_okKmHt9sGVw&oe=6ADF6B1A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TraceAR-trailer-cover.png", "id": "1128698116580221", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823940_1128698119913554_1305249843623614084_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0sM4VGtPo4Q7kNvwFJtQzh&_nc_oc=Adrh2lJU5bsvAcm7vcCJY5-HCx9Rsqva-DSRo9QKHoxbJUcVChAEQWKTOyMHk8A36qk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPYZ5ZT9ItkIKdYVaEnR0GI3w6QCNIWaSfHjr4W9txIw&oe=6ADF562B"}, "display_name": "TraceAR", "keywords": [], "long_description": "Bring your next drawing into your space with TraceAR.\n\nChoose a reference from the built-in library or import a PNG or JPG from your headset. Place it over your paper, canvas or wall, adjust its size and opacity, then lock it in place while you draw with your own materials.\n\nMAKE IT FIT\nMove and rotate references, resize from the corners or stretch individual edges. Use flat, cylinder, sphere and corner surface modes to shape your reference. Work with multiple images and switch between centimetres and inches.\n\nDRAW YOUR WAY\nKeep the controls close with a controller-mounted menu. Lock your reference while drawing, or briefly hide it to check your progress. Try original colours, black-and-white or inverted-white image modes.\n\nSTART FREE, GO BIGGER WITH PRO\nAll drawing tools, image import and the library are included free. Each reference fits within A4 (21 x 29.7 cm / 8.27 x 11.69 in). An optional one-time Pro purchase expands the limit to 3 metres (118.11 in) per side. No subscription.\n\nTraceAR provides virtual reference images; you draw on real surfaces with your own materials. Imported images remain in local app storage. Reference placements are not saved between sessions. Touch controllers required.", "short_description": "Turn images into mixed-reality drawing guides on Meta Quest. Import your own PNG or JPG, or choose from the built-in library. Place, resize, rotate and adjust opacity for tracing on paper or walls. All tools are free within A4 size; Pro unlocks images up to 3 metres per side with a one-time purchase."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Proabid/TraceARpolicy/blob/main/privacy.md", "developer_terms_of_service_url": null, "publisher_name": "Toti Studio", "support_website_url": "https://discord.gg/nHNFw3A35j", "website_url": "https://discord.gg/nHNFw3A35j", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1371320092733237"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828008_1783840602893815_4638249598523755066_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tt53HIWIniAQ7kNvwGlmdpg&_nc_oc=AdoP7LkqAVf3P9n4tLDHVlJWInXwlltJ40SpjM0CgPMOP5Yg0gE5IvE1k47XhzapLh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3zQQCTxgn1AUJod7ZO4tfqfAHpHhfQ_6oJ-rHXe2kKA&oe=6ADF532E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "TraceAR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_nam
599", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFZgdO7j9CwQ7kNvwGur3aQ&_nc_oc=Adq8RtvTCVTLxsjHujMuUOKz7Ay06B-NuG-N7G8vLxkh9B1yvSIG82r9LdRGk3kbKvo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UMwGuayIOTCIphamiPP0Tkr7Vt0jM61eCNExhLS7RjA&oe=6A3D387E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4Kk631CpzsQ7kNvwGhDyVa&_nc_oc=Adpl9A9oCQ-Sxn-5c2pnVVCnnX_E92ZwKaIsjL2WMvHfaF_seZlTYhLmGf3xPbOzeck&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TfiW7tu-6-zC9jF-w2GYKfJxh8uXjoL01mZQLxt6ryQ&oe=6A3D48A3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSZMHPZXcFcQ7kNvwH2zqnq&_nc_oc=AdplLZB9a_DD9gl8nfcDhNCeG2Nthic0KveKWGt1TM-D8y3-p8LUXzImVSqIm4k6i7U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--CoK_ltBMyAQy21op0xvNq-Zawh0tKYZ7Y3NZUEFnmw&oe=6A3D2A19"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIS8Os6I13QQ7kNvwFZq2cn&_nc_oc=AdpcKVD3ZVmN8RqZFxN4qmxoINYylMrM3bNE6q4joMQ6nj3CT1v-ZcgpCtrUJY2DTjY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yy0HBxrviVhXqYGpXfUdzduIMZiOeKnQ1nIUYi142GQ&oe=6A3D3916"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NgC2vF7JR8Q7kNvwFsYphy&_nc_oc=AdpnBIDwKvetUOSOIulyomRnH1wvpmxA7AkcHppUkBaAsEucZAAFVIp16Ljr4Gg-X5Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W4pN6Nlz6URtEHKJHsng9mAE6ywYc1hkL-WMUx1MBfg&oe=6A3D2783"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MGuTey9VckQ7kNvwGV4st3&_nc_oc=Adroz3rFs9RaGhnldcbCjYc0ytZgtdqO0mfOz3EmUKc4_9ejPXbrSuTyfMDQ5MSPdFI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgVtUzcSCoir6oEH6cPjuKScp5KNtWxwqa_EluIg6D-g&oe=6A7B2EFE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOzuTzF7mjYQ7kNvwHeAj5W&_nc_oc=AdqR4hDNIrnamZdhtwXzd0DK1RjEo-63xc1FwZg3-mWuP3fdLMl8pvLw9OiWRmVKyQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIXFWYK5Y3yWn-I0zfj9SyuPyzgE4PX4rOQkfSKmn9rA&oe=6A7B06E3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=16UACItTnKcQ7kNvwESDymu&_nc_oc=AdqCcQf332kTmzpKCj2fqXxi0UTJY0P4TWr6bWvHaflNkj7xCFuvxDlBH6n3csw7odI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwiaU5z4Q5SMr57VcMgPi7tBjGyl2oZbNW6MzMiecs2g&oe=6A7B2099"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4odKkVz1yOMQ7kNvwFEwMW-&_nc_oc=Adp-a0ZEZElbUZX9IV8QhGkAI7TFpRY3U5WAfVMOLe7tbVnee-lfpwrGqZW2-FMTOfs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNcgIPUod4IRfqQA7vVjslX_Q6cgBMi-5MAx9rKaE8UA&oe=6A7B2F96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5Y5UMSx5RIQ7kNvwFpKdVH&_nc_oc=AdrZvixdRAPSeDc4SzWuPC3rIx8xA5K9_BNDGRvvZY6fXk7PHyaqBdL3ME34imR1Nz8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHums0KH_7foPA4D0DtAgM-Zl3T8pefzPvvcurjjXRkzw&oe=6A7B1E03"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
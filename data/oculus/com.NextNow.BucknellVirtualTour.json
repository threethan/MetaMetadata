rd5-3.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mw8ZBK-gF_UQ7kNvwHNX5kL&_nc_oc=AdlwAFeK8JdKa2l208Rem8nw2wCTeSyVrGusXMDOF5trFS4GoR_B8qcKhM-jg39tCkk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwFsb1sdIwQQjkFPQ74Mlj6afvUj5HZvN84b8kA5-t9Kg&oe=69B810FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXjbwrhbl5gQ7kNvwHDu2cz&_nc_oc=Adlod1hxSnNUZKwocqVg1PMWGInM2buCslRNH29jIEb2nmthVrDcTtSkdNJbUCWqAS8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzcF31HaM6OVcF_fjvr8pEUHuEZX060ETcUNb6eGMu5WA&oe=69B7E8E3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSVRP60FGT4Q7kNvwHMY47Q&_nc_oc=AdmBwjrD8bqnI_1j7Llvp88qK_nzqhypveMUrTR5sDd9R8Ge6sAh3wT2JzJMFJV0amY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzDPq0ejBwUbzwGQFqRtmIAtkeluVBq8YFv8To7xXDqjA&oe=69B80299"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiQWLFBMfRcQ7kNvwFe3Sgm&_nc_oc=AdljCoVmXAXvLWcXjn-utG-rAcIKz_LOtg2MWXGSSuYOIBBZJrNb-h1HltVwE2Mc8dc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZV-FnRSRSVlED7C1JJhNiv4FdQY28HqHYWf-DNNZsXQ&oe=69B81196"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r11imVZLJaEQ7kNvwE7sjsO&_nc_oc=Admau369lxjkgNHc5SYgM__0JhS9WxgEPx1Ehq4Of6-Kg7OM8gyXhktylyk8J5rrYAQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2F8i_dE2jj8biABzPnelV4dz8fcCbVMKQJJAYOqUTuA&oe=69B80003"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
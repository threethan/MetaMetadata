599", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_EBUHy12K4Q7kNvwF2XgWg&_nc_oc=Adq0S09g4FFqj-P7Ty1P1RlgK4BHj9WL2H4RStv4b5wnDjs-gsB_klks1S1e_hcgZnw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRfj5RAKLhEE9k9EcDVlHCUKyABgrv8qRSq5-qzLXsug&oe=6A7345FE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-ymuIJEdecQ7kNvwFzyQKD&_nc_oc=AdrTYjX4g3SHQ7JQFbQqMhmSIGca0voXEhVpVGL0FlJwPb8_M2f_amfLjHA5w559H-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJINw7V2-Fn9ZC6iTmEJzNYUunqw-VKDF7mhkFUTt2tw&oe=6A735623"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZlvE_IPelIQ7kNvwG9C_4r&_nc_oc=AdrErhVZ9u4Pyc6F-9DnhJczml7RCsA7m_jS0c4ZZOMVM7d-Gve2NCUr57w4JW2_QTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkfcNbUFVZsLOaj_xqZeI8OB8On8kSiF-uzXOCuN4vag&oe=6A733799"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxLQmImq1dQQ7kNvwF5rwlb&_nc_oc=AdpeZNSU8UKfbVajXOU2ir3rBsNckFvk0y08jqEu9-A7dky2jKYiv93VEQ6_3EM7YXw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQY21KcU590fCzM_dALzNd3osV0rJIyeGLOv2o_WETmA&oe=6A734696"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ft_4KCBWAoQ7kNvwFllZKs&_nc_oc=Adoew62zgQDb0PrKAIlw53YA2sT72_zpxiQ71sS0cuYtGhsB5CA2Bu_-sj4ll-DHxvQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGiciAWuFqt8tB4DlSbBtrpd3wRB1KsBj0IHp_Jj39Jg&oe=6A733503"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
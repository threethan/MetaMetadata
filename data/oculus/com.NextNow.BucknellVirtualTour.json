rd5-3.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6gay7OBSR9EQ7kNvwGnEKT7&_nc_oc=AdkVB01Wwmhv5e9D-osWjzNrlgJKX3XXKaeYknuTvP_TDefryT5HLecebjarz4eYRAg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx9mkbNXvbX_KYsqv2RTbHbbEQoYflAF5pIqhDIxI91_Q&oe=69AC337E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXim24r_yZcQ7kNvwEP4n55&_nc_oc=AdkGdZogmAijNGRvj3L0fl_WdwiLFrc8mkstdvF6DmDO90j4gEILKH6yLN861C0XVfk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afztjmlu7TqjjY9yXI1xka7Rwl-jnULa31XVyFhkigvUwQ&oe=69AC0B63"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNmCPfzi67oQ7kNvwHL0XN0&_nc_oc=AdkZlJgN0X6RmhJYl7u_DzTZ737aLy4XgYwu8KqE3VTULVlGDTD0k2tNzWPN33CJfc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzC6qxo13rjfgCqQKpFRlINm_MJcnX-KzZfna4IYQYXdg&oe=69AC2519"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2F2VZuG2CwIQ7kNvwH9onVv&_nc_oc=Admd6CPhvr05wh7aEwp84GGW4rg2p_YHuJowh7rZXg0yMDd4s3osfbUoznc4i3DW-9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSO068JBesW-MoeWi89DYa-Jp1hLbxFm151jE0TuhFWg&oe=69AC3416"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQg2Qp8-kIgQ7kNvwEl2HWa&_nc_oc=AdnLUYthVNSrqVxM_MDZDyJxTfbOINZNP8_akV5dyM5EMIWbzyi6U1kTqY5KcZSoSDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsUd21j1i5Oc250y0QbV0tbfVxT1dKmiAgvKWUaJ9ShA&oe=69AC2283"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "pla
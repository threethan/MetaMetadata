599", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGeqdcaiWykQ7kNvwHTVCTu&_nc_oc=AdrUzmK1syPkPKHCYO8pDyQGQv8xfBbniH8YK11QGszxwAJ7BlPEqz-8PKIkhMwMkak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BW8hj-Q1CenMQshp7_rmXeEuPKPjZe3vcznxMlLcLAw&oe=6A3A957E"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4Kk631CpzsQ7kNvwFScNEI&_nc_oc=Adr0v_5jo_1nHeOsfV-_53i1spXGSPyyrNO0qIkjBwu_JKwKYVUSTGd540lYoFCHfC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ncAwjd9e79zrK2vLnAEGOEsA6U3kPPjLAtIsHwgdUmQ&oe=6A3AA5A3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Q_T7699MTcQ7kNvwHLPw3i&_nc_oc=Adpq5lUy7SSoic6YugRQOwpn4hkOMqln7ZiKZsglFReoAOVmYRBVdewyqTdkt4WelsI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dRK9jMnL3CS7iUV48YoCPtrBPM4jKw4ABw_nqyRDK-g&oe=6A3A8719"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PIS8Os6I13QQ7kNvwHi0Tto&_nc_oc=AdpIGtH-L_T6Jmyl2z3y01SfciGL-2Tt3UyUok_iDbjWmxGM7ttj6cH-C8YiyLIhlWw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Q1fZaCZZ1AyKaszhWaJj-zoMqFl50myoaUnpg1g9OlA&oe=6A3A9616"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7Kzt6CeRhUQ7kNvwFHC5lR&_nc_oc=AdpaSxaHoTG7EPys5WFcoWPu5dI93A81kEggfENXwGpmDMfTUQ7hsT-ZfUqgk0o3TuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rhRfnW-lhV0IHZtfWDho9Nq7G0y6eYG_jsJZglzMsDw&oe=6A3A8483"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 
599", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031436_355000419171932_3129026254251685423_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTh_LGLLAhYQ7kNvwE6INt-&_nc_oc=AdqkEWiuJlW3zKA5mbM5UbsrbTx2xeoG2IZFJjhRvnGOBSI7XMtJhdaI4Q5MojxjaqA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fPVzwt91FmTpDd2hh-WTdgMPYAn8439mpYfV2vVdCgg&oe=69DF9DFE"}, {"file_name": "Still10.png", "id": "154620259877664", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974631_154620263210997_7240358659162592942_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d915lJEw16AQ7kNvwFNZ44v&_nc_oc=AdpVqdp1WR2x7eVRZ19NfAwouA7ptoLynI1LUL2WcRplS0SjLinZZjvSeo6lxb67R1k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2azkKPjsrimN9HQWI2Z65eFaTWgJv7leMXbyNi1Y0kyA&oe=69DF75E3"}, {"file_name": "Still14.png", "id": "1350668401973383", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982580_1350668405306716_8167505081353268152_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KM5PjkowcqwQ7kNvwFkA_0d&_nc_oc=AdrrGsmf00vGhJdxFHP1lJRy_QpY6t49igNts9paymD2uvK91Jw-mbwDRXXVs10GAe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31P93P8z0S23fJb1sH7ZhrotZ5PiBObigHTdUwUyy0Jg&oe=69DF8F99"}, {"file_name": "Still13.png", "id": "491929948848500", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984454_491929952181833_5988664817215305229_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BJCsZwvzZZIQ7kNvwFBRyFn&_nc_oc=AdpKbDgcUdMYbBTIkXFW4bSNjg7iR-gHIcQygfSW6v5kbugNzwDNRk6kx_HE0bBblMs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IRa3BWCD8hknAxA-YrI_eQh60KgkYhcDIG6xBqRt-2w&oe=69DF9E96"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage01.png", "id": "459198832085361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984459_459198835418694_1510610565153484086_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ktg1UIl-AK4Q7kNvwE7ZxvW&_nc_oc=Adr5vun5-u7rlhxLLid-j9KGvOKdJdebq7F03HxW4KBt8YpztK365YbHjK2LPCg1qHc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hQGSpDNoKv_tCP751AEuWjTSFPli4vr1VV6EYecE2IA&oe=69DF8D03"}, "display_name": "Bucknell Virtual Experience", "keywords": [], "long_description": "The Bucknell Virtual Experience transports you into an immersive world that lets you see what makes Bucknell unique \u2014 from our high-tech labs and learning spaces to our spacious facilities for athletics and recreation. As you explore, you can stop at any of the 10 interactive exhibits \u2014 each featuring a helpful audio introduction, stunning photos and never-before-seen 360-degree videos shot on campus.\n\nBut these exhibits don\u2019t float in an empty digital space. Look left, right, up and down to spot beautifully rendered details taken from real life. You\u2019ll see downtown Lewisburg\u2019s three-globe lampposts, clock and Campus Theatre. You\u2019ll see the cherry trees from Malesardi Quad, the Rooke Science Center dome and the iconic clock tower atop Bertrand Library.\n\nDon\u2019t just imagine yourself at Bucknell. Be there, with the Bucknell Virtual Experience.", "short_description": "Take your college search deeper than websites and two-dimensional videos. Inside the Bucknell Virtual Experience, you\u2019ll enjoy an entirely new way to explore what it\u2019s like to be a college student. "}]}, "developer_name": "NextNow Agency", "developer_privacy_policy_url": "https://drive.google.com/file/d/1OS3rwU0kEI3oBzu0-SLp2l8uVkwJ3530/view?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Bucknell University", "support_website_url": null, "website_url": "https://bucknell.edu/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, 